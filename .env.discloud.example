# Copy this to `.env` before zipping the project for Discloud (never commit the real one).
# Discloud reads `.env` and gives it to the site as process.env, the same names Cloudflare uses.

# Public, same values as wrangler.toml
PETTO_BOT_API_URL=https://api.petto.sbs
DISCORD_CLIENT_ID=1489326875498119168
PETTO_OWNER_ID=293504726505357312
POLAR_SERVER=production
POLAR_CHECKOUT_LINK=https://buy.polar.sh/polar_cl_p41bcqro0KizhbyvWvgMU52a7hVTyE7XsW9yz38pCp6
POLAR_PRODUCT_PREMIUM_1_MONTH=15621107-ba45-4f62-a648-636f23c0f9e3
POLAR_PRODUCT_PREMIUM_1_YEAR=da48d960-a600-461a-b251-8cb684b1cb5f
POLAR_PRODUCT_PREMIUM_3_MONTH=b7636ff3-c73a-4274-9850-3d4446e3df11
POLAR_PRODUCT_PREMIUM_3_YEAR=1dc59fa1-f358-4172-9327-a61069882366
POLAR_PRODUCT_PREMIUM_5_MONTH=1ec97d11-63af-4573-af09-3075567c4cc7
POLAR_PRODUCT_PREMIUM_5_YEAR=5361b1ef-97e2-470d-8fe3-25da2b49aeeb

# Optional, Discloud only: read tables straight from PostgreSQL instead of through the bot API.
# Use the same database URL as the bot (DISCLOUD_DATABASE_URL). Reads and the dashboard's writes go straight to it.
# Without it, or if the database fails, everything keeps going through the API.
# Set it in production: without it every dashboard read and write goes through the rate-limited bot API.
PETTO_DATABASE_URL=
PETTO_DATABASE_SSL=false
# Most connections to the database at once (default 15).
PETTO_DATABASE_POOL_MAX=

# Optional: the bot's Redis (either name). Shared cache, the bot's server copies and change messages. Without it, memory only.
REDIS_URL=
DISCLOUD_REDIS_URL=

# Secrets: take them from the Cloudflare dashboard. Use the SAME values so logins stay valid.
DISCORD_TOKEN=
DISCORD_CLIENT_SECRET=
PETTO_BOT_API_SECRET=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
