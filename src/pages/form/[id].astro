---
export const prerender = false;
// The page of one form in this language: /form/<public id>. It is drawn on the server with the look of the form and the tags of its link
// preview (utils/formPreview.ts); the questions load for the member who logs in (components/WebFormPage.astro).
import WebFormPage from '../../components/WebFormPage.astro';
import { loadFormLook } from '../../utils/formPreview';
import { PUBLIC_ID } from '../../utils/forms';

const id = String(Astro.params.id ?? '');
if (!PUBLIC_ID.test(id)) return new Response('Not found', { status: 404 });
const { status, look } = await loadFormLook(Astro, id, 'en');
// A form that does not exist answers 404 with this page (its own message), not the site's page of a missing address.
if (status === 404) { Astro.response.status = 404; Astro.response.headers.set('X-Astro-Reroute', 'no'); }
// The same page for everyone (what depends on the member loads afterwards): a cache in front may keep it a minute.
Astro.response.headers.set('Cache-Control', look ? 'public, max-age=60, s-maxage=60, stale-while-revalidate=300' : 'no-store');
---
<WebFormPage lang="en" id={id} look={look} status={status} />
