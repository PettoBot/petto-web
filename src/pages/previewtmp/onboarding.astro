---
export const prerender = false;
import DashOnboarding from '../../components/DashOnboarding.astro';
const channels = [{ id: '1', name: 'general' }, { id: '2', name: 'welcome' }, { id: '3', name: 'logs' }];
const roles = [{ id: '10', name: 'Member' }, { id: '11', name: 'Unverified' }];
const ev = { welcomeChannelId: '2', welcomeMessage: 'Welcome {user.mention} to **{server_name}**!', welcomeEmbedTemplate: '', leaveChannelId: null, leaveMessage: '{user.name} left.', leaveEmbedTemplate: '', boostChannelId: null, boostMessage: '', boostEmbedTemplate: '', boostLevelMessage: '', boostLevelEmbedTemplate: '' };
---
<DashOnboarding user={{ username: 'Liam', avatar: null }} guildId="1" guildName="Botsitos 1" guildIcon="/assets/mascot-icon.webp"
  memberEvents={ev} verification={{ methodReady: true, method: 'letters', designReady: true, promptTemplate: '', verifiedTemplate: '', enabled: true, unverifiedRoleId: '11', verifiedRoleId: '10', panelReady: true, panelChannelId: '2' }}
  bump={{ designReady: true, thankyouTemplate: '', reminderTemplate: '', channelId: null, message: '', thankyou: '', pingable: false, autolock: false, autoclean: false }}
  dmJoin={{ message: '', embedTemplate: '' }} pingOnJoin={{ enabled: false, channelIds: [], delaysSeconds: {} }} joinRoles={[{ roleId: '10', target: 'humans' }]}
  roles={roles} channels={channels} embedTemplateNames={['Welcome card']} saved={false} />
