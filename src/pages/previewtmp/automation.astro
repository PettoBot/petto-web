---
export const prerender = false;
import DashAutomation from '../../components/DashAutomation.astro';
const section = Astro.url.searchParams.get('section') ?? 'webhooks';
const channels = [{ id: '1', name: 'general' }, { id: '2', name: 'announcements' }];
const board = { channel_id: '1', threshold: 3, emoji: '⭐', color: 0xffc107, selfstar: false, timestamp: true, jumpurl: true, attachments: true, embed_template: '' };
---
<DashAutomation user={{ username: 'Liam', avatar: null }} guildId="1" guildName="Botsitos 1" guildIcon="/assets/mascot-icon.webp"
  customCommands={[]} premiumActive={false} autoResponders={[]} stickyMessages={[]} disabledCommands={[]} reactionRoles={[]} reactionTriggers={[]} reactionMessages={[]} autoThreads={[]}
  roles={[]} channels={channels} embedTemplateNames={['Welcome card', 'Big news']} saved={false} aliases={[]} timers={[]}
  starboard={board as any} monkeyboard={{ ...board, emoji: '🐒', color: 0xc98b4a } as any} voiceMaster={null} voiceChannels={[]} channelCategories={[]}
  managedWebhooks={[{ id: 1, name: 'News', channelId: '2', webhookId: '9', defaultUsername: null, defaultAvatarUrl: null, defaultMessage: null, enabled: true } as any]}
  serverCounters={[]} section={section} />
