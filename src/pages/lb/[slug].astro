---
export const prerender = false;
import Leaderboard from '../../components/Leaderboard.astro';
import { loadLeaderboard } from '../../utils/leaderboard';
const { slug } = Astro.params as { slug: string };
// The status is set here, before the page starts to stream: a server that is not public answers 404, and a bot that cannot answer 503.
const data = await loadLeaderboard(Astro, slug);
if (data.status === 'missing') Astro.response.status = 404;
if (data.status === 'down') Astro.response.status = 503;
---
<Leaderboard lang="en" slug={slug} data={data} />
