---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { getDashLang } from '../i18n/dash';
import type { Locale } from '../i18n/ui';

// The page for an address that does not exist: on every address of the site, in the language of the address (/es, /pt-br) or, in the
// dashboard, the saved one. It is made on each request (the language and the address come from the request) and answers 404.
export const prerender = false;

const path = Astro.url.pathname;
const inDash = /^\/(?:(?:es|pt-br)\/)?dash(?:\/|$)/i.test(path);
const lang: Locale = /^\/es(?:\/|$)/i.test(path) ? 'es' : /^\/pt-br(?:\/|$)/i.test(path) ? 'pt-BR' : inDash ? getDashLang(Astro) : 'en';
const prefix = lang === 'es' ? '/es' : lang === 'pt-BR' ? '/pt-br' : '';

const copy = {
  en: { title: 'Page not found', lede: 'That page does not exist, or it moved. Check the address, or go back to somewhere that does.', home: 'Back home', commands: 'Commands', dash: 'Dashboard', support: 'Ask in the support server' },
  es: { title: 'Página no encontrada', lede: 'Esa página no existe o se movió. Revisa la dirección, o vuelve a un lugar que sí exista.', home: 'Volver al inicio', commands: 'Comandos', dash: 'Panel', support: 'Pregunta en el servidor de soporte' },
  'pt-BR': { title: 'Página não encontrada', lede: 'Essa página não existe ou foi movida. Confira o endereço, ou volte para um lugar que exista.', home: 'Voltar ao início', commands: 'Comandos', dash: 'Painel', support: 'Pergunte no servidor de suporte' },
}[lang];

Astro.response.status = 404;
---
<Base title={`${copy.title} · Petto`} lang={lang} active={inDash ? 'dash' : 'home'} noindex>
  <main class="nf">
    <div class="nf-card">
      <img class="nf-mascot" src="/assets/mascot-icon.webp" alt="" width="84" height="84" />
      <p class="nf-code" aria-hidden="true">404</p>
      <h1>{copy.title}</h1>
      <p class="nf-lede">{copy.lede}</p>
      <div class="nf-actions">
        <a class="btn btn-primary" href={prefix || '/'}><Icon name="ph:arrow-left-bold" width="16" height="16" />{copy.home}</a>
        <a class="btn btn-ghost" href={`${prefix}/commands`}><Icon name="ph:terminal-window-fill" width="16" height="16" />{copy.commands}</a>
        <a class="btn btn-ghost" href="/dash/manage"><Icon name="ph:squares-four-fill" width="16" height="16" />{copy.dash}</a>
      </div>
      <a class="nf-support" href="https://petto.sbs/support" target="_blank" rel="noopener">{copy.support}</a>
    </div>
  </main>
</Base>

<style>
  .nf { min-height: calc(100vh - 220px); display: grid; place-items: center; padding: 56px 16px; }
  .nf-card { width: min(100%, 520px); text-align: center; padding: 34px 26px 28px; border: 1px solid var(--border); border-radius: 22px; background: var(--card); }
  .nf-mascot { display: block; margin: 0 auto 6px; border-radius: 22px; }
  .nf-code { margin: 0; font-size: clamp(54px, 16vw, 84px); font-weight: 800; letter-spacing: -.04em; line-height: 1; color: var(--accent); }
  .nf h1 { margin: 10px 0 8px; font-size: clamp(22px, 6vw, 28px); line-height: 1.15; }
  .nf-lede { margin: 0 auto 22px; max-width: 40ch; color: var(--text-muted); line-height: 1.5; }
  .nf-actions { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .nf-support { display: inline-block; margin-top: 18px; font-size: 13.5px; color: var(--text-dim); text-decoration: underline; text-underline-offset: 3px; }
  .nf-support:hover { color: var(--text-muted); }
</style>
