---
export const prerender = false;
// /es/feedback and /pt-br/feedback are answered by the middleware, which renders /feedback in that language. These files only keep the language links and hreflang aware of the page, and set the language if one is ever reached directly.
Astro.cookies.set('petto_lang', 'pt-BR', { path: '/', maxAge: 60 * 60 * 24 * 365, sameSite: 'lax', secure: Astro.url.protocol === 'https:' });
return Astro.redirect('/feedback/new');
---
