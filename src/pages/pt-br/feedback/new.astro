---
export const prerender = false;
// The board lives at /feedback for every language: this sets the language and goes there.
Astro.cookies.set('petto_lang', 'pt-BR', { path: '/', maxAge: 60 * 60 * 24 * 365, sameSite: 'lax', secure: Astro.url.protocol === 'https:' });
return Astro.redirect('/feedback/new');
---
