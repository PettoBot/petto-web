---
export const prerender = false;
// The link of a form to share (/f/<public id>; it was the address of the form before the language moved to the path and the id to the
// hash): a browser goes to the page of the form, /form#<public id>, in the visitor's language (saved choice or browser); an app that
// reads link previews (Discord…) gets the preview of this form: title, description, color, banner or server icon (utils/formPreview.ts).
import { getDashLang } from '../../i18n/dash';
import { formLinkResponse } from '../../utils/formPreview';
const lang = getDashLang(Astro);
return formLinkResponse(Astro, lang === 'es' ? 'es' : lang === 'pt-BR' ? 'pt-BR' : 'en');
---
