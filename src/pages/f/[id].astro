---
export const prerender = false;
// A form of a server, filled on the website: the member logs in with Discord (only their identity), the bot says whether they may send
// it (member of the server, roles, ages, pending, cooldown, limits, dates) and takes the answers through the same pipeline as Discord.
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import { getDashLang, makeT } from '../../i18n/dash';
import { getDashboardSession } from '../../utils/dashAuth';
import { callPettoWebForm } from '../../utils/pettoBotApi';
import { PUBLIC_ID, descriptionHtml, imageUrl } from '../../utils/forms';

// The id is the random public id of the form (12 letters and digits). A number, or anything else, gets the site's normal
// not-found page at once, without asking the bot or a login, so the forms cannot be walked through by number.
const id = String(Astro.params.id ?? '');
if (!PUBLIC_ID.test(id)) return new Response(null, { status: 404 });
const lang = getDashLang(Astro);
const dt = makeT(lang);
Astro.response.headers.set('Cache-Control', 'private, no-store');
const session = await getDashboardSession(Astro);
const loginHref = `/f/login?next=${encodeURIComponent(`/f/${id}`)}`;

type Question = { id: string; type: string; label: string; help: string | null; description?: string | null; image?: string | null; placeholder: string | null; required: boolean; min_length: number | null; max_length: number | null; min_value: number | null; max_value: number | null; options: string[]; max_choices: number | null };
let data: any = null;
let status = 0;
let sent: { number: number; message: string } | null = null;
let failure = '';
let fieldErrors: Record<string, string> = {};
const values: Record<string, string | string[]> = {};

if (session) {
  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    for (const [key, value] of form.entries()) {
      if (!key.startsWith('q_') || typeof value !== 'string') continue;
      const qid = key.slice(2, 40);
      const prior = values[qid];
      if (form.getAll(key).length > 1 || String(form.get(`multi_${qid}`) ?? '') === '1') values[qid] = form.getAll(key).map(String).slice(0, 30);
      else if (prior === undefined) values[qid] = value.slice(0, 5000);
    }
    for (const key of form.keys()) if (key.startsWith('multi_') && values[key.slice(6)] === undefined) values[key.slice(6)] = [];
    const result = await callPettoWebForm(Astro, id, session.userId, 'submit', { values }, lang);
    if (result.ok) sent = { number: Number(result.data.number), message: String(result.data.message ?? '') };
    else if (result.data?.errors) fieldErrors = Object.fromEntries(result.data.errors.map((e: any) => [String(e.id), String(e.message)]));
    else failure = String(result.data?.message ?? '') || dt('It could not be sent. Try again in a moment.');
  }
  const shown = await callPettoWebForm(Astro, id, session.userId, 'public', {}, lang);
  data = shown.data;
  status = shown.status;
}
const form = data?.form ?? null;
const questions: Question[] = form?.questions ?? [];
const color = typeof form?.color === 'number' ? `#${form.color.toString(16).padStart(6, '0')}` : 'var(--accent)';
const title = form?.title ?? dt('Form');
const answered = Object.keys(fieldErrors).length;
const valueOf = (q: Question) => values[q.id];
const isChecked = (q: Question, v: string) => { const cur = valueOf(q); return Array.isArray(cur) ? cur.includes(v) : cur === v; };
---
<Base title={`${title} · Petto`} lang={lang} description={form?.description ?? dt('Fill in this form with your Discord account.')}>
  <main class="wf" data-no-loader>
    <div class="wf-shell" style={`--wf: ${color}`}>
      {!session && (
        <div class="wf-card wf-center">
          <img src="/assets/mascot-icon.webp" alt="" width="64" height="64" class="wf-mascot" />
          <h1>{dt('Log in to fill in this form')}</h1>
          <p class="wf-muted">{dt('Petto only asks Discord who you are, to send your answers as you and check that you are in the server.')}</p>
          <a class="btn btn-accent" href={loginHref}><Icon name="simple-icons:discord" width="16" height="16" />{dt('Log in with Discord')}</a>
        </div>
      )}

      {session && !form && (
        <div class="wf-card wf-center">
          <Icon name="ph:warning-fill" width="30" height="30" class="wf-warn-icon" />
          <h1>{status === 404 ? dt('This form does not exist') : dt('The form could not be loaded')}</h1>
          <p class="wf-muted">{status === 404 ? dt('It may have been deleted, or the link is wrong.') : dt('Petto did not answer. Try again in a moment.')}</p>
          {status === 404 ? <a class="btn btn-ghost" href="/">{dt('Go to Petto')}</a> : <a class="btn btn-ghost" href={`/f/${id}`}>{dt('Try again')}</a>}
        </div>
      )}

      {session && form && (
        <>
          <header class="wf-head">
            <div class="wf-server">
              {data.server?.icon ? <img src={data.server.icon} alt="" width="40" height="40" /> : <span class="wf-server-letter">{String(data.server?.name ?? '?').slice(0, 1)}</span>}
              <span>{data.server?.name}</span>
              <span class="wf-id" title={dt('Link of the form:')} translate="no"><span class="wf-id-p">~/f/</span>{form.id}<i class="wf-caret" aria-hidden="true"></i></span>
            </div>
            <h1>{form.title}</h1>
            {form.description && <p class="wf-desc">{form.description}</p>}
            <p class="wf-who"><Icon name="ph:user-circle-fill" width="15" height="15" />{dt('Answering as {a}', { a: session.username })} · <a href="/dash/logout">{dt('Not you?')}</a></p>
          </header>

          {sent && (
            <div class="wf-card wf-done" role="status">
              <span class="wf-done-icon"><Icon name="ph:check-circle-fill" width="34" height="34" /></span>
              <h2>{dt('Sent (#{a})', { a: sent.number })}</h2>
              <p>{sent.message}</p>
            </div>
          )}

          {!sent && !data.can && (
            <div class="wf-card wf-refused" role="status"><Icon name="ph:lock-fill" width="18" height="18" /><p>{data.reason}</p></div>
          )}

          {!sent && data.can && (
            <form method="POST" class="wf-card wf-form" novalidate data-wf-form>
              {failure && <div class="wf-alert" role="alert"><Icon name="ph:warning-fill" width="15" height="15" />{failure}</div>}
              {answered > 0 && <div class="wf-alert" role="alert"><Icon name="ph:warning-fill" width="15" height="15" />{dt('Some answers need a fix.')}</div>}
              {questions.map((q, index) => (
                <fieldset class:list={['wf-q', { 'wf-q-bad': fieldErrors[q.id] }]} style={`--i:${index}`} data-q={q.id} data-type={q.type} data-required={q.required ? '1' : '0'} data-min={q.min_length ?? ''} data-minv={q.min_value ?? ''} data-maxv={q.max_value ?? ''} data-maxc={q.max_choices ?? ''}>
                  {imageUrl(q.image) && <img class="wf-img" src={imageUrl(q.image)} alt={q.label} loading="lazy" decoding="async" referrerpolicy="no-referrer" />}
                  <legend><span class="wf-n">{index + 1}</span>{q.label}{q.required ? <em class="wf-req" aria-label={dt('Required')}>*</em> : <span class="wf-opt">{dt('optional')}</span>}</legend>
                  {q.help && <p class="wf-help">{q.help}</p>}
                  {q.description && <div class="wf-qdesc" set:html={descriptionHtml(q.description)} />}
                  {q.type === 'short' && <input type="text" name={`q_${q.id}`} value={String(valueOf(q) ?? '')} maxlength={q.max_length ?? 1000} placeholder={q.placeholder ?? ''} required={q.required} />}
                  {q.type === 'paragraph' && <textarea name={`q_${q.id}`} maxlength={q.max_length ?? 4000} placeholder={q.placeholder ?? ''} required={q.required} rows="5">{String(valueOf(q) ?? '')}</textarea>}
                  {q.type === 'number' && <input type="text" inputmode="decimal" name={`q_${q.id}`} value={String(valueOf(q) ?? '')} maxlength="30" placeholder={q.placeholder || (q.min_value !== null && q.max_value !== null ? `${q.min_value} – ${q.max_value}` : '')} required={q.required} />}
                  {q.type === 'yesno' && (
                    <div class="wf-choices wf-row">
                      <label class="wf-choice"><input type="radio" name={`q_${q.id}`} value="yes" checked={isChecked(q, 'yes')} /><span>{dt('Yes')}</span></label>
                      <label class="wf-choice"><input type="radio" name={`q_${q.id}`} value="no" checked={isChecked(q, 'no')} /><span>{dt('No')}</span></label>
                    </div>
                  )}
                  {q.type === 'choice' && <div class="wf-choices">{q.options.map((option, i) => <label class="wf-choice"><input type="radio" name={`q_${q.id}`} value={`o${i}`} checked={isChecked(q, `o${i}`)} /><span>{option}</span></label>)}</div>}
                  {q.type === 'multi' && (
                    <>
                      <input type="hidden" name={`multi_${q.id}`} value="1" />
                      <div class="wf-choices">{q.options.map((option, i) => <label class="wf-choice wf-check"><input type="checkbox" name={`q_${q.id}`} value={`o${i}`} checked={isChecked(q, `o${i}`)} /><span>{option}</span></label>)}</div>
                      <p class="wf-help">{q.max_choices ? dt('Pick up to {a}.', { a: q.max_choices }) : dt('Pick all that apply.')}</p>
                    </>
                  )}
                  <p class="wf-err" data-err aria-live="polite">{fieldErrors[q.id] ?? ''}</p>
                </fieldset>
              ))}
              <div class="wf-foot">
                <button class="btn btn-accent" type="submit" data-wf-send><Icon name="ph:paper-plane-tilt-fill" width="15" height="15" />{dt('Send')}</button>
                <span class="wf-muted">{dt('The staff of {a} reads your answers in Discord.', { a: data.server?.name ?? '' })}</span>
              </div>
            </form>
          )}
        </>
      )}
    </div>
  </main>
</Base>

<script define:vars={{ texts: { required: dt('Answer this question.'), number: dt('Write a number.'), range: dt('Write a number from {min} to {max}.'), short: dt('Write at least {count} characters.'), many: dt('Pick up to {count}.') } }}>
  // The same checks as the bot, before sending, so a mistake is shown at once. The bot checks everything again.
  (function () {
    var form = document.querySelector('[data-wf-form]');
    if (!form) return;
    var fill = function (text, vars) { return text.replace(/\{(\w+)\}/g, function (w, k) { return k in vars ? vars[k] : w; }); };
    var check = function (box) {
      var type = box.dataset.type;
      var required = box.dataset.required === '1';
      var msg = '';
      if (type === 'short' || type === 'paragraph' || type === 'number') {
        var input = box.querySelector('input[name^="q_"], textarea');
        var text = (input.value || '').trim();
        if (!text) { if (required) msg = texts.required; }
        else if (type === 'number') {
          var normal = text.replace(/\s/g, '').replace(',', '.');
          if (!/^-?\d{1,15}(\.\d{1,6})?$/.test(normal)) msg = texts.number;
          else {
            var n = Number(normal), min = box.dataset.minv, max = box.dataset.maxv;
            if ((min !== '' && n < Number(min)) || (max !== '' && n > Number(max))) msg = fill(texts.range, { min: min || '…', max: max || '…' });
          }
        } else if (box.dataset.min && text.length < Number(box.dataset.min)) msg = fill(texts.short, { count: box.dataset.min });
      } else {
        var picked = box.querySelectorAll('input[name^="q_"]:checked').length;
        if (!picked && required) msg = texts.required;
        else if (type === 'multi' && box.dataset.maxc && picked > Number(box.dataset.maxc)) msg = fill(texts.many, { count: box.dataset.maxc });
      }
      box.classList.toggle('wf-q-bad', Boolean(msg));
      box.querySelector('[data-err]').textContent = msg;
      return !msg;
    };
    form.addEventListener('change', function (event) { var box = event.target.closest('[data-q]'); if (box && box.classList.contains('wf-q-bad')) check(box); });
    form.addEventListener('focusout', function (event) { var box = event.target.closest('[data-q]'); if (box && event.target.matches('input[type=text], textarea') && event.target.value) check(box); });
    form.addEventListener('submit', function (event) {
      var boxes = Array.prototype.slice.call(form.querySelectorAll('[data-q]'));
      var bad = boxes.filter(function (box) { return !check(box); });
      if (bad.length) { event.preventDefault(); bad[0].scrollIntoView({ behavior: 'smooth', block: 'center' }); var first = bad[0].querySelector('input, textarea'); if (first) first.focus({ preventScroll: true }); return; }
      var button = form.querySelector('[data-wf-send]');
      if (button) { button.disabled = true; button.classList.add('is-sending'); }
    });
  })();
</script>

<style>
  .wf { padding: 48px 16px 80px; }
  .wf-shell { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }
  .wf-card { border: 1px solid var(--border); border-radius: 18px; background: var(--card); padding: 22px; animation: wfIn .5s cubic-bezier(.16, 1, .3, 1) both; }
  .wf-center { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 40px 22px; }
  .wf-center h1 { font-size: 24px; margin: 0; }
  .wf-mascot { animation: wfFloat 5s ease-in-out infinite; }
  .wf-muted { color: var(--text-muted); font-size: 14px; margin: 0; max-width: 52ch; }
  :global(.wf-warn-icon) { color: var(--yellow); }
  .wf-head { position: relative; border-radius: 20px; padding: 26px 24px 22px; background: linear-gradient(135deg, color-mix(in srgb, var(--wf) 22%, var(--card)), var(--card) 70%); border: 1px solid color-mix(in srgb, var(--wf) 35%, var(--border)); overflow: hidden; animation: wfIn .5s cubic-bezier(.16, 1, .3, 1) both; }
  .wf-head::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 5px; background: var(--wf); }
  .wf-server { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 13.5px; font-weight: 600; color: var(--text-muted); margin-bottom: 14px; }
  .wf-server img, .wf-server-letter { width: 32px; height: 32px; border-radius: 10px; object-fit: cover; }
  .wf-server-letter { display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); }
  .wf-id { margin-left: auto; display: inline-flex; align-items: center; font-family: var(--mono); font-size: 12px; letter-spacing: .03em; padding: 4px 9px; border-radius: 8px; font-weight: 500; color: color-mix(in srgb, var(--wf) 70%, var(--text)); background: color-mix(in srgb, var(--bg) 70%, transparent); border: 1px solid color-mix(in srgb, var(--wf) 30%, var(--border)); user-select: all; }
  .wf-id-p { color: var(--text-dim); user-select: none; }
  .wf-caret { width: 7px; height: 13px; margin-left: 3px; background: currentColor; opacity: .75; animation: wfBlink 1.1s steps(1) infinite; }
  .wf-head h1 { font-size: clamp(24px, 5vw, 32px); margin: 0 0 8px; line-height: 1.15; }
  .wf-desc { color: var(--text-muted); font-size: 15px; line-height: 1.6; margin: 0 0 12px; white-space: pre-line; }
  .wf-who { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-size: 13px; color: var(--text-dim); margin: 0; }
  .wf-who a { color: var(--accent); }
  .wf-form { display: flex; flex-direction: column; gap: 14px; }
  .wf-alert { display: flex; align-items: center; gap: 8px; border-radius: 10px; padding: 10px 13px; font-size: 13.5px; color: var(--red); background: color-mix(in srgb, var(--red) 10%, transparent); border: 1px solid color-mix(in srgb, var(--red) 40%, transparent); }
  .wf-q { border: 1px solid var(--border); border-radius: 14px; padding: 16px; margin: 0; min-width: 0; display: flex; flex-direction: column; gap: 9px; transition: border-color .2s ease, box-shadow .2s ease; animation: wfIn .45s cubic-bezier(.16, 1, .3, 1) both; animation-delay: calc(min(var(--i), 8) * 40ms); }
  .wf-q:focus-within { border-color: color-mix(in srgb, var(--wf) 55%, var(--border)); box-shadow: 0 0 0 3px color-mix(in srgb, var(--wf) 14%, transparent); }
  .wf-q-bad { border-color: color-mix(in srgb, var(--red) 60%, var(--border)); }
  .wf-q legend { display: flex; align-items: baseline; gap: 8px; font-weight: 600; font-size: 15px; padding: 0; float: left; width: 100%; }
  .wf-q legend + * { clear: both; }
  .wf-n { flex: none; font-size: 12px; font-family: var(--mono); color: var(--wf); }
  .wf-req { color: var(--red); font-style: normal; }
  .wf-opt { font-size: 11.5px; font-weight: 500; color: var(--text-dim); }
  .wf-help { font-size: 13px; color: var(--text-muted); margin: 0; }
  .wf-img { display: block; width: 100%; height: auto; max-height: 420px; object-fit: contain; border-radius: 12px; background: var(--bg); border: 1px solid var(--border); }
  .wf-qdesc { font-size: 14px; line-height: 1.6; color: var(--text-muted); margin: 0; overflow-wrap: anywhere; }
  .wf-qdesc :global(a) { color: var(--wf); text-decoration: underline; text-underline-offset: 2px; }
  .wf-qdesc :global(strong) { color: var(--text); }
  .wf-qdesc :global(code) { font-family: var(--mono); font-size: .9em; padding: 1px 5px; border-radius: 5px; background: var(--bg); border: 1px solid var(--border); }
  .wf-q input[type=text], .wf-q textarea { width: 100%; box-sizing: border-box; border: 1px solid var(--border); border-radius: 10px; padding: 11px 13px; background: var(--bg); color: var(--text); font: inherit; font-size: 15px; transition: border-color .15s ease, box-shadow .15s ease; }
  .wf-q textarea { resize: vertical; min-height: 120px; line-height: 1.5; }
  .wf-q input[type=text]:focus, .wf-q textarea:focus { outline: none; border-color: var(--wf); box-shadow: 0 0 0 3px color-mix(in srgb, var(--wf) 18%, transparent); }
  .wf-choices { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px; }
  .wf-row { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 360px; }
  .wf-choice { position: relative; display: block; cursor: pointer; }
  .wf-choice input { position: absolute; opacity: 0; pointer-events: none; }
  .wf-choice span { display: flex; align-items: center; gap: 10px; border: 1px solid var(--border); border-radius: 11px; padding: 11px 13px; font-size: 14.5px; transition: border-color .15s ease, background .15s ease, transform .12s ease; min-height: 22px; }
  .wf-choice span::before { content: ''; flex: none; width: 16px; height: 16px; border-radius: 50%; border: 2px solid var(--text-dim); box-sizing: border-box; transition: border-color .15s ease, background .15s ease, box-shadow .15s ease; }
  .wf-check span::before { border-radius: 5px; }
  .wf-choice:hover span { border-color: color-mix(in srgb, var(--wf) 45%, var(--border)); }
  .wf-choice:active span { transform: scale(.985); }
  .wf-choice input:checked + span { border-color: var(--wf); background: color-mix(in srgb, var(--wf) 12%, transparent); font-weight: 600; }
  .wf-choice input:checked + span::before { border-color: var(--wf); background: var(--wf); box-shadow: inset 0 0 0 3px var(--card); }
  .wf-choice input:focus-visible + span { box-shadow: 0 0 0 3px color-mix(in srgb, var(--wf) 25%, transparent); }
  .wf-err { margin: 0; font-size: 13px; color: var(--red); min-height: 0; }
  .wf-err:empty { display: none; }
  .wf-foot { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding-top: 4px; }
  .wf-foot .btn.is-sending { opacity: .7; pointer-events: none; }
  .wf-done { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 34px 22px; }
  .wf-done h2 { margin: 0; font-size: 22px; }
  .wf-done p { margin: 0; color: var(--text-muted); white-space: pre-line; max-width: 56ch; }
  .wf-done-icon { color: var(--green); animation: wfPop .55s cubic-bezier(.34, 1.56, .64, 1) both; }
  .wf-refused { display: flex; align-items: flex-start; gap: 12px; color: var(--text-muted); }
  .wf-refused p { margin: 0; font-size: 15px; line-height: 1.55; }
  .wf-refused :global(svg) { color: var(--yellow); flex: none; margin-top: 3px; }
  @keyframes wfIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes wfPop { from { opacity: 0; transform: scale(.6); } to { opacity: 1; transform: none; } }
  @keyframes wfBlink { 50% { opacity: 0; } }
  @keyframes wfFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  @media (prefers-reduced-motion: reduce) { .wf-card, .wf-head, .wf-q, .wf-done-icon, .wf-mascot, .wf-caret { animation: none; } }
  @media (max-width: 520px) { .wf { padding-top: 24px; } .wf-card, .wf-head { padding: 18px 16px; } .wf-q { padding: 14px; } .wf-choices { grid-template-columns: 1fr; } }
</style>
