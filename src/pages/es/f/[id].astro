---
export const prerender = false;
// The old address of a form (/f/<public id>, before the language moved to the path and the id to the hash): it goes to the page of
// the form, /form#<public id> in this language.
import { PUBLIC_ID, formPagePath } from '../../../utils/forms';
const id = String(Astro.params.id ?? '');
if (!PUBLIC_ID.test(id)) return new Response(null, { status: 404 });
return new Response(null, { status: 302, headers: { Location: `${formPagePath('es')}#${id}`, 'Cache-Control': 'no-store' } });
---
