---
export const prerender = false;
// The form page lives at /f/<id> for every language: this sets the language and goes there.
const id = /^\d{1,15}$/.test(String(Astro.params.id ?? '')) ? String(Astro.params.id) : '';
Astro.cookies.set('petto_lang', 'es', { path: '/', maxAge: 60 * 60 * 24 * 365, sameSite: 'lax', secure: Astro.url.protocol === 'https:' });
return Astro.redirect(id ? `/f/${id}` : '/');
---
