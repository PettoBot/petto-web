---
// Rendered on request (not prerendered): the versions that the team writes in the dashboard show up without a deploy. A version that does not exist answers 404 (Astro then draws the page of 404 in the language of the address).
export const prerender = false;
import Changelog from '../../../components/Changelog.astro';
import { changelogEntries } from '../../../utils/changelogFeed';
const { version } = Astro.params;
if (!(await changelogEntries('es', Astro)).some((entry) => entry.version === version)) Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=60, stale-while-revalidate=300');
---
<Changelog lang="es" version={version} />
