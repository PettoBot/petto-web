---
export const prerender = false;
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import FeedbackStyles from '../../components/feedback/FeedbackStyles.astro';
import { ago, avatarOf, KIND_ICON, KIND_LABEL, score, STATUS_LABEL, TAG_LABEL } from '../../components/feedback/feedbackUi';
import { getDashLang, makeT } from '../../i18n/dash';
import { getDashboardSession } from '../../utils/dashAuth';
import { EMOJI, emojiUrl, KINDS, listPosts, SORTS, STATUSES, TAGS, votesOf } from '../../utils/feedback';

const lang = getDashLang(Astro);
const dt = makeT(lang);
const session = await getDashboardSession(Astro);
const q = Astro.url.searchParams;
const kind = q.get('kind') ?? '';
const status = q.get('status') ?? '';
const tag = q.get('tag') ?? '';
const sort = q.get('sort') ?? 'top';
const search = q.get('q') ?? '';
const page = Number(q.get('page') ?? 1) || 1;
const result = await listPosts(Astro, { kind, status, tag, sort, q: search, page });
const mine = session && result ? await votesOf(Astro, session.userId, result.posts.map((post) => post.id)) : new Map<number, number>();

const href = (changes: Record<string, string | number>) => {
  const next = new URLSearchParams();
  const base: Record<string, string> = { kind, status, tag, sort: sort === 'top' ? '' : sort, q: search };
  for (const [key, value] of Object.entries({ ...base, ...Object.fromEntries(Object.entries(changes).map(([k, v]) => [k, String(v)])) })) if (value) next.set(key, value);
  const text = next.toString();
  return `/feedback${text ? `?${text}` : ''}`;
};
const flash = q.get('deleted') ? dt('The post was deleted.') : '';
---
<Base title={`${dt('Feedback')} · Petto`} lang={lang} description={dt('Ideas, feedback and bugs for Petto. Write yours and vote on the ones you want.')}>
  <FeedbackStyles />
  <main class="fb-wrap" data-no-loader>
    <div class="fb-head">
      <div>
        <div class="fb-eyebrow"><img src={emojiUrl(EMOJI.suggest)} alt="" width="20" height="20" />{dt('Feedback')}</div>
        <h1>{dt('Tell us what Petto needs')}</h1>
        <p class="fb-lede">{dt('Ideas, feedback and bugs. Write yours, vote on the ones you want, and see what the team plans.')}</p>
      </div>
      <a class="btn btn-accent" href={session ? '/feedback/new' : '/feedback/login?next=/feedback/new'}>{dt('New post')}</a>
    </div>

    {flash && <div class="fb-flash ok"><Icon name="ph:check-circle-fill" width="15" height="15" />{flash}</div>}
    {!result && <div class="fb-flash warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('The board is not available right now. Try again in a moment.')}</div>}

    <div class="fb-filters">
      <form class="fb-search" method="GET" action="/feedback">
        <input type="search" name="q" value={search} placeholder={dt('Search posts')} maxlength="60" aria-label={dt('Search posts')} />
        {kind && <input type="hidden" name="kind" value={kind} />}
        {tag && <input type="hidden" name="tag" value={tag} />}
        {status && <input type="hidden" name="status" value={status} />}
        <select name="sort" aria-label={dt('Sort')} onchange="this.form.submit()">
          {SORTS.map((value) => <option value={value} selected={value === sort}>{value === 'top' ? dt('Top') : value === 'new' ? dt('Newest') : dt('Most discussed')}</option>)}
        </select>
        <button class="btn btn-ghost btn-sm" type="submit">{dt('Search')}</button>
      </form>
      <div class="fb-chips" aria-label={dt('Type')}>
        <a class:list={['fb-chip', { on: !kind }]} href={href({ kind: '', page: 1 })}>{dt('All')}</a>
        {KINDS.map((value) => <a class:list={['fb-chip', { on: kind === value }]} href={href({ kind: value, page: 1 })}><Icon name={KIND_ICON[value]} width="13" height="13" />{dt(KIND_LABEL[value])}</a>)}
      </div>
      <div class="fb-chips" aria-label={dt('State')}>
        <a class:list={['fb-chip', { on: !status }]} href={href({ status: '', page: 1 })}>{dt('Any state')}</a>
        {STATUSES.map((value) => <a class:list={['fb-chip', { on: status === value }]} href={href({ status: value, page: 1 })}>{dt(STATUS_LABEL[value])}</a>)}
      </div>
      <div class="fb-chips" aria-label={dt('Topic')}>
        <a class:list={['fb-chip', { on: !tag }]} href={href({ tag: '', page: 1 })}>{dt('Any topic')}</a>
        {TAGS.map((value) => <a class:list={['fb-chip', { on: tag === value }]} href={href({ tag: value, page: 1 })}>{dt(TAG_LABEL[value])}</a>)}
      </div>
    </div>

    {result && result.posts.length === 0 && <div class="fb-empty">{dt('No posts here yet. Be the first one!')}</div>}
    <div class="fb-list">
      {result?.posts.map((post) => {
        const vote = mine.get(post.id) ?? 0;
        return (
          <article class="fb-card" data-post={post.id}>
            <div class="fb-vote" data-vote-box data-post={post.id} data-login={session ? '' : 'yes'}>
              <button type="button" data-value="1" class:list={{ on: vote === 1 }} aria-label={dt('Like')} title={dt('Like')}><img src={emojiUrl(EMOJI.like)} alt="" width="22" height="22" /></button>
              <span class="fb-score" data-score>{score(post)}</span>
              <button type="button" data-value="-1" class:list={{ on: vote === -1 }} aria-label={dt('Dislike')} title={dt('Dislike')}><img src={emojiUrl(EMOJI.dislike)} alt="" width="22" height="22" /></button>
            </div>
            <div class="fb-main">
              <a class="fb-title" href={`/feedback/${post.id}`}>{post.title}</a>
              {post.body && <p class="fb-excerpt">{post.body}</p>}
              <div class="fb-meta">
                <span class:list={['fb-badge', `k-${post.kind}`]}><Icon name={KIND_ICON[post.kind]} width="12" height="12" />{dt(KIND_LABEL[post.kind])}</span>
                {post.status !== 'open' && <span class:list={['fb-badge', `s-${post.status}`]}>{dt(STATUS_LABEL[post.status])}</span>}
                {post.tags?.map((value) => <span class="fb-tag">{dt(TAG_LABEL[value] ?? value)}</span>)}
                <span class="fb-by"><img src={avatarOf(post.user_id, post.avatar)} alt="" width="18" height="18" loading="lazy" />{post.username || dt('Someone')}</span>
                <span>{ago(post.created_at, lang)}</span>
                <a class="fb-link" href={`/feedback/${post.id}#comments`}><Icon name="ph:chat-circle-fill" width="12" height="12" /> {post.comments_count}</a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    {result && result.pages > 1 && (
      <nav class="fb-pager" aria-label={dt('Pages')}>
        {page > 1 && <a class="fb-chip" href={href({ page: page - 1 })}>← {dt('Previous')}</a>}
        <span>{dt('Page {a} of {b}', { a: Math.min(page, result.pages), b: result.pages })}</span>
        {page < result.pages && <a class="fb-chip" href={href({ page: page + 1 })}>{dt('Next')} →</a>}
      </nav>
    )}
  </main>
</Base>

<script>
  // A vote is sent right away and the list is updated, without leaving the page. Not logged in: the button goes to the login.
  document.querySelectorAll<HTMLElement>('[data-vote-box]').forEach((box) => {
    box.querySelectorAll<HTMLButtonElement>('button[data-value]').forEach((button) => {
      button.addEventListener('click', async () => {
        if (box.dataset.login) { location.href = '/feedback/login?next=/feedback'; return; }
        button.disabled = true;
        try {
          const response = await fetch(`/api/feedback/${box.dataset.post}/vote`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ value: Number(button.dataset.value) }) });
          if (response.status === 401) { location.href = '/feedback/login?next=/feedback'; return; }
          const data = await response.json();
          if (data.ok) {
            box.querySelector('[data-score]')!.textContent = String(data.up - data.down);
            box.querySelectorAll('button[data-value]').forEach((other) => other.classList.toggle('on', Number((other as HTMLElement).dataset.value) === data.vote));
          }
        } finally { button.disabled = false; }
      });
    });
  });
</script>
