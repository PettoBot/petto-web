---
export const prerender = false;
import { Icon } from 'astro-icon/components';
import Base from '../../layouts/Base.astro';
import FeedbackStyles from '../../components/feedback/FeedbackStyles.astro';
import { KIND_ICON, KIND_LABEL, TAG_LABEL } from '../../components/feedback/feedbackUi';
import { getDashLang, makeT } from '../../i18n/dash';
import { getDashboardSession } from '../../utils/dashAuth';
import { EMOJI, emojiUrl, KINDS, LIMITS, TAGS } from '../../utils/feedback';

const lang = getDashLang(Astro);
const dt = makeT(lang);
const session = await getDashboardSession(Astro);
if (!session) return Astro.redirect('/feedback/login?next=/feedback/new');
const error = Astro.url.searchParams.get('error');
const message = error === 'rate' ? dt('You wrote many posts today. Try again tomorrow.') : error === 'invalid' ? dt('Check the title (3 characters or more) and the text (10 characters or more).') : error ? dt('The post could not be saved. Try again in a moment.') : '';
---
<Base title={`${dt('New post')} · Petto`} lang={lang} description={dt('Ideas, feedback and bugs for Petto. Write yours and vote on the ones you want.')}>
  <FeedbackStyles />
  <main class="fb-wrap" data-no-loader>
    <p><a class="fb-link" href="/feedback">← {dt('All posts')}</a></p>
    <div class="fb-eyebrow"><img src={emojiUrl(EMOJI.suggest)} alt="" width="20" height="20" />{dt('Feedback')}</div>
    <h1 style="margin: 6px 0 16px;">{dt('New post')}</h1>
    {message && <div class="fb-flash warn"><Icon name="ph:warning-fill" width="15" height="15" />{message}</div>}

    <form class="fb-form" method="POST" action="/api/feedback">
      <div class="fb-field"><label>{dt('Type')}</label>
        <div class="fb-chips">
          {KINDS.map((value, index) => <label class="fb-check"><input type="radio" name="kind" value={value} checked={index === 0} /><Icon name={KIND_ICON[value]} width="14" height="14" />{dt(KIND_LABEL[value])}</label>)}
        </div>
      </div>
      <div class="fb-field"><label for="fb-title">{dt('Title')}</label>
        <input id="fb-title" name="title" required minlength="3" maxlength={LIMITS.title} placeholder={dt('A short title')} /></div>
      <div class="fb-field"><label for="fb-body">{dt('Details')}</label>
        <textarea id="fb-body" name="body" required minlength="10" maxlength={LIMITS.body} placeholder={dt('What do you want, why, and an example. For a bug: what happened and what you expected.')}></textarea></div>
      <div class="fb-field"><label>{dt('Topics')} <span class="fb-hint" style="text-transform: none;">({dt('up to {a}', { a: LIMITS.tags })})</span></label>
        <div class="fb-chips">{TAGS.map((value) => <label class="fb-check"><input type="checkbox" name="tags" value={value} />{dt(TAG_LABEL[value])}</label>)}</div></div>
      <div class="fb-trap" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off" /></div>
      <p class="fb-hint">{dt('Your Discord name and avatar are shown on the post. It is also shown in the Petto server, where people can vote with reactions.')}</p>
      <div class="fb-actions"><button class="btn btn-accent" type="submit">{dt('Publish')}</button><a class="fb-link" href="/feedback">{dt('Cancel')}</a></div>
    </form>
  </main>
</Base>

<script>
  // At most three topics: the fourth one that is picked is left unchecked.
  const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="tags"]'));
  boxes.forEach((box) => box.addEventListener('change', () => {
    if (boxes.filter((item) => item.checked).length > 3) box.checked = false;
  }));
</script>
