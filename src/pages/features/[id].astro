---
import FeatureShare from '../../components/FeatureShare.astro';
import { featuresCopy } from '../../data/featuresPage';
export function getStaticPaths() {
  return featuresCopy.en.groups.map((g) => ({ params: { id: g.id } }));
}
const { id } = Astro.params;
---
<FeatureShare lang="en" id={id as string} />
