---
export const prerender = false;
import DashMe from '../../components/DashMe.astro';
import { getDashboardSession } from '../../utils/dashAuth';
import { loadSwitcherServers } from '../../utils/dashSwitcherData';
import { getPersonalSettings } from '../../utils/dashPersonal';
import { getPremiumSnapshot } from '../../utils/premium';
import { profileOverview } from '../../utils/dashProfile.mjs';

const session = await getDashboardSession(Astro);
if (!session) {
  Astro.cookies.set('petto_after_login', `${Astro.url.pathname}${Astro.url.search}`, { httpOnly: true, secure: Astro.url.protocol === 'https:', sameSite: 'lax', path: '/', maxAge: 10 * 60 });
  return Astro.redirect('/dash');
}

// The servers come from the lists the server picker already caches; Premium and the two personal rows are small cached reads.
const [servers, premium, personal] = await Promise.all([
  loadSwitcherServers(Astro, session),
  getPremiumSnapshot(Astro, session.userId).catch(() => null),
  getPersonalSettings(Astro, session.userId).catch(() => ({ prefix: null, reputation: null })),
]);
const overview = profileOverview({
  session,
  servers,
  premium: premium && { status: premium.status, slotsUsed: premium.slotsUsed, slotsTotal: premium.slotsTotal, periodEnd: premium.entitlement?.current_period_end },
  prefix: personal.prefix,
  reputation: personal.reputation,
});
---
<DashMe user={session} overview={overview} unavailable={servers.unavailable} />
