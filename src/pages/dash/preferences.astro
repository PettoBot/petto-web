---
export const prerender = false;
import DashPreferences from '../../components/DashPreferences.astro';
import { getDashboardSession } from '../../utils/dashAuth';
import { getPersonalSettings } from '../../utils/dashPersonal';
import { read } from '../../utils/premium';
import { getEnv } from '../../utils/env';
import { getDashLang, makeT } from '../../i18n/dash';
const dt = makeT(getDashLang(Astro));

const session = await getDashboardSession(Astro);
if (!session) {
  Astro.cookies.set('petto_after_login', `${Astro.url.pathname}${Astro.url.search}`, { httpOnly: true, secure: Astro.url.protocol === 'https:', sameSite: 'lax', path: '/', maxAge: 10 * 60 });
  return Astro.redirect('/dash');
}

// The contact email: optional, written only by the person (the Terms say Petto may write to it about the policies and about what was asked to delete). It is one row of `user_contact`.
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');
const EMAIL = /^[^\s@<>()\[\]\\,;:"]{1,64}@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+$/;
let contactMessage: { ok: boolean; text: string } | null = null;
if (Astro.request.method === 'POST' && apiUrl && apiKey) {
  const origin = Astro.request.headers.get('origin');
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const headers = { apikey: apiKey, Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' };
  if (origin && origin !== Astro.url.origin) contactMessage = { ok: false, text: dt('That could not be done. Try again in a moment.') };
  else if (action === 'contact_save') {
    const email = String(form.get('email') ?? '').trim().toLowerCase();
    if (email.length < 5 || email.length > 254 || !EMAIL.test(email)) contactMessage = { ok: false, text: dt('That does not look like an email address.') };
    else {
      const res = await fetch(`${apiUrl}/rest/v1/user_contact?on_conflict=user_id`, { method: 'POST', headers: { ...headers, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify({ user_id: session.userId, email, updated_at: new Date().toISOString() }) }).catch(() => null);
      contactMessage = res?.ok ? { ok: true, text: dt('Saved.') } : { ok: false, text: dt('That could not be done. Try again in a moment.') };
    }
  } else if (action === 'contact_discord') {
    // The email of the Discord account comes from the session (never from the form): it is saved only when the person presses the button.
    const email = session.discordEmail ?? '';
    if (!email || !EMAIL.test(email)) contactMessage = { ok: false, text: dt('Discord did not give a verified email. Type one instead.') };
    else {
      const res = await fetch(`${apiUrl}/rest/v1/user_contact?on_conflict=user_id`, { method: 'POST', headers: { ...headers, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify({ user_id: session.userId, email, updated_at: new Date().toISOString() }) }).catch(() => null);
      contactMessage = res?.ok ? { ok: true, text: dt('Saved.') } : { ok: false, text: dt('That could not be done. Try again in a moment.') };
    }
  } else if (action === 'contact_remove') {
    const res = await fetch(`${apiUrl}/rest/v1/user_contact?user_id=eq.${session.userId}`, { method: 'DELETE', headers }).catch(() => null);
    contactMessage = res?.ok ? { ok: true, text: dt('Your email was deleted.') } : { ok: false, text: dt('That could not be done. Try again in a moment.') };
  }
}

// The personal prefix and the reputation are the same two small cached reads as the overview; a failed read is the same as "nothing set".
const [personal, optout, contact] = await Promise.all([
  getPersonalSettings(Astro, session.userId).catch(() => ({ prefix: null, reputation: null })),
  // Whether the account asked Petto not to save its name history (the switch of the History page).
  read<{ user_id: string }>(Astro, 'identity_history_optout', `user_id=eq.${session.userId}&select=user_id`),
  read<{ email: string }>(Astro, 'user_contact', `user_id=eq.${session.userId}&select=email`),
]);
---
<DashPreferences user={session} prefix={personal.prefix} reputation={personal.reputation} historyOff={optout.length > 0} contactEmail={contact[0]?.email ?? null} contactMessage={contactMessage} />
