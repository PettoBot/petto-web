---
export const prerender = false;
import DashManage from '../../../components/DashManage.astro';
import { getDashboardSession } from '../../../utils/dashAuth';
import { canManageGuild, guildIconUrl } from '../../../utils/discord';
import { getCachedUserGuilds, getCachedBotGuildIds, getBotGuildList } from '../../../utils/discordCache';
import { getEnv } from '../../../utils/env';
import { canEditPartners } from '../../../utils/partners';
import { isPettoOwner } from '../../../utils/premiumAdmin';
import { getPremiumGuildIds } from '../../../utils/premium';
import { guildsWithRoleAccess } from '../../../utils/dashAccess';
import { botInviteUrl } from '../../../utils/dashSwitcher.mjs';

const clientId = getEnv(Astro, 'DISCORD_CLIENT_ID');
const botToken = getEnv(Astro, 'DISCORD_TOKEN');

const session = await getDashboardSession(Astro);
if (!session) {
  return Astro.redirect('/dash');
}

// Nothing here depends on anything else, so they all start at once: the visitor's servers (Discord), the bot's servers,
// and the Premium state.
const [guildsResult, botGuildIds, botGuildList] = await Promise.all([
  getCachedUserGuilds(session.accessToken, Astro.request).then((list) => ({ list }), () => ({ list: null as any[] | null })),
  botToken ? getCachedBotGuildIds(botToken, Astro.request) : Promise.resolve(new Set<string>()),
  // Only used to sort by members, so a failure just leaves the order by name.
  botToken ? getBotGuildList(botToken).catch(() => []) : Promise.resolve([]),
]);
const discordUnavailable = guildsResult.list === null;
const manageable = (guildsResult.list ?? []).filter(canManageGuild);
const memberCounts = new Map(botGuildList.map((guild) => [guild.id, guild.memberCount]));
// Premium belongs to the server, so an admin who did not buy it sees it too. Premium, the servers opened by a role and the partners
// link do not depend on each other, so they are read at once.
const manageableIds = new Set(manageable.map((g: any) => g.id));
// Servers where the visitor does not manage anything but a role of theirs opens part of the dashboard.
const roleCandidates = (guildsResult.list ?? []).filter((g: any) => !manageableIds.has(g.id) && botGuildIds.has(g.id));
const [premiumGuildIds, byRoleList, canPartners] = await Promise.all([
  getPremiumGuildIds(Astro, session.userId, manageable.filter((g: any) => botGuildIds.has(g.id)).map((g: any) => g.id)),
  guildsWithRoleAccess(Astro, session.userId, roleCandidates.map((g: any) => g.id)),
  canEditPartners(Astro, session.userId),
]);
const byRole = new Set(byRoleList);
const roleGuilds = roleCandidates.filter((g: any) => byRole.has(g.id));

const guilds = [...manageable, ...roleGuilds]
  .map((g: any) => ({
    id: g.id,
    name: g.name,
    icon: guildIconUrl(g),
    tag: byRole.has(g.id) ? 'Role access' : g.owner ? 'Owner' : 'Administrator',
    active: botGuildIds.has(g.id),
    premiumActive: premiumGuildIds.has(g.id),
    memberCount: memberCounts.get(g.id) ?? null,
  }))
  // Where Petto is: the biggest first. Where it is not: by name.
  .sort((a: any, b: any) => (a.active !== b.active ? Number(b.active) - Number(a.active) : a.active ? (b.memberCount ?? -1) - (a.memberCount ?? -1) || a.name.localeCompare(b.name) : a.name.localeCompare(b.name)));

const inviteUrl = (guildId: string) => botInviteUrl(String(clientId), guildId);
const isOwner = isPettoOwner(Astro, session.userId);
---
<DashManage user={session} guilds={guilds} inviteUrl={inviteUrl} isOwner={isOwner} canPartners={canPartners} error={discordUnavailable ? 'discord_unavailable' : undefined} />
