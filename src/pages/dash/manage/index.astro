---
export const prerender = false;
import DashManage from '../../../components/DashManage.astro';
import { getDashboardSession } from '../../../utils/dashAuth';
import { canManageGuild, guildIconUrl } from '../../../utils/discord';
import { getCachedUserGuilds, getCachedBotGuildIds } from '../../../utils/discordCache';
import { getEnv } from '../../../utils/env';
import { isPettoOwner } from '../../../utils/premiumAdmin';
import { getPremiumSnapshot } from '../../../utils/premium';

const clientId = getEnv(Astro, 'DISCORD_CLIENT_ID');
const botToken = getEnv(Astro, 'DISCORD_TOKEN');

const session = await getDashboardSession(Astro);
if (!session) {
  return Astro.redirect('/dash');
}

// Nothing here depends on anything else, so they all start at once: the visitor's servers (Discord), the bot's servers,
// and the Premium state.
const [guildsResult, botGuildIds, premiumSnapshot] = await Promise.all([
  getCachedUserGuilds(session.accessToken, Astro.request).then((list) => ({ list }), () => ({ list: null as any[] | null })),
  botToken ? getCachedBotGuildIds(botToken, Astro.request) : Promise.resolve(new Set<string>()),
  getPremiumSnapshot(Astro, session.userId),
]);
const discordUnavailable = guildsResult.list === null;
const manageable = (guildsResult.list ?? []).filter(canManageGuild);
const premiumGuildIds = new Set(premiumSnapshot.assignments.map((assignment) => assignment.guild_id));

const guilds = manageable
  .map((g: any) => ({
    id: g.id,
    name: g.name,
    icon: guildIconUrl(g),
    tag: g.owner ? 'Owner' : 'Administrator',
    active: botGuildIds.has(g.id),
    premiumActive: premiumGuildIds.has(g.id),
  }))
  .sort((a: any, b: any) => Number(b.active) - Number(a.active));

const inviteUrl = (guildId: string) =>
  `https://discord.com/api/oauth2/authorize?client_id=${clientId}&permissions=8&scope=${encodeURIComponent('bot applications.commands')}&guild_id=${guildId}&disable_guild_select=true`;
const isOwner = isPettoOwner(Astro, session.userId);
---
<DashManage user={session} guilds={guilds} inviteUrl={inviteUrl} isOwner={isOwner} error={discordUnavailable ? 'discord_unavailable' : undefined} />
