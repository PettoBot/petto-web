---
export const prerender = false;
import DashDaily from '../../components/DashDaily.astro';
import { getDashboardSession } from '../../utils/dashAuth';
import { callPettoCeramos } from '../../utils/pettoBotApi';

const session = await getDashboardSession(Astro);
if (!session) {
  Astro.cookies.set('petto_after_login', `${Astro.url.pathname}${Astro.url.search}`, { httpOnly: true, secure: Astro.url.protocol === 'https:', sameSite: 'lax', path: '/', maxAge: 10 * 60 });
  return Astro.redirect('/dash');
}
const [state, catalog, ledger] = await Promise.all([callPettoCeramos(Astro, session.userId, 'state'), callPettoCeramos(Astro, session.userId, 'catalog'), callPettoCeramos(Astro, session.userId, 'ledger')]);
---
<DashDaily user={session} state={state.ok ? state.data : null} plans={catalog.ok ? catalog.data.plans : null} movements={ledger.ok ? ledger.data.movements : null} />
