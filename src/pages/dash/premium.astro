---
export const prerender = false;
import DashPremium from '../../components/DashPremium.astro';
import { getDashboardSession } from '../../utils/dashAuth';
import { canManageGuild, guildIconUrl } from '../../utils/discord';
import { getCachedBotGuildIds, getCachedUserGuilds } from '../../utils/discordCache';
import { getEnv } from '../../utils/env';
import { cancelPremiumServerRequest, createPremiumCheckout, getPremiumSnapshot, releasePremiumServer, requestPremiumServer } from '../../utils/premium';

const session = await getDashboardSession(Astro);
if (!session) return Astro.redirect('/dash');

let discordGuilds: any[] = [];
let discordUnavailable = false;
try {
  discordGuilds = await getCachedUserGuilds(session.accessToken);
} catch {
  discordUnavailable = true;
}

const manageable = discordGuilds.filter(canManageGuild);
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const botGuildIds = botToken ? await getCachedBotGuildIds(botToken) : new Set<string>();

let actionError: string | undefined;
const method = Astro.request.method.toUpperCase();
if (method === 'POST' && !discordUnavailable) {
  const form = await Astro.request.formData();
  const guildId = String(form.get('guild_id') ?? '');
  const action = String(form.get('action') ?? '');
  const guild = manageable.find((item: any) => item.id === guildId);

  if (action === 'checkout') {
    const checkoutUrl = await createPremiumCheckout(Astro, session.userId, String(form.get('plan') ?? ''));
    if (checkoutUrl) return Astro.redirect(checkoutUrl, 303);
    actionError = 'checkout_unavailable';
  } else if (!guild) {
    actionError = 'not_manageable';
  } else if (action === 'request' && !botGuildIds.has(guildId)) {
    actionError = 'request_failed';
  } else if (action === 'request') {
    if (await requestPremiumServer(Astro, session.userId, guildId)) return Astro.redirect('/dash/premium?saved=1');
    actionError = 'request_failed';
  } else if (action === 'cancel') {
    if (await cancelPremiumServerRequest(Astro, session.userId, guildId)) return Astro.redirect('/dash/premium?saved=1');
    actionError = 'request_failed';
  } else if (action === 'release') {
    if (await releasePremiumServer(Astro, session.userId, guildId)) return Astro.redirect('/dash/premium?saved=1');
    actionError = 'request_failed';
  }
}

const snapshot = await getPremiumSnapshot(Astro, session.userId);
const guilds = manageable
  .map((guild: any) => ({
    id: guild.id,
    name: guild.name,
    icon: guildIconUrl(guild),
    tag: guild.owner ? 'Owner' : 'Administrator',
    active: botGuildIds.has(guild.id),
  }))
  .sort((a: any, b: any) => Number(b.active) - Number(a.active) || a.name.localeCompare(b.name));

  const error = actionError ?? (discordUnavailable ? 'discord_unavailable' : undefined);
const saved = Astro.url.searchParams.get('saved') === '1';
const checkoutReady = Boolean(getEnv(Astro, 'POLAR_ACCESS_TOKEN'));
---

<DashPremium
  user={session}
  guilds={guilds}
  status={snapshot.status}
  slotsUsed={snapshot.slotsUsed}
  slotsTotal={snapshot.slotsTotal}
  assignedGuildIds={snapshot.assignments.map((assignment) => assignment.guild_id)}
  requestedGuildIds={snapshot.requests.map((request) => request.guild_id)}
  checkoutReady={checkoutReady}
  error={error}
  saved={saved}
/> 
