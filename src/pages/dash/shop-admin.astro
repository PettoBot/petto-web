---
export const prerender = false;
import DashShopAdmin from '../../components/DashShopAdmin.astro';
import { getDashboardSession } from '../../utils/dashAuth';
import { isPettoOwner } from '../../utils/premiumAdmin';
import { callPettoCeramos } from '../../utils/pettoBotApi';

const session = await getDashboardSession(Astro);
if (!session) {
  Astro.cookies.set('petto_after_login', `${Astro.url.pathname}${Astro.url.search}`, { httpOnly: true, secure: Astro.url.protocol === 'https:', sameSite: 'lax', path: '/', maxAge: 10 * 60 });
  return Astro.redirect('/dash');
}
// Only the owner; anybody else sees a plain 404, as with the other staff pages.
if (!isPettoOwner(Astro, session.userId)) return new Response('Not found', { status: 404 });
const asked = Astro.url.searchParams.get('tab');
const tab = asked === 'packs' || asked === 'banners' || asked === 'fonts' ? asked : 'builtin';
const shop = await callPettoCeramos(Astro, session.userId, 'admin/shop');
---
<DashShopAdmin user={session} data={shop.ok ? { packs: shop.data.packs, items: shop.data.items, builtIn: shop.data.builtIn } : null} tab={tab} />
