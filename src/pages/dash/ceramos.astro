---
export const prerender = false;
import DashCeramosLog from '../../components/DashCeramosLog.astro';
import { getDashboardSession } from '../../utils/dashAuth';
import { callPettoCeramos } from '../../utils/pettoBotApi';

const session = await getDashboardSession(Astro);
if (!session) {
  Astro.cookies.set('petto_after_login', `${Astro.url.pathname}${Astro.url.search}`, { httpOnly: true, secure: Astro.url.protocol === 'https:', sameSite: 'lax', path: '/', maxAge: 10 * 60 });
  return Astro.redirect('/dash');
}
const [ledger, state] = await Promise.all([callPettoCeramos(Astro, session.userId, 'ledger'), callPettoCeramos(Astro, session.userId, 'state')]);
---
<DashCeramosLog user={session} balance={state.ok ? state.data.balance : null} movements={ledger.ok ? ledger.data.movements : null} />
