---
export const prerender = false;
import DashCeramosAdmin from '../../components/DashCeramosAdmin.astro';
import { getDashboardSession } from '../../utils/dashAuth';
import { callPettoCeramos } from '../../utils/pettoBotApi';

const session = await getDashboardSession(Astro);
if (!session) {
  Astro.cookies.set('petto_after_login', `${Astro.url.pathname}${Astro.url.search}`, { httpOnly: true, secure: Astro.url.protocol === 'https:', sameSite: 'lax', path: '/', maxAge: 10 * 60 });
  return Astro.redirect('/dash');
}
// The bot says whether this person may give ceramos (the owner and the people the owner listed); anybody else sees a plain 404.
const state = await callPettoCeramos(Astro, session.userId, 'admin/grant');
if (state.ok && state.data && state.data.allowed === false) return new Response('Not found', { status: 404 });
---
<DashCeramosAdmin user={session} data={state.ok ? state.data : null} />
