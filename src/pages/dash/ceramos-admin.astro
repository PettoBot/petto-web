---
export const prerender = false;
import DashCeramosAdmin from '../../components/DashCeramosAdmin.astro';
import { getDashboardSession } from '../../utils/dashAuth';
import { staffProblem } from '../../utils/staffProblem';
import { isPettoOwner } from '../../utils/premiumAdmin';
import { callPettoCeramos } from '../../utils/pettoBotApi';

const session = await getDashboardSession(Astro);
if (!session) {
  Astro.cookies.set('petto_after_login', `${Astro.url.pathname}${Astro.url.search}`, { httpOnly: true, secure: Astro.url.protocol === 'https:', sameSite: 'lax', path: '/', maxAge: 10 * 60 });
  return Astro.redirect('/dash');
}
// The bot says whether this person may give ceramos (the owner and the people the owner listed); anybody else sees a plain 404.
const state = await callPettoCeramos(Astro, session.userId, 'admin/grant');
// The owner of the website is never sent to a 404: if the bot does not agree that this account is the owner, the page says so (see utils/staffProblem.ts).
const owner = isPettoOwner(Astro, session.userId);
if (state.ok && state.data && state.data.allowed === false && !owner) return new Response('Not found', { status: 404 });
const mismatch = owner && state.ok && state.data && state.data.allowed === false;
const problem = mismatch ? 'forbidden' : staffProblem(state);
---
<DashCeramosAdmin user={session} data={state.ok && !mismatch ? state.data : null} problem={problem ?? undefined} />
