---
export const prerender = false;
import DashRankCard from '../../components/DashRankCard.astro';
import { getDashboardSession } from '../../utils/dashAuth';
import { callPettoCeramos } from '../../utils/pettoBotApi';

const session = await getDashboardSession(Astro);
if (!session) {
  Astro.cookies.set('petto_after_login', `${Astro.url.pathname}${Astro.url.search}`, { httpOnly: true, secure: Astro.url.protocol === 'https:', sameSite: 'lax', path: '/', maxAge: 10 * 60 });
  return Astro.redirect('/dash');
}
// The bot knows the shop, the wallet and what the person saved: the page asks it and draws.
const [rank, catalog, state] = await Promise.all([callPettoCeramos(Astro, session.userId, 'rank-card'), callPettoCeramos(Astro, session.userId, 'catalog'), callPettoCeramos(Astro, session.userId, 'state')]);
const ok = rank.ok && catalog.ok && state.ok;
---
<DashRankCard user={session} rank={ok ? rank.data : null} catalog={ok ? catalog.data : null} state={ok ? state.data : null} />
