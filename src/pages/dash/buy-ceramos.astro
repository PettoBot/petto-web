---
export const prerender = false;
import DashBuyCeramos from '../../components/DashBuyCeramos.astro';
import { getDashboardSession } from '../../utils/dashAuth';
import { callPettoCeramos } from '../../utils/pettoBotApi';
import { isPettoOwner } from '../../utils/premiumAdmin';
import { coinCheckoutReady } from '../../utils/premium';

const session = await getDashboardSession(Astro);
if (!session) {
  Astro.cookies.set('petto_after_login', `${Astro.url.pathname}${Astro.url.search}`, { httpOnly: true, secure: Astro.url.protocol === 'https:', sameSite: 'lax', path: '/', maxAge: 10 * 60 });
  return Astro.redirect('/dash');
}
const [catalog, state] = await Promise.all([callPettoCeramos(Astro, session.userId, 'catalog'), callPettoCeramos(Astro, session.userId, 'state')]);
const packs = catalog.ok ? (catalog.data.coinPacks as { id: string; coins: number; price: number }[]) : null;
// What Polar answered is shown only to the owner (see plans/checkout.ts and ceramos/checkout.ts).
const why = isPettoOwner(Astro, session.userId) ? (Astro.url.searchParams.get('why') ?? '').slice(0, 220) : '';
const ready = coinCheckoutReady(Astro, (packs ?? []).map((pack) => pack.id));
---
<DashBuyCeramos user={session} packs={packs} ready={ready} balance={state.ok ? state.data.balance : null} paid={Astro.url.searchParams.get('paid') === '1'} failed={Astro.url.searchParams.get('error') === 'checkout_unavailable'} why={why} />
