---
export const prerender = false;
import DashLogin from '../../components/DashLogin.astro';
import { getDashboardSession } from '../../utils/dashAuth';
import { managePath } from '../../utils/dashLogin.mjs';

const errorParam = Astro.url.searchParams.get('error');

// Someone who is logged in has nothing to do here: the list of servers (the /es and /pt-br prefix is kept by the middleware).
const session = await getDashboardSession(Astro);
if (session) {
  return Astro.redirect(managePath(errorParam));
}
---
<DashLogin error={errorParam} />
