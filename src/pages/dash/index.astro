---
export const prerender = false;
import Dash from '../../components/Dash.astro';
import { getDashboardSession } from '../../utils/dashAuth';
import { getEnv } from '../../utils/env';

const clientId = getEnv(Astro, 'DISCORD_CLIENT_ID');

let loggedIn = false;
const session = await getDashboardSession(Astro);
loggedIn = !!session;

const redirectUri = `${Astro.url.origin}/dash/callback`;
const authorizeUrl = clientId
  ? `https://discord.com/api/oauth2/authorize?client_id=${clientId}&redirect_uri=${encodeURIComponent(redirectUri)}&response_type=code&scope=${encodeURIComponent('identify guilds')}`
  : null;

const errorParam = Astro.url.searchParams.get('error');
---
<Dash authorizeUrl={authorizeUrl} error={errorParam} loggedIn={loggedIn} />
