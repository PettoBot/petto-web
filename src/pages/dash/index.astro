---
export const prerender = false;
import Dash from '../../components/Dash.astro';
import { getDashboardSession } from '../../utils/dashAuth';
import { dashAuthorizeUrl } from '../../utils/discordLogin';

let loggedIn = false;
const session = await getDashboardSession(Astro);
loggedIn = !!session;

const authorizeUrl = dashAuthorizeUrl(Astro);

const errorParam = Astro.url.searchParams.get('error');
---
<Dash authorizeUrl={authorizeUrl} error={errorParam} loggedIn={loggedIn} />
