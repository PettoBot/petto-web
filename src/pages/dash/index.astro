---
export const prerender = false;
import DashLogin from '../../components/DashLogin.astro';
import { getDashboardSession } from '../../utils/dashAuth';
import { landingPath, loginInfo } from '../../utils/dashLogin.mjs';

const errorParam = Astro.url.searchParams.get('error');
const noticeParam = Astro.url.searchParams.get('notice');

// Someone who is logged in has nothing to do here: their profile (the /es and /pt-br prefix is kept by the middleware).
const session = await getDashboardSession(Astro);
if (session) {
  return Astro.redirect(landingPath(errorParam));
}
---
<DashLogin error={errorParam} info={loginInfo(noticeParam) ?? ((Astro.locals as Record<string, unknown>).sessionStale ? 'relogin' : null)} />
