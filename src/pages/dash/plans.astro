---
export const prerender = false;
import DashPlans from '../../components/DashPlans.astro';
import { getDashboardSession } from '../../utils/dashAuth';
import { callPettoCeramos } from '../../utils/pettoBotApi';

const session = await getDashboardSession(Astro);
if (!session) {
  Astro.cookies.set('petto_after_login', `${Astro.url.pathname}${Astro.url.search}`, { httpOnly: true, secure: Astro.url.protocol === 'https:', sameSite: 'lax', path: '/', maxAge: 10 * 60 });
  return Astro.redirect('/dash');
}
const [catalog, state] = await Promise.all([callPettoCeramos(Astro, session.userId, 'catalog'), callPettoCeramos(Astro, session.userId, 'state')]);
const plans = catalog.ok ? catalog.data.plans : null;
---
<DashPlans user={session} plans={plans ? { bronze: plans.bronze, silver: plans.silver, gold: plans.gold } : null} current={state.ok ? state.data.planInfo : null} />
