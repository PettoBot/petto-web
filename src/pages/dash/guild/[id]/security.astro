---
export const prerender = false;
import DashSecurity from '../../../../components/DashSecurity.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo } from '../../../../utils/discord';
import { runBatched } from '../../../../utils/concurrency';
import { getAllCommands } from '../../../../utils/commandList';

const { id } = Astro.params as { id: string };
const section = Astro.url.searchParams.get('section') ?? 'score';
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const supabaseUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const supabaseKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;

if (!botToken || !supabaseUrl || !supabaseKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const supabaseHeaders = { apikey: supabaseKey, Authorization: `Bearer ${supabaseKey}`, 'Content-Type': 'application/json' };

const [guildInfo, rolesRes, levelsRes, automodRes, antinukeRes, verificationRes, logsRes] = await runBatched([
  () => getGuildInfo(id, botToken),
  () => fetch(`https://discord.com/api/guilds/${id}/roles`, { headers: { Authorization: `Bot ${botToken}` } }),
  () => fetch(`${supabaseUrl}/rest/v1/command_permission_levels?guild_id=eq.${id}&select=command_name,required_level`, { headers: supabaseHeaders }),
  () => fetch(`${supabaseUrl}/rest/v1/automod_config?guild_id=eq.${id}&select=anti_spam_enabled,anti_raid_enabled`, { headers: supabaseHeaders }),
  () => fetch(`${supabaseUrl}/rest/v1/antinuke_config?guild_id=eq.${id}&select=enabled`, { headers: supabaseHeaders }),
  () => fetch(`${supabaseUrl}/rest/v1/verification_config?guild_id=eq.${id}&select=enabled`, { headers: supabaseHeaders }),
  () => fetch(`${supabaseUrl}/rest/v1/log_entries?guild_id=eq.${id}&select=id&limit=1`, { headers: supabaseHeaders }),
], 7);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

const DANGEROUS_PERMS: { flag: bigint; label: string }[] = [
  { flag: 1n << 5n, label: 'Manage Server' },
  { flag: 1n << 28n, label: 'Manage Roles' },
  { flag: 1n << 4n, label: 'Manage Channels' },
  { flag: 1n << 2n, label: 'Ban Members' },
  { flag: 1n << 1n, label: 'Kick Members' },
  { flag: 1n << 40n, label: 'Timeout Members' },
  { flag: 1n << 29n, label: 'Manage Webhooks' },
  { flag: 1n << 13n, label: 'Manage Messages' },
  { flag: 1n << 17n, label: 'Mention @everyone' },
  { flag: 1n << 27n, label: 'Manage Nicknames' },
];
const ADMINISTRATOR = 1n << 3n;

const allRoles = rolesRes.ok ? await rolesRes.json() : [];
const roleFindings = allRoles
  .map((r: any) => {
    const bits = BigInt(r.permissions ?? '0');
    const isAdmin = (bits & ADMINISTRATOR) === ADMINISTRATOR;
    const matched = isAdmin ? [] : DANGEROUS_PERMS.filter((p) => (bits & p.flag) === p.flag).map((p) => p.label);
    const isEveryone = r.name === '@everyone';
    let severity: 'critical' | 'high' | 'medium' | null = null;
    if (isEveryone && (isAdmin || matched.length > 0)) severity = 'critical';
    else if (isAdmin) severity = 'high';
    else if (matched.length > 0) severity = 'medium';
    return { id: r.id, name: r.name, isEveryone, isAdmin, matched, severity, position: r.position };
  })
  .filter((r: any) => r.severity)
  .sort((a: any, b: any) => (b.severity === 'critical' ? 1 : 0) - (a.severity === 'critical' ? 1 : 0) || b.position - a.position);

const levelRows = levelsRes.ok ? await levelsRes.json() : [];
const commandLevels: Record<string, number> = {};
for (const row of levelRows) commandLevels[row.command_name] = row.required_level;

const commands = getAllCommands();
const RISK_CATEGORIES = ['moderation', 'setup', 'automation'];
const unrestrictedCommands = commands.filter((c) => RISK_CATEGORIES.includes(c.category) && !commandLevels[c.name]);

const automodRows = automodRes.ok ? await automodRes.json() : [];
const antinukeRows = antinukeRes.ok ? await antinukeRes.json() : [];
const verificationRows = verificationRes.ok ? await verificationRes.json() : [];
const logRows = logsRes.ok ? await logsRes.json() : [];
const automod = automodRows[0] ?? {};
const protection = {
  antinuke: Boolean(antinukeRows[0]?.enabled),
  antiSpam: Boolean(automod.anti_spam_enabled),
  antiRaid: Boolean(automod.anti_raid_enabled),
  verification: Boolean(verificationRows[0]?.enabled),
  logs: logRows.length > 0,
};
let securityScore = 100;
const recommendations: string[] = [];
const everyoneFinding = roleFindings.find((role: any) => role.isEveryone);
const adminCount = roleFindings.filter((role: any) => role.isAdmin && !role.isEveryone).length;
if (everyoneFinding) { securityScore -= 30; recommendations.push('@everyone tiene permisos elevados.'); }
if (adminCount > 0) { securityScore -= Math.min(30, adminCount * 10); recommendations.push(`${adminCount} rol(es) tienen Administrator.`); }
if (!protection.antinuke) { securityScore -= 15; recommendations.push('Activa anti-nuke para responder a ataques destructivos.'); }
if (!protection.antiSpam) { securityScore -= 10; recommendations.push('Activa anti-spam para bloquear flooding y menciones masivas.'); }
if (!protection.antiRaid) { securityScore -= 10; recommendations.push('Activa anti-raid para detectar oleadas de entradas.'); }
if (!protection.verification) { securityScore -= 5; recommendations.push('Activa la verificación de entrada.'); }
if (!protection.logs) { securityScore -= 10; recommendations.push('Configura al menos un canal de auditoría.'); }
securityScore = Math.max(0, securityScore);
---
<DashSecurity
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.png'}
  roleFindings={roleFindings}
  unrestrictedCommands={unrestrictedCommands}
  securityScore={securityScore}
  protection={protection}
  recommendations={recommendations}
  section={section}
/>
