---
export const prerender = false;
import DashSecurity from '../../../../components/DashSecurity.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';
import { runBatched } from '../../../../utils/concurrency';
import { accessCommands, isSensitive } from '../../../../utils/commandAccess';
import { getDashLang, makeT } from '../../../../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);

const { id } = Astro.params as { id: string };
const section = Astro.url.searchParams.get('section') ?? 'score';
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;

if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const apiHeaders = { apikey: apiKey, Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' };

const [guildInfo, rolesRes, levelsRes, automodRes, antinukeRes, verificationRes, logsRes, restrictRes, disabledRes] = await runBatched([
  () => getGuildInfo(id, botToken),
  () => getGuildList(Astro, id, botToken, 'roles'),
  () => fetch(`${apiUrl}/rest/v1/command_permission_levels?guild_id=eq.${id}&select=command_name,required_level`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/automod_config?guild_id=eq.${id}&select=anti_spam_enabled,anti_raid_enabled`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/antinuke_config?guild_id=eq.${id}&select=enabled`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/verification_config?guild_id=eq.${id}&select=enabled`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/log_entries?guild_id=eq.${id}&select=event&limit=1`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/command_restrictions?guild_id=eq.${id}&select=command,role_id`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/disabled_commands?guild_id=eq.${id}&select=command,channel_id`, { headers: apiHeaders }),
], 9);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

const DANGEROUS_PERMS: { flag: bigint; label: string }[] = [
  { flag: 1n << 5n, label: 'Manage Server' },
  { flag: 1n << 28n, label: 'Manage Roles' },
  { flag: 1n << 4n, label: 'Manage Channels' },
  { flag: 1n << 2n, label: 'Ban Members' },
  { flag: 1n << 1n, label: 'Kick Members' },
  { flag: 1n << 40n, label: 'Timeout Members' },
  { flag: 1n << 29n, label: 'Manage Webhooks' },
  { flag: 1n << 13n, label: 'Manage Messages' },
  { flag: 1n << 17n, label: 'Mention @everyone' },
  { flag: 1n << 27n, label: 'Manage Nicknames' },
];
const ADMINISTRATOR = 1n << 3n;

const allRoles = rolesRes.ok ? await rolesRes.json() : [];
const roleFindings = allRoles
  .map((r: any) => {
    const bits = BigInt(r.permissions ?? '0');
    const isAdmin = (bits & ADMINISTRATOR) === ADMINISTRATOR;
    const matched = isAdmin ? [] : DANGEROUS_PERMS.filter((p) => (bits & p.flag) === p.flag).map((p) => p.label);
    const isEveryone = r.name === '@everyone';
    let severity: 'critical' | 'high' | 'medium' | null = null;
    if (isEveryone && (isAdmin || matched.length > 0)) severity = 'critical';
    else if (isAdmin) severity = 'high';
    else if (matched.length > 0) severity = 'medium';
    return { id: r.id, name: r.name, isEveryone, isAdmin, matched, severity, position: r.position };
  })
  .filter((r: any) => r.severity)
  .sort((a: any, b: any) => (b.severity === 'critical' ? 1 : 0) - (a.severity === 'critical' ? 1 : 0) || b.position - a.position);

const levelRows = levelsRes.ok ? await levelsRes.json() : [];
const rowsOf = async (res: Response) => (res.ok ? res.json().catch(() => []) : []);
// Commands that change the server or punish people, with every gate the bot checks (see utils/commandAccess.ts).
const coverage = accessCommands(dashLang, { levels: levelRows, restrictions: await rowsOf(restrictRes), disabled: await rowsOf(disabledRes) }).filter(isSensitive);
const roleNames = Object.fromEntries(allRoles.map((r: any) => [String(r.id), String(r.name)]));

const automodRows = automodRes.ok ? await automodRes.json() : [];
const antinukeRows = antinukeRes.ok ? await antinukeRes.json() : [];
const verificationRows = verificationRes.ok ? await verificationRes.json() : [];
const logRows = logsRes.ok ? await logsRes.json() : [];
const automod = automodRows[0] ?? {};
const protection = {
  antinuke: Boolean(antinukeRows[0]?.enabled),
  antiSpam: Boolean(automod.anti_spam_enabled),
  antiRaid: Boolean(automod.anti_raid_enabled),
  verification: Boolean(verificationRows[0]?.enabled),
  logs: logRows.length > 0,
};
let securityScore = 100;
const recommendations: string[] = [];
const everyoneFinding = roleFindings.find((role: any) => role.isEveryone);
const adminCount = roleFindings.filter((role: any) => role.isAdmin && !role.isEveryone).length;
if (everyoneFinding) { securityScore -= 30; recommendations.push(dt('@everyone has elevated permissions.')); }
if (adminCount > 0) { securityScore -= Math.min(30, adminCount * 10); recommendations.push(dt('{n} role(s) have Administrator.', { n: adminCount })); }
if (!protection.antinuke) { securityScore -= 15; recommendations.push(dt('Enable anti-nuke to respond to destructive attacks.')); }
if (!protection.antiSpam) { securityScore -= 10; recommendations.push(dt('Enable anti-spam to block flooding and mass mentions.')); }
if (!protection.antiRaid) { securityScore -= 10; recommendations.push(dt('Enable anti-raid to detect waves of joins.')); }
if (!protection.verification) { securityScore -= 5; recommendations.push(dt('Enable entry verification.')); }
if (!protection.logs) { securityScore -= 10; recommendations.push(dt('Set up at least one audit log channel.')); }
securityScore = Math.max(0, securityScore);
---
<DashSecurity
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'}
  roleFindings={roleFindings}
  coverage={coverage}
  roleNames={roleNames}
  securityScore={securityScore}
  protection={protection}
  recommendations={recommendations}
  section={section}
/>
