---
export const prerender = false;
import { ensureGuildRow } from '../../../../utils/ensureGuild';
import DashBirthdays from '../../../../components/DashBirthdays.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;
if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const apiHeaders = { apikey: apiKey, Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' };
const SNOWFLAKE = /^\d{15,25}$/;
const DEFAULT_MESSAGE = '{EMOJI} Happy birthday {user}! Have a great day!';

let saved = false;
let failed = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const channelId = String(form.get('channel_id') ?? '');
  const roleId = String(form.get('role_id') ?? '');
  const hour = Math.floor(Number(form.get('hour') ?? 9));
  const offset = Math.floor(Number(form.get('utc_offset_minutes') ?? -300));
  const embed = String(form.get('embed_template') ?? '').trim().toLowerCase().replace(/[^a-z0-9_-]/g, '_').slice(0, 60);
  if (channelId && !SNOWFLAKE.test(channelId)) failed = 'channel';
  else if (roleId && !SNOWFLAKE.test(roleId)) failed = 'role';
  else if (!(hour >= 0 && hour <= 23)) failed = 'hour';
  else if (!(offset >= -720 && offset <= 840)) failed = 'timezone';
  else {
    // The server keeps a row for the guild before any child table can point at it.
    await ensureGuildRow(apiUrl, apiHeaders, id);
    const res = await fetch(`${apiUrl}/rest/v1/birthday_config?on_conflict=guild_id`, {
      method: 'POST',
      headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
      body: JSON.stringify({
        guild_id: id,
        enabled: form.get('enabled') === 'on',
        channel_id: channelId || null,
        role_id: roleId || null,
        message: String(form.get('message') ?? '').replace(/\r\n?/g, '\n').trim().slice(0, 1500) || DEFAULT_MESSAGE,
        embed_template: embed || null,
        hour,
        utc_offset_minutes: offset,
        updated_at: new Date().toISOString(),
      }),
    });
    saved = res.ok;
    if (!res.ok) failed = 'save';
  }
}

const [guildInfo, configRes, listRes, rolesRes, channelsRes, templatesRes] = await Promise.all([
  getGuildInfo(id, botToken),
  fetch(`${apiUrl}/rest/v1/birthday_config?guild_id=eq.${id}&select=*`, { headers: apiHeaders }).catch(() => null),
  fetch(`${apiUrl}/rest/v1/birthdays?guild_id=eq.${id}&select=user_id,month,day&limit=5000`, { headers: apiHeaders }).catch(() => null),
  getGuildList(Astro, id, botToken, 'roles'),
  getGuildList(Astro, id, botToken, 'channels'),
  fetch(`${apiUrl}/rest/v1/embed_templates?guild_id=eq.${id}&select=name&order=name.asc`, { headers: apiHeaders }).catch(() => null),
]);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

const ready = Boolean(configRes?.ok);
const row = ready ? ((await configRes!.json())[0] ?? {}) : {};
const list: any[] = listRes?.ok ? await listRes.json() : [];
const roles = (rolesRes?.ok ? await rolesRes.json() : []).filter((r: any) => r.name !== '@everyone' && !r.managed).sort((a: any, b: any) => b.position - a.position).map((r: any) => ({ id: r.id, name: r.name }));
const channels = (channelsRes?.ok ? await channelsRes.json() : []).filter((c: any) => c.type === 0 || c.type === 5).sort((a: any, b: any) => a.position - b.position).map((c: any) => ({ id: c.id, name: c.name }));
const templates: string[] = (templatesRes?.ok ? await templatesRes.json() : []).map((t: any) => t.name).filter(Boolean);

const now = new Date(Date.now() + (row.utc_offset_minutes ?? -300) * 60_000);
const today = list.filter((entry) => entry.month === now.getUTCMonth() + 1 && entry.day === now.getUTCDate()).length;
const config = {
  enabled: row.enabled ?? false,
  channelId: row.channel_id ?? '',
  roleId: row.role_id ?? '',
  message: row.message ?? DEFAULT_MESSAGE,
  embedTemplate: row.embed_template ?? '',
  hour: row.hour ?? 9,
  offset: row.utc_offset_minutes ?? -300,
};
---
<DashBirthdays user={session} guildId={id} guildName={guildInfo.name} guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'} config={config} channels={channels} roles={roles} templates={templates} total={list.length} today={today} ready={ready} saved={saved} failed={failed} />
