---
export const prerender = false;
import DashAutomation from '../../../../components/DashAutomation.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo } from '../../../../utils/discord';
import { runBatched } from '../../../../utils/concurrency';

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const supabaseUrl = getEnv(Astro, 'SUPABASE_URL');
const supabaseKey = getEnv(Astro, 'SUPABASE_SERVICE_ROLE_KEY');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;

if (!botToken || !supabaseUrl || !supabaseKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const supabaseHeaders = {
  apikey: supabaseKey,
  Authorization: `Bearer ${supabaseKey}`,
  'Content-Type': 'application/json',
};

let saved = false;
let reactionRoleError: string | null = null;
let error: string | null = null;

async function deleteDiscordMessage(channelId: string | null, messageId: string | null) {
  if (!channelId || !messageId) return true;
  const res = await fetch(`https://discord.com/api/v10/channels/${channelId}/messages/${messageId}`, { method: 'DELETE', headers: { Authorization: `Bot ${botToken}` } });
  return res.ok || res.status === 404;
}

async function postVoiceMasterPanel(channelId: string) {
  const emoji = {
    leave: { id: '1533576199354454197', name: 'pe_leave' },
    decrease: { id: '1533576366174503085', name: 'pe_Decrease' },
    increase: { id: '1533576368502341683', name: 'pe_Increase' },
    lock: { id: '1533573937059987517', name: 'pe_Lock' },
    noVisibility: { id: '1533574205986177126', name: 'pe_Novisibility' },
    start: { id: '1533575715562192987', name: 'pe_Start' },
    visibility: { id: '1533574204287484145', name: 'pe_Visibility' },
    claim: { id: '1533574819084369931', name: 'pe_claim' },
    delete: { id: '1533575163273023599', name: 'pe_delete' },
    deny: { id: '1533574864198172772', name: 'pe_deny' },
    edit: { id: '1533574936168501479', name: 'pe_edit' },
    permit: { id: '1533574862436569228', name: 'pe_permit' },
    info: { id: '1533575563225337866', name: 'pe_info' },
    unlocked: { id: '1533573689461706914', name: 'pe_unlocked' },
    reload: { id: '1533575051947802764', name: 'pe_reload' },
  };
  const tag = (key: keyof typeof emoji) => `<:${emoji[key].name}:${emoji[key].id}>`;

  const payload = {
    flags: 1 << 15,
    components: [
      { type: 17, components: [
        { type: 10, content: ['## Voice Channel Panel', '-# Use the buttons below to manage your temporary voice channel.'].join('\n') },
        { type: 14, divider: true, spacing: 1 },
        { type: 10, content: [
          `>>> ${tag('lock')} · **Lock** the voice channel`, `${tag('unlocked')} · **Unlock** the voice channel`, `${tag('noVisibility')} · **Ghost** (hide) the voice channel`, `${tag('visibility')} · **Reveal** the voice channel`, `${tag('claim')} · **Claim** an unowned channel`,
          `${tag('permit')} · **Permit** a member to join`, `${tag('deny')} · **Reject** a member from the channel`, `${tag('edit')} · **Rename** the voice channel`, `${tag('reload')} · **Transfer** channel ownership`, `${tag('delete')} · **Delete** your channel`,
          `${tag('leave')} · **Disconnect** a member`, `${tag('start')} · **Start** an activity`, `${tag('info')} · **View** channel info`, `${tag('increase')} · **Increase** the user limit`, `${tag('decrease')} · **Decrease** the user limit`,
        ].join('\n') },
        { type: 14, divider: false, spacing: 1 },
        { type: 1, components: [
          { type: 2, custom_id: 'vc:lock', style: 2, emoji: emoji.lock }, { type: 2, custom_id: 'vc:unlock', style: 2, emoji: emoji.unlocked },
          { type: 2, custom_id: 'vc:ghost', style: 2, emoji: emoji.noVisibility }, { type: 2, custom_id: 'vc:reveal', style: 2, emoji: emoji.visibility }, { type: 2, custom_id: 'vc:claim', style: 2, emoji: emoji.claim },
        ] },
        { type: 1, components: [
          { type: 2, custom_id: 'vc:permit', style: 2, emoji: emoji.permit }, { type: 2, custom_id: 'vc:reject', style: 2, emoji: emoji.deny },
          { type: 2, custom_id: 'vc:rename', style: 2, emoji: emoji.edit }, { type: 2, custom_id: 'vc:transfer', style: 2, emoji: emoji.reload }, { type: 2, custom_id: 'vc:delete', style: 4, emoji: emoji.delete },
        ] },
        { type: 1, components: [
          { type: 2, custom_id: 'vc:disconnect', style: 2, emoji: emoji.leave }, { type: 2, custom_id: 'vc:activity', style: 2, emoji: emoji.start },
          { type: 2, custom_id: 'vc:info', style: 2, emoji: emoji.info }, { type: 2, custom_id: 'vc:limit_up', style: 2, emoji: emoji.increase }, { type: 2, custom_id: 'vc:limit_down', style: 2, emoji: emoji.decrease },
        ] },
      ] },
    ],
  };
  const res = await fetch(`https://discord.com/api/v10/channels/${channelId}/messages`, { method: 'POST', headers: { Authorization: `Bot ${botToken}`, 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
  if (!res.ok) return null;
  const message = await res.json();
  return String(message.id ?? '');
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'add_command') {
    const name = String(form.get('name') ?? '').trim().toLowerCase().replace(/[^a-z0-9_-]/g, '-').slice(0, 32);
    const response = String(form.get('response') ?? '').trim().slice(0, 500) || null;
    const embedTemplate = String(form.get('embed_template') ?? '').trim() || null;
    if (name && (response || embedTemplate)) {
      await fetch(`${supabaseUrl}/rest/v1/custom_commands`, {
        method: 'POST',
        headers: { ...supabaseHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({ guild_id: id, name, response, embed_template: embedTemplate }),
      });
      saved = true;
    }
  } else if (action === 'delete_command') {
    await fetch(`${supabaseUrl}/rest/v1/custom_commands?id=eq.${encodeURIComponent(String(form.get('id') ?? ''))}&guild_id=eq.${id}`, { method: 'DELETE', headers: supabaseHeaders });
    saved = true;
  } else if (action === 'add_responder') {
    const trigger = String(form.get('trigger') ?? '').trim().slice(0, 80);
    const reply = String(form.get('reply') ?? '').trim().slice(0, 500);
    const matchMode = String(form.get('match_mode') ?? 'contains');
    const deleteTrigger = form.get('delete_trigger') === 'on';
    const replyToTrigger = form.get('reply_to_trigger') === 'on';
    const pingUser = form.get('ping_user') === 'on';
    const channelIds = form.getAll('channel_ids').map(String);
    const roleIds = form.getAll('role_ids').map(String);
    const replyType = String(form.get('reply_type') ?? 'text');
    const embedColorRaw = String(form.get('embed_color') ?? '').trim().replace('#', '');
    const embedColor = /^[0-9a-fA-F]{6}$/.test(embedColorRaw) ? parseInt(embedColorRaw, 16) : null;
    const embedTitle = String(form.get('embed_title') ?? '').trim().slice(0, 100) || null;
    const embedFooter = String(form.get('embed_footer') ?? '').trim().slice(0, 100) || null;
    const embedTemplate = String(form.get('embed_template') ?? '').trim() || null;
    if (trigger && (reply || embedTemplate)) {
      await fetch(`${supabaseUrl}/rest/v1/auto_responders`, {
        method: 'POST',
        headers: { ...supabaseHeaders, Prefer: 'return=minimal' },
        body: JSON.stringify({
          guild_id: id, ar_id: crypto.randomUUID().slice(0, 8), trigger, reply, match_mode: matchMode,
          delete_trigger: deleteTrigger, reply_to_trigger: replyToTrigger, ping_user: pingUser,
          channel_ids: channelIds, role_ids: roleIds,
          reply_type: replyType, embed_color: embedColor, embed_title: embedTitle, embed_footer: embedFooter,
          embed_template: embedTemplate,
        }),
      });
      saved = true;
    }
  } else if (action === 'edit_responder') {
    const arId = String(form.get('ar_id') ?? '');
    const trigger = String(form.get('trigger') ?? '').trim().slice(0, 80);
    const reply = String(form.get('reply') ?? '').trim().slice(0, 500);
    const matchMode = String(form.get('match_mode') ?? 'contains');
    const deleteTrigger = form.get('delete_trigger') === 'on';
    const replyToTrigger = form.get('reply_to_trigger') === 'on';
    const pingUser = form.get('ping_user') === 'on';
    const channelIds = form.getAll('channel_ids').map(String);
    const roleIds = form.getAll('role_ids').map(String);
    const replyType = String(form.get('reply_type') ?? 'text');
    const embedColorRaw = String(form.get('embed_color') ?? '').trim().replace('#', '');
    const embedColor = /^[0-9a-fA-F]{6}$/.test(embedColorRaw) ? parseInt(embedColorRaw, 16) : null;
    const embedTitle = String(form.get('embed_title') ?? '').trim().slice(0, 100) || null;
    const embedFooter = String(form.get('embed_footer') ?? '').trim().slice(0, 100) || null;
    const embedTemplate = String(form.get('embed_template') ?? '').trim() || null;
    if (arId && trigger && (reply || embedTemplate)) {
      await fetch(`${supabaseUrl}/rest/v1/auto_responders?ar_id=eq.${encodeURIComponent(arId)}&guild_id=eq.${id}`, {
        method: 'PATCH',
        headers: { ...supabaseHeaders, Prefer: 'return=minimal' },
        body: JSON.stringify({
          trigger, reply, match_mode: matchMode, delete_trigger: deleteTrigger, reply_to_trigger: replyToTrigger, ping_user: pingUser,
          channel_ids: channelIds, role_ids: roleIds, reply_type: replyType, embed_color: embedColor, embed_title: embedTitle,
          embed_footer: embedFooter, embed_template: embedTemplate,
        }),
      });
      saved = true;
    }
  } else if (action === 'delete_responder') {
    await fetch(`${supabaseUrl}/rest/v1/auto_responders?ar_id=eq.${encodeURIComponent(String(form.get('ar_id') ?? ''))}&guild_id=eq.${id}`, { method: 'DELETE', headers: supabaseHeaders });
    saved = true;
  } else if (action === 'add_sticky') {
    const channelId = String(form.get('channel_id') ?? '');
    // Matches !stickymessage set's resolution, the bot's repost job sends this content as-is
    // (it doesn't re-resolve placeholders), so this has to happen before the row is saved.
    const content = String(form.get('content') ?? '').trim().slice(0, 500).replaceAll('{newline}', '\n').replaceAll('{separator}', '──────────────────────');
    if (channelId && content) {
      await fetch(`${supabaseUrl}/rest/v1/sticky_messages`, {
        method: 'POST',
        headers: { ...supabaseHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({ guild_id: id, channel_id: channelId, content }),
      });
      saved = true;
    }
  } else if (action === 'delete_sticky') {
    await fetch(`${supabaseUrl}/rest/v1/sticky_messages?channel_id=eq.${encodeURIComponent(String(form.get('channel_id') ?? ''))}&guild_id=eq.${id}`, { method: 'DELETE', headers: supabaseHeaders });
    saved = true;
  } else if (action === 'add_reactionrole') {
    const channelId = String(form.get('channel_id') ?? '');
    const messageId = String(form.get('message_id') ?? '').trim();
    const emoji = String(form.get('emoji') ?? '').trim().slice(0, 100);
    const roleId = String(form.get('role_id') ?? '');
    const mode = String(form.get('mode') ?? 'toggle');
    if (channelId && messageId && emoji && roleId) {
      // The bot has to actually react to the message with this emoji first, otherwise there's
      // nothing on the message for members to click, and the reactionAdd listener never fires.
      // /reactionrole add does this via message.react(), the dashboard form needs to match it.
      const customMatch = emoji.match(/^<a?:(\w+):(\d+)>$/);
      const reactionParam = customMatch ? `${customMatch[1]}:${customMatch[2]}` : emoji;
      const reactRes = await fetch(
        `https://discord.com/api/v10/channels/${channelId}/messages/${messageId}/reactions/${encodeURIComponent(reactionParam)}/@me`,
        { method: 'PUT', headers: { Authorization: `Bot ${botToken}` } },
      );
      if (!reactRes.ok) {
        reactionRoleError = "Couldn't react to that message, check the channel, message ID, and emoji.";
      } else {
        await fetch(`${supabaseUrl}/rest/v1/reaction_roles`, {
          method: 'POST',
          headers: { ...supabaseHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
          body: JSON.stringify({ guild_id: id, channel_id: channelId, message_id: messageId, emoji, role_id: roleId, mode }),
        });
        saved = true;
      }
    }
  } else if (action === 'delete_reactionrole') {
    await fetch(`${supabaseUrl}/rest/v1/reaction_roles?id=eq.${encodeURIComponent(String(form.get('id') ?? ''))}&guild_id=eq.${id}`, { method: 'DELETE', headers: supabaseHeaders });
    saved = true;
  } else if (action === 'add_disabled') {
    const command = String(form.get('command') ?? '').trim().toLowerCase().slice(0, 32);
    const channelId = String(form.get('channel_id') ?? '').trim() || null;
    if (command) {
      await fetch(`${supabaseUrl}/rest/v1/disabled_commands`, {
        method: 'POST',
        headers: { ...supabaseHeaders, Prefer: 'return=minimal' },
        body: JSON.stringify({ guild_id: id, command, channel_id: channelId }),
      });
      saved = true;
    }
  } else if (action === 'delete_disabled') {
    await fetch(`${supabaseUrl}/rest/v1/disabled_commands?id=eq.${encodeURIComponent(String(form.get('id') ?? ''))}&guild_id=eq.${id}`, { method: 'DELETE', headers: supabaseHeaders });
    saved = true;
  } else if (action === 'add_autothread') {
    const channelId = String(form.get('channel_id') ?? '').trim();
    const nameTemplate = String(form.get('name_template') ?? '').trim().slice(0, 100) || '{user_name}';
    const messageText = String(form.get('message_text') ?? '').trim().slice(0, 500) || null;
    const embedTemplate = String(form.get('embed_template') ?? '').trim() || null;
    const archiveMinutes = Number(form.get('archive_minutes')) || 60;
    if (channelId) {
      await fetch(`${supabaseUrl}/rest/v1/auto_threads`, {
        method: 'POST',
        headers: { ...supabaseHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({ guild_id: id, channel_id: channelId, name_template: nameTemplate, message_text: messageText, embed_template: embedTemplate, archive_minutes: archiveMinutes }),
      });
      saved = true;
    }
  } else if (action === 'delete_autothread') {
    await fetch(`${supabaseUrl}/rest/v1/auto_threads?guild_id=eq.${id}&channel_id=eq.${encodeURIComponent(String(form.get('channel_id') ?? ''))}`, { method: 'DELETE', headers: supabaseHeaders });
    saved = true;
  } else if (action === 'add_alias') {
    const name = String(form.get('name') ?? '').trim().toLowerCase().replace(/[^a-z0-9_-]/g, '').slice(0, 32);
    const command = String(form.get('command') ?? '').trim().slice(0, 500);
    if (name && command && !['alias', 'timer', 'starboard', 'voicemaster'].includes(name)) {
      const res = await fetch(`${supabaseUrl}/rest/v1/command_aliases`, { method: 'POST', headers: { ...supabaseHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify({ guild_id: id, name, command }) });
      saved = res.ok;
    }
  } else if (action === 'delete_alias') {
    const name = encodeURIComponent(String(form.get('name') ?? ''));
    const res = await fetch(`${supabaseUrl}/rest/v1/command_aliases?guild_id=eq.${id}&name=eq.${name}`, { method: 'DELETE', headers: supabaseHeaders });
    saved = res.ok;
  } else if (action === 'add_timer') {
    const channelId = String(form.get('channel_id') ?? '').trim();
    const minutes = Math.max(10, Math.min(525600, Number(form.get('interval_minutes') ?? 10) || 10));
    const message = String(form.get('message') ?? '').trim().slice(0, 2000);
    if (channelId && message) {
      const res = await fetch(`${supabaseUrl}/rest/v1/auto_messages`, { method: 'POST', headers: { ...supabaseHeaders, Prefer: 'return=minimal' }, body: JSON.stringify({ guild_id: id, channel_id: channelId, interval_ms: minutes * 60 * 1000, message, next_run_at: new Date(Date.now() + minutes * 60 * 1000).toISOString() }) });
      saved = res.ok;
      if (!res.ok) error = 'That channel may already have a timer.';
    }
  } else if (action === 'delete_timer') {
    const timerId = encodeURIComponent(String(form.get('id') ?? ''));
    const res = await fetch(`${supabaseUrl}/rest/v1/auto_messages?guild_id=eq.${id}&id=eq.${timerId}`, { method: 'DELETE', headers: supabaseHeaders });
    saved = res.ok;
  } else if (action === 'save_starboard') {
    const channelId = String(form.get('channel_id') ?? '').trim() || null;
    const threshold = Math.max(1, Math.min(100, Number(form.get('threshold') ?? 3) || 3));
    const emoji = String(form.get('emoji') ?? '⭐').trim().slice(0, 100) || '⭐';
    const ignoredChannelIds = form.getAll('ignored_channel_ids').map(String);
    const ignoredRoleIds = form.getAll('ignored_role_ids').map(String);
    const ignoredUserIds = String(form.get('ignored_user_ids') ?? '').split(/[\s,]+/).map((v) => v.trim()).filter((v) => /^\d{15,25}$/.test(v)).slice(0, 100);
    const res = await fetch(`${supabaseUrl}/rest/v1/starboards`, { method: 'POST', headers: { ...supabaseHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify({ guild_id: id, channel_id: channelId, threshold, emoji, selfstar: form.get('selfstar') === 'on', timestamp: form.get('timestamp') === 'on', jumpurl: form.get('jumpurl') === 'on', attachments: form.get('attachments') === 'on', ignored_channel_ids: ignoredChannelIds, ignored_role_ids: ignoredRoleIds, ignored_user_ids: ignoredUserIds }) });
    saved = res.ok;
  } else if (action === 'disable_starboard') {
    const entriesRes = await fetch(`${supabaseUrl}/rest/v1/starboard_entries?guild_id=eq.${id}`, { method: 'DELETE', headers: supabaseHeaders });
    const res = await fetch(`${supabaseUrl}/rest/v1/starboards?guild_id=eq.${id}`, { method: 'DELETE', headers: supabaseHeaders });
    saved = entriesRes.ok && res.ok;
  } else if (action === 'save_voicemaster') {
    const creatorChannelId = String(form.get('creator_channel_id') ?? '').trim();
    const panelChannelId = String(form.get('panel_channel_id') ?? '').trim();
    const categoryId = String(form.get('category_id') ?? '').trim() || null;
    const defaultLimit = Math.max(0, Math.min(99, Number(form.get('default_limit') ?? 0) || 0));
    const defaultName = String(form.get('default_name') ?? '{user.name}').trim().slice(0, 100) || '{user.name}';
    if (creatorChannelId && panelChannelId) {
      const oldRes = await fetch(`${supabaseUrl}/rest/v1/voice_configs?guild_id=eq.${id}&select=panel_channel_id,panel_message_id`, { headers: supabaseHeaders });
      const [old] = oldRes.ok ? await oldRes.json() : [];
      if (old && (old.panel_channel_id !== panelChannelId || form.get('resend_panel') === 'on')) await deleteDiscordMessage(old.panel_channel_id, old.panel_message_id);
      const panelMessageId = old && old.panel_channel_id === panelChannelId && form.get('resend_panel') !== 'on' ? old.panel_message_id : await postVoiceMasterPanel(panelChannelId);
      if (!panelMessageId) {
        error = 'Could not post the VoiceMaster panel. Check the bot permissions in that channel.';
      } else {
        const res = await fetch(`${supabaseUrl}/rest/v1/voice_configs`, { method: 'POST', headers: { ...supabaseHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify({ guild_id: id, creator_channel_id: creatorChannelId, panel_channel_id: panelChannelId, panel_message_id: panelMessageId, category_id: categoryId, default_limit: defaultLimit, default_name: defaultName, updated_at: new Date().toISOString() }) });
        saved = res.ok;
      }
    }
  } else if (action === 'disable_voicemaster') {
    const oldRes = await fetch(`${supabaseUrl}/rest/v1/voice_configs?guild_id=eq.${id}&select=panel_channel_id,panel_message_id`, { headers: supabaseHeaders });
    const [old] = oldRes.ok ? await oldRes.json() : [];
    await deleteDiscordMessage(old?.panel_channel_id, old?.panel_message_id);
    const res = await fetch(`${supabaseUrl}/rest/v1/voice_configs?guild_id=eq.${id}`, { method: 'DELETE', headers: supabaseHeaders });
    saved = res.ok;
  }
}

const [guildInfo, commandsRes, respondersRes, stickyRes, reactionRolesRes, disabledRes, autoThreadsRes, aliasesRes, timersRes, starboardRes, voiceMasterRes, rolesRes, channelsRes, embedTemplatesRes] = await runBatched([
  () => getGuildInfo(id, botToken),
  () => fetch(`${supabaseUrl}/rest/v1/custom_commands?guild_id=eq.${id}&select=id,name,response,embed_template&order=name.asc`, { headers: supabaseHeaders }),
  () => fetch(`${supabaseUrl}/rest/v1/auto_responders?guild_id=eq.${id}&select=id,ar_id,trigger,reply,match_mode,delete_trigger,reply_to_trigger,ping_user,channel_ids,role_ids,reply_type,embed_color,embed_title,embed_footer,embed_template&order=trigger.asc`, { headers: supabaseHeaders }),
  () => fetch(`${supabaseUrl}/rest/v1/sticky_messages?guild_id=eq.${id}&select=channel_id,content`, { headers: supabaseHeaders }),
  () => fetch(`${supabaseUrl}/rest/v1/reaction_roles?guild_id=eq.${id}&select=id,message_id,emoji,role_id,mode`, { headers: supabaseHeaders }),
  () => fetch(`${supabaseUrl}/rest/v1/disabled_commands?guild_id=eq.${id}&select=id,command,channel_id`, { headers: supabaseHeaders }),
  () => fetch(`${supabaseUrl}/rest/v1/auto_threads?guild_id=eq.${id}&select=channel_id,name_template,message_text,embed_template,archive_minutes`, { headers: supabaseHeaders }),
  () => fetch(`${supabaseUrl}/rest/v1/command_aliases?guild_id=eq.${id}&select=id,name,command&order=name.asc`, { headers: supabaseHeaders }),
  () => fetch(`${supabaseUrl}/rest/v1/auto_messages?guild_id=eq.${id}&select=id,channel_id,interval_ms,message,next_run_at&order=id.asc`, { headers: supabaseHeaders }),
  () => fetch(`${supabaseUrl}/rest/v1/starboards?guild_id=eq.${id}&select=*`, { headers: supabaseHeaders }),
  () => fetch(`${supabaseUrl}/rest/v1/voice_configs?guild_id=eq.${id}&select=*`, { headers: supabaseHeaders }),
  () => fetch(`https://discord.com/api/guilds/${id}/roles`, { headers: { Authorization: `Bot ${botToken}` } }),
  () => fetch(`https://discord.com/api/guilds/${id}/channels`, { headers: { Authorization: `Bot ${botToken}` } }),
  () => fetch(`${supabaseUrl}/rest/v1/embed_templates?guild_id=eq.${id}&select=name&order=name.asc`, { headers: supabaseHeaders }),
], 6);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

const customCommands = commandsRes.ok ? (await commandsRes.json()).map((c: any) => ({ id: c.id, name: c.name, response: c.response, embedTemplate: c.embed_template })) : [];
const embedTemplateNames = embedTemplatesRes.ok ? (await embedTemplatesRes.json()).map((t: any) => t.name) : [];
const autoResponders = respondersRes.ok ? (await respondersRes.json()).map((a: any) => ({
  id: a.id, arId: a.ar_id, trigger: a.trigger, reply: a.reply, matchMode: a.match_mode, deleteTrigger: a.delete_trigger ?? false, replyToTrigger: a.reply_to_trigger ?? false, pingUser: a.ping_user ?? false, channelIds: a.channel_ids ?? [], roleIds: a.role_ids ?? [],
  replyType: a.reply_type ?? 'text', embedColor: a.embed_color, embedTitle: a.embed_title, embedFooter: a.embed_footer, embedTemplate: a.embed_template,
})) : [];
const stickyMessages = stickyRes.ok ? (await stickyRes.json()).map((s: any) => ({ channelId: s.channel_id, content: s.content })) : [];
const reactionRoles = reactionRolesRes.ok ? (await reactionRolesRes.json()).map((r: any) => ({ id: r.id, messageId: r.message_id, emoji: r.emoji, roleId: r.role_id, mode: r.mode })) : [];
const disabledCommands = disabledRes.ok ? (await disabledRes.json()).map((d: any) => ({ id: d.id, command: d.command, channelId: d.channel_id })) : [];
const autoThreads = autoThreadsRes.ok ? (await autoThreadsRes.json()).map((t: any) => ({ channelId: t.channel_id, nameTemplate: t.name_template, messageText: t.message_text, embedTemplate: t.embed_template, archiveMinutes: t.archive_minutes })) : [];
const aliases = aliasesRes.ok ? (await aliasesRes.json()).map((a: any) => ({ id: a.id, name: a.name, command: a.command })) : [];
const timers = timersRes.ok ? (await timersRes.json()).map((t: any) => ({ id: t.id, channelId: t.channel_id, intervalMs: Number(t.interval_ms), message: t.message, nextRunAt: t.next_run_at })) : [];
const starboardRows = starboardRes.ok ? await starboardRes.json() : [];
const starboard = starboardRows[0] ? { ...starboardRows[0], ignoredChannelIds: starboardRows[0].ignored_channel_ids ?? [], ignoredRoleIds: starboardRows[0].ignored_role_ids ?? [], ignoredUserIds: starboardRows[0].ignored_user_ids ?? [] } : null;
const voiceRows = voiceMasterRes.ok ? await voiceMasterRes.json() : [];
const voiceMaster = voiceRows[0] ? { creatorChannelId: voiceRows[0].creator_channel_id, panelChannelId: voiceRows[0].panel_channel_id, panelMessageId: voiceRows[0].panel_message_id, categoryId: voiceRows[0].category_id, defaultLimit: voiceRows[0].default_limit ?? 0, defaultName: voiceRows[0].default_name ?? '{user.name}' } : null;

const allRoles = rolesRes.ok ? await rolesRes.json() : [];
const roles = allRoles
  .filter((r: any) => r.name !== '@everyone')
  .sort((a: any, b: any) => b.position - a.position)
  .map((r: any) => ({ id: r.id, name: r.name }));

const allChannels = channelsRes.ok ? await channelsRes.json() : [];
const channels = allChannels
  .filter((c: any) => c.type === 0 || c.type === 5)
  .sort((a: any, b: any) => a.position - b.position)
  .map((c: any) => ({ id: c.id, name: c.name }));
const voiceChannels = allChannels.filter((c: any) => c.type === 2 || c.type === 13).sort((a: any, b: any) => a.position - b.position).map((c: any) => ({ id: c.id, name: c.name }));
const channelCategories = allChannels.filter((c: any) => c.type === 4).sort((a: any, b: any) => a.position - b.position).map((c: any) => ({ id: c.id, name: c.name }));
---
<DashAutomation
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.png'}
  customCommands={customCommands}
  autoResponders={autoResponders}
  stickyMessages={stickyMessages}
  disabledCommands={disabledCommands}
  reactionRoles={reactionRoles}
  autoThreads={autoThreads}
  roles={roles}
  channels={channels}
  embedTemplateNames={embedTemplateNames}
  saved={saved}
  reactionRoleError={reactionRoleError}
  error={error}
  aliases={aliases}
  timers={timers}
  starboard={starboard}
  voiceMaster={voiceMaster}
  voiceChannels={voiceChannels}
  channelCategories={channelCategories}
/>
