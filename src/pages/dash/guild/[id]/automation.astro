---
export const prerender = false;
import DashAutomation from '../../../../components/DashAutomation.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';
import { runBatched } from '../../../../utils/concurrency';
import { hasPremiumForGuild } from '../../../../utils/premium';
import { getDashLang, makeT } from '../../../../i18n/dash';
const dt = makeT(getDashLang(Astro));

const { id } = Astro.params as { id: string };
const section = Astro.url.searchParams.get('section') ?? 'overview';
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;
const premiumActive = await hasPremiumForGuild(Astro, session.userId, id);
const customCommandLimit = premiumActive ? 100 : 25;
const responderLimit = premiumActive ? 75 : 15;

if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const apiHeaders = {
  apikey: apiKey,
  Authorization: `Bearer ${apiKey}`,
  'Content-Type': 'application/json',
};

let saved = false;
let reactionRoleError: string | null = null;
let error: string | null = null;
const COUNTER_OPTIONS = ['members', 'users_only', 'bots_only', 'pending_members', 'all_channels', 'text_channels', 'voice_channels', 'categories', 'announcement_channels', 'staging_channels', 'boosts', 'booster_count'];

async function deleteDiscordMessage(channelId: string | null, messageId: string | null) {
  if (!channelId || !messageId) return true;
  const res = await fetch(`https://discord.com/api/v10/channels/${channelId}/messages/${messageId}`, { method: 'DELETE', headers: { Authorization: `Bot ${botToken}` } });
  return res.ok || res.status === 404;
}

function discordButtonEmoji(value: string) {
  const custom = value.match(/^<a?:(\w+):(\d+)>$/);
  return custom
    ? { id: custom[2], name: custom[1], animated: value.startsWith('<a:') }
    : { name: value };
}

async function syncReactionRoleButtons(channelId: string, messageId: string) {
  const base = 'https://discord.com/api/v10/channels/' + channelId + '/messages/' + messageId;
  const messageRes = await fetch(base, { headers: { Authorization: 'Bot ' + botToken } });
  if (!messageRes.ok) return { ok: false, message: dt("Couldn't fetch that message.") };
  const message = await messageRes.json();
  const foreignComponents = (message.components ?? []).some((row: any) => (row.components ?? []).some((component: any) => component.custom_id && !String(component.custom_id).startsWith('rr:')));
  if (foreignComponents) return { ok: false, message: dt('That message already has another component panel. Use a message without buttons or selects for button roles.') };

  const rowsUrl = apiUrl + '/rest/v1/reaction_roles?guild_id=eq.' + id + '&message_id=eq.' + encodeURIComponent(messageId) + '&interaction_type=eq.button&select=id,emoji,role_id,mode,button_label&order=id.asc';
  const rowsRes = await fetch(rowsUrl, { headers: apiHeaders });
  if (!rowsRes.ok) return { ok: false, message: dt("Couldn't read the button role configuration.") };
  const rows = await rowsRes.json();
  if (rows.length > 25) return { ok: false, message: dt('A message can have at most 25 button roles.') };

  const buttons = rows.map((row: any) => ({
    type: 2,
    custom_id: 'rr:' + row.id,
    style: row.mode === 'add' ? 3 : row.mode === 'remove' ? 4 : 1,
    label: String(row.button_label || 'Role').trim().slice(0, 80) || 'Role',
    emoji: discordButtonEmoji(row.emoji),
  }));
  const components = [] as any[];
  for (let index = 0; index < buttons.length; index += 5) components.push({ type: 1, components: buttons.slice(index, index + 5) });
  const editRes = await fetch(base, {
    method: 'PATCH',
    headers: { Authorization: 'Bot ' + botToken, 'Content-Type': 'application/json' },
    body: JSON.stringify({ components }),
  });
  return editRes.ok ? { ok: true, message: '' } : { ok: false, message: dt("Couldn't update the message components.") };
}

async function postVoiceMasterPanel(channelId: string) {
  const emoji = {
    leave: { id: '1533576199354454197', name: 'pe_leave' },
    decrease: { id: '1533576366174503085', name: 'pe_Decrease' },
    increase: { id: '1533576368502341683', name: 'pe_Increase' },
    lock: { id: '1533573937059987517', name: 'pe_Lock' },
    noVisibility: { id: '1533574205986177126', name: 'pe_Novisibility' },
    start: { id: '1533575715562192987', name: 'pe_Start' },
    visibility: { id: '1533574204287484145', name: 'pe_Visibility' },
    claim: { id: '1533574819084369931', name: 'pe_claim' },
    delete: { id: '1533575163273023599', name: 'pe_delete' },
    deny: { id: '1533574864198172772', name: 'pe_deny' },
    edit: { id: '1533574936168501479', name: 'pe_edit' },
    permit: { id: '1533574862436569228', name: 'pe_permit' },
    info: { id: '1533575563225337866', name: 'pe_info' },
    unlocked: { id: '1533573689461706914', name: 'pe_unlocked' },
    reload: { id: '1533575051947802764', name: 'pe_reload' },
  };
  const tag = (key: keyof typeof emoji) => `<:${emoji[key].name}:${emoji[key].id}>`;

  const payload = {
    flags: 1 << 15,
    components: [
      { type: 17, components: [
        { type: 10, content: ['## Voice Channel Panel', '-# Use the buttons below to manage your temporary voice channel.'].join('\n') },
        { type: 14, divider: true, spacing: 1 },
        { type: 10, content: [
          `>>> ${tag('lock')} · **Lock** the voice channel`, `${tag('unlocked')} · **Unlock** the voice channel`, `${tag('noVisibility')} · **Ghost** (hide) the voice channel`, `${tag('visibility')} · **Reveal** the voice channel`, `${tag('claim')} · **Claim** an unowned channel`,
          `${tag('permit')} · **Permit** a member to join`, `${tag('deny')} · **Reject** a member from the channel`, `${tag('edit')} · **Rename** the voice channel`, `${tag('reload')} · **Transfer** channel ownership`, `${tag('delete')} · **Delete** your channel`,
          `${tag('leave')} · **Disconnect** a member`, `${tag('start')} · **Start** an activity`, `${tag('info')} · **View** channel info`, `${tag('increase')} · **Increase** the user limit`, `${tag('decrease')} · **Decrease** the user limit`,
        ].join('\n') },
        { type: 14, divider: false, spacing: 1 },
        { type: 1, components: [
          { type: 2, custom_id: 'vc:lock', style: 2, emoji: emoji.lock }, { type: 2, custom_id: 'vc:unlock', style: 2, emoji: emoji.unlocked },
          { type: 2, custom_id: 'vc:ghost', style: 2, emoji: emoji.noVisibility }, { type: 2, custom_id: 'vc:reveal', style: 2, emoji: emoji.visibility }, { type: 2, custom_id: 'vc:claim', style: 2, emoji: emoji.claim },
        ] },
        { type: 1, components: [
          { type: 2, custom_id: 'vc:permit', style: 2, emoji: emoji.permit }, { type: 2, custom_id: 'vc:reject', style: 2, emoji: emoji.deny },
          { type: 2, custom_id: 'vc:rename', style: 2, emoji: emoji.edit }, { type: 2, custom_id: 'vc:transfer', style: 2, emoji: emoji.reload }, { type: 2, custom_id: 'vc:delete', style: 4, emoji: emoji.delete },
        ] },
        { type: 1, components: [
          { type: 2, custom_id: 'vc:disconnect', style: 2, emoji: emoji.leave }, { type: 2, custom_id: 'vc:activity', style: 2, emoji: emoji.start },
          { type: 2, custom_id: 'vc:info', style: 2, emoji: emoji.info }, { type: 2, custom_id: 'vc:limit_up', style: 2, emoji: emoji.increase }, { type: 2, custom_id: 'vc:limit_down', style: 2, emoji: emoji.decrease },
        ] },
      ] },
    ],
  };
  const res = await fetch(`https://discord.com/api/v10/channels/${channelId}/messages`, { method: 'POST', headers: { Authorization: `Bot ${botToken}`, 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
  if (!res.ok) return null;
  const message = await res.json();
  return String(message.id ?? '');
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'add_command') {
    const name = String(form.get('name') ?? '').trim().toLowerCase().replace(/[^a-z0-9_-]/g, '-').slice(0, 32);
    const response = String(form.get('response') ?? '').trim().slice(0, 500) || null;
    const embedTemplate = String(form.get('embed_template') ?? '').trim() || null;
    if (name && (response || embedTemplate)) {
      const countRes = await fetch(`${apiUrl}/rest/v1/custom_commands?guild_id=eq.${id}&select=id`, { headers: apiHeaders });
      const current = countRes.ok ? await countRes.json() : null;
      if (!current) {
        error = dt("Couldn't check the custom command limit, try again.");
      } else if (current.length >= customCommandLimit) {
        error = premiumActive
          ? dt("You have reached the {n} custom command limit.", {n: customCommandLimit})
          : dt('The Free plan includes 25 custom commands. Premium unlocks up to 100.');
      } else {
        const res = await fetch(`${apiUrl}/rest/v1/custom_commands?on_conflict=guild_id,name`, {
          method: 'POST',
          headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
          body: JSON.stringify({ guild_id: id, name, response, embed_template: embedTemplate }),
        });
        if (res.ok) saved = true;
        else error = dt("Couldn't save that custom command, try again.");
      }
    }
  } else if (action === 'delete_command') {
    await fetch(`${apiUrl}/rest/v1/custom_commands?id=eq.${encodeURIComponent(String(form.get('id') ?? ''))}&guild_id=eq.${id}`, { method: 'DELETE', headers: apiHeaders });
    saved = true;
  } else if (action === 'add_responder') {
    const trigger = String(form.get('trigger') ?? '').trim().slice(0, 80);
    const reply = String(form.get('reply') ?? '').trim().slice(0, 500);
    const matchMode = String(form.get('match_mode') ?? 'contains');
    const deleteTrigger = form.get('delete_trigger') === 'on';
    const replyToTrigger = form.get('reply_to_trigger') === 'on';
    const pingUser = form.get('ping_user') === 'on';
    const channelIds = form.getAll('channel_ids').map(String);
    const roleIds = form.getAll('role_ids').map(String);
    const replyType = String(form.get('reply_type') ?? 'text');
    const embedColorRaw = String(form.get('embed_color') ?? '').trim().replace('#', '');
    const embedColor = /^[0-9a-fA-F]{6}$/.test(embedColorRaw) ? parseInt(embedColorRaw, 16) : null;
    const embedTitle = String(form.get('embed_title') ?? '').trim().slice(0, 100) || null;
    const embedFooter = String(form.get('embed_footer') ?? '').trim().slice(0, 100) || null;
    const embedTemplate = String(form.get('embed_template') ?? '').trim() || null;
    if (trigger && (reply || embedTemplate)) {
      const countRes = await fetch(`${apiUrl}/rest/v1/auto_responders?guild_id=eq.${id}&select=id`, { headers: apiHeaders });
      const current = countRes.ok ? await countRes.json() : null;
      if (!current) {
        error = dt("Couldn't check the autoresponder limit, try again.");
      } else if (current.length >= responderLimit) {
        error = premiumActive ? dt('You have reached the 75 autoresponder limit.') : dt('The Free plan includes 15 autoresponders. Premium unlocks up to 75.');
      } else {
        const res = await fetch(`${apiUrl}/rest/v1/auto_responders`, {
          method: 'POST',
          headers: { ...apiHeaders, Prefer: 'return=minimal' },
          body: JSON.stringify({
            guild_id: id, ar_id: crypto.randomUUID().slice(0, 8), trigger, reply, match_mode: matchMode,
            delete_trigger: deleteTrigger, reply_to_trigger: replyToTrigger, ping_user: pingUser,
            channel_ids: channelIds, role_ids: roleIds,
            reply_type: replyType, embed_color: embedColor, embed_title: embedTitle, embed_footer: embedFooter,
            embed_template: embedTemplate,
          }),
        });
        if (res.ok) saved = true;
        else error = dt("Couldn't save that autoresponder, try again.");
      }
    }
  } else if (action === 'edit_responder') {
    const arId = String(form.get('ar_id') ?? '');
    const trigger = String(form.get('trigger') ?? '').trim().slice(0, 80);
    const reply = String(form.get('reply') ?? '').trim().slice(0, 500);
    const matchMode = String(form.get('match_mode') ?? 'contains');
    const deleteTrigger = form.get('delete_trigger') === 'on';
    const replyToTrigger = form.get('reply_to_trigger') === 'on';
    const pingUser = form.get('ping_user') === 'on';
    const channelIds = form.getAll('channel_ids').map(String);
    const roleIds = form.getAll('role_ids').map(String);
    const replyType = String(form.get('reply_type') ?? 'text');
    const embedColorRaw = String(form.get('embed_color') ?? '').trim().replace('#', '');
    const embedColor = /^[0-9a-fA-F]{6}$/.test(embedColorRaw) ? parseInt(embedColorRaw, 16) : null;
    const embedTitle = String(form.get('embed_title') ?? '').trim().slice(0, 100) || null;
    const embedFooter = String(form.get('embed_footer') ?? '').trim().slice(0, 100) || null;
    const embedTemplate = String(form.get('embed_template') ?? '').trim() || null;
    if (arId && trigger && (reply || embedTemplate)) {
      await fetch(`${apiUrl}/rest/v1/auto_responders?ar_id=eq.${encodeURIComponent(arId)}&guild_id=eq.${id}`, {
        method: 'PATCH',
        headers: { ...apiHeaders, Prefer: 'return=minimal' },
        body: JSON.stringify({
          trigger, reply, match_mode: matchMode, delete_trigger: deleteTrigger, reply_to_trigger: replyToTrigger, ping_user: pingUser,
          channel_ids: channelIds, role_ids: roleIds, reply_type: replyType, embed_color: embedColor, embed_title: embedTitle,
          embed_footer: embedFooter, embed_template: embedTemplate,
        }),
      });
      saved = true;
    }
  } else if (action === 'delete_responder') {
    await fetch(`${apiUrl}/rest/v1/auto_responders?ar_id=eq.${encodeURIComponent(String(form.get('ar_id') ?? ''))}&guild_id=eq.${id}`, { method: 'DELETE', headers: apiHeaders });
    saved = true;
  } else if (action === 'add_sticky') {
    const channelId = String(form.get('channel_id') ?? '');
    // Matches !stickymessage set's resolution, the bot's repost job sends this content as-is
    // (it doesn't re-resolve placeholders), so this has to happen before the row is saved.
    const content = String(form.get('content') ?? '').trim().slice(0, 500).replaceAll('{newline}', '\n').replaceAll('{separator}', '──────────────────────');
    if (channelId && content) {
      await fetch(`${apiUrl}/rest/v1/sticky_messages?on_conflict=guild_id,channel_id`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({ guild_id: id, channel_id: channelId, content }),
      });
      saved = true;
    }
  } else if (action === 'delete_sticky') {
    await fetch(`${apiUrl}/rest/v1/sticky_messages?channel_id=eq.${encodeURIComponent(String(form.get('channel_id') ?? ''))}&guild_id=eq.${id}`, { method: 'DELETE', headers: apiHeaders });
    saved = true;
  } else if (action === 'add_reactionrole') {
    const channelId = String(form.get('channel_id') ?? '');
    const messageId = String(form.get('message_id') ?? '').trim();
    const emoji = String(form.get('emoji') ?? '').trim().slice(0, 100);
    const roleId = String(form.get('role_id') ?? '');
    const mode = String(form.get('mode') ?? 'toggle');
    const interactionType = String(form.get('interaction_type') ?? 'reaction') === 'button' ? 'button' : 'reaction';
    const buttonLabel = String(form.get('button_label') ?? '').trim().slice(0, 80) || null;
    if (channelId && messageId && emoji && roleId) {
      if (interactionType === 'reaction') {
        const customMatch = emoji.match(/^<a?:(\w+):(\d+)>$/);
        const reactionParam = customMatch ? customMatch[1] + ':' + customMatch[2] : emoji;
        const reactUrl = 'https://discord.com/api/v10/channels/' + channelId + '/messages/' + messageId + '/reactions/' + encodeURIComponent(reactionParam) + '/@me';
        const reactRes = await fetch(reactUrl, { method: 'PUT', headers: { Authorization: 'Bot ' + botToken } });
        if (!reactRes.ok) reactionRoleError = dt("Couldn't react to that message, check the channel, message ID, and emoji.");
      }
      if (!reactionRoleError) {
        const insertRes = await fetch(apiUrl + '/rest/v1/reaction_roles?on_conflict=message_id,emoji', {
          method: 'POST',
          headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
          body: JSON.stringify({ guild_id: id, channel_id: channelId, message_id: messageId, emoji, role_id: roleId, mode, interaction_type: interactionType, button_label: interactionType === 'button' ? buttonLabel : null }),
        });
        if (!insertRes.ok) reactionRoleError = dt("Couldn't save that role binding.");
        else if (interactionType === 'button') {
          const sync = await syncReactionRoleButtons(channelId, messageId);
          if (!sync.ok) reactionRoleError = sync.message;
        }
        saved = !reactionRoleError;
      }
    }
  } else if (action === 'delete_reactionrole') {
    const roleBindingId = String(form.get('id') ?? '');
    const oldUrl = apiUrl + '/rest/v1/reaction_roles?id=eq.' + encodeURIComponent(roleBindingId) + '&guild_id=eq.' + id + '&select=channel_id,message_id,interaction_type';
    const oldRes = await fetch(oldUrl, { headers: apiHeaders });
    const oldRows = oldRes.ok ? await oldRes.json() : [];
    const deleteUrl = apiUrl + '/rest/v1/reaction_roles?id=eq.' + encodeURIComponent(roleBindingId) + '&guild_id=eq.' + id;
    const deleteRes = await fetch(deleteUrl, { method: 'DELETE', headers: apiHeaders });
    if (deleteRes.ok && oldRows[0]?.interaction_type === 'button') {
      const sync = await syncReactionRoleButtons(oldRows[0].channel_id, oldRows[0].message_id);
      if (!sync.ok) reactionRoleError = sync.message;
    }
    saved = deleteRes.ok && !reactionRoleError;
  } else if (action === 'add_reaction_trigger') {
    const emoji = String(form.get('emoji') ?? '').trim().slice(0, 100);
    const trigger = String(form.get('trigger') ?? '').trim().replace(/\s+/g, ' ').toLowerCase().slice(0, 80);
    const matchMode = String(form.get('match_mode') ?? 'contains');
    const channelIds = form.getAll('trigger_channel_ids').map(String);
    const roleIds = form.getAll('trigger_role_ids').map(String);
    const cooldownSeconds = Math.max(0, Math.min(86400, Number(form.get('cooldown_seconds') ?? 0) || 0));
    const common = new Set(['a', 'an', 'and', 'are', 'as', 'at', 'be', 'but', 'by', 'can', 'do', 'for', 'from', 'get', 'go', 'have', 'he', 'hey', 'hi', 'i', 'if', 'in', 'is', 'it', 'me', 'my', 'no', 'of', 'on', 'or', 'our', 'so', 'that', 'the', 'this', 'to', 'was', 'we', 'what', 'when', 'where', 'who', 'why', 'will', 'with', 'you', 'your']);
    if (emoji && trigger.length >= 2 && !common.has(trigger)) {
      const res = await fetch(`${apiUrl}/rest/v1/reaction_triggers?on_conflict=guild_id,emoji,trigger`, { method: 'POST', headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify({ guild_id: id, emoji, trigger, owner_id: session.userId, match_mode: matchMode, channel_ids: channelIds, role_ids: roleIds, case_sensitive: form.get('case_sensitive') === 'on', cooldown_seconds: cooldownSeconds }) });
      saved = res.ok;
      if (!res.ok) error = dt('That emoji and trigger may already be configured.');
    } else {
      error = dt('Use an emoji and a specific trigger phrase (common one-word triggers are blocked).');
    }
  } else if (action === 'delete_reaction_trigger') {
    await fetch(`${apiUrl}/rest/v1/reaction_triggers?id=eq.${encodeURIComponent(String(form.get('id') ?? ''))}&guild_id=eq.${id}`, { method: 'DELETE', headers: apiHeaders });
    saved = true;
  } else if (action === 'reset_reaction_triggers') {
    await fetch(`${apiUrl}/rest/v1/reaction_triggers?guild_id=eq.${id}`, { method: 'DELETE', headers: apiHeaders });
    saved = true;
  } else if (action === 'edit_reaction_trigger') {
    const triggerId = String(form.get('id') ?? '').trim();
    const channelIds = form.getAll('trigger_channel_ids').map(String);
    const roleIds = form.getAll('trigger_role_ids').map(String);
    const patch = { match_mode: String(form.get('match_mode') ?? 'contains'), channel_ids: channelIds, role_ids: roleIds, case_sensitive: form.get('case_sensitive') === 'on', cooldown_seconds: Math.max(0, Math.min(86400, Number(form.get('cooldown_seconds') ?? 0) || 0)), enabled: form.get('enabled') === 'on' };
    const res = await fetch(`${apiUrl}/rest/v1/reaction_triggers?id=eq.${encodeURIComponent(triggerId)}&guild_id=eq.${id}`, { method: 'PATCH', headers: { ...apiHeaders, Prefer: 'return=minimal' }, body: JSON.stringify(patch) });
    saved = res.ok;
  } else if (action === 'save_reaction_messages') {
    const channelId = String(form.get('channel_id') ?? '').trim();
    const emojis = [...new Set(form.getAll('emojis').map(String).map((value) => value.trim()).filter(Boolean))].slice(0, 3);
    if (channelId) {
      const res = emojis.length
        ? await fetch(`${apiUrl}/rest/v1/reaction_message_configs?on_conflict=guild_id,channel_id`, { method: 'POST', headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify({ guild_id: id, channel_id: channelId, emojis }) })
        : await fetch(`${apiUrl}/rest/v1/reaction_message_configs?guild_id=eq.${id}&channel_id=eq.${encodeURIComponent(channelId)}`, { method: 'DELETE', headers: apiHeaders });
      saved = res.ok;
    }
  } else if (action === 'delete_reaction_messages') {
    await fetch(`${apiUrl}/rest/v1/reaction_message_configs?guild_id=eq.${id}&channel_id=eq.${encodeURIComponent(String(form.get('channel_id') ?? ''))}`, { method: 'DELETE', headers: apiHeaders });
    saved = true;
  } else if (action === 'create_webhook') {
    const channelId = String(form.get('channel_id') ?? '').trim();
    const name = String(form.get('name') ?? '').trim().slice(0, 80);
    const defaultUsername = String(form.get('default_username') ?? '').trim().slice(0, 80) || null;
    const defaultAvatarUrl = String(form.get('default_avatar_url') ?? '').trim() || null;
    const defaultMessage = String(form.get('default_message') ?? '').trim().slice(0, 2000) || null;
    if (channelId && name) {
      const createRes = await fetch(`https://discord.com/api/v10/channels/${channelId}/webhooks`, { method: 'POST', headers: { Authorization: `Bot ${botToken}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ name }) });
      if (createRes.ok) {
        const webhook = await createRes.json();
        const dbRes = await fetch(`${apiUrl}/rest/v1/managed_webhooks`, { method: 'POST', headers: { ...apiHeaders, Prefer: 'return=minimal' }, body: JSON.stringify({ guild_id: id, channel_id: channelId, webhook_id: webhook.id, webhook_token: webhook.token, name: webhook.name ?? name, created_by: session.userId, default_username: defaultUsername, default_avatar_url: defaultAvatarUrl, default_message: defaultMessage }) });
        saved = dbRes.ok;
      } else error = dt('Could not create the webhook. Check Manage Webhooks in that channel.');
    }
  } else if (action === 'send_webhook') {
    const localId = String(form.get('webhook_id') ?? '').trim();
    const message = String(form.get('message') ?? '').trim().slice(0, 2000);
    const username = String(form.get('username') ?? '').trim().slice(0, 80) || undefined;
    const avatarUrl = String(form.get('avatar_url') ?? '').trim() || undefined;
    const embedTitle = String(form.get('embed_title') ?? '').trim().slice(0, 256) || undefined;
    const embedDescription = String(form.get('embed_description') ?? '').trim().slice(0, 4096) || undefined;
    const embedColor = String(form.get('embed_color') ?? '').trim().replace('#', '');
    const rowRes = await fetch(`${apiUrl}/rest/v1/managed_webhooks?id=eq.${encodeURIComponent(localId)}&guild_id=eq.${id}&select=webhook_id,webhook_token,default_message,default_username,default_avatar_url,default_embed`, { headers: apiHeaders });
    const [row] = rowRes.ok ? await rowRes.json() : [];
    const embed = embedTitle || embedDescription ? { ...(embedTitle ? { title: embedTitle } : {}), ...(embedDescription ? { description: embedDescription } : {}), ...( /^[0-9a-fA-F]{6}$/.test(embedColor) ? { color: parseInt(embedColor, 16) } : {}) } : row?.default_embed;
    if (row && (message || row.default_message || embed)) {
      const sendRes = await fetch(`https://discord.com/api/v10/webhooks/${row.webhook_id}/${row.webhook_token}?wait=true`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ content: message || row.default_message || undefined, username: username || row.default_username || undefined, avatar_url: avatarUrl || row.default_avatar_url || undefined, embeds: embed ? [embed] : undefined }) });
      saved = sendRes.ok;
    }
  } else if (action === 'edit_webhook') {
    const localId = String(form.get('id') ?? '').trim();
    const patch = { name: String(form.get('name') ?? '').trim().slice(0, 80), default_username: String(form.get('default_username') ?? '').trim().slice(0, 80) || null, default_avatar_url: String(form.get('default_avatar_url') ?? '').trim() || null, default_message: String(form.get('default_message') ?? '').trim().slice(0, 2000) || null, enabled: form.get('enabled') === 'on' };
    const res = await fetch(`${apiUrl}/rest/v1/managed_webhooks?id=eq.${encodeURIComponent(localId)}&guild_id=eq.${id}`, { method: 'PATCH', headers: { ...apiHeaders, Prefer: 'return=minimal' }, body: JSON.stringify(patch) });
    saved = res.ok;
  } else if (action === 'duplicate_webhook') {
    const localId = String(form.get('id') ?? '').trim();
    const rowRes = await fetch(`${apiUrl}/rest/v1/managed_webhooks?id=eq.${encodeURIComponent(localId)}&guild_id=eq.${id}&select=*`, { headers: apiHeaders });
    const [row] = rowRes.ok ? await rowRes.json() : [];
    if (row) {
      const createRes = await fetch(`https://discord.com/api/v10/channels/${row.channel_id}/webhooks`, { method: 'POST', headers: { Authorization: `Bot ${botToken}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ name: `${row.name} copy`.slice(0, 80) }) });
      if (createRes.ok) {
        const webhook = await createRes.json();
        const dbRes = await fetch(`${apiUrl}/rest/v1/managed_webhooks`, { method: 'POST', headers: { ...apiHeaders, Prefer: 'return=minimal' }, body: JSON.stringify({ guild_id: id, channel_id: row.channel_id, webhook_id: webhook.id, webhook_token: webhook.token, name: webhook.name, created_by: session.userId, default_username: row.default_username, default_avatar_url: row.default_avatar_url, default_message: row.default_message, default_embed: row.default_embed }) });
        saved = dbRes.ok;
      }
    }
  } else if (action === 'delete_webhook') {
    const localId = String(form.get('id') ?? '').trim();
    const rowRes = await fetch(`${apiUrl}/rest/v1/managed_webhooks?id=eq.${encodeURIComponent(localId)}&guild_id=eq.${id}&select=webhook_id,webhook_token`, { headers: apiHeaders });
    const [row] = rowRes.ok ? await rowRes.json() : [];
    if (row) await fetch(`https://discord.com/api/v10/webhooks/${row.webhook_id}/${row.webhook_token}`, { method: 'DELETE' }).catch(() => {});
    const dbRes = await fetch(`${apiUrl}/rest/v1/managed_webhooks?id=eq.${encodeURIComponent(localId)}&guild_id=eq.${id}`, { method: 'DELETE', headers: apiHeaders });
    saved = dbRes.ok;
  } else if (action === 'create_counter') {
    const option = String(form.get('option') ?? '').trim().toLowerCase();
    const type = String(form.get('type') ?? 'voice').trim();
    const parentId = String(form.get('parent_id') ?? '').trim() || null;
    const nameTemplate = String(form.get('name_template') ?? '{option}: {value}').trim().slice(0, 100) || '{option}: {value}';
    const prefix = String(form.get('prefix') ?? '').slice(0, 30);
    const suffix = String(form.get('suffix') ?? '').slice(0, 30);
    const intervalSeconds = Math.max(60, Math.min(86400, Number(form.get('interval_seconds') ?? 60) || 60));
    const typeCode: Record<string, number> = { voice: 2, text: 0, category: 4, announce: 5, stage: 13 };
    if (COUNTER_OPTIONS.includes(option) && typeCode[type] != null) {
      const channelRes = await fetch(`https://discord.com/api/v10/guilds/${id}/channels`, { method: 'POST', headers: { Authorization: `Bot ${botToken}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ name: `${prefix}${option}${suffix}`.slice(0, 100), type: typeCode[type], parent_id: parentId }) });
      if (channelRes.ok) {
        const channel = await channelRes.json();
        const dbRes = await fetch(`${apiUrl}/rest/v1/server_counters`, { method: 'POST', headers: { ...apiHeaders, Prefer: 'return=minimal' }, body: JSON.stringify({ guild_id: id, channel_id: channel.id, counter_option: option, channel_type: type, created_by: session.userId, parent_id: parentId, name_template: nameTemplate, prefix, suffix, interval_seconds: intervalSeconds }) });
        saved = dbRes.ok;
      } else error = dt('Could not create the counter channel. Check Manage Channels.');
    }
  } else if (action === 'delete_counter') {
    const channelId = String(form.get('channel_id') ?? '').trim();
    const res = await fetch(`${apiUrl}/rest/v1/server_counters?guild_id=eq.${id}&channel_id=eq.${encodeURIComponent(channelId)}`, { method: 'DELETE', headers: apiHeaders });
    saved = res.ok;
  } else if (action === 'edit_counter') {
    const channelId = String(form.get('channel_id') ?? '').trim();
    const patch = { name_template: String(form.get('name_template') ?? '{option}: {value}').trim().slice(0, 100) || '{option}: {value}', prefix: String(form.get('prefix') ?? '').slice(0, 30), suffix: String(form.get('suffix') ?? '').slice(0, 30), interval_seconds: Math.max(60, Math.min(86400, Number(form.get('interval_seconds') ?? 60) || 60)), parent_id: String(form.get('parent_id') ?? '').trim() || null, enabled: form.get('enabled') === 'on' };
    const res = await fetch(`${apiUrl}/rest/v1/server_counters?guild_id=eq.${id}&channel_id=eq.${encodeURIComponent(channelId)}`, { method: 'PATCH', headers: { ...apiHeaders, Prefer: 'return=minimal' }, body: JSON.stringify(patch) });
    if (res.ok) await fetch(`https://discord.com/api/v10/channels/${channelId}`, { method: 'PATCH', headers: { Authorization: `Bot ${botToken}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ parent_id: patch.parent_id }) }).catch(() => {});
    saved = res.ok;
  } else if (action === 'add_disabled') {
    const command = String(form.get('command') ?? '').trim().toLowerCase().slice(0, 32);
    const channelId = String(form.get('channel_id') ?? '').trim() || null;
    if (command) {
      await fetch(`${apiUrl}/rest/v1/disabled_commands`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'return=minimal' },
        body: JSON.stringify({ guild_id: id, command, channel_id: channelId }),
      });
      saved = true;
    }
  } else if (action === 'delete_disabled') {
    await fetch(`${apiUrl}/rest/v1/disabled_commands?id=eq.${encodeURIComponent(String(form.get('id') ?? ''))}&guild_id=eq.${id}`, { method: 'DELETE', headers: apiHeaders });
    saved = true;
  } else if (action === 'add_autothread') {
    const channelId = String(form.get('channel_id') ?? '').trim();
    const nameTemplate = String(form.get('name_template') ?? '').trim().slice(0, 100) || '{user_name}';
    const messageText = String(form.get('message_text') ?? '').trim().slice(0, 500) || null;
    const embedTemplate = String(form.get('embed_template') ?? '').trim() || null;
    const archiveMinutes = Number(form.get('archive_minutes')) || 60;
    if (channelId) {
      await fetch(`${apiUrl}/rest/v1/auto_threads?on_conflict=guild_id,channel_id`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({ guild_id: id, channel_id: channelId, name_template: nameTemplate, message_text: messageText, embed_template: embedTemplate, archive_minutes: archiveMinutes }),
      });
      saved = true;
    }
  } else if (action === 'delete_autothread') {
    await fetch(`${apiUrl}/rest/v1/auto_threads?guild_id=eq.${id}&channel_id=eq.${encodeURIComponent(String(form.get('channel_id') ?? ''))}`, { method: 'DELETE', headers: apiHeaders });
    saved = true;
  } else if (action === 'add_alias') {
    const name = String(form.get('name') ?? '').trim().toLowerCase().replace(/[^a-z0-9_-]/g, '').slice(0, 32);
    const command = String(form.get('command') ?? '').trim().slice(0, 500);
    if (name && command && !['alias', 'timer', 'starboard', 'voicemaster'].includes(name)) {
      const res = await fetch(`${apiUrl}/rest/v1/command_aliases?on_conflict=guild_id,name`, { method: 'POST', headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify({ guild_id: id, name, command }) });
      saved = res.ok;
    }
  } else if (action === 'delete_alias') {
    const name = encodeURIComponent(String(form.get('name') ?? ''));
    const res = await fetch(`${apiUrl}/rest/v1/command_aliases?guild_id=eq.${id}&name=eq.${name}`, { method: 'DELETE', headers: apiHeaders });
    saved = res.ok;
  } else if (action === 'add_timer') {
    const channelId = String(form.get('channel_id') ?? '').trim();
    const minutes = Math.max(10, Math.min(525600, Number(form.get('interval_minutes') ?? 10) || 10));
    const message = String(form.get('message') ?? '').trim().slice(0, 2000);
    if (channelId && message) {
      const res = await fetch(`${apiUrl}/rest/v1/auto_messages`, { method: 'POST', headers: { ...apiHeaders, Prefer: 'return=minimal' }, body: JSON.stringify({ guild_id: id, channel_id: channelId, interval_ms: minutes * 60 * 1000, message, next_run_at: new Date(Date.now() + minutes * 60 * 1000).toISOString() }) });
      saved = res.ok;
      if (!res.ok) error = dt('That channel may already have a timer.');
    }
  } else if (action === 'delete_timer') {
    const timerId = encodeURIComponent(String(form.get('id') ?? ''));
    const res = await fetch(`${apiUrl}/rest/v1/auto_messages?guild_id=eq.${id}&id=eq.${timerId}`, { method: 'DELETE', headers: apiHeaders });
    saved = res.ok;
  } else if (action === 'save_starboard') {
    const channelId = String(form.get('channel_id') ?? '').trim() || null;
    const threshold = Math.max(1, Math.min(100, Number(form.get('threshold') ?? 3) || 3));
    const emoji = String(form.get('emoji') ?? '⭐').trim().slice(0, 100) || '⭐';
    const ignoredChannelIds = form.getAll('ignored_channel_ids').map(String);
    const ignoredRoleIds = form.getAll('ignored_role_ids').map(String);
    const ignoredUserIds = String(form.get('ignored_user_ids') ?? '').split(/[\s,]+/).map((v) => v.trim()).filter((v) => /^\d{15,25}$/.test(v)).slice(0, 100);
    const res = await fetch(`${apiUrl}/rest/v1/starboards?on_conflict=guild_id`, { method: 'POST', headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify({ guild_id: id, channel_id: channelId, threshold, emoji, selfstar: form.get('selfstar') === 'on', timestamp: form.get('timestamp') === 'on', jumpurl: form.get('jumpurl') === 'on', attachments: form.get('attachments') === 'on', ...(form.get('design_ready') || String(form.get('embed_template') ?? '').trim() ? { embed_template: String(form.get('embed_template') ?? '').trim().slice(0, 40) || null } : {}), ignored_channel_ids: ignoredChannelIds, ignored_role_ids: ignoredRoleIds, ignored_user_ids: ignoredUserIds }) });
    saved = res.ok;
  } else if (action === 'disable_starboard') {
    const entriesRes = await fetch(`${apiUrl}/rest/v1/starboard_entries?guild_id=eq.${id}`, { method: 'DELETE', headers: apiHeaders });
    const res = await fetch(`${apiUrl}/rest/v1/starboards?guild_id=eq.${id}`, { method: 'DELETE', headers: apiHeaders });
    saved = entriesRes.ok && res.ok;
  } else if (action === 'save_voicemaster') {
    const creatorChannelId = String(form.get('creator_channel_id') ?? '').trim();
    const panelChannelId = String(form.get('panel_channel_id') ?? '').trim();
    const categoryId = String(form.get('category_id') ?? '').trim() || null;
    const defaultLimit = Math.max(0, Math.min(99, Number(form.get('default_limit') ?? 0) || 0));
    const defaultName = String(form.get('default_name') ?? '{user.name}').trim().slice(0, 100) || '{user.name}';
    if (creatorChannelId && panelChannelId) {
      const oldRes = await fetch(`${apiUrl}/rest/v1/voice_configs?guild_id=eq.${id}&select=panel_channel_id,panel_message_id`, { headers: apiHeaders });
      const [old] = oldRes.ok ? await oldRes.json() : [];
      if (old && (old.panel_channel_id !== panelChannelId || form.get('resend_panel') === 'on')) await deleteDiscordMessage(old.panel_channel_id, old.panel_message_id);
      const panelMessageId = old && old.panel_channel_id === panelChannelId && form.get('resend_panel') !== 'on' ? old.panel_message_id : await postVoiceMasterPanel(panelChannelId);
      if (!panelMessageId) {
        error = dt('Could not post the VoiceMaster panel. Check the bot permissions in that channel.');
      } else {
        const res = await fetch(`${apiUrl}/rest/v1/voice_configs?on_conflict=guild_id`, { method: 'POST', headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify({ guild_id: id, creator_channel_id: creatorChannelId, panel_channel_id: panelChannelId, panel_message_id: panelMessageId, category_id: categoryId, default_limit: defaultLimit, default_name: defaultName, updated_at: new Date().toISOString() }) });
        saved = res.ok;
      }
    }
  } else if (action === 'disable_voicemaster') {
    const oldRes = await fetch(`${apiUrl}/rest/v1/voice_configs?guild_id=eq.${id}&select=panel_channel_id,panel_message_id`, { headers: apiHeaders });
    const [old] = oldRes.ok ? await oldRes.json() : [];
    await deleteDiscordMessage(old?.panel_channel_id, old?.panel_message_id);
    const res = await fetch(`${apiUrl}/rest/v1/voice_configs?guild_id=eq.${id}`, { method: 'DELETE', headers: apiHeaders });
    saved = res.ok;
  }
}

const [guildInfo, commandsRes, respondersRes, stickyRes, reactionRolesRes, reactionTriggersRes, reactionMessagesRes, disabledRes, autoThreadsRes, aliasesRes, timersRes, starboardRes, voiceMasterRes, webhooksRes, countersRes, rolesRes, channelsRes, embedTemplatesRes] = await runBatched([
  () => getGuildInfo(id, botToken),
  () => fetch(`${apiUrl}/rest/v1/custom_commands?guild_id=eq.${id}&select=id,name,response,embed_template&order=name.asc`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/auto_responders?guild_id=eq.${id}&select=id,ar_id,trigger,reply,match_mode,delete_trigger,reply_to_trigger,ping_user,channel_ids,role_ids,reply_type,embed_color,embed_title,embed_footer,embed_template&order=trigger.asc`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/sticky_messages?guild_id=eq.${id}&select=channel_id,content`, { headers: apiHeaders }),
  () => fetch(apiUrl + '/rest/v1/reaction_roles?guild_id=eq.' + id + '&select=id,message_id,emoji,role_id,mode,interaction_type,button_label', { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/reaction_triggers?guild_id=eq.${id}&select=id,emoji,trigger,owner_id,match_mode,channel_ids,role_ids,case_sensitive,cooldown_seconds,enabled&order=trigger.asc`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/reaction_message_configs?guild_id=eq.${id}&select=id,channel_id,emojis&order=channel_id.asc`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/disabled_commands?guild_id=eq.${id}&select=id,command,channel_id`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/auto_threads?guild_id=eq.${id}&select=channel_id,name_template,message_text,embed_template,archive_minutes`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/command_aliases?guild_id=eq.${id}&select=id,name,command&order=name.asc`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/auto_messages?guild_id=eq.${id}&select=id,channel_id,interval_ms,message,next_run_at&order=id.asc`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/starboards?guild_id=eq.${id}&select=*`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/voice_configs?guild_id=eq.${id}&select=*`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/managed_webhooks?guild_id=eq.${id}&select=id,name,channel_id,webhook_id,default_username,default_avatar_url,default_message,default_embed,enabled&order=id.asc`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/server_counters?guild_id=eq.${id}&select=id,channel_id,counter_option,channel_type,name_template,prefix,suffix,parent_id,interval_seconds,enabled&order=id.asc`, { headers: apiHeaders }),
  () => getGuildList(Astro, id, botToken, 'roles'),
  () => getGuildList(Astro, id, botToken, 'channels'),
  () => fetch(`${apiUrl}/rest/v1/embed_templates?guild_id=eq.${id}&select=name&order=name.asc`, { headers: apiHeaders }),
], 6);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

// The prefix of the server and which custom commands are written in code. Both are read apart and tolerate a database that
// does not have them yet, so the list never goes missing.
let guildPrefix = '!';
try {
  const prefixRes = await fetch(`${apiUrl}/rest/v1/guilds?guild_id=eq.${id}&select=prefix`, { headers: apiHeaders });
  if (prefixRes.ok) guildPrefix = String((await prefixRes.json())?.[0]?.prefix || '!');
} catch {}
const codeCommandNames = new Set<string>();
try {
  const codeRes = await fetch(`${apiUrl}/rest/v1/custom_commands?guild_id=eq.${id}&code=not.is.null&select=name`, { headers: apiHeaders });
  if (codeRes.ok) for (const row of await codeRes.json()) codeCommandNames.add(row.name);
} catch {}

const customCommands = commandsRes.ok ? (await commandsRes.json()).map((c: any) => ({ id: c.id, name: c.name, response: c.response, embedTemplate: c.embed_template, isCode: codeCommandNames.has(c.name) })) : [];
const embedTemplateNames = embedTemplatesRes.ok ? (await embedTemplatesRes.json()).map((t: any) => t.name) : [];
const autoResponders = respondersRes.ok ? (await respondersRes.json()).map((a: any) => ({
  id: a.id, arId: a.ar_id, trigger: a.trigger, reply: a.reply, matchMode: a.match_mode, deleteTrigger: a.delete_trigger ?? false, replyToTrigger: a.reply_to_trigger ?? false, pingUser: a.ping_user ?? false, channelIds: a.channel_ids ?? [], roleIds: a.role_ids ?? [],
  replyType: a.reply_type ?? 'text', embedColor: a.embed_color, embedTitle: a.embed_title, embedFooter: a.embed_footer, embedTemplate: a.embed_template,
})) : [];
const stickyMessages = stickyRes.ok ? (await stickyRes.json()).map((s: any) => ({ channelId: s.channel_id, content: s.content })) : [];
const reactionRoles = reactionRolesRes.ok ? (await reactionRolesRes.json()).map((r: any) => ({ id: r.id, messageId: r.message_id, emoji: r.emoji, roleId: r.role_id, mode: r.mode, interactionType: r.interaction_type ?? 'reaction', buttonLabel: r.button_label ?? null })) : [];
const reactionTriggers = reactionTriggersRes.ok ? (await reactionTriggersRes.json()).map((r: any) => ({ id: r.id, emoji: r.emoji, trigger: r.trigger, ownerId: r.owner_id, matchMode: r.match_mode ?? 'contains', channelIds: r.channel_ids ?? [], roleIds: r.role_ids ?? [], caseSensitive: r.case_sensitive ?? false, cooldownSeconds: r.cooldown_seconds ?? 0, enabled: r.enabled !== false })) : [];
const reactionMessages = reactionMessagesRes.ok ? (await reactionMessagesRes.json()).map((r: any) => ({ id: r.id, channelId: r.channel_id, emojis: r.emojis ?? [] })) : [];
const disabledCommands = disabledRes.ok ? (await disabledRes.json()).map((d: any) => ({ id: d.id, command: d.command, channelId: d.channel_id })) : [];
const autoThreads = autoThreadsRes.ok ? (await autoThreadsRes.json()).map((t: any) => ({ channelId: t.channel_id, nameTemplate: t.name_template, messageText: t.message_text, embedTemplate: t.embed_template, archiveMinutes: t.archive_minutes })) : [];
const aliases = aliasesRes.ok ? (await aliasesRes.json()).map((a: any) => ({ id: a.id, name: a.name, command: a.command })) : [];
const timers = timersRes.ok ? (await timersRes.json()).map((t: any) => ({ id: t.id, channelId: t.channel_id, intervalMs: Number(t.interval_ms), message: t.message, nextRunAt: t.next_run_at })) : [];
const starboardRows = starboardRes.ok ? await starboardRes.json() : [];
const starboard = starboardRows[0] ? { ...starboardRows[0], ignoredChannelIds: starboardRows[0].ignored_channel_ids ?? [], ignoredRoleIds: starboardRows[0].ignored_role_ids ?? [], ignoredUserIds: starboardRows[0].ignored_user_ids ?? [] } : null;
const voiceRows = voiceMasterRes.ok ? await voiceMasterRes.json() : [];
const voiceMaster = voiceRows[0] ? { creatorChannelId: voiceRows[0].creator_channel_id, panelChannelId: voiceRows[0].panel_channel_id, panelMessageId: voiceRows[0].panel_message_id, categoryId: voiceRows[0].category_id, defaultLimit: voiceRows[0].default_limit ?? 0, defaultName: voiceRows[0].default_name ?? '{user.name}' } : null;
const managedWebhooks = webhooksRes.ok ? (await webhooksRes.json()).map((w: any) => ({ id: w.id, name: w.name, channelId: w.channel_id, webhookId: w.webhook_id, defaultUsername: w.default_username, defaultAvatarUrl: w.default_avatar_url, defaultMessage: w.default_message, enabled: w.enabled !== false })) : [];
const serverCounters = countersRes.ok ? (await countersRes.json()).map((c: any) => ({ id: c.id, channelId: c.channel_id, option: c.counter_option, type: c.channel_type, nameTemplate: c.name_template ?? '{option}: {value}', prefix: c.prefix ?? '', suffix: c.suffix ?? '', parentId: c.parent_id, intervalSeconds: c.interval_seconds ?? 60, enabled: c.enabled !== false })) : [];

const allRoles = rolesRes.ok ? await rolesRes.json() : [];
const roles = allRoles
  .filter((r: any) => r.name !== '@everyone')
  .sort((a: any, b: any) => b.position - a.position)
  .map((r: any) => ({ id: r.id, name: r.name }));

const allChannels = channelsRes.ok ? await channelsRes.json() : [];
const channels = allChannels
  .filter((c: any) => c.type === 0 || c.type === 5)
  .sort((a: any, b: any) => a.position - b.position)
  .map((c: any) => ({ id: c.id, name: c.name }));
const voiceChannels = allChannels.filter((c: any) => c.type === 2 || c.type === 13).sort((a: any, b: any) => a.position - b.position).map((c: any) => ({ id: c.id, name: c.name }));
const channelCategories = allChannels.filter((c: any) => c.type === 4).sort((a: any, b: any) => a.position - b.position).map((c: any) => ({ id: c.id, name: c.name }));
