---
export const prerender = false;
import DashCustomize from '../../../../components/DashCustomize.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, imageUrlToDataUri, fileToDataUri, setBotGuildProfile, setBotNameStyle, getGuildMemberSelf, getBotProfile, getBotDescription } from '../../../../utils/discord';
import { parseNameStyleForm, readNameStyle, sameNameStyle } from '../../../../utils/nameStyle';
import { hasPremiumForGuild, resetGuildPremiumCustomizationIfStale } from '../../../../utils/premium';
import { cached } from '../../../../utils/sharedCache';

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;

if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const premiumActive = await hasPremiumForGuild(Astro, session.userId, id);

// The webhook performs this eagerly on cancellation/expiry. This request-time
// fallback covers missed webhooks and guarantees that an inactive slot can
// never leave a Premium-only profile override applied in Discord. Nicknames
// intentionally remain because they are available on the Free plan.
if (!premiumActive) await resetGuildPremiumCustomizationIfStale(Astro, id);

const apiHeaders = {
  apikey: apiKey,
  Authorization: `Bearer ${apiKey}`,
  'Content-Type': 'application/json',
};

// Fetched up front, both to render the form and, on POST, to know whether the
// avatar/banner actually changed, so an unrelated save (e.g. just editing the
// description) never silently resets them back to the default.
async function loadConfig() {
  const res = await fetch(`${apiUrl}/rest/v1/guilds?guild_id=eq.${id}&select=bot_nickname,bot_avatar_url,bot_banner_url,bot_description`, { headers: apiHeaders });
  const rows = res.ok ? await res.json() : [];
  return rows[0] ?? { bot_nickname: null, bot_avatar_url: null, bot_banner_url: null, bot_description: null };
}

// The name style lives in its own column and its own requests: a database that does not have the column yet, or a
// Discord that refuses the fields, must not stop the rest of the profile from loading or saving.
async function loadNameStyle() {
  try {
    const res = await fetch(`${apiUrl}/rest/v1/guilds?guild_id=eq.${id}&select=bot_name_style`, { headers: apiHeaders });
    const rows = res.ok ? await res.json() : [];
    return readNameStyle(rows[0]?.bot_name_style);
  } catch {
    return null;
  }
}

async function saveNameStyle(style: ReturnType<typeof readNameStyle>): Promise<boolean> {
  const res = await fetch(`${apiUrl}/rest/v1/guilds?guild_id=eq.${encodeURIComponent(id)}`, {
    method: 'PATCH',
    headers: { ...apiHeaders, Prefer: 'return=minimal' },
    body: JSON.stringify({ bot_name_style: style, updated_at: new Date().toISOString() }),
  }).catch(() => null);
  return Boolean(res?.ok);
}

let saved = false;
let error: string | null = null;
let discordWarning = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const resetField = String(form.get('reset_field') ?? '').trim();

  // Nicknames are a free, per-server identity aid. Free servers may only
  // submit this field; avatar, banner, and bio remain Premium-only even if a
  // client tries to add those fields manually.
  if (!premiumActive) {
    if (resetField && resetField !== 'nickname') return Astro.redirect(`/dash/premium?guild_id=${encodeURIComponent(id)}&error=premium_required`);

    const stored = await loadConfig();
    const nickname = resetField === 'nickname'
      ? ''
      : String(form.get('nickname') ?? '').trim().slice(0, 32);
    if (nickname !== (stored.bot_nickname ?? '')) {
      const applied = await setBotGuildProfile(id, botToken, { nick: nickname || null });
      if (!applied) discordWarning = true;
    }

    const dbRes = await fetch(`${apiUrl}/rest/v1/guilds?guild_id=eq.${encodeURIComponent(id)}`, {
      method: 'PATCH',
      headers: { ...apiHeaders, Prefer: 'return=minimal' },
      body: JSON.stringify({ bot_nickname: nickname || null, updated_at: new Date().toISOString() }),
    });
    if (dbRes.ok) saved = true;
    else error = 'discord_rejected';
  } else if (resetField) {

  // Reset buttons are independent actions. They must persist immediately and
  // must not accidentally save other unsaved fields from the form at the same
  // time (for example, an avatar reset must not also save a draft nickname).
  if (resetField === 'name_style') {
    // With no style set there is nothing to clear in Discord, so it is not asked (and cannot refuse).
    const applied = (await loadNameStyle()) ? await setBotNameStyle(id, botToken, null) : true;
    if (!applied) discordWarning = true;
    if (await saveNameStyle(null)) saved = true;
    else error = 'discord_rejected';
  } else if (['nickname', 'avatar', 'banner', 'description'].includes(resetField)) {
    const resetPatch = {
      nickname: { discord: { nick: null }, database: { bot_nickname: null } },
      avatar: { discord: { avatarDataUri: null }, database: { bot_avatar_url: null } },
      banner: { discord: { bannerDataUri: null }, database: { bot_banner_url: null } },
      description: { discord: { bio: null }, database: { bot_description: null } },
    }[resetField] as { discord: Parameters<typeof setBotGuildProfile>[2]; database: Record<string, null> };

    const applied = await setBotGuildProfile(id, botToken, resetPatch.discord);
    if (!applied) discordWarning = true;

    const dbRes = await fetch(`${apiUrl}/rest/v1/guilds?guild_id=eq.${encodeURIComponent(id)}`, {
      method: 'PATCH',
      headers: { ...apiHeaders, Prefer: 'return=minimal' },
      body: JSON.stringify({ ...resetPatch.database, updated_at: new Date().toISOString() }),
    });
    if (dbRes.ok) saved = true;
    else error = 'discord_rejected';
  }
  } else {
    const stored = await loadConfig();

    const nickname = String(form.get('nickname') ?? '').trim().slice(0, 32);
    const avatarUrl = String(form.get('avatar_url') ?? '').trim();
    const avatarFile = form.get('avatar_file');
    const bannerUrl = String(form.get('banner_url') ?? '').trim();
    const bannerFile = form.get('banner_file');
    const description = String(form.get('description') ?? '').replace(/\r\n/g, '\n').trim().slice(0, 190);

    let avatarDataUri: string | null | undefined;
    let nextAvatarUrl = avatarUrl;
    if (avatarFile instanceof File && avatarFile.size > 0) {
      const result = await fileToDataUri(avatarFile);
      if ('error' in result) error = result.error === 'too_large' ? 'avatar_too_large' : 'avatar_fetch_failed';
      else { avatarDataUri = result.dataUri; nextAvatarUrl = ''; }
    } else if (avatarUrl && avatarUrl !== (stored.bot_avatar_url ?? '')) {
      const result = await imageUrlToDataUri(avatarUrl);
      if ('error' in result) error = result.error === 'too_large' ? 'avatar_too_large' : 'avatar_fetch_failed';
      else avatarDataUri = result.dataUri;
    } else if (!avatarUrl && (stored.bot_avatar_url ?? '')) {
      avatarDataUri = null; // was cleared
    }

    let bannerDataUri: string | null | undefined;
    let nextBannerUrl = bannerUrl;
    if (!error) {
      if (bannerFile instanceof File && bannerFile.size > 0) {
        const result = await fileToDataUri(bannerFile);
        if ('error' in result) error = result.error === 'too_large' ? 'banner_too_large' : 'banner_fetch_failed';
        else { bannerDataUri = result.dataUri; nextBannerUrl = ''; }
      } else if (bannerUrl && bannerUrl !== (stored.bot_banner_url ?? '')) {
        const result = await imageUrlToDataUri(bannerUrl);
        if ('error' in result) error = result.error === 'too_large' ? 'banner_too_large' : 'banner_fetch_failed';
        else bannerDataUri = result.dataUri;
      } else if (!bannerUrl && (stored.bot_banner_url ?? '')) {
        bannerDataUri = null; // was cleared
      }
    }

    if (!error) {
      // nick/avatar/banner/bio are all real Discord fields on the same "Modify Current Member"
      // endpoint, applied together in one PATCH call.
      const bioChanged = description !== (stored.bot_description ?? '');
      if (nickname !== (stored.bot_nickname ?? '') || avatarDataUri !== undefined || bannerDataUri !== undefined || bioChanged) {
        const applied = await setBotGuildProfile(id, botToken, { nick: nickname || null, avatarDataUri, bannerDataUri, bio: description || null });
        if (!applied) discordWarning = true;
      }

      const dbRes = await fetch(`${apiUrl}/rest/v1/guilds?on_conflict=guild_id`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({
          guild_id: id,
          bot_nickname: nickname || null,
          bot_avatar_url: nextAvatarUrl || null,
          bot_banner_url: nextBannerUrl || null,
          bot_description: description || null,
          updated_at: new Date().toISOString(),
        }),
      });

      if (dbRes.ok) saved = true;
      else error = 'discord_rejected';

      // The name style, only when it changed. Discord's answer decides: a style it refuses is not saved.
      const parsedStyle = parseNameStyleForm(form);
      if ('error' in parsedStyle) {
        error = parsedStyle.error;
        saved = false;
      } else if (!sameNameStyle(parsedStyle.style, await loadNameStyle())) {
        if (await setBotNameStyle(id, botToken, parsedStyle.style)) {
          if (!(await saveNameStyle(parsedStyle.style))) error = 'discord_rejected';
        } else {
          error = 'name_style_rejected';
          saved = false;
        }
      }
    }
  }
}

// A reset button asks without leaving the page (it sends this header) and gets what happened as JSON.
if (Astro.request.method === 'POST' && Astro.request.headers.get('x-petto-ajax') === '1') {
  return new Response(JSON.stringify({ saved, warning: discordWarning, error }), { headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' } });
}

// The bot's global name, avatar and description are the same in every server and change rarely, so they are kept ten minutes and then
// shown at once for up to a day while they are read again. Its look in this server is kept the same way and read again as soon as it
// changes (getGuildMemberSelf). The bot's id is the first part of its token, so that read starts with the rest.
const BOT_GLOBAL_TTL_MS = 10 * 60_000;
const BOT_GLOBAL_STALE_MS = 24 * 3600_000;
const botIdFromToken = (() => { try { const value = atob(botToken.split('.')[0]); return /^\d{15,22}$/.test(value) ? value : null; } catch { return null; } })();
const [guildInfo, botProfile, globalDescription, config, nameStyle, memberSelfEarly] = await Promise.all([
  getGuildInfo(id, botToken),
  cached(`bot-profile:${botToken.split('.')[0]}`, () => getBotProfile(botToken), { freshMs: BOT_GLOBAL_TTL_MS, staleMs: BOT_GLOBAL_STALE_MS, allowStale: true, shared: true, keep: (value) => value !== null }),
  cached(`bot-description:${botToken.split('.')[0]}`, () => getBotDescription(botToken), { freshMs: BOT_GLOBAL_TTL_MS, staleMs: BOT_GLOBAL_STALE_MS, allowStale: true, shared: true }),
  loadConfig(),
  loadNameStyle(),
  botIdFromToken ? getGuildMemberSelf(id, botToken, botIdFromToken) : Promise.resolve(null),
]);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');
const memberSelf = memberSelfEarly ?? (botProfile && botProfile.id !== botIdFromToken ? await getGuildMemberSelf(id, botToken, botProfile.id) : null);

const nicknameValue = config.bot_nickname ?? '';
const avatarUrlValue = config.bot_avatar_url ?? '';
const bannerUrlValue = config.bot_banner_url ?? '';
const descriptionValue = config.bot_description ?? '';
const botUsername = botProfile?.username ?? 'Petto';

const effectiveAvatar = memberSelf?.avatarUrl || botProfile?.avatarUrl || guildInfo.icon || '/assets/mascot-icon.webp';
const effectiveBanner = memberSelf?.bannerUrl || botProfile?.bannerUrl || null;
// Discord's PATCH accepts and applies `bio`, confirmed live, but the GET member endpoint never
// echoes it back, so our own database is the only place this can be read from afterward.
const effectiveDescription = descriptionValue || globalDescription;
---
<DashCustomize
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'}
  nickname={nicknameValue}
  avatarUrl={avatarUrlValue}
  effectiveAvatar={effectiveAvatar}
  botUsername={botUsername}
  bannerUrl={bannerUrlValue}
  effectiveBanner={effectiveBanner}
  description={descriptionValue}
  effectiveDescription={effectiveDescription}
  globalUsername={botProfile?.username ?? 'Petto'}
  globalAvatar={botProfile?.avatarUrl}
  globalBanner={botProfile?.bannerUrl}
  globalDescription={globalDescription}
  saved={saved}
  discordWarning={discordWarning}
  error={error}
  premiumActive={premiumActive}
  nameStyle={nameStyle}
/>
