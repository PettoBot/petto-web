---
export const prerender = false;
import { makeT, getDashLang } from '../../../../i18n/dash';
import DashLogging from '../../../../components/DashLogging.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { noteGuildWrite } from '../../../../utils/guildSnapshots';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';

const EVENTS = ['sanctions', 'automod', 'verification', 'members', 'messages', 'voice', 'roles', 'channels', 'invites', 'emojis', 'webhooks', 'threads', 'integrations', 'commands', 'tickets', 'server'];

// The value of the "Create a new channel" choice in a channel picker.
const NEW_CHANNEL = '__new__';

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;

if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const apiHeaders = {
  apikey: apiKey,
  Authorization: `Bearer ${apiKey}`,
  'Content-Type': 'application/json',
};

let saved = false;

const dt = makeT(getDashLang(Astro));
const problems: string[] = [];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? 'routing');

  if (action === 'add_ignored') {
    // Ids, user mentions (<@123>) and channel mentions (<#123>), as many as are pasted.
    const targetIds = [...new Set([...String(form.get('target_id') ?? '').matchAll(/\d{15,25}/g)].map((match) => match[0]))].slice(0, 50);
    if (targetIds.length) {
      const ignoredRes = await fetch(`${apiUrl}/rest/v1/log_ignored?on_conflict=guild_id,target_id`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify(targetIds.map((targetId) => ({ guild_id: id, target_id: targetId }))),
      });
      if (ignoredRes.ok) saved = true; else problems.push(dt('The ignored list could not be saved. Try again.'));
    } else {
      problems.push(dt('Paste at least one user or channel ID, or a mention.'));
    }
  } else if (action === 'delete_ignored') {
    const targetId = encodeURIComponent(String(form.get('target_id') ?? ''));
    await fetch(`${apiUrl}/rest/v1/log_ignored?guild_id=eq.${id}&target_id=eq.${targetId}`, { method: 'DELETE', headers: apiHeaders });
    saved = true;
  } else {
    const [entriesRes, webhooksRes, channelList] = await Promise.all([
      fetch(`${apiUrl}/rest/v1/log_entries?guild_id=eq.${id}&select=event,channel_id`, { headers: apiHeaders }),
      fetch(`${apiUrl}/rest/v1/log_webhooks?guild_id=eq.${id}&select=channel_id`, { headers: apiHeaders }),
      getGuildList(Astro, id, botToken, 'channels').then((r: Response) => (r.ok ? r.json() : [])).catch(() => []),
    ]);
    const currentEntries: { event: string; channel_id: string }[] = entriesRes.ok ? await entriesRes.json() : [];
    const currentRouting: Record<string, string> = {};
    for (const e of currentEntries) currentRouting[e.event] = e.channel_id;
    const existingWebhookChannels = new Set<string>((webhooksRes.ok ? await webhooksRes.json() : []).map((w: { channel_id: string }) => w.channel_id));
    const channelNames = new Map<string, string>((channelList as any[]).map((c: any) => [c.id, c.name]));

    // What changed: the events that move to a channel (or turn off). Many events usually point at the same channel.
    const changes: { eventId: string; selected: string; previous: string | undefined }[] = [];
    for (const eventId of EVENTS) {
      const selected = String(form.get(`event_${eventId}`) ?? '').trim();
      const previous = currentRouting[eventId];
      if (selected !== (previous ?? '')) changes.push({ eventId, selected, previous });
    }

    // "Create a new channel": one private channel for every event that asked for it, made before the webhooks.
    if (changes.some((c) => c.selected === NEW_CHANNEL)) {
      let botId = '';
      try { botId = atob(botToken.split('.')[0]); } catch { botId = ''; }
      const created = await fetch(`https://discord.com/api/guilds/${id}/channels`, {
        method: 'POST',
        headers: { Authorization: `Bot ${botToken}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: 'petto-logs',
          type: 0,
          topic: 'Server logs sent by Petto.',
          // Only the staff (and Petto) can see it: everyone else is denied View Channel.
          permission_overwrites: [
            { id, type: 0, deny: '1024' },
            ...(botId ? [{ id: botId, type: 1, allow: String(1024 + 2048 + 16384 + 536870912) }] : []),
          ],
        }),
      }).catch(() => null);
      const detail: any = created ? await created.json().catch(() => null) : null;
      if (created?.ok && detail?.id) {
        noteGuildWrite(id);
        for (const c of changes) if (c.selected === NEW_CHANNEL) c.selected = String(detail.id);
        channelNames.set(String(detail.id), 'petto-logs');
      } else {
        problems.push(detail?.code === 50013 || created?.status === 403 ? dt('I need the Manage Channels permission to create a channel.') : dt('The channel could not be created.'));
        for (let i = changes.length - 1; i >= 0; i -= 1) if (changes[i].selected === NEW_CHANNEL) changes.splice(i, 1);
      }
    }

    // One webhook per channel that has none yet, all at once. A channel that cannot get one is reported and its events are left as they were.
    const needWebhook = [...new Set(changes.map((c) => c.selected).filter((c) => c && !existingWebhookChannels.has(c)))];
    const failedChannels = new Map<string, string>();
    await Promise.all(needWebhook.map(async (channelId) => {
      const whRes = await fetch(`https://discord.com/api/channels/${channelId}/webhooks`, {
        method: 'POST',
        headers: { Authorization: `Bot ${botToken}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: 'Petto Logs' }),
      }).catch(() => null);
      if (whRes?.ok) {
        noteGuildWrite(id);
        const webhook = await whRes.json();
        const stored = await fetch(`${apiUrl}/rest/v1/log_webhooks?on_conflict=guild_id,channel_id`, {
          method: 'POST',
          headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
          body: JSON.stringify({ guild_id: id, channel_id: channelId, webhook_id: webhook.id, webhook_token: webhook.token }),
        });
        if (stored.ok) existingWebhookChannels.add(channelId);
        else failedChannels.set(channelId, dt('Something went wrong, try again.'));
        return;
      }
      // Without a webhook nothing can be logged there, so the route is not saved as if it worked.
      const detail: any = whRes ? await whRes.json().catch(() => null) : null;
      failedChannels.set(channelId, detail?.code === 50013 || whRes?.status === 403
        ? dt('I need the Manage Webhooks permission in that channel.')
        : detail?.code === 30007 ? dt('That channel already has the maximum of 15 webhooks.')
        : detail?.code === 10003 ? dt('That channel no longer exists.')
        : dt('Discord did not accept it.'));
    }));

    const applicable = changes.filter((c) => !c.selected || existingWebhookChannels.has(c.selected));
    for (const c of changes) {
      if (c.selected && failedChannels.has(c.selected)) {
        problems.push(`${dt('Could not set up #{channel} for {event}.', { channel: channelNames.get(c.selected) ?? c.selected, event: c.eventId })} ${failedChannels.get(c.selected)}`);
      }
    }

    // Two writes for everything: remove the old routes of the events that changed, then add the new ones.
    const toClear = applicable.filter((c) => c.previous).map((c) => c.eventId);
    if (toClear.length) {
      const del = await fetch(`${apiUrl}/rest/v1/log_entries?guild_id=eq.${id}&event=in.(${toClear.join(',')})`, { method: 'DELETE', headers: apiHeaders });
      if (!del.ok) problems.push(dt('Something went wrong, try again.'));
    }
    const toAdd = applicable.filter((c) => c.selected).map((c) => ({ guild_id: id, channel_id: c.selected, event: c.eventId }));
    if (toAdd.length) {
      const add = await fetch(`${apiUrl}/rest/v1/log_entries?on_conflict=guild_id,channel_id,event`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify(toAdd),
      });
      if (!add.ok) problems.push(dt('Something went wrong, try again.'));
    }

    saved = problems.length === 0;
  }
}

const [guildInfo, entriesRes, ignoredRes, channelsRes] = await Promise.all([
  getGuildInfo(id, botToken),
  fetch(`${apiUrl}/rest/v1/log_entries?guild_id=eq.${id}&select=event,channel_id`, { headers: apiHeaders }),
  fetch(`${apiUrl}/rest/v1/log_ignored?guild_id=eq.${id}&select=target_id`, { headers: apiHeaders }),
  getGuildList(Astro, id, botToken, 'channels'),
]);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');
const entries: { event: string; channel_id: string }[] = entriesRes.ok ? await entriesRes.json() : [];
const routing: Record<string, string> = {};
for (const e of entries) routing[e.event] = e.channel_id;

const allChannels = channelsRes.ok ? await channelsRes.json() : [];
// Channels come with the name of their category, so the pickers can group them the way Discord does.
const categoryNames = new Map<string, string>(allChannels.filter((c: any) => c.type === 4).map((c: any) => [String(c.id), String(c.name)]));
const categoryOrder = new Map<string, number>(allChannels.filter((c: any) => c.type === 4).map((c: any) => [String(c.id), Number(c.position ?? 0)]));
const channels = allChannels
  .filter((c: any) => c.type === 0 || c.type === 5)
  .sort((a: any, b: any) => (categoryOrder.get(String(a.parent_id)) ?? -1) - (categoryOrder.get(String(b.parent_id)) ?? -1) || a.position - b.position)
  .map((c: any) => ({ id: c.id, name: c.name, category: categoryNames.get(String(c.parent_id)) ?? '' }));

function channelName(channelId: string) {
  return channels.find((c: any) => c.id === channelId)?.name ?? null;
}
const rawIgnored = ignoredRes.ok ? await ignoredRes.json() : [];
const ignoredIds = rawIgnored.map((r: any) => ({ targetId: r.target_id, channelName: channelName(r.target_id) }));
---
<DashLogging
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'}
  channels={channels}
  routing={routing}
  ignoredIds={ignoredIds}
  saved={saved}
  problems={problems}
/>
