---
export const prerender = false;
import { makeT, getDashLang } from '../../../../i18n/dash';
import DashLogging from '../../../../components/DashLogging.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';

const EVENTS = ['sanctions', 'automod', 'verification', 'members', 'messages', 'voice', 'roles', 'channels', 'invites', 'emojis', 'webhooks', 'threads', 'integrations', 'commands', 'tickets', 'server'];

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;

if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const apiHeaders = {
  apikey: apiKey,
  Authorization: `Bearer ${apiKey}`,
  'Content-Type': 'application/json',
};

let saved = false;

const dt = makeT(getDashLang(Astro));
const problems: string[] = [];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? 'routing');

  if (action === 'add_ignored') {
    // Ids, user mentions (<@123>) and channel mentions (<#123>), as many as are pasted.
    const targetIds = [...new Set([...String(form.get('target_id') ?? '').matchAll(/\d{15,25}/g)].map((match) => match[0]))].slice(0, 50);
    if (targetIds.length) {
      const ignoredRes = await fetch(`${apiUrl}/rest/v1/log_ignored?on_conflict=guild_id,target_id`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify(targetIds.map((targetId) => ({ guild_id: id, target_id: targetId }))),
      });
      if (ignoredRes.ok) saved = true; else problems.push(dt('The ignored list could not be saved. Try again.'));
    } else {
      problems.push(dt('Paste at least one user or channel ID, or a mention.'));
    }
  } else if (action === 'delete_ignored') {
    const targetId = encodeURIComponent(String(form.get('target_id') ?? ''));
    await fetch(`${apiUrl}/rest/v1/log_ignored?guild_id=eq.${id}&target_id=eq.${targetId}`, { method: 'DELETE', headers: apiHeaders });
    saved = true;
  } else {
    const entriesRes = await fetch(`${apiUrl}/rest/v1/log_entries?guild_id=eq.${id}&select=event,channel_id`, { headers: apiHeaders });
    const currentEntries: { event: string; channel_id: string }[] = entriesRes.ok ? await entriesRes.json() : [];
    const currentRouting: Record<string, string> = {};
    for (const e of currentEntries) currentRouting[e.event] = e.channel_id;

    const webhooksRes = await fetch(`${apiUrl}/rest/v1/log_webhooks?guild_id=eq.${id}&select=channel_id`, { headers: apiHeaders });
    const existingWebhookChannels = new Set<string>((webhooksRes.ok ? await webhooksRes.json() : []).map((w: { channel_id: string }) => w.channel_id));

    const channelNames = new Map<string, string>(((await getGuildList(Astro, id, botToken, 'channels').then((r: Response) => (r.ok ? r.json() : [])).catch(() => [])) as any[]).map((c: any) => [c.id, c.name]));
    for (const eventId of EVENTS) {
      const selected = String(form.get(`event_${eventId}`) ?? '').trim();
      const previous = currentRouting[eventId];
      if (selected === (previous ?? '')) continue;

      if (previous) {
        await fetch(`${apiUrl}/rest/v1/log_entries?guild_id=eq.${id}&event=eq.${eventId}`, { method: 'DELETE', headers: apiHeaders });
      }

      if (!selected) continue;

      if (!existingWebhookChannels.has(selected)) {
        const whRes = await fetch(`https://discord.com/api/channels/${selected}/webhooks`, {
          method: 'POST',
          headers: { Authorization: `Bot ${botToken}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: 'Petto Logs' }),
        });
        if (whRes.ok) {
          const webhook = await whRes.json();
          await fetch(`${apiUrl}/rest/v1/log_webhooks?on_conflict=guild_id,channel_id`, {
            method: 'POST',
            headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
            body: JSON.stringify({ guild_id: id, channel_id: selected, webhook_id: webhook.id, webhook_token: webhook.token }),
          });
          existingWebhookChannels.add(selected);
        } else {
          // Without a webhook nothing can be logged there, so the route is not saved as if it worked.
          const detail: any = await whRes.json().catch(() => null);
          const reason = detail?.code === 50013 || whRes.status === 403
            ? dt('I need the Manage Webhooks permission in that channel.')
            : detail?.code === 30007 ? dt('That channel already has the maximum of 15 webhooks.')
            : detail?.code === 10003 ? dt('That channel no longer exists.')
            : dt('Discord did not accept it.');
          problems.push(`${dt('Could not set up #{channel} for {event}.', { channel: channelNames.get(selected) ?? selected, event: eventId })} ${reason}`);
          continue;
        }
      }

      await fetch(`${apiUrl}/rest/v1/log_entries?on_conflict=guild_id,channel_id,event`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({ guild_id: id, channel_id: selected, event: eventId }),
      });
    }

    saved = problems.length === 0;
  }
}

const [guildInfo, entriesRes, ignoredRes, channelsRes] = await Promise.all([
  getGuildInfo(id, botToken),
  fetch(`${apiUrl}/rest/v1/log_entries?guild_id=eq.${id}&select=event,channel_id`, { headers: apiHeaders }),
  fetch(`${apiUrl}/rest/v1/log_ignored?guild_id=eq.${id}&select=target_id`, { headers: apiHeaders }),
  getGuildList(Astro, id, botToken, 'channels'),
]);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');
const entries: { event: string; channel_id: string }[] = entriesRes.ok ? await entriesRes.json() : [];
const routing: Record<string, string> = {};
for (const e of entries) routing[e.event] = e.channel_id;

const allChannels = channelsRes.ok ? await channelsRes.json() : [];
const channels = allChannels
  .filter((c: any) => c.type === 0 || c.type === 5)
  .sort((a: any, b: any) => a.position - b.position)
  .map((c: any) => ({ id: c.id, name: c.name }));

function channelName(channelId: string) {
  return channels.find((c: any) => c.id === channelId)?.name ?? null;
}
const rawIgnored = ignoredRes.ok ? await ignoredRes.json() : [];
const ignoredIds = rawIgnored.map((r: any) => ({ targetId: r.target_id, channelName: channelName(r.target_id) }));
---
<DashLogging
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.png'}
  channels={channels}
  routing={routing}
  ignoredIds={ignoredIds}
  saved={saved}
  problems={problems}
/>
