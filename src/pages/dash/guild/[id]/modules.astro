---
export const prerender = false;
import DashModules from '../../../../components/DashModules.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { guildIconUrl, getGuildDetails } from '../../../../utils/discord';
import { loadModuleStatuses } from '../../../../utils/moduleStatuses';

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;
if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const guild = await getGuildDetails(id, botToken);
if (!guild) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

const { statuses } = await loadModuleStatuses(apiUrl, apiKey, id);
---
<DashModules
  user={session}
  guildId={id}
  guildName={guild.name}
  guildIcon={guildIconUrl(guild) ?? '/assets/mascot-icon.webp'}
  statuses={statuses}
/>
