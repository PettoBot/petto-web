---
export const prerender = false;
import DashOnboarding from '../../../../components/DashOnboarding.astro';
import { runOnboardingPage } from '../../../../utils/onboardingPage';
// Welcome: the messages (welcome, goodbye, boost), the DM on join and the ping on join. `?section=messages|dm|ping`.
const { id } = Astro.params as { id: string };
const result = await runOnboardingPage(Astro, id);
if ('redirect' in result) return Astro.redirect(result.redirect);
const section = Astro.url.searchParams.get('section');
const view = section === 'dm' || section === 'ping' ? section : 'messages';
---
<DashOnboarding {...(result.props as any)} view={view} />
