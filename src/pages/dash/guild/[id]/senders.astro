---
export const prerender = false;
import DashSenders from '../../../../components/DashSenders.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo } from '../../../../utils/discord';

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;
if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const apiHeaders = { apikey: apiKey, Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' };
const FEATURES = ['quests', 'welcome', 'leave', 'boost', 'sanctions', 'levelup', 'vanity'];
const isHttps = (value: string) => { try { return new URL(value).protocol === 'https:'; } catch { return false; } };

let saved = false;
let failed = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const feature = String(form.get('feature') ?? '');
  if (FEATURES.includes(feature)) {
    if (String(form.get('action') ?? '') === 'reset') {
      saved = (await fetch(`${apiUrl}/rest/v1/sender_identities?guild_id=eq.${id}&feature=eq.${feature}`, { method: 'DELETE', headers: { ...apiHeaders, Prefer: 'return=minimal' } })).ok;
    } else {
      const name = String(form.get('name') ?? '').trim().slice(0, 80);
      const avatar = String(form.get('avatar_url') ?? '').trim().slice(0, 500);
      if (/discord|^clyde$/i.test(name)) failed = 'name';
      else if (avatar && !isHttps(avatar)) failed = 'avatar';
      else if (!name && !avatar) failed = 'empty';
      else {
        const res = await fetch(`${apiUrl}/rest/v1/sender_identities?on_conflict=guild_id,feature`, {
          method: 'POST',
          headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
          body: JSON.stringify({ guild_id: id, feature, name: name || null, avatar_url: avatar || null, updated_at: new Date().toISOString() }),
        });
        saved = res.ok;
        if (!res.ok) failed = 'save';
      }
    }
  }
}

const [guildInfo, rowsRes] = await Promise.all([
  getGuildInfo(id, botToken),
  fetch(`${apiUrl}/rest/v1/sender_identities?guild_id=eq.${id}&select=*`, { headers: apiHeaders }),
]);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');
const ready = rowsRes.ok;
const rows: any[] = ready ? await rowsRes.json() : [];
const looks = Object.fromEntries(FEATURES.map((feature) => {
  const row = rows.find((entry) => entry.feature === feature);
  return [feature, { name: row?.name ?? '', avatarUrl: row?.avatar_url ?? '' }];
}));
---
<DashSenders user={session} guildId={id} guildName={guildInfo.name} guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'} looks={looks} features={FEATURES} ready={ready} saved={saved} failed={failed} />
