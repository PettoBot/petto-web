---
export const prerender = false;
import DashAuditLog from '../../../../components/DashAuditLog.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo } from '../../../../utils/discord';
import { cached } from '../../../../utils/sharedCache';
import { getDashLang, makeT } from '../../../../i18n/dash';
const dt = makeT(getDashLang(Astro));

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;

if (!botToken) return Astro.redirect('/dash/manage?error=server_not_configured');

const guildInfo = await getGuildInfo(id, botToken);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

const ACTION_LABELS: Record<number, string> = {
  1: dt('Created a channel'), 2: dt('Updated a channel'), 3: dt('Deleted a channel'),
  10: dt('Created a permission overwrite'), 11: dt('Updated a permission overwrite'), 12: dt('Deleted a permission overwrite'),
  20: 'Kicked a member', 21: 'Pruned members', 22: 'Banned a member', 23: 'Unbanned a member', 24: dt('Updated a member'), 25: dt('Updated a member role'),
  26: 'Moved a member', 27: 'Disconnected a member', 28: dt('Added a bot'),
  30: dt('Created a role'), 31: dt('Updated a role'), 32: dt('Deleted a role'),
  40: dt('Created an invite'), 41: dt('Updated an invite'), 42: dt('Deleted an invite'),
  50: dt('Created a webhook'), 51: dt('Updated a webhook'), 52: dt('Deleted a webhook'),
  60: dt('Created an emoji'), 61: dt('Updated an emoji'), 62: dt('Deleted an emoji'),
  72: dt('Updated the server'), 73: dt('Updated the server MFA level'), 74: dt('Updated the server integrations'),
  80: dt('Created an integration'), 81: dt('Updated an integration'), 82: dt('Deleted an integration'),
  83: dt('Created a stage instance'), 84: dt('Updated a stage instance'), 85: dt('Deleted a stage instance'),
  90: dt('Created a sticker'), 91: dt('Updated a sticker'), 92: dt('Deleted a sticker'),
  100: dt('Created an event'), 101: dt('Updated an event'), 102: dt('Deleted an event'),
  110: dt('Created a thread'), 111: dt('Updated a thread'), 112: dt('Deleted a thread'),
  120: dt('Created an application command'), 121: dt('Updated an application command'), 122: dt('Deleted an application command'),
  140: dt('Created an AutoMod rule'), 141: dt('Updated an AutoMod rule'), 142: dt('Deleted an AutoMod rule'),
  143: 'AutoMod blocked a message', 144: 'AutoMod flagged a message', 145: 'AutoMod timed out a member',
  150: dt('Created a creator monetization request'), 151: 'Accepted creator monetization terms',
  163: dt('Created an onboarding prompt'), 164: dt('Updated an onboarding prompt'), 165: dt('Deleted an onboarding prompt'), 166: dt('Created onboarding'), 167: dt('Updated onboarding'),
};
const ACTION_KEYS: Record<number, string> = {
  1: 'create_group', 2: 'update_group_level', 20: 'remove_member', 21: 'remove_member', 22: 'delete_group', 23: 'add_member', 24: 'update_group_level', 25: 'update_group_level',
  30: 'create_group', 31: 'update_group_level', 32: 'delete_group', 50: 'create_group', 51: 'update_group_level', 52: 'delete_group', 72: 'update_group_level',
};

function snowflakeDate(id: string): string {
  try {
    return new Date(Number((BigInt(id) >> 22n) + 1420070400000n)).toISOString();
  } catch {
    return new Date().toISOString();
  }
}

// Discord's audit log is asked for once per server every 45 seconds at most (it was asked on every visit and every refresh of the page):
// the answer is kept in the shared cache, trimmed to what the page shows, and shared by every visitor of the server. It is not part of
// the server's change stamp, so nothing is raised here; the page's own copy follows the minute (see the ETag in middleware.ts).
const AUDIT_FRESH_MS = 45_000;
type AuditAnswer = { status: number; users: { id: string; name: string }[]; entries: { id: string; user_id: string | null; target_id: string | null; action_type: number; reason: string | null; name: { new_value?: unknown; old_value?: unknown } | null }[] };
const audit = await cached<AuditAnswer>(`audit:${id}`, async () => {
  const res = await fetch(`https://discord.com/api/v10/guilds/${id}/audit-logs?limit=100`, { headers: { Authorization: `Bot ${botToken}` } });
  if (!res.ok) return { status: res.status, users: [], entries: [] };
  const payload = await res.json();
  return {
    status: res.status,
    users: (payload.users ?? []).map((u: any) => ({ id: u.id, name: u.global_name ?? u.username ?? u.id })),
    entries: (payload.audit_log_entries ?? []).map((e: any) => {
      const nameChange = (Array.isArray(e.changes) ? e.changes : []).find((c: any) => c.key === 'name');
      return { id: e.id, user_id: e.user_id ?? null, target_id: e.target_id ?? null, action_type: e.action_type, reason: e.reason ?? null, name: nameChange ? { new_value: nameChange.new_value, old_value: nameChange.old_value } : null };
    }),
  };
}, { freshMs: AUDIT_FRESH_MS, shared: true, keep: (answer) => answer.status === 200 || answer.status === 403 }).catch(() => ({ status: 0, users: [], entries: [] } as AuditAnswer));
const auditRes = { ok: audit.status === 200, status: audit.status };
let auditError: string | null = null;
let entries: any[] = [];
if (auditRes.ok) {
  const users = new Map(audit.users.map((u) => [u.id, u.name]));
  entries = audit.entries.map((e) => {
    const nameChange = e.name;
    const targetUser = e.target_id ? users.get(e.target_id) : null;
    const target = targetUser ? String(targetUser) : nameChange?.new_value ?? nameChange?.old_value ?? e.target_id ?? '';
    return {
      id: e.id,
      actorId: e.user_id ?? null,
      actorName: users.get(e.user_id ?? '') ?? (e.user_id ? `User ${e.user_id}` : 'Discord'),
      actionKey: ACTION_KEYS[e.action_type] ?? '',
      action: ACTION_LABELS[e.action_type] ?? `Administrative action (${e.action_type})`,
      target: target ? String(target) : '',
      reason: e.reason ?? null,
      createdAt: snowflakeDate(e.id),
    };
  });
} else if (auditRes.status === 403) {
  auditError = dt('Petto needs the View Audit Log permission in this server.');
} else {
  auditError = dt("Discord could not return the audit log (HTTP {n}).", {n: auditRes.status});
}
---
<DashAuditLog
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'}
  entries={entries}
  error={auditError}
/>
