---
export const prerender = false;
import DashStats from '../../../../components/DashStats.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';
import { buildStats, STAT_TABS, botDay } from '../../../../utils/activityStats';
import { buildAnalysis, rulesFromRow, COUNTER_TABLES } from '../../../../utils/statsAnalysis';
import { getMemberProfiles } from '../../../../utils/memberNames';
// On Node the site may add rows up in the database itself (see utils/directDb.ts); elsewhere this is null.
import { directQuery } from '../../../../utils/directQuery';
import { hasPremiumForGuild } from '../../../../utils/premium';
import { FREE_STAT_DAYS, PREMIUM_STAT_DAYS } from '../../../../utils/planLimits';
import { callPettoInvites } from '../../../../utils/pettoBotApi';
import { getDashLang, makeT } from '../../../../i18n/dash';

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;
if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

// Every server sees 7, 14 and 30 days; Premium also sees 60 and 90 (the bot keeps every day, Premium only shows more of it).
const premium = await hasPremiumForGuild(Astro, session.userId, id);
const askedDays = Number(Astro.url.searchParams.get('days'));
const days = (FREE_STAT_DAYS as readonly number[]).includes(askedDays) || (premium && (PREMIUM_STAT_DAYS as readonly number[]).includes(askedDays)) ? askedDays : 7;
const requestedTab = Astro.url.searchParams.get('tab') ?? 'overview';
let tab = (STAT_TABS as readonly string[]).includes(requestedTab) ? requestedTab : 'overview';

const headers = { apikey: apiKey, Authorization: `Bearer ${apiKey}` };

// The settings of the Invites tab (rewards, bonus invites, resets, fake joins) go through the bot, which checks the same as `/invites`
// and gives or takes the reward roles at once. The page is then drawn again on the Invites tab with its answer.
let inviteMessage: { kind: 'ok' | 'err'; text: string } | null = null;
let dataMessage: { kind: 'ok' | 'err'; text: string } | null = null;
if (Astro.request.method === 'POST') {
  const dashLang = getDashLang(Astro);
  const dt = makeT(dashLang);
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const snowflake = (name: string) => (/^\d{15,25}$/.test(String(form.get(name) ?? '')) ? String(form.get(name)) : '');
  const whole = (name: string) => Math.trunc(Number(form.get(name) ?? NaN));
  let result: { ok: boolean; message: string } | null = null;
  if (action === 'invite_reward') result = await callPettoInvites(Astro, id, session.userId, 'reward', { role_id: snowflake('role_id'), invites: whole('invites') }, dashLang);
  else if (action === 'invite_unreward') result = await callPettoInvites(Astro, id, session.userId, 'unreward', { role_id: snowflake('role_id') }, dashLang);
  else if (action === 'invite_fake_days') result = await callPettoInvites(Astro, id, session.userId, 'fake_days', { days: whole('days') }, dashLang);
  else if (action === 'invite_bonus') result = await callPettoInvites(Astro, id, session.userId, 'bonus', { member_id: snowflake('member_id'), amount: whole('amount') }, dashLang);
  else if (action === 'invite_reset') result = await callPettoInvites(Astro, id, session.userId, 'reset', { member_id: snowflake('member_id') }, dashLang);
  if (result) tab = 'invites';
  if (result) inviteMessage = { kind: result.ok ? 'ok' : 'err', text: result.message || (result.ok ? dt('Saved.') : dt('Petto did not answer. Try again in a moment.')) };

  // The Data and privacy tab: what this server lets Petto count, and deleting what was counted. The bot reads the rules again within a minute.
  if (action === 'stats_rule' || action === 'stats_delete') {
    tab = 'data';
    const write = { ...headers, 'Content-Type': 'application/json', Prefer: 'resolution=merge-duplicates,return=minimal' };
    try {
      if (action === 'stats_rule') {
        const field = String(form.get('field') ?? '');
        const value = String(form.get('value') ?? '') === 'on';
        const current = rulesFromRow((await rows('stats_config', 'enabled,members_enabled,content_enabled'))[0]);
        if (!(field in current)) throw new Error('field');
        const next = { ...current, [field]: value };
        const res = await fetch(`${apiUrl}/rest/v1/stats_config?on_conflict=guild_id`, { method: 'POST', headers: write, body: JSON.stringify({ guild_id: id, enabled: next.enabled, members_enabled: next.members, content_enabled: next.content, updated_at: new Date().toISOString() }) });
        if (!res.ok) throw new Error(String(res.status));
        dataMessage = { kind: 'ok', text: dt('Saved.') };
      } else {
        for (const table of COUNTER_TABLES) {
          const res = await fetch(`${apiUrl}/rest/v1/${table}?guild_id=eq.${id}`, { method: 'DELETE', headers: { ...headers, Prefer: 'return=minimal' } });
          if (!res.ok) throw new Error(`${table} ${res.status}`);
        }
        dataMessage = { kind: 'ok', text: dt('Every counter of this server was deleted.') };
      }
    } catch {
      dataMessage = { kind: 'err', text: dt('Petto did not answer. Try again in a moment.') };
    }
  }
}
// Days are counted in GMT-5 (Colombia), the time Petto works in.
const since = botDay(new Date(Date.now() - (days - 1) * 86_400_000));
// The period before this one (the same number of days) is read too, to set the two side by side.
const sincePrevious = botDay(new Date(Date.now() - (days * 2 - 1) * 86_400_000));
const sinceInstant = new Date(`${since}T00:00:00-05:00`).toISOString();

// A table that is not there yet (the bot has not been updated) gives an empty list, so the page still opens.
async function rows(table: string, select: string, extra = ''): Promise<any[]> {
  try {
    const res = await fetch(`${apiUrl}/rest/v1/${table}?guild_id=eq.${id}${extra}&select=${select}`, { headers });
    if (!res.ok) return [];
    const data = await res.json();
    return Array.isArray(data) ? data : [];
  } catch {
    return [];
  }
}

const [guildInfo, channelsRes, channelRowsAll, hourlyRows, flowRowsAll, memberRows, caseRows, inviterRows, rolesRes, inviteConfigRows, rewardRows, contentRows, lifespanRows, ruleRows] = await Promise.all([
  getGuildInfo(id, botToken),
  getGuildList(Astro, id, botToken, 'channels').catch(() => null),
  rows('activity_stats', 'channel_id,day,messages,reactions,voice_seconds', `&day=gte.${sincePrevious}`),
  rows('activity_hourly', 'day,hour,messages,voice_seconds', `&day=gte.${since}`),
  rows('member_flow', 'day,joins,leaves,invited', `&day=gte.${sincePrevious}`),
  // Per member and day, these rows are the largest read of the page; the database adds them up per member when the site can
  // reach it (one row per member, dated on the first day of the range, which is all the page needs). Members are listed in the
  // order they first show up, as the rows were, so members with the same count keep a stable place.
  (directQuery
    ? directQuery(`SELECT "user_id", SUM("messages") AS "messages", SUM("voice_seconds") AS "voice_seconds", $3::text AS "day" FROM "public"."activity_members" WHERE "guild_id" = $1 AND "day" >= $2 GROUP BY "user_id" ORDER BY MIN("day"), "user_id"`, [id, since, since])
    : Promise.resolve(null)).then((summed) => summed ?? rows('activity_members', 'day,user_id,messages,voice_seconds', `&day=gte.${since}`)),
  rows('mod_actions', 'type,source,moderator_id,user_id,created_at', `&created_at=gte.${sinceInstant}&limit=20000`),
  rows('invite_uses', 'inviter_id,joins,leaves,bonus', '&order=joins.desc&limit=50'),
  getGuildList(Astro, id, botToken, 'roles').catch(() => null),
  rows('invite_config', 'fake_days'),
  rows('invite_rewards', 'role_id,invites', '&order=invites.asc'),
  rows('activity_content', 'day,links,attachments,replies,mentions', `&day=gte.${sincePrevious}`),
  rows('member_lifespan', 'day,bucket,members', `&day=gte.${since}`),
  rows('stats_config', 'enabled,members_enabled,content_enabled'),
]);
// The tabs of the page read only this period; the analysis (the comparison) reads both.
const channelRows = channelRowsAll.filter((row) => String(row.day).slice(0, 10) >= since);
const flowRows = flowRowsAll.filter((row) => String(row.day).slice(0, 10) >= since);
const analysis = buildAnalysis({ days, channelRows: channelRowsAll, hourlyRows, flowRows: flowRowsAll, contentRows, lifespanRows });
const rules = rulesFromRow(ruleRows[0]);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

const botId = getEnv(Astro, 'DISCORD_CLIENT_ID') || null;
const stats = buildStats({ days, channelRows, hourlyRows, flowRows, memberRows, caseRows, botId });

const channels: any[] = channelsRes && channelsRes.ok ? await channelsRes.json().catch(() => []) : [];
const channelNames: Record<string, string> = Object.fromEntries(channels.map((c: any) => [c.id, c.name]));

const inviters = inviterRows
  .map((row) => ({ id: String(row.inviter_id), joins: Number(row.joins) || 0, leaves: Number(row.leaves) || 0, net: (Number(row.joins) || 0) - (Number(row.leaves) || 0) + (Number(row.bonus) || 0) }))
  .filter((row) => row.joins || row.leaves || row.net)
  .sort((a, b) => b.net - a.net)
  .slice(0, 5);

// Names of the members that are named on the page. A user that cannot be read is shown by its ID.
const wanted = [...new Set([...stats.topMembers.messages, ...stats.topMembers.voice, ...stats.sanctions.topModerators, ...stats.sanctions.topUsers].map((m) => m.id).concat(inviters.map((i) => i.id)))].slice(0, 30);
const memberNames: Record<string, string> = {};
// One call to the bot for all of them (kept for a while); people who left are read from Discord's global profile, as before.
const profiles = await getMemberProfiles(Astro, id, wanted, botToken, { fallback: 'user', userId: session.userId });
for (const [userId, profile] of profiles) if (profile) memberNames[userId] = profile.globalName || profile.username || userId;
const hasFlow = flowRows.length > 0;

// The Invites tab: the reward roles (by number of invites), the roles that can be picked for one, and the days of a fake join.
const allRoles: any[] = rolesRes && rolesRes.ok ? await rolesRes.json().catch(() => []) : [];
const roleById = new Map(allRoles.map((role: any) => [String(role.id), role]));
const inviteRoles = allRoles
  .filter((role: any) => role.name !== '@everyone' && !role.managed)
  .sort((a: any, b: any) => b.position - a.position)
  .map((role: any) => ({ id: String(role.id), name: String(role.name), color: Number(role.color) || 0 }));
const inviteSettings = {
  fakeDays: inviteConfigRows.length ? Math.max(0, Number(inviteConfigRows[0].fake_days) || 0) : 3,
  rewards: rewardRows.map((row) => {
    const role: any = roleById.get(String(row.role_id));
    return { roleId: String(row.role_id), invites: Number(row.invites) || 0, name: role ? String(role.name) : null, color: role ? Number(role.color) || 0 : 0 };
  }),
};
---
<DashStats
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'}
  stats={stats}
  days={days}
  tab={tab}
  channelNames={channelNames}
  memberNames={memberNames}
  inviters={inviters}
  hasFlow={hasFlow}
  premium={premium}
  inviteRoles={inviteRoles}
  inviteSettings={inviteSettings}
  inviteMessage={inviteMessage}
  analysis={analysis}
  rules={rules}
  dataMessage={dataMessage}
/>
