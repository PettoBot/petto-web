---
export const prerender = false;
import DashCode from '../../../../components/DashCode.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';
import { canUseCodeCommands } from '../../../../utils/codeAccess';

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;
if (!canUseCodeCommands(Astro, session.userId)) return Astro.redirect(`/dash/guild/${id}/overview`);
if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const apiHeaders = { apikey: apiKey, Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' };
const guildInfo = await getGuildInfo(id, botToken);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

// The commands written in code. The list is asked up to three times and, if the filtered question fails, once more without the
// filter (the commands with code are picked here), so a slow or busy moment does not leave the page with an empty list.
type Row = { name: string; code: string; triggerType: string; triggerText: string; files: { name: string; size: number }[] };
const toRow = (row: any): Row => ({ name: row.name, code: row.code ?? '', triggerType: row.trigger_type ?? 'command', triggerText: row.trigger_text ?? '', files: Array.isArray(row.files) ? row.files.filter((file: any) => file && typeof file.name === 'string' && Number.isInteger(file.size)).map((file: any) => ({ name: String(file.name), size: Number(file.size) })) : [] });
async function loadCommands(): Promise<{ commands: Row[]; state: 'ok' | 'missing' | 'failed' }> {
  const base = `${apiUrl}/rest/v1/custom_commands?guild_id=eq.${id}`;
  // The column of the files comes with the bot update too: a database without it is asked again without it (the commands then show as one file).
  let withFiles = true;
  for (let attempt = 0; attempt < 3; attempt += 1) {
    for (const [filter, pick] of [['&code=not.is.null', false], ['', true]] as const) {
      try {
        const columns = `select=name,code,trigger_type,trigger_text${withFiles ? ',files' : ''}&order=name.asc`;
        const res = await fetch(`${base}${filter}&${columns}`, { headers: apiHeaders, signal: AbortSignal.timeout(6000) });
        if (res.ok) {
          const rows = (await res.json()) as any[];
          return { commands: (pick ? rows.filter((row) => row.code) : rows).map(toRow), state: 'ok' };
        }
        // The columns come with a bot update: a database without them says so, and that is not a failure to retry.
        const body = await res.text().catch(() => '');
        if (res.status === 400 && withFiles && /files/i.test(body)) { withFiles = false; continue; }
        if (res.status === 400 && /code|trigger_/i.test(body) && pick) return { commands: [], state: 'missing' };
      } catch { /* try again */ }
    }
    await new Promise((resolve) => setTimeout(resolve, 400 * (attempt + 1)));
  }
  return { commands: [], state: 'failed' };
}
// The text channels for the reminders (where each one runs), under their categories like Discord shows them.
async function loadChannels(): Promise<{ id: string; name: string; category?: string }[]> {
  try {
    const res = await getGuildList(Astro, id, botToken!, 'channels');
    if (!res.ok) return [];
    const all = (await res.json()) as any[];
    const categories = new Map(all.filter((channel) => channel.type === 4).map((channel) => [String(channel.id), String(channel.name)]));
    return all
      .filter((channel) => channel.type === 0 || channel.type === 5)
      .sort((a, b) => (a.position ?? 0) - (b.position ?? 0))
      .map((channel) => ({ id: String(channel.id), name: String(channel.name), category: channel.parent_id ? categories.get(String(channel.parent_id)) : undefined }));
  } catch { return []; }
}
// The roles of the server (for the roles a command is for), the highest first.
async function loadRoles(): Promise<{ id: string; name: string }[]> {
  try {
    const res = await getGuildList(Astro, id, botToken!, 'roles');
    if (!res.ok) return [];
    return ((await res.json()) as any[]).filter((role) => String(role.id) !== id).sort((a, b) => (b.position ?? 0) - (a.position ?? 0)).map((role) => ({ id: String(role.id), name: String(role.name) }));
  } catch { return []; }
}
const [loaded, channels, roles] = await Promise.all([loadCommands(), loadChannels(), loadRoles()]);
const commands = loaded.commands;
const ready = loaded.state !== 'missing';
const loadFailed = loaded.state === 'failed';
let prefix = '!';
try {
  const res = await fetch(`${apiUrl}/rest/v1/guilds?guild_id=eq.${id}&select=prefix`, { headers: apiHeaders });
  if (res.ok) prefix = String((await res.json())?.[0]?.prefix || '!');
} catch {}
---
<DashCode user={session} guildId={id} guildName={guildInfo.name} guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'} commands={commands} prefix={prefix} ready={ready} loadFailed={loadFailed} channels={channels} roles={roles} />
