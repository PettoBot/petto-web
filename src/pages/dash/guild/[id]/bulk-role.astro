---
export const prerender = false;
import DashBulkRole from '../../../../components/DashBulkRole.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';
import { getDashLang, makeT } from '../../../../i18n/dash';
const dt = makeT(getDashLang(Astro));

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
  const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
  const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;

if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const apiHeaders = {
  apikey: apiKey,
  Authorization: `Bearer ${apiKey}`,
  'Content-Type': 'application/json',
};

let error: string | null = null;
let started = false;

async function activeJobExists(): Promise<boolean> {
  const res = await fetch(`${apiUrl}/rest/v1/bulk_role_jobs?guild_id=eq.${id}&status=in.(pending,running)&select=id&limit=1`, { headers: apiHeaders });
  const rows = res.ok ? await res.json() : [];
  return rows.length > 0;
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'cancel') {
    await fetch(`${apiUrl}/rest/v1/bulk_role_jobs?guild_id=eq.${id}&status=in.(pending,running)`, {
      method: 'PATCH',
      headers: { ...apiHeaders, Prefer: 'return=minimal' },
      body: JSON.stringify({ status: 'cancelled', finished_at: new Date().toISOString() }),
    });
  } else if (action === 'start') {
    if (await activeJobExists()) {
      error = dt('A bulk role job is already running for this server. Wait for it to finish or cancel it first.');
    } else {
      const targetRoleId = String(form.get('target_role_id') ?? '').trim();
      const roleAction = String(form.get('role_action') ?? 'add') === 'remove' ? 'remove' : 'add';
      const memberType = ['all', 'bots', 'humans'].includes(String(form.get('member_type'))) ? String(form.get('member_type')) : 'all';
      const filterRoleIds = form.getAll('filter_role_ids').map(String);
      const filterMode = String(form.get('filter_mode') ?? 'any') === 'all' ? 'all' : 'any';
      const filterExclude = form.get('filter_exclude') === 'on';
      const joinedAfterRaw = String(form.get('joined_after') ?? '').trim();
      const joinedBeforeRaw = String(form.get('joined_before') ?? '').trim();
      const notifyChannelId = String(form.get('notify_channel_id') ?? '').trim() || null;

      if (!targetRoleId) {
        error = dt('Pick a role first.');
      } else {
        const res = await fetch(`${apiUrl}/rest/v1/bulk_role_jobs`, {
          method: 'POST',
          headers: { ...apiHeaders, Prefer: 'return=minimal' },
          body: JSON.stringify({
            guild_id: id,
            action: roleAction,
            target_role_id: targetRoleId,
            member_type: memberType,
            filter_role_ids: filterRoleIds,
            filter_mode: filterMode,
            filter_exclude: filterExclude,
            joined_after: joinedAfterRaw || null,
            joined_before: joinedBeforeRaw || null,
            notify_channel_id: notifyChannelId,
            started_by: session.userId,
          }),
        });
        if (res.ok) started = true;
        else error = dt("Couldn't start the job, try again.");
      }
    }
  }
}

const [guildInfo, rolesRes, channelsRes, jobRes] = await Promise.all([
  getGuildInfo(id, botToken),
  getGuildList(Astro, id, botToken, 'roles'),
  getGuildList(Astro, id, botToken, 'channels'),
  fetch(`${apiUrl}/rest/v1/bulk_role_jobs?guild_id=eq.${id}&order=created_at.desc&limit=1`, { headers: apiHeaders }),
]);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

const allRoles = rolesRes.ok ? await rolesRes.json() : [];
const roles = allRoles
  .filter((r: any) => r.name !== '@everyone')
  .sort((a: any, b: any) => b.position - a.position)
  .map((r: any) => ({ id: r.id, name: r.name }));

const allChannels = channelsRes.ok ? await channelsRes.json() : [];
const channels = allChannels
  .filter((c: any) => c.type === 0 || c.type === 5)
  .sort((a: any, b: any) => a.position - b.position)
  .map((c: any) => ({ id: c.id, name: c.name }));

const jobRows = jobRes.ok ? await jobRes.json() : [];
const rawJob = jobRows[0] ?? null;
const job = rawJob && {
  id: rawJob.id,
  action: rawJob.action,
  targetRoleId: rawJob.target_role_id,
  status: rawJob.status,
  totalMembers: rawJob.total_members,
  processedMembers: rawJob.processed_members,
  successCount: rawJob.success_count,
  errorCount: rawJob.error_count,
  errorMessage: rawJob.error_message,
};
---
<DashBulkRole
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.png'}
  roles={roles}
  channels={channels}
  job={job}
  started={started}
  error={error}
/>
