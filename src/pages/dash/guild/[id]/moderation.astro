---
export const prerender = false;
import { describeTeam, findKnownUsers } from '../../../../utils/team';
import { caseFilterOf, caseLogFilters, caseTypesFor, readCaseSearch } from '../../../../utils/caseLog';
import DashModeration from '../../../../components/DashModeration.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';
import { runBatched } from '../../../../utils/concurrency';
import { callPettoCases, callPettoMemberSearch } from '../../../../utils/pettoBotApi';
import { getDashLang, makeT } from '../../../../i18n/dash';
// The cases of each day are counted on the day of Petto (GMT-5), the one the rest of the statistics use.
import { botDay, rangeDays } from '../../../../utils/activityStats';

const { id } = Astro.params as { id: string };
const section = Astro.url.searchParams.get('section') ?? 'protection';
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;

if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const apiHeaders = {
  apikey: apiKey,
  Authorization: `Bearer ${apiKey}`,
  'Content-Type': 'application/json',
};

let saved = false;
// Invites typed in the allow-list that are not valid (skipped), and whether more than the limit were typed.
let badInvites: string[] = [];
let tooManyInvites = false;
const MAX_ALLOWED_INVITES = 50;
// The answer of the bot to a change of a case (a new reason, or deleted), shown above the case log.
let caseMessage: { kind: 'ok' | 'err'; text: string; number: number } | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? 'config');

  if (action === 'case_edit' || action === 'case_delete') {
    // Through the bot, like /case edit and /case delete: it checks Moderate Members and writes the change to the sanctions log.
    const dashLang = getDashLang(Astro);
    const dt = makeT(dashLang);
    const number = Math.trunc(Number(form.get('case') ?? 0));
    const result = action === 'case_edit'
      ? await callPettoCases(Astro, id, session.userId, 'edit', { case: number, reason: String(form.get('reason') ?? '').replace(/\r\n?/g, '\n').trim().slice(0, 1000) }, dashLang)
      : await callPettoCases(Astro, id, session.userId, 'delete', { case: number }, dashLang);
    caseMessage = { kind: result.ok ? 'ok' : 'err', number, text: result.message || (result.ok ? dt('Saved.') : dt('Petto did not answer. Try again in a moment.')) };
  }

  if (action === 'config') {
    const bannedWords = String(form.get('banned_words') ?? '').split(',').map((w) => w.trim()).filter(Boolean);
    const immuneRoleIds = form.getAll('immune_role_ids').map(String).filter((v) => /^\d{15,25}$/.test(v)).slice(0, 250);
    // Allowed invites: one per line or comma; a full discord.gg link or only the code, like the bot's /automod invites allow.
    const allowedInvites = new Set<string>();
    for (const raw of String(form.get('allowed_invite_codes') ?? '').split(/[\s,;]+/).map((x) => x.trim()).filter(Boolean)) {
      const code = raw.replace(/^(?:https?:\/\/)?(?:www\.)?(?:discord\.gg|discord(?:app)?\.com\/invite)\//i, '').replace(/[/?#].*$/, '').toLowerCase();
      if (!/^[a-z0-9-]{2,32}$/.test(code)) { if (badInvites.length < 5) badInvites.push(raw.slice(0, 40)); continue; }
      if (allowedInvites.size >= MAX_ALLOWED_INVITES) { tooManyInvites = true; continue; }
      allowedInvites.add(code);
    }

    await Promise.all([
      fetch(`${apiUrl}/rest/v1/automod_config?on_conflict=guild_id`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({
          guild_id: id,
          word_filter_enabled: form.get('word_filter_enabled') === 'on',
          word_filter_action: String(form.get('word_filter_action') ?? 'warn'),
          banned_words: bannedWords,
          anti_spam_enabled: form.get('anti_spam_enabled') === 'on',
          max_mentions: Math.max(1, Math.min(50, Number(form.get('max_mentions') ?? 5) || 5)),
          anti_raid_enabled: form.get('anti_raid_enabled') === 'on',
          raid_join_threshold: Math.max(2, Math.min(50, Number(form.get('raid_join_threshold') ?? 6) || 6)),
          raid_window_seconds: Math.max(5, Math.min(120, Number(form.get('raid_window_seconds') ?? 10) || 10)),
          raid_action: String(form.get('raid_action') ?? 'alert'),
          anti_alt_enabled: form.get('anti_alt_enabled') === 'on',
          anti_alt_min_age_days: Math.max(0, Math.min(365, Number(form.get('anti_alt_min_age_days') ?? 7) || 7)),
          anti_alt_action: String(form.get('anti_alt_action') ?? 'kick'),
          immune_role_ids: immuneRoleIds,
          allowed_invite_codes: [...allowedInvites],
          repeat_threshold: Math.max(2, Math.min(20, Number(form.get('repeat_threshold') ?? 3) || 3)),
          repeat_window_seconds: Math.max(3, Math.min(120, Number(form.get('repeat_window_seconds') ?? 10) || 10)),
          caps_percent: Math.max(30, Math.min(100, Number(form.get('caps_percent') ?? 70) || 70)),
          caps_min_length: Math.max(4, Math.min(200, Number(form.get('caps_min_length') ?? 12) || 12)),
          max_message_length: Math.max(0, Math.min(2000, Math.floor(Number(form.get('max_message_length') ?? 0)) || 0)),
          max_lines: Math.max(0, Math.min(100, Math.floor(Number(form.get('max_lines') ?? 0)) || 0)),
          exempt_channel_ids: form.getAll('exempt_channel_ids').map(String).filter((v) => /^\d{15,25}$/.test(v)).slice(0, 50),
          spam_repeat: form.get('spam_repeat') === 'on',
          spam_mentions: form.get('spam_mentions') === 'on',
          spam_invites: form.get('spam_invites') === 'on',
          spam_caps: form.get('spam_caps') === 'on',
          strike_limit: Math.max(0, Math.min(20, Math.floor(Number(form.get('strike_limit') ?? 0)) || 0)),
          strike_window_minutes: Math.max(1, Math.min(1440, Math.floor(Number(form.get('strike_window_minutes') ?? 10)) || 10)),
          strike_mute_minutes: Math.max(1, Math.min(40320, Math.floor(Number(form.get('strike_mute_minutes') ?? 10)) || 10)),
          updated_at: new Date().toISOString(),
        }),
      }),
      fetch(`${apiUrl}/rest/v1/sticky_roles_config?on_conflict=guild_id`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({ guild_id: id, enabled: form.get('sticky_roles_enabled') === 'on' }),
      }),
    ]);
    saved = true;
  } else if (action === 'save_sanction_messages') {
    const types = ['default', 'ban', 'tempban', 'softban', 'unban', 'kick', 'mute', 'tempmute', 'unmute', 'warn', 'jail', 'unjail'];
    const pick = (type: string, slot: string) => String(form.get(`${type}__${slot}`) ?? '').trim().slice(0, 40) || null;
    const rows = types.map((type) => ({ guild_id: id, type, dm_template: pick(type, 'dm'), reply_template: pick(type, 'reply'), log_template: pick(type, 'log') }));
    const filled = rows.filter((row) => row.dm_template || row.reply_template || row.log_template);
    const empty = rows.filter((row) => !filled.includes(row));
    if (filled.length) {
      await fetch(`${apiUrl}/rest/v1/sanction_templates?on_conflict=guild_id,type`, { method: 'POST', headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify(filled) });
    }
    if (empty.length) {
      await fetch(`${apiUrl}/rest/v1/sanction_templates?guild_id=eq.${id}&type=in.(${empty.map((row) => row.type).join(',')})`, { method: 'DELETE', headers: apiHeaders });
    }
    saved = true;
  } else if (action === 'add_silent_channel') {
    const channelId = String(form.get('channel_id') ?? '').trim();
    const silentAction = String(form.get('silent_action') ?? 'warn');
    if (channelId) {
      await fetch(`${apiUrl}/rest/v1/automod_silent_channels?on_conflict=guild_id,channel_id`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({ guild_id: id, channel_id: channelId, action: silentAction }),
      });
      saved = true;
    }
  } else if (action === 'delete_silent_channel') {
    const channelId = encodeURIComponent(String(form.get('channel_id') ?? ''));
    await fetch(`${apiUrl}/rest/v1/automod_silent_channels?guild_id=eq.${id}&channel_id=eq.${channelId}`, { method: 'DELETE', headers: apiHeaders });
    saved = true;
  } else if (action === 'add_escalation') {
    const warnCount = Math.max(1, Number(form.get('warn_count') ?? 0) || 0);
    const escAction = String(form.get('esc_action') ?? 'mute');
    const durationMinutes = Number(form.get('duration_minutes') ?? 0) || 0;
    if (warnCount > 0) {
      await fetch(`${apiUrl}/rest/v1/warn_escalation_rules?on_conflict=guild_id,warn_count`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({
          guild_id: id, warn_count: warnCount, action: escAction,
          duration_ms: durationMinutes > 0 ? durationMinutes * 60000 : null,
        }),
      });
      saved = true;
    }
  } else if (action === 'delete_escalation') {
    const warnCount = Number(form.get('warn_count') ?? 0) || 0;
    await fetch(`${apiUrl}/rest/v1/warn_escalation_rules?guild_id=eq.${id}&warn_count=eq.${warnCount}`, { method: 'DELETE', headers: apiHeaders });
    saved = true;
  }
}

// The case log reads one page of cases (the newest first, or the ones older than `before`), filtered by kind and by a search in the
// database, so a kind or a case that is not among the newest is still found. 100 at most: a longer list made the page slow to draw.
const casesLimit = Math.min(100, [25, 50, 100, 200].includes(Number(Astro.url.searchParams.get('cases'))) ? Number(Astro.url.searchParams.get('cases')) : 25);
const caseTypeParam = String(Astro.url.searchParams.get('type') ?? '').trim().toLowerCase();
const caseType = caseTypesFor(caseTypeParam) ? caseTypeParam : '';
const caseQuery = String(Astro.url.searchParams.get('q') ?? '').replace(/\s+/g, ' ').trim().slice(0, 100);
const caseBefore = Math.max(0, Math.trunc(Number(Astro.url.searchParams.get('before') ?? 0)) || 0) || null;
// The case whose edit form is open (the Edit link of a case without the dashboard's script).
const caseEdit = Math.max(0, Math.trunc(Number(Astro.url.searchParams.get('edit') ?? 0)) || 0) || null;
const caseSearch = readCaseSearch(caseQuery);
// Words are also looked up as names: members of the server (the bot's member search) and people seen lately (who may have left).
const casePeopleIds = section === 'cases' && caseSearch.kind === 'text'
  ? [...new Set([...findKnownUsers(caseSearch.text), ...(await Promise.race([
    callPettoMemberSearch(Astro, id, session.userId, caseSearch.text).catch(() => []),
    new Promise<[]>((resolve) => setTimeout(() => resolve([]), 3500)),
  ])).map((member) => member.id)])]
  : [];
const caseFilters = caseLogFilters({ type: caseType, search: caseSearch, before: caseBefore, peopleIds: casePeopleIds });
// Only the section on screen is drawn, so only what it shows is read.
const MODERATION_SECTIONS = ['protection', 'silent-channels', 'warn-escalation', 'sanction-messages', 'cases', 'active', 'stats'];
const shown = MODERATION_SECTIONS.includes(section) ? section : 'protection';
const needs = (...sections: string[]) => sections.includes(shown);
const when = <T,>(sections: string[], load: () => Promise<T>) => () => (needs(...sections) ? load() : Promise.resolve(null));
const [guildInfo, automodRes, antinukeRes, casesRes, silentRes, escalationRes, rolesRes, channelsRes, stickyRolesRes, sanctionTemplatesRes, embedTemplatesRes, activeRes, statsRes] = await runBatched([
  () => getGuildInfo(id, botToken),
  when(['protection'], () => fetch(`${apiUrl}/rest/v1/automod_config?guild_id=eq.${id}&select=*`, { headers: apiHeaders })),
  when(['protection'], () => fetch(`${apiUrl}/rest/v1/antinuke_config?guild_id=eq.${id}&select=*`, { headers: apiHeaders })),
  when(['cases'], () => fetch(`${apiUrl}/rest/v1/mod_actions?guild_id=eq.${id}&select=case_number,type,user_id,moderator_id,reason,active,created_at,evidence${caseFilters ? `&${caseFilters}` : ''}&order=case_number.desc&limit=${casesLimit + 1}`, { headers: apiHeaders })),
  when(['silent-channels'], () => fetch(`${apiUrl}/rest/v1/automod_silent_channels?guild_id=eq.${id}&select=channel_id,action`, { headers: apiHeaders })),
  when(['warn-escalation'], () => fetch(`${apiUrl}/rest/v1/warn_escalation_rules?guild_id=eq.${id}&select=warn_count,action,duration_ms&order=warn_count.asc`, { headers: apiHeaders })),
  when(['protection'], () => getGuildList(Astro, id, botToken, 'roles')),
  when(['protection', 'silent-channels'], () => getGuildList(Astro, id, botToken, 'channels')),
  when(['protection'], () => fetch(`${apiUrl}/rest/v1/sticky_roles_config?guild_id=eq.${id}&select=enabled`, { headers: apiHeaders })),
  when(['sanction-messages'], () => fetch(`${apiUrl}/rest/v1/sanction_templates?guild_id=eq.${id}&select=type,dm_template,reply_template,log_template`, { headers: apiHeaders })),
  when(['sanction-messages'], () => fetch(`${apiUrl}/rest/v1/embed_templates?guild_id=eq.${id}&select=name&order=name.asc`, { headers: apiHeaders })),
  when(['active'], () => fetch(`${apiUrl}/rest/v1/mod_actions?guild_id=eq.${id}&active=eq.true&type=in.(ban,tempban,hardban,mute,tempmute,jail)&select=case_number,type,user_id,moderator_id,reason,created_at,expires_at&order=created_at.desc&limit=100`, { headers: apiHeaders })),
  when(['stats'], () => fetch(`${apiUrl}/rest/v1/mod_actions?guild_id=eq.${id}&created_at=gte.${new Date(Date.now() - 30 * 86_400_000).toISOString()}&select=type,source,moderator_id,created_at&order=created_at.desc&limit=10000`, { headers: apiHeaders })),
], 6);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

const automodRows = automodRes?.ok ? await automodRes.json() : [];
const a = automodRows[0] ?? {};
const automod = {
  wordFilterEnabled: a.word_filter_enabled ?? false,
  wordFilterAction: a.word_filter_action ?? 'warn',
  bannedWords: a.banned_words ?? [],
  antiSpamEnabled: a.anti_spam_enabled ?? false,
  maxMentions: a.max_mentions ?? 5,
  antiRaidEnabled: a.anti_raid_enabled ?? false,
  raidJoinThreshold: a.raid_join_threshold ?? 6,
  raidWindowSeconds: a.raid_window_seconds ?? 10,
  raidAction: a.raid_action ?? 'alert',
  antiAltEnabled: a.anti_alt_enabled ?? false,
  antiAltMinAgeDays: a.anti_alt_min_age_days ?? 7,
  antiAltAction: a.anti_alt_action ?? 'kick',
  immuneRoleIds: a.immune_role_ids ?? [],
  repeatThreshold: a.repeat_threshold ?? 3,
  repeatWindow: a.repeat_window_seconds ?? 10,
  capsPercent: a.caps_percent ?? 70,
  capsMinLength: a.caps_min_length ?? 12,
  maxMessageLength: a.max_message_length ?? 0,
  maxLines: a.max_lines ?? 0,
  exemptChannelIds: a.exempt_channel_ids ?? [],
  allowedInviteCodes: a.allowed_invite_codes ?? [],
  spamRepeat: a.spam_repeat ?? true,
  spamMentions: a.spam_mentions ?? true,
  spamInvites: a.spam_invites ?? true,
  spamCaps: a.spam_caps ?? true,
  strikeLimit: a.strike_limit ?? 0,
  strikeWindow: a.strike_window_minutes ?? 10,
  strikeMute: a.strike_mute_minutes ?? 10,
};

const antinukeRows = antinukeRes?.ok ? await antinukeRes.json() : [];
const n = antinukeRows[0] ?? {};
const antinuke = {
  enabled: n.enabled ?? false,
  actionThreshold: n.action_threshold ?? 5,
  windowSeconds: n.window_seconds ?? 10,
  whitelistIds: (n.whitelist_ids ?? []).join(', '),
};

const stickyRolesRows = stickyRolesRes?.ok ? await stickyRolesRes.json() : [];
const stickyRolesEnabled: boolean = stickyRolesRows[0]?.enabled ?? false;

const rawCasePage = casesRes?.ok ? await casesRes.json() : [];
// One more than a page is read, to know whether there are older cases.
const olderCases = rawCasePage.length > casesLimit;
const rawCases = rawCasePage.slice(0, casesLimit);
const casesFailed = Boolean(casesRes && !casesRes.ok);
const cases = rawCases.map((c: any) => ({
  caseNumber: c.case_number, type: c.type, userId: c.user_id, moderatorId: c.moderator_id,
  reason: c.reason, active: c.active, createdAt: c.created_at, evidence: (c.evidence ?? []) as string[],
}));

const rawActive = activeRes?.ok ? await activeRes.json() : [];
const activeSanctions = rawActive.map((c: any) => ({ caseNumber: c.case_number, type: c.type, userId: c.user_id, moderatorId: c.moderator_id, reason: c.reason, createdAt: c.created_at, expiresAt: c.expires_at }));

// The last 30 days of cases, as numbers: by kind, by moderator, by day. What the bot did by itself is counted apart.
const rawStats = statsRes?.ok ? await statsRes.json() : [];
const moderatorTotals = new Map<string, number>();
const typeTotals: Record<string, number> = {};
const dayTotals: Record<string, number> = {};
let automaticTotal = 0;
for (const row of rawStats) {
  typeTotals[row.type] = (typeTotals[row.type] ?? 0) + 1;
  const day = botDay(row.created_at);
  dayTotals[day] = (dayTotals[day] ?? 0) + 1;
  if (row.source && row.source !== 'moderator') { automaticTotal += 1; continue; }
  moderatorTotals.set(row.moderator_id, (moderatorTotals.get(row.moderator_id) ?? 0) + 1);
}
const modStats = {
  total: rawStats.length,
  automatic: automaticTotal,
  byType: Object.entries(typeTotals).sort((x, y) => y[1] - x[1]),
  moderators: [...moderatorTotals.entries()].sort((x, y) => y[1] - x[1]).slice(0, 10).map(([userId, count]) => ({ userId, count })),
  days: rangeDays(new Date(), 14).map((d) => ({ label: d.slice(5), count: dayTotals[d] ?? 0 })),
};

// Names and pictures for the people in the cases, so the log is readable and not a list of ids. Discord answers are kept for a while.
const caseUserIds = [...new Set([...cases, ...activeSanctions, ...modStats.moderators.map((m: { userId: string }) => ({ userId: m.userId, moderatorId: m.userId }))].flatMap((c: { userId: string; moderatorId: string }) => [c.userId, c.moderatorId]).filter((value: string) => /^\d{15,25}$/.test(value)))] as string[];
const peopleMap = caseUserIds.length ? await describeTeam(botToken, caseUserIds.slice(0, 120)) : new Map();
// The pictures are drawn at 20 px: the small size of Discord's picture is asked for, not the 128 px one.
const people: Record<string, { name: string; avatar: string }> = Object.fromEntries([...peopleMap].map(([userId, person]) => [userId, { name: person.displayName, avatar: person.avatarUrl.replace(/\?size=128$/, '?size=32') }]));

const allRoles = rolesRes?.ok ? await rolesRes.json() : [];
const roles = allRoles
  .filter((r: any) => r.name !== '@everyone')
  .sort((a: any, b: any) => b.position - a.position)
  .map((r: any) => ({ id: r.id, name: r.name }));

const allChannels = channelsRes?.ok ? await channelsRes.json() : [];
const channels = allChannels
  .filter((c: any) => c.type === 0 || c.type === 5)
  .sort((a: any, b: any) => a.position - b.position)
  .map((c: any) => ({ id: c.id, name: c.name }));

function channelName(channelId: string) {
  return channels.find((c: any) => c.id === channelId)?.name ?? channelId;
}

const rawSilent = silentRes?.ok ? await silentRes.json() : [];
const silentChannels = rawSilent.map((s: any) => ({ channelId: s.channel_id, name: channelName(s.channel_id), action: s.action }));

// The table comes with the bot update that adds sanction messages; until then the section says so.
const sanctionMessagesReady = Boolean(sanctionTemplatesRes?.ok);
const sanctionTemplates: Record<string, { dm: string; reply: string; log: string }> = {};
for (const row of sanctionMessagesReady && sanctionTemplatesRes ? await sanctionTemplatesRes.json() : []) {
  sanctionTemplates[row.type] = { dm: row.dm_template ?? '', reply: row.reply_template ?? '', log: row.log_template ?? '' };
}
const embedTemplateNames: string[] = embedTemplatesRes?.ok ? (await embedTemplatesRes.json()).map((t: any) => t.name) : [];

// The prefix of the server, for the commands the texts name (!mute is not a slash command).
const prefixRes = await fetch(`${apiUrl}/rest/v1/guilds?guild_id=eq.${id}&select=prefix`, { headers: apiHeaders }).catch(() => null);
const prefix = String((prefixRes?.ok ? await prefixRes.json().catch(() => []) : [])[0]?.prefix || '!');

const rawEscalation = escalationRes?.ok ? await escalationRes.json() : [];
const escalationRules = rawEscalation.map((e: any) => ({
  warnCount: e.warn_count, action: e.action,
  durationMinutes: e.duration_ms ? Math.round(e.duration_ms / 60000) : null,
}));
---
<DashModeration
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'}
  automod={automod}
  antinuke={antinuke}
  stickyRolesEnabled={stickyRolesEnabled}
  cases={cases}
  activeSanctions={activeSanctions}
  modStats={modStats}
  people={people}
  casesLimit={casesLimit}
  caseLog={{ type: caseType, filter: caseFilterOf(caseType), q: caseQuery, before: caseBefore, older: olderCases, failed: casesFailed, edit: caseEdit }}
  silentChannels={silentChannels}
  escalationRules={escalationRules}
  sanctionTemplates={sanctionTemplates}
  sanctionMessagesReady={sanctionMessagesReady}
  embedTemplateNames={embedTemplateNames}
  roles={roles}
  channels={channels}
  saved={saved}
  badInvites={badInvites}
  tooManyInvites={tooManyInvites}
  caseMessage={caseMessage}
  section={section}
  prefix={prefix}
/>
