---
export const prerender = false;
import { describeTeam } from '../../../../utils/team';
import DashModeration from '../../../../components/DashModeration.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';
import { runBatched } from '../../../../utils/concurrency';

const { id } = Astro.params as { id: string };
const section = Astro.url.searchParams.get('section') ?? 'protection';
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;

if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const apiHeaders = {
  apikey: apiKey,
  Authorization: `Bearer ${apiKey}`,
  'Content-Type': 'application/json',
};

let saved = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? 'config');

  if (action === 'config') {
    const bannedWords = String(form.get('banned_words') ?? '').split(',').map((w) => w.trim()).filter(Boolean);
    const immuneRoleIds = form.getAll('immune_role_ids').map(String);
    const whitelistIds = String(form.get('whitelist_ids') ?? '').split(',').map((w) => w.trim()).filter(Boolean);

    await Promise.all([
      fetch(`${apiUrl}/rest/v1/automod_config?on_conflict=guild_id`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({
          guild_id: id,
          word_filter_enabled: form.get('word_filter_enabled') === 'on',
          word_filter_action: String(form.get('word_filter_action') ?? 'warn'),
          banned_words: bannedWords,
          anti_spam_enabled: form.get('anti_spam_enabled') === 'on',
          max_mentions: Math.max(1, Math.min(50, Number(form.get('max_mentions') ?? 5) || 5)),
          anti_raid_enabled: form.get('anti_raid_enabled') === 'on',
          raid_join_threshold: Math.max(2, Math.min(50, Number(form.get('raid_join_threshold') ?? 6) || 6)),
          raid_window_seconds: Math.max(5, Math.min(120, Number(form.get('raid_window_seconds') ?? 10) || 10)),
          raid_action: String(form.get('raid_action') ?? 'alert'),
          anti_alt_enabled: form.get('anti_alt_enabled') === 'on',
          anti_alt_min_age_days: Math.max(0, Math.min(365, Number(form.get('anti_alt_min_age_days') ?? 7) || 7)),
          anti_alt_action: String(form.get('anti_alt_action') ?? 'kick'),
          immune_role_ids: immuneRoleIds,
          updated_at: new Date().toISOString(),
        }),
      }),
      fetch(`${apiUrl}/rest/v1/antinuke_config?on_conflict=guild_id`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({
          guild_id: id,
          enabled: form.get('antinuke_enabled') === 'on',
          action_threshold: Math.max(2, Math.min(30, Number(form.get('antinuke_action_threshold') ?? 5) || 5)),
          window_seconds: Math.max(5, Math.min(120, Number(form.get('antinuke_window_seconds') ?? 10) || 10)),
          whitelist_ids: whitelistIds,
          updated_at: new Date().toISOString(),
        }),
      }),
      fetch(`${apiUrl}/rest/v1/sticky_roles_config?on_conflict=guild_id`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({ guild_id: id, enabled: form.get('sticky_roles_enabled') === 'on' }),
      }),
    ]);
    saved = true;
  } else if (action === 'save_sanction_messages') {
    const types = ['default', 'ban', 'tempban', 'softban', 'unban', 'kick', 'mute', 'tempmute', 'unmute', 'warn', 'jail', 'unjail'];
    const pick = (type: string, slot: string) => String(form.get(`${type}__${slot}`) ?? '').trim().slice(0, 40) || null;
    const rows = types.map((type) => ({ guild_id: id, type, dm_template: pick(type, 'dm'), reply_template: pick(type, 'reply'), log_template: pick(type, 'log') }));
    const filled = rows.filter((row) => row.dm_template || row.reply_template || row.log_template);
    const empty = rows.filter((row) => !filled.includes(row));
    if (filled.length) {
      await fetch(`${apiUrl}/rest/v1/sanction_templates?on_conflict=guild_id,type`, { method: 'POST', headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify(filled) });
    }
    if (empty.length) {
      await fetch(`${apiUrl}/rest/v1/sanction_templates?guild_id=eq.${id}&type=in.(${empty.map((row) => row.type).join(',')})`, { method: 'DELETE', headers: apiHeaders });
    }
    saved = true;
  } else if (action === 'add_silent_channel') {
    const channelId = String(form.get('channel_id') ?? '').trim();
    const silentAction = String(form.get('silent_action') ?? 'warn');
    if (channelId) {
      await fetch(`${apiUrl}/rest/v1/automod_silent_channels?on_conflict=guild_id,channel_id`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({ guild_id: id, channel_id: channelId, action: silentAction }),
      });
      saved = true;
    }
  } else if (action === 'delete_silent_channel') {
    const channelId = encodeURIComponent(String(form.get('channel_id') ?? ''));
    await fetch(`${apiUrl}/rest/v1/automod_silent_channels?guild_id=eq.${id}&channel_id=eq.${channelId}`, { method: 'DELETE', headers: apiHeaders });
    saved = true;
  } else if (action === 'add_escalation') {
    const warnCount = Math.max(1, Number(form.get('warn_count') ?? 0) || 0);
    const escAction = String(form.get('esc_action') ?? 'mute');
    const durationMinutes = Number(form.get('duration_minutes') ?? 0) || 0;
    if (warnCount > 0) {
      await fetch(`${apiUrl}/rest/v1/warn_escalation_rules?on_conflict=guild_id,warn_count`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({
          guild_id: id, warn_count: warnCount, action: escAction,
          duration_ms: durationMinutes > 0 ? durationMinutes * 60000 : null,
        }),
      });
      saved = true;
    }
  } else if (action === 'delete_escalation') {
    const warnCount = Number(form.get('warn_count') ?? 0) || 0;
    await fetch(`${apiUrl}/rest/v1/warn_escalation_rules?guild_id=eq.${id}&warn_count=eq.${warnCount}`, { method: 'DELETE', headers: apiHeaders });
    saved = true;
  }
}

const casesLimit = [25, 50, 100, 200].includes(Number(Astro.url.searchParams.get('cases'))) ? Number(Astro.url.searchParams.get('cases')) : 25;
// Only the section on screen is drawn, so only what it shows is read.
const MODERATION_SECTIONS = ['protection', 'silent-channels', 'warn-escalation', 'sanction-messages', 'cases'];
const shown = MODERATION_SECTIONS.includes(section) ? section : 'protection';
const needs = (...sections: string[]) => sections.includes(shown);
const when = <T,>(sections: string[], load: () => Promise<T>) => () => (needs(...sections) ? load() : Promise.resolve(null));
const [guildInfo, automodRes, antinukeRes, casesRes, silentRes, escalationRes, rolesRes, channelsRes, stickyRolesRes, sanctionTemplatesRes, embedTemplatesRes] = await runBatched([
  () => getGuildInfo(id, botToken),
  when(['protection'], () => fetch(`${apiUrl}/rest/v1/automod_config?guild_id=eq.${id}&select=*`, { headers: apiHeaders })),
  when(['protection'], () => fetch(`${apiUrl}/rest/v1/antinuke_config?guild_id=eq.${id}&select=*`, { headers: apiHeaders })),
  when(['cases'], () => fetch(`${apiUrl}/rest/v1/mod_actions?guild_id=eq.${id}&select=case_number,type,user_id,moderator_id,reason,active,created_at&order=created_at.desc&limit=${casesLimit}`, { headers: apiHeaders })),
  when(['silent-channels'], () => fetch(`${apiUrl}/rest/v1/automod_silent_channels?guild_id=eq.${id}&select=channel_id,action`, { headers: apiHeaders })),
  when(['warn-escalation'], () => fetch(`${apiUrl}/rest/v1/warn_escalation_rules?guild_id=eq.${id}&select=warn_count,action,duration_ms&order=warn_count.asc`, { headers: apiHeaders })),
  when(['protection'], () => getGuildList(Astro, id, botToken, 'roles')),
  when(['protection', 'silent-channels'], () => getGuildList(Astro, id, botToken, 'channels')),
  when(['protection'], () => fetch(`${apiUrl}/rest/v1/sticky_roles_config?guild_id=eq.${id}&select=enabled`, { headers: apiHeaders })),
  when(['sanction-messages'], () => fetch(`${apiUrl}/rest/v1/sanction_templates?guild_id=eq.${id}&select=type,dm_template,reply_template,log_template`, { headers: apiHeaders })),
  when(['sanction-messages'], () => fetch(`${apiUrl}/rest/v1/embed_templates?guild_id=eq.${id}&select=name&order=name.asc`, { headers: apiHeaders })),
], 6);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

const automodRows = automodRes?.ok ? await automodRes.json() : [];
const a = automodRows[0] ?? {};
const automod = {
  wordFilterEnabled: a.word_filter_enabled ?? false,
  wordFilterAction: a.word_filter_action ?? 'warn',
  bannedWords: a.banned_words ?? [],
  antiSpamEnabled: a.anti_spam_enabled ?? false,
  maxMentions: a.max_mentions ?? 5,
  antiRaidEnabled: a.anti_raid_enabled ?? false,
  raidJoinThreshold: a.raid_join_threshold ?? 6,
  raidWindowSeconds: a.raid_window_seconds ?? 10,
  raidAction: a.raid_action ?? 'alert',
  antiAltEnabled: a.anti_alt_enabled ?? false,
  antiAltMinAgeDays: a.anti_alt_min_age_days ?? 7,
  antiAltAction: a.anti_alt_action ?? 'kick',
  immuneRoleIds: a.immune_role_ids ?? [],
};

const antinukeRows = antinukeRes?.ok ? await antinukeRes.json() : [];
const n = antinukeRows[0] ?? {};
const antinuke = {
  enabled: n.enabled ?? false,
  actionThreshold: n.action_threshold ?? 5,
  windowSeconds: n.window_seconds ?? 10,
  whitelistIds: (n.whitelist_ids ?? []).join(', '),
};

const stickyRolesRows = stickyRolesRes?.ok ? await stickyRolesRes.json() : [];
const stickyRolesEnabled: boolean = stickyRolesRows[0]?.enabled ?? false;

const rawCases = casesRes?.ok ? await casesRes.json() : [];
const cases = rawCases.map((c: any) => ({
  caseNumber: c.case_number, type: c.type, userId: c.user_id, moderatorId: c.moderator_id,
  reason: c.reason, active: c.active, createdAt: c.created_at,
}));

// Names and pictures for the people in the cases, so the log is readable and not a list of ids. Discord answers are kept for a while.
const caseUserIds = [...new Set(cases.flatMap((c: { userId: string; moderatorId: string }) => [c.userId, c.moderatorId]).filter((value: string) => /^\d{15,25}$/.test(value)))] as string[];
const peopleMap = caseUserIds.length ? await describeTeam(botToken, caseUserIds.slice(0, 120)) : new Map();
const people: Record<string, { name: string; avatar: string }> = Object.fromEntries([...peopleMap].map(([userId, person]) => [userId, { name: person.displayName, avatar: person.avatarUrl }]));

const allRoles = rolesRes?.ok ? await rolesRes.json() : [];
const roles = allRoles
  .filter((r: any) => r.name !== '@everyone')
  .sort((a: any, b: any) => b.position - a.position)
  .map((r: any) => ({ id: r.id, name: r.name }));

const allChannels = channelsRes?.ok ? await channelsRes.json() : [];
const channels = allChannels
  .filter((c: any) => c.type === 0 || c.type === 5)
  .sort((a: any, b: any) => a.position - b.position)
  .map((c: any) => ({ id: c.id, name: c.name }));

function channelName(channelId: string) {
  return channels.find((c: any) => c.id === channelId)?.name ?? channelId;
}

const rawSilent = silentRes?.ok ? await silentRes.json() : [];
const silentChannels = rawSilent.map((s: any) => ({ channelId: s.channel_id, name: channelName(s.channel_id), action: s.action }));

// The table comes with the bot update that adds sanction messages; until then the section says so.
const sanctionMessagesReady = Boolean(sanctionTemplatesRes?.ok);
const sanctionTemplates: Record<string, { dm: string; reply: string; log: string }> = {};
for (const row of sanctionMessagesReady && sanctionTemplatesRes ? await sanctionTemplatesRes.json() : []) {
  sanctionTemplates[row.type] = { dm: row.dm_template ?? '', reply: row.reply_template ?? '', log: row.log_template ?? '' };
}
const embedTemplateNames: string[] = embedTemplatesRes?.ok ? (await embedTemplatesRes.json()).map((t: any) => t.name) : [];

const rawEscalation = escalationRes?.ok ? await escalationRes.json() : [];
const escalationRules = rawEscalation.map((e: any) => ({
  warnCount: e.warn_count, action: e.action,
  durationMinutes: e.duration_ms ? Math.round(e.duration_ms / 60000) : null,
}));
---
<DashModeration
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.png'}
  automod={automod}
  antinuke={antinuke}
  stickyRolesEnabled={stickyRolesEnabled}
  cases={cases}
  people={people}
  casesLimit={casesLimit}
  silentChannels={silentChannels}
  escalationRules={escalationRules}
  sanctionTemplates={sanctionTemplates}
  sanctionMessagesReady={sanctionMessagesReady}
  embedTemplateNames={embedTemplateNames}
  roles={roles}
  channels={channels}
  saved={saved}
  section={section}
/>
