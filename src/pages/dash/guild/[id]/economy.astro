---
export const prerender = false;
import DashEconomy from '../../../../components/DashEconomy.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getGuildInfo } from '../../../../utils/discord';
import { getEnv } from '../../../../utils/env';
// Economy: a preview for now (nothing is saved).
const { id } = Astro.params as { id: string };
const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const guildInfo = botToken ? await getGuildInfo(id, botToken) : null;
if (!guildInfo) return Astro.redirect('/dash/manage?error=server_not_configured');
---
<DashEconomy user={auth.session} guildId={id} guildName={guildInfo.name} guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'} />
