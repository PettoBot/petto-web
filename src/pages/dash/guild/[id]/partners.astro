---
export const prerender = false;
import DashPartners from '../../../../components/DashPartners.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';
import { isV2Data } from '../../../../utils/embedSchema';
import { guildHasPremium } from '../../../../utils/guildPremium';

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;
if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const apiHeaders = { apikey: apiKey, Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' };
const RESPONSE_KEYS = ['completed', 'cooldown', 'invalid_invite', 'member_requirement', 'blacklisted', 'self_partner', 'age_requirement', 'manager_welcome'];
const premium = await guildHasPremium(apiUrl, apiHeaders, id);
const channelLimit = premium ? 25 : 6;
const snowflake = /^\d{15,25}$/;
const int = (value: FormDataEntryValue | null, max: number) => Math.max(0, Math.min(max, Math.floor(Number(value ?? 0)) || 0));

let saved = false;
let notice = '';
let tableMissing = false;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? 'save');
  if (action === 'add_blacklist' || action === 'remove_blacklist') {
    const server = String(form.get('server') ?? '').trim();
    if (!snowflake.test(server)) {
      notice = 'bad_server';
    } else if (action === 'add_blacklist') {
      await fetch(`${apiUrl}/rest/v1/guilds?on_conflict=guild_id`, { method: 'POST', headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify({ guild_id: id }) }).catch(() => null);
      const res = await fetch(`${apiUrl}/rest/v1/partner_blacklist?on_conflict=guild_id,partner_guild_id`, { method: 'POST', headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify({ guild_id: id, partner_guild_id: server, note: String(form.get('note') ?? '').slice(0, 200) || null }) });
      saved = res.ok;
    } else {
      const res = await fetch(`${apiUrl}/rest/v1/partner_blacklist?guild_id=eq.${id}&partner_guild_id=eq.${server}`, { method: 'DELETE', headers: apiHeaders });
      saved = res.ok;
    }
  } else {
    const messages: Record<string, { text?: string; template?: string }> = {};
    for (const key of RESPONSE_KEYS) {
      const text = String(form.get(`text_${key}`) ?? '').trim().slice(0, 2000);
      const template = String(form.get(`tpl_${key}`) ?? '').trim().slice(0, 100);
      if (text || template) messages[key] = { ...(text ? { text } : {}), ...(template ? { template } : {}) };
    }
    const wanted = [...new Set(form.getAll('channel_ids').map(String).filter((value) => snowflake.test(value)))];
    if (wanted.length > channelLimit) notice = 'channel_limit';
    const reaction = String(form.get('react_emoji') ?? '').trim();
    // The guild row has to exist before a setting that points to it can be saved.
    await fetch(`${apiUrl}/rest/v1/guilds?on_conflict=guild_id`, { method: 'POST', headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify({ guild_id: id }) }).catch(() => null);
    const res = await fetch(`${apiUrl}/rest/v1/partner_config?on_conflict=guild_id`, {
      method: 'POST',
      headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
      body: JSON.stringify({
        guild_id: id,
        enabled: form.get('enabled') === 'on',
        channel_ids: wanted.slice(0, channelLimit),
        manager_role_id: snowflake.test(String(form.get('manager_role_id') ?? '')) ? String(form.get('manager_role_id')) : null,
        min_members: int(form.get('min_members'), 10_000_000),
        min_age_days: int(form.get('min_age_days'), 3650),
        cooldown_days: int(form.get('cooldown_days'), 365),
        keep_original: form.get('keep_original') === 'on',
        react_emoji: reaction && reaction.length <= 64 && !/\s/.test(reaction) ? reaction : null,
        messages,
        updated_at: new Date().toISOString(),
      }),
    });
    saved = res.ok;
    tableMissing = !res.ok;
  }
}

const [guildInfo, configRes, channelsRes, rolesRes, templatesRes, blacklistRes, logRes] = await Promise.all([
  getGuildInfo(id, botToken),
  fetch(`${apiUrl}/rest/v1/partner_config?guild_id=eq.${id}&select=*`, { headers: apiHeaders }),
  getGuildList(Astro, id, botToken, 'channels'),
  getGuildList(Astro, id, botToken, 'roles'),
  fetch(`${apiUrl}/rest/v1/embed_templates?guild_id=eq.${id}&select=name,data&order=name.asc`, { headers: apiHeaders }),
  fetch(`${apiUrl}/rest/v1/partner_blacklist?guild_id=eq.${id}&select=partner_guild_id,note&order=created_at.desc&limit=100`, { headers: apiHeaders }),
  fetch(`${apiUrl}/rest/v1/partner_log?guild_id=eq.${id}&select=manager_id,partner_name,created_at&order=created_at.desc&limit=5000`, { headers: apiHeaders }),
]);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

// The tables come with the bot update that adds partners; until then the page says so.
const ready = configRes.ok && !tableMissing;
const c = (ready ? (await configRes.json())[0] : null) ?? {};
const config = {
  enabled: c.enabled ?? false,
  channelIds: (c.channel_ids ?? []) as string[],
  managerRoleId: c.manager_role_id ?? '',
  minMembers: c.min_members ?? 0,
  minAgeDays: c.min_age_days ?? 0,
  cooldownDays: c.cooldown_days ?? 0,
  keepOriginal: c.keep_original ?? true,
  reactEmoji: c.react_emoji ?? '',
  messages: (c.messages ?? {}) as Record<string, { text?: string; template?: string }>,
};
const channels = (channelsRes.ok ? await channelsRes.json() : []).filter((ch: any) => ch.type === 0 || ch.type === 5).sort((a: any, b: any) => a.position - b.position).map((ch: any) => ({ id: ch.id, name: ch.name }));
const roles = (rolesRes.ok ? await rolesRes.json() : []).filter((r: any) => r.name !== '@everyone').sort((a: any, b: any) => b.position - a.position).map((r: any) => ({ id: r.id, name: r.name }));
const embedTemplates = (templatesRes.ok ? await templatesRes.json() : []).map((row: any) => ({ name: row.name as string, v2: isV2Data(row.data) }));
const blacklist = (blacklistRes.ok ? await blacklistRes.json() : []).map((row: any) => ({ server: row.partner_guild_id as string, note: (row.note ?? '') as string }));

// The numbers: this week (Monday, UTC) and all time, by Partner Manager.
const rows = (logRes.ok ? await logRes.json() : []) as { manager_id: string; partner_name: string | null; created_at: string }[];
const now = new Date();
const day = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());
const weekStart = day - ((now.getUTCDay() + 6) % 7) * 86_400_000;
const board = (since: number) => {
  const byManager = new Map<string, number>();
  for (const row of rows) if (new Date(row.created_at).getTime() >= since) byManager.set(row.manager_id, (byManager.get(row.manager_id) ?? 0) + 1);
  return [...byManager.entries()].sort((a, b) => b[1] - a[1]).slice(0, 10).map(([managerId, count]) => ({ managerId, count }));
};
const stats = {
  today: rows.filter((row) => new Date(row.created_at).getTime() >= day).length,
  week: rows.filter((row) => new Date(row.created_at).getTime() >= weekStart).length,
  total: rows.length,
  weekBoard: board(weekStart),
  allBoard: board(0),
  recent: rows.slice(0, 5).map((row) => ({ name: row.partner_name ?? '', at: row.created_at })),
};
---
<DashPartners
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.png'}
  config={config}
  channels={channels}
  roles={roles}
  embedTemplates={embedTemplates}
  blacklist={blacklist}
  stats={stats}
  channelLimit={channelLimit}
  premium={premium}
  ready={ready}
  saved={saved}
  notice={notice}
/>
