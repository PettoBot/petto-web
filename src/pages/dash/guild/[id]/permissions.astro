---
export const prerender = false;
import DashPermissions from '../../../../components/DashPermissions.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';
import { runBatched } from '../../../../utils/concurrency';
import { accessCommands } from '../../../../utils/commandAccess';
import { getDashLang } from '../../../../i18n/dash';

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;

if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const apiHeaders = {
  apikey: apiKey,
  Authorization: `Bearer ${apiKey}`,
  'Content-Type': 'application/json',
};

const [guildInfo, rolesRes, groupsRes, levelsRes, restrictRes, disabledRes] = await runBatched([
  () => getGuildInfo(id, botToken),
  () => getGuildList(Astro, id, botToken, 'roles'),
  () => fetch(`${apiUrl}/rest/v1/permission_groups?guild_id=eq.${id}&select=*&order=id.asc`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/command_permission_levels?guild_id=eq.${id}&select=command_name,required_level`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/command_restrictions?guild_id=eq.${id}&select=command,role_id`, { headers: apiHeaders }),
  () => fetch(`${apiUrl}/rest/v1/disabled_commands?guild_id=eq.${id}&select=command,channel_id`, { headers: apiHeaders }),
], 6);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

const ADMINISTRATOR = 1n << 3n;
const MANAGE_GUILD = 1n << 5n;

const allRoles = rolesRes.ok ? await rolesRes.json() : [];
const everyonePermissions = String(allRoles.find((r: any) => r.name === '@everyone' || r.id === id)?.permissions ?? '0');
const roles = allRoles
  .filter((r: any) => r.name !== '@everyone')
  .sort((a: any, b: any) => b.position - a.position)
  .map((r: any) => {
    const bits = BigInt(r.permissions ?? '0');
    return {
      id: r.id,
      name: r.name,
      isAdmin: (bits & ADMINISTRATOR) === ADMINISTRATOR,
      isManageGuild: (bits & MANAGE_GUILD) === MANAGE_GUILD,
      color: Number(r.color) || 0,
      permissions: String(r.permissions ?? '0'),
    };
  });

let groups = groupsRes.ok ? await groupsRes.json() : [];

// A guild always needs a base/@everyone node for the graph to have a center, create it on
// first visit rather than forcing every page that touches permissions to know about this.
let baseGroup = groups.find((g: any) => g.is_base);
if (!baseGroup) {
  const createRes = await fetch(`${apiUrl}/rest/v1/permission_groups?on_conflict=guild_id,name`, {
    method: 'POST',
    headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=representation' },
    body: JSON.stringify({ guild_id: id, name: '@everyone', level: 0, is_base: true }),
  });
  if (createRes.ok) {
    const created = await createRes.json();
    baseGroup = created[0];
    groups = [...groups, baseGroup];
  }
}

const groupIds = groups.map((g: any) => g.id);
let members: any[] = [];
if (groupIds.length) {
  const memRes = await fetch(`${apiUrl}/rest/v1/permission_group_members?group_id=in.(${groupIds.join(',')})&select=*`, { headers: apiHeaders });
  members = memRes.ok ? await memRes.json() : [];
}
const groupsWithMembers = groups.map((g: any) => ({
  id: g.id,
  name: g.name,
  level: g.level,
  isBase: g.is_base,
  members: members.filter((m: any) => m.group_id === g.id).map((m: any) => ({ subjectType: m.subject_type, subjectId: m.subject_id })),
}));

const levelRows = levelsRes.ok ? await levelsRes.json() : [];
const json = async (res: Response) => (res.ok ? res.json().catch(() => []) : []);
const commands = accessCommands(getDashLang(Astro), { levels: levelRows, restrictions: await json(restrictRes), disabled: await json(disabledRes) });
---
<DashPermissions
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'}
  roles={roles}
  groups={groupsWithMembers}
  everyonePermissions={everyonePermissions}
  commands={commands}
/>
