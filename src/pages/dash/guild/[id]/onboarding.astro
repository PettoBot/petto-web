---
export const prerender = false;
import DashOnboarding from '../../../../components/DashOnboarding.astro';
import { runOnboardingPage } from '../../../../utils/onboardingPage';
// Verification (Security). The page was "Join Gate" with the welcome, the roles and the bump too: those have their own pages now (welcome, join-roles, bump), and the old
// links (`onboarding#messages`) are sent there by the page itself.
const { id } = Astro.params as { id: string };
const result = await runOnboardingPage(Astro, id);
if ('redirect' in result) return Astro.redirect(result.redirect);
---
<DashOnboarding {...(result.props as any)} view="verification" />
