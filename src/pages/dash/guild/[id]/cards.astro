---
export const prerender = false;
import DashCards from '../../../../components/DashCards.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo } from '../../../../utils/discord';

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
if (!botToken || !getEnv(Astro, 'PETTO_BOT_API_URL') || !getEnv(Astro, 'PETTO_BOT_API_SECRET')) return Astro.redirect('/dash/manage?error=server_not_configured');

const guildInfo = await getGuildInfo(id, botToken);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');
const selected = new URL(Astro.request.url).searchParams.get('name') ?? '';
---
<DashCards user={auth.session} guildId={id} guildName={guildInfo.name} guildIcon={guildInfo.icon ?? '/assets/mascot-icon.png'} selected={selected} />
