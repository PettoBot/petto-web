---
export const prerender = false;
import DashRules from '../../../../components/DashRules.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';
import { pageDecision } from '../../../../utils/dashAccess';

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');
const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;
if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');
const headers = { apikey: apiKey, Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' };
const read = async (path: string): Promise<{ ok: boolean; rows: any[] }> => {
  const res = await fetch(`${apiUrl}/rest/v1/${path}`, { headers }).catch(() => null);
  const body: any = res?.ok ? await res.json().catch(() => null) : null;
  return Array.isArray(body) ? { ok: true, rows: body } : { ok: false, rows: [] };
};

const [guildInfo, rolesRes, channelsRes, settings, lists, rulesets, rules, logs] = await Promise.all([
  getGuildInfo(id, botToken), getGuildList(Astro, id, botToken, 'roles'), getGuildList(Astro, id, botToken, 'channels'),
  read(`mod_rule_settings?guild_id=eq.${id}&select=*`), read(`mod_lists?guild_id=eq.${id}&select=*&order=name.asc`),
  read(`mod_rulesets?guild_id=eq.${id}&select=*&order=position.asc,id.asc`), read(`mod_rules?guild_id=eq.${id}&select=*&order=position.asc,id.asc`),
  read(`mod_rule_logs?guild_id=eq.${id}&select=*&order=id.desc&limit=100`),
]);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');
const allRoles: any[] = rolesRes.ok ? ((await rolesRes.json().catch(() => [])) as any[]) : [];
const allChannels: any[] = channelsRes.ok ? ((await channelsRes.json().catch(() => [])) as any[]) : [];
const roles = allRoles.filter((r: any) => String(r.id) !== id).sort((a: any, b: any) => Number(b.position ?? 0) - Number(a.position ?? 0)).map((r: any) => ({ id: String(r.id), name: String(r.name), managed: Boolean(r.managed) }));
const channels = allChannels.filter((c: any) => c.type === 0 || c.type === 5 || c.type === 15).sort((a: any, b: any) => Number(a.position ?? 0) - Number(b.position ?? 0)).map((c: any) => ({ id: String(c.id), name: String(c.name) }));
const categories = allChannels.filter((c: any) => c.type === 4).sort((a: any, b: any) => Number(a.position ?? 0) - Number(b.position ?? 0)).map((c: any) => ({ id: String(c.id), name: String(c.name) }));
const ready = settings.ok && lists.ok && rulesets.ok && rules.ok;
const data = {
  settings: settings.rows[0] ? { enabled: settings.rows[0].enabled !== false, ignore_staff: settings.rows[0].ignore_staff !== false, log_channel_id: settings.rows[0].log_channel_id ?? null } : { enabled: true, ignore_staff: true, log_channel_id: null },
  lists: lists.rows.map((l: any) => ({ id: String(l.id), name: String(l.name), kind: l.kind === 'domains' ? 'domains' : 'words', items: Array.isArray(l.items) ? l.items.map(String) : [] })),
  rulesets: rulesets.rows.map((s: any) => ({
    id: String(s.id), name: String(s.name), enabled: s.enabled !== false, conditions: Array.isArray(s.conditions) ? s.conditions : [],
    rules: rules.rows.filter((r: any) => String(r.ruleset_id) === String(s.id)).map((r: any) => ({
      id: String(r.id), name: String(r.name), enabled: r.enabled !== false, trigger_mode: r.trigger_mode === 'all' ? 'all' : 'any',
      triggers: Array.isArray(r.triggers) ? r.triggers : [], conditions: Array.isArray(r.conditions) ? r.conditions : [], effects: Array.isArray(r.effects) ? r.effects : [],
      threshold_count: Number(r.threshold_count) || 1, threshold_minutes: Number(r.threshold_minutes) || 10, stop: r.stop !== false, hits: Number(r.hits) || 0,
    })),
  })),
  logs: logs.rows.map((l: any) => ({ id: String(l.id), rule: String(l.rule_name), user: String(l.user_id), channel: l.channel_id ? String(l.channel_id) : null, trigger: String(l.trigger), effects: Array.isArray(l.effects) ? l.effects.map(String) : [], at: String(l.created_at) })),
};
// Someone let in by a role of the dashboard (and the Petto owner in Support mode) only looks, unless the role lets them change this page.
let canEdit = !auth.devView && !auth.access;
if (auth.access) canEdit = pageDecision(auth.access, 'rules').canEdit;
---
<DashRules user={session} guildId={id} guildName={guildInfo.name} guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'} data={data} roles={roles} channels={channels} categories={categories} ready={ready} canEdit={canEdit} />
