---
export const prerender = false;
import DashStreaks from '../../../../components/DashStreaks.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo } from '../../../../utils/discord';
import { getDashLang, makeT } from '../../../../i18n/dash';
const dt = makeT(getDashLang(Astro));

// Streaks: what counts as an active day in this server (messages and minutes in voice that day). It is one row of `streak_config`; the streak itself is worked out by the bot from the activity it already counts.
const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;
if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const headers = { apikey: apiKey, Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' };
const whole = (value: FormDataEntryValue | null, max: number) => Math.max(0, Math.min(max, Math.floor(Number(value ?? 0)) || 0));
let saved = false;
let problem: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    const minMessages = whole(form.get('min_messages'), 1000);
    const minVoice = whole(form.get('min_voice_minutes'), 1440);
    if (minMessages === 0 && minVoice === 0) problem = dt('Ask for at least one message or one minute in voice, or every day would count.');
    else {
      const res = await fetch(`${apiUrl}/rest/v1/streak_config?on_conflict=guild_id`, {
        method: 'POST', headers: { ...headers, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({ guild_id: id, enabled: form.get('enabled') === 'on', min_messages: minMessages, min_voice_minutes: minVoice, updated_at: new Date().toISOString() }),
      });
      if (res.ok) saved = true; else problem = dt('It could not be saved. Try again in a moment.');
    }
  } catch (error) {
    console.error(`[streaks] saving for ${id}:`, (error as Error)?.message);
    problem = dt('It could not be saved. Try again in a moment.');
  }
}

const [guildInfo, rowRes] = await Promise.all([getGuildInfo(id, botToken), fetch(`${apiUrl}/rest/v1/streak_config?guild_id=eq.${id}&select=enabled,min_messages,min_voice_minutes`, { headers })]);
const fallbackInfo = Astro.request.method === 'POST' && !guildInfo ? { id, name: dt('Server'), icon: null } : null;
if (!guildInfo && !fallbackInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');
const serverInfo = (guildInfo ?? fallbackInfo)!;
// The table exists once the bot that added it runs; before that the page says so and offers nothing to save.
const ready = rowRes.ok;
const rows: any[] = ready ? await rowRes.json().catch(() => []) : [];
const row = { enabled: rows[0] ? rows[0].enabled !== false : true, minMessages: rows[0] ? Number(rows[0].min_messages) : 1, minVoice: rows[0] ? Number(rows[0].min_voice_minutes) : 0 };
---
<DashStreaks user={session} guildId={id} guildName={serverInfo.name} guildIcon={serverInfo.icon ?? '/assets/mascot-icon.webp'} row={row} ready={ready} saved={saved} problem={problem} />
