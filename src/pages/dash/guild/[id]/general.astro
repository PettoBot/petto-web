---
export const prerender = false;
import DashGeneral from '../../../../components/DashGeneral.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo } from '../../../../utils/discord';

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const supabaseUrl = getEnv(Astro, 'SUPABASE_URL');
const supabaseKey = getEnv(Astro, 'SUPABASE_SERVICE_ROLE_KEY');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;

if (!botToken || !supabaseUrl || !supabaseKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const supabaseHeaders = {
  apikey: supabaseKey,
  Authorization: `Bearer ${supabaseKey}`,
  'Content-Type': 'application/json',
};

let saved = false;
let reset = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? 'save');

  if (action === 'reset') {
    // Only resets what's shown on this page (prefix, mute role) plus the bot's identity fields
    // from Customize, this is a "reset general settings" button, not a wipe of every module.
    await fetch(`${supabaseUrl}/rest/v1/guilds`, {
      method: 'POST',
      headers: { ...supabaseHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
      body: JSON.stringify({
        guild_id: id, prefix: '!', mute_role_id: null,
        bot_nickname: null, bot_avatar_url: null, bot_banner_url: null, bot_description: null,
        updated_at: new Date().toISOString(),
      }),
    });
    if (botToken) {
      await fetch(`https://discord.com/api/guilds/${id}/members/@me`, {
        method: 'PATCH',
        headers: { Authorization: `Bot ${botToken}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ nick: null, avatar: null, banner: null, bio: null }),
      }).catch(() => {});
    }
    reset = true;
  } else {
    const prefix = (String(form.get('prefix') ?? '!').trim() || '!').slice(0, 5);
    const muteRoleId = String(form.get('mute_role_id') ?? '').trim() || null;

    await fetch(`${supabaseUrl}/rest/v1/guilds`, {
      method: 'POST',
      headers: { ...supabaseHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
      body: JSON.stringify({ guild_id: id, prefix, mute_role_id: muteRoleId, updated_at: new Date().toISOString() }),
    });
    saved = true;
  }
}

const [guildInfo, rolesRes, guildsRes] = await Promise.all([
  getGuildInfo(id, botToken),
  fetch(`https://discord.com/api/guilds/${id}/roles`, { headers: { Authorization: `Bot ${botToken}` } }),
  fetch(`${supabaseUrl}/rest/v1/guilds?guild_id=eq.${id}&select=prefix,mute_role_id`, { headers: supabaseHeaders }),
]);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

const allRoles = rolesRes.ok ? await rolesRes.json() : [];
const roles = allRoles
  .filter((r: any) => r.name !== '@everyone')
  .sort((a: any, b: any) => b.position - a.position)
  .map((r: any) => ({ id: r.id, name: r.name }));

const guildsRows = guildsRes.ok ? await guildsRes.json() : [];
const g = guildsRows[0] ?? {};
const config = { prefix: g.prefix ?? '!', mute_role_id: g.mute_role_id ?? null };
---
<DashGeneral
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.png'}
  prefix={config.prefix}
  muteRoleId={config.mute_role_id}
  roles={roles}
  saved={saved}
  reset={reset}
/>
