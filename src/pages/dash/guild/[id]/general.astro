---
export const prerender = false;
import DashGeneral from '../../../../components/DashGeneral.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { noteGuildWrite } from '../../../../utils/guildSnapshots';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';
import { syncPettoLanguage, syncPettoPrefix } from '../../../../utils/pettoBotApi';
import { checkPrefixList, prefixesFromRows, DEFAULT_PREFIXES } from '../../../../utils/guildPrefixes';
import { getDashLang, makeT } from '../../../../i18n/dash';

const { id } = Astro.params as { id: string };
const section = Astro.url.searchParams.get('section') ?? 'settings';
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;

if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const apiHeaders = {
  apikey: apiKey,
  Authorization: `Bearer ${apiKey}`,
  'Content-Type': 'application/json',
};

let saved = false;
let reset = false;
let prefixError = '';
const dt = makeT(getDashLang(Astro));

async function syncPrefix(prefixes: string | string[]) {
  try {
    const result = await syncPettoPrefix(Astro, id, prefixes);
    if (!result.ok) console.warn(`Could not sync prefix with Petto bot for guild ${id}: ${result.error ?? 'unknown_error'}`);
  } catch (err) {
    console.warn(`Could not sync prefix with Petto bot for guild ${id}:`, err);
  }
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? 'save');

  if (action === 'reset') {
    // Only resets what's shown on this page (prefix, mute role) plus the bot's identity fields
    // from Customize, this is a "reset general settings" button, not a wipe of every module.
    await fetch(`${apiUrl}/rest/v1/guilds?on_conflict=guild_id`, {
      method: 'POST',
      headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
      body: JSON.stringify({
        guild_id: id, prefix: DEFAULT_PREFIXES[0], mute_role_id: null,
        bot_nickname: null, bot_avatar_url: null, bot_banner_url: null, bot_description: null,
        updated_at: new Date().toISOString(),
      }),
    });
    // The list goes apart from the rest, so a database that does not have the column yet still resets everything else.
    await fetch(`${apiUrl}/rest/v1/guilds?on_conflict=guild_id`, {
      method: 'POST',
      headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
      body: JSON.stringify({ guild_id: id, prefixes: DEFAULT_PREFIXES }),
    }).catch(() => {});
    await syncPrefix(DEFAULT_PREFIXES);
    if (botToken) {
      await fetch(`https://discord.com/api/guilds/${id}/members/@me`, {
        method: 'PATCH',
        headers: { Authorization: `Bot ${botToken}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ nick: null, avatar: null, banner: null, bio: null }),
      }).catch(() => {});
      noteGuildWrite(id);
    }
    reset = true;
  } else if (action === 'prefixes') {
    // The Manage prefixes window: the whole list. The first prefix is the main one and goes in the old column too.
    let raw: unknown = null;
    try { raw = JSON.parse(String(form.get('prefixes') ?? '[]')); } catch { /* checked below */ }
    const checked = checkPrefixList(raw);
    if (checked.problem) {
      prefixError = dt(checked.problem.key, checked.problem.vars);
    } else {
      const list = checked.prefixes;
      const res = await fetch(`${apiUrl}/rest/v1/guilds?on_conflict=guild_id`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({ guild_id: id, prefix: list[0], prefixes: list, updated_at: new Date().toISOString() }),
      }).catch(() => null);
      await syncPrefix(list);
      if (res && res.ok) saved = true;
      else prefixError = dt('Could not save the prefixes, try again.');
    }
  } else {
    const muteRoleId = String(form.get('mute_role_id') ?? '').trim() || null;

    await fetch(`${apiUrl}/rest/v1/guilds?on_conflict=guild_id`, {
      method: 'POST',
      headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
      body: JSON.stringify({ guild_id: id, mute_role_id: muteRoleId, updated_at: new Date().toISOString() }),
    });
    // Apart from the rest, so a database that does not have this column yet still saves the prefix and the mute role.
    await fetch(`${apiUrl}/rest/v1/guilds?on_conflict=guild_id`, {
      method: 'POST',
      headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
      body: JSON.stringify({ guild_id: id, global_stats_hidden: form.get('global_stats_visible') !== 'on' }),
    }).catch(() => {});
    // Also apart: the column comes with the bot update that adds languages. The bot reads it again within a few minutes.
    const language = String(form.get('language') ?? '');
    if (['en', 'es', 'pt-BR'].includes(language)) {
      await fetch(`${apiUrl}/rest/v1/guilds?on_conflict=guild_id`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({ guild_id: id, language }),
      }).catch(() => {});
      // An old bot without the route keeps the old language until its own cache runs out, a few minutes at most.
      await syncPettoLanguage(Astro, id, language).catch(() => {});
    }
    saved = true;
  }
}

// Every read at once. The visibility and the language are read apart from the rest, because a database without those columns yet refuses
// the whole read; they used to wait for each other and for the rest, one after the other.
const optional = (column: string) => fetch(`${apiUrl}/rest/v1/guilds?guild_id=eq.${id}&select=${column}`, { headers: apiHeaders })
  .then(async (res) => (res.ok ? (await res.json())?.[0] : undefined))
  .catch(() => undefined);
const [guildInfo, rolesRes, guildsRes, visibleRow, languageRow, prefixesRow] = await Promise.all([
  getGuildInfo(id, botToken),
  getGuildList(Astro, id, botToken, 'roles'),
  fetch(`${apiUrl}/rest/v1/guilds?guild_id=eq.${id}&select=prefix,mute_role_id`, { headers: apiHeaders }),
  optional('global_stats_hidden'),
  optional('language'),
  optional('prefixes'),
]);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

// In the public ranking unless the server hid itself (and also when the column is not there yet).
const globalStatsVisible = visibleRow?.global_stats_hidden !== true;

// English until the server picks another one (and also when the column is not there yet).
const languageValue = languageRow?.language;
const language = languageValue === 'es' || languageValue === 'pt-BR' ? languageValue : 'en';

const allRoles = rolesRes.ok ? await rolesRes.json() : [];
const roles = allRoles
  .filter((r: any) => r.name !== '@everyone')
  .sort((a: any, b: any) => b.position - a.position)
  .map((r: any) => ({ id: r.id, name: r.name }));

const guildsRows = guildsRes.ok ? await guildsRes.json() : [];
const g = guildsRows[0] ?? {};
const prefixes = prefixesFromRows(prefixesRow?.prefixes, g.prefix);
const config = { prefix: prefixes[0], mute_role_id: g.mute_role_id ?? null };
---
<DashGeneral
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'}
  prefix={config.prefix}
  prefixes={prefixes}
  prefixError={prefixError}
  muteRoleId={config.mute_role_id}
  globalStatsVisible={globalStatsVisible}
  language={language}
  roles={roles}
  saved={saved}
  reset={reset}
  section={section}
/>
