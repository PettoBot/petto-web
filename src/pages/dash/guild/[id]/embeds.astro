---
export const prerender = false;
import DashEmbeds from '../../../../components/DashEmbeds.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, getGuildMemberSelf, getBotProfile } from '../../../../utils/discord';
import { hasPremiumForGuild } from '../../../../utils/premium';

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const supabaseUrl = getEnv(Astro, 'SUPABASE_URL');
const supabaseKey = getEnv(Astro, 'SUPABASE_SERVICE_ROLE_KEY');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;
const premiumActive = await hasPremiumForGuild(Astro, session.userId, id);

if (!botToken || !supabaseUrl || !supabaseKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const supabaseHeaders = {
  apikey: supabaseKey,
  Authorization: `Bearer ${supabaseKey}`,
  'Content-Type': 'application/json',
};

const [guildInfo, botProfile, templatesRes] = await Promise.all([
  getGuildInfo(id, botToken),
  getBotProfile(botToken),
  fetch(`${supabaseUrl}/rest/v1/embed_templates?guild_id=eq.${id}&select=name&order=name.asc`, { headers: supabaseHeaders }),
]);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

// memberSelf needs botProfile.id first, this is the only fetch here that can't join the batch above.
const memberSelf = botProfile ? await getGuildMemberSelf(id, botToken, botProfile.id) : null;
const botName = memberSelf?.nick || botProfile?.username || 'Petto';
const botIcon = memberSelf?.avatarUrl || botProfile?.avatarUrl || '/assets/mascot-icon.png';

const templateNames = templatesRes.ok ? (await templatesRes.json()).map((t: any) => t.name) : [];
const selected = new URL(Astro.request.url).searchParams.get('name') ?? templateNames[0] ?? '';
---
<DashEmbeds
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.png'}
  botName={botName}
  botIcon={botIcon}
  templateNames={templateNames}
  selected={selected}
  premiumActive={premiumActive}
/>
