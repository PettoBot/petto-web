---
export const prerender = false;
import DashEmbeds from '../../../../components/DashEmbeds.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getVariableGroups } from '../../../../utils/variableRegistry';
import { getGuildInfo, getBotIdentity, getGuildList } from '../../../../utils/discord';

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;

if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const apiHeaders = {
  apikey: apiKey,
  Authorization: `Bearer ${apiKey}`,
  'Content-Type': 'application/json',
};

const [guildInfo, identity, templatesRes, channelsRes, variableGroups] = await Promise.all([
  getGuildInfo(id, botToken),
  // The same read the layout starts (shared per request and kept for a while): the bot's server nickname and avatar, or its own name and avatar.
  getBotIdentity(id, botToken, Astro.request).catch(() => null),
  fetch(`${apiUrl}/rest/v1/embed_templates?guild_id=eq.${id}&select=name&order=name.asc`, { headers: apiHeaders }),
  getGuildList(Astro, id, botToken, 'channels'),
  getVariableGroups(Astro),
]);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

const botName = identity?.name || 'Petto';
const botIcon = identity?.icon || '/assets/mascot-icon.webp';

const templateNames = templatesRes.ok ? (await templatesRes.json()).map((t: any) => t.name) : [];
// Text and announcement channels are the places a test message can go.
const rawChannels = channelsRes.ok ? await channelsRes.json() : [];
const channels = (Array.isArray(rawChannels) ? rawChannels : []).filter((c: any) => c.type === 0 || c.type === 5).map((c: any) => ({ id: c.id, name: c.name }));
const selected = new URL(Astro.request.url).searchParams.get('name') ?? templateNames[0] ?? '';
---
<DashEmbeds
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'}
  botName={botName}
  botIcon={botIcon}
  templateNames={templateNames}
  selected={selected}
  channels={channels}
  variableGroups={variableGroups}
/>
