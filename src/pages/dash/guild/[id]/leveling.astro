---
export const prerender = false;
import { ensureGuildRow } from '../../../../utils/ensureGuild';
import DashLeveling from '../../../../components/DashLeveling.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';
import { getMemberProfiles, memberAvatarUrl } from '../../../../utils/memberNames';

const { id } = Astro.params as { id: string };
const section = Astro.url.searchParams.get('section') ?? 'settings';
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;

if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');


const apiHeaders = {
  apikey: apiKey,
  Authorization: `Bearer ${apiKey}`,
  'Content-Type': 'application/json',
};

let saved = false;
let saveError = false;
let boardError = '';

const formNumber = (form: FormData, name: string, fallback: number) => {
  const raw = form.get(name);
  if (raw === null || String(raw).trim() === '') return fallback;
  const value = Number(raw);
  return Number.isFinite(value) ? value : fallback;
};

// "10: Level 10!" lines as the levels with a message of their own (up to 25, levels 1 to 10000).
const parseMilestones = (value: FormDataEntryValue | null) => {
  const seen = new Set<number>();
  const list: { level: number; message: string }[] = [];
  for (const line of String(value ?? '').split(/\r?\n/)) {
    const match = /^\s*(\d{1,5})\s*[:|-]\s*(.+?)\s*$/.exec(line);
    if (!match) continue;
    const level = Number(match[1]);
    if (level < 1 || level > 10000 || seen.has(level)) continue;
    seen.add(level);
    list.push({ level, message: match[2].slice(0, 1000) });
    if (list.length >= 25) break;
  }
  return list.sort((a, b) => a.level - b.level);
};
const ids = (values: FormDataEntryValue[]) => values.map(String).filter((value) => /^\d{15,25}$/.test(value)).slice(0, 100);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'config') {
    const ignoredChannelIds = form.getAll('ignored_channel_ids').map(String);
    const saveResponse = await fetch(`${apiUrl}/rest/v1/level_config?on_conflict=guild_id`, {
      method: 'POST',
      headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
      body: JSON.stringify({
        guild_id: id,
        enabled: form.get('enabled') === 'on',
        xp_min: Math.max(1, Math.min(1000, formNumber(form, 'xp_min', 15))),
        xp_max: Math.max(1, Math.min(1000, formNumber(form, 'xp_max', 25))),
        cooldown_seconds: Math.max(0, Math.min(600, formNumber(form, 'cooldown_seconds', 60))),
        xp_per_vc_minute: Math.max(0, Math.min(1000, formNumber(form, 'xp_per_vc_minute', 5))),
        role_mode: String(form.get('role_mode') ?? 'highest'),
        notify_mode: String(form.get('notify_mode') ?? 'reply'),
        notify_channel_id: String(form.get('notify_channel_id') ?? '').trim() || null,
        notify_message: String(form.get('notify_message') ?? '').replace(/\r\n/g, '\n').trim().slice(0, 200) || '{EMOJI} {user} just leveled up to **{level}**!',
        notify_embed: form.get('notify_embed') === 'on',
        notify_embed_template: String(form.get('notify_embed_template') ?? '').trim().toLowerCase().replace(/[^a-z0-9_-]/g, '_') || null,
        notify_every: Math.max(1, Math.min(50, formNumber(form, 'notify_every', 1))),
        ignored_channel_ids: ignoredChannelIds,
        ignored_category_ids: ids(form.getAll('ignored_category_ids')),
        notify_reply: form.get('notify_reply') === 'on',
        notify_ping: form.get('notify_ping') === 'on',
        notify_delete_after: Math.max(0, Math.min(86400, Math.floor(formNumber(form, 'notify_delete_after', 0)))),
        notify_milestones: parseMilestones(form.get('notify_milestones')),
        join_xp: Math.max(0, Math.min(1000000, formNumber(form, 'join_xp', 0))),
        join_level: Math.max(0, Math.min(1000, formNumber(form, 'join_level', 0))),
        curve_a: Math.max(0, formNumber(form, 'curve_a', 1)),
        curve_b: Math.max(0, formNumber(form, 'curve_b', 50)),
        curve_c: Math.max(0, formNumber(form, 'curve_c', 100)),
        difficulty: Math.max(0.1, formNumber(form, 'difficulty', 2.5)),
        rounding: Math.max(1, formNumber(form, 'rounding', 50)),
        max_level: Math.max(1, Math.min(10000, formNumber(form, 'max_level', 1000))),
        updated_at: new Date().toISOString(),
      }),
    });
    saved = saveResponse.ok;
    saveError = !saveResponse.ok;
  } else if (action === 'board_page') {
    // The public page of the leaderboard: on or off, its name in the address and the link to join the server.
    const slug = String(form.get('leaderboard_slug') ?? '').trim().toLowerCase().replace(/[\s_]+/g, '-').replace(/[^a-z0-9-]/g, '').replace(/^-+|-+$/g, '').slice(0, 32);
    const joinUrl = String(form.get('leaderboard_join_url') ?? '').trim().slice(0, 200);
    let joinOk = true;
    if (joinUrl) { try { joinOk = new URL(joinUrl).protocol === 'https:'; } catch { joinOk = false; } }
    if (slug && !/^[a-z0-9][a-z0-9-]{1,31}$/.test(slug)) {
      boardError = 'slug';
    } else if (!joinOk) {
      boardError = 'join';
    } else {
      const saveResponse = await fetch(`${apiUrl}/rest/v1/level_config?on_conflict=guild_id`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({ guild_id: id, leaderboard_public: form.get('leaderboard_public') === 'on', leaderboard_slug: slug || null, leaderboard_join_url: joinUrl || null, updated_at: new Date().toISOString() }),
      });
      saved = saveResponse.ok;
      if (!saveResponse.ok) boardError = saveResponse.status === 409 ? 'taken' : 'save';
    }
  } else if (action === 'voice_config') {
    const ignoredChannelIds = form.getAll('voice_ignored_channel_ids').map(String);
    const saveResponse = await fetch(`${apiUrl}/rest/v1/level_config?on_conflict=guild_id`, {
      method: 'POST',
      headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
      body: JSON.stringify({
        guild_id: id,
        voice_enabled: form.get('voice_enabled') === 'on',
        xp_per_vc_minute: Math.max(0, Math.min(1000, formNumber(form, 'voice_xp_per_minute', 5))),
        voice_curve_a: Math.max(0, formNumber(form, 'voice_curve_a', 1)),
        voice_curve_b: Math.max(0, formNumber(form, 'voice_curve_b', 50)),
        voice_curve_c: Math.max(0, formNumber(form, 'voice_curve_c', 100)),
        voice_difficulty: Math.max(0.1, formNumber(form, 'voice_difficulty', 2.5)),
        voice_rounding: Math.max(1, formNumber(form, 'voice_rounding', 50)),
        voice_max_level: Math.max(1, Math.min(10000, formNumber(form, 'voice_max_level', 1000))),
        voice_notify_mode: String(form.get('voice_notify_mode') ?? 'off'),
        voice_notify_channel_id: String(form.get('voice_notify_channel_id') ?? '').trim() || null,
        voice_notify_message: String(form.get('voice_notify_message') ?? '').replace(/\r\n/g, '\n').trim().slice(0, 200) || '{EMOJI} {user} reached voice level **{level}**!',
        voice_notify_embed: form.get('voice_notify_embed') === 'on',
        voice_notify_embed_template: String(form.get('voice_notify_embed_template') ?? '').trim().toLowerCase().replace(/[^a-z0-9_-]/g, '_') || null,
        voice_notify_every: Math.max(1, Math.min(50, formNumber(form, 'voice_notify_every', 1))),
        voice_role_mode: String(form.get('voice_role_mode') ?? 'highest'),
        voice_ignored_channel_ids: ignoredChannelIds,
        voice_ignored_category_ids: ids(form.getAll('voice_ignored_category_ids')),
        voice_notify_ping: form.get('voice_notify_ping') === 'on',
        voice_notify_delete_after: Math.max(0, Math.min(86400, Math.floor(formNumber(form, 'voice_notify_delete_after', 0)))),
        voice_notify_milestones: parseMilestones(form.get('voice_notify_milestones')),
        updated_at: new Date().toISOString(),
      }),
    });
    saved = saveResponse.ok;
    saveError = !saveResponse.ok;
  } else if (action === 'rank') {
    const cardName = (value: FormDataEntryValue | null) => String(value ?? '').trim().toLowerCase().replace(/[^a-z0-9_-]/g, '_').slice(0, 40) || null;
    const style = String(form.get('rank_style') ?? 'card');
    const saveResponse = await fetch(`${apiUrl}/rest/v1/level_config?on_conflict=guild_id`, {
      method: 'POST',
      headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
      body: JSON.stringify({
        guild_id: id,
        rank_style: ['card', 'embed', 'both'].includes(style) ? style : 'card',
        rank_card: cardName(form.get('rank_card')),
        notify_card: cardName(form.get('notify_card')),
        voice_notify_card: cardName(form.get('voice_notify_card')),
        updated_at: new Date().toISOString(),
      }),
    });
    saved = saveResponse.ok;
    saveError = !saveResponse.ok;
  } else if (action === 'rules') {
    const saveResponse = await fetch(`${apiUrl}/rest/v1/level_config?on_conflict=guild_id`, {
      method: 'POST',
      headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
      body: JSON.stringify({
        guild_id: id,
        min_message_chars: Math.max(0, Math.min(200, Math.floor(formNumber(form, 'min_message_chars', 3)))),
        anti_repeat: form.get('anti_repeat') === 'on',
        voice_min_members: Math.max(1, Math.min(20, Math.floor(formNumber(form, 'voice_min_members', 1)))),
        voice_ignore_muted: form.get('voice_ignore_muted') === 'on',
        daily_bonus_xp: Math.max(0, Math.min(100000, Math.floor(formNumber(form, 'daily_bonus_xp', 0)))),
        streak_bonus_xp: Math.max(0, Math.min(10000, Math.floor(formNumber(form, 'streak_bonus_xp', 0)))),
        streak_max_days: Math.max(1, Math.min(365, Math.floor(formNumber(form, 'streak_max_days', 7)))),
        xp_multiplier: Math.max(0, Math.min(20, Math.round(formNumber(form, 'xp_multiplier', 1) * 100) / 100)),
        multiplier_mode: ['highest', 'stack', 'sum'].includes(String(form.get('multiplier_mode'))) ? String(form.get('multiplier_mode')) : 'highest',
        multiplier_cap: Math.max(1, Math.min(100, Math.round(formNumber(form, 'multiplier_cap', 20) * 100) / 100)),
        reset_on_leave: form.get('reset_on_leave') === 'on',
        restore_roles: form.get('restore_roles') === 'on',
        no_xp_role_ids: ids(form.getAll('no_xp_role_ids')),
        only_xp_role_ids: ids(form.getAll('only_xp_role_ids')),
        updated_at: new Date().toISOString(),
      }),
    });
    saved = saveResponse.ok;
    saveError = !saveResponse.ok;
    // The XP events staged on the page are applied with the same Save.
    if (saved) {
      let staged: any = {};
      try { staged = JSON.parse(String(form.get('events_payload') ?? '{}')); } catch { staged = {}; }
      const removeIds = (Array.isArray(staged.remove) ? staged.remove : []).map(String).filter((value: string) => /^\d{1,18}$/.test(value)).slice(0, 25);
      for (const eventId of removeIds) {
        const res = await fetch(`${apiUrl}/rest/v1/xp_events?guild_id=eq.${id}&id=eq.${eventId}`, { method: 'DELETE', headers: apiHeaders });
        if (!res.ok) saveError = true;
      }
      const toAdd = (Array.isArray(staged.add) ? staged.add : []).slice(0, 25);
      if (toAdd.length) {
        const activeRes = await fetch(`${apiUrl}/rest/v1/xp_events?guild_id=eq.${id}&ends_at=gt.${encodeURIComponent(new Date().toISOString())}&select=id`, { headers: apiHeaders });
        const room = Math.max(0, 25 - (activeRes.ok ? (await activeRes.json()).length : 25));
        const rows = [];
        for (const entry of toAdd.slice(0, room)) {
          const name = String(entry?.name ?? '').trim().slice(0, 60);
          const multiplier = Math.round(Number(entry?.multiplier) * 100) / 100;
          const source = String(entry?.source ?? 'all');
          const startInHours = Math.max(0, Math.min(24 * 30, Number(entry?.startIn) || 0));
          const durationHours = Math.max(0, Math.min(24 * 60, Number(entry?.duration) || 0));
          if (!name || !(multiplier > 1 && multiplier <= 20) || !['all', 'text', 'voice'].includes(source) || durationHours < 1 / 60) { saveError = true; continue; }
          const startsAt = new Date(Date.now() + startInHours * 3_600_000);
          rows.push({ guild_id: id, name, multiplier, source, starts_at: startsAt.toISOString(), ends_at: new Date(startsAt.getTime() + durationHours * 3_600_000).toISOString(), created_by: String(session.userId) });
        }
        if (toAdd.length > room) saveError = true;
        if (rows.length) {
          await ensureGuildRow(apiUrl, apiHeaders, id);
          const res = await fetch(`${apiUrl}/rest/v1/xp_events`, { method: 'POST', headers: { ...apiHeaders, Prefer: 'return=minimal' }, body: JSON.stringify(rows) });
          if (!res.ok) saveError = true;
        }
      }
      saved = !saveError;
    }
  } else if (action === 'save_rewards') {
    // The whole list as it stands on the page: what is missing is removed, the rest is saved.
    // A form sent without its list (the page's script did not start) must not empty what is saved: it is an error, not an empty list.
    const payloadRaw = form.get('payload');
    let list: any[] = [];
    try { list = JSON.parse(String(payloadRaw ?? '[]')); } catch { list = []; }
    const wanted = new Map<string, { guild_id: string; source: string; level: number; role_id: string }>();
    for (const entry of (Array.isArray(list) ? list : []).slice(0, 400)) {
      const level = Math.floor(Number(entry?.level));
      const source = entry?.source === 'voice' ? 'voice' : 'text';
      const roleId = String(entry?.role_id ?? '');
      if (level >= 1 && level <= 1000 && /^\d{15,25}$/.test(roleId)) wanted.set(`${source}:${level}`, { guild_id: id, source, level, role_id: roleId });
    }
    const currentRes = await fetch(`${apiUrl}/rest/v1/level_rewards?guild_id=eq.${id}&select=source,level`, { headers: apiHeaders });
    if (payloadRaw === null || !currentRes.ok) {
      saveError = true;
    } else {
      let failed = false;
      for (const row of await currentRes.json()) {
        if (wanted.has(`${row.source}:${row.level}`)) continue;
        const res = await fetch(`${apiUrl}/rest/v1/level_rewards?guild_id=eq.${id}&source=eq.${row.source}&level=eq.${row.level}`, { method: 'DELETE', headers: apiHeaders });
        if (!res.ok) failed = true;
      }
      if (wanted.size) {
        await ensureGuildRow(apiUrl, apiHeaders, id);
        const res = await fetch(`${apiUrl}/rest/v1/level_rewards?on_conflict=guild_id,source,level`, { method: 'POST', headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify([...wanted.values()]) });
        if (!res.ok) failed = true;
      }
      saved = !failed;
      saveError = failed;
    }
  } else if (action === 'save_multipliers') {
    const payloadRaw = form.get('payload');
    let list: any[] = [];
    try { list = JSON.parse(String(payloadRaw ?? '[]')); } catch { list = []; }
    const wanted = new Map<string, { guild_id: string; target_id: string; target_type: string; multiplier: number }>();
    for (const entry of (Array.isArray(list) ? list : []).slice(0, 300)) {
      const targetId = String(entry?.target_id ?? '');
      const targetType = String(entry?.target_type ?? '');
      const multiplier = Math.round(Number(entry?.multiplier) * 100) / 100;
      if (['role', 'channel', 'category'].includes(targetType) && /^\d{15,25}$/.test(targetId) && multiplier >= 0 && multiplier <= 20) wanted.set(targetId, { guild_id: id, target_id: targetId, target_type: targetType, multiplier });
    }
    if (payloadRaw === null || wanted.size > 100) {
      saveError = true;
    } else {
      const currentRes = await fetch(`${apiUrl}/rest/v1/level_multipliers?guild_id=eq.${id}&select=target_id`, { headers: apiHeaders });
      if (!currentRes.ok) {
        saveError = true;
      } else {
        let failed = false;
        for (const row of await currentRes.json()) {
          if (wanted.has(row.target_id)) continue;
          const res = await fetch(`${apiUrl}/rest/v1/level_multipliers?guild_id=eq.${id}&target_id=eq.${row.target_id}`, { method: 'DELETE', headers: apiHeaders });
          if (!res.ok) failed = true;
        }
        if (wanted.size) {
          await ensureGuildRow(apiUrl, apiHeaders, id);
          const res = await fetch(`${apiUrl}/rest/v1/level_multipliers?on_conflict=guild_id,target_id`, { method: 'POST', headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify([...wanted.values()]) });
          if (!res.ok) failed = true;
        }
        saved = !failed;
        saveError = failed;
      }
    }
  } else if (action === 'add_event') {
    const name = String(form.get('event_name') ?? '').trim().slice(0, 60);
    const multiplier = Math.round(formNumber(form, 'event_multiplier', 2) * 100) / 100;
    const source = String(form.get('event_source') ?? 'all');
    const startInHours = Math.max(0, Math.min(24 * 30, formNumber(form, 'event_start_in', 0)));
    const durationHours = Math.max(0, Math.min(24 * 60, formNumber(form, 'event_duration', 0)));
    if (!name || !(multiplier > 1 && multiplier <= 20) || !['all', 'text', 'voice'].includes(source) || durationHours < 1 / 60) {
      saveError = true;
    } else {
      const startsAt = new Date(Date.now() + startInHours * 3_600_000);
      const endsAt = new Date(startsAt.getTime() + durationHours * 3_600_000);
      const activeRes = await fetch(`${apiUrl}/rest/v1/xp_events?guild_id=eq.${id}&ends_at=gt.${encodeURIComponent(new Date().toISOString())}&select=id`, { headers: apiHeaders });
      const active = activeRes.ok ? await activeRes.json() : [];
      if (active.length >= 25) {
        saveError = true;
      } else {
        // The server keeps a row for the guild before any child table can point at it.
        await ensureGuildRow(apiUrl, apiHeaders, id);
        const saveResponse = await fetch(`${apiUrl}/rest/v1/xp_events`, {
          method: 'POST',
          headers: { ...apiHeaders, Prefer: 'return=minimal' },
          body: JSON.stringify({ guild_id: id, name, multiplier, source, starts_at: startsAt.toISOString(), ends_at: endsAt.toISOString(), created_by: String(session.userId) }),
        });
        saved = saveResponse.ok;
        saveError = !saveResponse.ok;
      }
    }
  } else if (action === 'delete_event') {
    const eventId = String(form.get('event_id') ?? '');
    if (/^\d{1,18}$/.test(eventId)) {
      const saveResponse = await fetch(`${apiUrl}/rest/v1/xp_events?guild_id=eq.${id}&id=eq.${eventId}`, { method: 'DELETE', headers: apiHeaders });
      saved = saveResponse.ok;
      saveError = !saveResponse.ok;
    }
  } else if (action === 'add_reward') {
    const level = Number(form.get('level') ?? 0);
    const roleId = String(form.get('role_id') ?? '');
    const source = String(form.get('source') ?? 'text') === 'voice' ? 'voice' : 'text';
    if (level > 0 && roleId) {
      const saveResponse = await fetch(`${apiUrl}/rest/v1/level_rewards?on_conflict=guild_id,source,level`, {
        method: 'POST',
        headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
        body: JSON.stringify({ guild_id: id, source, level, role_id: roleId }),
      });
      saved = saveResponse.ok;
      saveError = !saveResponse.ok;
    }
  } else if (action === 'delete_reward') {
    const level = Number(form.get('level') ?? 0);
    const source = String(form.get('source') ?? 'text') === 'voice' ? 'voice' : 'text';
    const saveResponse = await fetch(`${apiUrl}/rest/v1/level_rewards?guild_id=eq.${id}&source=eq.${source}&level=eq.${level}`, {
      method: 'DELETE',
      headers: apiHeaders,
    });
    saved = saveResponse.ok;
    saveError = !saveResponse.ok;
  } else if (action === 'add_multiplier') {
    const targetType = String(form.get('target_type') ?? '');
    const targetId = String(form.get(`target_${targetType}`) ?? '');
    const multiplier = Math.round(formNumber(form, 'multiplier', 2) * 100) / 100;
    if (['role', 'channel', 'category'].includes(targetType) && /^\d{15,25}$/.test(targetId) && multiplier >= 0 && multiplier <= 20) {
      const countRes = await fetch(`${apiUrl}/rest/v1/level_multipliers?guild_id=eq.${id}&select=target_id`, { headers: apiHeaders });
      const existing = countRes.ok ? await countRes.json() : [];
      if (existing.length >= 100 && !existing.some((row: any) => row.target_id === targetId)) {
        saveError = true;
      } else {
        // The server keeps a row for the guild before any child table can point at it.
        await ensureGuildRow(apiUrl, apiHeaders, id);
        const saveResponse = await fetch(`${apiUrl}/rest/v1/level_multipliers?on_conflict=guild_id,target_id`, {
          method: 'POST',
          headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' },
          body: JSON.stringify({ guild_id: id, target_id: targetId, target_type: targetType, multiplier }),
        });
        saved = saveResponse.ok;
        saveError = !saveResponse.ok;
      }
    } else {
      saveError = true;
    }
  } else if (action === 'delete_multiplier') {
    const targetId = String(form.get('target_id') ?? '');
    if (/^\d{15,25}$/.test(targetId)) {
      const saveResponse = await fetch(`${apiUrl}/rest/v1/level_multipliers?guild_id=eq.${id}&target_id=eq.${targetId}`, { method: 'DELETE', headers: apiHeaders });
      saved = saveResponse.ok;
      saveError = !saveResponse.ok;
    }
  }
}

// Only the section on screen is drawn, so only what it shows is read (the settings row is small and every section uses it).
const LEVELING_SECTIONS = ['settings', 'voice', 'rank', 'rules', 'multipliers', 'rewards', 'leaderboard', 'leaderboard-voice'];
const shown = LEVELING_SECTIONS.includes(section) ? section : 'settings';
const needs = (...sections: string[]) => sections.includes(shown);
const [guildInfo, configRes, rewardsRes, leaderboardRes, voiceLeaderboardRes, rolesRes, channelsRes, embedTemplatesRes, cardsRes, eventsRes, multipliersRes] = await Promise.all([
  getGuildInfo(id, botToken),
  fetch(`${apiUrl}/rest/v1/level_config?guild_id=eq.${id}&select=*`, { headers: apiHeaders }),
  needs('rewards') ? fetch(`${apiUrl}/rest/v1/level_rewards?guild_id=eq.${id}&select=source,level,role_id&order=level.asc`, { headers: apiHeaders }) : null,
  needs('leaderboard') ? fetch(`${apiUrl}/rest/v1/level_users?guild_id=eq.${id}&select=user_id,xp,level&order=xp.desc&limit=10`, { headers: apiHeaders }) : null,
  needs('leaderboard-voice') ? fetch(`${apiUrl}/rest/v1/level_users?guild_id=eq.${id}&voice_xp=gt.0&select=user_id,voice_xp,voice_level,vc_minutes&order=voice_xp.desc&limit=10`, { headers: apiHeaders }) : null,
  needs('rewards', 'rules', 'multipliers') ? getGuildList(Astro, id, botToken, 'roles') : null,
  needs('settings', 'voice', 'multipliers') ? getGuildList(Astro, id, botToken, 'channels') : null,
  needs('settings', 'voice') ? fetch(`${apiUrl}/rest/v1/embed_templates?guild_id=eq.${id}&select=name&order=name.asc`, { headers: apiHeaders }) : null,
  needs('rank') ? fetch(`${apiUrl}/rest/v1/image_cards?guild_id=eq.${id}&select=name,data&order=name.asc`, { headers: apiHeaders }).catch(() => null) : null,
  needs('rules') ? fetch(`${apiUrl}/rest/v1/xp_events?guild_id=eq.${id}&ends_at=gt.${encodeURIComponent(new Date().toISOString())}&select=id,name,multiplier,source,starts_at,ends_at&order=starts_at.asc`, { headers: apiHeaders }).catch(() => null) : null,
  needs('multipliers') ? fetch(`${apiUrl}/rest/v1/level_multipliers?guild_id=eq.${id}&select=target_id,target_type,multiplier&order=target_type.asc`, { headers: apiHeaders }).catch(() => null) : null,
]);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

const milestonesText = (value: unknown) => (Array.isArray(value) ? value : []).map((entry: any) => `${Number(entry.level)}: ${String(entry.message ?? '')}`).join('\n');
const configRows = configRes.ok ? await configRes.json() : [];
const c = configRows[0] ?? {};
const config = {
  enabled: c.enabled ?? false,
  xpMin: c.xp_min ?? 15,
  xpMax: c.xp_max ?? 25,
  xpPerVcMinute: c.xp_per_vc_minute ?? 5,
  cooldownSeconds: c.cooldown_seconds ?? 60,
  notifyMode: c.notify_mode ?? 'reply',
  notifyChannelId: c.notify_channel_id ?? null,
  notifyMessage: c.notify_message ?? '{EMOJI} {user} just leveled up to **{level}**!',
  notifyEmbed: c.notify_embed ?? false,
  notifyEmbedTemplate: c.notify_embed_template ?? '',
  notifyEvery: c.notify_every ?? 1,
  roleMode: c.role_mode ?? 'highest',
  ignoredChannelIds: c.ignored_channel_ids ?? [],
  ignoredCategoryIds: c.ignored_category_ids ?? [],
  notifyReply: c.notify_reply ?? true,
  notifyPing: c.notify_ping ?? true,
  notifyDeleteAfter: c.notify_delete_after ?? 0,
  notifyMilestones: milestonesText(c.notify_milestones),
  joinXp: c.join_xp ?? 0,
  joinLevel: c.join_level ?? 0,
  curveA: c.curve_a ?? 1,
  curveB: c.curve_b ?? 50,
  curveC: c.curve_c ?? 100,
  difficulty: c.difficulty ?? 2.5,
  rounding: c.rounding ?? 50,
  maxLevel: c.max_level ?? 1000,
};
const publicBoard = { enabled: c.leaderboard_public ?? false, slug: c.leaderboard_slug ?? '', joinUrl: c.leaderboard_join_url ?? '' };
const voiceConfig = {
  enabled: c.voice_enabled ?? config.enabled,
  xpPerMinute: c.xp_per_vc_minute ?? 5,
  curveA: c.voice_curve_a ?? 1,
  curveB: c.voice_curve_b ?? 50,
  curveC: c.voice_curve_c ?? 100,
  difficulty: c.voice_difficulty ?? 2.5,
  rounding: c.voice_rounding ?? 50,
  maxLevel: c.voice_max_level ?? 1000,
  notifyMode: c.voice_notify_mode ?? 'off',
  notifyChannelId: c.voice_notify_channel_id ?? null,
  notifyMessage: c.voice_notify_message ?? '{EMOJI} {user} reached voice level **{level}**!',
  notifyEmbed: c.voice_notify_embed ?? false,
  notifyEmbedTemplate: c.voice_notify_embed_template ?? '',
  notifyEvery: c.voice_notify_every ?? 1,
  roleMode: c.voice_role_mode ?? config.roleMode,
  ignoredChannelIds: c.voice_ignored_channel_ids ?? [],
  ignoredCategoryIds: c.voice_ignored_category_ids ?? [],
  notifyPing: c.voice_notify_ping ?? true,
  notifyDeleteAfter: c.voice_notify_delete_after ?? 0,
  notifyMilestones: milestonesText(c.voice_notify_milestones),
};

// Rank and rules settings, read with defaults so a database without the new columns still shows the page.
const rank = {
  style: c.rank_style ?? 'card',
  card: c.rank_card ?? '',
  notifyCard: c.notify_card ?? '',
  voiceNotifyCard: c.voice_notify_card ?? '',
};
const rules = {
  minMessageChars: c.min_message_chars ?? 3,
  antiRepeat: c.anti_repeat ?? true,
  voiceMinMembers: c.voice_min_members ?? 1,
  voiceIgnoreMuted: c.voice_ignore_muted ?? false,
  dailyBonusXp: c.daily_bonus_xp ?? 0,
  streakBonusXp: c.streak_bonus_xp ?? 0,
  streakMaxDays: c.streak_max_days ?? 7,
  xpMultiplier: Number(c.xp_multiplier ?? 1),
  multiplierMode: c.multiplier_mode ?? 'highest',
  multiplierCap: Number(c.multiplier_cap ?? 20),
  resetOnLeave: c.reset_on_leave ?? false,
  restoreRoles: c.restore_roles ?? true,
  noXpRoleIds: c.no_xp_role_ids ?? [],
  onlyXpRoleIds: c.only_xp_role_ids ?? [],
};
const rawCards = cardsRes?.ok ? await cardsRes.json() : [];
const cards = (Array.isArray(rawCards) ? rawCards : []).map((card: any) => ({ name: String(card.name), kind: card.data?.kind === 'rank' ? 'rank' : 'welcome', data: card.data }));
const rawEvents = eventsRes?.ok ? await eventsRes.json() : [];
const events = (Array.isArray(rawEvents) ? rawEvents : []).map((event: any) => ({ id: String(event.id), name: String(event.name), multiplier: Number(event.multiplier), source: String(event.source), startsAt: String(event.starts_at), endsAt: String(event.ends_at) }));

const rawRewards = rewardsRes?.ok ? await rewardsRes.json() : [];
const rewards = rawRewards.map((r: any) => ({ level: r.level, roleId: r.role_id, source: r.source === 'voice' ? 'voice' : 'text' }));
const rawMultipliers = multipliersRes?.ok ? await multipliersRes.json() : [];
const multipliers = (Array.isArray(rawMultipliers) ? rawMultipliers : []).map((row: any) => ({ targetId: String(row.target_id), type: String(row.target_type), multiplier: Number(row.multiplier) }));

// Only the leaderboard on screen is read, and the names of its members come in one call to the bot (kept for a while), not one
// Discord call per member.
const rawLeaderboard = leaderboardRes?.ok ? await leaderboardRes.json() : [];
const rawVoiceLeaderboard = voiceLeaderboardRes?.ok ? await voiceLeaderboardRes.json() : [];
const profiles = await getMemberProfiles(Astro, id, [...rawLeaderboard, ...rawVoiceLeaderboard].map((row: any) => String(row.user_id ?? '')), botToken, { userId: session.userId });
const leaderboardMember = (row: any) => {
  const userId = String(row.user_id ?? '');
  const profile = profiles.get(userId) ?? null;
  const username = profile?.username ?? '';
  return { userId, username, displayName: profile?.displayName || profile?.globalName || username || `Member ${userId.slice(-4)}`, avatarUrl: memberAvatarUrl(userId, profile) };
};
const leaderboard = rawLeaderboard.map((row: any, i: number) => ({ rank: i + 1, ...leaderboardMember(row), xp: Number(row.xp ?? 0), level: Number(row.level ?? 0) }));
const voiceLeaderboard = rawVoiceLeaderboard.map((row: any, i: number) => ({ rank: i + 1, ...leaderboardMember(row), xp: Number(row.voice_xp ?? 0), level: Number(row.voice_level ?? 0), voiceMinutes: Number(row.vc_minutes ?? 0) }));

const allRoles = rolesRes?.ok ? await rolesRes.json() : [];
const roles = allRoles
  .filter((r: any) => r.name !== '@everyone')
  .sort((a: any, b: any) => b.position - a.position)
  .map((r: any) => ({ id: r.id, name: r.name }));

const allChannels = channelsRes?.ok ? await channelsRes.json() : [];
const channels = allChannels
  .filter((c: any) => c.type === 0 || c.type === 5)
  .sort((a: any, b: any) => a.position - b.position)
  .map((c: any) => ({ id: c.id, name: c.name }));
const categories = allChannels
  .filter((c: any) => c.type === 4)
  .sort((a: any, b: any) => a.position - b.position)
  .map((c: any) => ({ id: c.id, name: c.name }));
const voiceChannels = allChannels
  .filter((c: any) => c.type === 2 || c.type === 13)
  .sort((a: any, b: any) => a.position - b.position)
  .map((c: any) => ({ id: c.id, name: c.name }));

const embedTemplates = embedTemplatesRes?.ok ? await embedTemplatesRes.json() : [];
const embedTemplateNames = embedTemplates.map((template: any) => template.name).filter(Boolean);
---
<DashLeveling
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'}
  config={config}
  rewards={rewards}
  multipliers={multipliers}
  categories={categories}
  roles={roles}
  channels={channels}
  voiceChannels={voiceChannels}
  leaderboard={leaderboard}
  voiceConfig={voiceConfig}
  voiceLeaderboard={voiceLeaderboard}
  embedTemplateNames={embedTemplateNames}
  rank={rank}
  rules={rules}
  cards={cards}
  events={events}
  saved={saved}
  saveError={saveError}
  publicBoard={publicBoard}
  boardError={boardError}
  section={section}
/>
