---
export const prerender = false;
import DashCounters from '../../../../components/DashCounters.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';
import { ensureGuildRow } from '../../../../utils/ensureGuild';
import { readGuildSnapshot } from '../../../../utils/guildSnapshots';
import { callPettoCounters } from '../../../../utils/pettoBotApi';
import { forgetCalls, markPending, sharedCall, withinBudget } from '../../../../utils/liveCall';
import { COUNTER_FORMATS, COUNTER_TYPES, ROLE_TYPES, validTimeZone } from '../../../../utils/counters';
import { makeT, getDashLang } from '../../../../i18n/dash';

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;
if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const apiHeaders = { apikey: apiKey, Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' };
const SNOWFLAKE = /^\d{15,25}$/;
const text = (value: FormDataEntryValue | null, max: number) => String(value ?? '').replace(/\u0000/g, '').replace(/\r\n/g, '\n').trim().slice(0, max);
const snowflake = (value: FormDataEntryValue | null) => (SNOWFLAKE.test(String(value ?? '')) ? String(value) : null);

let message: { kind: 'ok' | 'err'; text: string } | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  // Drag to reorder and editing a name in place answer in JSON, without reloading the page.
  if (action === 'reorder' || action === 'template') {
    const json = (body: Record<string, unknown>, status = 200) => new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' } });
    if (action === 'reorder') {
      let order: string[] = [];
      try { order = (JSON.parse(String(form.get('order') ?? '[]')) as unknown[]).map(String).filter((v) => SNOWFLAKE.test(v)).slice(0, 100); } catch { order = []; }
      if (!order.length) return json({ ok: false, message: dt('Nothing to reorder.') }, 400);
      const result = await callPettoCounters(Astro, id, session.userId, 'reorder', { channel_ids: order }, dashLang);
      forgetCalls(`counters:${id}:`);
      return json({ ok: result.ok, message: result.message || dt('Petto did not answer. Try again in a moment.') }, result.ok ? 200 : 502);
    }
    const channelId = snowflake(form.get('channel_id'));
    const template = text(form.get('template'), form.get('target') === 'topic' ? 500 : 100);
    if (!channelId || !template) return json({ ok: false, message: dt('Write a name.') }, 400);
    const res = await fetch(`${apiUrl}/rest/v1/server_counters?guild_id=eq.${id}&channel_id=eq.${channelId}`, { method: 'PATCH', headers: { ...apiHeaders, Prefer: 'return=minimal' }, body: JSON.stringify({ name_template: template }) }).catch(() => null);
    if (!res?.ok) return json({ ok: false, message: dt('It could not be saved, try again.') }, 502);
    await callPettoCounters(Astro, id, session.userId, 'refresh', { channel_id: channelId }, dashLang);
    forgetCalls(`counters:${id}:`);
    return json({ ok: true, message: dt('Counter saved. Its name changes as soon as Discord allows.') });
  }
  await ensureGuildRow(apiUrl, apiHeaders, id);
  const botFailed = () => dt('Petto did not answer. Try again in a moment.');
  const goalOf = (value: FormDataEntryValue | null) => { const n = Math.trunc(Number(String(value ?? '').replace(/[.,\s]/g, ''))); return Number.isFinite(n) && n > 0 ? Math.min(2_000_000_000, n) : null; };

  if (action === 'create') {
    const type = String(form.get('type') ?? '');
    const zone = text(form.get('timezone'), 64);
    if (!(COUNTER_TYPES as readonly string[]).includes(type)) message = { kind: 'err', text: dt('Pick what the counter shows.') };
    else if (ROLE_TYPES.includes(type) && !snowflake(form.get('role_id'))) message = { kind: 'err', text: dt('Pick the role to count.') };
    else if (zone && !validTimeZone(zone)) message = { kind: 'err', text: dt('That time zone is not known. Use a name like Europe/Madrid.') };
    else {
      const result = await callPettoCounters(Astro, id, session.userId, 'create', {
        type, template: text(form.get('template'), String(form.get('kind')) === 'topic' || form.get('target') === 'topic' ? 500 : 100), format: String(form.get('format') ?? 'plain'),
        kind: form.get('use') === 'existing' ? null : String(form.get('kind') ?? 'voice'), target: form.get('use') === 'existing' && form.get('target') === 'topic' ? 'topic' : 'name',
        category_id: snowflake(form.get('category_id')), channel_id: form.get('use') === 'existing' ? snowflake(form.get('channel_id')) : null,
        role_id: snowflake(form.get('role_id')), goal: goalOf(form.get('goal')), timezone: zone || null,
      }, dashLang);
      message = result.ok ? { kind: 'ok', text: result.message || dt('Counter created.') } : { kind: 'err', text: result.message || botFailed() };
    }
  } else if (action === 'setup') {
    const preset = String(form.get('preset') ?? '');
    const result = await callPettoCounters(Astro, id, session.userId, 'setup', ['basic', 'boosts', 'online', 'goal', 'clock'].includes(preset) ? { preset } : {}, dashLang);
    message = result.ok ? { kind: 'ok', text: result.message || dt('Server stats are ready.') } : { kind: 'err', text: result.message || botFailed() };
  } else if (action === 'refresh') {
    const result = await callPettoCounters(Astro, id, session.userId, 'refresh', { channel_id: snowflake(form.get('channel_id')) }, dashLang);
    message = result.ok ? { kind: 'ok', text: result.message } : { kind: 'err', text: result.message || botFailed() };
  } else if (action === 'delete') {
    const channelId = snowflake(form.get('channel_id'));
    const result = channelId ? await callPettoCounters(Astro, id, session.userId, 'delete', { channel_id: channelId, delete_channel: form.get('delete_channel') === 'on' }, dashLang) : { ok: false, message: '' };
    if (!result.ok && channelId && !result.message) {
      // The bot is away: the counter is still stopped, the channel stays.
      const res = await fetch(`${apiUrl}/rest/v1/server_counters?guild_id=eq.${id}&channel_id=eq.${channelId}`, { method: 'DELETE', headers: apiHeaders });
      message = res.ok ? { kind: 'ok', text: dt('Counter stopped. The channel was kept.') } : { kind: 'err', text: dt('It could not be saved, try again.') };
    } else message = result.ok ? { kind: 'ok', text: result.message } : { kind: 'err', text: result.message || botFailed() };
  } else if (action === 'announce' || action === 'announce_test') {
    const every = text(form.get('every'), 12).replace(/[.,\s]/g, '');
    const body = {
      enabled: form.get('enabled') === 'on', channel_id: snowflake(form.get('channel_id')), message: text(form.get('message'), 2000),
      embed_name: text(form.get('embed_name'), 100) || null, every: every || null, use_goals: form.get('use_goals') === 'on',
    };
    if (body.enabled && !body.channel_id) message = { kind: 'err', text: dt('Pick the channel for the announcements.') };
    else if (every && !(Number(every) >= 1 && Number(every) <= 100_000_000 && Number.isInteger(Number(every)))) message = { kind: 'err', text: dt('Every N members takes a whole number, like 100.') };
    else {
      const saved = await callPettoCounters(Astro, id, session.userId, 'announce', body, dashLang);
      if (!saved.ok && !saved.message) {
        // The bot is away: the settings are saved here and it reads them on its next look (starting from the members of then).
        const res = await fetch(`${apiUrl}/rest/v1/counter_announce_config?on_conflict=guild_id`, { method: 'POST', headers: { ...apiHeaders, Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify({ guild_id: id, ...body, every: body.every ? Number(body.every) : null, last_announced: null, updated_at: new Date().toISOString() }) });
        message = res.ok ? { kind: 'ok', text: dt('Announcements saved.') } : { kind: 'err', text: dt('It could not be saved, try again.') };
      } else if (saved.ok && action === 'announce_test') {
        const test = await callPettoCounters(Astro, id, session.userId, 'announce', { test: true }, dashLang);
        message = { kind: test.ok ? 'ok' : 'err', text: test.message || botFailed() };
      } else message = saved.ok ? { kind: 'ok', text: saved.message || dt('Announcements saved.') } : { kind: 'err', text: saved.message };
    }
  } else if (action === 'save') {
    const channelId = snowflake(form.get('channel_id'));
    const type = String(form.get('type') ?? '');
    const zone = text(form.get('timezone'), 64);
    const format = String(form.get('format') ?? 'plain');
    const parentId = snowflake(form.get('category_id'));
    if (!channelId || !(COUNTER_TYPES as readonly string[]).includes(type)) message = { kind: 'err', text: dt('Pick what the counter shows.') };
    else if (ROLE_TYPES.includes(type) && !snowflake(form.get('role_id'))) message = { kind: 'err', text: dt('Pick the role to count.') };
    else if (zone && !validTimeZone(zone)) message = { kind: 'err', text: dt('That time zone is not known. Use a name like Europe/Madrid.') };
    else {
      const enabled = form.get('enabled') === 'on';
      const target = form.get('target') === 'topic' ? 'topic' : 'name';
      const patch: Record<string, unknown> = {
        counter_option: type, name_template: text(form.get('template'), target === 'topic' ? 500 : 100) || '{count}', ...(form.has('target') ? { target } : {}),
        number_format: (COUNTER_FORMATS as readonly string[]).includes(format) ? format : 'plain',
        target_id: ROLE_TYPES.includes(type) ? snowflake(form.get('role_id')) : null, goal: goalOf(form.get('goal')), timezone: zone || null,
        parent_id: parentId, enabled, ...(enabled ? { problem: null, problem_at: null } : {}),
      };
      const res = await fetch(`${apiUrl}/rest/v1/server_counters?guild_id=eq.${id}&channel_id=eq.${channelId}`, { method: 'PATCH', headers: { ...apiHeaders, Prefer: 'return=minimal' }, body: JSON.stringify(patch) });
      if (res.ok && form.get('category_changed') === '1') {
        await fetch(`https://discord.com/api/v10/channels/${channelId}`, { method: 'PATCH', headers: { Authorization: `Bot ${botToken}`, 'Content-Type': 'application/json' }, body: JSON.stringify({ parent_id: parentId }) }).catch(() => null);
      }
      if (res.ok) await callPettoCounters(Astro, id, session.userId, 'refresh', { channel_id: channelId }, dashLang);
      message = res.ok ? { kind: 'ok', text: dt('Counter saved. Its name changes as soon as Discord allows.') } : { kind: 'err', text: dt('It could not be saved, try again.') };
    }
  }
}

// The live numbers, the names the channels have now and when they change next come from the bot, which can take a second or more. The
// page is drawn from the database at once and waits for them only a moment; when they are late it fills them in right after it is on
// screen (see liveCall.ts). A change made here forgets the numbers kept, and its answer (which carries the message of the change, that a
// read of the page again would lose) waits for them as before.
const LIVE_BUDGET_MS = Astro.request.method === 'POST' ? 25_000 : 300;
if (Astro.request.method === 'POST') forgetCalls(`counters:${id}:`);
const previewCall = sharedCall(`counters:${id}:${session.userId}:${dashLang}`, () => callPettoCounters(Astro, id, session.userId, 'preview', {}, dashLang), (result) => (result.ok ? 15_000 : 3_000));
const [guildInfo, rowsRes, channelsRes, rolesRes, previewReady, embedsRes, announceRes, daysRes, snapshot] = await Promise.all([
  getGuildInfo(id, botToken),
  fetch(`${apiUrl}/rest/v1/server_counters?guild_id=eq.${id}&select=*&order=id.asc`, { headers: apiHeaders }).catch(() => null),
  getGuildList(Astro, id, botToken, 'channels'),
  getGuildList(Astro, id, botToken, 'roles'),
  withinBudget(previewCall, LIVE_BUDGET_MS),
  fetch(`${apiUrl}/rest/v1/embed_templates?guild_id=eq.${id}&select=name&order=name.asc`, { headers: apiHeaders }).catch(() => null),
  fetch(`${apiUrl}/rest/v1/counter_announce_config?guild_id=eq.${id}&select=*`, { headers: apiHeaders }).catch(() => null),
  fetch(`${apiUrl}/rest/v1/guild_member_days?guild_id=eq.${id}&select=day,members&order=day.desc&limit=30`, { headers: apiHeaders }).catch(() => null),
  // The members of the bot's saved copy, shown while the live number is on its way (the same read as the lists above).
  readGuildSnapshot(id).catch(() => null),
]);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');
const livePending = !previewReady;
if (livePending) markPending(Astro);
const preview = previewReady?.value ?? { ok: false, message: '', data: null };

const allChannels: any[] = channelsRes?.ok ? await channelsRes.json() : [];
const channelName = new Map(allChannels.map((c: any) => [String(c.id), String(c.name)]));
const kindOf: Record<number, string> = { 0: 'text', 2: 'voice', 4: 'category', 5: 'announce', 13: 'stage' };
const categories = allChannels.filter((c: any) => c.type === 4).sort((a: any, b: any) => a.position - b.position).map((c: any) => ({ id: String(c.id), name: String(c.name) }));
// The order the list was dragged into, then the oldest first (the bot keeps the same order).
const rawRows: any[] = (rowsRes?.ok ? ((await rowsRes.json()) as any[]) : []).sort((a, b) => (a.position ?? 1e9) - (b.position ?? 1e9) || Number(a.id) - Number(b.id));
// The members of each day of the last 30, oldest first.
const memberDays: { day: string; members: number }[] = daysRes?.ok ? ((await daysRes.json().catch(() => [])) as any[]).map((row) => ({ day: String(row.day).slice(0, 10), members: Number(row.members) || 0 })).reverse() : [];
const counterChannels = new Set(rawRows.map((r) => String(r.channel_id)));
const freeChannels = allChannels.filter((c: any) => kindOf[c.type] && c.type !== 4 && !counterChannels.has(String(c.id))).sort((a: any, b: any) => a.position - b.position).map((c: any) => ({ id: String(c.id), name: String(c.name), kind: kindOf[c.type] }));
const roles = (rolesRes?.ok ? await rolesRes.json() : []).filter((r: any) => r.name !== '@everyone').sort((a: any, b: any) => b.position - a.position).map((r: any) => ({ id: String(r.id), name: String(r.name), color: Number(r.color) || 0 }));
const live = preview.ok ? preview.data : null;
const liveByChannel = new Map<string, any>((live?.counters ?? []).map((c: any) => [String(c.channel_id), c]));
const counters = rawRows.map((r) => {
  const state = liveByChannel.get(String(r.channel_id));
  return {
    id: Number(r.id), channelId: String(r.channel_id), type: String(r.counter_option), kind: String(r.channel_type ?? 'voice'),
    template: String(r.name_template ?? ''), format: String(r.number_format ?? 'plain'), goal: r.goal == null ? null : Number(r.goal), timezone: r.timezone ?? null,
    roleId: r.target_id ?? null, prefix: String(r.prefix ?? ''), suffix: String(r.suffix ?? ''), parentId: r.parent_id ?? null, enabled: r.enabled !== false,
    target: (r.target === 'topic' ? 'topic' : 'name') as 'topic' | 'name', channelName: state?.channel_name ?? channelName.get(String(r.channel_id)) ?? null,
    problem: r.problem ?? null, currentName: state?.current_name ?? (r.target === 'topic' ? null : channelName.get(String(r.channel_id))) ?? null, exists: state ? Boolean(state.exists) : channelName.has(String(r.channel_id)),
    nextRenameAt: state?.next_rename_at ?? null, renamesLeft: state?.renames_left ?? null,
    lastUpdatedAt: state?.last_updated_at ?? (r.last_updated_at ? Date.parse(r.last_updated_at) || null : null), nextCheckAt: state?.next_check_at ?? null,
    queued: Boolean(state?.queued), badges: Array.isArray(state?.badges) ? (state.badges as unknown[]).map(String) : [],
  };
});
const limits = live?.limits ?? null;
const embedNames: string[] = embedsRes?.ok ? ((await embedsRes.json().catch(() => [])) as any[]).map((row) => String(row.name)) : [];
const textChannels = allChannels.filter((c: any) => c.type === 0 || c.type === 5).sort((a: any, b: any) => a.position - b.position).map((c: any) => ({ id: String(c.id), name: String(c.name) }));
// The bot says the next number too; without it the saved row is shown as it is.
const savedAnnounce: any = announceRes?.ok ? ((await announceRes.json().catch(() => [])) as any[])[0] ?? null : null;
const announceRow: any = live?.announce ?? savedAnnounce;
const announce = announceRow ? {
  enabled: announceRow.enabled !== false, channelId: announceRow.channel_id ?? null, message: String(announceRow.message ?? ''), embedName: announceRow.embed_name ?? null,
  every: announceRow.every == null ? null : Number(announceRow.every), useGoals: announceRow.use_goals !== false,
  lastAnnounced: announceRow.last_announced == null ? null : Number(announceRow.last_announced), next: live?.announce?.next ?? null,
} : null;
---
<DashCounters user={session} guildId={id} guildName={guildInfo.name} guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'}
  counters={counters} categories={categories} roles={roles} freeChannels={freeChannels}
  values={live?.values ?? null} roleCounts={live?.roles ?? {}} roleOnlineCounts={live?.roles_online ?? {}} presences={Boolean(live?.presences)} limits={limits}
  approxMembers={Number((guildInfo as any).approximate_member_count ?? snapshot?.memberCount ?? 0) || 0} message={message}
  announce={announce} textChannels={textChannels} embedNames={embedNames} defaultAnnounce={String(live?.default_announce ?? '')} memberDays={memberDays} livePending={livePending} />
