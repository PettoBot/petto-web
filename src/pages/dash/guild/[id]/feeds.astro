---
export const prerender = false;
import DashFeeds from '../../../../components/DashFeeds.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';
import { hasPremiumForGuild } from '../../../../utils/premium';
import { FREE_LIMITS, PREMIUM_LIMITS, planLimits } from '../../../../utils/planLimits';
import { feedFromRow, platformById } from '../../../../utils/feeds';

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;
if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

// Each platform is a section of the page (?platform=youtube); without one, the overview of every followed account.
const wanted = Astro.url.searchParams.get('platform') ?? '';
const platform = platformById(wanted)?.id ?? null;
const apiHeaders = { apikey: apiKey, Authorization: `Bearer ${apiKey}` };

const [guildInfo, rowsRes, channelsRes, rolesRes, premium] = await Promise.all([
  getGuildInfo(id, botToken),
  fetch(`${apiUrl}/rest/v1/feeds?guild_id=eq.${id}&select=*&order=id.asc&limit=500`, { headers: apiHeaders }).catch(() => null),
  getGuildList(Astro, id, botToken, 'channels'),
  getGuildList(Astro, id, botToken, 'roles'),
  hasPremiumForGuild(Astro, session.userId, id),
]);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

// The table may not exist yet while the bot is on an older version: the page then says so instead of failing.
const ready = Boolean(rowsRes?.ok);
const feeds = (ready ? ((await rowsRes!.json().catch(() => [])) as any[]) : []).map(feedFromRow);
const channels = (channelsRes?.ok ? ((await channelsRes.json()) as any[]) : []).filter((c) => c.type === 0 || c.type === 5).sort((a, b) => a.position - b.position).map((c) => ({ id: String(c.id), name: String(c.name) }));
const roles = (rolesRes?.ok ? ((await rolesRes.json()) as any[]) : []).filter((r) => r.name !== '@everyone' && !r.managed).sort((a, b) => b.position - a.position).map((r) => ({ id: String(r.id), name: String(r.name), color: Number(r.color) || 0 }));
const limit = planLimits(premium).feeds;
---
<DashFeeds user={session} guildId={id} guildName={guildInfo.name} guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'}
  platform={platform} feeds={feeds} channels={channels} roles={roles} limit={limit} premium={premium} premiumLimit={PREMIUM_LIMITS.feeds} freeLimit={FREE_LIMITS.feeds} ready={ready} />
