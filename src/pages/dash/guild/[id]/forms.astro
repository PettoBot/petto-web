---
export const prerender = false;
import DashForms from '../../../../components/DashForms.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';
import { runBatched } from '../../../../utils/concurrency';
import { ensureGuildRow } from '../../../../utils/ensureGuild';
import { callPettoForms } from '../../../../utils/pettoBotApi';
import { lastAnswer, markPending, rememberAnswer, sharedCall, withinBudget } from '../../../../utils/liveCall';
import { normalizeForm, normalizeQuestions, slugName, newPublicId, NAME, FORM_PLAN, STATUSES, EMBED_COLUMNS, NEWER_PAGE_COLUMNS, usesPremiumLook } from '../../../../utils/forms';
import { hasPremiumForGuild } from '../../../../utils/premium';
import { makeT, getDashLang } from '../../../../i18n/dash';

const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const apiUrl = getEnv(Astro, 'PETTO_BOT_API_URL');
const apiKey = getEnv(Astro, 'PETTO_BOT_API_SECRET');
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;
if (!botToken || !apiUrl || !apiKey) return Astro.redirect('/dash/manage?error=server_not_configured');

const apiHeaders = { apikey: apiKey, Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' };
const SNOWFLAKE = /^\d{15,25}$/;
const SECTIONS = ['forms', 'submissions', 'panels'];
const section = SECTIONS.includes(String(Astro.url.searchParams.get('section'))) ? String(Astro.url.searchParams.get('section')) : 'forms';
const formParam = Astro.url.searchParams.get('form');
const statusParam = String(Astro.url.searchParams.get('status') ?? 'pending');
const statusFilter = [...STATUSES, 'all'].includes(statusParam as any) ? statusParam : 'pending';
const formFilter = /^\d{1,15}$/.test(String(Astro.url.searchParams.get('f') ?? '')) ? String(Astro.url.searchParams.get('f')) : '';
const search = String(Astro.url.searchParams.get('q') ?? '').trim().slice(0, 60);

const rest = (path: string, init: RequestInit = {}) => fetch(`${apiUrl}/rest/v1/${path}`, { ...init, headers: { ...apiHeaders, ...(init.headers as Record<string, string> | undefined) } });
const text = (value: FormDataEntryValue | null, max: number) => String(value ?? '').replace(/\u0000/g, '').trim().slice(0, max);
const plan = FORM_PLAN;
// Whether the database refused the columns of the link preview (a bot that has not added them yet), and the form without them.
const missingEmbedColumns = async (res: Response) => /embed_(?:title|description|image|color|thumbnail)|page_hide_branding/.test(await res.clone().text().catch(() => ''));
const LATER_COLUMNS: readonly string[] = [...EMBED_COLUMNS, ...NEWER_PAGE_COLUMNS];
const withoutEmbed = (row: object) => Object.fromEntries(Object.entries(row).filter(([key]) => !LATER_COLUMNS.includes(key)));
// The Premium touches of the page (the animated backgrounds, hiding the "Forms by Petto" line); everything else of forms is free.
const premiumActive = await hasPremiumForGuild(Astro, session.userId, id);

let message: { kind: 'ok' | 'err' | 'warn'; text: string } | null = null;
let redirectTo: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  await ensureGuildRow(apiUrl, apiHeaders, id);
  const failed = () => { message = { kind: 'err', text: dt('It could not be saved, try again.') }; };
  const formId = /^\d{1,15}$/.test(String(form.get('form_id') ?? '')) ? String(form.get('form_id')) : '';

  if (action === 'save_form') {
    let questions: unknown = [];
    try { questions = JSON.parse(String(form.get('questions_json') ?? '[]')); } catch { /* no questions */ }
    const closes = text(form.get('closes_at'), 40);
    const clean = normalizeForm({
      name: form.get('name'), title: form.get('title'), description: form.get('description'), color: /^#[0-9a-f]{6}$/i.test(text(form.get('color'), 7)) ? parseInt(text(form.get('color'), 7).slice(1), 16) : null,
      status: form.get('status'), questions,
      review_channel_id: form.get('review_channel_id'), reviewer_role_ids: form.getAll('reviewer_role_ids'), ping_role_ids: form.getAll('ping_role_ids'), auto_thread: form.get('auto_thread') === 'on',
      required_role_ids: form.getAll('required_role_ids'), blocked_role_ids: form.getAll('blocked_role_ids'),
      min_account_days: form.get('min_account_days'), min_member_days: form.get('min_member_days'), one_pending: form.get('one_pending') === 'on',
      deny_cooldown_hours: form.get('deny_cooldown_hours'), max_per_user: form.get('max_per_user'), max_total: form.get('max_total'),
      closes_at: closes ? `${closes}${closes.length === 16 ? ':00' : ''}Z` : null,
      accept_add_role_ids: form.getAll('accept_add_role_ids'), accept_remove_role_ids: form.getAll('accept_remove_role_ids'),
      deny_add_role_ids: form.getAll('deny_add_role_ids'), deny_remove_role_ids: form.getAll('deny_remove_role_ids'), dm_results: form.get('dm_results') === 'on', web_enabled: form.get('web_enabled') === 'on',
      page_banner: form.get('page_banner'), page_background: form.get('page_background'), page_show_icon: form.get('page_show_icon') === 'on', page_show_name: form.get('page_show_name') === 'on',
      embed_title: form.get('embed_title'), embed_description: form.get('embed_description'), embed_image: form.get('embed_image'), embed_thumbnail: form.get('embed_thumbnail') === 'on',
      embed_color: /^#[0-9a-f]{6}$/i.test(text(form.get('embed_color'), 7)) ? parseInt(text(form.get('embed_color'), 7).slice(1), 16) : null,
      messages: {
        submitted: { text: form.get('msg_submitted') },
        accepted: { text: form.get('msg_accepted'), template: form.get('tpl_accepted') },
        denied: { text: form.get('msg_denied'), template: form.get('tpl_denied') },
      },
      button_label: form.get('button_label'), button_emoji: form.get('button_emoji'), button_style: form.get('button_style'),
    }, { maxQuestions: plan.questions });
    // A free server keeps the rest of its changes. A Premium look it already had (saved while it had Premium) is kept as it is, so it
    // comes back with Premium; a new one is saved as the plain gradient and the line stays.
    let premiumWarn = '';
    if (!premiumActive && usesPremiumLook(clean)) {
      const storedRes = formId ? await rest(`forms?guild_id=eq.${id}&id=eq.${formId}&select=page_background,page_hide_branding`) : null;
      const stored = storedRes?.ok ? ((await storedRes.json().catch(() => []))[0] ?? {}) : {};
      let changed = false;
      if ((clean.page_background === 'aurora' || clean.page_background === 'waves') && stored.page_background !== clean.page_background) { clean.page_background = 'gradient'; changed = true; }
      if (clean.page_hide_branding && stored.page_hide_branding !== true) { clean.page_hide_branding = false; changed = true; }
      if (changed) premiumWarn = dt('Saved, but the animated backgrounds and hiding the "Forms by Petto" line are Premium touches, so the plain gradient and the line were kept.');
    }
    const asked = Array.isArray(questions) ? questions.length : 0;
    // A form opens only when members can send it somewhere: with questions and a review channel. Otherwise it is kept closed and the page says why.
    let warn = '';
    if (clean.status === 'open' && (!clean.questions.length || !clean.review_channel_id)) { clean.status = 'closed'; warn = dt('Saved, but kept closed: it needs at least one question and a review channel.'); }
    else if (premiumWarn) warn = premiumWarn;
    else if (asked > clean.questions.length) warn = dt('Saved. Questions without a text, choices with fewer than 2 options and the ones over the limit were left out.');
    else if (text(form.get('page_banner'), 600) && !clean.page_banner) warn = dt('Saved, but the banner was left out: use an https link to a .png, .jpg, .gif or .webp picture.');
    else if (text(form.get('embed_image'), 600) && !clean.embed_image) warn = dt('Saved, but the image of the link preview was left out: use an https link to a .png, .jpg, .gif or .webp picture.');
    if (!NAME.test(clean.name)) message = { kind: 'err', text: dt('Use a short name with letters, numbers, - or _.') };
    else if (formId) {
      let res = await rest(`forms?guild_id=eq.${id}&id=eq.${formId}`, { method: 'PATCH', headers: { Prefer: 'return=minimal' }, body: JSON.stringify({ ...clean, updated_at: new Date().toISOString() }) });
      // A bot that has not added the columns of the link preview yet refuses them: the rest of the form is saved, and the page says so.
      if (res.status === 400 && (await missingEmbedColumns(res))) {
        res = await rest(`forms?guild_id=eq.${id}&id=eq.${formId}`, { method: 'PATCH', headers: { Prefer: 'return=minimal' }, body: JSON.stringify({ ...withoutEmbed(clean), updated_at: new Date().toISOString() }) });
        if (res.ok) warn = dt('Saved, but the link preview could not be saved yet: Petto is being updated. Try again in a few minutes.');
      }
      if (res.status === 409) message = { kind: 'err', text: dt('Another form already has that name.') };
      else if (!res.ok) failed();
      else redirectTo = `?section=forms&form=${formId}&saved=${warn ? 'warn' : '1'}${warn ? `&w=${encodeURIComponent(warn)}` : ''}`;
    } else {
      const countRes = await rest(`forms?guild_id=eq.${id}&select=id`);
      const count = countRes.ok ? (await countRes.json()).length : 0;
      if (count >= plan.forms) message = { kind: 'err', text: dt('You reached the limit of forms ({a}).', { a: plan.forms }) };
      else {
        let res = await rest('forms', { method: 'POST', headers: { Prefer: 'return=representation' }, body: JSON.stringify({ guild_id: id, ...clean }) });
        if (res.status === 400 && (await missingEmbedColumns(res))) {
          res = await rest('forms', { method: 'POST', headers: { Prefer: 'return=representation' }, body: JSON.stringify({ guild_id: id, ...withoutEmbed(clean) }) });
          if (res.ok) warn = dt('Saved, but the link preview could not be saved yet: Petto is being updated. Try again in a few minutes.');
        }
        const row = res.ok ? (await res.json())[0] : null;
        if (res.status === 409) message = { kind: 'err', text: dt('Another form already has that name.') };
        else if (row) redirectTo = `?section=forms&form=${row.id}&saved=${warn ? 'warn' : '1'}${warn ? `&w=${encodeURIComponent(warn)}` : ''}`;
        else failed();
      }
    }
  } else if (action === 'toggle_form' && formId) {
    const res = await rest(`forms?guild_id=eq.${id}&id=eq.${formId}&select=status,questions,review_channel_id`);
    const row = res.ok ? (await res.json())[0] : null;
    if (!row) failed();
    else if (row.status !== 'open' && (!normalizeQuestions(row.questions).length || !row.review_channel_id)) message = { kind: 'err', text: dt('A form needs at least one question and a review channel before it opens.') };
    else {
      const done = await rest(`forms?guild_id=eq.${id}&id=eq.${formId}`, { method: 'PATCH', headers: { Prefer: 'return=minimal' }, body: JSON.stringify({ status: row.status === 'open' ? 'closed' : 'open', updated_at: new Date().toISOString() }) });
      message = done.ok ? { kind: 'ok', text: row.status === 'open' ? dt('Form closed.') : dt('Form opened.') } : { kind: 'err', text: dt('It could not be saved, try again.') };
    }
  } else if (action === 'relink_form' && formId) {
    // A new web address: the old link stops working at once (panels already posted keep the old one).
    const res = await rest(`forms?guild_id=eq.${id}&id=eq.${formId}`, { method: 'PATCH', headers: { Prefer: 'return=minimal' }, body: JSON.stringify({ public_id: newPublicId(), updated_at: new Date().toISOString() }) });
    if (res.ok) redirectTo = `?section=forms&form=${formId}&relinked=1`; else failed();
  } else if (action === 'delete_form' && formId) {
    const res = await rest(`forms?guild_id=eq.${id}&id=eq.${formId}`, { method: 'DELETE' });
    if (res.ok) redirectTo = '?section=forms&deleted=1'; else failed();
  } else if (action === 'duplicate_form' && formId) {
    const [orig, all] = await Promise.all([rest(`forms?guild_id=eq.${id}&id=eq.${formId}&select=*`), rest(`forms?guild_id=eq.${id}&select=name`)]);
    const original = orig.ok ? (await orig.json())[0] : null;
    const names = new Set((all.ok ? await all.json() : []).map((r: any) => r.name));
    if (!original) failed();
    else if (names.size >= plan.forms) message = { kind: 'err', text: dt('You reached the limit of forms ({a}).', { a: plan.forms }) };
    else {
      let name = slugName(`${String(original.name).slice(0, 27)}-copy`);
      for (let n = 2; names.has(name); n += 1) name = slugName(`${String(original.name).slice(0, 26)}-copy${n}`);
      const { id: _drop, public_id: _p, created_at: _c, updated_at: _u, guild_id: _g, ...copy } = original;
      const res = await rest('forms', { method: 'POST', headers: { Prefer: 'return=representation' }, body: JSON.stringify({ guild_id: id, ...copy, name, status: 'closed' }) });
      const row = res.ok ? (await res.json())[0] : null;
      if (row) redirectTo = `?section=forms&form=${row.id}`; else failed();
    }
  } else if (action === 'review') {
    const status = String(form.get('status') ?? '');
    const result = await callPettoForms(Astro, id, session.userId, 'review', { number: Number(form.get('number')), status, reason: text(form.get('reason'), 1000) }, dashLang);
    message = result.ok ? { kind: 'ok', text: result.message || dt('Done.') } : { kind: 'err', text: result.message || dt('The bot could not do it. Try again in a moment.') };
  } else if (action === 'save_retention') {
    const days = Math.min(365, Math.max(1, Math.trunc(Number(form.get('retention_days'))) || 30));
    const res = await rest('form_config?on_conflict=guild_id', { method: 'POST', headers: { Prefer: 'resolution=merge-duplicates,return=minimal' }, body: JSON.stringify({ guild_id: id, retention_days: days, updated_at: new Date().toISOString() }) });
    message = res.ok ? { kind: 'ok', text: dt('Saved.') } : { kind: 'err', text: dt('It could not be saved, try again.') };
  } else if (action === 'post_panel') {
    const color = text(form.get('panel_color'), 7);
    const result = await callPettoForms(Astro, id, session.userId, 'panel', {
      channel_id: text(form.get('channel_id'), 30), form_ids: form.getAll('form_ids').map(String).slice(0, 25), style: form.get('style') === 'select' ? 'select' : 'buttons',
      template: text(form.get('template'), 100) || null, title: text(form.get('panel_title'), 200) || null, description: text(form.get('panel_description'), 2000) || null, color: /^#[0-9a-f]{6}$/i.test(color) ? color : null,
      web: form.get('panel_web') === 'on',
    }, dashLang);
    message = result.ok ? { kind: 'ok', text: result.message || dt('Panel posted.') } : { kind: 'err', text: result.message || dt('The bot could not do it. Try again in a moment.') };
  }
}
if (redirectTo) return Astro.redirect(`/dash/guild/${id}/forms${redirectTo}`);
const savedParam = Astro.url.searchParams.get('saved');
if (savedParam === '1') message = { kind: 'ok', text: dt('Saved.') };
if (savedParam === 'warn') message = { kind: 'warn', text: text(Astro.url.searchParams.get('w'), 300) || dt('Saved.') };
if (Astro.url.searchParams.get('relinked') === '1') message = { kind: 'ok', text: dt('New link made. The old one no longer works.') };
if (Astro.url.searchParams.get('deleted') === '1') message = { kind: 'ok', text: dt('Form deleted. What members already sent is kept.') };

const editing = section === 'forms' && formParam ? formParam : null;
const needsLists = Boolean(editing) || section === 'panels';
// Outside the submissions tab the bot only gives the pending counts and the storage line. Those are kept per change stamp of the server
// (a new submission, a review or any change raises it), so the next pages reuse them; when they are not ready within a moment the page
// is drawn with the last ones known and fills them in right after (see liveCall.ts).
// The answer to a change (a review) carries its message, which a read of the page again would lose: it waits for them as before.
const SUMMARY_BUDGET_MS = Astro.request.method === 'POST' ? 30_000 : 300;
const subsArgs = { status: statusFilter, form_id: formFilter || null, q: section === 'submissions' ? search : '', limit: section === 'submissions' ? 50 : 1 };
// A page that answers a change (a review) is drawn before the stamp is raised, so it never reuses a kept answer.
const summaryStamp = Astro.request.method === 'POST' ? `post-${Date.now()}-${Math.random()}` : String((Astro.locals as Record<string, unknown>).dashVersion ?? '');
const summaryCall = section === 'submissions' ? null : sharedCall(`forms-summary:${id}:${session.userId}:${summaryStamp}:${statusFilter}:${formFilter}`, () => callPettoForms(Astro, id, session.userId, 'submissions', subsArgs, dashLang), (result) => (result.ok ? 60_000 : 3_000));
// The submissions are read through the bot (it keeps the cap and the retention); the forms and their settings straight from the database.
const [guildInfo, formsRes, subsResult, panelsRes, rolesRes, channelsRes, templatesRes] = await runBatched([
  () => getGuildInfo(id, botToken),
  () => rest(`forms?guild_id=eq.${id}&select=*&order=id.asc`),
  () => (summaryCall ? withinBudget(summaryCall, SUMMARY_BUDGET_MS).then((ready) => ready?.value ?? null) : callPettoForms(Astro, id, session.userId, 'submissions', subsArgs, dashLang)),
  () => (section === 'panels' ? rest(`form_panels?guild_id=eq.${id}&select=*&order=id.desc&limit=20`) : Promise.resolve(null)),
  () => (needsLists || section === 'submissions' ? getGuildList(Astro, id, botToken, 'roles') : Promise.resolve(null)),
  () => (needsLists ? getGuildList(Astro, id, botToken, 'channels') : Promise.resolve(null)),
  () => (needsLists ? rest(`embed_templates?guild_id=eq.${id}&select=name&order=name.asc`) : Promise.resolve(null)),
], 5);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

const ready = Boolean(formsRes?.ok);
const forms: any[] = ready ? await formsRes!.json() : [];
const summaryKey = `forms-summary:${id}:${session.userId}`;
if (summaryCall && !subsResult) markPending(Astro);
const subsData = subsResult?.ok ? subsResult.data : summaryCall && !subsResult ? lastAnswer<any>(summaryKey) ?? null : null;
if (summaryCall && subsResult?.ok) rememberAnswer(summaryKey, subsResult.data);
const pending: Record<string, number> = subsData?.pending ?? {};
const submissions: any[] = section === 'submissions' ? subsData?.submissions ?? [] : [];
const storage = { stored: Number(subsData?.stored ?? 0), cap: Number(subsData?.cap ?? plan.submissions), retention: Number(subsData?.retention_days ?? 30), known: Boolean(subsData) };
const panels: any[] = panelsRes?.ok ? await panelsRes.json() : [];
const roles = (rolesRes?.ok ? await rolesRes.json() : []).filter((r: any) => r.name !== '@everyone' && !r.managed).sort((a: any, b: any) => b.position - a.position).map((r: any) => ({ id: r.id, name: r.name }));
const channels = (channelsRes?.ok ? await channelsRes.json() : []).filter((c: any) => c.type === 0 || c.type === 5).sort((a: any, b: any) => a.position - b.position).map((c: any) => ({ id: c.id, name: c.name }));
const templates: string[] = (templatesRes?.ok ? await templatesRes.json() : []).map((t: any) => t.name).filter(Boolean);
const editForm = editing === 'new' ? 'new' : editing ? forms.find((f) => String(f.id) === editing) ?? null : null;
---
<DashForms
  user={session} guildId={id} guildName={guildInfo.name} guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'}
  section={section} forms={forms} pending={pending} submissions={submissions} panels={panels} roles={roles} channels={channels} templates={templates}
  editing={editForm} storage={storage} statusFilter={statusFilter} formFilter={formFilter} search={search} plan={plan} ready={ready} message={message} premiumActive={premiumActive}
/>
