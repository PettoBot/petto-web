---
export const prerender = false;
import DashBackups from '../../../../components/DashBackups.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getGuildInfo } from '../../../../utils/discord';
import { getEnv } from '../../../../utils/env';
import { callPettoVault } from '../../../../utils/pettoBotApi';
import { getDashLang, makeT } from '../../../../i18n/dash';
const dt = makeT(getDashLang(Astro));

const { id } = Astro.params as { id: string };
const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
if (!botToken) return Astro.redirect('/dash/manage?error=server_not_configured');
const guildInfo = await getGuildInfo(id, botToken);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

let message: string | null = null;
let error: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const body: Record<string, unknown> = { user_id: session.userId, action };
  if (action === 'create') body.label = String(form.get('label') ?? '').trim();
  if (action === 'schedule') { body.hours = Number(form.get('hours')); body.retention = Number(form.get('retention')); }
  if (action === 'restore') { body.backup_id = Number(form.get('backup_id')); body.mode = String(form.get('mode') ?? 'merge'); body.confirm = form.get('confirm') === 'true'; }
  const result = await callPettoVault(Astro, id, session.userId, { method: 'POST', body: JSON.stringify(body) });
  if (result.ok) message = action === 'create' ? dt('Backup created.') : action === 'schedule' ? dt('Automatic backup schedule saved.') : action === 'restore' ? dt('Backup restored. A safety backup was created first.') : dt('Automatic backups disabled.');
  else error = result.error === 'not_configured' ? dt('Vault is not connected to the dashboard yet.') : result.error === 'administrator_required' ? dt('Only server administrators can restore backups.') : result.error === 'restore_confirmation_required' ? dt('Restore confirmation is required.') : dt('Petto could not complete that Vault action.');
}

const result = await callPettoVault(Astro, id, session.userId);
const vault = result.ok ? result.payload : null;
if (!result.ok && !error) error = result.error === 'not_configured' ? dt('Vault is not connected to the dashboard yet.') : null;
---
<DashBackups
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.png'}
  backups={vault?.backups ?? []}
  audit={vault?.audit ?? []}
  schedule={vault?.schedule ?? null}
  connected={Boolean(vault)}
  message={message}
  error={error}
 />
