---
export const prerender = false;
import DashTicketAi from '../../../../components/DashTicketAi.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo, getGuildList } from '../../../../utils/discord';
import { pageDecision } from '../../../../utils/dashAccess';
import { canUseTicketAi } from '../../../../utils/ticketAiAccess';
import { ticketAiDb, readTicketAiSettings, readTicketAiUsage, saveTicketAiSettings, checkSaveInput, type TicketAiSettings } from '../../../../utils/ticketAi';
import { getDashLang, makeT } from '../../../../i18n/dash';

// Tickets → AI assistant (beta). The settings live in ticket_ai_settings (docs/schema/ticket_ai_settings.sql); the test chat and the setup
// helper call ./ai-assistant-api. Until the tables exist the page works, says the update is pending, and Save is off.
const dt = makeT(getDashLang(Astro));
const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');

const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;
if (!canUseTicketAi(Astro, session.userId, id)) return Astro.redirect(`/dash/guild/${id}/overview`);
const db = ticketAiDb(Astro);
if (!botToken || !db) return Astro.redirect('/dash/manage?error=server_not_configured');
const viewOnly = Boolean(auth.devView) || Boolean(auth.access && !pageDecision(auth.access, 'ai-assistant').canEdit);
const groqConfigured = Boolean(String(getEnv(Astro, 'GROQ_API_KEY') ?? '').trim());

// The ticket types (and their panels) the assistant can be limited to, the same rows the Tickets page reads.
const [guildInfo, settingsRead, usage, categoriesRes, panelsRes, channelsRes] = await Promise.all([
  getGuildInfo(id, botToken),
  readTicketAiSettings(db, id),
  readTicketAiUsage(db, id),
  fetch(`${db.url}/rest/v1/ticket_categories?guild_id=eq.${id}&select=id,label,emoji,panel_id&order=id.asc`, { headers: db.headers }).catch(() => null),
  fetch(`${db.url}/rest/v1/ticket_panels?guild_id=eq.${id}&select=id,title,channel_id&order=id.asc`, { headers: db.headers }).catch(() => null),
  getGuildList(Astro, id, botToken, 'channels'),
]);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');

const rawCategories: any[] = categoriesRes?.ok ? await categoriesRes.json().catch(() => []) : [];
const rawPanels: any[] = panelsRes?.ok ? await panelsRes.json().catch(() => []) : [];
const allChannels: any[] = channelsRes?.ok ? await channelsRes.json().catch(() => []) : [];
const channelName = new Map(allChannels.map((c: any) => [String(c.id), String(c.name)]));
const categories = rawCategories.map((c) => ({ id: String(c.id), label: String(c.label ?? ''), emoji: c.emoji ? String(c.emoji) : '', panelId: c.panel_id != null ? String(c.panel_id) : '' }));
const panels = rawPanels.map((p) => ({ id: String(p.id), name: p.title ? String(p.title) : channelName.has(String(p.channel_id)) ? `#${channelName.get(String(p.channel_id))}` : dt('Panel {n}', { n: p.id }) }));
// Channels for the typed autocomplete of the instructions (# inserts a channel the assistant can point to).
const channels = allChannels.filter((c: any) => c.type === 0 || c.type === 5 || c.type === 15).sort((a: any, b: any) => a.position - b.position).map((c: any) => ({ id: String(c.id), name: String(c.name), type: c.type }));

let state = settingsRead.state;
let settings: TicketAiSettings = settingsRead.settings;
let saved = false;
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (viewOnly) {
    error = dt('You can look at this page but not change it.');
  } else if (state !== 'ok') {
    // Never write defaults over settings that could not be read.
    error = state === 'pending' ? dt('The database update for the AI assistant is pending.') : dt("Couldn't read the saved settings. Try again.");
  } else {
    const checked = checkSaveInput(form, categoriesRes?.ok ? new Set(categories.map((c) => c.id)) : null);
    if (!checked.ok) {
      error = (checked as { ok: false; errors: string[] }).errors.includes('scope')
        ? dt('Choose at least one ticket type, or let it answer in all of them.')
        : dt('A text is longer than allowed. Make it shorter and save again.');
    } else {
      const result = await saveTicketAiSettings(db, id, String(session.userId), checked.value);
      if (result.ok) {
        saved = true;
        settings = { ...checked.value, updatedAt: new Date().toISOString() };
      } else if (result.pending) {
        state = 'pending';
        error = dt('The database update for the AI assistant is pending.');
      } else {
        error = dt("Couldn't save the AI assistant, try again.");
      }
    }
  }
}
---
<DashTicketAi
  user={session}
  guildId={id}
  guildName={guildInfo.name}
  guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'}
  settings={settings}
  state={state}
  categories={categories}
  panels={panels}
  channels={channels}
  usage={usage.replies}
  groqConfigured={groqConfigured}
  viewOnly={viewOnly}
  saved={saved}
  error={error}
/>
