---
export const prerender = false;
import DashMigrate from '../../../../components/DashMigrate.astro';
import { getGuildSession } from '../../../../utils/dashAuth';
import { getEnv } from '../../../../utils/env';
import { getGuildInfo } from '../../../../utils/discord';

// Moving from another bot: a converter of the variables of a message and a checklist. Nothing is saved on the server: the ticks stay in the browser.
const { id } = Astro.params as { id: string };
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
const auth = await getGuildSession(Astro, id);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { session } = auth;
if (!botToken) return Astro.redirect('/dash/manage?error=server_not_configured');

const guildInfo = await getGuildInfo(id, botToken);
if (!guildInfo) return Astro.redirect('/dash/manage?error=bot_not_in_guild');
// Only people with Manage Server use the AI helper (the bot checks it too): someone let in by a role of the dashboard, or the Petto owner in Support mode, only look.
const canRun = !auth.devView && !auth.access;
---
<DashMigrate user={session} guildId={id} guildName={guildInfo.name} guildIcon={guildInfo.icon ?? '/assets/mascot-icon.webp'} canRun={canRun} />
