  <script is:inline>
    // The burger and the language of the top bar. They are wired here, right after the menu, in plain old JavaScript, and not in the big script of the
    // page: if that one fails (a browser too old for its syntax, a content blocker, a file that does not load or loads late) the menu still opens.
    (function () {
      if (window.__pettoNav) return;
      window.__pettoNav = true;
      var langToggle = document.getElementById('langToggle');
      var langMenu = document.getElementById('langMenu');
      var navBurger = document.getElementById('navBurger');
      var mobileNav = document.getElementById('mobileNav');
      var mnavPops = mobileNav ? Array.prototype.slice.call(mobileNav.querySelectorAll('details.mnav-pop')) : [];
      function setLangOpen(open) {
        if (langMenu) langMenu.classList.toggle('open', open);
        if (langToggle) langToggle.setAttribute('aria-expanded', String(open));
      }
      // The language and the account of the burger menu are small pop-ups: one open at a time, closed by a tap outside or by Escape.
      function closeMnavPops(except) {
        mnavPops.forEach(function (pop) { if (pop !== except) pop.open = false; });
      }
      function closeMobileNav() {
        if (navBurger) { navBurger.classList.remove('open'); navBurger.setAttribute('aria-expanded', 'false'); }
        if (mobileNav) mobileNav.classList.remove('open');
        document.body.style.overflow = '';
        closeMnavPops(null);
      }
      if (langToggle) langToggle.addEventListener('click', function (e) {
        e.stopPropagation();
        setLangOpen(!(langMenu && langMenu.classList.contains('open')));
      });
      if (navBurger) navBurger.addEventListener('click', function (e) {
        e.stopPropagation();
        var isOpen = navBurger.classList.contains('open');
        // Under the pill of the header, wherever it is: its real bottom edge plus a small gap (the glass pill has a soft shadow).
        var pill = document.querySelector('header.nav');
        if (!isOpen && pill && mobileNav && document.body.classList.contains('public-body')) mobileNav.style.top = Math.round(pill.getBoundingClientRect().bottom + 10) + 'px';
        navBurger.classList.toggle('open', !isOpen);
        if (mobileNav) mobileNav.classList.toggle('open', !isOpen);
        navBurger.setAttribute('aria-expanded', String(!isOpen));
        document.body.style.overflow = !isOpen ? 'hidden' : '';
      });
      mnavPops.forEach(function (pop) {
        pop.addEventListener('toggle', function () { if (pop.open) closeMnavPops(pop); });
      });
      if (mobileNav) {
        mobileNav.addEventListener('click', function (e) {
          if (!(e.target instanceof Element) || !e.target.closest('details.mnav-pop')) closeMnavPops(null);
        });
        Array.prototype.forEach.call(mobileNav.querySelectorAll('a'), function (link) { link.addEventListener('click', closeMobileNav); });
      }
      document.addEventListener('click', function () { setLangOpen(false); });
      document.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape') return;
        if (langMenu && langMenu.classList.contains('open')) { setLangOpen(false); if (langToggle) langToggle.focus(); }
        if (mobileNav && mobileNav.classList.contains('open')) {
          var openPop = mnavPops.filter(function (pop) { return pop.open; })[0];
          if (openPop) { openPop.open = false; var sum = openPop.querySelector('summary'); if (sum) sum.focus(); } else { closeMobileNav(); if (navBurger) navBurger.focus(); }
        }
      });
      // Coming back to the page with the Back button (it can be restored as it was left) never shows an open menu.
      window.addEventListener('pageshow', function (e) { if (e.persisted) closeMobileNav(); });
      window.addEventListener('resize', function () {
        if (window.innerWidth > 880 && mobileNav && mobileNav.classList.contains('open')) closeMobileNav();
      });
    })();
  </script>

  {active !== 'dash' && <GlassDock base={base} route={currentRoute} labels={{ home: 'Petto', commands: t.nav.commands, premium: t.nav.premium, status: t.nav.status, support: t.nav.support, account: 'Dashboard' }} />}

