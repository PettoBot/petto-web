---
import InlineIcon from '../components/InlineIcon.astro';
import NavIcon from '../components/NavIcon.astro';
import SpecularButton from '../react/SpecularButton.jsx';
import { useTranslations, localeNames, localePath, type Locale } from '../i18n/ui';
import '@flaticon/flaticon-uicons/css/solid/rounded.css';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'commands' | 'docs' | 'dash';
  lang?: Locale;
  showFooter?: boolean;
  /** Only the guild dashboard's fixed two-panel app shell needs the body scroll lock, plain dash pages (login, manage) scroll normally. */
  appShell?: boolean;
}
const DEFAULT_DESCRIPTION: Record<Locale, string> = {
  en: 'Moderation, leveling, tickets, and giveaways with a full web dashboard, no slash-command grind required.',
  es: 'Moderación, niveles, tickets y sorteos con un dashboard web completo, sin necesidad de memorizar slash commands.',
  'pt-BR': 'Moderação, níveis, tickets e sorteios com um dashboard web completo, sem precisar decorar slash commands.',
};
const { title, description, active = 'home', lang = 'en' as Locale, showFooter = active !== 'dash', appShell = false } = Astro.props;
const metaDescription = description ?? DEFAULT_DESCRIPTION[lang];
const t = useTranslations(lang);
const base = localePath[lang];
const localeShort: Record<Locale, string> = { en: 'EN', es: 'ES', 'pt-BR': 'PT' };
const currentRoute = Astro.url.pathname.replace(/^\/(?:es|pt-br)(?=\/|$)/, '') || '/';
const languageHref = (target: Locale) => {
  if (active === 'dash' || currentRoute === '/dash' || currentRoute.startsWith('/dash/')) return '/dash';
  if (target === 'en') return currentRoute;
  return `${localePath[target]}${currentRoute === '/' ? '/' : currentRoute}`;
};
const isExternal = (href: string) => /^https?:\/\//.test(href);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://petto.sbs').toString();
const ogImageUrl = new URL('/assets/mascot-icon.png', Astro.site ?? 'https://petto.sbs').toString();

const cookieCopy = {
  en: { text: 'By using this site, you agree with our use of cookies.', consent: 'I consent to cookies', decline: 'Decline all', more: 'Want to know more?', privacy: 'Privacy policy' },
  es: { text: 'Al usar este sitio, aceptas nuestro uso de cookies.', consent: 'Acepto las cookies', decline: 'Rechazar todo', more: '¿Quieres saber más?', privacy: 'Política de privacidad' },
  'pt-BR': { text: 'Ao usar este site, você concorda com o uso de cookies.', consent: 'Aceito os cookies', decline: 'Recusar tudo', more: 'Quer saber mais?', privacy: 'Política de privacidade' },
}[lang];
// /dash has no translated routes yet, so it stays un-prefixed on every locale instead of 404ing at /es/dash.
const bypassLocale = (href: string) => href.startsWith('/dash');
const hrefFor = (href: string) => (isExternal(href) || bypassLocale(href) ? href : `${base}${href}`);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" href="/assets/mascot-icon.png" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:site_name" content="Petto" />

  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImageUrl} />
  <style is:global>
    @font-face {
      font-family: 'Petto Sans';
      src: url('/fonts/petto-sans.woff2') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Petto Sans';
      src: url('/fonts/petto-sans-bold.woff2') format('woff2');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }
  </style>
  <style is:global>
    :root {
      --bg: #111214;
      --bg-raise: #111214;
      --card: #111214;
      --card-hover: #191b20;
      --border: #2a2d35;
      --border-soft: #202228;
      --text: #f3f1ea;
      --text-muted: #9c968a;
      --text-dim: #6f6a62;
      --accent: #8399ff;
      --accent-soft: rgba(131, 153, 255, 0.14);
      --accent-ink: #1a1c2e;
      --green: #a5ea7a;
      --green-soft: rgba(165, 234, 122, 0.14);
      --yellow: #fed53c;
      --yellow-soft: rgba(254, 213, 60, 0.14);
      --red: #fe6465;
      --red-soft: rgba(254, 100, 101, 0.14);
      --serif: Iowan Old Style, "Palatino Linotype", Georgia, "Times New Roman", serif;
      --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      --mono: ui-monospace, "SFMono-Regular", "Cascadia Code", Consolas, monospace;
    }
    :root[data-theme="light"] {
      --bg: #ffffff; --bg-raise: #ffffff; --card: #ffffff; --card-hover: #f7f8fa;
      --border: #e3e6eb; --border-soft: #edf0f3; --text: #20242b; --text-muted: #66707d; --text-dim: #8c96a3;
      --accent: #5266d6; --accent-soft: rgba(82, 102, 214, 0.09); --accent-ink: #ffffff;
      --green: #4d8f2b; --green-soft: rgba(77, 143, 43, 0.1);
      --yellow: #93720a; --yellow-soft: rgba(147, 114, 10, 0.1);
      --red: #c23c3d; --red-soft: rgba(194, 60, 61, 0.1);
    }
    @media (prefers-color-scheme: light) {
      :root:not([data-theme="dark"]) {
        --bg: #ffffff; --bg-raise: #ffffff; --card: #ffffff; --card-hover: #f7f8fa;
        --border: #e3e6eb; --border-soft: #edf0f3; --text: #20242b; --text-muted: #66707d; --text-dim: #8c96a3;
        --accent: #5266d6; --accent-soft: rgba(82, 102, 214, 0.09); --accent-ink: #ffffff;
        --green: #4d8f2b; --green-soft: rgba(77, 143, 43, 0.1);
        --yellow: #93720a; --yellow-soft: rgba(147, 114, 10, 0.1);
        --red: #c23c3d; --red-soft: rgba(194, 60, 61, 0.1);
      }
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; background: var(--bg); color: var(--text); font-family: var(--sans); font-size: 16px; line-height: 1.55; -webkit-font-smoothing: antialiased; }
    body.public-body {
      font-family: 'Petto Sans', var(--sans);
      overflow-x: hidden;
    }
    body.dashboard-motion {
      font-family: 'Petto Sans', var(--sans);
      overflow-x: hidden;
    }
    img, svg { display: block; max-width: 100%; }
    a { color: inherit; }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 28px; }
    ::selection { background: var(--accent-soft); color: var(--text); }

    h1, h2, h3 { font-family: var(--serif); font-weight: 600; letter-spacing: -0.01em; text-wrap: balance; margin: 0; }
    body.public-body h1,
    body.public-body h2,
    body.public-body h3,
    body.public-body .brand,
    body.public-body .foot-brand,
    body.public-body .mega-brand-name { font-family: 'Petto Sans', var(--sans); font-weight: 700; letter-spacing: -0.025em; }
    body.public-body .eyebrow,
    body.public-body code,
    body.public-body .mono,
    body.public-body button,
    body.public-body input,
    body.public-body select,
    body.public-body textarea,
    body.public-body .btn { font-family: 'Petto Sans', var(--sans); }
    body.public-body .btn { border-radius: 11px; }
    body.public-body .btn-accent { box-shadow: 0 10px 24px -16px var(--accent); }
    body.public-body .btn-accent:hover { box-shadow: 0 14px 30px -16px var(--accent); }
    body.dashboard-motion h1,
    body.dashboard-motion h2,
    body.dashboard-motion h3 { font-family: 'Petto Sans', var(--sans); font-weight: 700; letter-spacing: -0.025em; }
    body.dashboard-motion button,
    body.dashboard-motion input,
    body.dashboard-motion select,
    body.dashboard-motion textarea,
    body.dashboard-motion .btn { font-family: 'Petto Sans', var(--sans); }
    body.public-body .announce-card,
    body.public-body .release,
    body.public-body .feat,
    body.public-body .stack-item { transition: transform 0.22s cubic-bezier(0.16,1,0.3,1), border-color 0.22s ease, background 0.22s ease, box-shadow 0.22s ease; }
    body.public-body .announce-card:hover,
    body.public-body .release:hover { transform: translateY(-4px); box-shadow: 0 18px 34px -28px rgba(0,0,0,0.75); }
    body.public-body .feat:hover,
    body.public-body .stack-item:hover { transform: translateY(-2px); }
    body.public-body :focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

    body.public-body header.nav {
      top: 14px;
      width: min(calc(100% - 28px), 1180px);
      margin: 14px auto 0;
      border: 1px solid color-mix(in srgb, var(--text) 12%, var(--border));
      border-radius: 18px;
      background: color-mix(in srgb, var(--card) 76%, transparent);
      box-shadow: 0 18px 50px -34px rgba(0,0,0,0.8);
    }
    body.public-body header.nav .nav-inner { max-width: none; padding: 10px 12px; }
    body.public-body nav.links { gap: 3px; }
    body.public-body nav.links a,
    body.public-body .mega-trigger { padding: 8px 11px; border-radius: 10px; transition: background 0.18s ease, color 0.18s ease; }
    body.public-body nav.links a:hover,
    body.public-body .mega-trigger:hover { background: var(--card-hover); }
    body.public-body .lang-btn { width: auto; min-width: 58px; gap: 6px; padding: 0 10px; }
    body.public-body .lang-current { color: var(--text); font-size: 11px; font-weight: 700; letter-spacing: 0.06em; }
    body.public-body .lang-menu {
      display: block;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px) scale(0.98);
      pointer-events: none;
      transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
    }
    body.public-body .lang-menu.open { opacity: 1; visibility: visible; transform: translateY(0) scale(1); pointer-events: auto; }
    body.public-body .mobile-nav { top: calc(var(--dgl-header-h, 60px) + 8px); left: 10px; right: 10px; bottom: 10px; border: 1px solid var(--border); border-radius: 18px; box-shadow: 0 18px 50px -30px rgba(0,0,0,0.8); }
    .page-transition { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; background: var(--bg); opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 0.34s ease, visibility 0.34s ease; }
    .page-transition-mascot { position: relative; width: 54px; height: 54px; object-fit: contain; animation: pageLoaderSpin 0.9s linear infinite; }
    body:not(.public-body) .page-transition { display: none; }
    body.public-body:not(.page-loaded) .page-transition,
    body.public-body.page-leaving .page-transition { opacity: 1; visibility: visible; }
    body.public-body.page-loaded .page-transition { opacity: 0; visibility: hidden; }
    body.public-body.page-leaving .page-transition { transition-duration: 0.2s; }
    .eyebrow { font-family: var(--mono); font-size: 12px; font-weight: 500; letter-spacing: 0.11em; text-transform: uppercase; color: var(--text-dim); }
    .num { font-variant-numeric: tabular-nums; }
    code, .mono { font-family: var(--mono); }

    @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes duckHop { 0% { transform: translateY(0) rotate(0deg); } 30% { transform: translateY(-8px) rotate(-5deg); } 55% { transform: translateY(0) rotate(3deg); } 75% { transform: translateY(-3px) rotate(-1deg); } 100% { transform: translateY(0) rotate(0deg); } }
    @keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { * { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; } }
    .reveal { opacity: 0; transform: translateY(18px); transition: opacity 0.6s cubic-bezier(0.16,1,0.3,1), transform 0.6s cubic-bezier(0.16,1,0.3,1); }
    .reveal.in { opacity: 1; transform: translateY(0); }
    /* Dashboard pages use the same reveal class for the shell, but their content
       scrolls inside a fixed app panel. Letting the viewport observer control it
       can leave the whole panel transparent on first render. */
    body:is(.public-body, .dashboard-motion) .reveal { opacity: 1; transform: none; transition: none; }

    @keyframes publicNavIn { from { opacity: 0; transform: translateY(-12px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes pageLoaderSpin { from { transform: rotate(0deg) scale(0.96); opacity: 0.78; } 50% { transform: rotate(180deg) scale(1); opacity: 1; } to { transform: rotate(360deg) scale(0.96); opacity: 0.78; } }
    body:is(.public-body, .dashboard-motion).motion-ready header.nav { animation: publicNavIn 0.65s cubic-bezier(0.16,1,0.3,1) both; }
    body:is(.public-body, .dashboard-motion).motion-ready main > section,
    body:is(.public-body, .dashboard-motion).motion-ready main > article {
      opacity: 1;
      transform: translateX(44px);
      transition: opacity 0.72s cubic-bezier(0.16,1,0.3,1), transform 0.72s cubic-bezier(0.16,1,0.3,1);
      transition-delay: calc(var(--motion-index, 0) * 65ms);
      will-change: opacity, transform;
    }
    body:is(.public-body, .dashboard-motion).motion-ready main > section:nth-child(even),
    body:is(.public-body, .dashboard-motion).motion-ready main > article:nth-child(even) { transform: translateX(-44px); }
    body:is(.public-body, .dashboard-motion).motion-ready main > section.motion-visible,
    body:is(.public-body, .dashboard-motion).motion-ready main > article.motion-visible { opacity: 1; transform: translateX(0); }
    body:is(.public-body, .dashboard-motion).motion-ready .motion-child {
      opacity: 1;
      transform: translateY(16px);
      transition: opacity 0.55s cubic-bezier(0.16,1,0.3,1), transform 0.55s cubic-bezier(0.16,1,0.3,1);
      transition-delay: calc(var(--motion-child, 0) * 55ms);
    }
    body:is(.public-body, .dashboard-motion).motion-ready .motion-visible .motion-child { opacity: 1; transform: translateY(0); }
    @keyframes publicItemIn { from { opacity: 0.3; transform: translateY(16px) scale(0.99); } to { opacity: var(--motion-final-opacity, 1); transform: translateY(0) scale(1); } }
    body:is(.public-body, .dashboard-motion).motion-ready .motion-item {
      --motion-final-opacity: 1;
      opacity: var(--motion-final-opacity);
      transform: none;
      will-change: opacity, transform;
    }
    body:is(.public-body, .dashboard-motion).motion-ready .motion-visible .motion-item {
      animation: publicItemIn 0.58s cubic-bezier(0.16,1,0.3,1) both;
      animation-delay: calc(var(--motion-item, 0) * 58ms);
    }
    body:is(.public-body, .dashboard-motion).motion-ready .motion-item.rm-card-static { --motion-final-opacity: 0.72; }
    @media (prefers-reduced-motion: reduce) {
      .page-transition, .page-transition-mascot { transition: none; animation: none; }
      body:is(.public-body, .dashboard-motion).motion-ready header.nav,
      body:is(.public-body, .dashboard-motion).motion-ready main > section,
      body:is(.public-body, .dashboard-motion).motion-ready main > article,
      body:is(.public-body, .dashboard-motion).motion-ready .motion-child,
      body:is(.public-body, .dashboard-motion).motion-ready .motion-item { animation: none; opacity: var(--motion-final-opacity, 1); transform: none; transition: none; }
    }
    @media (pointer: coarse), (max-width: 880px) {
      body:is(.public-body, .dashboard-motion).motion-ready main > section,
      body:is(.public-body, .dashboard-motion).motion-ready main > article,
      body:is(.public-body, .dashboard-motion).motion-ready .motion-child,
      body:is(.public-body, .dashboard-motion).motion-ready .motion-item {
        animation: none;
        opacity: var(--motion-final-opacity, 1);
        transform: none;
        transition: none;
        will-change: auto;
      }
      body:is(.public-body, .dashboard-motion) header.nav {
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
      }
    }

    header.nav { position: sticky; top: 0; z-index: 40; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border-soft); }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; padding: 14px 28px; max-width: 1120px; margin: 0 auto; }
    .brand { display: flex; align-items: center; gap: 9px; text-decoration: none; font-family: var(--serif); font-size: 19px; font-weight: 600; color: var(--text); }
    .brand img { height: 28px; width: 28px; object-fit: contain; }
    nav.links { display: flex; align-items: center; gap: 30px; }
    nav.links a { font-size: 14.5px; color: var(--text-muted); text-decoration: none; }
    nav.links a:hover, nav.links a.active { color: var(--text); }
    .btn { display: inline-flex; align-items: center; gap: 8px; font-family: var(--sans); font-size: 14.5px; font-weight: 600; padding: 10px 18px; border-radius: 9px; border: 1px solid transparent; text-decoration: none; cursor: pointer; transition: transform 0.15s cubic-bezier(0.34,1.56,0.64,1), background 0.15s ease, border-color 0.15s ease; }
    .btn-accent { background: var(--accent); color: var(--accent-ink); position: relative; overflow: hidden; }
    .btn-accent::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(112deg, transparent 28%, rgba(255,255,255,0.22) 48%, transparent 68%); transform: translateX(-125%); transition: transform 0.6s cubic-bezier(0.16,1,0.3,1); }
    .btn-accent:hover::after { transform: translateX(125%); }
    .btn-accent:hover { transform: translateY(-1px) scale(1.02); }
    .btn-primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
    .btn-primary:hover { transform: translateY(-1px); }
    .btn-primary:disabled { background: var(--bg-raise); color: var(--text-dim); border-color: var(--border); opacity: .72; cursor: not-allowed; transform: none; }
    .btn-ghost { border-color: var(--border); color: var(--text); background: transparent; }
    .btn-ghost:hover { border-color: var(--text-dim); }
    .btn-sm { padding: 8px 14px; font-size: 13.5px; }

    /* The guild dashboard is a fixed-height "app" layout, its own two panels scroll internally, the outer page never does. */
    body.dash-body { height: 100vh; overflow: hidden; }

    /* Shared "search + checkbox list" pattern used across the dashboard for long role/channel pickers. */
    .dgl-filter-input { width: 100%; border: 1px solid var(--border); border-radius: 8px; padding: 6px 9px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 12px; margin-bottom: 5px; }
    .dgl-filter-input:focus { outline: 2px solid var(--accent-soft); border-color: var(--accent); }

    /* Dropdown reference of every {variable} token Petto resolves, click a row to copy it. */
    .dgl-varmenu-wrap { position: relative; display: inline-block; margin-top: 4px; }
    .dgl-varbtn { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-muted); background: var(--bg-raise); border: 1px solid var(--border); border-radius: 8px; padding: 6px 10px; cursor: pointer; font-family: var(--sans); }
    .dgl-varbtn:hover { color: var(--text); border-color: var(--text-dim); }
    .dgl-varbtn-caret { transition: transform 0.12s ease; }
    .dgl-varbtn.open .dgl-varbtn-caret { transform: rotate(180deg); }
    .dgl-varmenu { position: absolute; top: calc(100% + 6px); left: 0; z-index: 40; background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 10px; width: 340px; max-height: 420px; overflow-y: auto; box-shadow: 0 14px 30px -12px rgba(0,0,0,0.4); }
    .dgl-varmenu-hint { font-size: 10.5px; color: var(--text-dim); margin: 2px 4px 10px; line-height: 1.4; }
    .dgl-varmenu-group-label { font-size: 10px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.04em; margin: 10px 4px 4px; }
    .dgl-varmenu-row { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; width: 100%; background: transparent; border: none; text-align: left; padding: 5px 6px; border-radius: 6px; cursor: pointer; }
    .dgl-varmenu-row:hover { background: var(--card-hover); }
    .dgl-varmenu-row code { font-family: var(--mono); color: var(--accent); background: var(--accent-soft); padding: 1px 6px; border-radius: 4px; flex-shrink: 0; font-size: 11px; }
    .dgl-varmenu-row span { color: var(--text-dim); font-size: 11px; text-align: right; }
    .dgl-varmenu-row.copied code { background: var(--green-soft); color: var(--green); }

    .dgl-ms { position: relative; width: 100%; }
    .dgl-ms-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 6px; }
    .dgl-ms-chips:empty { display: none; }
    .dgl-ms-chip { display: inline-flex; align-items: center; gap: 6px; background: var(--accent-soft); color: var(--accent); border-radius: 7px; padding: 4px 6px 4px 10px; font-size: 12px; font-weight: 500; max-width: 100%; }
    .dgl-ms-chip span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dgl-ms-chip-remove { border: none; background: transparent; color: inherit; opacity: 0.7; cursor: pointer; display: flex; align-items: center; padding: 2px; border-radius: 4px; flex-shrink: 0; }
    .dgl-ms-chip-remove:hover { opacity: 1; background: rgba(0,0,0,0.12); }
    .dgl-ms-control { display: flex; align-items: center; gap: 6px; width: 100%; box-sizing: border-box; border: 1px solid var(--border); border-radius: 8px; padding: 7px 9px; background: var(--bg-raise); cursor: text; }
    .dgl-ms-control:focus-within { outline: 2px solid var(--accent-soft); border-color: var(--accent); }
    .dgl-ms-input { flex: 1; min-width: 0; border: none; background: transparent; color: var(--text); font-family: var(--sans); font-size: 12.5px; padding: 0; }
    .dgl-ms-input:focus { outline: none; }
    .dgl-ms-caret { flex-shrink: 0; color: var(--text-dim); transition: transform 0.12s ease; }
    .dgl-ms.open .dgl-ms-caret { transform: rotate(180deg); }
    .dgl-ms-dropdown { position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 30; background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 4px; max-height: 220px; overflow-y: auto; box-shadow: 0 14px 30px -12px rgba(0,0,0,0.4); }
    .dgl-ms-option { display: block; padding: 7px 9px; border-radius: 6px; font-size: 12.5px; color: var(--text-muted); cursor: pointer; }
    .dgl-ms-option:hover { background: var(--card-hover); color: var(--text); }
    .dgl-ms-option.dgl-ms-selected { display: none; }
    .dgl-ms-option.dgl-ms-nomatch { display: none; }
    .dgl-ms-empty { padding: 8px 9px; font-size: 12px; color: var(--text-dim); font-style: italic; }
    .theme-toggle { width: 34px; height: 34px; border-radius: 8px; border: 1px solid var(--border); background: transparent; color: var(--text-muted); cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .theme-toggle:hover { color: var(--text); border-color: var(--text-dim); }
    .lang-switch { position: relative; }
    .lang-menu { display: none; position: absolute; top: calc(100% + 8px); right: 0; background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 6px; min-width: 140px; box-shadow: 0 14px 30px -12px rgba(0,0,0,0.4); z-index: 50; }
    .lang-menu.open { display: block; }
    .lang-menu a { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 10px; border-radius: 7px; font-size: 13.5px; color: var(--text-muted); text-decoration: none; }
    .lang-menu a:hover { background: var(--card-hover); color: var(--text); }
    .lang-menu a.active { color: var(--accent); font-weight: 600; }
    .lang-menu a.active :global(svg) { color: var(--accent); }

    .mega { position: relative; }
    .mega-trigger { display: flex; align-items: center; gap: 5px; font-family: var(--sans); font-size: 14.5px; color: var(--text-muted); background: none; border: none; cursor: pointer; padding: 0; }
    .mega-trigger:hover { color: var(--text); }
    .mega-caret { transition: transform 0.18s ease; }
    .mega.open .mega-trigger { color: var(--text); }
    .mega.open .mega-caret { transform: rotate(180deg); }
    .mega-panel { display: none; position: absolute; top: calc(100% + 16px); left: 50%; transform: translateX(-50%); width: 460px; background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 18px; box-shadow: 0 24px 48px -16px rgba(0,0,0,0.45); z-index: 50; grid-template-columns: 150px 1fr; gap: 4px; }
    .mega-panel.mega-panel-wide { width: 680px; grid-template-columns: 160px 1fr; }
    .mega.open .mega-panel { display: grid; }
    .mega-brand { display: flex; flex-direction: column; align-items: flex-start; padding: 14px 14px 14px 4px; border-right: 1px solid var(--border-soft); }
    .mega-brand img { height: 34px; width: 34px; object-fit: contain; margin-bottom: 10px; }
    .mega-brand-name { font-family: var(--serif); font-size: 16px; font-weight: 600; color: var(--text); }
    .mega-brand-tag { font-size: 12.5px; color: var(--text-dim); line-height: 1.5; margin: 8px 0 0; }
    .mega-list { display: flex; flex-direction: column; padding-left: 8px; }
    .mega-list-wide { display: grid; grid-template-columns: 1fr 1fr; gap: 0 6px; }
    .mega-item { display: flex; align-items: flex-start; gap: 10px; padding: 9px 10px; border-radius: 10px; text-decoration: none; }
    a.mega-item:hover { background: var(--card-hover); }
    .mega-item.disabled { opacity: 0.55; cursor: default; }
    .mega-item :global(.mega-ic) { width: 17px; height: 17px; color: var(--accent); margin-top: 2px; flex-shrink: 0; }
    .mega-item-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .mega-item-title { font-size: 13.5px; font-weight: 600; color: var(--text); display: flex; align-items: center; flex-wrap: wrap; gap: 4px 6px; white-space: nowrap; }
    .mega-badge { font-family: var(--mono); font-style: normal; font-size: 9.5px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--accent); background: var(--accent-soft); padding: 2px 6px; border-radius: 5px; }
    .mega-item-desc { font-size: 12px; color: var(--text-dim); line-height: 1.4; }
    .premium-link { display: flex; align-items: center; gap: 5px; color: #d9a441; font-weight: 600; }
    .premium-link:hover .premium-shine { filter: brightness(1.2); }

    .premium-shine {
      background: linear-gradient(90deg, #d9a441 0%, #fde52f 22%, #fff6cc 45%, #fde52f 68%, #d9a441 100%);
      background-size: 220% auto;
      -webkit-background-clip: text; background-clip: text; color: transparent;
      animation: premium-shine 3.2s linear infinite;
    }
    @keyframes premium-shine { to { background-position: -220% center; } }

    .foot-premium-link { display: flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; text-decoration: none; margin-bottom: 11px; }
    .foot-premium-link :global(svg) { color: #d9a441; flex-shrink: 0; }
    .status-link { display: flex; align-items: center; gap: 7px; }
    .status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 3px var(--green-soft); }

    section { padding: 88px 0; }
    section.alt { background: var(--bg-raise); border-top: 1px solid var(--border-soft); border-bottom: 1px solid var(--border-soft); }
    .sec-head { max-width: 640px; margin-bottom: 50px; }
    .sec-head .eyebrow { margin-bottom: 14px; }
    .sec-head h2 { font-size: 32px; margin-bottom: 14px; }
    .sec-head p { color: var(--text-muted); font-size: 16px; max-width: 54ch; }

    footer { border-top: 1px solid var(--border-soft); padding: 60px 0 34px; }
    .foot-grid { display: grid; grid-template-columns: 1.4fr repeat(3, 1fr); gap: 40px; margin-bottom: 46px; }
    .foot-brand { display: flex; align-items: center; gap: 9px; margin-bottom: 12px; font-family: var(--serif); font-size: 17px; font-weight: 600; }
    .foot-brand img { height: 22px; width: 22px; object-fit: contain; }
    .foot-desc { font-size: 13.5px; color: var(--text-dim); max-width: 30ch; }
    .foot-col .ft { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 14px; }
    .foot-col a, .foot-col .foot-disabled { display: flex; align-items: center; gap: 6px; font-size: 14px; color: var(--text-muted); text-decoration: none; margin-bottom: 11px; }
    .foot-col a:hover { color: var(--text); }
    .foot-col .foot-disabled { color: var(--text-dim); }
    .foot-badge { font-family: var(--mono); font-style: normal; font-size: 9px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-dim); background: var(--border-soft); padding: 1px 5px; border-radius: 5px; }
    .foot-bottom { display: flex; justify-content: space-between; align-items: center; padding-top: 26px; border-top: 1px solid var(--border-soft); font-size: 12.5px; color: var(--text-dim); }

    .nav-burger {
      display: none; align-items: center; justify-content: center; width: 34px; height: 34px;
      border-radius: 8px; background: none; border: 1px solid var(--border); color: var(--text); cursor: pointer;
    }
    .nav-burger:hover { background: var(--card-hover); }
    .nav-burger-close-ic { display: none; }
    .nav-burger.open .nav-burger-open-ic { display: none; }
    .nav-burger.open .nav-burger-close-ic { display: block; }

    .mobile-nav {
      display: none; position: fixed; top: var(--dgl-header-h, 60px); left: 0; right: 0; bottom: 0;
      background: var(--bg); z-index: 90; overflow-y: auto;
    }
    .mobile-nav.open { display: block; }
    .mobile-nav-inner { padding: 16px 20px 40px; display: flex; flex-direction: column; gap: 2px; max-width: 520px; margin: 0 auto; }
    .mobile-nav-label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-dim); margin: 18px 0 6px; }
    .mobile-nav-label:first-child { margin-top: 4px; }
    .mobile-nav-link { display: flex; align-items: center; gap: 10px; padding: 12px 10px; border-radius: 10px; text-decoration: none; color: var(--text); font-size: 15px; }
    .mobile-nav-link:hover { background: var(--card-hover); }
    .mobile-nav-link :global(svg) { color: var(--text-dim); flex-shrink: 0; }
    .mobile-nav-divider { height: 1px; background: var(--border-soft); margin: 14px 0; }
    .mobile-nav-cta { justify-content: center; margin-bottom: 4px; }
    .mobile-nav-row { display: flex; }
    .mobile-nav-theme {
      display: flex; align-items: center; gap: 10px; width: 100%; padding: 12px 10px; border-radius: 10px;
      background: none; border: none; color: var(--text); font-size: 15px; font-family: var(--sans); cursor: pointer; text-align: left;
    }
    .mobile-nav-theme:hover { background: var(--card-hover); }
    .mobile-nav-theme :global(svg) { color: var(--text-dim); flex-shrink: 0; }
    .mobile-nav-langs { display: flex; flex-direction: column; }
    .mobile-nav-langs a { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 10px; border-radius: 10px; text-decoration: none; color: var(--text-muted); font-size: 14px; }
    .mobile-nav-langs a:hover { background: var(--card-hover); color: var(--text); }
    .mobile-nav-langs a.active { color: var(--accent); font-weight: 600; }
    .mobile-nav-langs a.active :global(svg) { color: var(--accent); }

    @media (max-width: 880px) {
      nav.links { display: none; }
      .nav-burger { display: flex; }
      .nav-desktop-only { display: none; }
      .foot-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 560px) {
      body.public-body header.nav .nav-inner { padding: 9px 14px; gap: 10px; }
      body.public-body .brand { min-width: 0; gap: 7px; font-size: 18px; }
      body.public-body .brand img { width: 28px; height: 28px; }
      body.public-body header.nav .nav-inner > div:last-child { gap: 8px; }
      body.public-body .nav-burger { width: 42px; height: 42px; border-radius: 10px; }
      body.public-body .mobile-nav-inner { padding: 14px 14px 28px; }
      body.public-body .mobile-nav-cta { width: 100%; min-height: 46px; }
      .mega-panel { width: 90vw; left: 0; transform: none; grid-template-columns: 1fr; }
      .mega-brand { border-right: none; border-bottom: 1px solid var(--border-soft); flex-direction: row; align-items: center; padding: 8px 4px 14px; }
      .mega-brand img { margin-bottom: 0; margin-right: 10px; }
      .mega-list-wide { grid-template-columns: 1fr; }
    }

    .cookie-banner {
      position: fixed; bottom: 20px; right: 20px; z-index: 100; width: 300px;
      background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 18px;
      box-shadow: 0 24px 48px -20px rgba(0,0,0,0.55);
    }
    .cookie-text { font-size: 13px; color: var(--text-muted); line-height: 1.5; margin: 0 0 14px; }
    .cookie-btns { display: flex; flex-direction: column; gap: 8px; }
    .cookie-btn {
      display: block; width: 100%; text-align: center; padding: 10px 14px; border-radius: 999px;
      font-family: var(--sans); font-size: 13px; font-weight: 600; cursor: pointer; text-decoration: none;
      border: 1px solid transparent; box-sizing: border-box;
    }
    .cookie-btn-accent { background: var(--card-hover); color: var(--text); border-color: var(--border); }
    .cookie-btn-accent:hover { border-color: var(--text-dim); }
    .cookie-btn-ghost { background: var(--card-hover); color: var(--text-muted); border-color: var(--border); }
    .cookie-btn-ghost:hover { color: var(--text); }
    .cookie-btn-outline { background: none; color: var(--text-muted); border: 1px dashed var(--border); }
    .cookie-btn-outline:hover { color: var(--text); border-color: var(--text-dim); }
    .cookie-privacy-link { display: block; text-align: center; margin-top: 12px; font-size: 12px; color: var(--accent); text-decoration: none; }
    .cookie-privacy-link:hover { text-decoration: underline; }

    @media (max-width: 400px) {
      .cookie-banner { left: 12px; right: 12px; width: auto; bottom: 12px; }
    }
  </style>
  <style is:global>
    /* Slotted dashboard content is rendered by child Astro components, so this
       visibility rule must be global rather than scoped to Base.astro. */
    body.dashboard-motion .reveal { opacity: 1; transform: none; transition: none; }
  </style>
</head>
<body class:list={{ 'dash-body': appShell, 'public-body': active !== 'dash', 'dashboard-motion': active === 'dash' }}>
  <div class="page-transition" id="pageTransition" aria-hidden="true">
    <img class="page-transition-mascot" src="/assets/mascot-icon.png" alt="" />
  </div>
  <header class="nav">
    <div class="nav-inner">
      <a class="brand" href={`${base}/`}>
        <img src="/assets/mascot-icon.png" alt="" />
        Petto
      </a>
      <nav class="links">
        <div class="mega">
          <button class="mega-trigger" id="productTrigger" aria-expanded="false">
            {t.nav.product}
            <InlineIcon name="ph:caret-down" class="mega-caret" width="12" height="12" />
          </button>
          <div class="mega-panel" id="productPanel">
            <div class="mega-brand">
              <img src="/assets/mascot-icon.png" alt="" />
              <div class="mega-brand-name">Petto</div>
              <p class="mega-brand-tag">{t.nav.menu.product.tagline}</p>
            </div>
            <div class="mega-list">
              {t.nav.menu.product.items.map((it) => (
                it.href && String(it.href) !== '#' ? (
                  <a class="mega-item" href={hrefFor(it.href)} target={isExternal(it.href) ? '_blank' : undefined} rel={isExternal(it.href) ? 'noopener' : undefined}>
                    <NavIcon name={it.icon} class="mega-ic" />
                    <span class="mega-item-body">
                      <span class="mega-item-title">{it.title}{it.badge && <em class="mega-badge">{it.badge}</em>}</span>
                      <span class="mega-item-desc">{it.desc}</span>
                    </span>
                  </a>
                ) : (
                  <span class="mega-item disabled">
                    <NavIcon name={it.icon} class="mega-ic" />
                    <span class="mega-item-body">
                      <span class="mega-item-title">{it.title}{it.badge && <em class="mega-badge">{it.badge}</em>}</span>
                      <span class="mega-item-desc">{it.desc}</span>
                    </span>
                  </span>
                )
              ))}
            </div>
          </div>
        </div>
        <div class="mega">
          <button class="mega-trigger" id="communityTrigger" aria-expanded="false">
            {t.nav.community}
            <InlineIcon name="ph:caret-down" class="mega-caret" width="12" height="12" />
          </button>
          <div class="mega-panel mega-panel-wide" id="communityPanel">
            <div class="mega-brand">
              <img src="/assets/mascot-icon.png" alt="" />
              <div class="mega-brand-name">Petto</div>
              <p class="mega-brand-tag">{t.nav.menu.community.tagline}</p>
            </div>
            <div class="mega-list mega-list-wide">
              {t.nav.menu.community.items.map((it) => (
                it.href && String(it.href) !== '#' ? (
                  <a class="mega-item" href={hrefFor(it.href)} target={isExternal(it.href) ? '_blank' : undefined} rel={isExternal(it.href) ? 'noopener' : undefined}>
                    <NavIcon name={it.icon} class="mega-ic" />
                    <span class="mega-item-body">
                      <span class="mega-item-title">{it.title}{it.badge && <em class="mega-badge">{it.badge}</em>}</span>
                      <span class="mega-item-desc">{it.desc}</span>
                    </span>
                  </a>
                ) : (
                  <span class="mega-item disabled">
                    <NavIcon name={it.icon} class="mega-ic" />
                    <span class="mega-item-body">
                      <span class="mega-item-title">{it.title}{it.badge && <em class="mega-badge">{it.badge}</em>}</span>
                      <span class="mega-item-desc">{it.desc}</span>
                    </span>
                  </span>
                )
              ))}
            </div>
          </div>
        </div>
        <a href="https://wiki.petto.sbs" target="_blank" rel="noopener">{t.nav.docs}</a>
        <a class="premium-link" href={`${base}/premium`}>
          <InlineIcon name="ph:crown-fill" width="14" height="14" />
          <span class="premium-shine">{t.nav.premium}</span>
        </a>
        <a class="status-link" href={`${base}/status`}>
          <span class="status-dot"></span>
          {t.nav.status}
        </a>
      </nav>
      <div style="display:flex; align-items:center; gap:12px;">
        <div class="lang-switch nav-desktop-only">
          <button class="theme-toggle lang-btn" id="langToggle" aria-label="Change language" title="Change language">
            <InlineIcon name="ph:globe" width="16" height="16" />
