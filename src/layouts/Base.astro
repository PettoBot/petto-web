---
import { buildLabel, buildTitle, buildInfo } from '../utils/buildInfo';
import { LOCALIZED_ROUTES } from '../utils/localizedRoutes';
import InlineIcon from '../components/InlineIcon.astro';
import NavIcon from '../components/NavIcon.astro';
import DashPanelKit from '../components/DashPanelKit.astro';
import GlassDock from '../components/GlassDock.astro';
import LiquidGlass from '../components/LiquidGlass.astro';
import NavAccount from '../components/NavAccount.astro';
import SpecularButton from '../react/SpecularButton.jsx';
import { useTranslations, localePath, type Locale } from '../i18n/ui';
import { getDashLang } from '../i18n/dash';
import { discordEmbedJson } from '../data/discordEmbed';
import { pageImage, pageImagePath } from '../data/pageImages';
import DashLoader from '../components/DashLoader.astro';
import TextFit from '../components/TextFit.astro';
import { isStillNew } from '../utils/newBadge';
import DashSelectMenu from '../components/DashSelectMenu.astro';
import '../styles/skin-ash.css';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'commands' | 'docs' | 'dash';
  lang?: Locale;
  showFooter?: boolean;
  /** Only the guild dashboard's fixed two-panel app shell needs the body scroll lock, plain dash pages (login, manage) scroll normally. */
  appShell?: boolean;
  /** A feed of the page (the changelog's RSS), announced in the head so readers and bots find it from the page's address. */
  feed?: { title: string; href: string };
  /** A page that only sends people somewhere else (the share address of a feature): kept out of search results. */
  noindex?: boolean;
  /** The look of the public pages that were redesigned (the home, Features, Premium, Commands): ash greys, in the dark theme only. */
  skin?: 'ash';
}
// One short line about the bot, for the pages that do not have their own (search results and link previews cut longer ones).
const DEFAULT_DESCRIPTION: Record<Locale, string> = {
  en: 'Moderation, tickets, levels and giveaways for your Discord server, with a web dashboard.',
  es: 'Moderación, tickets, niveles y sorteos para tu servidor de Discord, con un dashboard web.',
  'pt-BR': 'Moderação, tickets, níveis e sorteios para o seu servidor do Discord, com um dashboard web.',
};
// The badge of a menu or footer item ("New"): it shows only while the item is new (`since`, a day YYYY-MM-DD), so it goes by itself.
const badgeOf = (item: { badge?: string; since?: string }): string => (item.badge && isStillNew(item.since) ? item.badge : '');
const { title, description, active = 'home', lang: langProp, showFooter = active !== 'dash', appShell = false, feed, noindex = false, skin } = Astro.props;
// Dashboard pages have no locale in the URL, so their language comes from the saved choice.
const lang: Locale = langProp ?? (active === 'dash' ? getDashLang(Astro) : 'en');
// Dashboard pages (and the app shell) keep the header's call-to-action as plain HTML and CSS; elsewhere its shine loads when the
// browser is idle (or when the mobile menu shows it), not before the page is usable.
const staticCta = appShell || active === 'dash';
const t = useTranslations(lang);
const base = localePath[lang];
// The language picker: each language in its own words, with a flag drawn as a local SVG (emoji flags do not render on Windows).
const langOptions: { code: Locale; label: string; short: string; flag: string }[] = [
  { code: 'en', label: 'English', short: 'EN', flag: '/assets/flags/us.svg' },
  { code: 'es', label: 'Español', short: 'ES', flag: '/assets/flags/es.svg' },
  { code: 'pt-BR', label: 'Português (Brasil)', short: 'PT', flag: '/assets/flags/br.svg' },
];
const langNow = langOptions.find((o) => o.code === lang) ?? langOptions[0];
const langWord = lang === 'en' ? 'Language' : 'Idioma';
const langLabel = `${langWord}: ${langNow.label}`;
const currentRoute = Astro.url.pathname.replace(/^\/(?:es|pt-br)(?=\/|$)/, '') || '/';
const languageHref = (target: Locale) => {
  if (active === 'dash' || currentRoute === '/dash' || currentRoute.startsWith('/dash/')) return `/dash/lang?to=${encodeURIComponent(target)}&next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;
  if (target === 'en') return currentRoute;
  return `${localePath[target]}${currentRoute === '/' ? '/' : currentRoute}`;
};
const isExternal = (href: string) => /^https?:\/\//.test(href);
// The footer keeps the main links only (the full lists are in the menus at the top): the rest of the site is one click from there.
const FOOTER_PRODUCT = ['/features', '/commands', '/dash', '/embed-builder', 'https://code.petto.sbs'];
const FOOTER_COMMUNITY = ['https://petto.sbs/support', '/team', '/status', '/changelog', '/blog', '/faq'];
const inFooter = (list: string[]) => (it: { href?: string }) => Boolean(it.href) && list.includes(String(it.href));
// Links to the other public pages are fetched while the pointer rests on them (Astro prefetch), so they open at once.
// The dashboard and outside links are left alone.
const prefetchFor = (href: string) => (isExternal(href) || /(?:^|\/)dash(?:[/?#]|$)/.test(href) ? undefined : 'hover');
// The address of the page as people share it and as the site links it: the path only (never ?v= of a reload or other parameters),
// without a trailing slash, except the home of each language (/, /es/, /pt-br/), the way the menus and the language switch link it.
const SITE = Astro.site ?? 'https://petto.sbs';
const canonicalPath = Astro.url.pathname.replace(/\/index(?:\.html)?$/, '/').replace(/(.)\/+$/, '$1').replace(/^\/(es|pt-br)$/, '/$1/');
const canonicalUrl = new URL(canonicalPath, SITE).toString();
// Every page shares a picture drawn for it (src/data/ogCards.mjs): its own card, the card of the page it is under, or the home one.
const pagePicture = pageImage(canonicalPath);
const ogImageUrl = new URL(pageImagePath(pagePicture), SITE).toString();
const ogImageAlt = pagePicture.alt;
// What the preview says (the card Discord draws and the Open Graph tags). A page that has a card of its own says what that card says (src/data/previewText.mjs):
// a title that says what the page is and carries the brand, and a description of one or two concrete sentences. Any other page keeps its own title (with the
// brand added when it lacks it) and its own description, or the one of the card it is under.
const brandOf = (text: string) => (/Petto/.test(text) ? text : `${text} · Petto`);
const previewTitle = pagePicture.exact ? pagePicture.embedTitle : brandOf(title);
const metaDescription = pagePicture.exact ? pagePicture.description : (description ?? (pagePicture.description || pagePicture.tagline || DEFAULT_DESCRIPTION[lang]));
// The same page in the other languages, for search engines and apps (hreflang), when the page has them: the dashboard has no
// language in the address, and a few pages exist in English only.
const OG_LOCALE: Record<Locale, string> = { en: 'en_US', es: 'es_ES', 'pt-BR': 'pt_BR' };
const HREFLANG: Record<Locale, string> = { en: 'en', es: 'es', 'pt-BR': 'pt-BR' };
const routeNoSlash = currentRoute.replace(/(.)\/+$/, '$1');
const hasLanguages = active !== 'dash' && !routeNoSlash.startsWith('/dash') && LOCALIZED_ROUTES.some((re) => re.test(routeNoSlash));
const alternates = hasLanguages
  ? (Object.keys(localePath) as Locale[]).map((l) => ({ lang: l, href: new URL(`${localePath[l]}${routeNoSlash === '/' ? '/' : routeNoSlash}`, SITE).toString() }))
  : [];

const cookieCopy = {
  en: { text: 'By using this site, you agree with our use of cookies.', consent: 'I consent to cookies', decline: 'Decline all', more: 'Want to know more?', privacy: 'Privacy policy' },
  es: { text: 'Al usar este sitio, aceptas nuestro uso de cookies.', consent: 'Acepto las cookies', decline: 'Rechazar todo', more: '¿Quieres saber más?', privacy: 'Política de privacidad' },
  'pt-BR': { text: 'Ao usar este site, você concorda com o uso de cookies.', consent: 'Aceito os cookies', decline: 'Recusar tudo', more: 'Quer saber mais?', privacy: 'Política de privacidade' },
}[lang];
// Inside the dashboard links stay un-prefixed. From the public site, /es/dash and /pt-br/dash set the dashboard language and continue to /dash.
const bypassLocale = (href: string) => href.startsWith('/dash') && active === 'dash';
const hrefFor = (href: string) => (isExternal(href) || bypassLocale(href) ? href : `${base}${href}`);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <script is:inline define:vars={{ pageVersion: buildInfo.builtAt }}>
    // A copy of this page kept by Cloudflare or the browser can belong to an older deploy. The version that is live now is asked once
    // (a unique address, so no cache answers it); when it is newer, the page loads itself again once with that version in the address,
    // which no cache has seen yet. The dashboard is never kept, so it is left alone.
    (function () {
      if (location.pathname.indexOf('/dash') !== -1) return;
      // Loaded again for this version (?v=<version>): the address goes back to the clean one, so it is the one people copy and share.
      try {
        var here = new URL(location.href);
        if (here.searchParams.get('v') === pageVersion) { here.searchParams.delete('v'); history.replaceState(history.state, '', here.pathname + here.search + here.hash); }
      } catch (e) { /* an old browser keeps the address */ }
      fetch('/version.json?t=' + Date.now(), { cache: 'no-store' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (live) {
          // What is compared is the moment of the build, not the version number of package.json: a deploy that did not change the number
          // (most of them) used to leave the old copy of a static page, such as Premium, in place for hours.
          if (!live || !live.builtAt) return;
          // The number in the footer is always the live one, even on a copy that is kept (it is written again as soon as the page can be read).
          if (live.version) {
            var showVersion = function () { var spots = document.querySelectorAll('[data-web-version]'); for (var i = 0; i < spots.length; i++) spots[i].textContent = 'Web v' + live.version; };
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', showVersion); else showVersion();
          }
          if (live.builtAt === pageVersion) return;
          // One reload for each page: the mark is of the page (not of the whole visit), so a second old page that the browser kept is also loaded again.
          var key = 'petto-reloaded:' + location.pathname;
          try { if (sessionStorage.getItem(key) === live.builtAt) return; sessionStorage.setItem(key, live.builtAt); } catch (e) { return; }
          var url = new URL(location.href);
          url.searchParams.set('v', live.builtAt);
          location.replace(url.toString());
        })
        .catch(function () {});
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={metaDescription} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <!-- The color of the browser bar and of the installed app's top bar: the color of the page itself, so the bar does not stand out. -->
  <meta name="theme-color" content="#111113" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <script is:inline>
    // A theme chosen by hand (the theme switch) wins over the phone's own setting.
    (function () {
      var colors = { dark: '#111113', light: '#ffffff' };
      var apply = function () {
        var theme = document.documentElement.getAttribute('data-theme');
        if (!colors[theme]) return;
        document.querySelectorAll('meta[name="theme-color"]').forEach(function (meta) { meta.removeAttribute('media'); meta.setAttribute('content', colors[theme]); });
      };
      apply();
      try { new MutationObserver(apply).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] }); } catch (e) { /* the bar keeps its color */ }
    })();
  </script>
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="apple-touch-icon" href="/assets/pwa/apple-touch-180.png" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Petto" />
  <link rel="canonical" href={canonicalUrl} />
  {feed && <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />}
  {alternates.map((a) => <link rel="alternate" hreflang={HREFLANG[a.lang]} href={a.href} />)}
  {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
  <link rel="icon" href="/assets/mascot-icon.png" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Petto" />
  <meta property="og:title" content={previewTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content={OG_LOCALE[lang]} />
  {alternates.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={OG_LOCALE[a.lang]} />)}
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:type" content="image/webp" />
  <meta property="og:image:width" content={String(pagePicture.width)} />
  <meta property="og:image:height" content={String(pagePicture.height)} />
  <meta property="og:image:alt" content={ogImageAlt} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={previewTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImageUrl} />
  {active !== 'dash' && <script is:inline id="discord:component-embed" type="application/json" set:html={discordEmbedJson(lang, { title: previewTitle, description: metaDescription, url: canonicalUrl, image: { url: ogImageUrl, alt: ogImageAlt }, accent: pagePicture.accent })}></script>}
  <style is:global>
    @font-face {
      font-family: 'Jakarta Variable';
      src: url('/fonts/dash/plus-jakarta-sans-latin-wght-normal.woff2') format('woff2-variations');
      font-weight: 200 800;
      font-style: normal;
      font-display: swap;
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: 'Jakarta Variable';
      src: url('/fonts/dash/plus-jakarta-sans-latin-ext-wght-normal.woff2') format('woff2-variations');
      font-weight: 200 800;
      font-style: normal;
      font-display: swap;
      unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
    }
    @font-face {
      font-family: 'Fraunces Variable';
      src: url('/fonts/dash/fraunces-latin-wght-normal.woff2') format('woff2-variations');
      font-weight: 100 900;
      font-style: normal;
      font-display: swap;
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: 'Fraunces Variable';
      src: url('/fonts/dash/fraunces-latin-ext-wght-normal.woff2') format('woff2-variations');
      font-weight: 100 900;
      font-style: normal;
      font-display: swap;
      unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
    }
    @font-face {
      font-family: 'Fraunces Variable';
      src: url('/fonts/dash/fraunces-latin-wght-italic.woff2') format('woff2-variations');
      font-weight: 100 900;
      font-style: italic;
      font-display: swap;
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: 'Petto Sans';
      src: url('/fonts/petto-sans.woff2') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Petto Sans';
      src: url('/fonts/petto-sans-bold.woff2') format('woff2');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }
  </style>
  <style is:global>
    :root {
      /* Dark, a step each (page, raised, card, hover). The public pages use these; the dashboard is a little darker (see body.dashboard-motion below). */
      --bg: #111113;
      --bg-raise: #17171a;
      --card: #1c1c20;
      --card-hover: #25252a;
      --border: #2c2c32;
      --border-soft: #222227;
      --text: #f2f1ed;
      --text-muted: #a8a49c;
      --text-dim: #79756d;
      --accent: #f0a88f;
      --accent-soft: rgba(240, 168, 143, 0.14);
      --accent-ink: #2b1a13;
      --blue: #9bd0f5;
      --blue-soft: rgba(155, 208, 245, 0.14);
      --green: #a5ea7a;
      --green-soft: rgba(165, 234, 122, 0.14);
      --green-ink: #10220a;
      --yellow: #fed53c;
      --yellow-soft: rgba(254, 213, 60, 0.14);
      --red: #fe6465;
      --red-soft: rgba(254, 100, 101, 0.14);
      /* The text on a soft color of its own: light (dark theme) or deep (light theme) and legible, never the bright color itself; the bright color is the mark (border, dot, icon). */
      --green-text: #e9fbdc; --yellow-text: #fff2bf; --red-text: #ffe4e4; --accent-text: #ffe9e1;
      /* The marks of the charts (bars, lines) are calmer than the numbers: the bright green and red stay for the small figures. */
      --chart-green: #86b894; --chart-red: #c98791;
      /* One pair of faces for the whole site: Fraunces for titles, Plus Jakarta Sans for everything else. */
      --serif: 'Fraunces Variable', Iowan Old Style, "Palatino Linotype", Georgia, "Times New Roman", serif;
      --sans: 'Jakarta Variable', -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      --mono: ui-monospace, "SFMono-Regular", "Cascadia Code", Consolas, monospace;
    }
    :root[data-theme="light"] {
      --bg: #ffffff; --bg-raise: #ffffff; --card: #ffffff; --card-hover: #f7f8fa;
      --border: #e3e6eb; --border-soft: #edf0f3; --text: #20242b; --text-muted: #66707d; --text-dim: #8c96a3;
      --accent: #bd5136; --accent-soft: rgba(189, 81, 54, 0.09); --accent-ink: #ffffff;
      --blue: #2f6fa8; --blue-soft: rgba(47, 111, 168, 0.1);
      --green: #458026; --green-soft: rgba(69, 128, 38, 0.1); --green-ink: #ffffff;
      --yellow: #93720a; --yellow-soft: rgba(147, 114, 10, 0.1);
      --red: #c23c3d; --red-soft: rgba(194, 60, 61, 0.1);
      --green-text: #1f4a0c; --yellow-text: #5a4305; --red-text: #7c1d1e; --accent-text: #6b2512;
      --chart-green: #3f7a52; --chart-red: #a85565;
    }
    @media (prefers-color-scheme: light) {
      :root:not([data-theme="dark"]) {
        --bg: #ffffff; --bg-raise: #ffffff; --card: #ffffff; --card-hover: #f7f8fa;
        --border: #e3e6eb; --border-soft: #edf0f3; --text: #20242b; --text-muted: #66707d; --text-dim: #8c96a3;
        --accent: #bd5136; --accent-soft: rgba(189, 81, 54, 0.09); --accent-ink: #ffffff;
        --blue: #2f6fa8; --blue-soft: rgba(47, 111, 168, 0.1);
        --green: #458026; --green-soft: rgba(69, 128, 38, 0.1); --green-ink: #ffffff;
        --yellow: #93720a; --yellow-soft: rgba(147, 114, 10, 0.1);
        --red: #c23c3d; --red-soft: rgba(194, 60, 61, 0.1);
      --green-text: #1f4a0c; --yellow-text: #5a4305; --red-text: #7c1d1e; --accent-text: #6b2512;
        --chart-green: #3f7a52; --chart-red: #a85565;
      }
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; background-color: var(--bg); }
    /* In the installed app the page can reach under the phone's bottom bar; the strip there takes the color of the page, not white. */
    body { padding-bottom: env(safe-area-inset-bottom, 0px); }
    body { margin: 0; background: var(--bg); color: var(--text); font-family: var(--sans); font-size: 16px; line-height: 1.55; -webkit-font-smoothing: antialiased; }
    body.public-body {
      font-family: var(--sans);
      overflow-x: hidden;
    }
    body.dashboard-motion {
      /* The dashboard is a tool people read and type in all day: a clear UI face for text and fields, an elegant serif for the titles. */
      --sans: 'Jakarta Variable', -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      --serif: 'Fraunces Variable', Iowan Old Style, "Palatino Linotype", Georgia, serif;
      font-family: var(--sans);
      font-size: 14px;
      overflow-x: hidden;
    }
    /* Clear whites in the dark dashboard: titles and text read at a glance (the background stays the same dark grey). */
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) body.dashboard-motion { --text: #f7f6f3; --text-muted: #b9b5ad; --text-dim: #9a968f; }
    }
    :root[data-theme="dark"] body.dashboard-motion { --text: #f7f6f3; --text-muted: #b9b5ad; --text-dim: #9a968f; }
    /* The dashboard in dark is near black (page, then panel, then cards one step lighter each), like the tools people leave open all day: the sidebar uses
       --dgl-side-bg and the content panel --dgl-panel-bg. The light theme keeps what it had. */
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) body.dashboard-motion {
        --bg: #0a0a0a; --bg-raise: #111113; --card: #151517; --card-hover: #1d1c21; --border: #27272c; --border-soft: #1d1d21;
        --dgl-side-bg: #0a0a0a; --dgl-panel-bg: #111113;
      }
    }
    :root[data-theme="dark"] body.dashboard-motion {
      --bg: #0a0a0a; --bg-raise: #111113; --card: #151517; --card-hover: #1d1c21; --border: #27272c; --border-soft: #1d1d21;
      --dgl-side-bg: #0a0a0a; --dgl-panel-bg: #111113;
    }
    /* The same clear whites on the public pages in dark: more contrast for the small grey text, same dark grey background. */
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) body.public-body { --text: #f7f6f3; --text-muted: #b9b5ad; --text-dim: #9a968f; }
    }
    :root[data-theme="dark"] body.public-body { --text: #f7f6f3; --text-muted: #b9b5ad; --text-dim: #9a968f; }
    img, svg { display: block; max-width: 100%; }
    a { color: inherit; }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 28px; }
    /* One 16px gutter for the public pages on phones, the same as the top bar. */
    @media (max-width: 560px) { body.public-body .wrap { padding-left: 16px; padding-right: 16px; } }
