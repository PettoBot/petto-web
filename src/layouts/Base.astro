  <div class="cookie-banner" id="cookieBanner" hidden>
    <p class="cookie-text">{cookieCopy.text}</p>
    <div class="cookie-btns">
      <button type="button" class="cookie-btn cookie-btn-accent" id="cookieAccept">{cookieCopy.consent}</button>
      <button type="button" class="cookie-btn cookie-btn-ghost" id="cookieDecline">{cookieCopy.decline}</button>
      <a class="cookie-btn cookie-btn-outline" href={`${base}/privacy`}>{cookieCopy.more}</a>
    </div>
    <a class="cookie-privacy-link" href={`${base}/privacy`}>{cookieCopy.privacy}</a>
  </div>

  <script>
    (function () {
      var isPublic = document.body.classList.contains('public-body');
      var isDashboard = document.body.classList.contains('dashboard-motion');
      if (!isPublic && !isDashboard) return;
      var usesTouchNavigation = window.matchMedia('(hover: none), (pointer: coarse)').matches;
      document.body.classList.add('page-entering');
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          document.body.classList.add('page-loaded');
        });
      });

      if (usesTouchNavigation) return;
      document.addEventListener('click', function (event) {
        if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        var target = event.target instanceof Element ? event.target : null;
        var link = target && target.closest ? target.closest('a') : null;
        if (!link || link.target === '_blank' || link.hasAttribute('download')) return;
        var href = link.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) return;
        var destination;
        try { destination = new URL(link.href, window.location.href); } catch (e) { return; }
        if (destination.origin !== window.location.origin || (destination.pathname === window.location.pathname && destination.hash)) return;
        // Links inside a part marked data-no-loader (the feedback board) and links that only change the filters of the same page go at once, without the full-screen loader.
        if (link.closest('[data-no-loader]') || destination.pathname === window.location.pathname) return;
        event.preventDefault();
        document.body.classList.remove('page-loaded');
        document.body.classList.add('page-leaving');
        window.setTimeout(function () { window.location.assign(destination.href); }, 220);
      });
    })();

    var megaPairs = [
      { trigger: 'productTrigger', panel: 'productPanel' },
      { trigger: 'communityTrigger', panel: 'communityPanel' },
    ];
    // The panel is centred under its button; on a narrow window (or a phone in desktop mode) that can push it past the edge of the screen,
    // so once it is open it is moved back inside by the amount it sticks out.
    function keepMegaInside(wrap) {
      var panel = wrap?.querySelector('.mega-panel');
      if (!panel) return;
      panel.style.setProperty('--mega-shift', '0px');
      var box = panel.getBoundingClientRect();
      var margin = 12;
      var shift = 0;
      if (box.left < margin) shift = margin - box.left;
      else if (box.right > window.innerWidth - margin) shift = window.innerWidth - margin - box.right;
      if (shift) panel.style.setProperty('--mega-shift', Math.round(shift) + 'px');
    }
    megaPairs.forEach(function (pair) {
      var trigger = document.getElementById(pair.trigger);
      var wrap = trigger?.closest('.mega');
      trigger?.addEventListener('click', function (e) {
        e.stopPropagation();
        var isOpen = wrap?.classList.contains('open');
        megaPairs.forEach(function (p) { document.getElementById(p.trigger)?.closest('.mega')?.classList.remove('open'); });
        if (!isOpen) { wrap?.classList.add('open'); keepMegaInside(wrap); }
      });
    });
    document.addEventListener('click', function () {
      megaPairs.forEach(function (p) { document.getElementById(p.trigger)?.closest('.mega')?.classList.remove('open'); });
    });

    // Desktop (real hover support, not a touch tap-through) opens these on mouseover instead
    // of requiring a click, closing shortly after the pointer actually leaves the whole
    // trigger+panel area so moving diagonally into the panel doesn't slam it shut.
    if (window.matchMedia('(hover: hover)').matches) {
      megaPairs.forEach(function (pair) {
        var trigger = document.getElementById(pair.trigger);
        var wrap = trigger?.closest('.mega');
        if (!wrap) return;
        var closeTimer;
        wrap.addEventListener('mouseenter', function () {
          clearTimeout(closeTimer);
          megaPairs.forEach(function (p) { document.getElementById(p.trigger)?.closest('.mega')?.classList.remove('open'); });
          wrap.classList.add('open');
          keepMegaInside(wrap);
        });
        wrap.addEventListener('mouseleave', function () {
          closeTimer = setTimeout(function () { wrap.classList.remove('open'); }, 150);
        });
      });
    }

    // The burger and the language of the top bar are wired by the small script that follows the menu (above), not by this one.

    var root = document.documentElement;
    var btn = document.getElementById('themeToggle');
    var stored = null;
    try { stored = localStorage.getItem('petto-theme'); } catch (e) {}
    if (stored) root.setAttribute('data-theme', stored);

    function currentTheme() {
      if (root.getAttribute('data-theme')) return root.getAttribute('data-theme');
      return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }
    function toggleTheme() {
      var next = currentTheme() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('petto-theme', next); } catch (e) {}
    }
    btn?.addEventListener('click', toggleTheme);
    document.getElementById('mobileThemeToggle')?.addEventListener('click', toggleTheme);

    (function () {
      var COOKIE_KEY = 'petto-cookie-consent';
      var banner = document.getElementById('cookieBanner');
      if (!banner) return;
      var already = null;
      try { already = localStorage.getItem(COOKIE_KEY); } catch (e) {}
      if (!already) {
        setTimeout(function () { banner.hidden = false; }, 600);
      }
      function choose(value) {
        try { localStorage.setItem(COOKIE_KEY, value); } catch (e) {}
        banner.hidden = true;
      }
      document.getElementById('cookieAccept')?.addEventListener('click', function () { choose('accepted'); });
      document.getElementById('cookieDecline')?.addEventListener('click', function () { choose('declined'); });
    })();

    (function () {
      if (!document.body.classList.contains('public-body')) return;

      var targets = Array.prototype.slice.call(document.querySelectorAll('main > section, main > article'));
      targets.forEach(function (target, sectionIndex) {
        target.style.setProperty('--motion-index', String(Math.min(sectionIndex, 6)));
        var wrap = Array.prototype.find.call(target.children, function (child) { return child.classList.contains('wrap'); });
        if (!wrap) return;
        Array.prototype.forEach.call(wrap.children, function (child, childIndex) {
          child.classList.add('motion-child');
          child.style.setProperty('--motion-child', String(Math.min(childIndex, 8)));
        });
      });

      var motionItemSelector = [
        'main .rm-col', 'main .rm-card',
        'main .announce-card', 'main .showcase', 'main .feat',
        'main .release', 'main .tm-card', 'main .blog-card',
        'main .news-card', 'main .news-row', 'main .cmd-card',
        'main .cmd-row', 'main .faq-item', 'main .tool-controls',
        'main .ts-table', 'main .try',
        'main .highlight-card', 'main .step-card', 'main .dash-mock-win',
        'main .dm-card', 'main .dgo-chart-card', 'main .dgo-metric',
        'main .dgo-top', 'main .dgo-stat-card', 'main .dgo-module',
        'main .dgl-content > :not(script):not(style)'
      ].join(',');
      document.querySelectorAll(motionItemSelector).forEach(function (item, itemIndex) {
        item.classList.add('motion-item');
        if (item instanceof HTMLElement) item.style.setProperty('--motion-item', String(itemIndex % 7));
      });

      document.body.classList.add('motion-ready');
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced || !('IntersectionObserver' in window)) {
        targets.forEach(function (target) { target.classList.add('motion-visible'); });
        return;
      }

      function revealOnce(entries, observer) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('motion-visible');
          observer.unobserve(entry.target);
        });
      }
      var publicIo = new IntersectionObserver(revealOnce, { threshold: 0.04, rootMargin: '0px 0px 22% 0px' });
      // A section far taller than the screen can never show 4% of itself, so it would stay
      // pushed sideways forever. Those only need to touch the viewport to be revealed.
      var tallIo = new IntersectionObserver(revealOnce, { threshold: 0, rootMargin: '0px 0px 22% 0px' });
      targets.forEach(function (target) {
        if (target.getBoundingClientRect().top < window.innerHeight * 1.1) target.classList.add('motion-visible');
        var tall = target.getBoundingClientRect().height * 0.04 > window.innerHeight * 0.6;
        (tall ? tallIo : publicIo).observe(target);
      });
    })();


    // Good answers ("Saved.") fade away after a few seconds; warnings stay until the page changes.
    (function () {
      document.querySelectorAll('[class$="-flash"]:not([class*="warn"]):not([class*="error"])').forEach(function (el) {
        setTimeout(function () { el.setAttribute('data-gone', ''); setTimeout(function () { (el as HTMLElement).hidden = true; }, 450); }, 5000);
      });
    })();

    // Remember the language picked in the menu, so the dashboard opens in it too.
    document.addEventListener('click', function (event) {
      var target = event.target;
      var link = target instanceof Element ? target.closest('a[data-set-lang]') : null;
      if (!link) return;
      try { document.cookie = 'petto_lang=' + link.getAttribute('data-set-lang') + '; path=/; max-age=31536000; samesite=lax'; } catch (e) {}
    });

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
    } else {
      document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
    }
  </script>
<script>
  // Going to the servers or into a server's dashboard: the link shows it is working and the page leaves with a short fade.
  const GOING = /^\/dash\/(manage\/?|guild\/[^/]+\/overview\/?)$/;
  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
    if (!link || link.target === '_blank' || link.hasAttribute('download')) return;
    const url = new URL(link.href, location.href);
    if (url.origin !== location.origin || !GOING.test(url.pathname)) return;
    link.classList.add('is-going');
    document.body.classList.add('nav-going');
  });
  // Coming back with the back button must not leave the page covered.
  window.addEventListener('pageshow', () => {
    document.body.classList.remove('nav-going');
    document.querySelectorAll('a.is-going').forEach((el) => el.classList.remove('is-going'));
  });
</script>
<DashSelectMenu />
  {active === 'dash' && (
    <script is:inline>
      // The height of the sticky top of a dashboard page (--dash-sticky, see scroll-padding-top above), measured, not guessed: the site
      // header plus, on a phone inside a server, the bar with the menu button. And a page opened fresh (a link, an address typed) starts
      // at its top, whatever scrolled it while it loaded; a reload or the back button keep the browser's own restored place.
      (function () {
        var root = document.documentElement;
        function measure() {
          var off = 0;
          var header = document.querySelector('header.nav');
          if (header) {
            var cs = getComputedStyle(header);
            if (cs.position === 'sticky' || cs.position === 'fixed') off += header.getBoundingClientRect().height + (parseFloat(cs.top) || 0);
          }
          var bar = document.querySelector('.dgl-menu-bar');
          if (bar && bar.offsetHeight && getComputedStyle(bar).position === 'sticky') off += bar.offsetHeight;
          root.style.setProperty('--dash-sticky', Math.round(off) + 'px');
        }
        measure();
        window.addEventListener('resize', measure, { passive: true });
        // The language links say which page to come back to as the page was first drawn; after moving to other sections without a reload
        // (the address changed) they come back to where the person is now, with its tab, filters and anchor.
        document.addEventListener('click', function (event) {
          var link = event.target && event.target.closest ? event.target.closest('a[href*="/dash/lang?"]') : null;
          if (!link) return;
          try {
            var url = new URL(link.getAttribute('href'), location.href);
            url.searchParams.set('next', location.pathname + location.search + location.hash);
            link.setAttribute('href', url.pathname + url.search);
          } catch (e) { /* the link keeps the page it had */ }
        }, true);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
        try {
          var entry = performance.getEntriesByType('navigation')[0];
          if (entry && entry.type === 'navigate' && !location.hash) {
            var touched = false;
            ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach(function (name) { window.addEventListener(name, function () { touched = true; }, { once: true, passive: true }); });
            var top = function () { if (!touched && window.scrollY > 0) window.scrollTo({ top: 0, left: 0, behavior: 'instant' }); };
            window.addEventListener('load', top);
            requestAnimationFrame(top);
          }
        } catch (e) { /* an old browser keeps its own behaviour */ }
      })();
    </script>
  )}
  <TextFit />
