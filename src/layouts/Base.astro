          : <SpecularButton client:idle className="nav-desktop-only" size="sm" href="https://petto.sbs/invite" target="_blank" rel="noopener" transparent tint="#ffffff" tintOpacity={0} baseColor="#bfc4d2" textColor="var(--text)" lineColor="#ffffff" intensity={1.2} speed={0.8} radius={11}>{t.nav.addToDiscord}</SpecularButton>}
        <button class="nav-burger" id="navBurger" aria-label="Menu" aria-expanded="false" aria-controls="mobileNav">
