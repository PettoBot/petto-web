          </button>
          <div class="lang-menu" id="langMenu">
            <a href={languageHref('en')} class:list={{ active: lang === 'en' }}>{localeNames.en}{lang === 'en' && <InlineIcon name="ph:check-bold" width="12" height="12" />}</a>
            <a href={languageHref('es')} class:list={{ active: lang === 'es' }}>{localeNames.es}{lang === 'es' && <InlineIcon name="ph:check-bold" width="12" height="12" />}</a>
            <a href={languageHref('pt-BR')} class:list={{ active: lang === 'pt-BR' }}>{localeNames['pt-BR']}{lang === 'pt-BR' && <InlineIcon name="ph:check-bold" width="12" height="12" />}</a>
          </div>
        </div>
        <button class="theme-toggle nav-desktop-only" id="themeToggle" aria-label="Toggle theme" title="Toggle theme">
          <InlineIcon name="ph:sun-fill" id="themeIcon" width="16" height="16" />
        </button>
        <SpecularButton client:load className="nav-desktop-only" size="sm" href="https://petto.sbs/invite" target="_blank" rel="noopener" transparent tint="#ffffff" tintOpacity={0} baseColor="#bfc4d2" textColor="var(--text)" lineColor="#ffffff" intensity={1.2} speed={0.8} radius={11}>{t.nav.addToDiscord}</SpecularButton>
        <button class="nav-burger" id="navBurger" aria-label="Menu" aria-expanded="false">
          <InlineIcon name="ph:list" width="20" height="20" class="nav-burger-open-ic" />
          <InlineIcon name="ph:x" width="20" height="20" class="nav-burger-close-ic" />
        </button>
      </div>
    </div>
  </header>

  <!-- Rendered as a sibling of <header>, not a descendant: header has backdrop-filter,
       which creates a containing block for position:fixed children and would trap this
       panel inside the header's own ~60px box instead of the full viewport. -->
  <div class="mobile-nav" id="mobileNav">
    <div class="mobile-nav-inner">
      <SpecularButton client:load className="mobile-nav-cta" size="md" href="https://petto.sbs/invite" target="_blank" rel="noopener" transparent tint="#ffffff" tintOpacity={0} baseColor="#bfc4d2" textColor="var(--text)" lineColor="#ffffff" intensity={1.2} speed={0.8} radius={11}>{t.nav.addToDiscord}</SpecularButton>

      <div class="mobile-nav-label">{t.nav.product}</div>
      {t.nav.menu.product.items.filter((it) => it.href && String(it.href) !== '#').map((it) => (
        <a href={hrefFor(it.href)} target={isExternal(it.href) ? '_blank' : undefined} rel={isExternal(it.href) ? 'noopener' : undefined} class="mobile-nav-link">
          <NavIcon name={it.icon} width="16" height="16" />
          {it.title}
