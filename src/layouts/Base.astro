            : <SpecularButton client:visible className="mobile-nav-cta" size="md" href="https://petto.sbs/invite" target="_blank" rel="noopener" transparent tint="#ffffff" tintOpacity={0} baseColor="#bfc4d2" textColor="var(--text)" lineColor="#ffffff" intensity={1.2} speed={0.8} radius={11}>{t.nav.addToDiscord}</SpecularButton>}
        </div>
        <div class="mnav-list">
          {[{ key: 'product', title: t.nav.product, items: t.nav.menu.product.items }, { key: 'community', title: t.nav.community, items: t.nav.menu.community.items.filter((it) => it.href !== '/status') }].map((group) => (
            <details class="mnav-group" name="mnav-group">
              <summary class="mnav-row"><span>{group.title}</span><InlineIcon name="ph:caret-down" class="mnav-caret" width="16" height="16" /></summary>
              <div class="mnav-sub">
                {group.items.filter((it) => it.href && String(it.href) !== '#').map((it) => (
                  <a href={hrefFor(it.href)} data-astro-prefetch={prefetchFor(hrefFor(it.href))} target={isExternal(it.href) ? '_blank' : undefined} rel={isExternal(it.href) ? 'noopener' : undefined} class="mobile-nav-link">
                    <NavIcon name={it.icon} width="16" height="16" />
