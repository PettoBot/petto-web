---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import PremiumPlanCard from './PremiumPlanCard.astro';

interface Guild {
  id: string;
  name: string;
  icon: string | null;
  tag: string;
  active: boolean;
}

interface Props {
  user: { username: string; avatar: string | null };
  guilds: Guild[];
  status: string;
  slotsUsed: number;
  slotsTotal: number;
  assignedGuildIds: string[];
  requestedGuildIds: string[];
  checkoutReady: boolean;
  selectedPlan?: string;
  error?: string;
  saved?: boolean;
}

const { user, guilds, status, slotsUsed, slotsTotal, assignedGuildIds, requestedGuildIds, checkoutReady, selectedPlan = 'premium-3-month', error, saved = false } = Astro.props;
const assigned = new Set(assignedGuildIds);
const requested = new Set(requestedGuildIds);
---

<Base title="Premium · Petto" active="dash" showFooter>
  <main>
    <section class="premium-dash-sec">
      <div class="wrap premium-dash-wrap">
        <div class="premium-dash-head">
          <div class="premium-dash-user">
            {user.avatar ? <img src={user.avatar} alt="" class="premium-user-av" /> : <div class="premium-user-av premium-user-fallback"><Icon name="ph:user-fill" width="18" height="18" /></div>}
            <div>
              <div class="premium-kicker">Premium workspace</div>
              <div class="premium-user-name">{user.username}</div>
            </div>
          </div>
          <a class="premium-logout" href="/dash/logout"><Icon name="ph:sign-out-fill" width="14" height="14" /> Log out</a>
        </div>

        <div class="premium-dash-intro">
          <div>
            <div class="eyebrow">Petto Premium</div>
            <h1>Choose where your Premium goes.</h1>
            <p>Free stays useful for every server. When Premium is active on your account, use the slots below on the servers you manage and move them whenever you need.</p>
          </div>
          <div class:list={['premium-status', `premium-status-${status}`]}>
            <span class="premium-status-dot"></span>
            {status === 'active' ? 'Premium active' : status === 'pending' ? 'Payment pending' : 'Free plan'}
          </div>
        </div>

        {error === 'discord_unavailable' && <div class="premium-alert premium-alert-error"><Icon name="ph:warning-fill" width="17" height="17" /> Discord did not respond. Refresh in a few seconds.</div>}
        {error === 'request_failed' && <div class="premium-alert premium-alert-error"><Icon name="ph:warning-fill" width="17" height="17" /> We could not save that server preference. Try again.</div>}
        {error === 'not_manageable' && <div class="premium-alert premium-alert-error"><Icon name="ph:warning-fill" width="17" height="17" /> You can only select servers where you have Manage Server or Administrator.</div>}
        {error === 'checkout_unavailable' && <div class="premium-alert premium-alert-error"><Icon name="ph:warning-fill" width="17" height="17" /> Checkout is not connected yet. Add the Polar access token to the dashboard environment first.</div>}
        {error === 'premium_required' && <div class="premium-alert premium-alert-error"><Icon name="ph:lock-simple-fill" width="17" height="17" /> This server does not have an active Premium slot yet. Choose it below after Premium is activated.</div>}
        {saved && <div class="premium-alert premium-alert-success"><Icon name="ph:check-circle-fill" width="17" height="17" /> Server selection saved. It will activate when Premium billing is connected to your account.</div>}

        <div class="premium-plan-grid">
          <PremiumPlanCard slots={1} monthly="$4.99 / month" annual="$50.90 / year" note="For one community" selectedPlan={selectedPlan} checkoutReady={checkoutReady} />
          <PremiumPlanCard slots={3} monthly="$12.99 / month" annual="$132.50 / year" note="For a small group" selectedPlan={selectedPlan} checkoutReady={checkoutReady} featured />
          <PremiumPlanCard slots={5} monthly="$19.99 / month" annual="$203.90 / year" note="For your whole network" selectedPlan={selectedPlan} checkoutReady={checkoutReady} />
        </div>
        {!checkoutReady && <p class="premium-setup-note"><Icon name="ph:info-fill" width="15" height="15" /> Premium stays optional. The plans appear now; checkout activates after the Polar access token is added to the dashboard environment.</p>}

        <div class="premium-summary-grid">
          <div class="premium-summary-card">
            <span class="premium-summary-label">Plan</span>
            <strong>{status === 'active' ? 'Petto Premium' : 'Free'}</strong>
            <small>{status === 'active' ? 'Account-level access' : 'All core features included'}</small>
          </div>
          <div class="premium-summary-card">
            <span class="premium-summary-label">Server slots</span>
            <strong>{slotsUsed} <span>/ {slotsTotal}</span></strong>
            <small>{status === 'active' ? 'Choose the servers below' : 'Slots appear after Premium is activated'}</small>
          </div>
          <div class="premium-summary-card premium-summary-note">
            <Icon name="ph:heart-fill" width="17" height="17" />
            <div><strong>Free is not a demo</strong><small>Moderation, leveling, tickets, giveaways and the dashboard remain available without paying.</small></div>
          </div>
        </div>

        <div class="premium-section-head">
          <div><h2>Your servers</h2><p>Select the places you want to prioritize. Requests stay pending until Premium billing is connected.</p></div>
          <a class="btn btn-ghost btn-sm" href="/premium"><Icon name="ph:crown-fill" width="14" height="14" /> See plans</a>
        </div>

        {guilds.length === 0 ? (
          <div class="premium-empty"><Icon name="ph:users-three-fill" width="22" height="22" /><strong>No manageable servers found</strong><span>Give Petto Manage Server access or refresh Discord permissions.</span></div>
        ) : (
          <div class="premium-server-grid">
            {guilds.map((guild) => {
              const isAssigned = assigned.has(guild.id);
              const isRequested = requested.has(guild.id);
              return <article class:list={['premium-server-card', { 'is-active': isAssigned, 'is-requested': isRequested, 'is-offline': !guild.active }]}>
                <div class="premium-server-icon-wrap"><img src={guild.icon ?? '/assets/dash-guild-fallback.avif'} alt="" class="premium-server-icon" /><span class:list={['premium-server-dot', { online: guild.active }]}></span></div>
                <div class="premium-server-info"><strong>{guild.name}</strong><span>{guild.active ? guild.tag : 'Petto not added'}</span></div>
                {isAssigned ? (
                  <form method="POST" class="premium-server-action"><input type="hidden" name="guild_id" value={guild.id} /><input type="hidden" name="action" value="release" /><button class="premium-server-state active" type="submit"><Icon name="ph:check-circle-fill" width="15" height="15" /> Premium here · Move</button></form>
                ) : isRequested ? (
                  <form method="POST" class="premium-server-action"><input type="hidden" name="guild_id" value={guild.id} /><input type="hidden" name="action" value="cancel" /><button class="btn btn-ghost btn-sm" type="submit"><Icon name="ph:x" width="14" height="14" /> Cancel request</button></form>
                ) : guild.active ? (
                  <form method="POST" class="premium-server-action"><input type="hidden" name="guild_id" value={guild.id} /><input type="hidden" name="action" value="request" /><button class="btn btn-ghost btn-sm" type="submit"><Icon name="ph:plus" width="14" height="14" /> Select server</button></form>
                ) : (
                  <a class="btn btn-ghost btn-sm premium-add-bot" href="/dash/manage">Add Petto first</a>
                )}
              </article>;
            })}
          </div>
        )}

        <div class="premium-footnote"><Icon name="ph:shield-check-fill" width="16" height="16" /><span>Selections are checked against your live Discord permissions on every request. A pending selection never unlocks paid features by itself.</span></div>
      </div>
    </section>
  </main>
</Base>

<style>
  .premium-dash-sec { padding: 54px 0 96px; }
  .premium-dash-wrap { max-width: 1160px; }
  .premium-dash-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:36px; }
  .premium-dash-user { display:flex; align-items:center; gap:12px; }
  .premium-user-av { width:42px; height:42px; border-radius:50%; object-fit:cover; border:1px solid var(--border); }
  .premium-user-fallback { display:flex; align-items:center; justify-content:center; background:var(--bg-raise); color:var(--text-dim); }
  .premium-kicker,.premium-summary-label { font-family:var(--mono); text-transform:uppercase; letter-spacing:.06em; font-size:10px; color:var(--text-dim); }
  .premium-user-name { font-family:var(--serif); font-size:17px; font-weight:600; }
  .premium-logout { display:flex; align-items:center; gap:6px; color:var(--text-dim); font-size:13px; text-decoration:none; }
  .premium-logout:hover { color:var(--text); }
  .premium-dash-intro { display:flex; justify-content:space-between; gap:30px; align-items:flex-end; padding-bottom:34px; border-bottom:1px solid var(--border-soft); }
  .premium-dash-intro h1 { margin:9px 0 10px; font-family:var(--serif); font-size:clamp(31px,5vw,52px); line-height:1.05; }
  .premium-dash-intro p { max-width:690px; margin:0; color:var(--text-muted); font-size:16px; }
  .premium-status { display:inline-flex; align-items:center; gap:8px; white-space:nowrap; padding:10px 13px; border:1px solid var(--border); border-radius:999px; color:var(--text-muted); font-family:var(--mono); font-size:11px; }
  .premium-status-dot { width:8px; height:8px; border-radius:50%; background:var(--text-dim); }
  .premium-status-active { color:var(--green); border-color:color-mix(in srgb,var(--green) 42%,var(--border)); }.premium-status-active .premium-status-dot { background:var(--green); }.premium-status-pending { color:var(--yellow); }.premium-status-pending .premium-status-dot { background:var(--yellow); }
  .premium-alert { display:flex; align-items:center; gap:9px; margin:20px 0 0; padding:13px 15px; border-radius:12px; font-size:14px; }.premium-alert-error { color:var(--red); background:var(--red-soft); border:1px solid color-mix(in srgb,var(--red) 55%,var(--border)); }
  .premium-alert-success { color:var(--green); background:var(--green-soft); border:1px solid color-mix(in srgb,var(--green) 55%,var(--border)); }
  .premium-summary-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin:24px 0 48px; }
  .premium-plan-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; margin:26px 0 30px; }
  .premium-plan-card { position:relative; min-width:0; padding:20px; border:1px solid var(--border); border-radius:15px; background:var(--card); }.premium-plan-featured { border-color:color-mix(in srgb,var(--accent) 62%,var(--border)); box-shadow:0 10px 30px color-mix(in srgb,var(--accent) 10%,transparent); }.premium-plan-badge { position:absolute; top:12px; right:12px; padding:4px 7px; border-radius:999px; background:var(--accent-soft); color:var(--accent); font-family:var(--mono); font-size:9px; text-transform:uppercase; letter-spacing:.05em; }.premium-plan-title strong,.premium-plan-title span { display:block; }.premium-plan-title strong { font-size:18px; }.premium-plan-title span,.premium-plan-annual { color:var(--text-dim); font-size:12px; }.premium-plan-price { margin-top:22px; font-size:21px; font-weight:700; }.premium-plan-annual { margin-top:3px; }.premium-plan-form { display:grid; gap:9px; margin:17px 0 0; }.premium-plan-form select { width:100%; padding:9px 10px; border:1px solid var(--border); border-radius:9px; background:var(--bg-raise); color:var(--text); font:inherit; font-size:12px; }.premium-plan-form button { display:inline-flex; align-items:center; gap:6px; width:100%; justify-content:center; }.premium-plan-form button:disabled { cursor:not-allowed; opacity:.5; }.premium-setup-note { display:flex; align-items:center; gap:7px; margin:-12px 0 30px; color:var(--text-dim); font-size:12px; }.premium-setup-note svg { color:var(--accent); flex:0 0 auto; }
  .premium-summary-card { min-height:116px; padding:19px; border:1px solid var(--border); border-radius:14px; background:var(--card); display:flex; flex-direction:column; gap:6px; }.premium-summary-card strong { font-size:21px; }.premium-summary-card strong span { color:var(--text-dim); font-size:15px; font-weight:400; }.premium-summary-card small { color:var(--text-dim); font-size:12px; }.premium-summary-note { flex-direction:row; gap:11px; color:var(--accent); }.premium-summary-note strong { display:block; color:var(--text); font-size:14px; }.premium-summary-note small { display:block; margin-top:4px; }
  .premium-section-head { display:flex; justify-content:space-between; gap:20px; align-items:end; margin-bottom:18px; }.premium-section-head h2 { margin:0 0 4px; font-family:var(--serif); font-size:26px; }.premium-section-head p { margin:0; color:var(--text-muted); font-size:13px; }.premium-section-head .btn { display:inline-flex; align-items:center; gap:7px; white-space:nowrap; }
  .premium-server-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(290px,1fr)); gap:12px; }.premium-server-card { display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:12px; padding:13px; border:1px solid var(--border); border-radius:14px; background:var(--card); }.premium-server-card.is-active { border-color:color-mix(in srgb,var(--green) 55%,var(--border)); }.premium-server-icon-wrap { position:relative; }.premium-server-icon { width:42px; height:42px; border-radius:13px; object-fit:cover; display:block; }.premium-server-dot { position:absolute; right:-2px; bottom:-2px; width:10px; height:10px; border:2px solid var(--card); border-radius:50%; background:var(--text-dim); }.premium-server-dot.online { background:var(--green); }.premium-server-info { min-width:0; }.premium-server-info strong,.premium-server-info span { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.premium-server-info strong { font-size:14px; }.premium-server-info span { color:var(--text-dim); font-size:11px; margin-top:2px; }.premium-server-action { margin:0; }.premium-server-action button,.premium-add-bot { display:inline-flex; align-items:center; gap:5px; white-space:nowrap; }.premium-server-state { display:inline-flex; align-items:center; gap:5px; color:var(--green); font-size:12px; white-space:nowrap; }.premium-server-state.active { font-family:var(--mono); }.premium-server-card.is-offline { opacity:.7; }
  .premium-empty { display:flex; flex-direction:column; align-items:center; gap:7px; border:1px dashed var(--border); border-radius:14px; padding:40px 20px; color:var(--text-dim); text-align:center; }.premium-empty strong { color:var(--text); }.premium-empty span { font-size:13px; }.premium-footnote { display:flex; align-items:flex-start; gap:9px; margin-top:20px; color:var(--text-dim); font-size:12px; }.premium-footnote svg { flex:0 0 auto; color:var(--green); margin-top:2px; }
  @media (max-width:760px) { .premium-dash-sec { padding:28px 0 60px; }.premium-dash-wrap { padding:0 16px; }.premium-dash-head,.premium-dash-intro,.premium-section-head { align-items:flex-start; flex-direction:column; }.premium-logout { margin-left:auto; margin-top:-44px; }.premium-summary-grid { grid-template-columns:1fr; margin-bottom:34px; }.premium-plan-grid { grid-template-columns:repeat(2,minmax(0,1fr)); margin-bottom:34px; }.premium-server-grid { grid-template-columns:1fr; }.premium-server-card { grid-template-columns:auto 1fr; }.premium-server-action,.premium-server-state,.premium-add-bot { grid-column:1 / -1; width:100%; justify-content:center; }.premium-section-head .btn { width:100%; justify-content:center; } }
  @media (max-width:560px) { .premium-plan-grid { grid-template-columns:1fr; } }
  .premium-server-state { background:none; border:0; padding:0; cursor:pointer; }
  .premium-server-state.active:hover { color:var(--text); }
</style>
