---
import { Icon } from 'astro-icon/components';
import { guildLetter, guildLetterStyle } from '../utils/guildLetter.mjs';
import CheckoutConsent from './CheckoutConsent.astro';
import DashMeLayout from './DashMeLayout.astro';
import type { Session } from '../utils/session';
import PremiumPlanCard from './PremiumPlanCard.astro';
import DashPanelHead from './DashPanelHead.astro';
import DashPanelEmpty from './DashPanelEmpty.astro';
import { PREMIUM_TIERS, annual, premiumFeatures, tr } from '../data/premiumCatalog';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Guild {
  id: string;
  name: string;
  icon: string | null;
  tag: string;
  active: boolean;
}

interface Props {
  user: Session;
  guilds: Guild[];
  status: string;
  slotsUsed: number;
  slotsTotal: number;
  assignedGuildIds: string[];
  requestedGuildIds: string[];
  history: Array<{
    id: number;
    provider: string;
    plan_key: string;
    status: string;
    current_period_end: string | null;
    created_at?: string;
    metadata?: Record<string, any>;
  }>;
  checkoutReady: boolean;
  portalReady: boolean;
  selectedPlan?: string;
  error?: string;
  saved?: boolean;
  checkoutStarted?: boolean;
}

const { user, guilds, status, slotsUsed, slotsTotal, assignedGuildIds, requestedGuildIds, history, checkoutReady, portalReady, selectedPlan = 'premium-3-month', error, saved = false, checkoutStarted = false } = Astro.props;
const assigned = new Set(assignedGuildIds);
const requested = new Set(requestedGuildIds);
const latestEntitlement = history[0] ?? null;
const formatDate = (value: string | null | undefined) => value ? new Intl.DateTimeFormat(dashLang, { dateStyle: 'medium' }).format(new Date(value)) : dt('No end date');
const statusLabel = (value: string) => ({ active: dt('Active'), pending: dt('Pending'), past_due: dt('Past due'), canceled: dt('Canceled'), expired: dt('Expired'), free: dt('Free') }[value] ?? value);
const scheduledCancellation = Boolean(latestEntitlement?.metadata?.cancel_at_period_end || latestEntitlement?.metadata?.polar?.cancel_at_period_end);
// The plans and the benefits come from src/data/premiumCatalog.ts, like the public Premium page.
const planCards = PREMIUM_TIERS.map((tier) => ({ slots: tier.servers, featured: Boolean(tier.featured), monthly: `$${tier.monthly.toFixed(2)} / month`, annual: `$${annual(tier.monthly).toFixed(2)} / year`, note: tr(tier.note, dashLang) }));
const benefits = premiumFeatures();
const introStatus = status === 'active' ? dt('Premium active') : status === 'pending' ? dt('Payment pending') : status === 'past_due' ? dt('Payment needs attention') : status === 'canceled' ? dt('Premium canceled') : status === 'expired' ? dt('Premium expired') : dt('Free plan');
const slotPct = slotsTotal > 0 ? Math.min(100, Math.round((slotsUsed / slotsTotal) * 100)) : 0;
const defaultTab = status === 'active' || slotsTotal > 0 ? 'servers' : 'plans';
---

<DashMeLayout user={user} active="premium" pageTitle="Premium">
      <div class="premium-dash-wrap" id="pr-dash-root">
        <DashPanelHead title={dt('Choose where your Premium goes.')} eyebrow={dt('Petto Premium')} icon="ph:crown-fill" back={false}>
          <span slot="badge" class:list={['premium-status', `premium-status-${status}`]}><span class="premium-status-dot"></span>{introStatus}</span>
        </DashPanelHead>

        {error === 'discord_unavailable' && <div class="premium-alert premium-alert-error"><Icon name="ph:warning-fill" width="17" height="17" /> {dt('Discord did not respond. Refresh in a few seconds.')}</div>}
        {error === 'request_failed' && <div class="premium-alert premium-alert-error"><Icon name="ph:warning-fill" width="17" height="17" /> {dt('We could not save that server preference. Try again.')}</div>}
        {error === 'not_manageable' && <div class="premium-alert premium-alert-error"><Icon name="ph:warning-fill" width="17" height="17" /> {dt('You can only select servers where you have Manage Server or Administrator.')}</div>}
        {error === 'terms_required' && <div class="premium-alert premium-alert-error"><Icon name="ph:warning-fill" width="17" height="17" /> {dt('Accept the purchase and refund terms before paying. Turn on JavaScript and press Choose plan again.')}</div>}
        {error === 'checkout_unavailable' && <div class="premium-alert premium-alert-error"><Icon name="ph:warning-fill" width="17" height="17" /> {dt('Checkout is not connected yet. Add the Polar access token to the dashboard environment first.')}</div>}
        {error === 'portal_unavailable' && <div class="premium-alert premium-alert-error"><Icon name="ph:warning-fill" width="17" height="17" /> {dt('We could not open the billing portal. Your subscription is still safe; try again in a moment.')}</div>}
        {error === 'premium_required' && <div class="premium-alert premium-alert-error"><Icon name="ph:lock-simple-fill" width="17" height="17" /> {dt('This server does not have an active Premium slot yet. Choose it below after Premium is activated.')}</div>}
        {saved && <div class="premium-alert premium-alert-success"><Icon name="ph:check-circle-fill" width="17" height="17" /> {dt('Server preference saved.')}</div>}
        {checkoutStarted && status === 'active' && <div class="premium-alert premium-alert-success"><Icon name="ph:check-circle-fill" width="17" height="17" /> {dt('Thank you! Your Premium is active. Choose the servers below.')}</div>}
        {checkoutStarted && status !== 'active' && <div class="premium-alert premium-alert-success"><Icon name="ph:check-circle-fill" width="17" height="17" /> {dt('Thank you! Your payment was received and Petto is turning your Premium on. Refresh this page in a few seconds.')}</div>}

        <div class="pr-vetox-hero">
          <div class="pr-vetox-hero-left">
            <span class="pr-vetox-badge"><Icon name="ph:crown-fill" width="12" height="12" /> PREMIUM</span>
            <h2>{dt('Choose where your Premium goes.')}</h2>
            <p>{status === 'active' ? `${latestEntitlement?.plan_key ?? dt('Account-level access')} · ${formatDate(latestEntitlement?.current_period_end)}` : dt('Every plan has the same Premium features. A plan only changes how many servers it covers.')}</p>
            <div class="pr-vetox-billing">
              <div class="pr-vetox-seg" id="prDashBilling" role="tablist">
                <button type="button" class="active" data-bill="month" role="tab" aria-selected="true">{dt('Monthly')}</button>
                <button type="button" data-bill="year" role="tab" aria-selected="false">{dt('Annual')}</button>
              </div>
              <span class="pr-vetox-save">{dt('Save 15%')}</span>
            </div>
            <div class="pr-vetox-perks">
              <span><Icon name="ph:check-bold" width="12" height="12" /> {dt('Move between servers')}</span>
              <span><Icon name="ph:check-bold" width="12" height="12" /> {dt('Cancel at any time')}</span>
              <span><Icon name="ph:check-bold" width="12" height="12" /> {dt('Payments by Polar')}</span>
            </div>
            <div class="pr-vetox-slots">
              <span>{dt('Server slots')}: <strong>{slotsUsed} / {slotsTotal}</strong></span>
              <div class="premium-slot-bar" aria-hidden="true"><i style={`width:${slotPct}%`}></i></div>
            </div>
          </div>
          <div class="pr-vetox-hero-art" aria-hidden="true">
            <img src="/assets/dash-premium-banner.webp" alt="" class="pr-vetox-sky-img" loading="eager" decoding="sync" fetchpriority="high" draggable="false" />
            <div class="pr-vetox-art-fade"></div>
          </div>
        </div>

        <div class="pr-dash-tabs" role="tablist" aria-label={dt('Petto Premium')}>
          <button type="button" role="tab" class:list={['pr-dash-tab', { active: defaultTab === 'servers' }]} data-pr-tab="servers" aria-selected={defaultTab === 'servers' ? 'true' : 'false'}>
            <Icon name="ph:hard-drives-fill" width="15" height="15" />
            <span>{dt('Your servers')}</span>
            <em class="pr-dash-count">{slotsUsed}/{slotsTotal}</em>
          </button>
          <button type="button" role="tab" class:list={['pr-dash-tab', { active: defaultTab === 'plans' }]} data-pr-tab="plans" aria-selected={defaultTab === 'plans' ? 'true' : 'false'}>
            <Icon name="ph:crown-fill" width="15" height="15" />
            <span>{dt('Plans')}</span>
          </button>
          <button type="button" role="tab" class="pr-dash-tab" data-pr-tab="billing" aria-selected="false">
            <Icon name="ph:credit-card-fill" width="15" height="15" />
            <span>{dt('Subscription & billing')}</span>
          </button>
        </div>

        <section class="pr-dash-panel" data-pr-panel="servers" hidden={defaultTab !== 'servers'}>
          <div class="premium-block">
            <div class="premium-section-head">
              <div><h2>{dt('Your servers')}</h2><p>{dt('Select where you want to use your Premium slots. Paid selections activate after Polar confirms the subscription.')}</p></div>
              <div class="pr-srv-tools">
                <div class="pr-srv-search">
                  <Icon name="ph:magnifying-glass" width="14" height="14" />
                  <input type="search" id="prSrvSearch" placeholder={dt('Search...')} autocomplete="off" />
                </div>
                <div class="pr-srv-filters" role="group">
                  <button type="button" class="active" data-srv-filter="all">{dt('All')}</button>
                  <button type="button" data-srv-filter="active">{dt('Active')}</button>
                  <button type="button" data-srv-filter="ready">{dt('Available')}</button>
                </div>
              </div>
            </div>

            {guilds.length === 0 ? (
              <DashPanelEmpty icon="ph:users-three-fill" text={`${dt('No manageable servers found')}. ${dt('Give Petto Manage Server access or refresh Discord permissions.')}`} />
            ) : (
              <div class="premium-server-grid" id="prSrvGrid">
                {guilds.map((guild) => {
                  const isAssigned = assigned.has(guild.id);
                  const isRequested = requested.has(guild.id);
                  const stateTag = isAssigned ? 'active' : guild.active ? 'ready' : 'offline';
                  return <article class:list={['premium-server-card', { 'is-active': isAssigned, 'is-requested': isRequested, 'is-offline': !guild.active }]} data-srv-name={guild.name.toLowerCase()} data-srv-state={stateTag}>
                    <div class="premium-server-icon-wrap">{guild.icon ? <img src={guild.icon} alt="" class="premium-server-icon" /> : <span class="premium-server-icon premium-server-letter" style={guildLetterStyle(guild.name)}>{guildLetter(guild.name)}</span>}<span class:list={['premium-server-dot', { online: guild.active }]}></span></div>
                    <div class="premium-server-info"><strong>{guild.name}</strong><span>{guild.active ? guild.tag : dt('Petto not added')}</span></div>
                    {isAssigned ? (
                      <form method="POST" class="premium-server-action" data-no-dirty><input type="hidden" name="guild_id" value={guild.id} /><input type="hidden" name="action" value="release" /><button class="premium-server-state active" type="submit"><Icon name="ph:check-circle-fill" width="15" height="15" /> {dt('Premium here · Remove')}</button></form>
                    ) : isRequested ? (
                      <form method="POST" class="premium-server-action" data-no-dirty><input type="hidden" name="guild_id" value={guild.id} /><input type="hidden" name="action" value="cancel" /><button class="btn btn-ghost btn-sm" type="submit"><Icon name="ph:x" width="14" height="14" /> {dt('Cancel request')}</button></form>
                    ) : guild.active ? (
                      <form method="POST" class="premium-server-action" data-no-dirty><input type="hidden" name="guild_id" value={guild.id} /><input type="hidden" name="action" value="request" /><button class="pr-select-srv-btn" type="submit"><Icon name="ph:plus" width="14" height="14" /> {dt('Select server')}</button></form>
                    ) : (
                      <a class="btn btn-ghost btn-sm premium-add-bot" href="/dash/manage" data-sk="list">{dt('Add Petto first')}</a>
                    )}
                  </article>;
                })}
              </div>
            )}

            <div class="premium-footnote"><Icon name="ph:shield-check-fill" width="16" height="16" /><span>{dt('Selections are checked against your live Discord permissions on every request. A pending selection never unlocks paid features by itself.')}</span></div>
          </div>
        </section>

        <section class="pr-dash-panel" data-pr-panel="plans" hidden={defaultTab !== 'plans'}>
          <div class="premium-block">
            <div class="premium-section-head">
              <div><h2>{dt('Plans')}</h2><p>{dt('Every plan has the same Premium features. A plan only changes how many servers it covers.')} {dt('You can buy more than one: their servers add up.')}</p></div>
            </div>
            <div class="premium-plan-grid">
              {planCards.map((plan) => <PremiumPlanCard slots={plan.slots} monthly={plan.monthly} annual={plan.annual} note={plan.note} selectedPlan={selectedPlan} checkoutReady={checkoutReady} featured={plan.featured} />)}
            </div>
            <p class="premium-roles-note"><Icon name="ph:medal-fill" width="15" height="15" /> {dt('In the Petto Discord server you also get the role of your plan and the Priority Support role. They are given to you by themselves, a couple of minutes after the payment, if you are in the server.')}</p>
            {!checkoutReady && <p class="premium-setup-note"><Icon name="ph:info-fill" width="15" height="15" /> {dt('Premium stays optional. The plans appear now; checkout activates after the Polar access token is added to the dashboard environment.')}</p>}
          </div>

          <div class="premium-block">
            <div class="premium-section-head">
              <div><h2>{dt('What Premium includes')}</h2></div>
              <a class="btn btn-ghost btn-sm" href="/premium"><Icon name="ph:crown-fill" width="14" height="14" /> {dt('See plans')}</a>
            </div>
            <div class="premium-benefits">
              {benefits.map((item) => (
                <div class={`premium-benefit${item.locked ? ' premium-benefit-locked' : ''}`}>
                  <span class="premium-benefit-icon"><Icon name={item.icon} width="16" height="16" /></span>
                  <div class="premium-benefit-text">
                    <strong>{tr(item.name, dashLang)}{item.isNew && <span class="premium-new">{dt('New')}</span>}{item.locked && <span class="premium-new premium-lock">{dt('Locked')}</span>}</strong>
                    {item.desc && <small>{tr(item.desc, dashLang)}</small>}
                    {item.locked && <small class="premium-lock-reason">{tr(item.locked.reason, dashLang)}</small>}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section class="pr-dash-panel" data-pr-panel="billing" hidden>
          <div class="premium-block premium-billing-section">
            <div class="premium-section-head">
              <div><h2>{dt('Subscription & billing')}</h2><p>{dt('Manage payment details, receipts, invoices, and cancellation safely through Polar.')}</p></div>
              {portalReady ? <form method="POST" data-no-dirty><input type="hidden" name="action" value="portal" /><button class="btn btn-ghost btn-sm" type="submit"><Icon name="ph:arrow-square-out" width="14" height="14" /> {dt('Manage billing')}</button></form> : <span class="premium-billing-muted">{dt('Available after your first Polar purchase')}</span>}
            </div>
            <div class="premium-billing-grid">
              <div class="premium-billing-card">
                <span class="premium-summary-label">{dt('Current billing state')}</span>
                <strong>{statusLabel(status)}</strong>
                <small>{latestEntitlement?.provider === 'manual' ? dt('Manual grant from Petto') : latestEntitlement ? (scheduledCancellation ? dt('Ends on {d}',{d:formatDate(latestEntitlement.current_period_end)}) : dt('Next renewal: {d}',{d:formatDate(latestEntitlement.current_period_end)})) : dt('No subscription yet')}</small>
              </div>
              <div class="premium-billing-card">
                <span class="premium-summary-label">{dt('What happens if Premium ends?')}</span>
                <strong>{dt('Free stays safe')}</strong>
                <small>{dt('Paid modules fall back to Free, assigned slots are released, and Premium customization is restored to the server defaults.')}</small>
              </div>
            </div>
            {history.length > 0 && (
              <div class="premium-history-card">
                <div class="premium-history-title"><strong>{dt('Subscription history')}</strong><span>{history.length === 1 ? dt('1 record') : dt('{n} records', { n: history.length })}</span></div>
                <div class="premium-history-list">
                  {history.slice(0, 8).map((item) => <div class="premium-history-row">
                    <div><strong>{item.plan_key}</strong><span>{dt('{a} · started {b}', { a: (item.provider === 'manual' ? dt('Manual grant') : dt('Polar subscription')), b: (formatDate(item.created_at)) })}</span></div>
                    <div class="premium-history-state"><span class:list={['premium-history-dot', `is-${item.status}`]}></span>{statusLabel(item.status)}<small>{formatDate(item.current_period_end)}</small></div>
                  </div>)}
                </div>
              </div>
            )}
          </div>
        </section>
      </div>
  <script is:inline>
    (function () {
      var root = document.getElementById('pr-dash-root');
      if (!root || root.dataset.ready) return;
      root.dataset.ready = '1';
      var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-pr-tab]'));
      var panels = Array.prototype.slice.call(root.querySelectorAll('[data-pr-panel]'));
      tabs.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var target = btn.getAttribute('data-pr-tab');
          tabs.forEach(function (t) { var on = t === btn; t.classList.toggle('active', on); t.setAttribute('aria-selected', on ? 'true' : 'false'); });
          panels.forEach(function (p) { p.hidden = p.getAttribute('data-pr-panel') !== target; });
        });
      });
      var billSeg = document.getElementById('prDashBilling');
      if (billSeg) {
        billSeg.querySelectorAll('[data-bill]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var mode = btn.getAttribute('data-bill') || 'month';
            billSeg.querySelectorAll('[data-bill]').forEach(function (b) { var on = b === btn; b.classList.toggle('active', on); b.setAttribute('aria-selected', on ? 'true' : 'false'); });
            root.querySelectorAll('.premium-plan-form select[name="plan"]').forEach(function (sel) {
              for (var i = 0; i < sel.options.length; i++) {
                if (sel.options[i].value.slice(-mode.length) === mode) { sel.selectedIndex = i; break; }
              }
            });
            root.querySelectorAll('.premium-plan-card').forEach(function (card) {
              var price = card.querySelector('.premium-plan-price');
              if (!price) return;
              var m = price.getAttribute('data-m');
              var y = price.getAttribute('data-y');
              if (m && y) {
                price.innerHTML = mode === 'year' ? y : m;
                if (price.animate) price.animate([{ opacity: 0.35, transform: 'translateY(4px)' }, { opacity: 1, transform: 'none' }], { duration: 220, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
              }
            });
          });
        });
      }
      var search = document.getElementById('prSrvSearch');
      var grid = document.getElementById('prSrvGrid');
      var filterBtns = Array.prototype.slice.call(root.querySelectorAll('[data-srv-filter]'));
      var currentFilter = 'all';
      function applyFilter() {
        if (!grid) return;
        var q = search ? search.value.trim().toLowerCase() : '';
        grid.querySelectorAll('.premium-server-card').forEach(function (card) {
          var name = card.getAttribute('data-srv-name') || '';
          var st = card.getAttribute('data-srv-state') || '';
          var okQ = !q || name.indexOf(q) !== -1;
          var okF = currentFilter === 'all' || st === currentFilter;
          card.hidden = !(okQ && okF);
        });
      }
      if (search) search.addEventListener('input', applyFilter);
      filterBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          currentFilter = btn.getAttribute('data-srv-filter') || 'all';
          filterBtns.forEach(function (b) { b.classList.toggle('active', b === btn); });
          applyFilter();
        });
      });
    })();
  </script>
  <CheckoutConsent lang={dashLang} />
</DashMeLayout>

<style>
  .premium-benefit-locked { opacity: .85; border-style: dashed; }
  .premium-lock { background: none; color: var(--text-dim); border: 1px solid var(--border); }
  .premium-lock-reason { display: block; margin-top: 4px; }
  .premium-dash-wrap { max-width: 1160px; min-width: 0; }
  .premium-user { display:flex; align-items:center; gap:9px; margin-bottom:18px; min-width:0; font-size:13px; color:var(--text-dim); }
  .premium-user-av { width:28px; height:28px; border-radius:50%; object-fit:cover; border:1px solid var(--border); flex:none; }
  .premium-user-fallback { display:grid; place-items:center; background:var(--bg-raise); color:var(--text-dim); }
  .premium-user-text { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .premium-kicker,.premium-summary-label { font-family:var(--mono); text-transform:uppercase; letter-spacing:.06em; font-size:10.5px; color:var(--text-dim); }
  .premium-user-name { color:var(--text); font-weight:600; }
  .premium-logout { display:inline-flex; align-items:center; gap:6px; margin-left:auto; flex:none; padding:6px 10px; border-radius:999px; color:var(--text-dim); font-size:13px; text-decoration:none; }
  .premium-logout:hover { color:var(--text); background:var(--bg-raise); }
  .premium-status { display:inline-flex; align-items:center; gap:7px; white-space:nowrap; padding:6px 11px; border:1px solid var(--border); border-radius:999px; color:var(--text-muted); font-family:var(--mono); font-size:11px; font-weight:500; letter-spacing:0; line-height:1.2; }
  .premium-status-dot { width:7px; height:7px; border-radius:50%; background:var(--text-dim); }
  .premium-status-active { color:var(--green); border-color:color-mix(in srgb,var(--green) 42%,var(--border)); }.premium-status-active .premium-status-dot { background:var(--green); }
  .premium-status-pending,.premium-status-past_due { color:var(--yellow); border-color:color-mix(in srgb,var(--yellow) 40%,var(--border)); }.premium-status-pending .premium-status-dot,.premium-status-past_due .premium-status-dot { background:var(--yellow); }
  .premium-alert { display:flex; align-items:center; gap:9px; margin:0 0 12px; padding:13px 15px; border-radius:14px; font-size:14px; }.premium-alert :global(svg) { flex:none; }
  .premium-alert-error { color:var(--red); background:var(--red-soft); border:1px solid color-mix(in srgb,var(--red) 55%,var(--border)); }
  .premium-alert-success { color:var(--green); background:var(--green-soft); border:1px solid color-mix(in srgb,var(--green) 55%,var(--border)); }

  @keyframes prRiseIn { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:none; } }
  .pr-vetox-hero { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(260px,0.95fr); border:1px solid var(--border); border-radius:18px; background:var(--card); overflow:hidden; margin:4px 0 18px; animation:prRiseIn 0.42s cubic-bezier(0.22,1,0.36,1) both; }
  .pr-dash-tabs { animation:prRiseIn 0.42s cubic-bezier(0.22,1,0.36,1) 0.06s both; }
  .pr-dash-panel:not([hidden]) { animation:prRiseIn 0.36s cubic-bezier(0.22,1,0.36,1) both; }
  .premium-server-card { transition:transform 0.18s cubic-bezier(0.22,1,0.36,1), border-color 0.18s ease, background-color 0.18s ease; }
  .premium-server-card:hover { transform:translateY(-2px); background:var(--card-hover); }
  .pr-vetox-hero-left { padding:24px 26px; display:flex; flex-direction:column; gap:11px; min-width:0; }
  .pr-vetox-badge { display:inline-flex; align-items:center; gap:5px; width:fit-content; padding:3px 9px; border-radius:999px; background:rgba(217,164,65,0.16); color:#f0b857; font-family:var(--mono); font-size:10px; font-weight:700; letter-spacing:.08em; }
  .pr-vetox-hero-left h2 { margin:0; font-family:var(--serif); font-size:26px; line-height:1.15; }
  .pr-vetox-hero-left p { margin:0; color:var(--text-muted); font-size:13.5px; line-height:1.5; }
