---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import SpecularButton from '../react/SpecularButton.jsx';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  authorizeUrl: string | null;
  error?: string | null;
  loggedIn?: boolean;
}
const { authorizeUrl, error, loggedIn = false } = Astro.props;

const errorMessages: Record<string, string> = {
  missing_code: dt('Discord didn\'t send back a login code, try again.'),
  token_exchange_failed: dt('Discord rejected the login exchange, try again.'),
  user_fetch_failed: dt('Couldn\'t load your Discord profile, try again.'),
  login_failed: dt('Something went wrong logging in, try again.'),
  server_not_configured: dt('Login isn\'t configured on this environment yet.'),
  no_access: dt('You don\'t have permission to manage that server.'),
  bot_not_in_guild: dt('Petto isn\'t in that server.'),
  discord_unavailable: dt('Discord didn\'t respond in time. Petto is still running; wait a few seconds and try again.'),
};
const discordErrorCodes = new Set(['missing_code', 'token_exchange_failed', 'user_fetch_failed', 'discord_unavailable']);
const isDiscordError = error ? discordErrorCodes.has(error) : false;

const highlights = [
  { icon: 'ph:shield-check-fill', title: dt('Moderation at a glance'), desc: dt('Every case, every warn, searchable without typing a single command.'), color: 'red' },
  { icon: 'ph:gift-fill', title: dt('Giveaways in a few clicks'), desc: dt('Build role-weighted presets and reusable templates visually instead of by hand.'), color: 'yellow' },
  { icon: 'ph:hand-waving-fill', title: dt('Onboarding, configured once'), desc: dt('Welcome messages, DMs on join, and verification, all in one place.'), color: 'green' },
  { icon: 'ph:ticket', title: dt('Tickets without the setup pain'), desc: dt('Panels, categories, and transcripts, built in a form instead of a dozen commands.'), color: 'accent' },
  { icon: 'ph:chart-line-up-fill', title: dt('Leveling that fits your server'), desc: dt('XP rates, level-up messages, role rewards, and clear rank progress, tuned visually.'), color: 'green' },
  { icon: 'ph:code-fill', title: dt('Embeds with a live preview'), desc: dt('Build rich message templates with a Discord-accurate preview and the full variable list.'), color: 'accent' },
];

const steps = [
  { n: '01', icon: 'ph:plus-circle-fill', title: dt('Add Petto to your server'), desc: dt('Invite the bot with the permissions it needs, takes a few seconds.') },
  { n: '02', icon: 'simple-icons:discord', title: dt('Log in with Discord'), desc: dt('We only ever ask for identify and guilds, enough to know which servers you manage.') },
  { n: '03', icon: 'ph:sliders-horizontal-fill', title: dt('Configure everything visually'), desc: dt('Moderation, tickets, leveling, giveaways, and more, all from the dashboard.') },
];
---
<Base title={dt('Dashboard · Petto')} active="dash" showFooter>
  <main>
    <section class="dash-hero">
      <div class="wrap dash-hero-grid">
        <div class="dash-hero-copy reveal">
          <div class="eyebrow">{dt('Dashboard')}</div>
          <h1>{dt('Configure Petto without touching a single slash command.')}</h1>
          <p class="dash-lede">{dt('Moderation, tickets, leveling, giveaways, and everything else Petto runs, from a browser instead of a wall of commands to memorize.')}</p>
          {error && <div class:list={['dash-error', { 'dash-error-external': isDiscordError }]} role="alert">
            <Icon name={isDiscordError ? 'simple-icons:discord' : 'ph:warning-fill'} width="15" height="15" class="dash-error-icon" />
            <span class="dash-error-copy">
              <strong class="dash-error-source">{isDiscordError ? 'Discord · external service' : 'Petto'}</strong>
              <span>{errorMessages[error] ?? dt('Something went wrong, try again.')}</span>
            </span>
          </div>}
          {loggedIn ? (
            <SpecularButton client:idle className="dash-login" size="md" href="/dash/manage" transparent tint="#ffffff" tintOpacity={0} baseColor="#bfc4d2" textColor="var(--text)" lineColor="#ffffff" intensity={1.2} speed={0.8} radius={11}>{dt('Go to your servers')}</SpecularButton>
          ) : authorizeUrl ? (
            <SpecularButton client:idle className="dash-login" size="md" href={authorizeUrl} transparent tint="#ffffff" tintOpacity={0} baseColor="#bfc4d2" textColor="var(--text)" lineColor="#ffffff" intensity={1.2} speed={0.8} radius={11}>{dt('Log in with Discord')}</SpecularButton>
          ) : (
            <span class="btn btn-ghost dash-login" aria-disabled="true">
              <Icon name="simple-icons:discord" width="17" height="17" />
              {dt("Login not configured yet")}
            </span>
          )}
          <p class="dash-preview-note">
            <Icon name="ph:flask-fill" width="13" height="13" />
            {loggedIn
              ? dt("You're already logged in, jump straight to your servers.")
              : dt("Testing on Petto's dev bot for now. Log in for real, your own actual servers show up on the next page.")}
          </p>
        </div>
        <div class="dash-hero-art reveal">
          <div class="dash-mock-win">
            <div class="dash-mock-bar">
              <span class="chip" style="background:var(--red)"></span>
              <span class="chip" style="background:var(--yellow)"></span>
              <span class="chip" style="background:var(--green)"></span>
            </div>
            <div class="dash-mock-body">
              <div class="dash-mock-stat"><b>1,204</b><span>{dt('Members')}</span></div>
              <div class="dash-mock-stat"><b>18</b><span>{dt('Roles')}</span></div>
              <div class="dash-mock-stat"><b>24</b><span>{dt('Channels')}</span></div>
              <div class="dash-mock-bar-chart">
                {[40, 65, 30, 80, 55, 70, 45].map((h) => <span style={`height:${h}%`}></span>)}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="dash-highlights alt">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="eyebrow">{dt('What you get')}</div>
          <h2>{dt('Everything Petto runs, in one panel')}</h2>
        </div>
        <div class="highlight-grid reveal">
          {highlights.map((h) => (
            <div class={`highlight-card hl-${h.color}`}>
              <Icon name={h.icon} class="highlight-ic" />
              <div class="highlight-t">{h.title}</div>
              <p>{h.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="dash-steps">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="eyebrow">{dt('How it works')}</div>
          <h2>{dt('Three steps, no command reference needed')}</h2>
        </div>
        <div class="step-grid reveal">
          {steps.map((s) => (
            <div class="step-card">
              <div class="step-n">{s.n}</div>
              <Icon name={s.icon} class="step-ic" />
              <div class="step-t">{s.title}</div>
              <p>{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="dash-cta alt">
      <div class="wrap reveal">
        <h2>{dt('Ready to set it up?')}</h2>
        <p>{dt('Takes less than a minute to invite Petto and log in.')}</p>
        {loggedIn ? (
          <SpecularButton client:idle size="md" href="/dash/manage" transparent tint="#ffffff" tintOpacity={0} baseColor="#bfc4d2" textColor="var(--text)" lineColor="#ffffff" intensity={1.2} speed={0.8} radius={11}>{dt('Go to your servers')}</SpecularButton>
        ) : authorizeUrl ? (
          <SpecularButton client:idle size="md" href={authorizeUrl} transparent tint="#ffffff" tintOpacity={0} baseColor="#bfc4d2" textColor="var(--text)" lineColor="#ffffff" intensity={1.2} speed={0.8} radius={11}>{dt('Log in with Discord')}</SpecularButton>
        ) : null}
      </div>
    </section>
  </main>
</Base>

<style>
  .dash-hero { padding: 64px 0 0; }
  .dash-hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center; padding-bottom: 64px; }
  .dash-hero-copy h1 { font-size: 36px; line-height: 1.18; margin: 14px 0 16px; }
  .dash-lede { color: var(--text-muted); font-size: 16px; line-height: 1.65; margin-bottom: 26px; max-width: 52ch; }
  .dash-login { display: inline-flex; align-items: center; gap: 9px; font-size: 15px; padding: 12px 22px; }
  .dash-login[aria-disabled] { opacity: 0.6; cursor: not-allowed; }
  .dash-error { display: flex; align-items: flex-start; gap: 9px; font-size: 13px; color: var(--red); background: var(--red-soft); border: 1px solid var(--red); border-radius: 9px; padding: 9px 12px; margin-bottom: 18px; max-width: min(100%, 520px); }
  .dash-error-icon { flex: 0 0 auto; margin-top: 2px; }
  .dash-error-copy { display: grid; gap: 2px; line-height: 1.45; }
  .dash-error-source { font-size: 10px; letter-spacing: .06em; text-transform: uppercase; }
  .dash-error-external { color: var(--text-muted); background: rgba(88,101,242,.12); border-color: rgba(126,140,255,.7); }
  .dash-error-external .dash-error-icon, .dash-error-external .dash-error-source { color: #aeb9ff; }
  .dash-preview-note { display: flex; align-items: flex-start; gap: 7px; font-size: 12.5px; color: var(--text-dim); line-height: 1.5; margin: 16px 0 0; max-width: 46ch; }
  .dash-preview-note :global(svg) { flex-shrink: 0; margin-top: 2px; color: var(--yellow); }

  .dash-mock-win { background: var(--card); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; box-shadow: 0 30px 60px -30px rgba(0,0,0,0.5); }
  .dash-mock-bar { display: flex; gap: 7px; padding: 12px 14px; border-bottom: 1px solid var(--border-soft); }
  .dash-mock-bar .chip { width: 9px; height: 9px; border-radius: 50%; }
  .dash-mock-body { padding: 24px; display: flex; flex-direction: column; gap: 20px; }
  .dash-mock-stat { display: inline-flex; align-items: baseline; gap: 7px; margin-right: 22px; }
  .dash-mock-stat b { font-family: var(--serif); font-size: 22px; color: var(--text); }
  .dash-mock-stat span { font-size: 12px; color: var(--text-dim); }
  .dash-mock-bar-chart { display: flex; align-items: flex-end; gap: 8px; height: 90px; }
  .dash-mock-bar-chart span { flex: 1; background: linear-gradient(180deg, var(--accent), color-mix(in srgb, var(--accent) 40%, transparent)); border-radius: 4px 4px 0 0; }


  .dash-highlights { padding: 64px 0 72px; }
  .highlight-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .highlight-card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 22px; }
  .highlight-card :global(.highlight-ic) { width: 20px; height: 20px; margin-bottom: 14px; }
  .hl-red :global(.highlight-ic) { color: var(--red); }
  .hl-yellow :global(.highlight-ic) { color: var(--yellow); }
  .hl-green :global(.highlight-ic) { color: var(--green); }
  .hl-accent :global(.highlight-ic) { color: var(--accent); }
  .highlight-t { font-size: 15px; font-weight: 600; color: var(--text); margin-bottom: 6px; }
  .highlight-card p { font-size: 13.5px; color: var(--text-muted); line-height: 1.55; margin: 0; }

  .dash-steps { padding: 72px 0; }
  .step-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .step-card { position: relative; border: 1px solid var(--border); border-radius: 14px; padding: 24px 22px; background: var(--card); }
  .step-n { position: absolute; top: 18px; right: 20px; font-family: var(--mono); font-size: 12px; color: var(--text-dim); }
  .step-card :global(.step-ic) { width: 22px; height: 22px; color: var(--accent); margin-bottom: 16px; }
  .step-t { font-size: 15px; font-weight: 600; color: var(--text); margin-bottom: 6px; }
  .step-card p { font-size: 13.5px; color: var(--text-muted); line-height: 1.55; margin: 0; }

  .dash-cta { padding: 64px 0 72px; text-align: center; }
  .dash-cta h2 { font-size: 26px; margin-bottom: 10px; }
  .dash-cta p { color: var(--text-muted); font-size: 15px; margin-bottom: 24px; }

  @media (max-width: 880px) {
    .dash-hero-grid { grid-template-columns: 1fr; }
    .highlight-grid { grid-template-columns: 1fr; }
    .step-grid { grid-template-columns: 1fr; }
  }
</style>
