---
import Base from '../layouts/Base.astro';
import InlineIcon from './InlineIcon.astro';
import { type Locale } from '../i18n/ui';

interface Props {
  lang?: Locale;
}

const { lang = 'en' as Locale } = Astro.props;
const status = Astro.url.searchParams.get('status');
const error = Astro.url.searchParams.get('error');

const copy = {
  en: {
    title: 'Linked roles · Petto',
    description: 'Connect your Petto account to Discord and unlock Petto Verified in servers that use linked roles.',
    eyebrow: 'Discord connection',
    heading: 'A small role that says you are connected.',
    lede: 'Link your Discord account to Petto through petto.sbs. Once the connection is complete, Discord can grant the Petto Verified role in participating servers.',
    connect: 'Connect with Discord',
    connected: 'Connection complete',
    connectedText: 'Your Petto connection was updated. Return to Discord to finish receiving the role.',
    errorTitle: 'We could not finish the connection',
    errors: {
      missing_config: 'Linked roles are not configured on this environment yet.',
      invalid_state: 'The verification session expired. Start the connection again.',
      access_denied: 'Discord did not authorize the connection.',
      token_exchange_failed: 'Discord could not exchange the connection code.',
      user_fetch_failed: 'Petto could not read your Discord profile.',
      connection_update_failed: 'Petto could not update your Discord connection.',
      invalid_request: 'The verification request was incomplete.',
      generic: 'Something went wrong. Try again in a moment.',
    },
    serverTitle: 'For server admins',
    serverText: 'Create a role, open its Links tab, and add Petto as a requirement. We recommend naming the role Petto Verified so members know what it represents.',
    previewAria: 'Petto Verified role flow',
    previewConnection: 'Connected through',
    previewService: 'Discord connection',
    previewRequirement: 'Role requirement met',
    howEyebrow: 'How it works',
    howTitle: 'Three quick steps.',
    steps: [
      ['01', 'Connect', 'Authorize Petto with Discord.'],
      ['02', 'Verify', 'Petto records the connection on your Discord profile.'],
      ['03', 'Receive', 'Discord checks the requirement and grants the role.'],
    ],
    note: 'This connection is separate from Petto Premium. It identifies a connected Petto account; it does not grant paid features.',
  },
  es: {
    title: 'Roles vinculados · Petto',
    description: 'Conecta tu cuenta de Petto con Discord y desbloquea Petto Verified en servidores que usen roles vinculados.',
    eyebrow: 'Conexión de Discord',
    heading: 'Un rol pequeño que demuestra que estás conectado.',
    lede: 'Vincula tu cuenta de Discord con Petto mediante petto.sbs. Cuando termine la conexión, Discord podrá darte el rol Petto Verified en los servidores participantes.',
    connect: 'Conectar con Discord',
    connected: 'Conexión completada',
    connectedText: 'Tu conexión con Petto se actualizó. Regresa a Discord para terminar de recibir el rol.',
    errorTitle: 'No pudimos terminar la conexión',
    errors: {
      missing_config: 'Los roles vinculados todavía no están configurados en este entorno.',
      invalid_state: 'La sesión de verificación expiró. Inicia la conexión otra vez.',
      access_denied: 'Discord no autorizó la conexión.',
      token_exchange_failed: 'Discord no pudo intercambiar el código de conexión.',
      user_fetch_failed: 'Petto no pudo leer tu perfil de Discord.',
      connection_update_failed: 'Petto no pudo actualizar tu conexión de Discord.',
      invalid_request: 'La solicitud de verificación estaba incompleta.',
      generic: 'Algo salió mal. Inténtalo de nuevo en un momento.',
    },
    serverTitle: 'Para administradores',
    serverText: 'Crea un rol, abre la pestaña Links y agrega Petto como requisito. Recomendamos llamarlo Petto Verified para que todos sepan qué representa.',
    previewAria: 'Flujo del rol Petto Verified',
    previewConnection: 'Conectado mediante',
    previewService: 'Conexión de Discord',
    previewRequirement: 'Requisito del rol cumplido',
    howEyebrow: 'Cómo funciona',
    howTitle: 'Tres pasos rápidos.',
    steps: [
      ['01', 'Conecta', 'Autoriza Petto con Discord.'],
      ['02', 'Verifica', 'Petto guarda la conexión en tu perfil de Discord.'],
      ['03', 'Recibe', 'Discord comprueba el requisito y entrega el rol.'],
    ],
    note: 'Esta conexión es independiente de Petto Premium. Identifica una cuenta conectada a Petto; no concede funciones de pago.',
  },
  'pt-BR': {
    title: 'Cargos vinculados · Petto',
    description: 'Conecte sua conta Petto ao Discord e desbloqueie o Petto Verified em servidores que usam cargos vinculados.',
    eyebrow: 'Conexão do Discord',
    heading: 'Um cargo pequeno que mostra que você está conectado.',
    lede: 'Vincule sua conta do Discord ao Petto pelo petto.sbs. Quando a conexão terminar, o Discord poderá conceder o cargo Petto Verified nos servidores participantes.',
    connect: 'Conectar com o Discord',
    connected: 'Conexão concluída',
    connectedText: 'Sua conexão com o Petto foi atualizada. Volte ao Discord para terminar de receber o cargo.',
    errorTitle: 'Não foi possível concluir a conexão',
    errors: {
      missing_config: 'Os cargos vinculados ainda não estão configurados neste ambiente.',
      invalid_state: 'A sessão de verificação expirou. Comece a conexão novamente.',
      access_denied: 'O Discord não autorizou a conexão.',
      token_exchange_failed: 'O Discord não conseguiu trocar o código de conexão.',
      user_fetch_failed: 'O Petto não conseguiu ler seu perfil do Discord.',
      connection_update_failed: 'O Petto não conseguiu atualizar sua conexão do Discord.',
      invalid_request: 'A solicitação de verificação estava incompleta.',
      generic: 'Algo deu errado. Tente novamente em instantes.',
    },
    serverTitle: 'Para administradores',
    serverText: 'Crie um cargo, abra a aba Links e adicione o Petto como requisito. Recomendamos o nome Petto Verified para deixar claro o que ele representa.',
    previewAria: 'Fluxo do cargo Petto Verified',
    previewConnection: 'Conectado pelo',
    previewService: 'Conexão do Discord',
    previewRequirement: 'Requisito do cargo atendido',
    howEyebrow: 'Como funciona',
    howTitle: 'Três passos rápidos.',
    steps: [
      ['01', 'Conecte', 'Autorize o Petto com o Discord.'],
      ['02', 'Verifique', 'O Petto registra a conexão no seu perfil do Discord.'],
      ['03', 'Receba', 'O Discord confere o requisito e concede o cargo.'],
    ],
    note: 'Esta conexão é separada do Petto Premium. Ela identifica uma conta conectada ao Petto; não concede recursos pagos.',
  },
}[lang];

const errorMessage = error ? (copy.errors as Record<string, string>)[error] ?? copy.errors.generic : null;
---

<Base title={copy.title} description={copy.description} lang={lang} showFooter>
  <main class="linked-page">
    <section class="linked-hero wrap">
      <div class="linked-copy">
        <p class="eyebrow"><InlineIcon name="ph:link-fill" width="14" height="14" /> {copy.eyebrow}</p>
        <h1>{copy.heading}</h1>
        <p class="linked-lede">{copy.lede}</p>
        {status === 'connected' ? (
          <div class="linked-alert linked-success" role="status">
            <InlineIcon name="ph:check-circle-fill" width="19" height="19" />
            <div><strong>{copy.connected}</strong><span>{copy.connectedText}</span></div>
          </div>
        ) : errorMessage ? (
          <div class="linked-alert linked-error" role="alert">
            <InlineIcon name="ph:warning-fill" width="19" height="19" />
            <div><strong>{copy.errorTitle}</strong><span>{errorMessage}</span></div>
          </div>
        ) : null}
        {status !== 'connected' && <a class="btn btn-accent linked-cta" href="/linked-roles/start"><InlineIcon name="simple-icons:discord" width="17" height="17" /> {copy.connect}</a>}
        <p class="linked-note"><InlineIcon name="ph:info-fill" width="14" height="14" /> {copy.note}</p>
      </div>

      <div class="linked-card linked-preview" aria-label={copy.previewAria}>
        <div class="linked-card-top"><span class="linked-status-dot"></span><span>petto.sbs</span><span class="linked-card-top-muted">{copy.previewService}</span></div>
        <div class="linked-role-icon"><InlineIcon name="ph:seal-check-fill" width="25" height="25" /></div>
        <h2>Petto Verified</h2>
        <p>{copy.previewConnection} <b>Petto</b></p>
        <div class="linked-chip"><InlineIcon name="ph:check-bold" width="12" height="12" /> {copy.previewRequirement}</div>
      </div>
    </section>

    <section class="linked-section wrap">
      <div class="linked-section-heading"><p class="eyebrow">{copy.howEyebrow}</p><h2>{copy.howTitle}</h2></div>
      <div class="linked-steps">
        {copy.steps.map(([number, title, text]) => <article class="linked-step"><span>{number}</span><h3>{title}</h3><p>{text}</p></article>)}
      </div>
    </section>

    <section class="linked-admin wrap">
      <div class="linked-admin-icon"><InlineIcon name="ph:gear-six-fill" width="20" height="20" /></div>
      <div><p class="eyebrow">{copy.serverTitle}</p><p>{copy.serverText}</p></div>
    </section>
  </main>
</Base>

<style>
  .linked-page { padding: 84px 0 110px; }
  .linked-hero { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(min(300px, 100%), .88fr); gap: 70px; align-items: center; min-height: 500px; }
  .linked-copy { max-width: 650px; }
  .linked-copy .eyebrow, .linked-section-heading .eyebrow, .linked-admin .eyebrow { display: flex; align-items: center; gap: 7px; margin: 0 0 16px; color: var(--accent); }
  .linked-copy h1 { font-size: clamp(45px, 6vw, 78px); line-height: .99; max-width: 700px; }
  .linked-lede { color: var(--text-muted); font-size: 18px; line-height: 1.65; max-width: 615px; margin: 26px 0 28px; }
  .linked-cta { margin-top: 3px; padding: 13px 20px; }
  .linked-note { display: flex; align-items: flex-start; gap: 7px; color: var(--text-dim); font-size: 12.5px; line-height: 1.5; max-width: 560px; margin: 22px 0 0; }
  .linked-note svg { flex: 0 0 auto; margin-top: 3px; }
  .linked-alert { display: flex; gap: 11px; align-items: flex-start; border: 1px solid; border-radius: 12px; padding: 13px 15px; margin: 22px 0 18px; max-width: 590px; }
  .linked-alert > svg { flex: 0 0 auto; margin-top: 2px; }
  .linked-alert div { display: grid; gap: 2px; }
  .linked-alert span { color: var(--text-muted); font-size: 13px; }
  .linked-success { border-color: color-mix(in srgb, var(--green) 65%, var(--border)); background: var(--green-soft); color: var(--green); }
  .linked-error { border-color: color-mix(in srgb, var(--red) 65%, var(--border)); background: var(--red-soft); color: var(--red); }
  .linked-card { border: 1px solid var(--border); border-radius: 20px; background: linear-gradient(145deg, color-mix(in srgb, var(--accent) 11%, var(--card)), var(--card) 62%); box-shadow: 0 28px 60px -42px rgba(0,0,0,.75); }
  .linked-preview { padding: 22px; text-align: center; min-height: 330px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .linked-preview::before { content: ''; position: absolute; width: 190px; height: 190px; border-radius: 50%; background: var(--accent-soft); filter: blur(10px); top: -90px; right: -40px; }
  .linked-card-top { width: 100%; display: flex; align-items: center; gap: 7px; color: var(--text); font-family: var(--mono); font-size: 11px; letter-spacing: .04em; position: absolute; top: 20px; left: 22px; text-align: left; }
  .linked-card-top-muted { color: var(--text-dim); margin-left: auto; margin-right: 42px; letter-spacing: 0; }
  .linked-status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 4px var(--green-soft); }
  .linked-role-icon { width: 66px; height: 66px; display: grid; place-items: center; border-radius: 19px; background: var(--accent-soft); color: var(--accent); margin-top: 24px; }
  .linked-preview h2 { font-family: 'Petto Sans', var(--sans); font-size: 25px; margin: 18px 0 3px; }
  .linked-preview p { margin: 0; color: var(--text-muted); font-size: 13px; }
  .linked-chip { display: inline-flex; align-items: center; gap: 6px; color: var(--green); border: 1px solid color-mix(in srgb, var(--green) 40%, var(--border)); background: var(--green-soft); border-radius: 999px; padding: 7px 11px; font-size: 11.5px; margin-top: 24px; }
  .linked-section { padding-top: 45px; }
  .linked-section-heading h2 { font-size: clamp(30px, 4vw, 44px); }
  .linked-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 25px; }
  .linked-step { padding: 22px; border: 1px solid var(--border); border-radius: 15px; background: var(--card); }
  .linked-step > span { color: var(--accent); font-family: var(--mono); font-size: 12px; }
  .linked-step h3 { font-family: 'Petto Sans', var(--sans); font-size: 19px; margin: 24px 0 5px; }
  .linked-step p { color: var(--text-muted); font-size: 13.5px; margin: 0; }
  .linked-admin { display: flex; gap: 16px; align-items: flex-start; border: 1px solid var(--border); border-radius: 15px; background: var(--card); padding: 22px; margin-top: 55px; }
  .linked-admin-icon { display: grid; place-items: center; width: 40px; height: 40px; flex: 0 0 auto; color: var(--yellow); border-radius: 12px; background: var(--yellow-soft); }
  .linked-admin .eyebrow { margin-bottom: 4px; color: var(--yellow); }
  .linked-admin p:last-child { color: var(--text-muted); margin: 0; font-size: 14px; max-width: 850px; }
  @media (max-width: 760px) { .linked-page { padding-top: 45px; } .linked-hero { grid-template-columns: 1fr; gap: 35px; min-height: 0; } .linked-copy h1 { font-size: clamp(42px, 12vw, 65px); } .linked-lede { font-size: 16px; } .linked-steps { grid-template-columns: 1fr; } .linked-preview { min-height: 285px; } .linked-card-top-muted { display: none; } }
</style>
