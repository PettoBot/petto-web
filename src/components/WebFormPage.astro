---
// A form of a server, filled on the website: /form/<public id> (and /es/form/…, /pt-br/form/…). The site draws the page on the server
// with the look of the form (utils/formPreview.ts): its color is the accent, with its banner, a solid or gradient background, the icon and
// the name of the server, the icon of the server in the tab, and the tags of the link preview the server set in the dashboard. It is
// the same frame as the appeal site: a bar with the server and the languages, one card with the banner on top, and a small footer.
// The member logs in with Discord (only their identity); the script asks /api/form/<id> whether they may send it (member of the
// server, roles, ages, pending, cooldown, limits, dates), shows the questions in steps of five (the pages of Discord) and sends the
// answers through the same pipeline as Discord. After sending, the page shows where the submission is.
// The older address /form#<public id> is the same component without a form (a static page): its script sends the visitor on to
// /form/<public id>.
import { Icon } from 'astro-icon/components';
import { makeT } from '../i18n/dash';
import type { Locale } from '../i18n/ui';
import { formPreview, type FormLook } from '../utils/formPreview';
import { formIdPath, formPagePath, type PageLook } from '../utils/forms';

interface Props { lang: Locale; id?: string | null; look?: FormLook | null; status?: number }
const { lang, id = null, look = null, status = 200 } = Astro.props;
const dt = makeT(lang);
const SITE = 'https://petto.sbs';
const LANGS: { code: Locale; label: string; hreflang: string; locale: string }[] = [
  { code: 'en', label: 'EN', hreflang: 'en', locale: 'en_US' },
  { code: 'es', label: 'ES', hreflang: 'es', locale: 'es_ES' },
  { code: 'pt-BR', label: 'PT', hreflang: 'pt-BR', locale: 'pt_BR' },
];
const pathIn = (l: Locale) => (id ? formIdPath(id, l) : formPagePath(l));
const canonical = `${SITE}${pathIn(lang)}`;
const notFound = status === 404;
const preview = look ? formPreview(look, lang === 'pt-BR' ? 'pt-BR' : lang === 'es' ? 'es' : 'en') : null;
const title = preview?.title ?? (notFound ? `${dt('This form does not exist')} · Petto` : `${dt('Form')} · Petto`);
const description = preview?.description ?? dt('Fill in this form with your Discord account.');
const color = look?.color != null ? `#${look.color.toString(16).padStart(6, '0')}` : null;
// The text on the buttons of the color: dark on a light color, white on a dark one.
const ink = look?.color != null ? ((0.2126 * ((look.color >> 16) & 255) + 0.7152 * ((look.color >> 8) & 255) + 0.0722 * (look.color & 255)) / 255 > 0.6 ? '#16171a' : '#ffffff') : null;
const page: PageLook = look?.page ?? { banner: null, background: 'default', show_icon: true, show_name: true, hide_branding: false };
const server = look?.server ?? null;
const showIcon = page.show_icon !== false;
const showName = page.show_name !== false && Boolean(server?.name);
const ogImage = preview?.image ?? `${SITE}/assets/petto-link-banner-min.png`;
const large = preview ? preview.large : true;
const texts = {
  required: dt('Answer this question.'), number: dt('Write a number.'), range: dt('Write a number from {min} to {max}.'), short: dt('Write at least {count} characters.'), many: dt('Pick up to {count}.'),
  yes: dt('Yes'), no: dt('No'), optional: dt('optional'), requiredLabel: dt('Required'), pickUpTo: dt('Pick up to {a}.'), pickAll: dt('Pick all that apply.'),
  answeringAs: dt('Answering as {a}'), staffReads: dt('The staff of {a} reads your answers in Discord.'), sent: dt('Sent (#{a})'),
  fix: dt('Some answers need a fix.'), failed: dt('It could not be sent. Try again in a moment.'),
  notFound: dt('This form does not exist'), notFoundHelp: dt('It may have been deleted, or the link is wrong.'), noLoad: dt('The form could not be loaded'), noLoadHelp: dt('Petto did not answer. Try again in a moment.'),
  noId: dt('This link has no form'), noIdHelp: dt('Open the link of the form again, it ends with the id of the form.'), form: dt('Form'),
  step: dt('Step {a} of {b}'), answered: dt('{a} of {b} answered'), pendingTitle: dt('You already sent this form'),
};
const style = [color && `--wf:${color}`, ink && `--wf-ink:${ink}`].filter(Boolean).join(';');
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    // The site's saved theme (the switch of petto.sbs), before the page paints; otherwise the one of the device.
    try { var savedTheme = localStorage.getItem('petto-theme'); if (savedTheme === 'light' || savedTheme === 'dark') document.documentElement.setAttribute('data-theme', savedTheme); } catch (e) { /* private window */ }
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content={preview?.color ?? '#f0a88f'} />
  <link rel="canonical" href={canonical} />
  {LANGS.map((l) => <link rel="alternate" hreflang={l.hreflang} href={`${SITE}${pathIn(l.code)}`} />)}
  <link rel="alternate" hreflang="x-default" href={`${SITE}${pathIn('en')}`} />
  <link rel="icon" href={server?.icon ?? '/assets/mascot-icon.png'} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={preview?.siteName ?? 'Petto'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={LANGS.find((l) => l.code === lang)!.locale} />
  {LANGS.filter((l) => l.code !== lang).map((l) => <meta property="og:locale:alternate" content={l.locale} />)}
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content={large ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="robots" content="noindex" />
  <style is:global set:html={`
    @font-face { font-family: 'Jakarta Variable'; src: url('/fonts/dash/plus-jakarta-sans-latin-wght-normal.woff2') format('woff2-variations'); font-weight: 200 800; font-display: swap; unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122; }
    @font-face { font-family: 'Jakarta Variable'; src: url('/fonts/dash/plus-jakarta-sans-latin-ext-wght-normal.woff2') format('woff2-variations'); font-weight: 200 800; font-display: swap; unicode-range: U+0100-02BA, U+1E00-1EFF, U+2C60-2C7F, U+A720-A7FF; }
    @font-face { font-family: 'Fraunces Variable'; src: url('/fonts/dash/fraunces-latin-wght-normal.woff2') format('woff2-variations'); font-weight: 100 900; font-display: swap; unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122; }
    @font-face { font-family: 'Fraunces Variable'; src: url('/fonts/dash/fraunces-latin-ext-wght-normal.woff2') format('woff2-variations'); font-weight: 100 900; font-display: swap; unicode-range: U+0100-02BA, U+1E00-1EFF, U+2C60-2C7F, U+A720-A7FF; }
  `} />
</head>
<body class:list={['wf', { 'wf-bg-solid': page.background === 'solid', 'wf-bg-gradient': page.background === 'gradient', 'wf-bg-aurora': page.background === 'aurora', 'wf-bg-waves': page.background === 'waves' }]} style={style || undefined} data-wf-root data-wf-id={id ?? ''} data-wf-status={String(status)} data-wf-lang={lang} data-wf-base={formPagePath(lang)}>
  <div class="wf-shell">
    <header class="wf-top">
      <span class="wf-brand">
        {showIcon && (server?.icon ? <img src={server.icon} alt="" width="34" height="34" data-wf-icon /> : server ? <span class="wf-letter" data-wf-letter>{server.name.slice(0, 1) || '?'}</span> : <img src="/assets/mascot-icon.webp" alt="" width="34" height="34" data-wf-icon />)}
        <span data-wf-server>{showName ? server!.name : server ? '' : 'Petto'}</span>
      </span>
      <nav class="wf-langs" aria-label="Language">
        {LANGS.map((l) => <a href={pathIn(l.code)} class:list={['wf-lang', { on: l.code === lang }]} hreflang={l.hreflang} lang={l.hreflang} aria-current={l.code === lang ? 'page' : undefined} data-wf-lang-link={l.code}>{l.label}</a>)}
        <button class="wf-theme" type="button" data-wf-theme aria-label={dt('Change theme')} title={dt('Change theme')}><Icon name="ph:sun-fill" width="15" height="15" /></button>
      </nav>
    </header>

    <main class="wf-screen">
      {page.banner && <div class="wf-banner" data-wf-banner><img src={page.banner} alt="" decoding="async" referrerpolicy="no-referrer" onerror="this.parentNode.hidden=true" /></div>}
      <div class="wf-inner">
        <div class="wf-head" data-wf-head hidden={!look}>
          <div class="wf-eyebrow">
            <span class="wf-chip"><Icon name="ph:list-checks-fill" width="13" height="13" />{dt('Form')}</span>
            {id && <span class="wf-id" title={dt('Link of the form:')} translate="no"><span class="wf-id-p">~/form/</span><span>{id}</span><i class="wf-caret" aria-hidden="true"></i></span>}
          </div>
          <h1 data-wf-title>{look?.title ?? ''}</h1>
          {look?.description ? <p class="wf-desc" data-wf-desc>{look.description}</p> : <p class="wf-desc" data-wf-desc hidden></p>}
        </div>

        <div class="wf-loading" data-wf-state="loading" role="status" aria-label="…" hidden={notFound}><span class="wf-spin"></span></div>

        <div class="wf-card wf-center" data-wf-state="login" hidden>
          <span class="wf-badge"><Icon name="simple-icons:discord" width="22" height="22" /></span>
          <h2>{dt('Log in to fill in this form')}</h2>
          <p class="wf-muted">{dt('Petto only asks Discord who you are, to send your answers as you and check that you are in the server.')}</p>
          <a class="wf-btn" href={id ? `/f/login?form=${id}&lang=${encodeURIComponent(lang)}` : '/f/login'} data-wf-login><Icon name="simple-icons:discord" width="16" height="16" />{dt('Log in with Discord')}</a>
        </div>

        <div class="wf-card wf-center" data-wf-state="error" hidden={!notFound}>
          <span class="wf-badge warn"><Icon name="ph:warning-fill" width="22" height="22" /></span>
          <h2 data-wf-error-title>{notFound ? texts.notFound : ''}</h2>
          <p class="wf-muted" data-wf-error-help>{notFound ? texts.notFoundHelp : ''}</p>
          <a class="wf-btn sec" href={lang === 'en' ? '/' : lang === 'es' ? '/es/' : '/pt-br/'} data-wf-home hidden={!notFound}>{dt('Go to Petto')}</a>
          <button class="wf-btn sec" type="button" data-wf-retry hidden>{dt('Try again')}</button>
        </div>

        <div class="wf-who" data-wf-state="who" hidden>
          <Icon name="ph:user-circle-fill" width="16" height="16" /><span data-wf-who></span><a href="/dash/logout">{dt('Not you?')}</a>
        </div>

        <div class="wf-card wf-status" role="status" data-wf-state="sent" hidden>
          <div class="wf-status-top">
            <span class="wf-done-icon"><Icon name="ph:check-circle-fill" width="34" height="34" /></span>
            <div><h2 data-wf-sent-title></h2><p class="wf-muted" data-wf-sent-text></p></div>
          </div>
          <ol class="wf-steps">
            <li class="done"><span class="wf-dot"><Icon name="ph:paper-plane-tilt-fill" width="13" height="13" /></span><div><b>{dt('Sent')}</b><span class="wf-muted">{dt('Your answers reached the staff.')}</span></div></li>
            <li class="now"><span class="wf-dot"><Icon name="ph:hourglass-medium-fill" width="13" height="13" /></span><div><b>{dt('In review')}</b><span class="wf-muted" data-wf-staff></span></div></li>
            <li><span class="wf-dot"><Icon name="ph:envelope-simple-fill" width="13" height="13" /></span><div><b>{dt('Result')}</b><span class="wf-muted">{dt('The staff accepts or denies it in Discord.')}</span></div></li>
          </ol>
        </div>

        <div class="wf-card wf-refused" role="status" data-wf-state="refused" hidden>
          <span class="wf-badge warn"><Icon name="ph:lock-fill" width="18" height="18" class="wf-ic-lock" /><Icon name="ph:hourglass-medium-fill" width="18" height="18" class="wf-ic-wait" /></span>
          <div><h2 data-wf-refused-title hidden></h2><p data-wf-reason></p></div>
        </div>

        <form class="wf-form" novalidate data-wf-form data-wf-state="fill" hidden>
          <div class="wf-progress" data-wf-progress>
            <div class="wf-progress-row"><span data-wf-step-label></span><span data-wf-answered></span></div>
            <div class="wf-bar"><i data-wf-bar></i></div>
          </div>
          <div class="wf-alert" role="alert" data-wf-alert hidden><Icon name="ph:warning-fill" width="15" height="15" /><span></span></div>
          <div class="wf-qs" data-wf-questions></div>
          <div class="wf-foot">
            <button class="wf-btn sec" type="button" data-wf-back hidden><Icon name="ph:arrow-left-bold" width="14" height="14" />{dt('Back')}</button>
            <button class="wf-btn" type="button" data-wf-next hidden>{dt('Next')}<Icon name="ph:arrow-right-bold" width="14" height="14" /></button>
            <button class="wf-btn" type="submit" data-wf-send><Icon name="ph:paper-plane-tilt-fill" width="15" height="15" />{dt('Send')}</button>
          </div>
        </form>
      </div>
    </main>
    <footer class="wf-foot-site" data-wf-foot hidden={page.hide_branding === true}><a href={lang === 'en' ? '/' : lang === 'es' ? '/es/' : '/pt-br/'}><img src="/assets/mascot-icon.webp" alt="" width="18" height="18" />{dt('Forms by Petto')}</a></footer>
  </div>

  <script is:inline define:vars={{ texts }}>
    (function () {
      var root = document.querySelector('[data-wf-root]');
      if (!root) return;
      var $ = function (sel) { return root.querySelector(sel); };
      var fill = function (text, vars) { return text.replace(/\{(\w+)\}/g, function (w, k) { return k in vars ? vars[k] : w; }); };
      var VALID = /^[0-9A-Za-z]{12}$/;
      var lang = root.getAttribute('data-wf-lang') || 'en';
      var base = root.getAttribute('data-wf-base') || '/form';
      var id = root.getAttribute('data-wf-id') || '';

      // The switch of the theme: the same saved choice as the rest of petto.sbs.
      $('[data-wf-theme]').addEventListener('click', function () {
        var html = document.documentElement;
        var now = html.getAttribute('data-theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        var next = now === 'light' ? 'dark' : 'light';
        html.setAttribute('data-theme', next);
        try { localStorage.setItem('petto-theme', next); } catch (e) { /* private window */ }
      });

      var show = function (names) {
        root.querySelectorAll('[data-wf-state]').forEach(function (el) { el.hidden = names.indexOf(el.getAttribute('data-wf-state')) === -1; });
      };
      var error = function (title, help, retry) {
        $('[data-wf-error-title]').textContent = title;
        $('[data-wf-error-help]').textContent = help;
        $('[data-wf-retry]').hidden = !retry;
        $('[data-wf-home]').hidden = Boolean(retry);
        show(['error']);
      };

      // The older address (/form#<id>, or back from the login without it): the page of the form is /form/<id> now.
      if (!id) {
        var KEY = 'petto-form-id';
        var fromHash = (location.hash || '').slice(1);
        var kept = '';
        try { kept = sessionStorage.getItem(KEY) || ''; sessionStorage.removeItem(KEY); } catch (e) { kept = ''; }
        var target = VALID.test(fromHash) ? fromHash : VALID.test(kept) ? kept : '';
        if (target) { location.replace(base + '/' + target + location.search); return; }
        error(texts.noId, texts.noIdHelp, false);
        return;
      }
      if (root.getAttribute('data-wf-status') === '404') return;

      var api = '/api/form/' + id + '?lang=' + encodeURIComponent(lang);
      var form = $('[data-wf-form]');
      var list = $('[data-wf-questions]');
      var PAGE = 5;
      var step = 0;
      var steps = 1;

      var el = function (tag, attrs, text) {
        var node = document.createElement(tag);
        if (attrs) Object.keys(attrs).forEach(function (k) { if (attrs[k] !== null && attrs[k] !== undefined && attrs[k] !== false) node.setAttribute(k, attrs[k] === true ? '' : attrs[k]); });
        if (text !== undefined && text !== null) node.textContent = text;
        return node;
      };
      var choice = function (type, name, value, label) {
        var wrap = el('label', { class: 'wf-choice' + (type === 'checkbox' ? ' wf-check' : '') });
        wrap.appendChild(el('input', { type: type, name: name, value: value }));
        wrap.appendChild(el('span', null, label));
        return wrap;
      };
      var question = function (q, index) {
        var box = el('fieldset', { class: 'wf-q', style: '--i:' + (index % PAGE), 'data-q': q.id, 'data-step': String(Math.floor(index / PAGE)), 'data-type': q.type, 'data-required': q.required ? '1' : '0', 'data-min': q.min_length == null ? '' : q.min_length, 'data-minv': q.min_value == null ? '' : q.min_value, 'data-maxv': q.max_value == null ? '' : q.max_value, 'data-maxc': q.max_choices == null ? '' : q.max_choices });
        var legend = el('legend');
        legend.appendChild(el('span', { class: 'wf-n' }, String(index + 1)));
        legend.appendChild(el('span', { class: 'wf-label' }, q.label));
        legend.appendChild(q.required ? el('em', { class: 'wf-req', 'aria-label': texts.requiredLabel }, '*') : el('span', { class: 'wf-opt' }, texts.optional));
        box.appendChild(legend);
        if (q.image) box.appendChild(el('img', { class: 'wf-img', src: q.image, alt: q.label, loading: 'lazy', decoding: 'async', referrerpolicy: 'no-referrer' }));
        if (q.help) box.appendChild(el('p', { class: 'wf-help' }, q.help));
        // Made safe by the site (utils/forms.ts descriptionHtml): everything is escaped, then only bold, italics, code and links are made.
        if (q.description_html) { var d = el('div', { class: 'wf-qdesc' }); d.innerHTML = q.description_html; box.appendChild(d); }
        var name = 'q_' + q.id;
        if (q.type === 'short') box.appendChild(el('input', { type: 'text', name: name, maxlength: q.max_length || 1000, placeholder: q.placeholder || '', required: q.required, 'aria-label': q.label }));
        else if (q.type === 'paragraph') box.appendChild(el('textarea', { name: name, maxlength: q.max_length || 4000, placeholder: q.placeholder || '', required: q.required, rows: '5', 'aria-label': q.label }));
        else if (q.type === 'number') box.appendChild(el('input', { type: 'text', inputmode: 'decimal', name: name, maxlength: '30', placeholder: q.placeholder || (q.min_value != null && q.max_value != null ? q.min_value + ' – ' + q.max_value : ''), required: q.required, 'aria-label': q.label }));
        else if (q.type === 'yesno') { var row = el('div', { class: 'wf-choices wf-row' }); row.appendChild(choice('radio', name, 'yes', texts.yes)); row.appendChild(choice('radio', name, 'no', texts.no)); box.appendChild(row); }
        else if (q.type === 'choice' || q.type === 'multi') {
          var grid = el('div', { class: 'wf-choices' });
          (q.options || []).forEach(function (option, i) { grid.appendChild(choice(q.type === 'multi' ? 'checkbox' : 'radio', name, 'o' + i, option)); });
          box.appendChild(grid);
          if (q.type === 'multi') box.appendChild(el('p', { class: 'wf-help' }, q.max_choices ? fill(texts.pickUpTo, { a: q.max_choices }) : texts.pickAll));
        }
        box.appendChild(el('p', { class: 'wf-err', 'data-err': true, 'aria-live': 'polite' }));
        return box;
      };
      var alertBox = function (text) {
        var box = $('[data-wf-alert]');
        box.hidden = !text;
        box.querySelector('span').textContent = text || '';
      };
      var boxes = function () { return Array.prototype.slice.call(list.querySelectorAll('[data-q]')); };
      var answered = function (box) {
        var type = box.dataset.type;
        if (type === 'short' || type === 'paragraph' || type === 'number') return Boolean((box.querySelector('input[name^="q_"], textarea').value || '').trim());
        return Boolean(box.querySelector('input[name^="q_"]:checked'));
      };
      // The bar over the questions: how many are answered, and the step when the form has more than five questions.
      var progress = function () {
        var all = boxes();
        var done = all.filter(answered).length;
        $('[data-wf-bar]').style.width = (all.length ? Math.round((done / all.length) * 100) : 0) + '%';
        $('[data-wf-answered]').textContent = fill(texts.answered, { a: done, b: all.length });
        $('[data-wf-step-label]').textContent = steps > 1 ? fill(texts.step, { a: step + 1, b: steps }) : '';
      };
      var goTo = function (n, scroll) {
        step = Math.max(0, Math.min(steps - 1, n));
        boxes().forEach(function (box) { box.hidden = Number(box.dataset.step) !== step; });
        $('[data-wf-back]').hidden = step === 0;
        $('[data-wf-next]').hidden = step >= steps - 1;
        $('[data-wf-send]').hidden = step < steps - 1;
        progress();
        if (scroll) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };

      // The same checks as the bot, before sending, so a mistake is shown at once. The bot checks everything again.
      var check = function (box) {
        var type = box.dataset.type;
        var required = box.dataset.required === '1';
        var msg = '';
        if (type === 'short' || type === 'paragraph' || type === 'number') {
          var input = box.querySelector('input[name^="q_"], textarea');
          var text = (input.value || '').trim();
          if (!text) { if (required) msg = texts.required; }
          else if (type === 'number') {
            var normal = text.replace(/\s/g, '').replace(',', '.');
            if (!/^-?\d{1,15}(\.\d{1,6})?$/.test(normal)) msg = texts.number;
            else {
              var n = Number(normal), min = box.dataset.minv, max = box.dataset.maxv;
              if ((min !== '' && n < Number(min)) || (max !== '' && n > Number(max))) msg = fill(texts.range, { min: min || '…', max: max || '…' });
            }
          } else if (box.dataset.min && text.length < Number(box.dataset.min)) msg = fill(texts.short, { count: box.dataset.min });
        } else {
          var picked = box.querySelectorAll('input[name^="q_"]:checked').length;
          if (!picked && required) msg = texts.required;
          else if (type === 'multi' && box.dataset.maxc && picked > Number(box.dataset.maxc)) msg = fill(texts.many, { count: box.dataset.maxc });
        }
        mark(box, msg);
        return !msg;
      };
      var mark = function (box, msg) { box.classList.toggle('wf-q-bad', Boolean(msg)); box.querySelector('[data-err]').textContent = msg || ''; };
      form.addEventListener('change', function (event) { var box = event.target.closest('[data-q]'); if (box && box.classList.contains('wf-q-bad')) check(box); progress(); });
      form.addEventListener('input', progress);
      form.addEventListener('focusout', function (event) { var box = event.target.closest('[data-q]'); if (box && event.target.matches('input[type=text], textarea') && event.target.value) check(box); });
      var collect = function () {
        var values = {};
        boxes().forEach(function (box) {
          var qid = box.dataset.q, type = box.dataset.type;
          if (type === 'multi') values[qid] = Array.prototype.map.call(box.querySelectorAll('input:checked'), function (i) { return i.value; });
