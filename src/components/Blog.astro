---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { useTranslations, localePath, sortedReleases, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = localePath[lang];
const b = t.blogIndexPage;

const posts = sortedReleases(lang).filter((p) => p.href);
---
<Base title={`${b.eyebrow} · Petto`} lang={lang}>
  <main>
    <section class="blog-sec">
      <div class="wrap blog-wrap">
        <div class="eyebrow">{b.eyebrow}</div>
        <h1>{b.title}</h1>
        <p class="blog-lede">{b.lede}</p>

        {posts.length > 0 ? (
          <div class="blog-grid reveal">
            {posts.map((p) => (
              <a class="blog-card" href={`${base}${p.href}`}>
                <div class="blog-banner">
                  {p.banner ? <img src={p.banner} alt="" /> : <img src="/assets/mascot-icon.webp" alt="" class="blog-placeholder" />}
                </div>
                <div class="blog-meta">{p.category} · {p.date}</div>
                <h2>{p.title}</h2>
                <p>{p.desc}</p>
                <span class="blog-read">{b.readMore} <Icon name="ph:arrow-right" width="13" height="13" /></span>
              </a>
            ))}
          </div>
        ) : (
          <p class="blog-empty">{b.empty}</p>
        )}
      </div>
    </section>
  </main>
</Base>

<style>
  .blog-sec { padding: 64px 0 110px; }
  .blog-wrap { max-width: 1120px; }
  .blog-sec h1 { font-size: 32px; margin: 14px 0 12px; }
  .blog-lede { color: var(--text-muted); font-size: 15.5px; line-height: 1.65; max-width: 60ch; margin-bottom: 44px; }

  .blog-grid { display: flex; flex-wrap: wrap; gap: 24px; }
  .blog-card { flex: 1 1 300px; max-width: 340px; }
  .blog-card { display: block; text-decoration: none; color: inherit; border: 1px solid var(--border); border-radius: 16px; overflow: hidden; background: var(--card); transition: border-color 0.15s ease, transform 0.15s ease; }
  .blog-card:hover { border-color: var(--text-dim); transform: translateY(-2px); }
  .blog-banner { aspect-ratio: 16/9; background: var(--bg-raise); display: flex; align-items: center; justify-content: center; border-bottom: 1px solid var(--border-soft); }
  .blog-banner img { width: 100%; height: 100%; object-fit: cover; }
  .blog-banner img.blog-placeholder { width: 40px; height: 40px; object-fit: contain; opacity: 0.5; }
  .blog-meta { font-family: var(--mono); font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-dim); margin: 16px 18px 8px; }
  .blog-card h2 { font-size: 17px; margin: 0 18px 8px; }
  .blog-card p { font-size: 13.5px; color: var(--text-muted); line-height: 1.55; margin: 0 18px 16px; }
  .blog-read { display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: var(--accent); margin: 0 18px 18px; }

  .blog-empty { color: var(--text-dim); font-size: 14px; border: 1px dashed var(--border); border-radius: 14px; padding: 20px; }
</style>
