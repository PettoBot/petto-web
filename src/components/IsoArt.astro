---
// Isometric line drawings for the headers of the redesigned pages, animated with CSS only (they stop with "reduce motion"):
//  - hub: the bot in the middle and its modules around it, that light up one after another (Features);
//  - slots: three stacked plates with 5, 3 and 1 server marks, that rise in turn (Premium: the plans of 1, 3 and 5 servers);
//  - keys: a keyboard whose keys are pressed in a wave (Commands).
import IsoBox from './IsoBox.astro';
import { P, str, scene } from '../utils/iso';

interface Props { variant: 'hub' | 'slots' | 'keys'; class?: string }
const { variant, class: className = '' } = Astro.props;

const A = scene(40);
let view = '';
let base = null as null | ReturnType<typeof A.box>;
let items: { b: ReturnType<typeof A.box>; i: number; cls: string }[] = [];
let extras: { b: ReturnType<typeof A.box>; i: number; cls: string }[] = [];
let links: string[] = [];

if (variant === 'hub') {
  base = A.box(0, 0, -0.3, 7, 7, 0.3);
  const spots: [number, number, number][] = [[0.5, 0.5, 1.3], [5.1, 0.5, 1.0], [0.5, 5.1, 1.0], [5.1, 5.1, 1.6]];
  // The roads between the middle and each module are lines on the floor.
  const mid: [number, number] = [3.5, 3.5];
  links = spots.map(([x, y]) => str([P(mid[0], mid[1], 0.02), P(x + 0.7, y + 0.7, 0.02)]));
  items = spots.map(([x, y, h], i) => ({ b: A.box(x, y, 0, 1.4, 1.4, h), i, cls: 'mod' }));
  extras = [{ b: A.box(2.6, 2.6, 0, 1.8, 1.8, 2.1), i: 0, cls: 'core' }];
  view = A.view();
} else if (variant === 'slots') {
  // From the bottom: five marks, three marks, one mark; each plate is smaller than the one under it.
  const plates: { z: number; w: number; d: number; marks: number }[] = [{ z: 0, w: 6.4, d: 3.8, marks: 5 }, { z: 2.6, w: 5.0, d: 3.0, marks: 3 }, { z: 5.2, w: 3.6, d: 2.4, marks: 1 }];
  plates.forEach((pl, i) => {
    const x0 = (6.4 - pl.w) / 2; const y0 = (3.8 - pl.d) / 2;
    items.push({ b: A.box(x0, y0, pl.z, pl.w, pl.d, 0.35), i, cls: 'plate' });
    const span = pl.marks * 0.62 + (pl.marks - 1) * 0.3;
    for (let m = 0; m < pl.marks; m += 1) extras.push({ b: A.box(x0 + (pl.w - span) / 2 + m * 0.92, y0 + pl.d - 1.0, pl.z + 0.35, 0.62, 0.62, 0.62), i, cls: 'mark' });
  });
  view = A.view();
} else {
  base = A.box(0, 0, -0.3, 7.2, 5.5, 0.3);
  for (let j = 0; j < 3; j += 1) {
    for (let i = 0; i < 5; i += 1) items.push({ b: A.box(0.35 + i * 1.3, 0.35 + j * 1.3, 0, 1.0, 1.0, 0.45), i: i + j, cls: 'key' });
  }
  // The long key under the rest.
  extras = [{ b: A.box(1.6, 4.4, 0, 4.0, 0.7, 0.3), i: 7, cls: 'key' }];
  view = A.view();
}
---
<svg viewBox={view} class:list={['iso-art', `iso-${variant}`, className]} aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  {base && <IsoBox {...base} />}
  {variant === 'hub' && links.map((points) => <polyline points={points} class="road" />)}
  {variant === 'hub' && items.slice(0, 3).map(({ b, i, cls }) => <IsoBox {...b} class={cls} style={`--i:${i}`} />)}
  {variant === 'hub' && extras.map(({ b, cls }) => <IsoBox {...b} class={cls} />)}
  {variant === 'hub' && items.slice(3).map(({ b, i, cls }) => <IsoBox {...b} class={cls} style={`--i:${i}`} />)}
  {variant === 'slots' && items.map(({ b, i, cls }, k) => (
    <>
      <IsoBox {...b} class={`${cls} p${i}`} style={`--i:${i}`} />
      {extras.filter((e) => e.i === i).map((e) => <IsoBox {...e.b} class={`mark p${i}`} style={`--i:${i}`} />)}
    </>
  ))}
  {variant === 'keys' && items.map(({ b, i, cls }) => <IsoBox {...b} class={cls} style={`--i:${i}`} />)}
  {variant === 'keys' && extras.map(({ b, i, cls }) => <IsoBox {...b} class={`${cls} space`} style={`--i:${i}`} />)}
</svg>
<style>
  .iso-art { --iso-line: color-mix(in srgb, var(--text) 62%, transparent); width: 100%; height: auto; display: block; overflow: visible; }
  .iso-art :global(polygon), .iso-art polyline { stroke: var(--iso-line); stroke-width: 1.2; stroke-linejoin: round; stroke-linecap: round; fill: var(--bg-raise); vector-effect: non-scaling-stroke; }
  .iso-art :global(.f-top) { fill: var(--card-hover); }
  .iso-art .road { fill: none; stroke-dasharray: 5 6; stroke-opacity: .7; }
  .iso-art :global(.core .f-top) { fill: color-mix(in srgb, #9ca3af 30%, var(--card-hover)); }
  .iso-art :global(.mark .f-top) { fill: color-mix(in srgb, #9ca3af 36%, var(--card-hover)); }

  @media (prefers-reduced-motion: no-preference) {
    .iso-art :global(.mod) { animation: modLift 6s ease-in-out infinite; animation-delay: calc(var(--i) * 0.9s); }
    .iso-art :global(.core) { animation: coreFloat 6s ease-in-out infinite; }
    .iso-art .road { animation: roadFlow 3s linear infinite; }
    .iso-art :global(.plate), .iso-art :global(.mark) { animation: plateRise 6s ease-in-out infinite; animation-delay: calc(var(--i) * 0.7s); }
    .iso-art :global(.key) { animation: keyPress 4.5s ease-in-out infinite; animation-delay: calc(var(--i) * 0.28s); }
  }
  @keyframes modLift { 0%, 100% { transform: none; } 10%, 22% { transform: translateY(-12px); } 34% { transform: none; } }
  @keyframes coreFloat { 0%, 100% { transform: none; } 50% { transform: translateY(-5px); } }
  @keyframes roadFlow { to { stroke-dashoffset: -22; } }
  @keyframes plateRise { 0%, 100% { transform: none; } 12%, 26% { transform: translateY(-18px); } 40% { transform: none; } }
  @keyframes keyPress { 0%, 12%, 100% { transform: none; } 6% { transform: translate(2px, 5px); } }
</style>
