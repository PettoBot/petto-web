---
// Who besides the managers of the server can open the dashboard: the members of some roles, into all of it or into some parts, to look or to change.
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MultiSelect from './MultiSelect.astro';
import { ACCESS_SECTIONS, type AccessRule } from '../utils/dashAccess';
import { getDashLang, makeT } from '../i18n/dash';

const dt = makeT(getDashLang(Astro));
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  roles: { id: string; name: string }[];
  rules: AccessRule[];
  saved: boolean;
  problems: string[];
}
const { user, guildId, guildName, guildIcon, roles, rules, saved, problems } = Astro.props;
const roleName = (id: string) => roles.find((role) => role.id === id)?.name ?? id;
const fullIds = rules.filter((rule) => rule.sections.includes('*')).map((rule) => rule.role_id);
const bySection = rules.filter((rule) => !rule.sections.includes('*'));
const sectionLabel = (id: string) => dt(ACCESS_SECTIONS.find((section) => section.id === id)?.label ?? id);
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="access" pageTitle="Dashboard access">
  <h1>{dt('Dashboard access')}</h1>
  <p class="ac-sub">{dt('Whoever manages the server can always open all of the dashboard. Here you can let the members of some roles in too: into all of it, or only into the parts you choose, to look at them or to change them.')}</p>

  {saved && <div class="ac-ok"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {problems.map((problem) => <div class="ac-problem"><Icon name="ph:warning-fill" width="15" height="15" />{problem}</div>)}

  <section class="ac-card">
    <h2><Icon name="ph:user-gear-fill" width="16" height="16" />{dt('Roles with full access')}</h2>
    <p class="ac-hint">{dt('The members of these roles can open and change every part of the dashboard, except this page.')}</p>
    <form method="POST">
      <input type="hidden" name="action" value="save_full" />
      <MultiSelect lazy name="full_role_ids" options={roles} selected={fullIds} placeholder={dt('Search roles...')} />
      <button type="submit" class="btn btn-accent ac-save">{dt('Save changes')}</button>
    </form>
  </section>

  <section class="ac-card">
    <h2><Icon name="ph:eye-fill" width="16" height="16" />{dt('Access by part')}</h2>
    <p class="ac-hint">{dt('Choose a role and the parts it opens. Without "can change" the members can look at them but not save anything.')}</p>
    {bySection.length === 0 && <p class="ac-empty">{dt('There are no rules yet. Add one to let a role into some parts.')}</p>}
    {bySection.map((rule) => (
      <div class="ac-rule">
        <div class="ac-rule-top">
          <strong>{roleName(rule.role_id)}</strong>
          <span class:list={['ac-tag', { edit: rule.can_edit }]}>{rule.can_edit ? dt('Can change') : dt('View only')}</span>
          <form method="POST" class="ac-del"><input type="hidden" name="action" value="delete_rule" /><input type="hidden" name="role_id" value={rule.role_id} /><button type="submit" class="btn btn-ghost btn-sm" aria-label={dt('Remove')}><Icon name="ph:trash-fill" width="13" height="13" /></button></form>
        </div>
        <div class="ac-chips">{rule.sections.map((id) => <span class="ac-chip">{sectionLabel(id)}</span>)}</div>
      </div>
    ))}

    <form method="POST" class="ac-add" data-no-dirty>
      <input type="hidden" name="action" value="add_rule" />
      <h3>{dt('Add or change a rule')}</h3>
      <label class="ac-field"><span>{dt('Role')}</span>
        <select name="role_id" required>
          <option value="" disabled selected>{dt('Choose a role')}</option>
          {roles.map((role) => <option value={role.id}>{role.name}</option>)}
        </select>
      </label>
      <div class="ac-field"><span>{dt('Parts')}</span>
        <div class="ac-sections">
          {ACCESS_SECTIONS.map((section) => <label class="ac-check"><input type="checkbox" name="sections" value={section.id} />{dt(section.label)}</label>)}
        </div>
      </div>
      <label class="ac-check"><input type="checkbox" name="can_edit" />{dt('Can change (not just look)')}</label>
      <button type="submit" class="btn btn-accent ac-save">{dt('Save rule')}</button>
    </form>
  </section>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  .ac-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 22px; max-width: 64ch; }
  .ac-ok, .ac-problem { display: flex; align-items: center; gap: 8px; font-size: 13.5px; border-radius: 9px; padding: 10px 14px; margin-bottom: 14px; }
  .ac-ok { color: var(--green); background: var(--green-soft); border: 1px solid var(--green); }
  .ac-problem { color: var(--red); background: var(--red-soft); border: 1px solid color-mix(in srgb, var(--red) 55%, transparent); }
  .ac-card { border: 1px solid var(--border); border-radius: 14px; padding: 18px 20px; background: var(--card); margin-bottom: 16px; max-width: 760px; }
  .ac-card h2 { display: flex; align-items: center; gap: 8px; font-size: 16px; margin: 0 0 4px; }
  .ac-card h2 :global(svg) { color: var(--accent); }
  .ac-card h3 { font-size: 14px; margin: 0 0 12px; }
  .ac-hint, .ac-empty { font-size: 13px; color: var(--text-muted); margin: 0 0 14px; }
  .ac-empty { color: var(--text-dim); }
  .ac-save { margin-top: 14px; }
  .ac-rule { border: 1px solid var(--border-soft); border-radius: 11px; padding: 11px 13px; margin-bottom: 10px; }
  .ac-rule-top { display: flex; align-items: center; gap: 10px; }
  .ac-rule-top strong { font-size: 14px; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ac-tag { font-family: var(--mono); font-size: 10.5px; letter-spacing: .04em; text-transform: uppercase; color: var(--text-dim); background: var(--bg-raise); padding: 2px 8px; border-radius: 6px; }
  .ac-tag.edit { color: var(--accent); background: var(--accent-soft); }
  .ac-del { margin: 0; }
  .ac-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 9px; }
  .ac-chip { font-size: 12px; color: var(--text-muted); border: 1px solid var(--border); border-radius: 999px; padding: 2px 10px; }
  .ac-add { border-top: 1px dashed var(--border); margin-top: 16px; padding-top: 16px; display: flex; flex-direction: column; gap: 12px; }
  .ac-field { display: flex; flex-direction: column; gap: 6px; }
  .ac-field > span { font-size: 12px; font-weight: 600; color: var(--text-dim); }
  .ac-field select { border: 1px solid var(--border); border-radius: 9px; padding: 9px 11px; background: var(--bg-raise); color: var(--text); font: 13.5px var(--sans); max-width: 100%; }
  .ac-sections { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
  .ac-check { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--text); cursor: pointer; }
  .ac-add .ac-save { align-self: flex-start; margin-top: 4px; }
</style>
