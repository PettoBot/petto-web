---
// Who besides the managers of the server can open the dashboard: the members of some roles, into all of it or into some parts, to look or to change.
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MultiSelect from './MultiSelect.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import { ACCESS_SECTIONS, type AccessRule } from '../utils/dashAccess';
import { getDashLang, makeT } from '../i18n/dash';

const dt = makeT(getDashLang(Astro));
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  roles: { id: string; name: string }[];
  rules: AccessRule[];
  saved: boolean;
  problems: string[];
}
const { user, guildId, guildName, guildIcon, roles, rules, saved, problems } = Astro.props;
const roleName = (id: string) => roles.find((role) => role.id === id)?.name ?? id;
const fullIds = rules.filter((rule) => rule.sections.includes('*')).map((rule) => rule.role_id);
const bySection = rules.filter((rule) => !rule.sections.includes('*'));
const sectionLabel = (id: string) => dt(ACCESS_SECTIONS.find((section) => section.id === id)?.label ?? id);
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="access" pageTitle="Dashboard access">
  <DashSettingsKit />
  <div class="sx-page">
  <h1>{dt('Dashboard access')}</h1>

  {saved && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {problems.map((problem) => <div class="sx-flash sx-flash-bad"><Icon name="ph:warning-fill" width="15" height="15" />{problem}</div>)}

  <DashStatTiles tiles={[
    { label: dt('Roles with full access'), value: fullIds.length, tone: 'joins' },
    { label: dt('Rules by part'), value: bySection.length, tone: 'voice' },
    { label: dt('Parts you can share'), value: ACCESS_SECTIONS.length, tone: 'invites' },
  ]} />

  <div class="sx-stack">
    <section class="sx-panel ac-block">
      <div class="sx-panel-head">
        <span class="sx-panel-icon" style="--c:var(--green)"><Icon name="ph:user-gear-fill" width="17" height="17" /></span>
        <h2>{dt('Roles with full access')}</h2>
      </div>
      <p class="sx-lead">{dt('The members of these roles can open and change every part of the dashboard, except this page.')}</p>
      <form method="POST" class="ac-form">
        <input type="hidden" name="action" value="save_full" />
        <MultiSelect lazy name="full_role_ids" options={roles} selected={fullIds} placeholder={dt('Search roles...')} />
        <div class="sx-foot"><button type="submit" class="btn btn-accent btn-sm">{dt('Save changes')}</button></div>
      </form>
    </section>

    <section class="sx-panel ac-block">
      <div class="sx-panel-head">
        <span class="sx-panel-icon" style="--c:var(--blue)"><Icon name="ph:eye-fill" width="17" height="17" /></span>
        <h2>{dt('Access by part')}</h2>
        {bySection.length > 0 && <span class="sx-tag">{bySection.length}</span>}
      </div>
      <p class="sx-lead">{dt('Choose a role and the parts it opens. Without "can change" the members can look at them but not save anything.')}</p>
      {bySection.length === 0 && <p class="sx-empty"><Icon name="ph:lock-key-fill" width="16" height="16" />{dt('There are no rules yet. Add one to let a role into some parts.')}</p>}
      {bySection.length > 0 && <div class="sx-list dgl-stagger">
      {bySection.map((rule) => (
        <div class="sx-row ac-rule">
          <div class="ac-rule-main">
            <div class="ac-rule-top">
              <strong>{roleName(rule.role_id)}</strong>
              <span class:list={['sx-tag', { 'sx-tag-accent': rule.can_edit }]}>{rule.can_edit ? dt('Can change') : dt('View only')}</span>
            </div>
            <div class="ac-chips">{rule.sections.map((id) => <span class="ac-chip">{sectionLabel(id)}</span>)}</div>
          </div>
          <form method="POST" class="ac-del" data-no-dirty><input type="hidden" name="action" value="delete_rule" /><input type="hidden" name="role_id" value={rule.role_id} /><button type="submit" class="sx-iconbtn" aria-label={dt('Remove')} title={dt('Remove')}><Icon name="ph:trash-fill" width="15" height="15" /></button></form>
        </div>
      ))}
      </div>}

      <form method="POST" class="sx-sub ac-add" data-no-dirty>
        <input type="hidden" name="action" value="add_rule" />
        <h3>{dt('Add or change a rule')}</h3>
        <div class="sx-field"><label for="ac-role">{dt('Role')}</label>
          <select name="role_id" id="ac-role" required>
            <option value="" disabled selected>{dt('Choose a role')}</option>
            {roles.map((role) => <option value={role.id}>{role.name}</option>)}
          </select>
        </div>
        <div class="sx-field">
          <div class="ac-parts-head"><span class="sx-label">{dt('Parts')}</span><span><button type="button" class="sx-linkbtn" data-ac-all="1">{dt('Select all')}</button><button type="button" class="sx-linkbtn" data-ac-all="0">{dt('Clear')}</button></span></div>
          <div class="sx-chips" data-ac-parts>
            {ACCESS_SECTIONS.map((section) => <label class="sx-chip"><input type="checkbox" name="sections" value={section.id} /><span>{dt(section.label)}</span></label>)}
          </div>
        </div>
        <label class="sx-switch"><input type="checkbox" name="can_edit" /><span class="sx-switch-text"><b>{dt('Can change (not just look)')}</b><em>{dt('Without it the members can only look at these parts.')}</em></span><i class="sx-toggle"></i></label>
        <div class="sx-foot"><button type="submit" class="btn btn-accent btn-sm">{dt('Save rule')}</button></div>
      </form>
    </section>
  </div>
  </div>
</DashGuildLayout>

<script is:inline>
  document.addEventListener('click', function (event) {
    var button = event.target.closest && event.target.closest('[data-ac-all]'); if (!button) return;
    var on = button.getAttribute('data-ac-all') === '1';
    button.closest('.sx-field').querySelectorAll('[data-ac-parts] input[type="checkbox"]').forEach(function (box) { if (box.checked !== on) { box.checked = on; box.dispatchEvent(new Event('change', { bubbles: true })); } });
  });
</script>

<style>
  h1 { font-size: 24px; margin: 0 0 18px; }
  .ac-block { padding: 18px; }
  .ac-form { display: flex; flex-direction: column; gap: 14px; }
  .ac-rule { align-items: flex-start; }
  .ac-rule-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 9px; }
  .ac-rule-top { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .ac-rule-top strong { font-size: 14px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ac-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .ac-chip { font-size: 12px; color: var(--text-muted); border: 1px solid var(--border); border-radius: 999px; padding: 2px 10px; }
  .ac-del { margin: 0; }
  .ac-parts-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .ac-parts-head .sx-label { font-size: 13px; font-weight: 600; }
  .ac-add .sx-foot { margin-top: 2px; }
</style>
