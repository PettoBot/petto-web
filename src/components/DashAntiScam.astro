---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MultiSelect from './MultiSelect.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import SxNumber from './SxNumber.astro';
import { getDashLang, makeT } from '../i18n/dash';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  config: {
    enabled: boolean; action: string; timeoutMinutes: number; deleteMessages: boolean; deleteMinutes: number; channelsThreshold: number; windowSeconds: number;
    scanText: boolean; scanNewAccounts: boolean; newAccountHours: number; dmUser: boolean; alertChannelId: string; pingRoleId: string; exemptRoleIds: string[]; exemptChannelIds: string[]; caught: number;
  };
  events: { id: number; user_id: string; user_name: string | null; signal: string; detail: string | null; channels: number; action: string; deleted: number; created_at: string }[];
  roles: { id: string; name: string }[];
  channels: { id: string; name: string; category: boolean }[];
  saved: boolean;
  failed: boolean;
}
const { user, guildId, guildName, guildIcon, config, events, roles, channels, saved, failed } = Astro.props;
const textChannels = channels.filter((c) => !c.category);
const actionNames: Record<string, string> = { alert: dt('Only alert the staff'), timeout: dt('Mute the account'), kick: dt('Kick the account'), ban: dt('Ban the account') };
const signalNames: Record<string, string> = { 'multi-channel': dt('Same message in several channels'), wording: dt('Scam wording'), 'new-account': dt('New account with scam wording') };
const actionIcons: Record<string, string> = { alert: 'ph:bell-ringing-fill', timeout: 'ph:speaker-slash-fill', kick: 'ph:sign-out-fill', ban: 'ph:prohibit-fill' };
const actionHints: Record<string, string> = { alert: dt('Nothing happens to the account'), timeout: dt('It cannot write for a while'), kick: dt('It leaves the server'), ban: dt('It is banned for good') };
const takenDown = events.reduce((sum, e) => sum + e.deleted, 0);
const when = (iso: string) => new Date(iso).toLocaleString(dashLang, { dateStyle: 'medium', timeStyle: 'short' });
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="antiscam" pageTitle={dt('Anti scam')}>
  <DashSettingsKit />
  <div class="sx-page">
  <h1 class="sx-title">{dt('Anti scam')} <span class:list={['sx-pill-state', { on: config.enabled }]}>{config.enabled ? dt('Active') : dt('Inactive')}</span></h1>

  {saved && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {failed && <div class="sx-flash sx-flash-bad"><Icon name="ph:warning-fill" width="15" height="15" />{dt('It could not be saved, try again.')}</div>}

  <DashStatTiles tiles={[
    { label: dt('Scams caught'), value: config.caught, tone: 'leaves' },
    { label: dt('Messages taken down (last 20)'), value: takenDown, tone: 'voice' },
  ]} />

  <form method="POST" class="sx-stack">
    <label class="sx-switch sx-master"><input type="checkbox" name="enabled" checked={config.enabled} /><span class="sx-switch-text"><b>{dt('Turn the anti scam on')}</b><em>{dt('It never touches the server owner or the roles and channels you exempt below.')}</em></span><i class="sx-toggle"></i></label>

    <section class="sx-panel sc-block">
      <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#ff6b6b"><Icon name="ph:gavel-fill" width="17" height="17" /></span><h2>{dt('What it does when it catches one')}</h2></div>
      <div class="sx-field">
        <span class="sx-label">{dt('Action on the account')}</span>
        <div class="sx-choices">
          {Object.entries(actionNames).map(([k, v]) => (
            <label class="sx-choice"><input type="radio" name="action" value={k} checked={config.action === k} /><span class="sx-choice-body"><Icon name={actionIcons[k]} width="18" height="18" /><b>{v}</b><em>{actionHints[k]}</em></span></label>
          ))}
        </div>
      </div>
      <div class="sx-grid">
        <div class="sx-field" data-sx-needs="action=timeout"><label for="sc-timeout">{dt('Minutes of mute')}</label><SxNumber name="timeout_minutes" id="sc-timeout" value={config.timeoutMinutes} min="1" max="40320" /><span class="sx-hint">{dt('Only when the action is to mute the account.')}</span></div>
      </div>
      <div class="sx-switches">
        <label class="sx-switch"><input type="checkbox" name="delete_messages" checked={config.deleteMessages} /><span class="sx-switch-text"><b>{dt('Take down what the account sent lately, in every channel')}</b></span><i class="sx-toggle"></i></label>
        <label class="sx-switch"><input type="checkbox" name="dm_user" checked={config.dmUser} /><span class="sx-switch-text"><b>{dt('Send the account a DM that it may be hacked, with what to do')}</b></span><i class="sx-toggle"></i></label>
      </div>
      <div class="sx-grid">
        <div class="sx-field" data-sx-needs="delete_messages"><label for="sc-back">{dt('How far back (minutes)')}</label><SxNumber name="delete_minutes" id="sc-back" value={config.deleteMinutes} min="1" max="120" /></div>
      </div>
    </section>

    <section class="sx-panel sc-block">
      <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#f5c26b"><Icon name="ph:magnifying-glass-bold" width="17" height="17" /></span><h2>{dt('How it spots them')}</h2></div>
      <div class="sx-grid">
        <div class="sx-field"><label for="sc-channels">{dt('Same message in this many channels')}</label><SxNumber name="channels_threshold" id="sc-channels" value={config.channelsThreshold} min="2" max="10" /></div>
        <div class="sx-field"><label for="sc-window">{dt('In how many seconds')}</label><SxNumber name="window_seconds" id="sc-window" value={config.windowSeconds} min="5" max="300" /></div>
      </div>
      <div class="sx-switches">
        <label class="sx-switch"><input type="checkbox" name="scan_text" checked={config.scanText} /><span class="sx-switch-text"><b>{dt('Also look for the scam wording')}</b><em>{dt('MrBeast, claim your reward, USDT, withdrawal, casino...')}</em></span><i class="sx-toggle"></i></label>
        <label class="sx-switch"><input type="checkbox" name="scan_new_accounts" checked={config.scanNewAccounts} /><span class="sx-switch-text"><b>{dt('Be stricter with new accounts that send a picture or link')}</b></span><i class="sx-toggle"></i></label>
      </div>
      <div class="sx-grid">
        <div class="sx-field" data-sx-needs="scan_new_accounts"><label for="sc-new">{dt('A new account is younger than (hours)')}</label><SxNumber name="new_account_hours" id="sc-new" value={config.newAccountHours} min="1" max="720" /></div>
      </div>
    </section>

    <section class="sx-panel sc-block">
      <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#9bd0f5"><Icon name="ph:bell-ringing-fill" width="17" height="17" /></span><h2>{dt('Alerts and exceptions')}</h2></div>
      <div class="sx-grid">
        <div class="sx-field"><label for="sc-alert">{dt('Alert channel (with Undo, Ban and Not a scam buttons)')}</label>
          <select name="alert_channel_id" id="sc-alert"><option value="">{dt('The automod log')}</option>{textChannels.map((c) => <option value={c.id} selected={c.id === config.alertChannelId}>#{c.name}</option>)}</select>
        </div>
        <div class="sx-field"><label for="sc-ping">{dt('Role to ping')}</label>
          <select name="ping_role_id" id="sc-ping"><option value="">{dt('Nobody')}</option>{roles.map((r) => <option value={r.id} selected={r.id === config.pingRoleId}>{r.name}</option>)}</select>
        </div>
        <div class="sx-field sx-wide"><span class="sx-label">{dt('Roles that are never checked')}</span><MultiSelect name="exempt_role_ids" options={roles} selected={config.exemptRoleIds} placeholder={dt('Search roles...')} /></div>
        <div class="sx-field sx-wide"><span class="sx-label">{dt('Channels that are never checked')}</span><MultiSelect name="exempt_channel_ids" options={channels} selected={config.exemptChannelIds} placeholder={dt('Search channels...')} /></div>
      </div>
      <p class="sx-hint sc-tip"><Icon name="ph:lightbulb-fill" width="14" height="14" />{dt('Tip: leave it on Only alert for a few days, watch what it catches, then let it mute or ban on its own.')}</p>
    </section>

    <div class="sx-foot sc-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:check-bold" width="13" height="13" />{dt('Save')}</button></div>
  </form>

  <section class="sx-panel sc-events-panel">
    <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#ff6b6b"><Icon name="ph:shield-warning-fill" width="17" height="17" /></span><h2>{dt('Latest scams caught')}</h2>{events.length > 0 && <span class="sx-tag">{events.length}</span>}</div>
    {events.length === 0 ? <p class="sx-empty"><Icon name="ph:shield-check-fill" width="16" height="16" />{dt('It has not caught anything yet.')}</p> : (
      <div class="sx-list dgl-stagger">
        {events.map((e) => (
          <div class="sx-row sc-event">
            <span class="sc-avatar" aria-hidden="true">{(e.user_name ?? e.user_id).slice(0, 1).toUpperCase()}</span>
            <div class="sc-event-main">
              <div class="sc-event-who"><b>{e.user_name ?? e.user_id}</b> <code>{e.user_id}</code></div>
              <span class="sc-event-what">{signalNames[e.signal] ?? e.signal}{e.detail ? ` · ${e.detail}` : ''}</span>
              <span class="sc-event-tags"><span class="sx-tag sx-tag-red">{actionNames[e.action] ?? e.action}</span><span class="sx-tag">{e.deleted} {dt('messages taken down')}</span><time class="sc-when">{when(e.created_at)}</time></span>
            </div>
          </div>
        ))}
      </div>
    )}
  </section>
  </div>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 18px; }
  .sc-block, .sc-events-panel { padding: 18px; }
  .sc-tip { display: flex; align-items: flex-start; gap: 8px; }
  .sc-tip :global(svg) { flex: none; margin-top: 2px; color: var(--yellow); }
  .sc-foot { justify-content: flex-end; }
  .sc-events-panel { margin-top: 14px; }
  .sc-event { align-items: flex-start; }
  .sc-avatar { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--red-soft); color: var(--red); font: 700 14px var(--sans); }
  .sc-event-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .sc-event-who { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; font-size: 13.5px; }
  .sc-event-who code { font-size: 11.5px; color: var(--text-dim); overflow-wrap: anywhere; }
  .sc-event-what { font-size: 13px; color: var(--text-muted); overflow-wrap: anywhere; }
  .sc-event-tags { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .sc-when { font-size: 12px; color: var(--text-dim); }
</style>
