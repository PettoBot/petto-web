---
// Quick Setup: seven steps that set up the main modules of a server, applied all together at the last one. Nothing is saved before that. The steps are
// plain HTML; the script only moves between them, keeps the summary on the side up to date and sends the answers (quick-setup-api.ts).
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import { getDashLang, makeT } from '../i18n/dash';

interface Props {
  user: { username: string; avatar: string | null; userId?: string };
  guildId: string; guildName: string; guildIcon: string;
  channels: { id: string; name: string }[];
  roles: { id: string; name: string }[];
  canRun: boolean;
}
const { user, guildId, guildName, guildIcon, channels, roles, canRun } = Astro.props;
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const docsUrl = `https://wiki.petto.sbs${dashLang === 'es' ? '/es' : dashLang === 'pt-BR' ? '/pt-br' : ''}/setup/quick-setup`;
const MODULES = [
  { id: 'moderation', icon: 'ph:shield-check-fill', name: dt('Moderation'), text: dt('A private log of every sanction and change, so your team sees who did what.') },
  { id: 'automod', icon: 'ph:funnel-fill', name: dt('Auto moderation'), text: dt('Petto removes spam, scam links and invites before anyone has to.') },
  { id: 'welcome', icon: 'ph:hand-waving-fill', name: dt('Welcome messages'), text: dt('Greet new members in a channel, and say goodbye if you want.') },
  { id: 'autorole', icon: 'ph:user-plus-fill', name: dt('Auto role'), text: dt('Every new member gets a role by itself.') },
  { id: 'tickets', icon: 'ph:ticket-fill', name: dt('Tickets'), text: dt('A panel where members open a private ticket for your staff.') },
  { id: 'verification', icon: 'ph:seal-check-fill', name: dt('Verification'), text: dt('New members prove they are real before they see the server.') },
] as const;
const STEPS = [dt('Modules'), dt('Moderation'), dt('Auto moderation'), dt('Welcome messages'), dt('Auto role and verification'), dt('Tickets'), dt('Review')];
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="quick-setup" pageTitle={dt('Quick Setup')}>
  <div class="qs" data-qs data-guild={guildId} data-can-run={canRun ? '1' : '0'}>
    <header class="qs-head">
      <h1>{dt('Quick Setup')}</h1>
      <a class="btn btn-sm" href={docsUrl} target="_blank" rel="noopener"><Icon name="ph:book-open-fill" width="13" height="13" />{dt('Read the docs')}</a>
    </header>
    {!canRun && <div class="qs-flash qs-flash-warn"><Icon name="ph:eye-fill" width="15" height="15" />{dt('Only people with Manage Server can run Quick Setup. You can look at the steps.')}</div>}

    <div class="qs-layout">
      <section class="qs-card">
        <div class="qs-progress" aria-hidden="true"><span data-qs-bar></span></div>
        <p class="qs-step-label"><span data-qs-n>1</span> / 7 · <b data-qs-title>{STEPS[0]}</b></p>

        <div class="qs-panel" data-step="1">
          <h2>{dt('Choose what to set up')}</h2>
          <p class="qs-lead">{dt('Turn on the modules you want. Each one has its own step with a few questions, and you can change all of it later from its page.')}</p>
          <div class="qs-modules">
            {MODULES.map((m) => (
              <label class="sx-switch qs-module">
                <input type="checkbox" data-module={m.id} />
                <span class="sx-switch-text"><b><Icon name={m.icon} width="15" height="15" /> {m.name}</b><em>{m.text}</em></span>
              </label>
            ))}
          </div>
        </div>

        <div class="qs-panel" data-step="2" hidden>
          <h2>{dt('Moderation')}</h2>
          <p class="qs-off" data-off="moderation">{dt('This module is off. Turn it on in the first step, or go on to the next one.')}</p>
          <div data-on="moderation">
            <p class="qs-lead">{dt('Petto writes sanctions, auto moderation hits and changes of members, roles, channels and the server in one log channel.')}</p>
            <label class="qs-field"><span>{dt('Log channel')}</span>
              <select data-field="moderation.log_channel">
                <option value="new">{dt('Create a new private channel (#mod-log)')}</option>
                {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
              </select>
            </label>
            <p class="qs-hint">{dt('A new channel is hidden from everyone but Petto and the people who can see all channels. Add your moderators to it afterwards.')}</p>
          </div>
        </div>

        <div class="qs-panel" data-step="3" hidden>
          <h2>{dt('Auto moderation')}</h2>
          <p class="qs-off" data-off="automod">{dt('This module is off. Turn it on in the first step, or go on to the next one.')}</p>
          <div data-on="automod" class="qs-checks">
            <label class="sx-switch"><input type="checkbox" data-field="automod.spam" checked /><span class="sx-switch-text"><b>{dt('Spam')}</b><em>{dt('The same message again and again, too many mentions, shouting and invites.')}</em></span></label>
            <label class="sx-switch"><input type="checkbox" data-field="automod.invites" checked /><span class="sx-switch-text"><b>{dt('Invites to other servers')}</b><em>{dt('Petto deletes them.')}</em></span></label>
            <label class="sx-switch"><input type="checkbox" data-field="automod.scam" checked /><span class="sx-switch-text"><b>{dt('Scam text')}</b><em>{dt('Fake gifts and Nitro, wallet phrases and the like. Petto deletes them.')}</em></span></label>
            <label class="sx-switch"><input type="checkbox" data-field="automod.links" /><span class="sx-switch-text"><b>{dt('All links')}</b><em>{dt('Off by default: it also deletes good links. You can allow some domains later.')}</em></span></label>
          </div>
        </div>

        <div class="qs-panel" data-step="4" hidden>
          <h2>{dt('Welcome messages')}</h2>
          <p class="qs-off" data-off="welcome">{dt('This module is off. Turn it on in the first step, or go on to the next one.')}</p>
          <div data-on="welcome">
            <label class="qs-field"><span>{dt('Welcome channel')}</span>
              <select data-field="welcome.channel">
                <option value="new">{dt('Create a new channel (#welcome)')}</option>
                {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
              </select>
            </label>
            <label class="qs-field"><span>{dt('Message')}</span>
              <textarea data-field="welcome.message" rows="4" maxlength="1800" placeholder={dt('Welcome {user.mention} to {server.name}!')}></textarea>
            </label>
            <p class="qs-hint">{dt('You can use variables like {user.mention}, {user.name} and {server.name}. Leave it empty for the default message.')}</p>
            <label class="sx-switch"><input type="checkbox" data-field="welcome.goodbye" /><span class="sx-switch-text"><b>{dt('Also say goodbye')}</b><em>{dt('A message in the same channel when someone leaves.')}</em></span></label>
          </div>
        </div>

        <div class="qs-panel" data-step="5" hidden>
          <h2>{dt('Auto role and verification')}</h2>
          <p class="qs-off" data-off="autorole">{dt('Auto role is off. Turn it on in the first step, or go on to the next one.')}</p>
          <div data-on="autorole">
            <label class="qs-field"><span>{dt('Role for new members')}</span>
              <select data-field="autorole.role">
                <option value="new">{dt('Create a new role (Member)')}</option>
                {roles.map((r) => <option value={r.id}>@{r.name}</option>)}
              </select>
            </label>
            <p class="qs-hint">{dt("Petto can only give roles that are below its own highest role. If it cannot, the review tells you.")}</p>
          </div>
          <p class="qs-off" data-off="verification">{dt('Verification is off. Turn it on in the first step if you want it.')}</p>
          <p class="qs-note" data-on="verification"><Icon name="ph:seal-check-fill" width="15" height="15" /> {dt('Verification will make its roles, its channel and its panel for you. It edits the channels of the server, so it can take a moment and it keeps working after Quick Setup ends.')}</p>
        </div>

        <div class="qs-panel" data-step="6" hidden>
          <h2>{dt('Tickets')}</h2>
          <p class="qs-off" data-off="tickets">{dt('This module is off. Turn it on in the first step, or go on to the next one.')}</p>
          <div data-on="tickets">
            <label class="qs-field"><span>{dt('Channel for the ticket panel')}</span>
              <select data-field="tickets.channel">
                <option value="new">{dt('Create a new channel (#open-a-ticket)')}</option>
                {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
              </select>
            </label>
            <label class="qs-field"><span>{dt('Role of your staff')}</span>
              <select data-field="tickets.support_role">
                <option value="new">{dt('Create a new role (Support)')}</option>
                {roles.map((r) => <option value={r.id}>@{r.name}</option>)}
              </select>
            </label>
            <p class="qs-hint">{dt('Members press a button on the panel and Petto opens a private channel for them and this role. Questions, forms and more types are in the Tickets page.')}</p>
          </div>
        </div>

        <div class="qs-panel" data-step="7" hidden>
          <h2>{dt('Review and apply')}</h2>
          <p class="qs-lead">{dt('Nothing has changed in your server yet. This is what Petto will do when you press the button.')}</p>
          <ul class="qs-review" data-qs-review></ul>
          <div class="qs-results" data-qs-results hidden></div>
        </div>

        <footer class="qs-nav">
          <button class="btn btn-ghost" type="button" data-qs-back disabled>{dt('Back')}</button>
          <span class="qs-nav-right">
            <button class="btn btn-ghost" type="button" data-qs-skip>{dt('Skip for now')}</button>
            <button class="btn btn-accent" type="button" data-qs-next>{dt('Next')}</button>
            <button class="btn btn-accent" type="button" data-qs-apply hidden disabled={!canRun}><Icon name="ph:check-bold" width="13" height="13" /> {dt('Apply Quick Setup')}</button>
          </span>
        </footer>
      </section>

      <aside class="qs-side">
        <div class="qs-side-card">
          <h3>{dt('Your setup')}</h3>
          <ul class="qs-summary" data-qs-summary>
            {MODULES.map((m) => <li data-sum={m.id}><Icon name="ph:circle-dashed" width="14" height="14" /><span>{m.name}</span></li>)}
          </ul>
        </div>
        <div class="qs-side-card">
          <p><Icon name="ph:clock-fill" width="14" height="14" /> {dt('Takes about a minute.')}</p>
          <p><Icon name="ph:lock-simple-fill" width="14" height="14" /> {dt('Nothing changes in your server until the last step.')}</p>
          <p><Icon name="ph:arrow-counter-clockwise-fill" width="14" height="14" /> {dt('You can run it again any time from the sidebar.')}</p>
          <p><Icon name="ph:book-open-fill" width="14" height="14" /> <a href={docsUrl} target="_blank" rel="noopener">{dt('Read the docs')}</a></p>
        </div>
      </aside>
    </div>

    <script type="application/json" data-qs-i18n set:html={JSON.stringify({
      steps: STEPS,
      on: dt('On'), off: dt('Off'), working: dt('Setting up…'), failed: dt('Petto did not answer. Try again in a moment.'),
      done: dt('Done. Everything that worked is already in your server.'), partial: dt('Some steps did not work. The rest is done.'),
      modules: Object.fromEntries(MODULES.map((m) => [m.id, m.name])),
      review: {
        moderation: dt('Moderation log in {channel}.'), automod: dt('Auto moderation: {list}.'), welcome: dt('Welcome messages in {channel}{goodbye}.'),
        goodbye: dt(' and goodbye messages'), autorole: dt('New members get {role}.'), tickets: dt('Tickets: the panel in {channel}, answered by {role}.'), verification: dt('Verification with its own roles, channel and panel.'),
        newChannel: dt('a new channel'), newRole: dt('a new role'), spam: dt('spam'), invites: dt('invites'), scam: dt('scam text'), links: dt('all links'), none: dt('Turn on at least one module in the first step.'),
      },
    })}></script>
  </div>
</DashGuildLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-qs]');
  if (root) {
    const i18n = JSON.parse(root.querySelector('[data-qs-i18n]')!.textContent || '{}');
    const panels = [...root.querySelectorAll<HTMLElement>('.qs-panel')];
    const MODULES = ['moderation', 'automod', 'welcome', 'autorole', 'tickets', 'verification'];
    let step = 1;
    const $ = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const moduleOn = (id: string) => Boolean(root.querySelector<HTMLInputElement>(`[data-module="${id}"]`)?.checked);
    const field = (name: string) => root.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[data-field="${name}"]`)!;
    const value = (name: string) => field(name).value;
    const checked = (name: string) => (field(name) as HTMLInputElement).checked;
    const optionText = (name: string, fallback: string) => {
      const select = field(name) as HTMLSelectElement;
      return select.value === 'new' ? fallback : select.selectedOptions[0]?.textContent ?? fallback;
    };
    const fill = (template: string, values: Record<string, string>) => template.replace(/\{(\w+)\}/g, (_all, key) => values[key] ?? '');

    function review(): string[] {
      const lines: string[] = [];
      const r = i18n.review;
      if (moduleOn('moderation')) lines.push(fill(r.moderation, { channel: optionText('moderation.log_channel', '#mod-log') }));
      if (moduleOn('automod')) {
        const list = [checked('automod.spam') && r.spam, checked('automod.invites') && r.invites, checked('automod.scam') && r.scam, checked('automod.links') && r.links].filter(Boolean).join(', ') || '—';
        lines.push(fill(r.automod, { list }));
      }
      if (moduleOn('welcome')) lines.push(fill(r.welcome, { channel: optionText('welcome.channel', '#welcome'), goodbye: checked('welcome.goodbye') ? r.goodbye : '' }));
      if (moduleOn('autorole')) lines.push(fill(r.autorole, { role: optionText('autorole.role', '@Member') }));
      if (moduleOn('tickets')) lines.push(fill(r.tickets, { channel: optionText('tickets.channel', '#open-a-ticket'), role: optionText('tickets.support_role', '@Support') }));
      if (moduleOn('verification')) lines.push(r.verification);
      return lines;
    }

    function render() {
      panels.forEach((panel) => { panel.hidden = Number(panel.dataset.step) !== step; });
      $('[data-qs-n]').textContent = String(step);
      $('[data-qs-title]').textContent = i18n.steps[step - 1];
      $<HTMLElement>('[data-qs-bar]').style.width = `${(step / 7) * 100}%`;
      for (const id of MODULES) {
        const on = moduleOn(id);
        root.querySelectorAll<HTMLElement>(`[data-on="${id}"]`).forEach((el) => { el.hidden = !on; });
        root.querySelectorAll<HTMLElement>(`[data-off="${id}"]`).forEach((el) => { el.hidden = on; });
        const li = root.querySelector<HTMLElement>(`[data-sum="${id}"]`)!;
        li.classList.toggle('is-on', on);
        li.querySelector('svg')?.setAttribute('style', on ? 'color: var(--green)' : '');
      }
      const last = step === 7;
      $<HTMLButtonElement>('[data-qs-back]').disabled = step === 1;
      $<HTMLElement>('[data-qs-next]').hidden = last;
      $<HTMLElement>('[data-qs-skip]').hidden = last || step === 1;
      $<HTMLElement>('[data-qs-apply]').hidden = !last;
      if (last) {
        const lines = review();
        $('[data-qs-review]').innerHTML = '';
        for (const line of lines.length ? lines : [i18n.review.none]) { const li = document.createElement('li'); li.textContent = line; $('[data-qs-review]').append(li); }
        $<HTMLButtonElement>('[data-qs-apply]').disabled = root.dataset.canRun !== '1' || !lines.length;
      }
    }

    const go = (delta: number) => { step = Math.max(1, Math.min(7, step + delta)); render(); window.scrollTo({ top: 0, behavior: 'smooth' }); };
    $('[data-qs-next]').addEventListener('click', () => go(1));
    $('[data-qs-skip]').addEventListener('click', () => go(1));
    $('[data-qs-back]').addEventListener('click', () => go(-1));
    root.addEventListener('change', render);

    $('[data-qs-apply]').addEventListener('click', async () => {
      const button = $<HTMLButtonElement>('[data-qs-apply]');
      const box = $<HTMLElement>('[data-qs-results]');
      const label = button.innerHTML;
      button.disabled = true; button.textContent = i18n.working;
      const setup = {
        modules: Object.fromEntries(MODULES.map((id) => [id, moduleOn(id)])),
        moderation: { log_channel: value('moderation.log_channel') },
        automod: { spam: checked('automod.spam'), invites: checked('automod.invites'), scam: checked('automod.scam'), links: checked('automod.links') },
        welcome: { channel: value('welcome.channel'), message: value('welcome.message'), goodbye: checked('welcome.goodbye') },
        autorole: { role: value('autorole.role') },
        tickets: { channel: value('tickets.channel'), support_role: value('tickets.support_role') },
      };
      let body: any = null;
      try {
        const response = await fetch(`/dash/guild/${root.dataset.guild}/quick-setup-api`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ setup }) });
        body = await response.json().catch(() => null);
      } catch { body = null; }
      box.hidden = false; box.innerHTML = '';
      const results: { module: string; ok: boolean; message: string }[] = Array.isArray(body?.results) ? body.results : [];
      const title = document.createElement('p');
      title.className = results.length && results.every((row) => row.ok) ? 'qs-ok' : 'qs-warn';
      title.textContent = !results.length ? (body?.message || i18n.failed) : results.every((row) => row.ok) ? i18n.done : i18n.partial;
      box.append(title);
      for (const row of results) {
        const p = document.createElement('p');
        p.className = row.ok ? 'qs-row qs-row-ok' : 'qs-row qs-row-err';
        p.textContent = `${i18n.modules[row.module] ?? row.module}: ${row.message}`;
        box.append(p);
      }
      if (results.length) button.hidden = true;
      else { button.disabled = false; button.innerHTML = label; }
    });
    render();
  }
</script>

<style>
  .qs { max-width: 1100px; }
  .qs-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 14px; margin: 0 0 18px; }
  .qs-head h1 { font-size: 24px; margin: 0; }
  .qs-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; padding: 10px 14px; border-radius: 10px; margin-bottom: 16px; border: 1px solid var(--border); }
  .qs-flash-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: color-mix(in srgb, var(--yellow) 55%, transparent); }
  .qs-layout { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 18px; align-items: start; }
  .qs-card { border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 18px 20px; }
  .qs-progress { height: 4px; border-radius: 4px; background: color-mix(in srgb, var(--text) 10%, transparent); overflow: hidden; margin-bottom: 12px; }
  .qs-progress span { display: block; height: 100%; width: 14%; background: var(--green); transition: width 0.25s ease; }
  .qs-step-label { margin: 0 0 14px; font-size: 12.5px; color: var(--text-dim); }
  .qs h2 { font-size: 19px; margin: 0 0 6px; }
  .qs-lead { margin: 0 0 14px; font-size: 13.5px; color: var(--text-muted); line-height: 1.55; }
  .qs-modules, .qs-checks { display: grid; gap: 10px; }
  .qs-module :global(b) { display: inline-flex; align-items: center; gap: 6px; }
  .qs-field { display: flex; flex-direction: column; gap: 6px; margin: 0 0 12px; }
  .qs-field > span { font-size: 13px; font-weight: 600; }
  .qs-field select, .qs-field textarea { border: 1px solid var(--border); border-radius: 8px; padding: 9px 11px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; min-width: 0; }
  .qs-field textarea { resize: none; field-sizing: content; min-height: 6.5em; }
  .qs-hint { font-size: 12.5px; color: var(--text-dim); margin: 0 0 12px; line-height: 1.5; }
  .qs-off { font-size: 13.5px; color: var(--text-dim); margin: 0 0 10px; }
  .qs-note { display: flex; gap: 8px; align-items: flex-start; font-size: 13px; color: var(--text-muted); line-height: 1.5; }
  .qs-review { margin: 0 0 14px; padding-left: 18px; display: grid; gap: 7px; font-size: 14px; }
  .qs-results { display: grid; gap: 8px; margin-top: 10px; }
  .qs-results p { margin: 0; font-size: 13.5px; }
  .qs-ok { color: var(--green); font-weight: 600; }
  .qs-warn { color: var(--yellow); font-weight: 600; }
  .qs-row-ok { color: var(--text); }
  .qs-row-err { color: var(--red, #ff6b6b); }
  .qs-nav { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 20px; padding-top: 14px; border-top: 1px solid var(--border); }
  .qs-nav-right { display: flex; gap: 8px; align-items: center; }
  .qs-side { display: grid; gap: 14px; }
  .qs-side-card { border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 14px 16px; }
  .qs-side-card h3 { margin: 0 0 10px; font-size: 14px; }
  .qs-side-card p { display: flex; align-items: flex-start; gap: 8px; margin: 0 0 8px; font-size: 13px; color: var(--text-muted); line-height: 1.45; }
  .qs-side-card p:last-child { margin-bottom: 0; }
  .qs-side-card p :global(svg) { flex: none; margin-top: 2px; }
  .qs-summary { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 13px; color: var(--text-dim); }
  .qs-summary li { display: flex; align-items: center; gap: 8px; }
  .qs-summary li.is-on { color: var(--text); }
  @media (max-width: 860px) { .qs-layout { grid-template-columns: minmax(0, 1fr); } .qs-nav { flex-wrap: wrap; } }
</style>
