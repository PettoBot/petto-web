          <form method="POST" class="am-add am-ar-edit">
            <input type="hidden" name="action" value="add_sticky" /><input type="hidden" name="old_channel_id" value={s.channelId} />
            <select name="channel_id" required aria-label={dt('Channel')}>{!channels.some((c) => c.id === s.channelId) && <option value={s.channelId} selected>#{channelName(s.channelId)}</option>}{channels.map((c) => <option value={c.id} selected={c.id === s.channelId}>#{c.name}</option>)}</select>
            <textarea class="dgl-autogrow" rows="2" name="content" data-ac placeholder={dt('Message to keep pinned to the bottom')} maxlength="500">{s.content}</textarea><SilentMentionHint />
            <select name="embed_template" data-tpl-locks="content"><option value="">{dt('No saved embed')}</option>{embedTemplateNames.map((name) => <option value={name} selected={name === s.embedTemplate}>{name}</option>)}</select>
            <button type="submit" class="btn btn-ghost btn-sm">{dt('Save changes')}</button>
          </form>
          <form method="POST" class="am-ar-delete" id={`am-del-sticky-${s.channelId}`} data-no-dirty><input type="hidden" name="action" value="delete_sticky" /><input type="hidden" name="channel_id" value={s.channelId} /></form>
        </details>
      ))}
    </div>
    <form method="POST" class="am-add" data-no-dirty>
      <input type="hidden" name="action" value="add_sticky" />
      <select name="channel_id" required>
        <option value="" disabled selected>{dt('Channel')}</option>
        {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
      </select>
      <textarea class="dgl-autogrow" rows="2" name="content" data-ac placeholder={dt('Message to keep pinned to the bottom')} maxlength="500"></textarea><SilentMentionHint />
      <select name="embed_template" data-tpl-locks="content"><option value="">{dt('No saved embed')}</option>{embedTemplateNames.map((name) => <option value={name}>{name}</option>)}</select>
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button>
    </form>
    <p class="am-hint"><Fragment set:html={dth('One sticky per channel, adding another in the same channel replaces it. After you save, the bot deletes and re-sends it every time someone posts in that channel, so it always stays at the bottom. Use <code>{a}</code> for a line break, <code>{b}</code> for a divider line. Choose a saved embed (a V2 design too) to send it instead of the text; the text is used if the embed is missing.', { a: ('{newline}'), b: ('{separator}') })} /></p>
  </div>
  )}

  {selectedSection === 'reaction-roles' && (
  <div class:list={['am-section', showSection('reaction-roles')]} data-section="reaction-roles">
    <h2><span class="am-h2-icon" style="--c:#fed53c"><Icon name="ph:smiley-fill" width="14" height="14" /></span><Fragment set:html={dth('Reaction roles <span class="am-count">{a}</span>', { a: (reactionRoles.length) })} /></h2>
    {reactionRoleError && <p class="am-error"><Icon name="ph:warning-fill" width="13" height="13" />{reactionRoleError}</p>}
    <a class="am-builder-link" href={`/dash/guild/${guildId}/reaction-role`}><Icon name="ph:magic-wand-fill" width="14" height="14" /><span><strong>{dt('Create a role menu with an embed and buttons')}</strong><small>{dt('Pick the channel, write or load an embed, and add rows of buttons with their color, role and emoji.')}</small></span><Icon name="ph:arrow-right-bold" width="13" height="13" /></a>
    {reactionRoles.length === 0 && <p class="am-empty"><Icon name="ph:sparkle" width="15" height="15" />{dt('Nothing here yet. Add the first one below.')}</p>}
    <div class="am-list dgl-stagger">
      {reactionRoles.map((r) => (
        <details class="am-ar am-card dgl-rc">
          <summary class="am-card-sum"><span class="am-card-head"><span class="am-card-main"><span class="am-row-key">{r.interactionType === 'button' ? (r.buttonLabel || 'button') : r.emoji}</span><span class="am-row-mode">{r.interactionType} · {r.mode}</span></span><span class="am-card-acts"><span class="am-act" aria-hidden="true"><Icon name="ph:pencil-simple-fill" width="12" height="12" /><span class="am-act-t"><span class="am-t-edit">{dt('Edit')}</span><span class="am-t-close">{dt('Close')}</span></span></span><button type="submit" form={`am-del-rr-${r.id}`} class="am-act am-act-del" title={dt('Delete')} aria-label={dt('Delete')} data-confirm={dt('Delete this? This cannot be undone.')}><Icon name="ph:trash-fill" width="12" height="12" /></button></span></span><span class="am-card-line"><span class="am-row-val" title={roleName(r.roleId)}>@{roleName(r.roleId)}</span>{r.channelId && <a class="am-row-mode" href={`https://discord.com/channels/${guildId}/${r.channelId}/${r.messageId}`} target="_blank" rel="noopener" onclick="event.stopPropagation()">{dt('Open message')}</a>}</span></summary>
          {r.interactionType === 'button' && r.channelId && <a class="am-builder-edit" href={`/dash/guild/${guildId}/reaction-role?message=${r.messageId}`}><Icon name="ph:pencil-simple-fill" width="12" height="12" />{dt('Edit the message in the builder')}</a>}
          <form method="POST" class="am-add am-add-wide am-ar-edit">
            <input type="hidden" name="action" value="edit_reactionrole" /><input type="hidden" name="id" value={r.id} />
            <div class="am-add-row">
              <select name="role_id" required data-give-role>{roles.map((role) => <option value={role.id} selected={role.id === r.roleId}>{role.name}</option>)}</select>
              <select name="mode"><option value="toggle" selected={r.mode === 'toggle'}>toggle</option><option value="add" selected={r.mode === 'add'}>{dt('add only')}</option><option value="remove" selected={r.mode === 'remove'}>{dt('remove only')}</option></select>
