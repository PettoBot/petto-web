---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import VariableHelp from './VariableHelp.astro';
import MultiSelect from './MultiSelect.astro';
import ColorPicker from './ColorPicker.astro';

interface CustomCommand { id: number; name: string; response: string | null; embedTemplate: string | null; }
interface AutoResponder {
  id: number; arId: string; trigger: string; reply: string; matchMode: string; deleteTrigger: boolean; replyToTrigger: boolean; pingUser: boolean; channelIds: string[]; roleIds: string[];
  replyType: string; embedColor: number | null; embedTitle: string | null; embedFooter: string | null; embedTemplate: string | null;
}
interface StickyMessage { channelId: string; content: string; }
interface DisabledCommand { id: number; command: string; channelId: string | null; }
interface ReactionRole { id: number; messageId: string; emoji: string; roleId: string; mode: string; }
interface AutoThread { channelId: string; nameTemplate: string; messageText: string | null; embedTemplate: string | null; archiveMinutes: number; }
interface CommandAlias { id: number; name: string; command: string; }
interface AutoTimer { id: number; channelId: string; intervalMs: number; message: string; nextRunAt: string; }
interface StarboardSettings { channel_id: string | null; threshold: number; emoji: string; selfstar: boolean; timestamp: boolean; jumpurl: boolean; attachments: boolean; ignoredChannelIds: string[]; ignoredRoleIds: string[]; ignoredUserIds: string[]; }
interface VoiceMasterSettings { creatorChannelId: string; panelChannelId: string; panelMessageId: string | null; categoryId: string | null; defaultLimit: number; defaultName: string; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  customCommands: CustomCommand[];
  autoResponders: AutoResponder[];
  stickyMessages: StickyMessage[];
  disabledCommands: DisabledCommand[];
  reactionRoles: ReactionRole[];
  autoThreads: AutoThread[];
  roles: { id: string; name: string }[];
  channels: { id: string; name: string }[];
  embedTemplateNames: string[];
  saved: boolean;
  reactionRoleError?: string | null;
  error?: string | null;
  aliases: CommandAlias[];
  timers: AutoTimer[];
  starboard: StarboardSettings | null;
  voiceMaster: VoiceMasterSettings | null;
  voiceChannels: { id: string; name: string }[];
  channelCategories: { id: string; name: string }[];
}
const { user, guildId, guildName, guildIcon, customCommands, autoResponders, stickyMessages, disabledCommands, reactionRoles, autoThreads, roles, channels, embedTemplateNames, saved, reactionRoleError, error, aliases, timers, starboard, voiceMaster, voiceChannels, channelCategories } = Astro.props;

const ARCHIVE_LABELS: Record<number, string> = { 60: '1 hour', 1440: '1 day', 4320: '3 days', 10080: '1 week' };

function channelName(id: string) {
  return channels.find((c) => c.id === id)?.name ?? id;
}
function roleName(id: string) {
  return roles.find((r) => r.id === id)?.name ?? id;
}
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="automation" pageTitle="Automation">
  <h1>Automation</h1>
  <p class="am-sub">Reaction roles, custom commands, autoresponders, sticky messages, and disabled commands in <b>{guildName}</b>.</p>

  {saved && <div class="am-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />Saved.</div>}
  {error && <div class="am-error"><Icon name="ph:warning-fill" width="13" height="13" />{error}</div>}

  <div class="am-section">
    <h2><span class="am-h2-icon" style="--c:#c792ea"><Icon name="ph:command-fill" width="14" height="14" /></span>Command aliases <span class="am-count">{aliases.length}</span></h2>
    <div class="am-list">
      {aliases.map((a) => (
        <div class="am-row">
          <code class="am-row-key">!{a.name}</code><span class="am-row-val" title={a.command}>{a.command}</span>
          <form method="POST"><input type="hidden" name="action" value="delete_alias" /><input type="hidden" name="name" value={a.name} /><button type="submit" class="am-del"><Icon name="ph:trash-fill" width="13" height="13" /></button></form>
        </div>
      ))}
    </div>
    <form method="POST" class="am-add">
      <input type="hidden" name="action" value="add_alias" /><input type="text" name="name" placeholder="Shortcut" maxlength="32" required />
      <input type="text" name="command" placeholder="Target command, e.g. warn {0} repeated spam" maxlength="500" required />
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />Add</button>
    </form>
    <p class="am-hint">Aliases are prefix-only. Use <code>{'{0}'}</code>, <code>{'{1}'}</code>, and so on for typed arguments.</p>
  </div>

  <div class="am-section">
    <h2><span class="am-h2-icon" style="--c:#5eead4"><Icon name="ph:timer-fill" width="14" height="14" /></span>Repeating timers <span class="am-count">{timers.length}</span></h2>
    <div class="am-list">
      {timers.map((t) => (
        <div class="am-row">
          <span class="am-row-key">#{channelName(t.channelId)}</span><span class="am-row-mode">{Math.round(t.intervalMs / 60000)} min</span><span class="am-row-val" title={t.message}>{t.message}</span>
          <form method="POST"><input type="hidden" name="action" value="delete_timer" /><input type="hidden" name="id" value={t.id} /><button type="submit" class="am-del"><Icon name="ph:trash-fill" width="13" height="13" /></button></form>
        </div>
      ))}
    </div>
    <form method="POST" class="am-add am-add-wide">
      <input type="hidden" name="action" value="add_timer" /><div class="am-add-row"><select name="channel_id" required><option value="" disabled selected>Channel</option>{channels.map((c) => <option value={c.id}>#{c.name}</option>)}</select><input type="number" name="interval_minutes" min="10" max="525600" value="10" required /><span class="am-inline-label">minutes</span></div>
      <input type="text" name="message" placeholder="Message to send repeatedly" maxlength="2000" required /><button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />Add timer</button>
    </form>
    <p class="am-hint">Minimum interval: 10 minutes. One timer per channel, matching Bleed's timer behavior.</p>
  </div>

  <div class="am-section">
    <h2><span class="am-h2-icon" style="--c:#fed53c"><Icon name="ph:star-fill" width="14" height="14" /></span>Starboard</h2>
    <form method="POST" class="am-add am-add-wide">
      <input type="hidden" name="action" value="save_starboard" />
      <div class="am-add-row"><select name="channel_id"><option value="">Disabled / no channel</option>{channels.map((c) => <option value={c.id} selected={c.id === starboard?.channel_id}>#{c.name}</option>)}</select><input type="number" name="threshold" min="1" max="100" value={starboard?.threshold ?? 3} required /><input type="text" name="emoji" maxlength="100" value={starboard?.emoji ?? '⭐'} placeholder="Emoji" required /></div>
      <label class="am-check"><input type="checkbox" name="selfstar" checked={starboard?.selfstar ?? false} />Count the message author's own reaction</label>
      <label class="am-check"><input type="checkbox" name="timestamp" checked={starboard?.timestamp ?? true} />Show the original timestamp</label>
      <label class="am-check"><input type="checkbox" name="jumpurl" checked={starboard?.jumpurl ?? true} />Include a jump link to the original</label>
      <label class="am-check"><input type="checkbox" name="attachments" checked={starboard?.attachments ?? true} />Include attachments and images</label>
      <div class="am-channel-scope"><span class="am-channel-scope-label">Ignored channels</span><MultiSelect name="ignored_channel_ids" options={channels.map((c) => ({ id: c.id, name: `#${c.name}` }))} selected={starboard?.ignoredChannelIds ?? []} placeholder="Search channels..." /></div>
      <div class="am-channel-scope"><span class="am-channel-scope-label">Ignored roles</span><MultiSelect name="ignored_role_ids" options={roles.map((r) => ({ id: r.id, name: r.name }))} selected={starboard?.ignoredRoleIds ?? []} placeholder="Search roles..." /></div>
      <input type="text" name="ignored_user_ids" value={(starboard?.ignoredUserIds ?? []).join(', ')} placeholder="Ignored member IDs, comma-separated" maxlength="260" />
      <div class="am-feature-actions"><button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:check-bold" width="12" height="12" />Save starboard</button><button type="submit" name="action" value="disable_starboard" class="am-del-text"><Icon name="ph:prohibit-fill" width="12" height="12" />Disable</button></div>
    </form>
    <p class="am-hint">The bot reposts messages after the selected emoji reaches the threshold and updates the count when reactions change.</p>
  </div>

  <div class="am-section">
    <h2><span class="am-h2-icon" style="--c:#8399ff"><Icon name="ph:speaker-high-fill" width="14" height="14" /></span>VoiceMaster</h2>
    <form method="POST" class="am-add am-add-wide">
      <input type="hidden" name="action" value="save_voicemaster" />
      <div class="am-add-row"><select name="creator_channel_id" required><option value="" disabled selected>Join-to-create voice channel</option>{voiceChannels.map((c) => <option value={c.id} selected={c.id === voiceMaster?.creatorChannelId}>{c.name}</option>)}</select><select name="panel_channel_id" required><option value="" disabled selected>Panel text channel</option>{channels.map((c) => <option value={c.id} selected={c.id === voiceMaster?.panelChannelId}>#{c.name}</option>)}</select></div>
      <div class="am-add-row"><select name="category_id"><option value="">Use creator category</option>{channelCategories.map((c) => <option value={c.id} selected={c.id === voiceMaster?.categoryId}>{c.name}</option>)}</select><input type="number" name="default_limit" min="0" max="99" value={voiceMaster?.defaultLimit ?? 0} placeholder="Default limit" /><input type="text" name="default_name" maxlength="100" value={voiceMaster?.defaultName ?? '{user.name}'} placeholder="Name template" /></div>
      <label class="am-check"><input type="checkbox" name="resend_panel" checked />Replace and resend the current VoiceMaster panel</label>
      <div class="am-feature-actions"><button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:check-bold" width="12" height="12" />Save VoiceMaster</button>{voiceMaster && <button type="submit" name="action" value="disable_voicemaster" class="am-del-text"><Icon name="ph:prohibit-fill" width="12" height="12" />Disable</button>}</div>
    </form>
    <p class="am-hint">Users join the creator channel, receive a temporary channel, and manage it from the panel or <code>!vc</code>.</p>
  </div>

  <div class="am-section">
    <h2><span class="am-h2-icon" style="--c:#8399ff"><Icon name="ph:terminal-window-fill" width="14" height="14" /></span>Custom commands <span class="am-count">{customCommands.length}</span></h2>
    <div class="am-list">
      {customCommands.map((c) => (
        <div class="am-row">
          <code class="am-row-key">/{c.name}</code>
          {c.embedTemplate ? (
            <span class="am-row-mode" title="Uses a saved embed template">embed: {c.embedTemplate}</span>
          ) : (
            <span class="am-row-val" title={c.response ?? ''}>{c.response}</span>
          )}
          <form method="POST"><input type="hidden" name="action" value="delete_command" /><input type="hidden" name="id" value={c.id} />
            <button type="submit" class="am-del"><Icon name="ph:trash-fill" width="13" height="13" /></button>
          </form>
        </div>
      ))}
    </div>
    <form method="POST" class="am-add">
      <input type="hidden" name="action" value="add_command" />
      <input type="text" name="name" placeholder="Command name" maxlength="32" required />
      <input type="text" name="response" placeholder="Response text (ignored if a template is picked)" maxlength="500" />
      {embedTemplateNames.length > 0 && (
        <select name="embed_template">
          <option value="">No template, use response text</option>
          {embedTemplateNames.map((n) => <option value={n}>{n}</option>)}
        </select>
      )}
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />Add</button>
    </form>
    {embedTemplateNames.length > 0 && <p class="am-hint">Templates are managed on the Embeds page.</p>}
    <VariableHelp />
  </div>

  <div class="am-section">
    <h2><span class="am-h2-icon" style="--c:#c792ea"><Icon name="ph:robot-fill" width="14" height="14" /></span>Autoresponders <span class="am-count">{autoResponders.length}</span></h2>
    <div class="am-list">
      {autoResponders.map((a) => (
        <details class="am-ar">
          <summary class="am-row">
            <code class="am-row-key">{a.trigger}</code>
            <span class="am-row-mode">{a.matchMode}</span>
            {a.deleteTrigger && <span class="am-row-mode" title="Deletes the triggering message"><Icon name="ph:trash-fill" width="10" height="10" /></span>}
            {a.replyToTrigger && <span class="am-row-mode" title="Replies directly to the triggering message"><Icon name="ph:arrow-bend-up-left-fill" width="10" height="10" /></span>}
            {a.pingUser && <span class="am-row-mode" title="Pings the triggering user"><Icon name="ph:bell-fill" width="10" height="10" /></span>}
            {a.channelIds.length > 0 && <span class="am-row-mode">{a.channelIds.length} channel{a.channelIds.length !== 1 ? 's' : ''}</span>}
            {a.roleIds.length > 0 && <span class="am-row-mode">{a.roleIds.length} role{a.roleIds.length !== 1 ? 's' : ''}</span>}
            {a.embedTemplate ? (
              <span class="am-row-mode" title="Uses a saved embed template">embed: {a.embedTemplate}</span>
            ) : (
              a.replyType === 'embed' && <span class="am-row-mode" title="Sent as an embed">embed</span>
            )}
            {a.reply && <span class="am-row-val" title={a.reply}>{a.reply}</span>}
            <Icon name="ph:caret-right-bold" width="12" height="12" class="am-ar-chevron" />
          </summary>
          <form method="POST" class="am-add am-add-wide am-ar-edit">
            <input type="hidden" name="action" value="edit_responder" />
            <input type="hidden" name="ar_id" value={a.arId} />
            <div class="am-add-row">
              <input type="text" name="trigger" value={a.trigger} maxlength="80" required />
              <select name="match_mode">
                <option value="contains" selected={a.matchMode === 'contains'}>contains</option>
                <option value="startsWith" selected={a.matchMode === 'startsWith'}>starts with</option>
                <option value="endsWith" selected={a.matchMode === 'endsWith'}>ends with</option>
                <option value="exact" selected={a.matchMode === 'exact'}>exact</option>
                <option value="regex" selected={a.matchMode === 'regex'}>regex</option>
              </select>
              <input type="text" name="reply" value={a.reply} placeholder="Reply text (not needed if you pick a template below)" maxlength="500" />
            </div>
            <label class="am-check"><input type="checkbox" name="delete_trigger" checked={a.deleteTrigger} />Delete the triggering message</label>
            <label class="am-check"><input type="checkbox" name="reply_to_trigger" checked={a.replyToTrigger} />Reply directly to the triggering message (instead of sending a new one)</label>
            <label class="am-check"><input type="checkbox" name="ping_user" checked={a.pingUser} />Notify the triggering user (native reply ping, no @mention text stuffed in)</label>
            <div class="am-embed-fields">
              <select name="reply_type">
                <option value="text" selected={a.replyType !== 'embed'}>Send as plain text</option>
                <option value="embed" selected={a.replyType === 'embed'}>Send as an embed</option>
              </select>
              <input type="text" name="embed_title" value={a.embedTitle ?? ''} placeholder="Embed title (optional)" maxlength="100" />
              <ColorPicker name="embed_color" value={a.embedColor != null ? `#${a.embedColor.toString(16).padStart(6, '0')}` : '#8399ff'} label="Embed color" />
              <input type="text" name="embed_footer" value={a.embedFooter ?? ''} placeholder="Footer text (optional)" maxlength="100" />
            </div>
            {embedTemplateNames.length > 0 && (
              <div class="am-embed-fields">
                <select name="embed_template">
                  <option value="">No saved template, use the options above</option>
                  {embedTemplateNames.map((n) => <option value={n} selected={n === a.embedTemplate}>{n}</option>)}
                </select>
              </div>
            )}
            <div class="am-channel-scope">
              <span class="am-channel-scope-label">Only in these channels (empty = everywhere)</span>
              <MultiSelect name="channel_ids" options={channels.map((c) => ({ id: c.id, name: `#${c.name}` }))} selected={a.channelIds} placeholder="Search channels..." />
            </div>
            <div class="am-channel-scope">
              <span class="am-channel-scope-label">Only for members with these roles (empty = everyone)</span>
              <MultiSelect name="role_ids" options={roles.map((r) => ({ id: r.id, name: r.name }))} selected={a.roleIds} placeholder="Search roles..." />
            </div>
            <div class="am-ar-edit-actions">
              <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:check-bold" width="12" height="12" />Save changes</button>
            </div>
          </form>
          <form method="POST" class="am-ar-delete"><input type="hidden" name="action" value="delete_responder" /><input type="hidden" name="ar_id" value={a.arId} />
            <button type="submit" class="am-del-text"><Icon name="ph:trash-fill" width="12" height="12" />Delete this autoresponder</button>
          </form>
        </details>
      ))}
    </div>
    <form method="POST" class="am-add am-add-wide">
      <input type="hidden" name="action" value="add_responder" />
      <div class="am-add-row">
        <input type="text" name="trigger" placeholder="Trigger word" maxlength="80" required />
        <select name="match_mode">
          <option value="contains">contains</option>
          <option value="startsWith">starts with</option>
          <option value="endsWith">ends with</option>
          <option value="exact">exact</option>
          <option value="regex">regex</option>
        </select>
        <input type="text" name="reply" placeholder="Reply text (not needed if you pick a template below)" maxlength="500" />
      </div>
      <VariableHelp />
      <label class="am-check"><input type="checkbox" name="delete_trigger" />Delete the triggering message</label>
      <label class="am-check"><input type="checkbox" name="reply_to_trigger" />Reply directly to the triggering message (instead of sending a new one)</label>
      <label class="am-check"><input type="checkbox" name="ping_user" />Notify the triggering user (native reply ping, no @mention text stuffed in)</label>
      <div class="am-embed-fields">
        <select name="reply_type">
          <option value="text">Send as plain text</option>
          <option value="embed">Send as an embed</option>
        </select>
        <input type="text" name="embed_title" placeholder="Embed title (optional)" maxlength="100" />
        <ColorPicker name="embed_color" value="#8399ff" label="Embed color" />
        <input type="text" name="embed_footer" placeholder="Footer text (optional)" maxlength="100" />
      </div>
      <p class="am-hint">The title/color/footer only apply when set to embed, the reply text above becomes the embed description.</p>
      {embedTemplateNames.length > 0 && (
        <div class="am-embed-fields">
          <select name="embed_template">
            <option value="">No saved template, use the options above</option>
            {embedTemplateNames.map((n) => <option value={n}>{n}</option>)}
          </select>
        </div>
      )}
      {embedTemplateNames.length > 0 && <p class="am-hint">Picking a saved template here overrides reply type/embed fields entirely, they're only used as a fallback if the template is later deleted. Templates are managed on the Embeds page.</p>}
      <div class="am-channel-scope">
        <span class="am-channel-scope-label">Only in these channels (empty = everywhere)</span>
        <MultiSelect name="channel_ids" options={channels.map((c) => ({ id: c.id, name: `#${c.name}` }))} selected={[]} placeholder="Search channels..." />
      </div>
      <div class="am-channel-scope">
        <span class="am-channel-scope-label">Only for members with these roles (empty = everyone)</span>
        <MultiSelect name="role_ids" options={roles.map((r) => ({ id: r.id, name: r.name }))} selected={[]} placeholder="Search roles..." />
      </div>
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />Add</button>
    </form>
  </div>

  <div class="am-section">
    <h2><span class="am-h2-icon" style="--c:#5eead4"><Icon name="ph:push-pin-fill" width="14" height="14" /></span>Sticky messages <span class="am-count">{stickyMessages.length}</span></h2>
    <div class="am-list">
      {stickyMessages.map((s) => (
        <div class="am-row">
          <span class="am-row-key">#{channelName(s.channelId)}</span>
          <span class="am-row-val" title={s.content}>{s.content}</span>
          <form method="POST"><input type="hidden" name="action" value="delete_sticky" /><input type="hidden" name="channel_id" value={s.channelId} />
            <button type="submit" class="am-del"><Icon name="ph:trash-fill" width="13" height="13" /></button>
          </form>
        </div>
      ))}
    </div>
    <form method="POST" class="am-add">
      <input type="hidden" name="action" value="add_sticky" />
      <select name="channel_id" required>
        <option value="" disabled selected>Channel</option>
        {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
      </select>
      <input type="text" name="content" placeholder="Message to keep pinned to the bottom" maxlength="500" required />
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />Add</button>
    </form>
    <p class="am-hint">One sticky per channel, adding another in the same channel replaces it. After you save, the bot deletes and re-sends it every time someone posts in that channel, so it always stays at the bottom. Use <code>{'{newline}'}</code> for a line break, <code>{'{separator}'}</code> for a divider line.</p>
  </div>

  <div class="am-section">
    <h2><span class="am-h2-icon" style="--c:#fed53c"><Icon name="ph:smiley-fill" width="14" height="14" /></span>Reaction roles <span class="am-count">{reactionRoles.length}</span></h2>
    {reactionRoleError && <p class="am-error"><Icon name="ph:warning-fill" width="13" height="13" />{reactionRoleError}</p>}
    <div class="am-list">
      {reactionRoles.map((r) => (
        <div class="am-row">
          <span class="am-row-key">{r.emoji}</span>
          <span class="am-row-val" title={roleName(r.roleId)}>{roleName(r.roleId)}</span>
          <span class="am-row-mode">{r.mode}</span>
          <form method="POST"><input type="hidden" name="action" value="delete_reactionrole" /><input type="hidden" name="id" value={r.id} />
            <button type="submit" class="am-del"><Icon name="ph:trash-fill" width="13" height="13" /></button>
          </form>
        </div>
      ))}
    </div>
    <form method="POST" class="am-add">
      <input type="hidden" name="action" value="add_reactionrole" />
      <select name="channel_id" required>
        <option value="" disabled selected>Channel</option>
        {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
      </select>
      <input type="text" name="message_id" placeholder="Message ID" maxlength="24" required />
      <input type="text" name="emoji" placeholder="Emoji" maxlength="4" required />
      <select name="role_id" required>
        <option value="" disabled selected>Role</option>
        {roles.map((r) => <option value={r.id}>{r.name}</option>)}
      </select>
      <select name="mode">
        <option value="toggle">toggle</option>
        <option value="add">add only</option>
        <option value="remove">remove only</option>
      </select>
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />Add</button>
    </form>
    <p class="am-hint">Right-click any message in Discord (developer mode on) and copy its ID. Petto still needs to see the reaction happen in that channel.</p>
  </div>

  <div class="am-section">
    <h2><span class="am-h2-icon" style="--c:#5b8def"><Icon name="ph:chats-circle-fill" width="14" height="14" /></span>Auto-threading <span class="am-count">{autoThreads.length}</span></h2>
    <div class="am-list">
      {autoThreads.map((at) => (
        <div class="am-row">
          <code class="am-row-key">#{channelName(at.channelId)}</code>
          <span class="am-row-mode" title="Thread name">{at.nameTemplate}</span>
          <span class="am-row-mode">{ARCHIVE_LABELS[at.archiveMinutes] ?? `${at.archiveMinutes}m`}</span>
          {(at.messageText || at.embedTemplate) && <span class="am-row-mode" title="Has a starter message">has message</span>}
          <form method="POST"><input type="hidden" name="action" value="delete_autothread" /><input type="hidden" name="channel_id" value={at.channelId} />
            <button type="submit" class="am-del"><Icon name="ph:trash-fill" width="13" height="13" /></button>
          </form>
        </div>
      ))}
    </div>
    <form method="POST" class="am-add-wide">
      <input type="hidden" name="action" value="add_autothread" />
      <div class="am-add-row">
        <select name="channel_id" required>
          <option value="" disabled selected>Channel</option>
          {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
        </select>
        <input type="text" name="name_template" placeholder="Thread name (default: {user_name})" maxlength="100" />
        <select name="archive_minutes">
          <option value="60">Archive after 1 hour</option>
          <option value="1440">Archive after 1 day</option>
          <option value="4320">Archive after 3 days</option>
          <option value="10080">Archive after 1 week</option>
        </select>
      </div>
      <input type="text" name="message_text" placeholder="Starter message inside the thread (optional, supports variables)" maxlength="500" />
      <VariableHelp />
      {embedTemplateNames.length > 0 && (
        <select name="embed_template">
          <option value="">No template, use message text above</option>
          {embedTemplateNames.map((n) => <option value={n}>{n}</option>)}
        </select>
      )}
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />Add</button>
    </form>
    <p class="am-hint">Starts a thread off every new message in the channel, good for support/showcase channels where each message deserves its own conversation.</p>
  </div>

  <div class="am-section">
    <h2><span class="am-h2-icon" style="--c:#fe6465"><Icon name="ph:prohibit-fill" width="14" height="14" /></span>Disabled commands <span class="am-count">{disabledCommands.length}</span></h2>
    <div class="am-list">
      {disabledCommands.map((d) => (
        <div class="am-row">
          <code class="am-row-key">/{d.command}</code>
          <span class="am-row-val">{d.channelId ? `in #${channelName(d.channelId)}` : 'server-wide'}</span>
          <form method="POST"><input type="hidden" name="action" value="delete_disabled" /><input type="hidden" name="id" value={d.id} />
            <button type="submit" class="am-del"><Icon name="ph:trash-fill" width="13" height="13" /></button>
          </form>
        </div>
      ))}
    </div>
    <form method="POST" class="am-add">
      <input type="hidden" name="action" value="add_disabled" />
      <input type="text" name="command" placeholder="Command name" maxlength="32" required />
      <select name="channel_id">
        <option value="">Server-wide</option>
        {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
      </select>
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />Add</button>
    </form>
  </div>
</DashGuildLayout>

<style>
