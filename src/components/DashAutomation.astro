            <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:check-bold" width="12" height="12" />{dt('Save timer')}</button>
          </form>
          <form method="POST" class="am-ar-delete" id={`am-del-timer-${t.id}`} data-no-dirty><input type="hidden" name="action" value="delete_timer" /><input type="hidden" name="id" value={t.id} /></form>
          <form method="POST" class="am-ar-delete" id={`am-run-timer-${t.id}`} data-no-dirty data-bot-wait><input type="hidden" name="action" value="run_timer" /><input type="hidden" name="id" value={t.id} /></form>
