            <div class="am-channel-scope">
              <span class="am-channel-scope-label">{dt('Only for members with these roles (empty = everyone)')}</span>
              <MultiSelect name="role_ids" options={roleOptions} source="am-roles" selected={a.roleIds} placeholder={dt('Search roles...')} />
            </div>
            <div class="am-ar-edit-actions">
              <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:check-bold" width="12" height="12" />{dt('Save changes')}</button>
            </div>
          </form>
          <form method="POST" class="am-ar-delete"><input type="hidden" name="action" value="delete_responder" /><input type="hidden" name="ar_id" value={a.arId} />
            <button type="submit" class="am-del-text" data-confirm={dt('Delete this? This cannot be undone.')}><Icon name="ph:trash-fill" width="12" height="12" />{dt('Delete this autoresponder')}</button>
          </form>
        </details>
      ))}
    </div>
    <form method="POST" class="am-add am-add-wide">
      <input type="hidden" name="action" value="add_responder" />
      <div class="am-add-row">
        <input type="text" name="trigger" placeholder={dt('Trigger word')} maxlength="80" required />
        <select name="match_mode">
          <option value="contains">contains</option>
          <option value="startsWith">{dt('starts with')}</option>
          <option value="endsWith">{dt('ends with')}</option>
          <option value="exact">exact</option>
          <option value="regex">regex</option>
        </select>
        <input type="text" name="reply" placeholder={dt('Reply text or flags (optional with a template)')} maxlength="500" />
      </div>
      <VariableHelp />
      <label class="am-check"><input type="checkbox" name="delete_trigger" />{dt('Delete the triggering message')}</label>
      <label class="am-check"><input type="checkbox" name="reply_to_trigger" />{dt('Reply directly to the triggering message (instead of sending a new one)')}</label>
      <label class="am-check"><input type="checkbox" name="ping_user" />{dt('Notify the triggering user (native reply ping, no @mention text stuffed in)')}</label>
      <div class="am-embed-fields">
        <select name="reply_type">
          <option value="text">{dt('Send as plain text')}</option>
          <option value="embed">{dt('Send as an embed')}</option>
        </select>
        <input type="text" name="embed_title" placeholder={dt('Embed title (optional)')} maxlength="100" />
        <ColorPicker name="embed_color" value="#8399ff" label={dt('Embed color')} />
        <input type="text" name="embed_footer" placeholder={dt('Footer text (optional)')} maxlength="100" />
      </div>
      <p class="am-hint"><Fragment set:html={dth('The title/color/footer only apply when set to embed, the reply text above becomes the embed description. Use <code>{a}</code> in that field to react to the sent embed.', { a: ('{reactreply:🌸}') })} /></p>
      {embedTemplateNames.length > 0 && (
        <div class="am-embed-fields">
          <select name="embed_template">
            <option value="">{dt('No saved template, use the options above')}</option>
            {embedTemplateNames.map((n) => <option value={n}>{n}</option>)}
          </select>
        </div>
      )}
      {embedTemplateNames.length > 0 && <p class="am-hint"><Fragment set:html={dth('Picking a saved template here uses its visual design. The reply field still accepts flags such as <code>{a}</code>; templates are managed on the Embeds page.', { a: ('{reactreply:🌸}') })} /></p>}
      <div class="am-channel-scope">
        <span class="am-channel-scope-label">{dt('Only in these channels (empty = everywhere)')}</span>
        <MultiSelect name="channel_ids" options={channelOptions} source="am-channels" selected={[]} placeholder={dt('Search channels...')} />
      </div>
      <div class="am-channel-scope">
        <span class="am-channel-scope-label">{dt('Only for members with these roles (empty = everyone)')}</span>
        <MultiSelect name="role_ids" options={roleOptions} source="am-roles" selected={[]} placeholder={dt('Search roles...')} />
      </div>
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button>
    </form>
  </div>
  )}

  {selectedSection === 'sticky-messages' && (
  <div class:list={['am-section', showSection('sticky-messages')]} data-section="sticky-messages">
    <h2><span class="am-h2-icon" style="--c:#5eead4"><Icon name="ph:push-pin-fill" width="14" height="14" /></span><Fragment set:html={dth('Sticky messages <span class="am-count">{a}</span>', { a: (stickyMessages.length) })} /></h2>
    <div class="am-list">
      {stickyMessages.map((s) => (
        <div class="am-row am-sticky-row">
          <span class="am-row-key">#{channelName(s.channelId)}</span>
          <span class="am-row-val" title={s.content}>{s.embedTemplate ? `${dt('Saved embed')}: ${s.embedTemplate}` : s.content}</span>
          <form method="POST"><input type="hidden" name="action" value="delete_sticky" /><input type="hidden" name="channel_id" value={s.channelId} />
            <button type="submit" class="am-del"><Icon name="ph:trash-fill" width="13" height="13" /></button>
          </form>
          <details class="am-edit">
            <summary><Icon name="ph:pencil-simple-fill" width="12" height="12" />{dt('Edit')}</summary>
            <form method="POST" class="am-add">
              <input type="hidden" name="action" value="add_sticky" /><input type="hidden" name="channel_id" value={s.channelId} />
              <input type="text" name="content" value={s.content} placeholder={dt('Message to keep pinned to the bottom')} maxlength="500" />
              <select name="embed_template"><option value="">{dt('No saved embed')}</option>{embedTemplateNames.map((name) => <option value={name} selected={name === s.embedTemplate}>{name}</option>)}</select>
              <button type="submit" class="btn btn-ghost btn-sm">{dt('Save changes')}</button>
            </form>
          </details>
        </div>
      ))}
    </div>
    <form method="POST" class="am-add">
      <input type="hidden" name="action" value="add_sticky" />
      <select name="channel_id" required>
        <option value="" disabled selected>{dt('Channel')}</option>
        {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
      </select>
      <input type="text" name="content" placeholder={dt('Message to keep pinned to the bottom')} maxlength="500" />
      <select name="embed_template"><option value="">{dt('No saved embed')}</option>{embedTemplateNames.map((name) => <option value={name}>{name}</option>)}</select>
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button>
    </form>
    <p class="am-hint"><Fragment set:html={dth('One sticky per channel, adding another in the same channel replaces it. After you save, the bot deletes and re-sends it every time someone posts in that channel, so it always stays at the bottom. Use <code>{a}</code> for a line break, <code>{b}</code> for a divider line. Choose a saved embed (a V2 design too) to send it instead of the text; the text is used if the embed is missing.', { a: ('{newline}'), b: ('{separator}') })} /></p>
  </div>
  )}

  {selectedSection === 'reaction-roles' && (
  <div class:list={['am-section', showSection('reaction-roles')]} data-section="reaction-roles">
    <h2><span class="am-h2-icon" style="--c:#fed53c"><Icon name="ph:smiley-fill" width="14" height="14" /></span><Fragment set:html={dth('Reaction roles <span class="am-count">{a}</span>', { a: (reactionRoles.length) })} /></h2>
    {reactionRoleError && <p class="am-error"><Icon name="ph:warning-fill" width="13" height="13" />{reactionRoleError}</p>}
    <a class="am-builder-link" href={`/dash/guild/${guildId}/reaction-role`}><Icon name="ph:magic-wand-fill" width="14" height="14" /><span><strong>{dt('Create a role menu with an embed and buttons')}</strong><small>{dt('Pick the channel, write or load an embed, and add rows of buttons with their color, role and emoji.')}</small></span><Icon name="ph:arrow-right-bold" width="13" height="13" /></a>
    <div class="am-list">
      {reactionRoles.map((r) => (
        <details class="am-ar">
          <summary class="am-row"><span class="am-row-key">{r.interactionType === 'button' ? (r.buttonLabel || 'button') : r.emoji}</span><span class="am-row-val" title={roleName(r.roleId)}>{roleName(r.roleId)}</span><span class="am-row-mode">{r.interactionType} · {r.mode}</span>{r.channelId && <a class="am-row-mode" href={`https://discord.com/channels/${guildId}/${r.channelId}/${r.messageId}`} target="_blank" rel="noopener" onclick="event.stopPropagation()">{dt('Open message')}</a>}<Icon name="ph:caret-right-bold" width="12" height="12" class="am-ar-chevron" /></summary>
          {r.interactionType === 'button' && r.channelId && <a class="am-builder-edit" href={`/dash/guild/${guildId}/reaction-role?message=${r.messageId}`}><Icon name="ph:pencil-simple-fill" width="12" height="12" />{dt('Edit the message in the builder')}</a>}
          <form method="POST" class="am-add am-add-wide am-ar-edit">
            <input type="hidden" name="action" value="edit_reactionrole" /><input type="hidden" name="id" value={r.id} />
            <div class="am-add-row">
              <select name="role_id" required>{roles.map((role) => <option value={role.id} selected={role.id === r.roleId}>{role.name}</option>)}</select>
              <select name="mode"><option value="toggle" selected={r.mode === 'toggle'}>toggle</option><option value="add" selected={r.mode === 'add'}>{dt('add only')}</option><option value="remove" selected={r.mode === 'remove'}>{dt('remove only')}</option></select>
              {r.interactionType === 'button' && <input type="text" name="button_label" value={r.buttonLabel ?? ''} placeholder={dt('Button label (optional)')} maxlength="80" />}
            </div>
            <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:check-bold" width="12" height="12" />{dt('Save')}</button>
          </form>
          <form method="POST" class="am-ar-delete"><input type="hidden" name="action" value="delete_reactionrole" /><input type="hidden" name="id" value={r.id} /><button type="submit" class="am-del-text" data-confirm={dt('Delete this? This cannot be undone.')}><Icon name="ph:trash-fill" width="12" height="12" />{dt('Delete')}</button></form>
        </details>
      ))}
    </div>
    <form method="POST" class="am-add">
      <input type="hidden" name="action" value="add_reactionrole" />
      <select name="channel_id" required>
        <option value="" disabled selected>{dt('Channel')}</option>
        {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
      </select>
      <input type="text" name="message_id" list="rr-messages" placeholder={dt('Message ID')} maxlength="24" />
      <datalist id="rr-messages">{[...new Set(reactionRoles.map((r) => r.messageId))].map((mid) => <option value={mid} />)}</datalist>
      <select name="embed_template">
        <option value="">{dt('Or post a new message with a saved embed')}</option>
        {embedTemplateNames.map((name) => <option value={name}>{name}</option>)}
      </select>
      <input type="text" name="emoji" data-emoji-input placeholder={dt('Emoji or custom emoji')} maxlength="100" required />
      <select name="role_id" required>
        <option value="" disabled selected>{dt('Role')}</option>
        {roles.map((r) => <option value={r.id}>{r.name}</option>)}
      </select>
      <select name="mode">
        <option value="toggle">toggle</option>
        <option value="add">{dt('add only')}</option>
        <option value="remove">{dt('remove only')}</option>
      </select>
      <select name="interaction_type">
        <option value="reaction">reaction</option>
        <option value="button">button</option>
      </select>
      <input type="text" name="button_label" placeholder={dt('Button label (optional)')} maxlength="80" />
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button>
    </form>
    <p class="am-hint">{dt('Use reaction mode for emoji reactions or button mode for a clickable role menu. Button mode can add up to 25 buttons to a message without another component panel.')}</p>
    <p class="am-hint">{dt('Type the ID of a message, or pick a saved embed to post a new message with the role button on it (classic embeds only; a V2 design cannot hold role buttons). To add more buttons to that message, use its ID.')}</p>
  </div>
  )}

  {selectedSection === 'auto-threads' && (
  <div class:list={['am-section', showSection('auto-threads')]} data-section="auto-threads">
    <h2><span class="am-h2-icon" style="--c:#5b8def"><Icon name="ph:chats-circle-fill" width="14" height="14" /></span><Fragment set:html={dth('Auto-threading <span class="am-count">{a}</span>', { a: (autoThreads.length) })} /></h2>
    <div class="am-list">
      {autoThreads.map((at) => (
        <div class="am-row">
          <code class="am-row-key">#{channelName(at.channelId)}</code>
          <span class="am-row-mode" title={dt('Thread name')}>{at.nameTemplate}</span>
          <span class="am-row-mode">{ARCHIVE_LABELS[at.archiveMinutes] ?? `${at.archiveMinutes}m`}</span>
          {(at.messageText || at.embedTemplate) && <span class="am-row-mode" title={dt('Has a starter message')}>{dt('has message')}</span>}
          <form method="POST"><input type="hidden" name="action" value="delete_autothread" /><input type="hidden" name="channel_id" value={at.channelId} />
            <button type="submit" class="am-del"><Icon name="ph:trash-fill" width="13" height="13" /></button>
          </form>
        </div>
      ))}
    </div>
    <form method="POST" class="am-add-wide">
      <input type="hidden" name="action" value="add_autothread" />
      <div class="am-add-row">
        <select name="channel_id" required>
          <option value="" disabled selected>{dt('Channel')}</option>
          {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
        </select>
        <input type="text" name="name_template" placeholder={dt('Thread name (default: {user_name})')} maxlength="100" />
        <select name="archive_minutes">
          <option value="60">{dt('Archive after 1 hour')}</option>
          <option value="1440">{dt('Archive after 1 day')}</option>
          <option value="4320">{dt('Archive after 3 days')}</option>
          <option value="10080">{dt('Archive after 1 week')}</option>
        </select>
      </div>
      <input type="text" name="message_text" placeholder={dt('Starter message inside the thread (optional, supports variables)')} maxlength="500" />
      <VariableHelp />
      {embedTemplateNames.length > 0 && (
        <select name="embed_template">
          <option value="">{dt('No template, use message text above')}</option>
          {embedTemplateNames.map((n) => <option value={n}>{n}</option>)}
        </select>
      )}
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button>
    </form>
    <p class="am-hint">{dt('Starts a thread off every new message in the channel, good for support/showcase channels where each message deserves its own conversation.')}</p>
  </div>
  )}

  {selectedSection === 'disabled-commands' && (
  <div class:list={['am-section', showSection('disabled-commands')]} data-section="disabled-commands">
    <h2><span class="am-h2-icon" style="--c:#fe6465"><Icon name="ph:prohibit-fill" width="14" height="14" /></span><Fragment set:html={dth('Disabled commands <span class="am-count">{a}</span>', { a: (disabledCommands.length) })} /></h2>
    <div class="am-list">
      {disabledCommands.map((d) => (
        <div class="am-row">
          <code class="am-row-key">{prefix}{d.command}</code>
          <span class="am-row-val">{d.channelId ? `in #${channelName(d.channelId)}` : 'server-wide'}</span>
          <form method="POST"><input type="hidden" name="action" value="delete_disabled" /><input type="hidden" name="id" value={d.id} />
            <button type="submit" class="am-del"><Icon name="ph:trash-fill" width="13" height="13" /></button>
          </form>
        </div>
      ))}
    </div>
    <form method="POST" class="am-add">
      <input type="hidden" name="action" value="add_disabled" />
      <input type="text" name="command" placeholder={dt('Command name')} maxlength="32" required />
      <select name="channel_id">
        <option value="">{dt('Server-wide')}</option>
        {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
      </select>
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button>
    </form>
  </div>
  )}
  {['reaction-triggers', 'starboard', 'monkeyboard', 'autoresponders'].includes(selectedSection) && (
    <>
      <MultiSelectOptions name="am-channels" options={channelOptions} />
      <MultiSelectOptions name="am-roles" options={roleOptions} />
    </>
  )}
  <EmojiPicker customEmojis={customEmojis} />
</DashGuildLayout>

<style>
  .am-news-icon { vertical-align: -2px; margin-right: 4px; }

  .am-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; max-width: 720px; margin-bottom: 24px; }
  .am-eyebrow { margin: 0 0 6px; color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  h1 { font-size: 24px; margin: 0 0 6px; }
  .am-overview-link { display: inline-flex; align-items: center; gap: 7px; color: var(--text-muted); border: 1px solid var(--border); background: var(--card); border-radius: 8px; padding: 8px 11px; font-size: 12px; text-decoration: none; white-space: nowrap; }
  .am-overview-link:hover { color: var(--accent); border-color: var(--accent); }
  h2 { font-size: 14.5px; margin: 0 0 12px; display: flex; align-items: center; gap: 9px; }
  .am-h2-icon { width: 24px; height: 24px; border-radius: 7px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: color-mix(in srgb, var(--c) 16%, transparent); color: var(--c); }
  .am-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 24px; max-width: 68ch; }
  .am-sub b { color: var(--text); }

  .am-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 20px; max-width: fit-content; }
  .am-error { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--red); background: var(--red-soft); border: 1px solid var(--red); border-radius: 9px; padding: 8px 12px; margin: 0 0 10px; }
  .am-feature-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; padding-top: 4px; }
  .am-inline-label { color: var(--text-dim); font-size: 12px; align-self: center; }

  .am-section { border: 1px solid var(--border); border-radius: 14px; background: var(--bg-raise); padding: 18px 20px; margin-bottom: 20px; max-width: 720px; }
  .am-section-hidden { display: none; }
  .am-overview { max-width: 720px; }
  .am-overview-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .am-overview-card { display: flex; align-items: center; gap: 11px; min-width: 0; padding: 14px; color: var(--text); background: var(--bg-raise); border: 1px solid var(--border); border-radius: 12px; text-decoration: none; transition: border-color .15s, background .15s, transform .15s; }
  .am-overview-card:hover { border-color: var(--accent); background: var(--card-hover); transform: translateY(-1px); }
  .am-overview-card > :global(span:nth-child(2)){ min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .am-overview-card strong { font-size: 13px; }
  .am-overview-card small { color: var(--text-dim); font-size: 11px; line-height: 1.35; }
  .am-overview-icon { width: 30px; height: 30px; display: grid; place-items: center; flex: 0 0 auto; border-radius: 8px; color: var(--accent); background: var(--accent-soft); }
  .am-overview-arrow { margin-left: auto; flex: 0 0 auto; color: var(--text-dim); }
  :global(.am-count){ font-family: var(--mono); font-size: 11px; color: var(--text-dim); font-weight: 400; }
  .am-spoiler { display: flex; align-items: flex-start; gap: 10px; font-size: 12.5px; color: var(--text-dim); background: color-mix(in srgb, var(--accent, #8399ff) 10%, transparent); border: 1px solid color-mix(in srgb, var(--accent, #8399ff) 35%, var(--border)); border-radius: 10px; padding: 10px 12px; margin: 0 0 12px; }
  .am-spoiler svg { flex: none; margin-top: 1px; color: var(--accent); }
  .am-spoiler div { display: flex; flex-direction: column; gap: 2px; }
  .am-spoiler strong { color: var(--text); font-size: 13px; }
  .am-premium-tag { font-family: var(--mono); font-size: 10px; font-weight: 600; color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border: 1px solid color-mix(in srgb, var(--yellow) 32%, var(--border)); border-radius: 999px; padding: 3px 7px; }
  .am-limit-card { display: flex; align-items: center; gap: 12px; max-width: 680px; padding: 13px 15px; border: 1px solid color-mix(in srgb, var(--yellow) 38%, var(--border)); border-radius: 11px; background: color-mix(in srgb, var(--yellow) 6%, var(--card)); color: var(--yellow); }
  .am-limit-card > div { display: grid; gap: 3px; min-width: 0; }
  .am-limit-card strong { color: var(--text); font-size: 13px; }
  .am-limit-card :global(span){ color: var(--text-muted); font-size: 12px; line-height: 1.4; }
  .am-limit-card .btn { margin-left: auto; flex-shrink: 0; }

  .am-list { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin-bottom: 10px; }
  .am-list:empty { display: none; }
  .am-row { display: flex; align-items: center; gap: 12px; padding: 9px 14px; font-size: 13px; background: var(--card); }
  .am-row + .am-row { border-top: 1px solid var(--border-soft); }
  .am-row-key { font-family: var(--mono); color: var(--accent); font-weight: 600; background: var(--accent-soft); padding: 2px 8px; border-radius: 5px; flex-shrink: 0; }
  .am-row-mode { font-size: 11px; color: var(--text-dim); background: var(--bg-raise); border: 1px solid var(--border-soft); padding: 2px 7px; border-radius: 5px; flex-shrink: 0; }
  .am-row-val { color: var(--text-muted); background: var(--bg-raise); border: 1px solid var(--border-soft); padding: 4px 10px; border-radius: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; min-width: 0; }
  .am-sticky-row { flex-wrap: wrap; }
  .am-edit { flex-basis: 100%; }
  .am-edit summary { cursor: pointer; font-size: 12px; color: var(--text-dim); display: inline-flex; align-items: center; gap: 5px; }
  .am-edit[open] summary { margin-bottom: 8px; }
  .am-del { border: none; background: transparent; color: var(--text-dim); cursor: pointer; padding: 4px; border-radius: 6px; flex-shrink: 0; }
  .am-del:hover { color: var(--red); background: var(--red-soft); }

  .am-add { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .am-add input, .am-add select, .am-add textarea, .am-add-wide input, .am-add-wide select, .am-add-wide textarea { border: 1px solid var(--border); border-radius: 8px; padding: 7px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 12.5px; box-sizing: border-box; }
  .am-add textarea, .am-add-wide textarea { width: 100%; min-height: 54px; resize: vertical; line-height: 1.45; }
