            {embedTemplateNames.length > 0 && <select name="embed_template" data-tpl-locks="message" aria-label={dt('Saved embed')}><option value="">{dt('No saved embed')}</option>{embedTemplateNames.map((name) => <option value={name} selected={name === t.embedTemplate}>{name}</option>)}</select>}
            <label class="am-check"><input type="checkbox" name="delete_previous" checked={t.deletePrevious} />{dt('Delete the message of the time before (the bot needs Manage Messages)')}</label>
