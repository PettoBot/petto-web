            <div class="am-add-row am-tm-repeat"><input type="hidden" name="old_schedule" value={t.schedule ?? 'interval'} /><label class="am-tm-label">{dt('Repeat')}<select name="schedule" aria-label={dt('Repeat')}><option value="interval" selected={(t.schedule ?? 'interval') === 'interval'}>{dt('Every interval')}</option><option value="daily" selected={(t.schedule ?? 'interval') === 'daily'}>{dt('Every day')}</option><option value="weekly" selected={(t.schedule ?? 'interval') === 'weekly'}>{dt('Every week')}</option></select></label></div><div class="am-add-row am-tm-sched"><input type="time" name="at_time" value={t.atTime ?? ''} aria-label={dt('Time')} /><select name="weekday" class="am-tm-week" aria-label={dt('Day of the week')}>{timerWeekdays.map((d) => <option value={d.day} selected={d.day === Number(t.weekday ?? 1)}>{d.name}</option>)}</select><input type="text" name="timezone" list="am-tm-zones" value={t.timezone ?? 'UTC'} autocomplete="off" spellcheck="false" maxlength="64" placeholder={dt('Search a time zone (e.g. America/Bogota)')} aria-label={dt('Time zone')} /></div><div class="am-add-row am-tm-int"><input type="number" name="interval_value" min="1" step="any" value={splitInterval(t.intervalMs).value} aria-label={dt('Repeat every')} required /><select name="interval_unit" aria-label={dt('Unit')}>{TIMER_UNITS.map((u) => <option value={u.id} selected={u.id === splitInterval(t.intervalMs).unit}>{timerUnitLabel[u.id]}</option>)}</select></div>
