<span class="am-msg-embed" style="--ec:var(--border)"><span class="am-msg-embed-title">{t.embedTemplate}</span></span>}{t.message ? <span class="am-msg-text am-msg-clamp" title={t.message}>{t.message}</span> : !t.embedTemplate && <span class="am-msg-text am-msg-none">{dt('No reply text')}</span>}</span></span></span>{t.lastError && <span class="am-tm-issue" title={t.lastError}><Icon name="ph:warning-fill" width="11" height="11" />{dt('Last send failed: {a}', { a: t.lastError })}</span>}</summary>
