      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button>
    </form>
    <p class="am-hint">{dt('Starts a thread off every new message in the channel, good for support/showcase channels where each message deserves its own conversation.')}</p>
  </div>
  )}

  {selectedSection === 'disabled-commands' && (
  <div class:list={['am-section', showSection('disabled-commands')]} data-section="disabled-commands">
    <h2><span class="am-h2-icon" style="--c:#fe6465"><Icon name="ph:prohibit-fill" width="14" height="14" /></span><Fragment set:html={dth('Disabled commands <span class="am-count">{a}</span>', { a: (disabledCommands.length) })} /></h2>
    <div class="am-dc-cats dgl-stagger" role="group" aria-label={dt('Commands by category')}>
      {dcCategories.map((c) => (
        <DcTile {...(disabledCommands.length ? { type: 'button', 'data-dc-cat': c.id, 'aria-pressed': 'false', title: dt('Show only the disabled commands of {a}', { a: c.title }) } : {})} class="am-dc-cat dgl-card">
          <span class="am-dc-cat-icon"><Icon name={c.icon} width="16" height="16" /></span>
          <span class="am-dc-cat-name">{c.title}</span>
          <span class="am-dc-cat-n">{c.total === 1 ? dt('1 command') : dt('{a} commands', { a: c.total })}</span>
          {c.off > 0 && <span class="am-dc-cat-off">{dt('{a} disabled', { a: c.off })}</span>}
        </DcTile>
      ))}
    </div>
    {disabledCommands.length === 0 && <p class="am-empty"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('No commands are disabled: everything works everywhere.')}</p>}
    {disabledCommands.length > 0 && <p class="am-empty" data-dc-none hidden><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('No command of this category is disabled.')}</p>}
    <div class="am-dc-groups">
      {groupRules(disabledCommands).map((group) => (
        <div class="am-dc-group" data-dc-group>
          <div class="am-dc-head">
            <span class="am-dc-place">{group.channelId ? <><Icon name="ph:hash-bold" width="12" height="12" />{channelName(group.channelId)}</> : <><Icon name="ph:globe-hemisphere-west-fill" width="13" height="13" />{dt('The whole server')}</>}</span>
            <span class="am-row-mode">{group.rules.length === 1 ? dt('1 command') : dt('{a} commands', { a: group.rules.length })}</span>
            <form method="POST" class="am-dc-clear">
              <input type="hidden" name="action" value="clear_disabled" /><input type="hidden" name="channel_id" value={group.channelId ?? 'server'} />
              <button type="submit" class="btn btn-ghost btn-sm" data-confirm={dt('Turn every command of this place back on?')}>{dt('Remove all')}</button>
            </form>
          </div>
          <div class="am-dc-chips">
            {group.rules.map((d) => (
              <form method="POST" class="am-dc-chip" data-dc-chip={dcCategoryOf.get(d.command.toLowerCase()) ?? ''}>
                <input type="hidden" name="action" value="delete_disabled" /><input type="hidden" name="id" value={d.id} />
                <code>{prefix}{d.command}</code>
                <button type="submit" class="am-dc-x" title={dt('Turn {a} back on', { a: `${prefix}${d.command}` })} aria-label={dt('Turn {a} back on', { a: `${prefix}${d.command}` })}><Icon name="ph:x-bold" width="10" height="10" /></button>
              </form>
            ))}
          </div>
        </div>
      ))}
    </div>
    <form method="POST" class="am-add am-dc-add" data-no-dirty>
      <input type="hidden" name="action" value="add_disabled" />
      <input type="text" name="command" list="am-dc-commands" placeholder={dt('Commands, like suggest, rank, 8ball')} maxlength="400" required autocomplete="off" />
      <datalist id="am-dc-commands">{disableableCommands.map((name) => <option value={name} />)}</datalist>
      <div class="am-channel-scope"><MultiSelect name="channel_ids" options={channelOptions} source="am-channels" selected={[]} placeholder={dt('The whole server')} /></div>
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Disable')}</button>
    </form>
    <p class="am-hint">{dt('Several at once, separated by commas or spaces; an alias is saved as its command. No channel: the whole server. The same as {a} in Discord.', { a: `${prefix}dc suggest,rank #channel` })}</p>
    <script is:inline>
      // A category tile shows only the disabled commands of that category (the list is all on the page); the same tile again shows all.
      if (!window.__amDcCatsBound) {
        window.__amDcCatsBound = true;
        document.addEventListener('click', function (e) {
          var tile = e.target && e.target.closest ? e.target.closest('[data-dc-cat]') : null;
          if (!tile) return;
          var section = tile.closest('[data-section="disabled-commands"]');
          if (!section) return;
          var on = tile.getAttribute('aria-pressed') !== 'true';
          var cat = on ? tile.getAttribute('data-dc-cat') : '';
          section.querySelectorAll('[data-dc-cat]').forEach(function (t) { t.setAttribute('aria-pressed', String(t === tile && on)); });
          var shown = 0;
          section.querySelectorAll('[data-dc-group]').forEach(function (group) {
            var any = false;
            group.querySelectorAll('[data-dc-chip]').forEach(function (chip) {
              var match = !cat || chip.getAttribute('data-dc-chip') === cat;
              chip.hidden = !match;
              if (match) any = true;
            });
            group.hidden = !any;
            if (any) shown++;
          });
          var none = section.querySelector('[data-dc-none]');
          if (none) none.hidden = shown > 0;
        });
      }
    </script>
  </div>
  )}
  {['reaction-triggers', 'starboard', 'monkeyboard', 'autoresponders', 'voicemaster', 'disabled-commands'].includes(selectedSection) && (
    <>
      <MultiSelectOptions name="am-channels" options={channelOptions} />
      <MultiSelectOptions name="am-roles" options={roleOptions} />
    </>
  )}
  <EmojiPicker customEmojis={customEmojis} />
  <script is:inline>
    // The usual look of a starboard repost is drawn while no saved design is picked.
    if (!window.__boardMock) {
      window.__boardMock = true;
      document.addEventListener('change', function (e) {
        var select = e.target;
        if (!select || select.name !== 'embed_template') return;
        var scope = select.closest('.am-channel-scope');
        var mock = scope && scope.querySelector('[data-board-mock]') ? scope.querySelector('.am-board-mock') : null;
        if (mock) mock.hidden = !!select.value;
      });
    }
  </script>
<script is:inline define:vars={{ flNames: { interval_seconds: dt('Update every (seconds)') } }}>
  // The add forms use placeholders as their only hint; this gives each field a label that stays visible while typing. A form put in the
  // page later (the edit form of an autoresponder row) is given them when it arrives.
  (window.amFloatLabels = function () {
    document.querySelectorAll('.am-section form.am-add:not([data-fl])').forEach(function (form) {
      form.setAttribute('data-fl', '1');
      form.querySelectorAll('input, select, textarea').forEach(function (el) {
        var type = (el.getAttribute('type') || '').toLowerCase();
        if (['hidden', 'checkbox', 'radio', 'file', 'color', 'submit', 'button'].indexOf(type) !== -1) return;
        // The search box of a role or channel picker already says what it is: a label above it would repeat it.
        if (el.closest('label, [data-colorpicker], .am-send-modes, [data-multiselect]') || el.hasAttribute('data-no-label')) return;
        var text = el.getAttribute('aria-label') || el.getAttribute('placeholder') || flNames[el.getAttribute('name')] || '';
        // A select whose first choice is already readable (not a disabled placeholder) needs no extra label.
        if (!text && el.tagName === 'SELECT' && el.options.length && el.options[0].disabled) text = el.options[0].textContent || '';
        text = text.trim();
        if (!text) return;
        var wrap = document.createElement('label');
        wrap.className = 'am-fl';
        var t = document.createElement('span');
        t.className = 'am-fl-t';
        t.textContent = text;
        el.parentNode.insertBefore(wrap, el);
        wrap.appendChild(t);
        wrap.appendChild(el);
      });
    });
  })();
</script>
</DashGuildLayout>

<style>
  /* Automation hub, aliases, webhooks, reaction triggers, message reactions and timers (everything ax2-). */
  .ax2-page { display: flex; flex-direction: column; max-width: 1000px; min-width: 0; }
  .ax2-head { margin: 4px 0 14px; }
  .ax2-head h2 { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin: 0; font-size: 16px; }
  .ax2-head p { margin: 4px 0 0; font-size: 13px; line-height: 1.5; color: var(--text-dim); max-width: 70ch; }
  .ax2-count { font-family: var(--mono); font-size: 11.5px; font-weight: 500; color: var(--text-dim); background: color-mix(in srgb, var(--text) 7%, transparent); border-radius: 999px; padding: 2px 9px; }
