      <label class="am-check"><input type="checkbox" name="delete_previous" />{dt('Delete the message of the time before (the bot needs Manage Messages)')}</label>
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add timer')}</button>
    </form>
    <datalist id="am-tm-zones">{timerZones.map((zone) => <option value={zone} />)}</datalist>
    <script is:inline define:vars={{ tmNext: dt('Next: {a}') }}>
      // Timers: the zone of a new timer starts as the browser's, and the next runs show in the viewer's own time. Runs on every visit
      // of the page (it only fills fields of this page); the window flag keeps the function from being defined again.
      if (!window.__amTimerZone) {
        window.__amTimerZone = function (nextLabel) {
          var zone = '';
          try { zone = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
          document.querySelectorAll('#dgl-content input[data-tm-zone-default]').forEach(function (el) {
            if (zone && el.value === 'UTC' && !el.hasAttribute('data-tm-zone-set')) el.value = zone;
            el.setAttribute('data-tm-zone-set', '');
          });
          document.querySelectorAll('#dgl-content time[data-tm-next]').forEach(function (el) {
            var at = Date.parse(el.getAttribute('datetime') || '');
            if (!isFinite(at)) return;
            try { el.textContent = nextLabel.replace('{a}', new Date(at).toLocaleString(document.documentElement.lang || undefined, { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })); } catch (e) {}
          });
        };
      }
      window.__amTimerZone(tmNext);
    </script>
