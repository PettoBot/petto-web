    <span class="am-icon-keep" aria-hidden="true"><Icon name="ph:check-bold" width="12" height="12" /></span>
    <template data-ar-edit>
          <form method="POST" class="am-add am-add-wide am-ar-edit">
            <input type="hidden" name="action" value="edit_responder" />
            <input type="hidden" name="ar_id" value="" />
            <div class="am-add-row">
              <input type="text" name="trigger" value="" maxlength="80" required />
              <select name="match_mode">
