    <form method="POST" class="am-add am-add-wide am-tm-form" data-no-dirty>
      <input type="hidden" name="action" value="add_timer" /><div class="am-add-row"><select name="channel_id" required><option value="" disabled selected>{dt('Channel')}</option>{channels.map((c) => <option value={c.id}>#{c.name}</option>)}</select></div><div class="am-add-row am-tm-repeat"><label class="am-tm-label">{dt('Repeat')}<select name="schedule" aria-label={dt('Repeat')}><option value="interval" selected>{dt('Every interval')}</option><option value="daily" >{dt('Every day')}</option><option value="weekly" >{dt('Every week')}</option></select></label></div><div class="am-add-row am-tm-sched"><input type="time" name="at_time" value="18:00" aria-label={dt('Time')} /><select name="weekday" class="am-tm-week" aria-label={dt('Day of the week')}>{timerWeekdays.map((d) => <option value={d.day} selected={d.day === 1}>{d.name}</option>)}</select><input type="text" name="timezone" list="am-tm-zones" value="UTC" autocomplete="off" spellcheck="false" maxlength="64" placeholder={dt('Search a time zone (e.g. America/Bogota)')} aria-label={dt('Time zone')} data-tm-zone-default /></div><div class="am-add-row am-tm-int"><input type="number" name="interval_value" min="1" step="any" value="10" aria-label={dt('Repeat every')} required /><select name="interval_unit" aria-label={dt('Unit')}>{TIMER_UNITS.map((u) => <option value={u.id} selected={u.id === 'minutes'}>{timerUnitLabel[u.id]}</option>)}</select></div>
