  <script is:inline>
    // The usual look of a starboard repost is drawn while no saved design is picked.
    if (!window.__boardMock) {
      window.__boardMock = true;
      document.addEventListener('change', function (e) {
        var select = e.target;
        if (!select || select.name !== 'embed_template') return;
        var scope = select.closest('.am-channel-scope');
        var mock = scope && scope.querySelector('[data-board-mock]') ? scope.querySelector('.am-board-mock') : null;
        if (mock) mock.hidden = !!select.value;
      });
    }
  </script>
<script is:inline define:vars={{ flNames: { interval_seconds: dt('Update every (seconds)'), interval_minutes: dt('Repeat every (minutes)') } }}>
  // The add forms use placeholders as their only hint; this gives each field a label that stays visible while typing. A form put in the
  // page later (the edit form of an autoresponder row) is given them when it arrives.
  (window.amFloatLabels = function () {
    document.querySelectorAll('.am-section form.am-add:not([data-fl])').forEach(function (form) {
      form.setAttribute('data-fl', '1');
      form.querySelectorAll('input, select, textarea').forEach(function (el) {
        var type = (el.getAttribute('type') || '').toLowerCase();
        if (['hidden', 'checkbox', 'radio', 'file', 'color', 'submit', 'button'].indexOf(type) !== -1) return;
        // The search box of a role or channel picker already says what it is: a label above it would repeat it.
        if (el.closest('label, [data-colorpicker], .am-send-modes, [data-multiselect]') || el.hasAttribute('data-no-label')) return;
        var text = el.getAttribute('aria-label') || el.getAttribute('placeholder') || flNames[el.getAttribute('name')] || '';
        // A select whose first choice is already readable (not a disabled placeholder) needs no extra label.
        if (!text && el.tagName === 'SELECT' && el.options.length && el.options[0].disabled) text = el.options[0].textContent || '';
        text = text.trim();
        if (!text) return;
        var wrap = document.createElement('label');
        wrap.className = 'am-fl';
        var t = document.createElement('span');
        t.className = 'am-fl-t';
        t.textContent = text;
        el.parentNode.insertBefore(wrap, el);
        wrap.appendChild(t);
        wrap.appendChild(el);
      });
    });
  })();
</script>
