        var f = document.querySelector('[data-vm]'); if (!f || f.dataset.bound) return; f.dataset.bound = '1';
        var input = f.querySelector('[data-vm-name]'), sample = f.querySelector('[data-vm-sample]');
        var paint = function () { sample.textContent = (input.value || '{user.name}').replace(/\{user\.display_name\}|\{user\.name\}|\{user\}/g, 'Liam').slice(0, 100); };
        input.addEventListener('input', paint);
        f.addEventListener('click', function (e) {
          var b = e.target.closest('[data-vm-insert]'); if (!b) return;
          var at = input.selectionStart == null ? input.value.length : input.selectionStart;
          input.value = (input.value.slice(0, at) + b.getAttribute('data-vm-insert') + input.value.slice(input.selectionEnd == null ? at : input.selectionEnd)).slice(0, 100);
          input.focus(); paint();
        });
      })();
