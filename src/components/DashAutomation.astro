---
import SilentMentionHint from './SilentMentionHint.astro';
import { Icon } from 'astro-icon/components';
import DashBoardMock from './DashBoardMock.astro';
import DashGuildLayout from './DashGuildLayout.astro';
import VariableHelp from './VariableHelp.astro';
import MultiSelect from './MultiSelect.astro';
import MultiSelectOptions from './MultiSelectOptions.astro';
import { groupRules, disableableCommands } from '../utils/disabledCommands';
import { TIMER_UNITS, splitInterval } from '../utils/timerInterval';
import { timeZoneList, weekdayName } from '../utils/timerSchedule';
import ColorPicker from './ColorPicker.astro';
import EmojiPicker from './EmojiPicker.astro';
import LiveTextPreview from './LiveTextPreview.astro';
import DashAcData from './DashAcData.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import SxNumber from './SxNumber.astro';
import { getAllCommands } from '../utils/commandList';
import { useTranslations } from '../i18n/ui';

import { dashLocale, getDashLang, makeT } from '../i18n/dash';
import { formatDuration } from '../utils/formatDuration';
import { FREE_LIMITS, PREMIUM_LIMITS, planLimits } from '../utils/planLimits';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface CustomCommand { id: number; name: string; response: string | null; embedTemplate: string | null; isCode?: boolean; }
interface AutoResponder {
  id: number; arId: string; trigger: string; reply: string; matchMode: string; deleteTrigger: boolean; replyToTrigger: boolean; pingUser: boolean; deletePrevious?: boolean; channelIds: string[]; roleIds: string[];
  replyType: string; embedColor: number | null; embedTitle: string | null; embedFooter: string | null; embedTemplate: string | null;
}
interface StickyMessage { channelId: string; content: string; embedTemplate: string; }
interface DisabledCommand { id: number; command: string; channelId: string | null; }
interface ReactionRole { id: number; channelId?: string; messageId: string; emoji: string; roleId: string; mode: string; interactionType: string; buttonLabel: string | null; }
interface ReactionTrigger { id: number; emoji: string; trigger: string; ownerId: string; matchMode: string; channelIds: string[]; roleIds: string[]; caseSensitive: boolean; cooldownSeconds: number; enabled: boolean; }
interface ReactionMessageConfig { id: number; channelId: string; emojis: string[]; }
interface ManagedWebhook { id: number; name: string; channelId: string; webhookId: string; defaultUsername: string | null; defaultAvatarUrl: string | null; defaultMessage: string | null; enabled: boolean; }
interface ServerCounter { id: number; channelId: string; option: string; type: string; nameTemplate: string; prefix: string; suffix: string; parentId: string | null; intervalSeconds: number; enabled: boolean; }
interface AutoThread { channelId: string; nameTemplate: string; messageText: string | null; embedTemplate: string | null; archiveMinutes: number; }
interface CommandAlias { id: number; name: string; command: string; }
interface AutoTimer { id: number; channelId: string; intervalMs: number; message: string; nextRunAt: string; deletePrevious?: boolean; embedTemplate?: string; schedule?: string; atTime?: string; timezone?: string; weekday?: number | null; number?: number | null; lastError?: string; paused?: boolean; }
interface StarboardSettings { channel_id: string | null; threshold: number; emoji: string; color?: number | null; selfstar: boolean; timestamp: boolean; jumpurl: boolean; attachments: boolean; embed_template?: string | null; ignoredChannelIds: string[]; ignoredRoleIds: string[]; ignoredUserIds: string[]; }
interface VoiceMasterSettings { creatorChannelId: string; panelChannelId: string; panelMessageId: string | null; categoryId: string | null; defaultLimit: number; defaultName: string; syncCategoryPermissions?: boolean; accessRoleIds?: string[]; privacyMode?: string; ownerPermissions?: string[]; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  customCommands: CustomCommand[];
  prefix?: string;
  premiumActive: boolean;
  autoResponders: AutoResponder[];
  stickyMessages: StickyMessage[];
  disabledCommands: DisabledCommand[];
  reactionRoles: ReactionRole[];
  reactionTriggers: ReactionTrigger[];
  reactionMessages: ReactionMessageConfig[];
  autoThreads: AutoThread[];
  roles: { id: string; name: string }[];
  channels: { id: string; name: string; type?: number }[];
  embedTemplateNames: string[];
  saved: boolean;
  notice?: string | null;
  reactionRoleError?: string | null;
  error?: string | null;
  aliases: CommandAlias[];
  timers: AutoTimer[];
  starboard: StarboardSettings | null;
  monkeyboard: StarboardSettings | null;
  stickyRolesEnabled?: boolean;
  stickyRolesSaved?: number;
  stickyRolesWaiting?: { id: string; name: string | null; avatar: string }[];
  voiceMaster: VoiceMasterSettings | null;
  voiceChannels: { id: string; name: string }[];
  channelCategories: { id: string; name: string }[];
  managedWebhooks: ManagedWebhook[];
  serverCounters: ServerCounter[];
  /** The Automation hub: how many each feature has (null when a count could not be read), which ones are on, and the timers' next run. */
  overview?: { counts: Record<string, number | null>; on: Record<string, boolean>; timers: { total: number; running: number; nextRunAt: string | null } | null } | null;
  section?: string;
  customEmojis?: { id: string; name: string; animated: boolean }[];
}
const { user, guildId, guildName, guildIcon, prefix = '!', monkeyboard = null, customCommands, premiumActive, autoResponders, stickyMessages, disabledCommands, reactionRoles, reactionTriggers, reactionMessages, autoThreads, roles, channels, embedTemplateNames, saved, notice = null, reactionRoleError, error, aliases, timers, starboard, voiceMaster, voiceChannels, channelCategories, managedWebhooks, serverCounters, stickyRolesEnabled = false, stickyRolesSaved = 0, stickyRolesWaiting = [], section, customEmojis = [] } = Astro.props;


// The channel and role lists of the searchable selects, written once for the whole page.
const channelOptions = channels.map((c) => ({ id: c.id, name: `#${c.name}` }));
const roleOptions = roles.map((r) => ({ id: r.id, name: r.name }));
// VoiceMaster and Sticky roles: the name of a channel by its id, a name cut to fit a number tile, and the three privacy modes as a title and a line ("Public: everyone can see and join").
const vmName = (list: { id: string; name: string }[], id: string | null | undefined) => list.find((c) => c.id === id)?.name ?? '—';
const vmNameValue = voiceMaster?.defaultName ?? '{user.name}';
const vmShort = (text: string) => (text.length > 12 ? `${text.slice(0, 11)}…` : text);
const vmSplit = (text: string): [string, string] => { const [head, ...rest] = text.split(': '); return [head, rest.join(': ')]; };
const vmPrivacy: Record<string, [string, string]> = {
  public: vmSplit(dt('Public: everyone can see and join')),
  locked: vmSplit(dt('Locked: everyone sees it, only invited members join')),
  hidden: vmSplit(dt('Hidden: only invited members see and join')),
};
const newsChannelIds = new Set(channels.filter((c) => c.type === 5).map((c) => c.id));
function channelName(id: string) {
  return channels.find((c) => c.id === id)?.name ?? id;
}
function roleName(id: string) {
  return roles.find((r) => r.id === id)?.name ?? id;
}

const sectionMeta: Record<string, { label: string; description: string }> = {
  overview: { label: dt('Automation'), description: dt('Manage every automation module independently from one place.') },
  'custom-commands': { label: dt('Custom commands'), description: dt('Create as many prefix commands as your server needs.') },
  autoresponders: { label: dt('Autoresponders'), description: dt('Build multiple automatic replies with channel, role, and embed rules.') },
  'sticky-messages': { label: dt('Sticky messages'), description: dt('Keep one configurable message pinned at the bottom of each selected channel.') },
  'reaction-roles': { label: dt('Reaction roles'), description: dt('Bind multiple messages, emojis, and roles to build flexible role menus.') },
  'reaction-triggers': { label: dt('Reaction triggers'), description: dt('React to words or phrases with independent matching and scope rules.') },
  'reaction-messages': { label: dt('Message reactions'), description: dt('Add a configurable set of emojis to every new message in selected channels.') },
  'auto-threads': { label: 'Auto-threading', description: dt('Create independent thread rules for each channel that needs them.') },
  'disabled-commands': { label: dt('Disabled commands'), description: dt('Disable commands globally or only in selected channels.') },
  aliases: { label: dt('Command aliases'), description: dt('Create multiple prefix shortcuts for your most-used commands.') },
  timers: { label: dt('Repeating timers'), description: dt('Run multiple recurring messages with independent channels and intervals.') },
  starboard: { label: dt('Starboard'), description: dt('Configure how highlighted messages are collected and displayed.') },
  monkeyboard: { label: dt('Monkeyboard'), description: dt('The starboard\'s opposite: messages that get enough monkeys are collected in their own channel.') },
  voicemaster: { label: dt('VoiceMaster'), description: dt('Configure the temporary voice channel system and its control panel.') },
  webhooks: { label: dt('Webhooks'), description: dt('Manage multiple webhooks and send customized messages from one place.') },
  'sticky-roles': { label: dt('Sticky roles'), description: dt('Give members back the roles they had when they come back to the server.') },
  counters: { label: dt('Live counters'), description: dt('Create multiple live counters with their own channel, format, and interval.') },
};
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'overview';
const selectedMeta = sectionMeta[selectedSection];
const showSection = (id: string) => selectedSection !== id ? 'am-section-hidden' : '';
const customCommandLimit = planLimits(premiumActive).customCommands;
const customCommandAtLimit = customCommands.length >= customCommandLimit;
const responderLimit = planLimits(premiumActive).autoResponders;
const timerUnitLabel: Record<string, string> = { seconds: dt('Seconds'), minutes: dt('Minutes'), hours: dt('Hours'), days: dt('Days'), weeks: dt('Weeks'), months: dt('Months'), years: dt('Years') };
const timerUnitOne: Record<string, string> = { seconds: dt('1 second'), minutes: dt('1 minute'), hours: dt('1 hour'), days: dt('1 day'), weeks: dt('1 week'), months: dt('1 month'), years: dt('1 year') };
const intervalText = (ms: number) => formatDuration(ms / 1000, { locale: dashLocale(dashLang), max: 'y' });
// Timers at a time of day: the text of the schedule, the weekdays (Monday first) and the time zones of the zone field.
const timerWhen = (t: AutoTimer) => t.schedule === 'daily' ? dt('Every day at {a} ({b})', { a: t.atTime ?? '', b: t.timezone ?? 'UTC' }) : t.schedule === 'weekly' ? dt('Every {a} at {b} ({c})', { a: weekdayName(Number(t.weekday ?? 0), dashLang), b: t.atTime ?? '', c: t.timezone ?? 'UTC' }) : intervalText(t.intervalMs);
const timerWeekdays = [1, 2, 3, 4, 5, 6, 0].map((day) => ({ day, name: weekdayName(day, dashLang) }));
const timerZones = selectedSection === 'timers' ? timeZoneList() : [];
const timerNextText = (iso: string) => { const at = Date.parse(iso); return Number.isFinite(at) ? new Date(at).toISOString().replace('T', ' ').slice(0, 16) + ' UTC' : ''; };
// The hub, aliases, webhooks, reaction triggers, message reactions and timers (the ax2- parts of this file).
const { overview = null } = Astro.props;
const ax2Locale = dashLocale(dashLang);
// How long until a moment, in the short text of the dashboard ("in 2h 15m"); a moment that has passed (or is about to) says it is due.
const ax2In = (iso: string | null | undefined) => { const at = iso ? Date.parse(iso) : NaN; if (!Number.isFinite(at)) return '—'; const seconds = (at - Date.now()) / 1000; return seconds < 45 ? dt('Due now') : dt('in {a}', { a: formatDuration(seconds, { locale: ax2Locale }) }); };
const ax2NextTimer = timers.filter((t) => !t.paused && t.nextRunAt).map((t) => t.nextRunAt).sort((a, b) => Date.parse(a) - Date.parse(b))[0] ?? null;
const ax2Repeats: [string, string][] = [['interval', dt('Every interval')], ['daily', dt('Every day')], ['weekly', dt('Every week')]];
const ax2Modes: [string, string][] = [['contains', dt('contains')], ['startsWith', dt('starts with')], ['endsWith', dt('ends with')], ['exact', dt('exact')]];
// An emoji as the dashboard saves it: a custom one is `<:name:id>` (drawn as its picture), anything else is the character itself.
const ax2Emoji = (value: string) => { const m = /^<(a?):(\w+):(\d+)>$/.exec(value ?? ''); return m ? { src: `https://cdn.discordapp.com/emojis/${m[3]}.${m[1] ? 'gif' : 'png'}?size=48`, text: `:${m[2]}:` } : { src: '', text: value ?? '' }; };
// The features of the hub, in the order of the side menu: its link, how many it has (or whether it is on), and its look.
const ax2Hub = () => {
  const n = (id: string) => overview?.counts[id] ?? null;
  const boardCounts = ['starboard', 'monkeyboard', 'clownboard'].map(n);
  const boards = boardCounts.every((c) => c === null) ? null : boardCounts.reduce<number>((sum, c) => sum + (c ?? 0), 0);
  const base = `/dash/guild/${guildId}`;
  const feature = (id: string, href: string, count: number | null, on: boolean | null = null) => ({ id, href, label: sectionMeta[id].label, desc: sectionMeta[id].description, icon: sectionIcons[id], color: sectionColors[id] ?? 'var(--accent)', n: count, on });
  const inSection = (id: string, on: boolean | null = null) => feature(id, `${base}/automation?section=${id}`, n(id), on);
  return [
    inSection('custom-commands'), inSection('autoresponders'), inSection('sticky-messages'), inSection('reaction-roles'), inSection('reaction-messages'), inSection('reaction-triggers'),
    inSection('auto-threads'), inSection('timers'), inSection('aliases'), inSection('disabled-commands'), inSection('webhooks'), feature('counters', `${base}/counters`, n('counters')),
    inSection('voicemaster', overview ? Boolean(overview.on.voicemaster) : null), inSection('sticky-roles', overview ? Boolean(overview.on['sticky-roles']) : null),
    { id: 'boards', href: `${base}/boards`, label: dt('Boards'), desc: dt('Collect the best messages of the server in a channel of their own.'), icon: 'ph:star-fill', color: sectionColors.starboard, n: boards, on: null },
  ];
};
const sectionIcons: Record<string, string> = {
  'custom-commands': 'ph:chat-circle-dots-fill', autoresponders: 'ph:robot-fill', 'sticky-messages': 'ph:push-pin-fill',
  'reaction-roles': 'ph:smiley-fill', 'reaction-triggers': 'ph:smiley-fill', 'reaction-messages': 'ph:chat-circle-dots-fill',
  'auto-threads': 'ph:chats-circle-fill', 'disabled-commands': 'ph:prohibit-fill', aliases: 'ph:command-fill',
  timers: 'ph:timer-fill', starboard: 'ph:star-fill', monkeyboard: 'ph:smiley-fill', voicemaster: 'ph:speaker-high-fill', webhooks: 'ph:webhooks-logo-fill', counters: 'ph:chart-line-up-fill', 'sticky-roles': 'ph:arrow-counter-clockwise-fill',
};
// The colour of each feature, the same as the icon of its section heading.
const sectionColors: Record<string, string> = {
  'custom-commands': 'var(--accent)', autoresponders: '#c792ea', 'sticky-messages': '#5eead4', 'reaction-roles': '#fed53c', 'reaction-triggers': '#f59e0b',
  'reaction-messages': '#f59e0b', 'auto-threads': '#5b8def', 'disabled-commands': '#fe6465', aliases: '#c792ea', timers: '#5eead4', starboard: '#fed53c',
  monkeyboard: '#c98b4a', voicemaster: 'var(--accent)', webhooks: '#a78bfa', 'sticky-roles': '#5eead4', counters: '#2dd4a7',
};
const ax2Features = selectedSection === 'overview' ? ax2Hub() : [];
const ax2Timers = overview?.timers ?? null;
const ax2InUse = ax2Features.filter((f) => f.on === true || (f.n ?? 0) > 0).length;
const ax2Items = ax2Features.reduce((sum, f) => sum + (f.on === null ? f.n ?? 0 : 0), 0);
// The match modes of an autoresponder, as the select of its form names them, and what each one does (the tooltip of its chip).
const matchLabel: Record<string, string> = { contains: 'contains', startsWith: dt('starts with'), endsWith: dt('ends with'), exact: 'exact', regex: 'regex' };
const matchHelp: Record<string, string> = {
  contains: dt('Replies when the trigger appears anywhere in the message.'),
  startsWith: dt('Replies when the message starts with the trigger.'),
  endsWith: dt('Replies when the message ends with the trigger.'),
  exact: dt('Replies only when the whole message is the trigger.'),
  regex: dt('Replies when the message matches this regular expression.'),
};
// The tiles above the disabled commands: every category of the commands page (static), how many commands it has and how many of them
// are turned off somewhere in this server (from the rules the page already has).
const dcCategoryIcons: Record<string, string> = {
  moderation: 'ph:shield-check-fill', tickets: 'ph:ticket', leveling: 'ph:chart-line-up-fill', giveaways: 'ph:gift-fill', automation: 'ph:robot-fill',
  community: 'ph:users-three-fill', onboarding: 'ph:hand-waving-fill', logging: 'ph:notebook-fill', info: 'ph:info-fill', setup: 'ph:gear-fill', roleplay: 'ph:heart-fill',
};
const dcCategoryOf = new Map<string, string>();
// With no rule there is nothing to filter: the tiles are only information then.
const DcTile = disabledCommands.length ? 'button' : 'div';
const dcCategories = selectedSection !== 'disabled-commands' ? [] : (() => {
  const all = getAllCommands();
  for (const c of all) dcCategoryOf.set(c.name.toLowerCase(), c.category);
  const offNames = new Set(disabledCommands.map((d) => d.command.toLowerCase()));
  return useTranslations(dashLang).commandsPage.categories.map((cat) => {
    const names = all.filter((c) => c.category === cat.id).map((c) => c.name.toLowerCase());
    return { id: cat.id, title: cat.title, icon: dcCategoryIcons[cat.id] ?? 'ph:squares-four-fill', total: names.length, off: names.filter((n) => offNames.has(n)).length };
  }).filter((c) => c.total > 0);
})();
// The sections with message fields get the data of the typed autocomplete.
const withMessages = ['webhooks', 'timers', 'custom-commands', 'autoresponders', 'sticky-messages', 'auto-threads'].includes(selectedSection);
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'overview' ? 'automation-overview' : selectedSection} pageTitle={selectedMeta.label}>
  <DashSettingsKit />
  <DashFormKit />
  <div class="am-heading">
    <h1>{selectedMeta.label}</h1>
    {selectedSection !== 'overview' && <a class="am-overview-link" href={`/dash/guild/${guildId}/automation?section=overview`}><Icon name="ph:squares-four-fill" width="14" height="14" />{dt('Automation overview')}</a>}
  </div>

  {withMessages && <DashAcData roles={roles} channels={channels} emojis={customEmojis} />}
  {saved && <div class="am-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {notice && <div class="am-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{notice}</div>}
  {error && <div class="am-error"><Icon name="ph:warning-fill" width="13" height="13" />{error}</div>}

  {selectedSection === 'overview' && (
  <div class="ax2-page" data-section="overview">
    <DashStatTiles tiles={[
      { label: dt('Features in use'), value: ax2InUse, tone: 'joins' },
      { label: dt('Items set up'), value: ax2Items, tone: 'invites' },
      { label: dt('Timers running'), value: ax2Timers?.running ?? 0, text: ax2Timers ? undefined : '—', tone: 'voice' },
      { label: dt('Next timer'), value: 0, text: ax2Timers?.nextRunAt ? ax2In(ax2Timers.nextRunAt) : '—', tone: 'reactions' },
    ]} />
    <div class="ax2-head">
      <h2>{dt('Features')} <span class="ax2-count">{ax2Features.length}</span></h2>
      <p>{sectionMeta.overview.description}</p>
    </div>
    <div class="ax2-hub dgl-stagger">
      {ax2Features.map((f) => (
        <a class="ax2-feat" style={`--c:${f.color}`} href={f.href} title={f.desc}>
          <span class="ax2-feat-ico"><Icon name={f.icon} width="18" height="18" /></span>
          <span class="ax2-feat-text"><b>{f.label}</b></span>
          {f.on !== null
            ? <span class:list={['ax2-feat-n', f.on ? 'is-on' : 'is-zero']}>{f.on ? dt('On') : dt('Off')}</span>
            : <span class:list={['ax2-feat-n', { 'is-zero': !f.n }]}>{f.n === null ? '—' : f.n.toLocaleString(ax2Locale)}</span>}
        </a>
      ))}
    </div>
  </div>
  )}

  {selectedSection === 'aliases' && (
  <div class="ax2-page" data-section="aliases">
    <DashStatTiles tiles={[
      { label: dt('Aliases'), value: aliases.length, tone: 'invites' },
      { label: dt('With arguments'), value: aliases.filter((a) => /\{\d+\}/.test(a.command)).length, tone: 'voice' },
      { label: dt('Prefix'), value: 0, text: prefix, tone: 'reactions' },
    ]} />
    <div class="ax2-head">
      <h2>{dt('Command aliases')} <span class="ax2-count">{aliases.length}</span></h2>
      <p><Fragment set:html={dth('Aliases are prefix-only. Use <code>{a}</code>, <code>{b}</code>, and so on for typed arguments.', { a: ('{0}'), b: ('{1}') })} /></p>
    </div>
    {aliases.length === 0 && <p class="ax2-empty"><Icon name="ph:command-fill" width="18" height="18" />{dt('Nothing here yet. Add the first one below.')}</p>}
    <div class="ax2-list ax2-duo dgl-stagger">
      {aliases.map((a) => (
        <details class="ax2-item" style="--c:#c792ea">
          <summary class="ax2-sum">
            <span class="ax2-ico"><Icon name="ph:command-fill" width="16" height="16" /></span>
            <span class="ax2-main"><code class="ax2-key">{prefix}{a.name}</code><span class="ax2-val" title={a.command}>{a.command}</span></span>
            <span class="ax2-acts"><span class="ax2-act" aria-hidden="true"><Icon name="ph:pencil-simple-fill" width="12" height="12" /><span class="ax2-t-edit">{dt('Edit')}</span><span class="ax2-t-close">{dt('Close')}</span></span><button type="submit" form={`am-del-alias-${a.id}`} class="ax2-del" title={dt('Delete')} aria-label={dt('Delete')} data-confirm={dt('Delete this? This cannot be undone.')}><Icon name="ph:trash-fill" width="15" height="15" /></button></span>
          </summary>
          <form method="POST" class="ax2-edit">
            <input type="hidden" name="action" value="add_alias" /><input type="hidden" name="name" value={a.name} />
            <div class="sx-field"><label for={`ax2-alias-cmd-${a.id}`}>{dt('Target command')}</label><textarea id={`ax2-alias-cmd-${a.id}`} name="command" class="dgl-autogrow sx-one" rows="1" data-one-line data-count maxlength="500" required>{a.command}</textarea></div>
            <div class="ax2-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:check-bold" width="12" height="12" />{dt('Save')}</button></div>
          </form>
          <form method="POST" id={`am-del-alias-${a.id}`} data-no-dirty hidden><input type="hidden" name="action" value="delete_alias" /><input type="hidden" name="name" value={a.name} /></form>
        </details>
      ))}
    </div>
    <form method="POST" class="ax2-add" data-no-dirty>
      <input type="hidden" name="action" value="add_alias" />
      <div class="ax2-add-title"><Icon name="ph:plus-circle-fill" width="16" height="16" />{dt('Add an alias')}</div>
      <div class="sx-grid ax2-grid-narrow">
        <div class="sx-field"><label for="ax2-alias-name">{dt('Shortcut')}</label><input id="ax2-alias-name" type="text" name="name" maxlength="32" required data-count placeholder="w" /></div>
        <div class="sx-field"><label for="ax2-alias-command">{dt('Target command')}</label><textarea id="ax2-alias-command" name="command" class="dgl-autogrow sx-one" rows="1" data-one-line data-count maxlength="500" required placeholder={dt('Target command, e.g. warn {0} repeated spam')}></textarea></div>
      </div>
      <div class="ax2-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button></div>
    </form>
  </div>
  )}

  {selectedSection === 'webhooks' && (
  <div class:list={['am-section', showSection('webhooks')]} data-section="webhooks">
    <h2><span class="am-h2-icon" style="--c:#a78bfa"><Icon name="ph:webhooks-logo-fill" width="14" height="14" /></span><Fragment set:html={dth('Managed webhooks <span class="am-count">{a}</span>', { a: (managedWebhooks.length) })} /></h2>
    <p class="am-hint am-section-intro">{dt('Create webhooks, send custom messages, and override their username or avatar without exposing webhook tokens in the dashboard.')}</p>
    {managedWebhooks.length === 0 && <p class="am-empty"><Icon name="ph:sparkle" width="15" height="15" />{dt('Nothing here yet. Add the first one below.')}</p>}
    <div class="am-list dgl-stagger">
      {managedWebhooks.map((w) => (
        <details class="am-ar am-card dgl-rc">
          <summary class="am-card-sum"><span class="am-card-head"><span class="am-card-main"><span class="am-card-title" title={w.webhookId}>{w.name}</span><span class="am-row-mode">{w.enabled ? 'enabled' : 'disabled'}</span></span><span class="am-card-acts"><span class="am-act" aria-hidden="true"><Icon name="ph:pencil-simple-fill" width="12" height="12" /><span class="am-act-t"><span class="am-t-edit">{dt('Edit')}</span><span class="am-t-close">{dt('Close')}</span></span></span><button type="submit" form={`am-del-webhook-${w.id}`} class="am-act am-act-del" title={dt('Delete')} aria-label={dt('Delete')} data-confirm={dt('Delete this? This cannot be undone.')}><Icon name="ph:trash-fill" width="12" height="12" /></button></span></span><span class="am-row-val">#{channelName(w.channelId)}{w.defaultMessage ? ` · ${w.defaultMessage}` : ''}</span></summary>
          <form method="POST" class="am-add am-add-wide am-ar-edit"><input type="hidden" name="action" value="edit_webhook" /><input type="hidden" name="id" value={w.id} /><div class="am-add-row"><input type="text" name="name" value={w.name} maxlength="80" required /><input type="text" name="default_username" value={w.defaultUsername ?? ''} placeholder={dt('Default username')} maxlength="80" /><input type="url" name="default_avatar_url" value={w.defaultAvatarUrl ?? ''} placeholder={dt('Default avatar URL')} /></div><textarea name="default_message" data-ac maxlength="2000" placeholder={dt('Default message template')}>{w.defaultMessage ?? ''}</textarea><SilentMentionHint /><label class="am-check"><input type="checkbox" name="enabled" checked={w.enabled} />{dt('Enabled')}</label><div class="am-feature-actions"><button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:check-bold" width="12" height="12" />{dt('Save webhook')}</button></div></form>
          <div class="am-feature-actions"><form method="POST"><input type="hidden" name="action" value="duplicate_webhook" /><input type="hidden" name="id" value={w.id} /><button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:copy-bold" width="12" height="12" />{dt('Duplicate')}</button></form><form method="POST" id={`am-del-webhook-${w.id}`} data-no-dirty><input type="hidden" name="action" value="delete_webhook" /><input type="hidden" name="id" value={w.id} /></form></div>
        </details>
      ))}
    </div>
    <form method="POST" class="am-add am-webhook-add" data-no-dirty>
      <input type="hidden" name="action" value="create_webhook" /><select name="channel_id" required><option value="" disabled selected>{dt('Channel')}</option>{channels.map((c) => <option value={c.id}>#{c.name}</option>)}</select><input type="text" name="name" placeholder={dt('Webhook name')} maxlength="80" required /><input type="text" name="default_username" placeholder={dt('Default username')} maxlength="80" /><input type="url" name="default_avatar_url" placeholder={dt('Default avatar URL')} /><button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Create')}</button>
    </form>
    {managedWebhooks.length > 0 && (
      <form method="POST" class="am-add am-add-wide am-send" data-no-dirty>
        <input type="hidden" name="action" value="send_webhook" />
        <div class="am-send-head"><Icon name="ph:paper-plane-tilt-fill" width="14" height="14" /><strong>{dt('Send a message')}</strong></div>
        <select name="webhook_id" required><option value="" disabled selected>{dt('Webhook')}</option>{managedWebhooks.map((w) => <option value={w.id}>{w.name} · #{channelName(w.channelId)}</option>)}</select>
        <div class="am-send-modes" role="tablist">
          <label><input type="radio" name="send_mode" value="text" checked /><span>{dt('Text and embed')}</span></label>
          <label><input type="radio" name="send_mode" value="design" /><span>{dt('Saved design')}</span></label>
          <label><input type="radio" name="send_mode" value="edit" /><span>{dt('Edit a sent message')}</span></label>
        </div>
        <div class="am-send-pane" data-send-pane="text">
          <div class="am-group">
            <span class="am-group-title"><Icon name="ph:chat-text-fill" width="13" height="13" />{dt('Message')}</span>
            <textarea name="message" data-ac placeholder={dt('Message (empty uses the default)')} maxlength="2000" data-lm-source="wh-message"></textarea><SilentMentionHint />
            <LiveTextPreview id="wh-message" label={dt('Preview')} />
            <p class="am-hint">{dt('Works: **bold**, *italic*, __underline__, ~~strike~~, `code`, > quote, and a command as')} <code>{'</bump:123456789>'}</code></p>
          </div>
          <div class="am-group">
            <span class="am-group-title"><Icon name="ph:user-circle-fill" width="13" height="13" />{dt('Sender')}</span>
            <div class="am-add-row"><input type="text" name="username" placeholder={dt('Username override')} maxlength="80" /><input type="url" name="avatar_url" placeholder={dt('Avatar URL override')} /></div>
          </div>
          <details class="am-group am-group-embed">
            <summary class="am-group-title"><Icon name="ph:browser-fill" width="13" height="13" />{dt('Embed (optional)')}</summary>
            <div class="am-add-row"><input type="text" name="embed_title" data-ac placeholder={dt('Embed title')} maxlength="256" /><ColorPicker name="embed_color" value="#8399ff" label={dt('Embed color')} allowNone /></div>
            <textarea name="embed_description" data-ac placeholder={dt('Embed description')} maxlength="4096" data-lm-source="wh-embed"></textarea>
            <LiveTextPreview id="wh-embed" label={dt('Preview')} />
            <div class="am-add-row"><input type="url" name="embed_image" placeholder={dt('Embed image URL')} /><input type="url" name="embed_thumbnail" placeholder={dt('Embed thumbnail URL')} /></div>
            <div class="am-add-row"><input type="text" name="embed_footer" data-ac placeholder={dt('Embed footer')} maxlength="2048" /><input type="url" name="embed_url" placeholder={dt('Embed title link')} /></div>
          </details>
        </div>
        <div class="am-send-pane" data-send-pane="design" hidden>
          <select name="send_design"><option value="">{dt('Pick a saved design')}</option>{embedTemplateNames.map((name) => <option value={name}>{name}</option>)}</select>
          <p class="am-hint">{dt('Sends a design from the Embeds page, with its variables filled in. Components V2 designs work too.')}</p>
        </div>
        <div class="am-send-pane" data-send-pane="edit" hidden>
          <input type="text" name="edit_message_id" placeholder={dt('ID of a message this webhook sent')} inputmode="numeric" pattern="[0-9]{15,22}" />
          <p class="am-hint">{dt('Fill the text or pick a design above and the message is changed in place instead of sending a new one.')}</p>
        </div>
        <details class="am-send-more">
          <summary>{dt('More options')}</summary>
          <div class="am-add-row"><input type="text" name="thread_id" placeholder={dt('Send into a thread (thread ID)')} inputmode="numeric" pattern="[0-9]{15,22}" /><input type="text" name="thread_name" placeholder={dt('Or start a forum post with this title')} maxlength="100" /></div>
          <div class="am-send-checks">
            <label class="am-check"><input type="checkbox" name="silent" />{dt('Send without a notification (silent)')}</label>
            <label class="am-check"><input type="checkbox" name="allow_pings" />{dt('Allow @everyone, roles and members to be pinged')}</label>
          </div>
        </details>
        <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:paper-plane-tilt-fill" width="12" height="12" />{dt('Send')}</button>
      </form>
    )}
    <script is:inline>
      (function () {
        document.querySelectorAll('.am-send').forEach(function (form) {
          if (form.dataset.sendBound) return;
          form.dataset.sendBound = '1';
          function sync() {
            var mode = (form.querySelector('input[name="send_mode"]:checked') || {}).value || 'text';
            form.querySelectorAll('[data-send-pane]').forEach(function (pane) {
              var name = pane.getAttribute('data-send-pane');
              // The text fields stay visible while editing: an edit can change the text as well as the design.
              pane.hidden = !(name === mode || (mode === 'edit' && name === 'text'));
            });
            var design = form.querySelector('[data-send-pane="design"]');
            if (design && mode === 'edit') design.hidden = false;
            var editPane = form.querySelector('[data-send-pane="edit"]');
            if (editPane) editPane.hidden = mode !== 'edit';
            var id = form.querySelector('[name="edit_message_id"]');
            if (id) id.required = mode === 'edit';
          }
          form.querySelectorAll('input[name="send_mode"]').forEach(function (r) { r.addEventListener('change', sync); });
          sync();
        });
      })();
    </script>
  </div>
  )}

  {selectedSection === 'sticky-roles' && (
  <div class="vmx-page" data-section="sticky-roles">
    <DashStatTiles tiles={[
      { label: dt('Sticky roles'), value: 0, text: stickyRolesEnabled ? dt('On') : dt('Off'), tone: stickyRolesEnabled ? 'joins' : 'leaves' },
      stickyRolesSaved >= 1000 ? { label: dt('Members waiting'), value: 0, text: '1000+', tone: 'invites' } : { label: dt('Members waiting'), value: stickyRolesSaved, tone: 'invites' },
    ]} />
    <div class="sx-duo vmx-duo">
      <div class="vmx-col">
        <form method="POST" class="sx-panel">
          <input type="hidden" name="action" value="save_sticky_roles" />
          <div class="sx-panel-head">
            <span class="sx-panel-icon" style="--c:#5eead4"><Icon name="ph:arrow-counter-clockwise-fill" width="17" height="17" /></span>
            <h2>{dt('Sticky roles')}</h2>
          </div>
          <p class="sx-lead">{dt('When this is on, Petto remembers the roles of a member who leaves and gives them back once if the member returns.')}</p>
          <label class="sx-switch sx-master"><input type="checkbox" name="enabled" checked={stickyRolesEnabled} /><span class="sx-switch-text"><b>{dt('Give back the roles of members who return')}</b></span><span class="sx-toggle"></span></label>
          <div class="sx-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:check-bold" width="12" height="12" />{dt('Save')}</button></div>
        </form>
        <div class="sx-panel">
          <div class="sx-panel-head">
            <span class="sx-panel-icon"><Icon name="ph:list-checks-fill" width="17" height="17" /></span>
            <h2>{dt('How it works')}</h2>
          </div>
          <ol class="vmx-steps">
            <li><span class="vmx-step-n">1</span><span><b>{dt('A member leaves the server')}</b><em>{dt('Petto remembers the roles they had.')}</em></span></li>
            <li><span class="vmx-step-n">2</span><span><b>{dt('The member comes back')}</b><em>{dt('Petto gives those roles back, once.')}</em></span></li>
            <li><span class="vmx-step-n">3</span><span><b>{dt('Members waiting')}</b><em>{dt('The ones who left and have not come back yet are listed here.')}</em></span></li>
          </ol>
        </div>
      </div>
      <div class="sx-panel">
        <div class="sx-panel-head">
          <span class="sx-panel-icon"><Icon name="ph:users-three-fill" width="17" height="17" /></span>
          <h2>{dt('Waiting for their roles')}</h2>
          <span class="vmx-count">{stickyRolesSaved >= 1000 ? '1000+' : stickyRolesSaved}</span>
        </div>
        {stickyRolesWaiting.length === 0 ? (
          <div class="vmx-empty">
            <Icon name="ph:users-three-fill" width="28" height="28" />
            <b>{dt('Nobody is waiting right now.')}</b>
            <p>{dt('When a member leaves, they show up here until they come back.')}</p>
          </div>
        ) : (
          <div class="vmx-people">
            {stickyRolesWaiting.map((member) => (
              <div class="vmx-person">
                <img src={member.avatar} alt="" width="34" height="34" loading="lazy" referrerpolicy="no-referrer" />
                <span><b>{member.name ?? member.id}</b><code>{member.id}</code></span>
              </div>
            ))}
            {stickyRolesSaved > stickyRolesWaiting.length && <p class="sx-hint">{dt('And {n} more.', { n: stickyRolesSaved >= 1000 ? '1000+' : stickyRolesSaved - stickyRolesWaiting.length })}</p>}
          </div>
        )}
      </div>
    </div>
  </div>
  )}

  {selectedSection === 'reaction-triggers' && (
  <div class:list={['am-section', showSection('reaction-triggers')]} data-section="reaction-triggers">
    <h2><span class="am-h2-icon" style="--c:#f59e0b"><Icon name="ph:smiley-fill" width="14" height="14" /></span><Fragment set:html={dth('Reaction triggers <span class="am-count">{a}</span>', { a: (reactionTriggers.length) })} /></h2>
    <p class="am-hint am-section-intro">{dt('React automatically when a message contains a configured word or phrase. Specific triggers are required so busy servers stay fast.')}</p>
    {reactionTriggers.length === 0 && <p class="am-empty"><Icon name="ph:sparkle" width="15" height="15" />{dt('Nothing here yet. Add the first one below.')}</p>}
    <div class="am-list dgl-stagger">
      {reactionTriggers.map((r) => (
        <details class="am-ar am-card dgl-rc">
          <summary class="am-card-sum"><span class="am-card-head"><span class="am-card-main"><span class="am-row-key">{r.emoji}</span><code class="am-card-title">{r.trigger}</code><span class="am-row-mode">{r.matchMode}</span><span class="am-row-mode">{r.enabled ? 'enabled' : 'disabled'}</span></span><span class="am-card-acts"><span class="am-act" aria-hidden="true"><Icon name="ph:pencil-simple-fill" width="12" height="12" /><span class="am-act-t"><span class="am-t-edit">{dt('Edit')}</span><span class="am-t-close">{dt('Close')}</span></span></span><button type="submit" form={`am-del-trigger-${r.id}`} class="am-act am-act-del" title={dt('Delete trigger')} aria-label={dt('Delete trigger')} data-confirm={dt('Delete this? This cannot be undone.')}><Icon name="ph:trash-fill" width="12" height="12" /></button></span></span><span class="am-row-val">{dt('{a} · {b} cooldown', { a: (r.channelIds.length ? `${r.channelIds.length} channels` : 'all channels'), b: formatDuration(r.cooldownSeconds, { locale: dashLocale(dashLang) }) })}</span></summary>
          <form method="POST" class="am-add am-add-wide am-ar-edit">
            <input type="hidden" name="action" value="edit_reaction_trigger" /><input type="hidden" name="id" value={r.id} />
            <div class="am-add-row"><select name="match_mode"><option value="contains" selected={r.matchMode === 'contains'}>contains</option><option value="startsWith" selected={r.matchMode === 'startsWith'}>{dt('starts with')}</option><option value="endsWith" selected={r.matchMode === 'endsWith'}>{dt('ends with')}</option><option value="exact" selected={r.matchMode === 'exact'}>exact</option></select><input type="number" name="cooldown_seconds" min="0" max="86400" value={r.cooldownSeconds} placeholder={dt('Cooldown seconds')} /></div>
            <label class="am-check"><input type="checkbox" name="case_sensitive" checked={r.caseSensitive} />{dt('Case-sensitive matching')}</label><label class="am-check"><input type="checkbox" name="enabled" checked={r.enabled} />{dt('Enabled')}</label>
            <div class="am-channel-scope"><span class="am-channel-scope-label">{dt('Only in these channels')}</span><MultiSelect name="trigger_channel_ids" options={channelOptions} source="am-channels" selected={r.channelIds} placeholder={dt('All channels')} /></div>
            <div class="am-channel-scope"><span class="am-channel-scope-label">{dt('Only for members with these roles')}</span><MultiSelect name="trigger_role_ids" options={roleOptions} source="am-roles" selected={r.roleIds} placeholder={dt('Everyone')} /></div>
            <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:check-bold" width="12" height="12" />{dt('Save trigger')}</button>
          </form>
          <form method="POST" class="am-ar-delete" id={`am-del-trigger-${r.id}`} data-no-dirty><input type="hidden" name="action" value="delete_reaction_trigger" /><input type="hidden" name="id" value={r.id} /></form>
        </details>
      ))}
    </div>
    <form method="POST" class="am-add am-add-wide" data-no-dirty>
      <input type="hidden" name="action" value="add_reaction_trigger" />
      <div class="am-add-row"><input type="text" name="emoji" data-emoji-input placeholder={dt('Emoji')} maxlength="100" required /><input type="text" name="trigger" placeholder={dt('Word or phrase')} maxlength="80" required /><select name="match_mode"><option value="contains">contains</option><option value="startsWith">{dt('starts with')}</option><option value="endsWith">{dt('ends with')}</option><option value="exact">exact</option></select><input type="number" name="cooldown_seconds" min="0" max="86400" value="0" placeholder={dt('Cooldown seconds')} /></div>
      <label class="am-check"><input type="checkbox" name="case_sensitive" />{dt('Case-sensitive matching')}</label>
      <div class="am-channel-scope"><span class="am-channel-scope-label">{dt('Only in these channels')}</span><MultiSelect name="trigger_channel_ids" options={channelOptions} source="am-channels" selected={[]} placeholder={dt('All channels')} /></div>
      <div class="am-channel-scope"><span class="am-channel-scope-label">{dt('Only for members with these roles')}</span><MultiSelect name="trigger_role_ids" options={roleOptions} source="am-roles" selected={[]} placeholder={dt('Everyone')} /></div>
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add trigger')}</button>
    </form>
    <div class="am-feature-actions">
      <form method="POST" data-no-dirty><input type="hidden" name="action" value="reset_reaction_triggers" /><button type="submit" class="am-del-text" data-confirm={dt('Delete this? This cannot be undone.')}><Icon name="ph:trash-fill" width="12" height="12" />{dt('Remove all triggers')}</button></form>
    </div>
  </div>
  )}

  {selectedSection === 'reaction-messages' && (
  <div class:list={['am-section', showSection('reaction-messages')]} data-section="reaction-messages">
    <h2><span class="am-h2-icon" style="--c:#f59e0b"><Icon name="ph:chat-circle-dots-fill" width="14" height="14" /></span><Fragment set:html={dth('React to every message <span class="am-count">{a}</span>', { a: (reactionMessages.length) })} /></h2>
    <p class="am-hint am-section-intro">{dt('Add up to five emojis to every new message in a channel, announcement channels included (posts from followed channels and webhooks get them too). Save the channel with no emojis to disable it.')}</p>
    {reactionMessages.length === 0 && <p class="am-empty"><Icon name="ph:sparkle" width="15" height="15" />{dt('Nothing here yet. Add the first one below.')}</p>}
    <div class="am-list dgl-stagger">
      {reactionMessages.map((r) => (
        <details class="am-ar am-card dgl-rc">
          <summary class="am-card-sum"><span class="am-card-head"><span class="am-card-main"><span class="am-row-key">{newsChannelIds.has(r.channelId) ? <Icon name="ph:megaphone-fill" width="13" height="13" class="am-news-icon" /> : '#'}{channelName(r.channelId)}</span><span class="am-row-mode">{r.emojis.length}/5</span></span><span class="am-card-acts"><span class="am-act" aria-hidden="true"><Icon name="ph:pencil-simple-fill" width="12" height="12" /><span class="am-act-t"><span class="am-t-edit">{dt('Edit')}</span><span class="am-t-close">{dt('Close')}</span></span></span><button type="submit" form={`am-del-react-${r.id}`} class="am-act am-act-del" title={dt('Remove channel')} aria-label={dt('Remove channel')} data-confirm={dt('Delete this? This cannot be undone.')}><Icon name="ph:trash-fill" width="12" height="12" /></button></span></span><span class="am-row-val am-row-emojis">{r.emojis.join(' ')}</span></summary>
          <form method="POST" class="am-add am-add-wide am-ar-edit">
            <input type="hidden" name="action" value="save_reaction_messages" /><input type="hidden" name="channel_id" value={r.channelId} />
            <div class="am-add-row">{[0, 1, 2, 3, 4].map((n) => <input type="text" name="emojis" data-emoji-input placeholder={n === 0 ? dt('Emoji 1') : dt('Emoji {a} (optional)', { a: n + 1 })} maxlength="100" value={r.emojis[n] ?? ''} required={n === 0} />)}</div>
            <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:check-bold" width="12" height="12" />{dt('Save channel')}</button>
          </form>
          <form method="POST" class="am-ar-delete" id={`am-del-react-${r.id}`} data-no-dirty><input type="hidden" name="action" value="delete_reaction_messages" /><input type="hidden" name="channel_id" value={r.channelId} /></form>
        </details>
      ))}
    </div>
    <form method="POST" class="am-add am-add-wide" data-no-dirty>
      <input type="hidden" name="action" value="save_reaction_messages" />
      <div class="am-add-row"><select name="channel_id" required><option value="" disabled selected>{dt('Channel')}</option>{channels.map((c) => <option value={c.id}>#{c.name}{c.type === 5 ? ' · ' + dt('Announcement channel') : ''}</option>)}</select>{[0, 1, 2, 3, 4].map((n) => <input type="text" name="emojis" data-emoji-input placeholder={n === 0 ? dt('Emoji 1') : dt('Emoji {a} (optional)', { a: n + 1 })} maxlength="100" required={n === 0} />)}</div>
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:check-bold" width="12" height="12" />{dt('Save channel')}</button>
    </form>
  </div>
  )}

  {selectedSection === 'timers' && (
  <div class:list={['am-section', showSection('timers')]} data-section="timers">
    <h2><span class="am-h2-icon" style="--c:#5eead4"><Icon name="ph:timer-fill" width="14" height="14" /></span><Fragment set:html={dth('Repeating timers <span class="am-count">{a}</span>', { a: (timers.length) })} /></h2>
    {timers.length === 0 && <p class="am-empty"><Icon name="ph:sparkle" width="15" height="15" />{dt('Nothing here yet. Add the first one below.')}</p>}
    <div class="am-list dgl-stagger">
      {timers.map((t) => (
        <details class="am-ar am-card dgl-rc">
