---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { useTranslations, localePath, type Locale } from '../i18n/ui';
import { renderSyntax } from '../utils/syntax';
import generated from '../data/commands.generated.json';

interface Props {
  lang: Locale;
}
// A category of the page: the ones of the bot, and the sections of each service of the Integrations (which have an icon, examples and a group).
interface Cat { id: string; title: string; desc?: string; group?: string; icon?: string; tryLabel?: string; examples?: string[]; cmds: readonly (readonly [string, string, string] | readonly [string, string, string, string[]])[] }
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = t.commandsPage;
const base = localePath[lang];
const prefixNote = lang === 'es'
  ? 'Casi todos los comandos se ejecutan con el prefijo configurable del servidor (por defecto !) y muchos también como comandos slash (/). Usa el interruptor para ver cada forma.'
  : lang === 'pt-BR'
    ? 'Quase todos os comandos usam o prefixo configurável do servidor (por padrão !) e muitos também como comandos slash (/). Use o seletor para ver cada forma.'
    : 'Almost every command works with the server’s configurable prefix (default !), and many also as slash commands (/). Use the switch to see each way.';

// The public catalogue used to contain legacy slash-style examples. Keep the
// source translations readable while guaranteeing the rendered reference uses
// the real prefix syntax Petto accepts.
// `/action` is the exception: it is a real slash command (every interaction action is one of its subcommands), shown as it is typed.
function prefixSyntax(value: string) {
  return value.replace(/(^|\s)\/(?!act\b)(?=[a-z])/g, '$1!');
}

const ui = lang === 'es'
  ? { copy: 'Copiar comando', copied: 'Copiado', top: 'Volver arriba', commands: 'comandos', also: 'También:', slash: 'Slash', prefix: 'Prefijo', mode: 'Cómo se escribe', searchN: 'Buscar {n} comandos', example: 'Ejemplo', details: 'Ver ejemplo y alias', categories: 'Categorías', pick: 'Elegir categoría', close: 'Cerrar', link: 'Copiar enlace' }
  : lang === 'pt-BR'
    ? { copy: 'Copiar comando', copied: 'Copiado', top: 'Voltar ao topo', commands: 'comandos', also: 'Também:', slash: 'Slash', prefix: 'Prefixo', mode: 'Como se escreve', searchN: 'Buscar {n} comandos', example: 'Exemplo', details: 'Ver exemplo e aliases', categories: 'Categorias', pick: 'Escolher categoria', close: 'Fechar', link: 'Copiar link' }
    : { copy: 'Copy command', copied: 'Copied', top: 'Back to top', commands: 'commands', also: 'Also:', slash: 'Slash', prefix: 'Prefix', mode: 'How it is typed', searchN: 'Search {n} commands', example: 'Example', details: 'Show example and aliases', categories: 'Categories', pick: 'Choose a category', close: 'Close', link: 'Copy link' };

// A row is typed with the prefix (`!ban user`) and, when the command is also registered with Discord, with a slash (`/ban user`): the page shows
// either one (the switch above the search). The slash form comes from the row itself: a syntax that starts with `/`, or the `/...` entry of "Also"
// (`/action love hug`) followed by the arguments of the syntax.
// The lookups of the Integrations (`!github user`, `!minecraft skin`...) are the groups of `/search` (`/search github user`): the ones that are one of its groups have a slash form.
const searchGroups = new Set<string>(((generated as { name: string; subcommands?: string[] }[]).find((command) => command.name === 'search')?.subcommands) ?? []);
function slashOf(syntax: string, also: readonly string[] = [], integration = false): string | null {
  if (integration && searchGroups.has(syntax.replace(/^[!/]/, '').split(/\s+/)[0])) return `/search ${syntax.replace(/^[!/]/, '')}`;
  const args = syntax.split(/\s+/).filter((word) => /^[<[]/.test(word)).join(' ');
  const via = also.find((value) => value.startsWith('/'));
  // A form that already has its arguments (`/ban <user> [reason]`: the prefix has more than the slash) is shown as it is.
  if (via && /[<[]/.test(via)) return via;
  if (via) return args ? `${via} ${args}` : via;
  if (syntax.startsWith('/')) return syntax;
  return null;
}
const SAMPLE: Record<string, string> = { user: '@member', member: '@member', target: '@member', role: '@role', channel: '#channel', reason: 'spamming', duration: '1h', time: '10m', amount: '10', count: '10', message: 'hello', text: 'hello', name: 'name', emoji: '🌸', color: '#ff91c2', hex: '#ff91c2', level: '5', xp: '1500', days: '7', id: '123456789012345678', query: 'ticket', code: 'ABC123', prize: 'Nitro', title: 'title', description: 'description' };
// What can be copied and tried: the required arguments (`<user>`) with a believable value, the optional ones (`[reason]`) left out.
function exampleOf(command: string): string {
  return command.split(/\s+/).flatMap((word) => {
    if (word.startsWith('[')) return [];
    const m = /^<([^>|]+)/.exec(word);
    return [m ? (SAMPLE[m[1].toLowerCase()] ?? m[1]) : word];
  }).join(' ');
}

// Every row has an anchor (`#cmd-ticket-close`), so a command can be linked. The name of a row is the whole command (`ticket close`).
const slug = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const usedIds = new Set<string>();
function rowId(name: string) {
  const base = `cmd-${slug(name) || 'command'}`;
  let id = base;
  for (let n = 2; usedIds.has(id); n += 1) id = `${base}-${n}`;
  usedIds.add(id);
  return id;
}

const catIcon: Record<string, string> = {
  moderation: 'ph:shield-check-fill',
  tickets: 'ph:ticket',
  leveling: 'ph:chart-line-up-fill',
  giveaways: 'ph:gift-fill',
  automation: 'ph:robot-fill',
  community: 'ph:users-three-fill',
  onboarding: 'ph:hand-waving-fill',
  logging: 'ph:notebook-fill',
  info: 'ph:info-fill',
  setup: 'ph:gear-fill',
  roleplay: 'ph:heart-fill',
};
---
<Base title={`${t.nav.commands} · ${c.title}`} active="commands" lang={lang} skin="ash">
  <main>
    <section class="cmd-hero">
      <div class="wrap">
        <div class="eyebrow">{c.eyebrow}</div>
        <h1>{c.h1}</h1>
        <p class="lede">{c.lede}</p>
        <p class="prefix-note">{prefixNote}</p>
        <div class="legend">
          {renderSyntax(prefixSyntax(c.syntaxLegend)).map((p) => (
            p.type === 'req' ? <code class="tok-req">{p.text}</code> : p.type === 'opt' ? <code class="tok-opt">{p.text}</code> : <span>{p.text}</span>
          ))}
        </div>

        <div class="resource-grid reveal">
          {c.resources.map((r) => (
            <a class="resource-card" href={r.href.startsWith('http') ? r.href : r.href === '#' ? '#' : `${base}${r.href}`} target={r.href.startsWith('http') ? '_blank' : undefined} rel={r.href.startsWith('http') ? 'noopener' : undefined}>
              <Icon name={r.icon} class="resource-ic" />
              <div class="resource-t">{r.title}</div>
              <p>{r.desc}</p>
            </a>
          ))}
        </div>
        <div class="resource-grid resource-grid-legal reveal">
          {t.footer.legalItems.map((it) => (
            <a class="resource-card resource-card-sm" href={`${base}${it.href}`}>
              <Icon name="ph:scales-fill" class="resource-ic" />
              <div class="resource-t">{it.title}</div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="cmd-body">
      <div class="wrap cmd-layout">
        <aside class="toc" id="cmdToc">
          <div class="mode-switch" role="group" aria-label={ui.mode} id="cmdMode">
            <button type="button" data-mode="slash" aria-pressed="false">{ui.slash}</button>
            <button type="button" data-mode="prefix" aria-pressed="true">{ui.prefix}</button>
          </div>
          <div class="search-box">
            <Icon name="ph:magnifying-glass" width="14" height="14" />
            <input type="search" id="cmdSearch" placeholder={c.searchPlaceholder} data-template={ui.searchN} autocomplete="off" aria-label={c.searchPlaceholder} />
          </div>
          <button type="button" class="cat-picker" id="catPicker" aria-haspopup="dialog" aria-label={ui.pick}>
            <span class="cat-picker-name" id="catPickerName"></span>
            <em id="catPickerCount"></em>
            <Icon name="ph:caret-up-down-bold" width="14" height="14" />
          </button>
          <div class="toc-label">{c.jumpTo}</div>
          <nav class="toc-links" aria-label={c.jumpTo}>
            {(c.categories as unknown as Cat[]).map((cat, index, list) => (
              <>
                {cat.group && cat.group !== list[index - 1]?.group && <div class="toc-group">{cat.group}</div>}
                <a href={`#${cat.id}`} data-toc={cat.id}>
                  <Icon name={cat.icon ?? catIcon[cat.id] ?? 'ph:terminal-window-fill'} class="toc-ic" />
                  <span>{cat.title}</span>
                  <em data-count>{cat.cmds.length}</em>
                </a>
              </>
            ))}
          </nav>
        </aside>

        <div class="cmd-cols">
          {(c.categories as unknown as Cat[]).map((cat) => (
            <div class="cat reveal" id={cat.id} data-cat data-group={cat.group ?? undefined}>
              <h2><Icon name={cat.icon ?? catIcon[cat.id] ?? 'ph:terminal-window-fill'} class="cat-ic" />{cat.title}<span class="cat-count" data-word={ui.commands}>{cat.cmds.length} {ui.commands}</span></h2>
              {cat.desc && <p class="cat-desc">{cat.desc}</p>}
              {cat.examples && (
                <div class="cat-try">
                  <span>{cat.tryLabel}</span>
                  {cat.examples.map((example) => <code>{example}</code>)}
                </div>
              )}
              <div class="cat-list">
                {cat.cmds.map(([name, syntax, desc, also]) => {
                  const id = rowId(name);
                  const slash = slashOf(syntax, also, Boolean(cat.group));
                  const prefixText = prefixSyntax(syntax);
                  const slashText = slash;
                  const example = exampleOf(prefixText);
                  const exampleSlash = slashText ? exampleOf(slashText) : '';
                  return (
                  <div class="cmd-row" id={id} data-cmd={name.split(' ')[0].toLowerCase()} data-name={name.toLowerCase()} data-desc={desc.toLowerCase()} data-also={(also ?? []).join(' | ').toLowerCase()} data-slash={slashText ? '1' : '0'}>
                    <div class="cmd-top">
                      <div class="cmd-syntax syn-prefix">
                        {renderSyntax(prefixText).map((p) => (
                          p.type === 'req' ? <code class="tok-req">{p.text}</code> : p.type === 'opt' ? <code class="tok-opt">{p.text}</code> : <code class="tok-plain">{p.text}</code>
                        ))}
                      </div>
                      {slashText && (
                        <div class="cmd-syntax syn-slash">
                          {renderSyntax(slashText).map((p) => (
                            p.type === 'req' ? <code class="tok-req">{p.text}</code> : p.type === 'opt' ? <code class="tok-opt">{p.text}</code> : <code class="tok-plain">{p.text}</code>
                          ))}
                        </div>
                      )}
                      <button class="cmd-copy" type="button" data-copy={prefixText} data-copy-prefix={prefixText} data-copy-slash={slashText ?? prefixText} data-copied={ui.copied} aria-label={ui.copy} title={ui.copy}>
                        <Icon name="ph:copy-bold" width="14" height="14" />
                      </button>
                      <button class="cmd-expand" type="button" aria-expanded="false" aria-label={ui.details} title={ui.details}>
                        <Icon name="ph:caret-down-bold" width="14" height="14" />
                      </button>
                    </div>
                    <p class="cmd-desc">{desc}</p>
                    <div class="cmd-more">
                      <div class="cmd-example">
                        <span>{ui.example}</span>
                        <code class="ex-prefix">{example}</code>
                        {slashText && <code class="ex-slash">{exampleSlash}</code>}
                        <button class="cmd-copy cmd-copy-ex" type="button" data-copy={example} data-copy-prefix={example} data-copy-slash={exampleSlash || example} data-copied={ui.copied} aria-label={ui.copy} title={ui.copy}><Icon name="ph:copy-bold" width="14" height="14" /></button>
                        <button class="cmd-link" type="button" data-link={`#${id}`} aria-label={ui.link} title={ui.link}><Icon name="ph:link-bold" width="14" height="14" /></button>
                      </div>
                      {also && also.length > 0 && (
                        <p class="cmd-also">{ui.also} {also.map((value) => <code>{value}</code>)}</p>
                      )}
                    </div>
                  </div>
                  );
                })}
              </div>
            </div>
          ))}
          <p class="no-results" id="cmdNoResults" style="display:none;">{c.noResults}</p>
        </div>
      </div>
    </section>
  </main>
  <div class="cat-sheet" id="catSheet" role="dialog" aria-modal="true" aria-label={ui.categories} hidden>
    <div class="cat-sheet-backdrop" data-sheet-close></div>
    <div class="cat-sheet-panel">
      <div class="cat-sheet-head"><b>{ui.categories}</b><button type="button" class="cat-sheet-x" data-sheet-close aria-label={ui.close}><Icon name="ph:x-bold" width="16" height="16" /></button></div>
      <div class="cat-sheet-list">
        {(c.categories as unknown as Cat[]).map((cat, index, list) => (
          <>
            {cat.group && cat.group !== list[index - 1]?.group && <div class="toc-group">{cat.group}</div>}
            <button type="button" data-sheet-cat={cat.id}>
              <Icon name={cat.icon ?? catIcon[cat.id] ?? 'ph:terminal-window-fill'} class="toc-ic" />
              <span>{cat.title}</span>
              <em data-count>{cat.cmds.length}</em>
            </button>
          </>
        ))}
      </div>
    </div>
  </div>
  <button class="cmd-top-btn" id="cmdTop" type="button" aria-label={ui.top} title={ui.top} hidden>
    <Icon name="ph:arrow-up" width="16" height="16" />
  </button>
</Base>

<script>
  const input = document.getElementById('cmdSearch') as HTMLInputElement | null;
  const cols = document.querySelector<HTMLElement>('.cmd-cols');
  const cats = Array.from(document.querySelectorAll<HTMLElement>('[data-cat]'));
  const noResults = document.getElementById('cmdNoResults');
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
  const body = document.querySelector<HTMLElement>('.cmd-body');
  const layout = document.querySelector<HTMLElement>('.cmd-layout');
  const ids = cats.map((cat) => cat.id);

  // Keep the sticky search bar right under the site header, whatever its height is.
  function stickyOffset() {
    const header = document.querySelector('header.nav') as HTMLElement | null;
    const offset = header ? header.getBoundingClientRect().bottom + 8 : 72;
    return Math.max(offset, 8);
  }
  function syncStickyOffset() {
    body?.style.setProperty('--cmd-sticky-top', `${stickyOffset()}px`);
  }
  syncStickyOffset();
  window.addEventListener('resize', syncStickyOffset);

  // One category at a time. Without JavaScript every category stays on the page.
  let current = '';
  function activate(id: string, options: { scroll: boolean; hash: boolean }) {
    if (!ids.includes(id)) id = ids[0];
    current = id;
    cats.forEach((cat) => cat.classList.toggle('active', cat.id === id));
    tocLinks.forEach((link) => {
      const on = link.dataset.toc === id;
      link.classList.toggle('active', on);
      if (on) link.setAttribute('aria-current', 'true'); else link.removeAttribute('aria-current');
    });
    const row = document.querySelector<HTMLElement>('.toc-links');
    const link = tocLinks.find((item) => item.dataset.toc === id);
    if (row && link && row.scrollWidth > row.clientWidth) {
      row.scrollTo({ left: link.offsetLeft - row.clientWidth / 2 + link.clientWidth / 2, behavior: 'smooth' });
    }
    if (options.hash && history.replaceState) history.replaceState(null, '', `#${id}`);
    if (typeof updatePicker === 'function') updatePicker();
    if (options.scroll && layout) {
      const top = layout.getBoundingClientRect().top + window.scrollY - stickyOffset() - 12;
      window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
    }
  }
  cols?.classList.add('tabs');

  // What a `#...` can point at: a category (`#moderation`), the Integrations as a whole (`#integrations`, the first of its sections), a row of one
  // command (`#cmd-ticket-close`, also written `#ticket-close`), or a command that has rows for each of its subcommands (`#ticket`: its first row).
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.cmd-row'));
  function resolveHash(raw: string): { cat: string; row: HTMLElement | null; alias?: boolean } | null {
    let hash = raw.replace(/^#/, '');
    try { hash = decodeURIComponent(hash); } catch {}
    hash = hash.trim().toLowerCase();
    if (!hash) return null;
    if (ids.includes(hash)) return { cat: hash, row: null };
    if (hash === 'integrations') {
      const first = cats.find((cat) => cat.dataset.group);
      if (first) return { cat: first.id, row: null, alias: true };
    }
    const row = document.getElementById(hash.startsWith('cmd-') ? hash : `cmd-${hash}`) ?? rows.find((item) => item.dataset.cmd === hash || item.dataset.name === hash) ?? null;
    const cat = row?.closest<HTMLElement>('[data-cat]');
    return row && cat ? { cat: cat.id, row } : null;
  }
  function show(target: { cat: string; row: HTMLElement | null; alias?: boolean }, options: { scroll: boolean }) {
    activate(target.cat, { scroll: (options.scroll || Boolean(target.alias)) && !target.row, hash: false });
    const row = target.row;
    if (!row) return;
    if (row.classList.contains('no-slash')) applyMode('prefix');
    row.classList.add('open');
    row.querySelector('.cmd-expand')?.setAttribute('aria-expanded', 'true');
    const top = row.getBoundingClientRect().top + window.scrollY - stickyOffset() - 12;
    window.scrollTo({ top: Math.max(0, top), behavior: options.scroll ? 'smooth' : 'auto' });
    row.classList.add('flash');
    setTimeout(() => row.classList.remove('flash'), 1800);
  }
  // How it is typed: with the prefix or with a slash. The choice is remembered; a row without a slash form is left out of the slash list, and the counts follow.
  const bodyBox = document.querySelector<HTMLElement>('.cmd-body');
  const modeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('#cmdMode [data-mode]'));
  const sheet = document.getElementById('catSheet');
  const sheetButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sheet-cat]'));
  const picker = document.getElementById('catPicker');
  const pickerName = document.getElementById('catPickerName');
  const pickerCount = document.getElementById('catPickerCount');
  const rowsAll = Array.from(document.querySelectorAll<HTMLElement>('.cmd-row'));
  let mode: 'slash' | 'prefix' = 'prefix';
  try { if (localStorage.getItem('petto-commands-mode') === 'slash') mode = 'slash'; } catch {}
  function countOf(cat: HTMLElement) { return cat.querySelectorAll('.cmd-row:not(.no-slash)').length; }
  function updatePicker() {
    const cat = cats.find((item) => item.id === current);
    const link = tocLinks.find((item) => item.dataset.toc === current);
    if (pickerName) pickerName.textContent = link?.querySelector('span')?.textContent ?? '';
    if (pickerCount && cat) pickerCount.textContent = String(countOf(cat));
  }
  // A heading of a group (Integrations) is shown only while some category under it is (with a slash, or a search, some have nothing to show).
  function syncGroupHeadings() {
    for (const list of [document.querySelector('.toc-links'), document.querySelector('.cat-sheet-list')]) {
      if (!list) continue;
      let heading: HTMLElement | null = null;
      let any = false;
      const close = () => { if (heading) heading.hidden = !any; };
      for (const node of Array.from(list.children) as HTMLElement[]) {
        if (node.classList.contains('toc-group')) { close(); heading = node; any = false; } else if (!node.hidden) any = true;
      }
      close();
    }
  }
  function applyMode(next: 'slash' | 'prefix', remember = true) {
    mode = next;
    if (bodyBox) bodyBox.dataset.mode = mode;
    modeButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.mode === mode)));
    rowsAll.forEach((row) => row.classList.toggle('no-slash', mode === 'slash' && row.dataset.slash === '0'));
    let total = 0;
    cats.forEach((cat) => {
      const n = countOf(cat);
      total += n;
      const counter = cat.querySelector<HTMLElement>('.cat-count');
      if (counter) counter.textContent = `${n} ${counter.dataset.word ?? ''}`.trim();
      tocLinks.find((a) => a.dataset.toc === cat.id)?.querySelector('[data-count]')?.replaceChildren(String(n));
      sheetButtons.find((b) => b.dataset.sheetCat === cat.id)?.querySelector('[data-count]')?.replaceChildren(String(n));
    });
    if (input) input.placeholder = (input.dataset.template ?? '').replace('{n}', total.toLocaleString(document.documentElement.lang || 'en'));
    if (remember) { try { localStorage.setItem('petto-commands-mode', mode); } catch {} }
    // The chosen category may have nothing to show with a slash: the first one that has goes first.
    const here = cats.find((item) => item.id === current);
    if (mode === 'slash' && here && countOf(here) === 0) { const first = cats.find((item) => countOf(item) > 0); if (first) activate(first.id, { scroll: false, hash: false }); }
    runSearch();
    syncGroupHeadings();
    updatePicker();
  }
  modeButtons.forEach((button) => button.addEventListener('click', () => applyMode(button.dataset.mode === 'slash' ? 'slash' : 'prefix')));

  // The category picker (on a phone): a sheet with every category and how many commands it has.
  function openSheet(open: boolean) {
    if (!sheet) return;
    sheet.hidden = !open;
    document.documentElement.classList.toggle('cat-sheet-open', open);
    if (open) sheet.querySelector<HTMLElement>('[aria-current], button[data-sheet-cat]')?.focus();
  }
  picker?.addEventListener('click', () => openSheet(true));
  sheet?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('[data-sheet-close]')) { openSheet(false); picker?.focus(); return; }
    const item = target.closest<HTMLButtonElement>('[data-sheet-cat]');
    if (!item) return;
    if (input && input.value) { input.value = ''; runSearch(); }
    openSheet(false);
    activate(item.dataset.sheetCat ?? ids[0], { scroll: true, hash: true });
  });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && sheet && !sheet.hidden) openSheet(false); });
  document.querySelector('.toc')?.classList.add('has-picker');

  // A row folds: the syntax and what it does always show, the example, the other ways to type it and the link open with the arrow.
  cols?.classList.add('fold');
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const link = target.closest<HTMLButtonElement>('.cmd-link');
    if (link) {
      const row = link.closest<HTMLElement>('.cmd-row');
      const url = `${location.origin}${location.pathname}#${row?.id ?? ''}`;
      navigator.clipboard?.writeText(url).catch(() => {});
      link.classList.add('copied');
      setTimeout(() => link.classList.remove('copied'), 1400);
      return;
    }
    const toggle = target.closest<HTMLButtonElement>('.cmd-expand');
    const row = toggle?.closest<HTMLElement>('.cmd-row') ?? (target.closest('.cmd-syntax') && !target.closest('.cmd-copy') ? target.closest<HTMLElement>('.cmd-row') : null);
    if (!row) return;
    const open = !row.classList.contains('open');
    row.classList.toggle('open', open);
    row.querySelector('.cmd-expand')?.setAttribute('aria-expanded', String(open));
  });

  const landing = resolveHash(location.hash);
  if (landing) show(landing, { scroll: false }); else activate(ids[0], { scroll: false, hash: false });
  applyMode(mode, false);

  tocLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      if (input && input.value) { input.value = ''; runSearch(); }
      activate(link.dataset.toc ?? ids[0], { scroll: true, hash: true });
    });
  });
  window.addEventListener('hashchange', () => {
    const target = resolveHash(location.hash);
    if (!target) return;
    if (target.row || target.cat !== current) show(target, { scroll: true });
  });

  // Searching looks through every category, and typing nothing goes back to the chosen one.
  // Every word of the search has to be somewhere in the name (`ticket close`), the description or the other ways to type the command; a `!` or `/`
  // in front of a word is the prefix and is left out, so `!ticket close` and `/ticket close` find the same row.
  function runSearch() {
    const q = (input?.value ?? '').trim().toLowerCase();
    const words = q.split(/\s+/).map((word) => word.replace(/^[!/]+/, '')).filter(Boolean);
    let visible = 0;
    cols?.classList.toggle('searching', words.length > 0);
    cats.forEach((cat) => {
      let catVisible = 0;
      cat.querySelectorAll<HTMLElement>('.cmd-row').forEach((el) => {
        const name = el.dataset.name ?? '';
        const also = el.dataset.also ?? '';
        const named = `${name} ${also}`;
        const match = !el.classList.contains('no-slash') && (!words.length || words.every((word) => `${named} ${el.dataset.desc ?? ''}`.includes(word)));
        el.style.display = match ? '' : 'none';
        // The rows whose name is what was typed come first in their category: `ticket close` before the rows that only mention it.
        const phrase = words.join(' ');
        el.style.order = !words.length ? '' : name === phrase ? '0' : name.startsWith(phrase) || also.includes(phrase) ? '1' : words.every((word) => named.includes(word)) ? '2' : '3';
        if (match) catVisible++;
      });
      const gone = catVisible === 0 && (words.length > 0 || mode === 'slash');
      cat.style.display = gone ? 'none' : '';
      tocLinks.find((a) => a.dataset.toc === cat.id)?.toggleAttribute('hidden', gone);
      sheetButtons.find((b) => b.dataset.sheetCat === cat.id)?.toggleAttribute('hidden', gone);
      visible += catVisible;
    });
    if (words.length && visible === 0) { tocLinks.forEach((a) => a.removeAttribute('hidden')); sheetButtons.forEach((b) => b.removeAttribute('hidden')); }
    if (noResults) noResults.style.display = words.length && visible === 0 ? 'block' : 'none';
    if (typeof syncGroupHeadings === 'function') syncGroupHeadings();
  }
  input?.addEventListener('input', runSearch);

  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.cmd-copy');
    if (!button) return;
    const text = (mode === 'slash' ? button.dataset.copySlash : button.dataset.copyPrefix) ?? button.dataset.copy ?? '';
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const area = document.createElement('textarea');
      area.value = text;
      document.body.appendChild(area);
      area.select();
      try { document.execCommand('copy'); } catch {}
      area.remove();
    }
    button.classList.add('copied');
    button.setAttribute('title', button.dataset.copied ?? '');
    setTimeout(() => button.classList.remove('copied'), 1400);
  });

  const topButton = document.getElementById('cmdTop');
  window.addEventListener('scroll', () => {
    if (topButton) topButton.hidden = window.scrollY < 900;
  }, { passive: true });
  topButton?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>

