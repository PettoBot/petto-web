---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { useTranslations, localePath, type Locale } from '../i18n/ui';
import { renderSyntax } from '../utils/syntax';

interface Props {
  lang: Locale;
}
// A category of the page: the ones of the bot, and the sections of each service of the Integrations (which have an icon, examples and a group).
interface Cat { id: string; title: string; desc?: string; group?: string; icon?: string; tryLabel?: string; examples?: string[]; cmds: readonly (readonly [string, string, string] | readonly [string, string, string, string[]])[] }
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = t.commandsPage;
const base = localePath[lang];
const prefixNote = lang === 'es'
  ? 'Casi todos los comandos se ejecutan con el prefijo configurable del servidor (por defecto !). Los comandos slash (/) existen solo para interacciones y roleplay, /setup y reportes.'
  : lang === 'pt-BR'
    ? 'Quase todos os comandos usam o prefixo configurável do servidor (por padrão !). Os comandos slash (/) existem apenas para interações e roleplay, /setup e denúncias.'
    : 'Almost every command uses the server’s configurable prefix (default !). Slash commands (/) exist only for interactions and roleplay, /setup and reports.';

// The public catalogue used to contain legacy slash-style examples. Keep the
// source translations readable while guaranteeing the rendered reference uses
// the real prefix syntax Petto accepts.
// `/act` is the exception: it is a real slash command (every interaction action is one of its subcommands), shown as it is typed.
function prefixSyntax(value: string) {
  return value.replace(/(^|\s)\/(?!act\b)(?=[a-z])/g, '$1!');
}

const ui = lang === 'es'
  ? { copy: 'Copiar comando', copied: 'Copiado', top: 'Volver arriba', commands: 'comandos', also: 'También:' }
  : lang === 'pt-BR'
    ? { copy: 'Copiar comando', copied: 'Copiado', top: 'Voltar ao topo', commands: 'comandos', also: 'Também:' }
    : { copy: 'Copy command', copied: 'Copied', top: 'Back to top', commands: 'commands', also: 'Also:' };

// Every row has an anchor (`#cmd-ticket-close`), so a command can be linked. The name of a row is the whole command (`ticket close`).
const slug = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const usedIds = new Set<string>();
function rowId(name: string) {
  const base = `cmd-${slug(name) || 'command'}`;
  let id = base;
  for (let n = 2; usedIds.has(id); n += 1) id = `${base}-${n}`;
  usedIds.add(id);
  return id;
}

const catIcon: Record<string, string> = {
  moderation: 'ph:shield-check-fill',
  tickets: 'ph:ticket',
  leveling: 'ph:chart-line-up-fill',
  giveaways: 'ph:gift-fill',
  automation: 'ph:robot-fill',
  community: 'ph:users-three-fill',
  onboarding: 'ph:hand-waving-fill',
  logging: 'ph:notebook-fill',
  info: 'ph:info-fill',
  setup: 'ph:gear-fill',
  roleplay: 'ph:heart-fill',
};
---
<Base title={`${t.nav.commands} · ${c.title}`} active="commands" lang={lang}>
  <main>
    <section class="cmd-hero">
      <div class="wrap">
        <div class="eyebrow">{c.eyebrow}</div>
        <h1>{c.h1}</h1>
        <p class="lede">{c.lede}</p>
        <p class="prefix-note">{prefixNote}</p>
        <div class="legend">
          {renderSyntax(prefixSyntax(c.syntaxLegend)).map((p) => (
            p.type === 'req' ? <code class="tok-req">{p.text}</code> : p.type === 'opt' ? <code class="tok-opt">{p.text}</code> : <span>{p.text}</span>
          ))}
        </div>

        <div class="resource-grid reveal">
          {c.resources.map((r) => (
            <a class="resource-card" href={r.href.startsWith('http') ? r.href : r.href === '#' ? '#' : `${base}${r.href}`} target={r.href.startsWith('http') ? '_blank' : undefined} rel={r.href.startsWith('http') ? 'noopener' : undefined}>
              <Icon name={r.icon} class="resource-ic" />
              <div class="resource-t">{r.title}</div>
              <p>{r.desc}</p>
            </a>
          ))}
        </div>
        <div class="resource-grid resource-grid-legal reveal">
          {t.footer.legalItems.map((it) => (
            <a class="resource-card resource-card-sm" href={`${base}${it.href}`}>
              <Icon name="ph:scales-fill" class="resource-ic" />
              <div class="resource-t">{it.title}</div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="cmd-body">
      <div class="wrap cmd-layout">
        <aside class="toc" id="cmdToc">
          <div class="search-box">
            <Icon name="ph:magnifying-glass" width="14" height="14" />
            <input type="search" id="cmdSearch" placeholder={c.searchPlaceholder} autocomplete="off" aria-label={c.searchPlaceholder} />
          </div>
          <div class="toc-label">{c.jumpTo}</div>
          <nav class="toc-links" aria-label={c.jumpTo}>
            {(c.categories as unknown as Cat[]).map((cat, index, list) => (
              <>
                {cat.group && cat.group !== list[index - 1]?.group && <div class="toc-group">{cat.group}</div>}
                <a href={`#${cat.id}`} data-toc={cat.id}>
                  <Icon name={cat.icon ?? catIcon[cat.id] ?? 'ph:terminal-window-fill'} class="toc-ic" />
                  <span>{cat.title}</span>
                  <em>{cat.cmds.length}</em>
                </a>
              </>
            ))}
          </nav>
        </aside>

        <div class="cmd-cols">
          {(c.categories as unknown as Cat[]).map((cat) => (
            <div class="cat reveal" id={cat.id} data-cat data-group={cat.group ?? undefined}>
              <h2><Icon name={cat.icon ?? catIcon[cat.id] ?? 'ph:terminal-window-fill'} class="cat-ic" />{cat.title}<span class="cat-count">{cat.cmds.length} {ui.commands}</span></h2>
              {cat.desc && <p class="cat-desc">{cat.desc}</p>}
              {cat.examples && (
                <div class="cat-try">
                  <span>{cat.tryLabel}</span>
                  {cat.examples.map((example) => <code>{example}</code>)}
                </div>
              )}
              <div class="cat-list">
                {cat.cmds.map(([name, syntax, desc, also]) => (
                  <div class="cmd-row" id={rowId(name)} data-cmd={name.split(' ')[0].toLowerCase()} data-name={name.toLowerCase()} data-desc={desc.toLowerCase()} data-also={(also ?? []).join(' | ').toLowerCase()}>
                    <div class="cmd-top">
                      <div class="cmd-syntax">
                        {renderSyntax(prefixSyntax(syntax)).map((p) => (
                          p.type === 'req' ? <code class="tok-req">{p.text}</code> : p.type === 'opt' ? <code class="tok-opt">{p.text}</code> : <code class="tok-plain">{p.text}</code>
                        ))}
                      </div>
                      <button class="cmd-copy" type="button" data-copy={prefixSyntax(syntax)} data-copied={ui.copied} aria-label={ui.copy} title={ui.copy}>
                        <Icon name="ph:copy-bold" width="14" height="14" />
                      </button>
                    </div>
                    <p class="cmd-desc">{desc}</p>
                    {also && also.length > 0 && (
                      <p class="cmd-also">{ui.also} {also.map((value) => <code>{value}</code>)}</p>
                    )}
                  </div>
                ))}
              </div>
            </div>
          ))}
          <p class="no-results" id="cmdNoResults" style="display:none;">{c.noResults}</p>
        </div>
      </div>
    </section>
  </main>
  <button class="cmd-top-btn" id="cmdTop" type="button" aria-label={ui.top} title={ui.top} hidden>
    <Icon name="ph:arrow-up" width="16" height="16" />
  </button>
</Base>

<script>
  const input = document.getElementById('cmdSearch') as HTMLInputElement | null;
  const cols = document.querySelector<HTMLElement>('.cmd-cols');
  const cats = Array.from(document.querySelectorAll<HTMLElement>('[data-cat]'));
  const noResults = document.getElementById('cmdNoResults');
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
  const body = document.querySelector<HTMLElement>('.cmd-body');
  const layout = document.querySelector<HTMLElement>('.cmd-layout');
  const ids = cats.map((cat) => cat.id);

  // Keep the sticky search bar right under the site header, whatever its height is.
  function stickyOffset() {
    const header = document.querySelector('header.nav') as HTMLElement | null;
    const offset = header ? header.getBoundingClientRect().bottom + 8 : 72;
    return Math.max(offset, 8);
  }
  function syncStickyOffset() {
    body?.style.setProperty('--cmd-sticky-top', `${stickyOffset()}px`);
  }
  syncStickyOffset();
  window.addEventListener('resize', syncStickyOffset);

  // One category at a time. Without JavaScript every category stays on the page.
  let current = '';
  function activate(id: string, options: { scroll: boolean; hash: boolean }) {
    if (!ids.includes(id)) id = ids[0];
    current = id;
    cats.forEach((cat) => cat.classList.toggle('active', cat.id === id));
    tocLinks.forEach((link) => {
      const on = link.dataset.toc === id;
      link.classList.toggle('active', on);
      if (on) link.setAttribute('aria-current', 'true'); else link.removeAttribute('aria-current');
    });
    const row = document.querySelector<HTMLElement>('.toc-links');
    const link = tocLinks.find((item) => item.dataset.toc === id);
    if (row && link && row.scrollWidth > row.clientWidth) {
      row.scrollTo({ left: link.offsetLeft - row.clientWidth / 2 + link.clientWidth / 2, behavior: 'smooth' });
    }
    if (options.hash && history.replaceState) history.replaceState(null, '', `#${id}`);
    if (options.scroll && layout) {
      const top = layout.getBoundingClientRect().top + window.scrollY - stickyOffset() - 12;
      window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
    }
  }
  cols?.classList.add('tabs');

  // What a `#...` can point at: a category (`#moderation`), the Integrations as a whole (`#integrations`, the first of its sections), a row of one
  // command (`#cmd-ticket-close`, also written `#ticket-close`), or a command that has rows for each of its subcommands (`#ticket`: its first row).
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.cmd-row'));
  function resolveHash(raw: string): { cat: string; row: HTMLElement | null; alias?: boolean } | null {
    let hash = raw.replace(/^#/, '');
    try { hash = decodeURIComponent(hash); } catch {}
    hash = hash.trim().toLowerCase();
    if (!hash) return null;
    if (ids.includes(hash)) return { cat: hash, row: null };
    if (hash === 'integrations') {
      const first = cats.find((cat) => cat.dataset.group);
      if (first) return { cat: first.id, row: null, alias: true };
    }
    const row = document.getElementById(hash.startsWith('cmd-') ? hash : `cmd-${hash}`) ?? rows.find((item) => item.dataset.cmd === hash || item.dataset.name === hash) ?? null;
    const cat = row?.closest<HTMLElement>('[data-cat]');
    return row && cat ? { cat: cat.id, row } : null;
  }
  function show(target: { cat: string; row: HTMLElement | null; alias?: boolean }, options: { scroll: boolean }) {
    activate(target.cat, { scroll: (options.scroll || Boolean(target.alias)) && !target.row, hash: false });
    const row = target.row;
    if (!row) return;
    const top = row.getBoundingClientRect().top + window.scrollY - stickyOffset() - 12;
    window.scrollTo({ top: Math.max(0, top), behavior: options.scroll ? 'smooth' : 'auto' });
    row.classList.add('flash');
    setTimeout(() => row.classList.remove('flash'), 1800);
  }
  const landing = resolveHash(location.hash);
  if (landing) show(landing, { scroll: false }); else activate(ids[0], { scroll: false, hash: false });

  tocLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      if (input && input.value) { input.value = ''; runSearch(); }
      activate(link.dataset.toc ?? ids[0], { scroll: true, hash: true });
    });
  });
  window.addEventListener('hashchange', () => {
    const target = resolveHash(location.hash);
    if (!target) return;
    if (target.row || target.cat !== current) show(target, { scroll: true });
  });

  // Searching looks through every category, and typing nothing goes back to the chosen one.
  // Every word of the search has to be somewhere in the name (`ticket close`), the description or the other ways to type the command; a `!` or `/`
  // in front of a word is the prefix and is left out, so `!ticket close` and `/ticket close` find the same row.
  function runSearch() {
    const q = (input?.value ?? '').trim().toLowerCase();
    const words = q.split(/\s+/).map((word) => word.replace(/^[!/]+/, '')).filter(Boolean);
    let visible = 0;
    cols?.classList.toggle('searching', words.length > 0);
    cats.forEach((cat) => {
      let catVisible = 0;
      cat.querySelectorAll<HTMLElement>('.cmd-row').forEach((el) => {
        const name = el.dataset.name ?? '';
        const also = el.dataset.also ?? '';
        const named = `${name} ${also}`;
        const match = !words.length || words.every((word) => `${named} ${el.dataset.desc ?? ''}`.includes(word));
        el.style.display = match ? '' : 'none';
        // The rows whose name is what was typed come first in their category: `ticket close` before the rows that only mention it.
        const phrase = words.join(' ');
        el.style.order = !words.length ? '' : name === phrase ? '0' : name.startsWith(phrase) || also.includes(phrase) ? '1' : words.every((word) => named.includes(word)) ? '2' : '3';
        if (match) catVisible++;
      });
      cat.style.display = catVisible === 0 && words.length ? 'none' : '';
      tocLinks.find((a) => a.dataset.toc === cat.id)?.toggleAttribute('hidden', catVisible === 0 && words.length > 0);
      visible += catVisible;
    });
    if (words.length && visible === 0) tocLinks.forEach((a) => a.removeAttribute('hidden'));
    if (noResults) noResults.style.display = words.length && visible === 0 ? 'block' : 'none';
  }
  input?.addEventListener('input', runSearch);

  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.cmd-copy');
    if (!button) return;
    const text = button.dataset.copy ?? '';
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const area = document.createElement('textarea');
      area.value = text;
      document.body.appendChild(area);
      area.select();
      try { document.execCommand('copy'); } catch {}
      area.remove();
    }
    button.classList.add('copied');
    button.setAttribute('title', button.dataset.copied ?? '');
    setTimeout(() => button.classList.remove('copied'), 1400);
  });

  const topButton = document.getElementById('cmdTop');
  window.addEventListener('scroll', () => {
    if (topButton) topButton.hidden = window.scrollY < 900;
  }, { passive: true });
  topButton?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>

<style>
  .toc-group { margin: 14px 0 4px; padding: 0 10px; font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--text-dim); }
  .cat-try { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 18px; }
  .cat-try span { font-size: 12px; color: var(--text-dim); }
  .cat-try code { font-family: var(--mono); font-size: 12.5px; padding: 4px 9px; border-radius: 8px; background: var(--surface-2, rgba(255,255,255,.05)); border: 1px solid var(--border, rgba(255,255,255,.08)); }
  .cmd-also { margin: 6px 0 0; font-size: 12px; color: var(--text-dim); display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .cmd-also code { font-family: var(--mono); font-size: 11.5px; padding: 2px 7px; border-radius: 6px; background: var(--surface-2, rgba(255,255,255,.05)); }
  .cmd-hero { padding: 64px 0 30px; }
  .cmd-hero h1 { font-size: 38px; margin: 14px 0 12px; }
  .cmd-hero .lede { color: var(--text-muted); font-size: 16.5px; max-width: 56ch; margin-bottom: 12px; }
  .prefix-note { color: var(--accent); font-size: 12.5px; margin: 0 0 14px; max-width: 68ch; }
  .legend { display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-dim); margin-bottom: 32px; }
  .legend code { font-family: var(--mono); }
  .legend :global(.tok-req) { color: var(--accent); }
  .legend :global(.tok-opt) { color: var(--text-dim); }

  .resource-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .resource-grid-legal { grid-template-columns: repeat(3, 1fr); margin-top: 12px; }
  .resource-card { display: block; border: 1px solid var(--border); border-radius: 14px; padding: 18px 20px; background: var(--card); text-decoration: none; color: inherit; transition: border-color 0.15s ease, transform 0.15s ease; }
  .resource-card:hover { border-color: var(--text-dim); transform: translateY(-2px); }
  .resource-card :global(.resource-ic) { width: 20px; height: 20px; color: var(--accent); margin-bottom: 12px; }
  .resource-t { font-size: 14.5px; font-weight: 600; color: var(--text); margin-bottom: 4px; }
  .resource-card p { font-size: 12.5px; color: var(--text-muted); line-height: 1.5; margin: 0; }
  .resource-card-sm { display: flex; align-items: center; gap: 10px; padding: 13px 18px; }
  .resource-card-sm :global(.resource-ic) { margin-bottom: 0; width: 16px; height: 16px; }
  .resource-card-sm .resource-t { margin-bottom: 0; }

  .cmd-body { padding: 44px 0 96px; border-top: 1px solid var(--border-soft); --cmd-sticky-top: 72px; }
  .cmd-layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 48px; align-items: start; }
  .cmd-layout > * { min-width: 0; }

  .toc { position: sticky; top: var(--cmd-sticky-top); display: flex; flex-direction: column; gap: 2px; max-height: calc(100vh - var(--cmd-sticky-top) - 20px); overflow-y: auto; scrollbar-width: thin; }
  .search-box { display: flex; align-items: center; gap: 8px; border: 1px solid var(--border); border-radius: 9px; padding: 8px 10px; color: var(--text-dim); margin-bottom: 18px; background: var(--bg); }
  .search-box:focus-within { border-color: var(--accent); }
  .search-box input { border: none; background: none; outline: none; color: var(--text); font-size: 14px; width: 100%; min-width: 0; font-family: var(--sans); }
  .toc-label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 6px; }
  .toc-links { display: flex; flex-direction: column; gap: 2px; }
  .toc-links a { display: flex; align-items: center; gap: 9px; font-size: 13.5px; color: var(--text-muted); text-decoration: none; padding: 7px 0; border-left: 2px solid transparent; padding-left: 12px; margin-left: -13px; }
  .toc-links a[hidden] { display: none; }
  .toc-links a span { flex: 1; min-width: 0; }
  .toc-links a em { font-style: normal; font-family: var(--mono); font-size: 11px; color: var(--text-dim); }
  .toc-links a:hover { color: var(--text); border-left-color: var(--border); }
  .toc-links a.active { color: var(--text); border-left-color: var(--accent); }
  .toc-links a.active :global(.toc-ic) { color: var(--accent); }
  .toc-links a :global(.toc-ic) { width: 14px; height: 14px; flex-shrink: 0; color: var(--text-dim); }

  .cmd-cols { display: flex; flex-direction: column; gap: 56px; }
  .cmd-cols.tabs .cat:not(.active) { display: none; }
  .cmd-cols.tabs.searching .cat { display: block; }
  .cat h2 { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 24px; margin-bottom: 8px; }
  .cat { scroll-margin-top: calc(var(--cmd-sticky-top) + 12px); }
  .cat h2 :global(.cat-ic) { width: 20px; height: 20px; color: var(--accent); }
  .cat-count { margin-left: auto; font-family: var(--mono); font-size: 11.5px; font-weight: 400; color: var(--text-dim); }
  .cat-desc { color: var(--text-muted); font-size: 14.5px; margin: 0 0 20px; }
  .cat:not(:has(.cat-desc)) h2 { margin-bottom: 20px; }

  .cat-list { display: flex; flex-direction: column; gap: 10px; }
  .cmd-row { border: 1px solid var(--border-soft); border-radius: 10px; padding: 12px 14px 13px 16px; background: var(--bg-raise); min-width: 0; }
  .cmd-row:hover { border-color: var(--border); }
  .cmd-row { scroll-margin-top: calc(var(--cmd-sticky-top) + 12px); }
  .cmd-row.flash { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .cmd-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 6px; }
  .cmd-syntax { display: flex; flex-wrap: wrap; gap: 2px 7px; min-width: 0; flex: 1; padding-top: 5px; }
  .cmd-syntax :global(code) { font-family: var(--mono); font-size: 13px; overflow-wrap: anywhere; word-break: break-word; }
  .cmd-syntax :global(.tok-plain) { color: var(--text); font-weight: 600; }
  .cmd-syntax :global(.tok-req) { color: var(--accent); }
  .cmd-syntax :global(.tok-opt) { color: var(--text-dim); }
  .cmd-copy { display: grid; place-items: center; flex: 0 0 auto; width: 34px; height: 34px; margin: -4px -6px 0 0; border: 1px solid transparent; border-radius: 8px; background: transparent; color: var(--text-dim); cursor: pointer; opacity: 0; transition: opacity 0.15s ease, color 0.15s ease, border-color 0.15s ease; }
  .cmd-row:hover .cmd-copy, .cmd-copy:focus-visible, .cmd-copy.copied { opacity: 1; }
  .cmd-copy:hover { color: var(--text); border-color: var(--border); }
  .cmd-copy.copied { color: var(--green); border-color: color-mix(in srgb, var(--green) 55%, var(--border)); }
  .cmd-desc { font-size: 13.5px; color: var(--text-muted); margin: 0; line-height: 1.55; overflow-wrap: anywhere; }
  .no-results { text-align: center; color: var(--text-dim); font-size: 14px; padding: 30px 0; }

  .cmd-top-btn { position: fixed; right: 18px; bottom: 18px; z-index: 30; display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid var(--border); border-radius: 50%; background: var(--card); color: var(--text); cursor: pointer; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18); }
  .cmd-top-btn[hidden] { display: none; }
  .cmd-top-btn:hover { border-color: var(--text-dim); }

  @media (hover: none) { .cmd-copy { opacity: 1; } }

  @media (max-width: 880px) {
    .cmd-hero { padding: 40px 0 22px; }
    .cmd-hero h1 { font-size: 32px; }
    .legend { margin-bottom: 22px; flex-wrap: wrap; }
    .resource-grid { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .resource-grid-legal { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .resource-card { padding: 13px 15px; display: grid; grid-template-columns: 24px minmax(0, 1fr); column-gap: 12px; align-items: center; }
    .resource-card :global(.resource-ic) { grid-row: 1 / span 2; margin-bottom: 0; }
    .resource-t { margin-bottom: 0; }
    .resource-card-sm { display: flex; }
    .cmd-body { padding: 24px 0 72px; }
    .cmd-layout { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .toc { max-height: none; overflow: visible; z-index: 20; padding: 10px; border: 1px solid var(--border); border-radius: 14px; background: color-mix(in srgb, var(--bg) 97%, transparent); backdrop-filter: blur(12px); }
    .search-box { margin-bottom: 10px; }
