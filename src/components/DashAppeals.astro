---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MultiSelect from './MultiSelect.astro';
import ColorPicker from './ColorPicker.astro';
import AppealImageField from './AppealImageField.astro';
import { getDashLang, makeT } from '../i18n/dash';
import type { NameClaim } from '../utils/appealNames';
import { answerView, pictureUrl, THEMES, LIMITS, FORM_ICONS, QUESTION_TYPES, LIST_TYPES, FILE_ACCEPTS, PUNISHMENT_TYPES, DM_LINK_TYPES, APPEAL_SETTING_LIMITS, BLOCKS, themeFor, hexColor, type AppealConfig } from '../utils/appeals';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null }; guildId: string; guildName: string; guildIcon: string; origin: string;
  section: string; config: AppealConfig; forms: any[]; counts: Record<string, number>; submissions: any[]; messages: Record<string, any[]>; statusFilter: string;
  claim?: NameClaim | null; lastClaim?: NameClaim | null; claimSlug?: string | null; claimSent?: boolean;
  roles: { id: string; name: string }[]; channels: { id: string; name: string }[]; editing: any; saved: boolean; message: { kind: 'ok' | 'err'; text: string } | null;
}
const { claim = null, lastClaim = null, claimSlug = null, claimSent = false, user, guildId, guildName, guildIcon, origin, section, config, forms, counts, submissions, messages, statusFilter, roles, channels, editing, message } = Astro.props;
const link = `${origin.replace(/^http:\/\/localhost[^/]*/, 'https://petto.sbs')}/appeal/${config.slug || guildId}`;
const addressOf = config.slug || guildId;
const uploadAction = (kind: string) => `/dash/guild/${guildId}/appeals-image?kind=${kind}`;
const picturePath = (kind: string) => `/appeal/${addressOf}/img/${kind}`;
const embedPreview = pictureUrl(config.embed?.image_url, 'embed', { path: addressOf, origin: '' });
const titles: Record<string, string> = { overview: dt('Appeals'), forms: dt('Appeal forms'), submissions: dt('Appeal submissions'), settings: dt('Appeal settings'), brand: dt('Appeal brand'), messages: dt('Appeal messages') };
const typeNames: Record<string, string> = { ban: dt('Bans'), mute: dt('Mutes'), warn: dt('Warns'), kick: dt('Kicks'), softban: dt('Softbans') };
// The sanctions whose DM can carry the appeal link, one by one.
const dmTypeNames: Record<string, string> = { ban: dt('Bans'), tempban: dt('Temporary bans'), softban: dt('Softbans'), kick: dt('Kicks'), timeout: dt('Timeouts and mutes'), warn: dt('Warns') };
const when = (iso: string) => new Date(iso).toLocaleString(dashLang, { dateStyle: 'medium', timeStyle: 'short' });
const liveForms = forms.filter((f) => f.status === 'live').length;
const theme = themeFor(config.brand);
const monthsOrDays = (days: number) => (days % 30 === 0 && days >= 30 ? { n: days / 30, unit: 'months' } : { n: days, unit: 'days' });
const warnsAge = monthsOrDays(config.warns_max_age_days);
const storeAge = monthsOrDays(config.store_days);
const variableChips = ['{username}', '{server}', '{reason}', '{form}', '{link}'];
// The typed autocomplete of the appeal messages offers these, not the general Petto variables (the appeal texts only know these five).
const appealVars = JSON.stringify([{ l: dt('Appeal messages'), v: [['{username}', dt('Name of the member')], ['{server}', dt('Name of the server')], ['{reason}', dt('Reason the staff wrote')], ['{form}', dt('Name of the form')], ['{link}', dt('Link of the appeal page')]] }]).replace(/</g, '\\u003c');
const sampleVars = { username: 'Liam', server: guildName, reason: dt('You can come back, please read the rules.'), form: dt('Ban appeal'), link: 'petto.sbs/appeal/…' };
// What the members read when nothing is written: in the language the server chose for its appeal page, not the one of the dashboard (the bot has the same texts).
const DEFAULT_MESSAGES: Record<string, Record<string, string>> = {
  en: { submitted: 'Your appeal was sent. The staff of {server} will look at it.', accepted: 'Your appeal was accepted. {reason}', rejected: 'Your appeal was rejected. {reason}', reply: 'The staff of {server} wrote to you about your appeal.' },
  es: { submitted: 'Tu apelación fue enviada. El staff de {server} la revisará.', accepted: 'Tu apelación fue aceptada. {reason}', rejected: 'Tu apelación fue rechazada. {reason}', reply: 'El staff de {server} te escribió sobre tu apelación.' },
  'pt-BR': { submitted: 'Sua apelação foi enviada. A equipe de {server} vai analisá-la.', accepted: 'Sua apelação foi aceita. {reason}', rejected: 'Sua apelação foi recusada. {reason}', reply: 'A equipe de {server} escreveu para você sobre a sua apelação.' },
};
const defaults = DEFAULT_MESSAGES[config.language] ?? DEFAULT_MESSAGES.en;
// The first form of a server is written in the language of its page too.
const STARTER: Record<string, { section: string; question: string }> = {
  en: { section: 'About your punishment', question: 'Why do you think your punishment should be lifted?' },
  es: { section: 'Sobre tu sanción', question: '¿Por qué crees que se debería levantar tu sanción?' },
  'pt-BR': { section: 'Sobre a sua punição', question: 'Por que você acha que a sua punição deveria ser retirada?' },
};
const starter = STARTER[config.language] ?? STARTER.en;
const messageTitles: Record<string, string> = { submitted: dt('When the appeal is sent'), accepted: dt('When it is accepted'), rejected: dt('When it is rejected'), reply: dt('When the staff writes to the member') };
const builderText = { section: dt('Section'), question: dt('Question'), addQuestion: dt('Add a question'), addSection: dt('Add a section'), title: dt('Section title'), description: dt('Description (optional)'), label: dt('Question'), help: dt('Help text (optional)'), required: dt('Required'), options: dt('Options, one per line'), remove: dt('Remove'), up: dt('Move up'), down: dt('Move down'), types: { short: dt('Short answer'), paragraph: dt('Long answer'), choice: dt('Choose one'), multi: dt('Choose several'), yesno: dt('Yes or no'), number: dt('Number'), dropdown: dt('Dropdown list'), scale: dt('Rating scale'), date: dt('Date'), link: dt('Link'), file: dt('File upload'), confirm: dt('Confirmation box') }, scaleMax: dt('The scale goes up to'), accept: dt('Files it accepts'), accepts: { images: dt('Pictures'), pdf: dt('PDF'), images_pdf: dt('Pictures or PDF'), documents: dt('Pictures, PDF or text') }, maxFiles: dt('How many files'), limit: dt('Limit reached') };
const formsBack = `/dash/guild/${guildId}/appeals?section=forms`;
const editForm = editing === 'new' ? { id: null, name: '', icon: '', short_description: '', description: '', status: 'draft', requirement_types: [], block_on_reject: 'none', generate_invite: false, sections: [{ id: 's1', title: starter.section, description: null, questions: [{ id: 'q1', type: 'paragraph', label: starter.question, help: null, required: true, options: [] }] }], messages: {} } : editing;
const blockNames: Record<string, string> = { none: dt("Don't block"), day: dt('Block for a day'), week: dt('Block for a week'), month: dt('Block for a month'), forever: dt('Block for good') };
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={`appeals-${section}`} pageTitle={titles[section]}>
  <h1>{titles[section]}{section === 'overview' && <span class:list={['da-badge', { on: config.enabled }]}>{config.enabled ? dt('Open') : dt('Closed')}</span>}</h1>
  {(section === 'messages' || (section === 'forms' && editForm)) && <script type="application/json" data-var-groups set:html={appealVars}></script>}
  {message && <div class:list={['da-flash', message.kind]} role={message.kind === 'err' ? 'alert' : undefined}><Icon name={message.kind === 'ok' ? 'ph:check-circle-fill' : 'ph:warning-fill'} width="15" height="15" />{message.text}</div>}

  {section === 'overview' && (
    <>
      <form method="POST" class="da-card da-toggle" data-no-dirty>
        <input type="hidden" name="action" value="toggle" />
        <label class="da-switch"><input type="checkbox" name="enabled" checked={config.enabled} /><span><b>{dt('Take appeals')}</b><em>{dt('While this is off, the page says appeals are closed.')}</em></span></label>
        <button type="submit" class="btn btn-accent btn-sm">{dt('Save')}</button>
      </form>
      <div class="da-card">
        <h2>{dt('Your appeal page')}</h2>
        <div class="da-link"><code>{link}</code><button type="button" class="btn btn-ghost btn-sm" data-copy={link}><Icon name="ph:copy-simple-bold" width="13" height="13" />{dt('Copy')}</button><a class="btn btn-ghost btn-sm" href={link} target="_blank" rel="noopener"><Icon name="ph:arrow-square-out-bold" width="13" height="13" />{dt('Open')}</a></div>
        <p class="da-hint">{dt('Share it in your rules channel or in the message members get when they are punished.')}</p>
      </div>
      <div class="da-card">
        <h2>{dt('Before you open it')}</h2>
        <ul class="da-checks">
          <li class:list={{ done: Boolean(config.submission_channel_id) }}><Icon name={config.submission_channel_id ? 'ph:check-circle-fill' : 'ph:circle'} width="16" height="16" /><span>{dt('Pick the channel where appeals arrive')}</span><a href={`/dash/guild/${guildId}/appeals?section=settings`}>{dt('Settings')}</a></li>
          <li class:list={{ done: liveForms > 0 }}><Icon name={liveForms > 0 ? 'ph:check-circle-fill' : 'ph:circle'} width="16" height="16" /><span>{dt('Publish at least one form')}</span><a href={`/dash/guild/${guildId}/appeals?section=forms`}>{dt('Forms')}</a></li>
          <li class:list={{ done: config.enabled }}><Icon name={config.enabled ? 'ph:check-circle-fill' : 'ph:circle'} width="16" height="16" /><span>{dt('Turn on Take appeals')}</span></li>
        </ul>
      </div>
      <div class="da-stats dgl-stagger">
        {(['pending', 'accepted', 'rejected', 'withdrawn'] as const).map((s) => <a href={`/dash/guild/${guildId}/appeals?section=submissions&status=${s}`} class="da-stat dgl-card"><b>{counts[s] ?? 0}</b><span>{{ pending: dt('Waiting'), accepted: dt('Accepted'), rejected: dt('Rejected'), withdrawn: dt('Withdrawn') }[s]}</span></a>)}
      </div>
    </>
  )}

  {section === 'forms' && !editForm && (
    <>
      <div class="da-row"><span class="da-hint">{forms.length}/{LIMITS.forms}</span><a class="btn btn-accent btn-sm" href={`${formsBack}&form=new`}><Icon name="ph:plus-bold" width="12" height="12" />{dt('New form')}</a></div>
      {forms.length === 0 && <div class="da-card"><p>{dt('No forms yet. Make one so members have something to fill in.')}</p></div>}
      <div class="da-list dgl-stagger">
        {forms.map((f) => (
          <div class="da-card da-form">
            <div class="da-row"><h3>{f.icon && <Icon name={`ph:${f.icon}-fill`} width="16" height="16" class="da-ico" />}{f.name}</h3><span class:list={['da-chip', f.status]}>{f.status === 'live' ? dt('Live') : dt('Draft')}</span></div>
            <p class="da-hint">{f.short_description || dt('No short description')} · {(f.sections ?? []).reduce((n: number, s: any) => n + (s.questions?.length ?? 0), 0)} {dt('questions')}</p>
            <div class="da-actions">
              <a class="btn btn-ghost btn-sm" href={`${formsBack}&form=${f.id}`}>{dt('Edit')}</a>
              <form method="POST" data-no-dirty><input type="hidden" name="action" value="duplicate_form" /><input type="hidden" name="form_id" value={f.id} /><button type="submit" class="btn btn-ghost btn-sm">{dt('Duplicate')}</button></form>
            </div>
          </div>
        ))}
      </div>
    </>
  )}

  {section === 'forms' && editForm && (
    <form method="POST" class="da-editor" data-builder-form>
      <input type="hidden" name="action" value="save_form" />
      {editForm.id && <input type="hidden" name="form_id" value={editForm.id} />}
      <a class="da-back" href={formsBack}>← {dt('All forms')}</a>
      <div class="da-card">
        <div class="da-grid">
          <label class="da-field"><span>{dt('Name')}</span><input type="text" name="name" value={editForm.name} maxlength="80" required /></label>
          <div class="da-field"><span>{dt('Icon')}</span><div class="da-icons">{FORM_ICONS.map((key) => <label class="da-iconpick"><input type="radio" name="icon" value={key} checked={editForm.icon === key} /><Icon name={`ph:${key}-fill`} width="18" height="18" /></label>)}<label class="da-iconpick da-iconnone"><input type="radio" name="icon" value="" checked={!editForm.icon} />{dt('None')}</label></div></div>
          <label class="da-field da-wide"><span>{dt('Short description')}</span><input type="text" name="short_description" value={editForm.short_description ?? ''} maxlength="160" /><em>{dt('Shown on the list of forms.')}</em></label>
          <label class="da-field da-wide"><span>{dt('Description')}</span><textarea name="description" maxlength="1500" rows="3">{editForm.description ?? ''}</textarea><em>{dt('Shown at the top of the form.')}</em></label>
          <label class="da-field"><span>{dt('Status')}</span><select name="status"><option value="draft" selected={editForm.status === 'draft'}>{dt('Draft: nobody sees it')}</option><option value="live" selected={editForm.status === 'live'}>{dt('Live: members can fill it')}</option></select></label>
          <label class="da-field"><span>{dt('When it is rejected')}</span><select name="block_on_reject">{BLOCKS.map((b) => <option value={b} selected={editForm.block_on_reject === b}>{blockNames[b]}</option>)}</select></label>
        </div>
        <div class="da-field"><span>{dt('Who can open it')}</span>
          <div class="da-checkrow">{PUNISHMENT_TYPES.map((t) => <label class="da-check"><input type="checkbox" name="requirement_types" value={t} checked={(editForm.requirement_types ?? []).includes(t)} />{typeNames[t]}</label>)}</div>
          <em>{dt('Leave all empty and anyone can open it. Pick types and the member needs one of those punishments.')}</em>
        </div>
        <label class="da-check"><input type="checkbox" name="generate_invite" checked={editForm.generate_invite} />{dt('Give a single-use invite when an appeal is accepted')}</label>
      </div>

      <div class="da-card">
        <h2>{dt('Questions')}</h2>
        <div data-builder data-initial={JSON.stringify(editForm.sections ?? [])} data-text={JSON.stringify(builderText)} data-limits={JSON.stringify(LIMITS)} data-types={JSON.stringify(QUESTION_TYPES)}></div>
        <input type="hidden" name="sections_json" data-builder-output />
      </div>

      <div class="da-card">
        <h2>{dt('Messages for this form')}</h2>
        <p class="da-hint">{dt('Leave empty to use the messages of the Messages page.')}</p>
        <div class="da-grid">
          {['submitted', 'accepted', 'rejected'].map((k) => <label class="da-field da-wide"><span>{messageTitles[k]}</span><textarea name={`msg_${k}`} maxlength="1000" rows="2" placeholder={defaults[k]} data-ac="vars,emojis">{editForm.messages?.[k] ?? ''}</textarea></label>)}
        </div>
      </div>
      <div class="da-actions"><button type="submit" class="btn btn-accent">{dt('Save form')}</button></div>
    </form>
  )}
  {section === 'forms' && editForm && editForm.id && (
    <form method="POST" class="da-danger" onsubmit={`return confirm(${JSON.stringify(dt('Delete this form? Appeals already sent stay.'))})`} data-no-dirty>
      <input type="hidden" name="action" value="delete_form" /><input type="hidden" name="form_id" value={editForm.id} />
      <button type="submit" class="da-del"><Icon name="ph:trash-bold" width="13" height="13" />{dt('Delete form')}</button>
    </form>
  )}

  {section === 'submissions' && (
    <>
      <div class="da-tabs">
        {(['pending', 'accepted', 'rejected', 'withdrawn'] as const).map((s) => <a href={`/dash/guild/${guildId}/appeals?section=submissions&status=${s}`} class:list={['da-tab', { on: statusFilter === s }]}>{{ pending: dt('Waiting'), accepted: dt('Accepted'), rejected: dt('Rejected'), withdrawn: dt('Withdrawn') }[s]}</a>)}
      </div>
      {submissions.length === 0 && <div class="da-card"><p>{dt('Nothing here.')}</p></div>}
      <div class="da-list dgl-stagger">
        {submissions.map((s) => (
          <details class="da-card da-sub">
            <summary><span class="da-who">{s.avatar_url && <img src={s.avatar_url} alt="" width="26" height="26" />}<b>{s.username}</b></span><span class="da-hint">{s.form_name} · {when(s.created_at)}</span><span class:list={['da-chip', s.status]}>{{ pending: dt('Waiting'), accepted: dt('Accepted'), rejected: dt('Rejected'), withdrawn: dt('Withdrawn') }[s.status as 'pending']}</span></summary>
            <div class="da-body">
              {(s.punishments ?? []).length > 0 && <div class="da-block"><h4>{dt('Punishments')}</h4>{s.punishments.map((p: any) => <p>• {typeNames[p.type] ?? p.type}{p.case ? ` #${p.case}` : ''}{p.reason ? ` — ${p.reason}` : ''}{p.until ? ` · ${when(p.until)}` : ''}</p>)}</div>}
              <div class="da-block"><h4>{dt('Answers')}</h4>{(s.answers ?? []).map((a: any) => {
                const view = answerView(a);
                return <div class="da-ans"><b>{a.label}</b>{view.kind === 'text' ? <span>{view.text}</span> : (
                  <span class="da-ans-files">{view.files.map((f) => f.mime.startsWith('image/')
                    ? <a href={`/dash/guild/${guildId}/appeals-file?f=${f.id}`} target="_blank" rel="noopener" class="da-ans-pic" title={f.name}><img src={`/dash/guild/${guildId}/appeals-file?f=${f.id}`} alt={f.name} loading="lazy" /></a>
                    : <a href={`/dash/guild/${guildId}/appeals-file?f=${f.id}`} target="_blank" rel="noopener" class="da-ans-doc"><Icon name="ph:file-text-bold" width="13" height="13" />{f.name}</a>)}</span>
                )}</div>;
              })}</div>
              <div class="da-block"><h4>{dt('Conversation')} <span class="da-live"><i></i>{dt('Updates live')}</span></h4>
                <div class="da-chat" data-chat={s.id}>
                {(messages[s.id] ?? []).map((m: any) => <div class:list={['da-msg', m.author_type]}><small>{m.author_type === 'user' ? s.username : m.author_type === 'staff' ? (m.author_name ?? dt('Staff')) : 'Petto'} · {when(m.created_at)}</small><span>{m.content}</span></div>)}
                {(messages[s.id] ?? []).length === 0 && <p class="da-hint" data-chat-empty>{dt('No messages yet.')}</p>}
                </div>
              </div>
              <form method="POST" class="da-inline" data-no-dirty data-chat-reply data-sid={s.id} data-failed={dt('It could not be saved, try again.')}><input type="hidden" name="action" value="reply" /><input type="hidden" name="submission_id" value={s.id} /><textarea name="content" rows="2" maxlength="1500" placeholder={dt('Write to the member')} required></textarea><button type="submit" class="btn btn-ghost btn-sm">{dt('Send')}</button></form>
              {s.status === 'pending' && (
                <form method="POST" class="da-resolve" data-no-dirty>
                  <input type="hidden" name="action" value="resolve" /><input type="hidden" name="submission_id" value={s.id} />
                  <input type="text" name="reason" maxlength="800" placeholder={dt('Reason (the member sees it)')} />
                  <button type="submit" name="status" value="accepted" class="btn btn-accent btn-sm">{dt('Accept')}</button>
                  <button type="submit" name="status" value="rejected" class="da-reject">{dt('Reject')}</button>
                </form>
              )}
              {s.status !== 'pending' && s.resolution_reason && <p class="da-hint">{dt('Reason')}: {s.resolution_reason}</p>}
              {s.status === 'accepted' && s.invite_note && <p class="da-hint">{dt('Invite')}: {s.invite_url ? <code>{s.invite_url}</code> : null} <span>({s.invite_note})</span></p>}
            </div>
          </details>
        ))}
      </div>
    </>
  )}

  {section === 'settings' && (
    <Fragment>
    {claim && (
      <div class="da-card da-claim da-claim-open">
        <h2>{dt('Name request')}: <code>{claim.slug}</code></h2>
        <p class="da-claim-text">{dt('The team is reviewing it. A review takes from 1 hour up to 72 hours.')}</p>
        <p class="da-claim-text">{dt('Until then your page uses the link with the server id:')} <code>{`petto.sbs/appeal/${guildId}`}</code></p>
        <form method="POST" data-no-dirty><input type="hidden" name="action" value="claim_cancel" /><button type="submit" class="btn btn-ghost btn-sm">{dt('Cancel the request')}</button></form>
      </div>
    )}
    {!claim && claimSent && <div class="da-claim-ok da-claim-sent" role="status"><Icon name="ph:check-circle-fill" width="16" height="16" />{dt('Request sent. The team will answer in 1 to 72 hours.')}</div>}
    {!claim && !claimSlug && lastClaim && (
      <div class="da-claim-ok">
        {lastClaim.status === 'approved' ? dt('Your request for this name was accepted:') : dt('Your last name request was denied:')} <code>{lastClaim.slug}</code>{lastClaim.note ? ` · ${lastClaim.note}` : ''}
      </div>
    )}
    {!claim && claimSlug && (
      <form method="POST" class="da-card da-claim" data-claim data-no-dirty>
        <input type="hidden" name="action" value="claim_send" />
        <input type="hidden" name="slug" value={claimSlug} />
        <h2>{dt('Ask for this name')}: <code>{claimSlug}</code></h2>
        <p class="da-claim-text">{dt('Another server has this name. If it should be yours, tell the team why. A review takes from 1 hour up to 72 hours.')}</p>
        <p class="da-claim-text">{dt('While you wait, your page uses the link with the server id. You can also pick another name or cancel.')}</p>
        <label class="da-field"><span>{dt('Why should it be yours?')}</span><textarea name="reason" rows="4" minlength="20" maxlength="1000" required placeholder={dt('For example: it is the name of our community, we use it in our other platforms…')}></textarea></label>
        <label class="da-field"><span>{dt('Link to see your server')}</span><input type="url" name="server_url" maxlength="300" required placeholder="https://discord.gg/…" /><em>{dt('An invite, so the team can look at the server.')}</em></label>
        <label class="da-field"><span>{dt('Extra proof (optional)')}</span><input type="url" name="extra_url" maxlength="300" placeholder="https://…" /><em>{dt('Your website, social profile or anything that shows the name is yours.')}</em></label>
        <div class="da-actions">
          <button type="submit" class="btn btn-accent">{dt('Send request')}</button>
          <button type="button" class="btn btn-ghost" data-claim-other>{dt('Pick another name')}</button>
          <a class="btn btn-ghost" href="?section=settings">{dt('Cancel')}</a>
        </div>
      </form>
    )}
    <form method="POST" class="da-editor">
      <input type="hidden" name="action" value="save_settings" />
      <div class="da-card">
        <h2>{dt('Link name')}</h2>
        <label class="da-field da-wide"><span>petto.sbs/appeal/</span><input type="text" name="slug" value={config.slug ?? ''} maxlength="32" placeholder={dt('your-server')} autocomplete="off" spellcheck="false" pattern="[A-Za-z0-9\-]{3,32}" /><em>{dt('Letters, numbers and dashes, 3 to 32. The link with the server id keeps working.')}</em></label>
      </div>
      <div class="da-card">
        <h2>{dt('Where appeals arrive')}</h2>
        <div class="da-grid">
          <label class="da-field"><span>{dt('Channel for appeals')}</span><select name="submission_channel_id"><option value="">{dt('Pick a channel')}</option>{channels.map((c) => <option value={c.id} selected={c.id === config.submission_channel_id}>#{c.name}</option>)}</select></label>
          <label class="da-field"><span>{dt('Log channel')}</span><select name="log_channel_id"><option value="">{dt('No log')}</option>{channels.map((c) => <option value={c.id} selected={c.id === config.log_channel_id}>#{c.name}</option>)}</select></label>
          <div class="da-field da-wide"><span>{dt('Roles to ping')}</span><MultiSelect lazy name="ping_role_ids" options={roles} selected={config.ping_role_ids} placeholder={dt('No roles')} /></div>
          <label class="da-check da-wide"><input type="checkbox" name="auto_thread" checked={config.auto_thread} />{dt('Open a thread under each appeal')}</label>
          <label class="da-field da-wide"><span>{dt('Thread name')}</span><input type="text" name="thread_name" value={config.thread_name} maxlength="100" /><em>{dt('You can use {username}.')}</em></label>
        </div>
      </div>
      <div class="da-card">
