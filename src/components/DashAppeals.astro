  .da-chip.rejected { color: var(--red); background: var(--red-soft); }
  .da-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; min-height: 110px; padding: 22px 16px; text-align: center; color: var(--text-dim); }
  .da-empty :global(svg) { color: var(--accent); }
  .da-empty .btn :global(svg) { color: inherit; }
  .da-empty p { margin: 0; font-size: 13.5px; line-height: 1.5; max-width: 340px; }
  .da-empty-panel { display: flex; flex-direction: column; margin-bottom: 14px; }
  .da-col > .da-empty-panel { margin-bottom: 0; }
  .da-bars { display: flex; align-items: flex-end; gap: 6px; height: 150px; }
  .da-bar { position: relative; flex: 1; min-width: 0; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 4px; padding-bottom: 20px; box-sizing: border-box; border-bottom: 1px solid var(--border-soft); }
  .da-bar i { display: block; width: 100%; max-width: 30px; border-radius: 6px 6px 0 0; background: color-mix(in srgb, var(--accent) 55%, transparent); transform-origin: bottom; animation: da-grow .6s var(--m-out) backwards; animation-delay: calc(var(--i, 0) * 25ms); }
  .da-bar-today i { background: var(--accent); }
  .da-bar em { font-style: normal; font-size: 11px; min-height: 13px; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .da-bar span { position: absolute; bottom: 2px; font-size: 10.5px; color: var(--text-dim); }
  @keyframes da-grow { from { transform: scaleY(0); } to { transform: none; } }
  .da-facts { display: flex; flex-direction: column; margin: 0; }
  .da-facts > div { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; padding: 10px 2px 0; margin-top: 10px; border-top: 1px solid var(--border-soft); font-size: 13px; }
  .da-facts dt { color: var(--text-muted); }
  .da-facts dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; }

  /* forms */
  .da-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
  .da-row .btn { display: inline-flex; align-items: center; gap: 6px; }
  .da-formlist { display: flex; flex-direction: column; gap: 10px; margin-bottom: 14px; }
  .da-formrow { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; gap: 14px; align-items: center; border: 1px solid var(--border); border-radius: 14px; padding: 14px 16px; background: var(--card); min-width: 0; transition: border-color .3s ease; }
  .da-formrow:hover { border-color: color-mix(in srgb, var(--text) 24%, var(--border)); }
  .da-formmain { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .da-formtop { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .da-formtop h3 { margin: 0; font-size: 15px; overflow-wrap: anywhere; }
  .da-formmain .sx-hint { overflow-wrap: anywhere; }
  .da-fdesc { margin: 4px 0 0; font-size: 13px; line-height: 1.5; color: var(--text-muted); overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .da-qpreview { margin: 2px 0 0; font-size: 12.5px; color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .da-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .da-formstats { display: flex; gap: 6px; }
  .da-formstats a { display: flex; flex-direction: column; align-items: center; gap: 1px; min-width: 62px; padding: 6px 8px; border-radius: 10px; text-decoration: none; color: inherit; transition: background-color .25s ease; }
  .da-formstats a:hover { background: var(--card-hover); }
  .da-formstats b { font-family: var(--serif); font-size: 20px; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .da-formstats span { font-size: 11.5px; color: var(--text-dim); }
  .da-formstats a.hot b { color: var(--yellow); }
  .da-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .da-actions form { margin: 0; }
  .da-actions .btn { display: inline-flex; align-items: center; gap: 6px; }
  .da-next { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .da-tile { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; text-align: center; min-height: 124px; padding: 18px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); color: inherit; text-decoration: none; min-width: 0; transition: border-color .3s ease, background-color .3s ease; }
  .da-tile:hover { background: var(--card-hover); border-color: color-mix(in srgb, var(--accent) 40%, var(--border)); }
  .da-tile > :global(svg) { color: var(--text-dim); transition: color .3s ease; }
  .da-tile:hover > :global(svg) { color: var(--accent); }
  .da-tile b { font-size: 14.5px; font-weight: 600; }
  .da-back { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--text-muted); text-decoration: none; margin-bottom: 12px; align-self: flex-start; }
  .da-back:hover { color: var(--text); }
  .da-editor { display: flex; flex-direction: column; }
  .da-icons { display: flex; flex-wrap: wrap; gap: 6px; }
  .da-iconpick { position: relative; display: grid; place-items: center; min-width: 40px; height: 40px; padding: 0 10px; border: 1px solid var(--border); border-radius: 11px; color: var(--text-muted); cursor: pointer; font-size: 12.5px; background: var(--card); transition: background-color .3s ease, border-color .3s ease, color .3s ease; }
  .da-iconpick:hover { background: var(--card-hover); color: var(--text); }
  .da-iconpick input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .da-iconpick:has(input:checked) { border-color: var(--green); color: var(--green); background: var(--green-soft); }
  .da-iconpick:has(input:focus-visible), .da-theme:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .sx-one { min-height: 40px; }

  /* appeals list */
  .da-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
  .da-tab { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border: 1px solid var(--border); border-radius: 999px; font-size: 13px; color: var(--text-muted); text-decoration: none; background: var(--card); transition: background-color .3s ease, border-color .3s ease, color .3s ease; }
  .da-tab:hover { background: var(--card-hover); color: var(--text); }
  .da-tab em { font-style: normal; font-size: 11.5px; padding: 1px 8px; border-radius: 999px; background: color-mix(in srgb, var(--text) 8%, transparent); font-variant-numeric: tabular-nums; }
  .da-tab.on { color: var(--green); background: var(--green-soft); border-color: color-mix(in srgb, var(--green) 55%, var(--border)); font-weight: 600; }
  .da-sublist { display: flex; flex-direction: column; gap: 8px; }
  .da-sub > summary { align-items: center; }
