<script>
  // The open conversations ask for new messages every few seconds, and a reply to the member is sent without redrawing the page.
  if (!(window as any).__daLive) {
    (window as any).__daLive = true;
    const base = () => `${location.pathname.replace(/\/appeals\/?$/, '')}/appeals-live`;
    let busy = false;
    async function refresh() {
      if (busy || document.hidden) return;
      const open = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.da-sub[open]')).map((d) => d.querySelector<HTMLElement>('[data-chat]')).filter((el): el is HTMLElement => !!el);
      if (!open.length) return;
      busy = true;
      try {
        const res = await fetch(`${base()}?ids=${open.map((el) => el.dataset.chat).join(',')}`, { headers: { Accept: 'application/json' }, cache: 'no-store' });
        if (!res.ok) throw new Error();
        const data = await res.json();
        open.forEach((box) => {
          box.closest('.da-block')?.querySelector('.da-live')?.classList.remove('off');
          const item = data.items?.[box.dataset.chat ?? ''];
          if (!item || box.innerHTML.trim() === item.html.trim()) return;
          const before = box.querySelectorAll('.da-msg').length;
          box.innerHTML = item.html;
          Array.from(box.querySelectorAll('.da-msg')).slice(before).forEach((el) => el.classList.add('fresh'));
        });
      } catch {
        document.querySelectorAll('.da-live').forEach((el) => el.classList.add('off'));
      } finally {
        busy = false;
      }
    }
    window.setInterval(refresh, 5000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
    // Captured before the dashboard binds the form, so the page is not swapped (that would close the open conversation).
    document.addEventListener('submit', async (event) => {
      const form = (event.target as HTMLElement | null)?.closest?.('form[data-chat-reply]') as HTMLFormElement | null;
      if (!form) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      const box = form.querySelector('textarea')!;
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const content = box.value.trim();
      if (!content || button.disabled) return;
      button.disabled = true;
      form.querySelector('.da-reply-error')?.remove();
      try {
        const res = await fetch(base(), { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ submission_id: form.dataset.sid, content }) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.message || '');
        box.value = '';
        await refresh();
      } catch (err) {
        const note = document.createElement('p');
        note.className = 'da-reply-error';
        note.setAttribute('role', 'alert');
        note.textContent = (err as Error).message || form.dataset.failed || '';
        form.after(note);
      } finally {
        button.disabled = false;
      }
    }, true);
  }
</script>

<script>
  // The builder of the questions of a form: drawn by script on `[data-builder]`.
  function initBuilder() {
    const root = document.querySelector<HTMLElement>('[data-builder]');
    const output = document.querySelector<HTMLInputElement>('[data-builder-output]');
    if (root && output && !root.dataset.bound) {
      root.dataset.bound = '1';
      type Q = { id: string; type: string; label: string; help: string; required: boolean; options: string[]; max?: number; accept?: string; max_files?: number };
      type S = { id: string; title: string; description: string; questions: Q[] };
      const text = JSON.parse(root.dataset.text ?? '{}');
      const limits = JSON.parse(root.dataset.limits ?? '{}');
      const types: string[] = JSON.parse(root.dataset.types ?? '[]');
      let n = 0;
      const nextId = (prefix: string) => `${prefix}${Date.now().toString(36)}${(n++).toString(36)}`.slice(0, 24);
      const state: S[] = (JSON.parse(root.dataset.initial ?? '[]') as any[]).map((s) => ({ id: s.id, title: s.title ?? '', description: s.description ?? '', questions: (s.questions ?? []).map((q: any) => ({ id: q.id, type: q.type, label: q.label ?? '', help: q.help ?? '', required: q.required !== false, options: q.options ?? [], ...(q.max ? { max: q.max } : {}), ...(q.accept ? { accept: q.accept } : {}), ...(q.max_files ? { max_files: q.max_files } : {}) })) }));
      const save = () => { output.value = JSON.stringify(state.map((s) => ({ ...s, description: s.description || null, questions: s.questions.map((q) => ({ ...q, help: q.help || null })) }))); };
      const el = <K extends keyof HTMLElementTagNameMap>(tag: K, props: Record<string, any> = {}, ...kids: (Node | string)[]) => { const e = document.createElement(tag); for (const [k, v] of Object.entries(props)) { if (k === 'class') e.className = v; else if (k === 'on') for (const [ev, fn] of Object.entries(v as Record<string, EventListener>)) e.addEventListener(ev, fn); else if (v !== undefined && v !== null) (e as any)[k] = v; } for (const kid of kids) e.append(kid); return e; };
      const field = (label: string, input: HTMLElement, wide = false) => el('label', { class: `da-field${wide ? ' da-wide' : ''}` }, el('span', {}, label), input);
      const move = <T,>(arr: T[], i: number, d: number) => { const j = i + d; if (j < 0 || j >= arr.length) return; [arr[i], arr[j]] = [arr[j], arr[i]]; draw(); };
      function drawQuestion(s: S, q: Q, qi: number): HTMLElement {
        const type = el('select', { on: { change: (e: Event) => { q.type = (e.target as HTMLSelectElement).value; draw(); } } }, ...types.map((t) => el('option', { value: t, selected: q.type === t }, text.types[t])));
        const label = el('input', { type: 'text', value: q.label, maxLength: limits.label, on: { input: (e: Event) => { q.label = (e.target as HTMLInputElement).value; save(); } } });
        const help = el('input', { type: 'text', value: q.help, maxLength: limits.help, on: { input: (e: Event) => { q.help = (e.target as HTMLInputElement).value; save(); } } });
        const req = el('input', { type: 'checkbox', checked: q.required, on: { change: (e: Event) => { q.required = (e.target as HTMLInputElement).checked; save(); } } });
        const box = el('div', { class: 'da-q' },
          el('div', { class: 'da-q-head' }, el('b', {}, `${text.question} ${qi + 1}`), el('span', { class: 'da-q-tools' },
            el('button', { type: 'button', title: text.up, on: { click: () => move(s.questions, qi, -1) } }, '↑'), el('button', { type: 'button', title: text.down, on: { click: () => move(s.questions, qi, 1) } }, '↓'),
            el('button', { type: 'button', class: 'del', title: text.remove, on: { click: () => { s.questions.splice(qi, 1); draw(); } } }, '×'))),
          el('div', { class: 'da-grid' }, field(text.label, label, true), field('', type), field(text.help, help, true)),
          el('label', { class: 'da-check' }, req, text.required));
        if (q.type === 'scale') {
          if (!q.max) q.max = 5;
          const max = el('select', { on: { change: (e: Event) => { q.max = Number((e.target as HTMLSelectElement).value); save(); } } }, ...[3, 4, 5, 6, 7, 8, 9, 10].map((n) => el('option', { value: String(n), selected: q.max === n }, `1 – ${n}`)));
          box.append(field(text.scaleMax, max));
        }
        if (q.type === 'file') {
          if (!q.accept) q.accept = 'images';
          if (!q.max_files) q.max_files = 3;
          const accept = el('select', { on: { change: (e: Event) => { q.accept = (e.target as HTMLSelectElement).value; save(); } } }, ...['images', 'pdf', 'images_pdf', 'documents'].map((k) => el('option', { value: k, selected: q.accept === k }, text.accepts[k])));
          const many = el('select', { on: { change: (e: Event) => { q.max_files = Number((e.target as HTMLSelectElement).value); save(); } } }, ...[1, 2, 3, 4, 5].map((n) => el('option', { value: String(n), selected: q.max_files === n }, String(n))));
          box.append(el('div', { class: 'da-grid' }, field(text.accept, accept), field(text.maxFiles, many)));
        }
        if (q.type === 'choice' || q.type === 'multi' || q.type === 'dropdown') {
          const area = el('textarea', { rows: 3, value: q.options.join('\n'), on: { input: (e: Event) => { q.options = (e.target as HTMLTextAreaElement).value.split('\n').map((x) => x.trim()).filter(Boolean).slice(0, limits.options); save(); } } });
          box.append(field(text.options, area, true));
        }
        return box;
      }
      function draw() {
        root!.textContent = '';
        state.forEach((s, si) => {
          const title = el('input', { type: 'text', value: s.title, maxLength: 100, on: { input: (e: Event) => { s.title = (e.target as HTMLInputElement).value; save(); } } });
          const desc = el('input', { type: 'text', value: s.description, maxLength: 500, on: { input: (e: Event) => { s.description = (e.target as HTMLInputElement).value; save(); } } });
          const sec = el('div', { class: 'da-section' },
            el('div', { class: 'da-q-head' }, el('h3', {}, `${text.section} ${si + 1}`), el('span', { class: 'da-q-tools' },
              el('button', { type: 'button', title: text.up, on: { click: () => move(state, si, -1) } }, '↑'), el('button', { type: 'button', title: text.down, on: { click: () => move(state, si, 1) } }, '↓'),
              el('button', { type: 'button', class: 'del', title: text.remove, on: { click: () => { state.splice(si, 1); draw(); } } }, '×'))),
            el('div', { class: 'da-grid' }, field(text.title, title), field(text.description, desc)),
            ...s.questions.map((q, qi) => drawQuestion(s, q, qi)),
            el('button', { type: 'button', class: 'btn btn-ghost btn-sm', disabled: s.questions.length >= limits.questions, on: { click: () => { s.questions.push({ id: nextId('q'), type: 'short', label: '', help: '', required: true, options: [] }); draw(); } } }, `+ ${text.addQuestion}`));
          root!.append(sec);
        });
        root!.append(el('button', { type: 'button', class: 'btn btn-ghost btn-sm', disabled: state.length >= limits.sections, on: { click: () => { state.push({ id: nextId('s'), title: '', description: '', questions: [] }); draw(); } } }, `+ ${text.addSection}`));
        save();
      }
      draw();
    }
  }

  // Copy buttons, the live preview of the link and of the messages, and the builder of the questions of a form.
  function initAppeals() {
    document.querySelectorAll<HTMLElement>('[data-copy]').forEach((b) => { if (b.dataset.bound) return; b.dataset.bound = '1'; b.addEventListener('click', () => { navigator.clipboard?.writeText(b.dataset.copy ?? '').catch(() => {}); }); });

    // The pictures of the page: a link typed in the box, or a file from the device that the bot keeps.
    document.querySelectorAll<HTMLElement>('[data-img-field]').forEach((field) => {
      if (field.dataset.bound) return; field.dataset.bound = '1';
      const q = <T extends HTMLElement>(sel: string) => field.querySelector<T>(sel)!;
      const hidden = q<HTMLInputElement>('[data-img-value]'), link = q<HTMLInputElement>('[data-img-link]'), file = q<HTMLInputElement>('[data-img-file]');
      const done = q<HTMLElement>('[data-img-done]'), thumb = q<HTMLImageElement>('[data-img-thumb]'), error = q<HTMLElement>('[data-img-error]');
      const kind = field.dataset.kind ?? '';
      const changed = () => hidden.dispatchEvent(new Event('input', { bubbles: true }));
      const fail = (text: string) => { error.textContent = text; error.hidden = !text; };
      link.addEventListener('input', () => { fail(''); hidden.value = link.value.trim(); changed(); });
      file.addEventListener('change', async () => {
        const picked = file.files?.[0];
        if (!picked) return;
        fail('');
        if (picked.size > 5 * 1024 * 1024) { fail(field.dataset.errBig ?? ''); file.value = ''; return; }
        if (!/^image\/(png|jpeg|webp|gif)$/.test(picked.type)) { fail(field.dataset.errType ?? ''); file.value = ''; return; }
        field.classList.add('busy');
        try {
          const res = await fetch(field.dataset.uploadUrl ?? '', { method: 'POST', body: picked, headers: { 'Content-Type': picked.type } });
          const data = await res.json().catch(() => null);
          if (!res.ok || !data?.ok) fail(data?.error === 'not_an_image' ? field.dataset.errImage ?? '' : field.dataset.errFail ?? '');
          else {
            hidden.value = `upload:${kind}`; link.value = ''; link.disabled = true;
            // The picture the bot kept is loaded back: if it does not show, the person is told instead of seeing a black box.
            thumb.onerror = () => { done.hidden = true; hidden.value = ''; link.disabled = false; fail(field.dataset.errFail ?? ''); changed(); };
            thumb.src = `${field.dataset.previewUrl}?v=${data.version ?? Date.now()}`; done.hidden = false; changed();
          }
        } catch { fail(field.dataset.errFail ?? ''); }
        field.classList.remove('busy'); file.value = '';
      });
      q<HTMLElement>('[data-img-remove]').addEventListener('click', async () => {
        await fetch(field.dataset.uploadUrl ?? '', { method: 'DELETE' }).catch(() => {});
        hidden.value = ''; link.disabled = false; link.value = ''; done.hidden = true; fail(''); changed();
      });
    });

    // "Pick another name": closes the request and puts the cursor in the name field.
    document.querySelectorAll<HTMLElement>('[data-claim-other]').forEach((b) => {
      if (b.dataset.bound) return; b.dataset.bound = '1';
      b.addEventListener('click', () => {
        b.closest<HTMLElement>('[data-claim]')?.remove();
        const field = document.querySelector<HTMLInputElement>('input[name="slug"]:not([type="hidden"])');
        field?.focus(); field?.select(); field?.scrollIntoView({ block: 'center', behavior: 'smooth' });
      });
    });

    const brand = document.querySelector<HTMLElement>('[data-brand]');
    if (brand && !brand.dataset.bound) {
      brand.dataset.bound = '1';
      const prev = (name: string) => brand.querySelector<HTMLElement>(`[data-prev="${name}"]`);
      const sync = () => {
        const val = (n: string) => (brand.querySelector<HTMLInputElement>(`[data-bind="${n}"]`)?.value ?? '').trim();
        const set = (n: string, v: string, fallback?: string) => { const el = prev(n); if (el) el.textContent = v || fallback || el.dataset.default || ''; };
        set('site', val('name'), prev('site')?.textContent ?? '');
        set('title', val('etitle')); set('desc', val('edesc'));
        const img = prev('image'); const url = val('eimage');
        const uploaded = brand.querySelector<HTMLElement>('[data-embed]')?.dataset.uploadEmbed;
        if (img) img.style.backgroundImage = /^https:\/\//.test(url) ? `url(${JSON.stringify(url)})` : url === 'upload:embed' && uploaded ? `url(${JSON.stringify(`${uploaded}?v=${Date.now()}`)})` : '';
      };
      brand.addEventListener('input', sync);
      brand.addEventListener('change', (e) => {
        const t = e.target as HTMLInputElement;
        if (t.name === 'theme') brand.querySelector<HTMLElement>('[data-embed]')?.style.setProperty('--bar', t.dataset.accent ?? '');
        if (t.name === 'embed_thumbnail') brand.querySelector<HTMLElement>('[data-embed]')?.classList.toggle('thumb', t.checked);
      });
    }

    const msgs = document.querySelector<HTMLElement>('[data-messages]');
    if (msgs && !msgs.dataset.bound) {
      msgs.dataset.bound = '1';
      const samples = JSON.parse(msgs.dataset.samples ?? '{}') as Record<string, string>;
      const render = (text: string) => text.replace(/\{(username|user|server|reason|form|link)\}/g, (_m, k) => (k === 'user' ? samples.username : samples[k]) ?? '');
      const paint = () => msgs.querySelectorAll<HTMLElement>('[data-preview]').forEach((el) => {
        const ta = msgs.querySelector<HTMLTextAreaElement>(`[data-msg="${el.dataset.preview}"]`);
        el.textContent = render((ta?.value ?? '').trim() || el.dataset.default || '');
      });
      let last: HTMLTextAreaElement | null = null;
      msgs.addEventListener('focusin', (e) => { if ((e.target as HTMLElement).matches('textarea')) last = e.target as HTMLTextAreaElement; });
      msgs.addEventListener('input', paint);
      msgs.addEventListener('click', (e) => {
        const chip = (e.target as HTMLElement).closest<HTMLElement>('[data-insert]');
        if (!chip) return;
        const ta = last ?? msgs.querySelector<HTMLTextAreaElement>('textarea');
        if (!ta) return;
        const at = ta.selectionStart ?? ta.value.length;
        ta.value = (ta.value.slice(0, at) + chip.dataset.insert + ta.value.slice(ta.selectionEnd ?? at)).slice(0, 1000);
        ta.focus(); ta.dispatchEvent(new Event('input', { bubbles: true }));
      });
      paint();
    }

    // The builder of the questions is set up apart: it must come up whatever happens to the parts above (a page swapped in after a duplicate, say).
    try { initBuilder(); } catch (error) { console.error(error); }
  }
  // The dashboard swaps pages in place: it calls this after every swap, and the first run is right here.
  (window as any).dashAppealsInit = initAppeals;
  initAppeals();
  // Whatever way a page with a builder gets in (a swap after a save, a duplicate, the back button), the builder is drawn when it appears.
  if (!(window as any).__daBuilderWatch) {
    (window as any).__daBuilderWatch = true;
    new MutationObserver(() => { if (document.querySelector('[data-builder]:not([data-bound])')) { try { initBuilder(); } catch (error) { console.error(error); } } }).observe(document.body, { childList: true, subtree: true });
  }
</script>

