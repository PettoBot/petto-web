  [data-builder] .da-field > span:first-child { font-size: 13px; font-weight: 600; color: var(--text); }
  [data-builder] input[type="text"], [data-builder] select, [data-builder] textarea { width: 100%; box-sizing: border-box; min-width: 0; border: 1px solid var(--border); border-radius: 10px; padding: 9px 12px; background: var(--card); color: var(--text); font: inherit; font-size: 13.5px; transition: border-color .25s ease, box-shadow .25s ease; }
  [data-builder] textarea { line-height: 1.5; resize: vertical; }
  [data-builder] input:focus-visible, [data-builder] select:focus-visible, [data-builder] textarea:focus-visible { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  [data-builder] .da-check { display: inline-flex; align-items: center; gap: 10px; width: fit-content; font-size: 13px; color: var(--text-muted); cursor: pointer; }
  [data-builder] .da-check input { appearance: none; -webkit-appearance: none; flex: none; position: relative; width: 38px; height: 22px; margin: 0; border-radius: 999px; background: color-mix(in srgb, var(--text) 22%, var(--card)); cursor: pointer; transition: background-color .3s ease; }
  [data-builder] .da-check input::after { content: ''; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgb(0 0 0 / .35); transition: transform .3s cubic-bezier(.22, 1, .36, 1); }
  [data-builder] .da-check input:checked { background: var(--green); }
  [data-builder] .da-check input:checked::after { transform: translateX(16px); }
