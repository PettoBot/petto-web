  h1 { font-size: 24px; margin: 0 0 16px; }
  .da-claim-note { white-space: pre-line; }
  .da-claim { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); margin-bottom: 14px; }
  .da-claim-text { margin: 0; color: var(--text-muted); font-size: 13px; line-height: 1.55; }
  .da-claim code, .da-claim-ok code { font-family: var(--mono); font-size: 12.5px; color: var(--accent); }
  .da-claim-ok { color: var(--text-muted); background: var(--card); border-color: var(--border); }
  .da-claim-ok.sx-flash-warn { color: var(--text-muted); border-color: color-mix(in srgb, var(--yellow) 55%, var(--border)); background: color-mix(in srgb, var(--yellow) 8%, var(--card)); }
  .da-claim-ok.sx-flash-warn > :global(svg) { color: var(--yellow); }
  .da-claim-ok > :global(svg) { flex: none; color: var(--green); }
  .da-claim-sent { animation: da-pop .45s cubic-bezier(.2, .9, .3, 1.2) both; }
  .da-claim-open { animation: da-pop .45s cubic-bezier(.2, .9, .3, 1.2) both; }
  @keyframes da-pop { from { opacity: 0; transform: translateY(10px) scale(.97); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .da-claim-sent, .da-claim-open, .da-live i, .da-msg.fresh, .da-bar i { animation: none; } }

  /* the overview and the appeals list: two columns that end together */
  .da-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; align-items: start; }
  .da-cols-subs { grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr); }
  .da-col { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
