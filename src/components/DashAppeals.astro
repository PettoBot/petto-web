---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MultiSelect from './MultiSelect.astro';
import ColorPicker from './ColorPicker.astro';
import AppealImageField from './AppealImageField.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import SxNumber from './SxNumber.astro';
import { dashLocale, getDashLang, makeT } from '../i18n/dash';
import { agoText } from '../utils/formatDuration';
import type { NameClaim } from '../utils/appealNames';
import { answerView, pictureUrl, THEMES, LIMITS, FORM_ICONS, QUESTION_TYPES, LIST_TYPES, FILE_ACCEPTS, PUNISHMENT_TYPES, DM_LINK_TYPES, APPEAL_SETTING_LIMITS, BLOCKS, themeFor, hexColor, type AppealConfig } from '../utils/appeals';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null }; guildId: string; guildName: string; guildIcon: string; origin: string;
  section: string; config: AppealConfig; forms: any[]; counts: Record<string, number>; history?: { status: string; created_at: string; form_id?: number | null }[]; latest?: { id: string; username: string; avatar_url: string | null; form_name: string; status: string; created_at: string }[]; submissions: any[]; messages: Record<string, any[]>; statusFilter: string;
  claim?: NameClaim | null; lastClaim?: NameClaim | null; claimSlug?: string | null; claimSent?: boolean;
  roles: { id: string; name: string }[]; channels: { id: string; name: string }[]; editing: any; saved: boolean; message: { kind: 'ok' | 'err'; text: string } | null;
}
const { claim = null, lastClaim = null, claimSlug = null, claimSent = false, user, guildId, guildName, guildIcon, origin, section, config, forms, counts, history = [], latest = [], submissions, messages, statusFilter, roles, channels, editing, message } = Astro.props;
const link = `${origin.replace(/^http:\/\/localhost[^/]*/, 'https://petto.sbs')}/appeal/${config.slug || guildId}`;
const addressOf = config.slug || guildId;
const uploadAction = (kind: string) => `/dash/guild/${guildId}/appeals-image?kind=${kind}`;
const picturePath = (kind: string) => `/appeal/${addressOf}/img/${kind}`;
const embedPreview = pictureUrl(config.embed?.image_url, 'embed', { path: addressOf, origin: '' });
const titles: Record<string, string> = { overview: dt('Appeals'), forms: dt('Appeal forms'), submissions: dt('Appeal submissions'), settings: dt('Appeal settings'), brand: dt('Appeal brand'), messages: dt('Appeal messages') };
const typeNames: Record<string, string> = { ban: dt('Bans'), mute: dt('Mutes'), warn: dt('Warns'), kick: dt('Kicks'), softban: dt('Softbans') };
// The sanctions whose DM can carry the appeal link, one by one.
const dmTypeNames: Record<string, string> = { ban: dt('Bans'), tempban: dt('Temporary bans'), softban: dt('Softbans'), kick: dt('Kicks'), timeout: dt('Timeouts and mutes'), warn: dt('Warns') };
const when = (iso: string) => new Date(iso).toLocaleString(dashLang, { dateStyle: 'medium', timeStyle: 'short' });
const liveForms = forms.filter((f) => f.status === 'live').length;
const theme = themeFor(config.brand);
const monthsOrDays = (days: number) => (days % 30 === 0 && days >= 30 ? { n: days / 30, unit: 'months' } : { n: days, unit: 'days' });
const warnsAge = monthsOrDays(config.warns_max_age_days);
const storeAge = monthsOrDays(config.store_days);
const variableChips = ['{username}', '{server}', '{reason}', '{form}', '{link}'];
// The typed autocomplete of the appeal messages offers these, not the general Petto variables (the appeal texts only know these five).
const appealVars = JSON.stringify([{ l: dt('Appeal messages'), v: [['{username}', dt('Name of the member')], ['{server}', dt('Name of the server')], ['{reason}', dt('Reason the staff wrote')], ['{form}', dt('Name of the form')], ['{link}', dt('Link of the appeal page')]] }]).replace(/</g, '\\u003c');
const sampleVars = { username: 'Liam', server: guildName, reason: dt('You can come back, please read the rules.'), form: dt('Ban appeal'), link: 'petto.sbs/appeal/…' };
// What the members read when nothing is written: in the language the server chose for its appeal page, not the one of the dashboard (the bot has the same texts).
const DEFAULT_MESSAGES: Record<string, Record<string, string>> = {
  en: { submitted: 'Your appeal was sent. The staff of {server} will look at it.', accepted: 'Your appeal was accepted. {reason}', rejected: 'Your appeal was rejected. {reason}', reply: 'The staff of {server} wrote to you about your appeal.' },
  es: { submitted: 'Tu apelación fue enviada. El staff de {server} la revisará.', accepted: 'Tu apelación fue aceptada. {reason}', rejected: 'Tu apelación fue rechazada. {reason}', reply: 'El staff de {server} te escribió sobre tu apelación.' },
  'pt-BR': { submitted: 'Sua apelação foi enviada. A equipe de {server} vai analisá-la.', accepted: 'Sua apelação foi aceita. {reason}', rejected: 'Sua apelação foi recusada. {reason}', reply: 'A equipe de {server} escreveu para você sobre a sua apelação.' },
};
const defaults = DEFAULT_MESSAGES[config.language] ?? DEFAULT_MESSAGES.en;
// The first form of a server is written in the language of its page too.
const STARTER: Record<string, { section: string; question: string }> = {
  en: { section: 'About your punishment', question: 'Why do you think your punishment should be lifted?' },
  es: { section: 'Sobre tu sanción', question: '¿Por qué crees que se debería levantar tu sanción?' },
  'pt-BR': { section: 'Sobre a sua punição', question: 'Por que você acha que a sua punição deveria ser retirada?' },
};
const starter = STARTER[config.language] ?? STARTER.en;
const messageTitles: Record<string, string> = { submitted: dt('When the appeal is sent'), accepted: dt('When it is accepted'), rejected: dt('When it is rejected'), reply: dt('When the staff writes to the member') };
const builderText = { section: dt('Section'), question: dt('Question'), addQuestion: dt('Add a question'), addSection: dt('Add a section'), title: dt('Section title'), description: dt('Description (optional)'), label: dt('Question'), help: dt('Help text (optional)'), required: dt('Required'), options: dt('Options, one per line'), remove: dt('Remove'), up: dt('Move up'), down: dt('Move down'), types: { short: dt('Short answer'), paragraph: dt('Long answer'), choice: dt('Choose one'), multi: dt('Choose several'), yesno: dt('Yes or no'), number: dt('Number'), dropdown: dt('Dropdown list'), scale: dt('Rating scale'), date: dt('Date'), link: dt('Link'), file: dt('File upload'), confirm: dt('Confirmation box') }, scaleMax: dt('The scale goes up to'), accept: dt('Files it accepts'), accepts: { images: dt('Pictures'), pdf: dt('PDF'), images_pdf: dt('Pictures or PDF'), documents: dt('Pictures, PDF or text') }, maxFiles: dt('How many files'), limit: dt('Limit reached') };
const formsBack = `/dash/guild/${guildId}/appeals?section=forms`;
const editForm = editing === 'new' ? { id: null, name: '', icon: '', short_description: '', description: '', status: 'draft', requirement_types: [], block_on_reject: 'none', generate_invite: false, sections: [{ id: 's1', title: starter.section, description: null, questions: [{ id: 'q1', type: 'paragraph', label: starter.question, help: null, required: true, options: [] }] }], messages: {} } : editing;
const blockNames: Record<string, string> = { none: dt("Don't block"), day: dt('Block for a day'), week: dt('Block for a week'), month: dt('Block for a month'), forever: dt('Block for good') };
// What the pages show about the appeals that arrived: the last 500 (status, date and form), from the page. The latest few are listed apart.
const DAY = 86_400_000;
const nowMs = Date.now();
const todayStart = new Date(nowMs); todayStart.setUTCHours(0, 0, 0, 0);
const perDay = Array.from({ length: 14 }, (_, i) => ({ at: todayStart.getTime() - (13 - i) * DAY, n: 0 }));
let weekNow = 0; let weekBefore = 0;
const perForm = new Map<number, { total: number; waiting: number }>();
let oldestWaiting = Infinity;
for (const row of history) {
  const at = Date.parse(row.created_at);
  if (Number.isFinite(at)) {
    const slot = Math.floor((at - perDay[0].at) / DAY);
    if (slot >= 0 && slot < 14) perDay[slot].n += 1;
    if (at >= nowMs - 7 * DAY) weekNow += 1; else if (at >= nowMs - 14 * DAY) weekBefore += 1;
    if (row.status === 'pending' && at < oldestWaiting) oldestWaiting = at;
  }
  if (row.form_id !== null && row.form_id !== undefined) {
    const entry = perForm.get(Number(row.form_id)) ?? { total: 0, waiting: 0 };
    entry.total += 1; if (row.status === 'pending') entry.waiting += 1;
    perForm.set(Number(row.form_id), entry);
  }
}
// The change against the week before only shows when the 500 appeals reach back that far (or there are fewer than 500).
const reachesBack = history.length < 500 || Date.parse(history[history.length - 1]?.created_at ?? '') <= nowMs - 14 * DAY;
const weekChange = !reachesBack ? undefined : weekBefore > 0 ? Math.round(((weekNow - weekBefore) / weekBefore) * 100) : weekNow > 0 ? null : undefined;
const last14 = perDay.reduce((sum, d) => sum + d.n, 0);
const topDay = Math.max(1, ...perDay.map((d) => d.n));
const answered = (counts.accepted ?? 0) + (counts.rejected ?? 0);
const acceptedShare = answered > 0 ? Math.round(((counts.accepted ?? 0) / answered) * 100) : null;
const dayName = (at: number) => new Date(at).toLocaleDateString(dashLang, { day: 'numeric', month: 'short', timeZone: 'UTC' });
const ago = (iso: string) => agoText(dt, iso, { now: nowMs, locale: dashLocale(dashLang), empty: '' });
const statusName: Record<string, string> = { pending: dt('Waiting'), accepted: dt('Accepted'), rejected: dt('Rejected'), withdrawn: dt('Withdrawn') };
const statuses = ['pending', 'accepted', 'rejected', 'withdrawn'] as const;
const statusTiles = [
  { label: dt('Waiting'), value: counts.pending ?? 0, tone: 'reactions' as const },
  { label: dt('Accepted'), value: counts.accepted ?? 0, tone: 'joins' as const },
  { label: dt('Rejected'), value: counts.rejected ?? 0, tone: 'leaves' as const },
  { label: dt('Withdrawn'), value: counts.withdrawn ?? 0, tone: 'invites' as const },
];
const initialOf = (name: string) => (String(name ?? '').trim()[0] ?? '?').toUpperCase();
const questionLabels = (f: any): string[] => (f.sections ?? []).flatMap((sec: any) => (sec.questions ?? []).map((q: any) => String(q.label ?? ''))).filter(Boolean);
const questionCount = (f: any) => (f.sections ?? []).reduce((n: number, s: any) => n + (s.questions?.length ?? 0), 0);
const messageIcons: Record<string, string> = { submitted: 'ph:paper-plane-tilt-fill', accepted: 'ph:check-circle-fill', rejected: 'ph:x-circle-fill', reply: 'ph:chat-teardrop-text-fill' };
const messageColors: Record<string, string> = { submitted: '#6ec6ff', accepted: '#a5ea7a', rejected: '#fe6465', reply: '#f0a88f' };
const setupDone = [Boolean(config.submission_channel_id), liveForms > 0, config.enabled].filter(Boolean).length;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={`appeals-${section}`} pageTitle={titles[section]}>
  <DashSettingsKit />
  <DashFormKit />
  <div class:list={['da-page', `da-s-${section}`, { 'da-fill': (section === 'forms' && !editForm) || section === 'submissions' }]}>
  <h1 class="sx-title">{titles[section]}{section === 'overview' && <span class:list={['sx-pill-state', { on: config.enabled }]}>{config.enabled ? dt('Open') : dt('Closed')}</span>}</h1>
  {(section === 'messages' || (section === 'forms' && editForm)) && <script type="application/json" data-var-groups set:html={appealVars}></script>}
  {message && <div class:list={['sx-flash', { 'sx-flash-bad': message.kind === 'err' }]} role={message.kind === 'err' ? 'alert' : 'status'}><Icon name={message.kind === 'ok' ? 'ph:check-circle-fill' : 'ph:warning-fill'} width="15" height="15" />{message.text}</div>}

  {section === 'overview' && (
    <>
      <DashStatTiles against={dt('vs the week before')} tiles={[...statusTiles, { label: dt('Last 7 days'), value: weekNow, tone: 'messages', change: weekChange }]} />
      <div class="da-cols">
        <div class="da-col">
          <form method="POST" class="da-toggle" data-no-dirty>
            <input type="hidden" name="action" value="toggle" />
            <label class="sx-switch sx-master"><input type="checkbox" name="enabled" checked={config.enabled} /><span class="sx-switch-text"><b>{dt('Take appeals')}</b><em>{dt('While this is off, the page says appeals are closed.')}</em></span><i class="sx-toggle"></i></label>
            <button type="submit" class="btn btn-accent btn-sm">{dt('Save')}</button>
          </form>
          <section class="sx-panel da-block">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--blue)"><Icon name="ph:link-fill" width="17" height="17" /></span><h2>{dt('Your appeal page')}</h2></div>
            <div class="da-link"><code>{link}</code><span class="da-link-btns"><button type="button" class="btn btn-ghost btn-sm" data-copy={link}><Icon name="ph:copy-simple-bold" width="13" height="13" />{dt('Copy')}</button><a class="btn btn-ghost btn-sm" href={link} target="_blank" rel="noopener"><Icon name="ph:arrow-square-out-bold" width="13" height="13" />{dt('Open')}</a></span></div>
            <p class="sx-hint">{dt('Share it in your rules channel or in the message members get when they are punished.')}</p>
          </section>
          <section class="sx-panel da-block">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--green)"><Icon name="ph:list-checks-fill" width="17" height="17" /></span><h2>{dt('Before you open it')}</h2><span class:list={['sx-tag', { 'sx-tag-accent': setupDone === 3 }]}>{dt('{n} of {max}', { n: setupDone, max: 3 })}</span></div>
            <ul class="da-checks">
              <li class:list={{ done: Boolean(config.submission_channel_id) }}><Icon name={config.submission_channel_id ? 'ph:check-circle-fill' : 'ph:circle'} width="18" height="18" /><span>{dt('Pick the channel where appeals arrive')}</span><a href={`/dash/guild/${guildId}/appeals?section=settings`}>{dt('Settings')}</a></li>
              <li class:list={{ done: liveForms > 0 }}><Icon name={liveForms > 0 ? 'ph:check-circle-fill' : 'ph:circle'} width="18" height="18" /><span>{dt('Publish at least one form')}</span><a href={`/dash/guild/${guildId}/appeals?section=forms`}>{dt('Forms')}</a></li>
              <li class:list={{ done: config.enabled }}><Icon name={config.enabled ? 'ph:check-circle-fill' : 'ph:circle'} width="18" height="18" /><span>{dt('Turn on Take appeals')}</span></li>
            </ul>
          </section>
          <section class="sx-panel da-block da-grow">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--red)"><Icon name="ph:clipboard-text-fill" width="17" height="17" /></span><h2>{dt('Appeal forms')}</h2>{forms.length > 0 && <span class="sx-tag">{forms.length}/{LIMITS.forms}</span>}</div>
            {forms.length === 0 ? (
              <div class="da-empty"><Icon name="ph:clipboard-text-fill" width="24" height="24" /><p>{dt('No forms yet. Make one so members have something to fill in.')}</p><a class="btn btn-accent btn-sm" href={`${formsBack}&form=new`}><Icon name="ph:plus-bold" width="12" height="12" />{dt('New form')}</a></div>
            ) : (
              <div class="sx-list dgl-stagger">
                {forms.map((f) => (
                  <a class="sx-row da-miniform" href={`${formsBack}&form=${f.id}`}>
                    <span class="da-formicon da-formicon-sm">{f.icon ? <Icon name={`ph:${f.icon}-fill`} width="16" height="16" /> : <Icon name="ph:clipboard-text-fill" width="16" height="16" />}</span>
                    <span class="da-miniform-text"><b>{f.name}</b><em>{(perForm.get(f.id)?.total ?? 0)} {dt('Appeals')}</em></span>
                    <span class:list={['da-chip', f.status]}>{f.status === 'live' ? dt('Live') : dt('Draft')}</span>
                  </a>
                ))}
              </div>
            )}
          </section>
        </div>
        <div class="da-col">
          <section class="sx-panel da-block da-grow">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:tray-fill" width="17" height="17" /></span><h2>{dt('Latest appeals')}</h2>{latest.length > 0 && <a class="da-all" href={`/dash/guild/${guildId}/appeals?section=submissions`}>{dt('See all')}</a>}</div>
            {latest.length === 0 ? (
              <div class="da-empty"><Icon name="ph:tray-fill" width="24" height="24" /><p>{dt('No appeals yet. They show up here as soon as a member sends one.')}</p></div>
            ) : (
              <div class="sx-list dgl-stagger">
                {latest.map((s) => (
                  <a class="sx-row da-miniform" href={`/dash/guild/${guildId}/appeals?section=submissions&status=${s.status}`}>
                    <span class="da-avatar">{s.avatar_url ? <img src={s.avatar_url} alt="" width="34" height="34" loading="lazy" referrerpolicy="no-referrer" /> : initialOf(s.username)}</span>
                    <span class="da-miniform-text"><b>{s.username}</b><em>{s.form_name} · {ago(s.created_at)}</em></span>
                    <span class={`da-chip ${s.status}`}>{statusName[s.status] ?? s.status}</span>
                  </a>
                ))}
              </div>
            )}
          </section>
          <section class="sx-panel da-block">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:chart-bar-fill" width="17" height="17" /></span><h2>{dt('Appeals in the last 14 days')}</h2>{last14 > 0 && <span class="sx-tag">{last14}</span>}</div>
            {last14 === 0 ? <p class="sx-empty"><Icon name="ph:chart-bar-fill" width="16" height="16" />{dt('No appeals in the last 14 days.')}</p> : (
              <div class="da-bars" role="img" aria-label={dt('Appeals in the last 14 days')}>
                {perDay.map((d, i) => (
                  <div class:list={['da-bar', { 'da-bar-today': i === 13 }]} style={`--i:${i}`} title={`${dayName(d.at)}: ${d.n}`}>
                    <em>{d.n || ''}</em>
                    <i style={`height:${d.n ? Math.max(6, Math.round((d.n / topDay) * 100)) : 3}%`}></i>
                    <span>{new Date(d.at).getUTCDate()}</span>
                  </div>
                ))}
              </div>
            )}
          </section>
        </div>
      </div>
    </>
  )}

  {section === 'forms' && !editForm && (
    <>
      {forms.length > 0 && <DashStatTiles tiles={[
        { label: dt('Forms'), value: forms.length, tone: 'messages' },
        { label: dt('Live'), value: liveForms, tone: 'joins' },
        { label: dt('Draft'), value: forms.length - liveForms, tone: 'reactions' },
        history.length >= 500 ? { label: dt('Appeals'), value: history.length, text: '500+', tone: 'invites' as const } : { label: dt('Appeals'), value: history.length, tone: 'invites' as const },
      ]} />}
      <div class="da-row"><span class="sx-hint">{forms.length}/{LIMITS.forms}</span><a class="btn btn-accent btn-sm" href={`${formsBack}&form=new`}><Icon name="ph:plus-bold" width="12" height="12" />{dt('New form')}</a></div>
      {forms.length === 0 && (
        <div class="sx-panel da-empty-panel">
          <div class="da-empty"><Icon name="ph:clipboard-text-fill" width="28" height="28" /><p>{dt('No forms yet. Make one so members have something to fill in.')}</p><a class="btn btn-accent btn-sm" href={`${formsBack}&form=new`}><Icon name="ph:plus-bold" width="12" height="12" />{dt('New form')}</a></div>
        </div>
      )}
      <div class="da-formlist dgl-stagger">
        {forms.map((f) => {
          const stats = perForm.get(f.id) ?? { total: 0, waiting: 0 };
          const sectionsCount = (f.sections ?? []).length;
          return (
            <div class="da-formrow">
              <span class="da-formicon">{f.icon ? <Icon name={`ph:${f.icon}-fill`} width="20" height="20" /> : <Icon name="ph:clipboard-text-fill" width="20" height="20" />}</span>
              <div class="da-formmain">
                <div class="da-formtop"><h3>{f.name}</h3><span class:list={['da-chip', f.status]}>{f.status === 'live' ? dt('Live') : dt('Draft')}</span></div>
                <p class="sx-hint">{f.short_description || dt('No short description')}</p>
                {f.description && <p class="da-fdesc">{f.description}</p>}
                {questionLabels(f).length > 0 && <p class="da-qpreview">{questionLabels(f).slice(0, 2).join(' · ')}{questionLabels(f).length > 2 ? ` · +${questionLabels(f).length - 2}` : ''}</p>}
                <div class="da-tags">
                  <span class="sx-tag">{questionCount(f)} {dt('questions')}</span>
                  {sectionsCount > 1 && <span class="sx-tag">{sectionsCount} {dt('sections')}</span>}
                  {(f.requirement_types ?? []).length === 0 ? <span class="sx-tag">{dt('Open to anyone')}</span> : (f.requirement_types as string[]).map((t) => <span class="sx-tag sx-tag-accent">{typeNames[t] ?? t}</span>)}
                  {f.generate_invite && <span class="sx-tag">{dt('Single-use invite')}</span>}
                  {f.block_on_reject && f.block_on_reject !== 'none' && <span class="sx-tag sx-tag-red">{blockNames[f.block_on_reject] ?? f.block_on_reject}</span>}
                </div>
              </div>
              <div class="da-formstats">
                <a href={`/dash/guild/${guildId}/appeals?section=submissions`}><b>{stats.total}</b><span>{dt('Appeals')}</span></a>
                <a href={`/dash/guild/${guildId}/appeals?section=submissions&status=pending`} class:list={{ hot: stats.waiting > 0 }}><b>{stats.waiting}</b><span>{dt('Waiting')}</span></a>
              </div>
              <div class="da-actions">
                <a class="btn btn-ghost btn-sm" href={`${formsBack}&form=${f.id}`}><Icon name="ph:pencil-simple-bold" width="12" height="12" />{dt('Edit')}</a>
                <form method="POST" data-no-dirty><input type="hidden" name="action" value="duplicate_form" /><input type="hidden" name="form_id" value={f.id} /><button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:copy-simple-bold" width="12" height="12" />{dt('Duplicate')}</button></form>
              </div>
            </div>
          );
        })}
      </div>
      <div class="da-next">
        <a class="da-tile" href={`/dash/guild/${guildId}/appeals?section=submissions`}><Icon name="ph:tray-fill" width="24" height="24" /><b>{dt('Appeal submissions')}</b><span class="sx-hint">{counts.pending ?? 0} {dt('Waiting')}</span></a>
        <a class="da-tile" href={`/dash/guild/${guildId}/appeals?section=settings`}><Icon name="ph:gear-six-fill" width="24" height="24" /><b>{dt('Appeal settings')}</b><span class="sx-hint">{config.submission_channel_id ? dt('Channel set') : dt('Pick the channel where appeals arrive')}</span></a>
        <a class="da-tile" href={`/dash/guild/${guildId}/appeals?section=brand`}><Icon name="ph:paint-brush-broad-fill" width="24" height="24" /><b>{dt('Appeal brand')}</b><span class="sx-hint">{theme.label}</span></a>
      </div>
    </>
  )}

  {section === 'forms' && editForm && (
    <form method="POST" class="da-editor" data-builder-form>
      <input type="hidden" name="action" value="save_form" />
      {editForm.id && <input type="hidden" name="form_id" value={editForm.id} />}
      <a class="da-back" href={formsBack}><Icon name="ph:arrow-left-bold" width="12" height="12" />{dt('All forms')}</a>
      <div class="sx-stack">
        <section class="sx-panel">
          <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--red)"><Icon name="ph:clipboard-text-fill" width="17" height="17" /></span><h2>{dt('Basics')}</h2></div>
          <div class="sx-grid">
            <div class="sx-field"><label for="af-name">{dt('Name')}</label><textarea id="af-name" name="name" class="dgl-autogrow sx-one" rows="1" data-one-line data-count maxlength="80" required>{editForm.name}</textarea></div>
            <div class="sx-field"><span class="sx-label">{dt('Status')}</span>
              <div class="sx-chips">
                <label class="sx-chip"><input type="radio" name="status" value="draft" checked={editForm.status !== 'live'} /><span>{dt('Draft: nobody sees it')}</span></label>
                <label class="sx-chip"><input type="radio" name="status" value="live" checked={editForm.status === 'live'} /><span>{dt('Live: members can fill it')}</span></label>
              </div>
            </div>
            <div class="sx-field sx-wide"><span class="sx-label">{dt('Icon')}</span><div class="da-icons">{FORM_ICONS.map((key) => <label class="da-iconpick"><input type="radio" name="icon" value={key} checked={editForm.icon === key} /><Icon name={`ph:${key}-fill`} width="18" height="18" /></label>)}<label class="da-iconpick da-iconnone"><input type="radio" name="icon" value="" checked={!editForm.icon} />{dt('None')}</label></div></div>
            <div class="sx-field sx-wide"><label for="af-short">{dt('Short description')}</label><textarea id="af-short" name="short_description" class="dgl-autogrow sx-one" rows="1" data-one-line data-count maxlength="160">{editForm.short_description ?? ''}</textarea><span class="sx-hint">{dt('Shown on the list of forms.')}</span></div>
            <div class="sx-field sx-wide"><label for="af-desc">{dt('Description')}</label><textarea id="af-desc" data-ac name="description" class="dgl-autogrow" data-count maxlength="1500" rows="3">{editForm.description ?? ''}</textarea><span class="sx-hint">{dt('Shown at the top of the form.')}</span></div>
          </div>
        </section>

        <section class="sx-panel">
          <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--blue)"><Icon name="ph:users-three-fill" width="17" height="17" /></span><h2>{dt('Who can open it')}</h2></div>
          <p class="sx-lead">{dt('Leave all empty and anyone can open it. Pick types and the member needs one of those punishments.')}</p>
          <div class="sx-chips">{PUNISHMENT_TYPES.map((t) => <label class="sx-chip"><input type="checkbox" name="requirement_types" value={t} checked={(editForm.requirement_types ?? []).includes(t)} /><span>{typeNames[t]}</span></label>)}</div>
          <div class="sx-sub">
            <div class="sx-field"><span class="sx-label">{dt('When it is rejected')}</span>
              <div class="sx-chips">{BLOCKS.map((b) => <label class="sx-chip"><input type="radio" name="block_on_reject" value={b} checked={editForm.block_on_reject === b} /><span>{blockNames[b]}</span></label>)}</div>
            </div>
            <div class="sx-switches da-one-col"><label class="sx-switch"><input type="checkbox" name="generate_invite" checked={editForm.generate_invite} /><span class="sx-switch-text"><b>{dt('Give a single-use invite when an appeal is accepted')}</b></span><i class="sx-toggle"></i></label></div>
          </div>
        </section>

        <section class="sx-panel">
          <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--green)"><Icon name="ph:list-checks-fill" width="17" height="17" /></span><h2>{dt('Questions')}</h2></div>
          <div data-builder data-initial={JSON.stringify(editForm.sections ?? [])} data-text={JSON.stringify(builderText)} data-limits={JSON.stringify(LIMITS)} data-types={JSON.stringify(QUESTION_TYPES)}></div>
          <input type="hidden" name="sections_json" data-builder-output />
        </section>

        <section class="sx-panel">
          <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:chat-teardrop-text-fill" width="17" height="17" /></span><h2>{dt('Messages for this form')}</h2></div>
          <p class="sx-lead">{dt('Leave empty to use the messages of the Messages page.')}</p>
          <div class="sx-grid">
            {['submitted', 'accepted', 'rejected'].map((k) => <div class="sx-field sx-wide"><label for={`af-msg-${k}`}>{messageTitles[k]}</label><textarea id={`af-msg-${k}`} name={`msg_${k}`} class="dgl-autogrow" data-count maxlength="1000" rows="2" placeholder={defaults[k]} data-ac="vars,emojis">{editForm.messages?.[k] ?? ''}</textarea></div>)}
          </div>
        </section>
        <div class="sx-foot"><button type="submit" class="btn btn-accent"><Icon name="ph:check-bold" width="13" height="13" />{dt('Save form')}</button></div>
      </div>
    </form>
  )}
  {section === 'forms' && editForm && editForm.id && (
    <form method="POST" class="da-danger" data-confirm={dt('Delete this form? Appeals already sent stay.')} data-no-dirty>
      <input type="hidden" name="action" value="delete_form" /><input type="hidden" name="form_id" value={editForm.id} />
      <button type="submit" class="da-del"><Icon name="ph:trash-bold" width="13" height="13" />{dt('Delete form')}</button>
    </form>
  )}

  {section === 'submissions' && (
    <>
      <DashStatTiles tiles={statusTiles} />
      <div class="da-tabs">
        {statuses.map((s) => <a href={`/dash/guild/${guildId}/appeals?section=submissions&status=${s}`} class:list={['da-tab', { on: statusFilter === s }]}>{statusName[s]}<em>{counts[s] ?? 0}</em></a>)}
      </div>
      <div class="da-cols da-cols-subs da-grow">
        <div class="da-col">
          {submissions.length === 0 && <div class="sx-panel da-empty-panel"><div class="da-empty"><Icon name="ph:tray-fill" width="28" height="28" /><p>{dt('Nothing here.')}</p></div></div>}
          <div class="da-sublist dgl-stagger">
            {submissions.map((s) => {
              const first = (s.answers ?? []).map((a: any) => answerView(a)).find((v: any) => v.kind === 'text' && String(v.text).trim());
              return (
              <details class="dfx-acc da-sub">
                <summary>
                  <span class="da-avatar">{s.avatar_url ? <img src={s.avatar_url} alt="" width="34" height="34" loading="lazy" referrerpolicy="no-referrer" /> : initialOf(s.username)}</span>
                  <span class="dfx-acc-title"><b>{s.username}</b><em>{s.form_name} · {when(s.created_at)}</em>{first && <small class="da-peek">{first.text}</small>}</span>
                  <span class={`da-chip ${s.status}`}>{statusName[s.status] ?? s.status}</span>
                  <Icon name="ph:caret-down-bold" class="dfx-caret" width="14" height="14" />
                </summary>
                <div class="dfx-acc-body da-body">
                  {(s.punishments ?? []).length > 0 && <div class="da-block-in"><h4>{dt('Punishments')}</h4><ul class="da-puns">{s.punishments.map((p: any) => <li><span class="sx-tag sx-tag-red">{typeNames[p.type] ?? p.type}{p.case ? ` #${p.case}` : ''}</span>{p.reason && <span>{p.reason}</span>}{p.until && <small>{when(p.until)}</small>}</li>)}</ul></div>}
                  <div class="da-block-in"><h4>{dt('Answers')}</h4><div class="da-answers">{(s.answers ?? []).map((a: any) => {
                    const view = answerView(a);
                    return <div class="da-ans"><b>{a.label}</b>{view.kind === 'text' ? <span>{view.text}</span> : (
                      <span class="da-ans-files">{view.files.map((f) => f.mime.startsWith('image/')
                        ? <a href={`/dash/guild/${guildId}/appeals-file?f=${f.id}`} target="_blank" rel="noopener" class="da-ans-pic" title={f.name}><img src={`/dash/guild/${guildId}/appeals-file?f=${f.id}`} alt={f.name} loading="lazy" /></a>
                        : <a href={`/dash/guild/${guildId}/appeals-file?f=${f.id}`} target="_blank" rel="noopener" class="da-ans-doc"><Icon name="ph:file-text-bold" width="13" height="13" />{f.name}</a>)}</span>
                    )}</div>;
                  })}</div></div>
                  <div class="da-block da-block-in"><h4>{dt('Conversation')} <span class="da-live"><i></i>{dt('Updates live')}</span></h4>
                    <div class="da-chat" data-chat={s.id}>
                    {(messages[s.id] ?? []).map((m: any) => <div class:list={['da-msg', m.author_type]}><small>{m.author_type === 'user' ? s.username : m.author_type === 'staff' ? (m.author_name ?? dt('Staff')) : 'Petto'} · {when(m.created_at)}</small><span>{m.content}</span></div>)}
                    {(messages[s.id] ?? []).length === 0 && <p class="sx-hint" data-chat-empty>{dt('No messages yet.')}</p>}
                    </div>
                  </div>
                  <form method="POST" class="da-inline" data-no-dirty data-chat-reply data-sid={s.id} data-failed={dt('It could not be saved, try again.')}><input type="hidden" name="action" value="reply" /><input type="hidden" name="submission_id" value={s.id} /><textarea name="content" class="dgl-autogrow" rows="2" maxlength="1500" placeholder={dt('Write to the member')} aria-label={dt('Write to the member')} required></textarea><button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:paper-plane-tilt-fill" width="13" height="13" />{dt('Send')}</button></form>
                  {s.status === 'pending' && (
                    <form method="POST" class="da-resolve" data-no-dirty>
                      <input type="hidden" name="action" value="resolve" /><input type="hidden" name="submission_id" value={s.id} />
                      <textarea name="reason" class="dgl-autogrow" rows="2" maxlength="800" placeholder={dt('Reason (the member sees it)')} aria-label={dt('Reason')}></textarea>
                      <span class="da-resolve-btns"><button type="submit" name="status" value="accepted" class="btn btn-accent btn-sm"><Icon name="ph:check-bold" width="13" height="13" />{dt('Accept')}</button>
                      <button type="submit" name="status" value="rejected" class="da-reject"><Icon name="ph:x-bold" width="12" height="12" />{dt('Reject')}</button></span>
                    </form>
                  )}
                  {s.status !== 'pending' && s.resolution_reason && <p class="sx-hint da-reason">{dt('Reason')}: {s.resolution_reason}</p>}
                  {s.status === 'accepted' && s.invite_note && <p class="sx-hint">{dt('Invite')}: {s.invite_url ? <code>{s.invite_url}</code> : null} <span>({s.invite_note})</span></p>}
                </div>
              </details>
              );
            })}
          </div>
        </div>
        <div class="da-col da-aside">
          <section class="sx-panel da-block">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:chart-bar-fill" width="17" height="17" /></span><h2>{dt('Appeals in the last 14 days')}</h2>{last14 > 0 && <span class="sx-tag">{last14}</span>}</div>
            {last14 === 0 ? <p class="sx-empty"><Icon name="ph:chart-bar-fill" width="16" height="16" />{dt('No appeals in the last 14 days.')}</p> : (
              <div class="da-bars" role="img" aria-label={dt('Appeals in the last 14 days')}>
                {perDay.map((d, i) => (
                  <div class:list={['da-bar', { 'da-bar-today': i === 13 }]} style={`--i:${i}`} title={`${dayName(d.at)}: ${d.n}`}>
                    <em>{d.n || ''}</em>
                    <i style={`height:${d.n ? Math.max(6, Math.round((d.n / topDay) * 100)) : 3}%`}></i>
                    <span>{new Date(d.at).getUTCDate()}</span>
                  </div>
                ))}
              </div>
            )}
            <dl class="da-facts">
              <div><dt>{dt('Accepted share of the answered')}</dt><dd>{acceptedShare === null ? '–' : `${acceptedShare}%`}</dd></div>
              <div><dt>{dt('Waiting the longest')}</dt><dd>{Number.isFinite(oldestWaiting) ? ago(new Date(oldestWaiting).toISOString()) : '–'}</dd></div>
            </dl>
          </section>
          <section class="sx-panel da-block da-grow">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--red)"><Icon name="ph:clipboard-text-fill" width="17" height="17" /></span><h2>{dt('Appeal forms')}</h2>{forms.length > 0 && <span class="sx-tag">{forms.length}/{LIMITS.forms}</span>}</div>
            {forms.length === 0 ? (
              <div class="da-empty"><Icon name="ph:clipboard-text-fill" width="24" height="24" /><p>{dt('No forms yet. Make one so members have something to fill in.')}</p><a class="btn btn-accent btn-sm" href={`${formsBack}&form=new`}><Icon name="ph:plus-bold" width="12" height="12" />{dt('New form')}</a></div>
            ) : (
              <div class="sx-list">
                {forms.map((f) => (
                  <a class="sx-row da-miniform" href={`${formsBack}&form=${f.id}`}>
                    <span class="da-formicon da-formicon-sm">{f.icon ? <Icon name={`ph:${f.icon}-fill`} width="16" height="16" /> : <Icon name="ph:clipboard-text-fill" width="16" height="16" />}</span>
                    <span class="da-miniform-text"><b>{f.name}</b><em>{(perForm.get(f.id)?.total ?? 0)} {dt('Appeals')}</em></span>
                    <span class:list={['da-chip', f.status]}>{f.status === 'live' ? dt('Live') : dt('Draft')}</span>
                  </a>
                ))}
              </div>
            )}
          </section>
        </div>
      </div>
    </>
  )}

  {section === 'settings' && (
    <Fragment>
    {claim && (
      <section class="sx-panel da-claim da-claim-open">
        <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:hourglass-fill" width="17" height="17" /></span><h2>{dt('Name request')}: <code>{claim.slug}</code></h2></div>
        <p class="da-claim-text">{dt('The team is reviewing it. A review takes from 1 hour up to 72 hours.')}</p>
        <p class="da-claim-text">{dt('Until then your page uses the link with the server id:')} <code>{`petto.sbs/appeal/${guildId}`}</code></p>
        <form method="POST" data-no-dirty><input type="hidden" name="action" value="claim_cancel" /><button type="submit" class="btn btn-ghost btn-sm">{dt('Cancel the request')}</button></form>
      </section>
    )}
    {!claim && claimSent && <div class="sx-flash da-claim-sent" role="status"><Icon name="ph:check-circle-fill" width="16" height="16" />{dt('Request sent. The team will answer in 1 to 72 hours.')}</div>}
    {!claim && !claimSlug && lastClaim && (
      <div class:list={['sx-flash', 'da-claim-ok', { 'sx-flash-warn': lastClaim.status !== 'approved' }]}>
        <Icon name={lastClaim.status === 'approved' ? 'ph:check-circle-fill' : 'ph:warning-fill'} width="15" height="15" /><span>{lastClaim.status === 'approved' ? dt('Your request for this name was accepted:') : dt('Your last name request was denied:')} <code>{lastClaim.slug}</code>{lastClaim.note ? <span class="da-claim-note">{` · ${lastClaim.note}`}</span> : ''}</span>
      </div>
    )}
    {!claim && claimSlug && (
      <form method="POST" class="sx-panel da-claim" data-claim data-no-dirty>
        <input type="hidden" name="action" value="claim_send" />
        <input type="hidden" name="slug" value={claimSlug} />
        <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:key-fill" width="17" height="17" /></span><h2>{dt('Ask for this name')}: <code>{claimSlug}</code></h2></div>
        <p class="da-claim-text">{dt('Another server has this name. If it should be yours, tell the team why. A review takes from 1 hour up to 72 hours.')}</p>
        <p class="da-claim-text">{dt('While you wait, your page uses the link with the server id. You can also pick another name or cancel.')}</p>
        <div class="sx-field"><label for="da-claim-reason">{dt('Why should it be yours?')}</label><textarea id="da-claim-reason" name="reason" class="dgl-autogrow" rows="4" minlength="20" maxlength="1000" data-count required placeholder={dt('For example: it is the name of our community, we use it in our other platforms…')}></textarea></div>
        <div class="sx-grid">
          <div class="sx-field"><label for="da-claim-url">{dt('Link to see your server')}</label><input id="da-claim-url" type="url" name="server_url" maxlength="300" required placeholder="https://discord.gg/…" /><span class="sx-hint">{dt('An invite, so the team can look at the server.')}</span></div>
          <div class="sx-field"><label for="da-claim-extra">{dt('Extra proof (optional)')}</label><input id="da-claim-extra" type="url" name="extra_url" maxlength="300" placeholder="https://…" /><span class="sx-hint">{dt('Your website, social profile or anything that shows the name is yours.')}</span></div>
        </div>
        <div class="da-actions">
          <button type="submit" class="btn btn-accent">{dt('Send request')}</button>
          <button type="button" class="btn btn-ghost" data-claim-other>{dt('Pick another name')}</button>
          <a class="btn btn-ghost" href="?section=settings">{dt('Cancel')}</a>
        </div>
      </form>
    )}
    <form method="POST" class="da-editor">
      <input type="hidden" name="action" value="save_settings" />
      <div class="sx-stack">
        <div class="sx-duo da-duo">
          <div class="sx-stack">
            <section class="sx-panel">
              <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--blue)"><Icon name="ph:link-fill" width="17" height="17" /></span><h2>{dt('Link name')}</h2></div>
              <div class="sx-field">
                <label for="da-slug">{dt('Name of the link')}</label>
                <div class="da-prefix"><span>petto.sbs/appeal/</span><input id="da-slug" type="text" name="slug" value={config.slug ?? ''} maxlength="32" placeholder={dt('your-server')} autocomplete="off" spellcheck="false" pattern="[A-Za-z0-9\-]{3,32}" /></div>
                <span class="sx-hint">{dt('Letters, numbers and dashes, 3 to 32. The link with the server id keeps working.')}</span>
              </div>
            </section>
            <section class="sx-panel">
              <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--green)"><Icon name="ph:seal-check-fill" width="17" height="17" /></span><h2>{dt('Accepted appeals')}</h2></div>
              <label class="sx-switch"><input type="checkbox" name="auto_invite" checked={config.auto_invite} /><span class="sx-switch-text"><b>{dt('Make a new single-use invite for each accepted appeal')}</b></span><i class="sx-toggle"></i></label>
              <p class="sx-hint">{dt('The invite that was made is shown on the appeal card in Discord, in the log and here in the appeal. It works once and lasts 7 days. If Petto cannot make one, it says why (it needs Create Invite in a text channel) and uses the invite code below if there is one.')}</p>
              <div class="sx-field"><label for="da-rejoin">{dt('Invite code to rejoin')}</label><input id="da-rejoin" type="text" name="rejoin_invite_code" value={config.rejoin_invite_code ?? ''} maxlength="40" data-count placeholder="discord.gg/…" /></div>
              <div class="sx-field"><span class="sx-label">{dt('Keep answered appeals for')}</span><div class="da-pair"><SxNumber name="store_age" min="1" max="365" value={storeAge.n} aria-label={dt('Keep answered appeals for')} />
                <div class="sx-chips da-unit-chips"><label class="sx-chip"><input type="radio" name="store_unit" value="days" checked={storeAge.unit === 'days'} /><span>{dt('days')}</span></label><label class="sx-chip"><input type="radio" name="store_unit" value="months" checked={storeAge.unit === 'months'} /><span>{dt('months')}</span></label></div></div><span class="sx-hint">{dt('After that they are deleted for good.')}</span></div>
            </section>
          </div>
          <section class="sx-panel">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:tray-fill" width="17" height="17" /></span><h2>{dt('Where appeals arrive')}</h2></div>
            <div class="sx-grid">
              <div class="sx-field"><label for="da-ch">{dt('Channel for appeals')}</label><select id="da-ch" name="submission_channel_id"><option value="">{dt('Pick a channel')}</option>{channels.map((c) => <option value={c.id} selected={c.id === config.submission_channel_id}>#{c.name}</option>)}</select></div>
              <div class="sx-field"><label for="da-log">{dt('Log channel')}</label><select id="da-log" name="log_channel_id"><option value="">{dt('No log')}</option>{channels.map((c) => <option value={c.id} selected={c.id === config.log_channel_id}>#{c.name}</option>)}</select></div>
              <div class="sx-field sx-wide"><span class="sx-label">{dt('Roles to ping')}</span><MultiSelect lazy name="ping_role_ids" options={roles} selected={config.ping_role_ids} placeholder={dt('No roles')} /></div>
            </div>
            <div class="sx-switches da-one-col"><label class="sx-switch"><input type="checkbox" name="auto_thread" checked={config.auto_thread} /><span class="sx-switch-text"><b>{dt('Open a thread under each appeal')}</b></span><i class="sx-toggle"></i></label></div>
            <div class="sx-field" data-sx-needs="auto_thread"><label for="da-thread">{dt('Thread name')}</label><textarea id="da-thread" name="thread_name" class="dgl-autogrow sx-one" rows="1" data-one-line data-count maxlength="100">{config.thread_name}</textarea><span class="sx-hint">{dt('You can use {username}.')}</span></div>
          </section>
        </div>
        <section class="sx-panel">
          <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--green)"><Icon name="ph:eye-fill" width="17" height="17" /></span><h2>{dt('What the member sees')}</h2></div>
          <div class="sx-field"><span class="sx-label">{dt('Punishments they can see')}</span><div class="sx-chips">{PUNISHMENT_TYPES.map((t) => <label class="sx-chip"><input type="checkbox" name="punishment_types" value={t} checked={config.punishment_types.includes(t)} /><span>{typeNames[t]}</span></label>)}</div></div>
          <div class="sx-field"><span class="sx-label">{dt('Details they can see')}</span><div class="sx-chips">
            <label class="sx-chip"><input type="checkbox" name="punishment_details" value="reason" checked={config.punishment_details.includes('reason')} /><span>{dt('Reason')}</span></label>
            <label class="sx-chip"><input type="checkbox" name="punishment_details" value="duration" checked={config.punishment_details.includes('duration')} /><span>{dt('Duration')}</span></label>
            <label class="sx-chip"><input type="checkbox" name="punishment_details" value="moderator" checked={config.punishment_details.includes('moderator')} /><span>{dt('Moderator')}</span></label>
          </div></div>
          <div class="sx-grid">
            <div class="sx-field"><span class="sx-label">{dt('Where punishments come from')}</span><div class="sx-chips">
              <label class="sx-chip"><input type="radio" name="punishment_source" value="both" checked={config.punishment_source === 'both'} /><span>Petto + Discord</span></label>
              <label class="sx-chip"><input type="radio" name="punishment_source" value="petto" checked={config.punishment_source === 'petto'} /><span>Petto</span></label>
              <label class="sx-chip"><input type="radio" name="punishment_source" value="discord" checked={config.punishment_source === 'discord'} /><span>Discord</span></label>
            </div></div>
            <div class="sx-field"><span class="sx-label">{dt('Page language')}</span><div class="sx-chips">
              <label class="sx-chip"><input type="radio" name="language" value="en" checked={config.language === 'en'} /><span>English</span></label>
              <label class="sx-chip"><input type="radio" name="language" value="es" checked={config.language === 'es'} /><span>Español</span></label>
              <label class="sx-chip"><input type="radio" name="language" value="pt-BR" checked={config.language === 'pt-BR'} /><span>Português</span></label>
            </div></div>
