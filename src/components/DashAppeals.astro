  .da-link { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .da-link code { flex: 1 1 200px; min-width: 0; font-family: var(--mono); font-size: 12.5px; background: color-mix(in srgb, var(--text) 4%, var(--card)); border: 1px solid var(--border-soft); border-radius: 9px; padding: 8px 11px; color: var(--accent); overflow-wrap: anywhere; }
  .da-link-btns { display: inline-flex; gap: 8px; }
  .da-link-btns .btn { display: inline-flex; align-items: center; gap: 6px; }
  .da-checks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .da-checks li { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid var(--border-soft); border-radius: 12px; background: color-mix(in srgb, var(--text) 3%, var(--card)); color: var(--text-muted); font-size: 13.5px; min-width: 0; }
  .da-checks li > :global(svg) { flex: none; color: var(--text-dim); }
  .da-checks li.done { color: var(--text); }
  .da-checks li.done > :global(svg) { color: var(--green); }
  .da-checks li span { min-width: 0; }
  .da-checks a { margin-left: auto; flex: none; color: var(--accent); font-size: 12.5px; }
  .da-miniform { text-decoration: none; color: inherit; }
  .da-miniform-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .da-miniform-text b { font-size: 13.5px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .da-miniform-text em { font-style: normal; font-size: 12px; color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .da-all { margin-left: auto; font-size: 12.5px; color: var(--accent); text-decoration: none; }
  .da-all:hover { text-decoration: underline; }
  .da-avatar { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; overflow: hidden; background: var(--accent-soft); color: var(--accent); font: 700 14px var(--sans); }
  .da-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .da-formicon { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; color: var(--accent); background: var(--accent-soft); }
  .da-formicon-sm { width: 34px; height: 34px; border-radius: 10px; }
  .da-chip { flex: none; font: 600 11.5px var(--sans); padding: 3px 10px; border-radius: 999px; color: var(--text-dim); background: color-mix(in srgb, var(--text) 7%, transparent); white-space: nowrap; }
  .da-chip.live, .da-chip.accepted { color: var(--green); background: var(--green-soft); }
