  .da-msg.fresh { animation: da-msg-in .35s cubic-bezier(.2, .8, .2, 1) both; }
  @keyframes da-msg-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  /* The question builder is drawn by script, so its rules cannot be scoped to the component. */
  [data-builder] .da-section { border: 1px solid var(--border); border-radius: 14px; padding: 16px; display: flex; flex-direction: column; gap: 14px; margin-bottom: 14px; background: color-mix(in srgb, var(--text) 3%, var(--card)); }
  [data-builder] .da-q { border: 1px solid var(--border-soft); border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 12px; background: var(--card); }
