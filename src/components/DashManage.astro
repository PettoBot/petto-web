---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Guild {
  id: string;
  name: string;
  icon: string | null;
  tag: string;
  active: boolean;
  premiumActive: boolean;
  memberCount?: number | null;
}
interface Props {
  user: { username: string; avatar: string | null };
  guilds: Guild[];
  inviteUrl: (guildId: string) => string;
  isOwner: boolean;
  canPartners?: boolean;
  error?: string;
}
const { user, guilds, inviteUrl, isOwner, canPartners = false, error } = Astro.props;
const withPetto = guilds.filter((g) => g.active);
const withoutPetto = guilds.filter((g) => !g.active);
const groups = [
  { key: 'with', title: dt('Servers with Petto'), list: withPetto },
  { key: 'without', title: dt('Servers without Petto'), list: withoutPetto },
].filter((group) => group.list.length);
let cardIndex = 0;
---
<Base title={dt('Manage servers · Petto')} active="dash" showFooter>
  <main>
    <section class="dm-sec">
      <div class="wrap dm-wrap">
        <div class="dm-head">
          <div class="dm-head-user">
            {user.avatar ? <img src={user.avatar} alt="" class="dm-user-av" /> : <div class="dm-user-av dm-user-av-fallback"><Icon name="ph:user-fill" width="18" height="18" /></div>}
            <div>
              <div class="dm-logged-label">{dt('Logged in as')}</div>
              <div class="dm-user-name">{user.username}</div>
            </div>
          </div>
          <a class="dm-logout" href="/dash/logout">
            <Icon name="ph:sign-out-fill" width="14" height="14" />
            {dt('Log out')}
          </a>
        </div>
        <div class="dm-note-row">
          <p class="dm-note">{dt('Servers where you have Manage Server or Administrator. "Manage" opens servers Petto is already in, "Add Bot" invites it to the rest.')}</p>
          <div class="dm-actions">
            <a class="btn btn-ghost btn-sm dm-premium-link" href="/dash/premium"><Icon name="ph:crown-fill" width="13" height="13" /> {dt('Premium servers')}</a>
            <a class="btn btn-ghost btn-sm dm-premium-link" href="/dash/history"><Icon name="ph:clock" width="13" height="13" /> {dt('History')}</a>
            {isOwner && <a class="btn btn-ghost btn-sm dm-premium-link" href="/dash/admin"><Icon name="ph:gift-fill" width="13" height="13" /> {dt("Owner grants")}</a>}
            {canPartners && <a class="btn btn-ghost btn-sm dm-premium-link" href="/dash/partners-admin"><Icon name="ph:handshake-fill" width="13" height="13" /> {dt('Partners')}</a>}
            {canPartners && <a class="btn btn-ghost btn-sm dm-premium-link" href="/dash/credits-admin"><Icon name="ph:heart-fill" width="13" height="13" /> {dt('Credits')}</a>}
            {canPartners && <a class="btn btn-ghost btn-sm dm-premium-link" href="/dash/appeal-names"><Icon name="ph:scales-fill" width="13" height="13" /> {dt('Appeal names')}</a>}
            {isOwner && <a class="btn btn-ghost btn-sm dm-premium-link" href="/dash/team"><Icon name="ph:users-three-fill" width="13" height="13" /> {dt('Team')}</a>}
            {isOwner && <a class="btn btn-ghost btn-sm dm-premium-link" href="/dash/admin/servers"><Icon name="ph:hard-drives-fill" width="13" height="13" /> {dt('All servers')}</a>}
          </div>
        </div>

        {error === 'discord_unavailable' ? (
          <p class="dm-empty dm-error">{dt('Discord no respondió a tiempo. Recarga la página en unos segundos para volver a cargar tus servidores.')}</p>
        ) : guilds.length === 0 ? (
          <p class="dm-empty">{dt('No servers found where you can manage Petto. You need Manage Server or Administrator permission on a server first.')}</p>
        ) : (
          <Fragment>
          <div class="dm-search">
            <Icon name="ph:magnifying-glass" width="14" height="14" />
            <input type="search" id="dm-search" placeholder={dt('Search servers')} aria-label={dt('Search servers')} autocomplete="off" />
          </div>
          {groups.map((group) => (
            <div class="dm-group" data-group={group.key}>
              <h2 class="dm-group-title">{group.title} <span class="dm-group-count">{group.list.length}</span></h2>
              <div class="dm-grid">
                {group.list.map((g) => { const index = cardIndex++; return (
              <div data-name={g.name.toLowerCase()} class:list={['dm-card', { 'dm-card-inactive': !g.active, 'dm-card-premium': g.premiumActive }]} style={`--i:${Math.min(index, 12)}`}>
                <div class="dm-card-banner">
                  <img src={g.icon ?? '/assets/dash-guild-fallback.avif'} alt="" class="dm-card-banner-bg" loading="lazy" decoding="async" />
                  <span class:list={['dm-plan-badge', { 'dm-plan-badge-premium': g.premiumActive }]}>
                    {g.premiumActive && <Icon name="ph:crown-fill" width="12" height="12" />}
                    {g.premiumActive ? dt('Premium active') : dt('Free')}
                  </span>
                </div>
                <img src={g.icon ?? '/assets/dash-guild-fallback.avif'} alt="" class="dm-card-icon" loading="lazy" decoding="async" />
                <div class="dm-card-body">
                  <div class="dm-card-name">{g.name}</div>
                  <div class="dm-card-tag">{g.active ? (g.memberCount != null ? `${g.memberCount.toLocaleString('en-US')} ${dt('members')} · ${dt(g.tag)}` : dt(g.tag)) : dt('Petto not added')}</div>
                  {g.active ? (
                    <a class="btn btn-ghost btn-sm dm-card-btn" href={`/dash/guild/${g.id}/overview`}>
                      <Icon name="ph:gear-fill" width="13" height="13" />
                      {dt('Manage Guild')}
                    </a>
                  ) : (
                    <a class="btn btn-sm dm-card-btn dm-card-btn-invite" href={inviteUrl(g.id)} target="_blank" rel="noopener">
                      <Icon name="ph:share-network-fill" width="13" height="13" />
                      {dt('Add Bot')}
                    </a>
                  )}
                  {g.active && (
                    <a class="btn btn-ghost btn-sm dm-card-btn dm-card-vanity" href={`/dash/guild/${g.id}/vanity`}>
                      <Icon name="ph:sparkle-fill" width="13" height="13" />
                      {dt('Vanity roles')}
                    </a>
                  )}
                </div>
              </div>
                ); })}
              </div>
            </div>
          ))}
          <p class="dm-empty dm-nomatch" id="dm-nomatch" hidden>{dt('No server matches your search.')}</p>
          </Fragment>
        )}
      </div>
    </section>
  </main>
</Base>

<script>
  // The search filters both lists by name; a list with nothing left hides its title too.
  const box = document.getElementById('dm-search') as HTMLInputElement | null;
  const none = document.getElementById('dm-nomatch');
  box?.addEventListener('input', () => {
    const term = box.value.trim().toLowerCase();
    let shown = 0;
    document.querySelectorAll<HTMLElement>('.dm-group').forEach((group) => {
      let inGroup = 0;
      group.querySelectorAll<HTMLElement>('.dm-card').forEach((card) => {
        const match = !term || (card.dataset.name ?? '').includes(term);
        card.hidden = !match;
        if (match) inGroup += 1;
      });
      group.hidden = inGroup === 0;
      shown += inGroup;
    });
    if (none) none.hidden = shown > 0;
  });
</script>

<style>
  .dm-sec { padding: 56px 0 100px; }
  .dm-wrap { max-width: 1320px; }
  .dm-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
  .dm-head-user { display: flex; align-items: center; gap: 12px; }
  .dm-user-av { width: 42px; height: 42px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border); }
  .dm-user-av-fallback { display: flex; align-items: center; justify-content: center; background: var(--bg-raise); color: var(--text-dim); }
  .dm-logged-label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-dim); }
  .dm-user-name { font-family: var(--serif); font-size: 17px; font-weight: 600; color: var(--text); }
  .dm-logout { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--text-dim); text-decoration: none; }
  .dm-logout:hover { color: var(--text); }
  .dm-note { font-size: 13px; color: var(--text-dim); margin: 0 0 32px; max-width: 62ch; }
  .dm-note-row { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:32px; }.dm-note-row .dm-note { margin:0; }.dm-actions { display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; }.dm-new { font-family:var(--mono); font-style:normal; font-size:9px; font-weight:600; letter-spacing:.04em; text-transform:uppercase; color:var(--accent); background:var(--accent-soft); padding:1px 6px; border-radius:5px; }.dm-premium-link { display:inline-flex; align-items:center; gap:6px; white-space:nowrap; }
  .dm-empty { border: 1px dashed var(--border); border-radius: 14px; padding: 24px; text-align: center; color: var(--text-dim); font-size: 14px; }

  .dm-search { display: flex; align-items: center; gap: 8px; max-width: 420px; margin: 0 0 22px; padding: 9px 14px; border: 1px solid var(--border); border-radius: 999px; background: var(--card); color: var(--text-dim); transition: border-color .15s ease, box-shadow .15s ease; }
  .dm-search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent); }
  .dm-search input { flex: 1; min-width: 0; border: none; outline: none; background: transparent; color: var(--text); font: inherit; font-size: 14px; }
  .dm-group { margin-bottom: 30px; }
  .dm-group-title { display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 700; margin: 0 0 14px; color: var(--text); }
  .dm-group-count { font-family: var(--mono); font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 999px; background: var(--bg-raise); color: var(--text-dim); }
  .dm-card[hidden], .dm-group[hidden] { display: none !important; }
  .dm-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr)); gap: 18px; }
  .dm-card { border: 1px solid var(--border); border-radius: 16px; background: var(--card); text-align: center; overflow: hidden; transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease; }
  .dm-card:hover { transform: translateY(-2px); }
  .dm-card-premium { border-color: color-mix(in srgb, var(--yellow) 78%, var(--border)); box-shadow: 0 0 0 1px color-mix(in srgb, var(--yellow) 18%, transparent), 0 12px 30px color-mix(in srgb, var(--yellow) 9%, transparent); }

  .dm-card-banner { position: relative; height: 108px; overflow: hidden; background: var(--bg-raise); }
  .dm-card-banner-bg { position: absolute; inset: -20%; width: 140%; height: 140%; object-fit: cover; filter: blur(22px) saturate(1.3) brightness(1.05); }
  .dm-plan-badge { position: absolute; z-index: 2; top: 10px; right: 10px; display: inline-flex; align-items: center; gap: 5px; padding: 5px 8px; border: 1px solid color-mix(in srgb, var(--border) 80%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--bg) 78%, transparent); color: var(--text-muted); font-family: var(--mono); font-size: 9px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; backdrop-filter: blur(8px); }
  .dm-plan-badge-premium { border-color: color-mix(in srgb, var(--yellow) 78%, transparent); background: color-mix(in srgb, var(--yellow) 15%, var(--bg)); color: var(--yellow); }
  .dm-card-icon {
    position: relative; z-index: 1; display: block; width: 68px; height: 68px; border-radius: 50%; object-fit: cover;
    margin: -34px auto 12px; border: 3px solid var(--card); background: var(--bg-raise);
    box-shadow: 0 6px 16px -6px rgba(0,0,0,0.6);
  }
  .dm-card-body { padding: 0 16px 16px; }
  .dm-card-name { font-size: 14.5px; font-weight: 600; color: var(--text); margin-bottom: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dm-card-tag { font-size: 12px; color: var(--text-dim); margin-bottom: 14px; }
  .dm-card-btn { width: 100%; justify-content: center; gap: 6px; border-radius: 999px; }
  .dm-card-btn-invite { background: var(--text-muted); color: var(--bg); border-color: transparent; }
  .dm-card-vanity { margin-top: 8px; }
  .dm-card-btn-invite:hover { background: var(--text); }

  .dm-card-inactive { background: var(--bg-raise); }
  .dm-card-inactive .dm-card-name { color: var(--text-dim); }
  .dm-card-inactive .dm-card-tag { color: var(--text-dim); font-style: italic; }

  @media (max-width: 880px) {
    .dm-sec { padding: 28px 0 56px; }
    .dm-wrap { padding-left: 16px; padding-right: 16px; }
    .dm-head { flex-wrap: wrap; gap: 12px; }
    .dm-logout { margin-left: auto; }
    .dm-note-row { align-items:flex-start; flex-direction:column; gap:14px; margin-bottom:22px; }.dm-note { margin-bottom:0; }
    .dm-premium-link { width:100%; justify-content:center; }.dm-actions { width:100%; }
    .dm-grid { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .dm-card { min-width: 0; }
  }

  @media (max-width: 380px) {
    .dm-wrap { padding-left: 10px; padding-right: 10px; }
  }
  /* The cards come in one after another, and each picture shimmers until it has loaded. */
  @keyframes dmRise { from { opacity: 0; transform: translateY(14px) scale(0.97); } to { opacity: 1; transform: none; } }
  .dm-head, .dm-note-row { animation: dmRise 0.45s cubic-bezier(0.2, 0.75, 0.25, 1) backwards; }
  .dm-note-row { animation-delay: 60ms; }
  .dm-card { animation: dmRise 0.5s cubic-bezier(0.2, 0.75, 0.25, 1) backwards; animation-delay: calc(120ms + var(--i, 0) * 55ms); }
  .dm-card-banner, .dm-card-icon { background: linear-gradient(100deg, var(--bg-raise) 30%, var(--card-hover) 50%, var(--bg-raise) 70%); background-size: 200% 100%; animation: pettoShimmer 1.4s ease-in-out infinite; }
  .dm-card-banner, .dm-card-icon { animation: pettoShimmer 1.4s ease-in-out 6; }
  @media (prefers-reduced-motion: reduce) { .dm-head, .dm-note-row, .dm-card, .dm-card-banner, .dm-card-icon { animation: none; } }
</style>
