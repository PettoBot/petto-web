---
import { Icon } from 'astro-icon/components';
import DashMeLayout from './DashMeLayout.astro';
import type { Session } from '../utils/session';
import DashPanelHead from './DashPanelHead.astro';
import DashPanelEmpty from './DashPanelEmpty.astro';

import { dashLocale, getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const numLocale = dashLocale(dashLang);
const dt = makeT(dashLang);
interface Guild {
  id: string;
  name: string;
  icon: string | null;
  tag: string;
  active: boolean;
  premiumActive: boolean;
  memberCount?: number | null;
}
interface Props {
  user: Session;
  guilds: Guild[];
  inviteUrl: (guildId: string) => string;
  isOwner: boolean;
  canPartners?: boolean;
  error?: string;
}
const { user, guilds, inviteUrl, isOwner, canPartners = false, error } = Astro.props;
const withPetto = guilds.filter((g) => g.active);
const withoutPetto = guilds.filter((g) => !g.active);
const groups = [
  { key: 'with', title: dt('Servers with Petto'), list: withPetto },
  { key: 'without', title: dt('Servers without Petto'), list: withoutPetto },
].filter((group) => group.list.length);
// The team's own pages, shown to the people who can open them.
const staffLinks = [
  isOwner && { href: '/dash/admin', icon: 'ph:gift-fill', label: dt('Owner grants'), sk: 'form' },
  isOwner && { href: '/dash/admin/servers', icon: 'ph:hard-drives-fill', label: dt('All servers'), sk: 'list' },
  isOwner && { href: '/dash/team', icon: 'ph:users-three-fill', label: dt('Team'), sk: 'list' },
  canPartners && { href: '/dash/partners-admin', icon: 'ph:handshake-fill', label: dt('Partners'), sk: 'list' },
  canPartners && { href: '/dash/credits-admin', icon: 'ph:heart-fill', label: dt('Credits'), sk: 'list' },
  canPartners && { href: '/dash/appeal-names', icon: 'ph:scales-fill', label: dt('Appeal names'), sk: 'list' },
].filter(Boolean) as { href: string; icon: string; label: string; sk: string }[];
import DashServerSort from './DashServerSort.astro';
---
<DashMeLayout user={user} active="servers" pageTitle="Your servers">
  <div class="dm-wrap">
        <DashPanelHead title={dt('Your servers')} eyebrow={dt('Dashboard')} icon="ph:squares-four-fill" back={false}>
          <a class="btn btn-ghost btn-sm" href="/dash/me"><Icon name="ph:user-circle-fill" width="13" height="13" /> {dt('My profile')}</a>
          <a class="btn btn-ghost btn-sm" href="/dash/premium" data-sk="cards"><Icon name="ph:crown-fill" width="13" height="13" /> {dt('Premium servers')}</a>
          <a class="btn btn-ghost btn-sm" href="/dash/history" data-sk="cards"><Icon name="ph:clock" width="13" height="13" /> {dt('History')}</a>
        </DashPanelHead>

        {staffLinks.length > 0 && (
          <nav class="dm-staff" aria-label={dt('Staff')}>
            <span class="dm-staff-label">{dt('Staff')}</span>
            <div class="dm-staff-links">
              {staffLinks.map((link) => <a class="dm-staff-link" href={link.href} data-sk={link.sk}><Icon name={link.icon} width="14" height="14" />{link.label}</a>)}
            </div>
          </nav>
        )}

        {error === 'discord_unavailable' ? (
          <DashPanelEmpty tone="error" icon="ph:cloud-slash-fill" text={dt('Discord no respondió a tiempo. Recarga la página en unos segundos para volver a cargar tus servidores.')} />
        ) : guilds.length === 0 ? (
          <DashPanelEmpty icon="ph:hard-drives-fill" text={dt('No servers found where you can manage Petto. You need Manage Server or Administrator permission on a server first.')} />
        ) : (
          <Fragment>
          <div class="dm-tools">
            {guilds.length > 6 && (
              <label class="dm-search">
                <Icon name="ph:magnifying-glass" width="14" height="14" />
                <input type="search" id="dm-search" placeholder={dt('Search servers')} aria-label={dt('Search servers')} autocomplete="off" />
              </label>
            )}
            {withPetto.length > 1 && <DashServerSort targets=".dm-group[data-group='with'] .dm-grid" />}
          </div>
          {groups.map((group) => (
            <div class="dm-group" data-group={group.key}>
              <h2 class="dm-group-title">{group.title} <span class="dm-group-count">{group.list.length}</span></h2>
              <div class="dm-grid dgl-stagger">
                {group.list.map((g) => (
                  <article data-name={g.name.toLowerCase()} data-members={g.active && g.memberCount != null ? String(g.memberCount) : ''} class:list={['dm-card', { 'dm-card-inactive': !g.active, 'dm-card-premium': g.premiumActive }]}>
                    <div class="dm-card-banner" aria-hidden="true">
                      <img src={g.icon ?? '/assets/dash-guild-fallback.avif'} alt="" class="dm-card-banner-bg" loading="lazy" decoding="async" />
                      <span class:list={['dm-plan-badge', { 'dm-plan-badge-premium': g.premiumActive }]}>
                        {g.premiumActive && <Icon name="ph:crown-fill" width="12" height="12" />}
                        {g.premiumActive ? dt('Premium active') : dt('Free')}
                      </span>
                    </div>
                    <img src={g.icon ?? '/assets/dash-guild-fallback.avif'} alt="" class="dm-card-icon" loading="lazy" decoding="async" />
                    <div class="dm-card-body">
                      <div class="dm-card-name" title={g.name}>{g.name}</div>
                      <div class="dm-card-tag">
                        {g.premiumActive && <span class="dm-crown"><Icon name="ph:crown-fill" width="11" height="11" />{dt('Premium')}</span>}
                        <span>{g.active ? (g.memberCount != null ? <Fragment><span class="dm-nw">{`${g.memberCount.toLocaleString(numLocale)} ${dt('members')}`}</span> <span class="dm-nw">{`· ${dt(g.tag)}`}</span></Fragment> : dt(g.tag)) : dt('Petto not added')}</span>
                      </div>
                    </div>
                    <div class="dm-card-actions">
                      {g.active ? (
                        <a class="btn btn-ghost btn-sm dm-card-btn" href={`/dash/guild/${g.id}/overview`}>
                          <Icon name="ph:gear-fill" width="13" height="13" />
                          {dt('Open')}
                        </a>
                      ) : (
                        <a class="btn btn-sm dm-card-btn dm-card-btn-invite" href={inviteUrl(g.id)} target="_blank" rel="noopener">
                          <Icon name="ph:plus-circle-fill" width="13" height="13" />
                          {dt('Add Petto')}
                        </a>
                      )}
                      {g.active && (
                        <a class="btn btn-ghost btn-sm dm-card-vanity" href={`/dash/guild/${g.id}/vanity`} title={dt('Vanity roles')} aria-label={dt('Vanity roles')}>
                          <Icon name="ph:sparkle-fill" width="14" height="14" />
                        </a>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          ))}
          <DashPanelEmpty id="dm-nomatch" hidden icon="ph:magnifying-glass" text={dt('No server matches your search.')} />
          </Fragment>
        )}
  </div>
</DashMeLayout>

<script>
  // The search filters both lists by name; a list with nothing left hides its title too.
  const box = document.getElementById('dm-search') as HTMLInputElement | null;
  const none = document.getElementById('dm-nomatch');
  box?.addEventListener('input', () => {
    const term = box.value.trim().toLowerCase();
    let shown = 0;
    document.querySelectorAll<HTMLElement>('.dm-group').forEach((group) => {
      let inGroup = 0;
      group.querySelectorAll<HTMLElement>('.dm-card').forEach((card) => {
        const match = !term || (card.dataset.name ?? '').includes(term);
        card.hidden = !match;
        if (match) inGroup += 1;
      });
      group.hidden = inGroup === 0;
      shown += inGroup;
    });
    if (none) none.hidden = shown > 0;
  });
</script>

<style>
  .dm-wrap { min-width: 0; }
  .dm-user { display: flex; align-items: center; gap: 9px; margin-bottom: 18px; min-width: 0; font-size: 13px; color: var(--text-dim); }
  .dm-user-av { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border); flex: none; }
  .dm-user-av-fallback { display: grid; place-items: center; background: var(--bg-raise); color: var(--text-dim); }
  .dm-user-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dm-logged-label { font-family: var(--mono); font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; }
  .dm-user-name { color: var(--text); font-weight: 600; }
  .dm-logout { display: inline-flex; align-items: center; gap: 6px; margin-left: auto; flex: none; padding: 6px 10px; border-radius: 999px; color: var(--text-dim); text-decoration: none; transition: color var(--m-fast) var(--m-std), background var(--m-fast) var(--m-std); }
  .dm-logout:hover { color: var(--text); background: var(--bg-raise); }

  .dm-staff { display: flex; align-items: center; gap: 10px 14px; flex-wrap: wrap; margin: 0 0 24px; padding: 10px 12px; border: 1px solid var(--border-soft); border-radius: 14px; background: color-mix(in srgb, var(--card) 60%, transparent); }
  .dm-staff-label { font-family: var(--mono); font-size: 10.5px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--text-dim); padding-left: 4px; }
  .dm-staff-links { display: flex; gap: 6px; flex-wrap: wrap; min-width: 0; }
  .dm-staff-link { display: inline-flex; align-items: center; gap: 7px; padding: 7px 12px; border: 1px solid var(--border); border-radius: 999px; color: var(--text-muted); font-size: 13px; font-weight: 500; text-decoration: none; white-space: nowrap; transition: color var(--m-fast) var(--m-std), border-color var(--m-fast) var(--m-std), transform var(--m-instant) var(--m-std); }
  .dm-staff-link :global(svg) { color: var(--accent); flex: none; }
  .dm-staff-link:hover { color: var(--text); border-color: var(--text-dim); }
  .dm-staff-link:active { transform: scale(var(--m-press)); }

  .dm-tools { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 14px; margin: 0 0 22px; }
  .dm-tools:empty { display: none; }
  .dm-search { display: flex; flex: 1 1 260px; align-items: center; gap: 8px; max-width: 420px; margin: 0; padding: 9px 14px; border: 1px solid var(--border); border-radius: 999px; background: var(--card); color: var(--text-dim); transition: border-color var(--m-fast) ease, box-shadow var(--m-fast) ease; }
  .dm-search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent); }
  .dm-search input { flex: 1; min-width: 0; border: none; outline: none; background: transparent; color: var(--text); font: inherit; font-size: 14px; }
  .dm-search input:focus, .dm-search input:focus-visible { outline: 0; border: 0; box-shadow: none; background: transparent; }
  .dm-group { margin-bottom: 30px; }
  .dm-group-title { display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 700; margin: 0 0 14px; color: var(--text); }
  .dm-group-count { font-family: var(--mono); font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 999px; background: var(--bg-raise); color: var(--text-dim); }
  .dm-card[hidden], .dm-group[hidden] { display: none !important; }
  .dm-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr)); gap: 16px; }
  .dm-card { display: flex; flex-direction: column; min-width: 0; border: 1px solid var(--border); border-radius: 16px; background: var(--card); text-align: center; overflow: hidden; transition: border-color var(--m-base) ease, box-shadow var(--m-slow) ease, transform var(--m-base) var(--m-out); }
  @media (hover: hover) { .dm-card:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--text-dim) 60%, var(--border)); } }
  .dm-card:active { transform: scale(.99); transition-duration: var(--m-instant); }
  .dm-card-premium, .dm-card-premium:hover { border-color: color-mix(in srgb, var(--yellow) 78%, var(--border)); box-shadow: 0 0 0 1px color-mix(in srgb, var(--yellow) 18%, transparent), 0 12px 30px color-mix(in srgb, var(--yellow) 9%, transparent); }

  .dm-card-banner { position: relative; height: 96px; overflow: hidden; background: var(--bg-raise); }
  .dm-card-banner-bg { position: absolute; inset: -20%; width: 140%; height: 140%; object-fit: cover; filter: blur(22px) saturate(1.3) brightness(1.05); }
  .dm-plan-badge { position: absolute; z-index: 2; top: 10px; right: 10px; display: inline-flex; align-items: center; gap: 5px; padding: 5px 8px; border: 1px solid color-mix(in srgb, var(--border) 80%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--bg) 78%, transparent); color: var(--text-muted); font-family: var(--mono); font-size: 9px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; backdrop-filter: blur(8px); }
  .dm-plan-badge-premium { border-color: color-mix(in srgb, var(--yellow) 78%, transparent); background: color-mix(in srgb, var(--yellow) 15%, var(--bg)); color: var(--yellow); }
  .dm-card-icon {
    position: relative; z-index: 1; display: block; width: 64px; height: 64px; border-radius: 50%; object-fit: cover;
    margin: -32px auto 10px; border: 3px solid var(--card); background: var(--bg-raise);
    box-shadow: 0 6px 16px -6px rgba(0,0,0,0.6);
  }
  .dm-card-body { padding: 0 16px; min-width: 0; }
  .dm-card-name { font-size: 14.5px; font-weight: 600; color: var(--text); margin-bottom: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dm-card-tag { display: flex; align-items: center; justify-content: center; gap: 6px; min-width: 0; font-size: 12px; color: var(--text-dim); }
  .dm-card-tag > span:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dm-nw { white-space: nowrap; }
  .dm-crown { display: none; align-items: center; gap: 3px; flex: none; padding: 1px 7px 1px 5px; border-radius: 999px; background: color-mix(in srgb, var(--yellow) 14%, transparent); color: var(--yellow); font-size: 10.5px; font-weight: 600; }
  .dm-card-actions { display: flex; gap: 8px; margin-top: auto; padding: 14px 16px 16px; }
  .dm-card-btn { flex: 1; min-width: 0; justify-content: center; gap: 6px; border-radius: 999px; }
  .dm-card-btn-invite { background: var(--text-muted); color: var(--bg); border-color: transparent; }
  .dm-card-btn-invite:hover { background: var(--text); }
  .dm-card-vanity { flex: none; justify-content: center; width: 38px; padding-left: 0; padding-right: 0; border-radius: 999px; color: var(--accent); }

  .dm-card-inactive { background: var(--bg-raise); }
  .dm-card-inactive .dm-card-name { color: var(--text-dim); }
  .dm-card-inactive .dm-card-tag { font-style: italic; }

  /* On a phone each server is one soft row: icon, name, and its actions. */
  @media (max-width: 600px) {
    .dm-staff { flex-direction: column; align-items: stretch; gap: 8px; padding: 10px; }
    .dm-staff-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .dm-staff-link { min-width: 0; overflow: hidden; text-overflow: ellipsis; padding: 8px 11px; border-radius: 11px; }
    .dm-search { max-width: none; margin-bottom: 18px; }
    .dm-group { margin-bottom: 24px; }
    .dm-group-title { margin-bottom: 10px; }
    .dm-grid { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .dm-card { flex-direction: row; align-items: center; gap: 12px; padding: 12px; text-align: left; border-radius: 14px; }
    .dm-card-banner { display: none; }
    .dm-card-icon { width: 44px; height: 44px; margin: 0; flex: none; border: 1px solid var(--border); box-shadow: none; }
    .dm-card-body { flex: 1; padding: 0; }
    .dm-card-tag { justify-content: flex-start; flex-wrap: wrap; row-gap: 3px; }
    .dm-card-tag > span:last-child { white-space: normal; overflow-wrap: anywhere; line-height: 1.35; }
    .dm-crown { display: inline-flex; }
    .dm-card-actions { flex: none; margin: 0; padding: 0; gap: 6px; }
    .dm-card-btn { flex: none; padding-left: 14px; padding-right: 14px; }
    .dm-card-btn :global(svg) { display: none; }
    .dm-card-tag { font-size: 11.5px; }
    .dm-card-vanity { width: 34px; }
  }
  /* The pictures shimmer until they have loaded. */
  .dm-card-banner, .dm-card-icon { background: linear-gradient(100deg, var(--bg-raise) 30%, var(--card-hover) 50%, var(--bg-raise) 70%); background-size: 200% 100%; animation: pettoShimmer 1.4s ease-in-out 6; }
  @media (prefers-reduced-motion: reduce) { .dm-card-banner, .dm-card-icon { animation: none; } .dm-card, .dm-staff-link { transition: none; } }
</style>
