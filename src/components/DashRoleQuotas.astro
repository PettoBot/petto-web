---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import { getDashLang, makeT } from '../i18n/dash';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const docsUrl = `https://wiki.petto.sbs${dashLang === 'es' ? '/es' : dashLang === 'pt-BR' ? '/pt-br' : ''}/moderation/role-quotas`;
interface Rule {
  roleId: string; roleName: string | null; roleColor: number; periodDays: number; minMessages: number; maxStrikes: number; notifyDm: boolean;
  reportChannelId: string | null; reportChannelName: string | null; startedAt: string; endsAt: string | null; lastRunAt: string | null;
  lastMet: number | null; lastMissed: number | null; lastRemoved: number | null; withStrikes: number;
}
interface Props {
  user: { username: string; avatar: string | null; userId?: string };
  guildId: string;
  guildName: string;
  guildIcon: string;
  rules: Rule[];
  roles: { id: string; name: string; hasRule: boolean }[];
  channels: { id: string; name: string }[];
  state: 'ok' | 'unavailable' | 'error';
  canEdit: boolean;
  message: { kind: 'ok' | 'err'; text: string } | null;
  max: number;
  limits: { messages: number; days: number; strikes: number; defaultDays: number; defaultStrikes: number };
}
const { user, guildId, guildName, guildIcon, rules, roles, channels, state, canEdit, message, max, limits } = Astro.props;
const hex = (color: number) => (color > 0 ? `#${color.toString(16).padStart(6, '0')}` : '#99aab5');
const day = (iso: string | null) => {
  const date = iso ? new Date(iso) : null;
  return date && Number.isFinite(date.getTime()) ? date.toLocaleString(dashLang, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '';
};
const ready = state === 'ok';
const editable = ready && canEdit;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="role-quotas" pageTitle={dt('Role quotas')}>
  <div class="rq">
    <header class="rq-head">
      <h1>{dt('Role quotas')}</h1>
      <a class="btn btn-sm rq-docs" href={docsUrl} target="_blank" rel="noopener"><Icon name="ph:book-open-fill" width="13" height="13" />{dt('Read the docs')}</a>
    </header>
    <p class="rq-lead">{dt('Ask a role for a number of messages in each period. A member who falls short too many periods in a row loses the role.')}</p>

    {message && <div class:list={['rq-flash', { 'rq-flash-err': message.kind === 'err' }]} role="status"><Icon name={message.kind === 'ok' ? 'ph:check-circle-fill' : 'ph:warning-fill'} width="15" height="15" />{message.text}</div>}
    {state === 'unavailable' && <div class="rq-flash rq-flash-warn"><Icon name="ph:plug-fill" width="15" height="15" />{dt('Role quotas are not available yet. Petto is being updated: try again in a few minutes.')}</div>}
    {state === 'error' && <div class="rq-flash rq-flash-warn"><Icon name="ph:plug-fill" width="15" height="15" />{dt('The role quotas could not be read. Try again in a moment.')}</div>}
    {ready && !canEdit && <div class="rq-flash rq-flash-warn" data-rq-readonly><Icon name="ph:eye-fill" width="15" height="15" />{dt('Only administrators can change role quotas, the same as the command. You can look at them.')}</div>}

    <div class="rq-grid">
      <section class="rq-card rq-list">
        <div class="rq-card-head">
          <h2>{dt('Quotas')}</h2>
          <span class:list={['rq-count', { 'rq-count-full': rules.length >= max }]}>{dt('{n} of {max}', { n: rules.length, max })}</span>
        </div>
        {rules.length === 0 ? (
          <p class="rq-empty">{ready ? dt('No role has a quota yet. Add the first one with the form.') : dt('There are no quotas to show.')}</p>
        ) : (
          <ul class="rq-rules">
            {rules.map((rule) => (
              <li class="rq-rule" data-rq-rule>
                <div class="rq-rule-main">
                  <span class:list={['rq-role', { 'rq-role-gone': rule.roleName === null }]} style={`--c:${hex(rule.roleColor)}`}>
                    <i aria-hidden="true"></i><b>{rule.roleName ?? dt('Deleted role')}</b>
                  </span>
                  <span class="rq-quota">{dt('{n} messages every {days} day(s)', { n: rule.minMessages, days: rule.periodDays })}</span>
                </div>
                <p class="rq-meta">
                  {dt('The role goes after {n} periods in a row below it.', { n: rule.maxStrikes })}
                  {rule.endsAt && <span> · {dt('This period ends {when}.', { when: day(rule.endsAt) })}</span>}
                </p>
                <p class="rq-meta">
                  {rule.withStrikes > 0 ? dt('{n} member(s) with strikes now.', { n: rule.withStrikes }) : dt('Nobody has strikes now.')}
                  {rule.lastRunAt && rule.lastMet !== null && <span> · {dt('Last period: {met} met, {missed} below, {removed} lost the role.', { met: rule.lastMet ?? 0, missed: rule.lastMissed ?? 0, removed: rule.lastRemoved ?? 0 })}</span>}
                </p>
                <p class="rq-meta">
                  {rule.notifyDm ? dt('Members are told by DM.') : dt('No DMs.')}
                  {rule.reportChannelId && <span> · {dt('Report in #{name}', { name: rule.reportChannelName ?? dt('a channel that is gone') })}</span>}
                </p>
                {editable && (
                  <form method="POST" class="rq-remove" data-no-dirty>
                    <input type="hidden" name="action" value="remove" />
                    <input type="hidden" name="role_id" value={rule.roleId} />
                    <button class="btn btn-ghost btn-sm" type="submit" data-confirm={dt('Remove the quota of this role?')} aria-label={dt('Remove')}><Icon name="ph:trash-bold" width="13" height="13" /><span>{dt('Remove')}</span></button>
                  </form>
                )}
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="rq-card rq-add" data-rq-add>
        <div class="rq-card-head"><h2>{dt('Set a quota')}</h2></div>
        <form method="POST" class="rq-form" data-no-dirty>
          <input type="hidden" name="action" value="set" />
          <label class="rq-field"><span>{dt('Role')}</span>
            <select name="role_id" required disabled={!editable}>
              <option value="">{dt('Choose a role')}</option>
              {roles.map((role) => <option value={role.id}>{role.hasRule ? dt('{name} (replaces its quota)', { name: role.name }) : role.name}</option>)}
            </select>
          </label>
          <label class="rq-field"><span>{dt('Messages in each period')}</span>
            <input type="number" name="messages" min="1" max={limits.messages} step="1" inputmode="numeric" required disabled={!editable} />
          </label>
          <div class="rq-two">
            <label class="rq-field"><span>{dt('Days in each period')}</span>
              <input type="number" name="period_days" min="1" max={limits.days} step="1" value={limits.defaultDays} inputmode="numeric" required disabled={!editable} />
            </label>
            <label class="rq-field"><span>{dt('Periods in a row before the role goes')}</span>
              <input type="number" name="strikes" min="1" max={limits.strikes} step="1" value={limits.defaultStrikes} inputmode="numeric" required disabled={!editable} />
            </label>
          </div>
          <label class="rq-field"><span>{dt('Report channel')}</span>
            <select name="report_channel_id" disabled={!editable}>
              <option value="">{dt('None')}</option>
              {channels.map((channel) => <option value={channel.id}>#{channel.name}</option>)}
            </select>
            <em>{dt('Optional. The result of each period is posted there.')}</em>
          </label>
          <label class="rq-check"><input type="checkbox" name="notify_dm" checked disabled={!editable} /><span>{dt('Tell members by DM when they fall short')}</span></label>
          <button class="btn btn-accent btn-sm" type="submit" disabled={!editable || rules.length >= max}><Icon name="ph:plus-bold" width="12" height="12" />{dt('Save quota')}</button>
          <p class="rq-hint">{dt('A role has one quota: saving it again replaces the old one and starts a new period now. Petto needs Manage Roles and a role above this one to take it away.')}</p>
        </form>
      </section>
    </div>

    <section class="rq-card rq-how">
      <div class="rq-card-head"><h2>{dt('How it works')}</h2></div>
      <ul class="rq-notes">
        <li>{dt('At the end of each period Petto counts the messages of each member who holds the role. Reaching the number clears their strikes; falling short adds one.')}</li>
        <li>{dt('A member given the role during a period is judged from the next one. The command /rolequota excuse gives someone time off.')}</li>
        <li>{dt('Petto keeps only a number for each member and period, never what was said, and only for members who hold a role with a quota. It is deleted when they lose the role.')}</li>
      </ul>
    </section>
  </div>
</DashGuildLayout>

<style>
  .rq { max-width: 1180px; display: flex; flex-direction: column; min-height: 100%; }
  .rq-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 14px; margin: 0 0 8px; }
  .rq-head h1 { font-size: 24px; margin: 0; }
  .rq-docs { display: inline-flex; align-items: center; gap: 6px; }
  .rq-lead { margin: 0 0 16px; font-size: 14px; color: var(--text-muted); }
  .rq h2 { font-size: 15px; margin: 0; }
  .rq-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid color-mix(in srgb, var(--green) 55%, transparent); border-radius: 10px; padding: 9px 12px; margin: 0 0 14px; }
  .rq-flash :global(svg) { flex: none; }
  .rq-flash-err { color: var(--red, #ff6b6b); background: color-mix(in srgb, var(--red, #ff6b6b) 10%, transparent); border-color: color-mix(in srgb, var(--red, #ff6b6b) 55%, transparent); }
  .rq-flash-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: color-mix(in srgb, var(--yellow) 55%, transparent); }
  .rq-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 16px; align-items: start; }
  .rq-card { border: 1px solid var(--border); border-radius: 14px; background: var(--card); min-width: 0; padding: 0; margin: 0; }
  .rq-card-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--border); }
  .rq-count { font-size: 12.5px; font-weight: 700; padding: 2px 10px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }
  .rq-count-full { background: color-mix(in srgb, var(--yellow) 18%, transparent); color: var(--yellow); }
  .rq-empty { margin: 0; padding: 18px 16px; font-size: 13.5px; color: var(--text-dim); }
  .rq-rules { list-style: none; margin: 0; padding: 0; }
  .rq-rule { position: relative; display: grid; gap: 4px; padding: 11px 16px; border-top: 1px solid var(--border); }
  .rq-rule:first-child { border-top: 0; }
  .rq-rule-main { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; padding-right: 96px; min-width: 0; }
  .rq-role { display: inline-flex; align-items: center; gap: 6px; max-width: 100%; min-width: 0; padding: 2px 10px 2px 8px; border-radius: 999px; background: color-mix(in srgb, var(--c) 14%, transparent); border: 1px solid color-mix(in srgb, var(--c) 40%, transparent); font-size: 13px; }
  .rq-role i { width: 10px; height: 10px; border-radius: 50%; background: var(--c); flex: none; }
  .rq-role b { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rq-role-gone { background: transparent; border-style: dashed; color: var(--text-dim); }
  .rq-role-gone i { background: transparent; border: 1px dashed var(--text-dim); }
  .rq-quota { font-size: 13px; font-weight: 600; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .rq-meta { margin: 0; font-size: 12.5px; color: var(--text-dim); overflow-wrap: anywhere; }
  .rq-remove { position: absolute; top: 9px; right: 12px; margin: 0; }
  .rq-remove :global(button) { color: var(--red, #e5484d); }
  .rq-form { display: flex; flex-direction: column; gap: 12px; padding: 14px 16px 16px; }
  .rq-two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; }
  .rq-field { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .rq-field > span { font-size: 13px; font-weight: 600; }
  .rq-field select, .rq-field input { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; min-width: 0; }
  .rq-field select:disabled, .rq-field input:disabled { opacity: .6; }
  .rq-field em { font-style: normal; font-size: 12px; color: var(--text-dim); }
  .rq-check { display: flex; align-items: center; gap: 8px; font-size: 13.5px; }
  .rq-form button[type="submit"] { align-self: flex-start; }
  .rq-form button[type="submit"]:disabled { opacity: .5; cursor: not-allowed; }
  .rq-hint { font-size: 12.5px; color: var(--text-dim); margin: 0; }
  .rq-how { margin-top: 16px; }
  .rq-notes { margin: 0; padding: 12px 16px 14px 32px; display: grid; gap: 6px; font-size: 13.5px; color: var(--text-muted); }
  @media (max-width: 1000px) { .rq-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 720px) {
    .rq-two { grid-template-columns: minmax(0, 1fr); }
    .rq-card-head { padding: 10px 14px; }
    .rq-rule { padding: 10px 14px; }
    .rq-rule-main { padding-right: 0; }
    .rq-remove { position: static; justify-self: start; margin-top: 2px; }
  }
</style>
