---
// What a visitor without a session sees at /dash (and where the pages of a server send them): a small "Login required" card.
// Notices of a failed login (?error=) show as one line above the button. The codes and routes are in utils/dashLogin.mjs.
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { getDashLang, makeT } from '../i18n/dash';
import { LOGIN_HREF, homeHref, isDiscordNotice, loginNotice } from '../utils/dashLogin.mjs';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  error?: string | null;
  /** An information banner (not an error): 'relogin' when an old session was rejected. */
  info?: string | null;
}
const { error, info = null } = Astro.props;

const errorMessages: Record<string, string> = {
  missing_code: dt('Discord didn\'t send back a login code, try again.'),
  token_exchange_failed: dt('Discord rejected the login exchange, try again.'),
  user_fetch_failed: dt('Couldn\'t load your Discord profile, try again.'),
  login_failed: dt('Something went wrong logging in, try again.'),
  server_not_configured: dt('Login isn\'t configured on this environment yet.'),
  no_access: dt('You don\'t have permission to manage that server.'),
  bot_not_in_guild: dt('Petto isn\'t in that server.'),
  discord_unavailable: dt('Discord didn\'t respond in time. Petto is still running; wait a few seconds and try again.'),
  unknown: dt('Something went wrong, try again.'),
};
const infoMessages: Record<string, string> = {
  relogin: dt('The Petto dashboard has been refreshed. Log in with Discord to continue.'),
};
const infoText = info ? infoMessages[info] ?? null : null;
const notice = loginNotice(error);
const fromDiscord = isDiscordNotice(error);
---
<Base title={`${dt('Login required')} · Petto`} active="dash" showFooter noindex preloadImages={['/assets/home-hero-sky.webp']}>
  <main class="dl-main">
    <div class="dl-bg" aria-hidden="true">
      <img src="/assets/home-hero-sky.webp" alt="" loading="eager" decoding="sync" fetchpriority="high" draggable="false" />
      <div class="dl-bg-fade"></div>
    </div>
    <section class="dl-card" aria-labelledby="dl-title">
      <img class="dl-mascot" src="/assets/favicon-3d.png" width="56" height="56" alt="" loading="eager" decoding="sync" draggable="false" />
      <h1 id="dl-title" class="dl-title">{dt('Login required')}</h1>
      {infoText && (
        <p class="dl-info" role="status" data-dl-info>
          <Icon name="ph:info-fill" width="16" height="16" class="dl-info-icon" />
          <span>{infoText}</span>
          <button type="button" class="dl-info-x" data-dl-info-close aria-label={dt('Close')}><Icon name="ph:x" width="13" height="13" /></button>
        </p>
      )}
      <p class="dl-line">{dt('Log in with Discord to manage your servers.')}</p>
      {notice && (
        <p class:list={['dl-notice', { 'dl-notice-discord': fromDiscord }]} role="alert">
          <Icon name={fromDiscord ? 'simple-icons:discord' : 'ph:warning-fill'} width="15" height="15" class="dl-notice-icon" />
          <span>{errorMessages[notice]}</span>
        </p>
      )}
      <a class="btn dl-login" href={LOGIN_HREF} data-dl-login>
        <Icon name="simple-icons:discord" width="17" height="17" />
        {dt('Log in with Discord')}
      </a>
      <a class="dl-back" href={homeHref(dashLang)}>{dt('Back to home')}</a>
    </section>
  </main>
</Base>

<script>
  // The button is the first thing to use here: focused without moving the page.
  document.querySelector<HTMLAnchorElement>('[data-dl-login]')?.focus({ preventScroll: true });
  document.querySelector('[data-dl-info-close]')?.addEventListener('click', () => document.querySelector<HTMLElement>('[data-dl-info]')?.setAttribute('hidden', ''));
</script>

<style>
  .dl-main { position: relative; isolation: isolate; overflow: hidden; min-height: calc(100svh - 66px); display: grid; place-items: center; padding: 64px 16px; }
  .dl-bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; background: url('/assets/home-hero-sky.webp') center 24% / cover no-repeat, #0b1933; }
  .dl-bg img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 24%; opacity: 0.72; display: block; }
  .dl-bg-fade { position: absolute; inset: 0; background: radial-gradient(60% 60% at 50% 42%, rgba(8, 12, 22, 0.25) 0%, rgba(11, 12, 14, 0.76) 80%, var(--bg) 100%); }
  .dl-card { width: 100%; max-width: 420px; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 36px 30px 28px; background: rgba(20, 22, 28, 0.78); -webkit-backdrop-filter: blur(20px) saturate(1.2); backdrop-filter: blur(20px) saturate(1.2); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 22px; box-shadow: 0 28px 70px -24px rgba(0, 0, 0, 0.78); }
  .dl-mascot { width: 56px; height: 56px; border-radius: 16px; margin-bottom: 16px; }
  .dl-title { font-size: 26px; line-height: 1.15; margin: 0 0 8px; color: #f6f8fc; }
  .dl-line { margin: 0 0 24px; color: #c7d2e4; font-size: 14.5px; line-height: 1.55; text-wrap: balance; }
  .dl-notice { display: flex; align-items: flex-start; gap: 9px; width: 100%; margin: 0 0 18px; padding: 10px 12px; text-align: left; font-size: 13px; line-height: 1.5; color: var(--red); background: var(--red-soft); border: 1px solid color-mix(in srgb, var(--red) 55%, transparent); border-radius: 11px; }
  .dl-info { display: flex; align-items: flex-start; gap: 9px; width: 100%; margin: 0 0 18px; padding: 10px 8px 10px 12px; text-align: left; font-size: 13px; line-height: 1.5; color: var(--text); background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 50%, var(--border)); border-radius: 11px; }
  .dl-info[hidden] { display: none; }
  .dl-info > span { flex: 1; min-width: 0; }
  .dl-info-icon { flex: 0 0 auto; margin-top: 2px; color: var(--accent); }
  .dl-info-x { flex: none; display: grid; place-items: center; width: 24px; height: 24px; margin-top: -1px; border: 0; border-radius: 7px; background: transparent; color: var(--text-muted); cursor: pointer; }
  .dl-info-x:hover { color: var(--text); background: var(--card-hover); }
  .dl-notice-icon { flex: 0 0 auto; margin-top: 2px; }
  .dl-notice-discord { color: var(--text-muted); background: rgba(88, 101, 242, 0.12); border-color: rgba(126, 140, 255, 0.55); }
  .dl-notice-discord .dl-notice-icon { color: #8a97ff; }
  .dl-login { width: 100%; justify-content: center; gap: 9px; font-size: 15px; font-weight: 600; padding: 12px 18px; border-radius: 12px; background: #5865f2; border: 1px solid #6875f7; color: #ffffff; }
  .dl-login:hover { background: #4752c4; }
  .dl-back { margin-top: 16px; padding: 4px 8px; font-size: 13px; color: #aeb9cc; text-decoration: none; border-radius: 8px; }
  .dl-back:hover { color: #ffffff; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 440px) { .dl-card { padding: 30px 20px 22px; } }
</style>
