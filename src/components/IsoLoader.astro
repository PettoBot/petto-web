---
// The isometric "loading" drawing: a plate with three blocks that go up and down one after the other, in CSS only (they slow down with "reduce motion").
// Used in the curtain of the dashboard (DashLoader), for example when the member goes to their profile, so the page does not just appear.
import IsoBox from './IsoBox.astro';
import { scene } from '../utils/iso';

interface Props { size?: number; class?: string }
const { size = 104, class: className = '' } = Astro.props;
const A = scene(14);
const base = A.box(0, 0, -0.3, 5.2, 5.2, 0.3);
const blocks = [A.box(0.5, 0.5, 0, 1.5, 1.5, 1.5), A.box(3.2, 0.5, 0, 1.5, 1.5, 1.1), A.box(1.9, 3.1, 0, 1.5, 1.5, 1.9)];
const view = A.view();
---
<svg class:list={['iso-loader', className]} viewBox={view} width={size} height={Math.round(size * 0.75)} aria-hidden="true" focusable="false">
  <IsoBox {...base} class="il-base" />
  {blocks.map((b, i) => <g class="il-block" style={`--i:${i}`}><IsoBox {...b} class="il-box" /></g>)}
</svg>
<style>
  .iso-loader { display: block; overflow: visible; }
  .iso-loader :global(polygon) { stroke: var(--text-dim); stroke-width: 1.4; stroke-linejoin: round; }
  .iso-loader :global(.f-left) { fill: var(--card); }
  .iso-loader :global(.f-right) { fill: color-mix(in srgb, var(--card) 70%, var(--bg)); }
  .iso-loader :global(.f-top) { fill: var(--card-hover); }
  .iso-loader :global(.il-box .f-top) { fill: color-mix(in srgb, var(--accent) 30%, var(--card-hover)); }
  .iso-loader :global(.il-box polygon) { stroke: color-mix(in srgb, var(--accent) 70%, var(--text-dim)); }
  .il-block { animation: ilBob 1.8s ease-in-out infinite; animation-delay: calc(var(--i) * .28s); }
  @keyframes ilBob { 0%, 100% { transform: translateY(0); } 30% { transform: translateY(-9px); } 60% { transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .il-block { animation-duration: 4s; } }
</style>
