---
// One blog post of the guides (src/data/blogGuides.ts): "Petto and other bots" and "How to switch from MEE6, Carl-bot or Dyno". The text is in that file, in the three languages.
import Base from '../layouts/Base.astro';
import { useTranslations, type Locale } from '../i18n/ui';
import { GUIDES, FIG_CAPTION, guideAuthor, guideContent, guideDate, type GuideKey } from '../data/blogGuides';
import figures from '../data/blogFigures.json';

interface Props { lang: Locale; guide: GuideKey }
const { lang, guide } = Astro.props;
const t = useTranslations(lang);
const c = guideContent(guide, lang);
const meta = GUIDES[guide];
const fl = lang === 'es' ? 'es' : lang === 'pt-BR' ? 'pt' : 'en';
const figure = (key: string): { src: string; w: number; h: number } => (figures as any)[key][fl];
// `code` between backticks in the text is drawn as code.
// An address (https://...) becomes a link; its last character is never a full stop or a comma.
const inline = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/`([^`]+)`/g, '<code>$1</code>').replace(/(https:\/\/[^\s<]*[^\s<.,)])/g, '<a href="$1" rel="noopener">$1</a>');
---
<Base title={c.title} lang={lang}>
  <main>
    <article class="post">
      <div class="wrap">
        <div class="post-banner reveal">
          <img src={meta.banner} alt={c.bannerAlt} />
        </div>
        <div class="post-head reveal">
          <span class="pill">{c.pill}</span>
          <h1>{c.h1}</h1>
          <div class="post-byline">
            <img src="/assets/mascot-icon.webp" alt="" />
            <span>{t.newsPosts.writtenBy} <b>{guideAuthor(lang)}</b> · {guideDate(guide, lang)}</span>
          </div>
        </div>

        <div class="post-body reveal">
          <p class="lede">{c.lede}</p>

          {c.sections.map((s) => (
            <>
              <h2>{s.h2}</h2>
              {s.p?.map((text) => <p set:html={inline(text)} />)}
              {s.list && <ul>{s.list.map(([bold, rest]) => <li><b>{bold}</b><Fragment set:html={inline(rest)} /></li>)}</ul>}
              {s.table && (
                <div class="tbl-wrap">
                  <table class={s.table.head.length > 3 ? 'wide' : ''}>
                    <thead><tr>{s.table.head.map((cell) => <th>{cell}</th>)}</tr></thead>
                    <tbody>{s.table.rows.map((row) => <tr>{row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td set:html={inline(cell)} />))}</tr>)}</tbody>
                  </table>
                </div>
              )}
              {s.after?.map((text) => <p set:html={inline(text)} />)}
              {s.figs?.map((key) => (
                <figure class={figure(key).h > figure(key).w * 1.2 ? 'tall' : ''}>
                  <img src={figure(key).src} width={figure(key).w} height={figure(key).h} alt={FIG_CAPTION[key][fl]} loading="lazy" decoding="async" />
                  <figcaption>{FIG_CAPTION[key][fl]}</figcaption>
                </figure>
              ))}
            </>
          ))}

          <p class="foot">{c.foot}</p>
        </div>
      </div>
    </article>
  </main>
</Base>

<style>
  .post { padding: 56px 0 100px; }
  .post-banner { border-radius: 16px; overflow: hidden; border: 1px solid var(--border-soft); margin-bottom: 28px; background: var(--card); }
  .post-banner img { width: 100%; height: auto; display: block; }
  .post-head { max-width: 68ch; margin: 0 auto 44px; }
  .pill { display: inline-block; font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); background: var(--bg-raise); border: 1px solid var(--border-soft); padding: 5px 12px; border-radius: 999px; margin-bottom: 18px; }
  .post-head h1 { font-size: 34px; line-height: 1.16; margin-bottom: 16px; }
  .post-byline { display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--text-dim); }
  .post-byline img { width: 26px; height: 26px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border); }
  .post-byline b { color: var(--text); font-weight: 600; }

  .post-body { max-width: 68ch; margin: 0 auto; }
  .post-body .lede { font-size: 16.5px; color: var(--text-muted); line-height: 1.6; margin-bottom: 36px; }
  .post-body h2 { font-size: 20px; margin: 40px 0 14px; }
  .post-body p { font-size: 15px; line-height: 1.75; color: var(--text-muted); margin: 0 0 16px; }
  .post-body p b { color: var(--text); font-weight: 600; }
  .post-body ul { margin: 0 0 16px; padding-left: 22px; display: flex; flex-direction: column; gap: 10px; }
  .post-body ul li { font-size: 15px; line-height: 1.65; color: var(--text-muted); }
  .post-body ul li b { color: var(--text); font-weight: 600; }
  .post-body :global(code) { font-family: var(--mono); font-size: 0.88em; background: var(--bg-raise); border: 1px solid var(--border-soft); border-radius: 6px; padding: 1px 6px; color: var(--text); }
  .post-body :global(a) { color: var(--accent); text-underline-offset: 3px; overflow-wrap: anywhere; }
  .post-body figure { margin: 6px 0 24px; }
  .post-body figure img { display: block; width: 100%; height: auto; border: 1px solid var(--border-soft); border-radius: 12px; background: var(--card); }
  .post-body figure.tall img { max-width: 460px; margin: 0 auto; }
  .post-body figure.tall figcaption { text-align: center; }
  .post-body figcaption { font-size: 12.5px; line-height: 1.5; color: var(--text-dim); margin-top: 8px; }
  .post-body .foot { font-size: 13px; color: var(--text-dim); border-top: 1px solid var(--border-soft); padding-top: 18px; margin-top: 44px; }

  /* The tables are wider than the text column: they scroll sideways inside their box and never push the page. */
  .tbl-wrap { overflow-x: auto; margin: 0 0 18px; border: 1px solid var(--border-soft); border-radius: 12px; background: var(--card); -webkit-overflow-scrolling: touch; }
  table { border-collapse: collapse; width: 100%; font-size: 13.5px; line-height: 1.5; }
  table.wide { min-width: 720px; }
  th, td { text-align: left; vertical-align: top; padding: 10px 14px; border-bottom: 1px solid var(--border-soft); color: var(--text-muted); }
  thead th { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-dim); background: var(--bg-raise); }
  tbody th { color: var(--text); font-weight: 600; width: 38%; }
  /* The wide table (five columns) keeps its first column in place while it scrolls sideways. */
  table.wide tbody th { width: auto; white-space: nowrap; position: sticky; left: 0; background: var(--card); box-shadow: 1px 0 0 var(--border-soft); }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }

  @media (max-width: 700px) {
    .post-head h1 { font-size: 27px; }
    .tbl-wrap { margin-left: -4px; margin-right: -4px; }
  }
</style>
