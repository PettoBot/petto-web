---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { useTranslations, localePath, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  postKey: 'nelu' | 'am' | 'code' | 'tools' | 'discordEncryption' | 'discordAgeVerification' | 'discordApi2026';
  banner?: string;
  bannerIcon?: string;
  avatar?: string;
  accent?: string;
  accentLight?: string;
  ctaHref?: string;
}
const { lang, postKey, banner, bannerIcon = 'ph:sparkle-fill', avatar = '/assets/mascot-icon.png', accent, accentLight, ctaHref = 'https://petto.sbs/support' } = Astro.props;
const t = useTranslations(lang);
const np = t.newsPosts;
const post = np[postKey];
const base = localePath[lang];
const ctaExternal = ctaHref.startsWith('http');
const ctaFinalHref = ctaExternal ? ctaHref : `${base}${ctaHref}`;
const accentStyle = accent ? `--np-accent-dark: ${accent};${accentLight ? ` --np-accent-light: ${accentLight};` : ''}` : undefined;
---
<Base title={`${post.title} · Petto`} lang={lang}>
  <main class="news" style={accentStyle}>
    <div class="news-banner-wrap">
      {banner ? (
        <img src={banner} alt="" class="news-banner" />
      ) : (
        <div class="news-banner news-banner-generated">
          <Icon name={bannerIcon} width="48" height="48" />
        </div>
      )}
      <span class="news-pill">{post.pill}</span>
    </div>

    <section class="news-body">
      <div class="wrap news-layout">
        <aside class="news-byline reveal">
          <img src={avatar} alt="" class="byline-avatar" />
          <div class="byline-label">{np.writtenBy}</div>
          <div class="byline-name">{post.author}</div>
          <div class="byline-label byline-label-2">{np.published}</div>
          <div class="byline-date">{post.date}</div>
        </aside>

        <div class="news-main reveal">
          <h1>{post.h1}</h1>
          <p class="news-lede">{post.lede}</p>

          <h2>{post.s1h}</h2>
          <p>{post.s1p}</p>

          <div class="news-callout">
            <ul>
              {post.facts.map((f) => (
                <li>
                  <Icon name="ph:check-circle-fill" class="fact-ic" />
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>

          <a class="news-cta" href={ctaFinalHref} target={ctaExternal ? '_blank' : undefined} rel={ctaExternal ? 'noopener' : undefined}>
            {post.ctaLabel}
            <Icon name="ph:arrow-right" width="14" height="14" />
          </a>

          <h2>{post.s2h}</h2>
          <p>{post.s2p}</p>

          <h2>{post.s3h}</h2>
          <p>{post.s3p}</p>

          <h2>{post.s4h}</h2>
          <p>{post.s4p}</p>
        </div>
      </div>

      <div class="news-share">
        <button class="share-btn" id="shareX" aria-label="Share on X" title="Share on X">
          <Icon name="simple-icons:x" width="15" height="15" />
        </button>
        <button class="share-btn" id="shareCopy" aria-label="Copy link" title="Copy link">
          <Icon name="ph:link-simple" width="16" height="16" />
        </button>
        <button class="share-btn" id="shareFb" aria-label="Share on Facebook" title="Share on Facebook">
          <Icon name="simple-icons:facebook" width="15" height="15" />
        </button>
      </div>
    </section>
  </main>
</Base>

<script>
  const xBtn = document.getElementById('shareX');
  const fbBtn = document.getElementById('shareFb');
  const copyBtn = document.getElementById('shareCopy');

  xBtn?.addEventListener('click', () => {
    window.open(`https://twitter.com/intent/tweet?url=${encodeURIComponent(location.href)}&text=${encodeURIComponent(document.title)}`, '_blank', 'noopener');
  });
  fbBtn?.addEventListener('click', () => {
    window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(location.href)}`, '_blank', 'noopener');
  });
  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(location.href);
      const icon = copyBtn.querySelector('svg');
      const original = copyBtn.title;
      copyBtn.title = 'Copied!';
      setTimeout(() => { copyBtn.title = original; }, 1500);
    } catch {
      // Clipboard permission denied or unavailable, nothing to fall back to here.
    }
  });
</script>

<style>
  .news { padding-bottom: 40px; }
  .news-banner-wrap { position: relative; max-width: 1120px; margin: 28px auto 0; padding: 0 28px; }
  .news-banner { width: 100%; aspect-ratio: 16 / 6.2; object-fit: cover; border-radius: 16px; border: 1px solid var(--border); background: var(--bg-raise); }
  .news-banner-generated { display: flex; align-items: center; justify-content: center; color: var(--np-accent); background: linear-gradient(135deg, color-mix(in srgb, var(--np-accent) 18%, var(--bg-raise)), var(--bg-raise)); }
  .news-pill { position: absolute; bottom: -13px; left: 50%; transform: translateX(-50%); background: var(--card); border: 1px solid var(--border); padding: 5px 16px; border-radius: 999px; font-family: var(--mono); font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); box-shadow: 0 8px 20px -8px rgba(0,0,0,0.35); }

  .news-body { padding: 52px 0 20px; }
  .news-layout { display: grid; grid-template-columns: 150px 1fr; gap: 48px; align-items: start; }

  .news-byline { position: sticky; top: 90px; display: flex; flex-direction: column; }
  .byline-avatar { width: 52px; height: 52px; border-radius: 12px; object-fit: cover; border: 1px solid var(--border); margin-bottom: 12px; background: color-mix(in srgb, var(--np-accent) 22%, var(--bg-raise)); }
  .byline-label { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-dim); }
  .byline-label-2 { margin-top: 12px; }
  .byline-name { font-size: 13.5px; font-weight: 600; color: var(--text); margin-top: 3px; }
  .byline-date { font-size: 13px; color: var(--text-muted); margin-top: 3px; }

  .news-main h1 { font-size: 34px; margin-bottom: 16px; }
  .news-main .news-lede { font-size: 16.5px; color: var(--text-muted); line-height: 1.65; margin-bottom: 30px; }
  .news-main h2 { font-size: 20px; margin: 34px 0 12px; }
  .news-main p { font-size: 15px; color: var(--text-muted); line-height: 1.7; margin: 0; }

  .news { --np-accent-dark: var(--accent); --np-accent-light: var(--accent); --np-accent: var(--np-accent-dark); }
  :root[data-theme="light"] .news { --np-accent: var(--np-accent-light); }
  @media (prefers-color-scheme: light) { :root:not([data-theme="dark"]) .news { --np-accent: var(--np-accent-light); } }
  .news-callout { border: 1px solid var(--border); border-left: 3px solid var(--np-accent); border-radius: 12px; background: var(--bg-raise); padding: 18px 20px; margin: 26px 0; }
  .news-callout ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 11px; }
  .news-callout li { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; color: var(--text); line-height: 1.5; }
  .news-callout :global(.fact-ic) { width: 15px; height: 15px; color: var(--np-accent); flex-shrink: 0; margin-top: 2px; }

  .news-cta { display: inline-flex; align-items: center; gap: 7px; font-size: 14px; font-weight: 600; color: var(--np-accent); text-decoration: none; margin-bottom: 6px; }
  .news-cta:hover { text-decoration: underline; }

  .news-share { display: flex; justify-content: center; gap: 10px; padding-top: 44px; margin-top: 20px; border-top: 1px solid var(--border-soft); }
  .share-btn { width: 34px; height: 34px; border-radius: 8px; border: 1px solid var(--border); background: transparent; color: var(--text-muted); cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .share-btn:hover { color: var(--text); border-color: var(--text-dim); }

  @media (max-width: 640px) {
    .news-layout { grid-template-columns: 1fr; }
    .news-byline { position: static; flex-direction: row; align-items: center; gap: 12px; }
    .byline-label-2 { margin-top: 0; margin-left: 18px; }
    .news-main h1 { font-size: 27px; }
  }
</style>
