---
// One place for the questions of the dashboard ("Delete this?", "Restore this backup?"): a card in the middle of the screen over a dimmed
// layer, in the look of the dashboard, instead of the browser's own window ("petto.sbs says..."). Scripts call
//   window.dglConfirm(text, { title, confirm, cancel, tone: 'danger' | 'neutral' })   ->  a promise that settles with true (yes) or false
// and a button or form can ask by itself with data-confirm="<text>" (the form is sent, or the button pressed, only after a yes; the button's
// own label is the label of the yes). Escape, a click outside and "Cancel" say no. The card comes in and goes out with the motion tokens
// (DashMotion.astro), and the focus goes to "Cancel" (the safe answer) and comes back to where it was.
import { getDashLang, makeT } from '../i18n/dash';
const dt = makeT(getDashLang(Astro));
const words = { title: dt('Are you sure?'), confirm: dt('Confirm'), cancel: dt('Cancel') };
---
<script is:inline set:html={`window.dglConfirmWords = ${JSON.stringify(words)};`}></script>
<script is:inline>
  (function () {
    if (window.dglConfirm) return;
    var ICON = '<svg viewBox="0 0 256 256" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M236.8 188.09 149.35 36.22a24.76 24.76 0 0 0-42.7 0L19.2 188.09a23.51 23.51 0 0 0 0 23.72A24.35 24.35 0 0 0 40.55 224h174.9a24.35 24.35 0 0 0 21.33-12.19 23.51 23.51 0 0 0 .02-23.72ZM120 104a8 8 0 0 1 16 0v40a8 8 0 0 1-16 0Zm8 88a12 12 0 1 1 12-12 12 12 0 0 1-12 12Z"/></svg>';
    var open = null;
    function words() { return window.dglConfirmWords || { title: 'Are you sure?', confirm: 'Confirm', cancel: 'Cancel' }; }
    window.dglConfirm = function (text, opts) {
      opts = opts || {};
      // One question at a time: asking again while one is open answers "no" to the old one.
      if (open) open(false);
      return new Promise(function (resolve) {
        var w = words();
        var returnTo = document.activeElement;
        var layer = document.createElement('div');
        layer.className = 'dgl-ask';
        layer.setAttribute('role', 'alertdialog');
        layer.setAttribute('aria-modal', 'true');
        var box = document.createElement('div');
        box.className = 'dgl-ask-box' + (opts.tone === 'neutral' ? ' neutral' : ' danger');
        var icon = document.createElement('span'); icon.className = 'dgl-ask-icon'; icon.innerHTML = ICON; icon.setAttribute('aria-hidden', 'true');
        var title = document.createElement('h2'); title.className = 'dgl-ask-title'; title.id = 'dgl-ask-title'; title.textContent = opts.title || w.title;
        var body = document.createElement('p'); body.className = 'dgl-ask-text'; body.id = 'dgl-ask-text'; body.textContent = text || '';
        var yes = document.createElement('button'); yes.type = 'button'; yes.className = 'dgl-ask-yes'; yes.textContent = opts.confirm || w.confirm;
        var no = document.createElement('button'); no.type = 'button'; no.className = 'dgl-ask-no'; no.textContent = opts.cancel || w.cancel;
        layer.setAttribute('aria-labelledby', 'dgl-ask-title'); layer.setAttribute('aria-describedby', 'dgl-ask-text');
        box.append(icon, title, body, yes, no);
        layer.appendChild(box);
        var settled = false;
        function finish(answer) {
          if (settled) return;
          settled = true;
          open = null;
          document.removeEventListener('keydown', onKey, true);
          var done = function () {
            layer.remove();
            document.documentElement.classList.remove('dgl-ask-open');
            if (returnTo && returnTo.isConnected && returnTo.focus) { try { returnTo.focus({ preventScroll: true }); } catch (e) {} }
            resolve(answer);
          };
          if (window.dglMotion) window.dglMotion.leave(layer, done); else done();
        }
        function onKey(e) {
          if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); finish(false); return; }
          if (e.key === 'Tab') {
            // The focus stays inside the card: between its two buttons.
            e.preventDefault();
            (document.activeElement === no ? yes : no).focus();
          }
        }
        yes.addEventListener('click', function () { finish(true); });
        no.addEventListener('click', function () { finish(false); });
        layer.addEventListener('mousedown', function (e) { if (e.target === layer) finish(false); });
        document.addEventListener('keydown', onKey, true);
        open = finish;
        document.documentElement.classList.add('dgl-ask-open');
        document.body.appendChild(layer);
        no.focus({ preventScroll: true });
      });
    };

    // data-confirm on a button or on a form: the action waits for a yes. The answer is given once; then the same click or submit goes on.
    var passing = false;
    document.addEventListener('click', function (event) {
      if (passing) return;
      var button = event.target && event.target.closest ? event.target.closest('button[data-confirm], a[data-confirm], [role="button"][data-confirm]') : null;
      if (!button || button.disabled) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      window.dglConfirm(button.getAttribute('data-confirm'), { confirm: (button.getAttribute('data-confirm-yes') || button.textContent || button.getAttribute('aria-label') || '').trim().slice(0, 40) || undefined }).then(function (yes) {
        if (!yes) return;
        passing = true;
        try { button.click(); } finally { passing = false; }
      });
    }, true);
    document.addEventListener('submit', function (event) {
      if (passing) return;
      var form = event.target;
      if (!form || !form.getAttribute || !form.hasAttribute('data-confirm')) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      var submitter = event.submitter || null;
      window.dglConfirm(form.getAttribute('data-confirm')).then(function (yes) {
        if (!yes) return;
        passing = true;
        try { if (form.requestSubmit) form.requestSubmit(submitter || undefined); else form.submit(); } finally { passing = false; }
      });
    }, true);
  })();
</script>

<style is:global>
  .dgl-ask { position: fixed; inset: 0; z-index: 1300; display: grid; place-items: center; padding: 20px; background: rgba(8, 9, 12, .62); animation: m-fade-in var(--m-base) var(--m-out) both; }
  .dgl-ask.dgl-leave { animation: m-fade-out var(--m-base) var(--m-in) both !important; }
  .dgl-ask-box { box-sizing: border-box; width: min(100%, 400px); display: flex; flex-direction: column; align-items: stretch; gap: 0; padding: 26px 22px 20px; border-radius: 20px; border: 1px solid var(--border); background: var(--card); color: var(--text); box-shadow: 0 30px 80px -20px rgba(0, 0, 0, .65); text-align: center; animation: m-dialog-in 260ms var(--m-out) both; }
  .dgl-ask.dgl-leave .dgl-ask-box { animation: m-dialog-out var(--m-base) var(--m-in) both; }
  .dgl-ask-icon { align-self: center; display: grid; place-items: center; width: 54px; height: 54px; margin-bottom: 14px; border-radius: 16px; color: var(--red); background: color-mix(in srgb, var(--red) 14%, transparent); }
  .dgl-ask-box.neutral .dgl-ask-icon { color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); }
  .dgl-ask-title { margin: 0 0 8px; font-size: 20px; line-height: 1.25; letter-spacing: -.01em; }
  .dgl-ask-text { margin: 0 0 20px; font-size: 14px; line-height: 1.5; color: var(--text-muted); overflow-wrap: anywhere; }
  .dgl-ask-yes, .dgl-ask-no { box-sizing: border-box; width: 100%; min-height: 46px; padding: 10px 16px; border-radius: 12px; font: inherit; font-size: 15px; font-weight: 600; cursor: pointer; touch-action: manipulation; transition: filter var(--m-fast) ease, background-color var(--m-fast) ease, transform var(--m-instant) ease; }
  .dgl-ask-yes { border: 0; color: #fff; background: var(--red); }
  .dgl-ask-box.neutral .dgl-ask-yes { color: #1b1b1b; background: var(--accent); }
  .dgl-ask-yes:hover { filter: brightness(1.08); }
  .dgl-ask-no { margin-top: 10px; border: 1px solid var(--border); color: var(--text); background: transparent; }
  .dgl-ask-no:hover { background: var(--card-hover); }
  .dgl-ask-yes:active, .dgl-ask-no:active { transform: scale(.985); }
  .dgl-ask-yes:focus-visible, .dgl-ask-no:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  html.dgl-ask-open, html.dgl-ask-open body { overflow: hidden; }
  @media (prefers-reduced-motion: reduce) { .dgl-ask, .dgl-ask-box { animation: none; } }
</style>
