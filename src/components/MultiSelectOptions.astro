---
// The full option list of every <MultiSelect source={name}> on the page, written once (see MultiSelect.astro).
interface Props { name: string; options: { id: string; name: string }[] }
const { name, options } = Astro.props;
const json = JSON.stringify(options.map((o) => ({ id: o.id, name: o.name }))).replace(/</g, '\\u003c');
---
<script type="application/json" data-ms-options={name} set:html={json}></script>
