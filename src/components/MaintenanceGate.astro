---
// A part of the dashboard that is paused: instead of its page, one compact note that says so.
import { Icon } from 'astro-icon/components';
import { getDashLang, makeT } from '../i18n/dash';
const dt = makeT(getDashLang(Astro));
interface Props { active: boolean; title: string; description: string }
const { active, title, description } = Astro.props;
---
{active ? (
  <div class="maint-note" role="note" aria-label={dt('Maintenance')}>
    <span class="maint-gate-icon"><Icon name="ph:wrench-fill" width="18" height="18" /></span>
    <div>
      <span class="maint-gate-kicker">{dt('Maintenance')}</span>
      <h2>{title}</h2>
      <p>{description}</p>
    </div>
  </div>
) : <slot />}

<style>
  /* A part of the dashboard that is paused says so with one compact note, centered near the top. Its page is not drawn behind it. */
  .maint-note { display: flex; align-items: flex-start; gap: 16px; width: min(560px, 100%); box-sizing: border-box; margin: 6px auto 0; padding: 20px 22px; border: 1px solid color-mix(in srgb, var(--yellow) 50%, var(--border)); border-radius: 15px; background: color-mix(in srgb, var(--card) 94%, var(--yellow) 6%); animation: maint-in .4s cubic-bezier(.2, .8, .2, 1) both; }
  .maint-gate-icon { flex: none; display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; color: var(--yellow); background: color-mix(in srgb, var(--yellow) 15%, transparent); animation: maint-sway 3.2s ease-in-out infinite; }
  .maint-gate-kicker { display: block; color: var(--yellow); font-size: 12px; font-weight: 600; }
  .maint-note h2 { margin: 4px 0 6px; font-family: var(--serif); font-size: 20px; line-height: 1.15; }
  .maint-note p { margin: 0; max-width: 46ch; color: var(--text-muted); font-size: 13px; line-height: 1.55; }
  @keyframes maint-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes maint-sway { 0%, 100% { transform: rotate(-8deg); } 50% { transform: rotate(8deg); } }
  @media (max-width: 560px) { .maint-note { padding: 16px; gap: 12px; } }
  @media (prefers-reduced-motion: reduce) { .maint-note, .maint-gate-icon { animation: none; } }
</style>
