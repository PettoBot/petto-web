---
// A part of the dashboard that is paused: its page is drawn as usual but blurred, with a card over it that says so (the same look as the Premium gate).
import { Icon } from 'astro-icon/components';
import { getDashLang, makeT } from '../i18n/dash';
const dt = makeT(getDashLang(Astro));
interface Props { active: boolean; title: string; description: string }
const { active, title, description } = Astro.props;
---
<div class:list={['maint-gate', { 'maint-gate-on': active }]}>
  <div class="maint-gate-content" inert={active}>
    <slot />
  </div>
  {active && (
    <div class="maint-gate-overlay" role="note" aria-label={dt('Maintenance')}>
      <div class="maint-gate-card">
        <span class="maint-gate-icon"><Icon name="ph:wrench-fill" width="18" height="18" /></span>
        <span class="maint-gate-kicker">{dt('Maintenance')}</span>
        <h2>{title}</h2>
        <p>{description}</p>
      </div>
    </div>
  )}
</div>

<style>
  .maint-gate { position: relative; min-width: 0; }
  .maint-gate-on { isolation: isolate; min-height: 420px; }
  .maint-gate-on .maint-gate-content { filter: blur(3px); opacity: .4; pointer-events: none; user-select: none; max-height: 720px; overflow: hidden; }
  .maint-gate-overlay { position: absolute; inset: 0; z-index: 3; display: grid; place-items: center; padding: 28px; border: 1px solid color-mix(in srgb, var(--yellow) 38%, var(--border)); border-radius: 16px; background: color-mix(in srgb, var(--bg) 70%, transparent); backdrop-filter: blur(6px); animation: maint-in .4s cubic-bezier(.2, .8, .2, 1) both; }
  .maint-gate-card { width: min(400px, 100%); padding: 26px; border: 1px solid color-mix(in srgb, var(--yellow) 50%, var(--border)); border-radius: 15px; background: color-mix(in srgb, var(--card) 94%, var(--yellow) 6%); box-shadow: 0 20px 60px color-mix(in srgb, var(--bg) 55%, transparent); text-align: center; }
  .maint-gate-icon { display: inline-grid; place-items: center; width: 40px; height: 40px; margin-bottom: 11px; border-radius: 12px; color: var(--yellow); background: color-mix(in srgb, var(--yellow) 15%, transparent); animation: maint-sway 3.2s ease-in-out infinite; }
  .maint-gate-kicker { display: block; color: var(--yellow); font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .maint-gate-card h2 { margin: 8px 0 7px; font-family: var(--serif); font-size: 23px; line-height: 1.1; }
  .maint-gate-card p { margin: 0 auto; max-width: 34ch; color: var(--text-muted); font-size: 13px; line-height: 1.55; }
  @keyframes maint-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes maint-sway { 0%, 100% { transform: rotate(-8deg); } 50% { transform: rotate(8deg); } }
  @media (max-width: 560px) { .maint-gate-overlay { padding: 14px; } .maint-gate-card { padding: 20px 16px; } }
  @media (prefers-reduced-motion: reduce) { .maint-gate-overlay, .maint-gate-icon { animation: none; } }
</style>
