---
import { isStillNew } from '../utils/newBadge';
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import { getDashLang, makeT } from '../i18n/dash';
import { MODULES, CATEGORIES, GUIDE } from '../utils/dashModules';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  statuses: Record<string, { state: 'on' | 'todo' | 'info'; note: string }>;
}
const { user, guildId, guildName, guildIcon, statuses } = Astro.props;

const steps = GUIDE.map((step) => ({ ...step, mod: MODULES.find((m) => m.id === step.module)!, state: statuses[step.module]?.state }));
const known = steps.filter((s) => s.state);
const done = known.filter((s) => s.state === 'on').length;
const pct = known.length ? Math.round((done / known.length) * 100) : 0;
const next = steps.find((s) => s.state === 'todo');
// How many modules each filter chip holds.
const inCategory = (id: string) => MODULES.filter((m) => m.category === id).length;
const toSetUp = MODULES.filter((m) => statuses[m.id]?.state === 'todo').length;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="modules" pageTitle="Modules">
  <h1>{dt('Modules')}</h1>

  <section class="md-guide" aria-labelledby="md-guide-title">
    <div class="md-guide-top">
      <div>
        <h2 id="md-guide-title">{dt('Setup guide')}</h2>
        <p class="md-guide-sub">{done === known.length && known.length > 0 ? dt('Everything on the guide is ready. Look for more below.') : dt('A few steps leave the server ready.')}</p>
      </div>
      <div class="md-ring" style={`--p:${pct}`} role="img" aria-label={`${pct}%`}><span>{done}/{known.length || steps.length}</span></div>
    </div>
    <div class="md-bar" aria-hidden="true"><i style={`width:${pct}%`}></i></div>
    <ol class="md-steps">
      {steps.map((s) => (
        <li class:list={['md-step', { done: s.state === 'on', next: next && next.id === s.id }]}>
          <a href={s.mod.href(guildId)}>
            <span class="md-check">{s.state === 'on' ? <Icon name="ph:check-bold" width="12" height="12" /> : null}</span>
            <span class="md-step-text"><strong>{dt(s.label)}</strong><span>{dt(s.hint)}</span></span>
            <Icon name="ph:caret-right-bold" width="12" height="12" class="md-step-go" />
          </a>
        </li>
      ))}
    </ol>
    {next && <a class="btn btn-accent btn-sm md-next" href={next.mod.href(guildId)}>{dt('Next step')}: {dt(next.label)}<Icon name="ph:arrow-right-bold" width="12" height="12" /></a>}
  </section>

  <div class="md-tools">
    <label class="md-search"><Icon name="ph:magnifying-glass-bold" width="14" height="14" /><input type="search" id="md-search" placeholder={dt('Search modules...')} autocomplete="off" /><kbd>/</kbd></label>
    <div class="md-chips" id="md-chips" role="tablist">
      <button type="button" class="md-chip on" data-cat="all">{dt('All')}<span class="md-chip-n">{MODULES.length}</span></button>
      {CATEGORIES.map((c) => <button type="button" class="md-chip" data-cat={c.id}>{dt(c.label)}<span class="md-chip-n">{inCategory(c.id)}</span></button>)}
      <button type="button" class="md-chip" data-cat="todo">{dt('To set up')}<span class="md-chip-n">{toSetUp}</span></button>
    </div>
  </div>

  <div class="md-grid dgl-stagger" id="md-grid">
    {MODULES.map((m) => {
      const st = statuses[m.id];
      return (
        <a class="md-card" href={m.href(guildId)} data-cat={m.category} data-state={st?.state ?? 'info'} data-text={`${dt(m.title)} ${dt(m.desc)}`.toLowerCase()} style={`--c:${m.color}`}>
          <span class="md-card-icon"><Icon name={m.icon} width="18" height="18" /></span>
          <span class="md-card-body">
            <span class="md-card-title">{dt(m.title)}{isStillNew(m.since) && <em class="md-new">{dt('New')}</em>}</span>
            <span class="md-card-desc">{dt(m.desc)}</span>
          </span>
          {st && <span class:list={['md-pill', st.state]}>{st.state === 'on' ? (st.note ? st.note : dt('On')) : dt('Set up')}</span>}
        </a>
      );
    })}
  </div>
  <p class="md-empty" id="md-empty" hidden><Icon name="ph:magnifying-glass" width="16" height="16" />{dt('No modules match.')}</p>

  <script is:inline>
    (function () {
      var grid = document.getElementById('md-grid');
      if (!grid) return;
      var input = document.getElementById('md-search');
      var chips = Array.prototype.slice.call(document.querySelectorAll('#md-chips .md-chip'));
      var empty = document.getElementById('md-empty');
      var cards = Array.prototype.slice.call(grid.querySelectorAll('.md-card'));
      var cat = 'all';
      function apply() {
        var q = (input.value || '').trim().toLowerCase();
        var shown = 0;
        cards.forEach(function (card) {
          var okCat = cat === 'all' || (cat === 'todo' ? card.getAttribute('data-state') === 'todo' : card.getAttribute('data-cat') === cat);
          var okText = !q || card.getAttribute('data-text').indexOf(q) !== -1;
          var show = okCat && okText;
          card.hidden = !show;
          if (show) shown += 1;
        });
        if (empty) empty.hidden = shown !== 0;
      }
      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          cat = chip.getAttribute('data-cat');
          chips.forEach(function (c) { c.classList.toggle('on', c === chip); });
          apply();
        });
      });
      input.addEventListener('input', apply);
      if (!window.__mdSlash) {
        window.__mdSlash = true;
        document.addEventListener('keydown', function (e) {
          var field = document.getElementById('md-search');
          if (e.key === '/' && field && document.activeElement !== field && !/^(INPUT|TEXTAREA|SELECT)$/.test((document.activeElement || {}).tagName || '')) {
            e.preventDefault();
            field.focus();
          }
        });
      }
    })();
  </script>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 18px; }
  .md-guide { border: 1px solid var(--border); border-radius: 16px; padding: 18px; background: var(--card); margin-bottom: 22px; display: flex; flex-direction: column; gap: 14px; }
  .md-guide-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .md-guide h2 { margin: 0; font-size: 16px; }
  .md-guide-sub { margin: 4px 0 0; font-size: 13px; color: var(--text-muted); }
  .md-ring { --p: 0; width: 52px; height: 52px; border-radius: 50%; flex-shrink: 0; display: grid; place-items: center; background: conic-gradient(var(--accent) calc(var(--p) * 1%), var(--bg-raise) 0); position: relative; font-size: 11.5px; font-weight: 700; font-family: var(--mono); }
  .md-ring::before { content: ''; position: absolute; inset: 5px; border-radius: 50%; background: var(--card); }
  .md-ring span { position: relative; }
  .md-bar { height: 6px; border-radius: 999px; background: var(--bg-raise); overflow: hidden; }
  .md-bar i { display: block; height: 100%; border-radius: inherit; background: var(--accent); transition: width .6s cubic-bezier(.2,.7,.3,1); }
  .md-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); gap: 8px; }
  .md-step a { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 12px; text-decoration: none; color: var(--text); background: var(--bg-raise); transition: border-color .16s ease, transform .16s ease, background .16s ease; }
  .md-step a:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); transform: translateY(-1px); }
  .md-check { width: 20px; height: 20px; border-radius: 50%; border: 1.5px solid var(--border); display: grid; place-items: center; flex-shrink: 0; color: var(--bg); }
  .md-step.done .md-check { background: var(--green); border-color: var(--green); }
  .md-step.next a { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .md-step-text { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .md-step-text strong { font-size: 13.5px; }
  .md-step-text span { font-size: 12px; color: var(--text-muted); }
  .md-step.done .md-step-text strong { color: var(--text-muted); text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--text-muted) 50%, transparent); }
  .md-step-go { color: var(--text-dim); flex-shrink: 0; }
  .md-next { align-self: flex-start; display: inline-flex; align-items: center; gap: 7px; }

  .md-tools { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-bottom: 16px; }
  .md-search { display: flex; align-items: center; gap: 8px; flex: 1 1 240px; max-width: 360px; padding: 0 12px; border: 1px solid var(--border); border-radius: 12px; background: var(--card); color: var(--text-dim); transition: border-color .16s ease, box-shadow .16s ease; }
  .md-search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .md-search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--text); font: inherit; font-size: 13.5px; padding: 10px 0; }
  .md-search input:focus { box-shadow: none; }
  .md-search kbd { font-family: var(--mono); font-size: 11px; padding: 1px 6px; border: 1px solid var(--border); border-radius: 6px; color: var(--text-dim); }
  .md-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .md-chip { display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border: 1px solid var(--border); border-radius: 999px; background: transparent; color: var(--text-muted); font: inherit; font-size: 12.5px; cursor: pointer; transition: background var(--m-fast) var(--m-std), color var(--m-fast) var(--m-std), border-color var(--m-fast) var(--m-std), transform var(--m-instant) var(--m-std); }
  .md-chip-n { font-family: var(--mono); font-size: 10.5px; color: var(--text-dim); }
  .md-chip.on .md-chip-n { color: var(--accent); }
  .md-chip:hover { color: var(--text); border-color: color-mix(in srgb, var(--accent) 35%, var(--border)); }
  .md-chip:active { transform: scale(var(--m-press)); }
  .md-chip.on { color: var(--text); background: var(--accent-soft); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }

  .md-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(290px, 100%), 1fr)); gap: 12px; }
  .md-card { position: relative; display: flex; align-items: flex-start; gap: 12px; padding: 16px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); text-decoration: none; color: var(--text); transition: transform var(--m-base) var(--m-out), border-color var(--m-base) var(--m-std), box-shadow var(--m-slow) var(--m-std); }
  .md-card[hidden] { display: none; }
  .md-card:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--c) 55%, var(--border)); box-shadow: 0 14px 28px -22px var(--c); }
  .md-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .md-card-icon { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; flex-shrink: 0; color: var(--c); background: color-mix(in srgb, var(--c) 16%, transparent); }
  .md-card-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1; }
  .md-card-title { font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 7px; }
  .md-card-desc { font-size: 12.5px; color: var(--text-muted); line-height: 1.45; }
  .md-new { font-family: var(--mono); font-style: normal; font-size: 9px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--accent); background: var(--accent-soft); padding: 1px 6px; border-radius: 5px; }
  .md-pill { flex-shrink: 0; font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 999px; background: var(--bg-raise); color: var(--text-dim); }
  .md-pill.on { color: var(--green); background: var(--green-soft); }
  .md-pill.todo { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 14%, transparent); }
  .md-empty { display: flex; align-items: center; gap: 8px; color: var(--text-muted); font-size: 13.5px; margin-top: 18px; padding: 14px 16px; border: 1px dashed var(--border); border-radius: 14px; }
  .md-empty[hidden] { display: none; }
  .md-empty :global(svg) { color: var(--accent); flex: none; }
  @media (prefers-reduced-motion: reduce) { .md-card, .md-step a, .md-bar i { transition: none; } }
</style>
