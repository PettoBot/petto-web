---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashChartTip from './DashChartTip.astro';
import StatsChartStyle from './StatsChartStyle.astro';
import { barChart, lineChart, tickLabels } from '../utils/statsChart.mjs';
import { buildSeries, changeChip, dayRows, seriesSummary, type Series, type SeriesKey } from '../utils/dashStatsView';
import { dashLocale, getDashLang, makeT } from '../i18n/dash';
import { STAT_TABS, BOT_TIME_LABEL, BOT_TIME_ZONE, type StatsData } from '../utils/activityStats';
import { FREE_STAT_DAYS, PREMIUM_STAT_DAYS } from '../utils/planLimits';
import DashMemberPick from './DashMemberPick.astro';
import DashStatsAnalysis from './DashStatsAnalysis.astro';
import type { Analysis, StatsRules } from '../utils/statsAnalysis';

const statsLang = getDashLang(Astro);
const dt = makeT(statsLang);
const numLocale = dashLocale(statsLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  stats: StatsData;
  days: number;
  tab: string;
  channelNames: Record<string, string>;
  memberNames: Record<string, string>;
  inviters: { id: string; joins: number; leaves: number; fake?: number; bonus?: number; net: number }[];
  hasFlow: boolean;
  premium?: boolean;
  inviteRoles?: { id: string; name: string; color: number }[];
  inviteSettings?: { fakeDays: number; quickLeaveMinutes?: number; ignoreBots?: boolean; subtractLeaves?: boolean; extended?: boolean; rewards: { roleId: string; invites: number; name: string | null; color: number }[] };
  invitePeriod?: 'all' | 'week' | 'month';
  inviteMember?: { id: string; joins: number; leaves: number; fake: number; bonus: number; total: number; invitedBy: { id: string | null; code: string | null; source: string; fake: boolean; joinedAt: string | null } | null; codes: { code: string; joins: number; left: number; fake: number }[] } | null;
  inviteMessage?: { kind: 'ok' | 'err'; text: string } | null;
  analysis: Analysis;
  rules: StatsRules;
  dataMessage?: { kind: 'ok' | 'err'; text: string } | null;
  /** Members now (what Discord says), to count the members line back from; null when it is not known. */
  memberTotal?: number | null;
}
const { user, guildId, guildName, guildIcon, stats, days, tab, channelNames, memberNames, inviters, hasFlow, premium = false, inviteRoles = [], inviteSettings = { fakeDays: 3, rewards: [] }, invitePeriod = 'all', inviteMember = null, inviteMessage = null, analysis, rules, dataMessage = null, memberTotal = null } = Astro.props;
const roleColor = (color: number) => (color ? `#${color.toString(16).padStart(6, '0')}` : 'var(--text-dim)');
const rewardIds = new Set(inviteSettings.rewards.map((reward) => reward.roleId));
// The three newer settings are shown only when the bot knows them (it is updated before the site).
const extended = Boolean(inviteSettings.extended);
const periodLinks: { value: 'all' | 'week' | 'month'; label: string }[] = [{ value: 'all', label: dt('All time') }, { value: 'week', label: dt('This week') }, { value: 'month', label: dt('This month') }];
const sourceText = (source: string) => source === 'vanity' ? dt('the server link') : source === 'bot' ? dt('a bot account') : source === 'unknown' ? dt('a link Petto could not identify') : dt('an invite');
const whenText = (iso: string | null) => (iso ? new Date(iso).toLocaleDateString(numLocale, { year: 'numeric', month: 'short', day: 'numeric', timeZone: BOT_TIME_ZONE }) : '');
const inviterLine = (row: { joins: number; leaves: number; bonus?: number }) => row.bonus ? dt('{a} joined, {b} left, {c} bonus', { a: n(row.joins), b: n(row.leaves), c: (row.bonus > 0 ? '+' : '') + n(row.bonus) }) : dt('{a} joined, {b} left', { a: n(row.joins), b: n(row.leaves) });

const tabs: Record<string, { label: string; icon: string; color: string }> = {
  overview: { label: 'Overview', icon: 'ph:squares-four-fill', color: '#f0a88f' },
  messages: { label: 'Messages', icon: 'ph:chat-circle-text-fill', color: '#f0a88f' },
  voice: { label: 'Voice', icon: 'ph:microphone-fill', color: '#9bd0f5' },
  joins: { label: 'Joins', icon: 'ph:user-plus-fill', color: '#8fdca8' },
  leaves: { label: 'Leaves', icon: 'ph:user-minus-fill', color: '#f08fa0' },
  invites: { label: 'Invites', icon: 'ph:link-fill', color: '#c6a8f5' },
  sanctions: { label: 'Sanctions', icon: 'ph:gavel-fill', color: '#f5c26b' },
  heatmap: { label: 'Heat map', icon: 'ph:fire-fill', color: '#f0a88f' },
  growth: { label: 'Growth', icon: 'ph:chart-line-up-fill', color: '#8fdca8' },
  compare: { label: 'Compare', icon: 'ph:scales-fill', color: '#c6a8f5' },
  data: { label: 'Data and privacy', icon: 'ph:shield-check-fill', color: '#9aa3b2' },
};
const WEEKDAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const FULL_WEEKDAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const n = (value: number) => Math.round(value).toLocaleString(numLocale);
function hoursText(seconds: number) {
  const minutes = Math.floor(seconds / 60);
  return minutes >= 60 ? Math.floor(minutes / 60) + 'h ' + (minutes % 60) + 'm' : minutes + 'm';
}
const dayLabel = (day: string) => new Date(`${day}T00:00:00Z`).toLocaleDateString(numLocale, { month: 'short', day: 'numeric', timeZone: 'UTC' });
const dayText = (day: string, opts: Intl.DateTimeFormatOptions) => new Date(`${day}T00:00:00Z`).toLocaleDateString(numLocale, { ...opts, timeZone: 'UTC' });
const hourLabel = (hour: number) => `${String(hour).padStart(2, '0')}:00`;
const growth = stats.totals.joins - stats.totals.leaves;
const num0 = new Intl.NumberFormat(numLocale, { maximumFractionDigits: 0 });
const num1 = new Intl.NumberFormat(numLocale, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const fmtHours = (v: number) => (v >= 10 ? String(Math.round(v)) : v.toFixed(1));
const signedOf = (format: (v: number) => string) => (v: number) => `${v > 0 ? '+' : v < 0 ? '−' : ''}${format(Math.abs(v))}`;
const colorOf = (name: string) => `var(--m-${name})`;

// ── The charts: an SVG for a small card, one for a medium one and one for a large one (the card picks by its own width, so a phone gets a chart
// drawn at its size, with text that stays readable). All come from src/utils/statsChart.mjs, the same builders as the public stats page. ──
const SIZES = { s: { W: 340, H: 230 }, m: { W: 520, H: 250 }, l: { W: 760, H: 270 } };
const chartText = { todaySoFar: dt('Today, so far'), estimatedTag: '', changeVsPrev: dt('vs the day before') };
interface ChartDef { title: string; sub: string; chip?: { change: number | null; inverse: boolean } | null; summary?: { label: string; value: string; sub?: string }[]; html: { s: string; m: string; l: string } | null; message?: string; span?: boolean }
const both = (make: (size: { W: number; H: number }) => string) => ({ s: make(SIZES.s), m: make(SIZES.m), l: make(SIZES.l) });

const series = buildSeries(stats, analysis, memberTotal);
const VOICE = { format: (v: number) => `${fmtHours(v)}h`, ticks: (t: number[]) => tickLabels(t, { locale: numLocale, num: num0, num1, fractional: true }) };
const COUNT = { format: (v: number) => n(v), ticks: (t: number[]) => tickLabels(t, { locale: numLocale, num: num0, num1, fractional: false }) };

/** A chart of a series of days: a smooth line (messages, voice, reactions, members) or bars (joins, leaves, net...), with today so far as the last point. */
function seriesChart(key: SeriesKey, o: { title: string; sub: string; color: string; shape: 'line' | 'bars'; hours?: boolean; floorZero?: boolean; chip?: ChartDef['chip']; summary?: boolean; span?: boolean }): ChartDef {
  const source: Series = series[key];
  const unit = o.hours ? VOICE : COUNT;
  const scaleBy = o.hours ? 1 / 3600 : 1;
  const points = source.points.map((point) => ({ ...point, value: point.value * scaleBy }));
  const flat = points.every((point) => point.value === 0);
  const def: ChartDef = { title: o.title, sub: o.sub, chip: o.chip, html: null, span: o.span };
  if (!points.length || flat) { def.message = dt('Nothing counted yet for this period.'); return def; }
  const single = points.length === 1;
  const shared = { color: o.color, format: unit.format, tickLabels: unit.ticks, dayText, signed: signedOf(unit.format), text: chartText, fluid: true, animate: true, aria: o.title, svgLabel: o.title };
  def.html = both((size) => (o.shape === 'line'
    ? lineChart({ ...shared, ...size, H: single ? 170 : size.H, points, single, floorZero: o.floorZero ?? true }).html
    : barChart({ ...shared, ...size, items: points.map((point) => ({ day: point.day, value: point.value, partial: point.partial })) }).html));
  if (o.summary && !source.level) {
    const sum = seriesSummary({ ...source, points });
    if (sum.fullDays > 1 && sum.average !== null) {
      const withDay = (point: typeof points[number] | null) => ({ value: point ? unit.format(point.value) : '–', sub: point ? dayLabel(point.day) : '' });
      def.summary = [{ label: dt('Average per day'), value: unit.format(sum.average) }, { label: dt('Highest'), ...withDay(sum.high) }, { label: dt('Lowest'), ...withDay(sum.low) }];
    }
  }
  if (single) def.message = dt('Only today is counted so far. The chart fills in as days pass.');
  else if (points.length < stats.days.length) def.message = dt('Showing the {a} days counted so far.', { a: points.length });
  return def;
}

/** A chart of kinds, hours of the day or weekdays: bars from zero, the busiest one lit. */
function categoryChart(o: { title: string; sub: string; color: string; values: number[]; labels: string[]; titles?: string[]; lit?: boolean; hours?: boolean }): ChartDef {
  const unit = o.hours ? VOICE : COUNT;
  const top = peakIndex(o.values);
  const def: ChartDef = { title: o.title, sub: o.sub, html: null };
  if (o.values.every((value) => value === 0)) { def.message = dt('Nothing counted yet for this period.'); return def; }
  def.html = both((size) => barChart({
    ...size, color: o.color, format: unit.format, tickLabels: unit.ticks, dayText, text: chartText, fluid: true, animate: true, aria: o.title, svgLabel: o.title,
    items: o.values.map((value, i) => ({ label: o.labels[i], title: o.titles?.[i] ?? o.labels[i], value, lit: o.lit !== false && i === top, dim: o.lit !== false && top !== -1 && i !== top })),
  }).html);
  return def;
}
const peakIndex = (values: number[]) => { let b = -1; values.forEach((v, i) => { if (v > 0 && (b === -1 || v > values[b])) b = i; }); return b; };
const hourLabels = Array.from({ length: 24 }, (_, h) => (h % 3 === 0 ? String(h).padStart(2, '0') : ''));
const hourTitles = Array.from({ length: 24 }, (_, h) => hourLabel(h));
const voiceHours = (seconds: number[]) => seconds.map((s) => s / 3600);
const bestDayOf = (values: number[]) => { const b = peakIndex(values); return b === -1 ? null : { day: stats.days[b], value: values[b] }; };
const weekdayShort = WEEKDAYS.map((d) => dt(d));
const weekdayFull = FULL_WEEKDAYS.map((d) => dt(d));
const busiestOn = (values: number[]) => (peakIndex(values) === -1 ? dt('Not enough data yet') : `${dt('Busiest on')} ${dt(FULL_WEEKDAYS[peakIndex(values)])}`);
const busiestAt = (peak: { hour: number } | null) => (peak ? `${dt('Busiest at')} ${hourLabel(peak.hour)} ${BOT_TIME_LABEL}` : dt('Not enough data yet'));
const change = (key: keyof typeof analysis.change, inverse = false) => (analysis.hasPrevious ? { change: analysis.change[key], inverse } : null);

const kindNames = ['Bans', 'Mutes', 'Warns', 'Kicks', 'Jails'];
const kindValues = [stats.sanctions.byGroup.bans, stats.sanctions.byGroup.mutes, stats.sanctions.byGroup.warns, stats.sanctions.byGroup.kicks, stats.sanctions.byGroup.jails];
const kindPeak = peakIndex(kindValues);
const sourceNames: Record<string, string> = { moderator: 'Moderators', automod: 'Automod', honeypot: 'Honeypot', escalation: 'Warn escalation', expiry: 'Automatic expiry', antinuke: 'Anti-nuke' };
const sourceRows = Object.entries(stats.sanctions.bySource).filter(([, count]) => count > 0) as [string, number][];

const messagesChart = () => seriesChart('messages', { title: dt('Messages per day'), sub: `${n(stats.totals.messages)} ${dt('in total')}`, color: colorOf('messages'), shape: 'line', chip: change('messages'), summary: true });
const hoursChart = (voice: boolean) => categoryChart({
  title: dt('Most active hours'), sub: busiestAt(voice ? stats.peakHour.voice : stats.peakHour.messages), color: colorOf(voice ? 'voice' : 'messages'),
  values: voice ? voiceHours(stats.hours.voice) : stats.hours.messages, labels: hourLabels, titles: hourTitles, hours: voice,
});
const weekdayChart = (values: number[], color: string) => categoryChart({ title: dt('Best days of the week'), sub: busiestOn(values), color, values, labels: weekdayShort, titles: weekdayFull });
const membersChart = () => seriesChart('members', { title: dt('Members'), sub: dt('Counted back from the members today'), color: colorOf('growth'), shape: 'line' });

const panels: Record<string, { charts: ChartDef[]; columns?: SeriesKey[] }> = {
  overview: { charts: [messagesChart(), hoursChart(false)], columns: ['messages', 'voice', 'joins', 'leaves'] },
  messages: { charts: [
    messagesChart(), hoursChart(false),
    seriesChart('reactions', { title: dt('Reactions per day'), sub: `${n(stats.totals.reactions)} ${dt('in total')}`, color: colorOf('reactions'), shape: 'line', chip: change('reactions'), summary: true, span: true }),
  ], columns: ['messages', 'reactions'] },
  voice: { charts: [
    seriesChart('voice', { title: dt('Voice hours per day'), sub: `${hoursText(stats.totals.voiceSeconds)} ${dt('in total')}`, color: colorOf('voice'), shape: 'line', hours: true, chip: change('voiceSeconds'), summary: true }),
    hoursChart(true),
  ], columns: ['voice'] },
  joins: { charts: [
    seriesChart('joins', { title: dt('Members who joined per day'), sub: `${n(stats.totals.joins)} ${dt('in total')}`, color: colorOf('joins'), shape: 'bars', chip: change('joins'), summary: true }),
    weekdayChart(stats.weekdays.joins, colorOf('joins')),
  ], columns: ['joins'] },
  leaves: { charts: [
    seriesChart('leaves', { title: dt('Members who left per day'), sub: `${n(stats.totals.leaves)} ${dt('in total')}`, color: colorOf('leaves'), shape: 'bars', chip: change('leaves', true), summary: true }),
    weekdayChart(stats.weekdays.leaves, colorOf('leaves')),
  ], columns: ['leaves'] },
  sanctions: { charts: [
    seriesChart('sanctions', { title: dt('Sanctions per day'), sub: `${n(stats.sanctions.total)} ${dt('in total')}`, color: colorOf('sanctions'), shape: 'bars', summary: true }),
    categoryChart({ title: dt('Sanctions by kind'), sub: kindPeak === -1 ? dt('Not enough data yet') : `${dt('Most')}: ${dt(kindNames[kindPeak])}`, color: colorOf('sanctions'), values: kindValues, labels: kindNames.map((k) => dt(k)) }),
  ], columns: ['sanctions'] },
  heatmap: { charts: [] },
  compare: { charts: [] },
  data: { charts: [] },
  growth: { charts: [
    ...(series.members.points.length ? [membersChart()] : []),
    categoryChart({ title: dt('How long members stayed before leaving'), sub: analysis.lifespanTotal ? dt('{a}% left within a week', { a: Math.round((analysis.earlyLeaveShare ?? 0) * 100) }) : dt('Nobody left in this period, or it was not counted yet.'), color: colorOf('growth'), values: analysis.lifespan, labels: ['Under a day', 'Under a week', 'Under a month', '1 to 3 months', 'Over 3 months'].map((label) => dt(label)) }),
    seriesChart('net', { title: dt('Net members gained per day'), sub: `${growth >= 0 ? '+' : ''}${n(growth)} ${dt('in total')}`, color: colorOf('growth'), shape: 'bars', span: Boolean(series.members.points.length) }),
  ], columns: ['joins', 'leaves', 'net', 'members'] },
  invites: { charts: [
    seriesChart('invited', { title: dt('Joins through invites per day'), sub: `${n(stats.totals.invited)} ${dt('in total')}`, color: colorOf('invites'), shape: 'bars', chip: change('invited'), summary: true }),
    weekdayChart(stats.weekdays.invited, colorOf('invites')),
  ], columns: ['invited', 'joins'] },
};

// ── The day by day table of the tabs that have a series: each value with its change from the day before in parentheses; today so far on top. ──
const COLUMN_LABEL: Record<SeriesKey, string> = { messages: 'Messages', reactions: 'Reactions', voice: 'Voice', joins: 'Joined', leaves: 'Left', invited: 'Through invites', sanctions: 'Sanctions', net: 'Net', members: 'Members' };
const COLUMN_COLOR: Record<SeriesKey, string> = { messages: 'messages', reactions: 'reactions', voice: 'voice', joins: 'joins', leaves: 'leaves', invited: 'invites', sanctions: 'sanctions', net: 'growth', members: 'growth' };
// Which way a rise reads: more of these is good (up), bad (inverse) or just a count (neutral).
const COLUMN_TONE: Record<SeriesKey, 'up' | 'inverse' | 'neutral'> = { messages: 'up', reactions: 'up', voice: 'up', joins: 'up', leaves: 'inverse', invited: 'up', sanctions: 'neutral', net: 'up', members: 'up' };
const cellText = (key: SeriesKey, value: number) => (key === 'voice' ? `${fmtHours(value / 3600)}h` : n(value));
const changeText = (key: SeriesKey, value: number) => `${value > 0 ? '+' : value < 0 ? '−' : ''}${cellText(key, Math.abs(value))}`;
const toneOf = (key: SeriesKey, value: number) => (value === 0 || COLUMN_TONE[key] === 'neutral' ? 'flat' : (value > 0) === (COLUMN_TONE[key] === 'up') ? 'good' : 'bad');
const TABLE_ROWS = 14;
const tables = Object.fromEntries(Object.entries(panels).map(([id, panel]) => {
  const columns = (panel.columns ?? []).filter((key) => series[key].points.length > 0);
  const rows = columns.length ? dayRows(series, columns) : [];
  return [id, { columns, rows }];
}));

const tiles: { label: string; value: string; count: number | null; color: string; change?: { value: number | null; inverse: boolean } }[] = [
  { label: 'Messages', value: n(stats.totals.messages), count: stats.totals.messages, color: 'messages', change: { value: analysis.change.messages, inverse: false } },
  { label: 'Active members', value: n(stats.totals.activeMembers), count: stats.totals.activeMembers, color: 'messages' },
  { label: 'Voice', value: hoursText(stats.totals.voiceSeconds), count: null, color: 'voice', change: { value: analysis.change.voiceSeconds, inverse: false } },
  { label: 'Joined', value: n(stats.totals.joins), count: stats.totals.joins, color: 'joins', change: { value: analysis.change.joins, inverse: false } },
  { label: 'Left', value: n(stats.totals.leaves), count: stats.totals.leaves, color: 'leaves', change: { value: analysis.change.leaves, inverse: true } },
  { label: 'Through invites', value: n(stats.totals.invited), count: stats.totals.invited, color: 'invites', change: { value: analysis.change.invited, inverse: false } },
];
const chipOf = (value: number | null, inverse: boolean) => changeChip(value, inverse, numLocale, dt('new'));
// A channel that is not in the server any more (deleted, or a temporary voice channel) has no name to show.
const channelName = (id: string) => (channelNames[id] ? `#${channelNames[id]}` : dt('Deleted or temporary channel'));
const memberName = (id: string) => memberNames[id] ?? id;
const bestJoin = bestDayOf(stats.daily.joins);
const bestLeave = bestDayOf(stats.daily.leaves);
const bestInvite = bestDayOf(stats.daily.invited);
const bestMessage = bestDayOf(stats.daily.messages);
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="stats" pageTitle="Statistics">
  <span hidden data-dash-live="30"></span>
  <div class="st-root" id="st-root">
  <div class="st-head">
    <div class="st-title">
      <h1>{dt('Statistics')}</h1>
      <span class="st-tz" title={dt('All times are {a}.', { a: 'GMT-5 (Colombia)' })}><Icon name="ph:clock-fill" width="12" height="12" />{BOT_TIME_LABEL}</span>
    </div>
    <nav class="st-range" aria-label={dt('Period')}>
      {FREE_STAT_DAYS.map((value) => (
        <a href={`/dash/guild/${guildId}/stats?days=${value}&tab=${tab}`} class:list={['st-range-link', { current: value === days }]} data-keep-tab aria-label={`${value} ${dt('days')}`} aria-current={value === days ? 'true' : undefined}>{value}d</a>
      ))}
      {PREMIUM_STAT_DAYS.map((value) => premium ? (
        <a href={`/dash/guild/${guildId}/stats?days=${value}&tab=${tab}`} class:list={['st-range-link', { current: value === days }]} data-keep-tab aria-label={`${value} ${dt('days')}`} aria-current={value === days ? 'true' : undefined}>{value}d</a>
      ) : (
        <a href={`/dash/premium?guild_id=${guildId}`} class="st-range-link st-range-locked" title={dt('Longer history is a Premium touch')} aria-label={`${value} ${dt('days')}`}><Icon name="ph:crown-fill" width="11" height="11" />{value}d</a>
      ))}
    </nav>
  </div>

  <div class="st-tabs" role="tablist" aria-label={dt('Statistics')}>
    {STAT_TABS.map((id) => (
      <button type="button" role="tab" class:list={['st-tab', { current: id === tab }]} data-tab={id} aria-selected={id === tab ? 'true' : 'false'} style={`--tab:${tabs[id].color}`}>
        <Icon name={tabs[id].icon} width="15" height="15" />{dt(tabs[id].label)}
      </button>
    ))}
  </div>

  <div class="st-tiles">
    {tiles.map((tile, i) => {
      const chip = analysis.hasPrevious && tile.change ? chipOf(tile.change.value, tile.change.inverse) : null;
      return (
        <div class="st-tile" style={`--m:var(--m-${tile.color});--i:${i}`}>
          <span class="st-tile-label"><i class="st-swatch"></i>{dt(tile.label)}</span>
          <b data-count={tile.count ?? undefined}>{tile.value}</b>
          <span class="st-chips">{chip && <Fragment><span class={`st-chip st-chip-${chip.tone}`}><b>{chip.arrow ? `${chip.arrow} ` : ''}{chip.text}</b></span><small>{dt('vs before')}</small></Fragment>}</span>
        </div>
      );
    })}
  </div>

  {STAT_TABS.map((id) => (
    <section class:list={['st-panel', { 'st-panel-hidden': id !== tab }]} data-panel={id} role="tabpanel" style={`--tab:${tabs[id].color}`}>
      {panels[id].charts.length > 0 && (
        <div class="st-charts">
          {panels[id].charts.map((c, ci) => {
            const chip = c.chip ? chipOf(c.chip.change, c.chip.inverse) : null;
            return (
              <article class:list={['st-card', 'st-chart', { 'st-span': c.span }]} style={`--i:${ci}`}>
                <div class="st-card-head">
                  <div>
                    <h2>{c.title}</h2>
                    <p class:list={['st-card-sub', { 'st-lit': c.sub.includes(BOT_TIME_LABEL) || c.sub.includes(dt('Busiest on')) }]}>{c.sub}</p>
                  </div>
                  {chip && <span class={`st-chip st-chip-${chip.tone}`}><b>{chip.arrow ? `${chip.arrow} ` : ''}{chip.text}</b><em>{dt('vs previous period')}</em></span>}
                </div>
                {c.summary && <dl class="st-summary">{c.summary.map((cell) => <div><dt>{cell.label}</dt><dd>{cell.value}{cell.sub && <small>{cell.sub}</small>}</dd></div>)}</dl>}
                {c.html && <Fragment><div class="st-var st-var-s" set:html={c.html.s}></div><div class="st-var st-var-m" set:html={c.html.m}></div><div class="st-var st-var-l" set:html={c.html.l}></div></Fragment>}
                {c.message && <p class:list={['st-empty', { 'st-empty-box': !c.html }]}>{c.message}</p>}
              </article>
            );
          })}
        </div>
      )}

      {tables[id].rows.length > 0 && (
        <article class="st-card st-daily" data-st-daily>
          <h2>{dt('Day by day')}</h2>
          <div class:list={['st-table-scroll', { 'st-fit': tables[id].columns.length < 2 }]} tabindex="0" role="region" aria-label={dt('Day by day')}>
            <table class="st-table">
              <thead>
                <tr>
                  <th scope="col">{dt('Day')}</th>
                  {tables[id].columns.map((key) => <th scope="col" style={`--m:var(--m-${COLUMN_COLOR[key]})`}><i class="st-swatch"></i>{dt(COLUMN_LABEL[key])}</th>)}
                </tr>
              </thead>
              <tbody>
                {tables[id].rows.map((row, i) => (
                  <tr class:list={{ 'st-today': row.today, 'st-extra': i >= TABLE_ROWS }}>
                    {row.today
                      ? <th scope="row">{dt('Today')}<small>{dt('so far')}</small></th>
                      : <th scope="row">{dayText(row.day, { weekday: 'short', month: 'short', day: 'numeric' })}</th>}
                    {tables[id].columns.map((key) => {
                      const cell = row.cells[key];
                      return cell
                        ? <td><span class="st-v">{cellText(key, cell.value)}</span>{cell.change !== null && <span class={`st-d st-d-${toneOf(key, cell.change)}`}> ({changeText(key, cell.change)})</span>}</td>
                        : <td class="st-none">–</td>;
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {tables[id].rows.length > TABLE_ROWS && <button type="button" class="st-more" data-st-more data-more={dt('Show all {a} days', { a: tables[id].rows.length })} data-less={dt('Show fewer days')}>{dt('Show all {a} days', { a: tables[id].rows.length })}</button>}
        </article>
      )}

      {(id === 'heatmap' || id === 'compare' || id === 'data') && <DashStatsAnalysis id={id} analysis={analysis} rules={rules} flash={dataMessage} />}

      <div class="st-lists">
        {(id === 'overview' || id === 'messages') && (
          <Fragment>
            <article class="st-card st-list">
              <h2>{dt('Top channels')}</h2>
              {stats.topChannels.messages.length ? <ol>{stats.topChannels.messages.map((row, i) => <li><span>{i + 1}</span><b>{channelName(row.id)}</b><em>{n(row.messages)}</em></li>)}</ol> : <p class="st-empty">{dt('Nothing counted yet for this period.')}</p>}
            </article>
            <article class="st-card st-list">
              <h2>{dt('Top members')}</h2>
              {stats.topMembers.messages.length ? <ol>{stats.topMembers.messages.map((row, i) => <li><span>{i + 1}</span><b>{memberName(row.id)}</b><em>{n(row.messages)}</em></li>)}</ol> : <p class="st-empty">{dt('Nothing counted yet for this period.')}</p>}
            </article>
          </Fragment>
        )}
        {id === 'voice' && (
          <Fragment>
            <article class="st-card st-list">
              <h2>{dt('Top voice channels')}</h2>
              {stats.topChannels.voice.length ? <ol>{stats.topChannels.voice.map((row, i) => <li><span>{i + 1}</span><b>{channelName(row.id)}</b><em>{hoursText(row.voiceSeconds)}</em></li>)}</ol> : <p class="st-empty">{dt('Nothing counted yet for this period.')}</p>}
            </article>
            <article class="st-card st-list">
              <h2>{dt('Top in voice')}</h2>
              {stats.topMembers.voice.length ? <ol>{stats.topMembers.voice.map((row, i) => <li><span>{i + 1}</span><b>{memberName(row.id)}</b><em>{hoursText(row.voiceSeconds)}</em></li>)}</ol> : <p class="st-empty">{dt('Nothing counted yet for this period.')}</p>}
            </article>
          </Fragment>
        )}
        {(id === 'joins' || id === 'leaves' || id === 'invites' || id === 'growth') && (
          <article class="st-card st-list">
            <h2>{dt('Growth')}</h2>
            <ol>
              <li><span><Icon name="ph:users-three-fill" width="14" height="14" /></span><b>{dt('Net members')}</b><em>{growth >= 0 ? '+' : ''}{n(growth)}</em></li>
              <li><span><Icon name="ph:user-plus-fill" width="14" height="14" /></span><b>{dt('Joined')}</b><em>{n(stats.totals.joins)}</em></li>
              <li><span><Icon name="ph:user-minus-fill" width="14" height="14" /></span><b>{dt('Left')}</b><em>{n(stats.totals.leaves)}</em></li>
              <li><span><Icon name="ph:link-fill" width="14" height="14" /></span><b>{dt('Through invites')}</b><em>{n(stats.totals.invited)}{stats.totals.joins ? ` (${Math.round((stats.totals.invited / stats.totals.joins) * 100)}%)` : ''}</em></li>
              {id === 'joins' && bestJoin && <li><span><Icon name="ph:calendar-check-fill" width="14" height="14" /></span><b>{dt('Best day')}</b><em>{dayLabel(bestJoin.day)} · {n(bestJoin.value)}</em></li>}
              {id === 'leaves' && bestLeave && <li><span><Icon name="ph:calendar-check-fill" width="14" height="14" /></span><b>{dt('Best day')}</b><em>{dayLabel(bestLeave.day)} · {n(bestLeave.value)}</em></li>}
              {id === 'invites' && bestInvite && <li><span><Icon name="ph:calendar-check-fill" width="14" height="14" /></span><b>{dt('Best day')}</b><em>{dayLabel(bestInvite.day)} · {n(bestInvite.value)}</em></li>}
            </ol>
            {!hasFlow && <p class="st-empty">{dt('Joins and leaves are counted from the moment this was added.')}</p>}
          </article>
        )}
        {id === 'invites' && (
          <Fragment>
            <article class="st-card st-list st-inv-top">
              <h2>{dt('Top inviters')}</h2>
              <div class="st-inv-periods" role="group" aria-label={dt('Period')}>
                {periodLinks.map((link) => <a href={`/dash/guild/${guildId}/stats?days=${days}&tab=invites&ip=${link.value}`} class:list={['st-range-link', { current: link.value === invitePeriod }]} data-keep-tab aria-current={link.value === invitePeriod ? 'true' : undefined}>{link.label}</a>)}
              </div>
              {inviters.length ? <ol>{inviters.map((row, i) => <li><span>{i + 1}</span><b><a href={`/dash/guild/${guildId}/stats?days=${days}&tab=invites&ip=${invitePeriod}&member=${row.id}`} data-keep-tab title={dt('Look up a member')}>{memberName(row.id)}</a><small>{inviterLine(row)}</small></b><em>{n(row.net)}</em></li>)}</ol> : <p class="st-empty">{dt('No tracked invites yet.')}</p>}
              {invitePeriod !== 'all' && <p class="st-inv-note">{dt('A week or a month counts the members brought in during it. Fake joins and bonus invites are left out.')}</p>}
            </article>
            <article class="st-card st-inv-member">
              <h2>{dt('Look up a member')}</h2>
              <form method="GET" class="st-inv-form st-inv-find" data-no-dirty role="search">
                <input type="hidden" name="days" value={days} /><input type="hidden" name="tab" value="invites" /><input type="hidden" name="ip" value={invitePeriod} />
                <div class="st-inv-field st-inv-grow"><span>{dt('Member')}</span><DashMemberPick guildId={guildId} name="member" /></div>
                <button type="submit" class="btn btn-accent btn-sm">{dt('Look up')}</button>
              </form>
              {inviteMember ? (
                <div class="st-inv-found">
                  <p class="st-inv-who"><b>{memberName(inviteMember.id)}</b><a href={`/dash/guild/${guildId}/stats?days=${days}&tab=invites&ip=${invitePeriod}`} data-keep-tab>{dt('Clear')}</a></p>
                  <dl class="st-inv-numbers">
                    <div><dt>{dt('Joined')}</dt><dd>{n(inviteMember.joins)}</dd></div>
                    <div><dt>{dt('Left')}</dt><dd>{n(inviteMember.leaves)}</dd></div>
                    <div><dt>{dt('Fake')}</dt><dd>{n(inviteMember.fake)}</dd></div>
                    <div><dt>{dt('Bonus')}</dt><dd>{n(inviteMember.bonus)}</dd></div>
                    <div class="st-inv-total"><dt>{dt('Total')}</dt><dd>{n(inviteMember.total)}</dd></div>
                  </dl>
                  <h3>{dt('Invited by')}</h3>
                  {inviteMember.invitedBy ? (
                    <p class="st-inv-note st-inv-by">
                      <b>{inviteMember.invitedBy.id ? memberName(inviteMember.invitedBy.id) : dt('Unknown')}</b>
                      {' '}{dt('through {a}', { a: sourceText(inviteMember.invitedBy.source) })}{inviteMember.invitedBy.code ? <> · <code>{inviteMember.invitedBy.code}</code></> : null}
                      {inviteMember.invitedBy.joinedAt ? <> · {whenText(inviteMember.invitedBy.joinedAt)}</> : null}
                      {inviteMember.invitedBy.fake ? <> · {dt('counted as a fake join')}</> : null}
                    </p>
                  ) : <p class="st-inv-note">{dt('Petto has no record of who invited this member.')}</p>}
                  <h3>{dt('Codes used to bring people in')}</h3>
                  {inviteMember.codes.length ? <ul class="st-inv-codes">{inviteMember.codes.map((row) => <li><code>{row.code}</code><em>{dt('{a} joined, {b} left, {c} fake', { a: n(row.joins), b: n(row.left), c: n(row.fake) })}</em></li>)}</ul> : <p class="st-inv-note">{dt('This member has not brought anybody in with a link.')}</p>}
                </div>
              ) : <p class="st-inv-note">{dt('Search a member to see their invites, who invited them and the codes they used.')}</p>}
            </article>
          </Fragment>
        )}
        {id === 'sanctions' && (
          <Fragment>
            <article class="st-card st-list">
              <h2>{dt('Sanctions')}</h2>
              <ol>
                <li><span><Icon name="ph:gavel-fill" width="14" height="14" /></span><b>{dt('Total')}</b><em>{n(stats.sanctions.total)}</em></li>
                {kindNames.map((name, i) => <li><span>{i + 1}</span><b>{dt(name)}</b><em>{n(kindValues[i])}</em></li>)}
                <li><span><Icon name="ph:arrow-counter-clockwise-fill" width="14" height="14" /></span><b>{dt('Undone')}</b><em>{n(stats.sanctions.byGroup.undone)}</em></li>
              </ol>
            </article>
            <article class="st-card st-list">
              <h2>{dt('Applied by')}</h2>
              {sourceRows.length ? <ol>{sourceRows.map(([key, count]) => <li><span><Icon name="ph:robot-fill" width="14" height="14" /></span><b>{dt(sourceNames[key] ?? key)}</b><em>{n(count)}</em></li>)}</ol> : <p class="st-empty">{dt('Nothing counted yet for this period.')}</p>}
            </article>
            <article class="st-card st-list">
              <h2>{dt('Most active moderators')}</h2>
              {stats.sanctions.topModerators.length ? <ol>{stats.sanctions.topModerators.map((row, i) => <li><span>{i + 1}</span><b>{memberName(row.id)}</b><em>{n(row.count)}</em></li>)}</ol> : <p class="st-empty">{dt('Nothing counted yet for this period.')}</p>}
            </article>
            <article class="st-card st-list">
              <h2>{dt('Most sanctioned')}</h2>
              {stats.sanctions.topUsers.length ? <ol>{stats.sanctions.topUsers.map((row, i) => <li><span>{i + 1}</span><b>{memberName(row.id)}</b><em>{n(row.count)}</em></li>)}</ol> : <p class="st-empty">{dt('Nothing counted yet for this period.')}</p>}
            </article>
          </Fragment>
        )}
        {id === 'overview' && stats.peakHour.messages && (
          <article class="st-card st-list">
            <h2>{dt('Highlights')}</h2>
            <ol>
              <li><span><Icon name="ph:clock-fill" width="14" height="14" /></span><b>{dt('Most active hour')}</b><em>{hourLabel(stats.peakHour.messages.hour)} {BOT_TIME_LABEL}</em></li>
              {bestMessage && <li><span><Icon name="ph:calendar-check-fill" width="14" height="14" /></span><b>{dt('Best day')}</b><em>{dayLabel(bestMessage.day)} · {n(bestMessage.value)}</em></li>}
              <li><span><Icon name="ph:users-three-fill" width="14" height="14" /></span><b>{dt('Net members')}</b><em>{growth >= 0 ? '+' : ''}{n(growth)}</em></li>
            </ol>
          </article>
        )}
      </div>

      {id === 'invites' && (
        <div class="st-inv" data-invite-settings>
          <div class="st-inv-head">
            <h2>{dt('Invite settings')}</h2>
            <p>{dt('Petto counts who brought each member in. Choose what an invite is worth: roles for reaching a number, which joins do not count, and corrections for one member. The same as /invites in Discord.')}</p>
          </div>
          {inviteMessage && <div class:list={['st-flash', { 'st-flash-err': inviteMessage.kind === 'err' }]} role={inviteMessage.kind === 'err' ? 'alert' : 'status'}>{inviteMessage.text}</div>}
          <div class="st-inv-grid">
            <article class="st-card st-inv-card">
              <h3><Icon name="ph:medal-fill" width="15" height="15" />{dt('Roles for invites')} <span class="st-inv-count">{inviteSettings.rewards.length}</span></h3>
              {inviteSettings.rewards.length ? (
                <ul class="st-inv-list">
                  {inviteSettings.rewards.map((reward) => (
                    <li>
                      <span class="st-inv-role" style={`--rc:${roleColor(reward.color)}`}><i></i>{reward.name ? `@${reward.name}` : dt('Deleted role')}</span>
                      <em>{dt('{a} invites', { a: n(reward.invites) })}</em>
                      <form method="POST" data-no-dirty>
                        <input type="hidden" name="role_id" value={reward.roleId} />
                        <button type="submit" name="action" value="invite_unreward" class="st-inv-del" aria-label={dt('Remove')} title={dt('Remove')} data-confirm={dt('Stop giving this role for invites? Members who have it keep it.')}><Icon name="ph:trash-fill" width="13" height="13" /></button>
                      </form>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="st-inv-empty">{dt('No roles for invites yet. Pick a role and how many invites earn it: Petto gives it when someone reaches the number and takes it back if they fall below.')}</p>
              )}
              <form method="POST" class="st-inv-form" data-no-dirty>
                <label class="st-inv-field st-inv-grow"><span>{dt('Role')}</span>
                  <select name="role_id" required>
                    <option value="">{dt('Choose a role')}</option>
                    {inviteRoles.map((role) => <option value={role.id}>{role.name}{rewardIds.has(role.id) ? ` · ${dt('change its number')}` : ''}</option>)}
                  </select>
                </label>
                <label class="st-inv-field st-inv-num"><span>{dt('Invites')}</span><input type="number" name="invites" min="1" max="100000" value="5" required /></label>
                <button type="submit" name="action" value="invite_reward" class="btn btn-accent btn-sm">{dt('Add role')}</button>
              </form>
              <p class="st-inv-note">{dt('The role must be below the highest role of Petto. Members who already have enough invites get it right away.')}</p>
            </article>

            <article class="st-card st-inv-card st-inv-settings">
              <h3><Icon name="ph:gear-six-fill" width="15" height="15" />{dt('Settings')}</h3>
              <p class="st-inv-note">{dt('A join from a very new account, or from someone who had already been in the server, does not count as an invite.')}</p>
              <form method="POST" class="st-inv-stack" data-no-dirty>
                {extended && <input type="hidden" name="extended" value="1" />}
                <label class="st-inv-field"><span>{dt('Accounts younger than (days)')}</span><input type="number" name="days" min="0" max="365" step="1" inputmode="numeric" value={inviteSettings.fakeDays} required /></label>
                <p class="st-inv-note">{inviteSettings.fakeDays ? dt('Now: accounts younger than {a} days are fake joins.', { a: inviteSettings.fakeDays }) : dt('Now: only members who come back are fake joins.')} {dt('With 0, a new account counts like any other.')}</p>
                {extended && (
                  <Fragment>
                    <label class="st-inv-field"><span>{dt('Leaves quickly (minutes)')}</span><input type="number" name="quick_leave_minutes" min="0" max="1440" step="1" inputmode="numeric" value={inviteSettings.quickLeaveMinutes ?? 0} required /></label>
                    <p class="st-inv-note">{dt('A member who leaves within this many minutes of joining counts as a fake join, so the invite is not credited. 0 turns it off.')}</p>
                    <label class="st-inv-check"><input type="checkbox" name="ignore_bots" checked={Boolean(inviteSettings.ignoreBots)} /><span>{dt('Ignore bot accounts')}</span></label>
                    <p class="st-inv-note">{dt('Bot accounts are written down but never credited to anybody.')}</p>
                    <label class="st-inv-check"><input type="checkbox" name="subtract_leaves" checked={inviteSettings.subtractLeaves !== false} /><span>{dt('Take away members who left')}</span></label>
                    <p class="st-inv-note">{dt('The total is the members who joined, minus those who left, plus the bonus. Turn it off to keep them in the total.')}</p>
                  </Fragment>
                )}
                <div class="st-inv-actions"><button type="submit" name="action" value="invite_settings" class="btn btn-accent btn-sm">{dt('Save settings')}</button></div>
              </form>
            </article>

            <article class="st-card st-inv-card">
              <h3><Icon name="ph:sliders-horizontal-fill" width="15" height="15" />{dt('Adjust the invites of a member')}</h3>
              <p class="st-inv-note">{dt('Bonus invites add to (or, negative, take from) what Petto counted, for events or invites it could not see. Reward roles follow the new number.')}</p>
              <form method="POST" class="st-inv-form st-inv-adjust" data-no-dirty>
                <div class="st-inv-field st-inv-grow"><span>{dt('Member')}</span><DashMemberPick guildId={guildId} name="member_id" /></div>
                <label class="st-inv-field st-inv-num"><span>{dt('Bonus')}</span><input type="number" name="amount" min="-100000" max="100000" step="1" value="1" /></label>
                <div class="st-inv-actions">
                  <button type="submit" name="action" value="invite_bonus" class="btn btn-accent btn-sm">{dt('Add bonus')}</button>
                  <button type="submit" name="action" value="invite_reset" class="btn btn-ghost btn-sm" data-confirm={dt('Put every invite of this member back to zero? Who they invited stays on record.')}>{dt('Reset to zero')}</button>
                </div>
              </form>
              <p class="st-inv-note">{dt('Resetting needs Administrator, like the command.')}</p>
            </article>
          </div>
        </div>
      )}
    </section>
  ))}
  <DashChartTip />
  <StatsChartStyle />
  <script is:inline>
    // Switching section: the new one slides in and the address keeps the section. This is an inline script inside the page
    // content, so it also runs when the dashboard opens this page without reloading it. The links of the period load like any
    // dashboard page: the shared placeholders (utils/dashSkeleton.mjs) show while the new numbers come in.
    (function () {
      var root = document.getElementById('st-root');
      if (!root || root.dataset.ready) return;
      root.dataset.ready = '1';
      var tabs = Array.prototype.slice.call(root.querySelectorAll('.st-tab'));
      var panels = Array.prototype.slice.call(root.querySelectorAll('.st-panel'));
      function show(id) {
        tabs.forEach(function (tab) {
          var on = tab.dataset.tab === id;
          tab.classList.toggle('current', on);
          tab.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        panels.forEach(function (panel) {
          if (panel.dataset.panel === id) {
            panel.classList.remove('st-panel-hidden');
            panel.classList.remove('st-enter');
            void panel.offsetWidth;
            panel.classList.add('st-enter');
          } else panel.classList.add('st-panel-hidden');
        });
        try {
          var url = new URL(location.href);
          url.searchParams.set('tab', id);
          history.replaceState(history.state, '', url);
          root.querySelectorAll('a[data-keep-tab]').forEach(function (a) {
            var u = new URL(a.href, location.origin);
            u.searchParams.set('tab', id);
            a.href = u.pathname + u.search;
          });
        } catch (e) { /* the address is just a convenience */ }
      }
      // The numbers of the tiles count up to their value.
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      root.querySelectorAll('[data-count]').forEach(function (el) {
        var target = Number(el.dataset.count);
        if (!isFinite(target) || target <= 0 || reduce) return;
        var started = null;
        function step(time) {
          if (started === null) started = time;
          var t = Math.min(1, (time - started) / 700);
          el.textContent = Math.round(target * (1 - Math.pow(1 - t, 3))).toLocaleString(document.documentElement.lang || 'en-US');
          if (t < 1) requestAnimationFrame(step);
        }
        el.textContent = '0';
        requestAnimationFrame(step);
      });
      // The day by day table shows the latest days; the button opens or closes the rest.
      root.querySelectorAll('[data-st-more]').forEach(function (button) {
        button.addEventListener('click', function () {
          var card = button.closest('[data-st-daily]');
          if (!card) return;
          var open = card.classList.toggle('st-open');
          button.textContent = open ? button.dataset.less : button.dataset.more;
        });
      });
      tabs.forEach(function (tab) { tab.addEventListener('click', function () { show(tab.dataset.tab || 'overview'); }); });
    })();
  </script>
  </div>
</DashGuildLayout>
<style>
  h1 { font-size: 22px; margin: 0; }
  .st-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
  .st-title { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 10px; min-width: 0; }
  /* The hours of the charts are in the bot's time zone: said once, next to the title. */
  .st-tz { display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border: 1px solid var(--border); border-radius: 999px; background: var(--card); color: var(--text-dim); font: 600 10.5px var(--mono); letter-spacing: .03em; white-space: nowrap; }
  .st-range { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; border: 1px solid var(--border); border-radius: 999px; background: var(--card); }
  /* On a phone the periods stay on one line and slide sideways, like the tabs below. */
  @media (max-width: 520px) { .st-range { flex-wrap: nowrap; max-width: 100%; overflow-x: auto; scrollbar-width: none; } .st-range::-webkit-scrollbar { display: none; } .st-range-link { flex: none; } .st-range.st-range { gap: 2px; } .st-range-link.st-range-link { padding: 6px 8px; font-size: 12px; } }
  .st-range-link { font-size: 12.5px; padding: 6px 12px; border-radius: 999px; color: var(--text-muted); text-decoration: none; }
  .st-range-link:hover { color: var(--text); }
  .st-range-locked { display: inline-flex; align-items: center; gap: 4px; opacity: .7; }
  .st-range-locked :global(svg) { color: #d9a441; }
  .st-range-link.current { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  /* The tabs wrap onto a second row aligned to the left: none is ever cut at the edge. */
  .st-tabs { display: flex; flex-wrap: wrap; gap: 6px; padding: 5px 3px 6px; margin: -5px -3px 6px; }
  .st-tab { display: inline-flex; align-items: center; gap: 7px; flex: none; font: inherit; font-size: 12.5px; padding: 7px 12px; border-radius: 999px; border: 1px solid var(--border); background: var(--card); color: var(--text-muted); cursor: pointer; transition: background var(--m-base), color var(--m-base), border-color var(--m-base), transform var(--m-fast) var(--m-out); white-space: nowrap; line-height: 1.2; }
  .st-tab:active { transform: scale(var(--m-press)); }
  .st-tab:hover { color: var(--text); }
  .st-tab:focus-visible { outline-offset: 1px; }
  .st-tab.current { color: var(--tab); border-color: var(--tab); background: color-mix(in srgb, var(--tab) 14%, transparent); font-weight: 600; }
