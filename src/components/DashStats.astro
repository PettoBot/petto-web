---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import { getDashLang, makeT } from '../i18n/dash';
import { STAT_TABS, BOT_TIME_LABEL, type StatsData } from '../utils/activityStats';

const dt = makeT(getDashLang(Astro));
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  stats: StatsData;
  days: number;
  tab: string;
  channelNames: Record<string, string>;
  memberNames: Record<string, string>;
  inviters: { id: string; joins: number; leaves: number; net: number }[];
  hasFlow: boolean;
}
const { user, guildId, guildName, guildIcon, stats, days, tab, channelNames, memberNames, inviters, hasFlow } = Astro.props;

const tabs: Record<string, { label: string; icon: string; color: string }> = {
  overview: { label: 'Overview', icon: 'ph:squares-four-fill', color: '#f0a88f' },
  messages: { label: 'Messages', icon: 'ph:chat-circle-text-fill', color: '#f0a88f' },
  voice: { label: 'Voice', icon: 'ph:microphone-fill', color: '#9bd0f5' },
  joins: { label: 'Joins', icon: 'ph:user-plus-fill', color: '#8fdca8' },
  leaves: { label: 'Leaves', icon: 'ph:user-minus-fill', color: '#f08fa0' },
  invites: { label: 'Invites', icon: 'ph:link-fill', color: '#c6a8f5' },
  sanctions: { label: 'Sanctions', icon: 'ph:gavel-fill', color: '#f5c26b' },
};
const WEEKDAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const FULL_WEEKDAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const n = (value: number) => Math.round(value).toLocaleString('en-US');
function hoursText(seconds: number) {
  const minutes = Math.floor(seconds / 60);
  return minutes >= 60 ? Math.floor(minutes / 60) + 'h ' + (minutes % 60) + 'm' : minutes + 'm';
}
const dayLabel = (day: string) => new Date(`${day}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const hourLabel = (hour: number) => `${String(hour).padStart(2, '0')}:00`;
const growth = stats.totals.joins - stats.totals.leaves;

function niceMax(value: number) {
  const raw = Math.max(value, 4) / 4;
  const magnitude = 10 ** Math.floor(Math.log10(raw));
  const step = [1, 2, 5, 10].map((m) => m * magnitude).find((candidate) => candidate >= raw) ?? raw;
  return step * 4;
}

// One chart as SVG: the grid and sparse labels, then bars (the busiest one lit) or, for the day-by-day charts, a line with its area
// and markers that draw themselves like the ones of the overview.
function chart(values: number[], labels: string[], color: string, format: (v: number) => string = n, highlight = -1, kind: 'bars' | 'line' = 'bars') {
  const W = 640, H = 230, left = 44, bottom = 26, top = 8;
  const plotW = W - left - 10, plotH = H - bottom - top;
  const max = niceMax(Math.max(0, ...values));
  const slot = plotW / Math.max(1, values.length);
  const barW = Math.max(3, Math.min(34, slot * 0.7));
  const every = Math.ceil(values.length / 10);
  const grid = [0, 1, 2, 3, 4].map((i) => ({ y: top + plotH - (plotH * i) / 4, label: format((max * i) / 4) }));
  const bars = values.map((value, i) => {
    const h = (value / max) * plotH;
    return { x: left + slot * i + (slot - barW) / 2, y: top + plotH - h, h, w: barW, label: labels[i], value, lit: i === highlight, delay: Math.min(i * 18, 500) };
  });
  const ticks = labels.map((label, i) => ({ label, x: left + slot * i + slot / 2, show: i % every === 0 || i === labels.length - 1 }));
  // The line goes through the middle of each slot; the curve is smoothed with Catmull-Rom and never leaves the range of its neighbours.
  const points = values.map((value, i) => ({ x: left + slot * i + slot / 2, y: top + plotH - (value / max) * plotH, value, label: labels[i] }));
  let line = '';
  if (points.length === 1) line = `M${points[0].x},${points[0].y} L${points[0].x + 0.01},${points[0].y}`;
  else if (points.length > 1) {
    line = `M${points[0].x},${points[0].y}`;
    for (let i = 0; i < points.length - 1; i += 1) {
      const p0 = points[Math.max(0, i - 1)], p1 = points[i], p2 = points[i + 1], p3 = points[Math.min(points.length - 1, i + 2)];
      const lo = Math.min(p1.y, p2.y), hi = Math.max(p1.y, p2.y);
      const c1y = Math.max(lo, Math.min(hi, p1.y + (p2.y - p0.y) / 6));
      const c2y = Math.max(lo, Math.min(hi, p2.y - (p3.y - p1.y) / 6));
      line += ` C${p1.x + (p2.x - p0.x) / 6},${c1y} ${p2.x - (p3.x - p1.x) / 6},${c2y} ${p2.x},${p2.y}`;
    }
  }
  const baseline = top + plotH;
  const area = points.length > 1 ? `${line} L${points[points.length - 1].x},${baseline} L${points[0].x},${baseline} Z` : '';
  return { W, H, left, plotW, bottom, grid, bars, ticks, color, format, highlight, kind, points, line, area, empty: values.every((v) => v === 0) };
}

const dailyLabels = stats.days.map(dayLabel);
const hourLabels = Array.from({ length: 24 }, (_, h) => (h % 3 === 0 ? String(h).padStart(2, '0') : ''));
const peakIndex = (values: number[]) => { let b = -1; values.forEach((v, i) => { if (v > 0 && (b === -1 || v > values[b])) b = i; }); return b; };
const voiceHours = stats.daily.voice.map((s) => s / 3600);
const fmtHours = (v: number) => (v >= 10 ? String(Math.round(v)) : v.toFixed(1));
const bestDayOf = (values: number[]) => { const b = peakIndex(values); return b === -1 ? null : { day: stats.days[b], value: values[b] }; };

const kindNames = ['Bans', 'Mutes', 'Warns', 'Kicks', 'Jails'];
const kindValues = [stats.sanctions.byGroup.bans, stats.sanctions.byGroup.mutes, stats.sanctions.byGroup.warns, stats.sanctions.byGroup.kicks, stats.sanctions.byGroup.jails];
const kindPeak = peakIndex(kindValues);
const sourceNames: Record<string, string> = { moderator: 'Moderators', automod: 'Automod', honeypot: 'Honeypot', escalation: 'Warn escalation', expiry: 'Automatic expiry', antinuke: 'Anti-nuke' };
const sourceRows = Object.entries(stats.sanctions.bySource).filter(([, count]) => count > 0) as [string, number][];

const panels: Record<string, { charts: { title: string; sub: string; chart: ReturnType<typeof chart> }[] }> = {
  overview: { charts: [
    { title: 'Messages per day', sub: `${n(stats.totals.messages)} ${dt('in total')}`, chart: chart(stats.daily.messages, dailyLabels, tabs.messages.color, n, -1) },
    { title: 'Most active hours', sub: stats.peakHour.messages ? `${dt('Busiest at')} ${hourLabel(stats.peakHour.messages.hour)} ${BOT_TIME_LABEL}` : dt('Not enough data yet'), chart: chart(stats.hours.messages, hourLabels, tabs.messages.color, n, peakIndex(stats.hours.messages)) },
  ] },
  messages: { charts: [
    { title: 'Messages per day', sub: `${n(stats.totals.messages)} ${dt('in total')}`, chart: chart(stats.daily.messages, dailyLabels, tabs.messages.color, n, -1) },
    { title: 'Most active hours', sub: stats.peakHour.messages ? `${dt('Busiest at')} ${hourLabel(stats.peakHour.messages.hour)} ${BOT_TIME_LABEL}` : dt('Not enough data yet'), chart: chart(stats.hours.messages, hourLabels, tabs.messages.color, n, peakIndex(stats.hours.messages)) },
  ] },
  voice: { charts: [
    { title: 'Voice hours per day', sub: `${hoursText(stats.totals.voiceSeconds)} ${dt('in total')}`, chart: chart(voiceHours, dailyLabels, tabs.voice.color, fmtHours, -1) },
    { title: 'Most active hours', sub: stats.peakHour.voice ? `${dt('Busiest at')} ${hourLabel(stats.peakHour.voice.hour)} ${BOT_TIME_LABEL}` : dt('Not enough data yet'), chart: chart(stats.hours.voice.map((s) => s / 3600), hourLabels, tabs.voice.color, fmtHours, peakIndex(stats.hours.voice)) },
  ] },
  joins: { charts: [
    { title: 'Members who joined per day', sub: `${n(stats.totals.joins)} ${dt('in total')}`, chart: chart(stats.daily.joins, dailyLabels, tabs.joins.color, n, -1) },
    { title: 'Best days of the week', sub: peakIndex(stats.weekdays.joins) === -1 ? dt('Not enough data yet') : `${dt('Busiest on')} ${dt(FULL_WEEKDAYS[peakIndex(stats.weekdays.joins)])}`, chart: chart(stats.weekdays.joins, WEEKDAYS.map((d) => dt(d)), tabs.joins.color, n, peakIndex(stats.weekdays.joins)) },
  ] },
  leaves: { charts: [
    { title: 'Members who left per day', sub: `${n(stats.totals.leaves)} ${dt('in total')}`, chart: chart(stats.daily.leaves, dailyLabels, tabs.leaves.color, n, -1) },
    { title: 'Best days of the week', sub: peakIndex(stats.weekdays.leaves) === -1 ? dt('Not enough data yet') : `${dt('Busiest on')} ${dt(FULL_WEEKDAYS[peakIndex(stats.weekdays.leaves)])}`, chart: chart(stats.weekdays.leaves, WEEKDAYS.map((d) => dt(d)), tabs.leaves.color, n, peakIndex(stats.weekdays.leaves)) },
  ] },
  sanctions: { charts: [
    { title: 'Sanctions per day', sub: `${n(stats.sanctions.total)} ${dt('in total')}`, chart: chart(stats.sanctions.daily, dailyLabels, tabs.sanctions.color, n, -1) },
    { title: 'Sanctions by kind', sub: kindPeak === -1 ? dt('Not enough data yet') : `${dt('Most')}: ${dt(kindNames[kindPeak])}`, chart: chart(kindValues, kindNames.map((k) => dt(k)), tabs.sanctions.color, n, kindPeak) },
  ] },
  invites: { charts: [
    { title: 'Joins through invites per day', sub: `${n(stats.totals.invited)} ${dt('in total')}`, chart: chart(stats.daily.invited, dailyLabels, tabs.invites.color, n, -1) },
    { title: 'Best days of the week', sub: peakIndex(stats.weekdays.invited) === -1 ? dt('Not enough data yet') : `${dt('Busiest on')} ${dt(FULL_WEEKDAYS[peakIndex(stats.weekdays.invited)])}`, chart: chart(stats.weekdays.invited, WEEKDAYS.map((d) => dt(d)), tabs.invites.color, n, peakIndex(stats.weekdays.invited)) },
  ] },
};

const tiles = [
  { label: 'Messages', value: n(stats.totals.messages), count: stats.totals.messages, color: tabs.messages.color },
  { label: 'Active members', value: n(stats.totals.activeMembers), count: stats.totals.activeMembers, color: '#f0a88f' },
  { label: 'Voice', value: hoursText(stats.totals.voiceSeconds), count: null, color: tabs.voice.color },
  { label: 'Joined', value: n(stats.totals.joins), count: stats.totals.joins, color: tabs.joins.color },
  { label: 'Left', value: n(stats.totals.leaves), count: stats.totals.leaves, color: tabs.leaves.color },
  { label: 'Through invites', value: n(stats.totals.invited), count: stats.totals.invited, color: tabs.invites.color },
];
// A channel that is not in the server any more (deleted, or a temporary voice channel) has no name to show.
const channelName = (id: string) => (channelNames[id] ? `#${channelNames[id]}` : dt('Deleted or temporary channel'));
const memberName = (id: string) => memberNames[id] ?? id;
const bestJoin = bestDayOf(stats.daily.joins);
const bestLeave = bestDayOf(stats.daily.leaves);
const bestInvite = bestDayOf(stats.daily.invited);
const bestMessage = bestDayOf(stats.daily.messages);
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="stats" pageTitle="Statistics">
  <div class="st-root" id="st-root">
  <div class="st-loadbar" aria-hidden="true"></div>
  <div class="st-head">
    <div>
      <h1>{dt('Statistics')}</h1>
      <p class="st-sub">{dt('How active the server is. All times are GMT-5 (Colombia).')}</p>
    </div>
    <nav class="st-range" aria-label={dt('Period')}>
      {[7, 14, 30].map((value) => (
        <a href={`/dash/guild/${guildId}/stats?days=${value}&tab=${tab}`} class:list={['st-range-link', { current: value === days }]} data-keep-tab>{value} {dt('days')}</a>
      ))}
    </nav>
  </div>

  <div class="st-tabs" role="tablist" aria-label={dt('Statistics')}>
    {STAT_TABS.map((id) => (
      <button type="button" role="tab" class:list={['st-tab', { current: id === tab }]} data-tab={id} aria-selected={id === tab ? 'true' : 'false'} style={`--tab:${tabs[id].color}`}>
        <Icon name={tabs[id].icon} width="15" height="15" />{dt(tabs[id].label)}
      </button>
    ))}
  </div>

  <div class="st-tiles">
    {tiles.map((tile, i) => (
      <div class="st-tile" style={`--tile:${tile.color};--i:${i}`}><i></i><span>{dt(tile.label)}</span><b data-count={tile.count ?? undefined}>{tile.value}</b></div>
    ))}
  </div>

  {STAT_TABS.map((id) => (
    <section class:list={['st-panel', { 'st-panel-hidden': id !== tab }]} data-panel={id} role="tabpanel" style={`--tab:${tabs[id].color}`}>
      <div class="st-charts">
        {panels[id].charts.map((c, ci) => (
          <article class="st-card" style={`--i:${ci}`}>
            <h2>{dt(c.title)}</h2>
            <p class:list={['st-card-sub', { 'st-lit': c.sub.includes(BOT_TIME_LABEL) || c.sub.includes(dt('Busiest on')) }]}>{c.sub}</p>
            <svg viewBox={`0 0 ${c.chart.W} ${c.chart.H}`} role="img" aria-label={dt(c.title)} class="st-svg">
              {c.chart.grid.map((g) => (
                <g><line x1={c.chart.left} x2={c.chart.left + c.chart.plotW} y1={g.y} y2={g.y} class="st-grid" /><text x={c.chart.left - 8} y={g.y + 4} text-anchor="end" class="st-axis">{g.label}</text></g>
              ))}
              {c.chart.kind === 'bars' && c.chart.bars.map((b, i) => (
                <rect x={b.x} y={b.y} width={b.w} height={Math.max(0, b.h)} rx="5" class:list={['st-bar', { 'st-bar-lit': b.lit, 'st-bar-dim': c.chart.highlight !== -1 && !b.lit }]} style={`--c:${c.chart.color};--d:${b.delay}ms`}><title>{b.label || `${String(i).padStart(2, '0')}:00`} · {c.chart.format(b.value)}</title></rect>
              ))}
              {c.chart.kind === 'line' && (
                <g style={`--c:${c.chart.color}`}>
                  {c.chart.area && <path d={c.chart.area} class="st-area" />}
                  <path d={c.chart.line} pathLength="1" class="st-line" />
                  {c.chart.points.map((pt, i) => <circle cx={pt.x} cy={pt.y} r="3.2" class="st-dot" style={`animation-delay:${0.45 + i * 0.03}s`}><title>{pt.label} · {c.chart.format(pt.value)}</title></circle>)}
                </g>
              )}
              {c.chart.ticks.filter((t) => t.show && t.label).map((t) => <text x={t.x} y={c.chart.H - 6} text-anchor="middle" class="st-axis">{t.label}</text>)}
            </svg>
            {c.chart.empty && <p class="st-empty">{dt('Nothing counted yet for this period.')}</p>}
          </article>
        ))}
      </div>

      <div class="st-lists">
        {(id === 'overview' || id === 'messages') && (
          <Fragment>
            <article class="st-card st-list">
              <h2>{dt('Top channels')}</h2>
              {stats.topChannels.messages.length ? <ol>{stats.topChannels.messages.map((row, i) => <li><span>{i + 1}</span><b>{channelName(row.id)}</b><em>{n(row.messages)}</em></li>)}</ol> : <p class="st-empty">{dt('Nothing counted yet for this period.')}</p>}
            </article>
            <article class="st-card st-list">
              <h2>{dt('Top members')}</h2>
              {stats.topMembers.messages.length ? <ol>{stats.topMembers.messages.map((row, i) => <li><span>{i + 1}</span><b>{memberName(row.id)}</b><em>{n(row.messages)}</em></li>)}</ol> : <p class="st-empty">{dt('Nothing counted yet for this period.')}</p>}
            </article>
          </Fragment>
        )}
        {id === 'voice' && (
          <Fragment>
            <article class="st-card st-list">
              <h2>{dt('Top voice channels')}</h2>
              {stats.topChannels.voice.length ? <ol>{stats.topChannels.voice.map((row, i) => <li><span>{i + 1}</span><b>{channelName(row.id)}</b><em>{hoursText(row.voiceSeconds)}</em></li>)}</ol> : <p class="st-empty">{dt('Nothing counted yet for this period.')}</p>}
            </article>
            <article class="st-card st-list">
              <h2>{dt('Top in voice')}</h2>
              {stats.topMembers.voice.length ? <ol>{stats.topMembers.voice.map((row, i) => <li><span>{i + 1}</span><b>{memberName(row.id)}</b><em>{hoursText(row.voiceSeconds)}</em></li>)}</ol> : <p class="st-empty">{dt('Nothing counted yet for this period.')}</p>}
            </article>
          </Fragment>
        )}
        {(id === 'joins' || id === 'leaves' || id === 'invites') && (
          <article class="st-card st-list">
            <h2>{dt('Growth')}</h2>
            <ol>
              <li><span><Icon name="ph:users-three-fill" width="14" height="14" /></span><b>{dt('Net members')}</b><em>{growth >= 0 ? '+' : ''}{n(growth)}</em></li>
              <li><span><Icon name="ph:user-plus-fill" width="14" height="14" /></span><b>{dt('Joined')}</b><em>{n(stats.totals.joins)}</em></li>
              <li><span><Icon name="ph:user-minus-fill" width="14" height="14" /></span><b>{dt('Left')}</b><em>{n(stats.totals.leaves)}</em></li>
              <li><span><Icon name="ph:link-fill" width="14" height="14" /></span><b>{dt('Through invites')}</b><em>{n(stats.totals.invited)}{stats.totals.joins ? ` (${Math.round((stats.totals.invited / stats.totals.joins) * 100)}%)` : ''}</em></li>
              {id === 'joins' && bestJoin && <li><span><Icon name="ph:calendar-check-fill" width="14" height="14" /></span><b>{dt('Best day')}</b><em>{dayLabel(bestJoin.day)} · {n(bestJoin.value)}</em></li>}
              {id === 'leaves' && bestLeave && <li><span><Icon name="ph:calendar-check-fill" width="14" height="14" /></span><b>{dt('Best day')}</b><em>{dayLabel(bestLeave.day)} · {n(bestLeave.value)}</em></li>}
              {id === 'invites' && bestInvite && <li><span><Icon name="ph:calendar-check-fill" width="14" height="14" /></span><b>{dt('Best day')}</b><em>{dayLabel(bestInvite.day)} · {n(bestInvite.value)}</em></li>}
            </ol>
            {!hasFlow && <p class="st-empty">{dt('Joins and leaves are counted from the moment this was added.')}</p>}
          </article>
        )}
        {id === 'invites' && (
          <article class="st-card st-list">
            <h2>{dt('Top inviters')}</h2>
            {inviters.length ? <ol>{inviters.map((row, i) => <li><span>{i + 1}</span><b>{memberName(row.id)}</b><em>{n(row.net)}</em></li>)}</ol> : <p class="st-empty">{dt('No tracked invites yet.')}</p>}
          </article>
        )}
        {id === 'sanctions' && (
          <Fragment>
            <article class="st-card st-list">
              <h2>{dt('Sanctions')}</h2>
              <ol>
                <li><span><Icon name="ph:gavel-fill" width="14" height="14" /></span><b>{dt('Total')}</b><em>{n(stats.sanctions.total)}</em></li>
                {kindNames.map((name, i) => <li><span>{i + 1}</span><b>{dt(name)}</b><em>{n(kindValues[i])}</em></li>)}
                <li><span><Icon name="ph:arrow-counter-clockwise-fill" width="14" height="14" /></span><b>{dt('Undone')}</b><em>{n(stats.sanctions.byGroup.undone)}</em></li>
              </ol>
            </article>
            <article class="st-card st-list">
              <h2>{dt('Applied by')}</h2>
              {sourceRows.length ? <ol>{sourceRows.map(([key, count]) => <li><span><Icon name="ph:robot-fill" width="14" height="14" /></span><b>{dt(sourceNames[key] ?? key)}</b><em>{n(count)}</em></li>)}</ol> : <p class="st-empty">{dt('Nothing counted yet for this period.')}</p>}
            </article>
            <article class="st-card st-list">
              <h2>{dt('Most active moderators')}</h2>
              {stats.sanctions.topModerators.length ? <ol>{stats.sanctions.topModerators.map((row, i) => <li><span>{i + 1}</span><b>{memberName(row.id)}</b><em>{n(row.count)}</em></li>)}</ol> : <p class="st-empty">{dt('Nothing counted yet for this period.')}</p>}
            </article>
            <article class="st-card st-list">
              <h2>{dt('Most sanctioned')}</h2>
              {stats.sanctions.topUsers.length ? <ol>{stats.sanctions.topUsers.map((row, i) => <li><span>{i + 1}</span><b>{memberName(row.id)}</b><em>{n(row.count)}</em></li>)}</ol> : <p class="st-empty">{dt('Nothing counted yet for this period.')}</p>}
            </article>
          </Fragment>
        )}
        {id === 'overview' && stats.peakHour.messages && (
          <article class="st-card st-list">
            <h2>{dt('Highlights')}</h2>
            <ol>
              <li><span><Icon name="ph:clock-fill" width="14" height="14" /></span><b>{dt('Most active hour')}</b><em>{hourLabel(stats.peakHour.messages.hour)} {BOT_TIME_LABEL}</em></li>
              {bestMessage && <li><span><Icon name="ph:calendar-check-fill" width="14" height="14" /></span><b>{dt('Best day')}</b><em>{dayLabel(bestMessage.day)} · {n(bestMessage.value)}</em></li>}
              <li><span><Icon name="ph:users-three-fill" width="14" height="14" /></span><b>{dt('Net members')}</b><em>{growth >= 0 ? '+' : ''}{n(growth)}</em></li>
            </ol>
          </article>
        )}
      </div>
    </section>
  ))}
  <script is:inline>
    // Switching section: the new one slides in and the address keeps the section. This is an inline script inside the page
    // content, so it also runs when the dashboard opens this page without reloading it. The links of the period show a loading
    // state while the new numbers come in.
    (function () {
      var root = document.getElementById('st-root');
      if (!root || root.dataset.ready) return;
      root.dataset.ready = '1';
      var tabs = Array.prototype.slice.call(root.querySelectorAll('.st-tab'));
      var panels = Array.prototype.slice.call(root.querySelectorAll('.st-panel'));
      function show(id) {
        tabs.forEach(function (tab) {
          var on = tab.dataset.tab === id;
          tab.classList.toggle('current', on);
          tab.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        panels.forEach(function (panel) {
          if (panel.dataset.panel === id) {
            panel.classList.remove('st-panel-hidden');
            panel.classList.remove('st-enter');
            void panel.offsetWidth;
            panel.classList.add('st-enter');
          } else panel.classList.add('st-panel-hidden');
        });
        try {
          var url = new URL(location.href);
          url.searchParams.set('tab', id);
          history.replaceState(history.state, '', url);
          root.querySelectorAll('a[data-keep-tab]').forEach(function (a) {
            var u = new URL(a.href, location.origin);
            u.searchParams.set('tab', id);
            a.href = u.pathname + u.search;
          });
        } catch (e) { /* the address is just a convenience */ }
      }
      // The numbers of the tiles count up to their value.
