---
import Base from '../layouts/Base.astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = t.toolsPage.embedCode;
---
<Base title={`${p.title} · Petto`} lang={lang}>
  <main>
    <section class="ec-sec">
      <div class="wrap ec-wrap">
        <div class="eyebrow">{p.eyebrow}</div>
        <h1>{p.title}</h1>
        <p class="ec-lede">{p.lede}</p>

        <div class="ec-layout" id="ecRoot" data-i18n={JSON.stringify(p)}>
          <div class="ec-form">
            <div class="ec-modes" role="tablist">
              <button type="button" class="ec-modetab ec-mode active" data-mode="classic" role="tab">{p.modeClassic}</button>
              <button type="button" class="ec-modetab ec-mode" data-mode="v2" role="tab">{p.modeV2}</button>
            </div>

            <div id="ecV2" class="ec-v2" hidden>
              <p class="ec-v2-intro">{p.v2Intro}</p>
              <div class="ec-row">
                <div class="ec-field"><label for="ecAccent">{p.v2AccentLabel}</label><input id="ecAccent" type="color" value="#8399ff" /></div>
              </div>
              <div class="ec-group">
                <h2>{p.v2Title}</h2>
                <div id="ecBlocks"></div>
                <div class="ec-add-row">
                  <button type="button" class="btn btn-ghost btn-sm" data-add="text">+ {p.v2AddText}</button>
                  <button type="button" class="btn btn-ghost btn-sm" data-add="section">+ {p.v2AddSection}</button>
                  <button type="button" class="btn btn-ghost btn-sm" data-add="images">+ {p.v2AddImages}</button>
                  <button type="button" class="btn btn-ghost btn-sm" data-add="sep">+ {p.v2AddSeparator}</button>
                  <button type="button" class="btn btn-ghost btn-sm" data-add="buttons">+ {p.v2AddButtons}</button>
                </div>
              </div>
            </div>

            <div id="ecClassic" class="ec-classic">
            <div class="ec-field"><label for="ecContent">{p.contentLabel}</label><textarea id="ecContent" rows="2" maxlength="2000"></textarea></div>
            <div class="ec-row">
              <div class="ec-field"><label for="ecTitle">{p.titleLabel}</label><input id="ecTitle" type="text" maxlength="256" /></div>
              <div class="ec-field"><label for="ecUrl">{p.titleUrlLabel}</label><input id="ecUrl" type="text" placeholder="https://" /></div>
            </div>
            <div class="ec-field"><label for="ecDescription">{p.descriptionLabel}</label><textarea id="ecDescription" rows="5" maxlength="4096"></textarea></div>
            <div class="ec-row">
              <div class="ec-field"><label for="ecColor">{p.colorLabel}</label><input id="ecColor" type="color" value="#8399ff" /></div>
              <label class="ec-check"><input id="ecTimestamp" type="checkbox" />{p.timestampLabel}</label>
            </div>
            <div class="ec-row">
              <div class="ec-field"><label for="ecThumbnail">{p.thumbnailLabel}</label><input id="ecThumbnail" type="text" placeholder="https://" /></div>
              <div class="ec-field"><label for="ecImage">{p.imageLabel}</label><input id="ecImage" type="text" placeholder="https://" /></div>
            </div>
            <div class="ec-row">
              <div class="ec-field"><label for="ecAuthorName">{p.authorNameLabel}</label><input id="ecAuthorName" type="text" maxlength="256" /></div>
              <div class="ec-field"><label for="ecAuthorIcon">{p.authorIconLabel}</label><input id="ecAuthorIcon" type="text" placeholder="https://" /></div>
            </div>
            <div class="ec-field"><label for="ecAuthorUrl">{p.authorUrlLabel}</label><input id="ecAuthorUrl" type="text" placeholder="https://" /></div>
            <div class="ec-row">
              <div class="ec-field"><label for="ecFooterText">{p.footerTextLabel}</label><input id="ecFooterText" type="text" maxlength="2048" /></div>
              <div class="ec-field"><label for="ecFooterIcon">{p.footerIconLabel}</label><input id="ecFooterIcon" type="text" placeholder="https://" /></div>
            </div>

            <div class="ec-group">
              <h2>{p.fieldsTitle}</h2>
              <div id="ecFields"></div>
              <button type="button" class="btn btn-ghost btn-sm" id="ecAddField">{p.addField}</button>
            </div>
            <div class="ec-group">
              <h2>{p.buttonsTitle}</h2>
              <div id="ecButtons"></div>
              <button type="button" class="btn btn-ghost btn-sm" id="ecAddButton">{p.addButton}</button>
            </div>

            <div class="ec-group">
              <h2>{p.importTitle}</h2>
              <textarea id="ecImport" rows="3" placeholder={p.importPlaceholder}></textarea>
              <div class="ec-actions"><button type="button" class="btn btn-ghost btn-sm" id="ecImportBtn">{p.importButton}</button><span class="ec-note" id="ecImportNote" role="status"></span></div>
            </div>
            </div>
          </div>

          <div class="ec-side">
            <div class="ec-group">
              <h2>{p.previewTitle}</h2>
              <div id="ecPreview" class="ec-preview"></div>
            </div>
            <div class="ec-group">
              <h2>{p.outputTitle}</h2>
              <div class="ec-tabs" id="ecTabs" role="tablist">
                <button type="button" class="ec-tab active" data-format="script" role="tab">{p.formatScript}</button>
                <button type="button" class="ec-tab" data-format="petto" role="tab">{p.formatPetto}</button>
              </div>
              <label class="ec-sep" id="ecSepRow">{p.separatorLabel}
                <select id="ecSeparator"><option value="&v">&amp;v</option><option value="$v">$v</option></select>
              </label>
              <textarea id="ecOutput" rows="7" readonly></textarea>
              <div class="ec-actions">
                <button type="button" class="btn btn-accent btn-sm" id="ecCopy">{p.copyLabel}</button>
                <a class="btn btn-ghost btn-sm" id="ecOpenDash" href="/dash/import" hidden target="_blank" rel="noopener">{p.openDash}</a>
              </div>
              <ul class="ec-warnings" id="ecWarnings" hidden></ul>
            </div>
            <div class="ec-group ec-how">
              <h2>{p.howTitle}</h2>
              <p>{p.howScript}</p>
              <p>{p.howPetto}</p>
              <p>{p.howV2}</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import { renderMessage, renderV2Message, defaultContext } from '../utils/discordPreview';
  import { parseEmbedScript, toEmbedScript } from '../utils/embedScript';
  import { emptyEmbed, validateTemplate, encodeShareCode, decodeShareCode, type TemplateData, type V2Doc, type V2Node } from '../utils/embedSchema';

  const root = document.getElementById('ecRoot')!;
  const text = JSON.parse(root.dataset.i18n || '{}') as Record<string, string>;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const fields: { name: string; value: string; inline: boolean }[] = [];
  const buttons: { label: string; url: string }[] = [];
  let format: 'script' | 'petto' = 'script';
  let notes: string[] = [];

  function read(): TemplateData {
    const colorValue = parseInt($<HTMLInputElement>('ecColor').value.slice(1), 16);
    const embed = {
      ...emptyEmbed(),
      title: $<HTMLInputElement>('ecTitle').value,
      url: $<HTMLInputElement>('ecUrl').value.trim(),
      description: $<HTMLTextAreaElement>('ecDescription').value,
      color: colorUsed ? colorValue : null,
      thumbnail: $<HTMLInputElement>('ecThumbnail').value.trim(),
      image: $<HTMLInputElement>('ecImage').value.trim(),
      timestamp: $<HTMLInputElement>('ecTimestamp').checked,
      author: { name: $<HTMLInputElement>('ecAuthorName').value, icon: $<HTMLInputElement>('ecAuthorIcon').value.trim(), url: $<HTMLInputElement>('ecAuthorUrl').value.trim() },
      footer: { text: $<HTMLInputElement>('ecFooterText').value, icon: $<HTMLInputElement>('ecFooterIcon').value.trim() },
      fields: fields.filter((f) => f.name && f.value).map((f) => ({ ...f })),
    };
    const hasEmbed = Boolean(embed.title || embed.description || embed.author.name || embed.footer.text || embed.fields.length || embed.image || embed.thumbnail || embed.url);
    const row = buttons.filter((b) => b.label && b.url).map((b) => ({ label: b.label, url: b.url, emoji: '', disabled: false }));
    return { content: $<HTMLTextAreaElement>('ecContent').value, embeds: hasEmbed ? [embed] : [], buttons: row.length ? [row.slice(0, 5)] : [] };
  }

  // The color picker always holds a value, so a color is only used once somebody chose one or a code carried it.
  let colorUsed = false;

  // ---- Components V2 -------------------------------------------------------------------------------------------------
  // A message made of blocks inside one container. It leaves as a p2. code, which the bot reads in !embed create and the dashboard in Import.
  type Block =
    | { kind: 'text'; content: string }
    | { kind: 'sep'; divider: boolean; large: boolean }
    | { kind: 'images'; urls: string }
    | { kind: 'section'; content: string; thumb: string }
    | { kind: 'buttons'; lines: string };
  let mode: 'classic' | 'v2' = 'classic';
  const blocks: Block[] = [];
  let accentUsed = false;

  function v2Doc(): V2Doc {
    const children: any[] = [];
    for (const block of blocks) {
      if (block.kind === 'text' && block.content.trim()) children.push({ type: 10, content: block.content });
      else if (block.kind === 'sep') children.push({ type: 14, divider: block.divider, spacing: block.large ? 2 : 1 });
      else if (block.kind === 'images') {
        const items = block.urls.split('\n').map((line) => line.trim()).filter(Boolean).slice(0, 10).map((url) => ({ media: { url } }));
        if (items.length) children.push({ type: 12, items });
      } else if (block.kind === 'section' && block.content.trim()) {
        const thumb = block.thumb.trim();
        children.push(thumb ? { type: 9, components: [{ type: 10, content: block.content }], accessory: { type: 11, media: { url: thumb } } } : { type: 10, content: block.content });
      } else if (block.kind === 'buttons') {
        const row = block.lines.split('\n').map((line) => line.split('|').map((part) => part.trim())).filter((parts) => parts[0] && parts[1]).slice(0, 5).map((parts) => ({ type: 2, style: 5, label: parts[0], url: parts[1] }));
        if (row.length) children.push({ type: 1, components: row });
      }
    }
    const accent = accentUsed ? parseInt($<HTMLInputElement>('ecAccent').value.slice(1), 16) : null;
    return { components: children.length ? [{ type: 17, accent_color: accent, components: children } as unknown as V2Node] : [] };
  }

  function blocksFromDoc(doc: V2Doc) {
    blocks.length = 0;
    const walk = (nodes: any[]) => {
      for (const node of nodes) {
        if (node.type === 17) {
          if (typeof node.accent_color === 'number') { accentUsed = true; $<HTMLInputElement>('ecAccent').value = `#${node.accent_color.toString(16).padStart(6, '0')}`; }
          walk(node.components ?? []);
        } else if (node.type === 10) blocks.push({ kind: 'text', content: node.content ?? '' });
        else if (node.type === 14) blocks.push({ kind: 'sep', divider: node.divider !== false, large: node.spacing === 2 });
        else if (node.type === 12) blocks.push({ kind: 'images', urls: (node.items ?? []).map((item: any) => item.media?.url ?? '').filter(Boolean).join('\n') });
        else if (node.type === 9) {
          const content = (node.components ?? []).map((child: any) => child.content ?? '').join('\n');
          blocks.push(node.accessory?.type === 11 ? { kind: 'section', content, thumb: node.accessory.media?.url ?? '' } : { kind: 'text', content });
        } else if (node.type === 1) blocks.push({ kind: 'buttons', lines: (node.components ?? []).filter((b: any) => b.url).map((b: any) => `${b.label ?? ''} | ${b.url}`).join('\n') });
      }
    };
    walk(doc.components);
  }

  function blockField(label: string, control: HTMLElement): HTMLElement {
    const box = document.createElement('div');
    box.className = 'ec-field';
    const name = document.createElement('label');
    name.textContent = label;
    box.append(name, control);
    return box;
  }
  function areaInput(value: string, rows: number, onInput: (value: string) => void, placeholder = ''): HTMLTextAreaElement {
    const area = document.createElement('textarea');
    area.rows = rows;
    area.value = value;
    area.placeholder = placeholder;
    area.addEventListener('input', () => onInput(area.value));
    return area;
  }
  function checkInput(label: string, value: boolean, onChange: (value: boolean) => void): HTMLElement {
    const wrap = document.createElement('label');
    wrap.className = 'ec-check';
    const box = document.createElement('input');
    box.type = 'checkbox';
    box.checked = value;
    box.addEventListener('change', () => { onChange(box.checked); render(); });
    wrap.append(box, document.createTextNode(label));
    return wrap;
  }

  function drawBlocks() {
    const box = $('ecBlocks');
    box.innerHTML = '';
    const names: Record<Block['kind'], string> = { text: text.v2AddText, sep: text.v2AddSeparator, images: text.v2AddImages, section: text.v2AddSection, buttons: text.v2AddButtons };
    blocks.forEach((block, index) => {
      const card = document.createElement('div');
      card.className = 'ec-block';
      const head = document.createElement('div');
      head.className = 'ec-block-head';
      const title = document.createElement('strong');
      title.textContent = names[block.kind];
      const tools = document.createElement('div');
      tools.className = 'ec-block-tools';
      const tool = (label: string, aria: string, run: () => void, disabled = false) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'ec-remove';
        button.textContent = label;
        button.title = aria;
        button.setAttribute('aria-label', aria);
        button.disabled = disabled;
        button.addEventListener('click', () => { run(); drawBlocks(); render(); });
        tools.appendChild(button);
      };
      tool('↑', text.v2Up, () => { [blocks[index - 1], blocks[index]] = [blocks[index], blocks[index - 1]]; }, index === 0);
      tool('↓', text.v2Down, () => { [blocks[index + 1], blocks[index]] = [blocks[index], blocks[index + 1]]; }, index === blocks.length - 1);
      tool('×', text.removeLabel, () => { blocks.splice(index, 1); });
      head.append(title, tools);
      card.appendChild(head);
      if (block.kind === 'text') card.appendChild(blockField(text.v2Text, areaInput(block.content, 4, (v) => { block.content = v; })));
      else if (block.kind === 'section') {
        card.appendChild(blockField(text.v2Text, areaInput(block.content, 3, (v) => { block.content = v; })));
        const thumb = document.createElement('input');
        thumb.type = 'text';
        thumb.placeholder = 'https://';
        thumb.value = block.thumb;
        thumb.addEventListener('input', () => { block.thumb = thumb.value; });
        card.appendChild(blockField(text.v2Thumb, thumb));
      } else if (block.kind === 'sep') {
        const row = document.createElement('div');
        row.className = 'ec-block-checks';
        row.append(checkInput(text.v2Divider, block.divider, (v) => { block.divider = v; }), checkInput(text.v2Large, block.large, (v) => { block.large = v; }));
        card.appendChild(row);
      } else if (block.kind === 'images') {
        card.appendChild(blockField(text.v2Images, areaInput(block.urls, 3, (v) => { block.urls = v; }, 'https://')));
        const hint = document.createElement('span'); hint.className = 'ec-note'; hint.textContent = text.v2ImagesHint; card.appendChild(hint);
      } else {
        card.appendChild(blockField(text.v2AddButtons, areaInput(block.lines, 3, (v) => { block.lines = v; }, 'Website | https://example.com')));
        const hint = document.createElement('span'); hint.className = 'ec-note'; hint.textContent = text.v2ButtonsHint; card.appendChild(hint);
      }
      box.appendChild(card);
    });
  }

  function renderV2() {
    const doc = v2Doc();
    const has = doc.components.length > 0;
    $('ecPreview').innerHTML = has ? renderV2Message(doc as any, { ...defaultContext, t: (key) => key }) : `<p class="ec-empty">${text.emptyMessage}</p>`;
    const output = $<HTMLTextAreaElement>('ecOutput');
    output.value = has ? encodeShareCode({ content: '', embeds: [], buttons: [], v2: doc }) : '';
    const openDash = $<HTMLAnchorElement>('ecOpenDash');
    openDash.hidden = !output.value;
    openDash.href = output.value ? `/dash/import#import=${encodeURIComponent(output.value)}` : '/dash/import';
    const list = $('ecWarnings');
    list.hidden = true;
    list.innerHTML = '';
  }

  function setMode(next: 'classic' | 'v2') {
    mode = next;
    $('ecV2').hidden = next !== 'v2';
    $('ecClassic').hidden = next !== 'classic';
    $('ecTabs').hidden = next === 'v2';
    $('ecSepRow').hidden = next === 'v2' || format !== 'script';
    document.querySelectorAll('.ec-mode').forEach((tab) => tab.classList.toggle('active', (tab as HTMLElement).dataset.mode === next));
    if (next === 'v2' && !blocks.length) blocks.push({ kind: 'text', content: '' });
    drawBlocks();
    render();
  }
  document.querySelectorAll<HTMLButtonElement>('.ec-mode').forEach((tab) => tab.addEventListener('click', () => setMode(tab.dataset.mode === 'v2' ? 'v2' : 'classic')));
  document.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((button) => button.addEventListener('click', () => {
    const kind = button.dataset.add as Block['kind'];
    blocks.push(kind === 'text' ? { kind, content: '' } : kind === 'sep' ? { kind, divider: true, large: false } : kind === 'images' ? { kind, urls: '' } : kind === 'section' ? { kind, content: '', thumb: '' } : { kind, lines: '' });
    drawBlocks();
    render();
  }));

  function render() {
    if (mode === 'v2') { renderV2(); return; }
    const data = read();
    const checked = validateTemplate(data);
    const clean = checked.ok ? checked.data : data;
    const message = { content: clean.content, embeds: clean.embeds, buttons: clean.buttons };
    $('ecPreview').innerHTML = data.content || data.embeds.length || data.buttons.length ? renderMessage(message, { ...defaultContext, t: (key) => key }) : `<p class="ec-empty">${text.emptyMessage}</p>`;

    const warnings = [...notes];
    if (!checked.ok) warnings.push(text.tooLong);
    const output = $<HTMLTextAreaElement>('ecOutput');
    const openDash = $<HTMLAnchorElement>('ecOpenDash');
    if (format === 'script') {
      output.value = toEmbedScript(data, $<HTMLSelectElement>('ecSeparator').value === '$v' ? '$v' : '&v');
      if (data.embeds.length > 1) warnings.push(text.extraEmbeds);
      openDash.hidden = true;
    } else {
      output.value = data.content || data.embeds.length ? encodeShareCode(clean) : '';
      openDash.hidden = !output.value;
      openDash.href = output.value ? `/dash/import#import=${encodeURIComponent(output.value)}` : '/dash/import';
    }
    const list = $('ecWarnings');
    list.hidden = warnings.length === 0;
    list.innerHTML = '';
    for (const warning of warnings) { const li = document.createElement('li'); li.textContent = warning; list.appendChild(li); }
  }

  function listRow(container: HTMLElement, inputs: { placeholder: string; key: string; value: string; max: number }[], extra: HTMLElement | null, onChange: (key: string, value: string) => void, onRemove: () => void) {
    const row = document.createElement('div');
    row.className = 'ec-list-row';
    for (const spec of inputs) {
      const input = document.createElement('input');
      input.type = 'text';
      input.placeholder = spec.placeholder;
      input.maxLength = spec.max;
      input.value = spec.value;
      input.addEventListener('input', () => { onChange(spec.key, input.value); render(); });
      row.appendChild(input);
    }
    if (extra) row.appendChild(extra);
    const remove = document.createElement('button');
    remove.type = 'button';
    remove.className = 'ec-remove';
    remove.textContent = '×';
    remove.title = text.removeLabel;
    remove.setAttribute('aria-label', text.removeLabel);
    remove.addEventListener('click', () => { onRemove(); drawLists(); render(); });
    row.appendChild(remove);
    container.appendChild(row);
  }

  function drawLists() {
    const fieldBox = $('ecFields');
    fieldBox.innerHTML = '';
    fields.forEach((field, index) => {
      const inline = document.createElement('label');
      inline.className = 'ec-check ec-inline';
      const box = document.createElement('input');
      box.type = 'checkbox';
      box.checked = field.inline;
      box.addEventListener('change', () => { field.inline = box.checked; render(); });
      inline.append(box, document.createTextNode(text.inlineLabel));
      listRow(fieldBox, [
        { placeholder: text.fieldName, key: 'name', value: field.name, max: 256 },
        { placeholder: text.fieldValue, key: 'value', value: field.value, max: 1024 },
      ], inline, (key, value) => { (field as Record<string, any>)[key] = value; }, () => fields.splice(index, 1));
    });
    const buttonBox = $('ecButtons');
    buttonBox.innerHTML = '';
    buttons.forEach((button, index) => {
      listRow(buttonBox, [
        { placeholder: text.buttonLabel, key: 'label', value: button.label, max: 80 },
        { placeholder: text.buttonUrl, key: 'url', value: button.url, max: 512 },
      ], null, (key, value) => { (button as Record<string, string>)[key] = value; }, () => buttons.splice(index, 1));
    });
    $<HTMLButtonElement>('ecAddField').disabled = fields.length >= 25;
    $<HTMLButtonElement>('ecAddButton').disabled = buttons.length >= 5;
  }

  function load(data: TemplateData) {
    const embed = data.embeds[0];
    $<HTMLTextAreaElement>('ecContent').value = data.content;
    $<HTMLInputElement>('ecTitle').value = embed?.title ?? '';
    $<HTMLInputElement>('ecUrl').value = embed?.url ?? '';
    $<HTMLTextAreaElement>('ecDescription').value = embed?.description ?? '';
    colorUsed = embed?.color !== null && embed?.color !== undefined;
    $<HTMLInputElement>('ecColor').value = colorUsed ? `#${(embed!.color as number).toString(16).padStart(6, '0')}` : '#8399ff';
    $<HTMLInputElement>('ecTimestamp').checked = Boolean(embed?.timestamp);
    $<HTMLInputElement>('ecThumbnail').value = embed?.thumbnail ?? '';
    $<HTMLInputElement>('ecImage').value = embed?.image ?? '';
    $<HTMLInputElement>('ecAuthorName').value = embed?.author.name ?? '';
    $<HTMLInputElement>('ecAuthorIcon').value = embed?.author.icon ?? '';
    $<HTMLInputElement>('ecAuthorUrl').value = embed?.author.url ?? '';
    $<HTMLInputElement>('ecFooterText').value = embed?.footer.text ?? '';
    $<HTMLInputElement>('ecFooterIcon').value = embed?.footer.icon ?? '';
    fields.splice(0, fields.length, ...(embed?.fields ?? []).map((f) => ({ ...f })));
    buttons.splice(0, buttons.length, ...data.buttons.flat().map((b) => ({ label: b.label, url: b.url })));
    drawLists();
  }

  root.addEventListener('input', (event) => {
    if ((event.target as HTMLElement).id === 'ecSeparator') return;
    const target = event.target as HTMLElement;
    if (target.id === 'ecColor') colorUsed = true;
    if (target.id === 'ecAccent') accentUsed = true;
    if (target.closest('.ec-form') && target.id !== 'ecImport') { notes = []; render(); }
  });
  $('ecAddField').addEventListener('click', () => { fields.push({ name: '', value: '', inline: false }); drawLists(); });
  $('ecAddButton').addEventListener('click', () => { buttons.push({ label: '', url: '' }); drawLists(); });

  document.querySelectorAll<HTMLButtonElement>('.ec-tab').forEach((tab) => tab.addEventListener('click', () => {
    format = tab.dataset.format === 'petto' ? 'petto' : 'script';
    document.querySelectorAll('.ec-tab').forEach((other) => other.classList.toggle('active', other === tab));
    $('ecSepRow').hidden = format !== 'script';
    render();
  }));
  $('ecSeparator').addEventListener('change', render);

  $('ecCopy').addEventListener('click', async () => {
    const button = $<HTMLButtonElement>('ecCopy');
    try { await navigator.clipboard.writeText($<HTMLTextAreaElement>('ecOutput').value); button.textContent = text.copiedLabel; } catch { $<HTMLTextAreaElement>('ecOutput').select(); }
    window.setTimeout(() => { button.textContent = text.copyLabel; }, 1500);
  });

  $('ecImportBtn').addEventListener('click', () => {
    const code = $<HTMLTextAreaElement>('ecImport').value.trim();
    const note = $('ecImportNote');
    if (!code) return;
    const shared = decodeShareCode(code);
    if (shared?.v2) { blocksFromDoc(shared.v2); notes = []; note.textContent = text.importDone; setMode('v2'); return; }
    if (shared) { load(shared); notes = []; note.textContent = text.importDone; setMode('classic'); return; }
    const parsed = parseEmbedScript(code);
    if (!parsed.data.content && !parsed.data.embeds.length) { note.textContent = text.importInvalid; return; }
    load(parsed.data);
    notes = parsed.warnings;
    note.textContent = text.importDone;
    setMode('classic');
  });

  drawLists();
  render();
</script>

