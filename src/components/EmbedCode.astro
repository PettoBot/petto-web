---
import Base from '../layouts/Base.astro';
import ColorPicker from './ColorPicker.astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = t.toolsPage.embedCode;
---
<Base title={`${p.title} · Petto`} lang={lang}>
  <main>
    <section class="ec-sec">
      <div class="wrap ec-wrap">
        <div class="eyebrow">{p.eyebrow}</div>
        <h1>{p.title}</h1>
        <p class="ec-lede">{p.lede}</p>

        <div class="ec-layout" id="ecRoot" data-i18n={JSON.stringify(p)}>
          <div class="ec-form">
            <div class="ec-modes" role="tablist">
              <button type="button" class="ec-modetab ec-mode active" data-mode="classic" role="tab">{p.modeClassic}</button>
              <button type="button" class="ec-modetab ec-mode" data-mode="v2" role="tab">{p.modeV2}</button>
            </div>

            <div id="ecV2" class="ec-v2" hidden>
              <p class="ec-v2-intro">{p.v2Intro}</p>
              <div class="ec-group">
                <h2>{p.v2Title}</h2>
                <div id="ecTree"></div>
                <div class="ec-add-row" id="ecTopAdd"></div>
              </div>
            </div>

            <div id="ecClassic" class="ec-classic">
            <div class="ec-field"><label for="ecContent">{p.contentLabel}</label><textarea id="ecContent" rows="2" maxlength="2000"></textarea></div>
            <div class="ec-row">
              <div class="ec-field"><label for="ecTitle">{p.titleLabel}</label><input id="ecTitle" type="text" maxlength="256" /></div>
              <div class="ec-field"><label for="ecUrl">{p.titleUrlLabel}</label><input id="ecUrl" type="text" placeholder="https://" /></div>
            </div>
            <div class="ec-field"><label for="ecDescription">{p.descriptionLabel}</label><textarea id="ecDescription" rows="5" maxlength="4096"></textarea></div>
            <div class="ec-row">
              <div class="ec-field"><label>{p.colorLabel}</label><ColorPicker id="ecColor" name="ecColor" value="" label={p.colorLabel} lang={lang} allowNone /></div>
              <label class="ec-check"><input id="ecTimestamp" type="checkbox" />{p.timestampLabel}</label>
            </div>
            <div class="ec-row">
              <div class="ec-field"><label for="ecThumbnail">{p.thumbnailLabel}</label><input id="ecThumbnail" type="text" placeholder="https://" /></div>
              <div class="ec-field"><label for="ecImage">{p.imageLabel}</label><input id="ecImage" type="text" placeholder="https://" /></div>
            </div>
            <div class="ec-row">
              <div class="ec-field"><label for="ecAuthorName">{p.authorNameLabel}</label><input id="ecAuthorName" type="text" maxlength="256" /></div>
              <div class="ec-field"><label for="ecAuthorIcon">{p.authorIconLabel}</label><input id="ecAuthorIcon" type="text" placeholder="https://" /></div>
            </div>
            <div class="ec-field"><label for="ecAuthorUrl">{p.authorUrlLabel}</label><input id="ecAuthorUrl" type="text" placeholder="https://" /></div>
            <div class="ec-row">
              <div class="ec-field"><label for="ecFooterText">{p.footerTextLabel}</label><input id="ecFooterText" type="text" maxlength="2048" /></div>
              <div class="ec-field"><label for="ecFooterIcon">{p.footerIconLabel}</label><input id="ecFooterIcon" type="text" placeholder="https://" /></div>
            </div>

            <div class="ec-group">
              <h2>{p.fieldsTitle}</h2>
              <div id="ecFields"></div>
              <button type="button" class="btn btn-ghost btn-sm" id="ecAddField">{p.addField}</button>
            </div>
            <div class="ec-group">
              <h2>{p.buttonsTitle}</h2>
              <div id="ecButtons"></div>
              <button type="button" class="btn btn-ghost btn-sm" id="ecAddButton">{p.addButton}</button>
              <p class="ec-note">{p.btnActionsHint}</p>
            </div>

            <div class="ec-group">
              <h2>{p.importTitle}</h2>
              <textarea id="ecImport" rows="3" placeholder={p.importPlaceholder}></textarea>
              <div class="ec-actions"><button type="button" class="btn btn-ghost btn-sm" id="ecImportBtn">{p.importButton}</button><span class="ec-note" id="ecImportNote" role="status"></span></div>
            </div>
            </div>
          </div>

          <div class="ec-side">
            <div class="ec-group">
              <h2>{p.previewTitle}</h2>
              <div id="ecPreview" class="ec-preview"></div>
            </div>
            <div class="ec-group">
              <h2>{p.outputTitle}</h2>
              <div class="ec-tabs" id="ecTabs" role="tablist">
                <button type="button" class="ec-tab active" data-format="script" role="tab">{p.formatScript}</button>
                <button type="button" class="ec-tab" data-format="petto" role="tab">{p.formatPetto}</button>
              </div>
              <label class="ec-sep" id="ecSepRow">{p.separatorLabel}
                <select id="ecSeparator"><option value="&v">&amp;v</option><option value="$v">$v</option></select>
              </label>
              <textarea id="ecOutput" rows="7" readonly></textarea>
              <div class="ec-actions">
                <button type="button" class="btn btn-accent btn-sm" id="ecCopy">{p.copyLabel}</button>
                <a class="btn btn-ghost btn-sm" id="ecOpenDash" href="/dash/import" hidden target="_blank" rel="noopener">{p.openDash}</a>
              </div>
              <ul class="ec-warnings" id="ecWarnings" hidden></ul>
            </div>
            <div class="ec-group ec-how">
              <h2>{p.howTitle}</h2>
              <p>{p.howScript}</p>
              <p>{p.howPetto}</p>
              <p>{p.howV2}</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import { renderMessage, renderV2Message, defaultContext } from '../utils/discordPreview';
  import { bindColorPickers } from '../scripts/color-picker.js';
  import { parseEmbedScript, toEmbedScript } from '../utils/embedScript';
  import { emptyEmbed, validateTemplate, encodeShareCode, decodeShareCode, cleanV2, countV2, BUTTON_STYLES as ACTION_COLORS, MAX_BUTTON_ACTIONS, type TemplateData, type V2Doc, type LinkButton, type ButtonAction } from '../utils/embedSchema';

  const root = document.getElementById('ecRoot')!;
  const text = JSON.parse(root.dataset.i18n || '{}') as Record<string, string>;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const fields: { name: string; value: string; inline: boolean }[] = [];
  // A button is a link (`url`) or has actions (`actions` and a `style`); without actions it is a link.
  const buttons: { label: string; url: string; emoji?: string; style?: LinkButton['style']; actions?: ButtonAction[] }[] = [];
  let format: 'script' | 'petto' = 'script';
  let notes: string[] = [];

  function read(): TemplateData {
    const colorHex = $<HTMLInputElement>('ecColor').value;
    const colorValue = /^#[0-9a-f]{6}$/i.test(colorHex) ? parseInt(colorHex.slice(1), 16) : null;
    const embed = {
      ...emptyEmbed(),
      title: $<HTMLInputElement>('ecTitle').value,
      url: $<HTMLInputElement>('ecUrl').value.trim(),
      description: $<HTMLTextAreaElement>('ecDescription').value,
      color: colorValue,
      thumbnail: $<HTMLInputElement>('ecThumbnail').value.trim(),
      image: $<HTMLInputElement>('ecImage').value.trim(),
      timestamp: $<HTMLInputElement>('ecTimestamp').checked,
      author: { name: $<HTMLInputElement>('ecAuthorName').value, icon: $<HTMLInputElement>('ecAuthorIcon').value.trim(), url: $<HTMLInputElement>('ecAuthorUrl').value.trim() },
      footer: { text: $<HTMLInputElement>('ecFooterText').value, icon: $<HTMLInputElement>('ecFooterIcon').value.trim() },
      fields: fields.filter((f) => f.name && f.value).map((f) => ({ ...f })),
    };
    const hasEmbed = Boolean(embed.title || embed.description || embed.author.name || embed.footer.text || embed.fields.length || embed.image || embed.thumbnail || embed.url);
    const row: LinkButton[] = buttons.flatMap((b) => {
      if (b.actions) {
        const actions = b.actions.filter((a) => a.ref.trim());
        return b.label && actions.length ? [{ label: b.label, url: '', emoji: (b.emoji ?? '').trim(), disabled: false, style: b.style ?? 'grey', actions }] : [];
      }
      return b.label && b.url ? [{ label: b.label, url: b.url, emoji: (b.emoji ?? '').trim(), disabled: false }] : [];
    });
    return { content: $<HTMLTextAreaElement>('ecContent').value, embeds: hasEmbed ? [embed] : [], buttons: row.length ? [row.slice(0, 5)] : [] };
  }

  // The color picker always holds a value, so a color is only used once somebody chose one or a code carried it.

  // ---- Components V2 -------------------------------------------------------------------------------------------------
  // The message is kept as the V2 document itself (containers and blocks), so nothing is lost when a code is pasted back in. It
  // leaves as a p2. code, which the bot reads in !embed create and the dashboard in Import.
  type AnyNode = Record<string, any>;
  let mode: 'classic' | 'v2' = 'classic';
  const newDoc = (): V2Doc => ({ components: [{ type: 17, accent_color: null, components: [{ type: 10, content: '' }] }] } as unknown as V2Doc);
  let doc: V2Doc = newDoc();
  const BUTTON_STYLES: [number, string][] = [[5, 'v2StyleLink'], [1, 'v2StylePrimary'], [2, 'v2StyleSecondary'], [3, 'v2StyleSuccess'], [4, 'v2StyleDanger']];
  const emojiToText = (emoji?: { name: string; id?: string; animated?: boolean }) => (emoji ? (emoji.id ? `<${emoji.animated ? 'a' : ''}:${emoji.name}:${emoji.id}>` : emoji.name) : '');
  const textToEmoji = (value: string) => {
    const raw = value.trim();
    const custom = /^<(a?):(\w{2,32}):(\d{15,25})>$/.exec(raw);
    if (custom) return { name: custom[2], id: custom[3], animated: custom[1] === 'a' };
    return raw ? { name: raw.slice(0, 64) } : undefined;
  };
  const makeNode = (kind: string): AnyNode => {
    switch (kind) {
      case 'container': return { type: 17, accent_color: null, components: [{ type: 10, content: '' }] };
      case 'text': return { type: 10, content: '' };
      case 'sep': return { type: 14, divider: true, spacing: 1 };
      case 'images': return { type: 12, items: [{ media: { url: '' } }] };
      case 'section': return { type: 9, components: [{ type: 10, content: '' }], accessory: { type: 11, media: { url: '' } } };
      default: return { type: 1, components: [{ type: 2, style: 5, label: '', url: '' }] };
    }
  };

  /** The message without its empty blocks and half-filled buttons, before Discord's limits cut it. */
  function pruned(): AnyNode {
    const keepButton = (b: AnyNode) => (b.style === 5 || !b.style ? Boolean(b.url?.trim() && (b.label?.trim() || b.emoji?.name)) : Boolean(b.label?.trim() || b.emoji?.name));
    const prune = (node: AnyNode): AnyNode | null => {
      if (node.type === 10) return node.content?.trim() ? node : null;
      if (node.type === 14) return node;
      if (node.type === 12) { const items = (node.items ?? []).filter((item: AnyNode) => item.media?.url?.trim()); return items.length ? { ...node, items } : null; }
      if (node.type === 9) {
        const texts = (node.components ?? []).filter((c: AnyNode) => c.content?.trim());
        if (!texts.length) return null;
        const acc = node.accessory;
        const accessory = acc?.type === 11 ? (acc.media?.url?.trim() ? acc : null) : acc?.type === 2 ? (keepButton(acc) ? acc : null) : null;
        // Discord needs the picture or button of a section, so without one it is just text.
        return accessory ? { ...node, components: texts, accessory } : { type: 10, content: texts.map((c: AnyNode) => c.content).join('\n') };
      }
      if (node.type === 1) { const components = (node.components ?? []).filter(keepButton); return components.length ? { ...node, components } : null; }
      if (node.type === 17) { const components = (node.components ?? []).map(prune).filter(Boolean); return components.length ? { ...node, components } : null; }
      return null;
    };
    return { components: (doc.components as AnyNode[]).map(prune).filter(Boolean) };
  }
  /** What would really be sent: the pruned message inside Discord's limits. */
  const effective = (): V2Doc => cleanV2(pruned());

  // -- small DOM helpers --
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className = '', content = ''): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (content) node.textContent = content;
    return node;
  }
  const field = (label: string, control: HTMLElement) => { const box = el('div', 'ec-field'); box.append(el('label', '', label), control); return box; };
  function textarea(value: string, rows: number, onInput: (value: string) => void, placeholder = '') {
    const node = el('textarea'); node.rows = rows; node.value = value; node.placeholder = placeholder; node.maxLength = 4000;
    node.addEventListener('input', () => onInput(node.value)); return node;
  }
  function input(value: string, onInput: (value: string) => void, placeholder = '', max = 512) {
    const node = el('input'); node.type = 'text'; node.value = value; node.placeholder = placeholder; node.maxLength = max;
    node.addEventListener('input', () => onInput(node.value)); return node;
  }
  function check(label: string, value: boolean, onChange: (value: boolean) => void) {
    const wrap = el('label', 'ec-check'); const box = el('input'); box.type = 'checkbox'; box.checked = value;
    box.addEventListener('change', () => { onChange(box.checked); render(); }); wrap.append(box, document.createTextNode(label)); return wrap;
  }
  function tool(parent: HTMLElement, label: string, aria: string, run: () => void, disabled = false) {
    const button = el('button', 'ec-remove', label); button.type = 'button'; button.title = aria; button.setAttribute('aria-label', aria); button.disabled = disabled;
    button.addEventListener('click', () => { run(); drawTree(); render(); }); parent.appendChild(button);
  }
  function head(title: string, list: AnyNode[], index: number): HTMLElement {
    const row = el('div', 'ec-block-head'); const tools = el('div', 'ec-block-tools');
    tool(tools, '↑', text.v2Up, () => { [list[index - 1], list[index]] = [list[index], list[index - 1]]; }, index === 0);
    tool(tools, '↓', text.v2Down, () => { [list[index + 1], list[index]] = [list[index], list[index + 1]]; }, index === list.length - 1);
    tool(tools, '×', text.removeLabel, () => { list.splice(index, 1); });
    row.append(el('strong', '', title), tools); return row;
  }
  function addButtons(parent: HTMLElement, list: AnyNode[], kinds: string[]) {
    const labels: Record<string, string> = { container: text.v2AddContainer, text: text.v2AddText, section: text.v2AddSection, images: text.v2AddImages, sep: text.v2AddSeparator, buttons: text.v2AddButtons };
    for (const kind of kinds) {
      const button = el('button', 'btn btn-ghost btn-sm', `+ ${labels[kind]}`); button.type = 'button';
      button.addEventListener('click', () => { list.push(makeNode(kind)); drawTree(); render(); }); parent.appendChild(button);
    }
  }

  function buttonEditor(button: AnyNode, onRemove: (() => void) | null): HTMLElement {
    const row = el('div', 'ec-btn-edit');
    const select = el('select');
    for (const [value, key] of BUTTON_STYLES) { const o = el('option', '', text[key]); o.value = String(value); o.selected = (button.style ?? 5) === value; select.appendChild(o); }
    const url = input(button.url ?? '', (v) => { button.url = v; }, 'https://');
    const disabled = check(text.v2Disabled, Boolean(button.disabled), (v) => { button.disabled = v || undefined; });
    const sync = () => { const link = Number(select.value) === 5; url.hidden = !link; disabled.hidden = !link; };
    select.addEventListener('change', () => { button.style = Number(select.value); if (button.style === 5) delete button.custom_id; sync(); render(); });
    const main = el('div', 'ec-btn-row');
    main.append(input(emojiToText(button.emoji), (v) => { const emoji = textToEmoji(v); if (emoji) button.emoji = emoji; else delete button.emoji; }, text.v2Emoji, 64), input(button.label ?? '', (v) => { button.label = v; }, text.buttonLabel, 80), select);
    if (onRemove) tool(main, '×', text.removeLabel, onRemove);
    row.append(main, url, disabled); sync(); return row;
  }

  function nodeEditor(node: AnyNode, list: AnyNode[], index: number, inContainer: boolean): HTMLElement {
    const names: Record<number, string> = { 10: text.v2AddText, 14: text.v2AddSeparator, 12: text.v2AddImages, 9: text.v2AddSection, 1: text.v2AddButtons, 17: text.v2Container };
    const card = el('div', node.type === 17 ? 'ec-block ec-container' : 'ec-block');
    card.appendChild(head(names[node.type] ?? '', list, index));
    if (node.type === 10) card.appendChild(field(text.v2Text, textarea(node.content ?? '', 4, (v) => { node.content = v; })));
    else if (node.type === 14) { const row = el('div', 'ec-block-checks'); row.append(check(text.v2Divider, node.divider !== false, (v) => { node.divider = v; }), check(text.v2Large, node.spacing === 2, (v) => { node.spacing = v ? 2 : 1; })); card.appendChild(row); }
    else if (node.type === 12) {
      const items: AnyNode[] = node.items;
      items.forEach((item, i) => {
        const row = el('div', 'ec-btn-edit'); const main = el('div', 'ec-btn-row');
        main.append(input(item.media?.url ?? '', (v) => { item.media = { url: v }; }, 'https://'));
        tool(main, '×', text.removeLabel, () => { items.splice(i, 1); });
        row.append(main, input(item.description ?? '', (v) => { if (v) item.description = v; else delete item.description; }, text.v2Desc, 1024), check(text.v2Spoiler, Boolean(item.spoiler), (v) => { item.spoiler = v || undefined; }));
        card.appendChild(row);
      });
      const more = el('button', 'btn btn-ghost btn-sm', `+ ${text.v2AddItem}`); more.type = 'button'; more.disabled = items.length >= 10;
      more.addEventListener('click', () => { items.push({ media: { url: '' } }); drawTree(); render(); }); card.append(more, el('span', 'ec-note', text.v2ImagesHint));
    } else if (node.type === 9) {
      const texts: AnyNode[] = node.components;
      texts.forEach((child, i) => {
        const row = el('div', 'ec-btn-edit'); row.appendChild(field(text.v2Text, textarea(child.content ?? '', 3, (v) => { child.content = v; })));
        if (texts.length > 1) { const rm = el('div', 'ec-block-tools'); tool(rm, '×', text.removeLabel, () => { texts.splice(i, 1); }); row.appendChild(rm); }
        card.appendChild(row);
      });
      if (texts.length < 3) { const more = el('button', 'btn btn-ghost btn-sm', `+ ${text.v2AddText}`); more.type = 'button'; more.addEventListener('click', () => { texts.push({ type: 10, content: '' }); drawTree(); render(); }); card.appendChild(more); }
      const kind = el('select'); for (const [value, label] of [['11', text.v2AccPicture], ['2', text.v2AccButton]] as const) { const o = el('option', '', label); o.value = value; o.selected = String(node.accessory?.type ?? 11) === value; kind.appendChild(o); }
      kind.addEventListener('change', () => { node.accessory = kind.value === '2' ? { type: 2, style: 5, label: '', url: '' } : { type: 11, media: { url: '' } }; drawTree(); render(); });
      card.appendChild(field(text.v2Accessory, kind));
      const acc = node.accessory;
      if (acc?.type === 2) card.appendChild(buttonEditor(acc, null));
      else if (acc) {
        card.append(field(text.v2Thumb, input(acc.media?.url ?? '', (v) => { acc.media = { url: v }; }, 'https://')), input(acc.description ?? '', (v) => { if (v) acc.description = v; else delete acc.description; }, text.v2Desc, 1024), check(text.v2Spoiler, Boolean(acc.spoiler), (v) => { acc.spoiler = v || undefined; }));
      }
    } else if (node.type === 1) {
      const buttons: AnyNode[] = node.components;
      buttons.forEach((button, i) => card.appendChild(buttonEditor(button, () => { buttons.splice(i, 1); })));
      const more = el('button', 'btn btn-ghost btn-sm', `+ ${text.addButton}`); more.type = 'button'; more.disabled = buttons.length >= 5;
      more.addEventListener('click', () => { buttons.push({ type: 2, style: 5, label: '', url: '' }); drawTree(); render(); }); card.append(more, el('span', 'ec-note', text.v2ButtonsHint));
    } else if (node.type === 17) {
      const top = el('div', 'ec-block-checks');
      const color = el('input'); color.type = 'color'; color.value = typeof node.accent_color === 'number' ? `#${node.accent_color.toString(16).padStart(6, '0')}` : '#8399ff'; color.disabled = typeof node.accent_color !== 'number';
      color.addEventListener('input', () => { node.accent_color = parseInt(color.value.slice(1), 16); });
      top.append(check(text.v2AccentLabel, typeof node.accent_color === 'number', (v) => { node.accent_color = v ? parseInt(color.value.slice(1), 16) : null; color.disabled = !v; }), color, check(text.v2Spoiler, Boolean(node.spoiler), (v) => { node.spoiler = v || undefined; }));
      card.appendChild(top);
      const inner = el('div', 'ec-inner');
      (node.components as AnyNode[]).forEach((child, i) => inner.appendChild(nodeEditor(child, node.components, i, true)));
      const add = el('div', 'ec-add-row'); addButtons(add, node.components, ['text', 'section', 'images', 'sep', 'buttons']);
      card.append(inner, add);
    }
    return card;
  }

  function drawTree() {
    const tree = $('ecTree'); tree.innerHTML = '';
    (doc.components as AnyNode[]).forEach((node, i) => tree.appendChild(nodeEditor(node, doc.components as AnyNode[], i, false)));
    const add = $('ecTopAdd'); add.innerHTML = '';
    addButtons(add, doc.components as AnyNode[], ['container', 'text', 'section', 'images', 'sep', 'buttons']);
  }

  function renderV2() {
    const sent = effective();
    const has = sent.components.length > 0;
    $('ecPreview').innerHTML = has ? renderV2Message(sent as any, { ...defaultContext, t: (key) => key }) : `<p class="ec-empty">${text.emptyMessage}</p>`;
    const output = $<HTMLTextAreaElement>('ecOutput');
    output.value = has ? encodeShareCode({ content: '', embeds: [], buttons: [], v2: sent }) : '';
    const openDash = $<HTMLAnchorElement>('ecOpenDash');
    openDash.hidden = !output.value;
    openDash.href = output.value ? `/dash/import#import=${encodeURIComponent(output.value)}` : '/dash/import';
    const list = $('ecWarnings');
    const counts = countV2(sent);
    const raw = countV2(pruned() as V2Doc);
    const warnings: string[] = [];
    if (raw.components > counts.components || raw.chars > counts.chars) warnings.push(text.v2TooBig);
    list.hidden = warnings.length === 0;
    list.innerHTML = '';
    for (const warning of warnings) { const li = document.createElement('li'); li.textContent = warning; list.appendChild(li); }
  }
  function setMode(next: 'classic' | 'v2') {
    mode = next;
    $('ecV2').hidden = next !== 'v2';
    $('ecClassic').hidden = next !== 'classic';
    $('ecTabs').hidden = next === 'v2';
    $('ecSepRow').hidden = next === 'v2' || format !== 'script';
    document.querySelectorAll('.ec-mode').forEach((tab) => tab.classList.toggle('active', (tab as HTMLElement).dataset.mode === next));
    if (next === 'v2') drawTree();
    render();
  }
  document.querySelectorAll<HTMLButtonElement>('.ec-mode').forEach((tab) => tab.addEventListener('click', () => setMode(tab.dataset.mode === 'v2' ? 'v2' : 'classic')));

  function render() {
    if (mode === 'v2') { renderV2(); return; }
    const data = read();
    const checked = validateTemplate(data);
    const clean = checked.ok ? checked.data : data;
    const message = { content: clean.content, embeds: clean.embeds, buttons: clean.buttons };
    $('ecPreview').innerHTML = data.content || data.embeds.length || data.buttons.length ? renderMessage(message, { ...defaultContext, t: (key) => key }) : `<p class="ec-empty">${text.emptyMessage}</p>`;

    const warnings = [...notes];
    if (!checked.ok) warnings.push(text.tooLong);
    const output = $<HTMLTextAreaElement>('ecOutput');
    const openDash = $<HTMLAnchorElement>('ecOpenDash');
    if (format === 'script') {
      output.value = toEmbedScript(data, $<HTMLSelectElement>('ecSeparator').value === '$v' ? '$v' : '&v');
      if (data.embeds.length > 1) warnings.push(text.extraEmbeds);
      openDash.hidden = true;
    } else {
      output.value = data.content || data.embeds.length ? encodeShareCode(clean) : '';
      openDash.hidden = !output.value;
      openDash.href = output.value ? `/dash/import#import=${encodeURIComponent(output.value)}` : '/dash/import';
    }
    const list = $('ecWarnings');
    list.hidden = warnings.length === 0;
    list.innerHTML = '';
    for (const warning of warnings) { const li = document.createElement('li'); li.textContent = warning; list.appendChild(li); }
  }

  function listRow(container: HTMLElement, inputs: { placeholder: string; key: string; value: string; max: number }[], extra: HTMLElement | null, onChange: (key: string, value: string) => void, onRemove: () => void) {
    const row = document.createElement('div');
    row.className = 'ec-list-row';
    for (const spec of inputs) {
      const input = document.createElement('input');
      input.type = 'text';
      input.placeholder = spec.placeholder;
      input.maxLength = spec.max;
      input.value = spec.value;
      input.addEventListener('input', () => { onChange(spec.key, input.value); render(); });
      row.appendChild(input);
    }
    if (extra) row.appendChild(extra);
    const remove = document.createElement('button');
    remove.type = 'button';
    remove.className = 'ec-remove';
    remove.textContent = '×';
    remove.title = text.removeLabel;
    remove.setAttribute('aria-label', text.removeLabel);
    remove.addEventListener('click', () => { onRemove(); drawLists(); render(); });
    row.appendChild(remove);
    container.appendChild(row);
  }

  function drawLists() {
    const fieldBox = $('ecFields');
    fieldBox.innerHTML = '';
    fields.forEach((field, index) => {
      const inline = document.createElement('label');
      inline.className = 'ec-check ec-inline';
      const box = document.createElement('input');
      box.type = 'checkbox';
      box.checked = field.inline;
      box.addEventListener('change', () => { field.inline = box.checked; render(); });
      inline.append(box, document.createTextNode(text.inlineLabel));
      listRow(fieldBox, [
        { placeholder: text.fieldName, key: 'name', value: field.name, max: 256 },
        { placeholder: text.fieldValue, key: 'value', value: field.value, max: 1024 },
      ], inline, (key, value) => { (field as Record<string, any>)[key] = value; }, () => fields.splice(index, 1));
    });
    const buttonBox = $('ecButtons');
    buttonBox.innerHTML = '';
    buttons.forEach((button, index) => {
      const box = document.createElement('div');
      box.className = 'ec-btn-box';
      const select = (options: [string, string][], value: string, onPick: (v: string) => void) => {
        const el = document.createElement('select');
        for (const [v, label] of options) { const o = document.createElement('option'); o.value = v; o.textContent = label; o.selected = v === value; el.appendChild(o); }
        el.addEventListener('change', () => { onPick(el.value); });
        return el;
      };
      const kind = select([['link', text.btnKindLink], ['action', text.btnKindAction]], button.actions ? 'action' : 'link', (v) => {
        if (v === 'action') { button.actions = [{ type: 'role', ref: '' }]; button.style = 'grey'; button.url = ''; } else { delete button.actions; delete button.style; }
        drawLists(); render();
      });
      const style = button.actions ? select(ACTION_COLORS.map((v): [string, string] => [v, text[`btnColor_${v}`]]), button.style ?? 'grey', (v) => { button.style = v as LinkButton['style']; render(); }) : null;
      listRow(box, [
        { placeholder: text.buttonLabel, key: 'label', value: button.label, max: 80 },
        ...(button.actions ? [] : [{ placeholder: text.buttonUrl, key: 'url', value: button.url, max: 512 }]),
        { placeholder: text.btnEmoji, key: 'emoji', value: button.emoji ?? '', max: 64 },
      ], null, (key, value) => { (button as unknown as Record<string, string>)[key] = value; }, () => buttons.splice(index, 1));
      const head = box.querySelector('.ec-list-row')!;
      head.prepend(kind);
      if (style) head.insertBefore(style, head.querySelector('.ec-remove'));
      if (button.actions) {
        const list = document.createElement('div');
        list.className = 'ec-btn-actions';
        button.actions.forEach((action, ai) => {
          const row = document.createElement('div');
          row.className = 'ec-list-row';
          const types: [string, string][] = [['role', text.btnActRole], ['addrole', text.btnActAddRole], ['removerole', text.btnActRemoveRole], ['embed', text.btnActEmbed]];
          row.appendChild(select(types, action.type, (v) => { action.type = v as ButtonAction['type']; action.ref = ''; action.mode = v === 'embed' ? 'ephemeral' : undefined; drawLists(); render(); }));
          const input = document.createElement('input');
          input.type = 'text';
          input.maxLength = 100;
          input.placeholder = action.type === 'embed' ? text.btnEmbedPlaceholder : text.btnRolePlaceholder;
          input.value = action.ref;
          input.addEventListener('input', () => { action.ref = input.value; render(); });
          row.appendChild(input);
          if (action.type === 'embed') row.appendChild(select([['ephemeral', text.btnModeEphemeral], ['public', text.btnModePublic], ['dm', text.btnModeDm]], action.mode ?? 'ephemeral', (v) => { action.mode = v as ButtonAction['mode']; render(); }));
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'ec-remove';
          remove.textContent = '×';
          remove.title = text.removeLabel;
          remove.setAttribute('aria-label', text.removeLabel);
          remove.addEventListener('click', () => { button.actions!.splice(ai, 1); if (!button.actions!.length) { delete button.actions; delete button.style; } drawLists(); render(); });
          row.appendChild(remove);
          list.appendChild(row);
        });
        if (button.actions.length < MAX_BUTTON_ACTIONS) {
          const more = document.createElement('button');
          more.type = 'button';
          more.className = 'btn btn-ghost btn-sm';
          more.textContent = `+ ${text.btnAddAction}`;
          more.addEventListener('click', () => { button.actions!.push({ type: 'role', ref: '' }); drawLists(); });
          list.appendChild(more);
        }
        box.appendChild(list);
      }
      buttonBox.appendChild(box);
    });
    $<HTMLButtonElement>('ecAddField').disabled = fields.length >= 25;
    $<HTMLButtonElement>('ecAddButton').disabled = buttons.length >= 5;
  }

  function load(data: TemplateData) {
    const embed = data.embeds[0];
    $<HTMLTextAreaElement>('ecContent').value = data.content;
    $<HTMLInputElement>('ecTitle').value = embed?.title ?? '';
    $<HTMLInputElement>('ecUrl').value = embed?.url ?? '';
    $<HTMLTextAreaElement>('ecDescription').value = embed?.description ?? '';
    const loadedColor = embed?.color !== null && embed?.color !== undefined ? `#${(embed!.color as number).toString(16).padStart(6, '0')}` : '';
    $<HTMLInputElement>('ecColor').value = loadedColor;
    $('ecColor').closest('[data-colorpicker]')?.dispatchEvent(new CustomEvent('cp-set', { detail: loadedColor }));
    $<HTMLInputElement>('ecTimestamp').checked = Boolean(embed?.timestamp);
    $<HTMLInputElement>('ecThumbnail').value = embed?.thumbnail ?? '';
    $<HTMLInputElement>('ecImage').value = embed?.image ?? '';
    $<HTMLInputElement>('ecAuthorName').value = embed?.author.name ?? '';
    $<HTMLInputElement>('ecAuthorIcon').value = embed?.author.icon ?? '';
    $<HTMLInputElement>('ecAuthorUrl').value = embed?.author.url ?? '';
    $<HTMLInputElement>('ecFooterText').value = embed?.footer.text ?? '';
    $<HTMLInputElement>('ecFooterIcon').value = embed?.footer.icon ?? '';
    fields.splice(0, fields.length, ...(embed?.fields ?? []).map((f) => ({ ...f })));
    buttons.splice(0, buttons.length, ...data.buttons.flat().map((b) => (b.actions?.length ? { label: b.label, url: '', emoji: b.emoji ?? '', style: b.style ?? 'grey', actions: b.actions.map((a) => ({ ...a })) } : { label: b.label, url: b.url, emoji: b.emoji ?? '' })));
    drawLists();
  }

  root.addEventListener('input', (event) => {
    if ((event.target as HTMLElement).id === 'ecSeparator') return;
    const target = event.target as HTMLElement;
    if (target.closest('.ec-form') && target.id !== 'ecImport') { notes = []; render(); }
  });
  $('ecAddField').addEventListener('click', () => { fields.push({ name: '', value: '', inline: false }); drawLists(); });
  $('ecAddButton').addEventListener('click', () => { buttons.push({ label: '', url: '' }); drawLists(); });

  document.querySelectorAll<HTMLButtonElement>('.ec-tab').forEach((tab) => tab.addEventListener('click', () => {
    format = tab.dataset.format === 'petto' ? 'petto' : 'script';
    document.querySelectorAll('.ec-tab').forEach((other) => other.classList.toggle('active', other === tab));
    $('ecSepRow').hidden = format !== 'script';
    render();
  }));
  $('ecSeparator').addEventListener('change', render);

  $('ecCopy').addEventListener('click', async () => {
    const button = $<HTMLButtonElement>('ecCopy');
    try { await navigator.clipboard.writeText($<HTMLTextAreaElement>('ecOutput').value); button.textContent = text.copiedLabel; } catch { $<HTMLTextAreaElement>('ecOutput').select(); }
    window.setTimeout(() => { button.textContent = text.copyLabel; }, 1500);
  });

  $('ecImportBtn').addEventListener('click', () => {
    const code = $<HTMLTextAreaElement>('ecImport').value.trim();
    const note = $('ecImportNote');
    if (!code) return;
    const shared = decodeShareCode(code);
    if (shared?.v2) { doc = JSON.parse(JSON.stringify(shared.v2)) as V2Doc; notes = []; note.textContent = text.importDone; setMode('v2'); return; }
    if (shared) { load(shared); notes = []; note.textContent = text.importDone; setMode('classic'); return; }
    const parsed = parseEmbedScript(code);
    if (!parsed.data.content && !parsed.data.embeds.length) { note.textContent = text.importInvalid; return; }
    load(parsed.data);
    notes = parsed.warnings;
    note.textContent = text.importDone;
    setMode('classic');
  });

  drawLists();
  render();
  bindColorPickers(document);
</script>

