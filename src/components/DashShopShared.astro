---
// The look both pages of the profile shop share (the page of badges and the pages of name fonts and banners): the cards, the search and the filter, the tiles' name and price,
// the rarity colours, the wallet and the dialog. Written once here so a change reaches every page.
---
<style is:global>  .bd-card { border: 1px solid var(--border-soft); border-radius: 18px; background: color-mix(in srgb, var(--text) 3%, transparent); padding: 16px; }
  .bd-card-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-bottom: 12px; }
  .bd-card-head h2 { margin: 0; font-size: 17px; }
  .bd-card-head span { color: var(--text-muted); font-size: 13px; }
  .bd-hint { margin: 12px 0 0; color: var(--text-muted); font-size: 13px; }
  .bd-tab, .bd-filter button { background: none; border: 0; color: var(--text-muted); font: inherit; font-size: 13.5px; padding: 7px 9px; border-radius: 10px; cursor: pointer; display: inline-flex; gap: 7px; align-items: center; }
  .bd-filter { display: inline-flex; padding: 3px; border-radius: 12px; background: color-mix(in srgb, var(--text) 5%, transparent); }
  .bd-filter button.active { background: var(--green-soft); color: var(--green-text); }
  .bd-find { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .bd-search { flex: 1 1 220px; min-width: 0; }
  .bd-search input { width: 100%; box-sizing: border-box; padding: 11px 14px; border-radius: 12px; border: 1px solid var(--border-soft); background: color-mix(in srgb, var(--text) 4%, transparent); color: var(--text); font: inherit; }
  .bd-search input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .bd-name { font-size: 13.5px; font-weight: 600; overflow-wrap: anywhere; line-height: 1.2; }
  .bd-meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; justify-content: center; font-size: 12.5px; color: var(--text-muted); }
  .bd-price { display: inline-flex; align-items: center; gap: 5px; }
  .bd-owned { color: var(--green-text); font-weight: 600; }
  .bd-until { font-size: 11.5px; color: var(--yellow-text, var(--text-muted)); }
  .bd-coin { display: inline-block; width: 13px; height: 13px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #fff3b0, #e8a92c); box-shadow: inset 0 0 0 2px rgba(150,90,10,.45); }
  .bd-rar { padding: 1px 7px; border-radius: 6px; font-size: 11.5px; font-weight: 700; background: color-mix(in srgb, var(--text) 10%, transparent); }
  .bd-r-rare { color: #7ad0ff; } .bd-r-epic { color: #c79bff; } .bd-r-legendary { color: #ffd666; }
  .bd-empty, .bd-down { color: var(--text-muted); margin: 8px 0; }
  .bd-down { color: var(--red-text); }
  .bd-wallet { display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .bd-bal { display: inline-flex; align-items: center; gap: 7px; padding: 7px 12px; border-radius: 12px; background: color-mix(in srgb, var(--text) 6%, transparent); font-size: 15px; }
  .bd-daily:not(:disabled) { background: var(--green); color: var(--green-ink); border-color: transparent; }
  .bd-daily[hidden], .bd-next[hidden] { display: none; }
  .bd-next { color: var(--text-muted); font-size: 13px; }
  .bd-dialog { border: 1px solid var(--border-soft); border-radius: 20px; padding: 0; background: var(--card); color: var(--text); width: min(360px, calc(100vw - 32px)); }
  .bd-dialog::backdrop { background: rgba(0,0,0,.6); }
  .bd-dialog-body { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 24px 20px 20px; text-align: center; }
  .bd-dialog h3 { margin: 4px 0 0; font-size: 20px; } .bd-dialog p { margin: 0; color: var(--text-muted); font-size: 14px; }
  .bd-d-actions { display: flex; flex-direction: column; gap: 8px; width: 100%; margin-top: 6px; }
  .bd-d-actions .btn, .bd-d-close { width: 100%; justify-content: center; }
  .bd-d-go { background: var(--green); color: var(--green-ink); border-color: transparent; }
  .bd-d-out { background: var(--red-soft); color: var(--red-text); }
  .bd-d-error { color: var(--red-text) !important; }
</style>
