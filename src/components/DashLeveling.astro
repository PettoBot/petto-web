  };
  window.PettoLevelingDepsInit = (root = document) => {
    root.querySelectorAll('form[data-lv-form]').forEach((form) => {
      if (form.dataset.lvDeps) return;
      form.dataset.lvDeps = '1';
      const kind = form.dataset.lvForm;
      const labels = lvLabelsOf();
      let hrefs = {};
      try { hrefs = JSON.parse(form.dataset.lvHrefs ?? '{}'); } catch { hrefs = {}; }
      const hrefFor = { textOff: hrefs.settings, noTextNotify: hrefs.settings, voiceOff: hrefs.voice, noVoiceNotify: hrefs.voice };
      const gate = form.querySelector('[data-lv-gate]');
      const gateNote = form.querySelector('[data-lv-gate-note]');
      const deps = Array.from(form.querySelectorAll('[data-lv-dep]'));
      const errors = new Map();
      const errFor = (name) => {
        const control = lvNamed(form, name)[0];
        const box = control?.closest('.lv-field') ?? control?.parentElement;
        if (!box) return null;
        let line = errors.get(name);
        if (!line || !line.isConnected) {
          line = document.createElement('p');
