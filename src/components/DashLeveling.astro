        <div class="lv-rank-stage" data-fail={dt('The preview could not be drawn.')} data-retry={dt('Try again')} data-busy={dt('Drawing the preview…')}><img id="lvRankImg" alt="" /></div>
        <div class="lv-preview-label">{dt('Embed preview')}</div>
