  .lv-board-row:hover { background: var(--card-hover); }
  .lv-board-rank { color: var(--text-dim); font: 600 12px var(--mono); }
  .lv-board-first .lv-board-rank { color: #e6c56f; }
  .lv-board-second .lv-board-rank { color: #b9c2cf; }
  .lv-board-third .lv-board-rank { color: #c99c74; }
  .lv-board-member { min-width: 0; display: flex; align-items: center; gap: 10px; }
