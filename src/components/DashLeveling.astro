          <MultiSelect lazy name="voice_ignored_category_ids" options={withMissing(categories.map((category) => ({ id: category.id, name: category.name })), voiceConfig.ignoredCategoryIds)} selected={voiceConfig.ignoredCategoryIds} placeholder={dt('Search categories...')} />
          <p class="lv-hint">{dt('Members in voice channels of these categories do not gain voice XP.')}</p>
        </div>
      </div>
    </details>

    <details class="lv-adv lv-adv-curve" data-lv-adv open={advVoiceCurve}>
      <summary><Icon name="ph:caret-right-bold" width="12" height="12" />{dt('Voice XP curve and level limit')}</summary>
    <div class="lv-advanced lv-curve-editor" data-voice-curve-editor>
      <div class="lv-curve-head">
        <div>
          <div class="lv-curve-title"><Icon name="ph:chart-line-up" width="16" height="16" />{dt('Voice XP curve')}</div>
