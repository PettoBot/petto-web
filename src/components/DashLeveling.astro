  .lv-switch { position: relative; display: inline-block; width: 34px; height: 20px; flex-shrink: 0; }
  .lv-switch input { opacity: 0; width: 0; height: 0; }
  .lv-switch span { position: absolute; inset: 0; background: var(--border); border-radius: 20px; transition: background 0.15s; cursor: pointer; }
  .lv-switch input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .lv-switch span::before { content: ''; position: absolute; width: 14px; height: 14px; left: 3px; top: 3px; background: var(--card); border-radius: 50%; transition: transform 0.15s; }
  .lv-switch input:checked + span { background: var(--accent); }
  .lv-switch input:checked + span::before { transform: translateX(14px); }
  .lv-switch input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }

  .lv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 28px; width: 100%; }
  .lv-field { display: flex; flex-direction: column; gap: 6px; }
