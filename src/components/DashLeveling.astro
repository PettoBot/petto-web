        <div class="lv-field"><label>{dt('Most a multiplier can reach')}</label><input type="number" name="multiplier_cap" value={rules.multiplierCap} min="1" max="100" step="0.5" /><span class="lv-hint">{dt('The combined multiplier never goes above this.')}</span></div>
        <label class="lv-check"><input type="checkbox" name="restore_roles" checked={rules.restoreRoles} />{dt('Give the reward roles back to a member who returns')}</label>
        <label class="lv-check"><input type="checkbox" name="reset_on_leave" checked={rules.resetOnLeave} />{dt('Wipe the XP and level of a member who leaves')}</label>
        <div class="lv-field lv-field-wide"><label>{dt('Roles that earn no XP')}</label>
          <MultiSelect lazy name="no_xp_role_ids" options={roles.map((role) => ({ id: role.id, name: role.name }))} selected={rules.noXpRoleIds} placeholder={dt('Search roles...')} />
        </div>
        <div class="lv-field lv-field-wide"><label>{dt('Only these roles earn XP')}</label>
          <MultiSelect lazy name="only_xp_role_ids" options={roles.map((role) => ({ id: role.id, name: role.name }))} selected={rules.onlyXpRoleIds} placeholder={dt('Search roles...')} />
