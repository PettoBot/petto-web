            line.hidden = false;
          } else {
            delete box.dataset.off;
            delete line.dataset.reason;
            line.hidden = true;
          }
          targets.forEach((el) => lvDescribe(el, line.id, Boolean(reason) && reasons.get(el) === reason));
        });
        lvControls(form).concat(lvWidgets(form)).forEach((el) => {
          const off = reasons.has(el);
