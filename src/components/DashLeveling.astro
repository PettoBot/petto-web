          <label class="dfx-chip"><input id="lv-voice_notify_mode" type="radio" name="voice_notify_mode" value="off" checked={voiceConfig.notifyMode === 'off'} />{dt('Off')}</label>
          <label class="dfx-chip"><input type="radio" name="voice_notify_mode" value="reply" checked={voiceConfig.notifyMode === 'reply'} />{dt('In the voice channel chat')}</label>
