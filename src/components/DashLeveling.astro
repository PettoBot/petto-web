            el.disabled = false;
            delete el.dataset.lvDis;
          }
        });

        // The line at the top of the card.
        form.querySelectorAll('[data-lv-status]').forEach((line) => {
          const text = statusParts(line.dataset.lvStatus, ctx, labels).join(' · ');
          if (line.textContent !== text) line.textContent = text;
        });

        // The messages under the fields: what is missing or does not fit. One that is about fields the person did not touch only warns.
        const shown = new Map();
        const note = (name, text, blocks, native) => { if (name && text && !shown.has(name)) shown.set(name, { text, blocks, native }); };
        if (kind === 'settings' || kind === 'voice' || kind === 'rules') {
          problemsFor(kind, ctx, initial).forEach((problem) => {
            const control = lvNamed(form, problem.field)[0];
            if (control && (control.disabled || control.closest('[inert]'))) return;
            note(problem.field, format(labels[`err_${problem.key}`] ?? '', problem.args), problem.blocks, false);
