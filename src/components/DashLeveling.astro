---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import VariableHelp from './VariableHelp.astro';
import MultiSelect from './MultiSelect.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface Config {
  enabled: boolean;
  xpMin: number;
  xpMax: number;
  xpPerVcMinute: number;
  cooldownSeconds: number;
  notifyMode: string;
  notifyChannelId: string | null;
  notifyMessage: string;
  notifyEmbed: boolean;
  notifyEmbedTemplate: string;
  notifyEvery: number;
  roleMode: string;
  ignoredChannelIds: string[];
  joinXp: number;
  joinLevel: number;
  curveA: number;
  curveB: number;
  curveC: number;
  difficulty: number;
  rounding: number;
  maxLevel: number;
}
interface Reward { level: number; roleId: string; }
interface LeaderboardRow {
  rank: number;
  userId: string;
  displayName: string;
  username: string;
  avatarUrl: string;
  xp: number;
  level: number;
  voiceMinutes?: number;
}
interface VoiceConfig {
  enabled: boolean;
  xpPerMinute: number;
  curveA: number;
  curveB: number;
  curveC: number;
  difficulty: number;
  rounding: number;
  maxLevel: number;
  notifyMode: string;
  notifyChannelId: string | null;
  notifyMessage: string;
  notifyEmbed: boolean;
  notifyEmbedTemplate: string;
  notifyEvery: number;
  roleMode: string;
  ignoredChannelIds: string[];
}

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  config: Config;
  rewards: Reward[];
  roles: { id: string; name: string }[];
  channels: { id: string; name: string }[];
  voiceChannels: { id: string; name: string }[];
  leaderboard: LeaderboardRow[];
  voiceConfig: VoiceConfig;
  voiceLeaderboard: LeaderboardRow[];
  embedTemplateNames: string[];
  saved: boolean;
  saveError: boolean;
  section?: string;
}
const { user, guildId, guildName, guildIcon, config, rewards, roles, channels, voiceChannels, leaderboard, voiceConfig, voiceLeaderboard, embedTemplateNames, saved, saveError, section } = Astro.props;
const sectionMeta: Record<string, string> = { settings: dt('Leveling settings'), voice: dt('Voice leveling'), rewards: dt('Level rewards'), leaderboard: dt('Leaderboard'), 'leaderboard-voice': dt('Voice leaderboard') };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'settings';
const selectedTitle = sectionMeta[selectedSection];
const leaderboardIsVoice = selectedSection === 'leaderboard-voice';
const displayLeaderboard = leaderboardIsVoice ? voiceLeaderboard : leaderboard;
const curvePreviewLevels = [1, 2, 3, 4, 5, 7, 10, 25, 50, 100, 200];
const curveNumber = (value: unknown, fallback: number) => {
  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : fallback;
};
const curveA = curveNumber(config.curveA, 1);
const curveB = curveNumber(config.curveB, 50);
const curveC = curveNumber(config.curveC, 100);
const curveDifficulty = curveNumber(config.difficulty, 2.5);
const curveRounding = Math.max(1, curveNumber(config.rounding, 50));
const curveTotal = (level: number) => {
  if (level <= 0) return 0;
  const raw = (curveA * level ** 3 + curveB * level ** 2 + curveC * level) * curveDifficulty;
  return Math.round(raw / curveRounding) * curveRounding;
};
const curveMax = Math.max(curveTotal(50), 1);
const curveX = (level: number) => 44 + (level / 50) * 556;
const curveY = (value: number) => 240 - (value / curveMax) * 216;
const curvePath = Array.from({ length: 51 }, (_, level) => `${level ? 'L' : 'M'}${curveX(level).toFixed(1)} ${curveY(curveTotal(level)).toFixed(1)}`).join(' ');
const curveMessages = (level: number) => Math.max(0, Math.ceil(curveTotal(level) / Math.max(curveNumber(config.xpMax, 25), 1)));
const curveCooldown = (level: number) => Math.max(0, Math.round(curveMessages(level) * curveNumber(config.cooldownSeconds, 60)));
const formatCurve = (value: number) => Math.max(0, Math.round(value)).toLocaleString('en-US');
const formatCooldown = (value: number) => value >= 3600 ? `~${(value / 3600).toFixed(1)}h` : `~${formatCurve(value)}s`;
const leaderboardProgress = (row: LeaderboardRow, voice = false) => {
  const total = voice ? voiceCurveTotal : curveTotal;
  const current = total(row.level);
  const next = total(row.level + 1);
  if (next <= current) return 100;
  return Math.min(100, Math.max(0, ((row.xp - current) / (next - current)) * 100));
};
const voiceCurveTotal = (level: number) => {
  if (level <= 0) return 0;
  const raw = (Number(voiceConfig.curveA) * level ** 3 + Number(voiceConfig.curveB) * level ** 2 + Number(voiceConfig.curveC) * level) * Number(voiceConfig.difficulty);
  return Math.round(raw / Math.max(1, Number(voiceConfig.rounding))) * Math.max(1, Number(voiceConfig.rounding));
};
const voiceCurveMax = Math.max(voiceCurveTotal(50), 1);
const voiceCurveX = (level: number) => 44 + (level / 50) * 556;
const voiceCurveY = (value: number) => 240 - (value / voiceCurveMax) * 216;
const voiceCurvePath = Array.from({ length: 51 }, (_, level) => `${level ? 'L' : 'M'}${voiceCurveX(level).toFixed(1)} ${voiceCurveY(voiceCurveTotal(level)).toFixed(1)}`).join(' ');
const voiceMinutesForLevel = (level: number) => Math.max(0, Math.ceil(voiceCurveTotal(level) / Math.max(1, Number(voiceConfig.xpPerMinute))));
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'settings' ? 'leveling' : `leveling-${selectedSection}`} pageTitle={selectedTitle}>
  <h1>{selectedTitle}</h1>
  <p class="lv-sub"><Fragment set:html={dth('XP, rank, and level-up rewards in <b>{a}</b>.', { a: (guildName) })} /></p>

  {saved && <div class="lv-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {saveError && <div class="lv-flash lv-flash-error"><Icon name="ph:x-circle-fill" width="15" height="15" />{dt('Could not save these changes. Check the API response and try again.')}</div>}

  <form method="POST" class:list={['lv-form', { 'lv-section-hidden': selectedSection !== 'settings' }]}>
    <input type="hidden" name="action" value="config" />
    <div class="lv-card">
      <div class="lv-card-head">
        <div class="lv-card-icon" style="--c:#a5ea7a"><Icon name="ph:chart-line-up-fill" width="16" height="16" /></div>
        <div class="lv-card-title">{dt('Leveling enabled')}</div>
        <label class="lv-switch"><input type="checkbox" name="enabled" checked={config.enabled} /><span></span></label>
      </div>
      <p class="lv-card-desc">{dt('Members earn XP from chatting and voice, and level up.')}</p>
    </div>

    <div class="lv-section-label">
      <Icon name="ph:sliders-horizontal-fill" width="14" height="14" />
      {dt('Configuration')}
    </div>
    <div class="lv-grid">
      <div class="lv-field">
        <label>{dt('XP per message (min-max)')}</label>
        <div class="lv-pair"><input type="number" name="xp_min" value={config.xpMin} min="1" max="1000" /><span>to</span><input type="number" name="xp_max" value={config.xpMax} min="1" max="1000" /></div>
      </div>
      <div class="lv-field">
        <label>{dt('Message cooldown (seconds)')}</label>
        <input type="number" name="cooldown_seconds" value={config.cooldownSeconds} min="0" max="600" />
      </div>
      <div class="lv-field">
        <label>{dt('XP per voice minute')}</label>
        <input type="number" name="xp_per_vc_minute" value={config.xpPerVcMinute} min="0" max="1000" />
      </div>
      <div class="lv-field">
        <label>{dt('Reward roles on level up')}</label>
        <select name="role_mode">
          <option value="highest" selected={config.roleMode === 'highest'}>{dt('Only the highest earned')}</option>
          <option value="all" selected={config.roleMode === 'all'}>{dt('Stack every earned role')}</option>
        </select>
      </div>
      <div class="lv-field">
        <label>{dt('Level-up announcement')}</label>
        <select name="notify_mode">
          <option value="off" selected={config.notifyMode === 'off'}>{dt('Off')}</option>
          <option value="reply" selected={config.notifyMode === 'reply'}>{dt('Reply in the same channel')}</option>
          <option value="channel" selected={config.notifyMode === 'channel'}>{dt('Fixed channel')}</option>
          <option value="dm" selected={config.notifyMode === 'dm'}>{dt('Direct message')}</option>
        </select>
      </div>
      <div class="lv-field">
        <label>{dt('Announcement channel')}</label>
        <select name="notify_channel_id">
          <option value="">{dt('None')}</option>
          {channels.map((c) => <option value={c.id} selected={c.id === config.notifyChannelId}>#{c.name}</option>)}
        </select>
      </div>
      <div class="lv-field lv-field-wide">
        <label>{dt('Announcement message')}</label>
        <input type="text" name="notify_message" value={config.notifyMessage} maxlength="200" data-dp data-dp-template="notify_embed_template" data-dp-embed="notify_embed" data-dp-title={dt('Level up!')} placeholder="{EMOJI} {user} just leveled up to **{level}**!" />
        <p class="lv-hint"><Fragment set:html={dth('<code>{a}</code> adds the level-up icon. Use the variables below to personalize it.', { a: ('{EMOJI}') })} /></p>
        <VariableHelp />
      </div>
      <div class="lv-notify-layout lv-field-wide">
        <div class="lv-notify-template">
          <div class="lv-field">
            <label>{dt('Saved embed template')}</label>
            <select name="notify_embed_template">
              <option value="" selected={!config.notifyEmbedTemplate}>{dt('Use the message above')}</option>
              {embedTemplateNames.map((name) => <option value={name} selected={name === config.notifyEmbedTemplate}>{name}</option>)}
            </select>
            <p class="lv-hint">{dt('Create and edit templates from')} <a href={`/dash/guild/${guildId}/embeds`}>{dt('Embeds')}</a>{dt('. The template can use the same leveling variables.')}</p>
          </div>
          <label class="lv-inline-check"><input type="checkbox" name="notify_embed" checked={config.notifyEmbed} />{dt('Use a simple embed when no template is selected')}</label>
        </div>
      </div>
      <div class="lv-field">
        <label>{dt('Announce every N levels')}</label>
        <input type="number" name="notify_every" value={config.notifyEvery} min="1" max="50" />
      </div>
      <div class="lv-field">
        <label>{dt('XP on join')}</label>
        <input type="number" name="join_xp" value={config.joinXp} min="0" />
      </div>
      <div class="lv-field">
        <label>{dt('Level on join')}</label>
        <input type="number" name="join_level" value={config.joinLevel} min="0" max="1000" />
      </div>
      <div class="lv-field lv-field-wide">
        <label>{dt('Ignored channels')}</label>
        <MultiSelect name="ignored_channel_ids" options={channels.map((ch) => ({ id: ch.id, name: `#${ch.name}` }))} selected={config.ignoredChannelIds} placeholder={dt('Search channels...')} />
        <p class="lv-hint">{dt('No XP is granted for messages in these channels.')}</p>
      </div>
    </div>

    <div class="lv-advanced lv-curve-editor" data-curve-editor>
      <div class="lv-curve-head">
        <div>
          <div class="lv-curve-title"><Icon name="ph:chart-line-up" width="16" height="16" />{dt('XP curve')}</div>
          <p class="lv-hint">{dt('Shape the progression and see the result before saving. Existing XP is interpreted with the new curve.')}</p>
        </div>
      <div class="lv-curve-stats"><span>{dt('Lv.10')} <b data-curve-stat="10">{dt('{a} XP', { a: (formatCurve(curveTotal(10))) })}</b></span><span>{dt('Lv.25')} <b data-curve-stat="25">{dt('{a} XP', { a: (formatCurve(curveTotal(25))) })}</b></span><span>{dt('Lv.50')} <b data-curve-stat="50">{dt('{a} XP', { a: (formatCurve(curveTotal(50))) })}</b></span></div>
      </div>
      <div class="lv-curve-layout">
        <div class="lv-curve-controls">
          <div class="lv-formula" aria-label={dt('XP formula')}>
            <span>{dt('XP(L) =')}</span>
            <label><input type="number" name="curve_a" value={config.curveA} step="0.1" min="0" aria-label={dt('Curve A')} /> L<sup>3</sup></label>
            <span>+</span>
            <label><input type="number" name="curve_b" value={config.curveB} step="0.1" min="0" aria-label={dt('Curve B')} /> L<sup>2</sup></label>
            <span>+</span>
            <label><input type="number" name="curve_c" value={config.curveC} step="0.1" min="0" aria-label={dt('Curve C')} /> L</label>
          </div>
          <div class="lv-preset-row">
            <div class="lv-field">
              <label>{dt('Curve preset')}</label>
              <select data-curve-preset>
                <option value="custom">{dt('Custom')}</option>
                <option value="balanced">{dt('Balanced')}</option>
                <option value="quick">{dt('Quick start')}</option>
                <option value="long">{dt('Long progression')}</option>
              </select>
            </div>
            <p class="lv-preset-description" data-curve-preset-description>{dt('Adjust the values above to create your own curve.')}</p>
          </div>
          <div class="lv-curve-options">
            <div class="lv-field"><label>{dt('Difficulty')}</label><input type="number" name="difficulty" value={config.difficulty} step="0.1" min="0.1" /></div>
            <div class="lv-field"><label>{dt('Round to nearest')}</label><input type="number" name="rounding" value={config.rounding} min="1" /></div>
            <div class="lv-field"><label>{dt('Max level')}</label><input type="number" name="max_level" value={config.maxLevel} min="1" max="10000" /></div>
          </div>
          <p class="lv-hint lv-advanced-warn">{dt('A higher difficulty or steeper curve means members need more XP for each level. Rounding keeps totals readable.')}</p>
        </div>
        <div class="lv-curve-chart" aria-label={dt('Live XP curve preview')}>
          <svg viewBox="0 0 620 270" role="img" aria-labelledby="curve-title curve-desc" preserveAspectRatio="none">
            <title id="curve-title">{dt('XP required by level')}</title>
            <desc id="curve-desc">{dt('Live preview of the XP curve from level zero to fifty.')}</desc>
            <g class="lv-chart-grid">
              <line x1="44" y1="24" x2="600" y2="24" /><line x1="44" y1="78" x2="600" y2="78" /><line x1="44" y1="132" x2="600" y2="132" /><line x1="44" y1="186" x2="600" y2="186" /><line x1="44" y1="240" x2="600" y2="240" />
              <line x1="44" y1="24" x2="44" y2="240" /><line x1="155" y1="24" x2="155" y2="240" /><line x1="266" y1="24" x2="266" y2="240" /><line x1="377" y1="24" x2="377" y2="240" /><line x1="488" y1="24" x2="488" y2="240" /><line x1="600" y1="24" x2="600" y2="240" />
            </g>
            <path class="lv-chart-area" data-curve-area d={`${curvePath} L600 240 L44 240 Z`} />
            <path class="lv-chart-line" data-curve-line d={curvePath} />
            <text x="44" y="260">0</text><text x="266" y="260">20</text><text x="488" y="260">40</text><text x="586" y="260">50</text>
            <text x="10" y="30" data-curve-axis="max">{formatCurve(curveMax)}</text><text x="10" y="244">0</text>
          </svg>
        </div>
      </div>
      <div class="lv-curve-table-wrap">
        <table class="lv-curve-table">
          <thead><tr><th>{dt('Level')}</th><th>{dt('Total XP')}</th><th>{dt('Total messages')}</th><th>{dt('Total cooldown')}</th></tr></thead>
          <tbody>
            {curvePreviewLevels.map((level) => <tr data-curve-row={level}><td>{level}</td><td data-curve-total>{dt('{a} XP', { a: (formatCurve(curveTotal(level))) })}</td><td data-curve-messages>~{formatCurve(curveMessages(level))}</td><td data-curve-cooldown>{formatCooldown(curveCooldown(level))}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
    <button type="submit" class="btn btn-accent btn-sm">{dt('Save changes')}</button>
  </form>

  <form method="POST" class:list={['lv-form', 'lv-voice-form', { 'lv-section-hidden': selectedSection !== 'voice' }]}>
    <input type="hidden" name="action" value="voice_config" />
    <div class="lv-card lv-voice-card">
      <div class="lv-card-head">
        <div class="lv-card-icon" style="--c:#8fb3ff"><Icon name="ph:headphones-fill" width="16" height="16" /></div>
        <div class="lv-card-title">{dt('Voice leveling enabled')}</div>
        <label class="lv-switch"><input type="checkbox" name="voice_enabled" checked={voiceConfig.enabled} /><span></span></label>
      </div>
      <p class="lv-card-desc">{dt('Track time spent in voice separately from messages. Voice XP has its own level, rank, leaderboard, curve, and announcements.')}</p>
    </div>

    <div class="lv-section-label"><Icon name="ph:sliders-horizontal-fill" width="14" height="14" />{dt('Voice configuration')}</div>
    <div class="lv-grid">
      <div class="lv-field">
        <label>{dt('XP per voice minute')}</label>
        <input type="number" name="voice_xp_per_minute" value={voiceConfig.xpPerMinute} min="0" max="1000" />
      </div>
      <div class="lv-field">
        <label>{dt('Reward roles')}</label>
        <select name="voice_role_mode">
          <option value="highest" selected={voiceConfig.roleMode === 'highest'}>{dt('Only the highest earned')}</option>
          <option value="all" selected={voiceConfig.roleMode === 'all'}>{dt('Stack every earned role')}</option>
        </select>
      </div>
      <div class="lv-field">
        <label>{dt('Voice level-up announcement')}</label>
        <select name="voice_notify_mode">
          <option value="off" selected={voiceConfig.notifyMode === 'off'}>{dt('Off')}</option>
          <option value="channel" selected={voiceConfig.notifyMode === 'channel'}>{dt('Fixed channel')}</option>
          <option value="dm" selected={voiceConfig.notifyMode === 'dm'}>{dt('Direct message')}</option>
        </select>
      </div>
      <div class="lv-field">
        <label>{dt('Announcement channel')}</label>
        <select name="voice_notify_channel_id">
          <option value="">{dt('None')}</option>
          {channels.map((c) => <option value={c.id} selected={c.id === voiceConfig.notifyChannelId}>#{c.name}</option>)}
        </select>
      </div>
      <div class="lv-field lv-field-wide">
        <label>{dt('Voice announcement message')}</label>
        <input type="text" name="voice_notify_message" value={voiceConfig.notifyMessage} maxlength="200" data-dp />
        <p class="lv-hint"><Fragment set:html={dth('<code>{a}</code>, <code>{b}</code>, <code>{c}</code> and saved embed variables are available.', { a: ('{user}'), b: ('{level}'), c: ('{level_xp}') })} /></p>
      </div>
      <div class="lv-field">
        <label>{dt('Saved embed template')}</label>
        <select name="voice_notify_embed_template">
          <option value="" selected={!voiceConfig.notifyEmbedTemplate}>{dt('Use the message above')}</option>
          {embedTemplateNames.map((name) => <option value={name} selected={name === voiceConfig.notifyEmbedTemplate}>{name}</option>)}
        </select>
      </div>
      <div class="lv-field">
        <label>{dt('Announce every N levels')}</label>
        <input type="number" name="voice_notify_every" value={voiceConfig.notifyEvery} min="1" max="50" />
      </div>
      <label class="lv-inline-check"><input type="checkbox" name="voice_notify_embed" checked={voiceConfig.notifyEmbed} />{dt('Use a simple embed when no template is selected')}</label>
      <div class="lv-field lv-field-wide">
        <label>{dt('Ignored voice channels')}</label>
        <MultiSelect name="voice_ignored_channel_ids" options={voiceChannels.map((channel) => ({ id: channel.id, name: `Voice · ${channel.name}` }))} selected={voiceConfig.ignoredChannelIds} placeholder={dt('Search voice channels...')} />
        <p class="lv-hint">{dt('Members in these voice channels do not gain voice XP.')}</p>
      </div>
    </div>

    <div class="lv-advanced lv-curve-editor" data-voice-curve-editor>
      <div class="lv-curve-head">
        <div>
          <div class="lv-curve-title"><Icon name="ph:chart-line-up" width="16" height="16" />{dt('Voice XP curve')}</div>
          <p class="lv-hint">{dt('A separate curve controls voice levels. Change it and the preview updates immediately.')}</p>
        </div>
        <div class="lv-curve-stats"><span>{dt('Lv.10')} <b data-voice-curve-stat="10">{dt('{a} XP', { a: (formatCurve(voiceCurveTotal(10))) })}</b></span><span>{dt('Lv.25')} <b data-voice-curve-stat="25">{dt('{a} XP', { a: (formatCurve(voiceCurveTotal(25))) })}</b></span><span>{dt('Lv.50')} <b data-voice-curve-stat="50">{dt('{a} XP', { a: (formatCurve(voiceCurveTotal(50))) })}</b></span></div>
      </div>
      <div class="lv-curve-layout">
        <div class="lv-curve-controls">
          <div class="lv-formula" aria-label={dt('Voice XP formula')}>
            <span>{dt('XP(L) =')}</span>
            <label><input type="number" name="voice_curve_a" value={voiceConfig.curveA} step="0.1" min="0" aria-label={dt('Voice curve A')} /> L<sup>3</sup></label>
            <span>+</span>
            <label><input type="number" name="voice_curve_b" value={voiceConfig.curveB} step="0.1" min="0" aria-label={dt('Voice curve B')} /> L<sup>2</sup></label>
            <span>+</span>
            <label><input type="number" name="voice_curve_c" value={voiceConfig.curveC} step="0.1" min="0" aria-label={dt('Voice curve C')} /> L</label>
          </div>
          <div class="lv-curve-options">
            <div class="lv-field"><label>{dt('Difficulty')}</label><input type="number" name="voice_difficulty" value={voiceConfig.difficulty} step="0.1" min="0.1" /></div>
            <div class="lv-field"><label>{dt('Round to nearest')}</label><input type="number" name="voice_rounding" value={voiceConfig.rounding} min="1" /></div>
            <div class="lv-field"><label>{dt('Max level')}</label><input type="number" name="voice_max_level" value={voiceConfig.maxLevel} min="1" max="10000" /></div>
          </div>
        </div>
        <div class="lv-curve-chart" aria-label={dt('Live voice XP curve preview')}>
          <svg viewBox="0 0 620 270" role="img" aria-label={dt('Voice XP required by level')} preserveAspectRatio="none">
            <g class="lv-chart-grid"><line x1="44" y1="24" x2="600" y2="24" /><line x1="44" y1="78" x2="600" y2="78" /><line x1="44" y1="132" x2="600" y2="132" /><line x1="44" y1="186" x2="600" y2="186" /><line x1="44" y1="240" x2="600" y2="240" /><line x1="44" y1="24" x2="44" y2="240" /><line x1="155" y1="24" x2="155" y2="240" /><line x1="266" y1="24" x2="266" y2="240" /><line x1="377" y1="24" x2="377" y2="240" /><line x1="488" y1="24" x2="488" y2="240" /><line x1="600" y1="24" x2="600" y2="240" /></g>
            <path class="lv-chart-area" data-voice-curve-area d={`${voiceCurvePath} L600 240 L44 240 Z`} />
            <path class="lv-chart-line" data-voice-curve-line d={voiceCurvePath} />
            <text x="44" y="260">0</text><text x="266" y="260">20</text><text x="488" y="260">40</text><text x="586" y="260">50</text>
            <text x="10" y="30" data-voice-curve-axis="max">{formatCurve(voiceCurveMax)}</text><text x="10" y="244">0</text>
          </svg>
        </div>
      </div>
      <div class="lv-curve-table-wrap">
        <table class="lv-curve-table"><thead><tr><th>{dt('Level')}</th><th>{dt('Total XP')}</th><th>{dt('Voice minutes')}</th><th>{dt('Approx. time')}</th></tr></thead><tbody>
          {curvePreviewLevels.map((level) => <tr data-voice-curve-row={level}><td>{level}</td><td data-voice-curve-total>{dt('{a} XP', { a: (formatCurve(voiceCurveTotal(level))) })}</td><td data-voice-curve-minutes>~{formatCurve(voiceMinutesForLevel(level))}</td><td data-voice-curve-time>{voiceMinutesForLevel(level) >= 60 ? `~${(voiceMinutesForLevel(level) / 60).toFixed(1)}h` : `~${formatCurve(voiceMinutesForLevel(level))}m`}</td></tr>)}
        </tbody></table>
      </div>
    </div>
    <button type="submit" class="btn btn-accent btn-sm">{dt('Save voice leveling')}</button>
  </form>

  <div class:list={['lv-section', { 'lv-section-hidden': selectedSection !== 'rewards' }]}>
    <h2><Icon name="ph:trophy-fill" width="15" height="15" />{dt('Level rewards')}</h2>
    <div class="lv-rewards">
      {rewards.map((r) => (
        <form method="POST" class="lv-reward-row">
          <input type="hidden" name="action" value="delete_reward" />
          <input type="hidden" name="level" value={r.level} />
          <span class="lv-reward-level">{dt('Level {a}', { a: (r.level) })}</span>
          <span class="lv-reward-arrow"><Icon name="ph:arrow-right" width="12" height="12" /></span>
          <span class="lv-reward-role">{roles.find((role) => role.id === r.roleId)?.name ?? r.roleId}</span>
          <button type="submit" class="lv-reward-del" title={dt('Remove')}><Icon name="ph:trash-fill" width="13" height="13" /></button>
        </form>
      ))}
    </div>
    <form method="POST" class="lv-add-reward">
      <input type="hidden" name="action" value="add_reward" />
      <input type="number" name="level" placeholder={dt('Level')} min="1" max="1000" required />
      <select name="role_id" required>
        <option value="" disabled selected>{dt('Choose a role')}</option>
        {roles.map((r) => <option value={r.id}>{r.name}</option>)}
      </select>
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add reward')}</button>
    </form>
  </div>

  <div class:list={['lv-section', { 'lv-section-hidden': !['leaderboard', 'leaderboard-voice'].includes(selectedSection) }]}>
    <div class="lv-board-heading">
      <div>
        <h2><Icon name="ph:ranking-fill" width="15" height="15" />{leaderboardIsVoice ? dt('Voice leaderboard') : dt('Leaderboard')}</h2>
        <p>{leaderboardIsVoice ? dt('Members ranked by voice XP and time spent in voice channels.') : dt('Members ranked by message XP and progress through the current leveling curve.')}</p>
      </div>
      <span class="lv-board-count">{dt('Top {a}', { a: (displayLeaderboard.length) })}</span>
    </div>
    {displayLeaderboard.length === 0 ? (
      <p class="lv-empty-note">{leaderboardIsVoice ? dt('Nobody has earned voice XP yet.') : dt("Nobody's earned XP yet.")}</p>
    ) : (
      <div class="lv-board" role="table" aria-label={dt('Leveling leaderboard')}>
        <div class="lv-board-head" role="row">
          <span>{dt('Rank')}</span><span>{dt('Member')}</span><span>{dt('Level')}</span><span>{leaderboardIsVoice ? 'Voice XP' : 'Total XP'}</span>
        </div>
        {displayLeaderboard.map((row) => (
          <div class:list={['lv-board-row', { 'lv-board-first': row.rank === 1, 'lv-board-second': row.rank === 2, 'lv-board-third': row.rank === 3 }]} role="row">
            <span class="lv-board-rank">{String(row.rank).padStart(2, '0')}</span>
            <div class="lv-board-member">
              <img src={row.avatarUrl} alt="" loading="lazy" />
              <div>
                <strong>{row.displayName}</strong>
                <small>{row.username ? `@${row.username}` : `ID ${row.userId}`}</small>
                <span class="lv-board-progress"><i style={`width:${leaderboardProgress(row, leaderboardIsVoice).toFixed(1)}%`}></i></span>
              </div>
            </div>
            <span class="lv-board-level">{dt('Lv. {a}', { a: (row.level) })}</span>
            <span class="lv-board-xp">{row.xp.toLocaleString()} <small>{leaderboardIsVoice ? 'voice XP' : 'XP'}</small>{leaderboardIsVoice && row.voiceMinutes != null && <small class="lv-board-minutes">{row.voiceMinutes.toLocaleString()} min</small>}</span>
          </div>
        ))}
      </div>
    )}
  </div>
</DashGuildLayout>

<script>
  // @ts-nocheck
  window.PettoLevelingInit = (root = document) => {
    const form = root.querySelector('form.lv-form');
    if (form?.dataset.lvInitialized) return;
    if (form) form.dataset.lvInitialized = '1';
  if (form) {
    const control = (name) => form.elements.namedItem(name);
    const number = (name, fallback) => {
      const value = Number.parseFloat(control(name)?.value);
      return Number.isFinite(value) ? value : fallback;
    };
    const format = (value) => Math.max(0, Math.round(value)).toLocaleString('en-US');
    const totalXp = (level) => {
      if (level <= 0) return 0;
      const raw = (number('curve_a', 1) * level ** 3 + number('curve_b', 50) * level ** 2 + number('curve_c', 100) * level) * number('difficulty', 2.5);
      const rounding = number('rounding', 50);
      return rounding <= 0 ? Math.round(raw) : Math.round(raw / rounding) * rounding;
    };
    const updateCurve = () => {
      const points = Array.from({ length: 51 }, (_, level) => totalXp(level));
      const max = Math.max(points[50], 1);
      const x = (level) => 44 + (level / 50) * 556;
      const y = (value) => 240 - (value / max) * 216;
      const line = points.map((value, level) => `${level ? 'L' : 'M'}${x(level).toFixed(1)} ${y(value).toFixed(1)}`).join(' ');
      const lineNode = form.querySelector('[data-curve-line]');
      const areaNode = form.querySelector('[data-curve-area]');
      lineNode?.setAttribute('d', line);
      areaNode?.setAttribute('d', `${line} L600 240 L44 240 Z`);
      form.querySelector('[data-curve-axis="max"]')?.replaceChildren(document.createTextNode(format(max)));
      [10, 25, 50].forEach((level) => form.querySelector(`[data-curve-stat="${level}"]`)?.replaceChildren(document.createTextNode(`${format(totalXp(level))} XP`)));
      form.querySelectorAll('[data-curve-row]').forEach((row) => {
        const level = Number(row.dataset.curveRow);
        const current = totalXp(level);
        const messages = Math.max(0, Math.ceil(current / Math.max(number('xp_max', 25), 1)));
        const cooldown = Math.max(0, Math.round(messages * number('cooldown_seconds', 60)));
        row.querySelector('[data-curve-total]').textContent = `${format(current)} XP`;
        row.querySelector('[data-curve-messages]').textContent = `~${format(messages)}`;
        row.querySelector('[data-curve-cooldown]').textContent = cooldown >= 3600 ? `~${(cooldown / 3600).toFixed(1)}h` : `~${format(cooldown)}s`;
      });
    };
    const curvePresets = {
      balanced: { a: 1, b: 50, c: 100, difficulty: 2.5, rounding: 50, description: cdt('A steady curve for general-purpose communities.') },
      quick: { a: 0.4, b: 28, c: 80, difficulty: 1.8, rounding: 25, description: cdt('Early levels feel fast while high levels still matter.') },
      long: { a: 1.6, b: 70, c: 120, difficulty: 3.2, rounding: 100, description: cdt('A slower progression for long-running servers.') },
    };
    const updatePresetDescription = () => {
      const preset = form.querySelector('[data-curve-preset]')?.value;
      const description = form.querySelector('[data-curve-preset-description]');
      description.textContent = curvePresets[preset]?.description || 'Adjust the values above to create your own curve.';
    };
    form.querySelector('[data-curve-preset]')?.addEventListener('change', (event) => {
      const preset = curvePresets[event.target.value];
      if (preset) {
        control('curve_a').value = preset.a;
        control('curve_b').value = preset.b;
        control('curve_c').value = preset.c;
        control('difficulty').value = preset.difficulty;
        control('rounding').value = preset.rounding;
      }
      updatePresetDescription();
      updateCurve();
    });
    form.addEventListener('input', () => { updateCurve(); });
    updateCurve();
    updatePresetDescription();
  }
  };
  window.PettoLevelingInit(document);
  window.PettoVoiceLevelingInit = (root = document) => {
    const form = root.querySelector('form.lv-voice-form');
    if (!form || form.dataset.voiceLvInitialized) return;
    form.dataset.voiceLvInitialized = '1';
    const control = (name) => form.elements.namedItem(name);
    const number = (name, fallback) => {
      const value = Number.parseFloat(control(name)?.value);
      return Number.isFinite(value) ? value : fallback;
    };
    const format = (value) => Math.max(0, Math.round(value)).toLocaleString('en-US');
    const totalXp = (level) => {
      if (level <= 0) return 0;
      const rounding = Math.max(1, number('voice_rounding', 50));
      const raw = (number('voice_curve_a', 1) * level ** 3 + number('voice_curve_b', 50) * level ** 2 + number('voice_curve_c', 100) * level) * number('voice_difficulty', 2.5);
      return Math.round(raw / rounding) * rounding;
    };
    const updateCurve = () => {
      const points = Array.from({ length: 51 }, (_, level) => totalXp(level));
      const max = Math.max(points[50], 1);
      const x = (level) => 44 + (level / 50) * 556;
      const y = (value) => 240 - (value / max) * 216;
      const line = points.map((value, level) => `${level ? 'L' : 'M'}${x(level).toFixed(1)} ${y(value).toFixed(1)}`).join(' ');
      form.querySelector('[data-voice-curve-line]')?.setAttribute('d', line);
      form.querySelector('[data-voice-curve-area]')?.setAttribute('d', `${line} L600 240 L44 240 Z`);
      form.querySelector('[data-voice-curve-axis="max"]')?.replaceChildren(document.createTextNode(format(max)));
      [10, 25, 50].forEach((level) => form.querySelector(`[data-voice-curve-stat="${level}"]`)?.replaceChildren(document.createTextNode(`${format(totalXp(level))} XP`)));
      form.querySelectorAll('[data-voice-curve-row]').forEach((row) => {
        const level = Number(row.dataset.voiceCurveRow);
        const current = totalXp(level);
        const minutes = Math.max(0, Math.ceil(current / Math.max(number('voice_xp_per_minute', 5), 1)));
        row.querySelector('[data-voice-curve-total]').textContent = `${format(current)} XP`;
        row.querySelector('[data-voice-curve-minutes]').textContent = `~${format(minutes)}`;
        row.querySelector('[data-voice-curve-time]').textContent = minutes >= 60 ? `~${(minutes / 60).toFixed(1)}h` : `~${format(minutes)}m`;
      });
    };
    form.addEventListener('input', updateCurve);
    updateCurve();
  };
  window.PettoVoiceLevelingInit(document);
</script>

<style>
