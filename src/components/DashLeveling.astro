  .lv-preset-description { margin: 0 0 8px; color: var(--text-dim); font-size: 11.5px; line-height: 1.45; }
  .lv-curve-chart { min-width: 0; min-height: 250px; border: 1px solid var(--border); border-radius: 11px; background: var(--bg-raise); padding: 8px 10px 2px 0; }
  .lv-curve-chart svg { display: block; width: 100%; height: 250px; overflow: visible; }
  .lv-chart-grid line { stroke: var(--border-soft); stroke-width: 1; }
  .lv-chart-area { fill: color-mix(in srgb, var(--accent) 18%, transparent); }
  .lv-chart-line { fill: none; stroke: var(--accent); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 3px 5px color-mix(in srgb, var(--accent) 25%, transparent)); }
  .lv-curve-chart text { fill: var(--text-dim); font: 10px var(--mono); }
  .lv-curve-table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 10px; }
  .lv-curve-table { width: 100%; min-width: 520px; border-collapse: collapse; font-size: 12px; }
  .lv-curve-table th { padding: 9px 11px; text-align: left; color: var(--text-dim); background: color-mix(in srgb, var(--bg-raise) 65%, transparent); font: 10px var(--mono); letter-spacing: .04em; text-transform: uppercase; }
  .lv-curve-table td { padding: 9px 11px; color: var(--text-muted); border-top: 1px solid var(--border-soft); }
  .lv-curve-table td:first-child, .lv-curve-table td:nth-child(2) { color: var(--text); font-weight: 600; }
  .lv-curve-table tr:hover td { background: color-mix(in srgb, var(--accent) 5%, transparent); }

  .lv-section { margin-bottom: 40px; }
  .lv-empty-note { display: flex; align-items: center; gap: 8px; max-width: 460px; box-sizing: border-box; margin: 0 0 12px; padding: 12px 14px; border: 1px dashed var(--border); border-radius: 12px; font-size: 13px; color: var(--text-dim); }
  .lv-empty-note[hidden] { display: none; }
  .lv-empty-note :global(svg) { flex-shrink: 0; color: var(--accent); }

  /* The lists that are edited on the page (events, rewards, multipliers): a card for each row. The rows are drawn by the script, so their styles use :global. */
  .lv-rewards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 10px; margin-bottom: 14px; max-width: 980px; width: 100%; box-sizing: border-box; }
  .lv-rewards:empty { display: none; }
  .lv-rewards.lv-events { grid-template-columns: minmax(0, 1fr); }
  .lv-rewards :global(.lv-reward-row) { position: relative; display: flex; align-items: center; gap: 10px; border: 1px solid var(--border); border-radius: 14px; padding: 11px 10px 11px 16px; background: var(--card); min-width: 0; transition: border-color .3s ease, background-color .3s ease, opacity .3s ease; }
  .lv-rewards :global(.lv-reward-row)::before { content: ''; position: absolute; left: 0; top: 12px; bottom: 12px; width: 3px; border-radius: 0 3px 3px 0; background: var(--accent); opacity: .7; }
  .lv-rewards :global(.lv-reward-row[data-state="running"])::before { background: var(--green); opacity: 1; }
  .lv-rewards :global(.lv-reward-row:hover) { border-color: color-mix(in srgb, var(--accent) 28%, var(--border)); background: var(--card-hover); }
  .lv-rewards :global(.lv-reward-new) { animation: m-rise-in var(--m-slow) var(--m-out) backwards; }
  .lv-rewards :global(.lv-reward-level) { font-size: 13.5px; font-weight: 600; color: var(--text); overflow-wrap: anywhere; }
  .lv-rewards :global(.lv-reward-arrow) { color: var(--text-dim); flex: none; }
  .lv-rewards :global(.lv-reward-role) { flex: 1; min-width: 0; font-size: 13px; color: var(--text-muted); overflow-wrap: anywhere; }
  .lv-rewards.lv-events :global(.lv-reward-row) { flex-wrap: wrap; }
  .lv-rewards.lv-events :global(.lv-reward-role) { flex: 1 1 220px; }
  .lv-rewards :global(.lv-reward-del) { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; flex-shrink: 0; margin-left: auto; border: none; background: transparent; color: var(--text-dim); font-size: 17px; line-height: 1; cursor: pointer; padding: 0; border-radius: 9px; transition: color var(--m-fast) ease, background var(--m-fast) ease, transform var(--m-fast) var(--m-out); }
  .lv-rewards :global(.lv-reward-del:hover) { color: var(--red); background: var(--red-soft); }
  .lv-rewards :global(.lv-reward-del:active) { transform: scale(var(--m-press)); }
  /* The rows of rewards and multipliers come in one after the other the first time they are drawn; adding or removing one later does not replay it (the script marks the list). */
  .lv-rewards:not(.lv-events):not([data-drawn]) :global(.lv-reward-row) { animation: m-rise-in var(--m-slow) var(--m-out) backwards; }
  .lv-rewards:not(.lv-events):not([data-drawn]) :global(.lv-reward-row:nth-child(2)) { animation-delay: var(--m-stagger); }
  .lv-rewards:not(.lv-events):not([data-drawn]) :global(.lv-reward-row:nth-child(3)) { animation-delay: calc(var(--m-stagger) * 2); }
  .lv-rewards:not(.lv-events):not([data-drawn]) :global(.lv-reward-row:nth-child(4)) { animation-delay: calc(var(--m-stagger) * 3); }
  .lv-rewards:not(.lv-events):not([data-drawn]) :global(.lv-reward-row:nth-child(n+5)) { animation-delay: calc(var(--m-stagger) * 4); }
  [data-stage-form="multipliers"] .lv-rewards :global(.lv-reward-level), [data-stage-form="rewards"] .lv-rewards :global(.lv-reward-level) { flex: none; border-radius: 999px; padding: 3px 11px; font-size: 12.5px; color: var(--accent); background: var(--accent-soft); font-variant-numeric: tabular-nums; }
  .lv-events :global(.lv-reward-row[data-existing-event]) { animation: m-rise-in var(--m-slow) var(--m-out) backwards; }
  .lv-events :global(.lv-reward-row[data-existing-event]:nth-child(3)) { animation-delay: var(--m-stagger); }
  .lv-events :global(.lv-reward-row[data-existing-event]:nth-child(4)) { animation-delay: calc(var(--m-stagger) * 2); }
  .lv-events :global(.lv-reward-row[data-existing-event]:nth-child(n+5)) { animation-delay: calc(var(--m-stagger) * 3); }
  @media (prefers-reduced-motion: reduce) { .lv-rewards :global(.lv-reward-new), .lv-rewards:not(.lv-events):not([data-drawn]) :global(.lv-reward-row), .lv-events :global(.lv-reward-row[data-existing-event]) { animation: none; } }

  .lv-save-bar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
  .lv-add-reward .btn { display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0; }

  .lv-board-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 14px; max-width: 780px; }
  .lv-board-heading h2 { margin-bottom: 5px; }
  .lv-board-heading p { margin: 0; color: var(--text-dim); font-size: 12px; line-height: 1.5; }
  .lv-board-count { flex: 0 0 auto; border: 1px solid var(--border); border-radius: 999px; padding: 6px 10px; color: var(--text-muted); font: 10px var(--mono); text-transform: uppercase; letter-spacing: .04em; }
  .lv-board { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 13px; overflow: hidden; max-width: 780px; background: var(--card); }
  .lv-board-head, .lv-board-row { display: grid; grid-template-columns: 64px minmax(0, 1fr) 100px 110px; align-items: center; gap: 14px; padding: 0 18px; }
  .lv-board-head { min-height: 36px; background: color-mix(in srgb, var(--bg-raise) 70%, transparent); color: var(--text-dim); font: 10px var(--mono); letter-spacing: .05em; text-transform: uppercase; }
  .lv-board-head span:nth-child(3), .lv-board-head span:nth-child(4) { text-align: right; }
