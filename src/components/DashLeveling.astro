        }
        form.querySelectorAll('input[type="number"]').forEach((input) => {
          if (input.disabled || input.value === '' || input.validity.valid || input.validity.customError) return;
          const min = input.min !== '' ? Number(input.min) : null;
          const max = input.max !== '' ? Number(input.max) : null;
          const key = min !== null && max !== null ? 'err_range' : min !== null ? 'err_min' : 'err_max';
          note(input.name, format(labels[key] ?? '', { a: min !== null ? min : max, b: max }), true, true);
        });
        new Set([...errors.keys(), ...shown.keys()]).forEach((name) => {
          const target = errFor(name);
          if (!target) return;
          const entry = shown.get(name);
          const { line, control } = target;
          line.hidden = !entry;
          line.textContent = entry ? entry.text : '';
