  let lvSeq = 0;
  const lvNamed = (form, name) => Array.from(form.querySelectorAll('[name]')).filter((el) => el.name === name);
  const lvControls = (el) => Array.from(el.querySelectorAll('input, select, textarea')).filter((c) => c.type !== 'hidden' && c.type !== 'submit' && c.type !== 'button' && !c.closest('[data-multiselect]') && !c.hasAttribute('data-lv-keep'));
  const lvWidgets = (el) => Array.from(el.querySelectorAll('[data-multiselect]'));
  const lvLabelsOf = () => { try { return JSON.parse(document.getElementById('lvDepLabels')?.textContent ?? '{}'); } catch { return {}; } };
  const lvCtx = (form, initial) => {
    let flags = {};
    try { flags = JSON.parse(form.dataset.lvFlags ?? '{}'); } catch { flags = {}; }
    const read = (name) => {
      const els = lvNamed(form, name);
      if (!els.length) return '';
      const first = els[0];
      const isOn = (el) => (initial ? (el.type === 'checkbox' || el.type === 'radio' ? el.defaultChecked : false) : el.checked);
      if (first.type === 'radio') return els.find(isOn)?.value ?? '';
      if (first.type === 'checkbox') return els.filter(isOn).map((el) => el.value).join('\u0001');
