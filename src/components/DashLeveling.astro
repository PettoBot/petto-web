          if (entry && entry.blocks && !entry.native) { control.setCustomValidity(entry.text); control.dataset.lvCv = '1'; }
          else if (control.dataset.lvCv) { control.setCustomValidity(''); delete control.dataset.lvCv; }
        });
      };

      // What a greyed control holds is added to the form data when it is built (a native Save, the bar of unsaved changes, or any
      // `new FormData(form)`), because the browser leaves disabled controls out.
      form.addEventListener('formdata', (event) => {
        form.querySelectorAll('[data-lv-dis]').forEach((el) => {
          if (!el.name) return;
          if ((el.type === 'checkbox' || el.type === 'radio') && !el.checked) return;
          event.formData.append(el.name, el.value);
        });
      });
      // A blocked field inside a closed block opens it, so the browser can show where the problem is.
      form.addEventListener('invalid', (event) => { event.target.closest?.('details:not([open])')?.setAttribute('open', ''); }, true);
      form.addEventListener('input', apply);
      form.addEventListener('change', apply);
      form.addEventListener('reset', () => setTimeout(apply, 0));
      apply();
    });
  };

  window.PettoLevelingInit = (root = document) => {
    window.PettoLevelingDepsInit?.(root);
    window.PettoLevelingStageInit?.(root);
    const form = root.querySelector('form[data-lv-settings]');
    if (form?.dataset.lvInitialized) return;
    if (form) form.dataset.lvInitialized = '1';
  if (form) {
    const control = (name) => form.elements.namedItem(name);
    const number = (name, fallback) => {
      const value = Number.parseFloat(control(name)?.value);
      return Number.isFinite(value) ? value : fallback;
    };
    const format = (value) => Math.max(0, Math.round(value)).toLocaleString(document.documentElement.lang || 'en-US');
    const totalXp = (level) => {
      if (level <= 0) return 0;
      const raw = (number('curve_a', 1) * level ** 3 + number('curve_b', 50) * level ** 2 + number('curve_c', 100) * level) * number('difficulty', 2.5);
      const rounding = number('rounding', 50);
      return rounding <= 0 ? Math.round(raw) : Math.round(raw / rounding) * rounding;
    };
    const updateCurve = () => {
      const points = Array.from({ length: 51 }, (_, level) => totalXp(level));
      const max = Math.max(points[50], 1);
      const x = (level) => 44 + (level / 50) * 556;
      const y = (value) => 240 - (value / max) * 216;
      const line = points.map((value, level) => `${level ? 'L' : 'M'}${x(level).toFixed(1)} ${y(value).toFixed(1)}`).join(' ');
      const lineNode = form.querySelector('[data-curve-line]');
      const areaNode = form.querySelector('[data-curve-area]');
      lineNode?.setAttribute('d', line);
      areaNode?.setAttribute('d', `${line} L600 240 L44 240 Z`);
      form.querySelector('[data-curve-axis="max"]')?.replaceChildren(document.createTextNode(format(max)));
      [10, 25, 50].forEach((level) => form.querySelector(`[data-curve-stat="${level}"]`)?.replaceChildren(document.createTextNode(`${format(totalXp(level))} XP`)));
      form.querySelectorAll('[data-curve-row]').forEach((row) => {
        const level = Number(row.dataset.curveRow);
        const current = totalXp(level);
        const messages = Math.max(0, Math.ceil(current / Math.max(number('xp_max', 25), 1)));
        const cooldown = Math.max(0, Math.round(messages * number('cooldown_seconds', 60)));
        row.querySelector('[data-curve-total]').textContent = `${format(current)} XP`;
        row.querySelector('[data-curve-messages]').textContent = `~${format(messages)}`;
        row.querySelector('[data-curve-cooldown]').textContent = cooldown >= 3600 ? `~${(cooldown / 3600).toFixed(1)}h` : `~${format(cooldown)}s`;
      });
    };
    const curvePresets = {
      balanced: { a: 1, b: 50, c: 100, difficulty: 2.5, rounding: 50, description: cdt('A steady curve for general-purpose communities.') },
      quick: { a: 0.4, b: 28, c: 80, difficulty: 1.8, rounding: 25, description: cdt('Early levels feel fast while high levels still matter.') },
      long: { a: 1.6, b: 70, c: 120, difficulty: 3.2, rounding: 100, description: cdt('A slower progression for long-running servers.') },
    };
    const updatePresetDescription = () => {
      const preset = form.querySelector('[data-curve-preset]')?.value;
      const description = form.querySelector('[data-curve-preset-description]');
