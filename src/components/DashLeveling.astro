  .lv-board-member small { color: var(--text-dim); font: 10px var(--mono); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lv-board-progress { display: block; width: min(190px, 100%); height: 3px; margin-top: 4px; border-radius: 99px; overflow: hidden; background: var(--border); }
  .lv-board-progress i { display: block; height: 100%; border-radius: inherit; background: var(--accent); }
  .lv-board-level { justify-self: end; border: 1px solid var(--border); border-radius: 7px; padding: 5px 8px; color: var(--text-muted); font: 11px var(--mono); }
  .lv-board-xp { justify-self: end; color: var(--text); font-weight: 700; white-space: nowrap; }
  .lv-board-xp small { color: var(--text-dim); font: 10px var(--mono); }
  .lv-board-xp .lv-board-minutes { display: block; margin-top: 2px; color: var(--text-dim); text-align: right; }

  @media (max-width: 620px) {
    .lv-grid { grid-template-columns: 1fr; }
    .lv-notify-layout, .lv-curve-layout { grid-template-columns: 1fr; }
    .lv-curve-head { flex-direction: column; }
    .lv-curve-stats { justify-content: flex-start; }
    .lv-curve-options { grid-template-columns: 1fr 1fr; }
    .lv-preset-row { align-items: stretch; flex-direction: column; gap: 7px; }
    .lv-preset-row .lv-field { width: 100%; }
    .lv-preset-description { margin: 0; }
    .lv-board-heading { flex-direction: column; gap: 9px; }
    .lv-board-head { display: none; }
    .lv-board-row { grid-template-columns: 34px minmax(0, 1fr) auto; gap: 10px; padding: 12px; }
    .lv-board-level { grid-column: 3; grid-row: 1; }
    .lv-board-xp { grid-column: 3; grid-row: 2; }
    .lv-board-member { grid-column: 2; grid-row: 1 / span 2; }
