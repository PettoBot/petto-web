      };

      const apply = () => {
        const ctx = lvCtx(form, false);
        const initial = lvCtx(form, true);
        // Which controls are switched off, and why: the master switch of the card first, then the rule of each field.
        const reasons = new Map();
        const gateOff = Boolean(gate) && !lvNamed(form, gate.dataset.lvGate)[0]?.checked;
        if (gate) {
