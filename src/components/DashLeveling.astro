          <div class="lv-field"><label>{dt('Starts in (hours)')}</label><input type="number" data-f="startIn" value="0" min="0" max="720" step="1" /></div>
        </div>
        <button type="button" class="btn btn-ghost btn-sm" data-stage-add-btn><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add event')}</button>
      </div>
      <div class="lv-save-bar">
        <button type="submit" class="btn btn-accent btn-sm">{dt('Save changes')}</button>
      </div>
    </form>
  </div>
