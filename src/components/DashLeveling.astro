        <p class="lv-hint"><Fragment set:html={dth('<code>{a}</code>, <code>{b}</code>, <code>{c}</code> and saved embed variables are available.', { a: ('{user}'), b: ('{level}'), c: ('{level_xp}') })} /></p>
