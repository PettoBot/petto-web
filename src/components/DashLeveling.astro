    <details class="lv-adv" data-lv-adv open={advNotify({ notifyPing: voiceConfig.notifyPing, notifyDeleteAfter: voiceConfig.notifyDeleteAfter, notifyEvery: voiceConfig.notifyEvery, notifyMilestones: voiceConfig.notifyMilestones, notifyEmbed: voiceConfig.notifyEmbed })}>
      <summary><Icon name="ph:caret-right-bold" width="12" height="12" />{dt('Advanced announcement options')}</summary>
      <div class="lv-grid lv-adv-body">
        <div class="lv-check-wrap" data-lv-dep="v_announce_on v_no_template">
          <label class="lv-inline-check"><input type="checkbox" name="voice_notify_embed" checked={voiceConfig.notifyEmbed} />{dt('Use a simple embed when no template is selected')}</label>
        </div>
        <div class="lv-check-wrap" data-lv-dep="v_announce_on">
