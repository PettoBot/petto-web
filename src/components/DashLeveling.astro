            <span class="lv-reward-level">{event.name}</span>
            <span class="lv-reward-role">×{event.multiplier} · {sourceLabel(event.source)} · {eventRunning(event) ? dt('until {a}', { a: eventTime(event.endsAt) }) : dt('from {a}', { a: eventTime(event.startsAt) })}</span>
            <button type="button" class="lv-reward-del" title={dt('Remove')} data-remove-existing><Icon name="ph:trash-fill" width="13" height="13" /></button>
          </div>
        ))}
      </div>
      <div class="lv-form lv-event-form" data-stage-add>
        <div class="lv-grid">
          <div class="lv-field"><label>{dt('Name')}</label><input type="text" data-f="name" maxlength="60" placeholder={dt('Double XP weekend')} /></div>
          <div class="lv-field"><label>{dt('Multiplier')}</label><input type="number" data-f="multiplier" value="2" min="1.1" max="20" step="0.1" /></div>
          <div class="lv-field"><label>{dt('Applies to')}</label>
            <select data-f="source"><option value="all">{dt('All XP')}</option><option value="text">{dt('Messages only')}</option><option value="voice">{dt('Voice only')}</option></select>
