---
import SilentMentionHint from './SilentMentionHint.astro';
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import VariableHelp from './VariableHelp.astro';
import MultiSelect from './MultiSelect.astro';
import SelectSource from './SelectSource.astro';
import SelectChosen from './SelectChosen.astro';
import DashAcData from './DashAcData.astro';
import DashStatTiles from './DashStatTiles.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import { ctxFromEntries, statusParts } from '../utils/levelingDeps';
import { configFormEntries, voiceFormEntries, rankFormEntries, rulesFormEntries, boardFormEntries, keepChosen, minFor, maxFor } from '../utils/levelingForm';

import { dashLocale, getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface Config {
  enabled: boolean;
  xpMin: number;
  xpMax: number;
  xpPerVcMinute: number;
  cooldownSeconds: number;
  notifyMode: string;
  notifyChannelId: string | null;
  notifyMessage: string;
  notifyEmbed: boolean;
  notifyEmbedTemplate: string;
  notifyEvery: number;
  roleMode: string;
  ignoredChannelIds: string[];
  ignoredCategoryIds: string[];
  notifyReply: boolean;
  notifyPing: boolean;
  notifyDeleteAfter: number;
  notifyMilestones: string;
  joinXp: number;
  joinLevel: number;
  curveA: number;
  curveB: number;
  curveC: number;
  difficulty: number;
  rounding: number;
  maxLevel: number;
}
interface Reward { level: number; roleId: string; source: string; }
interface Multiplier { targetId: string; type: string; multiplier: number }
interface LeaderboardRow {
  rank: number;
  userId: string;
  displayName: string;
  username: string;
  avatarUrl: string;
  xp: number;
  level: number;
  voiceMinutes?: number;
}
interface VoiceConfig {
  enabled: boolean;
  xpPerMinute: number;
  curveA: number;
  curveB: number;
  curveC: number;
  difficulty: number;
  rounding: number;
  maxLevel: number;
  notifyMode: string;
  notifyChannelId: string | null;
  notifyMessage: string;
  notifyEmbed: boolean;
  notifyEmbedTemplate: string;
  notifyEvery: number;
  roleMode: string;
  ignoredChannelIds: string[];
  ignoredCategoryIds: string[];
  notifyPing: boolean;
  notifyDeleteAfter: number;
  notifyMilestones: string;
}

interface RankConfig { style: string; card: string; notifyCard: string; voiceNotifyCard: string }
interface Rules { minMessageChars: number; antiRepeat: boolean; dailyXpCap: number; voiceAlonePercent: number; voiceMinMembers: number; voiceIgnoreMuted: boolean; dailyBonusXp: number; streakBonusXp: number; streakMaxDays: number; xpMultiplier: number; multiplierMode: string; multiplierCap: number; voteBoost: boolean; resetOnLeave: boolean; restoreRoles: boolean; noXpRoleIds: string[]; onlyXpRoleIds: string[] }
interface CardRow { name: string; kind: string; data: unknown }
interface XpEvent { id: string; name: string; multiplier: number; source: string; startsAt: string; endsAt: string }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  config: Config;
  rewards: Reward[];
  multipliers?: Multiplier[];
  categories?: { id: string; name: string }[];
  roles: { id: string; name: string }[];
  channels: { id: string; name: string }[];
  voiceChannels: { id: string; name: string }[];
  leaderboard: LeaderboardRow[];
  voiceConfig: VoiceConfig;
  voiceLeaderboard: LeaderboardRow[];
  embedTemplateNames: string[];
  rank: RankConfig;
  rules: Rules;
  cards: CardRow[];
  events: XpEvent[];
  saved: boolean;
  saveError: boolean;
  publicBoard?: { enabled: boolean; slug: string; joinUrl: string };
  boardError?: string;
  section?: string;
}
const { multipliers = [], categories = [] } = Astro.props;
const { user, guildId, guildName, guildIcon, config, rewards, roles, channels, voiceChannels, leaderboard, voiceConfig, voiceLeaderboard, embedTemplateNames, rank, rules, cards, events, saved, saveError, publicBoard, boardError, section } = Astro.props;
const sectionMeta: Record<string, string> = { settings: dt('Leveling settings'), voice: dt('Voice leveling'), rank: dt('Rank card'), rules: dt('Rules and events'), multipliers: dt('Multipliers'), rewards: dt('Level rewards'), leaderboard: dt('Leaderboard'), 'leaderboard-voice': dt('Voice leaderboard') };
// What a member needs to earn voice XP, from the rules saved for the server (shown under the XP per voice minute).
const voiceXpHint = [
  rules.voiceMinMembers <= 1
    ? dt("Voice XP is earned also when you are alone. Deafened members and the server's AFK channel never earn it.")
    : dt("Voice XP needs at least {a} people in the channel. Deafened members and the server's AFK channel never earn it.", { a: rules.voiceMinMembers }),
  rules.voiceIgnoreMuted ? dt('Muted members do not earn it either.') : '',
].filter(Boolean).join(' ');
// The profiles of the Rules page: each one fills the Chat and Voice rules (the form is saved with the Save bar, as always).
const ruleProfiles = [
  { id: 'relaxed', name: dt('Relaxed'), text: dt('Everything counts, even short messages and repeats. Voice earns alone, at full XP.'), icon: 'ph:sun-fill', values: { min_message_chars: 0, anti_repeat: false, daily_xp_cap: 0, voice_min_members: 1, voice_alone_percent: 100, voice_ignore_muted: false } },
  { id: 'balanced', name: dt('Balanced'), text: dt('Short messages and repeats earn nothing. Voice earns alone, at half XP.'), icon: 'ph:scales-fill', values: { min_message_chars: 3, anti_repeat: true, daily_xp_cap: 0, voice_min_members: 1, voice_alone_percent: 50, voice_ignore_muted: false } },
  { id: 'strict', name: dt('Strict'), text: dt('Longer messages, a daily limit, and voice only with company and the microphone on.'), icon: 'ph:shield-check-fill', values: { min_message_chars: 8, anti_repeat: true, daily_xp_cap: 1500, voice_min_members: 2, voice_alone_percent: 0, voice_ignore_muted: true } },
];
// A short line for each card, from what is saved.
const chatSummary = [
  rules.minMessageChars > 0 ? dt('Messages shorter than {a} characters earn nothing.', { a: rules.minMessageChars }) : dt('Every message counts, however short.'),
  rules.antiRepeat ? dt('The same text again within a minute earns nothing.') : '',
  rules.dailyXpCap > 0 ? dt('At most {a} XP a day from messages.', { a: rules.dailyXpCap.toLocaleString(dashLocale(dashLang)) }) : dt('No daily limit.'),
].filter(Boolean).join(' ');
const boardLink = `${Astro.url.origin}/lb/${publicBoard?.slug || guildId}`;
const boardErrors: Record<string, string> = {
  slug: dt('The name for the address needs 2 to 32 letters, numbers or dashes.'),
  join: dt('The join link has to start with https://.'),
  taken: dt('That name is already used by another server. Choose a different one.'),
  save: dt('Could not save these changes. Check the API response and try again.'),
};
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'settings';
const selectedTitle = sectionMeta[selectedSection];
const leaderboardIsVoice = selectedSection === 'leaderboard-voice';
const displayLeaderboard = leaderboardIsVoice ? voiceLeaderboard : leaderboard;
const boardCount = displayLeaderboard.length;
const boardTopLevel = displayLeaderboard.reduce((top, row) => Math.max(top, row.level), 0);
const boardXp = displayLeaderboard.reduce((sum, row) => sum + row.xp, 0);
const boardMinutes = displayLeaderboard.reduce((sum, row) => sum + (row.voiceMinutes ?? 0), 0);
const roleName = (roleId: string) => roles.find((role) => role.id === roleId)?.name ?? roleId;
const channelName = (channelId: string) => { const found = channels.find((c) => c.id === channelId) ?? voiceChannels.find((c) => c.id === channelId) ?? categories.find((c) => c.id === channelId); return found ? found.name : channelId; };
const multiplierLabel = (row: Multiplier) => (row.type === 'role' ? `@${roleName(row.targetId)}` : row.type === 'category' ? `${channelName(row.targetId)} (${dt('category')})` : `#${channelName(row.targetId)}`);
const rankCards = cards.filter((card) => card.kind === 'rank');
const sourceLabel = (source: string) => (source === 'text' ? dt('Messages only') : source === 'voice' ? dt('Voice only') : dt('All XP'));
const eventTime = (value: string) => new Date(value).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
const eventRunning = (event: XpEvent) => new Date(event.startsAt).getTime() <= Date.now();
const curvePreviewLevels = [1, 2, 3, 4, 5, 7, 10, 25, 50, 100, 200];
const curveNumber = (value: unknown, fallback: number) => {
  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : fallback;
};
const curveA = curveNumber(config.curveA, 1);
const curveB = curveNumber(config.curveB, 50);
const curveC = curveNumber(config.curveC, 100);
const curveDifficulty = curveNumber(config.difficulty, 2.5);
const curveRounding = Math.max(1, curveNumber(config.rounding, 50));
const curveTotal = (level: number) => {
  if (level <= 0) return 0;
  const raw = (curveA * level ** 3 + curveB * level ** 2 + curveC * level) * curveDifficulty;
  return Math.round(raw / curveRounding) * curveRounding;
};
const curveMax = Math.max(curveTotal(50), 1);
const curveX = (level: number) => 44 + (level / 50) * 556;
const curveY = (value: number) => 240 - (value / curveMax) * 216;
const curvePath = Array.from({ length: 51 }, (_, level) => `${level ? 'L' : 'M'}${curveX(level).toFixed(1)} ${curveY(curveTotal(level)).toFixed(1)}`).join(' ');
const curveMessages = (level: number) => Math.max(0, Math.ceil(curveTotal(level) / Math.max(curveNumber(config.xpMax, 25), 1)));
const curveCooldown = (level: number) => Math.max(0, Math.round(curveMessages(level) * curveNumber(config.cooldownSeconds, 60)));
const formatCurve = (value: number) => Math.max(0, Math.round(value)).toLocaleString(dashLocale(dashLang));
const formatCooldown = (value: number) => value >= 3600 ? `~${(value / 3600).toFixed(1)}h` : `~${formatCurve(value)}s`;
const leaderboardProgress = (row: LeaderboardRow, voice = false) => {
  const total = voice ? voiceCurveTotal : curveTotal;
  const current = total(row.level);
  const next = total(row.level + 1);
  if (next <= current) return 100;
  return Math.min(100, Math.max(0, ((row.xp - current) / (next - current)) * 100));
};
const voiceCurveTotal = (level: number) => {
  if (level <= 0) return 0;
  const raw = (Number(voiceConfig.curveA) * level ** 3 + Number(voiceConfig.curveB) * level ** 2 + Number(voiceConfig.curveC) * level) * Number(voiceConfig.difficulty);
  return Math.round(raw / Math.max(1, Number(voiceConfig.rounding))) * Math.max(1, Number(voiceConfig.rounding));
};
const voiceCurveMax = Math.max(voiceCurveTotal(50), 1);
const voiceCurveX = (level: number) => 44 + (level / 50) * 556;
const voiceCurveY = (value: number) => 240 - (value / voiceCurveMax) * 216;
const voiceCurvePath = Array.from({ length: 51 }, (_, level) => `${level ? 'L' : 'M'}${voiceCurveX(level).toFixed(1)} ${voiceCurveY(voiceCurveTotal(level)).toFixed(1)}`).join(' ');
const voiceMinutesForLevel = (level: number) => Math.max(0, Math.ceil(voiceCurveTotal(level) / Math.max(1, Number(voiceConfig.xpPerMinute))));

// ---- Dependencies between settings (src/utils/levelingDeps.ts): the same rules draw the page here and run in its script ----------
// Nothing is switched off on the server: a control the page greys out is only greyed by its script, and it still posts the value it holds.
const lvLabels: Record<string, string> = {
  why_textOff: dt('Turn on leveling first.'),
  why_voiceOff: dt('Turn on voice leveling first.'),
  why_announceOff: dt('The announcement is off, so this is not used.'),
  why_channelReply: dt('Only used with "Fixed channel". Now it answers in the same channel.'),
  why_channelDm: dt('A direct message has no channel.'),
  why_replyDm: dt('A direct message cannot answer a message.'),
  why_template: dt('A saved embed template replaces the simple embed.'),
  why_joinLevel: dt('"Level on join" is set, and it wins over XP on join.'),
  why_rankEmbed: dt('Only used when the answer includes the card.'),
  why_noTextNotify: dt('Level-ups are not announced. Turn the announcement on first.'),
  why_noVoiceNotify: dt('Voice level-ups are not announced. Turn the voice announcement on first.'),
  why_aloneNeedsOne: dt('Only used when 1 person is enough to earn voice XP.'),
  why_noStreak: dt('There is no streak bonus, so there is nothing to limit.'),
  why_boardOff: dt('Turn on the public page first.'),
  link_textOff: dt('Open Leveling settings'),
  link_voiceOff: dt('Open Voice leveling'),
  link_noTextNotify: dt('Open Leveling settings'),
  link_noVoiceNotify: dt('Open Voice leveling'),
  err_xpRange: dt('The minimum cannot be higher than the maximum.'),
  err_needChannel: dt('Choose the channel, or the announcement goes where the member leveled up.'),
  err_milestoneIgnored: dt('{a} line(s) will be ignored. Write them like 10: your message, one level per line.'),
  err_roleBoth: dt('{a} role(s) are in both lists. "Earn no XP" wins.'),
  err_range: dt('Enter a number between {a} and {b}.'),
  err_min: dt('Enter {a} or more.'),
  err_max: dt('Enter {a} or less.'),
  statusOn: dt('On'),
  statusOff: dt('Off'),
  statusXp: dt('{a}-{b} XP per message'),
  statusVoiceXp: dt('{a} XP per voice minute'),
  statusAnnounceOff: dt('level-ups are not announced'),
  statusReply: dt('level-ups answer in the same channel'),
  statusChannel: dt('level-ups in {a}'),
  statusChannelUnset: dt('level-ups in the channel of the message'),
  statusDm: dt('level-ups by direct message'),
  statusEvery: dt('every {a} levels'),
  statusTemplate: dt('template {a}'),
  statusEmbed: dt('as an embed'),
  statusRankCard: dt('/levels rank answers with a card'),
  statusRankEmbed: dt('/levels rank answers with an embed'),
  statusRankBoth: dt('/levels rank answers with a card and an embed'),
  statusLevelCard: dt('level-up card {a}'),
  statusMinChars: dt('messages need {a}+ characters'),
  statusAnyMessage: dt('every message counts'),
  statusDailyCap: dt('at most {a} XP a day from messages'),
  statusNoCap: dt('no daily limit'),
  statusVoicePeople: dt('voice needs {a} people'),
  statusDailyBonus: dt('daily bonus {a} XP'),
  statusBoardOn: dt('Public page on'),
  statusBoardOff: dt('Public page off'),
};
const lvFlags = { textOn: Boolean(config.enabled), voiceOn: Boolean(voiceConfig.enabled), textNotify: config.notifyMode !== 'off', voiceNotify: voiceConfig.notifyMode !== 'off' };
const lvHref = { settings: `/dash/guild/${guildId}/leveling`, voice: `/dash/guild/${guildId}/leveling?section=voice` };
const lvStatus = (kind: 'settings' | 'voice' | 'rank' | 'rules' | 'board', entries: [string, string][]) => statusParts(kind, ctxFromEntries(entries, lvFlags, (id) => `#${channelName(id)}`), lvLabels).join(' · ');
const statusSettings = lvStatus('settings', configFormEntries(config));
const statusVoice = lvStatus('voice', voiceFormEntries(voiceConfig));
const statusRank = lvStatus('rank', rankFormEntries(rank));
const statusRules = lvStatus('rules', rulesFormEntries(rules));
const statusBoard = lvStatus('board', boardFormEntries({ enabled: Boolean(publicBoard?.enabled), slug: publicBoard?.slug ?? '', joinUrl: publicBoard?.joinUrl ?? '' }));
// A saved choice that is no longer in its list (a deleted channel, role, template or card) stays as an option, so a Save never drops it.
const missingLabel = (id: string) => dt('Missing: {a}', { a: id });
const withMissing = (options: { id: string; name: string }[], chosen: string[]) => keepChosen(options, chosen, missingLabel);
const missingOption = (names: string[], chosen: string) => (chosen && !names.includes(chosen) ? chosen : '');
// What opens an "Advanced" block by itself: a value that is not the default one.
const advNotify = (c: { notifyReply?: boolean; notifyPing: boolean; notifyDeleteAfter: number; notifyEvery: number; notifyMilestones: string; notifyEmbed: boolean }) => c.notifyEmbed || c.notifyReply === false || !c.notifyPing || c.notifyDeleteAfter > 0 || c.notifyEvery > 1 || Boolean(c.notifyMilestones);
const advMore = config.ignoredChannelIds.length > 0 || config.ignoredCategoryIds.length > 0 || config.joinXp > 0 || config.joinLevel > 0 || config.xpPerVcMinute !== 5;
const advCurve = config.curveA !== 1 || config.curveB !== 50 || config.curveC !== 100 || config.difficulty !== 2.5 || config.rounding !== 50 || config.maxLevel !== 1000;
const advVoiceCurve = voiceConfig.curveA !== 1 || voiceConfig.curveB !== 50 || voiceConfig.curveC !== 100 || voiceConfig.difficulty !== 2.5 || voiceConfig.rounding !== 50 || voiceConfig.maxLevel !== 1000;
const advVoiceMore = voiceConfig.ignoredChannelIds.length > 0 || voiceConfig.ignoredCategoryIds.length > 0;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'settings' ? 'leveling' : `leveling-${selectedSection}`} pageTitle={selectedTitle}>
  <h1>{selectedTitle}</h1>
  <DashFormKit />
  <DashSettingsKit />
  {['settings', 'voice'].includes(selectedSection) && <DashAcData roles={roles} channels={channels} vars={[{ tok: '{EMOJI}', desc: dt('The level-up icon') }, { tok: '{level_role}', desc: dt('The reward role of that level') }]} />}

  {saved && <div class="lv-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {saveError && <div class="lv-flash lv-flash-error"><Icon name="ph:x-circle-fill" width="15" height="15" />{dt('Could not save these changes. Check the API response and try again.')}</div>}

  {selectedSection === 'settings' && <DashStatTiles tiles={[
    { label: dt('Level rewards'), value: rewards.length, tone: 'joins' },
    { label: dt('Multipliers'), value: multipliers.length, tone: 'reactions' },
    { label: dt('Max level'), value: config.maxLevel, tone: 'invites' },
  ]} />}

  {selectedSection === 'voice' && <DashStatTiles tiles={[
    { label: dt('XP per voice minute'), value: voiceConfig.xpPerMinute, tone: 'voice' },
    { label: dt('Minutes to level 10'), value: voiceMinutesForLevel(10), tone: 'joins' },
    { label: dt('Max level'), value: voiceConfig.maxLevel, tone: 'invites' },
  ]} />}

  {selectedSection === 'settings' && (
  <form method="POST" class:list={['lv-form', { 'lv-section-hidden': selectedSection !== 'settings' }]} data-lv-settings data-lv-form="settings" data-lv-flags={JSON.stringify(lvFlags)} data-lv-hrefs={JSON.stringify(lvHref)}>
    <input type="hidden" name="action" value="config" />
    <div class="lv-card lv-master">
      <div class="lv-card-head">
        <div class="lv-card-icon" style="--c:#a5ea7a"><Icon name="ph:chart-line-up-fill" width="16" height="16" /></div>
        <div class="lv-card-title" id="lv-enabled-title">{dt('Leveling enabled')}</div>
        <label class="lv-switch"><input type="checkbox" name="enabled" checked={config.enabled} aria-labelledby="lv-enabled-title" aria-describedby="lv-status-settings" /><span></span></label>
      </div>
      <p class="lv-card-desc">{dt('Members earn XP from chatting and level up. Voice has its own switch in Voice leveling.')}</p>
      <p class="lv-status" id="lv-status-settings" data-lv-status="settings" aria-live="polite">{statusSettings}</p>
    </div>
    <p class="lv-gate-note" data-lv-gate-note role="status" hidden>{dt('Leveling is off. Turn it on to edit what is below. Everything you saved stays as it is.')}</p>

    <div class="lv-gate" data-lv-gate="enabled">
    <div class="lv-section-label">
      <Icon name="ph:sliders-horizontal-fill" width="14" height="14" />
      {dt('Earning XP')}
    </div>
    <div class="lv-grid">
      <div class="lv-field">
        <label for="lv-xp_min">{dt('XP per message (min-max)')}</label>
        <div class="lv-pair"><input id="lv-xp_min" type="number" name="xp_min" value={config.xpMin} min={minFor(config.xpMin, 1)} max={maxFor(config.xpMin, 1000)} /><span>{dt('to')}</span><input type="number" name="xp_max" value={config.xpMax} min={minFor(config.xpMax, 1)} max={maxFor(config.xpMax, 1000)} aria-label={dt('Maximum XP per message')} /></div>
      </div>
      <div class="lv-field">
        <label for="lv-cooldown_seconds">{dt('Message cooldown (seconds)')}</label>
        <input id="lv-cooldown_seconds" type="number" name="cooldown_seconds" value={config.cooldownSeconds} min={minFor(config.cooldownSeconds, 0)} max={maxFor(config.cooldownSeconds, 600)} />
        <p class="lv-hint">{dt('A member earns XP at most once in this time, so fast chatting is not rewarded more.')}</p>
      </div>
      <div class="lv-field">
        <label for="lv-role_mode">{dt('Reward roles on level up')}</label>
        <select id="lv-role_mode" name="role_mode">
          <option value="highest" selected={config.roleMode === 'highest'}>{dt('Only the highest earned')}</option>
          <option value="all" selected={config.roleMode === 'all'}>{dt('Stack every earned role')}</option>
        </select>
        <p class="lv-hint">{dt('The roles themselves are chosen in Level rewards.')}</p>
      </div>
    </div>

    <div class="lv-section-label">
      <Icon name="ph:chat-circle-text-fill" width="14" height="14" />
      {dt('Level-up announcement')}
    </div>
    <div class="lv-grid">
      <div class="lv-field">
        <label for="lv-notify_mode">{dt('Level-up announcement')}</label>
        <select id="lv-notify_mode" name="notify_mode">
          <option value="off" selected={config.notifyMode === 'off'}>{dt('Off')}</option>
          <option value="reply" selected={config.notifyMode === 'reply'}>{dt('Reply in the same channel')}</option>
          <option value="channel" selected={config.notifyMode === 'channel'}>{dt('Fixed channel')}</option>
          <option value="dm" selected={config.notifyMode === 'dm'}>{dt('Direct message')}</option>
        </select>
      </div>
      <div class="lv-field" data-lv-dep="announce_on channel_used">
        <label for="lv-notify_channel_id">{dt('Announcement channel')}</label>
        <select id="lv-notify_channel_id" name="notify_channel_id" data-fill="lv-ch">
          <option value="">{dt('None')}</option>
          {config.notifyChannelId && !channels.some((channel) => channel.id === config.notifyChannelId) && <option value={config.notifyChannelId} selected>{missingLabel(config.notifyChannelId)}</option>}
          <SelectChosen items={channels} selected={config.notifyChannelId} prefix="#" />
        </select>
      </div>
      <div class="lv-field lv-field-wide" data-lv-dep="announce_on">
        <label for="lv-notify_message">{dt('Announcement message')}</label>
        <textarea id="lv-notify_message" class="dgl-autogrow" rows="2" name="notify_message" data-count data-ac maxlength="200" data-dp data-dp-template="notify_embed_template" data-dp-embed="notify_embed" data-dp-title={dt('Level up!')} placeholder="{EMOJI} {user} just leveled up to **{level}**!">{config.notifyMessage}</textarea><SilentMentionHint />
        <p class="lv-hint"><Fragment set:html={dth('<code>{a}</code> adds the level-up icon. Use the variables below to personalize it.', { a: ('{EMOJI}') })} /></p>
        <VariableHelp />
      </div>
      <div class="lv-field lv-field-wide" data-lv-dep="announce_on">
        <label for="lv-notify_embed_template">{dt('Saved embed template')}</label>
        <select id="lv-notify_embed_template" name="notify_embed_template">
          <option value="" selected={!config.notifyEmbedTemplate}>{dt('Use the message above')}</option>
          {missingOption(embedTemplateNames, config.notifyEmbedTemplate) && <option value={config.notifyEmbedTemplate} selected>{missingLabel(config.notifyEmbedTemplate)}</option>}
          {embedTemplateNames.map((name) => <option value={name} selected={name === config.notifyEmbedTemplate}>{name}</option>)}
        </select>
        <p class="lv-hint">{dt('Create and edit templates from')} <a href={`/dash/guild/${guildId}/embeds`}>{dt('Embeds')}</a>{dt('. The template can use the same leveling variables.')}</p>
      </div>
    </div>

    <details class="lv-adv" data-lv-adv open={advNotify(config)}>
      <summary><Icon name="ph:caret-right-bold" width="12" height="12" />{dt('Advanced announcement options')}</summary>
      <div class="lv-grid lv-adv-body">
        <div class="lv-check-wrap" data-lv-dep="announce_on no_template">
          <label class="lv-inline-check"><input type="checkbox" name="notify_embed" checked={config.notifyEmbed} />{dt('Use a simple embed when no template is selected')}</label>
        </div>
        <div class="lv-check-wrap" data-lv-dep="announce_on reply_used">
          <label class="lv-inline-check"><input type="checkbox" name="notify_reply" checked={config.notifyReply} />{dt('Answer the message that made them level up')}</label>
        </div>
        <div class="lv-check-wrap" data-lv-dep="announce_on">
          <label class="lv-inline-check"><input type="checkbox" name="notify_ping" checked={config.notifyPing} />{dt('Ping the member in the announcement')}</label>
        </div>
        <div class="lv-field" data-lv-dep="announce_on">
          <label for="lv-notify_delete_after">{dt('Delete the announcement after (seconds)')}</label>
          <input id="lv-notify_delete_after" type="number" name="notify_delete_after" value={config.notifyDeleteAfter} min="0" max="86400" />
          <p class="lv-hint">{dt('0 keeps it. Otherwise Petto deletes the announcement after this time, so the channel stays clean.')}</p>
        </div>
        <div class="lv-field" data-lv-dep="announce_on">
          <label for="lv-notify_every">{dt('Announce every N levels')}</label>
          <input id="lv-notify_every" type="number" name="notify_every" value={config.notifyEvery} min={minFor(config.notifyEvery, 1)} max={maxFor(config.notifyEvery, 50)} />
          <p class="lv-hint">{dt('1 announces every level, 5 announces levels 5, 10, 15...')}</p>
        </div>
        <div class="lv-field lv-field-wide" data-lv-dep="announce_on">
          <label for="lv-notify_milestones">{dt('Levels with a message of their own')}</label>
          <textarea id="lv-notify_milestones" class="dgl-autogrow" name="notify_milestones" rows="3" data-ac placeholder={'10: {user} is now level {level} and got {level_role}!'}>{config.notifyMilestones}</textarea><SilentMentionHint />
          <p class="lv-hint">{dt('One level per line, like 10: your message. That level is always announced with its own message, even with "every N levels".')}</p>
        </div>
      </div>
    </details>

    <details class="lv-adv" data-lv-adv open={advMore}>
      <summary><Icon name="ph:caret-right-bold" width="12" height="12" />{dt('Advanced')}</summary>
      <div class="lv-grid lv-adv-body">
        <div class="lv-field" data-lv-dep="voice_on">
          <label for="lv-xp_per_vc_minute">{dt('XP per voice minute')}</label>
          <input id="lv-xp_per_vc_minute" type="number" name="xp_per_vc_minute" value={config.xpPerVcMinute} min={minFor(config.xpPerVcMinute, 0)} max={maxFor(config.xpPerVcMinute, 1000)} />
          <p class="lv-hint">{dt('Voice has its own page, with its own curve and announcements.')} <a href={lvHref.voice}>{dt('Open Voice leveling')}</a></p>
        </div>
        <div class="lv-field" data-lv-dep="join_xp_used">
          <label for="lv-join_xp">{dt('XP on join')}</label>
          <input id="lv-join_xp" type="number" name="join_xp" value={config.joinXp} min="0" />
          <p class="lv-hint">{dt('What a new member starts with. If "Level on join" is set, the level is used instead.')}</p>
        </div>
        <div class="lv-field">
          <label for="lv-join_level">{dt('Level on join')}</label>
          <input id="lv-join_level" type="number" name="join_level" value={config.joinLevel} min={minFor(config.joinLevel, 0)} max={maxFor(config.joinLevel, 1000)} />
          <p class="lv-hint">{dt('0 turns it off.')}</p>
        </div>
        <div class="lv-field lv-field-wide">
          <label>{dt('Ignored channels')}</label>
          <MultiSelect lazy name="ignored_channel_ids" options={withMissing(channels.map((ch) => ({ id: ch.id, name: `#${ch.name}` })), config.ignoredChannelIds)} selected={config.ignoredChannelIds} placeholder={dt('Search channels...')} />
          <p class="lv-hint">{dt('No XP is granted for messages in these channels.')}</p>
        </div>
        <div class="lv-field lv-field-wide">
          <label>{dt('Ignored categories')}</label>
          <MultiSelect lazy name="ignored_category_ids" options={withMissing(categories.map((category) => ({ id: category.id, name: category.name })), config.ignoredCategoryIds)} selected={config.ignoredCategoryIds} placeholder={dt('Search categories...')} />
          <p class="lv-hint">{dt('No XP is granted in any channel of these categories.')}</p>
        </div>
      </div>
    </details>

    <details class="lv-adv lv-adv-curve" data-lv-adv open={advCurve}>
      <summary><Icon name="ph:caret-right-bold" width="12" height="12" />{dt('XP curve and level limit')}</summary>
    <div class="lv-advanced lv-curve-editor" data-curve-editor>
      <div class="lv-curve-head">
        <div>
          <div class="lv-curve-title"><Icon name="ph:chart-line-up" width="16" height="16" />{dt('XP curve')}</div>
          <p class="lv-hint">{dt('Shape the progression and see the result before saving. Existing XP is interpreted with the new curve.')}</p>
        </div>
      <div class="lv-curve-stats"><span>{dt('Lv.10')} <b data-curve-stat="10">{dt('{a} XP', { a: (formatCurve(curveTotal(10))) })}</b></span><span>{dt('Lv.25')} <b data-curve-stat="25">{dt('{a} XP', { a: (formatCurve(curveTotal(25))) })}</b></span><span>{dt('Lv.50')} <b data-curve-stat="50">{dt('{a} XP', { a: (formatCurve(curveTotal(50))) })}</b></span></div>
      </div>
      <div class="lv-curve-layout">
        <div class="lv-curve-controls">
          <div class="lv-formula" aria-label={dt('XP formula')}>
            <span>{dt('XP(L) =')}</span>
            <label><input type="number" name="curve_a" value={config.curveA} step="0.1" min="0" aria-label={dt('Curve A')} /> L<sup>3</sup></label>
            <span>+</span>
            <label><input type="number" name="curve_b" value={config.curveB} step="0.1" min="0" aria-label={dt('Curve B')} /> L<sup>2</sup></label>
            <span>+</span>
            <label><input type="number" name="curve_c" value={config.curveC} step="0.1" min="0" aria-label={dt('Curve C')} /> L</label>
          </div>
          <div class="lv-preset-row">
            <div class="lv-field">
              <label>{dt('Curve preset')}</label>
              <select data-curve-preset>
                <option value="custom">{dt('Custom')}</option>
                <option value="balanced">{dt('Balanced')}</option>
                <option value="quick">{dt('Quick start')}</option>
                <option value="long">{dt('Long progression')}</option>
              </select>
            </div>
            <p class="lv-preset-description" data-curve-preset-description>{dt('Adjust the values above to create your own curve.')}</p>
          </div>
          <div class="lv-curve-options">
            <div class="lv-field"><label>{dt('Difficulty')}</label><input type="number" name="difficulty" value={config.difficulty} step="0.1" min="0.1" /></div>
            <div class="lv-field"><label>{dt('Round to nearest')}</label><input type="number" name="rounding" value={config.rounding} min={minFor(config.rounding, 1)} /></div>
            <div class="lv-field"><label>{dt('Max level')}</label><input type="number" name="max_level" value={config.maxLevel} min={minFor(config.maxLevel, 1)} max={maxFor(config.maxLevel, 10000)} /></div>
          </div>
          <p class="lv-hint lv-advanced-warn">{dt('A higher difficulty or steeper curve means members need more XP for each level. Rounding keeps totals readable.')}</p>
        </div>
        <div class="lv-curve-chart" aria-label={dt('Live XP curve preview')}>
          <svg viewBox="0 0 620 270" role="img" aria-labelledby="curve-title curve-desc" preserveAspectRatio="none">
            <title id="curve-title">{dt('XP required by level')}</title>
            <desc id="curve-desc">{dt('Live preview of the XP curve from level zero to fifty.')}</desc>
            <g class="lv-chart-grid">
              <line x1="44" y1="24" x2="600" y2="24" /><line x1="44" y1="78" x2="600" y2="78" /><line x1="44" y1="132" x2="600" y2="132" /><line x1="44" y1="186" x2="600" y2="186" /><line x1="44" y1="240" x2="600" y2="240" />
              <line x1="44" y1="24" x2="44" y2="240" /><line x1="155" y1="24" x2="155" y2="240" /><line x1="266" y1="24" x2="266" y2="240" /><line x1="377" y1="24" x2="377" y2="240" /><line x1="488" y1="24" x2="488" y2="240" /><line x1="600" y1="24" x2="600" y2="240" />
            </g>
            <path class="lv-chart-area" data-curve-area d={`${curvePath} L600 240 L44 240 Z`} />
            <path class="lv-chart-line" data-curve-line d={curvePath} />
            <text x="44" y="260">0</text><text x="266" y="260">20</text><text x="488" y="260">40</text><text x="586" y="260">50</text>
            <text x="10" y="30" data-curve-axis="max">{formatCurve(curveMax)}</text><text x="10" y="244">0</text>
          </svg>
        </div>
      </div>
      <div class="lv-curve-table-wrap">
        <table class="lv-curve-table">
          <thead><tr><th>{dt('Level')}</th><th>{dt('Total XP')}</th><th>{dt('Total messages')}</th><th>{dt('Total cooldown')}</th></tr></thead>
          <tbody>
            {curvePreviewLevels.map((level) => <tr data-curve-row={level}><td>{level}</td><td data-curve-total>{dt('{a} XP', { a: (formatCurve(curveTotal(level))) })}</td><td data-curve-messages>~{formatCurve(curveMessages(level))}</td><td data-curve-cooldown>{formatCooldown(curveCooldown(level))}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
    </details>
    </div>
    <button type="submit" class="btn btn-accent btn-sm">{dt('Save changes')}</button>
  </form>
  )}

  {selectedSection === 'voice' && (
  <form method="POST" class:list={['lv-form', 'lv-voice-form', { 'lv-section-hidden': selectedSection !== 'voice' }]} data-lv-form="voice" data-lv-flags={JSON.stringify(lvFlags)} data-lv-hrefs={JSON.stringify(lvHref)}>
