  }

  @media (max-width: 420px) {
    .lv-curve-options { grid-template-columns: 1fr; }
    .lv-advanced { padding: 14px; }
  }

  /* The redesign: the same page, softer and easier to read and to use. */
  /* (the gate itself is not animated: an animation would hold its opacity at 1 and the dimming below would never show) */
  .lv-form > :not(.lv-gate), .lv-gate > * { animation: m-rise-in var(--m-slow) var(--m-out) both; }
  .lv-form > :nth-child(2) { animation-delay: 30ms; } .lv-form > :nth-child(3) { animation-delay: 60ms; }
  .lv-card { border-radius: 16px; padding: 18px 20px; }
  .lv-master { background: linear-gradient(180deg, color-mix(in srgb, var(--green) 7%, var(--card)), var(--card) 85%); transition: border-color .3s ease; }
  .lv-master:has(input[name="enabled"]:checked) { border-color: color-mix(in srgb, var(--green) 40%, var(--border)); }
  .lv-master:has(input[name="enabled"]:not(:checked)) { background: var(--card); border-color: color-mix(in srgb, var(--yellow) 45%, var(--border)); }
  .lv-master:has(input[name="enabled"]:not(:checked)) .lv-status::before { background: var(--yellow); }
  .lv-card-title { font-size: 15px; }
  .lv-card-desc { font-size: 12.5px; }
  .lv-section-label { gap: 10px; margin-top: 10px; padding-top: 18px; border-top: 1px solid var(--border-soft); font-family: var(--sans); font-size: 15px; font-weight: 600; letter-spacing: 0; text-transform: none; color: var(--text); width: 100%; box-sizing: border-box; }
  .lv-gate > .lv-section-label:first-child { border-top: 0; padding-top: 0; margin-top: 0; }
  .lv-section-label :global(svg) { box-sizing: content-box; width: 14px; height: 14px; padding: 8px; border-radius: 10px; background: var(--accent-soft); color: var(--accent); }
  /* When leveling is off the page is still readable and editable: a clear banner, and only a little dimming. */
  .lv-gate-note { display: flex; align-items: center; gap: 10px; border-left-width: 1px; border-color: color-mix(in srgb, var(--yellow) 45%, var(--border)); background: color-mix(in srgb, var(--yellow) 10%, transparent); font-size: 13px; padding: 12px 14px; }
  .lv-gate-note::before { content: '!'; flex: none; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--yellow); color: #1a1b1f; font-weight: 800; font-size: 13px; }
  .lv-gate[data-off] { opacity: .8; }
  .lv-grid { gap: 20px 24px; }
  .lv-field label { font-size: 13px; font-weight: 600; color: var(--text); text-transform: none; letter-spacing: 0; }
  .lv-field input:not([type="checkbox"]), .lv-field select, .lv-field textarea { border-radius: 10px; padding: 9px 12px; background: var(--card); transition: border-color .25s ease, box-shadow .25s ease; }
  .lv-field input:not([type="checkbox"]):hover, .lv-field select:hover, .lv-field textarea:hover { border-color: color-mix(in srgb, var(--text) 24%, var(--border)); }
  .lv-field input:not([type="checkbox"]):focus, .lv-field select:focus, .lv-field textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent); }
  .lv-field textarea.dgl-autogrow { min-height: 5.6em; resize: none; line-height: 1.5; }
  .lv-field textarea.dgl-autogrow.dfx-one { min-height: 40px; overflow-y: hidden; }
  .lv-field :global(.dfx-count) { align-self: flex-end; }
  .lv-field > .lv-label { font-size: 13px; font-weight: 600; color: var(--text); }
  /* The title of a subpage: one line of what it is, in the same voice as the other redesigned pages. */
  .lv-head { margin: 4px 0 16px; max-width: 980px; }
  .lv-head h2 { margin: 0; font-size: 16px; }
  .lv-head p { margin: 5px 0 0; font-size: 13px; line-height: 1.5; color: var(--text-dim); max-width: 72ch; }
  .lv-events-head { margin-top: 30px; }
  .lv-add-box { border: 1px solid var(--border); border-radius: 16px; background: var(--card); padding: 18px 20px; width: 100%; box-sizing: border-box; max-width: 980px; }
  .lv-add-title { font-size: 14.5px; font-weight: 600; }
  .lv-add-reward.lv-add-box { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .lv-grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 720px) { .lv-grid-3 { grid-template-columns: minmax(0, 1fr); } }
  .lv-off-note { max-width: 980px; margin: 0 0 18px; }
  .lv-off-note a { color: var(--accent); font-weight: 600; }
  .lv-off-note span { min-width: 0; }
  .lv-preview-label { font-family: var(--sans); font-size: 13px; font-weight: 600; letter-spacing: 0; text-transform: none; color: var(--text); margin-top: 8px; }
