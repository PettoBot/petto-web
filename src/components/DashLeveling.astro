  .lv-curve-title :global(svg) { color: var(--accent); }
  .lv-curve-head .lv-hint { margin-top: 6px; }
  .lv-curve-stats { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 7px; }
  .lv-curve-stats span { display: flex; flex-direction: column; gap: 2px; border: 1px solid var(--border); border-radius: 8px; padding: 7px 9px; color: var(--text-dim); font: 10px var(--mono); }
  .lv-curve-stats :global(b){ color: var(--text); font-size: 12px; }
  .lv-curve-layout { display: grid; grid-template-columns: minmax(min(230px, 100%), .72fr) minmax(0, 1.28fr); gap: 20px; align-items: stretch; }
  .lv-curve-controls { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .lv-formula { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; color: var(--text-muted); font: 12px var(--mono); line-height: 1.8; }
  .lv-formula label { display: inline-flex; align-items: center; gap: 5px; color: var(--text); font: 12px var(--mono); text-transform: none; letter-spacing: normal; }
  .lv-formula input { width: 66px; border: 1px solid var(--border); border-radius: 7px; padding: 7px 6px; background: var(--bg-raise); color: var(--text); font: 12px var(--mono); }
  .lv-curve-options { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 9px; }
