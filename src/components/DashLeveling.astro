          if (gateNote) gateNote.hidden = !gateOff;
        }
        deps.forEach((box) => {
          const line = lvWhyLine(box);
          const reason = gateOff && gate.contains(box) ? null : firstReason((box.dataset.lvDep ?? '').split(/\s+/).filter(Boolean), ctx);
          const targets = lvControls(box).concat(lvWidgets(box));
          if (reason) {
            box.dataset.off = '1';
            targets.forEach((el) => { if (!reasons.has(el)) reasons.set(el, reason); });
            if (line.dataset.reason !== reason) {
              line.dataset.reason = reason;
              line.textContent = labels[`why_${reason}`] ?? '';
              if (labels[`link_${reason}`] && hrefFor[reason]) {
                const link = document.createElement('a');
                link.href = hrefFor[reason];
                link.textContent = labels[`link_${reason}`];
                line.append(' ', link);
              }
