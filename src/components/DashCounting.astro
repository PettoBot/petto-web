---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import EmojiPicker from './EmojiPicker.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import { getDashLang, makeT } from '../i18n/dash';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  config: {
    enabled: boolean; channelId: string; allowDouble: boolean; math: boolean; resetOnWrong: boolean; deleteWrong: boolean; announceEdits: boolean;
    reactOk: string; reactBad: string; reactRecord: string; savesMax: number; saveEvery: number; milestoneEvery: number; recordEvery: number; startNumber: number; wrongRoleId: string; wrongRoleMinutes: number; topRoleId: string; alertSeconds: number;
    current: number; highScore: number; totalCorrect: number; totalWrong: number;
  };
  channels: { id: string; name: string }[];
  roles: { id: string; name: string }[];
  customEmojis?: { id: string; name: string; animated: boolean }[];
  top: { userId: string; name: string | null; correct: number; wrong: number; best: number }[];
  ready: boolean;
  saved: boolean;
  failed: string;
}
const { user, guildId, guildName, guildIcon, config, channels, roles, customEmojis = [], top, ready, saved, failed } = Astro.props;
const errors: Record<string, string> = { channel: dt('Choose a channel from the list.'), role: dt('Choose a role from the list.'), save: dt('It could not be saved. Try again in a moment.') };
const switches = [
  { name: 'math', on: config.math, label: dt('Sums count as a number'), hint: dt('2*3+1 is 7. Only whole numbers.') },
  { name: 'reset_on_wrong', on: config.resetOnWrong, label: dt('A mistake sends the count back to the start'), hint: dt('If it is off, the count goes on from where it was.') },
  { name: 'allow_double', on: config.allowDouble, label: dt('The same person can count twice in a row'), hint: dt('Off by default: someone else has to count in between.') },
  { name: 'delete_wrong', on: config.deleteWrong, label: dt('Delete the wrong numbers'), hint: '' },
  { name: 'announce_edits', on: config.announceEdits, label: dt('Say when the last number is edited or deleted'), hint: dt('So nobody counts from a number that is not there.') },
];
const rate = config.totalCorrect + config.totalWrong ? Math.round((config.totalCorrect / (config.totalCorrect + config.totalWrong)) * 100) : 0;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="counting" pageTitle={dt('Counting')}>
  <DashFormKit />
  <h1>{dt('Counting')}</h1>
  {saved && <div class="dfx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {failed && <div class="dfx-flash dfx-warn"><Icon name="ph:warning-fill" width="15" height="15" />{errors[failed] ?? errors.save}</div>}
  {!ready && <div class="dfx-flash dfx-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}

  <div class="ct-page">
    <DashStatTiles tiles={[
      { label: dt('Now at'), value: config.current, tone: 'messages' },
      { label: dt('Record'), value: config.highScore, tone: 'reactions' },
      { label: dt('Right numbers'), value: config.totalCorrect, tone: 'joins' },
      { label: dt('Mistakes'), value: config.totalWrong, tone: 'leaves' },
      { label: dt('Accuracy (%)'), value: rate, tone: 'voice' },
    ]} />

    <form method="POST" class="dfx-form">
      <label class="dfx-master"><span><b>{dt('The counting game is on')}</b><em>{dt('Members count one number at a time in the channel.')}</em></span><input type="checkbox" class="dfx-t" name="enabled" checked={config.enabled} /></label>

      <section class="dfx-sec">
        <div class="dfx-sec-head"><h2>{dt('The game')}</h2><p>{dt('Where members count and from which number.')}</p></div>
        <div class="dfx-grid">
          <div class="dfx-field"><label>{dt('Channel')}</label>
            <select name="channel_id">
              <option value="">{dt('Choose a channel')}</option>
              {channels.map((c) => <option value={c.id} selected={c.id === config.channelId}>#{c.name}</option>)}
            </select>
            <span class="dfx-hint">{dt('Members count here. Messages that are not numbers are left alone.')}</span>
          </div>
          <div class="dfx-field"><label>{dt('The count starts after')}</label><input type="number" name="start_number" min="0" max="1000000" value={config.startNumber} /><span class="dfx-hint">{dt('0 means the first number is 1.')}</span></div>
        </div>
        <div class="dfx-switches">
          {switches.map((s) => (
            <label class="dfx-switch"><span><b>{s.label}</b>{s.hint && <em>{s.hint}</em>}</span><input type="checkbox" class="dfx-t" name={s.name} checked={s.on} /></label>
          ))}
        </div>
      </section>

      <section class="dfx-sec">
        <div class="dfx-sec-head"><h2>{dt('Reactions and milestones')}</h2><p>{dt('How Petto answers a number, and when it celebrates.')}</p></div>
        <div class="dfx-emoji-row">
          <div class="dfx-field"><label>{dt('Right number')}</label><input type="text" name="react_ok" data-emoji-input value={config.reactOk} maxlength="64" /></div>
          <div class="dfx-field"><label>{dt('Wrong number')}</label><input type="text" name="react_bad" data-emoji-input value={config.reactBad} maxlength="64" /></div>
          <div class="dfx-field"><label>{dt('New record')}</label><input type="text" name="react_record" data-emoji-input value={config.reactRecord} maxlength="64" /></div>
        </div>
        <div class="dfx-grid">
          <div class="dfx-field"><label>{dt('Record reaction every this many numbers')}</label><input type="number" name="record_every" min="0" max="100000" value={config.recordEvery} /><span class="dfx-hint">{dt('0 for never.')}</span></div>
          <div class="dfx-field"><label>{dt('A message every this many numbers')}</label><input type="number" name="milestone_every" min="0" max="100000" value={config.milestoneEvery} /><span class="dfx-hint">{dt('0 for none.')}</span></div>
        </div>
      </section>

      <section class="dfx-sec">
        <div class="dfx-sec-head"><h2>{dt('Saves and mistakes')}</h2><p>{dt('A save forgives a mistake; alerts and roles follow the people who get a number wrong.')}</p></div>
        <div class="dfx-grid">
          <div class="dfx-field"><label>{dt('Saves the server can keep')}</label><input type="number" name="saves_max" min="0" max="5" value={config.savesMax} /><span class="dfx-hint">{dt('A save forgives one mistake. 0 turns them off.')}</span></div>
          <div class="dfx-field"><label>{dt('A save is earned every this many numbers')}</label><input type="number" name="save_every" min="10" max="10000" value={config.saveEvery} /></div>
          <div class="dfx-field"><label>{dt('Seconds until the alerts delete themselves')}</label><input type="number" name="alert_seconds" min="0" max="3600" value={config.alertSeconds} /><span class="dfx-hint">{dt('The messages about a mistake. 0 keeps them.')}</span></div>
          <div class="dfx-field"><label>{dt('Minutes the mistake role lasts')}</label><input type="number" name="wrong_role_minutes" min="0" max="10080" value={config.wrongRoleMinutes} /><span class="dfx-hint">{dt('0 keeps it until their next right number.')}</span></div>
        </div>
      </section>

      <section class="dfx-sec">
        <div class="dfx-sec-head"><h2>{dt('Roles')}</h2><p>{dt('A role for the best counter and one for whoever slips.')}</p></div>
        <div class="dfx-grid">
          <div class="dfx-field"><label>{dt('Role of the best counter')}</label>
            <select name="top_role_id" data-give-role><option value="">{dt('None')}</option>{roles.map((r) => <option value={r.id} selected={r.id === config.topRoleId}>{r.name}</option>)}</select>
            <span class="dfx-hint">{dt('It moves to whoever has the most right numbers.')}</span>
          </div>
          <div class="dfx-field"><label>{dt('Role for who gets a number wrong')}</label>
            <select name="wrong_role_id" data-give-role><option value="">{dt('None')}</option>{roles.map((r) => <option value={r.id} selected={r.id === config.wrongRoleId}>{r.name}</option>)}</select>
            <span class="dfx-hint">{dt('Petto has to be above it.')}</span>
          </div>
        </div>
      </section>

      <div class="dfx-foot">
        <button class="btn btn-accent btn-sm" type="submit" disabled={!ready}>{dt('Save')}</button>
        <span class="dfx-hint">{dt('With the prefix: !counting setup, next, stats, leaderboard.')}</span>
      </div>
    </form>

    <section class="dfx-card ct-list">
      <h2>{dt('Who counts the most')}</h2>
      {top.length === 0 && <p class="dfx-empty"><Icon name="ph:hash-bold" width="16" height="16" />{dt('Nobody has counted yet.')}</p>}
      {top.length > 0 && <div class="ct-rows dgl-stagger">
        {top.map((t, i) => (
          <div class="ct-row" style={`--share:${Math.max(4, Math.round((t.correct / (top[0].correct || 1)) * 100))}%`}>
            <span class={`ct-rank ct-rank-${i + 1}`}>{i + 1}</span>
            <div class="ct-who"><p>{t.name ?? t.userId}</p><small>{dt('{a} right · {b} mistakes · highest {c}', { a: t.correct, b: t.wrong, c: t.best })}</small><i class="ct-bar" aria-hidden="true"></i></div>
          </div>
        ))}
      </div>}
    </section>
  </div>
  <EmojiPicker customEmojis={customEmojis} />
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 18px; }
  .ct-page { max-width: 1000px; }
  .ct-list { padding: 18px 20px; }
  .ct-rows { display: flex; flex-direction: column; }
  .ct-row { display: flex; align-items: center; gap: 14px; padding: 11px 0; border-top: 1px solid var(--border-soft); }
  .ct-row:first-child { border-top: 0; }
  .ct-who { flex: 1; min-width: 0; }
  .ct-row p { margin: 0 0 2px; font-size: 14px; font-weight: 600; overflow-wrap: anywhere; }
  .ct-row small { display: block; font-size: 12px; color: var(--text-dim); }
  .ct-bar { display: block; height: 5px; margin-top: 8px; border-radius: 999px; background: color-mix(in srgb, var(--text) 8%, transparent); position: relative; overflow: hidden; }
  .ct-bar::after { content: ''; position: absolute; inset: 0 auto 0 0; width: var(--share); border-radius: inherit; background: var(--accent); transform-origin: left; animation: ct-grow 0.8s var(--m-out) both; }
  @keyframes ct-grow { from { transform: scaleX(0); } to { transform: none; } }
  .ct-rank { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font-size: 13px; font-weight: 700; background: var(--accent-soft); color: var(--accent); flex: none; }
  .ct-rank-1 { background: color-mix(in srgb, #f5c26b 24%, transparent); color: #f5c26b; }
  .ct-rank-2 { background: color-mix(in srgb, #c9d1d9 20%, transparent); color: #c9d1d9; }
  .ct-rank-3 { background: color-mix(in srgb, #d69866 22%, transparent); color: #d69866; }
  @media (prefers-reduced-motion: reduce) { .ct-bar::after { animation: none; } }
</style>
