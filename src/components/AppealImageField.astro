---
import { Icon } from 'astro-icon/components';
import { getDashLang, makeT } from '../i18n/dash';
// A picture of the appeal page: a link, or a file from the device that the bot stores. The form field holds the link or `upload:<kind>`.
interface Props { label: string; name: string; kind: 'banner' | 'icon' | 'embed'; value: string; hint?: string; uploadUrl: string; previewUrl: string; bind?: string; wide?: boolean }
const { label, name, kind, value, hint, uploadUrl, previewUrl, bind, wide = false } = Astro.props;
const dt = makeT(getDashLang(Astro));
const isUpload = value === `upload:${kind}`;
---
<div class:list={['sx-field', 'da-img', { 'sx-wide': wide }]} data-img-field data-kind={kind} data-upload-url={uploadUrl} data-preview-url={previewUrl}
  data-err-big={dt('The picture is bigger than 5 MB.')} data-err-type={dt('Use a PNG, JPG, WEBP or GIF picture.')} data-err-fail={dt('The picture could not be uploaded, try again.')} data-err-image={dt('That file is not a picture Petto can read.')}>
  <span class="sx-label">{label}</span>
  <input type="hidden" name={name} value={value} data-img-value data-bind={bind} />
  <div class="da-img-row">
    <textarea class="dgl-autogrow sx-one" rows="1" inputmode="url" autocomplete="off" spellcheck="false" placeholder="https://…" disabled={isUpload} data-img-link data-one-line>{isUpload ? '' : value}</textarea>
    <label class="btn btn-ghost btn-sm da-img-upload"><Icon name="ph:upload-simple-bold" width="13" height="13" />{dt('Upload from your device')}<input type="file" accept="image/png,image/jpeg,image/webp,image/gif" hidden data-img-file /></label>
  </div>
  <div class="da-img-done" data-img-done hidden={!isUpload}>
    <img src={isUpload ? previewUrl : ''} alt="" data-img-thumb />
    <span>{dt('Uploaded from your device')}</span>
    <button type="button" class="btn btn-ghost btn-sm" data-img-remove>{dt('Remove')}</button>
  </div>
  {hint && <span class="sx-hint">{hint}</span>}
  <span class="sx-hint da-img-error" data-img-error hidden></span>
</div>

<style>
  .da-img-row { display: flex; gap: 8px; align-items: stretch; flex-wrap: wrap; }
  .da-img-row textarea { flex: 1 1 180px; min-width: 0; }
  .da-img-row textarea:disabled { opacity: .5; }
  .da-img-upload { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; white-space: nowrap; min-height: 40px; box-sizing: border-box; }
  .da-img.busy { opacity: .6; pointer-events: none; }
  .da-img-done { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border: 1px solid var(--border); border-radius: 11px; background: color-mix(in srgb, var(--text) 3%, var(--card)); font-size: 12.5px; color: var(--text-muted); }
  .da-img-done[hidden] { display: none; }
  .da-img-done img { width: 52px; height: 36px; object-fit: cover; border-radius: 6px; background: var(--card); flex: none; }
  .da-img-done span { flex: 1; min-width: 0; }
  .da-img .da-img-error { color: var(--red, #fe6465); }
  .da-img-error[hidden] { display: none; }
</style>
