---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import { CODE_GENERATOR_URL } from '../data/codeGenerator';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  commands: { name: string; code: string; triggerType: string; triggerText: string }[];
  prefix: string;
  ready: boolean;
  loadFailed?: boolean;
}
const { user, guildId, guildName, guildIcon, commands, prefix, ready, loadFailed = false } = Astro.props;

// Everything the script shows, translated here so the script has no text of its own.
const ui = {
  ok: dt('The code is fine.'),
  checking: dt('Checking...'),
  line: dt('line {n}'),
  saved: dt('Saved.'),
  saving: dt('Saving...'),
  deleted: dt('Deleted.'),
  confirmDelete: dt('Delete this command? This cannot be undone.'),
  confirmTemplate: dt('Replace what you wrote with this template?'),
  confirmLeave: dt('You have changes that are not saved. Leave anyway?'),
  confirmNew: dt('You have changes that are not saved. Start a new command anyway?'),
  needName: dt('Write a name first.'),
  running: dt('Running...'),
  prints: dt('It would print'),
  nothing: dt('nothing'),
  does: dt('It would do'),
  nothingElse: dt('nothing else'),
  stopped: dt('The code stopped'),
  stepsTime: dt('{steps} steps, {ms} ms'),
  noMatch: dt('No function matches.'),
  unavailable: dt('The bot did not answer. Try again in a moment.'),
  closed: dt('Commands in code are turned off for now.'),
  triggerSaved: dt('The trigger was saved.'),
  saveFirst: dt('Save the command first.'),
  imported: dt('The command was imported. It is not saved until you press Save.'),
  importedExists: dt('The command was imported. A command with this name already exists: saving replaces it.'),
  importBad: dt('That share code is not valid. Nothing was changed.'),
  // The Discord-like preview of a test.
  onlyYou: dt('Only you can see this'),
  dmTo: dt('Direct message to {name}'),
  otherChannel: dt('In another channel ({channel})'),
  after: dt('After {s} s'),
  updated: dt('Changes the message of the button'),
  deletedAfter: dt('Deleted after {s} s'),
  execRuns: dt('Runs {name}'),
  execRunsAfter: dt('Runs {name} after {s} s'),
  deletedNow: dt('Deleted'),
  form: dt('Form'),
  submit: dt('Submit'),
  cancel: dt('Cancel'),
  usedButton: dt('{name} used the button {id}'),
  usedMenu: dt('{name} used the menu {id}'),
  noReply: dt('No answer is shown.'),
  // The suggestions of the editor.
  suggestions: dt('Suggestions'),
  limitNear: dt('Close to the limit of characters.'),
  limitOver: dt('Over the limit of characters: it cannot be saved.'),
};
const snippetLabels: [string, string][] = [
  ['embed', dt('Embed')],
  ['button', dt('Button and what it does')],
  ['menu', dt('Menu and what it does')],
  ['modal', dt('Form that pops up')],
  ['reaction', dt('Reaction and what it does')],
  ['cooldown', dt('Cooldown (dbSetExpire)')],
  ['counter', dt('Counter (dbIncr)')],
  ['ranking', dt('Ranking (dbTop and dbRank)')],
  ['mentions', dt('Mentioned member (.Mentions)')],
];
const avatar = user.avatar || '/assets/mascot-icon.webp';
const triggerTypes = [
  ['command', dt('The prefix of Petto')],
  ['prefix', dt('Its own prefix')],
  ['startswith', dt('A message that starts with...')],
  ['exact', dt('A whole message')],
  ['contains', dt('A message that has...')],
];
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="code" pageTitle="Commands in code">
  <div class="cc-title">
    <h1>{dt('Commands in code')}</h1>
    <a class="cc-docs" href="https://code.petto.sbs" target="_blank" rel="noopener"><Icon name="ph:book-open-fill" width="13" height="13" />{dt('Read the docs')}</a>
  </div>
  {loadFailed && <div class="cc-flash"><Icon name="ph:warning-fill" width="15" height="15" />{dt('We could not load your commands. Reload the page: nothing was deleted.')} <a href="" onclick="location.reload(); return false;">{dt('Reload')}</a></div>}
  {!ready && <div class="cc-flash"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}

  <div
    id="cc"
    class="cc-grid"
    data-endpoint={`/dash/guild/${guildId}/code-api`}
    data-prefix={prefix}
    data-commands={JSON.stringify(commands)}
    data-ui={JSON.stringify(ui)}
    data-generator={CODE_GENERATOR_URL}
    data-lang={dashLang}
    data-user={JSON.stringify({ name: user.username, avatar })}
  >
    <aside class="cc-side">
      <div class="cc-box">
        <div class="cc-box-head"><strong>{dt('Your commands')}</strong><button type="button" class="cc-btn cc-btn-small" id="cc-new"><Icon name="ph:plus-bold" width="12" height="12" />{dt('New')}</button></div>
        <ul class="cc-list" id="cc-list"></ul>
        <p class="cc-empty" id="cc-empty" hidden>{dt('No commands in code yet. Start from a template.')}</p>
      </div>
      <div class="cc-box">
        <div class="cc-box-head"><strong>{dt('Templates')}</strong></div>
        <select id="cc-templates" class="cc-input"><option value="">{dt('Choose a template...')}</option></select>
        <p class="cc-note" id="cc-template-note"></p>
      </div>
      <div class="cc-box">
        <div class="cc-box-head"><strong>{dt('Functions')}</strong></div>
        <input type="text" id="cc-fn-search" class="cc-input" placeholder={dt('Search a function')} autocomplete="off" />
        <ul class="cc-fns" id="cc-fns"></ul>
        <p class="cc-note">{dt('Click a function to put it in the code.')}</p>
      </div>
    </aside>

    <div class="cc-main">
      <div class="cc-box">
        <div class="cc-row">
          <label class="cc-field cc-grow">
            <span>{dt('Name')}</span>
            <span class="cc-prefixed"><code id="cc-prefix-show">{prefix}</code><input type="text" id="cc-name" class="cc-input" maxlength="32" placeholder="hello" autocomplete="off" spellcheck="false" /></span>
          </label>
          <div class="cc-actions">
            <button type="button" class="cc-btn cc-btn-primary" id="cc-save"><Icon name="ph:floppy-disk-fill" width="14" height="14" />{dt('Save')}</button>
            <button type="button" class="cc-btn cc-btn-danger" id="cc-delete" hidden><Icon name="ph:trash-fill" width="14" height="14" />{dt('Delete')}</button>
          </div>
        </div>

        <div class="cc-toolbar">
          <label class="cc-insert">
            <Icon name="ph:code-fill" width="14" height="14" />
            <span class="cc-sr">{dt('Insert')}</span>
            <select id="cc-snippet" class="cc-input">
              <option value="">{dt('Insert...')}</option>
              {snippetLabels.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </label>
          <button type="button" class="cc-btn cc-btn-small" id="cc-generator"><Icon name="ph:magic-wand-fill" width="13" height="13" />{dt('Open in the generator')}</button>
          <span class="cc-note cc-keys" id="cc-keys">{dt('Tab and Shift+Tab indent, Ctrl+Space suggests, Ctrl+S saves, Ctrl+Enter runs the test.')}</span>
        </div>
        <div class="cc-editor-wrap" id="cc-editor-wrap">
          <div class="cc-editor">
            <div class="cc-gutter" id="cc-gutter" aria-hidden="true"></div>
            <div class="cc-area" id="cc-area">
              <div class="cc-layer" id="cc-layer" aria-hidden="true"><div class="cc-errband" id="cc-errband" hidden></div><pre class="cc-pre" id="cc-pre"></pre></div>
              <span class="cc-measure" id="cc-measure" aria-hidden="true"></span>
              <textarea id="cc-code" spellcheck="false" autocapitalize="off" autocomplete="off" autocorrect="off" wrap="off" aria-label={dt('Code')} aria-describedby="cc-keys" aria-autocomplete="list" aria-controls="cc-ac" placeholder={'Hello {{ .User.Username }}!'}></textarea>
            </div>
          </div>
          <ul class="cc-ac" id="cc-ac" role="listbox" aria-label={dt('Suggestions')} hidden></ul>
        </div>
        <div class="cc-status" id="cc-status" role="status"><span class="cc-dot"></span><span id="cc-status-text">{dt('Checking...')}</span><span class="cc-count" id="cc-count"></span></div>
        <ul class="cc-hints" id="cc-hints" hidden></ul>
        <p class="cc-message" id="cc-message" hidden></p>
      </div>

      <div class="cc-box" id="cc-trigger-box">
        <div class="cc-box-head"><strong>{dt('What starts it')}</strong></div>
        <div class="cc-row">
          <select id="cc-trigger-type" class="cc-input">{triggerTypes.map(([value, label]) => <option value={value}>{label}</option>)}</select>
          <input type="text" id="cc-trigger-text" class="cc-input cc-grow" maxlength="50" placeholder={dt('The prefix or the words')} autocomplete="off" hidden />
          <button type="button" class="cc-btn" id="cc-trigger-save">{dt('Save trigger')}</button>
        </div>
        <p class="cc-note" id="cc-trigger-note"></p>
      </div>

      <div class="cc-box">
        <div class="cc-box-head"><strong><Icon name="ph:flask-fill" width="14" height="14" /> {dt('Test')}</strong><span class="cc-note">{dt('Nothing is sent or saved.')}</span></div>
        <div class="cc-row">
          <select id="cc-test-mode" class="cc-input"><option value="command">{dt('Someone uses the command')}</option><option value="button">{dt('Someone uses a button')}</option><option value="select">{dt('Someone uses a menu')}</option></select>
          <input type="text" id="cc-test-args" class="cc-input cc-grow" placeholder={dt('Arguments, like: 4 5 6')} maxlength="500" autocomplete="off" />
        </div>
        <div class="cc-row" id="cc-test-extra" hidden>
          <input type="text" id="cc-test-handler" class="cc-input" placeholder={dt('Button or menu id')} maxlength="20" autocomplete="off" />
          <input type="text" id="cc-test-value" class="cc-input" placeholder={dt('Chosen value (menus)')} maxlength="100" autocomplete="off" />
        </div>
        <div><button type="button" class="cc-btn cc-btn-primary" id="cc-run"><Icon name="ph:play-fill" width="14" height="14" />{dt('Run test')}</button></div>
        <div class="cc-result" id="cc-result" hidden></div>
      </div>
    </div>
  </div>
</DashGuildLayout>

<script>
  import { highlight, caretContext, esc } from '../utils/codeEditor/highlight';
  import { renderPreview } from '../utils/codeEditor/discord';
  import { FUNCTIONS, KEYWORDS, dataChildren, catalogLang } from '../utils/codeEditor/catalog';
  import { snippets } from '../utils/codeEditor/snippets';

  const root = document.getElementById('cc') as HTMLElement | null;
  if (root) {
    const ui = JSON.parse(root.dataset.ui || '{}');
    const endpoint = root.dataset.endpoint || '';
    const prefix = root.dataset.prefix || '!';
    let commands: { name: string; code: string; triggerType: string; triggerText: string }[] = JSON.parse(root.dataset.commands || '[]');
    let meta: any = null;
    let current: string | null = null; // the name of the saved command being edited
    let savedCode = '';
    let savedName = '';

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const code = $<HTMLTextAreaElement>('cc-code');
    const gutter = $('cc-gutter');
    const nameInput = $<HTMLInputElement>('cc-name');
    const statusBox = $('cc-status');
    const statusText = $('cc-status-text');
    const messageBox = $('cc-message');
    const countBox = $('cc-count');
    const list = $('cc-list');
    const empty = $('cc-empty');
    const deleteButton = $<HTMLButtonElement>('cc-delete');
    const triggerType = $<HTMLSelectElement>('cc-trigger-type');
    const triggerText = $<HTMLInputElement>('cc-trigger-text');
    const result = $('cc-result');
    const pre = $('cc-pre');
    const layer = $('cc-layer');
    const errBand = $('cc-errband');
    const measure = $('cc-measure');
    const wrap = $('cc-editor-wrap');
    const area = $('cc-area');
    const acList = $('cc-ac');
    const hintsBox = $('cc-hints');
    const dashLang = root.dataset.lang || 'en';
    const lang = catalogLang(dashLang);
    const viewer: { name: string; avatar: string } = JSON.parse(root.dataset.user || '{"name":"you","avatar":""}');
    // The functions the colors know: the catalog first, then the list of the bot when it arrives.
    let functionNames = new Set(FUNCTIONS.map((fn) => fn.name));
    let errorLine = 0;

    // Why a request did not work: the answer of the page or the bot, or that nothing came back.
    const why = (answer: { status: number; payload: any }) => `[${answer.payload?.error ?? (answer.status || 'no answer')}]`;
    const say = (message: string, kind: 'ok' | 'bad' | 'info' = 'info') => { messageBox.textContent = message; messageBox.hidden = !message; messageBox.dataset.kind = kind; };
    const dirty = () => code.value !== savedCode || nameInput.value.trim().toLowerCase() !== savedName;
    // The dashboard's bar of unsaved changes (DashGuildLayout) follows the editor: it saves with the same save() as the Save button,
    // and "discard" puts back the saved command (or an empty new one).
    function syncBar() {
      const w = window as unknown as { dglDirty?: (key: string, opts: object) => void; dglClean?: (key: string) => void };
      if (!w.dglDirty || !w.dglClean) return;
      if (!dirty() || !(code.value.trim() || nameInput.value.trim())) { w.dglClean('code-editor'); return; }
      w.dglDirty('code-editor', {
        save: async () => { await save(); return !dirty(); },
        discard: () => {
          const command = current ? commands.find((entry) => entry.name === current) : null;
          if (command) load(command.name, command.code, command.triggerType, command.triggerText); else load(null, '');
        },
      });
    }

    async function api(body: Record<string, unknown>) {
      try {
        const response = await fetch(endpoint, { method: 'POST', signal: AbortSignal.timeout(20000), headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body) });
        const payload = await response.json().catch(() => null);
        return { status: response.status, payload };
      } catch {
        return { status: 0, payload: null };
      }
    }

    // ── The editor: colors under a clear textarea, line numbers that follow the scroll, and a mark on the line with a mistake ──
    // The lines never wrap, so a line of the colors, of the textarea and of the numbers always has the same height.
    const LINE = 20;
    const PAD_TOP = 10;
    const LIMIT = () => Number(meta?.limits?.source ?? 10000);
    function follow() {
      gutter.scrollTop = code.scrollTop;
      layer.style.transform = `translate(${-code.scrollLeft}px, ${-code.scrollTop}px)`;
    }
    function paintCode() {
      pre.innerHTML = `${highlight(code.value, functionNames)}\n`;
      errBand.hidden = !errorLine;
      if (errorLine) errBand.style.top = `${PAD_TOP + (errorLine - 1) * LINE}px`;
      follow();
    }
    function drawGutter() {
      const lines = code.value.split('\n').length;
      let html = '';
      for (let n = 1; n <= lines; n += 1) html += `<div class="${n === errorLine ? 'cc-err' : ''}">${n}</div>`;
      gutter.innerHTML = html;
      gutter.scrollTop = code.scrollTop;
      const length = code.value.length;
      countBox.textContent = `${length.toLocaleString()} / ${LIMIT().toLocaleString()}`;
      countBox.dataset.level = length > LIMIT() ? 'over' : length > LIMIT() * 0.9 ? 'near' : '';
      countBox.title = length > LIMIT() ? ui.limitOver : length > LIMIT() * 0.9 ? ui.limitNear : '';
      paintCode();
    }
    code.addEventListener('scroll', follow);

    // Typing through the browser keeps Ctrl+Z working; when it cannot, the text is set and the page is told.
    function typeText(text: string) {
      code.focus();
      let done = false;
      try { done = document.execCommand('insertText', false, text); } catch { done = false; }
      if (!done) {
        code.setRangeText(text, code.selectionStart, code.selectionEnd, 'end');
        code.dispatchEvent(new Event('input'));
      }
    }
    // Tab and Shift+Tab move the lines of the selection by two spaces.
    function indentLines(outdent: boolean) {
      const value = code.value;
      const { selectionStart: start, selectionEnd: end } = code;
      const from = value.lastIndexOf('\n', start - 1) + 1;
      const lastEnd = end > start && value[end - 1] === '\n' ? end - 1 : end;
      let to = value.indexOf('\n', lastEnd);
      if (to === -1) to = value.length;
      const lines = value.slice(from, to).split('\n');
      let firstShift = 0;
      let total = 0;
      const changed = lines.map((text, i) => {
        if (!outdent) { if (i === 0) firstShift = 2; total += 2; return `  ${text}`; }
        const cut = /^ {1,2}/.exec(text)?.[0].length ?? 0;
        if (i === 0) firstShift = -cut;
        total -= cut;
        return text.slice(cut);
      }).join('\n');
      if (!total) return;
      code.setSelectionRange(from, to);
      typeText(changed);
      const newStart = Math.max(from, start + firstShift);
      code.setSelectionRange(newStart, start === end ? newStart : end + total);
    }

    code.addEventListener('keydown', (event) => {
      if (suggestKeys(event)) return;
      if ((event.ctrlKey || event.metaKey) && event.key === ' ') {
        event.preventDefault();
        suggest(true);
      } else if (event.key === 'Tab' && !event.altKey && !event.ctrlKey && !event.metaKey) {
        event.preventDefault();
        const { selectionStart: start, selectionEnd: end } = code;
        if (event.shiftKey || code.value.slice(start, end).includes('\n')) indentLines(event.shiftKey);
        else typeText('  ');
      } else if ((event.ctrlKey || event.metaKey) && event.key === 's') {
        // The bar of unsaved changes also listens for Ctrl+S: the editor saves once, here.
        event.preventDefault();
        event.stopPropagation();
        save();
      } else if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') {
        event.preventDefault();
        runTest();
      } else if (event.key === 'Enter' && !event.shiftKey && !event.altKey) {
        // A new line keeps the indentation of the line before it.
        const start = code.selectionStart;
        const lineText = code.value.slice(code.value.lastIndexOf('\n', start - 1) + 1, start);
        const spaces = /^[ \t]*/.exec(lineText)?.[0] ?? '';
        if (spaces) { event.preventDefault(); typeText(`\n${spaces}`); }
      } else if (event.key === '{' && !event.ctrlKey && !event.metaKey && code.selectionStart === code.selectionEnd && code.value[code.selectionStart - 1] === '{' && code.value.slice(code.selectionStart, code.selectionStart + 2) !== '}}') {
        // {{ closes itself: {{ | }}
        event.preventDefault();
        const at = code.selectionStart;
        typeText('{  }}');
        code.setSelectionRange(at + 2, at + 2);
        suggestClose();
      }
    });

    // ── Suggestions: functions inside {{ }}, and the fields of the data after a dot ──
    type Suggestion = { name: string; kind: 'fn' | 'kw' | 'data'; detail: string; more: boolean; arity: string };
    let suggestions: Suggestion[] = [];
    let active = 0;
    let suggestFrom = -1;
    const catalogText = new Map(FUNCTIONS.map((fn) => [fn.name, fn.text[lang] ?? fn.text.en]));
    const arityOf = (fn: any) => (fn.max === null ? `${fn.min}+` : fn.min === fn.max ? `${fn.min}` : `${fn.min}-${fn.max}`);
    function suggestClose() {
      suggestions = [];
      suggestFrom = -1;
      acList.hidden = true;
      acList.textContent = '';
      code.removeAttribute('aria-activedescendant');
    }
    function suggestPick(index: number) {
      active = (index + suggestions.length) % suggestions.length;
      acList.querySelectorAll('[role="option"]').forEach((item, i) => item.setAttribute('aria-selected', String(i === active)));
      const chosen = document.getElementById(`cc-ac-${active}`);
      if (chosen) { code.setAttribute('aria-activedescendant', chosen.id); chosen.scrollIntoView({ block: 'nearest' }); }
    }
    function caretPoint() {
      const value = code.value;
      const at = code.selectionStart;
      const lineStart = value.lastIndexOf('\n', at - 1) + 1;
      const row = value.slice(0, at).split('\n').length - 1;
      measure.textContent = value.slice(lineStart, at);
      const x = 12 + measure.getBoundingClientRect().width - code.scrollLeft;
      const y = PAD_TOP + row * LINE - code.scrollTop;
      const areaBox = area.getBoundingClientRect();
      const wrapBox = wrap.getBoundingClientRect();
      return { x: areaBox.left - wrapBox.left + x, y: areaBox.top - wrapBox.top + y, bottom: areaBox.bottom - wrapBox.top };
    }
    function suggest(forced = false) {
      const where = caretContext(code.value, code.selectionStart);
      if (!where || code.selectionStart !== code.selectionEnd || (!forced && where.kind === 'word' && !where.partial)) { suggestClose(); return; }
      const partial = where.partial.toLowerCase();
      let found: Suggestion[];
      if (where.kind === 'data') {
        found = dataChildren(where.parent).map((entry) => ({ name: entry.name, kind: 'data' as const, detail: entry.text ? entry.text[lang] ?? entry.text.en : '', more: entry.children, arity: '' }));
      } else {
        const known: any[] = meta?.functions ?? FUNCTIONS.map((fn) => ({ name: fn.name, min: null, max: null }));
        found = [
          ...KEYWORDS.map((name) => ({ name, kind: 'kw' as const, detail: catalogText.get(name) ?? '', more: false, arity: '' })),
          ...known.map((fn) => ({ name: String(fn.name), kind: 'fn' as const, detail: catalogText.get(fn.name) ?? '', more: false, arity: fn.min === null || fn.min === undefined ? '' : arityOf(fn) })),
        ];
      }
      const starts = found.filter((item) => item.name.toLowerCase().startsWith(partial));
      const has = found.filter((item) => !item.name.toLowerCase().startsWith(partial) && item.name.toLowerCase().includes(partial));
      suggestions = [...starts.sort((a, b) => a.name.localeCompare(b.name)), ...has].slice(0, 40);
      if (!suggestions.length || (suggestions.length === 1 && suggestions[0].name === where.partial && !suggestions[0].more)) { suggestClose(); return; }
      suggestFrom = where.start;
      acList.innerHTML = suggestions.map((item, i) => `<li id="cc-ac-${i}" role="option" aria-selected="false" data-index="${i}" class="cc-ac-${item.kind}"><code>${esc(item.kind === 'data' ? `.${item.name}${item.more ? '.' : ''}` : item.name)}</code>${item.arity ? `<em>${esc(item.arity)}</em>` : ''}${item.detail ? `<span>${esc(item.detail)}</span>` : ''}</li>`).join('');
      acList.hidden = false;
      const point = caretPoint();
      const width = Math.min(360, wrap.clientWidth - 8);
      acList.style.width = `${width}px`;
      acList.style.left = `${Math.max(4, Math.min(point.x, wrap.clientWidth - width - 4))}px`;
      const below = point.y + LINE + 4;
      const height = acList.offsetHeight;
      const room = point.bottom - below;
      acList.style.top = `${room < Math.min(height, 120) && point.y - height - 4 > 0 ? point.y - height - 4 : below}px`;
      suggestPick(0);
    }
    function suggestAccept(index = active) {
      const item = suggestions[index];
      if (!item || suggestFrom < 0) { suggestClose(); return; }
      const next = code.value[code.selectionStart] ?? '';
      const tail = item.kind === 'data' ? (item.more ? '.' : '') : /\s/.test(next) ? '' : ' ';
      code.setSelectionRange(suggestFrom, code.selectionStart);
      typeText(`${item.name}${tail}`);
      if (item.more) suggest(true); else suggestClose();
    }
    // The keys of the open list; true when the key was for it.
    function suggestKeys(event: KeyboardEvent) {
      if (acList.hidden || !suggestions.length) return false;
      if (event.key === 'ArrowDown') { event.preventDefault(); suggestPick(active + 1); return true; }
      if (event.key === 'ArrowUp') { event.preventDefault(); suggestPick(active - 1); return true; }
      if ((event.key === 'Enter' || event.key === 'Tab') && !event.shiftKey && !event.ctrlKey && !event.metaKey) { event.preventDefault(); suggestAccept(); return true; }
      if (event.key === 'Escape') { event.preventDefault(); event.stopPropagation(); suggestClose(); return true; }
      if (['ArrowLeft', 'ArrowRight', 'Home', 'End', 'PageUp', 'PageDown'].includes(event.key)) suggestClose();
      return false;
    }
    acList.addEventListener('mousedown', (event) => {
      const item = (event.target as HTMLElement).closest('[role="option"]') as HTMLElement | null;
      if (!item) return;
      event.preventDefault();
      suggestAccept(Number(item.dataset.index));
    });
    code.addEventListener('blur', () => setTimeout(() => { if (document.activeElement !== code) suggestClose(); }, 120));
    code.addEventListener('mousedown', suggestClose);
    code.addEventListener('scroll', () => { if (!acList.hidden) suggestClose(); });

    // ── Hints the bot gives with a check or a test ──
    function showHints(list: unknown) {
      const hints = Array.isArray(list) ? list.filter((hint) => typeof hint === 'string' && hint.trim()) : [];
      hintsBox.textContent = '';
      hintsBox.hidden = !hints.length;
      for (const hint of hints) { const item = document.createElement('li'); item.textContent = String(hint); hintsBox.appendChild(item); }
    }

    // ── Checking while writing ──
    let checkTimer: ReturnType<typeof setTimeout> | undefined;
    let checkId = 0;
    function setStatus(kind: 'ok' | 'bad' | 'wait', text: string) { statusBox.dataset.kind = kind; statusText.textContent = text; }
    async function checkNow() {
      const ticket = ++checkId;
      if (!code.value.trim()) { errorLine = 0; drawGutter(); showHints(null); setStatus('wait', ''); return; }
      setStatus('wait', ui.checking);
      const answer = await api({ action: 'check', code: code.value });
      const payload = answer.payload;
      if (ticket !== checkId) return;
      if (!payload?.ok) { setStatus('wait', `${ui.unavailable} ${why(answer)}`); return; }
      const problem = payload.problem;
      errorLine = problem?.line ?? 0;
      drawGutter();
      showHints(payload.hints);
      if (!problem) setStatus('ok', ui.ok);
      else setStatus('bad', `${problem.line ? `${String(ui.line).replace('{n}', problem.line)}: ` : ''}${problem.message}`);
    }
    code.addEventListener('input', (event) => {
      drawGutter();
      syncBar();
      clearTimeout(checkTimer);
      checkTimer = setTimeout(checkNow, 450);
      // Suggestions follow what is typed or deleted by hand, not the code a template or a snippet puts.
      const kind = (event as InputEvent).inputType ?? '';
      if (kind === 'insertText' || kind === 'deleteContentBackward' || kind === 'insertCompositionText') suggest(!acList.hidden || (event as InputEvent).data === '.');
      else suggestClose();
    });

    // ── The list of commands ──
    function triggerLabel(command: { triggerType: string; triggerText: string; name: string }) {
      if (command.triggerType === 'prefix') return `${command.triggerText}${command.name}`;
      if (command.triggerType === 'command' || !command.triggerType) return `${prefix}${command.name}`;
      return `${command.triggerType}: ${command.triggerText}`;
    }
    function drawList() {
      list.textContent = '';
      empty.hidden = commands.length > 0;
      for (const command of commands) {
        const item = document.createElement('li');
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `cc-item${command.name === current ? ' on' : ''}`;
        const title = document.createElement('code');
        title.textContent = triggerLabel(command);
        button.appendChild(title);
        button.addEventListener('click', () => open(command.name));
        item.appendChild(button);
        list.appendChild(item);
      }
    }

    function showTrigger(type: string, text: string) {
      triggerType.value = type || 'command';
      triggerText.value = text || '';
      triggerText.hidden = triggerType.value === 'command';
      $('cc-trigger-note').textContent = '';
    }

    function load(name: string | null, source: string, type = 'command', text = '') {
      current = name;
      savedName = name ?? '';
      savedCode = source;
      nameInput.value = name ?? '';
      nameInput.readOnly = Boolean(name);
      code.value = source;
      deleteButton.hidden = !name;
      showTrigger(type, text);
      result.hidden = true;
      say('');
      showHints(null);
      suggestClose();
      errorLine = 0;
      drawGutter();
      drawList();
      syncBar();
      if (source) checkNow(); else setStatus('wait', '');
    }
    function open(name: string) {
      if (dirty() && !confirm(ui.confirmLeave)) return;
      const command = commands.find((entry) => entry.name === name);
      if (command) load(command.name, command.code, command.triggerType, command.triggerText);
    }
    $('cc-new').addEventListener('click', () => {
      if (dirty() && !confirm(ui.confirmNew)) return;
      load(null, '');
      nameInput.focus();
    });

    // ── Saving and deleting ──
    async function save() {
      const name = nameInput.value.trim().toLowerCase();
      if (!name) { say(ui.needName, 'bad'); nameInput.focus(); return; }
      say(ui.saving);
      const { status, payload } = await api({ action: 'save', name, code: code.value });
      if (status === 403 && payload?.error === 'turned_off') { say(ui.closed, 'bad'); return; }
      if (!payload) { say(`${ui.unavailable} ${why({ status, payload })}`, 'bad'); return; }
      if (!payload.ok) { say(payload.message || `${ui.unavailable} ${why({ status, payload })}`, 'bad'); return; }
      const existing = commands.find((entry) => entry.name === name);
      if (existing) existing.code = code.value; else commands.push({ name, code: code.value, triggerType: 'command', triggerText: '' });
      commands.sort((a, b) => a.name.localeCompare(b.name));
      current = name; savedName = name; savedCode = code.value; nameInput.readOnly = true; deleteButton.hidden = false;
      drawList();
      syncBar();
      say(ui.saved, 'ok');
    }
    $('cc-save').addEventListener('click', save);
    nameInput.addEventListener('input', syncBar);

    deleteButton.addEventListener('click', async () => {
      if (!current || !confirm(ui.confirmDelete)) return;
      const { payload } = await api({ action: 'delete', name: current });
      if (!payload?.ok) { say(ui.unavailable, 'bad'); return; }
      commands = commands.filter((entry) => entry.name !== current);
      load(null, '');
      say(ui.deleted, 'ok');
    });

    // ── The trigger ──
    triggerType.addEventListener('change', () => { triggerText.hidden = triggerType.value === 'command'; });
    $('cc-trigger-save').addEventListener('click', async () => {
      if (!current) { $('cc-trigger-note').textContent = ui.saveFirst; return; }
      const { payload } = await api({ action: 'trigger', name: current, type: triggerType.value, text: triggerText.value });
      if (!payload) { $('cc-trigger-note').textContent = ui.unavailable; return; }
      if (!payload.ok) { $('cc-trigger-note').textContent = payload.message || ui.unavailable; return; }
      const command = commands.find((entry) => entry.name === current);
      if (command) { command.triggerType = triggerType.value; command.triggerText = payload.text ?? ''; }
      drawList();
      $('cc-trigger-note').textContent = ui.triggerSaved;
    });

    // ── The test ──
    const mode = $<HTMLSelectElement>('cc-test-mode');
    mode.addEventListener('change', () => { $('cc-test-extra').hidden = mode.value === 'command'; });
    function line(label: string, value: string, bad = false) {
      const block = document.createElement('div');
      block.className = bad ? 'cc-res-bad' : 'cc-res-block';
      const title = document.createElement('strong');
      title.textContent = label;
      const body = document.createElement('pre');
      body.textContent = value;
      block.append(title, body);
      return block;
    }
    // The message that would start the command, as someone would write it.
    function testedMessage() {
      const name = nameInput.value.trim().toLowerCase() || 'command';
      const args = $<HTMLInputElement>('cc-test-args').value.trim();
      const type = triggerType.value;
      const start = type === 'prefix' ? `${triggerText.value.trim()}${name}` : type === 'command' ? `${prefix}${name}` : triggerText.value.trim();
      return [start, args].filter(Boolean).join(' ');
    }
    async function runTest() {
      result.hidden = false;
      result.textContent = ui.running;
      const { status, payload } = await api({
        action: 'test', code: code.value, args: $<HTMLInputElement>('cc-test-args').value, trigger: mode.value,
        handler: $<HTMLInputElement>('cc-test-handler').value, value: $<HTMLInputElement>('cc-test-value').value,
      });
      result.textContent = '';
      if (status === 403 && payload?.error === 'turned_off') { result.appendChild(line(ui.stopped, ui.closed, true)); return; }
      if (!payload?.ok) { result.appendChild(line(ui.stopped, `${ui.unavailable} ${why({ status, payload })}`, true)); return; }
      if (payload.error) {
        const where = payload.error.line ? ` (${String(ui.line).replace('{n}', payload.error.line)})` : '';
        result.appendChild(line(ui.stopped, `${payload.error.message}${where}`, true));
        if (payload.error.line) { errorLine = payload.error.line; drawGutter(); }
        return;
      }
      showHints(payload.hints);
      const output = String(payload.output ?? '');
      const actions: string[] = Array.isArray(payload.actions) ? payload.actions : [];
      if (Array.isArray(payload.effects)) {
        // The bot gave what the code does: it is drawn like Discord, and the printed text stays one click away.
        const preview = document.createElement('div');
        preview.className = 'cc-preview';
        preview.innerHTML = renderPreview(output, payload.effects, {
          ctx: { locale: document.documentElement.lang || dashLang },
          t: { onlyYou: ui.onlyYou, dmTo: ui.dmTo, otherChannel: ui.otherChannel, after: ui.after, updated: ui.updated, deletedAfter: ui.deletedAfter, form: ui.form, submit: ui.submit, cancel: ui.cancel, usedButton: ui.usedButton, usedMenu: ui.usedMenu, deleted: ui.deletedNow, nothing: ui.noReply, execRuns: ui.execRuns, execRunsAfter: ui.execRunsAfter },
          prefix,
          user: { name: viewer.name, avatar: viewer.avatar },
          bot: { name: 'Petto', avatar: '/assets/bot-avatar.png' },
          trigger: { mode: mode.value, text: mode.value === 'command' ? testedMessage() : $<HTMLInputElement>('cc-test-handler').value.trim() },
        });
        result.appendChild(preview);
        result.appendChild(line(ui.does, actions.length ? actions.map((action: string) => `• ${action}`).join('\n') : ui.nothingElse));
        const raw = document.createElement('details');
        raw.className = 'cc-res-block cc-raw';
        const summary = document.createElement('summary');
        summary.textContent = ui.prints;
        const body = document.createElement('pre');
        body.textContent = output.trim() || ui.nothing;
        raw.append(summary, body);
        result.appendChild(raw);
      } else {
        result.appendChild(line(ui.prints, output.trim() || ui.nothing));
        result.appendChild(line(ui.does, actions.length ? actions.map((action: string) => `• ${action}`).join('\n') : ui.nothingElse));
      }
      const foot = document.createElement('p');
      foot.className = 'cc-note';
      foot.textContent = String(ui.stepsTime).replace('{steps}', payload.steps).replace('{ms}', payload.millis);
      result.appendChild(foot);
    }
    $('cc-run').addEventListener('click', runTest);
    result.addEventListener('click', (event) => { (event.target as HTMLElement).closest('.dc-spoiler')?.classList.toggle('shown'); });

    // ── Templates and functions ──
    function insert(text: string) {
      const { selectionStart: start, selectionEnd: end } = code;
      code.setRangeText(text, start, end, 'end');
      code.focus();
      code.dispatchEvent(new Event('input'));
    }
    function drawFunctions(filter = '') {
      const box = $('cc-fns');
      box.textContent = '';
      const shown = (meta?.functions ?? []).filter((fn: any) => fn.name.toLowerCase().includes(filter.toLowerCase()));
      if (!shown.length) { const none = document.createElement('li'); none.className = 'cc-note'; none.textContent = ui.noMatch; box.appendChild(none); return; }
      for (const fn of shown) {
        const item = document.createElement('li');
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'cc-fn';
        const arity = fn.max === null ? `${fn.min}+` : fn.min === fn.max ? `${fn.min}` : `${fn.min}-${fn.max}`;
        const name = document.createElement('code');
        name.textContent = fn.name;
        const hint = document.createElement('span');
        hint.textContent = arity;
        button.append(name, hint);
        button.addEventListener('click', () => insert(`{{ ${fn.name} }}`));
        item.appendChild(button);
        box.appendChild(item);
      }
    }
    $<HTMLInputElement>('cc-fn-search').addEventListener('input', (event) => drawFunctions((event.target as HTMLInputElement).value));

    // ── Snippets: common pieces put where the caret is ──
    const snippetPicker = $<HTMLSelectElement>('cc-snippet');
    const snippetCode = new Map(snippets(lang).map((snippet) => [snippet.id, snippet.code]));
    snippetPicker.addEventListener('change', () => {
      const text = snippetCode.get(snippetPicker.value);
      snippetPicker.value = '';
      if (!text) return;
      const before = code.value.slice(0, code.selectionStart);
      typeText(`${before && !before.endsWith('\n') ? '\n' : ''}${text}`);
    });

    const templates = $<HTMLSelectElement>('cc-templates');
    templates.addEventListener('change', () => {
      const template = (meta?.templates ?? []).find((entry: any) => entry.id === templates.value);
      $('cc-template-note').textContent = template?.description ?? '';
      if (!template) return;
      if ((code.value.trim() && dirty()) && !confirm(ui.confirmTemplate)) { templates.value = ''; return; }
      current = null; savedName = ''; deleteButton.hidden = true; nameInput.readOnly = false;
      if (!nameInput.value.trim() || !commands.some((entry) => entry.name === nameInput.value.trim())) nameInput.value = template.suggestedName;
      code.value = template.code;
      savedCode = '';
      showTrigger('command', '');
      errorLine = 0;
      drawGutter(); drawList(); syncBar(); checkNow();
    });

    window.addEventListener('beforeunload', (event) => { if (dirty() && code.value.trim()) { event.preventDefault(); } });

    // ── The Code Generator: share codes in and out ──
    // A share code is pc1. + the base64url of {"v":1,"n":name,"d":description,"c":code}, the same as !customcommand export.
    function toShareCode(name: string, source: string) {
      const bytes = new TextEncoder().encode(JSON.stringify({ v: 1, n: name, d: '', c: source }));
      let binary = '';
      for (const byte of bytes) binary += String.fromCharCode(byte);
      return `pc1.${btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '')}`;
    }
    function fromShareCode(text: string): { name: string; code: string } | null {
      try {
        const raw = text.trim();
        if (!raw.startsWith('pc1.')) return null;
        const clean = raw.slice(4).replace(/-/g, '+').replace(/_/g, '/');
        const binary = atob(clean + '='.repeat((4 - (clean.length % 4)) % 4));
        const data = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(Uint8Array.from(binary, (char) => char.charCodeAt(0))));
        if (!data || data.v !== 1 || typeof data.c !== 'string' || data.c.length > 10000) return null;
        const name = typeof data.n === 'string' ? data.n.toLowerCase().replace(/[^a-z0-9_-]/g, '').slice(0, 32) : '';
        return { name, code: data.c };
      } catch {
        return null;
      }
    }
    const generatorUrl = (root.dataset.generator || '').replace(/\/+$/, '');
    // Opens what is in the editor in the generator, in a new tab. With nothing written it just opens the generator.
    document.getElementById('cc-generator')?.addEventListener('click', () => {
      if (!generatorUrl) return;
      const url = code.value.trim()
        ? `${generatorUrl}/#/import?share=${encodeURIComponent(toShareCode(nameInput.value.trim().toLowerCase() || 'command', code.value))}`
        : `${generatorUrl}/`;
      window.open(url, '_blank', 'noopener');
    });

    // ── Start ──
    drawList();
    drawGutter();
    if (commands[0]) load(commands[0].name, commands[0].code, commands[0].triggerType, commands[0].triggerText);

    // A command sent from the Code Generator arrives in the URL fragment (#import=pc1...). It opens like a template:
    // a new command in the editor, not saved until Save is pressed.
    const importMatch = location.hash.match(/^#import=(.+)$/);
    if (importMatch) {
      let text = importMatch[1];
      try { text = decodeURIComponent(text); } catch { /* keep it as it came */ }
      const imported = fromShareCode(text);
      if (imported) {
        current = null; savedName = ''; deleteButton.hidden = true; nameInput.readOnly = false;
        nameInput.value = imported.name;
        code.value = imported.code;
        savedCode = '';
        showTrigger('command', '');
        result.hidden = true;
        errorLine = 0;
        drawGutter(); drawList(); syncBar(); checkNow();
        say(commands.some((entry) => entry.name === imported.name) ? ui.importedExists : ui.imported, 'ok');
      } else {
        say(ui.importBad, 'bad');
      }
      history.replaceState(null, '', location.pathname + location.search);
    }
    let metaStatus = 0;
    (async () => {
      try {
        const response = await fetch(endpoint, { signal: AbortSignal.timeout(20000), headers: { Accept: 'application/json' } });
        metaStatus = response.status;
        meta = await response.json();
      } catch { meta = null; }
      if (!meta?.ok) { setStatus('wait', `${ui.unavailable} ${why({ status: metaStatus, payload: meta })}`); return; }
      for (const template of meta.templates) { const option = document.createElement('option'); option.value = template.id; option.textContent = template.name; templates.appendChild(option); }
      if (Array.isArray(meta.functions) && meta.functions.length) functionNames = new Set(meta.functions.map((fn: any) => String(fn.name)));
      drawFunctions();
      drawGutter();
      if (!meta.canWrite) say(ui.closed, 'bad');
      if (code.value.trim()) checkNow();
    })();
  }
</script>

<style>
  .cc-title { display: flex; align-items: center; gap: 8px 12px; flex-wrap: wrap; margin: 0 0 18px; }
  h1 { font-size: 24px; margin: 0; }
  .cc-docs { display: inline-flex; align-items: center; gap: 6px; padding: 5px 11px; border: 1px solid var(--border); border-radius: 999px; background: var(--card); color: var(--text-muted); font-family: var(--sans); font-size: 12.5px; font-weight: 500; line-height: 1.2; text-decoration: none; transition: color var(--m-fast) var(--m-std), border-color var(--m-fast) var(--m-std), transform var(--m-fast) var(--m-out); }
  .cc-docs:hover { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
  .cc-docs:active { transform: scale(var(--m-press)); }
  .cc-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border: 1px solid var(--yellow); border-radius: 9px; padding: 10px 14px; margin-bottom: 16px; max-width: 640px; }
  .cc-grid { display: grid; grid-template-columns: minmax(min(220px, 100%), 280px) minmax(0, 1fr); gap: 20px; align-items: start; }
  @media (max-width: 960px) { .cc-grid { grid-template-columns: 1fr; } }
  .cc-side, .cc-main { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .cc-box { border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 16px; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .cc-box-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 13.5px; }
  .cc-box-head strong { display: inline-flex; align-items: center; gap: 6px; }
  .cc-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-end; }
  .cc-grow { flex: 1; min-width: 160px; }
  @media (max-width: 520px) { .cc-row > .cc-input { flex: 1 1 100%; } }
  .cc-field { display: flex; flex-direction: column; gap: 6px; }
  .cc-field > span:first-child { font-size: 12px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.03em; }
  .cc-prefixed { display: flex; align-items: center; gap: 8px; }
  .cc-prefixed code { font-family: var(--mono); font-size: 14px; color: var(--accent); background: transparent; border: 0; padding: 0; }
  .cc-prefixed .cc-input { flex: 1; }
  .cc-input { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; min-width: 0; }
  .cc-input:focus { outline: 2px solid var(--accent-soft); border-color: var(--accent); }
  .cc-input[readonly] { opacity: 0.7; }
  .cc-actions { display: flex; gap: 8px; }
  .cc-btn { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--border); background: var(--card); color: var(--text); border-radius: 8px; padding: 8px 12px; font: inherit; font-size: 13px; cursor: pointer; }
  .cc-btn:hover { border-color: var(--accent); }
  .cc-btn-small { padding: 4px 9px; font-size: 12px; }
  .cc-btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .cc-btn-danger { color: var(--red); }
  .cc-btn-danger:hover { border-color: var(--red); }
  [hidden] { display: none !important; }

  .cc-list, .cc-fns { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .cc-fns { max-height: 260px; overflow: auto; }
  /* The items of the lists are made by the script, so their rules are :global(). */
  :global(.cc-item), :global(.cc-fn) { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 8px; border: 1px solid transparent; background: transparent; color: var(--text); border-radius: 7px; padding: 6px 8px; font: inherit; font-size: 13px; cursor: pointer; text-align: left; }
  :global(.cc-item:hover), :global(.cc-fn:hover) { background: var(--border-soft); }
  :global(.cc-item.on) { background: color-mix(in srgb, var(--accent) 14%, transparent); border-color: var(--accent); }
  :global(.cc-item code), :global(.cc-fn code) { font-family: var(--mono); font-size: 12.5px; background: transparent; border: 0; padding: 0; color: inherit; }
  :global(.cc-fn span) { font-family: var(--mono); font-size: 11px; color: var(--text-dim); }
  .cc-empty, .cc-note, :global(li.cc-note) { font-size: 12px; color: var(--text-dim); margin: 0; line-height: 1.45; }

  .cc-toolbar { display: flex; align-items: center; gap: 8px 12px; flex-wrap: wrap; }
  .cc-insert { display: inline-flex; align-items: center; gap: 6px; color: var(--text-dim); }
  .cc-insert .cc-input { padding: 6px 8px; font-size: 13px; }
  .cc-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .cc-keys { flex: 1 1 220px; }
  @media (max-width: 640px) { .cc-keys { display: none; } }

  /* The editor: a clear textarea over the code with colors. Both use the same font, size, line height and padding. */
  .cc-editor-wrap { position: relative; }
  .cc-editor { display: flex; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: var(--bg-raise, var(--card)); min-height: 340px; }
  .cc-editor:focus-within { border-color: var(--accent); }
  .cc-gutter { flex: 0 0 auto; min-width: 42px; padding: 10px 8px 10px 10px; text-align: right; font-family: var(--mono); font-size: 13px; line-height: 20px; color: var(--text-dim); background: var(--border-soft); overflow: hidden; user-select: none; font-variant-numeric: tabular-nums; }
  .cc-gutter :global(.cc-err) { color: #fff; background: var(--red); border-radius: 4px; padding: 0 4px; margin-right: -4px; }
  .cc-area { position: relative; flex: 1; min-width: 0; overflow: hidden; display: flex; }
  .cc-layer { position: absolute; top: 0; left: 0; min-width: 100%; pointer-events: none; will-change: transform; }
