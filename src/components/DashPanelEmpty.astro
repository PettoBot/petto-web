---
// A friendly empty state for the lists of the dashboard pages outside a server: a soft icon and one short line (and an optional
// action in the slot). `hidden` lets a page script show it, e.g. when a search leaves nothing.
import { Icon } from 'astro-icon/components';
interface Props { text: string; icon?: string; id?: string; hidden?: boolean; tone?: 'muted' | 'error' }
const { text, icon = 'ph:sparkle-fill', id, hidden = false, tone = 'muted' } = Astro.props;
---
<div class:list={['dpe', { 'dpe-error': tone === 'error' }]} id={id} hidden={hidden}>
  <span class="dpe-icon" aria-hidden="true"><Icon name={icon} width="18" height="18" /></span>
  <p>{text}</p>
  {Astro.slots.has('default') && <div class="dpe-actions"><slot /></div>}
</div>

<style>
  .dpe { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 26px 18px; border: 1px dashed var(--border); border-radius: 16px; text-align: center; animation: m-fade-in var(--m-slow) var(--m-out) backwards; }
  .dpe[hidden] { display: none; }
  .dpe-icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--accent-soft); color: var(--accent); }
  .dpe p { margin: 0; max-width: 46ch; color: var(--text-dim); font-size: 13.5px; line-height: 1.5; }
  .dpe-error .dpe-icon { background: var(--red-soft); color: var(--red); }
  .dpe-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .dpe-actions :global(.btn) { display: inline-flex; align-items: center; gap: 6px; }
  @media (prefers-reduced-motion: reduce) { .dpe { animation: none; } }
</style>
