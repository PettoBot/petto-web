---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import { getDashLang, makeT } from '../i18n/dash';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  looks: Record<string, { name: string; avatarUrl: string }>;
  features: string[];
  ready: boolean;
  saved: boolean;
  failed: string;
}
const { user, guildId, guildName, guildIcon, looks, features, ready, saved, failed } = Astro.props;
const labels: Record<string, [string, string]> = {
  quests: ['Quest alerts', 'The alerts of new Quests and the quest method.'],
  welcome: ['Welcome messages', 'What is sent when someone joins.'],
  leave: ['Leave messages', 'What is sent when someone leaves.'],
  boost: ['Boost messages', 'What is sent when someone boosts the server.'],
  sanctions: ['Sanction messages', 'The public messages of bans, kicks, timeouts and warns.'],
  levelup: ['Level-up messages', 'What is sent when someone reaches a new level.'],
  vanity: ['Vanity and Server Tag messages', 'The thank-you when someone gets a role from a Vanity or Server Tag rule.'],
  giveaways: ['Giveaway messages', 'Winner announcements, claim messages and other giveaway replies.'],
  bump: ['Bump messages', 'The thank-you after a bump and the reminder for the next one.'],
  tickets: ['Ticket messages', 'The welcome, the claim notice and the closing card inside tickets.'],
  automod: ['Automod notices', 'The short notice when Petto removes a malicious link.'],
  partners: ['Partner welcomes', 'The welcome sent to a new partner manager.'],
  votes: ['Vote thank-yous', 'The thank-you when someone votes for the bot.'],
  reminders: ['Reminders', 'The reminders people ask Petto to send.'],
  automessages: ['Auto messages', 'The messages Petto sends by itself on a schedule.'],
  rollouts: ['Rollout alerts', 'The alerts of Discord rollouts in the channel you chose.'],
  birthdays: ['Birthday messages', 'The messages that celebrate a member\'s birthday.'],
};
const errors: Record<string, string> = {
  name: 'Discord does not accept a webhook name with "discord" or "clyde" in it.',
  avatar: 'The picture has to be a link that starts with https://.',
  empty: 'Write a name, a picture link, or both.',
  save: 'It could not be saved. Try again in a moment.',
};

// What the numbers on top say comes from the saved looks: a kind of message with a name or a picture of its own.
const own = features.filter((feature) => looks[feature].name || looks[feature].avatarUrl);
const withName = features.filter((feature) => looks[feature].name).length;
const withPicture = features.filter((feature) => looks[feature].avatarUrl).length;
const PETTO_PICTURE = '/assets/mascot-icon.webp';
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="senders" pageTitle="Message look">
  <DashSettingsKit />
  <DashFormKit />
  <div class="sx-page sd-page">
    <h1>{dt('Message look')}</h1>
    <p class="sd-lead">{dt('Choose the name and picture Petto uses when it sends each kind of message.')}</p>

    {saved && <div class="sx-flash" data-sd-flash><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
    {failed && <div class="sx-flash sx-flash-warn" data-sd-flash><Icon name="ph:warning-fill" width="15" height="15" />{dt(errors[failed] ?? errors.save)}</div>}
    {!ready && <div class="sx-flash sx-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}

    <DashStatTiles tiles={[
      { label: dt('With your look'), value: own.length, tone: 'messages' },
      { label: dt("With Petto's look"), value: features.length - own.length, tone: 'voice' },
      { label: dt('Own names'), value: withName, tone: 'invites' },
      { label: dt('Own pictures'), value: withPicture, tone: 'joins' },
    ]} />

    <div class="sd-bar">
      <div class="sx-chips" role="radiogroup" aria-label={dt('Show')}>
        <label class="sx-chip"><input type="radio" name="sd-filter" value="all" checked /><span>{dt('All')} · {features.length}</span></label>
        <label class="sx-chip"><input type="radio" name="sd-filter" value="own" /><span>{dt('With your look')} · {own.length}</span></label>
        <label class="sx-chip"><input type="radio" name="sd-filter" value="default" /><span>{dt("With Petto's look")} · {features.length - own.length}</span></label>
      </div>
    </div>

    <div class="sd-list dgl-stagger">
      {features.map((feature) => {
        const look = looks[feature];
        const custom = Boolean(look.name || look.avatarUrl);
        return (
          <details class="dfx-acc sd-item" data-feature={feature} data-own={custom ? '' : undefined}>
            <summary>
              <img class="sd-av" src={look.avatarUrl || PETTO_PICTURE} alt="" width="38" height="38" loading="lazy" />
              <span class="dfx-acc-title"><b>{dt(labels[feature][0])}</b><em>{look.name ? look.name : dt(labels[feature][1])}</em></span>
              {custom && <span class="sx-tag sx-tag-accent sd-tag">{dt('Your look')}</span>}
              <Icon name="ph:caret-down-bold" class="dfx-caret" width="14" height="14" />
            </summary>
            <div class="dfx-acc-body sd-body">
              <div class="sd-side">
                <p class="sx-hint">{dt(labels[feature][1])}</p>
                <div class="sd-prev" aria-hidden="true">
                  <img class="sd-av" src={look.avatarUrl || PETTO_PICTURE} alt="" width="38" height="38" loading="lazy" data-sd-img data-default={PETTO_PICTURE} />
                  <div class="sd-prev-main">
                    <div class="sd-prev-head"><b data-sd-name data-default="Petto">{look.name || 'Petto'}</b><span class="sd-app">APP</span></div>
                    <span class="sd-line" style="width:82%"></span>
                    <span class="sd-line" style="width:54%"></span>
                  </div>
                </div>
              </div>
              <form method="POST" class="sd-form">
                <input type="hidden" name="feature" value={feature} />
                <div class="sx-field">
                  <label for={`sd-name-${feature}`}>{dt('Name')}</label>
                  <textarea id={`sd-name-${feature}`} name="name" class="dgl-autogrow sx-one" rows="1" data-one-line data-count maxlength="80" placeholder={dt('Name (empty keeps Petto\'s)')}>{look.name}</textarea>
                </div>
                <div class="sx-field">
                  <label for={`sd-link-${feature}`}>{dt('Picture link')}</label>
                  <textarea id={`sd-link-${feature}`} name="avatar_url" class="dgl-autogrow sx-one" rows="1" data-one-line maxlength="500" inputmode="url" autocomplete="off" spellcheck="false" placeholder="https://…">{look.avatarUrl}</textarea>
                </div>
                <div class="sx-foot">
                  <button class="btn btn-accent btn-sm" type="submit" disabled={!ready}>{dt('Save')}</button>
                  {custom && <button class="btn btn-ghost btn-sm" type="submit" name="action" value="reset" formnovalidate>{dt('Use Petto\'s look')}</button>}
                </div>
              </form>
            </div>
          </details>
        );
      })}
    </div>
    {own.length === 0 && <p class="sx-empty sd-none sd-none-own"><Icon name="ph:user-circle-fill" width="18" height="18" />{dt('No kind of message has a look of its own yet.')}</p>}

    <p class="sd-note"><Icon name="ph:info-fill" width="14" height="14" />{dt('Petto needs Manage Webhooks in the channel; without it the message is sent the normal way.')}</p>
  </div>

  <script is:inline>
    (function () {
      // After a save the page is drawn again with every row folded: the row that was saved opens again, so its message is seen in place.
      // The listeners are on the document and set once; the page is checked every time it is shown.
      function openSaved() {
        var flash = document.querySelector('[data-sd-flash]'); var stamp = 0; var feature = '';
        try { var raw = (sessionStorage.getItem('sdOpen') || '').split('|'); feature = raw[0]; stamp = Number(raw[1]) || 0; sessionStorage.removeItem('sdOpen'); } catch (e) { /* no storage */ }
        if (!flash || !feature || Date.now() - stamp > 20000) return;
        var row = document.querySelector('.sd-item[data-feature="' + feature.replace(/"/g, '') + '"]');
        if (row) { row.open = true; if (row.scrollIntoView) row.scrollIntoView({ block: 'nearest' }); }
      }
      if (!window.__sdBound) {
        window.__sdBound = true;
        document.addEventListener('submit', function (event) {
          var form = event.target;
          if (!form || !form.classList || !form.classList.contains('sd-form')) return;
          var feature = form.querySelector('input[name="feature"]');
          try { if (feature) sessionStorage.setItem('sdOpen', feature.value + '|' + Date.now()); } catch (e) { /* no storage */ }
        }, true);
        // The little preview follows what is typed: the name at once, the picture once its link is set.
        document.addEventListener('input', function (event) {
          var field = event.target;
          if (!field || !field.matches || !field.matches('.sd-form textarea[name="name"]')) return;
          var name = field.closest('.sd-body').querySelector('[data-sd-name]');
          if (name) name.textContent = field.value.trim() || name.getAttribute('data-default');
        });
        document.addEventListener('change', function (event) {
          var field = event.target;
          if (!field || !field.matches || !field.matches('.sd-form textarea[name="avatar_url"]')) return;
          var img = field.closest('.sd-body').querySelector('[data-sd-img]');
          if (!img) return;
          var link = field.value.trim();
          img.src = /^https:\/\//i.test(link) ? link : img.getAttribute('data-default');
        });
        // A picture that does not load shows Petto's.
        document.addEventListener('error', function (event) {
          var img = event.target;
          if (!img || !img.classList || !img.classList.contains('sd-av') || img.dataset.fallback) return;
          img.dataset.fallback = '1';
          img.src = '/assets/mascot-icon.webp';
        }, true);
      }
      openSaved();
    })();
  </script>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  .sd-lead { margin: 0 0 16px; font-size: 13.5px; line-height: 1.5; color: var(--text-muted); max-width: 70ch; }
  .sd-bar { margin: 0 0 14px; }

  .sd-list { display: flex; flex-direction: column; gap: 8px; }
  .sd-item > summary { gap: 12px; padding: 11px 14px; }
  .sd-item .dfx-acc-title b, .sd-item .dfx-acc-title em { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sd-item[data-own] { border-color: color-mix(in srgb, var(--accent) 30%, var(--border)); }
  .sd-tag { flex: none; max-width: 40%; overflow: hidden; text-overflow: ellipsis; }
  .sd-av { flex: none; width: 38px; height: 38px; border-radius: 50%; object-fit: cover; background: var(--bg-raise); }
  .sd-body { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 18px; align-items: start; padding-top: 2px; }
  .sd-side { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .sd-side .sx-hint { margin: 0; }
  .sd-item:not([open]) > .dfx-acc-body { visibility: hidden; transition: visibility 0s 0.45s; }

  /* A message as Discord draws it: the picture, the name with its APP mark, and two grey lines for the text. */
  .sd-prev { display: flex; align-items: flex-start; gap: 12px; padding: 12px 14px; border-radius: 12px; background: var(--bg); border: 1px solid var(--border-soft); min-width: 0; }
  .sd-prev-main { display: flex; flex-direction: column; gap: 7px; min-width: 0; flex: 1; }
  .sd-prev-head { display: flex; align-items: center; gap: 7px; min-width: 0; }
  .sd-prev-head b { font-size: 14px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sd-app { flex: none; font-size: 10px; font-weight: 700; letter-spacing: 0.02em; color: #fff; background: #5865f2; border-radius: 4px; padding: 1px 5px; }
  .sd-line { display: block; height: 8px; border-radius: 4px; background: color-mix(in srgb, var(--text) 12%, transparent); }

  .sd-form { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .sd-form .btn { display: inline-flex; align-items: center; justify-content: center; }
  /* The dashboard puts Save in its bar of unsaved changes and hides this one: nothing is left of the row when the look is Petto's. */
  .sd-form .sx-foot:not(:has(> .btn:not(.dgl-bar-save))) { display: none; }

  /* The filter chips work without a script: the row of a kind that is not asked for is not drawn. */
  .sd-page:has(input[name="sd-filter"][value="own"]:checked) .sd-item:not([data-own]),
  .sd-page:has(input[name="sd-filter"][value="default"]:checked) .sd-item[data-own] { display: none; }
  .sd-none { display: none; margin: 0 0 14px; }
  .sd-page:has(input[name="sd-filter"][value="own"]:checked) .sd-none-own { display: flex; }

  .sd-note { display: flex; align-items: flex-start; gap: 8px; margin: 16px 0 0; font-size: 12.5px; line-height: 1.5; color: var(--text-dim); }
  .sd-note :global(svg) { flex: none; margin-top: 2px; }

  @media (max-width: 720px) {
    .sd-body { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .sd-tag { max-width: 34%; }
  }
</style>
