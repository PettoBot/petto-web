---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import { getDashLang, makeT } from '../i18n/dash';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  looks: Record<string, { name: string; avatarUrl: string }>;
  features: string[];
  ready: boolean;
  saved: boolean;
  failed: string;
}
const { user, guildId, guildName, guildIcon, looks, features, ready, saved, failed } = Astro.props;
const labels: Record<string, [string, string]> = {
  quests: ['Quest alerts', 'The alerts of new Quests and the quest method.'],
  welcome: ['Welcome messages', 'What is sent when someone joins.'],
  leave: ['Leave messages', 'What is sent when someone leaves.'],
  boost: ['Boost messages', 'What is sent when someone boosts the server.'],
  sanctions: ['Sanction messages', 'The public messages of bans, kicks, timeouts and warns.'],
  levelup: ['Level-up messages', 'What is sent when someone reaches a new level.'],
  vanity: ['Vanity and Server Tag messages', 'The thank-you when someone gets a role from a Vanity or Server Tag rule.'],
  giveaways: ['Giveaway messages', 'Winner announcements, claim messages and other giveaway replies.'],
  bump: ['Bump messages', 'The thank-you after a bump and the reminder for the next one.'],
  tickets: ['Ticket messages', 'The welcome, the claim notice and the closing card inside tickets.'],
  automod: ['Automod notices', 'The short notice when Petto removes a malicious link.'],
  partners: ['Partner welcomes', 'The welcome sent to a new partner manager.'],
  votes: ['Vote thank-yous', 'The thank-you when someone votes for the bot.'],
  reminders: ['Reminders', 'The reminders people ask Petto to send.'],
  automessages: ['Auto messages', 'The messages Petto sends by itself on a schedule.'],
  rollouts: ['Rollout alerts', 'The alerts of Discord rollouts in the channel you chose.'],
  birthdays: ['Birthday messages', 'The messages that celebrate a member\'s birthday.'],
};
const errors: Record<string, string> = {
  name: 'Discord does not accept a webhook name with "discord" or "clyde" in it.',
  avatar: 'The picture has to be a link that starts with https://.',
  empty: 'Write a name, a picture link, or both.',
  save: 'It could not be saved. Try again in a moment.',
};
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="senders" pageTitle="Message look">
  <h1>{dt('Message look')}</h1>
  {saved && <div class="sd-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {failed && <div class="sd-flash sd-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt(errors[failed] ?? errors.save)}</div>}
  {!ready && <div class="sd-flash sd-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}
  <div class="sd-list dgl-stagger">
    {features.map((feature) => (
      <section class="sd-card">
        <div class="sd-head">
          {looks[feature].avatarUrl ? <img src={looks[feature].avatarUrl} alt="" width="40" height="40" /> : <span class="sd-ph" aria-hidden="true"><Icon name="ph:user-circle-fill" width="26" height="26" /></span>}
          <div><b>{dt(labels[feature][0])}</b><span>{dt(labels[feature][1])}</span></div>
        </div>
        <form method="POST" class="sd-form">
          <input type="hidden" name="feature" value={feature} />
          <input type="text" name="name" value={looks[feature].name} maxlength="80" placeholder={dt('Name (empty keeps Petto\'s)')} aria-label={dt('Name')} />
          <input type="url" name="avatar_url" value={looks[feature].avatarUrl} maxlength="500" placeholder="https://…" aria-label={dt('Picture link')} />
          <button class="btn btn-accent btn-sm" type="submit" disabled={!ready}>{dt('Save')}</button>
          {(looks[feature].name || looks[feature].avatarUrl) && <button class="btn btn-ghost btn-sm" type="submit" name="action" value="reset" formnovalidate>{dt('Use Petto\'s look')}</button>}
        </form>
      </section>
    ))}
  </div>
  <p class="sd-note"><Icon name="ph:info-fill" width="13" height="13" />{dt('Petto needs Manage Webhooks in the channel; without it the message is sent the normal way.')}</p>
</DashGuildLayout>

<style>
  .sd-note { display: flex; align-items: center; gap: 7px; margin: 18px 0 0; font-size: 12.5px; color: var(--text-dim); }
  h1 { font-size: 24px; margin: 0 0 20px; }
  .sd-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 16px; max-width: 760px; }
  .sd-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: var(--yellow); }
  /* Two columns of cards (one on a phone): the look of each kind of message, with its own small form. */
  .sd-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(380px, 100%), 1fr)); gap: 12px; max-width: 1000px; align-items: start; }
  .sd-card { border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 16px; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .sd-head { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .sd-head img, .sd-ph { width: 40px; height: 40px; border-radius: 50%; flex: none; object-fit: cover; background: var(--bg-raise); display: grid; place-items: center; color: var(--text-dim); }
  .sd-head b { display: block; font-size: 14.5px; }
  .sd-head span:not(.sd-ph) { font-size: 12.5px; color: var(--text-dim); }
  .sd-form { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .sd-form input { flex: 1 1 200px; border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; min-width: 0; }
</style>
