---
// The long lists of the dashboard (roles, channels, members) open as a small menu under the field instead of the browser's own list, which
// fills the whole screen on a phone. The real <select> stays in the page and keeps the value, so every form and script that reads it works as before.
// On a phone every select opens this menu, even a short one: the phone's own list is a grey sheet that covers the screen.
// A select that should keep the browser's own list carries `data-native`; the React editors (inside astro-island) keep theirs.
---
<script is:inline>
  (function () {
    if (window.__dglSelectMenu) return;
    window.__dglSelectMenu = true;
    // With a mouse, short lists keep the browser's own small list; on a touch screen every list uses this menu.
    var TOUCH = !!(window.matchMedia && window.matchMedia('(pointer: coarse)').matches);
    var MIN_OPTIONS = TOUCH ? 1 : 6;
    var SEARCH_FROM = 12;
    var menu = null;
    var current = null;

    function eligible(select) {
      return select && select.tagName === 'SELECT' && !select.multiple && !select.disabled && !select.hasAttribute('data-native') && select.options.length >= MIN_OPTIONS && !select.closest('[data-native]') && !select.closest('astro-island');
    }
    function close() {
      // The menu fades out where it is (dglMotion, DashMotion.astro) and is removed after; a new one can open meanwhile.
      if (menu) { var gone = menu; menu = null; if (window.dglMotion) window.dglMotion.leave(gone, function () { gone.remove(); }); else gone.remove(); }
      if (current) current.removeAttribute('data-menu-open');
      current = null;
    }
    function choose(select, option) {
      if (option.disabled) return;
      select.value = option.value;
      select.dispatchEvent(new Event('input', { bubbles: true }));
      select.dispatchEvent(new Event('change', { bubbles: true }));
    }
    function open(select) {
      close();
      current = select;
      select.setAttribute('data-menu-open', '');
      var rect = select.getBoundingClientRect();
      menu = document.createElement('div');
      menu.className = 'dgl-selmenu';
      menu.setAttribute('role', 'listbox');
      var search = null;
      if (select.options.length >= SEARCH_FROM) {
        search = document.createElement('input');
        search.type = 'text';
        search.className = 'dgl-selmenu-search';
        search.autocomplete = 'off';
        search.placeholder = (window.cdt ? window.cdt('Search...') : 'Search...');
        menu.appendChild(search);
      }
      var list = document.createElement('div');
      list.className = 'dgl-selmenu-list';
      menu.appendChild(list);
      var items = [];
      var lastGroup = null;
      Array.prototype.forEach.call(select.options, function (option) {
        var group = option.parentNode && option.parentNode.tagName === 'OPTGROUP' ? option.parentNode.label : '';
        if (group && group !== lastGroup) {
          var head = document.createElement('div');
          head.className = 'dgl-selmenu-group';
          head.textContent = group;
          list.appendChild(head);
          items.push({ el: head, text: '', group: true });
        }
        lastGroup = group;
        var row = document.createElement('button');
        row.type = 'button';
        row.className = 'dgl-selmenu-opt';
        row.setAttribute('role', 'option');
        // An option with a note (a channel Petto cannot post in) shows its name as it is and the note under it, in red.
        var note = option.getAttribute('data-note');
        if (note) {
          var name = document.createElement('span');
          name.className = 'dgl-selmenu-name';
          name.textContent = option.textContent;
          var why = document.createElement('span');
          why.className = 'dgl-selmenu-note';
          why.textContent = note;
          row.appendChild(name);
          row.appendChild(why);
        } else row.textContent = option.textContent;
        if (option.disabled) row.disabled = true;
        if (option.selected) { row.classList.add('on'); row.setAttribute('aria-selected', 'true'); }
        row.addEventListener('click', function () { choose(select, option); close(); select.focus({ preventScroll: true }); });
        list.appendChild(row);
        items.push({ el: row, text: option.textContent.toLowerCase(), group: false });
      });
      if (search) {
        search.addEventListener('input', function () {
          var q = search.value.trim().toLowerCase();
          items.forEach(function (item) { item.el.hidden = item.group ? !!q : !!q && item.text.indexOf(q) === -1; });
        });
      }
      document.body.appendChild(menu);
      openWidth = window.innerWidth;
      var width = Math.max(rect.width, 220);
      var left = Math.min(Math.max(8, rect.left), Math.max(8, window.innerWidth - width - 8));
      var below = window.innerHeight - rect.bottom - 12;
      var above = rect.top - 12;
      // Under the field when there is room for a good list there, otherwise on the side with more room. A field so close to an edge that
      // neither side has room (a window on a phone, with the keyboard or the browser bars taking the rest) gets the menu over the
      // whole screen height instead of a list of four or five rows.
      var up = below < 320 && above > below;
      var room = up ? above : below;
      var pinned = room < 220;
      var maxHeight = pinned ? Math.max(180, window.innerHeight - 16) : Math.min(380, room);
      if (up && !pinned) menu.classList.add('up');
      menu.style.cssText = 'left:' + left + 'px;width:' + width + 'px;max-height:' + maxHeight + 'px;' + (pinned ? 'top:8px;' : up ? 'bottom:' + (window.innerHeight - rect.top + 4) + 'px;' : 'top:' + (rect.bottom + 4) + 'px;');
      var on = list.querySelector('.on');
      if (on) on.scrollIntoView({ block: 'center' });
      if (search && window.matchMedia && window.matchMedia('(pointer: fine)').matches) search.focus({ preventScroll: true });
    }

    // The same note under the field while the chosen option has one (a closed list only shows the name). Drawn again by the page after each
    // change and, for the content a page just drew, by dglSelectNotes (the layout calls it).
    function syncNote(select) {
      if (!select || select.tagName !== 'SELECT' || select.multiple) return;
      var option = select.options[select.selectedIndex];
      var text = option ? option.getAttribute('data-note') : '';
      var next = select.nextElementSibling;
      var note = next && next.classList && next.classList.contains('dgl-sel-note') ? next : null;
      if (!text) { if (note) note.remove(); return; }
      if (!note) {
        note = document.createElement('div');
        note.className = 'dgl-sel-note';
        note.setAttribute('role', 'note');
        select.insertAdjacentElement('afterend', note);
      }
      note.textContent = text;
    }
    window.dglSelectNotes = function (root) {
      Array.prototype.forEach.call((root || document).querySelectorAll('select option[data-note]'), function (option) { syncNote(option.parentNode && option.parentNode.tagName === 'OPTGROUP' ? option.parentNode.parentNode : option.parentNode); });
    };
    document.addEventListener('change', function (event) { syncNote(event.target); });

    // On a touch screen the phone opens its own list when the finger lifts, so the tap is taken there (a finger that moved was a scroll).
    var touchStart = null;
    document.addEventListener('touchstart', function (event) {
      var t = event.touches && event.touches[0];
      touchStart = t ? { x: t.clientX, y: t.clientY } : null;
    }, { capture: true, passive: true });
    document.addEventListener('touchend', function (event) {
      var select = event.target && event.target.closest ? event.target.closest('select') : null;
      if (!eligible(select)) return;
      var t = event.changedTouches && event.changedTouches[0];
      if (touchStart && t && (Math.abs(t.clientX - touchStart.x) > 10 || Math.abs(t.clientY - touchStart.y) > 10)) return;
      event.preventDefault();
      if (current === select) { close(); return; }
      open(select);
    }, { capture: true, passive: false });
    function typingInMenu() {
      var active = document.activeElement;
      return !!(menu && active && menu.contains(active));
    }

    document.addEventListener('mousedown', function (event) {
      var select = event.target && event.target.closest ? event.target.closest('select') : null;
      if (menu && !(event.target.closest && event.target.closest('.dgl-selmenu')) && select !== current) close();
      if (!eligible(select)) return;
      event.preventDefault();
      if (current === select) { close(); return; }
      open(select);
    }, true);
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && menu) { close(); return; }
      var select = event.target && event.target.tagName === 'SELECT' ? event.target : null;
      if (!eligible(select)) return;
      if (event.key === 'Enter' || event.key === ' ' || (event.altKey && event.key === 'ArrowDown')) { event.preventDefault(); open(select); }
    }, true);
    // The phone's keyboard (typing in the search box) resizes and scrolls the page: that must not close the menu.
    // Only a change of width closes it: scrolling a list on a phone shows and hides the browser's address bar, which changes the height.
    var openWidth = window.innerWidth;
    window.addEventListener('resize', function () { if (typingInMenu()) return; if (menu && window.innerWidth === openWidth) return; close(); });
    document.addEventListener('scroll', function (event) { if (menu && !typingInMenu() && !(event.target && event.target.closest && event.target.closest('.dgl-selmenu'))) close(); }, true);
    document.addEventListener('touchstart', function (event) {
      if (menu && !(event.target && event.target.closest && (event.target.closest('.dgl-selmenu') || event.target.closest('select') === current))) close();
    }, { capture: true, passive: true });
  })();
</script>
<style is:global>
  .dgl-selmenu { position: fixed; z-index: 1000; display: flex; flex-direction: column; overflow: hidden; border-radius: 12px; border: 1px solid var(--border); background: var(--card, #1f2128); box-shadow: 0 12px 32px rgba(0, 0, 0, .35); }
  .dgl-selmenu-search { flex: none; margin: 8px; padding: 8px 10px; border-radius: 8px; border: 1px solid var(--border); background: transparent; color: var(--text); font: inherit; font-size: .88rem; }
  .dgl-selmenu-list { overflow-y: auto; overscroll-behavior: contain; padding: 4px; }
  .dgl-selmenu-group { padding: 8px 10px 4px; font-size: .7rem; letter-spacing: .04em; text-transform: uppercase; opacity: .6; }
  .dgl-selmenu-opt { display: block; width: 100%; padding: 8px 10px; min-height: 40px; border: 0; border-radius: 8px; background: transparent; color: var(--text); font: inherit; font-size: .88rem; text-align: left; cursor: pointer; }
  .dgl-selmenu-opt:hover, .dgl-selmenu-opt:focus-visible { background: var(--card-hover, rgba(255, 255, 255, .07)); outline: none; }
  .dgl-selmenu-opt.on { color: var(--accent); font-weight: 600; }
  @media (pointer: coarse) { .dgl-selmenu-search { font-size: 16px; } .dgl-selmenu-opt { padding: 11px 12px; font-size: 15px; } }
  .dgl-selmenu [hidden] { display: none; }
  .dgl-selmenu-opt:disabled { opacity: .45; cursor: not-allowed; }
  .dgl-selmenu-opt { overflow-wrap: anywhere; }
  .dgl-selmenu-name { display: block; }
  .dgl-selmenu-note, .dgl-sel-note { display: block; margin-top: 2px; color: var(--red, #f87171); font-size: .76rem; font-weight: 500; line-height: 1.35; overflow-wrap: anywhere; }
  .dgl-sel-note { margin-top: 4px; }
</style>
