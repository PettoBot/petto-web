---
// The look of the statistics charts that src/utils/statsChart.mjs draws: the public stats page and the dashboard's per-server statistics
// carry this one set of rules, so a chart looks the same in both. The color of a chart is `--c` on its plot box.
---
<style is:global>
  .sc-plot { display: block; width: 100%; }
  .sc-plot svg { display: block; max-width: 100%; overflow: visible; }
  .sc-fluid svg { width: 100%; height: auto; }
  .sc-grid { stroke: var(--border); stroke-dasharray: 3 5; }
  .sc-grid-zero { stroke-dasharray: none; stroke: color-mix(in srgb, var(--text-dim) 55%, var(--border)); }
  .sc-axis { fill: var(--text-dim); font-size: 11.5px; font-family: var(--mono); }
  .sc-axis-today { fill: var(--text-muted); }
  .sc-line { fill: none; stroke: var(--c); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .sc-area { fill: color-mix(in srgb, var(--c) 16%, transparent); stroke: none; }
  .sc-end { fill: var(--c); stroke: var(--card); stroke-width: 2; }
  /* Not a plain measurement (today so far, or days rebuilt afterwards): a dashed line, and an open end for today. */
  .sc-line-dash { stroke-dasharray: 5 4.5; stroke-linecap: butt; stroke-width: 2.2; }
  .sc-dot { fill: var(--c); stroke: var(--card); stroke-width: 1.6; }
  .sc-hollow { fill: var(--card); stroke: var(--c); stroke-width: 2.4; }
  .sc-bar { fill: var(--c); transform-box: fill-box; transform-origin: bottom; transition: filter .15s; }
  .sc-bar-neg { fill: var(--chart-red); transform-origin: top; }
  .sc-bar-dim { fill: color-mix(in srgb, var(--c) 45%, transparent); }
  .sc-bar-lit { fill: var(--accent); }
  .sc-bar-partial { fill: color-mix(in srgb, var(--c) 22%, var(--card)); stroke: var(--c); stroke-width: 1.6; stroke-dasharray: 3.5 3; }
  .sc-bar-neg.sc-bar-partial { fill: color-mix(in srgb, var(--chart-red) 22%, var(--card)); stroke: var(--chart-red); }
  .sc-bar:hover { filter: brightness(1.18); }
  .sc-draw .sc-line:not(.sc-line-dash) { stroke-dasharray: 1; stroke-dashoffset: 1; animation: scDraw 0.9s cubic-bezier(.16, 1, .3, 1) forwards; }
  .sc-draw .sc-area, .sc-draw .sc-line-dash, .sc-draw .sc-dot { opacity: 0; animation: scFade .6s ease-out .3s forwards; }
  .sc-draw .sc-end { opacity: 0; animation: scFade .3s ease-out .8s forwards; }
  .sc-draw .sc-bar { animation: scGrow .6s cubic-bezier(.2, .8, .2, 1) both; animation-delay: var(--d, 0ms); }
  @keyframes scDraw { to { stroke-dashoffset: 0; } }
  @keyframes scFade { to { opacity: 1; } }
  @keyframes scGrow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @media (prefers-reduced-motion: reduce) {
    .sc-draw .sc-line:not(.sc-line-dash), .sc-draw .sc-area, .sc-draw .sc-line-dash, .sc-draw .sc-end, .sc-draw .sc-dot, .sc-draw .sc-bar { animation: none; opacity: 1; stroke-dashoffset: 0; transform: none; }
  }
</style>
