---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import DashPanelHead from './DashPanelHead.astro';
import DashPanelEmpty from './DashPanelEmpty.astro';
import { getDashLang, makeT } from '../i18n/dash';
import { CREDIT_KINDS, type CreditRow } from '../utils/credits';

const dt = makeT(getDashLang(Astro));
interface Props { credits: CreditRow[]; custom: boolean; error?: string; saved?: boolean }
const { credits, custom, error, saved = false } = Astro.props;

const kindLabels: Record<string, string> = {
  people: dt('People'), features: dt('Features'), data: dt('Data sources'), systems: dt('Systems'), tools: dt('Tools and libraries'), art: dt('Art and icons'), other: dt('And more'),
};
const errors: Record<string, string> = {
  invalid: dt('That request was not valid.'),
  name: dt('Write the name of the credit.'),
  url: dt('The link has to start with https://.'),
  logo: dt('The logo link has to start with https://.'),
  invite: dt('That invite could not be read, or its server has no icon. Paste a direct link to the picture instead.'),
  album: dt('An Imgur album cannot be used. Open the picture and copy its link (i.imgur.com/...).'),
  full: dt('There can be up to 300 credits.'),
  database: dt('The database did not accept the change. Try again.'),
  not_configured: dt('The dashboard is not connected to the bot database.'),
};
const groups = CREDIT_KINDS.map((kind) => ({ kind, items: credits.filter((credit) => credit.kind === kind) }));
---

<Base title={dt('Credits · Petto')} active="dash" showFooter>
  <main>
    <section class="pe-sec">
      <div class="wrap pe-wrap">
        <DashPanelHead title={dt('Credits')} eyebrow={dt('Team view')} icon="ph:heart-fill">
          <a class="btn btn-ghost btn-sm" href="/credits" target="_blank" rel="noopener"><Icon name="ph:arrow-square-out" width="14" height="14" /> {dt('See the page')}</a>
        </DashPanelHead>

        {error && <div class="pe-alert error"><Icon name="ph:warning-fill" width="17" height="17" /> {errors[error] ?? errors.invalid}</div>}
        {saved && !error && <div class="pe-alert success"><Icon name="ph:check-circle-fill" width="17" height="17" /> {dt('Saved.')}</div>}

        {!custom && (
          <div class="pe-banner">
            <p>{dt('The page shows the original list. Start editing to save it, then change it as you like.')}</p>
            <form method="POST" data-no-dirty><input type="hidden" name="action" value="start" /><button class="btn btn-primary btn-sm" type="submit"><Icon name="ph:pencil-simple-fill" width="14" height="14" /> {dt('Start editing')}</button></form>
          </div>
        )}

        {custom && (
          <details class="pe-card pe-add" open={credits.length === 0}>
            <summary><Icon name="ph:plus-circle-fill" width="16" height="16" /> {dt('Add a credit')}</summary>
            <form method="POST" class="pe-form" data-no-dirty>
              <input type="hidden" name="action" value="add" />
              <label>{dt('Type')}<select name="kind">{CREDIT_KINDS.map((kind) => <option value={kind}>{kindLabels[kind]}</option>)}</select></label>
              <label>{dt('Name')}<input name="name" maxlength="80" required /></label>
              <label>{dt('Link (optional)')}<input name="url" type="url" placeholder="https://…" maxlength="300" /></label>
              <label>{dt('Logo link (optional)')}<input name="logo_url" type="url" placeholder="https://…" maxlength="400" /><small>{dt('A link to the picture (.png, .jpg, .webp), an Imgur link, or a Discord invite to use the icon of its server.')}</small></label>
              <label class="wide">{dt('Description (English)')}<textarea name="description_en" rows="2" maxlength="600"></textarea></label>
              <label class="wide">{dt('Description (Spanish, optional)')}<textarea name="description_es" rows="2" maxlength="600"></textarea></label>
              <label class="wide">{dt('Description (Portuguese, optional)')}<textarea name="description_pt" rows="2" maxlength="600"></textarea></label>
              <button class="btn btn-primary btn-sm" type="submit">{dt('Add')}</button>
            </form>
          </details>
        )}

        {custom && groups.map((group) => group.items.length > 0 && (
          <div class="pe-group">
            <h2>{kindLabels[group.kind]} <span>{group.items.length}</span></h2>
            <div class="pe-list dgl-stagger">
            {group.items.map((credit) => (
              <details class:list={['pe-card', { 'pe-hidden': !credit.visible }]}>
                <summary>
                  {credit.logo_url ? <img src={credit.logo_url} alt="" width="28" height="28" /> : <span class="pe-letter">{credit.name.slice(0, 1).toUpperCase()}</span>}
                  <span class="pe-sum"><b>{credit.name}</b>{credit.description_en && <small>{credit.description_en}</small>}</span>
                  {!credit.visible && <i class="pe-tag pe-tag-off">{dt('Hidden')}</i>}
                  <Icon name="ph:caret-down" width="14" height="14" class="pe-caret" />
                </summary>
                <form method="POST" class="pe-form">
                  <input type="hidden" name="action" value="update" /><input type="hidden" name="id" value={credit.id} />
                  <label>{dt('Type')}<select name="kind">{CREDIT_KINDS.map((kind) => <option value={kind} selected={kind === credit.kind}>{kindLabels[kind]}</option>)}</select></label>
                  <label>{dt('Name')}<input name="name" value={credit.name} maxlength="80" required /></label>
                  <label>{dt('Link (optional)')}<input name="url" type="url" value={credit.url ?? ''} maxlength="300" /></label>
                  <label>{dt('Logo link (optional)')}<input name="logo_url" type="url" value={credit.logo_url ?? ''} maxlength="400" /><small>{dt('A link to the picture (.png, .jpg, .webp), an Imgur link, or a Discord invite to use the icon of its server.')}</small></label>
                  <label class="wide">{dt('Description (English)')}<textarea name="description_en" rows="2" maxlength="600">{credit.description_en}</textarea></label>
                  <label class="wide">{dt('Description (Spanish, optional)')}<textarea name="description_es" rows="2" maxlength="600">{credit.description_es}</textarea></label>
                  <label class="wide">{dt('Description (Portuguese, optional)')}<textarea name="description_pt" rows="2" maxlength="600">{credit.description_pt}</textarea></label>
                  <button class="btn btn-primary btn-sm" type="submit" data-keep>{dt('Save')}</button>
                </form>
                <div class="pe-row-actions">
                  <form method="POST" data-no-dirty><input type="hidden" name="id" value={credit.id} /><button class="btn btn-ghost btn-sm" name="action" value="up" type="submit"><Icon name="ph:arrow-up" width="13" height="13" /> {dt('Up')}</button></form>
                  <form method="POST" data-no-dirty><input type="hidden" name="id" value={credit.id} /><button class="btn btn-ghost btn-sm" name="action" value="down" type="submit"><Icon name="ph:arrow-down" width="13" height="13" /> {dt('Down')}</button></form>
                  <form method="POST" data-no-dirty><input type="hidden" name="id" value={credit.id} /><button class="btn btn-ghost btn-sm" name="action" value="toggle" type="submit">{credit.visible ? dt('Hide') : dt('Show')}</button></form>
                  <form method="POST" data-no-dirty onsubmit="return confirm(this.dataset.ask)" data-ask={dt('Remove this credit?')}><input type="hidden" name="id" value={credit.id} /><button class="btn btn-ghost btn-sm pe-danger" name="action" value="remove" type="submit"><Icon name="ph:trash" width="13" height="13" /> {dt('Remove')}</button></form>
                </div>
              </details>
            ))}
            </div>
          </div>
        ))}
        {custom && credits.length === 0 && <DashPanelEmpty icon="ph:heart-fill" text={dt('Nothing here yet. Add the first one above.')} />}

        {custom && (
          <form method="POST" class="pe-reset" data-no-dirty onsubmit="return confirm(this.dataset.ask)" data-ask={dt('Delete every saved credit and go back to the original list?')}>
            <input type="hidden" name="action" value="reset" />
            <button class="btn btn-ghost btn-sm pe-danger" type="submit">{dt('Go back to the original list')}</button>
          </form>
        )}
      </div>
    </section>
  </main>
</Base>

<style>
  .pe-sec { padding: 40px 0 72px; }
  .pe-wrap { max-width: 860px; min-width: 0; }
  .pe-alert { display: flex; align-items: center; gap: 8px; border-radius: 12px; padding: 11px 14px; font-size: 13.5px; margin-bottom: 14px; border: 1px solid; animation: m-rise-in var(--m-slow) var(--m-out) both; }
  .pe-alert.error { color: var(--red, #fe6465); border-color: currentColor; background: color-mix(in srgb, currentColor 10%, transparent); }
  .pe-alert.success { color: var(--green); border-color: var(--green); background: var(--green-soft); }
  .pe-banner { display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap; border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 14px 16px; margin-bottom: 16px; }
  .pe-banner p { margin: 0; font-size: 13.5px; color: var(--text-muted); }
  .pe-card { border: 1px solid var(--border); border-radius: 14px; background: var(--card); margin-bottom: 8px; min-width: 0; transition: border-color var(--m-base) ease; }
  .pe-card:hover, .pe-card[open] { border-color: color-mix(in srgb, var(--text-dim) 45%, var(--border)); }
  .pe-add { margin-bottom: 6px; }
  .pe-add > summary { color: var(--accent); font-weight: 600; }
  .pe-card > summary { display: flex; align-items: center; gap: 10px; padding: 12px 16px; cursor: pointer; list-style: none; font-size: 14.5px; }
  .pe-card > summary::-webkit-details-marker { display: none; }
  .pe-card > summary:focus-visible { outline-offset: -2px; border-radius: 13px; }
  .pe-sum { display: flex; flex-direction: column; min-width: 0; flex: 0 1 auto; }
  .pe-sum b, .pe-sum small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pe-sum small { margin-top: 1px; color: var(--text-dim); font-size: 12px; }
  .pe-tag { flex: none; }
  .pe-card :global(.pe-caret) { flex: none; margin-left: auto; color: var(--text-dim); transition: transform var(--m-base) var(--m-out); }
  .pe-card[open] > summary :global(.pe-caret) { transform: rotate(180deg); }
  .pe-card summary img, .pe-letter { width: 28px; height: 28px; border-radius: 8px; object-fit: cover; flex: none; }
  .pe-letter { display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); font-weight: 700; font-size: 13px; }
  .pe-tag { font-style: normal; font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: .05em; padding: 3px 8px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }
  .pe-tag-off { background: color-mix(in srgb, var(--yellow) 14%, transparent); color: var(--yellow); }
  .pe-hidden { opacity: .65; }
  .pe-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 12px; padding: 4px 16px 14px; min-width: 0; }
  .pe-form label { display: flex; flex-direction: column; gap: 5px; font-size: 12.5px; color: var(--text-muted); min-width: 0; }
  .pe-form small { font-size: 11.5px; color: var(--text-dim); line-height: 1.4; }
  .pe-form .wide, .pe-form .check, .pe-form button { grid-column: 1 / -1; }
  .pe-form .check { flex-direction: row; align-items: center; gap: 8px; }
  .pe-form button { justify-self: start; }
  .pe-form input:not([type='checkbox']), .pe-form select, .pe-form textarea { width: 100%; min-width: 0; max-width: 100%; box-sizing: border-box; resize: vertical; font: inherit; font-size: 13.5px; padding: 9px 11px; border-radius: 9px; border: 1px solid var(--border); background: var(--bg-raise); color: var(--text); }
  .pe-row-actions { display: flex; gap: 6px; flex-wrap: wrap; padding: 0 16px 14px; }
  .pe-group h2 { font-size: 15px; margin: 22px 0 10px; display: flex; align-items: center; gap: 8px; }
  .pe-group h2 span { padding: 2px 8px; border-radius: 999px; background: var(--bg-raise); }
  .pe-group h2 span { font-size: 11px; color: var(--text-dim); font-family: var(--mono); }
  .pe-danger { color: var(--red, #fe6465); }
  .pe-reset { margin-top: 28px; }
  @media (max-width: 600px) { .pe-form { grid-template-columns: minmax(0, 1fr); padding: 4px 14px 14px; } .pe-sec { padding: 22px 0 56px; } .pe-card { overflow: hidden; } .pe-card > summary { padding: 12px 14px; } .pe-row-actions { padding: 0 14px 14px; } }
  @media (prefers-reduced-motion: reduce) { .pe-alert { animation: none; } }
</style>
