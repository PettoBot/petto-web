---
// Economy (server dashboard): a preview of the global economy (four coins that turn into ceramos) and of the economy of the server itself. Nothing here is saved or works yet: the page says so.
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import { getDashLang, makeT } from '../i18n/dash';
const dt = makeT(getDashLang(Astro));
interface Props { user: any; guildId: string; guildName: string; guildIcon: string }
const { user, guildId, guildName, guildIcon } = Astro.props;
const coins = [
  { id: 'bronze', name: dt('Bronze coin'), line: dt('The coin of every day.') },
  { id: 'silver', name: dt('Silver coin'), line: dt('200 bronze coins make one.') },
  { id: 'gold', name: dt('Gold coin'), line: dt('100 silver coins make one.') },
  { id: 'mithril', name: dt('Mithril coin'), line: dt('50 gold coins make one. The magic metal of the fantasy stories.') },
];
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="economy" pageTitle="Economy">
  <section class="ec-hero">
    <div class="ec-hero-text">
      <span class="ec-soon">{dt('Soon')}</span>
      <h2>{dt('Economy')}</h2>
      <p>{dt('This is a preview. Nothing on this page works or is saved yet, but this is how it will look when it is ready.')}</p>
    </div>
    <div class="ec-hero-coins" aria-hidden="true">
      {['bronze', 'silver', 'gold', 'mithril'].map((id) => <img src={`/assets/economy/${id}.webp`} alt="" width="256" height="256" />)}
    </div>
  </section>

  <h3 class="ec-h">{dt('The four coins of the global economy')}</h3>
  <div class="ec-coins">
    {coins.map((coin) => (
      <article class="ec-coin">
        <img src={`/assets/economy/${coin.id}.webp`} alt="" width="256" height="256" loading="lazy" />
        <h4>{coin.name}</h4>
        <p>{coin.line}</p>
      </article>
    ))}
  </div>

  <div class="ec-chain" aria-label={dt('How the coins change')}>
    {[['bronze', 200, 'silver', 1], ['silver', 100, 'gold', 1], ['gold', 50, 'mithril', 1], ['mithril', 100, '', 1]].map(([from, n, to, m]) => (
      <div class="ec-step">
        <span class="ec-chip"><img src={`/assets/economy/${from}.webp`} alt="" width="32" height="32" /><b>{n}</b></span>
        <Icon name="ph:arrow-right-bold" width="18" height="18" />
        <span class="ec-chip">{to ? <img src={`/assets/economy/${to}.webp`} alt="" width="32" height="32" /> : <i class="bd-coin"></i>}<b>{m}{to ? '' : ` ${dt('ceramo')}`}</b></span>
      </div>
    ))}
  </div>
  <p class="ec-note">{dt('A person can change coins into ceramos and ceramos into coins, so ceramos can also be earned by playing and not only bought. Ceramos are used for the badges, banners and fonts of the profile.')}</p>

  <div class="ec-two">
    <article class="ec-card">
      <header><h3>{dt('Global economy')}</h3><span class="ec-pill">{dt('Soon')}</span></header>
      <p>{dt('The four coins are the same in every server that uses it, and the streaks of a person go with them everywhere.')}</p>
      <p class="ec-switch"><span class="ec-knob"></span>{dt('Use the global economy in this server')}</p>
      <p class="ec-small">{dt('If you turn it off, the members of your server keep their coins and their streaks everywhere else.')}</p>
    </article>
    <article class="ec-card">
      <header><h3>{dt('Economy of your server')}</h3><span class="ec-pill">{dt('Soon')}</span></header>
      <p>{dt('Create your own system: your coin, jobs, a shop with your roles and rewards for your members, like the economy bots, but part of Petto.')}</p>
      <p class="ec-switch"><span class="ec-knob"></span>{dt('Use the economy of this server')}</p>
      <p class="ec-small">{dt('We are still designing it. Tell us what you would want in the feedback page.')}</p>
    </article>
  </div>
</DashGuildLayout>

<style is:global>
  .ec-hero { position: relative; padding: 26px 24px; border-radius: 18px; background: linear-gradient(135deg, color-mix(in srgb, var(--yellow) 14%, var(--bg-card, #151515)), var(--bg-card, #151515)); border: 1px solid color-mix(in srgb, var(--yellow) 30%, transparent); margin-bottom: 22px; }
  .ec-hero h2 { margin: 6px 0 8px; font-size: clamp(34px, 6vw, 56px); line-height: 1; }
  .ec-hero p { margin: 0; max-width: 62ch; color: var(--text-muted); }
  .ec-soon { display: inline-block; padding: 6px 16px; border-radius: 999px; font-size: clamp(16px, 3vw, 22px); font-weight: 700; color: var(--yellow-text); background: color-mix(in srgb, var(--yellow) 18%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--yellow) 50%, transparent); }
  .ec-h { margin: 0 0 12px; font-size: 18px; }
  .ec-coins { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  @media (min-width: 560px) { .ec-coins { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .ec-coins { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .ec-coin { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; padding: 18px 14px; border-radius: 16px; background: var(--bg-card, #151515); border: 1px solid var(--border); }
  .ec-coin img { width: 96px; height: 96px; }
  .ec-coin h4 { margin: 4px 0 0; font-size: 17px; }
  .ec-coin p { margin: 0; font-size: 13.5px; color: var(--text-muted); }
  .ec-hero { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .ec-hero-coins { display: none; }
  @media (min-width: 900px) { .ec-hero-coins { display: flex; flex: none; } .ec-hero-coins img { width: 112px; height: 112px; margin-left: -26px; filter: drop-shadow(0 6px 10px rgb(0 0 0 / .45)); } .ec-hero-coins img:first-child { margin-left: 0; } }
  .ec-chain { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; margin: 14px 0 6px; }
  @media (min-width: 560px) { .ec-chain { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .ec-chain { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .ec-step { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 12px 8px; border-radius: 14px; background: var(--bg-card, #151515); border: 1px solid var(--border); color: var(--text-muted); }
  .ec-chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px 4px 4px; border-radius: 999px; background: color-mix(in srgb, var(--text) 7%, transparent); font-size: 14px; color: var(--text); white-space: nowrap; }
  .ec-chip img { width: 32px; height: 32px; }
  .ec-note { margin: 8px 0 22px; color: var(--text-muted); font-size: 14px; max-width: 80ch; }
  .ec-two { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
  @media (min-width: 900px) { .ec-two { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .ec-card { padding: 20px; border-radius: 16px; background: var(--bg-card, #151515); border: 1px solid var(--border); display: flex; flex-direction: column; gap: 10px; }
  .ec-card header { display: flex; align-items: center; justify-content: space-between; gap: 10px; } .ec-card h3 { margin: 0; font-size: 18px; } .ec-card p { margin: 0; color: var(--text-muted); }
  .ec-pill { padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; color: var(--yellow-text); background: color-mix(in srgb, var(--yellow) 14%, transparent); }
  .ec-switch { display: flex; align-items: center; gap: 12px; color: var(--text) !important; opacity: .55; margin-top: 4px !important; }
  .ec-knob { position: relative; flex: none; width: 40px; height: 22px; border-radius: 999px; background: color-mix(in srgb, var(--text) 18%, transparent); } .ec-knob::after { content: ''; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: var(--text-muted); }
  .ec-small { font-size: 13px; }
</style>
