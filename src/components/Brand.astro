---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const copy = {
  en: {
    eyebrow: 'Brand',
    title: 'The Petto brand.',
    lede: 'Everything you need to talk about Petto: the mascot, colors, fonts and a few simple rules. Free to use for articles, videos, bot lists and community posts.',
    logoTitle: 'Mascot and versions',
    groups: [{ title: 'Main', text: 'The everyday mascot.' }, { title: 'Premium', text: 'The crown marks Petto Premium. Use it only for Premium.' }, { title: 'Hat colors', text: 'Same duck, other hat colors for themes and events.' }, { title: 'Banner', text: 'For link previews and headers.' }],
    names: { 'mascot-icon': ['Mascot icon', 'PNG'], 'bot-avatar': ['Bot avatar', 'PNG, as on Discord'], 'duck-plain': ['Duck, plain', 'PNG, no hat'], 'duck-crown': ['Premium duck', 'PNG, with crown'], 'crown': ['Crown', 'PNG, on its own'], 'duck-bowl': ['Duck in a cup', 'PNG'], 'duck-bowl-crown': ['Premium duck in a cup', 'PNG, with crown'], 'duck-blue': ['Blue hat', 'PNG'], 'duck-green': ['Green hat', 'PNG'], 'duck-red': ['Red hat', 'PNG'], 'banner': ['Link banner', 'PNG, wide'] },
    kit: 'Download everything (.zip)',
    download: 'Download',
    colorTitle: 'Colors',
    colorText: 'Click a color to copy its hex code.',
    copied: 'Copied',
    colors: [
      { name: 'Peach', hex: '#f0a88f', use: 'Main accent' },
      { name: 'Night', hex: '#18191d', use: 'Background' },
      { name: 'Card', hex: '#212328', use: 'Surfaces' },
      { name: 'Mint', hex: '#a5ea7a', use: 'Success' },
      { name: 'Yellow', hex: '#fed53c', use: 'Warnings, the beak' },
      { name: 'Coral', hex: '#fe6465', use: 'Errors' },
    ],
    typeTitle: 'Typography',
    typeText: 'Fraunces for titles, Plus Jakarta Sans for everything else.',
    titleSample: 'Fraunces',
    textSample: 'Plus Jakarta Sans',
    aboutTitle: 'About Petto',
    shortLabel: 'Short description',
    short: 'Petto is a Discord bot for moderation, logging, tickets, voice channels and more, with a clean dashboard.',
    longLabel: 'Long description',
    long: 'Petto is an all-in-one Discord bot that helps communities stay safe and organized. It brings moderation, logging, tickets, appeals, VoiceMaster, leveling and a full web dashboard together in one place, in English, Spanish and Portuguese.',
    copy: 'Copy text',
    rulesTitle: 'Do and do not',
    dos: ['Use the original files', 'Keep clear space around the duck', 'Write the name as "Petto"', 'Link to petto.sbs'],
    donts: ['Do not stretch, rotate or recolor the duck', 'Do not add effects or shadows', 'Do not imply Petto endorses your project', 'Do not sell the assets'],
    contact: 'Need something else, like a special size or a partnership?',
    support: 'Open a support ticket',
  },
  es: {
    eyebrow: 'Marca',
    title: 'La marca de Petto.',
    lede: 'Todo lo que necesitas para hablar de Petto: la mascota, los colores, las fuentes y unas pocas reglas simples. Es libre de usar en artículos, videos, listas de bots y publicaciones de comunidad.',
    logoTitle: 'Mascota y versiones',
    groups: [{ title: 'Principal', text: 'La mascota de todos los días.' }, { title: 'Premium', text: 'La corona marca Petto Premium. Úsala solo para Premium.' }, { title: 'Colores de sombrero', text: 'El mismo pato con otros colores de sombrero para temas y eventos.' }, { title: 'Banner', text: 'Para vistas previas de enlaces y encabezados.' }],
    names: { 'mascot-icon': ['Icono de la mascota', 'PNG'], 'bot-avatar': ['Avatar del bot', 'PNG, como en Discord'], 'duck-plain': ['Pato simple', 'PNG, sin sombrero'], 'duck-crown': ['Pato Premium', 'PNG, con corona'], 'crown': ['Corona', 'PNG, sola'], 'duck-bowl': ['Pato en una taza', 'PNG'], 'duck-bowl-crown': ['Pato Premium en una taza', 'PNG, con corona'], 'duck-blue': ['Sombrero azul', 'PNG'], 'duck-green': ['Sombrero verde', 'PNG'], 'duck-red': ['Sombrero rojo', 'PNG'], 'banner': ['Banner del enlace', 'PNG, panorámico'] },
    kit: 'Descargar todo (.zip)',
    download: 'Descargar',
    colorTitle: 'Colores',
    colorText: 'Haz clic en un color para copiar su código hex.',
    copied: 'Copiado',
    colors: [
      { name: 'Durazno', hex: '#f0a88f', use: 'Acento principal' },
      { name: 'Noche', hex: '#18191d', use: 'Fondo' },
      { name: 'Tarjeta', hex: '#212328', use: 'Superficies' },
      { name: 'Menta', hex: '#a5ea7a', use: 'Éxito' },
      { name: 'Amarillo', hex: '#fed53c', use: 'Avisos, el pico' },
      { name: 'Coral', hex: '#fe6465', use: 'Errores' },
    ],
    typeTitle: 'Tipografía',
    typeText: 'Fraunces para los títulos, Plus Jakarta Sans para todo lo demás.',
    titleSample: 'Fraunces',
    textSample: 'Plus Jakarta Sans',
    aboutTitle: 'Sobre Petto',
    shortLabel: 'Descripción corta',
    short: 'Petto es un bot de Discord para moderación, registros, tickets, canales de voz y más, con un panel limpio.',
    longLabel: 'Descripción larga',
    long: 'Petto es un bot de Discord todo en uno que ayuda a las comunidades a mantenerse seguras y organizadas. Reúne moderación, registros, tickets, apelaciones, VoiceMaster, niveles y un panel web completo, en inglés, español y portugués.',
    copy: 'Copiar texto',
    rulesTitle: 'Qué hacer y qué no',
    dos: ['Usa los archivos originales', 'Deja espacio libre alrededor del pato', 'Escribe el nombre como "Petto"', 'Enlaza a petto.sbs'],
    donts: ['No estires, gires ni recolores el pato', 'No agregues efectos ni sombras', 'No des a entender que Petto respalda tu proyecto', 'No vendas los recursos'],
    contact: '¿Necesitas algo más, como un tamaño especial o una alianza?',
    support: 'Abrir un ticket de soporte',
  },
  'pt-BR': {
    eyebrow: 'Marca',
    title: 'A marca do Petto.',
    lede: 'Tudo o que você precisa para falar do Petto: o mascote, as cores, as fontes e algumas regras simples. Uso livre em artigos, vídeos, listas de bots e posts de comunidade.',
    logoTitle: 'Mascote e versões',
    groups: [{ title: 'Principal', text: 'O mascote de todo dia.' }, { title: 'Premium', text: 'A coroa marca o Petto Premium. Use só para o Premium.' }, { title: 'Cores de chapéu', text: 'O mesmo pato com outras cores de chapéu para temas e eventos.' }, { title: 'Banner', text: 'Para prévias de links e cabeçalhos.' }],
    names: { 'mascot-icon': ['Ícone do mascote', 'PNG'], 'bot-avatar': ['Avatar do bot', 'PNG, como no Discord'], 'duck-plain': ['Pato simples', 'PNG, sem chapéu'], 'duck-crown': ['Pato Premium', 'PNG, com coroa'], 'crown': ['Coroa', 'PNG, sozinha'], 'duck-bowl': ['Pato em uma xícara', 'PNG'], 'duck-bowl-crown': ['Pato Premium em uma xícara', 'PNG, com coroa'], 'duck-blue': ['Chapéu azul', 'PNG'], 'duck-green': ['Chapéu verde', 'PNG'], 'duck-red': ['Chapéu vermelho', 'PNG'], 'banner': ['Banner do link', 'PNG, panorâmico'] },
    kit: 'Baixar tudo (.zip)',
    download: 'Baixar',
    colorTitle: 'Cores',
    colorText: 'Clique em uma cor para copiar o código hex.',
    copied: 'Copiado',
    colors: [
      { name: 'Pêssego', hex: '#f0a88f', use: 'Destaque principal' },
      { name: 'Noite', hex: '#18191d', use: 'Fundo' },
      { name: 'Cartão', hex: '#212328', use: 'Superfícies' },
      { name: 'Menta', hex: '#a5ea7a', use: 'Sucesso' },
      { name: 'Amarelo', hex: '#fed53c', use: 'Avisos, o bico' },
      { name: 'Coral', hex: '#fe6465', use: 'Erros' },
    ],
    typeTitle: 'Tipografia',
    typeText: 'Fraunces para os títulos, Plus Jakarta Sans para o resto.',
    titleSample: 'Fraunces',
    textSample: 'Plus Jakarta Sans',
    aboutTitle: 'Sobre o Petto',
    shortLabel: 'Descrição curta',
    short: 'O Petto é um bot de Discord para moderação, logs, tickets, canais de voz e mais, com um painel limpo.',
    longLabel: 'Descrição longa',
    long: 'O Petto é um bot de Discord tudo em um que ajuda as comunidades a se manterem seguras e organizadas. Reúne moderação, logs, tickets, apelações, VoiceMaster, níveis e um painel web completo, em inglês, espanhol e português.',
    copy: 'Copiar texto',
    rulesTitle: 'Pode e não pode',
    dos: ['Use os arquivos originais', 'Deixe espaço livre ao redor do pato', 'Escreva o nome como "Petto"', 'Linke para petto.sbs'],
    donts: ['Não estique, gire nem recolora o pato', 'Não adicione efeitos ou sombras', 'Não sugira que o Petto apoia seu projeto', 'Não venda os arquivos'],
    contact: 'Precisa de algo mais, como um tamanho especial ou uma parceria?',
    support: 'Abrir um ticket de suporte',
  },
} as const;

const t = copy[lang];
const groupFiles = [
  ['mascot-icon', 'bot-avatar', 'duck-plain'],
  ['duck-crown', 'crown', 'duck-bowl', 'duck-bowl-crown'],
  ['duck-blue', 'duck-green', 'duck-red'],
  ['petto-link-banner-min'],
];
const fileKey = (file: string) => (file === 'petto-link-banner-min' ? 'banner' : file);
---

<Base title={`${t.eyebrow} · Petto`} lang={lang}>
  <main>
    <section class="br-hero">
      <div class="wrap">
        <div class="eyebrow reveal">{t.eyebrow}</div>
        <h1 class="reveal">{t.title}</h1>
        <p class="br-lede reveal">{t.lede}</p>
      </div>
    </section>

    <section class="br-sec">
      <div class="wrap">
        <h2 class="br-h">{t.logoTitle}</h2>
        <a class="btn btn-ghost btn-sm br-kit" href="/assets/brand/petto-brand-kit.zip" download>
          <Icon name="ph:download-simple-bold" width="14" height="14" />{t.kit}
        </a>
        {t.groups.map((group, index) => (
          <div class="br-group">
            <h3 class="br-gh">{group.title}</h3>
            <p class="br-p">{group.text}</p>
            <div class="br-assets">
              {groupFiles[index].map((file) => {
                const [name, note] = t.names[fileKey(file)];
                return (
                  <article class="br-asset">
                    <div class="br-thumb"><img src={`/assets/brand/${file}.png`} alt={name} loading="lazy" /></div>
                    <div class="br-asset-body"><strong>{name}</strong><span>{note}</span></div>
                    <a class="btn btn-ghost btn-sm" href={`/assets/brand/${file}.png`} download>
                      <Icon name="ph:download-simple-bold" width="14" height="14" />{t.download}
                    </a>
                  </article>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="br-sec">
      <div class="wrap">
        <h2 class="br-h">{t.colorTitle}</h2>
        <p class="br-p">{t.colorText}</p>
        <div class="br-colors">
          {t.colors.map((color) => (
            <button type="button" class="br-color" data-copy={color.hex} data-done={t.copied}>
              <span class="br-swatch" style={`background:${color.hex}`}></span>
              <span class="br-color-name">{color.name}</span>
              <span class="br-color-hex">{color.hex}</span>
              <span class="br-color-use">{color.use}</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="br-sec">
      <div class="wrap">
        <h2 class="br-h">{t.typeTitle}</h2>
        <p class="br-p">{t.typeText}</p>
        <div class="br-type">
          <div class="br-type-card"><span class="br-serif">Aa</span><b>{t.titleSample}</b></div>
          <div class="br-type-card"><span class="br-sans">Aa</span><b>{t.textSample}</b></div>
        </div>
      </div>
    </section>

    <section class="br-sec">
      <div class="wrap">
        <h2 class="br-h">{t.aboutTitle}</h2>
        <div class="br-texts">
          <div class="br-text">
            <small>{t.shortLabel}</small>
            <p>{t.short}</p>
            <button type="button" class="btn btn-ghost btn-sm" data-copy={t.short} data-done={t.copied}><Icon name="ph:copy-simple-bold" width="14" height="14" />{t.copy}</button>
          </div>
          <div class="br-text">
            <small>{t.longLabel}</small>
            <p>{t.long}</p>
            <button type="button" class="btn btn-ghost btn-sm" data-copy={t.long} data-done={t.copied}><Icon name="ph:copy-simple-bold" width="14" height="14" />{t.copy}</button>
          </div>
        </div>
      </div>
    </section>

    <section class="br-sec">
      <div class="wrap">
        <h2 class="br-h">{t.rulesTitle}</h2>
        <div class="br-rules">
          <ul class="br-do">{t.dos.map((item) => <li><Icon name="ph:check-circle-fill" width="16" height="16" />{item}</li>)}</ul>
          <ul class="br-dont">{t.donts.map((item) => <li><Icon name="ph:x-circle-fill" width="16" height="16" />{item}</li>)}</ul>
        </div>
        <div class="br-contact">
          <p>{t.contact}</p>
          <a class="btn btn-ghost btn-sm" href="https://petto.sbs/support" target="_blank" rel="noopener">
            <Icon name="ph:ticket" width="14" height="14" />{t.support}
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const label = button.innerHTML;
      try { await navigator.clipboard.writeText(button.dataset.copy || ''); } catch { return; }
      button.textContent = button.dataset.done || 'Copied';
      setTimeout(() => { button.innerHTML = label; }, 1400);
    });
  });
</script>

<style>
  .br-hero { padding: 64px 0 24px; }
  .br-hero h1 { font-size: 36px; margin: 14px 0 12px; }
  .br-lede { color: var(--text-muted); font-size: 15.5px; max-width: 60ch; line-height: 1.65; }
  .br-sec { padding: 26px 0 8px; }
  .br-h { font-size: 22px; margin: 0 0 6px; }
  .br-p { color: var(--text-muted); font-size: 14px; margin: 0 0 16px; max-width: 60ch; }
  .br-kit { margin-bottom: 8px; }
  .br-group { margin-top: 22px; }
  .br-gh { font-size: 16px; margin: 0 0 4px; }
  .br-assets { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr)); gap: 14px; }
  .br-asset { border: 1px solid var(--border); background: var(--card); border-radius: 16px; padding: 14px; display: flex; flex-direction: column; gap: 12px; }
  .br-thumb { height: 140px; border-radius: 12px; background: #f4f4f5; display: grid; place-items: center; overflow: hidden; }
  .br-thumb img { max-width: 80%; max-height: 120px; object-fit: contain; }
  .br-asset-body { display: flex; flex-direction: column; gap: 2px; font-size: 14px; }
  .br-asset-body span { color: var(--text-dim); font-size: 12.5px; }
  .br-colors { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(150px, 100%), 1fr)); gap: 12px; }
  .br-color { all: unset; box-sizing: border-box; cursor: pointer; border: 1px solid var(--border); background: var(--card); border-radius: 14px; padding: 10px; display: flex; flex-direction: column; gap: 3px; font-size: 13px; }
  .br-color:hover { border-color: var(--accent); }
  .br-swatch { height: 56px; border-radius: 9px; margin-bottom: 6px; border: 1px solid rgba(255,255,255,.08); }
  .br-color-name { font-weight: 600; }
  .br-color-hex { font-family: var(--mono); color: var(--text-muted); font-size: 12px; }
  .br-color-use { color: var(--text-dim); font-size: 12px; }
  .br-type { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 14px; }
  .br-type-card { border: 1px solid var(--border); background: var(--card); border-radius: 16px; padding: 18px; display: flex; flex-direction: column; gap: 6px; }
  .br-type-card span { font-size: 54px; line-height: 1; color: var(--accent); }
  .br-serif { font-family: 'Fraunces', Georgia, serif; font-weight: 700; }
  .br-sans { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; font-weight: 600; }
  .br-texts { display: grid; gap: 14px; margin-top: 12px; }
  .br-text { border: 1px solid var(--border); background: var(--card); border-radius: 16px; padding: 16px; display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .br-text small { font-family: var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--text-dim); font-size: 11.5px; }
  .br-text p { margin: 0; color: var(--text-muted); font-size: 14px; line-height: 1.65; }
  .br-rules { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 14px; margin-top: 12px; }
  .br-rules ul { list-style: none; margin: 0; padding: 16px; border: 1px solid var(--border); background: var(--card); border-radius: 16px; display: flex; flex-direction: column; gap: 10px; }
  .br-rules li { display: flex; gap: 9px; align-items: flex-start; font-size: 14px; color: var(--text-muted); line-height: 1.5; }
  .br-rules li :global(svg) { flex: none; margin-top: 2px; }
  .br-do li :global(svg) { color: #a5ea7a; }
  .br-dont li :global(svg) { color: #fe6465; }
  .br-contact { display: flex; align-items: center; justify-content: space-between; gap: 20px; max-width: 760px; padding: 30px 0 72px; color: var(--text-muted); }
  .br-contact p { margin: 0; font-size: 13.5px; }
  @media (max-width: 560px) {
    .br-hero h1 { font-size: 30px; }
    .br-contact { flex-direction: column; align-items: flex-start; }
  }
</style>
