---
// The carousel of the servers that run Petto: the ones with 500 members or more (at most 15, the biggest first), in two rows that never stop and never
// end (the second one goes the other way). Each one shows its picture (animated when it is), its name, the marks Discord gives it, the members online and
// the members in all. It cannot be paused or clicked. The list comes from /api/showcase (the bot keeps it); with no servers the section is not drawn.
import type { Locale } from '../i18n/ui';

interface Props { lang: Locale }
const { lang } = Astro.props;

const WORDS: Record<Locale, { eyebrow: string; title: string; desc: string; online: string; members: string; discoverable: string; verified: string; partnered: string; boost: string }> = {
  en: { eyebrow: 'Live', title: 'Servers that run on Petto', desc: 'The biggest communities that use Petto right now.', online: 'online', members: 'members', discoverable: 'Discoverable server', verified: 'Verified server', partnered: 'Partnered server', boost: 'Boost level' },
  es: { eyebrow: 'En vivo', title: 'Servidores que funcionan con Petto', desc: 'Las comunidades más grandes que usan Petto ahora mismo.', online: 'en línea', members: 'miembros', discoverable: 'Servidor en Descubrimiento', verified: 'Servidor verificado', partnered: 'Servidor asociado', boost: 'Nivel de potenciación' },
  'pt-BR': { eyebrow: 'Ao vivo', title: 'Servidores que funcionam com o Petto', desc: 'As maiores comunidades que usam o Petto agora.', online: 'online', members: 'membros', discoverable: 'Servidor no Descobrir', verified: 'Servidor verificado', partnered: 'Servidor parceiro', boost: 'Nível de impulso' },
};
const w = WORDS[lang];
const locale = lang === 'pt-BR' ? 'pt-BR' : lang;
---
<section class="sc-section" id="servers" data-showcase data-locale={locale} data-online={w.online} data-members={w.members}
  data-discoverable={w.discoverable} data-verified={w.verified} data-partnered={w.partnered} data-boost={w.boost} hidden aria-label={w.title}>
  <div class="wrap">
    <div class="sc-head">
      <div class="eyebrow">{w.eyebrow}</div>
      <h2>{w.title}</h2>
      <p>{w.desc}</p>
    </div>
  </div>
  <div class="sc-rows" aria-hidden="true">
    <div class="sc-row" data-row="0"><div class="sc-track"></div></div>
    <div class="sc-row sc-row-back" data-row="1"><div class="sc-track"></div></div>
  </div>
</section>

<script>
  // The carousel is drawn here (the list is read from the bot every 5 minutes). Texts go in as text, never as HTML: a server chooses its own name.
  const root = document.querySelector<HTMLElement>('[data-showcase]');
  if (root) start(root);

  type Server = { id: string; name: string; icon: string | null; animated: boolean; members: number; online: number | null; badges: string[]; boost: number };

  function start(section: HTMLElement) {
    const number = new Intl.NumberFormat(section.dataset.locale || 'en');
    const SPEED = 38; // pixels a second
    const CARD = 314; // card width + gap, kept in step with the style below
    const MIN_CARDS = 9; // each half of a track is at least wider than a big screen, so the loop never shows a gap
    let signature = '';

    // The marks, as the Discord app draws them: the flower-star badge of a verified server (with a checkmark) and of a partnered server (with the partner
    // mark), the compass of Server Discovery and the boost gem. The shapes are the ones of the Discord web app; the colors are ours (inherited from the style).
    const FLOWER = 'M5.52995 0.431867C6.27995 0.181867 7.2 1.23199 8 1.23199C8.8 1.23199 9.75007 0.231867 10.4701 0.431867C11.19 0.631965 11.38 2.07173 12 2.52171C12.62 2.9717 14.0003 2.70184 14.4603 3.32184C14.9199 3.94191 14.2303 5.16178 14.4603 5.91169C14.6903 6.66159 15.9998 7.21166 16 8.00153C16 8.79146 14.72 9.38146 14.4798 10.0914C14.2398 10.8014 14.9198 12.0919 14.4798 12.6819C14.0397 13.2716 12.6401 13.0321 12.0202 13.482C11.4002 13.932 11.2298 15.3219 10.4798 15.5719C9.72987 15.8216 8.80967 14.7717 8.00973 14.7717C7.2098 14.7719 6.25964 15.7718 5.53971 15.5719C4.81995 15.3716 4.61982 13.9321 4 13.482C3.38 13.032 1.99971 13.3019 1.53971 12.6819C1.07975 12.0619 1.76971 10.8414 1.53971 10.0914C1.30939 9.34159 0 8.79139 0 8.00153C0.000177681 7.21159 1.2802 6.62163 1.52018 5.91169C1.76012 5.20167 1.08021 3.91183 1.52018 3.32184C1.96018 2.73184 3.36999 3.0017 4 2.52171C4.62997 2.04173 4.78003 0.681954 5.52995 0.431867Z';
    const BADGE_SVG: Record<string, string> = {
      verified: `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="${FLOWER}"/><path transform="translate(2.5 2.5) scale(0.46)" fill="#fff" fill-rule="evenodd" d="M18.7 7.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4l3.3 3.29 7.3-7.3a1 1 0 0 1 1.4 0Z"/></svg>`,
      partnered: `<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="${FLOWER}"/><g transform="translate(2 2) scale(0.75)" fill="#fff"><path d="M10.5906 6.39993L9.19223 7.29993C8.99246 7.39993 8.89258 7.39993 8.69281 7.29993C8.59293 7.19993 8.39317 7.09993 8.29328 6.99993C7.89375 6.89993 7.5941 6.99993 7.29445 7.19993L6.79504 7.49993L4.29797 9.19993C3.69867 9.49993 2.99949 9.39993 2.69984 8.79993C2.30031 8.29993 2.50008 7.59993 2.99949 7.19993L5.99598 5.19993C6.79504 4.69993 7.79387 4.49993 8.69281 4.69993C9.49188 4.89993 10.0912 5.29993 10.5906 5.89993C10.7904 6.09993 10.6905 6.29993 10.5906 6.39993Z"/><path d="M13.4871 7.79985C13.4871 8.19985 13.2874 8.59985 12.9877 8.79985L9.89135 10.7999C9.29206 11.1999 8.69276 11.3999 7.99358 11.3999C7.69393 11.3999 7.49417 11.3999 7.19452 11.2999C6.39545 11.0999 5.79616 10.6999 5.29674 10.0999C5.19686 9.89985 5.29674 9.69985 5.39663 9.59985L6.79499 8.69985C6.89487 8.59985 7.09463 8.59985 7.19452 8.69985C7.39428 8.79985 7.59405 8.89985 7.69393 8.99985C8.09346 8.99985 8.39311 8.99985 8.69276 8.79985L9.39194 8.39985L11.3896 6.99985L11.6892 6.79985C12.1887 6.49985 12.9877 6.59985 13.2874 7.09985C13.4871 7.39985 13.4871 7.59985 13.4871 7.79985Z"/></g></svg>`,
      discoverable: '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><path fill="currentColor" fill-rule="evenodd" d="M23 12a11 11 0 1 1-22 0 11 11 0 0 1 22 0ZM7.74 9.3A2 2 0 0 1 9.3 7.75l7.22-1.45a1 1 0 0 1 1.18 1.18l-1.45 7.22a2 2 0 0 1-1.57 1.57l-7.22 1.45a1 1 0 0 1-1.18-1.18L7.74 9.3Z"/></svg>',
      boost: '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M11.02 1.36c.56-.48 1.4-.48 1.96 0l6.48 5.45c.34.29.54.71.54 1.16v8.23c-.05.38-.24.74-.54 1l-6.48 5.44c-.53.45-1.3.48-1.86.09l-.1-.09-6.48-5.45c-.3-.25-.49-.6-.53-1L4 16.04V7.97c0-.45.2-.87.54-1.16l6.48-5.45ZM6.36 7.89a1 1 0 0 0-.36.76v6.7c0 .29.13.57.36.76l5 4.2a1 1 0 0 0 1.28 0l5-4.2a1 1 0 0 0 .36-.77V8.65a1 1 0 0 0-.36-.76l-5-4.2a1 1 0 0 0-1.28 0l-5 4.2Z"/><path fill="currentColor" d="M11.36 6.3a1 1 0 0 1 1.28 0l3 2.52a1 1 0 0 1 .36.76v4.84a1 1 0 0 1-.36.76l-3 2.53a1 1 0 0 1-1.28 0l-3-2.53a1 1 0 0 1-.36-.76V9.58a1 1 0 0 1 .36-.76l3-2.53Z"/></svg>',
    };

    const card = (server: Server) => {
      const el = document.createElement('div');
      el.className = 'sc-card';
      el.dataset.id = server.id;
      const pic = document.createElement(server.icon ? 'img' : 'span') as HTMLImageElement | HTMLSpanElement;
      pic.className = 'sc-icon';
      if (server.icon && pic instanceof HTMLImageElement) { pic.src = server.icon; pic.alt = ''; pic.loading = 'lazy'; pic.decoding = 'async'; pic.width = 44; pic.height = 44; }
      else pic.textContent = (server.name.trim()[0] || '?').toUpperCase();
      const body = document.createElement('div');
      body.className = 'sc-body';
      const top = document.createElement('div');
      top.className = 'sc-top';
      const name = document.createElement('span');
      name.className = 'sc-name';
      name.textContent = server.name;
      top.append(name);
      for (const badge of server.badges) {
        if (!BADGE_SVG[badge]) continue;
        const mark = document.createElement('span');
        mark.className = `sc-badge sc-badge-${badge}`;
        mark.title = section.dataset[badge] || badge;
        mark.innerHTML = BADGE_SVG[badge];
        top.append(mark);
      }
      if (server.boost > 0) {
        const boost = document.createElement('span');
        boost.className = 'sc-badge sc-badge-boost';
        boost.title = `${section.dataset.boost} ${server.boost}`;
        boost.innerHTML = BADGE_SVG.boost;
        top.append(boost);
      }
      const numbers = document.createElement('div');
      numbers.className = 'sc-numbers';
      const dot = document.createElement('span');
      dot.className = 'sc-dot';
      const online = document.createElement('span');
      online.className = 'sc-online';
      online.textContent = server.online === null ? '' : `${number.format(server.online)} ${section.dataset.online}`;
      const members = document.createElement('span');
      members.className = 'sc-members';
      members.textContent = `${number.format(server.members)} ${section.dataset.members}`;
      if (server.online === null) numbers.append(members); else numbers.append(dot, online, members);
      body.append(top, numbers);
      el.append(pic, body);
      return el;
    };

    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches; // no movement: one still list, each server once
    const fill = (servers: Server[], reverse: boolean) => {
      const list = reverse ? [...servers].reverse() : servers;
      if (calm) return list;
      let half = [...list];
      while (half.length < MIN_CARDS) half = half.concat(list);
      return half;
    };

    const draw = (servers: Server[]) => {
      section.hidden = servers.length === 0;
      section.querySelectorAll<HTMLElement>('.sc-row').forEach((row, index) => {
        const track = row.querySelector<HTMLElement>('.sc-track')!;
        const half = fill(servers, index === 1);
        track.replaceChildren(...half.map(card), ...(calm ? [] : half.map(card))); // twice: the loop moves one half and starts again, it never ends
        track.style.setProperty('--sc-dur', `${Math.round((half.length * CARD) / SPEED)}s`);
        track.style.setProperty('--sc-delay', `${index === 1 ? -Math.round(((half.length * CARD) / SPEED) / 3) : 0}s`);
      });
    };

    const update = (servers: Server[]) => {
      // Only a new order or a new server draws everything again (the movement would jump); the numbers change in place.
      const next = servers.map((s) => s.id).join(',');
      if (next !== signature) { signature = next; draw(servers); return; }
      const by = new Map(servers.map((s) => [s.id, s]));
      section.querySelectorAll<HTMLElement>('.sc-card').forEach((el) => {
        const s = by.get(el.dataset.id || '');
        if (!s) return;
        const online = el.querySelector<HTMLElement>('.sc-online');
        const members = el.querySelector<HTMLElement>('.sc-members');
        if (online && s.online !== null) online.textContent = `${number.format(s.online)} ${section.dataset.online}`;
        if (members) members.textContent = `${number.format(s.members)} ${section.dataset.members}`;
      });
    };

    const load = async () => {
      try {
        const response = await fetch('/api/showcase', { headers: { Accept: 'application/json' } });
        if (!response.ok) return;
        const body = await response.json();
        if (Array.isArray(body?.servers)) update(body.servers as Server[]);
      } catch { /* the carousel keeps what it has */ }
    };
    load();
    setInterval(load, 5 * 60_000);
  }
</script>

<style is:global>
  .sc-section { padding: 56px 0 64px; overflow: hidden; }
  .sc-section[hidden] { display: none; }
  .sc-head { text-align: center; margin: 0 auto 28px; max-width: 640px; }
  .sc-head h2 { margin: 6px 0 8px; }
  .sc-head p { margin: 0; color: var(--text-muted); }
  .sc-rows { display: grid; gap: 14px; mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); }
  .sc-row { overflow: hidden; pointer-events: none; user-select: none; -webkit-user-select: none; }
  .sc-track { display: flex; gap: 14px; width: max-content; animation: sc-move var(--sc-dur, 60s) linear var(--sc-delay, 0s) infinite; will-change: transform; }
  .sc-row-back .sc-track { animation-direction: reverse; }
  @keyframes sc-move { from { transform: translateX(0); } to { transform: translateX(calc(-50% - 7px)); } }
  .sc-card { display: flex; align-items: center; gap: 12px; flex: 0 0 300px; width: 300px; box-sizing: border-box; padding: 12px 14px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); }
  .sc-icon { flex: none; width: 44px; height: 44px; border-radius: 12px; object-fit: cover; background: var(--bg-raise); display: inline-flex; align-items: center; justify-content: center; font-weight: 700; color: var(--text-muted); }
  .sc-body { min-width: 0; display: grid; gap: 3px; }
  .sc-top { display: flex; align-items: center; gap: 6px; min-width: 0; }
  .sc-name { font-weight: 700; font-size: 15px; line-height: 1.25; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sc-badge { flex: none; display: inline-flex; color: var(--text-muted); }
  .sc-badge-partnered { color: var(--blue); }
  .sc-badge-verified { color: var(--green); }
  .sc-badge-discoverable { color: var(--text-muted); }
  .sc-badge-boost { color: var(--accent); }
  .sc-numbers { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--text-muted); white-space: nowrap; overflow: hidden; }
  .sc-dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--green); }
  .sc-online { color: var(--text); }
  .sc-online + .sc-members::before { content: '·'; margin-right: 6px; color: var(--text-dim); }
  @media (max-width: 600px) { .sc-section { padding: 40px 0 48px; } .sc-card { flex-basis: 284px; width: 284px; } .sc-numbers { font-size: 12px; gap: 5px; } }
  @media (prefers-reduced-motion: reduce) {
    .sc-track { animation: none; width: auto; flex-wrap: wrap; justify-content: center; }
    .sc-row-back { display: none; }
    .sc-rows { mask-image: none; -webkit-mask-image: none; }
  }
</style>
