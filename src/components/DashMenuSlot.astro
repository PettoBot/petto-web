---
// On a phone (880px and below) the button that opens the dashboard menu leaves its own row and sits in the site's top bar, right before the
// site's burger button, so the menu is one tap away and the page has one bar instead of two. The button is MOVED, not copied: it keeps its id,
// its listeners, aria-expanded and focus. It goes into its own span (data-dash-menu-slot), so anything else the bar gets next to the burger
// (an avatar button, say) lives beside it. Above 880px it goes back to its row. If the bar has no burger the row stays as it is.
interface Props { button: string; row: string }
const { button, row } = Astro.props;
---
<script is:inline define:vars={{ buttonId: button, rowId: row }}>
  (function () {
    var button = document.getElementById(buttonId);
    var row = document.getElementById(rowId);
    var burger = document.getElementById('navBurger');
    if (!button || !row || !burger || !burger.parentNode) return;
    var root = document.documentElement;
    var query = window.matchMedia('(max-width: 880px)');
    var slot = null;
    function place() {
      if (query.matches) {
        if (!slot) {
          slot = document.createElement('span');
          slot.setAttribute('data-dash-menu-slot', '');
        }
        if (slot.parentNode !== burger.parentNode) burger.parentNode.insertBefore(slot, burger);
        if (button.parentNode !== slot) slot.appendChild(button);
        root.classList.add('dash-bar-moved');
      } else {
        root.classList.remove('dash-bar-moved');
        if (button.parentNode !== row) row.insertBefore(button, row.firstChild);
        if (slot && slot.parentNode) slot.parentNode.removeChild(slot);
      }
    }
    place();
    if (query.addEventListener) query.addEventListener('change', place); else query.addListener(place);
  })();
</script>

<style is:global>
  [data-dash-menu-slot] { display: none; }
  @media (max-width: 880px) {
    [data-dash-menu-slot] { display: inline-flex; align-items: center; }
    /* The same size and frame as the site's burger beside it, with the accent color so it reads as the dashboard's menu. */
    html [data-dash-menu-slot] .dash-menu-btn { width: 34px; height: 34px; border-radius: 8px; background: none; border: 1px solid var(--border); color: var(--accent); }
    html [data-dash-menu-slot] .dash-menu-btn:hover { background: var(--card-hover); }
    html [data-dash-menu-slot] .dash-menu-btn[aria-expanded="true"] { background: var(--accent-soft); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
    html [data-dash-menu-slot] .dash-menu-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    /* Its row is empty now: the page's own heading says where you are. */
    html.dash-bar-moved .dgl-menu-bar, html.dash-bar-moved .dme-bar { display: none; }
  }
</style>
