  .stack-item h3 { font-size: 15.5px; margin-bottom: 8px; }
  .stack-item p { font-size: 13px; color: var(--text-muted); line-height: 1.5; margin: 0; }

  .credits-sec { padding: 56px 0 64px; }
  .credits-head { max-width: 640px; margin: 0 auto 32px; text-align: center; }
  .credits-disclaimer { font-size: 13px; color: var(--text-dim); line-height: 1.6; margin: 10px 0 0; }
  .marquee { overflow: hidden; mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent); }
  .marquee-track { display: flex; width: max-content; gap: 48px; animation: marquee 32s linear infinite; }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .marquee-item { display: flex; align-items: center; gap: 10px; flex-shrink: 0; opacity: 0.6; transition: opacity 0.2s ease; }
  .marquee-item:hover { opacity: 1; }
  .marquee-item :global(.marquee-ic) { width: 22px; height: 22px; color: var(--text-muted); }
  .marquee-item span { font-size: 14px; color: var(--text-muted); white-space: nowrap; font-weight: 500; }

  .cta-band { text-align: center; }
  .duck-family { display: flex; align-items: flex-end; justify-content: center; gap: 6px; margin-bottom: 20px; }
  .duck-family img { width: 54px; height: auto; filter: drop-shadow(0 8px 14px rgba(0,0,0,0.3)); }
  .cta-band h2 { font-size: 34px; margin-bottom: 16px; }
  .cta-band p { color: var(--text-muted); margin-bottom: 30px; }

  @media (max-width: 880px) {
    .hero-grid { grid-template-columns: 1fr; }
    h1.headline { font-size: 34px; }
    .headline-row img { width: 56px; height: 56px; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .showcase { grid-template-columns: 1fr; gap: 0; margin-bottom: 28px; }
    .showcase-copy { padding: 32px 26px; }
    .showcase-mock { padding: 26px; }
    .showcase.reverse .showcase-copy { order: 1; }
    .showcase.reverse .showcase-mock { order: 2; }
    .feat-grid { grid-template-columns: 1fr; }
    .releases { grid-template-columns: 1fr; }
    .stack-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  const chipsEl = document.getElementById('tryChips');
  const bodyEl = document.getElementById('tryBody');
  const chanEl = document.getElementById('tryChan');
  const chips = Array.from(chipsEl?.querySelectorAll('.try-chip') ?? []) as HTMLElement[];

  const REPLIES: Record<string, { chan: string; html: string }> = {
    ban: {
      chan: '#moderation',
      html: `
        <div class="wmsg">
          <img class="wav" src="/assets/user-liam.png" alt="" />
          <div><div class="wmeta"><b>liam</b><span>just now</span></div><div class="wtxt">!ban @spammer unauthorized advertising</div></div>
        </div>
        <div class="wmsg">
          <div class="wav bot"><img src="/assets/mascot-icon.png" alt="" /></div>
          <div>
            <div class="wmeta"><b>tetto</b><span class="wtag">BOT</span></div>
            <div class="wcard"><div class="wcard-t">Case #144 &middot; Ban</div><div class="wcard-r"><b>User</b>spammer#0192</div><div class="wcard-r"><b>Reason</b>unauthorized advertising</div></div>
          </div>
        </div>`,
    },
    rank: {
      chan: '#general',
      html: `
        <div class="wmsg">
          <img class="wav" src="/assets/user-liam.png" alt="" />
          <div><div class="wmeta"><b>liam</b><span>just now</span></div><div class="wtxt">!rank</div></div>
        </div>
        <div class="wmsg">
          <div class="wav bot"><img src="/assets/mascot-icon.png" alt="" /></div>
          <div>
            <div class="wmeta"><b>tetto</b><span class="wtag">BOT</span></div>
            <div class="wlevel"><div class="wlevel-t">Level <b>12</b> &middot; Rank <b>#4</b></div><div class="wlevel-bar"><span style="width: 64%"></span></div><div class="wlevel-xp">8,240 / 12,900 XP</div></div>
          </div>
        </div>`,
    },
    giveaway: {
      chan: '#giveaways',
      html: `
        <div class="wmsg">
          <img class="wav" src="/assets/user-liam.png" alt="" />
          <div><div class="wmeta"><b>liam</b><span>just now</span></div><div class="wtxt">!giveaway quick 10m 1 "Nitro Classic"</div></div>
        </div>
        <div class="wmsg">
          <div class="wav bot"><img src="/assets/mascot-icon.png" alt="" /></div>
          <div>
            <div class="wmeta"><b>tetto</b><span class="wtag">BOT</span></div>
            <div class="wgiveaway"><div class="wgiveaway-t">&#9733; Discord Nitro Classic</div><div class="wgiveaway-r">Hosted by <b>liam</b> &middot; 1 winner</div><div class="wgiveaway-r">Ends in 10 minutes</div><button class="wbtn">&#127881; Enter Giveaway</button></div>
          </div>
        </div>`,
    },
    invites: {
      chan: '#general',
      html: `
        <div class="wmsg">
          <img class="wav" src="/assets/user-liam.png" alt="" />
          <div><div class="wmeta"><b>liam</b><span>just now</span></div><div class="wtxt">!invites top</div></div>
        </div>
        <div class="wmsg">
          <div class="wav bot"><img src="/assets/mascot-icon.png" alt="" /></div>
          <div>
            <div class="wmeta"><b>tetto</b><span class="wtag">BOT</span></div>
            <div class="wcard">
              <div class="wcard-t">Invite leaderboard</div>
              <div class="wcard-r"><b>1. liam</b>42 net</div>
              <div class="wcard-r"><b>2. kiwi</b>19 net</div>
              <div class="wcard-r"><b>3. mono</b>7 net</div>
            </div>
          </div>
        </div>`,
    },
  };

  function show(cmd: string) {
    const reply = REPLIES[cmd];
    if (!reply || !bodyEl) return;
    bodyEl.innerHTML = reply.html;
    if (chanEl) chanEl.textContent = reply.chan;
    chips.forEach((c) => c.classList.toggle('active', c.dataset.cmd === cmd));
  }

  chips.forEach((chip) => chip.addEventListener('click', () => show(chip.dataset.cmd ?? '')));
  show('ban');
</script>
