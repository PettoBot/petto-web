---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { useTranslations, localePath, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = localePath[lang];

const featureIcons = ['ph:users-three-fill', 'ph:terminal-window-fill', 'ph:moon-stars-fill', 'ph:link-fill', 'ph:shield-check-fill', 'ph:notebook-fill'];
const featureColors = ['blue', 'green', 'yellow', 'red', 'blue', 'green'];
const features = t.features.grid.map((f, i) => ({ ...f, icon: featureIcons[i], color: featureColors[i] }));

// Real guild count, fetched from Supabase at build time (falls back to a fixed
// number if the request fails, e.g. no network on the build machine).
async function fetchActiveServers() {
  const url = process.env.SUPABASE_URL;
  const key = process.env.SUPABASE_SERVICE_ROLE_KEY;
  if (!url || !key) return null;

  try {
    const res = await fetch(`${url}/rest/v1/guilds?select=guild_id`, {
      headers: { apikey: key, Authorization: `Bearer ${key}`, Prefer: 'count=exact', Range: '0-0' },
    });
    const range = res.headers.get('content-range'); // "0-0/N"
    return range ? range.split('/')[1] : null;
  } catch {
    return null;
  }
}

const activeServers = (await fetchActiveServers()) ?? '4';

const releases = t.releases.items.slice(0, 3).map((r) => ({ ...r, href: r.href ? `${base}${r.href}` : null, banner: r.banner || null }));

const stats = [
  { n: activeServers, l: t.stats.servers, icon: 'ph:globe-hemisphere-west-fill', color: 'blue' },
  { n: '56', l: t.stats.commands, icon: 'ph:terminal-window-fill', color: 'green' },
  { n: '9', l: t.stats.categories, icon: 'ph:list-checks-fill', color: 'yellow' },
  { n: '100%', l: t.stats.postgres, icon: 'ph:database-fill', color: 'red' },
];

---
<Base title="Petto, a Discord bot" lang={lang}>
  <main id="top">
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <div class="hero-eyebrow"><span class="dot"></span><span class="eyebrow">{t.hero.eyebrow}</span></div>
          <div class="headline-row">
            <img src="/assets/mascot-icon.png" alt="" />
            <h1 class="headline">{t.hero.headline}</h1>
          </div>
          <p class="lede">{t.hero.lede}</p>
          <div class="hero-ctas">
            <a class="btn btn-accent" href="https://petto.sbs/invite" target="_blank" rel="noopener">{t.hero.cta1}</a>
            <a class="btn btn-ghost" href={`${base}/commands`}>{t.hero.cta2}</a>
          </div>
          <p class="hero-note">{t.hero.note}</p>
        </div>

        <div class="mock-wrap">
          <img src="/assets/duck-purple.png" alt="" class="peek-duck" />
          <div class="mock" aria-hidden="true">
          <div class="mock-bar">
            <span class="chip" style="background:var(--red)"></span>
            <span class="chip" style="background:var(--yellow)"></span>
            <span class="chip" style="background:var(--green)"></span>
            <span class="chan">#moderation</span>
          </div>
          <div class="mock-body">
            <div class="msg">
              <div class="av user"><img src="/assets/user-liam.png" alt="" /></div>
              <div>
                <div class="meta"><b>liam</b><span class="time">today 21:04</span></div>
                <div class="txt">!ban @spammer unauthorized advertising</div>
              </div>
            </div>
            <div class="msg">
              <div class="av bot"><img src="/assets/bot-avatar.png" alt="" /></div>
              <div>
                <div class="meta"><b>tetto</b><span class="tag">BOT</span><span class="time">today 21:04</span></div>
                <div class="case-card">
                  <div class="ct"><img src="/assets/icon-hammer.png" alt="" />Case #142 &middot; Ban</div>
                  <div class="row"><b>User</b>spammer#0192</div>
                  <div class="row"><b>Moderator</b>liam</div>
                  <div class="row"><b>Reason</b>unauthorized advertising</div>
                </div>
              </div>
            </div>
            <div class="msg">
              <div class="av user"><img src="/assets/user-julia.png" alt="" /></div>
              <div>
                <div class="meta"><b>☉Solo Lester☉</b><span class="time">today 21:07</span></div>
                <div class="txt">!giveaway quick 10m 1 "Nitro Classic"<span class="cursor-line"></span></div>
              </div>
            </div>
          </div>
          </div>
        </div>
      </div>
    </section>

    <section class="announce-section">
      <div class="wrap reveal">
        <a class="announce-card" href={`${base}/blog/blibot-to-petto`}>
          <div class="announce-img-wrap">
            <img src="/assets/banner-blibot.svg" alt="" class="announce-img" />
          </div>
          <div class="announce-copy">
            <span class="pill">{t.announce.pill}</span>
            <h3>{t.announce.title}</h3>
            <p>{t.announce.desc} <Icon name="ph:arrow-right" width="14" height="14" /></p>
          </div>
        </a>
      </div>
    </section>

    <section class="alt">
      <div class="wrap reveal">
        <div class="win stats-win">
          <div class="win-bar">
            <span class="chip" style="background:var(--red)"></span>
            <span class="chip" style="background:var(--yellow)"></span>
            <span class="chip" style="background:var(--green)"></span>
            <span class="win-chan">{t.stats.chan}</span>
          </div>
          <div class="stats">
            {stats.map((s) => (
              <div class={`stat stat-${s.color}`}>
                <Icon name={s.icon} class="stat-ic" />
                <div class="stat-num">
                  <span class="n num">{s.n}</span>
                </div>
                <div class="l">{s.l}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="features">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="eyebrow">{t.features.eyebrow}</div>
          <h2>{t.features.title}</h2>
          <p>{t.features.desc}</p>
        </div>

        <div class="showcase showcase-red reveal">
          <div class="showcase-copy">
            <div class="eyebrow">{t.features.moderationEyebrow}</div>
            <h3>{t.features.moderationTitle}</h3>
            <p>{t.features.moderationDesc}</p>
          </div>
          <div class="showcase-mock">
            <div class="win">
              <div class="win-bar">
                <span class="chip" style="background:var(--red)"></span>
                <span class="chip" style="background:var(--yellow)"></span>
                <span class="chip" style="background:var(--green)"></span>
                <span class="win-chan">#moderation</span>
              </div>
              <div class="win-body">
                <div class="wmsg">
                  <img class="wav" src="/assets/user-liam.png" alt="" />
                  <div>
                    <div class="wmeta"><b>liam</b><span>today 19:22</span></div>
                    <div class="wtxt">!mute @user 1h spamming links</div>
                  </div>
                </div>
                <div class="wmsg">
                  <div class="wav bot"><img src="/assets/bot-avatar.png" alt="" /></div>
                  <div>
                    <div class="wmeta"><b>tetto</b><span class="wtag">BOT</span></div>
                    <div class="wcard">
                      <div class="wcard-t">Case #143 &middot; Mute</div>
                      <div class="wcard-r"><b>Duration</b>1 hour</div>
                      <div class="wcard-r"><b>Expires</b>in 59 minutes</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="showcase showcase-yellow reveal reverse">
          <div class="showcase-copy">
            <div class="eyebrow">{t.features.giveawaysEyebrow}</div>
            <h3>{t.features.giveawaysTitle}</h3>
            <p>{t.features.giveawaysDesc}</p>
          </div>
          <div class="showcase-mock">
            <div class="win">
              <div class="win-bar">
                <span class="chip" style="background:var(--red)"></span>
                <span class="chip" style="background:var(--yellow)"></span>
                <span class="chip" style="background:var(--green)"></span>
                <span class="win-chan">#giveaways</span>
              </div>
              <div class="win-body">
                <div class="wgiveaway">
                  <div class="wgiveaway-t">★ Discord Nitro Classic</div>
                  <div class="wgiveaway-r">Hosted by <b>liam</b> &middot; 1 winner</div>
                  <div class="wgiveaway-r">Ends in 9 minutes</div>
                  <button class="wbtn">🎉 Enter Giveaway</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="showcase showcase-blue reveal">
          <div class="showcase-copy">
            <div class="eyebrow">{t.features.ticketsEyebrow}</div>
            <h3>{t.features.ticketsTitle}</h3>
            <p>{t.features.ticketsDesc}</p>
          </div>
          <div class="showcase-mock">
            <div class="win">
              <div class="win-bar">
                <span class="chip" style="background:var(--red)"></span>
                <span class="chip" style="background:var(--yellow)"></span>
                <span class="chip" style="background:var(--green)"></span>
                <span class="win-chan">#support</span>
              </div>
              <div class="win-body">
                <div class="wticket">
                  <div class="wticket-t">Need help?</div>
                  <div class="wticket-d">Open a ticket and staff will be with you shortly.</div>
                  <button class="wbtn">🎫 Open a ticket</button>
                </div>
                <div class="wsys">Ticket <b>#42</b> opened by <b>kiwi</b>, routed to <b>Support</b>.</div>
              </div>
            </div>
          </div>
        </div>

        <div class="showcase showcase-green reveal reverse">
          <div class="showcase-copy">
            <div class="eyebrow">{t.features.levelingEyebrow}</div>
            <h3>{t.features.levelingTitle}</h3>
            <p>{t.features.levelingDesc}</p>
          </div>
          <div class="showcase-mock">
            <div class="win">
              <div class="win-bar">
                <span class="chip" style="background:var(--red)"></span>
                <span class="chip" style="background:var(--yellow)"></span>
                <span class="chip" style="background:var(--green)"></span>
                <span class="win-chan">#general</span>
              </div>
              <div class="win-body">
                <div class="wlevel">
                  <div class="wlevel-t">✨ <b>kiwi</b> leveled up to <b>level 12</b>!</div>
                  <div class="wlevel-bar"><span style="width: 64%"></span></div>
                  <div class="wlevel-xp">8,240 / 12,900 XP</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="feat-lead">{t.features.leadMore}</div>
        <div class="feat-grid reveal">
          {features.map((f) => (
            <div class={`feat feat-${f.color}`}>
              <div class="feat-badge"><Icon name={f.icon} class="ic" /></div>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </div>
          ))}
        </div>

        <div class="feat-more reveal">
          <a class="btn btn-ghost" href={`${base}/commands`}>{t.features.seeAll} &rarr;</a>
        </div>
      </div>
    </section>

    <section id="demo" class="alt">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="eyebrow">{t.releases.eyebrow}</div>
          <h2>{t.releases.title}</h2>
        </div>
        <a class="btn btn-ghost releases-see-all reveal" href={`${base}/news`}>{t.releases.seeAll} &rarr;</a>
        <div class="releases reveal">
          {releases.map((r) => (
            <div class="release">
              <div class="release-banner" class:list={{ empty: !r.banner }}>
                {r.banner ? <img src={r.banner} alt="" /> : <img src="/assets/mascot-icon.png" alt="" class="release-placeholder" />}
              </div>
              <div class="release-body">
                <h3>{r.title}</h3>
                <p>{r.desc}</p>
                <div class="release-meta">
                  <div class="release-row"><span>{t.releases.date}</span><b>{r.date}</b></div>
                  <div class="release-row"><span>{t.releases.category}</span><b>{r.category}</b></div>
                </div>
                {r.href ? (
                  <a class="btn btn-ghost btn-sm" href={r.href}>{t.releases.read} <Icon name="ph:arrow-right" width="13" height="13" /></a>
                ) : (
                  <span class="release-soon">{t.releases.notPublished}</span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="playground">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="eyebrow">{t.playground.eyebrow}</div>
          <h2>{t.playground.title}</h2>
          <p>{t.playground.desc}</p>
        </div>

        <div class="try reveal">
          <div class="try-chips" id="tryChips">
            <button class="try-chip" data-cmd="ban">!ban</button>
            <button class="try-chip" data-cmd="rank">!rank</button>
            <button class="try-chip" data-cmd="giveaway">!giveaway quick</button>
            <button class="try-chip" data-cmd="invites">!invites top</button>
          </div>

          <div class="win try-win">
            <div class="win-bar">
              <span class="chip" style="background:var(--red)"></span>
              <span class="chip" style="background:var(--yellow)"></span>
              <span class="chip" style="background:var(--green)"></span>
              <span class="win-chan" id="tryChan">#moderation</span>
            </div>
            <div class="win-body" id="tryBody"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="stack-sec alt">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="eyebrow">{t.stack.eyebrow}</div>
          <h2>{t.stack.title}</h2>
        </div>
        <div class="stack-grid reveal">
          {t.stack.items.map((s) => (
            <div class="stack-item">
              <Icon name={s.icon} class="stack-ic" style={`color: ${s.color}`} />
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="credits-sec">
      <div class="wrap">
        <div class="credits-head reveal">
          <div class="eyebrow">{t.credits.title}</div>
          <p class="credits-disclaimer">{t.credits.disclaimer}</p>
        </div>
      </div>
      <div class="marquee reveal">
        <div class="marquee-track">
          {[...t.credits.items, ...t.credits.items].map((c) => (
            <div class="marquee-item">
              <Icon name={`simple-icons:${c.slug}`} class="marquee-ic" />
              <span>{c.name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-band alt">
      <div class="wrap reveal">
        <div class="duck-family">
          <img src="/assets/duck-green.png" alt="" style="transform: rotate(-9deg);" />
          <img src="/assets/mascot-icon.png" alt="" style="transform: translateY(-10px);" />
          <img src="/assets/duck-red.png" alt="" style="transform: rotate(9deg);" />
        </div>
        <h2>{t.cta.title}</h2>
        <p>{t.cta.desc}</p>
        <a class="btn btn-accent" href="https://petto.sbs/invite" target="_blank" rel="noopener">{t.cta.button}</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero { padding: 80px 0 72px; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: center; }
  .hero-eyebrow { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
  .hero-eyebrow .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 3px var(--green-soft); }
  .headline-row { display: flex; align-items: center; gap: 18px; margin-bottom: 20px; }
  .headline-row img { width: 76px; height: 76px; flex-shrink: 0; }
  h1.headline { font-size: 43px; line-height: 1.14; }
  .hero p.lede { font-size: 17.5px; color: var(--text-muted); max-width: 46ch; margin-bottom: 34px; }
  .hero-ctas { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .hero-note { margin-top: 22px; font-size: 13px; color: var(--text-dim); }

  .mock-wrap { position: relative; }
  .peek-duck {
    position: absolute; top: -34px; right: 28px; width: 92px; height: auto; z-index: 2;
    transform: rotate(8deg); filter: drop-shadow(0 12px 20px rgba(0,0,0,0.35));
    animation: rise 0.7s cubic-bezier(0.16,1,0.3,1) 0.05s both;
  }
  .mock { background: var(--card); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; animation: rise 0.7s cubic-bezier(0.16,1,0.3,1) 0.15s both; box-shadow: 0 30px 60px -30px rgba(0,0,0,0.45); }
  .mock-bar { display: flex; align-items: center; gap: 8px; padding: 13px 16px; border-bottom: 1px solid var(--border-soft); }
  .mock-bar .chip { width: 10px; height: 10px; border-radius: 50%; }
  .mock-bar .chan { margin-left: 8px; font-family: var(--mono); font-size: 12.5px; color: var(--text-dim); }
  .mock-body { padding: 18px 18px 20px; display: flex; flex-direction: column; gap: 16px; }
  .msg { display: flex; gap: 12px; }
  .msg .av { width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 15px; font-weight: 700; color: var(--accent-ink); overflow: hidden; }
  .msg .av.user { background: var(--border); color: var(--text-muted); }
  .msg .av.user img { width: 100%; height: 100%; object-fit: cover; }
  .msg .av.bot img { width: 100%; height: 100%; object-fit: cover; }
  .msg .meta { font-size: 13px; margin-bottom: 3px; }
  .msg .meta b { font-weight: 600; }
  .msg .meta .tag { font-family: var(--mono); font-size: 10px; background: var(--accent); color: var(--accent-ink); padding: 1px 5px; border-radius: 4px; margin-left: 6px; vertical-align: 1px; }
  .msg .meta .time { color: var(--text-dim); margin-left: 7px; font-size: 11.5px; }
  .msg .txt { font-size: 14.5px; color: var(--text-muted); font-family: var(--mono); }
  .case-card { margin-top: 8px; background: var(--bg-raise); border: 1px solid var(--border-soft); border-radius: 10px; padding: 13px 15px; font-size: 13.5px; max-width: 340px; }
  .case-card .ct { font-family: var(--serif); font-weight: 600; font-size: 14.5px; margin-bottom: 7px; display: flex; align-items: center; gap: 8px; }
  .case-card .ct img { width: 18px; height: 18px; }
  .case-card .row { display: flex; gap: 6px; color: var(--text-muted); margin-bottom: 3px; }
  .case-card .row b { color: var(--text); font-weight: 600; min-width: 68px; display: inline-block; }
  .cursor-line { display: inline-block; width: 7px; height: 15px; background: var(--accent); vertical-align: -2px; animation: blink 1s step-end infinite; }

  .announce-section { padding: 0 0 44px; }
  .announce-card { display: block; background: var(--card); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; text-decoration: none; color: var(--text); transition: border-color 0.15s ease; }
  .announce-card:hover { border-color: var(--text-dim); }
  .announce-img-wrap { overflow: hidden; }
  .announce-img { width: 100%; height: auto; display: block; transition: transform 0.5s cubic-bezier(0.16,1,0.3,1); }
  .announce-card:hover .announce-img { transform: scale(1.06); }
  .announce-copy { padding: 26px 28px 30px; }
  .announce-copy .pill { display: inline-block; font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); background: var(--bg-raise); border: 1px solid var(--border-soft); padding: 4px 11px; border-radius: 999px; margin-bottom: 14px; }
  .announce-copy h3 { font-size: 24px; margin-bottom: 8px; }
  .announce-copy p { font-size: 15px; color: var(--text-muted); margin: 0; display: flex; align-items: center; gap: 6px; }
  .announce-copy p :global(svg) { color: var(--accent); }

  .stats-win { max-width: 720px; margin: 0 auto; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border-soft); }
  .stat { position: relative; background: var(--card); padding: 26px 22px 24px; overflow: hidden; transition: background 0.2s ease; }
  .stat:hover { background: var(--card-hover); }
  .stat::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: var(--stat-color); opacity: 0.7;
  }
  .stat-blue { --stat-color: var(--accent); }
  .stat-green { --stat-color: var(--green); }
  .stat-yellow { --stat-color: var(--yellow); }
  .stat-red { --stat-color: var(--red); }
  .stat :global(.stat-ic) { width: 20px; height: 20px; color: var(--stat-color); margin-bottom: 16px; }
  .stat-num { display: flex; align-items: baseline; gap: 9px; }
  .stat .n { font-family: var(--serif); font-size: 34px; font-weight: 600; }
  .stat .l { font-size: 13.5px; color: var(--text-muted); margin-top: 6px; }

  .showcase { display: grid; grid-template-columns: 1fr 1fr; gap: 0; align-items: stretch; margin-bottom: 40px; border-radius: 22px; overflow: hidden; }
  .showcase.reverse .showcase-copy { order: 2; }
  .showcase.reverse .showcase-mock { order: 1; }
  .showcase-red { --sc: var(--red); }
  .showcase-yellow { --sc: var(--yellow); }
  .showcase-blue { --sc: var(--accent); }
  .showcase-green { --sc: var(--green); }
  .showcase-copy { background: color-mix(in srgb, var(--sc) 20%, var(--bg)); padding: 44px 46px; display: flex; flex-direction: column; justify-content: center; }
  .showcase-copy .eyebrow { color: var(--sc); font-weight: 700; }
  .showcase-copy h3 { font-size: 25px; margin: 12px 0 14px; line-height: 1.3; }
  .showcase-copy p { font-size: 15.5px; color: var(--text-muted); line-height: 1.7; max-width: 40ch; }
  .showcase-mock { position: relative; padding: 40px; display: flex; align-items: center; justify-content: center; background: color-mix(in srgb, var(--sc) 9%, var(--bg-raise)); }

  .win { background: var(--card); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; box-shadow: 0 24px 48px -28px rgba(0,0,0,0.4); }
  .win-bar { display: flex; align-items: center; gap: 8px; padding: 12px 15px; border-bottom: 1px solid var(--border-soft); }
  .win-bar .chip { width: 9px; height: 9px; border-radius: 50%; }
  .win-chan { margin-left: 6px; font-family: var(--mono); font-size: 12px; color: var(--text-dim); }
  .win-body { padding: 20px; display: flex; flex-direction: column; gap: 16px; }
  /* :global() here because #tryBody's content is swapped in by client-side JS at runtime,
