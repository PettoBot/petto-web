---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import SpecularButton from '../react/SpecularButton.jsx';
import { useTranslations, localePath, sortedReleases, type Locale } from '../i18n/ui';
import { getAllCommands } from '../utils/commandList';
import { LOG_EVENT_IDS } from '../data/logEvents';
import DiscordShot from './DiscordShot.astro';
import ServerCarousel from './ServerCarousel.astro';
import DeviceLaptop from './DeviceLaptop.astro';
import DevicePhone from './DevicePhone.astro';
import HomeScenes from './HomeScenes.astro';
import HomeLayers from './HomeLayers.astro';
import { HOME_COPY } from '../data/homeCopy';
import { getShot } from '../data/shotsIndex';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
// Short and in the language of the page: the title of the tab and of the link preview.
const HOME_TITLE: Record<Locale, string> = { en: 'Petto, a Discord bot', es: 'Petto, un bot de Discord', 'pt-BR': 'Petto, um bot do Discord' };
const base = localePath[lang];

const featureIcons = ['ph:users-three-fill', 'ph:terminal-window-fill', 'ph:moon-stars-fill', 'ph:link-fill', 'ph:shield-check-fill', 'ph:notebook-fill'];
const featureColors = ['blue', 'green', 'yellow', 'red', 'blue', 'green'];
const features = t.features.grid.map((f, i) => ({ ...f, icon: featureIcons[i], color: featureColors[i] }));

// The simulated screenshots of the home page: what the members see in Discord. The full set is on the Features page.
const SEE: Record<Locale, { eyebrow: string; title: string; desc: string; button: string }> = {
  en: { eyebrow: 'In Discord', title: 'This is what your members see', desc: 'Cards with the look of Discord, in your language, with the buttons right there.', button: 'See every feature' },
  es: { eyebrow: 'En Discord', title: 'Esto es lo que ven tus miembros', desc: 'Tarjetas con el aspecto de Discord, en tu idioma, con los botones ahí mismo.', button: 'Ver todas las características' },
  'pt-BR': { eyebrow: 'No Discord', title: 'É isso que seus membros veem', desc: 'Cards com a cara do Discord, no seu idioma, com os botões ali mesmo.', button: 'Ver todos os recursos' },
};
const see = SEE[lang];
const hc = HOME_COPY[lang];
// The pictures of the dashboard (taken at the width of a laptop and of a phone, in dark, with the sample data of the main server) in the language of the page.
const imgLang = lang === 'pt-BR' ? 'pt' : lang;
const dashImg = (page: string, kind: 'pc' | 'phone') => `/assets/home/dash-${page}-${kind}-${imgLang}.webp`;
const discordLaptopShot = getShot('stats-overview', lang);
const discordPhoneShots = ['giveaway', 'levelup', 'tickets-panel'].map((id) => getShot(id, lang));

const activeServers = '—';
const commandCount = getAllCommands().length;

const releases = sortedReleases(lang).slice(0, 3).map((r) => ({ ...r, href: r.href ? `${base}${r.href}` : null, banner: r.banner || null }));

const stats = [
  { key: 'servers', n: activeServers, l: t.stats.servers, icon: 'ph:globe-hemisphere-west-fill', color: 'blue' },
  { key: 'commands', n: String(commandCount), l: t.stats.commands, icon: 'ph:terminal-window-fill', color: 'green' },
  // How many kinds of events a server can send to its log channels (the Logging page), counted, not written by hand.
  { key: 'logEvents', n: String(LOG_EVENT_IDS.length), l: t.stats.logEvents, icon: 'ph:list-checks-fill', color: 'yellow' },
  { key: 'postgres', n: '100%', l: t.stats.postgres, icon: 'ph:database-fill', color: 'red' },
];

---
<Base title={HOME_TITLE[lang]} lang={lang} skin="ash">
  <main id="top">
    <section class="hero">
      <div class="wrap hero-center">
        <div class="hero-eyebrow"><span class="dot" data-bot-dot></span><span class="eyebrow">{hc.hero.eyebrow}</span></div>
        <h1 class="headline">{hc.hero.before} <em>{hc.hero.em}</em> {hc.hero.after}</h1>
        <p class="lede">{hc.hero.lede}</p>
        <div class="hero-ctas">
          <SpecularButton client:idle size="lg" href="https://petto.sbs/invite" target="_blank" rel="noopener" transparent tint="#ffffff" tintOpacity={0} baseColor="#bfc4d2" textColor="var(--text)" lineColor="#ffffff" intensity={1.2} speed={0.8} radius={11}>{t.hero.cta1}</SpecularButton>
          <a class="btn btn-ghost" href={`${base}/commands`}>{t.hero.cta2}</a>
        </div>
      </div>
      <div class="wrap hero-laptop">
        <DeviceLaptop src={dashImg('overview', 'pc')} alt={hc.devices.laptopAlt} pop />
      </div>
    </section>

    <section class="announce-section">
      <div class="wrap reveal">
        <a class="announce-card" href={`${base}${t.announce.href}`}>
          <div class="announce-img-wrap">
            <img src={t.announce.image} alt="" class="announce-img" />
          </div>
          <div class="announce-copy">
            <span class="pill">{t.announce.pill}</span>
            <h3>{t.announce.title}</h3>
            <p>{t.announce.desc} <Icon name="ph:arrow-right" width="14" height="14" /></p>
          </div>
        </a>
      </div>
    </section>

    <ServerCarousel lang={lang} />

    <section class="phones-sec">
      <div class="wrap phones-grid">
        <div class="phones-copy">
          <span class="kicker">{hc.phones.eyebrow}</span>
          <h2>{hc.phones.title} <em>{hc.phones.em}</em></h2>
          <p>{hc.phones.desc}</p>
          <ul class="points">
            {hc.phones.points.map((point) => <li><Icon name="ph:check-circle-fill" width="20" height="20" />{point}</li>)}
          </ul>
        </div>
        <div class="fan" data-fan>
          {([['leveling', 'l'], ['modules', 'c'], ['welcome', 'r']] as const).map(([page, pos]) => (
            <button type="button" class="fan-phone" data-pos={pos} data-src={dashImg(page, 'phone')} data-alt={hc.devices.phoneAlt[page]} aria-label={hc.devices.phoneAlt[page]}>
              <DevicePhone src={dashImg(page, 'phone')} alt="" />
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="alt">
      <div class="wrap reveal">
        <div class="win stats-win">
          <div class="win-bar">
            <span class="chip" style="background:var(--red)"></span>
            <span class="chip" style="background:var(--yellow)"></span>
            <span class="chip" style="background:var(--green)"></span>
            <span class="win-chan">{t.stats.chan}</span>
          </div>
          <div class="stats">
            {stats.map((s) => (
              <div class={`stat stat-${s.color}`} data-home-stat={s.key}>
                <Icon name={s.icon} class="stat-ic" />
                <div class="stat-num">
                  <span class="n num" data-home-stat-value={s.key}>{s.n}</span>
                </div>
                <div class="l">{s.l}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="layers" class="layers-sec">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="kicker">{hc.layers.eyebrow}</span>
          <h2>{hc.layers.title} <em>{hc.layers.em}</em></h2>
          <p>{hc.layers.desc}</p>
        </div>
        <HomeLayers lang={lang} />
      </div>
    </section>

    <section id="features">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="kicker">{hc.scenes.eyebrow}</span>
          <h2>{hc.scenes.title} <em>{hc.scenes.em}</em></h2>
          <p>{hc.scenes.desc}</p>
        </div>
        <HomeScenes lang={lang} />

        <div class="feat-lead">{t.features.leadMore}</div>
        <div class="feat-grid reveal">
          {features.map((f) => (
            <div class={`feat feat-${f.color}`}>
              <div class="feat-badge"><Icon name={f.icon} class="ic" /></div>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </div>
          ))}
        </div>

        <div class="feat-more reveal">
          <a class="btn btn-ghost" href={`${base}/commands`}>{t.features.seeAll} &rarr;</a>
        </div>
      </div>
    </section>

    <section id="in-discord" class="alt">
      <div class="wrap">
        <div class="sec-head reveal">
          <span class="kicker">{hc.discord.eyebrow}</span>
          <h2>{hc.discord.title} <em>{hc.discord.em}</em></h2>
          <p>{hc.discord.desc}</p>
        </div>
        <div class="disc-devices reveal">
          <div class="disc-lap"><DeviceLaptop><DiscordShot shot={discordLaptopShot} /></DeviceLaptop></div>
          <div class="disc-ph"><DevicePhone>{discordPhoneShots.map((shot) => <DiscordShot shot={shot} />)}</DevicePhone></div>
        </div>
        <div class="feat-more reveal">
          <a class="btn btn-ghost" href={`${base}/features`}>{see.button} &rarr;</a>
        </div>
      </div>
    </section>

    <section id="demo" class="alt">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="eyebrow">{t.releases.eyebrow}</div>
          <h2>{t.releases.title}</h2>
        </div>
        <a class="btn btn-ghost releases-see-all reveal" href={`${base}/news`}>{t.releases.seeAll} &rarr;</a>
        <div class="releases reveal">
          {releases.map((r) => (
            <div class="release">
              <div class="release-banner" class:list={{ empty: !r.banner }}>
                {r.banner ? <img src={r.banner} alt="" /> : <img src="/assets/mascot-icon.webp" alt="" class="release-placeholder" />}
              </div>
              <div class="release-body">
                <h3>{r.title}</h3>
                <p>{r.desc}</p>
                <div class="release-meta">
                  <div class="release-row"><span>{t.releases.date}</span><b>{r.date}</b></div>
                  <div class="release-row"><span>{t.releases.category}</span><b>{r.category}</b></div>
                </div>
                {r.href ? (
                  <a class="btn btn-ghost btn-sm" href={r.href}>{t.releases.read} <Icon name="ph:arrow-right" width="13" height="13" /></a>
                ) : (
                  <span class="release-soon">{t.releases.notPublished}</span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="playground">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="eyebrow">{t.playground.eyebrow}</div>
          <h2>{t.playground.title}</h2>
          <p>{t.playground.desc}</p>
        </div>

        <div class="try reveal">
          <div class="try-chips" id="tryChips">
            <button class="try-chip" data-cmd="ban">!ban</button>
            <button class="try-chip" data-cmd="rank">!rank</button>
            <button class="try-chip" data-cmd="giveaway">!giveaway quick</button>
            <button class="try-chip" data-cmd="invites">!invites top</button>
          </div>

          <div class="win try-win">
            <div class="win-bar">
              <span class="chip" style="background:var(--red)"></span>
              <span class="chip" style="background:var(--yellow)"></span>
              <span class="chip" style="background:var(--green)"></span>
              <span class="win-chan" id="tryChan">#moderation</span>
            </div>
            <div class="win-body" id="tryBody"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="stack-sec alt">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="eyebrow">{t.stack.eyebrow}</div>
          <h2>{t.stack.title}</h2>
        </div>
        <div class="stack-grid reveal">
          {t.stack.items.map((s) => (
            <div class="stack-item">
              <Icon name={s.icon} class="stack-ic" style={`color: ${s.color}`} />
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="credits-sec">
      <div class="wrap">
        <div class="credits-head reveal">
          <div class="eyebrow">{t.credits.title}</div>
          <p class="credits-disclaimer">{t.credits.disclaimer}</p>
        </div>
      </div>
      <div class="marquee reveal">
        <div class="marquee-track">
          {[...t.credits.items, ...t.credits.items].map((c) => (
            <div class="marquee-item">
              <Icon name={`simple-icons:${c.slug}`} class="marquee-ic" />
              <span>{c.name}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-band alt">
      <div class="wrap reveal">
        <div class="duck-family">
          <img src="/assets/duck-green.png" alt="" style="transform: rotate(-9deg);" />
          <img src="/assets/duck-blue.png" alt="" style="transform: translateY(-10px);" />
          <img src="/assets/duck-red.png" alt="" style="transform: rotate(9deg);" />
        </div>
        <h2>{t.cta.title}</h2>
        <p>{t.cta.desc}</p>
        <SpecularButton client:idle size="md" href="https://petto.sbs/invite" target="_blank" rel="noopener" transparent tint="#ffffff" tintOpacity={0} baseColor="#bfc4d2" textColor="var(--text)" lineColor="#ffffff" intensity={1.2} speed={0.8} radius={11}>{t.cta.button}</SpecularButton>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero { padding: 80px 0 72px; }
  .hero-eyebrow { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
  .hero-eyebrow .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 3px var(--green-soft); transition: background .3s ease, box-shadow .3s ease; }
  /* The dot says whether the bot is online right now (see syncHomeServerStat): green online, yellow reconnecting, red offline. */
  .hero-eyebrow .dot[data-state='reconnecting'] { background: var(--yellow, #e5b546); box-shadow: 0 0 0 3px rgba(229, 181, 70, .22); }
  .hero-eyebrow .dot[data-state='offline'] { background: var(--red, #e5484d); box-shadow: 0 0 0 3px rgba(229, 72, 77, .2); }
  .hero-ctas { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }


  .announce-section { padding: 0 0 44px; }
  .announce-card { display: block; background: var(--card); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; text-decoration: none; color: var(--text); transition: border-color 0.15s ease; }
  .announce-card:hover { border-color: var(--text-dim); }
  .announce-img-wrap { overflow: hidden; }
  .announce-img { width: 100%; height: auto; display: block; transition: transform 0.5s cubic-bezier(0.16,1,0.3,1); }
  .announce-card:hover .announce-img { transform: scale(1.06); }
  .announce-copy { padding: 26px 28px 30px; }
  .announce-copy .pill { display: inline-block; font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); background: var(--bg-raise); border: 1px solid var(--border-soft); padding: 4px 11px; border-radius: 999px; margin-bottom: 14px; }
  .announce-copy h3 { font-size: 24px; margin-bottom: 8px; }
  .announce-copy p { font-size: 15px; color: var(--text-muted); margin: 0; display: flex; align-items: center; gap: 6px; }
  .announce-copy p :global(svg) { color: var(--accent); }

  /* web 0.3.0: the hero comes in piece by piece, the mascot breathes, a soft light sits behind it, and the stats count up once. */
  .hero { position: relative; isolation: isolate; }
  .hero::before { content: ''; position: absolute; inset: -6% 0 auto; height: 620px; z-index: -1; pointer-events: none; background: radial-gradient(46% 60% at 50% 38%, var(--ash-glow, rgba(201, 208, 219, .1)), transparent 72%); animation: heroGlow 1.2s ease both; }
  .hero p.lede { animation-delay: .14s; }
  .hero-ctas { animation-delay: .21s; }
  .hero-ctas .btn-ghost:active { transform: scale(.97); }
  /* The second hero button is as tall as the main one (50px), so the pair reads as one row. */
  .hero-ctas .btn-ghost { min-height: 50px; padding-inline: 26px; justify-content: center; }
  .hero { overflow-x: clip; }
  @media (max-width: 560px) { .hero-ctas .btn-ghost { width: 100%; } }
  .stat { transition: background .2s ease, transform .25s cubic-bezier(.16, 1, .3, 1); }
  .stat::before { transform: scaleX(0); transform-origin: left; transition: transform .9s cubic-bezier(.16, 1, .3, 1); }
  .stats.counted .stat::before { transform: none; }
  .stats.counted .stat:nth-child(2)::before { transition-delay: .08s; }
  .stats.counted .stat:nth-child(3)::before { transition-delay: .16s; }
  .stats.counted .stat:nth-child(4)::before { transition-delay: .24s; }
  .stat:hover :global(.stat-ic) { transform: translateY(-2px) scale(1.08); }
  .stat :global(.stat-ic) { transition: transform .3s cubic-bezier(.34, 1.56, .64, 1); }
  @keyframes heroIn { from { opacity: 0; transform: translateY(18px); filter: blur(4px); } to { opacity: 1; transform: none; filter: none; } }
  @keyframes heroGlow { from { opacity: 0; } to { opacity: .9; } }
  @keyframes heroFloat { 0%, 100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-5px) rotate(-3deg); } }
  @media (prefers-reduced-motion: reduce) {
    .hero::before, .hero-eyebrow, .hero h1.headline, .hero p.lede, .hero-ctas { animation: none; }
    .stat::before { transform: none; transition: none; }
  }

  .stats-win { max-width: 720px; margin: 0 auto; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border-soft); }
  .stat { position: relative; background: var(--card); padding: 26px 22px 24px; overflow: hidden; transition: background 0.2s ease; }
  .stat:hover { background: var(--card-hover); }
  .stat::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: var(--stat-color); opacity: 0.7;
  }
  .stat-blue { --stat-color: var(--accent); }
  .stat-green { --stat-color: var(--green); }
  .stat-yellow { --stat-color: var(--yellow); }
  .stat-red { --stat-color: var(--red); }
  .stat :global(.stat-ic) { width: 20px; height: 20px; color: var(--stat-color); margin-bottom: 16px; }
  .stat-num { display: flex; align-items: baseline; gap: 9px; }
  .stat .n { font-family: var(--serif); font-size: 34px; font-weight: 600; }
  .stat .l { font-size: 13.5px; color: var(--text-muted); margin-top: 6px; }

  /* One column is capped at 560px and centered, never left against the edge of the container with the right side empty. */
  @media (max-width: 980px) { .see-grid { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; } }
  /* From 700px there is room for two columns: the music card is the tall one, so it takes the right column and the other two stack on the left. */
  @media (min-width: 700px) and (max-width: 980px) { .see-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: auto 1fr; max-width: none; } .see-grid > :global(.dshot:nth-child(2)) { grid-row: span 2; } }


  .win { background: var(--card); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; box-shadow: 0 24px 48px -28px rgba(0,0,0,0.4); }
  .win-bar { display: flex; align-items: center; gap: 8px; padding: 12px 15px; border-bottom: 1px solid var(--border-soft); }
  .win-bar .chip { width: 9px; height: 9px; border-radius: 50%; }
  .win-chan { margin-left: 6px; font-family: var(--mono); font-size: 12px; color: var(--text-dim); }
  .win-body { padding: 20px; display: flex; flex-direction: column; gap: 16px; }
  /* :global() here because #tryBody's content is swapped in by client-side JS at runtime,
     after Astro's per-page scoping attributes are already baked into the static HTML, so
     dynamically-created elements never get the scoped attribute and need real global rules. */
  :global(.wmsg) { display: flex; gap: 11px; }
  :global(.wav) { width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: var(--text-muted); overflow: hidden; object-fit: cover; }
  :global(.wav.bot img) { width: 100%; height: 100%; object-fit: cover; }
  :global(.wmeta) { font-size: 12.5px; margin-bottom: 3px; }
  :global(.wmeta b) { font-weight: 600; }
  :global(.wmeta span) { color: var(--text-dim); margin-left: 6px; font-size: 11px; }
  :global(.wtag) { font-family: var(--mono); font-size: 9.5px; background: var(--accent); color: var(--accent-ink); padding: 1px 5px; border-radius: 4px; }
  :global(.wtxt) { font-size: 13.5px; color: var(--text-muted); font-family: var(--mono); }
  :global(.wcard) { margin-top: 6px; background: var(--bg-raise); border: 1px solid var(--border-soft); border-radius: 9px; padding: 12px 14px; font-size: 13px; max-width: 260px; }
  :global(.wcard-t) { font-family: var(--serif); font-weight: 600; font-size: 14px; margin-bottom: 6px; }
  :global(.wcard-r) { display: flex; gap: 6px; color: var(--text-muted); margin-bottom: 2px; }
  :global(.wcard-r b) { color: var(--text); font-weight: 600; min-width: 62px; display: inline-block; }
  :global(.wgiveaway) { background: var(--bg-raise); border: 1px solid var(--border-soft); border-radius: 10px; padding: 18px; }
  :global(.wgiveaway-t) { font-family: var(--serif); font-weight: 600; font-size: 17px; margin-bottom: 8px; }
  :global(.wgiveaway-r) { font-size: 13px; color: var(--text-muted); margin-bottom: 4px; }
  :global(.wgiveaway-r b) { color: var(--text); font-weight: 600; }
  :global(.wbtn) { margin-top: 14px; width: 100%; padding: 10px; border: none; border-radius: 8px; background: var(--accent); color: var(--accent-ink); font-family: var(--sans); font-size: 13.5px; font-weight: 600; cursor: default; }


  :global(.wlevel) { background: var(--bg-raise); border: 1px solid var(--border-soft); border-radius: 10px; padding: 18px; }
  :global(.wlevel-t) { font-size: 14px; margin-bottom: 14px; }
  :global(.wlevel-t b) { font-weight: 600; }
  :global(.wlevel-bar) { height: 8px; border-radius: 999px; background: var(--border-soft); overflow: hidden; margin-bottom: 8px; }
  :global(.wlevel-bar span) { display: block; height: 100%; background: var(--green); border-radius: 999px; }
  :global(.wlevel-xp) { font-family: var(--mono); font-size: 12px; color: var(--text-dim); }

  .feat-lead { margin-top: 56px; font-family: var(--mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 18px; }
  .feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border-soft); border: 1px solid var(--border-soft); border-radius: 14px; overflow: hidden; }
  .feat { background: var(--bg); padding: 30px 28px; transition: background 0.2s ease; }
  .feat:hover { background: var(--card-hover); }
  .feat-blue { --fc: var(--accent); }
  .feat-green { --fc: var(--green); }
  .feat-yellow { --fc: var(--yellow); }
  .feat-red { --fc: var(--red); }
