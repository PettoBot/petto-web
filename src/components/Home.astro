<script>
  const homeServerStat = document.querySelector<HTMLElement>('[data-home-stat-value="servers"]');
  const botDot = document.querySelector<HTMLElement>('[data-bot-dot]');
  // The last count seen, so the page shows it at once on the next visit and keeps it while the bot restarts (instead of "—" or 0).
  const LAST_KEY = 'petto-home-servers';
  try { const last = localStorage.getItem(LAST_KEY); if (homeServerStat && last && /^\d+$/.test(last)) homeServerStat.textContent = last; } catch {}

  async function syncHomeServerStat() {
    if (!homeServerStat) return;
    try {
      const response = await fetch('/api/status', { cache: 'no-store', headers: { Accept: 'application/json' } });
      if (!response.ok) return;
      const payload = await response.json();
      if (!Array.isArray(payload.shards) || payload.shards.length === 0) return;

      // Only the shards that are running now, as the status page counts them: an old shard row would add servers twice.
      const staleMs = 5 * 60 * 1000;
      let live = 0;
      let reconnecting = 0;
      const serverCount = payload.shards.reduce((total: number, shard: { guild_count?: number; status?: string; updated_at?: string }) => {
        const fresh = shard.updated_at ? Date.now() - new Date(shard.updated_at).getTime() <= staleMs : false;
        if (!fresh || shard.status === 'Disconnected') return total;
        if (shard.status === 'Ready') live += 1; else reconnecting += 1;
        const count = Number(shard.guild_count);
        return total + (Number.isFinite(count) ? count : 0);
      }, 0);
      if (botDot) botDot.dataset.state = live ? 'online' : reconnecting ? 'reconnecting' : 'offline';
      // While the bot restarts no shard is fresh: the last count stays on screen.
      if (serverCount > 0) {
        homeServerStat.textContent = String(serverCount);
        try { localStorage.setItem(LAST_KEY, String(serverCount)); } catch {}
      }
    } catch {}
  }

  syncHomeServerStat();
  window.setInterval(syncHomeServerStat, 60_000);
</script>

<script>
  // The stats count up from zero the first time they are seen (not the server count, which the live status keeps up to date).
  const statsBox = document.querySelector<HTMLElement>('.stats');
  if (statsBox) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const run = () => {
      statsBox.classList.add('counted');
      if (reduce) return;
      statsBox.querySelectorAll<HTMLElement>('[data-home-stat-value]').forEach((el) => {
        if (el.dataset.homeStatValue === 'servers') return;
        const match = /^(\d+)(%?)$/.exec((el.textContent ?? '').trim());
        if (!match) return;
        const target = Number(match[1]);
        const start = performance.now();
        const step = (now: number) => {
          const p = Math.min(1, (now - start) / 1100);
          el.textContent = `${Math.round(target * (1 - Math.pow(1 - p, 3)))}${match[2]}`;
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => { if (entries.some((e) => e.isIntersecting)) { io.disconnect(); run(); } }, { threshold: 0.4 });
      io.observe(statsBox);
    } else run();
  }

  // The phones of the fan: a tap on a side phone brings it to the middle (the one that was there takes its place); a tap on the middle one opens it bigger.
  const fan = document.querySelector<HTMLElement>('[data-fan]');
  if (fan) {
    fan.addEventListener('click', (event) => {
      const phone = (event.target as HTMLElement).closest<HTMLElement>('.fan-phone');
      if (!phone) return;
      const pos = phone.dataset.pos;
      if (pos === 'c') {
        window.dispatchEvent(new CustomEvent('petto-pop', { detail: { src: phone.dataset.src, alt: phone.dataset.alt, from: phone } }));
        return;
      }
      const middle = fan.querySelector<HTMLElement>('.fan-phone[data-pos="c"]');
      if (middle && pos) { middle.dataset.pos = pos; phone.dataset.pos = 'c'; }
    });
  }
</script>
