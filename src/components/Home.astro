  }
  .try-chip:hover { border-color: var(--text-dim); color: var(--text); }
  .try-chip.active { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
  .try-win .win-body { min-height: 120px; }
  @keyframes popIn { from { transform: scale(0.96) translateY(6px); opacity: 0; } to { transform: scale(1) translateY(0); opacity: 1; } }
  .try-win .win-body > * { animation: popIn 0.3s cubic-bezier(0.16,1,0.3,1) both; }

  #playground { padding-bottom: 56px; }
  .stack-sec { padding-top: 56px; }
  .stack-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border-soft); border: 1px solid var(--border-soft); border-radius: 14px; overflow: hidden; }
