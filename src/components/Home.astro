---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { useTranslations, localePath, sortedReleases, type Locale } from '../i18n/ui';
import { getAllCommands } from '../utils/commandList';
import { LOG_EVENT_IDS } from '../data/logEvents';
import ServerCarousel from './ServerCarousel.astro';
import HomeChartDemo from './HomeChartDemo.astro';
import HomeLayers from './HomeLayers.astro';
import IsoArt from './IsoArt.astro';
import { HOME_COPY } from '../data/homeCopy';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const HOME_TITLE: Record<Locale, string> = {
  en: 'Petto, a Discord bot',
  es: 'Petto, un bot de Discord',
  'pt-BR': 'Petto, um bot do Discord',
};
const base = localePath[lang];
const hc = HOME_COPY[lang];

const activeServers = '23';
const commandCount = getAllCommands().length;
const logCount = LOG_EVENT_IDS.length;
const releases = sortedReleases(lang).slice(0, 3).map((r) => ({
  ...r,
  href: r.href ? `${base}${r.href}` : null,
  banner: r.banner || null,
}));

const stats = [
  { key: 'servers', n: activeServers, l: t.stats.servers, sub: hc.numbers.subs.servers, icon: 'ph:globe-hemisphere-west-fill', color: 'blue' },
  { key: 'commands', n: String(commandCount), l: t.stats.commands, sub: hc.numbers.subs.commands, icon: 'ph:terminal-window-fill', color: 'green' },
  { key: 'logEvents', n: String(logCount), l: t.stats.logEvents, sub: hc.numbers.subs.logEvents, icon: 'ph:list-checks-fill', color: 'yellow' },
  { key: 'postgres', n: '100%', l: t.stats.postgres, sub: hc.numbers.subs.postgres, icon: 'ph:database-fill', color: 'red' },
];

const VETOX_HOME = {
  en: {
    dashCta: 'Open dashboard',
    heroChips: ['Moderation', 'Tickets & Forms', 'Leveling', 'Giveaways', 'Embeds V2', 'Backups'],
    showcaseKicker: 'Every job. One bot.',
    showcaseTitle: 'All on the free plan.',
    showcaseSub: 'Configure once in the web dashboard, and watch Petto run your channels automatically.',
    tabs: [
      { id: 'mod', icon: 'ph:shield-check-fill', label: 'Moderation', chan: '#mod-log', cfgTitle: 'Auto-Moderation', cfgSub: 'Stops spam, phishing links, and mass mentions in milliseconds.', toggles: ['Anti-spam burst filter', 'Scam & phishing shield', 'Auto-timeout repeat offenders'] },
      { id: 'lvl', icon: 'ph:chart-line-up-fill', label: 'Leveling', chan: '#general', cfgTitle: 'XP & Rank Cards', cfgSub: 'Custom image cards, voice XP, and automatic role rewards.', toggles: ['Text & voice XP enabled', 'Custom rank card fonts', 'Auto-assign milestone roles'] },
      { id: 'wel', icon: 'ph:hand-waving-fill', label: 'Welcome', chan: '#welcome', cfgTitle: 'Welcome Cards', cfgSub: 'Greet every new member with a crisp image card and auto-roles.', toggles: ['Custom welcome image card', 'Join auto-roles enabled', 'DM welcome guide'] },
      { id: 'tkt', icon: 'ph:ticket', label: 'Tickets', chan: '#support-panel', cfgTitle: 'Ticket Panels', cfgSub: 'Custom intake forms, private threads, and full HTML transcripts.', toggles: ['Pre-ticket intake form', 'Private support channels', 'Auto-save transcripts'] },
      { id: 'gwy', icon: 'ph:gift-fill', label: 'Giveaways', chan: '#giveaways', cfgTitle: 'Giveaways', cfgSub: 'Role requirements, bonus entries, and instant rerolls.', toggles: ['One-click button entry', 'Role & level requirements', 'Automatic winner DM'] },
    ],
    bentoKicker: 'Security & Control',
    bentoTitle: 'Locked down, day and night.',
    bentoSub: 'Five layers of protection working together so your staff never gets caught off guard.',
    bentoCards: [
      { wide: true, icon: 'ph:shield-warning-fill', color: 'blue', badge: 'Real-time', title: 'Anti-Nuke & Protection', desc: 'Detects mass channel deletions, unauthorized role edits, and rogue admins — quarantining threats before damage spreads.' },
      { wide: false, icon: 'ph:lock-key-fill', color: 'green', badge: 'Instant', title: 'Verification', desc: 'Keep raid bots out with clean button or captcha gates before members see your channels.' },
      { wide: false, icon: 'ph:robot', color: 'yellow', badge: 'Automated', title: 'Auto-Moderation', desc: 'Block scam links, invite spam, caps floods, and bad words with escalating punishments.' },
      { wide: false, icon: 'ph:list-checks-fill', color: 'blue', badge: `${logCount} events`, title: 'Complete Audit Logs', desc: 'Every edit, deletion, role change, voice move, and sanction routed cleanly to your log channels.' },
      { wide: false, icon: 'ph:clock-counter-clockwise-fill', color: 'red', badge: '1-click', title: 'Server Backups', desc: 'Snapshot your channels, categories, roles, and permissions. Restore everything in one click.' },
    ],
    allFeatures: 'Explore all features',
    numbersTitle: 'Petto in numbers',
    numbersSub: 'Live on Discord',
    isoTitle: 'Built in layers',
    isoSub: 'Everything modular',
    isoDesc: 'Turn on only the modules your server needs. Every system works cleanly on its own or together.',
    blogKicker: 'Guides & updates',
    blogSub: 'Release notes, setup guides, and tips to get more out of your Discord server.',
  },
  es: {
    dashCta: 'Abrir dashboard',
    heroChips: ['Moderación', 'Tickets y Forms', 'Niveles', 'Sorteos', 'Embeds V2', 'Backups'],
    showcaseKicker: 'Todo en un solo bot.',
    showcaseTitle: 'Incluido en el plan gratis.',
    showcaseSub: 'Configúralo una sola vez desde la Dash web y deja que Petto gestione tus canales al instante.',
    tabs: [
      { id: 'mod', icon: 'ph:shield-check-fill', label: 'Moderación', chan: '#mod-log', cfgTitle: 'Auto-Moderación', cfgSub: 'Detiene spam, enlaces maliciosos y menciones masivas en milisegundos.', toggles: ['Filtro anti-spam activo', 'Escudo anti-estafas y phishing', 'Aislamiento automático'] },
      { id: 'lvl', icon: 'ph:chart-line-up-fill', label: 'Niveles', chan: '#general', cfgTitle: 'XP y Tarjetas', cfgSub: 'Tarjetas personalizadas, XP por voz y roles automáticos al subir.', toggles: ['XP de texto y voz activo', 'Fuentes y fondos propios', 'Roles automáticos por nivel'] },
      { id: 'wel', icon: 'ph:hand-waving-fill', label: 'Bienvenidas', chan: '#bienvenidas', cfgTitle: 'Tarjetas de Bienvenida', cfgSub: 'Recibe a cada miembro nuevo con su tarjeta visual y roles al entrar.', toggles: ['Tarjeta gráfica de bienvenida', 'Autoroles al unirse', 'Mensaje guía por MD'] },
      { id: 'tkt', icon: 'ph:ticket', label: 'Tickets', chan: '#soporte', cfgTitle: 'Paneles de Tickets', cfgSub: 'Formularios previos, canales privados y transcripciones guardadas.', toggles: ['Formulario antes de abrir', 'Canales privados por tema', 'Transcripciones automáticas'] },
      { id: 'gwy', icon: 'ph:gift-fill', label: 'Sorteos', chan: '#sorteos', cfgTitle: 'Sorteos', cfgSub: 'Requisitos de rol, entradas extra y reroll en un clic.', toggles: ['Entrada con un botón', 'Requisitos de rol o nivel', 'Aviso automático al ganador'] },
    ],
    bentoKicker: 'Seguridad y Control',
    bentoTitle: 'Protegido, día y noche.',
    bentoSub: 'Cinco capas de seguridad trabajando juntas para que tu equipo nunca se lleve sorpresas.',
    bentoCards: [
      { wide: true, icon: 'ph:shield-warning-fill', color: 'blue', badge: 'En vivo', title: 'Anti-Nuke y Protección', desc: 'Detecta borrados masivos de canales, cambios de roles sospechosos y admins comprometidos — aislando la amenaza al instante.' },
      { wide: false, icon: 'ph:lock-key-fill', color: 'green', badge: 'Al instante', title: 'Verificación', desc: 'Frena cuentas falsas y raids con un botón o filtro limpio antes de abrir tus canales.' },
      { wide: false, icon: 'ph:robot', color: 'yellow', badge: 'Automático', title: 'Auto-Moderación', desc: 'Bloquea enlaces de estafa, spam de invitaciones y flood con sanciones progresivas.' },
      { wide: false, icon: 'ph:list-checks-fill', color: 'blue', badge: `${logCount} eventos`, title: 'Registros completos', desc: 'Cada edición, borrado, cambio de rol, movimiento de voz y sanción ordenado en tus canales de logs.' },
      { wide: false, icon: 'ph:clock-counter-clockwise-fill', color: 'red', badge: '1 clic', title: 'Copias de seguridad', desc: 'Guarda tus canales, categorías, roles y permisos. Restaura tu servidor completo en un clic.' },
    ],
    allFeatures: 'Ver todas las funciones',
    numbersTitle: 'Petto en números',
    numbersSub: 'En vivo en Discord',
    isoTitle: 'Hecho por capas',
    isoSub: 'Todo modular',
    isoDesc: 'Activa solo los módulos que tu servidor necesita. Cada sistema funciona por separado o en conjunto.',
    blogKicker: 'Guías y novedades',
    blogSub: 'Notas de versión, guías prácticas y consejos para sacarle más partido a tu servidor.',
  },
  'pt-BR': {
    dashCta: 'Abrir dashboard',
    heroChips: ['Moderação', 'Tickets e Forms', 'Níveis', 'Sorteios', 'Embeds V2', 'Backups'],
    showcaseKicker: 'Tudo em um só bot.',
    showcaseTitle: 'Tudo no plano grátis.',
    showcaseSub: 'Configure uma vez no painel web e deixe o Petto cuidar dos seus canais automaticamente.',
    tabs: [
      { id: 'mod', icon: 'ph:shield-check-fill', label: 'Moderação', chan: '#mod-log', cfgTitle: 'Auto-Moderação', cfgSub: 'Para spam, links maliciosos e menções em massa em milissegundos.', toggles: ['Filtro anti-spam ativo', 'Escudo anti-golpes e phishing', 'Castigo automático'] },
      { id: 'lvl', icon: 'ph:chart-line-up-fill', label: 'Níveis', chan: '#geral', cfgTitle: 'XP e Cards', cfgSub: 'Cards de imagem, XP por voz e cargos automáticos ao subir.', toggles: ['XP de texto e voz ativo', 'Fontes personalizadas', 'Cargos por marco de nível'] },
      { id: 'wel', icon: 'ph:hand-waving-fill', label: 'Boas-vindas', chan: '#boas-vindas', cfgTitle: 'Cards de Boas-vindas', cfgSub: 'Receba cada novo membro com card visual e cargos automáticos.', toggles: ['Card gráfico de boas-vindas', 'Cargos automáticos ao entrar', 'Guia de boas-vindas por DM'] },
      { id: 'tkt', icon: 'ph:ticket', label: 'Tickets', chan: '#suporte', cfgTitle: 'Painéis de Tickets', cfgSub: 'Formulários prévios, canais privados e transcrições salvas.', toggles: ['Formulário antes de abrir', 'Canais privados por assunto', 'Transcrições automáticas'] },
      { id: 'gwy', icon: 'ph:gift-fill', label: 'Sorteios', chan: '#sorteios', cfgTitle: 'Sorteios', cfgSub: 'Requisitos de cargo, entradas extras e novo sorteio em 1 clique.', toggles: ['Entrada com um botão', 'Requisitos de cargo ou nível', 'Aviso automático ao vencedor'] },
    ],
    bentoKicker: 'Segurança e Controle',
    bentoTitle: 'Protegido, dia e noite.',
    bentoSub: 'Cinco camadas de proteção trabalhando juntas para sua equipe nunca ser pega de surpresa.',
    bentoCards: [
      { wide: true, icon: 'ph:shield-warning-fill', color: 'blue', badge: 'Tempo real', title: 'Anti-Nuke e Proteção', desc: 'Detecta exclusões em massa de canais, edições suspeitas de cargos e admins comprometidos antes que o dano se espalhe.' },
      { wide: false, icon: 'ph:lock-key-fill', color: 'green', badge: 'Instantâneo', title: 'Verificação', desc: 'Bloqueie raids e contas falsas com um botão limpo antes de liberar os canais.' },
      { wide: false, icon: 'ph:robot', color: 'yellow', badge: 'Automático', title: 'Auto-Moderação', desc: 'Bloqueie links de golpe, spam de convites e flood com punições progressivas.' },
      { wide: false, icon: 'ph:list-checks-fill', color: 'blue', badge: `${logCount} eventos`, title: 'Logs completos', desc: 'Cada edição, exclusão, cargo, voz e punição organizado nos seus canais de log.' },
      { wide: false, icon: 'ph:clock-counter-clockwise-fill', color: 'red', badge: '1 clique', title: 'Backups do servidor', desc: 'Salve canais, categorias, cargos e permissões. Restaure tudo em um clique.' },
    ],
    allFeatures: 'Ver todos os recursos',
    numbersTitle: 'Petto em números',
    numbersSub: 'Ao vivo no Discord',
    isoTitle: 'Feito em camadas',
    isoSub: 'Tudo modular',
    isoDesc: 'Ative apenas os módulos de que seu servidor precisa. Cada sistema funciona sozinho ou em conjunto.',
    blogKicker: 'Guias e novidades',
    blogSub: 'Notas de versão, guias práticos e dicas para aproveitar mais o seu servidor.',
  },
}[lang];
---

<Base title={HOME_TITLE[lang]} lang={lang} skin="ash" preloadImages={['/assets/home-hero-sky.webp']}>
  <main id="top">
    {/* 1. FULL-BLEED VETOX NIGHT-SKY HERO (NO LAPTOP) */}
    <section class="home-hero-stage">
      <div class="home-sky-bg" aria-hidden="true">
        <img src="/assets/home-hero-sky.webp" alt="" class="home-sky-img" loading="eager" decoding="sync" fetchpriority="high" draggable="false" />
        <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMin slice" class="home-sky-svg">
          <defs>
            <radialGradient id="hmStarHalo" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#ffffff" stop-opacity="0.92" />
              <stop offset="40%" stop-color="#9cc0ff" stop-opacity="0.35" />
              <stop offset="100%" stop-color="#9cc0ff" stop-opacity="0" />
            </radialGradient>
          </defs>
          <g class="home-stars" fill="#e4eeff">
            <circle cx="246" cy="112" r="20" fill="url(#hmStarHalo)" class="home-star-halo" />
            <path d="M246 98 L248 110 L260 112 L248 114 L246 126 L244 114 L232 112 L244 110 Z" fill="#ffffff" class="home-north-star" />
            <path d="M1194 94 L1195.4 102 L1203.4 103.4 L1195.4 104.8 L1194 112.8 L1192.6 104.8 L1184.6 103.4 L1192.6 102 Z" fill="#dbe9ff" opacity="0.85" class="home-north-star" />
            <circle cx="148" cy="184" r="1.4" opacity="0.7" /><circle cx="384" cy="72" r="1.5" opacity="0.8" />
            <circle cx="622" cy="58" r="1.3" opacity="0.75" /><circle cx="884" cy="68" r="1.4" opacity="0.75" />
            <circle cx="1062" cy="128" r="1.3" opacity="0.7" /><circle cx="1312" cy="154" r="1.5" opacity="0.8" />
          </g>
        </svg>
        <div class="home-sky-scrim"></div>
        <div class="home-sky-fade-bottom"></div>
      </div>

      <div class="wrap hero-center">
        <a class="hero-eyebrow" href={`${base}/status`} data-astro-prefetch="hover">
          <span class="dot" data-bot-dot></span>
          <span class="eyebrow">{hc.hero.eyebrow}</span>
          <Icon name="ph:caret-right" width="13" height="13" class="hero-eyebrow-go" />
        </a>
        <h1 class="headline">{hc.hero.before} <em>{hc.hero.em}</em> {hc.hero.after}</h1>
        <p class="lede">{hc.hero.lede}</p>
        <div class="hero-ctas">
          <a class="home-cta-primary" href="https://petto.sbs/invite" target="_blank" rel="noopener">{t.hero.cta1}</a>
          <a class="home-cta-glass" href="/dash">{VETOX_HOME.dashCta} <Icon name="ph:caret-right" width="14" height="14" /></a>
        </div>
        <div class="hero-chips" aria-hidden="true">
          {VETOX_HOME.heroChips.map((chip) => (
            <span class="hero-chip"><i class="hero-chip-dot"></i>{chip}</span>
          ))}
        </div>
      </div>
    </section>

    {/* 2. TRUSTED SERVERS STRIP */}
    <ServerCarousel lang={lang} />

    {/* 3. VETOX-STYLE AUTO-CYCLING SHOWCASE WITH CSS-ANIMATED DISCORD EMULATOR */}
    <section id="features" class="vx-sec">
      <div class="wrap">
        <div class="vx-head reveal">
          <div class="vx-bar-title">
            <span class="vx-accent-bar" aria-hidden="true"></span>
            <h2><strong>{VETOX_HOME.showcaseKicker}</strong> <span>{VETOX_HOME.showcaseTitle}</span></h2>
          </div>
          <p>{VETOX_HOME.showcaseSub}</p>
        </div>

        <div class="vx-stage reveal" id="vxShowcase">
          <div class="vx-stage-grid">
            {/* Left: Dashboard Config Card */}
            <div class="vx-cfg-col">
              {VETOX_HOME.tabs.map((tab, i) => (
                <div class:list={['vx-cfg-card', { active: i === 0 }]} data-vx-cfg={tab.id}>
                  <div class="vx-cfg-top">
                    <span class="vx-cfg-ico"><Icon name={tab.icon} width="18" height="18" /></span>
                    <div>
                      <h3>{tab.cfgTitle}</h3>
                      <p>{tab.cfgSub}</p>
                    </div>
                  </div>
                  <div class="vx-cfg-list">
                    {tab.toggles.map((label, ti) => (
                      <div class="vx-cfg-row" style={`--d:${ti * 65}ms`}>
                        <span>{label}</span>
                        <span class="vx-switch on" aria-hidden="true"><i></i></span>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>

            {/* Right: Live CSS-Animated Discord Emulator */}
            <div class="vx-dc-col">
              <div class="dc-win">
                <div class="dc-topbar">
                  <span class="dc-hash">#</span>
                  <span class="dc-chan" id="vxDcChan">{VETOX_HOME.tabs[0].chan.replace(/^#/, '')}</span>
                  <span class="dc-live-pill"><i></i>LIVE</span>
                </div>

                <div class="dc-body">
                  {/* Slide 1: Moderation */}
                  <div class="dc-scene active" data-vx-dc="mod">
                    <div class="dc-msg">
                      <img class="dc-av" src="/assets/favicon-3d.png" alt="" draggable="false" />
                      <div class="dc-msg-main">
                        <div class="dc-author"><b>Petto</b><span class="dc-app-tag">APP</span><small>Today at 22:14</small></div>
                        <div class="dc-embed dc-embed-red">
                          <div class="dc-embed-title"><Icon name="ph:shield-check-fill" width="14" height="14" /> Auto-Moderation · Case #144</div>
                          <div class="dc-embed-desc">Blocked a phishing link in <span class="dc-mention">#general</span> and applied a <b>10m timeout</b>.</div>
                          <div class="dc-embed-fields">
                            <div><span>Member</span><b>@spammer_92</b></div>
                            <div><span>Rule</span><b>Scam Shield</b></div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  {/* Slide 2: Leveling */}
                  <div class="dc-scene" data-vx-dc="lvl">
                    <div class="dc-msg">
                      <img class="dc-av" src="/assets/favicon-3d.png" alt="" draggable="false" />
                      <div class="dc-msg-main">
                        <div class="dc-author"><b>Petto</b><span class="dc-app-tag">APP</span><small>Today at 22:15</small></div>
                        <div class="dc-rank-card">
                          <div class="dc-rank-head">
                            <img class="dc-rank-av" src="/assets/user-liam.png" alt="" draggable="false" />
                            <div class="dc-rank-info">
                              <strong>liam</strong>
                              <span>Rank <b>#2</b> · Level <b>24</b></span>
                            </div>
                            <span class="dc-rank-badge">+45 XP</span>
                          </div>
                          <div class="dc-rank-bar"><i class="dc-rank-fill"></i></div>
                          <div class="dc-rank-meta"><span>9,420 / 12,400 XP</span><span>76%</span></div>
                        </div>
                      </div>
                    </div>
                  </div>

                  {/* Slide 3: Welcome */}
                  <div class="dc-scene" data-vx-dc="wel">
                    <div class="dc-msg">
                      <img class="dc-av" src="/assets/favicon-3d.png" alt="" draggable="false" />
                      <div class="dc-msg-main">
                        <div class="dc-author"><b>Petto</b><span class="dc-app-tag">APP</span><small>Today at 22:16</small></div>
                        <div class="dc-wel-card">
                          <div class="dc-wel-ring"><img src="/assets/user-liam.png" alt="" draggable="false" /></div>
                          <div class="dc-wel-title">Welcome to <b>Petto Community</b>!</div>
                          <div class="dc-wel-sub">You are member <span>#1,248</span> · Auto-role <span class="dc-role-pill">@Member</span> added</div>
                        </div>
                      </div>
                    </div>
                  </div>

                  {/* Slide 4: Tickets */}
                  <div class="dc-scene" data-vx-dc="tkt">
                    <div class="dc-msg">
                      <img class="dc-av" src="/assets/favicon-3d.png" alt="" draggable="false" />
                      <div class="dc-msg-main">
                        <div class="dc-author"><b>Petto</b><span class="dc-app-tag">APP</span><small>Today at 22:17</small></div>
                        <div class="dc-embed dc-embed-silver">
                          <div class="dc-embed-title"><Icon name="ph:ticket" width="14" height="14" /> Need help? Open a ticket</div>
                          <div class="dc-embed-desc">Choose a category below. Petto will ask 2 quick questions and create a private room with our staff.</div>
                        </div>
                        <div class="dc-btn-row">
                          <span class="dc-btn dc-btn-primary">General Support</span>
                          <span class="dc-btn dc-btn-sec">Report Member</span>
                          <span class="dc-btn dc-btn-green">Partner</span>
                        </div>
                      </div>
                    </div>
                  </div>

                  {/* Slide 5: Giveaways */}
                  <div class="dc-scene" data-vx-dc="gwy">
                    <div class="dc-msg">
                      <img class="dc-av" src="/assets/favicon-3d.png" alt="" draggable="false" />
                      <div class="dc-msg-main">
                        <div class="dc-author"><b>Petto</b><span class="dc-app-tag">APP</span><small>Today at 22:18</small></div>
                        <div class="dc-embed dc-embed-green">
                          <div class="dc-embed-title"><Icon name="ph:gift-fill" width="14" height="14" /> Discord Nitro · 1 Month</div>
                          <div class="dc-embed-desc">Hosted by <span class="dc-mention">@liam</span> · Ends in <b>10 minutes</b> · <b>1 winner</b></div>
                          <div class="dc-gwy-foot">
                            <span class="dc-btn dc-btn-green dc-pulse">Enter Giveaway</span>
                            <span class="dc-entries">142 entries</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {/* 5-Button Auto-Cycling Tab Bar with Animated Progress */}
          <div class="vx-tabs" role="tablist" id="vxTabs">
            {VETOX_HOME.tabs.map((tab, i) => (
              <button type="button" role="tab" class:list={['vx-tab', { active: i === 0 }]} data-vx-tab={tab.id} data-vx-chan={tab.chan.replace(/^#/, '')} aria-selected={i === 0 ? 'true' : 'false'}>
                <Icon name={tab.icon} width="15" height="15" />
                <span>{tab.label}</span>
                <i class="vx-tab-bar" aria-hidden="true"></i>
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* 4. VETOX-STYLE 5-LAYER SECURITY ASYMMETRIC BENTO GRID */}
    <section id="security" class="vx-sec">
      <div class="wrap">
        <div class="vx-head reveal">
          <div class="vx-bar-title">
            <span class="vx-accent-bar" aria-hidden="true"></span>
            <h2><strong>{VETOX_HOME.bentoTitle}</strong> <span>{VETOX_HOME.bentoKicker}</span></h2>
          </div>
          <p>{VETOX_HOME.bentoSub}</p>
        </div>

        <div class="vx-bento reveal">
          {VETOX_HOME.bentoCards.map((card) => (
            <article class:list={['vx-bcard', `vx-bc-${card.color}`, { 'vx-bcard-wide': card.wide }]}>
              <div class="vx-bcard-body">
                <div class="vx-bcard-top">
                  <span class="vx-bcard-ico"><Icon name={card.icon} width="19" height="19" /></span>
