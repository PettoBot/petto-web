              <div class={`stat stat-${s.color}`} data-home-stat={s.key}>
                <Icon name={s.icon} class="stat-ic" />
                <div class="stat-num">
                  <span class="n num" data-home-stat-value={s.key}>{s.n}</span>
                </div>
