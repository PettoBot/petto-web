                    <span class="release-soon">{t.releases.notPublished}</span>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* 8. CREDITS MARQUEE (CONSTRAINED TO PAGE RAIL WIDTH) */}
    <section class="credits-sec">
      <div class="wrap">
