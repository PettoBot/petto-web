                {r.banner ? <img src={r.banner} alt="" draggable="false" /> : <img src="/assets/banner-default.webp" alt="" draggable="false" />}
                <span class="release-cat-pill">{r.category}</span>
              </div>
              <div class="release-body">
                <div class="release-date-line"><Icon name="ph:calendar-check-fill" width="13" height="13" /><span>{r.date}</span></div>
                <h3>{r.title}</h3>
                <p>{r.desc}</p>
                <div class="release-foot">
                  {r.href ? (
                    <a class="release-read-btn" href={r.href}><span>{t.releases.read}</span><Icon name="ph:arrow-right" width="14" height="14" /></a>
