  :global(.wmsg) { display: flex; gap: 11px; }
  :global(.wav) { width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: var(--text-muted); overflow: hidden; object-fit: cover; }
