<script>
  // Vetox-style auto-cycling showcase tabs + Discord channel emulator
  (function () {
    const stage = document.getElementById('vxShowcase');
    const tabList = document.getElementById('vxTabs');
    const chanEl = document.getElementById('vxDcChan');
    if (!stage || !tabList) return;
    const tabs = Array.from(tabList.querySelectorAll<HTMLElement>('[data-vx-tab]'));
    const cfgs = Array.from(stage.querySelectorAll<HTMLElement>('[data-vx-cfg]'));
    const scenes = Array.from(stage.querySelectorAll<HTMLElement>('[data-vx-dc]'));
    let idx = 0;
    let timer: number | null = null;
    let paused = false;

    function activate(nextIdx: number) {
      idx = ((nextIdx % tabs.length) + tabs.length) % tabs.length;
      const target = tabs[idx];
      const id = target.dataset.vxTab || '';
      if (chanEl && target.dataset.vxChan) chanEl.textContent = target.dataset.vxChan;
      tabs.forEach((t, i) => {
        const on = i === idx;
        t.classList.remove('active');
        void t.offsetWidth;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      cfgs.forEach((c) => c.classList.toggle('active', c.dataset.vxCfg === id));
      scenes.forEach((s) => s.classList.toggle('active', s.dataset.vxDc === id));
    }

    function schedule() {
      if (timer) window.clearTimeout(timer);
      if (paused) return;
      timer = window.setTimeout(() => {
        activate(idx + 1);
        schedule();
      }, 6000);
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        activate(i);
        schedule();
      });
    });
    stage.addEventListener('pointerenter', () => { paused = true; stage.classList.add('is-paused'); if (timer) window.clearTimeout(timer); });
    stage.addEventListener('pointerleave', () => { paused = false; stage.classList.remove('is-paused'); schedule(); });
    schedule();
  })();
</script>

