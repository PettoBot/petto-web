  .release-banner { aspect-ratio: 16/9; background: var(--bg-raise); border-bottom: 1px solid var(--border-soft); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .release-banner img { width: 100%; height: 100%; object-fit: cover; }
  .release-banner.empty img.release-placeholder { width: 44px; height: 44px; object-fit: contain; opacity: 0.5; }
  .release-body { padding: 22px 22px 24px; display: flex; flex-direction: column; flex: 1; }
  .release-body h3 { font-size: 18px; margin-bottom: 8px; line-height: 1.32; }
