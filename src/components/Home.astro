  .release-row { display: flex; justify-content: space-between; align-items: center; padding: 5px 0; font-family: var(--mono); font-size: 11px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-dim); }
  .release-row b { font-family: var(--sans); font-size: 13px; text-transform: none; letter-spacing: normal; color: var(--text-muted); font-weight: 500; }
  .release-soon { font-size: 12.5px; color: var(--text-dim); font-style: italic; }

  .try-chips { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 20px; }
