  :global(.wbtn) { margin-top: 14px; width: 100%; padding: 10px; border: none; border-radius: 8px; background: var(--accent); color: var(--accent-ink); font-family: var(--sans); font-size: 13.5px; font-weight: 600; cursor: default; }

  .wticket { background: var(--bg-raise); border: 1px solid var(--border-soft); border-radius: 10px; padding: 18px; }
  .wticket-t { font-family: var(--serif); font-weight: 600; font-size: 16px; margin-bottom: 6px; }
  .wticket-d { font-size: 13px; color: var(--text-muted); margin-bottom: 14px; }
  .wsys { font-size: 12.5px; color: var(--text-dim); text-align: center; padding: 4px 0; }
