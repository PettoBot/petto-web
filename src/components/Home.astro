            <span class="vx-accent-bar" aria-hidden="true"></span>
            <h2><strong>{VETOX_HOME.numbersTitle}</strong> <span>{VETOX_HOME.numbersSub}</span></h2>
          </div>
          <p>{hc.numbers.desc}</p>
