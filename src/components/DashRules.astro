---
// Moderation rules: the place where a server makes its own rules (they cannot be made with a command). A ruleset groups rules that share general
// conditions; a rule says what to look for (triggers), who and where (conditions) and what Petto does (effects). The tabs are the global settings, the
// lists of words and domains, the log of what the rules did, and one for each ruleset. The text of the page is drawn here by the server (so it is
// translated); the script only builds the forms from the data and sends every change to rules-api.ts.
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import { getDashLang, makeT } from '../i18n/dash';
import { LIMITS } from '../utils/modRules';

interface Props {
  user: { username: string; avatar: string | null; userId?: string };
  guildId: string; guildName: string; guildIcon: string;
  data: any;
  roles: { id: string; name: string; managed: boolean }[];
  channels: { id: string; name: string }[];
  categories: { id: string; name: string }[];
  ready: boolean;
  canEdit: boolean;
}
const { user, guildId, guildName, guildIcon, data, roles, channels, categories, ready, canEdit } = Astro.props;
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const docsUrl = `https://wiki.petto.sbs${dashLang === 'es' ? '/es' : dashLang === 'pt-BR' ? '/pt-br' : ''}/moderation/rules`;

type Field = { k: string; t: 'number' | 'select' | 'text' | 'lines' | 'list' | 'role' | 'textarea'; label: string; options?: [string, string][]; min?: number; max?: number; d?: string | number; kind?: string; hint?: string };
const num = (k: string, label: string, min: number, max: number, d: number, hint?: string): Field => ({ k, t: 'number', label, min, max, d, hint });
const pick = (k: string, label: string, options: [string, string][], d: string): Field => ({ k, t: 'select', label, options, d });

// What a rule can look for.
const TRIGGERS: Record<string, { label: string; hint: string; fields: Field[] }> = {
  words: { label: dt('Words'), hint: dt('A word or phrase from a list, or typed here. Accents and capitals do not matter.'), fields: [
    pick('match', dt('How it is found'), [['word', dt('Whole words')], ['contains', dt('Inside other words too')], ['exact', dt('The whole message is exactly it')]], 'word'),
    { k: 'list_id', t: 'list', kind: 'words', label: dt('List of words') },
    { k: 'words', t: 'lines', label: dt('More words, one per line') }] },
  regex: { label: dt('Pattern (regex)'), hint: dt('An expression for advanced users. Short ones only: patterns that could run for ever are refused.'), fields: [{ k: 'pattern', t: 'text', label: dt('Expression') }] },
  links: { label: dt('Links'), hint: dt('Any link, links to some domains, or links that are not to the domains you allow.'), fields: [
    pick('mode', dt('When it applies'), [['any', dt('Any link')], ['deny', dt('A link to a domain in the list')], ['allow', dt('A link to a domain that is NOT in the list')]], 'any'),
    { k: 'list_id', t: 'list', kind: 'domains', label: dt('List of domains') },
    { k: 'domains', t: 'lines', label: dt('More domains, one per line') }] },
  invites: { label: dt('Discord invites'), hint: dt('Invitations to any Discord server.'), fields: [] },
  mentions: { label: dt('Mentions'), hint: dt('More mentions than the limit in one message.'), fields: [
    pick('kind', dt('What counts'), [['any', dt('Everything')], ['users', dt('Members')], ['roles', dt('Roles')], ['everyone', dt('@everyone and @here')]], 'any'), num('max', dt('More than'), 0, 100, 5)] },
  caps: { label: dt('Shouting (capitals)'), hint: dt('A message that is mostly capital letters.'), fields: [num('percent', dt('Percent of capitals'), 30, 100, 70), num('min_length', dt('Only if it has at least this many letters'), 5, 500, 12)] },
  emojis: { label: dt('Many emojis'), hint: dt('More emojis than the limit in one message.'), fields: [num('max', dt('More than'), 1, 200, 10)] },
  repeated: { label: dt('The same message again'), hint: dt('The same text sent again and again by one member.'), fields: [num('times', dt('Times'), 2, 20, 3), num('seconds', dt('In this many seconds'), 3, 600, 30)] },
  rate: { label: dt('Too many messages'), hint: dt('A member who writes faster than the limit.'), fields: [num('messages', dt('Messages'), 2, 50, 6), num('seconds', dt('In this many seconds'), 2, 120, 8)] },
  attachments: { label: dt('Attachments'), hint: dt('Files or images in a message.'), fields: [
    pick('kind', dt('What counts'), [['any', dt('Any file')], ['images', dt('Images')], ['files', dt('Files that are not images')]], 'any'), num('max', dt('More than'), 0, 20, 0)] },
  length: { label: dt('Long messages'), hint: dt('Too many characters or too many lines. Leave 0 to not look at one of them.'), fields: [num('max_chars', dt('More characters than'), 0, 4000, 0), num('max_lines', dt('More lines than'), 0, 200, 0)] },
  zalgo: { label: dt('Zalgo text'), hint: dt('Letters piled with strange marks.'), fields: [num('max', dt('Marks'), 3, 100, 8)] },
  repeated_chars: { label: dt('Repeated characters'), hint: dt('The same character again and again, like aaaaaaaaa.'), fields: [num('max', dt('Repeats'), 3, 100, 10)] },
};
// Who and where.
const CONDITIONS: Record<string, { label: string; fields: Field[] }> = {
  channel: { label: dt('Channel'), fields: [pick('mode', dt('The message is'), [['not_in', dt('NOT in these channels')], ['in', dt('Only in these channels')]], 'not_in'), { k: 'ids', t: 'select', label: dt('Channels'), kind: 'channels' }] },
  category: { label: dt('Category'), fields: [pick('mode', dt('The message is'), [['not_in', dt('NOT in these categories')], ['in', dt('Only in these categories')]], 'not_in'), { k: 'ids', t: 'select', label: dt('Categories'), kind: 'categories' }] },
  role: { label: dt('Roles of the member'), fields: [pick('mode', dt('The member'), [['has_none', dt('has none of these roles')], ['has_any', dt('has one of these roles')]], 'has_none'), { k: 'ids', t: 'select', label: dt('Roles'), kind: 'roles' }] },
  account_age: { label: dt('New account'), fields: [num('max_days', dt('The account is at most this many days old'), 1, 3650, 7)] },
  member_age: { label: dt('New member'), fields: [num('max_days', dt('The member joined at most this many days ago'), 1, 3650, 7)] },
  no_roles: { label: dt('Member with no roles'), fields: [] },
};
// What Petto does.
const EFFECTS: Record<string, { label: string; later: boolean; fields: Field[] }> = {
  delete: { label: dt('Delete the message'), later: false, fields: [] },
  reply: { label: dt('Reply in the channel'), later: false, fields: [{ k: 'text', t: 'textarea', label: dt('Message'), hint: dt('You can use {user}, {username}, {server}, {channel} and {rule}.') }, num('delete_after', dt('Delete the reply after (seconds, 0 to keep it)'), 0, 600, 10)] },
  dm: { label: dt('Send a DM'), later: true, fields: [{ k: 'text', t: 'textarea', label: dt('Message'), hint: dt('You can use {user}, {username}, {server}, {channel} and {rule}.') }] },
  warn: { label: dt('Warn the member'), later: true, fields: [{ k: 'reason', t: 'text', label: dt('Reason (optional)') }] },
  timeout: { label: dt('Timeout (mute)'), later: true, fields: [num('minutes', dt('Minutes'), 1, 40320, 10)] },
  kick: { label: dt('Kick'), later: true, fields: [] },
  ban: { label: dt('Ban'), later: true, fields: [{ k: 'reason', t: 'text', label: dt('Reason (optional)') }, num('delete_days', dt('Delete their messages of the last days'), 0, 7, 0)] },
  add_role: { label: dt('Give a role'), later: true, fields: [{ k: 'role_id', t: 'role', label: dt('Role') }] },
  remove_role: { label: dt('Take a role away'), later: true, fields: [{ k: 'role_id', t: 'role', label: dt('Role') }] },
};

const i18n = {
  tabs: { global: dt('Global settings'), lists: dt('Lists'), logs: dt('Logs'), newSet: dt('New ruleset') },
  blank: dt('Nothing chosen'), save: dt('Save'), cancel: dt('Cancel'), delete: dt('Delete'), edit: dt('Edit'), add: dt('Add'), yes: dt('Yes'), no: dt('No'),
  saved: dt('Saved.'), failed: dt('Something went wrong, try again.'), working: dt('Saving…'),
  confirmDeleteSet: dt('Delete this ruleset and all its rules?'), confirmDeleteRule: dt('Delete this rule?'), confirmDeleteList: dt('Delete this list? Rules that use it stop finding anything with it.'),
  global: {
    title: dt('Global settings'), lead: dt('These apply to every rule of the server.'), enabled: dt('Rules are on'), enabledHint: dt('Turn it off to stop every rule at once without deleting them.'),
    staff: dt('Leave out moderators'), staffHint: dt('Members who can manage messages are never touched by the rules.'), logChannel: dt('Send each hit to a channel'), logNone: dt('No channel (hits are only kept in the Logs tab)'),
  },
  lists: {
    title: dt('Lists'), lead: dt('Lists of words and of domains that any rule can use. Change a list here and every rule that uses it follows.'), none: dt('No lists yet.'),
    name: dt('Name'), kind: dt('Kind'), words: dt('Words'), domains: dt('Domains'), items: dt('One per line'), count: dt('{n} items'), newList: dt('New list'),
    domainsHint: dt('Domains like example.com. A domain also covers its subdomains.'),
  },
  logs: { title: dt('Logs'), lead: dt('What the rules did lately: the rule, the member, the channel and what matched. Petto never keeps the text of the message. The last 100 are shown.'), none: dt('No rule has caught anything yet.'), when: dt('When'), rule: dt('Rule'), member: dt('Member'), channel: dt('Channel'), what: dt('Matched'), did: dt('Petto did'), clear: dt('Clear the logs'), confirmClear: dt('Clear the logs of the rules?'), nothingDone: dt('nothing yet') },
  set: {
    name: dt('Name of the ruleset'), enabled: dt('Ruleset is on'), conditions: dt('General conditions'), conditionsLead: dt('Rules of this ruleset only apply to messages that pass all of these.'), addCondition: dt('Add a condition'),
    rules: dt('Rules'), none: dt('This ruleset has no rules yet.'), newRule: dt('New rule'), delete: dt('Delete ruleset'), hits: dt('{n} hits'), saveSet: dt('Save ruleset'),
  },
  rule: {
    name: dt('Name of the rule'), enabled: dt('Rule is on'), triggers: dt('Triggers: what it looks for'), addTrigger: dt('Add a trigger'), any: dt('Any of them'), all: dt('All of them'), mode: dt('The rule applies when it finds'),
    conditions: dt('Conditions: who and where'), addCondition: dt('Add a condition'), effects: dt('Effects: what Petto does'), addEffect: dt('Add an effect'),
    threshold: dt('Wait until the member does it'), times: dt('time(s) in'), minutes: dt('minutes'), thresholdHint: dt('Delete and reply happen every time. The rest (warn, timeout, kick, ban, DM and roles) wait for this count.'),
    stop: dt('Stop here: do not check the rules after this one'), up: dt('Move up'), down: dt('Move down'), later: dt('waits for the count'), needTrigger: dt('Add at least one trigger.'), needEffect: dt('Add at least one effect.'),
    pickType: dt('Choose…'), newTitle: dt('New rule'),
  },
  triggers: TRIGGERS, conditions: CONDITIONS, effects: EFFECTS,
  limits: { rulesets: LIMITS.rulesets, rules: LIMITS.rulesPerSet, lists: LIMITS.lists },
};
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="mod-rules" pageTitle={dt('Moderation rules')}>
  <DashSettingsKit />
  <DashFormKit />
  <div class="mr" data-mr data-guild={guildId} data-can-edit={canEdit ? '1' : '0'} data-ready={ready ? '1' : '0'}>
    <header class="mr-head">
      <h1>{dt('Moderation rules')}</h1>
      <a class="btn btn-sm" href={docsUrl} target="_blank" rel="noopener"><Icon name="ph:book-open-fill" width="13" height="13" />{dt('Read the docs')}</a>
    </header>
    <p class="mr-lead">{dt('Make your own rules: what to look for, who and where it applies, and what Petto does. Rules are made here in the dashboard; the bot only follows them.')}</p>
    {!ready && <div class="mr-flash mr-flash-warn"><Icon name="ph:plug-fill" width="15" height="15" />{dt('The rules could not be read. Petto may be updating: try again in a few minutes.')}</div>}
    {ready && !canEdit && <div class="mr-flash mr-flash-warn"><Icon name="ph:eye-fill" width="15" height="15" />{dt('You can look at the rules but not change them.')}</div>}
    <div class="mr-flash" data-mr-flash role="status" hidden></div>
    <nav class="mr-tabs" data-mr-tabs aria-label={dt('Moderation rules')}></nav>
    <div class="mr-body" data-mr-body></div>
    <script type="application/json" data-mr-data set:html={JSON.stringify(data)}></script>
    <script type="application/json" data-mr-i18n set:html={JSON.stringify(i18n)}></script>
    <script type="application/json" data-mr-places set:html={JSON.stringify({ roles, channels, categories })}></script>
  </div>
</DashGuildLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-mr]');
  if (root) {
    const read = (selector: string) => JSON.parse(root.querySelector(selector)!.textContent || '{}');
    const data = read('[data-mr-data]');
    const T = read('[data-mr-i18n]');
    const places = read('[data-mr-places]');
    const canEdit = root.dataset.canEdit === '1' && root.dataset.ready === '1';
    const tabsEl = root.querySelector<HTMLElement>('[data-mr-tabs]')!;
    const bodyEl = root.querySelector<HTMLElement>('[data-mr-body]')!;
    const flashEl = root.querySelector<HTMLElement>('[data-mr-flash]')!;
    const api = `/dash/guild/${root.dataset.guild}/rules-api`;
    const KEY = `petto-rules-tab-${root.dataset.guild}`;
    let tab: string = 'global';
    try { tab = sessionStorage.getItem(KEY) || 'global'; } catch { /* the tab is only a convenience */ }
    if (!['global', 'lists', 'logs'].includes(tab) && !data.rulesets.some((s: any) => `set-${s.id}` === tab)) tab = 'global';

    type Attrs = Record<string, any>;
    function h(tag: string, attrs: Attrs = {}, ...children: any[]): HTMLElement {
      const el = document.createElement(tag);
      for (const [key, value] of Object.entries(attrs)) {
        if (value === false || value === null || value === undefined) continue;
        if (key === 'class') el.className = value;
        else if (key.startsWith('on')) el.addEventListener(key.slice(2), value);
        else if (key === 'value') (el as HTMLInputElement).value = value;
        else if (key === 'checked' || key === 'disabled' || key === 'selected' || key === 'multiple') (el as any)[key] = Boolean(value);
        else el.setAttribute(key, value === true ? '' : String(value));
      }
      for (const child of children.flat()) if (child !== null && child !== undefined && child !== false) el.append(child instanceof Node ? child : document.createTextNode(String(child)));
      return el;
    }
    const fill = (text: string, values: Record<string, any>) => text.replace(/\{(\w+)\}/g, (_all, key) => String(values[key] ?? ''));
    const lockedAttrs: Attrs = { disabled: !canEdit };

    function flash(text: string, ok: boolean) {
      flashEl.hidden = false; flashEl.textContent = text; flashEl.className = `mr-flash ${ok ? 'mr-flash-ok' : 'mr-flash-err'}`;
      window.setTimeout(() => { flashEl.hidden = true; }, 5000);
    }
    async function send(payload: Record<string, any>): Promise<any> {
      try {
        const response = await fetch(api, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        const body = await response.json().catch(() => null);
        if (!response.ok || !body?.ok) { flash(body?.message || T.failed, false); return null; }
        return body;
      } catch { flash(T.failed, false); return null; }
    }
    const reload = (nextTab?: string) => { try { sessionStorage.setItem(KEY, nextTab || tab); } catch { /* optional */ } location.reload(); };
    const confirmed = (text: string): Promise<boolean> => (window as any).dglConfirm(text, { confirm: T.delete, tone: 'danger' });

    // ---- A form field from its description ----
    function optionsFor(kind: string): [string, string][] {
      if (kind === 'channels') return places.channels.map((c: any) => [c.id, `#${c.name}`]);
      if (kind === 'categories') return places.categories.map((c: any) => [c.id, c.name]);
      return places.roles.map((r: any) => [r.id, `@${r.name}`]);
    }
    function fieldEl(spec: any, value: any): { el: HTMLElement; get: () => any } {
      const label = (control: HTMLElement) => h('label', { class: 'mr-field' }, h('span', {}, spec.label), control, spec.hint ? h('em', {}, spec.hint) : null);
      if (spec.t === 'number') {
        const input = h('input', { type: 'number', min: spec.min, max: spec.max, value: value ?? spec.d, ...lockedAttrs }) as HTMLInputElement;
        return { el: label(input), get: () => Number(input.value) };
      }
      if (spec.t === 'text') { const input = h('input', { type: 'text', maxlength: 200, value: value ?? '', ...lockedAttrs }) as HTMLInputElement; return { el: label(input), get: () => input.value }; }
      if (spec.t === 'textarea') { const area = h('textarea', { rows: 3, maxlength: 500, ...lockedAttrs }, value ?? '') as HTMLTextAreaElement; return { el: label(area), get: () => area.value }; }
      if (spec.t === 'lines') {
        const area = h('textarea', { rows: 4, ...lockedAttrs }, (Array.isArray(value) ? value : []).join('\n')) as HTMLTextAreaElement;
        return { el: label(area), get: () => area.value.split('\n').map((line) => line.trim()).filter(Boolean) };
      }
      if (spec.t === 'list') {
        const lists = data.lists.filter((l: any) => l.kind === spec.kind);
        const select = h('select', { ...lockedAttrs }, h('option', { value: '' }, T.blank), lists.map((l: any) => h('option', { value: l.id, selected: String(value) === l.id }, l.name))) as HTMLSelectElement;
        return { el: label(select), get: () => (select.value ? Number(select.value) : null) };
      }
      if (spec.t === 'role') {
        const select = h('select', { ...lockedAttrs }, h('option', { value: '' }, T.blank), places.roles.map((r: any) => h('option', { value: r.id, selected: String(value) === r.id }, `@${r.name}`))) as HTMLSelectElement;
        return { el: label(select), get: () => select.value };
      }
      if (spec.kind) {
        const chosen = new Set((Array.isArray(value) ? value : []).map(String));
        const select = h('select', { multiple: true, size: 6, ...lockedAttrs }, optionsFor(spec.kind).map(([id, name]) => h('option', { value: id, selected: chosen.has(id) }, name))) as HTMLSelectElement;
        return { el: label(select), get: () => [...select.selectedOptions].map((o) => o.value) };
      }
      const select = h('select', { ...lockedAttrs }, (spec.options || []).map(([id, name]: [string, string]) => h('option', { value: id, selected: String(value ?? spec.d) === id }, name))) as HTMLSelectElement;
      return { el: label(select), get: () => select.value };
    }

    // ---- A list of typed items (triggers, conditions, effects): a row for each, with its fields ----
    function itemsEditor(kindMap: Record<string, any>, items: any[], addLabel: string, extra?: (type: string) => string | null) {
      const wrap = h('div', { class: 'mr-items' });
      const rows: { type: string; getters: Record<string, () => any>; el: HTMLElement }[] = [];
      function addRow(item: any) {
        const type = item.type;
        const def = kindMap[type];
        if (!def) return;
        const getters: Record<string, () => any> = {};
        const body = h('div', { class: 'mr-item-fields' });
        for (const spec of def.fields) {
          const built = fieldEl(spec, item[spec.k]);
          getters[spec.k] = built.get; body.append(built.el);
        }
        const note = extra?.(type);
        const el = h('div', { class: 'mr-item' },
          h('div', { class: 'mr-item-head' }, h('b', {}, def.label), note ? h('span', { class: 'mr-tag' }, note) : null,
            canEdit ? h('button', { type: 'button', class: 'btn btn-ghost btn-sm mr-x', title: T.delete, onclick: () => { el.remove(); rows.splice(rows.findIndex((r) => r.el === el), 1); } }, '×') : null),
          def.hint ? h('p', { class: 'mr-hint' }, def.hint) : null, body);
        rows.push({ type, getters, el }); wrap.append(el);
      }
      items.forEach(addRow);
      const select = h('select', { class: 'mr-add-select' }, h('option', { value: '' }, `+ ${addLabel}`), Object.entries(kindMap).map(([type, def]: [string, any]) => h('option', { value: type }, def.label))) as HTMLSelectElement;
      select.addEventListener('change', () => {
        if (!select.value) return;
        const defaults: any = { type: select.value };
        for (const spec of kindMap[select.value].fields) if (spec.d !== undefined) defaults[spec.k] = spec.d;
        addRow(defaults); select.value = '';
      });
      const root = h('div', {}, wrap, canEdit ? select : null);
      return { el: root, get: () => rows.map((row) => ({ type: row.type, ...Object.fromEntries(Object.entries(row.getters).map(([k, g]) => [k, g()])) })) };
    }

    const toggle = (checked: boolean, title: string, hint?: string) => {
      const input = h('input', { type: 'checkbox', checked, ...lockedAttrs }) as HTMLInputElement;
      return { el: h('label', { class: 'sx-switch' }, input, h('span', { class: 'sx-switch-text' }, h('b', {}, title), hint ? h('em', {}, hint) : null), h('span', { class: 'sx-toggle', 'aria-hidden': 'true' })), get: () => input.checked };
    };
    const saveButton = (onclick: () => void) => (canEdit ? h('button', { type: 'button', class: 'btn btn-accent', onclick }, T.save) : null);

    // ---- Tabs ----
    function drawTabs() {
      tabsEl.innerHTML = '';
      const add = (id: string, label: string, extra = '') => tabsEl.append(h('button', { type: 'button', class: `mr-tab${tab === id ? ' is-active' : ''}${extra}`, onclick: () => { tab = id; try { sessionStorage.setItem(KEY, id); } catch { /* optional */ } draw(); } }, label));
      add('global', T.tabs.global); add('lists', T.tabs.lists); add('logs', T.tabs.logs);
      for (const set of data.rulesets) add(`set-${set.id}`, set.name, set.enabled ? '' : ' is-off');
      if (canEdit && data.rulesets.length < T.limits.rulesets) tabsEl.append(h('button', { type: 'button', class: 'mr-tab mr-tab-new', onclick: newRuleset }, `+ ${T.tabs.newSet}`));
    }
    async function newRuleset() {
      const body = await send({ op: 'ruleset_save', name: T.tabs.newSet, enabled: true, conditions: [] });
      if (body) reload(`set-${body.id}`);
    }

    // ---- Global settings ----
    function drawGlobal() {
      const s = data.settings;
      const on = toggle(s.enabled, T.global.enabled, T.global.enabledHint);
      const staff = toggle(s.ignore_staff, T.global.staff, T.global.staffHint);
      const channel = h('select', { ...lockedAttrs }, h('option', { value: '' }, T.global.logNone), places.channels.map((c: any) => h('option', { value: c.id, selected: s.log_channel_id === c.id }, `#${c.name}`))) as HTMLSelectElement;
      return h('section', { class: 'mr-card' }, h('h2', {}, T.global.title), h('p', { class: 'mr-hint' }, T.global.lead), on.el, staff.el,
        h('label', { class: 'mr-field' }, h('span', {}, T.global.logChannel), channel),
        saveButton(async () => { if (await send({ op: 'settings', enabled: on.get(), ignore_staff: staff.get(), log_channel_id: channel.value || null })) reload(); }));
    }

    // ---- Lists ----
    function drawLists() {
      const section = h('section', { class: 'mr-card' }, h('h2', {}, T.lists.title), h('p', { class: 'mr-hint' }, T.lists.lead));
      if (!data.lists.length) section.append(h('p', { class: 'mr-empty' }, T.lists.none));
      const editor = (list: any) => {
        const name = h('input', { type: 'text', maxlength: 60, value: list.name, ...lockedAttrs }) as HTMLInputElement;
        const kind = h('select', { ...(list.id ? { disabled: true } : lockedAttrs) }, h('option', { value: 'words', selected: list.kind === 'words' }, T.lists.words), h('option', { value: 'domains', selected: list.kind === 'domains' }, T.lists.domains)) as HTMLSelectElement;
        const items = h('textarea', { rows: 6, ...lockedAttrs }, list.items.join('\n')) as HTMLTextAreaElement;
        return h('div', { class: 'mr-list' },
          h('div', { class: 'mr-row' }, h('label', { class: 'mr-field' }, h('span', {}, T.lists.name), name), h('label', { class: 'mr-field' }, h('span', {}, T.lists.kind), kind)),
          h('label', { class: 'mr-field' }, h('span', {}, T.lists.items), items, h('em', {}, T.lists.domainsHint)),
          canEdit ? h('div', { class: 'mr-actions' },
            h('button', { type: 'button', class: 'btn btn-accent btn-sm', onclick: async () => { if (await send({ op: 'list_save', id: list.id || undefined, name: name.value, kind: kind.value, items: items.value.split('\n') })) reload('lists'); } }, T.save),
            list.id ? h('button', { type: 'button', class: 'btn btn-danger btn-sm', onclick: async () => { if ((await confirmed(T.confirmDeleteList)) && await send({ op: 'list_delete', id: list.id })) reload('lists'); } }, T.delete) : null) : null);
      };
      for (const list of data.lists) section.append(h('details', { class: 'mr-details' }, h('summary', {}, h('b', {}, list.name), h('span', { class: 'mr-tag' }, list.kind === 'domains' ? T.lists.domains : T.lists.words), h('span', { class: 'mr-dim' }, fill(T.lists.count, { n: list.items.length }))), editor(list)));
      if (canEdit && data.lists.length < T.limits.lists) section.append(h('details', { class: 'mr-details' }, h('summary', {}, h('b', {}, `+ ${T.lists.newList}`)), editor({ id: '', name: '', kind: 'words', items: [] })));
      return section;
    }

    // ---- Logs ----
    function drawLogs() {
      const section = h('section', { class: 'mr-card' }, h('h2', {}, T.logs.title), h('p', { class: 'mr-hint' }, T.logs.lead));
      if (!data.logs.length) { section.append(h('p', { class: 'mr-empty' }, T.logs.none)); return section; }
      const channelName = (id: string | null) => (id ? (places.channels.find((c: any) => c.id === id)?.name ? `#${places.channels.find((c: any) => c.id === id).name}` : id) : '—');
      const table = h('table', { class: 'mr-table' }, h('thead', {}, h('tr', {}, [T.logs.when, T.logs.rule, T.logs.member, T.logs.channel, T.logs.what, T.logs.did].map((t: string) => h('th', {}, t)))),
        h('tbody', {}, data.logs.map((l: any) => h('tr', {}, h('td', {}, new Date(l.at).toLocaleString()), h('td', {}, l.rule), h('td', {}, h('code', {}, l.user)), h('td', {}, channelName(l.channel)), h('td', {}, l.trigger), h('td', {}, l.effects.join(', ') || T.logs.nothingDone)))));
      section.append(h('div', { class: 'mr-scroll' }, table));
      if (canEdit) section.append(h('button', { type: 'button', class: 'btn btn-danger btn-sm', onclick: async () => { if ((await confirmed(T.logs.confirmClear)) && await send({ op: 'clear_logs' })) reload('logs'); } }, T.logs.clear));
      return section;
    }

    // ---- A ruleset and its rules ----
    function ruleEditor(set: any, rule: any) {
      const isNew = !rule.id;
      const name = h('input', { type: 'text', maxlength: 60, value: rule.name, ...lockedAttrs }) as HTMLInputElement;
      const on = toggle(rule.enabled, T.rule.enabled);
      const mode = h('select', { ...lockedAttrs }, h('option', { value: 'any', selected: rule.trigger_mode === 'any' }, T.rule.any), h('option', { value: 'all', selected: rule.trigger_mode === 'all' }, T.rule.all)) as HTMLSelectElement;
      const triggers = itemsEditor(T.triggers, rule.triggers, T.rule.addTrigger);
      const conditions = itemsEditor(T.conditions, rule.conditions, T.rule.addCondition);
      const effects = itemsEditor(T.effects, rule.effects, T.rule.addEffect, (type) => (T.effects[type].later ? T.rule.later : null));
      const count = h('input', { type: 'number', min: 1, max: 50, value: rule.threshold_count, ...lockedAttrs }) as HTMLInputElement;
      const minutes = h('input', { type: 'number', min: 1, max: 1440, value: rule.threshold_minutes, ...lockedAttrs }) as HTMLInputElement;
      const stop = toggle(rule.stop, T.rule.stop);
      return h('div', { class: 'mr-rule' },
        h('div', { class: 'mr-row' }, h('label', { class: 'mr-field' }, h('span', {}, T.rule.name), name), on.el),
        h('h3', {}, T.rule.triggers), h('label', { class: 'mr-field mr-inline' }, h('span', {}, T.rule.mode), mode), triggers.el,
        h('h3', {}, T.rule.conditions), conditions.el,
        h('h3', {}, T.rule.effects), effects.el,
        h('div', { class: 'mr-threshold' }, h('span', {}, T.rule.threshold), count, h('span', {}, T.rule.times), minutes, h('span', {}, T.rule.minutes)),
        h('p', { class: 'mr-hint' }, T.rule.thresholdHint), stop.el,
        canEdit ? h('div', { class: 'mr-actions' }, h('button', { type: 'button', class: 'btn btn-accent', onclick: async () => {
          const t = triggers.get(); const e = effects.get();
          if (!t.length) return flash(T.rule.needTrigger, false);
          if (!e.length) return flash(T.rule.needEffect, false);
          const ok = await send({ op: 'rule_save', ruleset_id: set.id, rule: { id: rule.id || undefined, name: name.value, enabled: on.get(), trigger_mode: mode.value, triggers: t, conditions: conditions.get(), effects: e, threshold_count: Number(count.value), threshold_minutes: Number(minutes.value), stop: stop.get() } });
          if (ok) reload(`set-${set.id}`);
        } }, isNew ? T.add : T.save)) : null);
    }
    function drawSet(set: any) {
      const name = h('input', { type: 'text', maxlength: 60, value: set.name, ...lockedAttrs }) as HTMLInputElement;
      const on = toggle(set.enabled, T.set.enabled);
      const conditions = itemsEditor(T.conditions, set.conditions, T.set.addCondition);
      const head = h('section', { class: 'mr-card' },
        h('div', { class: 'mr-row' }, h('label', { class: 'mr-field' }, h('span', {}, T.set.name), name), on.el),
        h('h3', {}, T.set.conditions), h('p', { class: 'mr-hint' }, T.set.conditionsLead), conditions.el,
        canEdit ? h('div', { class: 'mr-actions' },
          h('button', { type: 'button', class: 'btn btn-accent', onclick: async () => { if (await send({ op: 'ruleset_save', id: set.id, name: name.value, enabled: on.get(), conditions: conditions.get() })) reload(`set-${set.id}`); } }, T.set.saveSet),
          h('button', { type: 'button', class: 'btn btn-danger', onclick: async () => { if ((await confirmed(T.confirmDeleteSet)) && await send({ op: 'ruleset_delete', id: set.id })) reload('global'); } }, T.set.delete),
          data.rulesets.length > 1 ? [h('button', { type: 'button', class: 'btn btn-ghost btn-sm', onclick: async () => { if (await send({ op: 'move', kind: 'ruleset', id: set.id, dir: -1 })) reload(`set-${set.id}`); } }, `← ${T.rule.up}`), h('button', { type: 'button', class: 'btn btn-ghost btn-sm', onclick: async () => { if (await send({ op: 'move', kind: 'ruleset', id: set.id, dir: 1 })) reload(`set-${set.id}`); } }, `${T.rule.down} →`)] : null) : null);
      const rulesBox = h('section', { class: 'mr-card' }, h('h2', {}, T.set.rules));
      if (!set.rules.length) rulesBox.append(h('p', { class: 'mr-empty' }, T.set.none));
      for (const rule of set.rules) {
        rulesBox.append(h('details', { class: 'mr-details' },
          h('summary', {}, h('b', {}, rule.name), rule.enabled ? null : h('span', { class: 'mr-tag mr-tag-off' }, T.no), h('span', { class: 'mr-dim' }, fill(T.set.hits, { n: rule.hits })),
            canEdit ? h('span', { class: 'mr-summary-actions' },
              h('button', { type: 'button', class: 'btn btn-ghost btn-sm', title: T.rule.up, onclick: async (ev: Event) => { ev.preventDefault(); if (await send({ op: 'move', kind: 'rule', id: rule.id, dir: -1 })) reload(`set-${set.id}`); } }, '↑'),
              h('button', { type: 'button', class: 'btn btn-ghost btn-sm', title: T.rule.down, onclick: async (ev: Event) => { ev.preventDefault(); if (await send({ op: 'move', kind: 'rule', id: rule.id, dir: 1 })) reload(`set-${set.id}`); } }, '↓'),
              h('button', { type: 'button', class: 'btn btn-danger btn-sm', onclick: async (ev: Event) => { ev.preventDefault(); if ((await confirmed(T.confirmDeleteRule)) && await send({ op: 'rule_delete', id: rule.id })) reload(`set-${set.id}`); } }, T.delete)) : null),
          ruleEditor(set, rule)));
      }
      if (canEdit && set.rules.length < T.limits.rules) {
        const blank = { id: '', name: T.rule.newTitle, enabled: true, trigger_mode: 'any', triggers: [], conditions: [], effects: [{ type: 'delete' }], threshold_count: 1, threshold_minutes: 10, stop: true };
        rulesBox.append(h('details', { class: 'mr-details' }, h('summary', {}, h('b', {}, `+ ${T.set.newRule}`)), ruleEditor(set, blank)));
      }
      return h('div', {}, head, rulesBox);
    }

    function draw() {
      drawTabs();
      bodyEl.innerHTML = '';
      if (tab === 'global') bodyEl.append(drawGlobal());
      else if (tab === 'lists') bodyEl.append(drawLists());
      else if (tab === 'logs') bodyEl.append(drawLogs());
      else { const set = data.rulesets.find((s: any) => `set-${s.id}` === tab); if (set) bodyEl.append(drawSet(set)); }
    }
    draw();
  }
</script>

