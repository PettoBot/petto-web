---
// Buy ceramos (/dash/buy-ceramos): the packs of ceramos that are sold besides the plans, each with its picture, how many ceramos it gives and its price. "Buy" opens the dialog with the
// terms and goes to Polar; the ceramos arrive when the payment is confirmed (the webhook), so nothing here gives them. What can be bought with them is said under the packs.
import DashMeLayout from './DashMeLayout.astro';
import DashPanelHead from './DashPanelHead.astro';
import DashShopShared from './DashShopShared.astro';
import CheckoutConsent from './CheckoutConsent.astro';
import { getDashLang, makeT } from '../i18n/dash';
import type { Session } from '../utils/session';

interface Pack { id: string; coins: number; price: number }
interface Props { user: Session; packs: Pack[] | null; ready: Record<string, boolean>; balance: number | null; paid: boolean; failed: boolean; why?: string }
const { user, packs, ready, balance, paid, failed, why = '' } = Astro.props;
const lang = getDashLang(Astro);
const dt = makeT(lang);
const names: Record<string, string> = { pile: dt('Pile of coins'), 'small-bag': dt('Small bag'), 'big-bag': dt('Big bag'), chest: dt('Treasure chest') };
const number = new Intl.NumberFormat(lang);
---
<DashMeLayout user={user} active="buy" pageTitle="Buy ceramos">
  <DashShopShared />
  <DashPanelHead title={dt('Buy ceramos')} eyebrow={dt('Ceramos')} icon="ph:coins-fill" back={false}>
    {balance !== null && <div class="bd-wallet"><span class="bd-bal"><i class="bd-coin"></i><b>{balance}</b></span></div>}
  </DashPanelHead>
  <p class="bc-lead">{dt('Ceramos are for banners, name fonts, packs and badges. Buy them whenever you want: the ceramos arrive a few seconds after the payment and never expire.')}</p>
  {paid && <p class="bc-msg" role="status">{dt('Thank you! Your payment was received. Your ceramos arrive in a few seconds: refresh the page to see them.')}</p>}
  {failed && <p class="bc-msg is-bad" role="alert">{dt('The payment page could not be opened. Try again in a moment.')}{why && <><br /><small>{dt('Only you see this: {why}', { why })}</small></>}</p>}
  {!packs && <p class="bd-down" role="alert">{dt('Petto did not answer. Try again in a moment.')}</p>}
  {packs && (
    <div class="bc-grid">
      {packs.map((pack) => (
        <article class="bd-card bc-card">
          <img src={`/assets/ceramos/${pack.id}.webp`} alt="" width="512" height="512" loading="lazy" />
          <h2>{names[pack.id] ?? pack.id}</h2>
          <p class="bc-coins"><i class="bd-coin"></i> <b>{number.format(pack.coins)}</b> <span>{dt('ceramos')}</span></p>
          <p class="bc-price">${pack.price.toFixed(2)}</p>
          {ready[pack.id]
            ? <a class="btn bc-buy" href={`/dash/buy-ceramos?buy=${pack.id}`}>{dt('Buy')}</a>
            : <button type="button" class="btn bc-buy" disabled>{dt('Not available yet')}</button>}
        </article>
      ))}
    </div>
  )}
  <p class="bc-note">{dt('You pay in Polar. Payments are not refunded, except a charge that was duplicated, made by mistake or never delivered.')}</p>
  <CheckoutConsent lang={lang} />
</DashMeLayout>

<style is:global>
  .bc-lead { margin: -4px 0 16px; color: var(--text-muted); max-width: 70ch; }
  .bc-msg { margin: 0 0 14px; padding: 12px 16px; border-radius: 12px; background: var(--green-soft); color: var(--green-text); font-size: 14.5px; }
  .bc-msg.is-bad { background: var(--red-soft); color: var(--red-text); }
  .bc-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; align-items: stretch; }
  @media (min-width: 560px) { .bc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .bc-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .bc-card { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; padding: 18px 16px; }
  .bc-card img { width: min(170px, 70%); height: auto; aspect-ratio: 1; object-fit: contain; }
  .bc-card h2 { margin: 4px 0 0; font-size: 17px; }
  .bc-coins { margin: 0; display: inline-flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 2px 8px; font-size: 22px; } .bc-coins b { font-size: 26px; } .bc-coins span { flex-basis: 100%; font-size: 14px; color: var(--text-muted); }
  .bc-price { margin: 0; font-size: 20px; font-weight: 600; }
  .bc-buy { margin-top: auto; width: 100%; justify-content: center; background: var(--green); color: var(--green-ink); border-color: transparent; }
  .bc-buy:disabled { background: color-mix(in srgb, var(--text) 10%, transparent); color: var(--text-muted); cursor: default; }
  .bc-note { margin: 16px 0 0; color: var(--text-muted); font-size: 13px; }
</style>
