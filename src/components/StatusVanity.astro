---
import Base from '../layouts/Base.astro';
import { useTranslations, localePath, type Locale } from '../i18n/ui';
import { getEnv } from '../utils/env';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const s = t.vanityStatusPage;
const base = localePath[lang] ?? '';

type Snapshot = {
  state: string;
  discord?: string;
  database?: string;
  guilds?: number;
  latency_ms?: number;
  uptime_seconds?: number;
  version?: string;
  updated_at?: string;
};

let snapshot: Snapshot = { state: 'unknown' };
const vanityUrl = getEnv(Astro, 'VANITY_BOT_API_URL');
if (vanityUrl) {
  try {
    const res = await fetch(`${vanityUrl.replace(/\/+$/, '')}/api/status`, { headers: { Accept: 'application/json' }, signal: AbortSignal.timeout(4000) });
    const data: any = await res.json().catch(() => null);
    if (data && typeof data.state === 'string') snapshot = data;
  } catch {
    // The page still renders, with the unavailable state.
  }
}

function formatUptime(totalSeconds: number) {
  const d = Math.floor(totalSeconds / 86400);
  const h = Math.floor((totalSeconds % 86400) / 3600);
  const m = Math.floor((totalSeconds % 3600) / 60);
  if (d > 0) return `${d}d ${h}h`;
  if (h > 0) return `${h}h ${m}m`;
  return `${m}m`;
}

const headlines: Record<string, string> = { online: s.operational, degraded: s.degraded, offline: s.offline, unknown: s.unknown };
const known = snapshot.state in headlines ? snapshot.state : 'unknown';
const health = (value?: string) => (value === 'ok' ? s.ok : value === 'down' ? s.down : '-');
---
<Base title={`${s.title} · Petto`} lang={lang}>
  <main>
    <section class="vs-sec">
      <div class="wrap vs-wrap">
        <div class="eyebrow">{s.heading}</div>
        <h1><span class={`vs-dot ${known}`} id="vsDot"></span><span id="vsHeadline">{headlines[known]}</span></h1>
        <p class="vs-desc">{s.desc}</p>
        <p class="vs-desc vs-unknown" id="vsUnknown" hidden={known !== 'unknown'}>{s.unknownDesc}</p>

        <div
          id="vsBlock"
          data-endpoint="/api/status-vanity"
          data-online={s.operational}
          data-degraded={s.degraded}
          data-offline={s.offline}
          data-unknown={s.unknown}
          data-ok={s.ok}
          data-down={s.down}
        >
          <div class="vs-head">
            <span class="vs-label">{s.heading}</span>
            <span class="vs-live" id="vsLive">{s.live}</span>
          </div>
          <div class="vs-grid">
            <div class="vs-card"><span class="n" id="vsDiscord">{health(snapshot.discord)}</span><span class="l">{s.discord}</span></div>
            <div class="vs-card"><span class="n" id="vsDatabase">{health(snapshot.database)}</span><span class="l">{s.database}</span></div>
            <div class="vs-card"><span class="n" id="vsGuilds">{known === 'unknown' ? '-' : snapshot.guilds ?? 0}</span><span class="l">{s.servers}</span></div>
            <div class="vs-card"><span class="n" id="vsLatency">{known === 'unknown' ? '-' : `${snapshot.latency_ms ?? 0} ms`}</span><span class="l">{s.latency}</span></div>
            <div class="vs-card"><span class="n" id="vsUptime">{known === 'unknown' ? '-' : formatUptime(snapshot.uptime_seconds ?? 0)}</span><span class="l">{s.uptime}</span></div>
            <div class="vs-card"><span class="n" id="vsVersion">{snapshot.version || '-'}</span><span class="l">{s.version}</span></div>
          </div>
        </div>

        <p class="vs-foot"><a href={`${base}/status`}>{s.mainStatus}</a></p>
      </div>
    </section>
  </main>
</Base>

<script>
  const block = document.getElementById('vsBlock');
  if (block) {
    const labels: Record<string, string> = {
      online: block.dataset.online || '',
      degraded: block.dataset.degraded || '',
      offline: block.dataset.offline || '',
      unknown: block.dataset.unknown || '',
    };
    const health = (value: string) => (value === 'ok' ? block.dataset.ok : value === 'down' ? block.dataset.down : '-') || '-';
    const setText = (id: string, text: string) => {
      const node = document.getElementById(id);
      if (node) node.textContent = text;
    };
    function uptime(total: number) {
      const d = Math.floor(total / 86400);
      const h = Math.floor((total % 86400) / 3600);
      const m = Math.floor((total % 3600) / 60);
      return d > 0 ? `${d}d ${h}h` : h > 0 ? `${h}h ${m}m` : `${m}m`;
    }
    async function poll() {
      try {
        const res = await fetch(block!.dataset.endpoint || '/api/status-vanity', { headers: { Accept: 'application/json' }, cache: 'no-store' });
        const data = await res.json();
        const state = data.state in labels ? data.state : 'unknown';
        setText('vsHeadline', labels[state]);
        const dot = document.getElementById('vsDot');
        if (dot) dot.className = `vs-dot ${state}`;
        const note = document.getElementById('vsUnknown');
        if (note) note.hidden = state !== 'unknown';
        if (state === 'unknown') return;
        setText('vsDiscord', health(data.discord));
        setText('vsDatabase', health(data.database));
        setText('vsGuilds', String(data.guilds ?? 0));
        setText('vsLatency', `${data.latency_ms ?? 0} ms`);
        setText('vsUptime', uptime(Number(data.uptime_seconds) || 0));
        setText('vsVersion', data.version || '-');
      } catch {
        // Keep the last values, the next poll tries again.
      }
    }
    setInterval(poll, 15000);
  }
</script>

<style>
  .vs-sec { padding: 90px 0 120px; }
  .vs-wrap { max-width: 640px; }
  .vs-sec h1 { font-size: 30px; margin: 14px 0 12px; display: flex; align-items: center; gap: 12px; }
  .vs-dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; background: var(--text-dim); }
  .vs-dot.online { background: var(--green); box-shadow: 0 0 0 5px var(--green-soft); }
  .vs-dot.degraded { background: var(--yellow); box-shadow: 0 0 0 5px var(--yellow-soft); }
  .vs-dot.offline { background: var(--red); box-shadow: 0 0 0 5px var(--red-soft); }
  .vs-desc { color: var(--text-muted); font-size: 15px; line-height: 1.6; max-width: 54ch; margin-bottom: 18px; }
  .vs-unknown { color: var(--text-dim); font-size: 14px; margin-bottom: 26px; }
  .vs-head { display: flex; align-items: center; justify-content: space-between; margin: 26px 0 10px; }
  .vs-label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); }
  .vs-live { font-family: var(--mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--green); }
  .vs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
  .vs-card { border: 1px solid var(--border); border-radius: 14px; padding: 16px 18px; background: var(--card); display: flex; flex-direction: column; gap: 3px; }
  .vs-card .n { font-family: var(--serif); font-size: 20px; font-weight: 600; color: var(--text); overflow-wrap: anywhere; }
  .vs-card .l { font-size: 11.5px; color: var(--text-dim); }
  .vs-foot { margin-top: 26px; font-size: 13.5px; }
  @media (max-width: 480px) { .vs-grid { grid-template-columns: 1fr 1fr; } }
</style>
