---
// The shared tooltip of the dashboard's charts: one script (bound once to the document) and the look of the guide, the dots and the box.
import chartTipCode from '../scripts/chart-tip.js?raw';
---
<script is:inline set:html={chartTipCode}></script>

<style is:global>
  [data-ct] { position: relative; touch-action: pan-y; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; -webkit-tap-highlight-color: transparent; cursor: crosshair; }
  [data-ct]:focus { outline: none; }
  [data-ct]:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 6px; }
  .ct-guide, .ct-dot, .ct-tip { position: absolute; left: 0; top: 0; pointer-events: none; opacity: 0; will-change: transform; transition: transform 110ms cubic-bezier(.22, .8, .3, 1), opacity 90ms ease-out; }
  .ct-guide { bottom: 0; width: 0; border-left: 1px dashed var(--border); }
  .ct-dot { width: 12px; height: 12px; margin: -6px 0 0 -6px; box-sizing: border-box; border-radius: 50%; border: 2px solid var(--card); background: var(--ct-c, var(--accent)); }
  .ct-tip { z-index: 2; width: max-content; max-width: 100%; min-width: min(140px, 100%); box-sizing: border-box; background: var(--bg-raise); border: 1px solid var(--border); border-radius: 9px; padding: 9px 11px; box-shadow: 0 8px 24px rgba(0, 0, 0, .3); }
  .ct-on .ct-guide, .ct-on .ct-dot, .ct-on .ct-tip { opacity: 1; }
  /* The first placement jumps to its spot (only the fade runs); every move after it glides. */
  .ct-snap .ct-guide, .ct-snap .ct-dot, .ct-snap .ct-tip { transition: opacity 90ms ease-out; }
  .ct-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .ct-guide, .ct-dot, .ct-tip, .ct-snap .ct-guide, .ct-snap .ct-dot, .ct-snap .ct-tip { transition: none; } }
</style>
