---
// The shared tooltip of the dashboard's charts: one script (bound once to the document) and the look of the guide, the dots and the box.
import chartTipCode from '../scripts/chart-tip.js?raw';
---
<script is:inline set:html={chartTipCode}></script>

<style is:global>
  [data-ct] { position: relative; touch-action: pan-y; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; -webkit-tap-highlight-color: transparent; cursor: crosshair; }
  [data-ct]:focus { outline: none; }
  [data-ct]:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 6px; }
  /* The motion of the tooltip. The numbers are the ones of TIMING in scripts/chart-tip.js (scripts/check-chart-tip.mjs compares them):
     the guide, the dots and the box glide to the next point with an ease-out curve, and the box fades in softly. The fade out has its own
     delay in the script (hideDelayMs), so a brief jitter at the edge of the chart never flickers it. */
  [data-ct] { --ct-glide: 220ms; --ct-in: 140ms; --ct-out: 160ms; --ct-ease: cubic-bezier(.16, 1, .3, 1); }
  .ct-guide, .ct-dot, .ct-tip { position: absolute; left: 0; top: 0; pointer-events: none; opacity: 0; will-change: transform, opacity; transition: transform var(--ct-glide) var(--ct-ease), opacity var(--ct-out) ease-out; }
  .ct-guide { bottom: 0; width: 0; border-left: 1px dashed var(--border); }
  .ct-dot { width: 12px; height: 12px; margin: -6px 0 0 -6px; box-sizing: border-box; border-radius: 50%; border: 2px solid var(--card); background: var(--ct-c, var(--accent)); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ct-c, var(--accent)) 22%, transparent); }
  .ct-tip { z-index: 2; width: max-content; max-width: 100%; min-width: min(140px, 100%); box-sizing: border-box; background: color-mix(in srgb, var(--bg-raise) 92%, transparent); backdrop-filter: blur(10px); border: 1px solid var(--border); border-radius: 11px; padding: 9px 12px; box-shadow: 0 12px 28px -8px rgba(0, 0, 0, .42); }
  .ct-on .ct-guide, .ct-on .ct-dot, .ct-on .ct-tip { opacity: 1; transition: transform var(--ct-glide) var(--ct-ease), opacity var(--ct-in) ease-out; }
  /* The first placement jumps to its spot (only the fade runs); every move after it glides. */
  .ct-snap .ct-guide, .ct-snap .ct-dot, .ct-snap .ct-tip { transition: opacity var(--ct-in) ease-out; }
  /* The body of a tooltip with a date, an optional tag, the value and an optional change (the statistics charts). */
  .ct-rich { display: flex; flex-direction: column; gap: 2px; padding: 8px 11px; font-size: 12.5px; min-width: 0; max-width: 220px; }
  .ct-rich b { font-weight: 600; color: var(--text); }
  .ct-rich small { font-size: 11.5px; color: var(--accent); font-weight: 600; }
  .ct-rich small:empty { display: none; }
  .ct-rich span { color: var(--text); font-variant-numeric: tabular-nums; font-weight: 600; font-size: 14px; }
  .ct-rich em { font-style: normal; color: var(--text-dim); font-size: 11.5px; }
  .ct-rich em:empty { display: none; }
  .ct-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .ct-guide, .ct-dot, .ct-tip, .ct-on .ct-guide, .ct-on .ct-dot, .ct-on .ct-tip, .ct-snap .ct-guide, .ct-snap .ct-dot, .ct-snap .ct-tip { transition: none; } }
</style>
