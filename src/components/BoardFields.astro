---
// The fields of one reaction board (Boards page, DashBoards.astro): channel, emojis (the main one and up to four more), how many, the look of the
// repost, and what it ignores. They sit in a pop-up window, once to add a board and once for each board that exists.
import ColorPicker from './ColorPicker.astro';
import MultiSelect from './MultiSelect.astro';
import SxNumber from './SxNumber.astro';
import { getDashLang, makeT } from '../i18n/dash';
import { MAX_EXTRA_EMOJIS, type BoardKind, type BoardRow } from '../data/boardKinds';

const dt = makeT(getDashLang(Astro));
interface Props { kind: BoardKind; board: BoardRow; channels: { id: string; name: string }[]; roles: { id: string; name: string }[]; templates: string[]; uid: string }
const { kind, board, channels, roles, templates, uid } = Astro.props;
const extras = [...board.extraEmojis, ...Array(MAX_EXTRA_EMOJIS).fill('')].slice(0, MAX_EXTRA_EMOJIS);
---
<div class="bf-grid">
  <div class="sx-field"><label>{dt('Channel')}</label>
    <select name="channel_id" required>
      <option value="">{dt('Choose a channel')}</option>
      {channels.map((c) => <option value={c.id} selected={c.id === board.channelId}>#{c.name}</option>)}
    </select>
  </div>
  <div class="sx-field"><label>{dt('Reactions needed')}</label><SxNumber name="threshold" min="1" max="100" value={board.threshold} required /></div>
</div>

<div class="sx-field">
  <span class="sx-label">{dt('Emojis')}</span>
  <div class="bf-emojis">
    <input type="text" name="emoji" data-emoji-input maxlength="100" value={board.emoji} placeholder={dt('Emoji')} required aria-label={dt('Main emoji')} />
    {extras.map((e) => <input type="text" name="extra_emoji" data-emoji-input maxlength="100" value={e} placeholder={dt('Another')} aria-label={dt('Another emoji')} />)}
  </div>
  <span class="sx-hint">{dt('The first is the main one, the others are optional. Any of them counts, and whoever reacts with several counts once.')}</span>
</div>

<ColorPicker name="color" value={`#${board.color.toString(16).padStart(6, '0')}`} label={dt('Color of the repost')} />

<div class="sx-switches">
  <label class="sx-switch"><input type="checkbox" name="selfstar" checked={board.selfstar} /><span class="sx-switch-text"><b>{dt('Count the message author\'s own reaction')}</b></span><i class="sx-toggle"></i></label>
  <label class="sx-switch"><input type="checkbox" name="timestamp" checked={board.timestamp} /><span class="sx-switch-text"><b>{dt('Show the original timestamp')}</b></span><i class="sx-toggle"></i></label>
  <label class="sx-switch"><input type="checkbox" name="jumpurl" checked={board.jumpurl} /><span class="sx-switch-text"><b>{dt('Add an Original Message button')}</b></span><i class="sx-toggle"></i></label>
  <label class="sx-switch"><input type="checkbox" name="attachments" checked={board.attachments} /><span class="sx-switch-text"><b>{dt('Include attachments and images')}</b></span><i class="sx-toggle"></i></label>
</div>

<div class="sx-field"><label>{dt('Repost design')}</label>
  <select name="embed_template">
    <option value="" selected={!board.template}>{dt('Use Petto default')}</option>
    {templates.map((name) => <option value={name} selected={name === board.template}>{name}</option>)}
  </select>
  <span class="sx-hint">{dt('A saved design from the Embeds page. It can use the variables of this board, like {star.count} or {star.link}.').replaceAll('star', kind.variable)}</span>
</div>

<div class="sx-field"><span class="sx-label">{dt('Ignored channels')}</span><MultiSelect lazy name="ignored_channel_ids" options={channels} selected={board.ignoredChannelIds} placeholder={dt('Search channels...')} /></div>
<div class="sx-field"><span class="sx-label">{dt('Ignored roles')}</span><MultiSelect lazy name="ignored_role_ids" options={roles} selected={board.ignoredRoleIds} placeholder={dt('Search roles...')} /></div>
<div class="sx-field"><label>{dt('Ignored members')}</label><textarea name="ignored_user_ids" class="dgl-autogrow sx-one" rows="1" maxlength="2700" placeholder={dt('Ignored member IDs, comma-separated')}>{board.ignoredUserIds.join(', ')}</textarea></div>

<style>
  .bf-grid { display: grid; grid-template-columns: minmax(0, 1fr) 150px; gap: 12px; align-items: start; }
  .bf-emojis { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
  .bf-emojis :global(.ep-wrap) { min-width: 0; }
  .bf-emojis input[type="text"] { border: 1px solid var(--border); border-radius: 9px; padding: 9px 10px; background: var(--card); color: var(--text); font: inherit; font-size: 13.5px; min-width: 0; width: 100%; box-sizing: border-box; }
  .bf-emojis input[type="text"]:focus-visible { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .sx-one { min-height: 40px; }
  @media (max-width: 560px) { .bf-grid { grid-template-columns: 1fr; } .bf-emojis { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
