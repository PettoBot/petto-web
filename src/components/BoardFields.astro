---
// The fields of one reaction board (Boards page, DashBoards.astro): channel, emojis (the main one and up to four more), how many, the look of the
// repost, and what it ignores. They sit in a pop-up window, once to add a board and once for each board that exists.
import ColorPicker from './ColorPicker.astro';
import MultiSelect from './MultiSelect.astro';
import { getDashLang, makeT } from '../i18n/dash';
import { MAX_EXTRA_EMOJIS, type BoardKind, type BoardRow } from '../data/boardKinds';

const dt = makeT(getDashLang(Astro));
interface Props { kind: BoardKind; board: BoardRow; channels: { id: string; name: string }[]; roles: { id: string; name: string }[]; templates: string[]; uid: string }
const { kind, board, channels, roles, templates, uid } = Astro.props;
const extras = [...board.extraEmojis, ...Array(MAX_EXTRA_EMOJIS).fill('')].slice(0, MAX_EXTRA_EMOJIS);
---
<div class="bf-grid">
  <label class="bf-field"><span>{dt('Channel')}</span>
    <select name="channel_id" required>
      <option value="">{dt('Choose a channel')}</option>
      {channels.map((c) => <option value={c.id} selected={c.id === board.channelId}>#{c.name}</option>)}
    </select>
  </label>
  <label class="bf-field bf-narrow"><span>{dt('Reactions needed')}</span><input type="number" name="threshold" min="1" max="100" value={board.threshold} required /></label>
</div>

<div class="bf-field">
  <span>{dt('Emojis')}</span>
  <div class="bf-emojis">
    <input type="text" name="emoji" data-emoji-input maxlength="100" value={board.emoji} placeholder={dt('Emoji')} required aria-label={dt('Main emoji')} />
    {extras.map((e) => <input type="text" name="extra_emoji" data-emoji-input maxlength="100" value={e} placeholder={dt('Another')} aria-label={dt('Another emoji')} />)}
  </div>
  <small>{dt('The first is the main one, the others are optional. Any of them counts, and whoever reacts with several counts once.')}</small>
</div>

<ColorPicker name="color" value={`#${board.color.toString(16).padStart(6, '0')}`} label={dt('Color of the repost')} />

<div class="bf-switches">
  <label class="bf-check"><input type="checkbox" name="selfstar" checked={board.selfstar} />{dt('Count the message author\'s own reaction')}</label>
  <label class="bf-check"><input type="checkbox" name="timestamp" checked={board.timestamp} />{dt('Show the original timestamp')}</label>
  <label class="bf-check"><input type="checkbox" name="jumpurl" checked={board.jumpurl} />{dt('Add an Original Message button')}</label>
  <label class="bf-check"><input type="checkbox" name="attachments" checked={board.attachments} />{dt('Include attachments and images')}</label>
</div>

<label class="bf-field"><span>{dt('Repost design')}</span>
  <select name="embed_template">
    <option value="" selected={!board.template}>{dt('Use Petto default')}</option>
    {templates.map((name) => <option value={name} selected={name === board.template}>{name}</option>)}
  </select>
  <small>{dt('A saved design from the Embeds page. It can use the variables of this board, like {star.count} or {star.link}.').replaceAll('star', kind.variable)}</small>
</label>

<div class="bf-field"><span>{dt('Ignored channels')}</span><MultiSelect lazy name="ignored_channel_ids" options={channels} selected={board.ignoredChannelIds} placeholder={dt('Search channels...')} /></div>
<div class="bf-field"><span>{dt('Ignored roles')}</span><MultiSelect lazy name="ignored_role_ids" options={roles} selected={board.ignoredRoleIds} placeholder={dt('Search roles...')} /></div>
<label class="bf-field"><span>{dt('Ignored members')}</span><input type="text" name="ignored_user_ids" value={board.ignoredUserIds.join(', ')} placeholder={dt('Ignored member IDs, comma-separated')} maxlength="2700" /></label>

<style>
  .bf-grid { display: grid; grid-template-columns: minmax(0, 1fr) 130px; gap: 12px; }
  .bf-field { display: grid; gap: 6px; min-width: 0; align-content: start; }
  .bf-field > span { font-size: 13px; font-weight: 600; }
  .bf-field small { font-size: 12px; color: var(--text-dim); font-weight: 400; }
  .bf-field select, .bf-field input[type="number"], .bf-field input[type="text"] { border: 1px solid var(--border); border-radius: 8px; padding: 9px 10px; background: var(--card); color: var(--text); font: inherit; font-size: 13.5px; min-width: 0; width: 100%; box-sizing: border-box; }
  .bf-emojis { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
  .bf-emojis :global(.ep-wrap) { min-width: 0; }
  .bf-switches { display: grid; gap: 8px; }
  .bf-check { display: flex; align-items: center; gap: 8px; font-size: 13.5px; cursor: pointer; }
  @media (max-width: 560px) { .bf-grid { grid-template-columns: 1fr; } .bf-emojis { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
