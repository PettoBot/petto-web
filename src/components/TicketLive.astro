    window.__tklStop = stop;
    // Who is looking, for "Mine" (the tickets they claimed).
    me = root.getAttribute('data-me');
    loadList().then(function () {
      var m = /#ticket-(\d+)/.exec(location.hash || '');
      if (m) openTicket(Number(m[1]));
    });
  })();
</script>

