---
// The top of the dashboard menu (desktop sidebar and phone drawer): a banner (the server's or the account's Discord banner, the account color,
// or the Petto art when there is none), the icon in front of it, the name and the button that opens the server sheet (DashServerSheet.astro).
import { Icon } from 'astro-icon/components';
import InlineIcon from './InlineIcon.astro';
import { makeT, getDashLang } from '../i18n/dash';
import type { HeaderArt } from '../utils/dashProfile.mjs';

interface Props {
  /** A server (square icon) or the account (round avatar with its decoration). */
  kind: 'guild' | 'user';
  name: string;
  icon: string | null;
  art: HeaderArt;
  premium?: boolean;
  /** The still and animated pictures of the avatar decoration (account header only). */
  decoration?: { animated: string | null; still: string | null } | null;
}
const { kind, name, icon, art, premium = false, decoration = null } = Astro.props;
const dt = makeT(getDashLang(Astro));
const tint = art.kind === 'color' ? `--sh-tint:${art.color}` : undefined;
---
<div class:list={['sh', `sh-${kind}`]} data-sh>
  <div class:list={['sh-art', `sh-art-${art.kind}`]} style={tint} aria-hidden="true">
    {art.kind === 'image' && (
      <picture>
        {art.animated && <source media="(prefers-reduced-motion: reduce)" srcset={art.still} />}
        <img class="sh-art-img" src={art.animated ?? art.still} alt="" width="300" height="88" decoding="async" referrerpolicy="no-referrer" />
      </picture>
    )}
    {art.kind === 'art' && (
      <Fragment>
        <span class="sh-dots"></span>
        <svg class="sh-sparks" viewBox="0 0 300 88" preserveAspectRatio="xMidYMid slice" focusable="false">
          <path class="s1" d="M52 16c1.6 7.4 3.6 9.4 11 11-7.4 1.6-9.4 3.6-11 11-1.6-7.4-3.6-9.4-11-11 7.4-1.6 9.4-3.6 11-11Z" />
          <path class="s2" d="M118 52c1 4.6 2.2 5.8 6.8 6.8-4.6 1-5.8 2.2-6.8 6.8-1-4.6-2.2-5.8-6.8-6.8 4.6-1 5.8-2.2 6.8-6.8Z" />
          <path class="s3" d="M246 14c1.2 5.4 2.6 6.8 8 8-5.4 1.2-6.8 2.6-8 8-1.2-5.4-2.6-6.8-8-8 5.4-1.2 6.8-2.6 8-8Z" />
          <path class="s2" d="M20 60c.8 3.6 1.8 4.6 5.4 5.4-3.6.8-4.6 1.8-5.4 5.4-.8-3.6-1.8-4.6-5.4-5.4 3.6-.8 4.6-1.8 5.4-5.4Z" />
        </svg>
        <img class="sh-mascot" src="/assets/mascot-icon.webp" alt="" width="64" height="64" decoding="async" />
      </Fragment>
    )}
  </div>
  <div class="sh-icon">
    {icon ? <img class="sh-icon-img" src={icon} alt="" width="56" height="56" referrerpolicy="no-referrer" /> : <span class="sh-icon-img sh-icon-fallback"><Icon name={kind === 'guild' ? 'ph:buildings-fill' : 'ph:user-fill'} width="22" height="22" /></span>}
    {decoration?.animated && (
      <picture class="sh-deco">
        {decoration.still && <source media="(prefers-reduced-motion: reduce)" srcset={decoration.still} />}
        <img src={decoration.animated} alt="" width="68" height="68" decoding="async" />
      </picture>
    )}
  </div>
  <div class="sh-name"><strong title={name}>{name}</strong>{premium && <span class="sh-premium"><InlineIcon name="ph:crown-fill" width="11" height="11" />Premium</span>}</div>
  <button type="button" class="sh-select" data-sheet-open aria-haspopup="dialog" aria-expanded="false" aria-controls="ds-sheet">
    <Icon name="ph:hard-drives-fill" width="14" height="14" />
    <span>{kind === 'guild' ? dt('Switch server') : dt('Select a server')}</span>
    <Icon name="ph:caret-up-down" width="13" height="13" />
  </button>
</div>

<script>
  // A banner or decoration that does not load is dropped: the Petto art (or the color) under it stays, so there is never an empty frame.
  document.querySelectorAll<HTMLImageElement>('[data-sh] .sh-art-img, [data-sh] .sh-deco img').forEach((img) => {
    img.addEventListener('error', () => (img.closest('picture') ?? img).remove(), { once: true });
  });
</script>

<style>
  .sh { position: relative; flex: none; display: flex; flex-direction: column; align-items: center; text-align: center; }
  /* The art follows the theme: the dark one is the default (like the site), the light one under data-theme="light" or a light system. */
  .sh-art {
    --sh-a: #6e4339; --sh-b: #403670; --sh-c: #2f5d78; --sh-dot: rgba(255, 196, 170, .38); --sh-star: #ffe9df;
    position: relative; align-self: stretch; height: 88px; overflow: hidden; isolation: isolate;
    background:
      radial-gradient(120px 70px at 12% 10%, var(--sh-c), transparent 70%),
      radial-gradient(150px 90px at 92% 85%, var(--sh-b), transparent 70%),
      linear-gradient(115deg, var(--sh-a), var(--sh-b));
  }
  :global(:root[data-theme="light"]) .sh-art { --sh-a: #ffd8c8; --sh-b: #e3d6fb; --sh-c: #cfe7f5; --sh-dot: rgba(189, 81, 54, .26); --sh-star: #fff; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .sh-art { --sh-a: #ffd8c8; --sh-b: #e3d6fb; --sh-c: #cfe7f5; --sh-dot: rgba(189, 81, 54, .26); --sh-star: #fff; }
  }
  /* The account color: a gradient from the color to a darker one. */
  .sh-art-color { background: linear-gradient(115deg, var(--sh-tint), color-mix(in srgb, var(--sh-tint) 55%, #000)); }
  .sh-art-image { background: var(--bg-raise); }
  .sh-art::after { content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none; background: linear-gradient(to bottom, transparent 52%, color-mix(in srgb, var(--card) 70%, transparent) 82%, var(--card) 100%); }
  .sh-art-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
  .sh-art picture { display: contents; }

  .sh-dots { position: absolute; inset: 0; z-index: 0; background: radial-gradient(var(--sh-dot) 1.15px, transparent 1.6px) 0 0 / 13px 13px; -webkit-mask-image: linear-gradient(105deg, #000 0%, transparent 70%); mask-image: linear-gradient(105deg, #000 0%, transparent 70%); }
  .sh-sparks { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; }
  .sh-sparks path { fill: var(--sh-star); }
  .sh-sparks .s1 { opacity: .95; } .sh-sparks .s2 { opacity: .65; } .sh-sparks .s3 { opacity: .8; }
  .sh-mascot { position: absolute; z-index: 1; right: 14px; top: 8px; width: 54px; height: 54px; object-fit: contain; transform: rotate(8deg); filter: drop-shadow(0 4px 8px rgba(0, 0, 0, .22)); }
  .sh-mascot { background: radial-gradient(closest-side, rgba(255, 255, 255, .72), transparent); border-radius: 50%; }

  /* The icon sits half over the banner. */
  .sh-icon { position: relative; z-index: 3; flex: none; width: 56px; height: 56px; margin-top: -30px; }
  .sh-icon-img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 17px; background: var(--bg-raise); box-shadow: 0 0 0 3.5px var(--card), 0 6px 16px -6px rgba(0, 0, 0, .5); }
  .sh-user .sh-icon-img { border-radius: 50%; }
  .sh-icon-fallback { display: grid; place-items: center; color: var(--text-dim); }
  .sh-deco { position: absolute; left: -10%; top: -10%; width: 120%; height: 120%; pointer-events: none; }
  .sh-deco img { width: 100%; height: 100%; max-width: none; }

  .sh-name { display: flex; align-items: center; justify-content: center; gap: 7px; max-width: 100%; min-width: 0; margin-top: 7px; padding: 0 14px; }
  .sh-name strong { min-width: 0; font-size: 15px; font-weight: 700; letter-spacing: -.01em; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sh-premium { display: inline-flex; align-items: center; gap: 4px; flex-shrink: 0; color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border: 1px solid color-mix(in srgb, var(--yellow) 42%, var(--border)); border-radius: 999px; font-family: var(--mono); font-size: 9px; font-weight: 700; line-height: 1; padding: 4px 6px; }

  .sh-select {
    display: flex; align-items: center; gap: 9px; align-self: stretch; margin: 9px 10px 0; padding: 8px 11px; border-radius: 12px;
    background: color-mix(in srgb, var(--text) 3%, transparent); border: 1px solid var(--border-soft); color: var(--text-muted);
    font: inherit; font-size: 13px; font-weight: 600; text-align: left; cursor: pointer; touch-action: manipulation;
    transition: background-color var(--m-fast) ease, border-color var(--m-fast) ease, color var(--m-fast) ease, transform var(--m-instant) ease;
  }
  .sh-select span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sh-select :global(svg) { flex: none; color: var(--text-dim); }
  .sh-select:hover, .sh-select[aria-expanded="true"] { background: var(--card-hover); border-color: var(--border); color: var(--text); }
  .sh-select:active { transform: scale(.985); }
  .sh-select:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  @media (max-width: 880px) {
    .sh-art { height: 96px; }
    .sh-icon { width: 62px; height: 62px; margin-top: -34px; }
    .sh-name strong { font-size: 16.5px; }
    .sh-select { margin: 11px 12px 0; padding: 10px 13px; border-radius: 14px; font-size: 14px; }
    .sh-mascot { width: 60px; height: 60px; }
  }
</style>
