---
// The top of the dashboard menu (desktop sidebar and phone drawer): a banner (the server's or the account's Discord banner, the account color,
// or the Petto art when there is none), the icon in front of it, the name and the button that opens the server sheet (DashServerSheet.astro).
import { Icon } from 'astro-icon/components';
import InlineIcon from './InlineIcon.astro';
import { guildLetter, guildLetterStyle } from '../utils/guildLetter.mjs';
import { makeT, getDashLang } from '../i18n/dash';
import type { HeaderArt } from '../utils/dashProfile.mjs';

interface Props {
  /** A server (square icon) or the account (round avatar with its decoration). */
  kind: 'guild' | 'user';
  name: string;
  icon: string | null;
  art: HeaderArt;
  premium?: boolean;
  /** The still and animated pictures of the avatar decoration (account header only). */
  decoration?: { animated: string | null; still: string | null } | null;
  /** The account menu uses the roomy header (taller banner, bigger avatar); a server keeps the compact one. */
  size?: 'compact' | 'roomy';
  /** The @username under the name (account header only). */
  handle?: string | null;
}
const { kind, name, icon, art, premium = false, decoration = null, size = 'compact', handle = null } = Astro.props;
const dt = makeT(getDashLang(Astro));
const tint = art.kind === 'color' ? `--sh-tint:${art.color}` : undefined;
---
<div class:list={['sh', `sh-${kind}`, { 'sh-roomy': size === 'roomy' }]} data-sh>
  <div class:list={['sh-art', `sh-art-${art.kind}`]} style={tint} aria-hidden="true">
    {art.kind === 'image' && (
      <picture>
        {art.animated && <source media="(prefers-reduced-motion: reduce)" srcset={art.still} />}
        <img class="sh-art-img" src={art.animated ?? art.still} alt="" width="300" height="88" loading="eager" decoding="sync" referrerpolicy="no-referrer" />
      </picture>
    )}
    {art.kind === 'art' && (
      <img class="sh-art-img sh-art-petto" src="/assets/banner-default.webp" alt="" width="300" height="88" loading="eager" decoding="sync" draggable="false" />
    )}
  </div>
  <div class="sh-icon">
    {icon ? <img class="sh-icon-img" src={icon} alt="" width={size === 'roomy' ? 80 : 56} height={size === 'roomy' ? 80 : 56} loading="eager" decoding="sync" referrerpolicy="no-referrer" /> : kind === 'guild' ? <span class="sh-icon-img sh-icon-fallback sh-letter" style={guildLetterStyle(name)}>{guildLetter(name)}</span> : <span class="sh-icon-img sh-icon-fallback"><Icon name="ph:user-fill" width="22" height="22" /></span>}
    {decoration?.animated && (
      <picture class="sh-deco">
        {decoration.still && <source media="(prefers-reduced-motion: reduce)" srcset={decoration.still} />}
        <img src={decoration.animated} alt="" width="68" height="68" loading="eager" decoding="sync" />
      </picture>
    )}
  </div>
  <div class="sh-name"><strong title={name}>{name}</strong>{premium && <span class="sh-premium"><InlineIcon name="ph:crown-fill" width="11" height="11" />Premium</span>}</div>
  {handle && <div class="sh-handle" title={`@${handle}`}>@{handle}</div>}
  <button type="button" class="sh-select" data-sheet-open aria-haspopup="dialog" aria-expanded="false" aria-controls="ds-sheet">
    <Icon name="ph:hard-drives-fill" width="14" height="14" />
    <span>{kind === 'guild' ? dt('Switch server') : dt('Select a server')}</span>
    <Icon name="ph:caret-up-down" width="13" height="13" />
  </button>
</div>

<script>
  // A banner or decoration that does not load is dropped: the Petto art (or the color) under it stays, so there is never an empty frame.
  document.querySelectorAll<HTMLImageElement>('[data-sh] .sh-art-img, [data-sh] .sh-deco img').forEach((img) => {
    img.addEventListener('error', () => (img.closest('picture') ?? img).remove(), { once: true });
  });
</script>

<style>
  .sh { position: relative; flex: none; display: flex; flex-direction: column; align-items: center; text-align: center; }
  /* The art follows the theme: the dark one is the default (like the site), the light one under data-theme="light" or a light system. */
  /* No picture of the server: the Petto banner on a flat panel of the theme (the panel behind it has no gradient). */
  .sh-art { position: relative; align-self: stretch; height: 118px; overflow: hidden; isolation: isolate; background: var(--bg-raise); }
  /* The account color: a gradient from the color to a darker one. */
  .sh-art-color { background: linear-gradient(115deg, var(--sh-tint), color-mix(in srgb, var(--sh-tint) 55%, #000)); }
  .sh-art-image { background: var(--bg-raise); }
  .sh-art::after { content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none; background: linear-gradient(to bottom, transparent 42%, color-mix(in srgb, var(--dgl-side-bg, var(--card)) 74%, transparent) 80%, var(--dgl-side-bg, var(--card)) 100%); }
  .sh-art-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
  .sh-art picture { display: contents; }
  /* The Petto banner keeps its logo in the upper part, clear of the icon that sits over the bottom of the banner. */
  .sh-art-petto { object-position: 50% 72%; }

  /* The icon sits half over the banner. */
  .sh-icon { position: relative; z-index: 3; flex: none; width: 68px; height: 68px; margin-top: -36px; }
  .sh-icon-img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 18px; background: var(--bg-raise); box-shadow: 0 0 0 4px var(--dgl-side-bg, var(--card)), 0 6px 16px -6px rgba(0, 0, 0, .5); }
  .sh-user .sh-icon-img { border-radius: 50%; }
  .sh-icon-fallback { display: grid; place-items: center; color: var(--text-dim); }
  .sh-letter { font-size: 28px; font-weight: 700; line-height: 1; }
  .sh-roomy .sh-letter { font-size: 32px; }
  .sh-deco { position: absolute; left: -10%; top: -10%; width: 120%; height: 120%; pointer-events: none; }
  .sh-deco img { width: 100%; height: 100%; max-width: none; }

  .sh-name { display: flex; align-items: center; justify-content: center; gap: 7px; max-width: 100%; min-width: 0; margin-top: 9px; padding: 0 16px; }
  .sh-name strong { min-width: 0; font-size: 16.5px; font-weight: 700; letter-spacing: -.01em; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sh-premium { display: inline-flex; align-items: center; gap: 4px; flex-shrink: 0; color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border: 1px solid color-mix(in srgb, var(--yellow) 42%, var(--border)); border-radius: 999px; font-family: var(--mono); font-size: 9px; font-weight: 700; line-height: 1; padding: 4px 6px; }

  .sh-select {
    display: flex; align-items: center; gap: 9px; align-self: stretch; margin: 11px 14px 2px; padding: 9px 13px; border-radius: 11px;
    background: var(--bg-raise); border: 1px solid var(--border); color: var(--text-muted);
    font: inherit; font-size: 13.5px; font-weight: 600; text-align: left; cursor: pointer; touch-action: manipulation;
    transition: background-color var(--m-fast) ease, border-color var(--m-fast) ease, color var(--m-fast) ease, transform var(--m-instant) ease;
  }
  .sh-select span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sh-select :global(svg) { flex: none; color: var(--text-dim); }
  .sh-select:hover, .sh-select[aria-expanded="true"] { background: var(--card-hover); border-color: color-mix(in srgb, var(--text) 18%, var(--border)); color: var(--text); }
  .sh-select:active { transform: scale(.985); }
  .sh-select:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* The account header: more room everywhere. */
  .sh-roomy .sh-art { height: 132px; }
  .sh-roomy .sh-icon { width: 76px; height: 76px; margin-top: -42px; }
  .sh-roomy .sh-icon-img { box-shadow: 0 0 0 4px var(--dgl-side-bg, var(--card)), 0 8px 20px -8px rgba(0, 0, 0, .55); }
  .sh-roomy .sh-icon-fallback :global(svg) { width: 30px; height: 30px; }
  .sh-roomy .sh-name { margin-top: 9px; }
  .sh-roomy .sh-name strong { font-size: 17.5px; }
  .sh-handle { max-width: 100%; margin-top: 2px; padding: 0 16px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--mono); font-size: 12.5px; color: var(--text-dim); }
  .sh-roomy .sh-select {
    margin: 12px 14px 4px; padding: 10px 13px; border-radius: 11px; font-size: 13.5px; color: var(--text);
    background: var(--bg-raise); border-color: var(--border);
  }
  .sh-roomy .sh-select :global(svg) { color: var(--text-muted); }
  .sh-roomy .sh-select:hover, .sh-roomy .sh-select[aria-expanded="true"] { color: var(--text); background: var(--card-hover); border-color: color-mix(in srgb, var(--text) 18%, var(--border)); }

  @media (max-width: 880px) {
    .sh-art { height: 96px; }
    .sh-roomy .sh-art { height: 118px; }
    .sh-roomy .sh-icon { width: 76px; height: 76px; margin-top: -44px; }
    .sh-roomy .sh-name strong { font-size: 19px; }
    .sh-roomy .sh-select { margin: 14px 14px 4px; padding: 12px 15px; font-size: 14.5px; }
    .sh-icon { width: 62px; height: 62px; margin-top: -34px; }
    .sh-name strong { font-size: 16.5px; }
    .sh-select { margin: 11px 12px 0; padding: 10px 13px; border-radius: 14px; font-size: 14px; }
    .sh-mascot { width: 60px; height: 60px; }
  }
</style>
