---
// The row of number cards of the Statistics page, for any page of the dashboard: a small label with the color of its number, the number big in the serif
// (it counts up when the page opens), and under it how much it changed against the period before, with an arrow (green when it is good, red when it is not).
// `change` is a percentage (null: there was nothing before, so it is new; left out: no chip). `inverse`: a rise is bad (people who left).
import { changeChip } from '../utils/dashStatsView';
import { dashLocale, getDashLang, makeT } from '../i18n/dash';
type Tone = 'messages' | 'voice' | 'joins' | 'invites' | 'reactions' | 'leaves';
interface Tile { label: string; value: number; tone?: Tone; change?: number | null; inverse?: boolean; /** Said instead of the number (a time, a rating): it does not count up. */ text?: string }
interface Props { tiles: Tile[]; /** What the change is against (said once under each chip). */ against?: string }
const { tiles, against } = Astro.props;
const lang = getDashLang(Astro);
const dt = makeT(lang);
const locale = dashLocale(lang);
const compare = against ?? dt('vs before');
---
<div class="stt" style={`--cols:${Math.min(tiles.length, 6)}`}>
  {tiles.map((tile, i) => {
    const chip = tile.change === undefined ? null : changeChip(tile.change, Boolean(tile.inverse), locale, dt('new'));
    return (
      <div class="stt-tile" style={`--m:var(--m-${tile.tone ?? 'messages'});--i:${i}`}>
        <span class="stt-label"><i class="stt-swatch"></i>{tile.label}</span>
        <b data-count={tile.text === undefined && tile.value > 0 ? tile.value : undefined}>{tile.text ?? tile.value.toLocaleString(locale)}</b>
        <span class="stt-chips">{chip && <Fragment><span class={`stt-chip stt-chip-${chip.tone}`}><b>{chip.arrow ? `${chip.arrow} ` : ''}{chip.text}</b></span><small>{compare}</small></Fragment>}</span>
      </div>
    );
  })}
</div>
<script is:inline>
  (function () {
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('.stt [data-count]').forEach(function (el) {
      if (el.getAttribute('data-counted')) return;
      el.setAttribute('data-counted', '1');
      var target = Number(el.dataset.count);
      if (!isFinite(target) || target <= 0 || reduce) return;
      var started = null;
      function step(time) {
        if (started === null) started = time;
        var t = Math.min(1, (time - started) / 700);
        el.textContent = Math.round(target * (1 - Math.pow(1 - t, 3))).toLocaleString(document.documentElement.lang || 'en-US');
        if (t < 1) requestAnimationFrame(step);
      }
      el.textContent = '0';
      requestAnimationFrame(step);
    });
  })();
</script>
<style>
  .stt { --m-messages: #f0a88f; --m-reactions: #f5c26b; --m-voice: #9bd0f5; --m-joins: #86b894; --m-leaves: #c98791; --m-invites: #c6a8f5;
    display: grid; grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr)); gap: 8px; margin-bottom: 14px; }
  :global(:root[data-theme="light"]) .stt { --m-messages: #c4573a; --m-reactions: #b07a0c; --m-voice: #3a7fb8; --m-joins: #3f7a52; --m-leaves: #a85565; --m-invites: #7b55c4; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .stt { --m-messages: #c4573a; --m-reactions: #b07a0c; --m-voice: #3a7fb8; --m-joins: #3f7a52; --m-leaves: #a85565; --m-invites: #7b55c4; }
  }
  .stt-tile { position: relative; border: 1px solid var(--border); border-radius: 14px; padding: 14px 14px 12px; display: flex; flex-direction: column; gap: 6px; min-width: 0; overflow: hidden;
    background: linear-gradient(180deg, color-mix(in srgb, var(--m) 9%, var(--card)), var(--card) 70%); animation: m-rise-in var(--m-slow) var(--m-out) both; animation-delay: calc(var(--i, 0) * var(--m-stagger)); }
  .stt-label { display: flex; align-items: center; gap: 7px; font-family: var(--mono); font-size: 9.5px; letter-spacing: .01em; text-transform: uppercase; color: var(--text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .stt-swatch { display: inline-block; width: 8px; height: 8px; border-radius: 3px; background: var(--m, var(--accent)); flex: none; }
  .stt-tile > b { font-family: var(--serif); white-space: nowrap; font-size: 23px; font-weight: 600; line-height: 1.1; font-variant-numeric: lining-nums tabular-nums; }
  .stt-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 6px; min-height: 22px; }
  .stt-chips small { font-size: 11.5px; color: var(--text-dim); white-space: nowrap; }
  .stt-chip { display: inline-flex; align-items: baseline; gap: 5px; border-radius: 999px; padding: 2px 9px; font-size: 12px; line-height: 1.4; white-space: nowrap; background: color-mix(in srgb, var(--text) 6%, transparent); color: var(--text-muted); max-width: 100%; }
  .stt-chip b { font-weight: 700; font-variant-numeric: tabular-nums; }
  .stt-chip-good { background: var(--green-soft); }
  .stt-chip-good b { color: var(--green); }
  .stt-chip-bad { background: var(--red-soft); }
  .stt-chip-bad b { color: var(--red); }
  @media (max-width: 560px) { .stt { grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); } .stt-tile > b { white-space: normal; overflow-wrap: anywhere; } }
</style>
