    <h2 class="gw-h2-gap"><Icon name="ph:trophy-fill" width="15" height="15" /><Fragment set:html={dth('Ended <span class="gw-count">{a}</span>', { a: (ended.length) })} /></h2>
    {ended.length === 0 ? (
      <p class="gw-empty-note gw-empty"><Icon name="ph:trophy-fill" width="15" height="15" />{dt('No giveaway has ended yet.')}</p>
