---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import VariableHelp from './VariableHelp.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface Config {
  embedTemplate: string;
  entryMode: string;
  reaction: string;
  winnerMessage: string;
  noEntriesMessage: string;
  denyMessage: string;
  claimTimeMessage: string;
  claimTimeOverMessage: string;
  acceptMessage: string;
}
interface Active { id: number; prize: string; winnersCount: number; endsAt: string; entries: number; hostId: string; }
interface PresetRole { roleId: string; entries: number; claimTimeMs: number; entriesStack: boolean; claimTimeStack: boolean; }
interface Preset { id: number; name: string; roles: PresetRole[]; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  config: Config;
  active: Active[];
  presets: Preset[];
  roles: { id: string; name: string }[];
  embedTemplateNames: string[];
  premiumActive: boolean;
  saved: boolean;
  section?: string;
}
const { user, guildId, guildName, guildIcon, config, active, presets, roles, embedTemplateNames, premiumActive, saved, section } = Astro.props;

const sectionMeta: Record<string, string> = { settings: dt('Giveaway settings'), presets: dt('Bonus-entry presets'), active: dt('Running giveaways') };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'settings';
const selectedTitle = sectionMeta[selectedSection];

function roleName(id: string) {
  return roles.find((r) => r.id === id)?.name ?? id;
}
function formatDuration(ms: number) {
  if (!ms) return '';
  const units = [{ suffix: 'w', value: 604800000 }, { suffix: 'd', value: 86400000 }, { suffix: 'h', value: 3600000 }, { suffix: 'm', value: 60000 }, { suffix: 's', value: 1000 }];
  const unit = units.find((item) => ms >= item.value) ?? units[units.length - 1];
  return `${Math.round(ms / unit.value)}${unit.suffix}`;
}
const giveawayPresetLimit = premiumActive ? 15 : 3;
const giveawayPresetAtLimit = presets.length >= giveawayPresetLimit;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'settings' ? 'giveaways' : `giveaways-${selectedSection}`} pageTitle={selectedTitle}>
  <h1>{selectedTitle}</h1>
  <p class="gw-sub"><Fragment set:html={dth('Entry style, messages, and bonus-entry presets for giveaways in <b>{a}</b>. Start one with <code>/giveaway start</code>.', { a: (guildName) })} /></p>
  <div class="gw-discord-note"><Icon name="ph:info-fill" width="15" height="15" /><span>{dt('Giveaways are started from Discord with')} <code>{dt('/giveaway start')}</code>{dt('. This page manages their settings, messages, designs, and presets.')}</span></div>

  {saved && <div class="gw-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}

  <form method="POST" class:list={['gw-form', { 'gw-section-hidden': selectedSection !== 'settings' }]}>
    <input type="hidden" name="action" value="config" />
    <div class="gw-config-head">
      <div class="gw-config-icon"><Icon name="ph:gift-fill" width="16" height="16" /></div>
      <div class="gw-config-title">{dt('Entry & messages')}</div>
    </div>
    <div class="gw-grid">
      <div class="gw-field">
        <label>{dt('Entry method')}</label>
        <select name="entry_mode">
          <option value="button" selected={config.entryMode === 'button'}>{dt('Button')}</option>
          <option value="reaction" selected={config.entryMode === 'reaction'}>{dt('Reaction')}</option>
        </select>
      </div>
      <div class="gw-field">
        <label>{dt('Reaction emoji')}</label>
        <input type="text" name="reaction" value={config.reaction} maxlength="4" />
      </div>
      <div class="gw-field gw-field-wide">
        <label>{dt('Default giveaway design')}</label>
        <select name="embed_template">
          <option value="" selected={!config.embedTemplate}>{dt('Use Petto default')}</option>
          {embedTemplateNames.map((name) => <option value={name} selected={name === config.embedTemplate}>{name}</option>)}
        </select>
        <span class="gw-field-note">{dt('Saved designs come from the Embeds page. A per-giveaway choice can still override this default from Discord.')}</span>
      </div>
      <div class="gw-field gw-field-wide">
        <label>{dt('Winner message')}</label>
        <input type="text" name="winner_message" value={config.winnerMessage} maxlength="200" placeholder={dt('{user} won **{gw.prize}**!')} />
      </div>
      <div class="gw-field gw-field-wide">
        <label>{dt('No-entries message')}</label>
        <input type="text" name="no_entries_message" value={config.noEntriesMessage} maxlength="200" placeholder={dt('Nobody entered, no winner this time.')} />
      </div>
      <div class="gw-field gw-field-wide">
        <label>{dt('Winner denied prize message')}</label>
        <input type="text" name="deny_message" value={config.denyMessage} maxlength="200" placeholder={dt('{user} gave up their prize, re-rolling...')} />
      </div>
      <div class="gw-field gw-field-wide">
        <label>{dt('Claim prompt (when a giveaway needs winners to confirm)')}</label>
        <input type="text" name="claim_time_message" value={config.claimTimeMessage} maxlength="200" placeholder={dt('{user}, click to claim **{gw.prize}** within {gw.claim_time}!')} />
      </div>
      <div class="gw-field gw-field-wide">
        <label>{dt('Claim expired message')}</label>
        <input type="text" name="claim_time_over_message" value={config.claimTimeOverMessage} maxlength="200" placeholder={dt('{user} didn\'t claim in time, re-rolling...')} />
      </div>
      <div class="gw-field gw-field-wide">
        <label>{dt('Claim accepted message')}</label>
        <input type="text" name="accept_message" value={config.acceptMessage} maxlength="200" placeholder={dt('{user} claimed **{gw.prize}**!')} />
      </div>
      <div class="gw-field-wide">
        <VariableHelp />
      </div>
    </div>
    <button type="submit" class="btn btn-accent btn-sm">{dt('Save changes')}</button>
  </form>

  <div class:list={['gw-section', { 'gw-section-hidden': selectedSection !== 'presets' }]}>
    <h2><Icon name="ph:star-fill" width="15" height="15" /><Fragment set:html={dth('Bonus-entry presets <span class="gw-count">{a}/{b}</span>', { a: (presets.length), b: (giveawayPresetLimit) })} />{!premiumActive && <span class="gw-premium-tag">Premium: 15</span>}</h2>
    <p class="gw-section-note">{dt('Give certain roles extra entries automatically when a giveaway uses a preset.')}</p>

    <div class="gw-presets">
      {presets.map((p) => (
        <div class="gw-preset">
          <div class="gw-preset-head">
            <span class="gw-preset-name">{p.name}</span>
            <form method="POST"><input type="hidden" name="action" value="delete_preset" /><input type="hidden" name="preset_id" value={p.id} />
              <button type="submit" class="gw-preset-del" title={dt('Delete preset')}><Icon name="ph:trash-fill" width="13" height="13" /></button>
            </form>
          </div>
          {p.roles.length > 0 && (
            <div class="gw-preset-roles">
              {p.roles.map((r) => (
                <span class="gw-preset-role">
                  {roleName(r.roleId)} +{r.entries}
                  {r.claimTimeMs > 0 && <em title={dt('Extra claim time for winners with this role')}> +{formatDuration(r.claimTimeMs)} claim</em>}
                  {r.entriesStack && <em title={dt('Entries stack with other matching roles')}> stacks</em>}
                  {r.claimTimeStack && <em title={dt('Claim time stacks with other matching roles')}> +time</em>}
                </span>
              ))}
            </div>
          )}
          <form method="POST" class="gw-add-role">
            <input type="hidden" name="action" value="add_preset_role" />
            <input type="hidden" name="preset_id" value={p.id} />
            <select name="role_id" required>
              <option value="" disabled selected>{dt('Role')}</option>
              {roles.map((r) => <option value={r.id}>{r.name}</option>)}
            </select>
            <input type="number" name="entries" placeholder={dt('Extra entries')} min="1" max="100" required />
            <input type="text" name="claim_time" placeholder={dt('Claim time, e.g. 5m')} maxlength="12" />
            <label class="gw-stack-check"><input type="checkbox" name="entries_stack" />{dt('Stack entries')}</label>
            <label class="gw-stack-check"><input type="checkbox" name="claim_time_stack" />{dt('Stack claim time')}</label>
            <button type="submit" class="btn btn-ghost btn-sm">{dt('Add')}</button>
          </form>
        </div>
      ))}
    </div>

    {giveawayPresetAtLimit ? (
      <div class="gw-limit-card">
        <div><strong>{premiumActive ? dt('Preset limit reached') : dt('Free preset limit reached')}</strong><span>{premiumActive ? dt('You are using all {n} available giveaway presets.',{n:giveawayPresetLimit}) : dt('Free includes 3 presets. Premium increases this to 15.')}</span></div>
        {!premiumActive && <a class="btn btn-ghost btn-sm" href={`/dash/premium?guild_id=${guildId}`}>{dt('Unlock Premium')}</a>}
      </div>
    ) : (
      <form method="POST" class="gw-add-preset">
        <input type="hidden" name="action" value="add_preset" />
        <input type="text" name="name" placeholder={dt('Preset name, e.g. Booster bonus')} maxlength="40" required />
        <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add preset')}</button>
      </form>
    )}
  </div>

  <div class:list={['gw-section', { 'gw-section-hidden': selectedSection !== 'active' }]}>
    <h2><Icon name="ph:timer-fill" width="15" height="15" /><Fragment set:html={dth('Running now <span class="gw-count">{a}</span>', { a: (active.length) })} /></h2>
    {active.length === 0 ? (
      <p class="gw-empty-note">{dt('Nothing running.')}</p>
    ) : (
      <div class="gw-active-list">
        {active.map((g) => (
          <div class="gw-active-row">
            <span class="gw-active-prize">{g.prize}</span>
            <span class="gw-active-meta">{g.winnersCount} winner{g.winnersCount !== 1 ? 's' : ''}</span>
            <span class="gw-active-meta">{g.entries} entries</span>
            <span class="gw-active-ends">{dt('ends {d}', { d: new Date(g.endsAt).toLocaleString(dashLang) })}</span>
          </div>
        ))}
      </div>
    )}
  </div>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  h2 { font-size: 14.5px; margin: 0 0 6px; display: flex; align-items: center; gap: 8px; }
  h2 :global(svg) { color: var(--accent); }
  .gw-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 24px; max-width: 68ch; }
  .gw-sub :global(b){ color: var(--text); }
  .gw-sub :global(code){ font-family: var(--mono); color: var(--accent); }

  .gw-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 20px; max-width: fit-content; }
  .gw-discord-note { display: flex; align-items: flex-start; gap: 8px; color: var(--text-muted); background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border)); border-radius: 9px; padding: 10px 14px; margin: -10px 0 20px; max-width: 640px; font-size: 12.5px; line-height: 1.45; }
  .gw-discord-note :global(svg) { color: var(--accent); flex-shrink: 0; margin-top: 1px; }
  .gw-discord-note :global(code){ font-family: var(--mono); color: var(--accent); }

  .gw-form { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; margin-bottom: 40px; max-width: 640px; width: 100%; border: 1px solid var(--border); border-radius: 14px; background: var(--bg-raise); padding: 18px 20px; }
  .gw-config-head { display: flex; align-items: center; gap: 10px; }
  .gw-config-icon { width: 30px; height: 30px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: var(--accent-soft); color: var(--accent); }
  .gw-config-title { font-size: 13.5px; font-weight: 600; color: var(--text); }
  .gw-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 24px; width: 100%; }
  .gw-field { display: flex; flex-direction: column; gap: 6px; }
  .gw-field-wide { grid-column: 1 / -1; }
  .gw-field label { font-size: 12px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.03em; }
  .gw-field input, .gw-field select { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; }
  .gw-field-note { font-size: 11.5px; line-height: 1.4; color: var(--text-dim); }

  .gw-section { margin-bottom: 40px; }
  .gw-section-hidden { display: none; }
  .gw-section-note { font-size: 12.5px; color: var(--text-dim); margin: 0 0 14px; }
  :global(.gw-count){ font-family: var(--mono); font-size: 11px; color: var(--text-dim); font-weight: 400; }
  .gw-premium-tag { font-family: var(--mono); font-size: 10px; font-weight: 600; color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border: 1px solid color-mix(in srgb, var(--yellow) 32%, var(--border)); border-radius: 999px; padding: 3px 7px; }
  .gw-limit-card { display: flex; align-items: center; justify-content: space-between; gap: 12px; max-width: 520px; padding: 13px 15px; border: 1px solid color-mix(in srgb, var(--yellow) 38%, var(--border)); border-radius: 11px; background: color-mix(in srgb, var(--yellow) 6%, var(--card)); }
  .gw-limit-card > div { display: grid; gap: 3px; min-width: 0; }
  .gw-limit-card strong { color: var(--text); font-size: 13px; }
  .gw-limit-card :global(span){ color: var(--text-muted); font-size: 12px; line-height: 1.4; }
  .gw-limit-card .btn { flex-shrink: 0; }
  .gw-empty-note { font-size: 13px; color: var(--text-dim); }

  .gw-presets { display: flex; flex-direction: column; gap: 10px; margin-bottom: 12px; max-width: 480px; }
  .gw-preset { border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; background: var(--card); }
  .gw-preset-head { display: flex; align-items: center; justify-content: space-between; }
  .gw-preset-name { font-size: 13.5px; font-weight: 600; color: var(--text); }
  .gw-preset-del { border: none; background: transparent; color: var(--text-dim); cursor: pointer; padding: 4px; border-radius: 6px; }
  .gw-preset-del:hover { color: var(--red); background: var(--red-soft); }
  .gw-preset-roles { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .gw-preset-role { font-size: 11.5px; color: var(--accent); background: var(--accent-soft); padding: 3px 8px; border-radius: 6px; }
  .gw-preset-role em { font-style: normal; opacity: 0.75; }
  .gw-add-role { display: flex; gap: 6px; margin-top: 10px; align-items: center; flex-wrap: wrap; }
  .gw-add-role select, .gw-add-role input[type="number"] { border: 1px solid var(--border); border-radius: 7px; padding: 6px 8px; background: var(--bg-raise); color: var(--text); font-family: var(--sans); font-size: 12px; }
  .gw-add-role input[type="number"] { width: 90px; }
  .gw-stack-check { display: flex; align-items: center; gap: 5px; font-size: 11.5px; color: var(--text-dim); cursor: pointer; white-space: nowrap; }
  .gw-stack-check input { accent-color: var(--accent); }

  .gw-add-preset { display: flex; flex-wrap: wrap; gap: 8px; }
  .gw-add-preset input { flex: 1 1 200px; min-width: 0; border: 1px solid var(--border); border-radius: 8px; padding: 8px 11px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13px; box-sizing: border-box; }
  .gw-add-preset .btn { display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0; }

  .gw-active-list { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; max-width: 620px; }
  .gw-active-row { display: flex; align-items: center; gap: 14px; padding: 10px 14px; font-size: 13px; background: var(--card); flex-wrap: wrap; }
  .gw-active-row + .gw-active-row { border-top: 1px solid var(--border-soft); }
  .gw-active-prize { font-weight: 600; color: var(--text); }
  .gw-active-meta { color: var(--text-dim); font-size: 12px; }
  .gw-active-ends { margin-left: auto; color: var(--text-dim); font-size: 12px; }

  @media (max-width: 620px) {
    .gw-grid { grid-template-columns: 1fr; }
  }
</style>
