---
import SilentMentionHint from './SilentMentionHint.astro';
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import VariableHelp from './VariableHelp.astro';
import DashAcData from './DashAcData.astro';
import DashFormKit from './DashFormKit.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import EmojiPicker from './EmojiPicker.astro';

import { getDashLang, makeT } from '../i18n/dash';
import { FREE_LIMITS, PREMIUM_LIMITS, planLimits } from '../utils/planLimits';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface Config {
  embedTemplate: string;
  entryMode: string;
  reaction: string;
  winnerMessage: string;
  noEntriesMessage: string;
  denyMessage: string;
  claimTimeMessage: string;
  claimTimeOverMessage: string;
  acceptMessage: string;
  winnerMessageEmbed: string;
  noEntriesMessageEmbed: string;
  denyMessageEmbed: string;
  claimTimeMessageEmbed: string;
  claimTimeOverMessageEmbed: string;
  acceptMessageEmbed: string;
}
interface Active { id: number; prize: string; winnersCount: number; endsAt: string; entries: number; hostId: string; channelId?: string; messageId?: string | null; }
interface Ended { id: number; prize: string; winnersCount: number; endsAt: string; channelId: string; messageId: string | null; }
interface PresetRole { roleId: string; entries: number; claimTimeMs: number; entriesStack: boolean; claimTimeStack: boolean; }
interface PresetLevel { source: string; level: number; entries: number; }
interface Preset { id: number; name: string; roles: PresetRole[]; minLevel?: number; minVoiceLevel?: number; levels?: PresetLevel[]; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  config: Config;
  active: Active[];
  ended?: Ended[];
  channels?: { id: string; name: string }[];
  giveawayError?: string | null;
  giveawayNote?: string | null;
  presets: Preset[];
  roles: { id: string; name: string }[];
  embedTemplateNames: string[];
  premiumActive: boolean;
  saved: boolean;
  section?: string;
}
const { user, guildId, guildName, guildIcon, config, active, ended = [], channels = [], giveawayError = null, giveawayNote = null, presets, roles, embedTemplateNames, premiumActive, saved, section } = Astro.props;

const sectionMeta: Record<string, string> = { settings: dt('Giveaway settings'), presets: dt('Bonus-entry presets'), active: dt('Running giveaways') };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'settings';
const selectedTitle = sectionMeta[selectedSection];

function roleName(id: string) {
  return roles.find((r) => r.id === id)?.name ?? id;
}
function formatDuration(ms: number) {
  if (!ms) return '';
  const units = [{ suffix: 'w', value: 604800000 }, { suffix: 'd', value: 86400000 }, { suffix: 'h', value: 3600000 }, { suffix: 'm', value: 60000 }, { suffix: 's', value: 1000 }];
  const unit = units.find((item) => ms >= item.value) ?? units[units.length - 1];
  return `${Math.round(ms / unit.value)}${unit.suffix}`;
}
const giveawayPresetLimit = planLimits(premiumActive).giveawayPresets;
const giveawayPresetAtLimit = presets.length >= giveawayPresetLimit;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'settings' ? 'giveaways' : `giveaways-${selectedSection}`} pageTitle={selectedTitle}>
  <DashFormKit />
  <DashSettingsKit />
  <h1>{selectedTitle}</h1>
  <div class="gw-discord-note"><Icon name="ph:info-fill" width="15" height="15" /><span>{dt('Start one here, in Running now, or in Discord with')} <code>{dt('/giveaway start')}</code>{dt('. This page also manages their settings, messages, designs, and presets.')}</span></div>

  {selectedSection === 'active' && <DashStatTiles tiles={[
    { label: dt('Running now'), value: active.length, tone: 'joins' },
    { label: dt('Entries'), value: active.reduce((sum, g) => sum + (g.entries ?? 0), 0), tone: 'messages' },
    { label: dt('Ended'), value: ended.length, tone: 'invites' },
  ]} />}
  {selectedSection === 'presets' && <DashStatTiles tiles={[
    { label: dt('Presets'), value: presets.length, tone: 'reactions' },
    { label: dt('Roles with bonus'), value: presets.reduce((sum, p) => sum + p.roles.length, 0), tone: 'invites' },
    { label: dt('Level steps'), value: presets.reduce((sum, p) => sum + (p.levels ?? []).length, 0), tone: 'voice' },
  ]} />}
  {saved && <div class="gw-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}{giveawayNote ? ' ' : ''}{giveawayNote}</div>}
  {giveawayError && <div class="gw-error"><Icon name="ph:warning-fill" width="15" height="15" />{giveawayError}</div>}

  {selectedSection === 'settings' && <DashAcData roles={roles} channels={channels} />}
  {selectedSection === 'settings' && (
  <form method="POST" class:list={['dfx-form', 'gw-form', { 'gw-section-hidden': selectedSection !== 'settings' }]}>
    <input type="hidden" name="action" value="config" />
    <section class="dfx-sec gw-first">
      <div class="dfx-sec-head"><h2>{dt('Entry & messages')}</h2><p>{dt('How members enter and what Petto says along the way.')}</p></div>
      <div class="dfx-field">
        <span class="dfx-label">{dt('Entry method')}</span>
        <div class="dfx-chips">
          <label class="dfx-chip"><input type="radio" name="entry_mode" value="button" checked={config.entryMode === 'button'} />{dt('Button')}</label>
          <label class="dfx-chip"><input type="radio" name="entry_mode" value="reaction" checked={config.entryMode === 'reaction'} />{dt('Reaction')}</label>
        </div>
      </div>
      <div class="dfx-field" data-sx-needs="entry_mode=reaction">
        <label>{dt('Reaction emoji')}</label>
        <input type="text" name="reaction" data-emoji-input value={config.reaction} maxlength="4" />
        <span class="dfx-hint">{dt('The emoji members press to enter.')}</span>
      </div>
      <div class="dfx-field">
        <label>{dt('Default giveaway design')}</label>
        <select name="embed_template" data-dp-template-only>
          <option value="" selected={!config.embedTemplate}>{dt('Use Petto default')}</option>
          {embedTemplateNames.map((name) => <option value={name} selected={name === config.embedTemplate}>{name}</option>)}
        </select>
        <span class="dfx-hint">{dt('Saved designs come from the Embeds page. A per-giveaway choice can still override this default from Discord.')}</span>
      </div>
    </section>

    <section class="dfx-sec">
      <div class="dfx-sec-head"><h2>{dt('Messages')}</h2><p>{dt('Open one to change it. The ones you changed have a dot.')}</p></div>
      <div class="gw-accs">
      <details class="dfx-acc gw-acc" open={Boolean(config.winnerMessage || config.winnerMessageEmbed)}>
        <summary><span class="dfx-acc-title"><b>{dt('Winner message')}{(config.winnerMessage || config.winnerMessageEmbed) && <i class="gw-dot" title={dt('Changed')}></i>}</b><em>{dt('Sent when the giveaway ends with a winner.')}</em></span><svg class="dfx-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
        <div class="dfx-acc-body">
          <div class="dfx-field">
            <textarea class="dgl-autogrow" rows="2" name="winner_message" data-ac data-dp data-count maxlength="200" placeholder={dt('{user} won **{gw.prize}**!')} aria-label={dt('Winner message')}>{config.winnerMessage}</textarea><SilentMentionHint />
          </div>
          <div class="dfx-field">
            <label>{dt('Saved design')}</label>
            <select name="winner_embed_template" data-tpl-locks="winner_message" data-dp-template-only>
              <option value="" selected={!config.winnerMessageEmbed}>{dt('Send it as text')}</option>
              {embedTemplateNames.map((name) => <option value={name} selected={name === config.winnerMessageEmbed}>{name}</option>)}
            </select>
            <span class="dfx-hint">{dt('Or send a saved design instead of the text above.')}</span>
          </div>
        </div>
      </details>
      <details class="dfx-acc gw-acc" open={Boolean(config.noEntriesMessage || config.noEntriesMessageEmbed)}>
        <summary><span class="dfx-acc-title"><b>{dt('No-entries message')}{(config.noEntriesMessage || config.noEntriesMessageEmbed) && <i class="gw-dot" title={dt('Changed')}></i>}</b><em>{dt('Sent when nobody entered.')}</em></span><svg class="dfx-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
        <div class="dfx-acc-body">
          <div class="dfx-field">
            <textarea class="dgl-autogrow" rows="2" name="no_entries_message" data-ac data-dp data-count maxlength="200" placeholder={dt('Nobody entered, no winner this time.')} aria-label={dt('No-entries message')}>{config.noEntriesMessage}</textarea><SilentMentionHint />
          </div>
          <div class="dfx-field">
            <label>{dt('Saved design')}</label>
            <select name="no_entries_embed_template" data-tpl-locks="no_entries_message" data-dp-template-only>
              <option value="" selected={!config.noEntriesMessageEmbed}>{dt('Send it as text')}</option>
              {embedTemplateNames.map((name) => <option value={name} selected={name === config.noEntriesMessageEmbed}>{name}</option>)}
            </select>
            <span class="dfx-hint">{dt('Or send a saved design instead of the text above.')}</span>
          </div>
        </div>
      </details>
      <details class="dfx-acc gw-acc" open={Boolean(config.denyMessage || config.denyMessageEmbed)}>
        <summary><span class="dfx-acc-title"><b>{dt('Winner denied prize message')}{(config.denyMessage || config.denyMessageEmbed) && <i class="gw-dot" title={dt('Changed')}></i>}</b><em>{dt('Sent when a winner gives up the prize.')}</em></span><svg class="dfx-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
        <div class="dfx-acc-body">
          <div class="dfx-field">
            <textarea class="dgl-autogrow" rows="2" name="deny_message" data-ac data-dp data-count maxlength="200" placeholder={dt('{user} gave up their prize, re-rolling...')} aria-label={dt('Winner denied prize message')}>{config.denyMessage}</textarea><SilentMentionHint />
          </div>
          <div class="dfx-field">
            <label>{dt('Saved design')}</label>
            <select name="deny_embed_template" data-tpl-locks="deny_message" data-dp-template-only>
              <option value="" selected={!config.denyMessageEmbed}>{dt('Send it as text')}</option>
              {embedTemplateNames.map((name) => <option value={name} selected={name === config.denyMessageEmbed}>{name}</option>)}
            </select>
            <span class="dfx-hint">{dt('Or send a saved design instead of the text above.')}</span>
          </div>
        </div>
      </details>
      <details class="dfx-acc gw-acc" open={Boolean(config.claimTimeMessage || config.claimTimeMessageEmbed)}>
        <summary><span class="dfx-acc-title"><b>{dt('Claim prompt (when a giveaway needs winners to confirm)')}{(config.claimTimeMessage || config.claimTimeMessageEmbed) && <i class="gw-dot" title={dt('Changed')}></i>}</b><em>{dt('Sent to winners who have to confirm the prize.')}</em></span><svg class="dfx-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
        <div class="dfx-acc-body">
          <div class="dfx-field">
            <textarea class="dgl-autogrow" rows="2" name="claim_time_message" data-ac data-dp data-count maxlength="200" placeholder={dt('{user}, click to claim **{gw.prize}** within {gw.claim_time}!')} aria-label={dt('Claim prompt (when a giveaway needs winners to confirm)')}>{config.claimTimeMessage}</textarea><SilentMentionHint />
          </div>
          <div class="dfx-field">
            <label>{dt('Saved design')}</label>
            <select name="claim_time_embed_template" data-tpl-locks="claim_time_message" data-dp-template-only>
              <option value="" selected={!config.claimTimeMessageEmbed}>{dt('Send it as text')}</option>
              {embedTemplateNames.map((name) => <option value={name} selected={name === config.claimTimeMessageEmbed}>{name}</option>)}
            </select>
            <span class="dfx-hint">{dt('Or send a saved design instead of the text above.')}</span>
          </div>
        </div>
      </details>
      <details class="dfx-acc gw-acc" open={Boolean(config.claimTimeOverMessage || config.claimTimeOverMessageEmbed)}>
        <summary><span class="dfx-acc-title"><b>{dt('Claim expired message')}{(config.claimTimeOverMessage || config.claimTimeOverMessageEmbed) && <i class="gw-dot" title={dt('Changed')}></i>}</b><em>{dt('Sent when a winner does not claim in time.')}</em></span><svg class="dfx-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
        <div class="dfx-acc-body">
          <div class="dfx-field">
            <textarea class="dgl-autogrow" rows="2" name="claim_time_over_message" data-ac data-dp data-count maxlength="200" placeholder={dt('{user} didn\'t claim in time, re-rolling...')} aria-label={dt('Claim expired message')}>{config.claimTimeOverMessage}</textarea><SilentMentionHint />
          </div>
          <div class="dfx-field">
            <label>{dt('Saved design')}</label>
            <select name="claim_time_over_embed_template" data-tpl-locks="claim_time_over_message" data-dp-template-only>
              <option value="" selected={!config.claimTimeOverMessageEmbed}>{dt('Send it as text')}</option>
              {embedTemplateNames.map((name) => <option value={name} selected={name === config.claimTimeOverMessageEmbed}>{name}</option>)}
            </select>
            <span class="dfx-hint">{dt('Or send a saved design instead of the text above.')}</span>
          </div>
        </div>
      </details>
      <details class="dfx-acc gw-acc" open={Boolean(config.acceptMessage || config.acceptMessageEmbed)}>
        <summary><span class="dfx-acc-title"><b>{dt('Claim accepted message')}{(config.acceptMessage || config.acceptMessageEmbed) && <i class="gw-dot" title={dt('Changed')}></i>}</b><em>{dt('Sent when a winner claims the prize.')}</em></span><svg class="dfx-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
        <div class="dfx-acc-body">
          <div class="dfx-field">
            <textarea class="dgl-autogrow" rows="2" name="accept_message" data-ac data-dp data-count maxlength="200" placeholder={dt('{user} claimed **{gw.prize}**!')} aria-label={dt('Claim accepted message')}>{config.acceptMessage}</textarea><SilentMentionHint />
          </div>
          <div class="dfx-field">
            <label>{dt('Saved design')}</label>
            <select name="accept_embed_template" data-tpl-locks="accept_message" data-dp-template-only>
              <option value="" selected={!config.acceptMessageEmbed}>{dt('Send it as text')}</option>
              {embedTemplateNames.map((name) => <option value={name} selected={name === config.acceptMessageEmbed}>{name}</option>)}
            </select>
            <span class="dfx-hint">{dt('Or send a saved design instead of the text above.')}</span>
          </div>
        </div>
      </details>
      </div>
      <VariableHelp />
    </section>

    <div class="dfx-foot"><button type="submit" class="btn btn-accent btn-sm">{dt('Save changes')}</button></div>
  </form>
  )}

  {selectedSection === 'presets' && (
  <div class="gwx-page">
    <div class="gwx-head">
      <h2>{dt('Bonus-entry presets')} <span class="gwx-count">{presets.length}/{giveawayPresetLimit}</span>{!premiumActive && <span class="gw-premium-tag">Premium: {PREMIUM_LIMITS.giveawayPresets}</span>}</h2>
      <p>{dt('Give certain roles extra entries automatically, and ask for a level or give extra entries by level, when a giveaway uses a preset.')}</p>
    </div>

    {presets.length === 0 && <p class="gwx-empty"><Icon name="ph:star-fill" width="18" height="18" />{dt('No presets yet. Add one below.')}</p>}
    <div class="gwx-list dgl-stagger">
      {presets.map((p) => (
        <div class="gwx-item">
          <div class="gwx-item-head">
            <span class="gwx-icon" aria-hidden="true"><Icon name="ph:star-fill" width="17" height="17" /></span>
            <span class="gwx-item-title">
              <b>{p.name}</b>
              <span>{dt('Roles')}: {p.roles.length} · {dt('Levels')}: {(p.levels ?? []).length}</span>
            </span>
            <form method="POST" data-no-dirty><input type="hidden" name="action" value="delete_preset" /><input type="hidden" name="preset_id" value={p.id} />
              <button type="submit" class="gw-preset-del gwx-del" title={dt('Delete preset')} aria-label={dt('Delete preset')}><Icon name="ph:trash-fill" width="15" height="15" /></button>
            </form>
          </div>

          <details class="dfx-acc" open={p.roles.length > 0}>
            <summary><span class="dfx-acc-title"><b>{dt('Roles with bonus')}</b><em>{dt('Extra entries for the members who have a role.')}</em></span><span class="gwx-badge">{p.roles.length}</span><Icon name="ph:caret-down-bold" class="dfx-caret" width="14" height="14" /></summary>
            <div class="dfx-acc-body">
              {p.roles.length > 0 && (
                <div class="gwx-chips">
                  {p.roles.map((r) => (
                    <span class="gwx-chip">
                      <b>{roleName(r.roleId)}</b>
                      <i>{dt('+{a} entries', { a: r.entries })}</i>
                      {r.claimTimeMs > 0 && <em title={dt('Extra claim time for winners with this role')}>{dt('+{a} claim time', { a: formatDuration(r.claimTimeMs) })}</em>}
                      {r.entriesStack && <em title={dt('Entries stack with other matching roles')}>{dt('Stacks')}</em>}
                      {r.claimTimeStack && <em title={dt('Claim time stacks with other matching roles')}>{dt('Time stacks')}</em>}
                    </span>
                  ))}
                </div>
              )}
              <form method="POST" class="gwx-add" data-no-dirty>
                <input type="hidden" name="action" value="add_preset_role" />
                <input type="hidden" name="preset_id" value={p.id} />
                <div class="dfx-grid dfx-grid-3">
                  <div class="dfx-field"><label>{dt('Role')}</label>
                    <select name="role_id" required>
                      <option value="" disabled selected>{dt('Role')}</option>
                      {roles.map((r) => <option value={r.id}>{r.name}</option>)}
                    </select>
                  </div>
                  <div class="dfx-field"><label>{dt('Extra entries')}</label><input type="number" name="entries" min="1" max="100" required /></div>
                  <div class="dfx-field"><label>{dt('Claim time')} <span class="gw-muted">{dt('optional')}</span></label><input type="text" name="claim_time" placeholder={dt('Claim time, e.g. 5m')} maxlength="12" /></div>
                </div>
                <div class="dfx-chips">
                  <label class="dfx-chip"><input type="checkbox" name="entries_stack" />{dt('Stack entries')}</label>
                  <label class="dfx-chip"><input type="checkbox" name="claim_time_stack" />{dt('Stack claim time')}</label>
                </div>
                <div class="dfx-foot"><button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button></div>
              </form>
            </div>
          </details>

          <details class="dfx-acc" open={(p.levels ?? []).length > 0 || Boolean(p.minLevel) || Boolean(p.minVoiceLevel)}>
            <summary><span class="dfx-acc-title"><b>{dt('Levels')}</b><em>{dt('A level to take part, and extra entries for each level reached.')}</em></span><span class="gwx-badge">{(p.levels ?? []).length}</span><Icon name="ph:caret-down-bold" class="dfx-caret" width="14" height="14" /></summary>
            <div class="dfx-acc-body">
              <form method="POST" class="gwx-add">
                <input type="hidden" name="action" value="set_preset_levels" />
                <input type="hidden" name="preset_id" value={p.id} />
                <div class="dfx-grid">
                  <div class="dfx-field"><label>{dt('Message level needed')}</label><input type="number" name="min_level" value={p.minLevel ?? 0} min="0" max="10000" /></div>
                  <div class="dfx-field"><label>{dt('Voice level needed')}</label><input type="number" name="min_voice_level" value={p.minVoiceLevel ?? 0} min="0" max="10000" /></div>
                </div>
                <div class="dfx-foot"><button type="submit" class="btn btn-ghost btn-sm">{dt('Save')}</button></div>
              </form>
              {(p.levels ?? []).length > 0 && (
                <div class="gwx-chips">
                  {(p.levels ?? []).map((step) => (
                    <form method="POST" class="gwx-chip" data-no-dirty>
                      <input type="hidden" name="action" value="delete_preset_level" />
                      <input type="hidden" name="preset_id" value={p.id} />
                      <input type="hidden" name="source" value={step.source} />
                      <input type="hidden" name="level" value={step.level} />
                      <b>{step.source === 'voice' ? dt('Voice level') : dt('Level')} {step.level}+</b> <i>+{step.entries}</i>
                      <button type="submit" class="gwx-chip-x" title={dt('Remove')} aria-label={dt('Remove')}>×</button>
                    </form>
                  ))}
                </div>
              )}
              <form method="POST" class="gwx-add" data-no-dirty>
                <input type="hidden" name="action" value="add_preset_level" />
                <input type="hidden" name="preset_id" value={p.id} />
                <div class="dfx-field">
                  <span class="dfx-label">{dt('Level')}</span>
                  <div class="dfx-chips">
                    <label class="dfx-chip"><input type="radio" name="source" value="text" checked />{dt('Message level')}</label>
                    <label class="dfx-chip"><input type="radio" name="source" value="voice" />{dt('Voice level')}</label>
                  </div>
                </div>
                <div class="dfx-grid">
                  <div class="dfx-field"><label>{dt('From level')}</label><input type="number" name="level" min="1" max="10000" required /></div>
                  <div class="dfx-field"><label>{dt('Extra entries')}</label><input type="number" name="entries" min="1" max="1000" required /></div>
                </div>
                <div class="dfx-foot"><button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button></div>
              </form>
            </div>
          </details>
        </div>
      ))}
    </div>

    {giveawayPresetAtLimit ? (
      <div class="gwx-limit">
        <Icon name="ph:crown-simple-fill" width="20" height="20" />
        <div><strong>{premiumActive ? dt('Preset limit reached') : dt('Free preset limit reached')}</strong><span>{premiumActive ? dt('You are using all {n} available giveaway presets.',{n:giveawayPresetLimit}) : dt('Free includes {a} presets. Premium increases this to {b}.', { a: FREE_LIMITS.giveawayPresets, b: PREMIUM_LIMITS.giveawayPresets })}</span></div>
        {!premiumActive && <a class="btn btn-ghost btn-sm" href={`/dash/premium?guild_id=${guildId}`}>{dt('Unlock Premium')}</a>}
      </div>
    ) : (
      <form method="POST" class="dfx-form gwx-new" data-no-dirty>
        <input type="hidden" name="action" value="add_preset" />
        <div class="dfx-sec-head"><h2><Icon name="ph:plus-circle-fill" width="16" height="16" />{dt('Add preset')}</h2></div>
        <div class="dfx-field"><label>{dt('Name')}</label><textarea name="name" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count maxlength="40" placeholder={dt('Preset name, e.g. Booster bonus')} required></textarea></div>
