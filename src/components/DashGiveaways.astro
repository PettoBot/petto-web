          <select name="preset"><option value="">{dt('None')}</option>{presets.map((preset) => <option value={preset.name}>{preset.name}</option>)}</select>
        </div>
        <div class="gw-field"><label>{dt('Design')}</label>
          <select name="embed_template"><option value="">{dt('Server default')}</option>{embedTemplateNames.map((name) => <option value={name}>{name}</option>)}</select>
        </div>
      </div>
      <button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:rocket-launch-fill" width="13" height="13" />{dt('Start giveaway')}</button>
    </form>

    <h2 class="gw-h2-gap"><Icon name="ph:timer-fill" width="15" height="15" /><Fragment set:html={dth('Running now <span class="gw-count">{a}</span>', { a: (active.length) })} /></h2>
    {active.length === 0 ? (
      <p class="gw-empty-note gw-empty"><Icon name="ph:timer-fill" width="15" height="15" />{dt('Nothing running.')}</p>
    ) : (
