---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import VariableHelp from './VariableHelp.astro';

interface Config {
  entryMode: string;
  reaction: string;
  winnerMessage: string;
  noEntriesMessage: string;
  denyMessage: string;
  claimTimeMessage: string;
  claimTimeOverMessage: string;
  acceptMessage: string;
}
interface Active { id: number; prize: string; winnersCount: number; endsAt: string; entries: number; hostId: string; }
interface PresetRole { roleId: string; entries: number; entriesStack: boolean; claimTimeStack: boolean; }
interface Preset { id: number; name: string; roles: PresetRole[]; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  config: Config;
  active: Active[];
  presets: Preset[];
  roles: { id: string; name: string }[];
  saved: boolean;
}
const { user, guildId, guildName, guildIcon, config, active, presets, roles, saved } = Astro.props;

function roleName(id: string) {
  return roles.find((r) => r.id === id)?.name ?? id;
}
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="giveaways" pageTitle="Giveaways">
  <h1>Giveaways</h1>
  <p class="gw-sub">Entry style, messages, and bonus-entry presets for giveaways in <b>{guildName}</b>. Start one with <code>/giveaway start</code>.</p>

  {saved && <div class="gw-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />Saved.</div>}

  <form method="POST" class="gw-form">
    <input type="hidden" name="action" value="config" />
    <div class="gw-config-head">
      <div class="gw-config-icon"><Icon name="ph:gift-fill" width="16" height="16" /></div>
      <div class="gw-config-title">Entry &amp; messages</div>
    </div>
    <div class="gw-grid">
      <div class="gw-field">
        <label>Entry method</label>
        <select name="entry_mode">
          <option value="button" selected={config.entryMode === 'button'}>Button</option>
          <option value="reaction" selected={config.entryMode === 'reaction'}>Reaction</option>
        </select>
      </div>
      <div class="gw-field">
        <label>Reaction emoji</label>
        <input type="text" name="reaction" value={config.reaction} maxlength="4" />
      </div>
      <div class="gw-field gw-field-wide">
        <label>Winner message</label>
        <input type="text" name="winner_message" value={config.winnerMessage} maxlength="200" placeholder="{user} won **{gw.prize}**!" />
      </div>
      <div class="gw-field gw-field-wide">
        <label>No-entries message</label>
        <input type="text" name="no_entries_message" value={config.noEntriesMessage} maxlength="200" placeholder="Nobody entered, no winner this time." />
      </div>
      <div class="gw-field gw-field-wide">
        <label>Winner denied prize message</label>
        <input type="text" name="deny_message" value={config.denyMessage} maxlength="200" placeholder="{user} gave up their prize, re-rolling..." />
      </div>
      <div class="gw-field gw-field-wide">
        <label>Claim prompt (when a giveaway needs winners to confirm)</label>
        <input type="text" name="claim_time_message" value={config.claimTimeMessage} maxlength="200" placeholder="{user}, click to claim **{gw.prize}** within {gw.claim_time}!" />
      </div>
      <div class="gw-field gw-field-wide">
        <label>Claim expired message</label>
        <input type="text" name="claim_time_over_message" value={config.claimTimeOverMessage} maxlength="200" placeholder="{user} didn't claim in time, re-rolling..." />
      </div>
      <div class="gw-field gw-field-wide">
        <label>Claim accepted message</label>
        <input type="text" name="accept_message" value={config.acceptMessage} maxlength="200" placeholder="{user} claimed **{gw.prize}**!" />
      </div>
      <div class="gw-field-wide">
        <VariableHelp />
      </div>
    </div>
    <button type="submit" class="btn btn-accent btn-sm">Save changes</button>
  </form>

  <div class="gw-section">
    <h2><Icon name="ph:star-fill" width="15" height="15" />Bonus-entry presets</h2>
    <p class="gw-section-note">Give certain roles extra entries automatically when a giveaway uses a preset.</p>

    <div class="gw-presets">
      {presets.map((p) => (
        <div class="gw-preset">
          <div class="gw-preset-head">
            <span class="gw-preset-name">{p.name}</span>
            <form method="POST"><input type="hidden" name="action" value="delete_preset" /><input type="hidden" name="preset_id" value={p.id} />
              <button type="submit" class="gw-preset-del" title="Delete preset"><Icon name="ph:trash-fill" width="13" height="13" /></button>
            </form>
          </div>
          {p.roles.length > 0 && (
            <div class="gw-preset-roles">
              {p.roles.map((r) => (
                <span class="gw-preset-role">
                  {roleName(r.roleId)} +{r.entries}
                  {r.entriesStack && <em title="Entries stack with other matching roles"> stacks</em>}
                  {r.claimTimeStack && <em title="Claim time stacks with other matching roles"> +time</em>}
                </span>
              ))}
            </div>
          )}
          <form method="POST" class="gw-add-role">
            <input type="hidden" name="action" value="add_preset_role" />
            <input type="hidden" name="preset_id" value={p.id} />
            <select name="role_id" required>
              <option value="" disabled selected>Role</option>
              {roles.map((r) => <option value={r.id}>{r.name}</option>)}
            </select>
            <input type="number" name="entries" placeholder="Extra entries" min="1" max="100" required />
            <label class="gw-stack-check"><input type="checkbox" name="entries_stack" />Stack entries</label>
            <label class="gw-stack-check"><input type="checkbox" name="claim_time_stack" />Stack claim time</label>
            <button type="submit" class="btn btn-ghost btn-sm">Add</button>
          </form>
        </div>
      ))}
    </div>

    <form method="POST" class="gw-add-preset">
      <input type="hidden" name="action" value="add_preset" />
      <input type="text" name="name" placeholder="Preset name, e.g. Booster bonus" maxlength="40" required />
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />Add preset</button>
    </form>
  </div>

  <div class="gw-section">
    <h2><Icon name="ph:timer-fill" width="15" height="15" />Running now <span class="gw-count">{active.length}</span></h2>
    {active.length === 0 ? (
      <p class="gw-empty-note">Nothing running.</p>
    ) : (
      <div class="gw-active-list">
        {active.map((g) => (
          <div class="gw-active-row">
            <span class="gw-active-prize">{g.prize}</span>
            <span class="gw-active-meta">{g.winnersCount} winner{g.winnersCount !== 1 ? 's' : ''}</span>
            <span class="gw-active-meta">{g.entries} entries</span>
            <span class="gw-active-ends">ends {new Date(g.endsAt).toLocaleString()}</span>
          </div>
        ))}
      </div>
    )}
  </div>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  h2 { font-size: 14.5px; margin: 0 0 6px; display: flex; align-items: center; gap: 8px; }
  h2 :global(svg) { color: var(--accent); }
  .gw-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 24px; max-width: 68ch; }
  .gw-sub b { color: var(--text); }
  .gw-sub code { font-family: var(--mono); color: var(--accent); }

  .gw-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 20px; max-width: fit-content; }

  .gw-form { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; margin-bottom: 40px; max-width: 640px; width: 100%; border: 1px solid var(--border); border-radius: 14px; background: var(--bg-raise); padding: 18px 20px; }
  .gw-config-head { display: flex; align-items: center; gap: 10px; }
  .gw-config-icon { width: 30px; height: 30px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: var(--accent-soft); color: var(--accent); }
  .gw-config-title { font-size: 13.5px; font-weight: 600; color: var(--text); }
  .gw-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 24px; width: 100%; }
  .gw-field { display: flex; flex-direction: column; gap: 6px; }
  .gw-field-wide { grid-column: 1 / -1; }
  .gw-field label { font-size: 12px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.03em; }
  .gw-field input, .gw-field select { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; }

  .gw-section { margin-bottom: 40px; }
  .gw-section-note { font-size: 12.5px; color: var(--text-dim); margin: 0 0 14px; }
  .gw-count { font-family: var(--mono); font-size: 11px; color: var(--text-dim); font-weight: 400; }
  .gw-empty-note { font-size: 13px; color: var(--text-dim); }

  .gw-presets { display: flex; flex-direction: column; gap: 10px; margin-bottom: 12px; max-width: 480px; }
  .gw-preset { border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; background: var(--card); }
  .gw-preset-head { display: flex; align-items: center; justify-content: space-between; }
  .gw-preset-name { font-size: 13.5px; font-weight: 600; color: var(--text); }
  .gw-preset-del { border: none; background: transparent; color: var(--text-dim); cursor: pointer; padding: 4px; border-radius: 6px; }
  .gw-preset-del:hover { color: var(--red); background: var(--red-soft); }
  .gw-preset-roles { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .gw-preset-role { font-size: 11.5px; color: var(--accent); background: var(--accent-soft); padding: 3px 8px; border-radius: 6px; }
  .gw-preset-role em { font-style: normal; opacity: 0.75; }
  .gw-add-role { display: flex; gap: 6px; margin-top: 10px; align-items: center; flex-wrap: wrap; }
  .gw-add-role select, .gw-add-role input[type="number"] { border: 1px solid var(--border); border-radius: 7px; padding: 6px 8px; background: var(--bg-raise); color: var(--text); font-family: var(--sans); font-size: 12px; }
  .gw-add-role input[type="number"] { width: 90px; }
  .gw-stack-check { display: flex; align-items: center; gap: 5px; font-size: 11.5px; color: var(--text-dim); cursor: pointer; white-space: nowrap; }
  .gw-stack-check input { accent-color: var(--accent); }

  .gw-add-preset { display: flex; gap: 8px; }
  .gw-add-preset input { border: 1px solid var(--border); border-radius: 8px; padding: 8px 11px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13px; min-width: 240px; }
  .gw-add-preset .btn { display: inline-flex; align-items: center; gap: 6px; }

  .gw-active-list { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; max-width: 620px; }
  .gw-active-row { display: flex; align-items: center; gap: 14px; padding: 10px 14px; font-size: 13px; background: var(--card); flex-wrap: wrap; }
  .gw-active-row + .gw-active-row { border-top: 1px solid var(--border-soft); }
  .gw-active-prize { font-weight: 600; color: var(--text); }
  .gw-active-meta { color: var(--text-dim); font-size: 12px; }
  .gw-active-ends { margin-left: auto; color: var(--text-dim); font-size: 12px; }

  @media (max-width: 620px) {
    .gw-grid { grid-template-columns: 1fr; }
  }
</style>
