            <span class="gw-row-actions">
              {g.messageId && g.channelId && <a class="gw-link" href={`https://discord.com/channels/${guildId}/${g.channelId}/${g.messageId}`} target="_blank" rel="noopener"><Icon name="ph:arrow-square-out" width="13" height="13" />{dt('Open in Discord')}</a>}
              <label class="gw-text-btn" for={`gw-edit-${g.id}`}><Icon name="ph:pencil-simple-fill" width="13" height="13" />{dt('Edit')}</label>
              <form method="POST" data-no-dirty><input type="hidden" name="action" value="end_giveaway" /><input type="hidden" name="giveaway_id" value={g.id} /><button type="submit" class="gw-text-btn" data-confirm={dt('End this giveaway now and draw the winners?')}><Icon name="ph:stop-circle-fill" width="13" height="13" />{dt('End now')}</button></form>
            </span>
            <form method="POST" class="gw-edit-form" data-no-dirty>
              <input type="hidden" name="action" value="edit_giveaway" />
              <input type="hidden" name="giveaway_id" value={g.id} />
