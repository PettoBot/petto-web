---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import VariableHelp from './VariableHelp.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface Config {
  embedTemplate: string;
  entryMode: string;
  reaction: string;
  winnerMessage: string;
  noEntriesMessage: string;
  denyMessage: string;
  claimTimeMessage: string;
  claimTimeOverMessage: string;
  acceptMessage: string;
  winnerMessageEmbed: string;
  noEntriesMessageEmbed: string;
  denyMessageEmbed: string;
  claimTimeMessageEmbed: string;
  claimTimeOverMessageEmbed: string;
  acceptMessageEmbed: string;
}
interface Active { id: number; prize: string; winnersCount: number; endsAt: string; entries: number; hostId: string; channelId?: string; messageId?: string | null; }
interface Ended { id: number; prize: string; winnersCount: number; endsAt: string; channelId: string; messageId: string | null; }
interface PresetRole { roleId: string; entries: number; claimTimeMs: number; entriesStack: boolean; claimTimeStack: boolean; }
interface PresetLevel { source: string; level: number; entries: number; }
interface Preset { id: number; name: string; roles: PresetRole[]; minLevel?: number; minVoiceLevel?: number; levels?: PresetLevel[]; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  config: Config;
  active: Active[];
  ended?: Ended[];
  channels?: { id: string; name: string }[];
  giveawayError?: string | null;
  giveawayNote?: string | null;
  presets: Preset[];
  roles: { id: string; name: string }[];
  embedTemplateNames: string[];
  premiumActive: boolean;
  saved: boolean;
  section?: string;
}
const { user, guildId, guildName, guildIcon, config, active, ended = [], channels = [], giveawayError = null, giveawayNote = null, presets, roles, embedTemplateNames, premiumActive, saved, section } = Astro.props;

const sectionMeta: Record<string, string> = { settings: dt('Giveaway settings'), presets: dt('Bonus-entry presets'), active: dt('Running giveaways') };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'settings';
const selectedTitle = sectionMeta[selectedSection];

function roleName(id: string) {
  return roles.find((r) => r.id === id)?.name ?? id;
}
function formatDuration(ms: number) {
  if (!ms) return '';
  const units = [{ suffix: 'w', value: 604800000 }, { suffix: 'd', value: 86400000 }, { suffix: 'h', value: 3600000 }, { suffix: 'm', value: 60000 }, { suffix: 's', value: 1000 }];
  const unit = units.find((item) => ms >= item.value) ?? units[units.length - 1];
  return `${Math.round(ms / unit.value)}${unit.suffix}`;
}
const giveawayPresetLimit = premiumActive ? 15 : 3;
const giveawayPresetAtLimit = presets.length >= giveawayPresetLimit;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'settings' ? 'giveaways' : `giveaways-${selectedSection}`} pageTitle={selectedTitle}>
  <h1>{selectedTitle}</h1>
  <p class="gw-sub"><Fragment set:html={dth('Entry style, messages, and bonus-entry presets for giveaways in <b>{a}</b>. Start one with <code>/giveaway start</code>.', { a: (guildName) })} /></p>
  <div class="gw-discord-note"><Icon name="ph:info-fill" width="15" height="15" /><span>{dt('Start one here, in Running now, or in Discord with')} <code>{dt('/giveaway start')}</code>{dt('. This page also manages their settings, messages, designs, and presets.')}</span></div>

  {saved && <div class="gw-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}{giveawayNote ? ' ' : ''}{giveawayNote}</div>}
  {giveawayError && <div class="gw-error"><Icon name="ph:warning-fill" width="15" height="15" />{giveawayError}</div>}

  {selectedSection === 'settings' && (
  <form method="POST" class:list={['gw-form', { 'gw-section-hidden': selectedSection !== 'settings' }]}>
    <input type="hidden" name="action" value="config" />
    <div class="gw-config-head">
      <div class="gw-config-icon"><Icon name="ph:gift-fill" width="16" height="16" /></div>
      <div class="gw-config-title">{dt('Entry & messages')}</div>
    </div>
    <div class="gw-grid">
      <div class="gw-field">
        <label>{dt('Entry method')}</label>
        <select name="entry_mode">
          <option value="button" selected={config.entryMode === 'button'}>{dt('Button')}</option>
          <option value="reaction" selected={config.entryMode === 'reaction'}>{dt('Reaction')}</option>
        </select>
      </div>
      <div class="gw-field">
        <label>{dt('Reaction emoji')}</label>
        <input type="text" name="reaction" value={config.reaction} maxlength="4" />
      </div>
      <div class="gw-field gw-field-wide">
        <label>{dt('Default giveaway design')}</label>
        <select name="embed_template" data-dp-template-only>
          <option value="" selected={!config.embedTemplate}>{dt('Use Petto default')}</option>
          {embedTemplateNames.map((name) => <option value={name} selected={name === config.embedTemplate}>{name}</option>)}
        </select>
        <span class="gw-field-note">{dt('Saved designs come from the Embeds page. A per-giveaway choice can still override this default from Discord.')}</span>
      </div>
      <div class="gw-field gw-field-wide">
        <label>{dt('Winner message')}</label>
        <input type="text" name="winner_message" data-dp value={config.winnerMessage} maxlength="200" placeholder={dt('{user} won **{gw.prize}**!')} />
      </div>
      <div class="gw-field gw-field-wide">
        <select name="winner_embed_template" data-dp-template-only>
          <option value="" selected={!config.winnerMessageEmbed}>{dt('Send it as text')}</option>
          {embedTemplateNames.map((name) => <option value={name} selected={name === config.winnerMessageEmbed}>{name}</option>)}
        </select>
        <span class="gw-field-note">{dt('Or send a saved design instead of the text above.')}</span>
      </div>
      <div class="gw-field gw-field-wide">
        <label>{dt('No-entries message')}</label>
        <input type="text" name="no_entries_message" data-dp value={config.noEntriesMessage} maxlength="200" placeholder={dt('Nobody entered, no winner this time.')} />
      </div>
      <div class="gw-field gw-field-wide">
        <select name="no_entries_embed_template" data-dp-template-only>
          <option value="" selected={!config.noEntriesMessageEmbed}>{dt('Send it as text')}</option>
          {embedTemplateNames.map((name) => <option value={name} selected={name === config.noEntriesMessageEmbed}>{name}</option>)}
        </select>
        <span class="gw-field-note">{dt('Or send a saved design instead of the text above.')}</span>
      </div>
      <div class="gw-field gw-field-wide">
        <label>{dt('Winner denied prize message')}</label>
        <input type="text" name="deny_message" data-dp value={config.denyMessage} maxlength="200" placeholder={dt('{user} gave up their prize, re-rolling...')} />
      </div>
      <div class="gw-field gw-field-wide">
        <select name="deny_embed_template" data-dp-template-only>
          <option value="" selected={!config.denyMessageEmbed}>{dt('Send it as text')}</option>
          {embedTemplateNames.map((name) => <option value={name} selected={name === config.denyMessageEmbed}>{name}</option>)}
        </select>
        <span class="gw-field-note">{dt('Or send a saved design instead of the text above.')}</span>
      </div>
      <div class="gw-field gw-field-wide">
        <label>{dt('Claim prompt (when a giveaway needs winners to confirm)')}</label>
        <input type="text" name="claim_time_message" data-dp value={config.claimTimeMessage} maxlength="200" placeholder={dt('{user}, click to claim **{gw.prize}** within {gw.claim_time}!')} />
      </div>
      <div class="gw-field gw-field-wide">
        <select name="claim_time_embed_template" data-dp-template-only>
          <option value="" selected={!config.claimTimeMessageEmbed}>{dt('Send it as text')}</option>
          {embedTemplateNames.map((name) => <option value={name} selected={name === config.claimTimeMessageEmbed}>{name}</option>)}
        </select>
        <span class="gw-field-note">{dt('Or send a saved design instead of the text above.')}</span>
      </div>
      <div class="gw-field gw-field-wide">
        <label>{dt('Claim expired message')}</label>
        <input type="text" name="claim_time_over_message" data-dp value={config.claimTimeOverMessage} maxlength="200" placeholder={dt('{user} didn\'t claim in time, re-rolling...')} />
      </div>
      <div class="gw-field gw-field-wide">
        <select name="claim_time_over_embed_template" data-dp-template-only>
          <option value="" selected={!config.claimTimeOverMessageEmbed}>{dt('Send it as text')}</option>
          {embedTemplateNames.map((name) => <option value={name} selected={name === config.claimTimeOverMessageEmbed}>{name}</option>)}
        </select>
        <span class="gw-field-note">{dt('Or send a saved design instead of the text above.')}</span>
      </div>
      <div class="gw-field gw-field-wide">
        <label>{dt('Claim accepted message')}</label>
        <input type="text" name="accept_message" data-dp value={config.acceptMessage} maxlength="200" placeholder={dt('{user} claimed **{gw.prize}**!')} />
      </div>
      <div class="gw-field gw-field-wide">
        <select name="accept_embed_template" data-dp-template-only>
          <option value="" selected={!config.acceptMessageEmbed}>{dt('Send it as text')}</option>
          {embedTemplateNames.map((name) => <option value={name} selected={name === config.acceptMessageEmbed}>{name}</option>)}
        </select>
        <span class="gw-field-note">{dt('Or send a saved design instead of the text above.')}</span>
      </div>
      <div class="gw-field-wide">
        <VariableHelp />
      </div>
    </div>
    <button type="submit" class="btn btn-accent btn-sm">{dt('Save changes')}</button>
  </form>
  )}

  {selectedSection === 'presets' && (
  <div class:list={['gw-section', { 'gw-section-hidden': selectedSection !== 'presets' }]}>
    <h2><Icon name="ph:star-fill" width="15" height="15" /><Fragment set:html={dth('Bonus-entry presets <span class="gw-count">{a}/{b}</span>', { a: (presets.length), b: (giveawayPresetLimit) })} />{!premiumActive && <span class="gw-premium-tag">Premium: 15</span>}</h2>
    <p class="gw-section-note">{dt('Give certain roles extra entries automatically, and ask for a level or give extra entries by level, when a giveaway uses a preset.')}</p>

    <div class="gw-presets">
      {presets.map((p) => (
        <div class="gw-preset">
          <div class="gw-preset-head">
            <span class="gw-preset-name">{p.name}</span>
            <form method="POST"><input type="hidden" name="action" value="delete_preset" /><input type="hidden" name="preset_id" value={p.id} />
              <button type="submit" class="gw-preset-del" title={dt('Delete preset')}><Icon name="ph:trash-fill" width="13" height="13" /></button>
            </form>
          </div>
          {p.roles.length > 0 && (
            <div class="gw-preset-roles">
              {p.roles.map((r) => (
                <span class="gw-preset-role">
                  {roleName(r.roleId)} +{r.entries}
                  {r.claimTimeMs > 0 && <em title={dt('Extra claim time for winners with this role')}> +{formatDuration(r.claimTimeMs)} claim</em>}
                  {r.entriesStack && <em title={dt('Entries stack with other matching roles')}> stacks</em>}
                  {r.claimTimeStack && <em title={dt('Claim time stacks with other matching roles')}> +time</em>}
                </span>
              ))}
            </div>
          )}
          <div class="gw-preset-levels">
            <div class="gw-preset-sub">{dt('Levels')}</div>
            <form method="POST" class="gw-add-role">
              <input type="hidden" name="action" value="set_preset_levels" />
              <input type="hidden" name="preset_id" value={p.id} />
              <label class="gw-stack-check">{dt('Message level needed')} <input type="number" name="min_level" value={p.minLevel ?? 0} min="0" max="10000" /></label>
              <label class="gw-stack-check">{dt('Voice level needed')} <input type="number" name="min_voice_level" value={p.minVoiceLevel ?? 0} min="0" max="10000" /></label>
              <button type="submit" class="btn btn-ghost btn-sm">{dt('Save')}</button>
            </form>
            {(p.levels ?? []).length > 0 && (
              <div class="gw-preset-roles">
                {(p.levels ?? []).map((step) => (
                  <form method="POST" class="gw-preset-role">
                    <input type="hidden" name="action" value="delete_preset_level" />
                    <input type="hidden" name="preset_id" value={p.id} />
                    <input type="hidden" name="source" value={step.source} />
                    <input type="hidden" name="level" value={step.level} />
                    {step.source === 'voice' ? dt('Voice level') : dt('Level')} {step.level}+ <em>+{step.entries}</em>
                    <button type="submit" class="gw-preset-del" title={dt('Remove')}>×</button>
                  </form>
                ))}
              </div>
            )}
            <form method="POST" class="gw-add-role">
              <input type="hidden" name="action" value="add_preset_level" />
              <input type="hidden" name="preset_id" value={p.id} />
              <select name="source"><option value="text">{dt('Message level')}</option><option value="voice">{dt('Voice level')}</option></select>
              <input type="number" name="level" placeholder={dt('From level')} min="1" max="10000" required />
              <input type="number" name="entries" placeholder={dt('Extra entries')} min="1" max="1000" required />
              <button type="submit" class="btn btn-ghost btn-sm">{dt('Add')}</button>
            </form>
          </div>
          <form method="POST" class="gw-add-role">
            <input type="hidden" name="action" value="add_preset_role" />
            <input type="hidden" name="preset_id" value={p.id} />
            <select name="role_id" required>
              <option value="" disabled selected>{dt('Role')}</option>
              {roles.map((r) => <option value={r.id}>{r.name}</option>)}
            </select>
            <input type="number" name="entries" placeholder={dt('Extra entries')} min="1" max="100" required />
            <input type="text" name="claim_time" placeholder={dt('Claim time, e.g. 5m')} maxlength="12" />
            <label class="gw-stack-check"><input type="checkbox" name="entries_stack" />{dt('Stack entries')}</label>
            <label class="gw-stack-check"><input type="checkbox" name="claim_time_stack" />{dt('Stack claim time')}</label>
            <button type="submit" class="btn btn-ghost btn-sm">{dt('Add')}</button>
          </form>
        </div>
      ))}
    </div>

    {giveawayPresetAtLimit ? (
      <div class="gw-limit-card">
        <div><strong>{premiumActive ? dt('Preset limit reached') : dt('Free preset limit reached')}</strong><span>{premiumActive ? dt('You are using all {n} available giveaway presets.',{n:giveawayPresetLimit}) : dt('Free includes 3 presets. Premium increases this to 15.')}</span></div>
        {!premiumActive && <a class="btn btn-ghost btn-sm" href={`/dash/premium?guild_id=${guildId}`}>{dt('Unlock Premium')}</a>}
      </div>
    ) : (
      <form method="POST" class="gw-add-preset">
        <input type="hidden" name="action" value="add_preset" />
        <input type="text" name="name" placeholder={dt('Preset name, e.g. Booster bonus')} maxlength="40" required />
        <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add preset')}</button>
      </form>
    )}
  </div>
  )}

  {selectedSection === 'active' && (
  <div class:list={['gw-section', { 'gw-section-hidden': selectedSection !== 'active' }]}>
    <h2><Icon name="ph:rocket-launch-fill" width="15" height="15" />{dt('Start a giveaway')}</h2>
    <form method="POST" class="gw-start">
      <input type="hidden" name="action" value="start_giveaway" />
      <div class="gw-start-grid">
        <div class="gw-field gw-field-wide"><label>{dt('Prize')}</label><input type="text" name="prize" maxlength="256" placeholder={dt('Discord Nitro')} required /></div>
        <div class="gw-field"><label>{dt('Winners')}</label><input type="number" name="winners" min="1" max="50" value="1" required /></div>
        <div class="gw-field"><label>{dt('Duration')}</label><input type="text" name="duration" maxlength="30" placeholder="1h, 3d 4h" required /></div>
        <div class="gw-field gw-field-wide"><label>{dt('Channel')}</label>
          <select name="channel_id" required><option value="" disabled selected>{dt('Choose a channel')}</option>{channels.map((ch) => <option value={ch.id}>#{ch.name}</option>)}</select>
        </div>
        <div class="gw-field"><label>{dt('Claim time')} <span class="gw-muted">{dt('optional')}</span></label><input type="text" name="claim_time" maxlength="12" placeholder="5m" /></div>
        <div class="gw-field"><label>{dt('Entry method')}</label>
          <select name="entry_mode"><option value="">{dt('Server default')}</option><option value="button">{dt('Button')}</option><option value="reaction">{dt('Reaction')}</option></select>
        </div>
        <div class="gw-field"><label>{dt('Bonus-entry preset')}</label>
          <select name="preset"><option value="">{dt('None')}</option>{presets.map((preset) => <option value={preset.name}>{preset.name}</option>)}</select>
        </div>
        <div class="gw-field"><label>{dt('Design')}</label>
          <select name="embed_template"><option value="">{dt('Server default')}</option>{embedTemplateNames.map((name) => <option value={name}>{name}</option>)}</select>
        </div>
      </div>
      <button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:rocket-launch-fill" width="13" height="13" />{dt('Start giveaway')}</button>
    </form>

    <h2 class="gw-h2-gap"><Icon name="ph:timer-fill" width="15" height="15" /><Fragment set:html={dth('Running now <span class="gw-count">{a}</span>', { a: (active.length) })} /></h2>
    {active.length === 0 ? (
      <p class="gw-empty-note">{dt('Nothing running.')}</p>
    ) : (
      <div class="gw-active-list" data-live-url={`/dash/guild/${guildId}/live?kind=giveaways`}>
        {active.map((g) => (
          <div class="gw-active-row" data-giveaway-id={g.id}>
            <span class="gw-active-prize">{g.prize}</span>
            <span class="gw-active-meta">{g.winnersCount} winner{g.winnersCount !== 1 ? 's' : ''}</span>
            <span class="gw-active-meta"><b data-gw-entries>{g.entries}</b> entries</span>
            <span class="gw-active-ends">{dt('ends {d}', { d: new Date(g.endsAt).toLocaleString(dashLang) })}</span>
            <input type="checkbox" class="gw-edit-check" id={`gw-edit-${g.id}`} hidden />
            <span class="gw-row-actions">
              {g.messageId && g.channelId && <a class="gw-link" href={`https://discord.com/channels/${guildId}/${g.channelId}/${g.messageId}`} target="_blank" rel="noopener"><Icon name="ph:arrow-square-out" width="13" height="13" />{dt('Open in Discord')}</a>}
              <label class="gw-text-btn" for={`gw-edit-${g.id}`}><Icon name="ph:pencil-simple-fill" width="13" height="13" />{dt('Edit')}</label>
              <form method="POST"><input type="hidden" name="action" value="end_giveaway" /><input type="hidden" name="giveaway_id" value={g.id} /><button type="submit" class="gw-text-btn" data-confirm={dt('End this giveaway now and draw the winners?')}><Icon name="ph:stop-circle-fill" width="13" height="13" />{dt('End now')}</button></form>
            </span>
            <form method="POST" class="gw-edit-form">
              <input type="hidden" name="action" value="edit_giveaway" />
              <input type="hidden" name="giveaway_id" value={g.id} />
              <label>{dt('Prize')}<input type="text" name="prize" value={g.prize} maxlength="256" autocomplete="off" /></label>
              <label>{dt('Winners')}<input type="number" name="winners" value={g.winnersCount} min="1" max="50" /></label>
              <label>{dt('New end, counted from now')}<input type="text" name="duration" placeholder={dt('e.g. 2h or 1d 6h (empty keeps it)')} maxlength="30" autocomplete="off" /></label>
              <button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:check-bold" width="13" height="13" />{dt('Save changes')}</button>
            </form>
          </div>
        ))}
      </div>
    )}

    <h2 class="gw-h2-gap"><Icon name="ph:trophy-fill" width="15" height="15" /><Fragment set:html={dth('Ended <span class="gw-count">{a}</span>', { a: (ended.length) })} /></h2>
    {ended.length === 0 ? (
      <p class="gw-empty-note">{dt('No giveaway has ended yet.')}</p>
    ) : (
      <div class="gw-active-list">
        {ended.map((g) => (
          <div class="gw-active-row">
            <span class="gw-active-prize">{g.prize}</span>
            <span class="gw-active-meta">{g.winnersCount} winner{g.winnersCount !== 1 ? 's' : ''}</span>
            <span class="gw-active-ends">{dt('ended {d}', { d: new Date(g.endsAt).toLocaleString(dashLang) })}</span>
            <span class="gw-row-actions">
              {g.messageId && <a class="gw-link" href={`https://discord.com/channels/${guildId}/${g.channelId}/${g.messageId}`} target="_blank" rel="noopener"><Icon name="ph:arrow-square-out" width="13" height="13" />{dt('Open in Discord')}</a>}
              <form method="POST" class="gw-reroll"><input type="hidden" name="action" value="reroll_giveaway" /><input type="hidden" name="giveaway_id" value={g.id} /><input type="number" name="winners" min="1" max="50" placeholder={dt('How many')} aria-label={dt('How many')} /><button type="submit" class="gw-text-btn" data-confirm={dt('Draw new winners for this giveaway?')}><Icon name="ph:arrows-clockwise-fill" width="13" height="13" />{dt('Draw again')}</button></form>
            </span>
          </div>
        ))}
      </div>
    )}
  </div>
  )}
</DashGuildLayout>

<script is:inline>
  // The entries of the running giveaways follow the entries as they come in, every 5 seconds while the page is in view.
  (function () {
    if (window.__gwLive) return;
    window.__gwLive = true;
    var timer = null;
    function tick() {
      var list = document.querySelector('.gw-active-list[data-live-url]');
      if (!list || document.hidden) { timer = setTimeout(tick, 5000); return; }
      fetch(list.getAttribute('data-live-url'), { cache: 'no-store', headers: { Accept: 'application/json' } })
        .then(function (res) { return res.ok ? res.json() : null; })
        .then(function (data) {
          if (!data || !Array.isArray(data.giveaways)) return;
          var running = {};
          data.giveaways.forEach(function (entry) { running[entry.id] = entry.entries; });
          list.querySelectorAll('.gw-active-row[data-giveaway-id]').forEach(function (row) {
            var id = row.getAttribute('data-giveaway-id');
            var counter = row.querySelector('[data-gw-entries]');
            if (id in running) { if (counter) counter.textContent = String(running[id]); }
            else row.classList.add('gw-row-ended');
          });
        })
        .catch(function () {})
        .then(function () { timer = setTimeout(tick, 5000); });
    }
    document.addEventListener('visibilitychange', function () { if (!document.hidden) { clearTimeout(timer); timer = setTimeout(tick, 300); } });
    timer = setTimeout(tick, 5000);
  })();
</script>

<style>
  .gw-error { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--red); background: var(--red-soft); border: 1px solid color-mix(in srgb, var(--red) 55%, transparent); border-radius: 9px; padding: 10px 14px; margin-bottom: 20px; max-width: fit-content; }
  .gw-start { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; max-width: 640px; border: 1px solid var(--border); border-radius: 14px; background: var(--bg-raise); padding: 16px 18px; margin: 10px 0 30px; }
