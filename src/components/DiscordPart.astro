---
// One block of a Components V2 message (text, section, gallery, separator or a row of buttons), as Discord draws it. It is used inside a card
// and also alone at the top of a message, because a message can have text and buttons that are not in a card.
import { markdown, emojiUrl, type MarkdownContext } from '../utils/discordMarkdown';

interface Part {
  type: number;
  content?: string;
  components?: Part[];
  accessory?: Part;
  media?: { url: string };
  items?: { media: { url: string }; description?: string }[];
  divider?: boolean;
  spacing?: number;
  label?: string;
  style?: number;
  disabled?: boolean;
  emoji?: { id?: string; name?: string; animated?: boolean };
  placeholder?: string;
}
interface Props { part: Part; context: MarkdownContext }
const { part, context } = Astro.props;
const text = (value?: string) => markdown(value ?? '', context);
const styleName = (style?: number) => ({ 1: 'primary', 2: 'secondary', 3: 'success', 4: 'danger', 5: 'link' }[style ?? 2] ?? 'secondary');
---
{part.type === 10 && <div class="dshot-t" set:html={text(part.content)} />}
{part.type === 9 && (
  <div class="dshot-section">
    <div class="dshot-section-text">{(part.components ?? []).map((inner) => <div class="dshot-t" set:html={text(inner.content)} />)}</div>
    {part.accessory?.type === 11 && <img class="dshot-thumb" src={part.accessory.media?.url} alt="" loading="lazy" />}
    {part.accessory?.type === 2 && <span class={`dshot-btn ${styleName(part.accessory.style)}`}>{part.accessory.label}</span>}
  </div>
)}
{part.type === 12 && <div class={`dshot-gallery n${Math.min((part.items ?? []).length, 4)}`}>{(part.items ?? []).map((item) => <img src={item.media.url} alt={item.description ?? ''} loading="lazy" />)}</div>}
{part.type === 14 && <div class={`dshot-sep${part.divider === false ? ' none' : ''}${part.spacing === 2 ? ' large' : ''}`}></div>}
{part.type === 1 && (
  <div class="dshot-row">
    {(part.components ?? []).map((button) => button.type === 3 ? (
      <span class="dshot-select"><span>{button.placeholder}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10l5 5 5-5z" fill="currentColor" /></svg></span>
    ) : (
      <span class={`dshot-btn ${styleName(button.style)}${button.disabled ? ' off' : ''}`}>
        {button.emoji?.id ? <img class="ds-emoji" src={emojiUrl(button.emoji.id, button.emoji.animated)} alt="" /> : button.emoji?.name && <span class="dshot-btn-emoji">{button.emoji.name}</span>}
        {button.label}
        {button.style === 5 && <svg class="dshot-ext" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7h-2V6.4l-8.3 8.3-1.4-1.4L17.6 5H14V3zM5 5h6v2H5v12h12v-6h2v8H3V5h2z" fill="currentColor" /></svg>}
      </span>
    ))}
  </div>
)}
