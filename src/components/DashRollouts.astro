---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import SxNumber from './SxNumber.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  config: { enabled: boolean; channelId: string; roleId: string; style: string; embedTemplate: string; kinds: string[]; events: string[]; minChange: number; includeUnrolled: boolean; hideSections: string[]; accentColor: string; typeTemplates: Record<string, string> };
  channels: { id: string; name: string }[];
  roles: { id: string; name: string }[];
  embedTemplates: { name: string; v2: boolean }[];
  ready: boolean;
  saved: boolean;
}
const { user, guildId, guildName, guildIcon, config, channels, roles, embedTemplates, ready, saved } = Astro.props;
const kinds = [['user', 'Users experiments'], ['guild', 'Servers experiments'], ['apex_user', 'Users experiments (A/B)'], ['installation', 'Installations experiments']];
const events = [['new', 'A new experiment'], ['increase', 'The rollout grows'], ['decrease', 'The rollout shrinks'], ['status', 'The status changes']];
const sections = [['variants', 'Variants and their change'], ['ranges', 'Ranges'], ['status', 'Status'], ['platforms', 'Platforms'], ['filters', 'Filters']];
const EMOJIS: Record<string, string> = { rexperiment: '1558964304277938266', rup: '1558964315627720786', rstatus: '1558964324414783568', rplataform: '1558964325450911746', reload: '1533575051947802764', rranges: '1558964320770072627', rfilters: '1558964328617611324' };
const e = (name: string) => `<img class="ro-emoji" src="https://cdn.discordapp.com/emojis/${EMOJIS[name]}.png?size=32" alt="" />`;
const sample = { name: 'Android media viewer full resolution', id: '2026-10-android-media-viewer-full-resolution', variants: ['Variant 0 (control): 50%', 'Variant 1: 37.5% → 50% (+12.5%)'], ranges: 'Variant 1: (5000 - 10000)' };

// What is set now, for the numbers on top: all of it comes from the saved settings (an empty choice means every kind and every event).
const kindsFollowed = config.kinds.length || kinds.length;
const eventsFollowed = config.events.length || events.length;
const ownDesigns = kinds.filter(([value]) => config.typeTemplates[value]).length;
const useTemplate = config.style === 'template';
const stateText = { on: dt('On'), off: dt('Off') };
const channelName = channels.find((ch) => ch.id === config.channelId)?.name;
const roleName = roles.find((r) => r.id === config.roleId)?.name;
const pickedNames = (list: string[][], picked: string[]) => list.filter(([value]) => picked.includes(value)).map(([, label]) => dt(label)).join(', ');
const summary: [string, string][] = [
  [dt('Alerts'), config.enabled ? stateText.on : stateText.off],
  [dt('Channel'), channelName ? `#${channelName}` : dt('None')],
  [dt('Role to ping'), roleName ?? dt('None')],
  [dt('Experiments'), config.kinds.length ? pickedNames(kinds, config.kinds) : dt('Every kind')],
  [dt('Events'), config.events.length ? pickedNames(events, config.events) : dt('Every event')],
  [dt('Message style'), useTemplate ? `${dt('A saved embed')}${config.embedTemplate ? `: ${config.embedTemplate}` : ''}` : dt('Petto card')],
];
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="rollouts" pageTitle="Rollout alerts">
  <DashSettingsKit />
  <div class="sx-page ro-page">
    <div class="sx-title">
      <h1>{dt('Rollout alerts')}</h1>
      <span class:list={['sx-pill-state', { on: config.enabled }]} data-ro-state data-on={stateText.on} data-off={stateText.off}>{config.enabled ? stateText.on : stateText.off}</span>
    </div>
    <p class="ro-lead">{dt('Petto posts a message when Discord starts an experiment or changes how many people get it.')}</p>

    {saved && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
    {!ready && <div class="sx-flash sx-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}

    <DashStatTiles tiles={[
      { label: dt('Kinds followed'), value: kindsFollowed, tone: 'voice' },
      { label: dt('Events followed'), value: eventsFollowed, tone: 'invites' },
      { label: dt('Smallest change'), value: 0, text: dt('{n} pts', { n: config.minChange.toLocaleString(dashLang) }), tone: 'reactions' },
      { label: dt('Own designs'), value: ownDesigns, tone: 'messages' },
    ]} />

    <div class="ro-grid">
      <form method="POST" class="sx-stack ro-form">
        <section class="sx-panel">
          <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:bell-ringing-fill" width="17" height="17" /></span><h2>{dt('Where it goes')}</h2></div>
          <label class="sx-switch sx-master"><input type="checkbox" name="enabled" checked={config.enabled} data-ro-enabled /><span class="sx-switch-text"><b>{dt('Send alerts')}</b><em>{dt('While this is off, nothing is posted.')}</em></span><i class="sx-toggle"></i></label>
          <div class="sx-grid">
            <div class="sx-field"><label for="ro-channel">{dt('Channel')}</label>
              <select id="ro-channel" name="channel_id"><option value="">{dt('None')}</option>{channels.map((ch) => <option value={ch.id} selected={ch.id === config.channelId}>#{ch.name}</option>)}</select>
            </div>
            <div class="sx-field"><label for="ro-role">{dt('Role to ping')}</label>
              <select id="ro-role" name="role_id"><option value="">{dt('None')}</option>{roles.map((r) => <option value={r.id} selected={r.id === config.roleId}>{r.name}</option>)}</select>
            </div>
          </div>
        </section>

        <section class="sx-panel">
          <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--blue)"><Icon name="ph:funnel-fill" width="17" height="17" /></span><h2>{dt('What to announce')}</h2></div>
          <p class="sx-lead">{dt('Pick only what you care about. Leaving a group empty means all of it.')}</p>
          <div class="sx-field">
            <span class="sx-label">{dt('Only these experiments')}</span>
            <div class="sx-chips">{kinds.map(([value, label]) => <label class="sx-chip"><input type="checkbox" name="kinds" value={value} checked={config.kinds.includes(value)} /><span>{dt(label)}</span></label>)}</div>
            <span class="sx-hint">{dt('Leave all empty for every kind.')}</span>
          </div>
          <div class="sx-field">
            <span class="sx-label">{dt('Only these events')}</span>
            <div class="sx-chips">{events.map(([value, label]) => <label class="sx-chip"><input type="checkbox" name="events" value={value} checked={config.events.includes(value)} /><span>{dt(label)}</span></label>)}</div>
            <span class="sx-hint">{dt('Leave all empty for every event.')}</span>
          </div>
          <div class="sx-sub">
            <div class="sx-field"><label for="ro-min">{dt('Ignore changes smaller than (percentage points)')}</label><SxNumber id="ro-min" name="min_change" min="0" max="100" step="0.5" value={config.minChange} /></div>
            <div class="sx-switches ro-one"><label class="sx-switch"><input type="checkbox" name="include_unrolled" checked={config.includeUnrolled} /><span class="sx-switch-text"><b>{dt('Also announce new experiments that have no rollout yet')}</b></span><i class="sx-toggle"></i></label></div>
          </div>
        </section>

        <section class="sx-panel">
          <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--red)"><Icon name="ph:paint-brush-fill" width="17" height="17" /></span><h2>{dt('How the message looks')}</h2></div>
          <div class="sx-chips" role="radiogroup" aria-label={dt('Message style')}>
            <label class="sx-chip"><input type="radio" name="style" value="card" checked={!useTemplate} /><span>{dt('Petto card')}</span></label>
            <label class="sx-chip"><input type="radio" name="style" value="template" checked={useTemplate} /><span>{dt('A saved embed')}</span></label>
          </div>

          <div class="sx-sub" id="ro-template-field" data-sx-needs="style=template">
            <div class="sx-field"><label for="ro-embed">{dt('Saved embed')}</label>
              <select id="ro-embed" name="embed_template"><option value="">{dt('None')}</option>{embedTemplates.map((tpl) => <option value={tpl.name} selected={tpl.name === config.embedTemplate}>{tpl.name}{tpl.v2 ? ' (V2)' : ''}</option>)}</select>
              <span class="sx-hint">{dt('It can use the rollout variables, such as {rollout.name}, {rollout.change} and {rollout.variants}. If it is missing, the card is sent.')}</span>
            </div>
            <div class="ro-actions">
              {config.embedTemplate && <a class="btn btn-ghost btn-sm" href={`/dash/guild/${guildId}/embeds?name=${encodeURIComponent(config.embedTemplate)}`}><Icon name="ph:pencil-simple-bold" width="13" height="13" />{dt('Edit this design')}</a>}
              <button type="submit" form="ro-design-form" class="btn btn-ghost btn-sm" disabled={!ready}><Icon name="ph:magic-wand-fill" width="13" height="13" />{dt('Make a V2 design from the Petto card')}</button>
            </div>
          </div>

          <div class="sx-sub" id="ro-card-options" data-sx-needs="style=card">
            <div class="sx-field">
              <span class="sx-label">{dt('What the card hides')}</span>
              <div class="sx-chips">{sections.map(([value, label]) => <label class="sx-chip"><input type="checkbox" name={`hide_${value}`} data-hide={value} checked={config.hideSections.includes(value)} /><span>{dt(label)}</span></label>)}</div>
            </div>
            <div class="sx-field ro-color"><label for="ro-color">{dt('Card color')}</label>
              <div class="ro-color-row"><i class="ro-swatch" data-ro-swatch style={config.accentColor ? `--sw:${config.accentColor}` : ''}></i><input type="text" name="accent_color" id="ro-color" value={config.accentColor} placeholder="#ff91c2" maxlength="7" autocomplete="off" /></div>
              <span class="sx-hint">{dt('Empty sends the card with no color.')}</span>
            </div>
          </div>
        </section>

        <section class="sx-panel">
          <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:palette-fill" width="17" height="17" /></span><h2>{dt('A different design for each kind')}</h2></div>
          <p class="sx-lead">{dt('Choose a saved embed (normal or V2) for the kinds of experiment you want to look different. An experiment uses the one of its kind; if there is none, the general design above.')}</p>
          <div class="sx-grid">
            {kinds.map(([value, label]) => (
              <div class="sx-field">
                <label for={`ro-type-${value}`}>{dt(label)}</label>
                <select id={`ro-type-${value}`} name={`type_template_${value}`}><option value="">{dt('The general design')}</option>{embedTemplates.map((tpl) => <option value={tpl.name} selected={tpl.name === config.typeTemplates[value]}>{tpl.name}{tpl.v2 ? ' (V2)' : ''}</option>)}</select>
              </div>
            ))}
          </div>
        </section>

        <div class="sx-foot">
          <button type="submit" class="btn btn-accent btn-sm" disabled={!ready}>{dt('Save changes')}</button>
          <p class="sx-hint ro-batch"><Icon name="ph:stack-fill" width="14" height="14" />{dt('When many changes arrive at once, Petto sends them in order, a message every few seconds, grouped in cards of up to 10 changes, so a big day never floods the channel.')}</p>
        </div>
      </form>

      <aside class="ro-side">
        <section class="sx-panel">
          <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:list-checks-fill" width="17" height="17" /></span><h2>{dt('Saved now')}</h2></div>
          <dl class="ro-sum">
            {summary.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
          </dl>
        </section>
        <section class="sx-panel ro-preview" aria-label={dt('Preview')}>
          <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--green)"><Icon name="ph:eye-fill" width="17" height="17" /></span><h2>{dt('Preview')}</h2></div>
          <div class="ro-msg" id="ro-card" style={config.accentColor ? `--ro-accent:${config.accentColor}` : ''} hidden={useTemplate}>
            <div class="ro-head">
              <div class="ro-title"><Fragment set:html={e('rexperiment')} /> <b>{sample.name}</b></div>
              <span class="ro-chip">+12.5% (50%)</span>
            </div>
            <hr />
            <div class="ro-lines">
              <div><Fragment set:html={e('rexperiment')} /> <b>{dt('Kind')}:</b> {dt('Users experiment (A/B)')}</div>
              <div data-part="status"><Fragment set:html={e('rstatus')} /> <b>{dt('Status')}:</b> {dt('A/B test')}</div>
              <div data-part="platforms"><Fragment set:html={e('rplataform')} /> <b>{dt('Platforms')}:</b> android, desktop</div>
              <div><a class="ro-id"><code>{sample.id}</code></a></div>
            </div>
            <div data-part="variants"><hr /><div class="ro-h2"><Fragment set:html={e('reload')} /> <b>{dt('Rollouts')}</b></div><pre class="ro-code">{sample.variants.join('\n')}</pre></div>
            <div data-part="ranges"><div class="ro-h2"><Fragment set:html={e('rranges')} /> {dt('Ranges')}</div><pre class="ro-code">{sample.ranges}</pre></div>
            <div data-part="filters"><hr /><div class="ro-h2"><Fragment set:html={e('rfilters')} /> {dt('Filters')}</div><div class="ro-lines"><div>• {dt('Servers of 3 to 50 members')}</div></div></div>
          </div>
          <div class="ro-design" id="ro-design" hidden={!useTemplate}>
            <Icon name="ph:paint-brush-fill" width="22" height="22" />
            <p>{dt('The alert is your saved embed:')} <b data-ro-design-name>{config.embedTemplate || dt('None')}</b></p>
            <span class="sx-hint">{dt('If it is missing, the Petto card is sent.')}</span>
          </div>
          <p class="sx-hint">{dt('A rough preview. Discord draws the real message.')}</p>
        </section>
      </aside>
    </div>
    <form method="POST" id="ro-design-form" data-no-dirty><input type="hidden" name="action" value="create_design" /></form>
  </div>

  <script is:inline>
    (function () {
      // The preview follows the form: the parts the card hides, its color, and which of the two looks is on. It reads the page each time, so it
      // also works when the page is opened from the side menu.
      function update() {
        var card = document.getElementById('ro-card'); if (!card) return;
        document.querySelectorAll('[data-hide]').forEach(function (box) {
          card.querySelectorAll('[data-part="' + box.dataset.hide + '"]').forEach(function (el) { el.hidden = box.checked; });
        });
        var color = document.getElementById('ro-color'); var swatch = document.querySelector('[data-ro-swatch]');
        var valid = color && /^#?[0-9a-f]{6}$/i.test(color.value.trim()); var hex = valid ? '#' + color.value.trim().replace('#', '') : '';
        if (hex) { card.style.setProperty('--ro-accent', hex); if (swatch) swatch.style.setProperty('--sw', hex); }
        else { card.style.removeProperty('--ro-accent'); if (swatch) swatch.style.removeProperty('--sw'); }
        var style = document.querySelector('input[name="style"]:checked'); var template = style && style.value === 'template';
        card.hidden = Boolean(template);
        var design = document.getElementById('ro-design'); if (design) design.hidden = !template;
        var pick = document.getElementById('ro-embed'); var name = document.querySelector('[data-ro-design-name]');
        if (pick && name && pick.value) name.textContent = pick.value;
        var on = document.querySelector('[data-ro-enabled]'); var pill = document.querySelector('[data-ro-state]');
        if (on && pill) { pill.classList.toggle('on', on.checked); pill.textContent = on.checked ? pill.getAttribute('data-on') : pill.getAttribute('data-off'); }
      }
      if (!window.__roWatch) { window.__roWatch = true; document.addEventListener('input', update); document.addEventListener('change', update); }
      update();
    })();
  </script>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0; }
  .sx-title { margin-bottom: 6px; }
  .ro-lead { margin: 0 0 16px; font-size: 13.5px; line-height: 1.5; color: var(--text-muted); max-width: 70ch; }
  .ro-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(min(260px, 100%), 330px); gap: 14px; align-items: start; }
  .ro-side { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .ro-preview { position: sticky; top: 12px; }
  .ro-sum { display: flex; flex-direction: column; margin: 0; }
  .ro-sum > div { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; padding: 8px 0; border-top: 1px solid var(--border-soft); font-size: 13px; }
  .ro-sum > div:first-child { border-top: 0; padding-top: 0; }
  .ro-sum dt { flex: none; color: var(--text-dim); }
  .ro-sum dd { margin: 0; text-align: right; font-weight: 600; min-width: 0; overflow-wrap: anywhere; }
  .ro-one { grid-template-columns: 1fr; }
  .ro-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .ro-actions .btn { display: inline-flex; align-items: center; gap: 6px; }
  .ro-batch { display: flex; align-items: flex-start; gap: 8px; margin: 0; max-width: 70ch; }
  .ro-batch :global(svg) { flex: none; margin-top: 1px; color: var(--accent); }
  .ro-color-row { display: flex; align-items: center; gap: 10px; }
  .ro-color-row input { flex: 1; min-width: 0; border: 1px solid var(--border); border-radius: 9px; padding: 9px 11px; background: var(--card); color: var(--text); font-family: var(--mono); font-size: 13.5px; box-sizing: border-box; }
  .ro-color-row input:focus-visible { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .ro-swatch { flex: none; width: 32px; height: 32px; border-radius: 10px; border: 1px solid var(--border); background: var(--sw, repeating-conic-gradient(color-mix(in srgb, var(--text) 14%, transparent) 0 25%, transparent 0 50%) 50% / 12px 12px); transition: background-color 0.3s ease; }
  [hidden] { display: none !important; }
  .ro-msg { border: 1px solid var(--border); border-left: 4px solid var(--ro-accent, var(--border)); border-radius: 10px; background: var(--bg-raise, var(--card)); padding: 14px; display: flex; flex-direction: column; gap: 12px; transition: border-color 0.3s ease; }
  .ro-title { font-size: 16px; font-weight: 800; overflow-wrap: anywhere; }
  .ro-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
  .ro-chip { flex: none; display: inline-flex; align-items: center; font-size: 12px; font-weight: 600; padding: 5px 10px; border-radius: 6px; background: color-mix(in srgb, var(--green) 40%, var(--card)); color: var(--text); }
  .ro-msg hr { border: none; border-top: 1px solid var(--border-soft); margin: 2px 0; }
  .ro-h2 { font-size: 14px; font-weight: 700; margin: 4px 0; }
  .ro-lines { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--text-muted); }
  .ro-lines b { color: var(--text); }
  .ro-msg :global(.ro-emoji) { display: inline-block; width: 1.15em; height: 1.15em; vertical-align: -0.2em; margin-right: 2px; }
  .ro-id { color: var(--accent); overflow-wrap: anywhere; }
  .ro-id code { font-family: var(--mono); font-size: 12px; padding: 1px 5px; border-radius: 5px; background: var(--bg-raise); }
  .ro-code { margin: 0; padding: 8px 10px; border-radius: 8px; background: var(--bg-raise); font-family: var(--mono); font-size: 12px; white-space: pre-wrap; color: var(--text); }
  .ro-design { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding: 18px; border: 1px dashed var(--border); border-radius: 12px; }
  .ro-design :global(svg) { color: var(--accent); }
  .ro-design p { margin: 0; font-size: 13.5px; overflow-wrap: anywhere; }
  @media (max-width: 960px) {
    .ro-grid { grid-template-columns: minmax(0, 1fr); }
    .ro-preview { position: static; }
  }
</style>
