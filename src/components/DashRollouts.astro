---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  config: { enabled: boolean; channelId: string; roleId: string; style: string; embedTemplate: string; kinds: string[]; events: string[]; minChange: number; includeUnrolled: boolean; hideSections: string[]; accentColor: string; typeTemplates: Record<string, string> };
  channels: { id: string; name: string }[];
  roles: { id: string; name: string }[];
  embedTemplates: { name: string; v2: boolean }[];
  ready: boolean;
  saved: boolean;
}
const { user, guildId, guildName, guildIcon, config, channels, roles, embedTemplates, ready, saved } = Astro.props;
const kinds = [['user', 'Users experiments'], ['guild', 'Servers experiments'], ['apex_user', 'Users experiments (A/B)'], ['installation', 'Installations experiments']];
const events = [['new', 'A new experiment'], ['increase', 'The rollout grows'], ['decrease', 'The rollout shrinks'], ['status', 'The status changes']];
const sections = [['variants', 'Variants and their change'], ['ranges', 'Ranges'], ['status', 'Status'], ['platforms', 'Platforms'], ['filters', 'Filters']];
const sample = { name: 'Android media viewer full resolution', id: '2026-10-android-media-viewer-full-resolution', variants: ['Variant 0 (control): 50%', 'Variant 1: 37.5% → 50% (+12.5%)'], ranges: 'Variant 1: (5000 - 10000)' };
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="rollouts" pageTitle="Rollout alerts">
  <h1>{dt('Rollout alerts')} <span class="ro-beta">{dt('Beta')}</span></h1>
  <p class="ro-sub"><Fragment set:html={dth('A message in a channel of <b>{a}</b> when a Discord experiment appears or its rollout changes. Only the team and the testers can see this page for now.', { a: (guildName) })} /></p>
  {saved && <div class="ro-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {!ready && <div class="ro-flash ro-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}

  <div class="ro-grid">
    <form method="POST" class="ro-form">
      <label class="ro-check"><input type="checkbox" name="enabled" checked={config.enabled} />{dt('Send alerts')}</label>
      <div class="ro-field"><label>{dt('Channel')}</label><select name="channel_id"><option value="">{dt('None')}</option>{channels.map((ch) => <option value={ch.id} selected={ch.id === config.channelId}>#{ch.name}</option>)}</select></div>
      <div class="ro-field"><label>{dt('Role to ping')}</label><select name="role_id"><option value="">{dt('None')}</option>{roles.map((r) => <option value={r.id} selected={r.id === config.roleId}>{r.name}</option>)}</select></div>

      <div class="ro-field"><label>{dt('Message style')}</label>
        <select name="style" id="ro-style"><option value="card" selected={config.style !== 'template'}>{dt('Petto card')}</option><option value="template" selected={config.style === 'template'}>{dt('A saved embed')}</option></select>
      </div>
      <div class="ro-field" id="ro-template-field"><label>{dt('Saved embed')}</label>
        <select name="embed_template"><option value="">{dt('None')}</option>{embedTemplates.map((tpl) => <option value={tpl.name} selected={tpl.name === config.embedTemplate}>{tpl.name}{tpl.v2 ? ' (V2)' : ''}</option>)}</select>
        <span class="ro-note">{dt('It can use the rollout variables, such as {rollout.name}, {rollout.change} and {rollout.variants}. If it is missing, the card is sent.')}</span>
        {config.embedTemplate && <a class="ro-edit" href={`/dash/guild/${guildId}/embeds?name=${encodeURIComponent(config.embedTemplate)}`}>{dt('Edit this design')}</a>}
        <button type="submit" form="ro-design-form" class="btn btn-ghost btn-sm ro-make" disabled={!ready}>{dt('Make a V2 design from the Petto card')}</button>
      </div>

      <fieldset class="ro-set"><legend>{dt('Only these experiments')}</legend>
        {kinds.map(([value, label]) => <label class="ro-check"><input type="checkbox" name="kinds" value={value} checked={config.kinds.includes(value)} />{dt(label)}</label>)}
        <span class="ro-note">{dt('Leave all empty for every kind.')}</span>
      </fieldset>
      <fieldset class="ro-set"><legend>{dt('Only these events')}</legend>
        {events.map(([value, label]) => <label class="ro-check"><input type="checkbox" name="events" value={value} checked={config.events.includes(value)} />{dt(label)}</label>)}
        <span class="ro-note">{dt('Leave all empty for every event.')}</span>
      </fieldset>
      <div class="ro-field"><label>{dt('Ignore changes smaller than (percentage points)')}</label><input type="number" name="min_change" min="0" max="100" step="0.5" value={config.minChange} /></div>
      <label class="ro-check"><input type="checkbox" name="include_unrolled" checked={config.includeUnrolled} />{dt('Also announce new experiments that have no rollout yet')}</label>

      <fieldset class="ro-set" id="ro-card-options"><legend>{dt('What the card hides')}</legend>
        {sections.map(([value, label]) => <label class="ro-check"><input type="checkbox" name={`hide_${value}`} data-hide={value} checked={config.hideSections.includes(value)} />{dt(label)}</label>)}
        <div class="ro-field"><label>{dt('Card color')}</label><input type="text" name="accent_color" id="ro-color" value={config.accentColor} placeholder="#ff91c2" maxlength="7" /><span class="ro-note">{dt('Empty uses green when it grows, red when it shrinks, blue for a new one and yellow for a status change.')}</span></div>
      </fieldset>

      <fieldset class="ro-set"><legend>{dt('A different design for each kind')}</legend>
        <span class="ro-note">{dt('Choose a saved embed (normal or V2) for the kinds of experiment you want to look different. An experiment uses the one of its kind; if there is none, the general design above.')}</span>
        {kinds.map(([value, label]) => (
          <div class="ro-field ro-type">
            <label>{dt(label)}</label>
            <select name={`type_template_${value}`}><option value="">{dt('The general design')}</option>{embedTemplates.map((tpl) => <option value={tpl.name} selected={tpl.name === config.typeTemplates[value]}>{tpl.name}{tpl.v2 ? ' (V2)' : ''}</option>)}</select>
          </div>
        ))}
      </fieldset>

      <button type="submit" class="btn btn-accent btn-sm" disabled={!ready}>{dt('Save changes')}</button>
    </form>

    <aside class="ro-preview" aria-label={dt('Preview')}>
      <div class="ro-eyebrow">{dt('Preview')}</div>
      <div class="ro-card" id="ro-card" style={`--ro-accent:${config.accentColor || '#6df08e'}`}>
        <div class="ro-head">
          <div>
            <div>🧪 <b>{dt('Users experiment (A/B)')}</b> · {dt('Rollout increased')}</div>
            <div class="ro-name">{sample.name}</div>
            <div class="ro-id">{sample.id}</div>
          </div>
          <span class="ro-badge">+12.5% (50%)</span>
        </div>
        <div data-part="variants"><hr /><div class="ro-code-title">🔁 {dt('Rollouts')}:</div><pre class="ro-code">{sample.variants.join('\n')}</pre></div>
        <div data-part="ranges"><div class="ro-code-title">🎯 {dt('Ranges')}:</div><pre class="ro-code">{sample.ranges}</pre></div>
        <div class="ro-lines"><hr />
          <div data-part="status">• <b>{dt('Status')}:</b> {dt('A/B test')}</div>
          <div data-part="platforms">• <b>{dt('Platforms')}:</b> android, desktop</div>
          <div data-part="filters">• <b>{dt('Filters')}:</b> {dt('Servers of 3 to 50 members')}</div>
        </div>
        <hr />
        <div class="ro-credit">{dt('Data from')} agnonotdev's rollouts list</div>
      </div>
      <p class="ro-note">{dt('A rough preview. Discord draws the real message.')}</p>
    </aside>
  </div>
  <form method="POST" id="ro-design-form"><input type="hidden" name="action" value="create_design" /></form>
</DashGuildLayout>

<script>
  const card = document.getElementById('ro-card');
  const color = document.getElementById('ro-color') as HTMLInputElement | null;
  const style = document.getElementById('ro-style') as HTMLSelectElement | null;
  function update() {
    document.querySelectorAll<HTMLInputElement>('[data-hide]').forEach((box) => {
      card?.querySelectorAll<HTMLElement>(`[data-part="${box.dataset.hide}"]`).forEach((el) => { el.hidden = box.checked; });
    });
    if (card && color) card.style.setProperty('--ro-accent', /^#?[0-9a-f]{6}$/i.test(color.value.trim()) ? `#${color.value.trim().replace('#', '')}` : '#6df08e');
    const useTemplate = style?.value === 'template';
    document.getElementById('ro-template-field')?.toggleAttribute('hidden', !useTemplate);
    document.getElementById('ro-card-options')?.toggleAttribute('hidden', useTemplate);
    document.getElementById('ro-card')?.toggleAttribute('hidden', useTemplate);
  }
  document.querySelectorAll('[data-hide], #ro-color, #ro-style').forEach((el) => el.addEventListener('input', update));
  update();
</script>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  .ro-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 20px; max-width: 68ch; }
  .ro-sub :global(b) { color: var(--text); }
  .ro-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 16px; max-width: 640px; }
  .ro-flash-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: var(--yellow); }
  .ro-grid { display: grid; grid-template-columns: minmax(0, 640px) minmax(260px, 340px); gap: 28px; align-items: start; }
  @media (max-width: 960px) { .ro-grid { grid-template-columns: 1fr; } }
  .ro-form { display: flex; flex-direction: column; gap: 16px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 20px; }
  .ro-field { display: flex; flex-direction: column; gap: 6px; }
  .ro-field label { font-size: 12px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.03em; }
  .ro-field textarea { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; resize: vertical; }
  .ro-field input, .ro-field select { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; }
.ro-type { display: grid; grid-template-columns: minmax(90px, 1fr) minmax(0, 2fr) minmax(0, 2fr); align-items: center; gap: 8px; }
  .ro-type label { grid-column: 1; }
  @media (max-width: 600px) { .ro-type { grid-template-columns: 1fr; } }
  .ro-note { font-size: 11.5px; line-height: 1.4; color: var(--text-dim); }
  .ro-set { border: 1px solid var(--border-soft); border-radius: 10px; padding: 12px 14px; display: flex; flex-direction: column; gap: 8px; }
  .ro-set legend { font-size: 12px; font-weight: 600; color: var(--text-dim); padding: 0 6px; }
  .ro-check { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--text); }
  [hidden] { display: none !important; }
  .ro-preview { position: sticky; top: 16px; }
  .ro-eyebrow { font-size: 12px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 8px; }
  .ro-card { border: 1px solid var(--border); border-left: 4px solid var(--qa-accent); border-radius: 10px; background: var(--card); padding: 14px; display: flex; flex-direction: column; gap: 12px; }
  .ro-title { font-size: 16px; font-weight: 700; }
  .ro-title a { color: var(--accent); }
  .ro-badge { color: var(--qa-accent); }
  .ro-h2 { font-size: 14px; font-weight: 700; margin-bottom: 4px; }
  .ro-card hr { border: none; border-top: 1px solid var(--border-soft); margin: 2px 0; }
  .ro-edit { font-size: 12.5px; color: var(--accent); }
  .ro-make { align-self: flex-start; margin-top: 4px; }
  .ro-hero { height: 110px; border-radius: 8px; background: linear-gradient(135deg, color-mix(in srgb, var(--qa-accent) 70%, #000), var(--qa-accent)); }
  .ro-lines { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--text-muted); }
  .ro-lines b { color: var(--text); }
  .ro-buttons { display: flex; gap: 8px; margin-top: 8px; }
  .ro-buttons span { font-size: 12px; padding: 5px 10px; border-radius: 6px; background: var(--bg-raise); color: var(--text); }
  .ro-credit { font-size: 11px; color: var(--text-dim); }
  .ro-beta { display: inline-block; margin-left: 6px; padding: 2px 8px; border: 1px solid var(--accent); border-radius: 999px; color: var(--accent); font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; vertical-align: 6px; }
  .ro-head { display: flex; justify-content: space-between; gap: 10px; align-items: flex-start; font-size: 13px; }
  .ro-name { font-weight: 700; margin-top: 6px; }
  .ro-id { font-family: var(--mono); font-size: 11px; color: var(--text-dim); word-break: break-all; }
  .ro-badge { flex: none; font-size: 12px; font-weight: 600; padding: 5px 10px; border-radius: 6px; background: var(--ro-accent); color: #0b0b0b; opacity: .9; }
  .ro-code-title { font-size: 13px; font-weight: 700; margin: 6px 0 4px; }
  .ro-code { margin: 0; padding: 8px 10px; border-radius: 8px; background: var(--bg-raise); font-family: var(--mono); font-size: 12px; white-space: pre-wrap; color: var(--text); }
</style>
