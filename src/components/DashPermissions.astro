---
import DashGuildLayout from './DashGuildLayout.astro';
import { Icon } from 'astro-icon/components';
import PermissionGraphApp from '../react/permissions/PermissionGraphApp';

interface Member { subjectType: 'user' | 'role'; subjectId: string; }
interface Group { id: number; name: string; level: number; isBase: boolean; members: Member[]; }
interface CommandInfo { name: string; category: string; categoryTitle: string; desc: string; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  roles: { id: string; name: string; isAdmin: boolean; isManageGuild: boolean }[];
  groups: Group[];
  commandLevels: Record<string, number>;
  commands: CommandInfo[];
  currentUser: { id: string; name: string; avatarUrl: string };
}
const { user, guildId, guildName, guildIcon, roles, groups, commandLevels, commands, currentUser } = Astro.props;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="permissions" pageTitle="Permissions">
  <h1>Permissions</h1>
  <p class="pg-sub">A custom 0-100 authorization level, layered on top of Discord's own permissions, for every command in <b>{guildName}</b>. Click any ring segment to edit it, bars reach further out the higher the required level. The server owner and anyone with Administrator always bypass this.</p>

  <div class="pg-prefix-card">
    <div class="pg-prefix-copy">
      <span class="pg-prefix-icon"><Icon name="ph:terminal-window-fill" width="15" height="15" /></span>
      <div><strong>Prefix-only access</strong><span>These same groups and command levels also work from Discord. The server prefix is configurable; <code>!</code> is only the default.</span></div>
    </div>
    <div class="pg-prefix-examples"><code>!permission group list</code><code>!permission command list</code><code>!permission mylevel</code></div>
  </div>

  <PermissionGraphApp
    client:only="react"
    guildId={guildId}
    roles={roles}
    initialGroups={groups}
    initialCommandLevels={commandLevels}
    commands={commands}
    currentUser={currentUser}
  />
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  .pg-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 20px; max-width: 74ch; }
  .pg-sub b { color: var(--text); }
  .pg-prefix-card { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 13px 15px; margin: 0 0 22px; border: 1px solid var(--border); border-radius: 12px; background: var(--bg-raise); }
  .pg-prefix-copy { display: flex; align-items: flex-start; gap: 10px; min-width: 0; }
  .pg-prefix-icon { display: grid; place-items: center; width: 28px; height: 28px; flex: 0 0 28px; color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); border-radius: 8px; }
  .pg-prefix-copy div { display: grid; gap: 3px; }
  .pg-prefix-copy strong { color: var(--text); font-size: 13px; }
  .pg-prefix-copy span { color: var(--text-muted); font-size: 12px; line-height: 1.45; }
  .pg-prefix-copy code, .pg-prefix-examples code { font-family: var(--mono); color: var(--accent); }
  .pg-prefix-examples { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px; }
  .pg-prefix-examples code { padding: 6px 8px; border: 1px solid var(--border); border-radius: 7px; background: var(--card); font-size: 11px; white-space: nowrap; }
  @media (max-width: 780px) { .pg-prefix-card { align-items: flex-start; flex-direction: column; } .pg-prefix-examples { justify-content: flex-start; } }
</style>
