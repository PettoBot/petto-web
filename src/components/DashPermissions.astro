---
import DashGuildLayout from './DashGuildLayout.astro';
import PermissionGraphApp from '../react/permissions/PermissionGraphApp';

interface Member { subjectType: 'user' | 'role'; subjectId: string; }
interface Group { id: number; name: string; level: number; isBase: boolean; members: Member[]; }
interface CommandInfo { name: string; category: string; categoryTitle: string; desc: string; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  roles: { id: string; name: string; isAdmin: boolean; isManageGuild: boolean }[];
  groups: Group[];
  commandLevels: Record<string, number>;
  commands: CommandInfo[];
  currentUser: { id: string; name: string; avatarUrl: string };
}
const { user, guildId, guildName, guildIcon, roles, groups, commandLevels, commands, currentUser } = Astro.props;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="permissions" pageTitle="Permissions">
  <h1>Permissions</h1>
  <p class="pg-sub">A custom 0-100 authorization level, layered on top of Discord's own permissions, for every command in <b>{guildName}</b>. Click any ring segment to edit it, bars reach further out the higher the required level. The server owner and anyone with Administrator always bypass this.</p>

  <PermissionGraphApp
    client:only="react"
    guildId={guildId}
    roles={roles}
    initialGroups={groups}
    initialCommandLevels={commandLevels}
    commands={commands}
    currentUser={currentUser}
  />
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  .pg-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 20px; max-width: 74ch; }
  .pg-sub b { color: var(--text); }
</style>
