---
// "The history of Petto": why the site says 2017 when the bot you add today is from 2026, told in the first person by the person who leads Petto.
// The words are in src/data/historyCopy.ts (three languages, the same dates in the same order, checked by scripts/check-history-page.mjs).
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { localePath, type Locale } from '../i18n/ui';
import { HISTORY_COPY } from '../data/historyCopy';

interface Props { lang: Locale }
const { lang } = Astro.props;
const c = HISTORY_COPY[lang];
const base = localePath[lang];
---
<Base title={c.name} description={c.description} active="home" lang={lang} skin="ash">
  <main>
    <section class="hs-hero">
      <div class="wrap hs-narrow">
        <h1>{c.h1}</h1>
        <p class="hs-lede">{c.lede}</p>
      </div>
    </section>

    <section class="hs-sec">
      <div class="wrap hs-narrow">
        <div class="hs-short reveal">
          <h2>{c.short.title}</h2>
          <ul class="hs-three">
            {c.short.items.map((item) => (
              <li><b>{item.when}</b><span>{item.text}</span></li>
            ))}
          </ul>
          <p class="hs-note">{c.short.note}</p>
        </div>

        <ul class="hs-numbers reveal">
          {c.numbers.map((n) => (
            <li><b class="num">{n.value}</b><span>{n.label}</span></li>
          ))}
        </ul>

        <h2 class="hs-h2">{c.timelineTitle}</h2>
        <ol class="hs-line">
          {c.steps.map((step) => (
            <li class="hs-step reveal">
              <span class="hs-dot" aria-hidden="true"></span>
              <time class="hs-when">{step.when}</time>
              <div class="hs-card">
                <h3>{step.title}</h3>
                <p>{step.text}</p>
                {step.note && <p class="hs-aside">{step.note}</p>}
              </div>
            </li>
          ))}
        </ol>

        <div class="hs-duo">
          <section class="hs-card reveal">
            <h3><Icon name="ph:code-fill" width="18" height="18" />{c.code.title}</h3>
            <p>{c.code.text}</p>
          </section>
          <section class="hs-card reveal">
            <h3><Icon name="ph:sparkle-fill" width="18" height="18" />{c.why.title}</h3>
            <p>{c.why.text}</p>
          </section>
        </div>

        <section class="hs-today reveal">
          <h2>{c.today.title}</h2>
          <p>{c.today.text}</p>
          <p class="hs-sign">— {c.today.sign}</p>
          <div class="hs-cta">
            <a class="btn btn-primary" href="https://petto.sbs/invite" target="_blank" rel="noopener">{c.today.add}</a>
            <a class="btn btn-ghost" href={`${base}/team`}>{c.today.team} &rarr;</a>
          </div>
        </section>
      </div>
    </section>
  </main>
</Base>

<style>
  .hs-narrow { max-width: 820px; margin-inline: auto; }
  .hs-hero { padding: 84px 0 28px; text-align: center; }
  .hs-hero h1 { margin: 0 0 16px; font-size: clamp(38px, 6.4vw, 58px); line-height: 1.08; }
  .hs-lede { margin: 0 auto; max-width: 640px; font-size: 18px; line-height: 1.6; color: var(--text-muted); }
  .hs-sec { padding: 8px 0 96px; }
  .hs-sec h2 { font-family: var(--serif); font-size: clamp(24px, 4vw, 30px); margin: 0 0 16px; text-align: center; }
  .hs-h2 { margin-top: 64px !important; }

  /* The short answer: three dates, one sentence each. */
  .hs-short { padding: 28px 26px 22px; border: 1px solid var(--border); border-radius: 18px; background: var(--card); }
  .hs-three { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .hs-three li { display: flex; flex-direction: column; gap: 6px; padding: 16px 16px 15px; border: 1px solid var(--border-soft); border-radius: 14px; background: var(--bg-raise); }
  .hs-three b { font-family: var(--mono); font-size: 12.5px; letter-spacing: .02em; color: var(--accent); font-weight: 600; }
  .hs-three span { font-size: 15px; line-height: 1.5; color: var(--text); }
  .hs-note { margin: 16px 4px 0; text-align: center; font-size: 14.5px; line-height: 1.55; color: var(--text-dim); }

  .hs-numbers { list-style: none; margin: 22px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; border: 1px solid var(--border); border-radius: 16px; overflow: hidden; background: var(--border-soft); }
  .hs-numbers li { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 20px 12px 18px; background: var(--card); text-align: center; }
  .hs-numbers b { font-family: var(--serif); font-size: 30px; font-weight: 600; color: var(--text); }
  .hs-numbers span { font-size: 13px; line-height: 1.4; color: var(--text-dim); max-width: 18ch; }

  /* The years: a line down the left, a dot and the date for each, and a card with what happened. */
  .hs-line { list-style: none; margin: 0; padding: 0 0 0 28px; position: relative; display: flex; flex-direction: column; gap: 20px; }
  .hs-line::before { content: ''; position: absolute; left: 6px; top: 8px; bottom: 8px; width: 2px; border-radius: 2px; background: linear-gradient(to bottom, var(--border), var(--border-soft)); }
  .hs-step { position: relative; display: flex; flex-direction: column; gap: 8px; }
  .hs-dot { position: absolute; left: -28px; top: 4px; width: 14px; height: 14px; border-radius: 50%; background: var(--bg); border: 2px solid var(--accent); box-shadow: 0 0 0 4px var(--bg); }
  .hs-when { font-family: var(--mono); font-size: 13px; letter-spacing: .02em; color: var(--accent); font-weight: 600; }
  .hs-card { padding: 18px 20px 18px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); }
  .hs-card h3 { display: flex; align-items: center; gap: 8px; margin: 0 0 6px; font-size: 17px; font-weight: 650; color: var(--text); }
  .hs-card h3 :global(svg) { color: var(--accent); flex: none; }
  .hs-card p { margin: 0; font-size: 15.5px; line-height: 1.6; color: var(--text-muted); }
  .hs-aside { margin-top: 10px !important; padding-top: 10px; border-top: 1px dashed var(--border); font-size: 14.5px !important; color: var(--text-dim) !important; }

  .hs-duo { margin-top: 44px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .hs-duo .hs-card { height: 100%; }

  .hs-today { margin-top: 56px; padding: 34px 26px 30px; text-align: center; border: 1px solid var(--border); border-radius: 18px; background: var(--card); }
  .hs-today h2 { margin-bottom: 10px; }
  .hs-today p { margin: 0 auto; max-width: 520px; font-size: 16px; line-height: 1.6; color: var(--text-muted); }
  .hs-sign { margin-top: 12px !important; font-family: var(--serif); font-size: 18px !important; color: var(--text) !important; }
  .hs-cta { margin-top: 22px; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }

  @media (max-width: 720px) {
    .hs-hero { padding: 52px 0 20px; }
    .hs-hero h1 { font-size: 36px; }
    .hs-lede { font-size: 16.5px; }
    .hs-three, .hs-duo { grid-template-columns: 1fr; }
    .hs-numbers { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hs-short { padding: 22px 16px 18px; }
    .hs-card { padding: 16px 16px; }
    .hs-today { padding: 28px 18px 26px; }
  }
</style>
