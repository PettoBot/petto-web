---
import { Icon } from 'astro-icon/components';

interface Props {
  locked: boolean;
  title?: string;
  description?: string;
  href?: string;
}

const {
  locked,
  title = 'This feature needs Premium',
  description = 'Activate Premium for this server to unlock these controls.',
  href = '/dash/premium',
} = Astro.props;
---

<div class:list={['premium-gate', { 'premium-gate-locked': locked }]}>
  <div class="premium-gate-content">
    <slot />
  </div>

  {locked && (
    <div class="premium-gate-overlay" role="note" aria-label="Premium required">
      <div class="premium-gate-card">
        <span class="premium-gate-icon"><Icon name="ph:crown-fill" width="18" height="18" /></span>
        <span class="premium-gate-kicker">Petto Premium</span>
        <h2>{title}</h2>
        <p>{description}</p>
        <a class="btn btn-primary btn-sm" href={href}>
          <Icon name="ph:lock-open-fill" width="14" height="14" />
          See Premium plans
        </a>
      </div>
    </div>
  )}
</div>

<style>
  .premium-gate { position: relative; min-width: 0; }
  .premium-gate-locked { isolation: isolate; }
  .premium-gate-locked .premium-gate-content { filter: blur(2px); opacity: .42; pointer-events: none; user-select: none; }
  .premium-gate-overlay { position: absolute; inset: 0; z-index: 3; display: grid; place-items: center; padding: 28px; border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border)); border-radius: 16px; background: color-mix(in srgb, var(--bg) 76%, transparent); backdrop-filter: blur(5px); }
  .premium-gate-card { width: min(390px, 100%); padding: 25px; border: 1px solid color-mix(in srgb, var(--accent) 52%, var(--border)); border-radius: 15px; background: color-mix(in srgb, var(--card) 94%, var(--accent) 6%); box-shadow: 0 20px 60px color-mix(in srgb, var(--bg) 55%, transparent); text-align: center; }
  .premium-gate-icon { display: inline-grid; place-items: center; width: 38px; height: 38px; margin-bottom: 11px; border-radius: 12px; color: var(--accent); background: var(--accent-soft); }
  .premium-gate-kicker { display: block; color: var(--accent); font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .premium-gate-card h2 { margin: 8px 0 7px; font-family: var(--serif); font-size: 23px; line-height: 1.1; }
  .premium-gate-card p { margin: 0 auto 18px; max-width: 33ch; color: var(--text-muted); font-size: 13px; line-height: 1.55; }
  .premium-gate-card .btn { display: inline-flex; align-items: center; gap: 7px; }
  @media (max-width: 560px) { .premium-gate-overlay { padding: 14px; } .premium-gate-card { padding: 20px 16px; } }
</style>
