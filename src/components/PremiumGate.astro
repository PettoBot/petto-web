---
import { Icon } from 'astro-icon/components';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  locked: boolean;
  title?: string;
  description?: string;
  href?: string;
}

const {
  locked,
  title = dt('This feature needs Premium'),
  description = dt('Activate Premium for this server to unlock these controls.'),
  href = '/dash/premium',
} = Astro.props;
---

<div class:list={['premium-gate', { 'premium-gate-locked': locked }]}>
  <div class="premium-gate-content">
    <slot />
  </div>

  {locked && (
    <div class="premium-gate-overlay" role="note" aria-label={dt('Premium required')}>
      <div class="premium-gate-card">
        <span class="premium-gate-icon"><Icon name="ph:crown-fill" width="18" height="18" /></span>
        <span class="premium-gate-kicker">{dt('Petto Premium')}</span>
        <h2>{title}</h2>
        <p>{description}</p>
        <ul class="premium-gate-terms">
          <li><b>{dt('Cancel whenever you want')}</b><span>{dt('It stays active until the end of the period you already paid and does not renew.')}</span></li>
          <li><b>{dt('Charges by mistake are returned')}</b><span>{dt('A duplicated charge, one made by mistake or never activated is refunded: open a ticket with the receipt.')}</span></li>
        </ul>
        <a class="btn btn-primary btn-sm" href={href}>
          <Icon name="ph:lock-open-fill" width="14" height="14" />
          {dt('See Premium plans')}
        </a>
      </div>
    </div>
  )}
</div>

<style>
  .premium-gate { position: relative; min-width: 0; }
  /* Tall enough for the card even when the locked controls are short. */
  .premium-gate-locked { isolation: isolate; min-height: 260px; }
  .premium-gate-locked .premium-gate-content { filter: blur(1.5px); opacity: .45; pointer-events: none; user-select: none; }
  .premium-gate-overlay { position: absolute; inset: 0; z-index: 3; display: grid; place-items: center; padding: 24px; border: 1px dashed color-mix(in srgb, var(--accent) 38%, var(--border)); border-radius: 16px; background: color-mix(in srgb, var(--bg) 58%, transparent); }
  .premium-gate-card { width: min(380px, 100%); padding: 22px 20px; border: 1px solid color-mix(in srgb, var(--accent) 34%, var(--border)); border-radius: 16px; background: linear-gradient(160deg, color-mix(in srgb, var(--accent-soft) 70%, var(--card)), var(--card) 62%); box-shadow: 0 18px 44px -22px color-mix(in srgb, #000 70%, transparent); text-align: center; animation: m-rise-in var(--m-slow) var(--m-out) backwards; }
  .premium-gate-icon { display: inline-grid; place-items: center; width: 40px; height: 40px; margin-bottom: 10px; border-radius: 13px; color: var(--accent); background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border)); }
  .premium-gate-kicker { display: block; color: var(--accent); font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .premium-gate-card h2 { margin: 6px 0 6px; font-family: var(--serif); font-size: 21px; line-height: 1.15; }
  .premium-gate-card p { margin: 0 auto 16px; max-width: 34ch; color: var(--text-muted); font-size: 13px; line-height: 1.55; }
  .premium-gate-terms { list-style: none; margin: 0 auto 16px; padding: 0; display: flex; flex-direction: column; gap: 8px; text-align: left; max-width: 34ch; }
  .premium-gate-terms li { display: flex; flex-direction: column; gap: 2px; padding: 8px 10px; border-radius: 10px; background: color-mix(in srgb, var(--text) 5%, transparent); }
  .premium-gate-terms b { font-size: 12.5px; } .premium-gate-terms span { font-size: 12px; color: var(--text-muted); line-height: 1.45; }
  .premium-gate-card .btn { display: inline-flex; align-items: center; gap: 7px; }
  @media (max-width: 560px) { .premium-gate-locked { min-height: 330px; } .premium-gate-overlay { padding: 12px; } .premium-gate-card { padding: 18px 16px; } .premium-gate-card h2 { font-size: 19px; } }
  @media (prefers-reduced-motion: reduce) { .premium-gate-card { animation: none; } }
</style>
