---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import DashPanelHead from './DashPanelHead.astro';
import DashPanelEmpty from './DashPanelEmpty.astro';
import { daysLeft, userAvatar, type ManualPremiumGrant, type GrantState, type PreviewResult } from '../utils/premiumAdmin';

import { dashLocale, getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);

interface Row {
  grant: ManualPremiumGrant;
  target: { type: 'user' | 'server'; id: string };
  name: string | null;
  image: string | null;
  state: GrantState;
  live: boolean;
}
interface Form { targetType: string; targetId: string; duration: string; until: string; slots: string }

interface Props {
  user: { username: string; avatar: string | null };
  rows: Row[];
  counts: Record<'all' | 'users' | 'servers' | 'live' | 'expired', number>;
  filter: string;
  form: Form;
  preview: Extract<PreviewResult, { ok: true }> | null;
  flip: { type: 'user' | 'server'; name: string | null; image: string | null; known: boolean } | null;
  editedId: number | null;
  error?: string;
  saved?: string | null;
  logged?: number | null;
  ownerId: string;
}

const { rows, counts, filter, form, preview, flip, editedId, error, saved = null, logged = null, ownerId } = Astro.props;

const fmt = new Intl.DateTimeFormat(dashLocale(dashLang), { dateStyle: 'medium', timeZone: 'UTC' });
const day = (iso: string | null) => (iso ? fmt.format(new Date(iso)) : dt('Permanent'));
const tomorrow = new Date(Date.now() + 86_400_000).toISOString().slice(0, 10);
const durations: Array<[string, string]> = [['permanent', dt('Permanent')], ['1m', dt('1 month')], ['3m', dt('3 months')], ['6m', dt('6 months')], ['1y', dt('1 year')], ['date', dt('Until a date')]];
const slotChoices = (current?: number) => [...new Set([1, 3, 5, 10, 25, ...(current ? [current] : [])])].sort((a, b) => a - b);
const slotLabel = (n: number) => (n === 1 ? dt('1 server') : dt('{n} servers', { n }));
const flipHref = (type: string) => `/dash/admin?${new URLSearchParams({ target_type: type, target_id: form.targetId, duration: form.duration, until: form.until, slot_limit: form.slots }).toString()}#give`;
const targetKind = (type: string) => (type === 'server' ? dt('Server') : dt('User'));
const fallbackName = (type: string, id: string) => (type === 'server' ? dt('Server {id}', { id }) : dt('User {id}', { id }));

const errors: Record<string, string> = {
  invalid: dt('Check the Discord ID, the date and the slot limit. IDs have 15 to 22 digits.'),
  database: dt('The private API could not save this grant. Check the dashboard API secret.'),
  slot_conflict: dt('This grant already has more active servers than the new slot limit.'),
  server_taken: dt('That server already has an active Premium owner.'),
  wrong_type_server: dt('That ID is a server, not a user. Switch to Server.'),
  wrong_type_user: dt('That ID is a user, not a server. Switch to User.'),
  past_date: dt('The end date must be in the future.'),
  not_found: dt('That manual grant no longer exists.'),
  stale: dt('The grant changed or the review expired while you were looking at it. Review it again.'),
  unconfirmed: dt('Tick the box to confirm that the ID is a server of Petto.'),
  log_not_configured: dt('Set PREMIUM_LOGS_WEBHOOK_URL in the website first: the webhook of the channel of the team.'),
  log_database: dt('The list of active Premium could not be read from the database.'),
  log_discord: dt('Discord did not accept the message. Check the webhook of the channel.'),
};
const savedText: Record<string, string> = {
  '1': dt('Premium grant saved.'), grant: dt('Premium grant saved.'), edit: dt('Premium grant changed.'),
  extend: dt('Premium grant extended.'), revoke: dt('Premium grant revoked.'),
};

const plan = preview?.plan ?? null;
const target = preview?.target ?? null;
const planTitle = plan ? (plan.mode === 'edit' ? dt('Check the change') : dt('Check before you save')) : '';
const noteText: Record<string, string> = {
  new: dt('A new grant. It starts now.'),
  extended: dt('This target already has a live grant: the time is added to its current end.'),
  kept_permanent: dt('This target already has a permanent grant. It stays permanent.'),
  kept_later: dt('This target already has a grant that ends later than that date. Its end does not change.'),
  restarted: dt('This target had a grant that is over. It becomes active again and counts from now.'),
  set: dt('The end is set exactly to this value, whatever it was before.'),
};
const prevText = plan ? (plan.prevStatus === null ? dt('No grant yet') : plan.prevLive ? (plan.prevEnd ? dt('Ends on {d} (UTC)', { d: day(plan.prevEnd) }) : dt('Permanent')) : dt('Not live (over or revoked)')) : '';

const rowEnd = (row: Row) => row.grant.current_period_end;
const stateText = (row: Row) => {
  const end = rowEnd(row);
  if (row.state === 'permanent') return dt('Permanent');
  if (row.state === 'timed' && end) {
    const n = daysLeft(end);
    return dt('Ends on {d} · {n}', { d: day(end), n: n === 1 ? dt('1 day left') : dt('{n} days left', { n }) });
  }
  return row.state === 'revoked' ? dt('Revoked') : dt('Expired');
};
const filters: Array<[string, string]> = [['all', dt('All')], ['users', dt('Users')], ['servers', dt('Servers')]];
---

<Base title={dt('Premium controls · Petto')} active="dash" showFooter>
  <main>
    <section class="admin-sec">
      <div class="wrap admin-wrap">
        <DashPanelHead title={dt('Manual Premium grants')} eyebrow={dt('Owner controls')} icon="ph:crown-fill">
          <a class="btn btn-ghost btn-sm" href="/dash/admin/servers" data-sk="list"><Icon name="ph:hard-drives-fill" width="14" height="14" /> {dt('All servers')}</a>
        </DashPanelHead>

        {error && errors[error] && <div class="admin-alert error"><Icon name="ph:warning-fill" width="17" height="17" /> <span>{errors[error]}</span></div>}
        {flip && <div class="admin-flip">
          <div class="admin-target">
            {flip.image ? <img src={flip.image} alt="" width="40" height="40" /> : <span class="admin-target-ph"><Icon name={flip.type === 'server' ? 'ph:hard-drives-fill' : 'ph:user-fill'} width="18" height="18" /></span>}
            <div><strong>{flip.name ?? fallbackName(flip.type, form.targetId)}</strong><small>{targetKind(flip.type)} · {form.targetId}</small></div>
          </div>
          <a class="btn btn-primary btn-sm" href={flipHref(flip.type)}><Icon name="ph:arrow-right-bold" width="14" height="14" /> {flip.type === 'server' ? dt('Switch to Server') : dt('Switch to User')}</a>
        </div>}
        {logged !== null && <div class="admin-alert success"><Icon name="ph:check-circle-fill" width="17" height="17" /> {dt('Sent to the channel of the team: {n} active.', { n: logged })}</div>}
        {saved && savedText[saved] && <div class="admin-alert success"><Icon name="ph:check-circle-fill" width="17" height="17" /> {savedText[saved]}</div>}

        <form method="POST" class="admin-log" data-no-dirty><input type="hidden" name="action" value="premium_log" /><button class="btn btn-ghost btn-sm" type="submit"><Icon name="ph:megaphone-fill" width="14" height="14" /> {dt('Send the active Premium to the log channel')}</button><span>{dt('Lists what the database has, so you can check that the subscriptions of Polar arrived.')}</span></form>

        <div class="admin-grid">
          {plan && target ? <article class="admin-card admin-review" id="give">
            <div class="admin-card-head"><Icon name="ph:seal-check-fill" width="20" height="20" /><div><h2>{planTitle}</h2><p>{dt('Nothing is saved until you confirm.')}</p></div></div>
            <div class="admin-target big">
              {target.image ? <img src={target.image} alt="" width="52" height="52" /> : <span class="admin-target-ph"><Icon name={plan.targetType === 'server' ? 'ph:hard-drives-fill' : 'ph:user-fill'} width="22" height="22" /></span>}
              <div>
                <strong>{target.name ?? (plan.targetType === 'server' ? dt('Petto does not know this server') : dt('Petto does not know this user yet'))}</strong>
                <small><span class:list={['kind', plan.targetType]}>{targetKind(plan.targetType)}</span> {target.id}{target.memberCount ? ` · ${dt('{n} members', { n: new Intl.NumberFormat(dashLocale(dashLang)).format(target.memberCount) })}` : ''}</small>
              </div>
            </div>
            {plan.needsAck && <div class="admin-alert error strong"><Icon name="ph:warning-fill" width="19" height="19" /> <span>{dt('Petto is not in a server with this ID: check it is a server ID. If it is a user ID, the Premium would go to nobody.')}</span></div>}
            {!plan.needsAck && plan.targetType === 'user' && !target.known && <div class="admin-alert warn"><Icon name="ph:info-fill" width="17" height="17" /> <span>{dt('Petto does not know this user yet. You can still confirm it: they will have Premium when they use Petto.')}</span></div>}
            <dl class="admin-sum">
              <div><dt>{dt('Action')}</dt><dd>{plan.mode === 'edit' ? dt('Edit the grant (the end is set exactly)') : plan.mode === 'extend' ? dt('Extend the grant') : dt('Give Premium (extends the grant if there is one)')}</dd></div>
              <div><dt>{dt('For')}</dt><dd>{plan.targetType === 'server' ? dt('The server directly: it gets Premium, 1 server slot') : dt('The user account: {slots}', { slots: slotLabel(plan.slots) })}</dd></div>
              {plan.targetType === 'server' && <div><dt>{dt('Internal account')}</dt><dd>{dt('Your owner account ({id}) holds this grant.', { id: plan.internalUserId || ownerId })}</dd></div>}
              {plan.prevStatus !== null && <div><dt>{dt('Now')}</dt><dd>{prevText}{plan.targetType === 'user' && plan.prevSlots !== plan.slots ? ` · ${slotLabel(plan.prevSlots ?? 0)}` : ''}</dd></div>}
              <div class="admin-sum-new"><dt>{dt('After')}</dt><dd>{plan.prevStatus !== null ? <><span>{prevText}</span> <Icon name="ph:arrow-right-bold" width="13" height="13" /> </> : ''}<strong>{plan.end ? dt('Ends on {d} (UTC)', { d: day(plan.end) }) : dt('Permanent')}</strong>{plan.targetType === 'user' && plan.prevSlots !== plan.slots && plan.prevSlots !== null ? ` · ${slotLabel(plan.slots)}` : ''}</dd></div>
            </dl>
            <p class="admin-note-strong">{noteText[plan.note]}</p>
            <p class="admin-note-strong">{plan.end ? dt('Nothing is charged: when that day passes, the grant simply stops.') : dt('Nothing is charged. It lasts until you revoke it or edit it.')}</p>
            <form method="POST" class="admin-form" data-no-dirty>
              <input type="hidden" name="action" value="confirm" />
              <input type="hidden" name="token" value={preview!.token} />
              <input type="hidden" name="kind" value={plan.mode === 'edit' ? 'edit' : 'grant'} />
              {plan.needsAck && <label class="admin-check"><input type="checkbox" name="ack" value="1" required /> <span>{dt('I checked it: this is the ID of a server.')}</span></label>}
              <div class="admin-buttons">
                <button class="btn btn-primary" type="submit"><Icon name="ph:crown-fill" width="15" height="15" /> {plan.mode === 'edit' ? dt('Confirm the change') : dt('Confirm and give Premium')}</button>
                <a class="btn btn-ghost" href={plan.mode === 'edit' ? '/dash/admin' : flipHref(plan.targetType)}>{dt('Back')}</a>
              </div>
            </form>
          </article> : <article class="admin-card" id="give">
            <div class="admin-card-head"><Icon name="ph:gift-fill" width="20" height="20" /><div><h2>{dt('Give Premium')}</h2><p>{dt('Choose who it is for, paste one ID and pick how long it lasts.')}</p></div></div>
            <form method="POST" class="admin-form give-form" data-no-dirty>
              <input type="hidden" name="action" value="preview" />
              <fieldset class="admin-choice">
                <legend>{dt('Give it to')}</legend>
                <label><input type="radio" name="target_type" value="user" checked={form.targetType === 'user'} /> <span><Icon name="ph:user-fill" width="15" height="15" /> {dt('User')}</span></label>
                <label><input type="radio" name="target_type" value="server" checked={form.targetType === 'server'} /> <span><Icon name="ph:hard-drives-fill" width="15" height="15" /> {dt('Server')}</span></label>
              </fieldset>
              <label class="id-field">
                <span class="when-user">{dt('Discord user ID')}</span><span class="when-server">{dt('Discord server ID')}</span>
                <input name="target_id" value={form.targetId} inputmode="numeric" pattern="[0-9]{15,22}" minlength="15" maxlength="22" required autocomplete="off" placeholder={dt('Discord ID')} data-ph-user={dt('Discord user ID')} data-ph-server={dt('Discord server ID')} />
                <small class="when-user">{dt('The ID of a person: in Discord, Developer Mode on, right click their name, Copy User ID. 15 to 22 digits.')}</small>
                <small class="when-server">{dt('The ID of a server: right click its icon, Copy Server ID. Not a user ID. 15 to 22 digits.')}</small>
              </label>
              <label class="slots-field">{dt('Server slots')}<select name="slot_limit">{slotChoices().map((n) => <option value={String(n)} selected={String(n) === form.slots}>{slotLabel(n)}</option>)}</select><small>{dt('How many servers this person can give Premium to. A server grant uses 1 slot.')}</small></label>
              <label>{dt('Duration')}<select name="duration">{durations.map(([value, label]) => <option value={value} selected={value === form.duration}>{label}</option>)}</select></label>
              <label class="until-field">{dt('Until')}<input type="date" name="until" value={form.until} min={tomorrow} /><small>{dt('The grant ends at the end of that day (UTC).')}</small></label>
              <button class="btn btn-primary" type="submit"><Icon name="ph:seal-check-fill" width="15" height="15" /> {dt('Review')}</button>
            </form>
            <p class="admin-note">{dt('You will see what the ID is (name and picture) before anything is saved. Giving Premium again to a target that already has a grant extends it; Edit in the list sets the end exactly. A server grant uses your owner ID as the internal account.')}</p>
          </article>}

          <article class="admin-card admin-info-card">
            <div class="admin-card-head"><Icon name="ph:shield-check-fill" width="20" height="20" /><div><h2>{dt('Protected owner area')}</h2><p>{dt('Only the configured Petto owner can submit these actions.')}</p></div></div>
            <dl>
              <div><dt>{dt('Owner ID')}</dt><dd>{ownerId}</dd></div>
              <div><dt>{dt('Storage')}</dt><dd>{dt('Discloud PostgreSQL · premium_entitlements')}</dd></div>
              <div><dt>{dt('Billing')}</dt><dd>{dt('Manual grant · no Polar charge, nothing is charged when it ends')}</dd></div>
            </dl>
          </article>
        </div>

        <div class="admin-list-head"><div><h2>{dt('Manual grants')}</h2><p>{dt('Permanent grants last until revoked. Timed ones stop by themselves on their end date. A revoked or ended grant is deleted automatically within minutes. Edit sets the end exactly; Extend adds time.')}</p></div></div>
        <nav class="admin-filters" aria-label={dt('Filter the grants')}>
          {filters.map(([value, label]) => <a href={value === 'all' ? '/dash/admin' : `/dash/admin?filter=${value}`} class:list={[{ on: filter === value }]} aria-current={filter === value ? 'page' : undefined}>{label} <span>{counts[value as keyof typeof counts]}</span></a>)}
        </nav>
        {rows.length === 0 ? <DashPanelEmpty icon="ph:crown-fill" text={counts.all === 0 ? dt('No manual grants yet.') : dt('No grants in this filter.')} /> : <div class="admin-grants dgl-stagger">
          {rows.map((row) => {
            const { grant, target: t } = row;
            const active = grant.assignments.filter((a) => a.status === 'active');
            const editing = editedId === grant.id;
            return <article class:list={['grant-row', { over: !row.live }]}>
              <div class="grant-top">
                {t.type === 'user' || row.image ? <img class="grant-img" src={row.image ?? userAvatar(t.id, null)} alt="" width="40" height="40" loading="lazy" /> : <div class="grant-icon"><Icon name="ph:hard-drives-fill" width="18" height="18" /></div>}
                <div class="grant-main">
                  <strong>{row.name ?? fallbackName(t.type, t.id)}</strong>
                  <span class="grant-meta"><span class:list={['kind', t.type]}>{targetKind(t.type)}</span> <code>{t.id}</code></span>
                  <span class="grant-meta">{t.type === 'user' ? slotLabel(grant.slot_limit) : dt('Server directly')} · <span class:list={['state', row.state]}>{stateText(row)}</span></span>
                  {t.type === 'user' && active.length > 0 && <small>{dt('Assigned: {list}', { list: active.map((a) => a.guild_id).join(', ') })}</small>}
                </div>
              </div>
              <div class="grant-actions">
                {row.live && <>
                  {grant.current_period_end && <form method="POST" data-no-dirty><input type="hidden" name="action" value="extend" /><input type="hidden" name="entitlement_id" value={grant.id} /><input type="hidden" name="by" value="1m" /><button class="btn btn-ghost btn-sm" type="submit">{dt('Extend 1 month')}</button></form>}
                  {grant.current_period_end && <form method="POST" data-no-dirty><input type="hidden" name="action" value="extend" /><input type="hidden" name="entitlement_id" value={grant.id} /><input type="hidden" name="by" value="1y" /><button class="btn btn-ghost btn-sm" type="submit">{dt('Extend 1 year')}</button></form>}
                  {grant.current_period_end && <form method="POST" data-no-dirty><input type="hidden" name="action" value="extend" /><input type="hidden" name="entitlement_id" value={grant.id} /><input type="hidden" name="by" value="permanent" /><button class="btn btn-ghost btn-sm" type="submit">{dt('Make permanent')}</button></form>}
                </>}
                <details class="grant-edit" open={editing}>
                  <summary class="btn btn-ghost btn-sm"><Icon name="ph:pencil-simple-fill" width="14" height="14" /> {dt('Edit')}</summary>
                  <form method="POST" class="admin-form cond-form" data-no-dirty>
                    <input type="hidden" name="action" value="edit_preview" />
                    <input type="hidden" name="entitlement_id" value={grant.id} />
                    <label>{dt('New duration (counted from today)')}<select name="duration">{durations.map(([value, label]) => <option value={value} selected={value === (row.live ? (grant.current_period_end ? 'date' : 'permanent') : '1m')}>{label}</option>)}</select></label>
                    <label class="until-field">{dt('Until')}<input type="date" name="until" min={tomorrow} value={row.live && grant.current_period_end ? grant.current_period_end.slice(0, 10) : ''} /></label>
                    {t.type === 'user' && <label>{dt('Server slots')}<select name="slot_limit">{slotChoices(grant.slot_limit).map((n) => <option value={String(n)} selected={n === grant.slot_limit}>{slotLabel(n)}</option>)}</select></label>}
                    <button class="btn btn-primary btn-sm" type="submit">{dt('Review the change')}</button>
                  </form>
                </details>
                {row.live && <details class="grant-revoke">
                  <summary class="btn btn-danger btn-sm"><Icon name="ph:x" width="14" height="14" /> {dt('Revoke')}</summary>
                  <form method="POST" data-no-dirty><input type="hidden" name="action" value="revoke" /><input type="hidden" name="entitlement_id" value={grant.id} /><p>{dt('Revoke this Premium now? The server slots are released.')}</p><button class="btn btn-danger btn-sm" type="submit">{dt('Yes, revoke it')}</button></form>
                </details>}
              </div>
            </article>;
          })}
        </div>}
      </div>
    </section>
  </main>
</Base>

<script>
  // The placeholder of the ID field follows the choice (labels and help follow it in CSS, so the page works without this).
  const form = document.querySelector<HTMLFormElement>('.give-form');
  const input = form?.querySelector<HTMLInputElement>('input[name="target_id"]');
  const sync = () => {
    if (!form || !input) return;
    const server = form.querySelector<HTMLInputElement>('input[name="target_type"][value="server"]')?.checked;
    input.placeholder = (server ? input.dataset.phServer : input.dataset.phUser) ?? '';
  };
  form?.addEventListener('change', sync);
  sync();
</script>

<style>
  .admin-log { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }.admin-log span { color: var(--text-dim); font-size: 12.5px; }
  .admin-sec { padding: 40px 0 96px; }.admin-wrap { max-width: 1120px; }
  .admin-alert { display:flex; align-items:flex-start; gap:9px; padding:12px 14px; border-radius:12px; margin:12px 0; font-size:13.5px; animation:m-rise-in var(--m-slow) var(--m-out) both; }
  .admin-alert > :global(svg) { flex:0 0 auto; margin-top:2px; }
  .admin-alert span { min-width:0; overflow-wrap:anywhere; }
  .admin-alert.error { color:var(--red); background:var(--red-soft); border:1px solid color-mix(in srgb,var(--red) 55%,var(--border)); }
  .admin-alert.error.strong { border-width:2px; font-weight:600; }
  .admin-alert.warn { color:var(--text); background:var(--accent-soft); border:1px solid color-mix(in srgb,var(--accent) 45%,var(--border)); }
  .admin-alert.success { color:var(--green); background:var(--green-soft); border:1px solid color-mix(in srgb,var(--green) 55%,var(--border)); }
  .admin-flip { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; padding:12px 14px; border:1px solid var(--border); border-radius:12px; background:var(--card); margin:0 0 12px; }
  .admin-target { display:flex; align-items:center; gap:11px; min-width:0; }
  .admin-target img, .admin-target-ph { width:40px; height:40px; border-radius:50%; flex:0 0 auto; object-fit:cover; background:var(--accent-soft); }
  .admin-target-ph { display:grid; place-items:center; color:var(--accent); }
  .admin-target div { min-width:0; } .admin-target strong, .admin-target small { display:block; overflow-wrap:anywhere; }
  .admin-target small { color:var(--text-dim); font-size:12px; margin-top:2px; }
  .admin-target.big { padding:14px; border:1px solid var(--border); border-radius:14px; background:var(--bg-raise); margin-bottom:14px; }
  .admin-target.big img, .admin-target.big .admin-target-ph { width:52px; height:52px; }
  .admin-target.big strong { font-size:16px; }
  .kind { display:inline-block; padding:1px 8px; border-radius:99px; font-size:10.5px; font-weight:700; letter-spacing:.03em; text-transform:uppercase; background:var(--accent-soft); color:var(--accent); }
  .kind.server { background:color-mix(in srgb,var(--green) 16%,transparent); color:var(--green); }
  .admin-grid { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(min(260px, 100%),.8fr); gap:14px; margin-bottom:32px; }
  .admin-card { padding:22px; border:1px solid var(--border); border-radius:16px; background:var(--card); min-width:0; }
  .admin-card-head { display:flex; align-items:flex-start; gap:11px; margin-bottom:21px; color:var(--accent); }
  .admin-card-head > :global(svg) { flex:0 0 auto; }
  .admin-card-head h2 { margin:0 0 4px; color:var(--text); font-family:var(--serif); font-size:22px; }
  .admin-card-head p { margin:0; color:var(--text-dim); font-size:12px; }
  .admin-form { display:grid; gap:14px; }
  .admin-form label { display:grid; gap:6px; color:var(--text); font-size:13px; font-weight:600; }
  .admin-form small { color:var(--text-dim); font-weight:400; font-size:11.5px; line-height:1.45; }
  .admin-form input:not([type=radio]):not([type=checkbox]), .admin-form select { width:100%; box-sizing:border-box; padding:11px 12px; border:1px solid var(--border); border-radius:9px; background:var(--bg-raise); color:var(--text); font:inherit; font-size:13px; min-width:0; }
  .admin-form button { display:inline-flex; align-items:center; justify-content:center; gap:7px; margin-top:3px; }
  .admin-choice { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin:0; padding:0; border:0; min-width:0; }
  .admin-choice legend { padding:0; margin-bottom:6px; font-size:13px; font-weight:600; }
  .admin-choice label { position:relative; display:block; cursor:pointer; }
  .admin-choice input { position:absolute; opacity:0; inset:0; margin:0; cursor:pointer; }
