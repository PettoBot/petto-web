---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface Grant {
  id: number;
  user_id: string;
  plan_key: string;
  status: string;
  slot_limit: number;
  current_period_end: string | null;
  metadata: Record<string, unknown>;
  assignments: Array<{ guild_id: string; status: string }>;
}

interface Props {
  user: { username: string; avatar: string | null };
  grants: Grant[];
  error?: string;
  saved?: boolean;
  logged?: number | null;
}

const { grants, error, saved = false, logged = null } = Astro.props;
const targetLabel = (grant: Grant) => grant.metadata?.target_type === 'server' ? `Server ${grant.metadata.target_guild_id ?? 'unknown'}` : `User ${grant.user_id}`;
---

<Base title={dt('Premium controls · Petto')} active="dash" showFooter>
  <main>
    <section class="admin-sec">
      <div class="wrap admin-wrap">
        <div class="admin-head">
          <div>
            <div class="eyebrow"><Icon name="ph:crown-fill" width="14" height="14" /> {dt('Owner controls')}</div>
            <h1>{dt('Manual Premium grants')}</h1>
            <p>{dt('Give permanent Premium to a Discord user or activate it directly on a server. These grants do not create a Polar charge.')}</p>
          </div>
          <div class="admin-head-actions"><a class="btn btn-ghost btn-sm" href="/dash/admin/servers"><Icon name="ph:hard-drives-fill" width="14" height="14" /> {dt('All servers')}</a><a class="btn btn-ghost btn-sm" href="/dash/manage"><Icon name="ph:arrow-left" width="14" height="14" /> {dt('Back to servers')}</a></div>
        </div>

        {error === 'invalid' && <div class="admin-alert error"><Icon name="ph:warning-fill" width="17" height="17" /> {dt('Check the Discord IDs and the slot limit. IDs must be numeric Snowflakes.')}</div>}
        {error === 'database' && <div class="admin-alert error"><Icon name="ph:warning-fill" width="17" height="17" /> {dt('The private API could not save this grant. Check the dashboard API secret.')}</div>}
        {error === 'slot_conflict' && <div class="admin-alert error"><Icon name="ph:warning-fill" width="17" height="17" /> {dt('This grant already has more active servers than the new slot limit.')}</div>}
        {error === 'server_taken' && <div class="admin-alert error"><Icon name="ph:warning-fill" width="17" height="17" /> {dt('That server already has an active Premium owner.')}</div>}
        {error === 'log_not_configured' && <div class="admin-alert error"><Icon name="ph:warning-fill" width="17" height="17" /> {dt('Set PREMIUM_LOGS_WEBHOOK_URL in the website first: the webhook of the channel of the team.')}</div>}
        {error === 'log_database' && <div class="admin-alert error"><Icon name="ph:warning-fill" width="17" height="17" /> {dt('The list of active Premium could not be read from the database.')}</div>}
        {error === 'log_discord' && <div class="admin-alert error"><Icon name="ph:warning-fill" width="17" height="17" /> {dt('Discord did not accept the message. Check the webhook of the channel.')}</div>}
        {logged !== null && <div class="admin-alert success"><Icon name="ph:check-circle-fill" width="17" height="17" /> {dt('Sent to the channel of the team: {n} active.', { n: logged })}</div>}
        {saved && <div class="admin-alert success"><Icon name="ph:check-circle-fill" width="17" height="17" /> {dt('Premium grant saved permanently.')}</div>}

        <form method="POST" class="admin-log"><input type="hidden" name="action" value="premium_log" /><button class="btn btn-ghost btn-sm" type="submit"><Icon name="ph:megaphone-fill" width="14" height="14" /> {dt('Send the active Premium to the log channel')}</button><span>{dt('Lists what the database has, so you can check that the subscriptions of Polar arrived.')}</span></form>

        <div class="admin-grid">
          <article class="admin-card">
            <div class="admin-card-head"><Icon name="ph:gift-fill" width="20" height="20" /><div><h2>{dt('Give Premium')}</h2><p>{dt('Permanent until you revoke it.')}</p></div></div>
            <form method="POST" class="admin-form">
              <input type="hidden" name="action" value="grant" />
              <label>{dt('Grant type')}<select name="target_type"><option value="user">{dt('User account')}</option><option value="server">{dt('Server directly')}</option></select></label>
              <label><Fragment set:html={dth('User ID <span class="hint">required for user grants · optional for server grants</span>')} /><input name="user_id" inputmode="numeric" pattern="[0-9]{15,22}" placeholder={dt('Discord user ID')} /></label>
              <label><Fragment set:html={dth('Server ID <span class="hint">required for server grants</span>')} /><input name="guild_id" inputmode="numeric" pattern="[0-9]{15,22}" placeholder={dt('Discord server ID')} /></label>
              <label>{dt('Server slots')}<select name="slot_limit"><option value="1">{dt('1 server')}</option><option value="3">{dt('3 servers')}</option><option value="5">{dt('5 servers')}</option><option value="10">{dt('10 servers')}</option><option value="25">{dt('25 servers')}</option></select></label>
              <button class="btn btn-primary" type="submit"><Icon name="ph:crown-fill" width="15" height="15" /> {dt('Grant permanent Premium')}</button>
            </form>
            <p class="admin-note">{dt('A server grant uses your owner ID as the internal account when User ID is blank. The server is active immediately for the bot.')}</p>
          </article>

          <article class="admin-card admin-info-card">
            <div class="admin-card-head"><Icon name="ph:shield-check-fill" width="20" height="20" /><div><h2>{dt('Protected owner area')}</h2><p>{dt('Only the configured Petto owner can submit these actions.')}</p></div></div>
            <dl>
              <div><dt>{dt('Owner ID')}</dt><dd>293504726505357312</dd></div>
              <div><dt>{dt('Storage')}</dt><dd>{dt('Discloud PostgreSQL · premium_entitlements')}</dd></div>
              <div><dt>{dt('Billing')}</dt><dd>{dt('Manual grant · no Polar charge')}</dd></div>
            </dl>
          </article>
        </div>

        <div class="admin-list-head"><div><h2>{dt('Manual grants')}</h2><p>{dt('Active grants stay permanent until revoked here.')}</p></div></div>
        {grants.length === 0 ? <div class="admin-empty">{dt('No manual grants yet.')}</div> : <div class="admin-grants">
          {grants.map((grant) => <article class:list={['grant-row', { revoked: grant.status !== 'active' }]}>
            <div class="grant-icon"><Icon name="ph:crown-fill" width="18" height="18" /></div>
            <div class="grant-main"><strong>{targetLabel(grant)}</strong><span>{dt('{a} server slot{b} · {c}', { a: (grant.slot_limit), b: (grant.slot_limit === 1 ? '' : 's'), c: (grant.status === 'active' ? 'Permanent active' : 'Revoked') })}</span>{grant.assignments.filter((a) => a.status === 'active').length > 0 && <small>Assigned: {grant.assignments.filter((a) => a.status === 'active').map((a) => a.guild_id).join(', ')}</small>}</div>
            {grant.status === 'active' && <form method="POST"><input type="hidden" name="action" value="revoke" /><input type="hidden" name="entitlement_id" value={grant.id} /><button class="btn btn-danger btn-sm" type="submit"><Icon name="ph:x" width="14" height="14" /> {dt('Revoke')}</button></form>}
          </article>)}
        </div>}
      </div>
    </section>
  </main>
</Base>

<style>
  .admin-log { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }.admin-log span { color: var(--text-dim); font-size: 12.5px; }
  .admin-sec { padding: 54px 0 96px; }.admin-wrap { max-width: 1120px; }.admin-head { display:flex; justify-content:space-between; align-items:end; gap:25px; margin-bottom:34px; }.admin-head .eyebrow { display:flex; align-items:center; gap:7px; color:var(--accent); }.admin-head h1 { margin:9px 0 10px; font-family:var(--serif); font-size:clamp(32px,5vw,54px); line-height:1.04; }.admin-head p { max-width:680px; margin:0; color:var(--text-muted); font-size:15px; }.admin-head .btn { display:inline-flex; align-items:center; gap:6px; white-space:nowrap; }.admin-alert { display:flex; align-items:center; gap:9px; padding:13px 15px; border-radius:12px; margin:12px 0; font-size:14px; }.admin-alert.error { color:var(--red); background:var(--red-soft); border:1px solid color-mix(in srgb,var(--red) 55%,var(--border)); }.admin-alert.success { color:var(--green); background:var(--green-soft); border:1px solid color-mix(in srgb,var(--green) 55%,var(--border)); }.admin-grid { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(min(260px, 100%),.8fr); gap:14px; margin-bottom:45px; }.admin-card { padding:22px; border:1px solid var(--border); border-radius:16px; background:var(--card); }.admin-card-head { display:flex; align-items:flex-start; gap:11px; margin-bottom:21px; color:var(--accent); }.admin-card-head h2 { margin:0 0 4px; color:var(--text); font-family:var(--serif); font-size:22px; }.admin-card-head p { margin:0; color:var(--text-dim); font-size:12px; }.admin-form { display:grid; gap:14px; }.admin-form label { display:grid; gap:6px; color:var(--text); font-size:13px; font-weight:600; }.admin-form :global(.hint){ color:var(--text-dim); font-weight:400; font-size:11px; }.admin-form input,.admin-form select { width:100%; box-sizing:border-box; padding:11px 12px; border:1px solid var(--border); border-radius:9px; background:var(--bg-raise); color:var(--text); font:inherit; font-size:13px; }.admin-form button { display:inline-flex; align-items:center; justify-content:center; gap:7px; margin-top:3px; }.admin-note { margin:18px 0 0; color:var(--text-dim); font-size:11px; line-height:1.5; }.admin-info-card dl { display:grid; gap:14px; margin:30px 0 0; }.admin-info-card dl div { padding-bottom:13px; border-bottom:1px solid var(--border-soft); }.admin-info-card dt { color:var(--text-dim); font-family:var(--mono); font-size:10px; text-transform:uppercase; letter-spacing:.05em; }.admin-info-card dd { margin:5px 0 0; color:var(--text); font-size:13px; word-break:break-word; }.admin-list-head { margin-bottom:15px; }.admin-list-head h2 { margin:0 0 4px; font-family:var(--serif); font-size:25px; }.admin-list-head p { margin:0; color:var(--text-dim); font-size:13px; }.admin-empty { padding:25px; border:1px dashed var(--border); border-radius:14px; color:var(--text-dim); text-align:center; font-size:13px; }.admin-grants { display:grid; gap:10px; }.grant-row { display:flex; align-items:center; gap:13px; padding:14px 16px; border:1px solid var(--border); border-radius:13px; background:var(--card); }.grant-row.revoked { opacity:.55; }.grant-icon { display:grid; place-items:center; width:38px; height:38px; border-radius:11px; background:var(--accent-soft); color:var(--accent); flex:0 0 auto; }.grant-main { min-width:0; flex:1; }.grant-main strong,.grant-main :global(span),.grant-main small { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.grant-main strong { font-size:14px; }.grant-main :global(span),.grant-main small { margin-top:3px; color:var(--text-dim); font-size:11px; }.grant-main small { font-family:var(--mono); }.grant-row form { margin:0; }.btn-danger { display:inline-flex; align-items:center; gap:5px; color:var(--red); border-color:color-mix(in srgb,var(--red) 55%,var(--border)); }.btn-danger:hover { background:var(--red-soft); }
  .admin-head-actions { display:flex; gap:8px; flex-wrap:wrap; }
  @media (max-width:760px) { .admin-head-actions { width:100%; }.admin-head-actions .btn { flex:1 1 100%; } .admin-sec { padding:28px 0 60px; }.admin-head { align-items:flex-start; flex-direction:column; }.admin-head .btn { width:100%; justify-content:center; }.admin-grid { grid-template-columns:minmax(0,1fr); }.admin-card { min-width:0; }.grant-row { align-items:flex-start; flex-wrap:wrap; min-width:0; }.grant-main { flex:1 1 calc(100% - 51px); }.grant-main strong,.grant-main :global(span),.grant-main small { white-space:normal; overflow-wrap:anywhere; }.grant-row form { flex:1 1 100%; width:100%; margin:0; }.grant-row form .btn { width:100%; justify-content:center; box-sizing:border-box; } }
</style>
