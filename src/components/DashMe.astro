---
// The overview of the profile dash (/dash/me): what Petto and Discord really know about the account. Nothing is invented: a figure that
// is not there is not drawn, and a card with nothing to say shows a short empty state.
import { Icon } from 'astro-icon/components';
import InlineIcon from './InlineIcon.astro';
import DashMeLayout from './DashMeLayout.astro';
import { dashLocale, getDashLang, makeT } from '../i18n/dash';
import { guildIconUrl } from '../utils/discord';
import type { Session } from '../utils/session';
import type { profileOverview } from '../utils/dashProfile.mjs';

interface Props { user: Session; overview: ReturnType<typeof profileOverview>; unavailable?: boolean }
const { user, overview, unavailable = false } = Astro.props;
const lang = getDashLang(Astro);
const dt = makeT(lang);
const locale = dashLocale(lang);
const date = (iso: string | null) => (iso ? new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(iso)) : null);
const statusLabel: Record<string, string> = { active: dt('Active'), pending: dt('Pending'), past_due: dt('Past due'), canceled: dt('Canceled'), expired: dt('Expired'), free: dt('Free') };
const { servers, premium, settings } = overview;
const premiumNote = premium.status === 'active'
  ? [premium.slotsTotal ? dt('{a} of {b} slots used', { a: premium.slotsUsed, b: premium.slotsTotal }) : null, premium.endsAt ? dt('Active until {d}', { d: date(premium.endsAt) }) : null].filter(Boolean).join(' · ')
  : '';
const stats = [
  { icon: 'ph:hard-drives-fill', label: dt('Servers you manage'), value: String(servers.managed.toLocaleString(locale)) },
  { icon: 'ph:check-circle-fill', label: dt('With Petto'), value: String(servers.withPetto.toLocaleString(locale)) },
  { icon: 'ph:crown-fill', label: 'Premium', value: statusLabel[premium.status] ?? premium.status, note: premiumNote },
  { icon: 'ph:calendar-check-fill', label: dt('On Discord since'), value: date(overview.created) ?? '—' },
];
---
<DashMeLayout user={user} active="overview" pageTitle="Overview">
  <header class="dm-head">
    <h1>{dt('Welcome back, {a}', { a: overview.name || user.username })}</h1>
    <p>{dt('Your Discord account, your servers and your Premium in one place.')}{overview.handle && <span class="dm-handle"> @{overview.handle}</span>}</p>
  </header>

  <div class="dm-stats">
    {stats.map((stat) => (
      <div class="dm-stat">
        <Icon name={stat.icon} width="44" height="44" class="dm-stat-icon" />
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
        {stat.note && <small>{stat.note}</small>}
      </div>
    ))}
  </div>

  <div class="dm-grid">
    <section class="dm-card dm-card-wide">
      <div class="dm-card-head"><h2>{dt('Your servers')}</h2><a href="/dash/manage">{dt('See all')}</a></div>
      {servers.top.length > 0 ? (
        <ul class="dm-servers">
          {servers.top.map((g: any) => (
            <li>
              <a href={`/dash/guild/${g.id}/overview`}>
                {g.icon ? <img src={g.icon} alt="" width="36" height="36" loading="lazy" referrerpolicy="no-referrer" /> : <span class="dm-sv-fallback"><Icon name="ph:buildings-fill" width="16" height="16" /></span>}
                <span class="dm-sv-name">{g.name}</span>
                {g.premium && <span class="dm-sv-premium"><InlineIcon name="ph:crown-fill" width="11" height="11" />Premium</span>}
                <Icon name="ph:caret-right-bold" width="13" height="13" class="dm-sv-go" />
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="dm-empty">{unavailable ? dt('Discord did not answer in time. Reload in a few seconds to load your servers.') : dt('Petto is not in any of your servers yet.')}</p>
      )}
    </section>

    <section class="dm-card">
      <div class="dm-card-head"><h2>Premium</h2></div>
      <p class="dm-premium-state"><span class:list={['dm-pill', `is-${premium.status}`]}>{statusLabel[premium.status] ?? premium.status}</span></p>
      {premiumNote ? <p class="dm-muted">{premiumNote}</p> : <p class="dm-muted">{dt('Unlock the paid modules and the custom look for your servers.')}</p>}
      <a class="btn btn-ghost btn-sm dm-btn" href="/dash/premium"><Icon name="ph:crown-fill" width="13" height="13" /> {dt('Manage Premium')}</a>
    </section>

    <section class="dm-card">
      <div class="dm-card-head"><h2>{dt('Your settings')}</h2></div>
      {settings.prefix || settings.reputation ? (
        <dl class="dm-rows">
          {settings.prefix && <div><dt>{dt('Personal prefix')}</dt><dd><code>{settings.prefix}</code></dd></div>}
          {settings.reputation && <div><dt>{dt('Reputation')}</dt><dd>{settings.reputation.points.toLocaleString(locale)}<small>{settings.reputation.servers === 1 ? dt('In 1 server') : dt('In {a} servers', { a: settings.reputation.servers })}</small></dd></div>}
        </dl>
      ) : (
        <p class="dm-empty">{dt('Nothing set yet. Your own prefix and your reputation show up here.')}</p>
      )}
    </section>
  </div>
</DashMeLayout>

<style>
  .dm-head h1 { margin: 0; font-family: var(--serif); font-size: clamp(26px, 4.4vw, 38px); line-height: 1.08; overflow-wrap: anywhere; }
  .dm-head p { margin: 8px 0 0; color: var(--text-muted); font-size: 15px; }
  .dm-handle { color: var(--text-dim); font-family: var(--mono); font-size: 13px; white-space: nowrap; }
  .dm-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-top: 22px; }
  .dm-stat { position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 3px; padding: 16px 16px 15px; border: 1px solid var(--border-soft); border-radius: 16px; background: color-mix(in srgb, var(--text) 3%, transparent); min-width: 0; }
  .dm-stat strong { font-family: var(--serif); font-size: 26px; line-height: 1.1; font-weight: 600; color: var(--text); overflow-wrap: anywhere; }
  .dm-stat:nth-child(4) strong { font-size: 18px; line-height: 1.35; }
  .dm-stat span { color: var(--text-muted); font-size: 13px; }
  .dm-stat small { color: var(--text-dim); font-size: 12px; line-height: 1.35; }
  .dm-stat :global(.dm-stat-icon) { position: absolute; right: -6px; bottom: -8px; color: var(--accent); opacity: .12; transform: rotate(-12deg); }
  .dm-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 12px; }
  .dm-card { min-width: 0; padding: 16px 18px 18px; border: 1px solid var(--border-soft); border-radius: 16px; background: color-mix(in srgb, var(--text) 2%, transparent); }
  .dm-card-wide { grid-column: 1 / -1; }
  .dm-card-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
  .dm-card-head h2 { margin: 0; font-size: 15px; font-weight: 700; }
  .dm-card-head a { font-size: 12.5px; color: var(--accent); text-decoration: none; }
  .dm-card-head a:hover { text-decoration: underline; }
  .dm-servers { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 10px; }
  .dm-servers a { display: flex; align-items: center; gap: 11px; padding: 7px 9px; border-radius: 12px; color: var(--text); text-decoration: none; transition: background-color var(--m-fast) ease; }
  .dm-servers a:hover { background: var(--card-hover); }
  .dm-servers img, .dm-sv-fallback { flex: none; width: 36px; height: 36px; border-radius: 11px; object-fit: cover; background: var(--bg-raise); }
  .dm-sv-fallback { display: grid; place-items: center; color: var(--text-dim); }
  .dm-sv-name { flex: 1; min-width: 0; font-size: 14px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dm-sv-premium { display: inline-flex; align-items: center; gap: 4px; flex: none; color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border: 1px solid color-mix(in srgb, var(--yellow) 42%, var(--border)); border-radius: 999px; font-family: var(--mono); font-size: 9px; font-weight: 700; line-height: 1; padding: 4px 6px; }
  .dm-servers :global(.dm-sv-go) { flex: none; color: var(--text-dim); }
  .dm-empty { margin: 2px 0 0; color: var(--text-muted); font-size: 13.5px; }
  .dm-muted { margin: 8px 0 14px; color: var(--text-muted); font-size: 13.5px; line-height: 1.45; }
  .dm-premium-state { margin: 0; }
  .dm-pill { display: inline-flex; align-items: center; padding: 4px 11px; border-radius: 999px; font-size: 12.5px; font-weight: 700; color: var(--text-muted); background: color-mix(in srgb, var(--text) 6%, transparent); border: 1px solid var(--border-soft); }
  .dm-pill.is-active { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: color-mix(in srgb, var(--yellow) 42%, var(--border)); }
  .dm-pill.is-past_due, .dm-pill.is-expired { color: var(--red); background: var(--red-soft); border-color: color-mix(in srgb, var(--red) 40%, var(--border)); }
  .dm-btn { display: inline-flex; align-items: center; gap: 6px; }
  .dm-rows { margin: 0; display: grid; gap: 10px; }
  .dm-rows div { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding-bottom: 9px; border-bottom: 1px solid var(--border-soft); }
  .dm-rows div:last-child { border-bottom: 0; padding-bottom: 0; }
  .dm-rows dt { color: var(--text-muted); font-size: 13.5px; }
  .dm-rows dd { margin: 0; font-weight: 700; font-size: 15px; text-align: right; }
  .dm-rows dd small { display: block; color: var(--text-dim); font-weight: 400; font-size: 12px; }
  .dm-rows code { font-family: var(--mono); padding: 2px 8px; border-radius: 7px; background: var(--accent-soft); color: var(--accent); }
  @media (max-width: 1100px) { .dm-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 720px) { .dm-grid, .dm-servers { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 480px) { .dm-stats { gap: 8px; } .dm-stat { padding: 13px 12px 12px; } .dm-stat strong { font-size: 22px; } .dm-stat:nth-child(4) strong { font-size: 15px; } .dm-stat span { font-size: 12.5px; } .dm-stat small { font-size: 11.5px; } }
</style>
