---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';

interface Stat {
  icon: string;
  label: string;
  value: string;
  color: string;
}
interface ModuleItem { label: string; value: string; ok: boolean; }
interface Module { title: string; href: string; items: ModuleItem[]; }

interface ActivityPoint { label: string; messages: number; reactions: number; }
interface TopChannel { name: string; color: string; count: number; pct: number; deltaPct: number | null; }
interface Activity {
  range: 'day' | 'week' | 'month' | 'year';
  hasData: boolean;
  points: ActivityPoint[];
  messagesSpark: number[];
  reactionsSpark: number[];
  voiceSpark: number[];
  totalMessages: number;
  totalReactions: number;
  totalVoiceHours: number;
  activeChannels: number;
  messagesDeltaPct: number | null;
  reactionsDeltaPct: number | null;
  topMessageChannels: TopChannel[];
  topReactionChannels: TopChannel[];
}

interface ModPoint { label: string; bans: number; other: number; }
interface Moderation {
  hasData: boolean;
  points: ModPoint[];
  totals: { bans: number; other: number };
  totalActions: number;
  deltaPct: number | null;
}

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  stats: Stat[];
  modules: Module[];
  activity: Activity;
  moderation: Moderation;
}
const { user, guildId, guildName, guildIcon, stats, modules, activity, moderation } = Astro.props;

const CHART_W = 760;
const CHART_H = 180;
const maxVal = Math.max(1, ...activity.points.map((p) => Math.max(p.messages, p.reactions)));
const singlePoint = activity.points.length === 1;

const SPARK_W = 120;
const SPARK_H = 32;
function sparkPath(values: number[]) {
  if (values.length < 2) return '';
  const max = Math.max(1, ...values);
  return values
    .map((v, i) => {
      const x = (i / (values.length - 1)) * SPARK_W;
      const y = SPARK_H - (v / max) * (SPARK_H - 4) - 2;
      return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(' ');
}
const messagesSparkPath = sparkPath(activity.messagesSpark);
const reactionsSparkPath = sparkPath(activity.reactionsSpark);
const voiceSparkPath = sparkPath(activity.voiceSpark);

// Catmull-Rom → cubic Bezier, gives the line a gentle curve through every point instead of
// straight segments. Control points are clamped to each segment's own [min,max] y-range, so a
// sharp spike in the data (small counts jumping 1→6→1) can never make the curve overshoot past
// its own endpoints, a plain Catmull-Rom does exactly that and produces wild, off-chart shapes.
function smoothPath(pts: { x: number; y: number }[]) {
  if (pts.length < 2) return '';
  if (pts.length === 2) return `M${pts[0].x.toFixed(1)},${pts[0].y.toFixed(1)} L${pts[1].x.toFixed(1)},${pts[1].y.toFixed(1)}`;
  let d = `M${pts[0].x.toFixed(1)},${pts[0].y.toFixed(1)}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i === 0 ? 0 : i - 1];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2 < pts.length ? i + 2 : i + 1];
    let c1x = p1.x + (p2.x - p0.x) / 6;
    let c1y = p1.y + (p2.y - p0.y) / 6;
    let c2x = p2.x - (p3.x - p1.x) / 6;
    let c2y = p2.y - (p3.y - p1.y) / 6;
    const yLo = Math.min(p1.y, p2.y);
    const yHi = Math.max(p1.y, p2.y);
    c1y = Math.max(yLo, Math.min(yHi, c1y));
    c2y = Math.max(yLo, Math.min(yHi, c2y));
    d += ` C${c1x.toFixed(1)},${c1y.toFixed(1)} ${c2x.toFixed(1)},${c2y.toFixed(1)} ${p2.x.toFixed(1)},${p2.y.toFixed(1)}`;
  }
  return d;
}

function pointsFor(key: 'messages' | 'reactions') {
  const n = activity.points.length;
  return activity.points.map((p, i) => {
    const x = n === 1 ? CHART_W / 2 : (i / (n - 1)) * CHART_W;
    const y = CHART_H - (p[key] / maxVal) * (CHART_H - 10) - 5;
    return { x, y };
  });
}

function pathFor(key: 'messages' | 'reactions') {
  return smoothPath(pointsFor(key));
}
function areaFor(key: 'messages' | 'reactions') {
  const pts = pointsFor(key);
  if (pts.length < 2) return '';
  return `${smoothPath(pts)} L${pts[pts.length - 1].x.toFixed(1)},${CHART_H} L${pts[0].x.toFixed(1)},${CHART_H} Z`;
}
const messagesPath = pathFor('messages');
const reactionsPath = pathFor('reactions');
const messagesArea = areaFor('messages');
const reactionsArea = areaFor('reactions');
const messagesPts = pointsFor('messages');
const reactionsPts = pointsFor('reactions');
const messagesDot = singlePoint ? messagesPts[0] : null;
const reactionsDot = singlePoint ? reactionsPts[0] : null;

function formatLabel(iso: string) {
  return new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
}
const hoverPoints = activity.points.map((p) => ({ messages: p.messages, reactions: p.reactions, displayLabel: formatLabel(p.label) }));

// Show every date up to 20 points (week/month views), only thin them out past that (year view,
// ~52 weekly buckets) where labeling every single one would just overlap into unreadable mush.
const AXIS_LABEL_COUNT = 20;
const n = activity.points.length;
const axisLabelCount = Math.min(AXIS_LABEL_COUNT, n);
const axisLabels =
  axisLabelCount > 1
    ? [...new Set(Array.from({ length: axisLabelCount }, (_, i) => Math.round((i * (n - 1)) / (axisLabelCount - 1))))].map((i) => ({
        pct: (i / (n - 1)) * 100,
        text: formatLabel(activity.points[i].label),
      }))
    : [];

const yTicks = [1, 0.75, 0.5, 0.25, 0].map((f) => Math.round(maxVal * f));

// ── Moderation chart: same geometry approach as the activity chart above, own scale ──
const modMaxVal = Math.max(1, ...moderation.points.map((p) => Math.max(p.bans, p.other)));
const modSinglePoint = moderation.points.length === 1;
function modPointsFor(key: 'bans' | 'other') {
  const n = moderation.points.length;
  return moderation.points.map((p, i) => {
    const x = n === 1 ? CHART_W / 2 : (i / (n - 1)) * CHART_W;
    const y = CHART_H - (p[key] / modMaxVal) * (CHART_H - 10) - 5;
    return { x, y };
  });
}
function modPathFor(key: 'bans' | 'other') {
  return smoothPath(modPointsFor(key));
}
function modAreaFor(key: 'bans' | 'other') {
  const pts = modPointsFor(key);
  if (pts.length < 2) return '';
  return `${smoothPath(pts)} L${pts[pts.length - 1].x.toFixed(1)},${CHART_H} L${pts[0].x.toFixed(1)},${CHART_H} Z`;
}
const bansPath = modPathFor('bans');
const otherPath = modPathFor('other');
const bansArea = modAreaFor('bans');
const otherArea = modAreaFor('other');
const bansPts = modPointsFor('bans');
const otherPts = modPointsFor('other');
const bansDot = modSinglePoint ? bansPts[0] : null;
const otherDot = modSinglePoint ? otherPts[0] : null;

const modHoverPoints = moderation.points.map((p) => ({ bans: p.bans, other: p.other, displayLabel: formatLabel(p.label) }));
const modN = moderation.points.length;
const modAxisLabelCount = Math.min(AXIS_LABEL_COUNT, modN);
const modAxisLabels =
  modAxisLabelCount > 1
    ? [...new Set(Array.from({ length: modAxisLabelCount }, (_, i) => Math.round((i * (modN - 1)) / (modAxisLabelCount - 1))))].map((i) => ({
        pct: (i / (modN - 1)) * 100,
        text: formatLabel(moderation.points[i].label),
      }))
    : [];
const modYTicks = [1, 0.75, 0.5, 0.25, 0].map((f) => Math.round(modMaxVal * f));

const totalEngagement = activity.totalMessages + activity.totalReactions;
const prevEngagement =
  activity.messagesDeltaPct !== null || activity.reactionsDeltaPct !== null
    ? Math.round(activity.totalMessages / (1 + (activity.messagesDeltaPct ?? 0) / 100)) + Math.round(activity.totalReactions / (1 + (activity.reactionsDeltaPct ?? 0) / 100))
    : null;
const engagementDeltaPct = prevEngagement && prevEngagement > 0 ? ((totalEngagement - prevEngagement) / prevEngagement) * 100 : null;

function fmtDelta(pct: number | null) {
  if (pct === null) return null;
  const sign = pct >= 0 ? '+' : '';
  return `${sign}${pct.toFixed(0)}%`;
}
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="overview" pageTitle="Overview">
  <div class="dgo-head">
    <div>
      <h1>Hello, {user.username}</h1>
      <p class="dgo-sub">Here's a quick overview of the activity in <b>{guildName}</b>.</p>
    </div>
    <div class="dgo-range">
      <a href="?range=day" class:list={{ active: activity.range === 'day' }}>Day</a>
      <a href="?range=week" class:list={{ active: activity.range === 'week' }}>Week</a>
      <a href="?range=month" class:list={{ active: activity.range === 'month' }}>Month</a>
      <a href="?range=year" class:list={{ active: activity.range === 'year' }}>Year</a>
    </div>
  </div>

  {!activity.hasData ? (
    <div class="dgo-empty">
      <Icon name="ph:chart-line-fill" width="20" height="20" />
      <div>
        <div class="dgo-empty-t">No activity tracked yet</div>
        <p>Petto started counting messages, reactions and voice time recently, come back once there's been some activity to chart.</p>
      </div>
    </div>
  ) : (
    <>
      <div class="dgo-chart-card">
        <div class="dgo-chart-head">
          <div class="dgo-chart-eyebrow">Total engagement</div>
          <div class="dgo-chart-big">{totalEngagement.toLocaleString()}</div>
          {fmtDelta(engagementDeltaPct) && <div class:list={['dgo-metric-delta', { down: (engagementDeltaPct ?? 0) < 0 }]}>{fmtDelta(engagementDeltaPct)} vs previous period</div>}
        </div>
        <div class="dgo-chart-row">
          <div class="dgo-chart-axis">
            {yTicks.map((v) => <span>{v.toLocaleString()}</span>)}
          </div>
          <div class="dgo-chart-wrap" id="dgo-chart-wrap">
            <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} preserveAspectRatio="none" class="dgo-chart" id="dgo-chart-svg">
              <defs>
                <linearGradient id="dgo-grad-messages" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.32" />
                  <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
                </linearGradient>
                <linearGradient id="dgo-grad-reactions" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#f78fb3" stop-opacity="0.28" />
                  <stop offset="100%" stop-color="#f78fb3" stop-opacity="0" />
                </linearGradient>
              </defs>
              {[0.25, 0.5, 0.75].map((f) => <line x1="0" x2={CHART_W} y1={CHART_H * f} y2={CHART_H * f} class="dgo-gridline" />)}
              <path d={messagesArea} fill="url(#dgo-grad-messages)" stroke="none" class="dgo-area" />
              <path d={reactionsArea} fill="url(#dgo-grad-reactions)" stroke="none" class="dgo-area" />
              <path d={messagesPath} pathLength="1" class="dgo-line dgo-line-messages" />
              <path d={reactionsPath} pathLength="1" class="dgo-line dgo-line-reactions" style="animation-delay:0.15s" />
              {messagesPts.map((p, i) => <circle cx={p.x} cy={p.y} r="3" class="dgo-marker dgo-marker-messages" style={`animation-delay:${0.5 + i * 0.03}s`} />)}
              {reactionsPts.map((p, i) => <circle cx={p.x} cy={p.y} r="3" class="dgo-marker dgo-marker-reactions" style={`animation-delay:${0.55 + i * 0.03}s`} />)}
            </svg>
            <div id="dgo-hover-guide" class="dgo-hover-guide"></div>
            <div id="dgo-hover-dot-messages" class="dgo-hdot dgo-hdot-messages"></div>
            <div id="dgo-hover-dot-reactions" class="dgo-hdot dgo-hdot-reactions"></div>
            {messagesDot && <div class="dgo-hdot dgo-hdot-messages" style={`left:${(messagesDot.x / CHART_W) * 100}%;top:${(messagesDot.y / CHART_H) * 100}%`} />}
            {reactionsDot && <div class="dgo-hdot dgo-hdot-reactions" style={`left:${(reactionsDot.x / CHART_W) * 100}%;top:${(reactionsDot.y / CHART_H) * 100}%`} />}
            {!singlePoint && (
              <div class="dgo-tooltip" id="dgo-tooltip">
                <div class="dgo-tt-date" id="dgo-tt-date"></div>
                <div class="dgo-tt-row"><i class="dgo-dot dgo-dot-messages"></i><span id="dgo-tt-messages"></span> messages</div>
                <div class="dgo-tt-row"><i class="dgo-dot dgo-dot-reactions"></i><span id="dgo-tt-reactions"></span> reactions</div>
              </div>
            )}
          </div>
        </div>
        {!singlePoint && (
          <div class="dgo-chart-dates">
            {axisLabels.map((l, i) => (
              <span
                class:list={{ first: i === 0, last: i === axisLabels.length - 1 }}
                style={i > 0 && i < axisLabels.length - 1 ? `left:${l.pct}%` : undefined}
              >
                {l.text}
              </span>
            ))}
          </div>
        )}
        {singlePoint && <p class="dgo-chart-note">Just one day tracked so far, the line fills in as more days come in.</p>}
        <div class="dgo-legend">
          <span><i class="dgo-dot dgo-dot-messages"></i>Messages</span>
          <span><i class="dgo-dot dgo-dot-reactions"></i>Reactions</span>
        </div>
      </div>

      {moderation.hasData && (
        <div class="dgo-chart-card">
          <div class="dgo-chart-head">
            <div class="dgo-chart-eyebrow">Moderation actions</div>
            <div class="dgo-chart-big">{moderation.totalActions.toLocaleString()}</div>
            {fmtDelta(moderation.deltaPct) && <div class:list={['dgo-metric-delta', { down: (moderation.deltaPct ?? 0) < 0 }]}>{fmtDelta(moderation.deltaPct)} vs previous period</div>}
          </div>
          <div class="dgo-chart-row">
            <div class="dgo-chart-axis">
              {modYTicks.map((v) => <span>{v.toLocaleString()}</span>)}
            </div>
            <div class="dgo-chart-wrap" id="dgo-mod-chart-wrap">
              <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} preserveAspectRatio="none" class="dgo-chart" id="dgo-mod-chart-svg">
                <defs>
                  <linearGradient id="dgo-grad-bans" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="var(--red)" stop-opacity="0.32" />
                    <stop offset="100%" stop-color="var(--red)" stop-opacity="0" />
                  </linearGradient>
                  <linearGradient id="dgo-grad-other" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.28" />
                    <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
                  </linearGradient>
                </defs>
                {[0.25, 0.5, 0.75].map((f) => <line x1="0" x2={CHART_W} y1={CHART_H * f} y2={CHART_H * f} class="dgo-gridline" />)}
                <path d={bansArea} fill="url(#dgo-grad-bans)" stroke="none" class="dgo-area" />
                <path d={otherArea} fill="url(#dgo-grad-other)" stroke="none" class="dgo-area" />
                <path d={bansPath} pathLength="1" class="dgo-line dgo-line-bans" />
                <path d={otherPath} pathLength="1" class="dgo-line dgo-line-other" style="animation-delay:0.15s" />
                {bansPts.map((p, i) => <circle cx={p.x} cy={p.y} r="3" class="dgo-marker dgo-marker-bans" style={`animation-delay:${0.5 + i * 0.03}s`} />)}
                {otherPts.map((p, i) => <circle cx={p.x} cy={p.y} r="3" class="dgo-marker dgo-marker-other" style={`animation-delay:${0.55 + i * 0.03}s`} />)}
              </svg>
              <div id="dgo-mod-hover-guide" class="dgo-hover-guide"></div>
              <div id="dgo-mod-hover-dot-bans" class="dgo-hdot dgo-hdot-bans"></div>
              <div id="dgo-mod-hover-dot-other" class="dgo-hdot dgo-hdot-other"></div>
              {bansDot && <div class="dgo-hdot dgo-hdot-bans" style={`left:${(bansDot.x / CHART_W) * 100}%;top:${(bansDot.y / CHART_H) * 100}%`} />}
              {otherDot && <div class="dgo-hdot dgo-hdot-other" style={`left:${(otherDot.x / CHART_W) * 100}%;top:${(otherDot.y / CHART_H) * 100}%`} />}
              {!modSinglePoint && (
                <div class="dgo-tooltip" id="dgo-mod-tooltip">
                  <div class="dgo-tt-date" id="dgo-mod-tt-date"></div>
                  <div class="dgo-tt-row"><i class="dgo-dot dgo-dot-bans"></i><span id="dgo-mod-tt-bans"></span> bans</div>
                  <div class="dgo-tt-row"><i class="dgo-dot dgo-dot-other"></i><span id="dgo-mod-tt-other"></span> other actions</div>
                </div>
              )}
            </div>
          </div>
          {!modSinglePoint && (
            <div class="dgo-chart-dates">
              {modAxisLabels.map((l, i) => (
                <span
                  class:list={{ first: i === 0, last: i === modAxisLabels.length - 1 }}
                  style={i > 0 && i < modAxisLabels.length - 1 ? `left:${l.pct}%` : undefined}
                >
                  {l.text}
                </span>
              ))}
            </div>
          )}
          {modSinglePoint && <p class="dgo-chart-note">Just one day tracked so far, the line fills in as more days come in.</p>}
          <div class="dgo-legend">
            <span><i class="dgo-dot dgo-dot-bans"></i>Bans</span>
            <span><i class="dgo-dot dgo-dot-other"></i>Other actions (kicks, mutes, warns)</span>
          </div>
        </div>
      )}

      {moderation.hasData && !modSinglePoint && (
        <script is:inline define:vars={{ points: modHoverPoints, chartW: CHART_W, chartH: CHART_H }}>
          (function () {
            const wrap = document.getElementById('dgo-mod-chart-wrap');
            const svg = document.getElementById('dgo-mod-chart-svg');
            const guide = document.getElementById('dgo-mod-hover-guide');
            const dotBans = document.getElementById('dgo-mod-hover-dot-bans');
            const dotOther = document.getElementById('dgo-mod-hover-dot-other');
            const tooltip = document.getElementById('dgo-mod-tooltip');
            const ttDate = document.getElementById('dgo-mod-tt-date');
            const ttBans = document.getElementById('dgo-mod-tt-bans');
            const ttOther = document.getElementById('dgo-mod-tt-other');
            if (!wrap || !svg || !guide || points.length < 2) return;

            const maxVal = Math.max(1, ...points.map((p) => Math.max(p.bans, p.other)));
            const n = points.length;
            const yFor = (v) => chartH - (v / maxVal) * (chartH - 10) - 5;
            const xFor = (i) => (i / (n - 1)) * chartW;

            function show(e) {
              const wrapRect = wrap.getBoundingClientRect();
              const relX = ((e.clientX - wrapRect.left) / wrapRect.width) * chartW;
              let idx = Math.round((relX / chartW) * (n - 1));
              idx = Math.max(0, Math.min(n - 1, idx));
              const p = points[idx];
              const xPct = (xFor(idx) / chartW) * 100;
              const yBansPct = (yFor(p.bans) / chartH) * 100;
              const yOtherPct = (yFor(p.other) / chartH) * 100;

              guide.style.left = `${xPct}%`;
              guide.style.opacity = '1';
              dotBans.style.left = `${xPct}%`;
              dotBans.style.top = `${yBansPct}%`;
              dotBans.style.opacity = '1';
              dotOther.style.left = `${xPct}%`;
              dotOther.style.top = `${yOtherPct}%`;
              dotOther.style.opacity = '1';

              if (tooltip) {
                ttDate.textContent = p.displayLabel;
                ttBans.textContent = p.bans.toLocaleString();
                ttOther.textContent = p.other.toLocaleString();
                const pxX = (xFor(idx) / chartW) * wrapRect.width;
                let left = pxX + 14;
                if (left + 150 > wrapRect.width) left = pxX - 164;
                tooltip.style.left = `${left}px`;
                tooltip.classList.add('show');
              }
            }
            function hide() {
              guide.style.opacity = '0';
              dotBans.style.opacity = '0';
              dotOther.style.opacity = '0';
              if (tooltip) tooltip.classList.remove('show');
            }
            svg.addEventListener('pointermove', show);
            svg.addEventListener('pointerleave', hide);
          })();
        </script>
      )}

      {!singlePoint && (
        <script is:inline define:vars={{ points: hoverPoints, chartW: CHART_W, chartH: CHART_H }}>
          (function () {
            const wrap = document.getElementById('dgo-chart-wrap');
            const svg = document.getElementById('dgo-chart-svg');
            const guide = document.getElementById('dgo-hover-guide');
            const dotMsg = document.getElementById('dgo-hover-dot-messages');
            const dotReact = document.getElementById('dgo-hover-dot-reactions');
            const tooltip = document.getElementById('dgo-tooltip');
            const ttDate = document.getElementById('dgo-tt-date');
            const ttMessages = document.getElementById('dgo-tt-messages');
            const ttReactions = document.getElementById('dgo-tt-reactions');
            if (!wrap || !svg || !guide || points.length < 2) return;

            const maxVal = Math.max(1, ...points.map((p) => Math.max(p.messages, p.reactions)));
            const n = points.length;
            const yFor = (v) => chartH - (v / maxVal) * (chartH - 10) - 5;
            const xFor = (i) => (i / (n - 1)) * chartW;

            function show(e) {
              const wrapRect = wrap.getBoundingClientRect();
              const relX = ((e.clientX - wrapRect.left) / wrapRect.width) * chartW;
              let idx = Math.round((relX / chartW) * (n - 1));
              idx = Math.max(0, Math.min(n - 1, idx));
              const p = points[idx];
              const xPct = (xFor(idx) / chartW) * 100;
              const yMsgPct = (yFor(p.messages) / chartH) * 100;
              const yReactPct = (yFor(p.reactions) / chartH) * 100;

              guide.style.left = `${xPct}%`;
              guide.style.opacity = '1';
              dotMsg.style.left = `${xPct}%`;
              dotMsg.style.top = `${yMsgPct}%`;
              dotMsg.style.opacity = '1';
              dotReact.style.left = `${xPct}%`;
              dotReact.style.top = `${yReactPct}%`;
              dotReact.style.opacity = '1';

              if (tooltip) {
                ttDate.textContent = p.displayLabel;
                ttMessages.textContent = p.messages.toLocaleString();
                ttReactions.textContent = p.reactions.toLocaleString();
                const pxX = (xFor(idx) / chartW) * wrapRect.width;
                let left = pxX + 14;
                if (left + 150 > wrapRect.width) left = pxX - 164;
                tooltip.style.left = `${left}px`;
                tooltip.classList.add('show');
              }
            }
            function hide() {
              guide.style.opacity = '0';
              dotMsg.style.opacity = '0';
              dotReact.style.opacity = '0';
              if (tooltip) tooltip.classList.remove('show');
            }
            svg.addEventListener('pointermove', show);
            svg.addEventListener('pointerleave', hide);
          })();
        </script>
      )}

      <div class="dgo-metric-grid">
        <div class="dgo-metric">
          <div class="dgo-metric-label">Messages</div>
          <div class="dgo-metric-value">{activity.totalMessages.toLocaleString()}</div>
          {fmtDelta(activity.messagesDeltaPct) && <div class:list={['dgo-metric-delta', { down: (activity.messagesDeltaPct ?? 0) < 0 }]}>{fmtDelta(activity.messagesDeltaPct)} vs previous period</div>}
          {messagesSparkPath && <svg viewBox={`0 0 ${SPARK_W} ${SPARK_H}`} preserveAspectRatio="none" class="dgo-spark"><path d={messagesSparkPath} class="dgo-spark-line" style="--sc:var(--accent)" /></svg>}
        </div>
        <div class="dgo-metric">
          <div class="dgo-metric-label">Reactions</div>
          <div class="dgo-metric-value">{activity.totalReactions.toLocaleString()}</div>
          {fmtDelta(activity.reactionsDeltaPct) && <div class:list={['dgo-metric-delta', { down: (activity.reactionsDeltaPct ?? 0) < 0 }]}>{fmtDelta(activity.reactionsDeltaPct)} vs previous period</div>}
          {reactionsSparkPath && <svg viewBox={`0 0 ${SPARK_W} ${SPARK_H}`} preserveAspectRatio="none" class="dgo-spark"><path d={reactionsSparkPath} class="dgo-spark-line" style="--sc:#f78fb3" /></svg>}
        </div>
        <div class="dgo-metric">
          <div class="dgo-metric-label">Voice activity</div>
          <div class="dgo-metric-value">{activity.totalVoiceHours.toLocaleString()} hrs</div>
          {voiceSparkPath && <svg viewBox={`0 0 ${SPARK_W} ${SPARK_H}`} preserveAspectRatio="none" class="dgo-spark"><path d={voiceSparkPath} class="dgo-spark-line" style="--sc:#5eead4" /></svg>}
        </div>
        <div class="dgo-metric">
          <div class="dgo-metric-label">Active channels</div>
          <div class="dgo-metric-value">{activity.activeChannels}</div>
        </div>
      </div>

      <div class="dgo-top-grid">
        <div class="dgo-top">
          <div class="dgo-top-head">Top message channels</div>
          <div class="dgo-top-cols">
            <span>Channel</span><span>Messages</span><span>% of activity</span><span>Change</span>
          </div>
          {activity.topMessageChannels.map((c) => (
            <div class="dgo-top-row">
              <span class="dgo-top-name"><i class="dgo-top-badge" style={`--c:${c.color}`}>#</i>{c.name}</span>
              <span class="dgo-top-count">{c.count.toLocaleString()}</span>
              <span class="dgo-top-pct">{c.pct.toFixed(0)}%</span>
              <span class:list={['dgo-top-delta', { down: (c.deltaPct ?? 0) < 0, flat: c.deltaPct === null }]}>{fmtDelta(c.deltaPct) ?? 'new'}</span>
            </div>
          ))}
        </div>
        <div class="dgo-top">
          <div class="dgo-top-head">Top reaction channels</div>
          <div class="dgo-top-cols">
            <span>Channel</span><span>Reactions</span><span>% of activity</span><span>Change</span>
          </div>
          {activity.topReactionChannels.map((c) => (
            <div class="dgo-top-row">
              <span class="dgo-top-name"><i class="dgo-top-badge" style={`--c:${c.color}`}>#</i>{c.name}</span>
              <span class="dgo-top-count">{c.count.toLocaleString()}</span>
              <span class="dgo-top-pct">{c.pct.toFixed(0)}%</span>
              <span class:list={['dgo-top-delta', { down: (c.deltaPct ?? 0) < 0, flat: c.deltaPct === null }]}>{fmtDelta(c.deltaPct) ?? 'new'}</span>
            </div>
          ))}
        </div>
      </div>
    </>
  )}

  <div class="dgo-stats">
    {stats.map((s) => (
      <div class="dgo-stat-card">
        <div class="dgo-stat-icon" style={`--c:${s.color}`}><Icon name={s.icon} width="16" height="16" /></div>
        <div class="dgo-stat-body">
          <div class="dgo-stat-label">{s.label}</div>
          <div class="dgo-stat-value">{s.value}</div>
        </div>
      </div>
    ))}
  </div>

  <h2 class="dgo-modules-title">Modules</h2>
  <p class="dgo-modules-sub">What's actually configured right now, at a glance.</p>

  <div class="dgo-modules">
    {modules.map((m) => (
      <div class="dgo-module">
        <div class="dgo-module-head">{m.title}</div>
        <ul class="dgo-module-list">
          {m.items.map((it) => (
            <li><span>{it.label}</span><b class:list={{ ok: it.ok, off: !it.ok }}>{it.value}</b></li>
          ))}
        </ul>
        <a href={m.href} class="dgo-module-link">Change settings <Icon name="ph:arrow-right" width="11" height="11" /></a>
      </div>
    ))}
  </div>
</DashGuildLayout>

