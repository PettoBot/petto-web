---
import { Icon } from 'astro-icon/components';
import { getDashLang, makeT } from '../i18n/dash';
const dt = makeT(getDashLang(Astro));
interface Field { type: string; id: string; label: string; placeholder?: string; required?: boolean }
interface Props { fields?: Field[] }
const { fields } = Astro.props;
const rows: Field[] = fields && fields.length ? fields : [{ type: 'long_text', id: '', label: '', placeholder: '', required: true }];
---
<div class="ff" data-ff>
  <input type="hidden" name="form_fields" value="" />
  <div class="ff-list" data-ff-list>
    {rows.map((f) => (
      <div class="ff-row" data-ff-row data-id={f.id}>
        <select data-ff-type aria-label={dt('Type')}>
          <option value="short_text" selected={f.type === 'short_text'}>{dt('Short answer')}</option>
          <option value="long_text" selected={f.type === 'long_text'}>{dt('Paragraph')}</option>
        </select>
        <input type="text" data-ff-label placeholder={dt('Question')} maxlength="45" value={f.label} />
        <input type="text" data-ff-hint placeholder={dt('Hint text (optional)')} maxlength="100" value={f.placeholder ?? ''} />
        <label class="ff-req"><input type="checkbox" data-ff-required checked={f.required !== false} />{dt('Required')}</label>
        <button type="button" class="ff-del" data-ff-del aria-label={dt('Remove')}><Icon name="ph:x-bold" width="13" height="13" /></button>
      </div>
    ))}
  </div>
  <button type="button" class="btn btn-ghost btn-sm" data-ff-add><Icon name="ph:plus-bold" width="13" height="13" />{dt('Add field')}</button>
  <span class="ff-note">{dt('Up to 5 fields.')}</span>
</div>

<style>
  .ff { display: flex; flex-direction: column; gap: 8px; width: 100%; align-items: flex-start; }
  .ff-list { display: flex; flex-direction: column; gap: 8px; width: 100%; }
  .ff-row { display: grid; grid-template-columns: 130px minmax(0, 1.2fr) minmax(0, 1fr) auto auto; gap: 8px; align-items: center; width: 100%; padding: 8px; border: 1px solid var(--border); border-radius: 10px; background: var(--card); }
  .ff-row input[type="text"], .ff-row select { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--bg, transparent); color: var(--text); font-family: var(--sans); font-size: 13.5px; min-width: 0; width: 100%; }
  .ff-req { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted, inherit); white-space: nowrap; }
  .ff-del { border: 0; background: transparent; color: var(--muted, inherit); cursor: pointer; padding: 6px; border-radius: 8px; display: inline-flex; }
  .ff-del:hover { color: #ff6b6b; }
  .ff-note { font-size: 12px; opacity: .65; }
  @media (max-width: 720px) {
    .ff-row { grid-template-columns: 1fr auto; }
    .ff-row select, .ff-row input[type="text"] { grid-column: 1 / -1; }
  }
</style>

<script is:inline>
  if (!window.__ffBound) {
    window.__ffBound = true;
    var clean = function (v) { return String(v || '').replace(/[|;]/g, ' ').replace(/\s+/g, ' ').trim(); };
    var sync = function (box) {
      var rows = box.querySelectorAll('[data-ff-row]');
      var used = {};
      var parts = [];
      rows.forEach(function (row, i) {
        var label = clean(row.querySelector('[data-ff-label]').value);
        if (!label) return;
        var id = row.getAttribute('data-id') || '';
        if (!id || used[id]) { id = 'field_' + (i + 1); while (used[id]) id += 'x'; }
        used[id] = 1;
        row.setAttribute('data-id', id);
        parts.push([
          row.querySelector('[data-ff-type]').value, id, label,
          clean(row.querySelector('[data-ff-hint]').value),
          row.querySelector('[data-ff-required]').checked ? 'required' : 'optional'
        ].join('|'));
      });
      box.querySelector('input[name="form_fields"]').value = parts.slice(0, 5).join(';');
      var add = box.querySelector('[data-ff-add]');
      if (add) add.style.display = rows.length >= 5 ? 'none' : '';
    };
    var syncAll = function () { document.querySelectorAll('[data-ff]').forEach(sync); };
    document.addEventListener('input', function (e) { var b = e.target.closest && e.target.closest('[data-ff]'); if (b) sync(b); });
    document.addEventListener('change', function (e) { var b = e.target.closest && e.target.closest('[data-ff]'); if (b) sync(b); });
    document.addEventListener('click', function (e) {
      var t = e.target.closest && e.target.closest('[data-ff-add],[data-ff-del]');
      if (!t) return;
      var box = t.closest('[data-ff]');
      var list = box.querySelector('[data-ff-list]');
      if (t.hasAttribute('data-ff-add')) {
        var rows = list.querySelectorAll('[data-ff-row]');
        if (rows.length >= 5) return;
        var copy = rows[0].cloneNode(true);
        copy.removeAttribute('data-id');
        copy.querySelector('[data-ff-label]').value = '';
        copy.querySelector('[data-ff-hint]').value = '';
        copy.querySelector('[data-ff-required]').checked = true;
        list.appendChild(copy);
        copy.querySelector('[data-ff-label]').focus();
      } else {
        var all = list.querySelectorAll('[data-ff-row]');
        var row = t.closest('[data-ff-row]');
        if (all.length <= 1) { row.querySelector('[data-ff-label]').value = ''; row.querySelector('[data-ff-hint]').value = ''; }
        else row.remove();
      }
      sync(box);
    });
    document.addEventListener('submit', function (e) { var b = e.target.querySelector && e.target.querySelector('[data-ff]'); if (b) sync(b); }, true);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', syncAll); else syncAll();
  }
</script>
