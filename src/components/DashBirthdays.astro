---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import { getDashLang, makeT } from '../i18n/dash';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  config: { enabled: boolean; channelId: string; roleId: string; message: string; embedTemplate: string; hour: number; offset: number };
  channels: { id: string; name: string }[];
  roles: { id: string; name: string }[];
  templates: string[];
  total: number;
  today: number;
  ready: boolean;
  saved: boolean;
  failed: string;
}
const { user, guildId, guildName, guildIcon, config, channels, roles, templates, total, today, ready, saved, failed } = Astro.props;
const errors: Record<string, string> = {
  channel: dt('Choose a channel from the list.'),
  role: dt('Choose a role from the list.'),
  hour: dt('The hour has to be from 0 to 23.'),
  timezone: dt('Choose a time zone from the list.'),
  save: dt('It could not be saved. Try again in a moment.'),
};
const offsets = Array.from({ length: 53 }, (_, i) => -720 + i * 30).filter((m) => m <= 840);
const offsetLabel = (minutes: number) => {
  const sign = minutes < 0 ? '-' : '+';
  const abs = Math.abs(minutes);
  return `UTC${sign}${Math.floor(abs / 60)}${abs % 60 ? `:${String(abs % 60).padStart(2, '0')}` : ''}`;
};
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="birthdays" pageTitle={dt('Birthdays')}>
  <h1>{dt('Birthdays')}</h1>
  <p class="bd-sub">{dt('Members save their birthday with !birthday set, and Petto celebrates it: a message at the hour you choose, and a role for the day if you want.')}</p>
  {saved && <div class="bd-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {failed && <div class="bd-flash bd-warn"><Icon name="ph:warning-fill" width="15" height="15" />{errors[failed] ?? errors.save}</div>}
  {!ready && <div class="bd-flash bd-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}

  <div class="bd-stats">
    <div><b>{total}</b><span>{dt('Birthdays saved')}</span></div>
    <div><b>{today}</b><span>{dt('Celebrating today')}</span></div>
  </div>

  <form method="POST" class="bd-form">
    <label class="bd-check"><input type="checkbox" name="enabled" checked={config.enabled} />{dt('Celebrate birthdays in this server')}</label>
    <div class="bd-grid">
      <div class="bd-field"><label>{dt('Channel')}</label>
        <select name="channel_id">
          <option value="">{dt('No message')}</option>
          {channels.map((c) => <option value={c.id} selected={c.id === config.channelId}>#{c.name}</option>)}
        </select>
      </div>
      <div class="bd-field"><label>{dt('Role for the day')}</label>
        <select name="role_id">
          <option value="">{dt('No role')}</option>
          {roles.map((r) => <option value={r.id} selected={r.id === config.roleId}>{r.name}</option>)}
        </select>
        <span class="bd-hint">{dt('Given in the morning and taken back a day later. Petto has to be above it.')}</span>
      </div>
      <div class="bd-field"><label>{dt('Hour of the day')}</label><input type="number" name="hour" min="0" max="23" value={config.hour} /></div>
      <div class="bd-field"><label>{dt('Time zone')}</label>
        <select name="utc_offset_minutes">
          {offsets.map((m) => <option value={m} selected={m === config.offset}>{offsetLabel(m)}</option>)}
        </select>
      </div>
      <div class="bd-field bd-wide"><label>{dt('Message')}</label>
        <textarea name="message" rows="3" maxlength="1500" data-dp data-dp-template="embed_template">{config.message}</textarea>
        <span class="bd-hint">{dt('Variables: {user}, {user.mention}, {server} and {age} (the age they turn, empty if they did not say the year).')}</span>
      </div>
      <div class="bd-field bd-wide"><label>{dt('Saved embed (optional)')}</label>
        <select name="embed_template">
          <option value="">{dt('Use the message above')}</option>
          {templates.map((name) => <option value={name} selected={name === config.embedTemplate}>{name}</option>)}
        </select>
        <span class="bd-hint">{dt('A design from Embeds is sent instead of the message. Its variables work, but not {age}.')}</span>
      </div>
    </div>
    <div class="bd-foot">
      <button class="btn btn-accent btn-sm" type="submit" disabled={!ready}>{dt('Save')}</button>
      <a class="bd-link" href={`/dash/guild/${guildId}/senders`}>{dt('Give these messages their own name and picture')}</a>
    </div>
  </form>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  .bd-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 20px; max-width: 70ch; }
  .bd-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 16px; max-width: 760px; }
  .bd-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: var(--yellow); }
  .bd-stats { display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
  .bd-stats div { border: 1px solid var(--border); border-radius: 12px; background: var(--card); padding: 12px 18px; min-width: 150px; }
  .bd-stats b { display: block; font-size: 22px; }
  .bd-stats span { font-size: 12.5px; color: var(--text-dim); }
  .bd-form { display: flex; flex-direction: column; gap: 16px; max-width: 760px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 18px; }
  .bd-check { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; }
  .bd-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .bd-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .bd-wide { grid-column: 1 / -1; }
  .bd-field label { font-size: 13px; font-weight: 600; }
  .bd-field input, .bd-field select, .bd-field textarea { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; min-width: 0; }
  .bd-field textarea { resize: vertical; }
  .bd-hint { font-size: 12px; color: var(--text-dim); }
  .bd-foot { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .bd-link { font-size: 13px; color: var(--accent); text-decoration: none; }
  .bd-link:hover { text-decoration: underline; }
  @media (max-width: 720px) { .bd-grid { grid-template-columns: 1fr; } }
</style>
