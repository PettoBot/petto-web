---
import SilentMentionHint from './SilentMentionHint.astro';
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashAcData from './DashAcData.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import { getDashLang, makeT } from '../i18n/dash';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  config: { enabled: boolean; channelId: string; roleId: string; message: string; embedTemplate: string; hour: number; offset: number };
  channels: { id: string; name: string }[];
  roles: { id: string; name: string }[];
  templates: string[];
  total: number;
  today: number;
  ready: boolean;
  saved: boolean;
  failed: string;
}
const { user, guildId, guildName, guildIcon, config, channels, roles, templates, total, today, ready, saved, failed } = Astro.props;
const errors: Record<string, string> = {
  channel: dt('Choose a channel from the list.'),
  role: dt('Choose a role from the list.'),
  hour: dt('The hour has to be from 0 to 23.'),
  timezone: dt('Choose a time zone from the list.'),
  save: dt('It could not be saved. Try again in a moment.'),
};
const offsets = Array.from({ length: 53 }, (_, i) => -720 + i * 30).filter((m) => m <= 840);
const offsetLabel = (minutes: number) => {
  const sign = minutes < 0 ? '-' : '+';
  const abs = Math.abs(minutes);
  return `UTC${sign}${Math.floor(abs / 60)}${abs % 60 ? `:${String(abs % 60).padStart(2, '0')}` : ''}`;
};
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="birthdays" pageTitle={dt('Birthdays')}>
  <DashFormKit />
  <h1>{dt('Birthdays')}</h1>
  <DashAcData roles={roles} channels={channels} vars={[{ tok: '{age}', desc: dt('The age they turn') }, { tok: '{server}', desc: dt('Name of the server') }]} />
  {saved && <div class="dfx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {failed && <div class="dfx-flash dfx-warn"><Icon name="ph:warning-fill" width="15" height="15" />{errors[failed] ?? errors.save}</div>}
  {!ready && <div class="dfx-flash dfx-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}

  <div class="bd-page">
    <DashStatTiles tiles={[
      { label: dt('Birthdays saved'), value: total, tone: 'invites' },
      { label: dt('Celebrating today'), value: today, tone: 'reactions' },
    ]} />

    <form method="POST" class="dfx-form">
      <label class="dfx-master"><span><b>{dt('Celebrate birthdays in this server')}</b><em>{dt('Petto writes to the channel and gives the role on the day.')}</em></span><input type="checkbox" class="dfx-t" name="enabled" checked={config.enabled} /></label>

      <section class="dfx-sec">
        <div class="dfx-sec-head"><h2>{dt('Where and when')}</h2><p>{dt('The channel, the role of the day and the hour it all happens.')}</p></div>
        <div class="dfx-grid">
          <div class="dfx-field"><label>{dt('Channel')}</label>
            <select name="channel_id">
              <option value="">{dt('No message')}</option>
              {channels.map((c) => <option value={c.id} selected={c.id === config.channelId}>#{c.name}</option>)}
            </select>
          </div>
          <div class="dfx-field"><label>{dt('Role for the day')}</label>
            <select name="role_id" data-give-role>
              <option value="">{dt('No role')}</option>
              {roles.map((r) => <option value={r.id} selected={r.id === config.roleId}>{r.name}</option>)}
            </select>
            <span class="dfx-hint">{dt('Given in the morning and taken back a day later. Petto has to be above it.')}</span>
          </div>
          <div class="dfx-field"><label>{dt('Hour of the day')}</label><input type="number" name="hour" min="0" max="23" value={config.hour} /></div>
          <div class="dfx-field"><label>{dt('Time zone')}</label>
            <select name="utc_offset_minutes">
              {offsets.map((m) => <option value={m} selected={m === config.offset}>{offsetLabel(m)}</option>)}
            </select>
          </div>
        </div>
        <p class="bd-when" data-bd-when data-text={dt('Wishes go out every day at {time} ({zone}).')}></p>
      </section>

      <section class="dfx-sec">
        <div class="dfx-sec-head"><h2>{dt('The message')}</h2><p>{dt('What Petto says. Write it here or choose a design from the Embeds page.')}</p></div>
        <div class="dfx-grid">
          <div class="dfx-field dfx-wide"><label>{dt('Message')}</label>
            <textarea name="message" class="dgl-autogrow" rows="4" maxlength="1500" data-count data-ac data-dp data-dp-template="embed_template">{config.message}</textarea><SilentMentionHint />
            <span class="dfx-hint">{dt('Variables: {user}, {user.mention}, {server} and {age} (the age they turn, empty if they did not say the year).')}</span>
          </div>
          <div class="dfx-field dfx-wide"><label>{dt('Saved embed (optional)')}</label>
            <select name="embed_template" data-tpl-locks="message">
              <option value="">{dt('Use the message above')}</option>
              {templates.map((name) => <option value={name} selected={name === config.embedTemplate}>{name}</option>)}
            </select>
            <span class="dfx-hint">{dt('A design from Embeds is sent instead of the message. Its variables work, but not {age}.')}</span>
          </div>
        </div>
      </section>

      <div class="dfx-foot">
        <button class="btn btn-accent btn-sm" type="submit" disabled={!ready}>{dt('Save')}</button>
        <a class="dfx-link" href={`/dash/guild/${guildId}/senders`}>{dt('Give these messages their own name and picture')}</a>
      </div>
    </form>
  </div>

  <script is:inline>
    (function () {
      var note = document.querySelector('[data-bd-when]');
      var hour = document.querySelector('input[name="hour"]');
      var zone = document.querySelector('select[name="utc_offset_minutes"]');
      if (!note || !hour || !zone) return;
      function paint() {
        var h = Math.max(0, Math.min(23, parseInt(hour.value, 10) || 0));
        var label = zone.options[zone.selectedIndex] ? zone.options[zone.selectedIndex].textContent : '';
        note.textContent = note.getAttribute('data-text').replace('{time}', String(h).padStart(2, '0') + ':00').replace('{zone}', label);
      }
      hour.addEventListener('input', paint); zone.addEventListener('input', paint); zone.addEventListener('change', paint);
      paint();
    })();
  </script>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 18px; }
  .bd-page { max-width: 1000px; }
  .bd-when { margin: 0; padding: 10px 14px; border-radius: 10px; background: color-mix(in srgb, var(--accent) 9%, transparent); color: var(--text-muted); font-size: 13px; }
</style>
