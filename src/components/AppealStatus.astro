---
import { Icon } from 'astro-icon/components';
import AppealLayout from './AppealLayout.astro';
import { appealText, type AppealLang } from '../i18n/appeal';
import { chatHtml } from '../utils/appealChat';
import { answerView, linkPreview, timeAgo, type AppealConfig, type AppealMessage, type Submission } from '../utils/appeals';

interface Props {
  lang: AppealLang; guild: { id: string; name: string; icon: string | null }; config: AppealConfig; submission: Submission; messages: AppealMessage[];
  justSent?: boolean; error?: string | null;
}
const { lang, guild, config, submission, messages, justSent = false, error = null } = Astro.props;
const t = appealText(lang);
const preview = linkPreview(config, guild, lang, { path: (guild as any).path ?? guild.id, origin: Astro.url.origin });
const pending = submission.status === 'pending';
const filePath = (id: string) => `/appeal/${(guild as any).path ?? guild.id}/file/${id}`;
const who = (m: AppealMessage) => (m.author_type === 'user' ? t('you') : m.author_type === 'staff' ? (m.anonymous ? t('staff') : m.author_name || t('staff')) : t('petto'));
const chat = chatHtml(messages, { prefix: 'ap', who, when: (iso) => timeAgo(iso, lang), empty: t('noMessages') });
const liveUrl = `/appeal/${(guild as any).path ?? guild.id}/status/${submission.id}/live`;
---
<AppealLayout lang={lang} config={config} guild={guild} preview={preview}>
  <div>
    <a class="ap-btn ghost" href={`/appeal/${(guild as any).path ?? guild.id}`}>← {t('back')}</a>
    <div class="ap-row" style="margin-top:6px"><h1>{submission.form_name}</h1><span class:list={['ap-chip', submission.status]}>{t(`status_${submission.status}` as any)}</span></div>
    <p class="ap-muted">{t('sent', { when: timeAgo(submission.created_at, lang) })}{submission.resolved_at && !pending ? ` · ${t('resolvedAt', { when: timeAgo(submission.resolved_at, lang) })}` : ''}</p>
  </div>
  {justSent && <div class="ap-card good"><h3>{t('sentTitle')}</h3><p>{t('sentBody')}</p></div>}
  {error && <div class="ap-card bad"><p><b>{t(`err_${error}` as any)}</b></p></div>}
  {submission.resolution_reason && !pending && <div class:list={['ap-card', submission.status === 'accepted' ? 'good' : 'bad']}><p>{submission.resolution_reason}</p></div>}

  <section class="ap-list">
    <div class="ap-row"><h2>{t('conversation')}</h2>{pending && <span class="ap-live" data-live-pill><i></i>{t('live')}</span>}</div>
    <div class="ap-chat" id="apChat" data-live-url={liveUrl} data-status={submission.status} data-pending={pending ? '1' : '0'} data-failed={t('err_failed')} data-rate={t('err_rate_limited')} aria-live="polite" set:html={chat}></div>
    {pending && config.allow_replies && (
      <form method="POST" class="ap-list" id="apReply">
        <input type="hidden" name="action" value="reply" />
        <textarea class="ap-area" name="content" maxlength="1500" placeholder={t('writeMessage')} required style="min-height:90px"></textarea>
        <p class="ap-reply-error" role="alert" hidden></p>
        <div><button class="ap-btn" type="submit">{t('sendMessage')}</button></div>
      </form>
    )}
    {pending && !config.allow_replies && <p class="ap-muted">{t('repliesOff')}</p>}
  </section>

  <section class="ap-card soft">
    <h3>{t('yourAnswers')}</h3>
    <div>{submission.answers.map((a) => {
      const view = answerView(a);
      return (
        <div class="ap-answer"><b>{a.label}</b>
          {view.kind === 'text' ? <span>{view.text}</span> : (
            <span class="ap-answer-files">{view.files.map((f) => f.mime.startsWith('image/')
              ? <a href={filePath(f.id)} target="_blank" rel="noopener" class="ap-answer-pic" title={f.name}><img src={filePath(f.id)} alt={f.name} loading="lazy" /></a>
              : <a href={filePath(f.id)} target="_blank" rel="noopener" class="ap-answer-doc"><Icon name="ph:file-text-bold" width="14" height="14" />{f.name}</a>)}</span>
          )}
        </div>
      );
    })}</div>
  </section>

  {pending && (
    <form method="POST" onsubmit={`return confirm(${JSON.stringify(t('withdrawConfirm'))})`}>
      <input type="hidden" name="action" value="withdraw" />
      <button class="ap-btn sec" type="submit">{t('withdraw')}</button>
    </form>
  )}
</AppealLayout>

<style is:global>
  .ap-answer-files { display: flex; flex-wrap: wrap; gap: 8px; }
  .ap-answer-pic img { display: block; width: 120px; height: 84px; object-fit: cover; border-radius: 10px; border: 1px solid var(--border); background: var(--raise); transition: transform .2s ease; }
  .ap-answer-pic:hover img { transform: scale(1.04); }
  .ap-answer-doc { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--border); background: var(--raise); font-size: 13px; text-decoration: none; color: inherit; }
  .ap-live { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .ap-live i { width: 7px; height: 7px; border-radius: 50%; background: #5bd68a; box-shadow: 0 0 0 0 rgba(91, 214, 138, .55); animation: ap-pulse 2s ease-out infinite; }
  .ap-live.off i { background: var(--muted); animation: none; }
  @keyframes ap-pulse { 70% { box-shadow: 0 0 0 7px rgba(91, 214, 138, 0); } 100% { box-shadow: 0 0 0 0 rgba(91, 214, 138, 0); } }
  .ap-msg.fresh { animation: ap-msg-in .35s cubic-bezier(.2, .8, .2, 1) both; }
  @keyframes ap-msg-in { from { opacity: 0; transform: translateY(8px) scale(.98); } to { opacity: 1; transform: none; } }
  .ap-reply-error { margin: 0; color: var(--red, #ff6b6b); font-size: 13px; }
  @media (prefers-reduced-motion: reduce) { .ap-live i, .ap-msg.fresh { animation: none; } }
</style>

<script>
  // The conversation updates by itself: it asks for the new messages every few seconds while the page is open, and a reply is sent without reloading.
  const chat = document.getElementById('apChat');
  if (chat && !(window as any).__apLive) {
    (window as any).__apLive = true;
    const url = chat.dataset.liveUrl ?? '';
    const pill = document.querySelector<HTMLElement>('[data-live-pill]');
    const form = document.getElementById('apReply') as HTMLFormElement | null;
    const status = chat.dataset.status;
    const delay = chat.dataset.pending === '1' ? 4000 : 15000;
    let known = chat.querySelectorAll('.ap-msg').length;
    let busy = false;
    let timer: number | undefined;

    async function refresh() {
      if (busy || document.hidden) return;
      busy = true;
      try {
        const res = await fetch(url, { headers: { Accept: 'application/json' }, cache: 'no-store' });
        if (!res.ok) throw new Error(String(res.status));
        const data = await res.json();
        pill?.classList.remove('off');
        // A decision or a withdrawal changes more than the chat: the page is drawn again.
        if (data.status !== status) { location.reload(); return; }
        if (data.count !== known || chat!.innerHTML.trim() !== data.html.trim()) {
          const stick = window.innerHeight + window.scrollY >= document.body.scrollHeight - 140;
          chat!.innerHTML = data.html;
          const items = Array.from(chat!.querySelectorAll('.ap-msg'));
          items.slice(known).forEach((el) => el.classList.add('fresh'));
          known = items.length;
          if (stick) window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
        }
      } catch {
        pill?.classList.add('off');
      } finally {
        busy = false;
      }
    }
    function start() { window.clearInterval(timer); timer = window.setInterval(refresh, delay); }
    document.addEventListener('visibilitychange', () => { if (!document.hidden) { refresh(); start(); } });
    start();

    if (form) {
      const box = form.querySelector('textarea')!;
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const error = form.querySelector<HTMLElement>('.ap-reply-error')!;
      async function send() {
        const content = box.value.trim();
        if (!content || button.disabled) return;
        button.disabled = true;
        error.hidden = true;
        try {
          const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ content }) });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || !data.ok) throw new Error(data.error ?? 'failed');
          box.value = '';
          await refresh();
        } catch (err) {
          error.textContent = String((err as Error).message) === 'rate_limited' ? (chat!.dataset.rate ?? '') : (chat!.dataset.failed ?? '');
          error.hidden = false;
        } finally {
          button.disabled = false;
        }
      }
      form.addEventListener('submit', (e) => { e.preventDefault(); send(); });
      box.addEventListener('keydown', (e) => { if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); send(); } });
    }
  }
</script>
