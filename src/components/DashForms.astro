      const side = q<HTMLInputElement>('input[name="embed_color"]')?.value ?? '';
      const color = q<HTMLInputElement>('input[name="color"]')?.value ?? '';
      pv.style.setProperty('--bar', /^#[0-9a-f]{6}$/i.test(side) ? side : /^#[0-9a-f]{6}$/i.test(color) ? color : '#f0a88f');
    };
    form.addEventListener('input', draw);
    form.addEventListener('change', draw);
