  }
  // The preview of the web page of the form follows the banner, the background, the switches of the server, the color, the title
  // and the description as they change.
  function initPagePreview() {
    const pv = document.querySelector<HTMLElement>('[data-page-pv]');
    const form = pv?.closest('form');
    if (!pv || !form || pv.dataset.bound) return;
    pv.dataset.bound = '1';
    const q = <T extends Element>(sel: string) => form.querySelector<T>(sel);
    const banner = q<HTMLInputElement>('[data-page-banner]');
    const bannerBad = q<HTMLElement>('[data-page-banner-bad]');
    const bannerBox = q<HTMLElement>('[data-page-pv-banner]');
    const bannerImg = q<HTMLImageElement>('[data-page-pv-banner-img]');
    const background = q<HTMLSelectElement>('[data-page-background]');
    const showIcon = q<HTMLInputElement>('[data-page-show-icon]');
    const showName = q<HTMLInputElement>('[data-page-show-name]');
    const color = q<HTMLInputElement>('input[name="color"]');
    const title = q<HTMLInputElement>('[data-preview-title]');
    const desc = q<HTMLTextAreaElement>('[data-preview-desc]');
    const name = q<HTMLElement>('[data-page-pv-name]')?.textContent ?? '';
    const tab = document.querySelector<HTMLElement>('[data-page-pv-tab]');
    const fallbackTitle = q<HTMLElement>('[data-page-pv-title]')?.textContent ?? '';
    const draw = () => {
      const link = banner?.value.trim() ?? '';
      const src = link ? imageUrl(link) : null;
      if (bannerBad) bannerBad.hidden = !link || Boolean(src);
      if (bannerBox && bannerImg) { bannerBox.hidden = !src; if (src && bannerImg.getAttribute('src') !== src) bannerImg.src = src; }
      pv.className = `fm-page-pv bg-${background?.value || 'default'}`;
      const hex = /^#[0-9a-f]{6}$/i.test(color?.value ?? '') ? color!.value : '';
      if (hex) pv.style.setProperty('--wf', hex); else pv.style.removeProperty('--wf');
      const icon = q<HTMLElement>('[data-page-pv-icon]'); if (icon) icon.hidden = !showIcon?.checked;
      const nameEl = q<HTMLElement>('[data-page-pv-name]'); if (nameEl) nameEl.hidden = !showName?.checked;
      const t = title?.value.trim() || fallbackTitle;
      const titleEl = q<HTMLElement>('[data-page-pv-title]'); if (titleEl) titleEl.textContent = t;
      const descEl = q<HTMLElement>('[data-page-pv-desc]'); if (descEl) { descEl.textContent = desc?.value.trim() ?? ''; descEl.hidden = !descEl.textContent; }
      if (tab) tab.textContent = `${t} · ${name}`;
