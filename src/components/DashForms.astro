---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MultiSelect from './MultiSelect.astro';
import DashAcData from './DashAcData.astro';
import ColorPicker from './ColorPicker.astro';
import DashFormKit from './DashFormKit.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import { getDashLang, makeT } from '../i18n/dash';
import { LIMITS, QUESTION_TYPES, BUTTON_STYLES, PAGE_BACKGROUNDS, PREMIUM_PAGE_BACKGROUNDS, normalizeQuestions, answerText, hexColor, formWebPath, pageLook, linkEmbed } from '../utils/forms';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null }; guildId: string; guildName: string; guildIcon: string;
  section: string; forms: any[]; pending: Record<string, number>; submissions: any[]; panels: any[];
  roles: { id: string; name: string }[]; channels: { id: string; name: string }[]; templates: string[];
  editing: any; storage: { stored: number; cap: number; retention: number; known: boolean };
  statusFilter: string; formFilter: string; search: string; plan: { forms: number; questions: number }; ready: boolean;
  message: { kind: 'ok' | 'err' | 'warn'; text: string } | null;
  premiumActive?: boolean;
}
const { user, guildId, guildName, guildIcon, section, forms, pending, submissions, panels, roles, channels, templates, editing, storage, statusFilter, formFilter, search, plan, ready, message, premiumActive = false } = Astro.props;
const base = `/dash/guild/${guildId}/forms`;
const titles: Record<string, string> = { forms: dt('Forms'), submissions: dt('Form submissions'), panels: dt('Form panels') };
const statusNames: Record<string, string> = { pending: dt('Pending'), accepted: dt('Accepted'), denied: dt('Denied'), cancelled: dt('Cancelled'), all: dt('All') };
const typeNames: Record<string, string> = { short: dt('Short text'), paragraph: dt('Paragraph'), number: dt('Number'), yesno: dt('Yes or no'), choice: dt('One choice'), multi: dt('Several choices') };
const styleNames: Record<string, string> = { primary: dt('Blurple'), secondary: dt('Grey'), success: dt('Green'), danger: dt('Red') };
const when = (iso: string) => new Date(iso).toLocaleString(dashLang, { dateStyle: 'medium', timeStyle: 'short' });
const atLimit = forms.length >= plan.forms;
const isNew = editing === 'new';
const f = isNew ? { name: '', title: '', description: '', color: null, status: 'closed', questions: [], review_channel_id: '', reviewer_role_ids: [], ping_role_ids: [], auto_thread: false, required_role_ids: [], blocked_role_ids: [], min_account_days: 0, min_member_days: 0, one_pending: true, deny_cooldown_hours: 0, max_per_user: 0, max_total: 0, closes_at: null, accept_add_role_ids: [], accept_remove_role_ids: [], deny_add_role_ids: [], deny_remove_role_ids: [], dm_results: true, messages: {}, button_label: '', button_emoji: '', button_style: 'primary', web_enabled: true, page_banner: null, page_background: 'default', page_show_icon: true, page_show_name: true, page_hide_branding: false, embed_title: null, embed_description: null, embed_image: null, embed_color: null, embed_thumbnail: false } : editing;
const webPath = !isNew && f ? formWebPath(f, dashLang) : null;
const look = pageLook(f);
const embed = linkEmbed(f);
// What the preview of the link shows when a part is left empty (utils/formPreview.ts does the same for the real tags).
const embedDefaults = { title: `${f?.title || dt('The title')} · ${guildName}`, description: (f?.description ?? '').replace(/\s+/g, ' ').trim().slice(0, 200) || dt('Fill in this form of {a} with your Discord account.', { a: guildName }) };
const embedImage = embed.image ?? look.banner ?? null;
const backgroundNames: Record<string, string> = { default: dt("Petto's (dark or light)"), solid: dt('A tint of the color'), gradient: dt('A gradient of the color'), aurora: dt('Aurora, animated'), waves: dt('Waves, animated') };
// The animated backgrounds and hiding the "Forms by Petto" line are Premium touches; a free server sees them marked and cannot pick them.
const premiumMark = (b: string) => (PREMIUM_PAGE_BACKGROUNDS.includes(b) ? ` · Premium` : '');
const closesLocal = f?.closes_at ? new Date(f.closes_at).toISOString().slice(0, 16) : '';
const builderText = {
  more: dt('More options'), question: dt('Question'), add: dt('Add a question'), remove: dt('Remove'), up: dt('Move up'), down: dt('Move down'), drag: dt('Drag to reorder'),
  label: dt('Question (45 characters)'), help: dt('Help line (optional)'),
  description: dt('Description (optional)'), descriptionHint: dt('Shown under the question on the web: up to 1000 characters, with line breaks, **bold**, *italics* and [links](https://petto.sbs). Discord shows the help line, or the start of the description.'),
  image: dt('Image URL (optional)'), imageHint: dt('Shown over the question on the web, not in Discord. An https link to a .png, .jpg, .gif or .webp picture.'), imageBad: dt('That link cannot be used: it must start with https:// and end in .png, .jpg, .gif or .webp.'),
  web: dt('On the web'), placeholder: dt('Placeholder (optional)'), required: dt('Required'),
  minLength: dt('Least characters'), maxLength: dt('Most characters'), minValue: dt('Lowest number'), maxValue: dt('Highest number'),
  options: dt('Options, one per line (2 to 25)'), maxChoices: dt('How many can be picked'), empty: dt('No questions yet. Add the first one.'),
  limit: dt('Limit reached'), types: typeNames, page: dt('Page'), yes: dt('Yes'), no: dt('No'), pick: dt('Pick one'), pickMany: dt('Pick one or more'), number: dt('A number'),
  next: dt('Next'), submit: dt('Submit'), apply: dt('Apply'), pages: dt('{a} questions in {b} pages'),
};
const variableChips = ['{user}', '{form}', '{reason}', '{number}', '{server}'];
// The variables of the form messages (the chips above), offered first by the typed autocomplete. {user} is already in the usual list.
const formVars = [
  { tok: '{form}', desc: dt('Name of the form') }, { tok: '{reason}', desc: dt('Reason the staff wrote') },
  { tok: '{number}', desc: dt('Number of the answers') }, { tok: '{server}', desc: dt('Name of the server') },
];
const defaultMessages = {
  submitted: dt('Your answers to {form} were sent (#{number}). The staff will look at them and you will get a DM with the result.'),
  accepted: dt('Your answers to {form} in {server} were accepted.'),
  denied: dt('Your answers to {form} in {server} were denied.'),
};
const formOptions = forms.map((x) => ({ id: String(x.id), name: x.title }));
const formName = (id: unknown) => forms.find((x) => String(x.id) === String(id))?.title;
const yesWord = dt('Yes');
const noWord = dt('No');
const pendingTotal = Object.values(pending).reduce((sum, n) => sum + Number(n || 0), 0);
const filterHref = (over: Record<string, string>) => {
  const params = new URLSearchParams({ section: 'submissions', status: statusFilter, ...(formFilter ? { f: formFilter } : {}), ...(search ? { q: search } : {}), ...over });
  for (const [key, value] of [...params]) if (!value) params.delete(key);
  return `${base}?${params}`;
};
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={section === 'forms' ? 'forms' : `forms-${section}`} pageTitle={titles[section]}>
  <div class="fm-page">
  <DashFormKit />
  <DashSettingsKit />
  <h1>{titles[section]}</h1>
  {((section === 'forms' && f) || section !== 'forms') && <DashAcData roles={roles} channels={channels} vars={section === 'forms' ? formVars : []} />}
  {message && <div class:list={['fm-flash', message.kind]} role={message.kind === 'err' ? 'alert' : 'status'}><Icon name={message.kind === 'ok' ? 'ph:check-circle-fill' : 'ph:warning-fill'} width="15" height="15" />{message.text}</div>}
  {!ready && <div class="fm-flash warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}

  {section === 'forms' && !f && (
    <>
      {forms.length > 0 && <DashStatTiles tiles={[
        { label: dt('Forms'), value: forms.length, tone: 'messages' },
        { label: dt('Open forms'), value: forms.filter((x) => x.status === 'open').length, tone: 'joins' },
        { label: dt('Pending'), value: Object.values(pending).reduce((sum, n) => sum + Number(n || 0), 0), tone: 'reactions' },
      ]} />}
      <div class="fm-row">
        <span class="fm-hint">{dt('{a} of {b} forms', { a: forms.length, b: plan.forms })} · {dt('Up to {a} questions per form', { a: plan.questions })}</span>
        {atLimit ? <span class="btn btn-ghost btn-sm" aria-disabled="true">{dt('Limit reached')}</span> : <a class="btn btn-accent btn-sm" href={`${base}?section=forms&form=new`}><Icon name="ph:plus-bold" width="12" height="12" />{dt('New form')}</a>}
      </div>
      {forms.length === 0 && (
        <div class="fm-card fm-empty fm-fill">
          <Icon name="ph:clipboard-text-fill" width="28" height="28" />
          <p>{dt('No forms yet. Make one for staff applications, partner requests or sign-ups.')}</p>
          <p class="fm-hint">{dt('In Discord: !form create staff Staff application')}</p>
        </div>
      )}
      <div class="fm-grid-cards dgl-stagger">
        {forms.map((x) => {
          const count = normalizeQuestions(x.questions).length;
          const waiting = pending[String(x.id)] ?? 0;
          return (
            <div class="fm-card fm-formcard dgl-card">
              <div class="fm-row"><h3 style={x.color !== null && x.color !== undefined ? `--fc:${hexColor(x.color)}` : ''}><i class="fm-dot"></i>{x.title}</h3><span class:list={['fm-chip', x.status]}>{x.status === 'open' ? dt('Open') : dt('Closed')}</span></div>
              <p class="fm-hint"><code>{x.name}</code>{x.number ? <> · #{x.number}</> : null} · {dt('{a} questions', { a: count })} · <a href={`${base}?section=submissions&f=${x.id}`}>{dt('{a} pending', { a: waiting })}</a>{x.web_enabled !== false && formWebPath(x, dashLang) && <> · <a href={formWebPath(x, dashLang)!} target="_blank" rel="noopener">{dt('Open on the web')}</a></>}</p>
              {x.description && <p class="fm-desc">{x.description}</p>}
              <div class="fm-actions">
                <a class="btn btn-ghost btn-sm" href={`${base}?section=forms&form=${x.id}`}><Icon name="ph:pencil-simple-bold" width="12" height="12" />{dt('Edit')}</a>
                <form method="POST" data-no-dirty><input type="hidden" name="action" value="toggle_form" /><input type="hidden" name="form_id" value={x.id} /><button type="submit" class="btn btn-ghost btn-sm">{x.status === 'open' ? dt('Close') : dt('Open')}</button></form>
                {!atLimit && <form method="POST" data-no-dirty><input type="hidden" name="action" value="duplicate_form" /><input type="hidden" name="form_id" value={x.id} /><button type="submit" class="btn btn-ghost btn-sm">{dt('Duplicate')}</button></form>}
              </div>
            </div>
          );
        })}
      </div>
      {forms.length > 0 && (
        <div class="fm-next">
          <a class="fm-card fm-tile" href={`${base}?section=submissions`}>
            <Icon name="ph:tray-fill" width="24" height="24" />
            <b>{dt('Form submissions')}</b>
            {storage.known && <span class="fm-hint">{dt('{a} pending', { a: Object.values(pending).reduce((sum, n) => sum + Number(n || 0), 0) })}</span>}
          </a>
          <a class="fm-card fm-tile" href={`${base}?section=panels`}>
            <Icon name="ph:cursor-click-fill" width="24" height="24" />
            <b>{dt('Form panels')}</b>
            <span class="fm-hint">{dt('Post a panel')}</span>
          </a>
        </div>
      )}
    </>
  )}

  {section === 'forms' && f && (
    <>
    <a class="fm-back" href={`${base}?section=forms`}>← {dt('All forms')}</a>
    <div class="fm-editor-wrap">
      <form method="POST" class="fm-editor" data-forms-editor>
        <input type="hidden" name="action" value="save_form" />
        {!isNew && <input type="hidden" name="form_id" value={f.id} />}
        <details class="fm-fold" data-fm-fold open>
          <summary><span class="fm-fold-icon" aria-hidden="true"><Icon name="ph:text-aa-bold" width="16" height="16" /></span><span class="fm-fold-title"><h2>{dt('Basics')}</h2><em>{dt('The title, the short name and the color.')}</em></span><Icon name="ph:caret-down-bold" class="fm-fold-caret" width="14" height="14" /></summary>
          <div class="fm-fold-body">          
          <div class="fm-grid">
            <label class="fm-field"><span>{dt('Title')}</span><input type="text" name="title" value={f.title} maxlength={LIMITS.title} required data-preview-title /><em>{dt('Shown on top of the Discord form (45 characters).')}</em></label>
            <label class="fm-field"><span>{dt('Short name')}</span><input type="text" name="name" value={f.name} maxlength="32" required pattern={'[A-Za-z0-9][A-Za-z0-9_\\-]{0,31}'} autocomplete="off" spellcheck="false" /><em>{dt('For commands, like !form info staff.')}</em></label>
            <label class="fm-field fm-wide"><span>{dt('Description')}</span><textarea class="dgl-autogrow" data-count name="description" maxlength={LIMITS.description} rows="2" data-ac data-preview-desc>{f.description ?? ''}</textarea><em>{dt('Shown on the panel.')}</em></label>
            <label class="fm-field"><span>{dt('Status')}</span><select name="status"><option value="closed" selected={f.status !== 'open'}>{dt('Closed: nobody can send it')}</option><option value="open" selected={f.status === 'open'}>{dt('Open: members can send it')}</option></select></label>
            <div class="fm-field"><span>{dt('Color')}</span><ColorPicker name="color" value={hexColor(f.color)} label={dt('Color')} allowNone /></div>
          </div>
          </div>
        </details>

        <details class="fm-fold" data-fm-fold open>
          <summary><span class="fm-fold-icon" aria-hidden="true"><Icon name="ph:list-checks-bold" width="16" height="16" /></span><span class="fm-fold-title"><h2>{dt('Questions')}</h2><em>{dt('What members are asked.')}</em></span><span class="fm-hint" data-q-count></span><Icon name="ph:caret-down-bold" class="fm-fold-caret" width="14" height="14" /></summary>
          <div class="fm-fold-body">          
          <p class="fm-hint">{dt('Members see them in Discord forms of 5 questions, with a Next button between pages. Drag a question to change its place.')}</p>
          <div data-q-builder data-initial={JSON.stringify(normalizeQuestions(f.questions))} data-text={JSON.stringify(builderText)} data-limit={plan.questions} data-limits={JSON.stringify(LIMITS)} data-types={JSON.stringify(QUESTION_TYPES)}></div>
          <input type="hidden" name="questions_json" data-q-output />
          </div>
        </details>

        <details class="fm-fold" data-fm-fold open>
          <summary><span class="fm-fold-icon" aria-hidden="true"><Icon name="ph:eye-bold" width="16" height="16" /></span><span class="fm-fold-title"><h2>{dt('Review')}</h2><em>{dt('Where the answers arrive and who reviews them.')}</em></span><Icon name="ph:caret-down-bold" class="fm-fold-caret" width="14" height="14" /></summary>
          <div class="fm-fold-body">          
          <div class="fm-grid">
            <label class="fm-field"><span>{dt('Review channel')}</span><select name="review_channel_id"><option value="">{dt('Pick a channel')}</option>{channels.map((c) => <option value={c.id} selected={c.id === f.review_channel_id}>#{c.name}</option>)}</select><em>{dt('Where the cards with the answers arrive.')}</em></label>
            <label class="fm-check fm-center"><input type="checkbox" name="auto_thread" checked={f.auto_thread} />{dt('Open a thread under each card')}</label>
            <div class="fm-field fm-wide"><span>{dt('Reviewer roles')}</span><MultiSelect lazy name="reviewer_role_ids" options={roles} selected={f.reviewer_role_ids ?? []} placeholder={dt('Only who manages the server')} /><em>{dt('Who can accept and deny. Who manages the server always can.')}</em></div>
            <div class="fm-field fm-wide"><span>{dt('Roles to ping')}</span><MultiSelect lazy name="ping_role_ids" options={roles} selected={f.ping_role_ids ?? []} placeholder={dt('No roles')} /></div>
          </div>
          </div>
        </details>

        <details class="fm-fold" data-fm-fold>
          <summary><span class="fm-fold-icon" aria-hidden="true"><Icon name="ph:users-three-bold" width="16" height="16" /></span><span class="fm-fold-title"><h2>{dt('Who can send it')}</h2><em>{dt('Roles, account age and limits.')}</em></span><Icon name="ph:caret-down-bold" class="fm-fold-caret" width="14" height="14" /></summary>
          <div class="fm-fold-body">          
          <div class="fm-grid">
            <div class="fm-field fm-wide"><span>{dt('Needs one of these roles')}</span><MultiSelect lazy name="required_role_ids" options={roles} selected={f.required_role_ids ?? []} placeholder={dt('Anyone')} /></div>
            <div class="fm-field fm-wide"><span>{dt('Blocked roles')}</span><MultiSelect lazy name="blocked_role_ids" options={roles} selected={f.blocked_role_ids ?? []} placeholder={dt('No roles')} /></div>
            <label class="fm-field"><span>{dt('Account age (days)')}</span><input type="number" name="min_account_days" min="0" max="3650" value={f.min_account_days} /></label>
            <label class="fm-field"><span>{dt('Time in the server (days)')}</span><input type="number" name="min_member_days" min="0" max="3650" value={f.min_member_days} /></label>
            <label class="fm-field"><span>{dt('Wait after a denial (hours)')}</span><input type="number" name="deny_cooldown_hours" min="0" max="8760" value={f.deny_cooldown_hours} /></label>
            <label class="fm-field"><span>{dt('Times each member can send it')}</span><input type="number" name="max_per_user" min="0" max="1000" value={f.max_per_user} /><em>{dt('0 is no limit.')}</em></label>
            <label class="fm-field"><span>{dt('Answers in all')}</span><input type="number" name="max_total" min="0" max="100000" value={f.max_total} /><em>{dt('0 is no limit.')}</em></label>
            <label class="fm-field"><span>{dt('Closes on (UTC)')}</span><input type="datetime-local" name="closes_at" value={closesLocal} /></label>
            <label class="fm-check fm-wide"><input type="checkbox" name="one_pending" checked={f.one_pending} />{dt('One pending answer per member')}</label>
          </div>
          </div>
        </details>

        <details class="fm-fold" data-fm-fold>
          <summary><span class="fm-fold-icon" aria-hidden="true"><Icon name="ph:chat-teardrop-text-bold" width="16" height="16" /></span><span class="fm-fold-title"><h2>{dt('After the review')}</h2><em>{dt('Roles given and the messages members get.')}</em></span><Icon name="ph:caret-down-bold" class="fm-fold-caret" width="14" height="14" /></summary>
          <div class="fm-fold-body">          
          <div class="fm-grid">
            <div class="fm-field"><span>{dt('Accepted: give roles')}</span><MultiSelect lazy giveRole name="accept_add_role_ids" options={roles} selected={f.accept_add_role_ids ?? []} placeholder={dt('No roles')} /></div>
            <div class="fm-field"><span>{dt('Accepted: take roles')}</span><MultiSelect lazy name="accept_remove_role_ids" options={roles} selected={f.accept_remove_role_ids ?? []} placeholder={dt('No roles')} /></div>
            <div class="fm-field"><span>{dt('Denied: give roles')}</span><MultiSelect lazy giveRole name="deny_add_role_ids" options={roles} selected={f.deny_add_role_ids ?? []} placeholder={dt('No roles')} /></div>
            <div class="fm-field"><span>{dt('Denied: take roles')}</span><MultiSelect lazy name="deny_remove_role_ids" options={roles} selected={f.deny_remove_role_ids ?? []} placeholder={dt('No roles')} /></div>
            <label class="fm-check fm-wide"><input type="checkbox" name="dm_results" checked={f.dm_results} />{dt('Send the member a DM with the result')}</label>
          </div>
          <p class="fm-hint">{dt('Variables:')} {variableChips.map((v) => <code class="fm-var">{v}</code>)} {dt('and the usual ones.')}</p>
          <div class="fm-grid">
            <label class="fm-field fm-wide"><span>{dt('When it is sent')}</span><textarea class="dgl-autogrow" data-count name="msg_submitted" data-ac rows="2" maxlength={LIMITS.message} placeholder={defaultMessages.submitted}>{f.messages?.submitted?.text ?? ''}</textarea></label>
            <label class="fm-field"><span>{dt('When it is accepted')}</span><textarea class="dgl-autogrow" data-count name="msg_accepted" data-ac rows="3" maxlength={LIMITS.message} placeholder={defaultMessages.accepted}>{f.messages?.accepted?.text ?? ''}</textarea></label>
            <label class="fm-field"><span>{dt('When it is denied')}</span><textarea class="dgl-autogrow" data-count name="msg_denied" data-ac rows="3" maxlength={LIMITS.message} placeholder={defaultMessages.denied}>{f.messages?.denied?.text ?? ''}</textarea></label>
            <label class="fm-field"><span>{dt('Saved embed when accepted')}</span><select name="tpl_accepted" data-tpl-locks="msg_accepted"><option value="">{dt('None: use the text')}</option>{templates.map((n) => <option value={n} selected={n === f.messages?.accepted?.template}>{n}</option>)}</select></label>
            <label class="fm-field"><span>{dt('Saved embed when denied')}</span><select name="tpl_denied" data-tpl-locks="msg_denied"><option value="">{dt('None: use the text')}</option>{templates.map((n) => <option value={n} selected={n === f.messages?.denied?.template}>{n}</option>)}</select></label>
          </div>
          </div>
        </details>

        <details class="fm-fold" id="fm-web-page" data-fm-fold>
          <summary><span class="fm-fold-icon" aria-hidden="true"><Icon name="ph:browser-bold" width="16" height="16" /></span><span class="fm-fold-title"><h2>{dt('Web page')}</h2><em>{dt('How the page of the form looks on petto.sbs.')}</em></span><Icon name="ph:caret-down-bold" class="fm-fold-caret" width="14" height="14" /></summary>
          <div class="fm-fold-body">          
          <p class="fm-hint">{dt('How the page of the form looks on petto.sbs. The color of the form (in Basics) is its accent; the tab shows the icon of the server, and its title is the form and the server.')}</p>
          <div class="fm-grid">
            <label class="fm-check fm-wide"><input type="checkbox" name="web_enabled" checked={f.web_enabled !== false} />{dt('Allow filling on the web')}</label>
            {!isNew && f.web_enabled !== false && webPath && (
              <div class="fm-weblink fm-wide">
                <span class="fm-weblink-label">{dt('Link of the form:')}</span>
                <div class="fm-weblink-row">
                  <a class="fm-weblink-url" href={webPath} target="_blank" rel="noopener"><span class="fm-weblink-host">{`petto.sbs${webPath.slice(0, -12)}`}</span><b>{f.public_id}</b></a>
                  <button type="button" class="btn btn-ghost btn-sm" data-fm-copy={`https://petto.sbs${webPath}`} data-done={dt('Copied')}><Icon name="ph:copy-simple-bold" width="13" height="13" /><span>{dt('Copy')}</span></button>
                  <button type="submit" class="btn btn-ghost btn-sm" form="fm-relink" formnovalidate><Icon name="ph:arrows-clockwise-bold" width="13" height="13" />{dt('New link')}</button>
                </div>
                <em class="fm-hint">{dt('Anyone in the server with this link can open the form. Pasted in Discord, it shows the link preview below. A new link stops the old one at once; panels already posted keep the old one.')}</em>
              </div>
            )}
            <label class="fm-field fm-wide"><span>{dt('Banner image')}</span><input type="text" inputmode="url" name="page_banner" value={look.banner ?? ''} maxlength={LIMITS.image} placeholder="https://…/banner.png" autocomplete="off" spellcheck="false" data-page-banner /><em>{dt('A wide picture on top of the page: an https link to a .png, .jpg, .gif or .webp picture. Empty: no banner.')}</em><em class="fm-bad" data-page-banner-bad hidden>{dt('That link cannot be used: it must start with https:// and end in .png, .jpg, .gif or .webp.')}</em></label>
            <label class="fm-field"><span>{dt('Background')}</span><select name="page_background" data-page-background>{PAGE_BACKGROUNDS.map((b) => <option value={b} selected={b === look.background} disabled={!premiumActive && PREMIUM_PAGE_BACKGROUNDS.includes(b) && b !== look.background}>{backgroundNames[b]}{premiumMark(b)}</option>)}</select></label>
            <div class="fm-field fm-center">
              <label class="fm-check"><input type="checkbox" name="page_show_icon" checked={look.show_icon} data-page-show-icon />{dt('Show the server icon')}</label>
