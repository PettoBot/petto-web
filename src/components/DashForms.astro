    }
    function drawPreview() {
      if (!pages) return;
      pages.textContent = '';
      const titleInput = form?.querySelector<HTMLInputElement>('[data-preview-title]');
      const title = (titleInput?.value || '').trim() || text.apply;
      const valid = state.filter((q) => q.label.trim());
      const count = Math.ceil(valid.length / 5);
      for (let p = 0; p < count; p += 1) {
        const box = el('div', { class: 'fm-dmodal' }, el('b', {}, `${title.slice(0, 45 - (count > 1 ? 6 : 0))}${count > 1 ? ` (${p + 1}/${count})` : ''}`));
        for (const q of valid.slice(p * 5, p * 5 + 5)) {
          const isMenu = q.type === 'yesno' || q.type === 'choice' || q.type === 'multi';
          const hint = q.placeholder || (isMenu ? (q.type === 'multi' ? text.pickMany : text.pick) : q.type === 'number' ? text.number : '');
          box.append(el('div', { class: 'fm-dfield' },
            el('span', {}, q.label, q.required ? el('i', {}, ' *') : null),
            labelDescription(q) ? el('small', {}, labelDescription(q)) : null,
            el('div', { class: `fm-dinput${q.type === 'paragraph' ? ' tall' : ''}${isMenu ? ' menu' : ''}` }, hint)));
        }
        box.append(el('div', { class: 'fm-dfoot' }, el('span', { class: 'fm-dbtn primary' }, p < count - 1 ? text.next : text.submit)));
        pages.append(box);
      }
      // The same questions as the web page shows them: the image over the question and the description under it.
      const extras = valid.filter((q) => q.description.trim() || imageUrl(q.image));
      if (!extras.length) return;
      const web = el('div', { class: 'fm-wpreview' }, el('b', {}, text.web));
      for (const q of extras) {
        const src = imageUrl(q.image);
        const desc = el('div', { class: 'fm-wdesc' });
        desc.innerHTML = descriptionHtml(q.description); // escaped by descriptionHtml: only its own few tags
        web.append(el('div', { class: 'fm-wq' },
          src ? el('img', { src, alt: q.label, loading: 'lazy', decoding: 'async', referrerPolicy: 'no-referrer' }) : null,
          el('span', {}, q.label, q.required ? el('i', {}, ' *') : null),
          q.description.trim() ? desc : null));
      }
      pages.append(web);
    }
    function draw() {
      root!.textContent = '';
      if (!state.length) root!.append(el('p', { class: 'fm-hint' }, text.empty));
      state.forEach((q, i) => root!.append(drawQuestion(q, i)));
      root!.append(el('button', { type: 'button', class: 'btn btn-ghost btn-sm', disabled: state.length >= limit, on: { click: () => { state.push({ id: newId(), type: 'short', label: '', help: '', description: '', image: '', placeholder: '', required: true, options: [] }); draw(); root!.querySelector<HTMLInputElement>('.fm-q:last-of-type input[type="text"]')?.focus(); } } }, state.length >= limit ? text.limit : `+ ${text.add}`));
      save();
    }
    draw();
    quiet = false;

    // The panel on the right follows the title, text and button as they are typed.
    const bind = (selector: string, target: string, fallback: () => string) => {
      const input = form?.querySelector<HTMLInputElement | HTMLTextAreaElement>(selector);
      const out = document.querySelector<HTMLElement>(target);
      if (!input || !out) return;
