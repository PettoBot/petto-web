    bannerImg?.addEventListener('error', () => { if (bannerBox) bannerBox.hidden = true; });
    form.addEventListener('input', draw);
    form.addEventListener('change', draw);
    draw();
  }
  // The preview of the link of the form follows its own fields, and falls back like the real tags do: the title and the description
  // of the form, the banner of the page (big) or the icon of the server (small), and the color of the form.
  function initEmbedPreview() {
    const pv = document.querySelector<HTMLElement>('[data-embed-pv]');
    const form = pv?.closest('form');
