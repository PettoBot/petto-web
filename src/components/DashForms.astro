          </div>
          <label class="dfx-switch"><span><b>{dt('Add a "Fill on the web" link button')}</b><em>{dt('Members can also fill the form on the web, from a link button.')}</em></span><input type="checkbox" class="dfx-t" name="panel_web" /></label>
        </section>
        <div class="dfx-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:paper-plane-tilt-fill" width="13" height="13" />{dt('Post panel')}</button><span class="dfx-hint">{dt('Closed forms answer that they are closed when pressed.')}</span></div>
      </form>
      )}
      <div class="fms-posted">
        <div class="fms-head"><h2>{dt('Posted panels')} <span class="fms-count">{panels.length}</span></h2></div>
        {panels.length === 0 && <p class="fms-empty"><Icon name="ph:cursor-click-fill" width="20" height="20" />{dt('No panels yet.')}</p>}
        <div class="fms-rows dgl-stagger">
          {panels.map((p) => (
