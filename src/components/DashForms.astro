              </div>
              {p.message_id && <a class="btn btn-ghost btn-sm" href={`https://discord.com/channels/${guildId}/${p.channel_id}/${p.message_id}`} target="_blank" rel="noopener">{dt('Open in Discord')}</a>}
            </div>
          ))}
        </div>
      </div>
    </div>
  )}
  </div>
</DashGuildLayout>


<script is:inline>
  (function () {
    if (window.__fmFolds) return;
    window.__fmFolds = true;
    // Numbers get a minus and a plus (the same input, with the same name and limits; DashSettingsKit does the pressing).
    var plusSvg = '<svg viewBox="0 0 256 256" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M224 128a8 8 0 0 1-8 8h-88v88a8 8 0 0 1-16 0v-88H32a8 8 0 0 1 0-16h88V32a8 8 0 0 1 16 0v88h88a8 8 0 0 1 8 8Z"/></svg>';
    var minusSvg = '<svg viewBox="0 0 256 256" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M224 128a8 8 0 0 1-8 8H40a8 8 0 0 1 0-16h176a8 8 0 0 1 8 8Z"/></svg>';
    function steppers(root) {
      (root || document).querySelectorAll('.fm-editor .fm-field input[type="number"]').forEach(function (input) {
        if (input.closest('.sx-stepper')) return;
        var wrap = document.createElement('span'); wrap.className = 'sx-stepper';
        input.parentNode.insertBefore(wrap, input);
        wrap.innerHTML = '<button type="button" class="sx-step" data-sx-step="-1" tabindex="-1" aria-label="−">' + minusSvg + '</button>';
        wrap.appendChild(input);
        wrap.insertAdjacentHTML('beforeend', '<button type="button" class="sx-step" data-sx-step="1" tabindex="-1" aria-label="+">' + plusSvg + '</button>');
      });
    }
    // A required field inside a section that is closed, or a link to a section, opens it.
    document.addEventListener('invalid', function (e) { var d = e.target.closest && e.target.closest('details'); if (d) d.open = true; }, true);
    function openHash() { var id = location.hash.slice(1); var el = id ? document.getElementById(id) : null; if (el && el.matches('details')) el.open = true; }
    window.addEventListener('hashchange', openHash);
    document.addEventListener('click', function (e) { var a = e.target.closest && e.target.closest('a[href^="#fm-"]'); if (a) { var el = document.getElementById(a.getAttribute('href').slice(1)); if (el && el.matches('details')) el.open = true; } });
    function init() { steppers(); openHash(); var q = document.querySelector('[data-q-builder]'); if (q) new MutationObserver(function () { steppers(q); }).observe(q, { childList: true, subtree: true }); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  })();
</script>
<script>
  // The questions of a form: drawn on `[data-q-builder]`, saved as JSON in `[data-q-output]`, reordered by dragging or with the arrows,
  // and shown on the right as the pages of five questions a member sees in Discord.
  import { descriptionHtml, imageUrl, labelDescription } from '../utils/forms';
  function initFormsBuilder() {
    const root = document.querySelector<HTMLElement>('[data-q-builder]');
    const output = document.querySelector<HTMLInputElement>('[data-q-output]');
    if (!root || !output || root.dataset.bound) return;
    root.dataset.bound = '1';
    type Q = { id: string; type: string; label: string; help: string; description: string; image: string; placeholder: string; required: boolean; min_length?: number | null; max_length?: number | null; min_value?: number | null; max_value?: number | null; options?: string[]; max_choices?: number | null };
    const text = JSON.parse(root.dataset.text ?? '{}');
    const limits = JSON.parse(root.dataset.limits ?? '{}');
    const types: string[] = JSON.parse(root.dataset.types ?? '[]');
    const limit = Number(root.dataset.limit) || 10;
    const state: Q[] = (JSON.parse(root.dataset.initial ?? '[]') as any[]).map((q) => ({ ...q, help: q.help ?? '', description: q.description ?? '', image: q.image ?? '', placeholder: q.placeholder ?? '', options: q.options ?? [] }));
    let n = 0;
    const newId = () => `q${Date.now().toString(36)}${(n++).toString(36)}`.slice(0, 20);
    const counter = document.querySelector<HTMLElement>('[data-q-count]');
    const pages = document.querySelector<HTMLElement>('[data-pv-pages]');
    const form = root.closest('form');
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, props: Record<string, any> = {}, ...kids: (Node | string | null)[]) => {
      const e = document.createElement(tag);
      for (const [k, v] of Object.entries(props)) {
        if (k === 'class') e.className = v;
        else if (k === 'on') for (const [ev, fn] of Object.entries(v as Record<string, EventListener>)) e.addEventListener(ev, fn);
        else if (k.includes('-')) { if (v !== undefined && v !== null && v !== false) e.setAttribute(k, String(v)); }
        else if (v !== undefined && v !== null && v !== false) (e as any)[k] = v;
      }
      for (const kid of kids) if (kid !== null) e.append(kid);
      return e;
    };
    const field = (label: string, input: HTMLElement, wide = false) => el('label', { class: `fm-field${wide ? ' fm-wide' : ''}` }, el('span', {}, label), input);
    let quiet = true;
    const save = () => {
      output.value = JSON.stringify(state.map((q) => ({ ...q, help: q.help || null, description: q.description || null, image: q.image.trim() || null, placeholder: q.placeholder || null })));
      if (counter) counter.textContent = `${state.length}/${limit}`;
      drawPreview();
      if (!quiet) output.dispatchEvent(new Event('input', { bubbles: true }));
    };
    const num = (value: string) => (value.trim() === '' ? null : Number(value));
    let dragFrom = -1;
    function drawQuestion(q: Q, i: number): HTMLElement {
      const typeSelect = el('select', { 'aria-label': text.question, on: { change: (e: Event) => { q.type = (e.target as HTMLSelectElement).value; draw(); } } }, ...types.map((t) => el('option', { value: t, selected: q.type === t }, text.types[t])));
      const label = el('input', { type: 'text', value: q.label, maxLength: limits.label, placeholder: text.label, required: true, on: { input: (e: Event) => { q.label = (e.target as HTMLInputElement).value; save(); } } });
      const help = el('input', { type: 'text', value: q.help, maxLength: limits.help, on: { input: (e: Event) => { q.help = (e.target as HTMLInputElement).value; save(); } } });
      const placeholder = el('input', { type: 'text', value: q.placeholder, maxLength: limits.placeholder, on: { input: (e: Event) => { q.placeholder = (e.target as HTMLInputElement).value; save(); } } });
      const description = el('textarea', { class: 'dgl-autogrow', rows: 3, value: q.description, maxLength: limits.questionDescription, on: { input: (e: Event) => { q.description = (e.target as HTMLTextAreaElement).value; save(); } } });
      const imageNote = el('em', {}, text.imageHint);
      const imageCheck = () => {
        const bad = Boolean(q.image.trim()) && !imageUrl(q.image);
        imageNote.textContent = bad ? text.imageBad : text.imageHint;
