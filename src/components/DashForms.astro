  .fm-field { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .fm-field.fm-center { gap: 10px; }
  .fm-field em[hidden] { display: none; }
  /* The preview of the web page: the head of /form/<id> at a small size, with the color, background and banner of the form. */
