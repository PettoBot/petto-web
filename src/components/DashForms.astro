      const ownTitle = q<HTMLInputElement>('[data-embed-title]')?.value.trim() ?? '';
      const ownDesc = (q<HTMLTextAreaElement>('[data-embed-desc]')?.value ?? '').replace(/\s+/g, ' ').trim();
      const titleEl = pv.querySelector<HTMLElement>('[data-embed-pv-title]');
      const descEl = pv.querySelector<HTMLElement>('[data-embed-pv-desc]');
      const site = pv.dataset.site ?? '';
      if (titleEl) titleEl.textContent = ownTitle || (formTitle ? `${formTitle} · ${site}` : titleEl.dataset.default ?? '');
      if (descEl) descEl.textContent = ownDesc || formDesc.slice(0, 200) || (descEl.dataset.default ?? '');
      const link = q<HTMLInputElement>('[data-embed-image]')?.value.trim() ?? '';
      const own = link ? imageUrl(link) : null;
      const bad = q<HTMLElement>('[data-embed-image-bad]'); if (bad) bad.hidden = !link || Boolean(own);
      const bannerLink = q<HTMLInputElement>('[data-page-banner]')?.value.trim() ?? '';
      const banner = bannerLink ? imageUrl(bannerLink) : null;
      const picture = own ?? banner ?? pv.dataset.icon ?? '';
      const img = pv.querySelector<HTMLElement>('[data-embed-pv-img]');
      if (img) img.style.backgroundImage = picture ? `url(${JSON.stringify(picture)})` : '';
