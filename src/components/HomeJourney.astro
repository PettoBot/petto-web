---
// A decoration for the home page: a dotted path that winds down the margins of the page, drawn as the visitor scrolls, with a caterpillar that crawls along it,
// hangs as a chrysalis halfway and comes out as a butterfly at the end. It has no text, nothing in it can be focused or clicked, and it takes no room: it
// is absolutely placed over the whole <main>, where it only draws in the empty margins and in the gaps between sections (see src/utils/homeJourney.mjs).
// The path is drawn by the script below, once the page has loaded, from the measured sections.
---
<div class="jy" data-home-journey aria-hidden="true">
  <svg class="jy-svg" focusable="false" aria-hidden="true" preserveAspectRatio="none">
    <defs>
      <g id="jy-wing">
        <path class="jy-fill jy-sky" d="M2-3C6-34 30-58 55-50C73-44 68-12 44-2C30 3 12 1 2-3Z" />
        <path class="jy-fill jy-pink" d="M2 4C14 2 33 8 42 22C50 38 34 52 22 42C10 32 4 18 2 4Z" />
        <circle class="jy-fill jy-butter" cx="42" cy="-26" r="7" />
        <circle class="jy-fill jy-cream" cx="27" cy="-18" r="3" />
        <circle class="jy-fill jy-butter" cx="27" cy="29" r="4.5" />
        <path class="jy-shine" d="M18-38C26-46 38-48 46-44" />
      </g>
    </defs>
    <path class="jy-route" />
    <g class="jy-dots"></g>
    <g class="jy-sparks"></g>

    <g class="jy-cr jy-cat">
      <g class="jy-feet">
        <path d="M-44 7v6M-36 7v6M-29 10v6M-21 10v6M-12 11v6M-4 11v6M6 12v6M14 12v6" />
      </g>
      <g class="jy-seg" style="--i:0"><circle class="jy-fill jy-butter" cx="-40" cy="0" r="8" /></g>
      <g class="jy-seg" style="--i:1"><circle class="jy-fill jy-mint" cx="-25" cy="0" r="11" /><circle class="jy-spot" cx="-25" cy="-5" r="2.2" /></g>
      <g class="jy-seg" style="--i:2"><circle class="jy-fill jy-butter" cx="-8" cy="0" r="12.5" /><circle class="jy-spot" cx="-8" cy="-6" r="2.4" /></g>
      <g class="jy-seg" style="--i:3"><circle class="jy-fill jy-mint" cx="10" cy="0" r="13" /><circle class="jy-spot" cx="10" cy="-6" r="2.4" /></g>
      <g class="jy-seg" style="--i:4">
        <path class="jy-feeler" d="M26-13Q22-27 13-29M39-13Q43-27 52-26" />
        <circle class="jy-fill jy-pink" cx="13" cy="-29" r="3.4" />
        <circle class="jy-fill jy-pink" cx="52" cy="-26" r="3.4" />
        <circle class="jy-fill jy-mint" cx="32" cy="0" r="15" />
        <circle class="jy-blush" cx="23" cy="5" r="3.2" />
        <circle class="jy-blush" cx="41" cy="5" r="3.2" />
        <circle class="jy-eye" cx="26" cy="-4" r="2.7" />
        <circle class="jy-eye" cx="38" cy="-4" r="2.7" />
        <circle class="jy-glint" cx="27" cy="-5" r="0.9" />
        <circle class="jy-glint" cx="39" cy="-5" r="0.9" />
        <path class="jy-smile" d="M28 6Q32 11 37 6" />
      </g>
    </g>

    <g class="jy-cr jy-chry">
      <g class="jy-swing">
        <path class="jy-feeler" d="M-24-41Q0-48 24-40" />
        <path class="jy-fill jy-mint" d="M13-43C20-55 34-54 38-46C30-38 20-38 13-43Z" />
        <path class="jy-thread" d="M0-44V-29" />
        <path class="jy-fill jy-pink" d="M0-29C14-29 18-8 12 14C9 26 4 33 0 38C-4 33-9 26-12 14C-18-8-14-29 0-29Z" />
        <path class="jy-peachband" d="M-10-12Q0-6 10-12M-12 3Q0 9 12 3M-9 18Q0 23 9 18" />
        <path class="jy-shine" d="M-8-21C-11-12-11-4-9 3" />
        <path class="jy-fill jy-cream" d="M24 -2Q25.2 3.2 30.5 4.5Q25.2 5.8 24 11Q22.8 5.8 17.5 4.5Q22.8 3.2 24-2Z" />
      </g>
    </g>

    <g class="jy-cr jy-fly">
      <g class="jy-bob">
        <g class="jy-wings"><use href="#jy-wing" /><use href="#jy-wing" transform="scale(-1 1)" /></g>
        <path class="jy-feeler" d="M-2-27Q-8-44-19-48M2-27Q8-44 19-48" />
        <circle class="jy-eye" cx="-19" cy="-48" r="2.8" />
        <circle class="jy-eye" cx="19" cy="-48" r="2.8" />
        <ellipse class="jy-body" cx="0" cy="2" rx="4.6" ry="22" />
        <circle class="jy-body" cx="0" cy="-24" r="6.5" />
      </g>
    </g>
  </svg>
</div>

<style is:global>
  /* The wrapper the drawing is placed in. Nothing in the page changes its place: the drawing is out of the flow. */
  main#top { position: relative; }
  /* The row of logos runs the full width of the page: the drawing goes behind it. */
  main#top .marquee { position: relative; z-index: 1; }
  .jy {
    position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; user-select: none;
    --jy-line: #F8EFDD; --jy-ink: #26231f; --jy-ghost: rgba(248, 239, 221, 0.2);
    --jy-butter: #FFD84D; --jy-mint: #9FE0B8; --jy-peach: #FFB59A; --jy-sky: #9CCBF3; --jy-pink: #FF9EC3; --jy-cream: #FFF4DC;
  }
  :root[data-theme='light'] .jy { --jy-line: #26231f; --jy-ghost: rgba(38, 35, 31, 0.2); }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .jy { --jy-line: #26231f; --jy-ghost: rgba(38, 35, 31, 0.2); }
  }
  .jy-svg { position: absolute; left: 0; top: 0; display: block; width: 100%; height: 100%; overflow: hidden; }

  .jy-route { fill: none; stroke: none; visibility: hidden; }
  /* The dots of the way ahead are faint; each one lights up, with a little pop, when the drawing gets there. */
  .jy-dot { fill: var(--jy-ghost); stroke: none; transform: scale(0.55); transform-box: fill-box; transform-origin: center; transition: fill 0.3s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .jy-dot.on { stroke: color-mix(in srgb, var(--jy-line) 38%, transparent); stroke-width: 0.9; transform: none; }
  .jy-dot.on.c0 { fill: var(--jy-butter); } .jy-dot.on.c1 { fill: var(--jy-mint); } .jy-dot.on.c2 { fill: var(--jy-sky); } .jy-dot.on.c3 { fill: var(--jy-pink); } .jy-dot.on.c4 { fill: var(--jy-peach); }
  .jy-spark { stroke: var(--jy-line); stroke-width: 1.6; stroke-linejoin: round; opacity: 0; transform: scale(0.1); transform-box: fill-box; transform-origin: center; transition: opacity 0.35s ease, transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .jy-spark.on { opacity: 1; transform: none; }

  /* The three drawings: flat pastel shapes with a thick outline, like the stickers of the link preview cards. */
  .jy-cr { opacity: 0; }
  .jy-fill, .jy-body { stroke: var(--jy-line); stroke-width: 3.2; stroke-linejoin: round; stroke-linecap: round; }
  .jy-butter { fill: var(--jy-butter); } .jy-mint { fill: var(--jy-mint); } .jy-peach { fill: var(--jy-peach); }
  .jy-sky { fill: var(--jy-sky); } .jy-pink { fill: var(--jy-pink); } .jy-cream { fill: var(--jy-cream); }
  .jy-body { fill: var(--jy-ink); stroke-width: 2.4; }
  .jy-feet, .jy-feeler, .jy-thread { fill: none; stroke: var(--jy-line); stroke-width: 2.6; stroke-linecap: round; }
  .jy-spot { fill: var(--jy-pink); opacity: 0.85; }
  .jy-blush { fill: var(--jy-pink); opacity: 0.8; }
  .jy-eye { fill: var(--jy-ink); }
  .jy-glint { fill: #fff; }
  .jy-smile { fill: none; stroke: var(--jy-ink); stroke-width: 2.2; stroke-linecap: round; }
  .jy-peachband { fill: none; stroke: var(--jy-peach); stroke-width: 4.5; stroke-linecap: round; }
  .jy-shine { fill: none; stroke: #fff; stroke-width: 3; stroke-linecap: round; opacity: 0.8; }
  .jy-fly .jy-eye { fill: var(--jy-line); }

  /* The little life of each one. Only the drawing that is on show moves. */
  .jy-seg { animation: jy-inch 1.1s ease-in-out infinite; animation-delay: calc(var(--i) * -0.13s); }
  .jy-swing { animation: jy-swing 2.6s ease-in-out infinite alternate; transform-origin: 0 -44px; }
  .jy-wings { animation: jy-flap 0.7s ease-in-out infinite alternate; transform-origin: 0 0; }
  .jy-bob { animation: jy-bob 2.4s ease-in-out infinite alternate; }
  .jy[data-state='caterpillar'] :is(.jy-swing, .jy-wings, .jy-bob),
  .jy[data-state='chrysalis'] :is(.jy-seg, .jy-wings, .jy-bob),
  .jy[data-state='butterfly'] :is(.jy-seg, .jy-swing) { animation-play-state: paused; }
  @keyframes jy-inch { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3.5px); } }
  @keyframes jy-swing { from { transform: rotate(-6deg); } to { transform: rotate(6deg); } }
  @keyframes jy-flap { from { transform: scaleX(1); } to { transform: scaleX(0.55); } }
  @keyframes jy-bob { from { transform: translateY(-2px); } to { transform: translateY(3px); } }

  @media (prefers-reduced-motion: reduce) {
    .jy-seg, .jy-swing, .jy-wings, .jy-bob { animation: none; }
    .jy-dot, .jy-spark { transition: none; }
  }
</style>

<script>
  import { DOT_GAP, FINAL_SHARE, STATIC_SCENE, buildRoute, dotsFor, journeyState } from '../utils/homeJourney.mjs';

  type Table = { total: number; xs: Float32Array; ys: Float32Array; ks: Float32Array; ymax: Float32Array };
  const SAMPLE = 6;
  const NS = 'http://www.w3.org/2000/svg';
  const clamp = (n: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, n));

  const root = document.querySelector<HTMLElement>('[data-home-journey]');
  if (root) boot(root);

  function boot(root: HTMLElement) {
    const main = root.parentElement as HTMLElement;
    const svg = root.querySelector('svg') as SVGSVGElement;
    const ghost = svg.querySelector('.jy-route') as SVGPathElement;
    const dotsLayer = svg.querySelector('.jy-dots') as SVGGElement;
    const sparksLayer = svg.querySelector('.jy-sparks') as SVGGElement;
    const drawings = {
      caterpillar: svg.querySelector('.jy-cat') as SVGGElement,
      chrysalis: svg.querySelector('.jy-chry') as SVGGElement,
      butterfly: svg.querySelector('.jy-fly') as SVGGElement,
    };
    const reduceQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    let table: Table | null = null;
    let route: ReturnType<typeof buildRoute> = null;
    let dots: SVGElement[] = [];
    let sparks: { el: SVGElement; at: number }[] = [];
    let bands: { top: number; bottom: number }[] = [];
    let lit = 0;
    let litSparks = 0;
    let scrollEnd = 1;
    let mainTop = 0;
    let current = 0;
    let target = 0;
    let frame = 0;
    let faceX = 1;
    let faceTarget = 1;
    let heading = 90;
    let tilt = 0;
    let timer = 0;

    const ymaxAt = (s: number) => {
      const t = table as Table;
      const i = clamp(s / SAMPLE, 0, t.ymax.length - 1);
      const a = Math.floor(i);
      const b = Math.min(t.ymax.length - 1, a + 1);
      return t.ymax[a] + (t.ymax[b] - t.ymax[a]) * (i - a);
    };
    const pointAt = (s: number) => {
      const t = table as Table;
      const i = clamp(s / SAMPLE, 0, t.xs.length - 1);
      const a = Math.floor(i);
      const b = Math.min(t.xs.length - 1, a + 1);
      const f = i - a;
      return { x: t.xs[a] + (t.xs[b] - t.xs[a]) * f, y: t.ys[a] + (t.ys[b] - t.ys[a]) * f, k: t.ks[a] + (t.ks[b] - t.ks[a]) * f };
    };
    /** The length of path that is level with a height of the page. */
    const lengthAtY = (y: number) => {
      const t = table as Table;
      let lo = 0;
      let hi = t.ymax.length - 1;
      while (lo < hi) { const mid = (lo + hi) >> 1; if (t.ymax[mid] >= y) hi = mid; else lo = mid + 1; }
      return Math.min(t.total, lo * SAMPLE);
    };
    /** The length of path for a progress of the scroll (0 to 1): down the page by height, and the last part of the scroll is the flight to the end. */
    const lengthAt = (progress: number) => {
      const t = table as Table;
      const r = route as NonNullable<typeof route>;
      const p = clamp(progress, 0, 1);
      const split = 1 - FINAL_SHARE;
      if (p >= 1) return t.total;
      if (p >= split) { const from = lengthAtY(r.finalY); return from + (t.total - from) * ((p - split) / FINAL_SHARE); }
      return lengthAtY(r.start.y + (p / split) * (r.finalY - r.start.y));
    };
    /** The progress of the journey (0 to 1) of a length of path: the inverse of lengthAt, so the drawing changes where the scroll says it should. */
    const progressAt = (s: number) => {
      const t = table as Table;
      const r = route as NonNullable<typeof route>;
      const split = 1 - FINAL_SHARE;
      const from = lengthAtY(r.finalY);
      if (s >= from) return clamp(split + FINAL_SHARE * ((s - from) / Math.max(1, t.total - from)), 0, 1);
      return clamp((split * (ymaxAt(s) - r.start.y)) / Math.max(1, r.finalY - r.start.y), 0, split);
    };

    function measure() {
      const width = main.clientWidth;
      const sections = Array.from(main.querySelectorAll<HTMLElement>(':scope > section')).filter((s) => s.offsetHeight > 0).map((sec) => {
        const wrap = sec.querySelector<HTMLElement>(':scope > .wrap') ?? sec;
        const style = getComputedStyle(sec);
        const wrapStyle = getComputedStyle(wrap);
        const base = wrap !== sec && wrap.offsetParent === sec ? sec.offsetLeft : 0;
        const left = base + (wrap === sec ? 0 : wrap.offsetLeft) + parseFloat(wrapStyle.paddingLeft || '0');
        const right = base + (wrap === sec ? width : wrap.offsetLeft + wrap.offsetWidth) - parseFloat(wrapStyle.paddingRight || '0');
        return { top: sec.offsetTop, bottom: sec.offsetTop + sec.offsetHeight, padTop: parseFloat(style.paddingTop || '0'), padBottom: parseFloat(style.paddingBottom || '0'), left, right };
      });
      // Rows that run the full width of the page (the logos): the trail does not draw dots there, so it goes under them.
      bands = Array.from(main.querySelectorAll<HTMLElement>('.marquee')).map((el) => {
        let y = 0;
        for (let e: HTMLElement | null = el; e && e !== main; e = e.offsetParent as HTMLElement | null) y += e.offsetTop;
        return { top: y - 8, bottom: y + el.offsetHeight + 8 };
      });
      return { width, height: main.offsetHeight, sections };
    }

    function build() {
      const layout = measure();
      const next = layout.width > 0 && layout.height > 0 ? buildRoute(layout) : null;
      route = next && next.margin >= 8 ? next : null;
      dotsLayer.replaceChildren();
      sparksLayer.replaceChildren();
      dots = [];
      sparks = [];
      lit = 0;
      litSparks = 0;
      if (!route) { root.removeAttribute('data-ready'); table = null; return; }

      svg.setAttribute('width', String(layout.width));
      svg.setAttribute('height', String(layout.height));
      svg.setAttribute('viewBox', `0 0 ${layout.width} ${layout.height}`);
      // The points become a smooth line (Catmull-Rom as cubic curves).
      const pts = route.points;
      const f = (n: number) => n.toFixed(1);
      let d = `M${f(pts[0].x)} ${f(pts[0].y)}`;
      for (let i = 0; i < pts.length - 1; i += 1) {
        const p0 = pts[Math.max(0, i - 1)]; const p1 = pts[i]; const p2 = pts[i + 1]; const p3 = pts[Math.min(pts.length - 1, i + 2)];
        d += `C${f(p1.x + (p2.x - p0.x) / 6)} ${f(p1.y + (p2.y - p0.y) / 6)} ${f(p2.x - (p3.x - p1.x) / 6)} ${f(p2.y - (p3.y - p1.y) / 6)} ${f(p2.x)} ${f(p2.y)}`;
      }
      ghost.setAttribute('d', d);
      const total = ghost.getTotalLength();
      // How much of each part of the polyline is each part of the path, to know the scale of the drawing along it.
      const cum: number[] = [0];
      for (let i = 1; i < pts.length; i += 1) cum.push(cum[i - 1] + Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y));
      const ratio = cum[cum.length - 1] / total;
      const n = Math.ceil(total / SAMPLE) + 1;
      const t: Table = { total, xs: new Float32Array(n), ys: new Float32Array(n), ks: new Float32Array(n), ymax: new Float32Array(n) };
      let seg = 0;
      for (let i = 0; i < n; i += 1) {
        const at = Math.min(total, i * SAMPLE);
        const p = ghost.getPointAtLength(at);
        t.xs[i] = p.x; t.ys[i] = p.y;
        const L = at * ratio;
        while (seg < cum.length - 2 && cum[seg + 1] < L) seg += 1;
        const span = Math.max(1e-6, cum[seg + 1] - cum[seg]);
        t.ks[i] = pts[seg].k + (pts[seg + 1].k - pts[seg].k) * clamp((L - cum[seg]) / span, 0, 1);
        t.ymax[i] = i ? Math.max(t.ymax[i - 1], p.y) : p.y;
      }
      table = t;

      const dotFragment = document.createDocumentFragment();
      const dummy = document.createElementNS(NS, 'circle'); // stands for a dot that is not drawn, so the count of dots still follows the length
      const count = Math.floor(total / DOT_GAP) + 1;
      for (let i = 0; i < count; i += 1) {
        const p = ghost.getPointAtLength(i * DOT_GAP);
        if (bands.some((b) => p.y > b.top && p.y < b.bottom)) { dots.push(dummy); continue; }
        const dot = document.createElementNS(NS, 'circle');
        dot.setAttribute('class', `jy-dot c${i % 5}`);
        dot.setAttribute('cx', f(p.x)); dot.setAttribute('cy', f(p.y)); dot.setAttribute('r', '3.4');
        dotFragment.appendChild(dot);
        dots.push(dot);
      }
      dotsLayer.appendChild(dotFragment);

      // Sparkles: a few along the whole way and a trail of them where the butterfly flies off.
      const sparkAt: number[] = [];
      for (let s = 700; s < total - 800; s += 760) sparkAt.push(s);
      for (let i = 0; i < 9; i += 1) sparkAt.push(total - 30 - (8 - i) * 70);
      sparkAt.forEach((s, i) => {
        const p = pointAt(s);
        const size = clamp(p.k * 1.1, 0.5, 1.25);
        if (bands.some((b) => p.y > b.top - 20 && p.y < b.bottom + 20)) return;
        const holder = document.createElementNS(NS, 'g');
        holder.setAttribute('transform', `translate(${f(p.x)} ${f(p.y)}) scale(${size.toFixed(2)})`);
        const el = document.createElementNS(NS, 'path');
        el.setAttribute('class', `jy-spark jy-${['cream', 'butter', 'pink', 'sky', 'mint'][i % 5]}`);
        el.setAttribute('d', 'M0-9Q1.2-1.2 9 0Q1.2 1.2 0 9Q-1.2 1.2-9 0Q-1.2-1.2 0-9Z');
        holder.appendChild(el);
        sparksLayer.appendChild(holder);
        sparks.push({ el, at: s });
      });

      const docHeight = document.documentElement.scrollHeight;
      mainTop = main.getBoundingClientRect().top + window.scrollY;
      scrollEnd = Math.max(1, Math.min(docHeight - window.innerHeight, mainTop + route.bottom - window.innerHeight * 0.6));
      root.setAttribute('data-ready', '');
      current = target = targetLength();
      face(0, true);
      draw(current);
    }

    function targetLength() {
      if (reduceQuery.matches) return (table as Table).total;
      return lengthAt(clamp(window.scrollY / scrollEnd, 0, 1));
    }

    function place(g: SVGGElement, s: number, opacity: number, scale: number, spin: number, flipX: number) {
      const p = pointAt(s);
      g.style.opacity = opacity.toFixed(3);
      g.style.visibility = opacity < 0.01 ? 'hidden' : 'visible';
      g.setAttribute('transform', `translate(${p.x.toFixed(1)} ${p.y.toFixed(1)}) rotate(${spin.toFixed(1)}) scale(${(flipX * scale * p.k).toFixed(3)} ${(scale * p.k).toFixed(3)})`);
    }

    // The caterpillar turns to where the path goes (and turns around when the path goes back): the heading follows the path softly.
    function face(s: number, snap = false) {
      const a = pointAt(Math.max(0, s - 10));
      const b = pointAt(s + 10);
      const dx = b.x - a.x;
      const dy = b.y - a.y;
      const len = Math.hypot(dx, dy) || 1;
      if (Math.abs(dx) / len > 0.5) faceTarget = dx < 0 ? -1 : 1;
      const wanted = Math.min(70, (Math.atan2(dy, Math.abs(dx)) * 180) / Math.PI);
      const wantedTilt = clamp((dx / len) * 22, -22, 22);
      if (snap) { faceX = faceTarget; heading = wanted; tilt = wantedTilt; return; }
      faceX += (faceTarget - faceX) * 0.18;
      heading += (wanted - heading) * 0.2;
      tilt += (wantedTilt - tilt) * 0.2;
    }

    function draw(s: number) {
      if (!table) return;
      const want = Math.min(dots.length, dotsFor(s));
      while (lit < want) dots[lit++].classList.add('on');
      while (lit > want) dots[--lit].classList.remove('on');
      while (litSparks < sparks.length && sparks[litSparks].at <= s) sparks[litSparks++].el.classList.add('on');
      while (litSparks > 0 && sparks[litSparks - 1].at > s) sparks[--litSparks].el.classList.remove('on');

      if (reduceQuery.matches) {
        // A still picture of the whole story: the caterpillar where the path starts, the chrysalis halfway and the butterfly at the end.
        for (const pose of STATIC_SCENE) {
          const at = lengthAt(pose.at);
          if (pose.name === 'caterpillar') { face(at, true); place(drawings.caterpillar, at, 1, 1, faceX * heading, faceX); }
          else place(drawings[pose.name as 'chrysalis' | 'butterfly'], at, 1, 1, 0, 1);
        }
        root.setAttribute('data-state', 'still');
        return;
      }
      const st = journeyState(progressAt(s));
      root.setAttribute('data-state', st.name);
      face(s);
      place(drawings.caterpillar, s, st.caterpillar, st.scale.caterpillar, faceX * heading, faceX);
      place(drawings.chrysalis, s, st.chrysalis, st.scale.chrysalis, 0, 1);
      place(drawings.butterfly, s, st.butterfly, st.scale.butterfly, tilt, 1);
    }

    // The drawing follows the scroll with a little delay, so crossing a gap is a short run and not a jump.
    function step() {
      frame = 0;
      current += (target - current) * 0.16;
      if (Math.abs(target - current) < 0.5) current = target;
      draw(current);
      if (current !== target) frame = requestAnimationFrame(step);
    }
    function onScroll() {
      if (!table || reduceQuery.matches) return;
      target = targetLength();
      if (!frame) frame = requestAnimationFrame(step);
    }
    function rebuild() {
      timer = 0;
      if (frame) { cancelAnimationFrame(frame); frame = 0; }
      build();
    }
    function schedule() {
      if (timer) window.clearTimeout(timer);
      timer = window.setTimeout(rebuild, 90);
    }

    function start() {
      build();
      window.addEventListener('scroll', onScroll, { passive: true });
      const observer = new ResizeObserver(schedule);
      observer.observe(main);
      main.querySelectorAll(':scope > section').forEach((s) => observer.observe(s));
      main.addEventListener('load', schedule, true);
      document.fonts?.ready.then(schedule);
      reduceQuery.addEventListener('change', rebuild);
    }

    // After the page is drawn and the browser has nothing better to do, so it never competes with the content.
    const idle = (fn: () => void) => {
      if (typeof window.requestIdleCallback === 'function') window.requestIdleCallback(fn, { timeout: 1500 });
      else window.setTimeout(fn, 200);
    };
    if (document.readyState === 'complete') idle(start);
    else window.addEventListener('load', () => idle(start), { once: true });
  }
</script>
