---
// Media channels (Community): channels where only pictures and videos, or only links of some sites, can be posted. The bot deletes what does
// not fit (src/events/messageCreateMediaOnly.js of petto-bot). One card per channel; the sites are chips with their logo.
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MediaFields from './MediaFields.astro';
import Modal from './Modal.astro';
import { getDashLang, makeT } from '../i18n/dash';
import { MEDIA_NETWORKS, type MediaRule } from '../data/mediaChannels';

const dt = makeT(getDashLang(Astro));
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  rules: MediaRule[];
  channels: { id: string; name: string }[];
  roles: { id: string; name: string }[];
  ready: boolean;
  saved: string;
  failed: string;
}
const { user, guildId, guildName, guildIcon, rules, channels, roles, ready, saved, failed } = Astro.props;
const names = new Map(channels.map((c) => [c.id, c.name]));
const taken = new Set(rules.map((r) => r.channelId));
const free = channels.filter((c) => !taken.has(c.id));
const savedText: Record<string, string> = { added: dt('Channel added.'), saved: dt('Saved.'), removed: dt('Channel removed.') };
const errors: Record<string, string> = {
  channel: dt('Choose a channel from the list.'),
  empty: dt('Turn on attachments, links or both. To stop checking a channel, remove it.'),
  save: dt('It could not be saved. Try again in a moment.'),
};
const siteName = (id: string) => MEDIA_NETWORKS.find((n) => n.id === id)?.name ?? id;
const summary = (r: MediaRule) => {
  const parts: string[] = [];
  if (r.attachments) parts.push([r.images && dt('Pictures'), r.videos && dt('Videos'), r.audio && dt('Audio'), r.files && dt('Files')].filter(Boolean).join(', ') || dt('Attachments'));
  if (r.links) parts.push(r.networks.length ? r.networks.map(siteName).join(', ') : dt('Links of any site'));
  return parts.join(' · ');
};
const blank: MediaRule = { channelId: '', attachments: true, links: false, images: true, videos: true, audio: false, files: false, networks: [], caption: true, notice: true, bypassRoleIds: [] };
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="media" pageTitle={dt('Media channels')}>
  <div class="md-top">
    <h1>{dt('Media channels')}</h1>
    <button type="button" class="btn btn-accent btn-sm" data-modal-open="md-d-new" disabled={!ready || !free.length}><Icon name="ph:plus-bold" width="14" height="14" />{dt('Add channel')}</button>
  </div>
  {saved && <div class="md-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{savedText[saved] ?? savedText.saved}</div>}
  {failed && <div class="md-flash md-warn"><Icon name="ph:warning-fill" width="15" height="15" />{errors[failed] ?? errors.save}</div>}
  {!ready && <div class="md-flash md-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}

  <div class="md-grid dgl-stagger">
    {rules.map((r) => {
      const linkOnly = r.links && !r.attachments;
      return (
        <article class="md-card">
          <header class="md-head">
            <span class="md-ico"><Icon name={linkOnly ? 'ph:link-fill' : 'ph:image-fill'} width="18" height="18" /></span>
            <div class="md-main"><b>#{names.get(r.channelId) ?? r.channelId}</b><span>{linkOnly ? dt('Links only') : r.links ? dt('Attachments and links') : dt('Attachments only')}</span></div>
          </header>

          <div class="md-preview" aria-label={dt('Preview')}>
            <div class="md-pv-msg md-pv-ok">
              <span class="md-pv-av">L</span>
              <div>
                <b>Liam</b>
                {r.attachments && !linkOnly && <div class="md-pv-img"><Icon name="ph:image-fill" width="20" height="20" /></div>}
                {r.links && <p class="md-pv-link"><Icon name="ph:link-simple-bold" width="12" height="12" />{r.networks.length ? siteName(r.networks[0]) : dt('Any site')}</p>}
              </div>
              <Icon name="ph:check-circle-fill" width="16" height="16" class="md-pv-mark" />
            </div>
            <div class="md-pv-msg md-pv-no">
              <span class="md-pv-av">M</span>
              <div><b>Mia</b><p>{dt('hello everyone!')}</p></div>
              <Icon name="ph:trash-fill" width="16" height="16" class="md-pv-mark" />
            </div>
          </div>

          <p class="md-summary">{summary(r)}</p>
          <div class="md-foot">
            <span class="md-chips">
              {r.links && r.networks.slice(0, 5).map((id) => <span class="md-chip" title={siteName(id)}><Icon name={MEDIA_NETWORKS.find((n) => n.id === id)?.icon ?? 'ph:link-fill'} width="13" height="13" /></span>)}
            </span>
            <div class="md-acts">
              <button type="button" class="md-act" data-modal-open={`md-d-${r.channelId}`} aria-label={dt('Edit')} title={dt('Edit')}><Icon name="ph:pencil-simple-fill" width="15" height="15" /></button>
              <form method="POST" data-no-dirty>
                <input type="hidden" name="action" value="remove" /><input type="hidden" name="channel_id" value={r.channelId} />
                <button type="submit" class="md-act md-del" aria-label={dt('Remove channel')} title={dt('Remove channel')} data-confirm={dt('Remove this channel? Messages there will not be checked any more.')}><Icon name="ph:trash-fill" width="15" height="15" /></button>
              </form>
            </div>
          </div>
        </article>
      );
    })}
    <button type="button" class="md-card md-add" data-modal-open="md-d-new" disabled={!ready || !free.length}>
      <span class="md-ico"><Icon name="ph:plus-bold" width="18" height="18" /></span>
      <b>{dt('Add channel')}</b>
    </button>
  </div>
  <p class="md-hint md-prefix">{dt('With the prefix: !imgonly add #channel, !urlonly add #channel youtube x, !imgonly list.')}</p>

  <Modal id="md-d-new" title={dt('New media channel')} icon="ph:image-fill">
    <form method="POST" class="md-form" data-no-dirty>
      <input type="hidden" name="action" value="save" />
      <p class="md-lede">{dt('Everything else sent there is deleted, and the person is told why in a notice that deletes itself.')}</p>
      <div class="md-field">
        <label for="md-ch-new">{dt('Channel')}</label>
        <select id="md-ch-new" name="channel_id" required>
          <option value="">{dt('Choose a channel')}</option>
          {free.map((c) => <option value={c.id}>#{c.name}</option>)}
        </select>
      </div>
      <MediaFields rule={blank} roles={roles} />
      <footer><button type="button" class="btn btn-ghost btn-sm" data-modal-close>{dt('Cancel')}</button><button type="submit" class="btn btn-accent btn-sm" data-keep>{dt('Create')}</button></footer>
    </form>
  </Modal>

  {rules.map((r) => (
    <Modal id={`md-d-${r.channelId}`} title={`#${names.get(r.channelId) ?? r.channelId}`} icon={r.links && !r.attachments ? 'ph:link-fill' : 'ph:image-fill'}>
      <form method="POST" class="md-form" data-no-dirty>
        <input type="hidden" name="action" value="save" /><input type="hidden" name="channel_id" value={r.channelId} />
        <MediaFields rule={r} roles={roles} />
        <footer><button type="button" class="btn btn-ghost btn-sm" data-modal-close>{dt('Cancel')}</button><button type="submit" class="btn btn-accent btn-sm" data-keep>{dt('Save')}</button></footer>
      </form>
    </Modal>
  ))}
</DashGuildLayout>


<style>
  .md-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
  h1 { font-size: 24px; margin: 0; }
  .md-top .btn { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; flex: none; }
  .md-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 16px; max-width: 1000px; }
  .md-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: var(--yellow); }
  .md-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 14px; }
  .md-card { display: flex; flex-direction: column; gap: 14px; border: 1px solid var(--border); border-radius: 16px; background: var(--card); padding: 16px; text-align: left; font: inherit; color: inherit; }
  .md-head { display: flex; align-items: center; gap: 12px; }
  .md-ico { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); flex: none; }
  .md-main { flex: 1; min-width: 0; display: grid; gap: 2px; }
  .md-main b { font-size: 15px; overflow-wrap: anywhere; }
  .md-main span { font-size: 12.5px; color: var(--text-dim); }
  .md-preview { display: grid; gap: 8px; border-radius: 12px; background: var(--bg-raise, rgba(255, 255, 255, .03)); border: 1px solid var(--border-soft, var(--border)); padding: 12px; }
  .md-pv-msg { display: flex; align-items: flex-start; gap: 10px; font-size: 13px; }
  .md-pv-msg > div { flex: 1; min-width: 0; display: grid; gap: 4px; }
  .md-pv-msg p { margin: 0; color: var(--text-muted); }
  .md-pv-av { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font-size: 11px; font-weight: 700; background: var(--accent-soft); color: var(--accent); flex: none; }
  .md-pv-img { height: 44px; border-radius: 8px; display: grid; place-items: center; color: var(--text-dim); background: var(--accent-soft); }
  .md-pv-link { display: inline-flex; align-items: center; gap: 5px; color: var(--accent) !important; }
  .md-pv-ok :global(.md-pv-mark) { color: var(--green); }
  .md-pv-no { opacity: .6; }
  .md-pv-no p { text-decoration: line-through; }
  .md-pv-no :global(.md-pv-mark) { color: var(--red, #ff6b6b); }
  .md-summary { margin: 0; font-size: 12.5px; color: var(--text-dim); }
  .md-foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .md-chips { display: inline-flex; gap: 6px; flex-wrap: wrap; }
  .md-chip { width: 26px; height: 26px; border-radius: 8px; display: grid; place-items: center; border: 1px solid var(--border); color: var(--text-muted); }
  .md-add { align-items: center; justify-content: center; min-height: 160px; border-style: dashed; background: transparent; cursor: pointer; color: var(--text-muted); transition: border-color var(--m-fast) ease, color var(--m-fast) ease; }
  .md-add:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .md-add:disabled { opacity: .5; cursor: not-allowed; }
  .md-acts { display: flex; align-items: center; gap: 6px; flex: none; }
  .md-acts form { margin: 0; }
  .md-act { width: 34px; height: 34px; border-radius: 9px; border: 1px solid var(--border); background: none; color: var(--text-muted); display: grid; place-items: center; cursor: pointer; transition: transform var(--m-instant) ease, border-color var(--m-fast) ease, color var(--m-fast) ease; }
  .md-act:hover { border-color: var(--text-dim); color: var(--text); }
  .md-act:active { transform: scale(var(--m-press)); }
  .md-del:hover { color: var(--red, #ff6b6b); border-color: var(--red, #ff6b6b); }
  .md-hint { display: block; font-size: 12px; color: var(--text-dim); margin: 10px 0 0; }
  .md-prefix { margin-top: 14px; }
  .md-form { display: grid; gap: 16px; }
  .md-lede { margin: -6px 0 0; font-size: 13px; color: var(--text-dim); }
  .md-field { display: grid; gap: 6px; }
  .md-field label { font-size: 13px; font-weight: 600; }
  .md-field select { border: 1px solid var(--border); border-radius: 8px; padding: 9px 10px; background: var(--card); color: var(--text); font: inherit; font-size: 13.5px; min-width: 0; }
  .md-form footer { display: flex; justify-content: flex-end; gap: 8px; padding-top: 4px; }
</style>
