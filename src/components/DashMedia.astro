---
// Media channels (Community): channels where only pictures and videos, or only links of some sites, can be posted. The bot deletes what does
// not fit (src/events/messageCreateMediaOnly.js of petto-bot). One panel per channel; the sites are chips with their logo.
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import MediaFields from './MediaFields.astro';
import Modal from './Modal.astro';
import { getDashLang, makeT } from '../i18n/dash';
import { MEDIA_NETWORKS, type MediaRule } from '../data/mediaChannels';

const dt = makeT(getDashLang(Astro));
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  rules: MediaRule[];
  channels: { id: string; name: string }[];
  roles: { id: string; name: string }[];
  ready: boolean;
  saved: string;
  failed: string;
}
const { user, guildId, guildName, guildIcon, rules, channels, roles, ready, saved, failed } = Astro.props;
const names = new Map(channels.map((c) => [c.id, c.name]));
const taken = new Set(rules.map((r) => r.channelId));
const free = channels.filter((c) => !taken.has(c.id));
const savedText: Record<string, string> = { added: dt('Channel added.'), saved: dt('Saved.'), removed: dt('Channel removed.') };
const errors: Record<string, string> = {
  channel: dt('Choose a channel from the list.'),
  empty: dt('Turn on attachments, links or both. To stop checking a channel, remove it.'),
  save: dt('It could not be saved. Try again in a moment.'),
};
const siteName = (id: string) => MEDIA_NETWORKS.find((n) => n.id === id)?.name ?? id;
const siteOf = (id: string) => MEDIA_NETWORKS.find((n) => n.id === id);
// The numbers on top: all of them come from the rules the page already reads.
const withAttachments = rules.filter((r) => r.attachments).length;
const withLinks = rules.filter((r) => r.links).length;
const skipRoles = new Set(rules.flatMap((r) => r.bypassRoleIds)).size;
const blank: MediaRule = { channelId: '', attachments: true, links: false, images: true, videos: true, audio: false, files: false, networks: [], caption: true, notice: true, bypassRoleIds: [] };
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="media" pageTitle={dt('Media channels')}>
  <DashSettingsKit />
  <div class="sx-page md">
  <div class="md-top">
    <div>
      <h1>{dt('Media channels')}</h1>
      <p class="md-lead">{dt('Channels where only pictures and videos, or only links, can be posted. Petto deletes the rest.')}</p>
    </div>
    <button type="button" class="btn btn-accent btn-sm" data-modal-open="md-d-new" disabled={!ready || !free.length}><Icon name="ph:plus-bold" width="14" height="14" />{dt('Add channel')}</button>
  </div>
  {saved && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{savedText[saved] ?? savedText.saved}</div>}
  {failed && <div class="sx-flash sx-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{errors[failed] ?? errors.save}</div>}
  {!ready && <div class="sx-flash sx-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}

  <DashStatTiles tiles={[
    { label: dt('Channels'), value: rules.length, tone: 'voice' },
    { label: dt('With attachments'), value: withAttachments, tone: 'messages' },
    { label: dt('With links'), value: withLinks, tone: 'invites' },
    { label: dt('Roles that skip'), value: skipRoles, tone: 'joins' },
  ]} />

  {rules.length === 0 ? (
    <section class="sx-panel md-empty">
      <span class="md-empty-ico"><Icon name="ph:image-fill" width="26" height="26" /></span>
      <h2>{dt('No channel is checked yet')}</h2>
      <p>{dt('Keep a channel for pictures, videos or links only.')}</p>
      <button type="button" class="btn btn-accent btn-sm" data-modal-open="md-d-new" disabled={!ready || !free.length}><Icon name="ph:plus-bold" width="14" height="14" />{dt('Add channel')}</button>
    </section>
  ) : (
    <div class="md-grid dgl-stagger">
      {rules.map((r) => {
        const linkOnly = r.links && !r.attachments;
        const kinds = [r.images && dt('Pictures'), r.videos && dt('Videos'), r.audio && dt('Audio'), r.files && dt('Other files')].filter(Boolean) as string[];
        return (
          <article class="sx-panel md-rule">
            <header class="md-head">
              <span class="md-ico"><Icon name={linkOnly ? 'ph:link-fill' : 'ph:image-fill'} width="18" height="18" /></span>
              <div class="md-main"><b>#{names.get(r.channelId) ?? r.channelId}</b><span>{linkOnly ? dt('Links only') : r.links ? dt('Attachments and links') : dt('Attachments only')}</span></div>
            </header>

            <div class="md-allow">
              {r.attachments && <div class="md-line"><span class="md-line-label">{dt('Attachments')}</span><span class="md-chips">{kinds.length ? kinds.map((k) => <span class="sx-tag sx-tag-accent">{k}</span>) : <span class="sx-tag">{dt('Attachments')}</span>}</span></div>}
              {r.links && (
                <div class="md-line"><span class="md-line-label">{dt('Links')}</span><span class="md-chips">
                  {r.networks.length ? r.networks.map((id) => <span class="md-site" title={siteOf(id)?.name ?? id}><Icon name={siteOf(id)?.icon ?? 'ph:link-fill'} width="13" height="13" />{siteOf(id)?.name ?? id}</span>) : <span class="sx-tag sx-tag-accent">{dt('Any site')}</span>}
                </span></div>
              )}
            </div>

            <div class="md-preview" aria-label={dt('Preview')}>
              <div class="md-pv-msg md-pv-ok">
                <span class="md-pv-av">L</span>
                <div>
                  <b>Liam</b>
                  {r.attachments && !linkOnly && <img class="md-pv-img" src="/assets/memes/star.jpg" alt="" width="320" height="180" loading="lazy" decoding="async" />}
                  {r.links && <p class="md-pv-link"><Icon name="ph:link-simple-bold" width="12" height="12" />{r.networks.length ? siteName(r.networks[0]) : dt('Any site')}</p>}
                </div>
                <Icon name="ph:check-circle-fill" width="16" height="16" class="md-pv-mark" />
              </div>
              <div class="md-pv-msg md-pv-no">
                <span class="md-pv-av">M</span>
                <div><b>Mia</b><p>{dt('hello everyone!')}</p></div>
                <Icon name="ph:trash-fill" width="16" height="16" class="md-pv-mark" />
              </div>
            </div>

            <div class="md-foot">
              <span class="md-tags">
                <span class="sx-tag">{r.caption ? dt('Text next to it is fine') : dt('Nothing but the file or link')}</span>
                <span class="sx-tag">{r.notice ? dt('Says why it was deleted') : dt('Deletes without a notice')}</span>
                {r.bypassRoleIds.length > 0 && <span class="sx-tag sx-tag-accent">{r.bypassRoleIds.length === 1 ? dt('1 role skips it') : dt('{n} roles skip it', { n: r.bypassRoleIds.length })}</span>}
              </span>
              <div class="md-acts">
                <button type="button" class="md-act" data-modal-open={`md-d-${r.channelId}`} aria-label={dt('Edit')} title={dt('Edit')}><Icon name="ph:pencil-simple-fill" width="15" height="15" /></button>
                <form method="POST" data-no-dirty>
                  <input type="hidden" name="action" value="remove" /><input type="hidden" name="channel_id" value={r.channelId} />
                  <button type="submit" class="md-act md-del" aria-label={dt('Remove channel')} title={dt('Remove channel')} data-confirm={dt('Remove this channel? Messages there will not be checked any more.')}><Icon name="ph:trash-fill" width="15" height="15" /></button>
                </form>
              </div>
            </div>
          </article>
        );
      })}
      <button type="button" class="md-rule md-add" data-modal-open="md-d-new" disabled={!ready || !free.length}>
        <span class="md-ico"><Icon name="ph:plus-bold" width="18" height="18" /></span>
        <b>{dt('Add channel')}</b>
      </button>
    </div>
  )}

  {free.length > 0 && ready && (
    <section class="sx-panel md-free">
      <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--red)"><Icon name="ph:hash-fill" width="17" height="17" /></span><h2>{dt('Not checked yet')}</h2><span class="sx-tag">{free.length}</span></div>
      <p class="sx-lead">{dt('Click a channel to start checking it.')}</p>
      <div class="md-freelist">
        {free.slice(0, 18).map((c) => <button type="button" class="md-freechip" data-modal-open="md-d-new" data-media-pick={c.id}><Icon name="ph:hash-bold" width="12" height="12" />{c.name}</button>)}
        {free.length > 18 && <span class="md-more">{dt('+{n} more', { n: free.length - 18 })}</span>}
      </div>
    </section>
  )}

  <div class="sx-duo md-help">
    <section class="sx-panel">
      <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--green)"><Icon name="ph:shield-check-fill" width="17" height="17" /></span><h2>{dt('What happens to the rest')}</h2></div>
      <p class="sx-lead">{dt('Everything else sent there is deleted, and the person is told why in a notice that deletes itself.')}</p>
      <p class="sx-hint">{dt('Members with Manage Messages are never touched.')}</p>
    </section>
    <section class="sx-panel">
      <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--blue)"><Icon name="ph:terminal-window-fill" width="17" height="17" /></span><h2>{dt('Commands')}</h2></div>
      <p class="sx-lead">{dt('With the prefix: !imgonly add #channel, !urlonly add #channel youtube x, !imgonly list.')}</p>
    </section>
  </div>
  </div>

  <script is:inline>
    // A channel chip of "Not checked yet" opens the New window with that channel already chosen.
    if (!window.__mdPick) {
      window.__mdPick = true;
      document.addEventListener('click', function (event) {
        var chip = event.target.closest && event.target.closest('[data-media-pick]'); if (!chip) return;
        var select = document.getElementById('md-ch-new'); if (select) select.value = chip.getAttribute('data-media-pick');
      });
    }
  </script>

  <Modal id="md-d-new" title={dt('New media channel')} icon="ph:image-fill">
    <form method="POST" class="md-form" data-no-dirty>
      <input type="hidden" name="action" value="save" />
      <p class="md-lede">{dt('Everything else sent there is deleted, and the person is told why in a notice that deletes itself.')}</p>
      <div class="md-field">
        <label for="md-ch-new">{dt('Channel')}</label>
        <select id="md-ch-new" name="channel_id" required>
          <option value="">{dt('Choose a channel')}</option>
          {free.map((c) => <option value={c.id}>#{c.name}</option>)}
        </select>
      </div>
      <MediaFields rule={blank} roles={roles} />
      <footer><button type="button" class="btn btn-ghost btn-sm" data-modal-close>{dt('Cancel')}</button><button type="submit" class="btn btn-accent btn-sm" data-keep>{dt('Create')}</button></footer>
    </form>
  </Modal>

  {rules.map((r) => (
    <Modal id={`md-d-${r.channelId}`} title={`#${names.get(r.channelId) ?? r.channelId}`} icon={r.links && !r.attachments ? 'ph:link-fill' : 'ph:image-fill'}>
      <form method="POST" class="md-form" data-no-dirty>
        <input type="hidden" name="action" value="save" /><input type="hidden" name="channel_id" value={r.channelId} />
        <MediaFields rule={r} roles={roles} />
        <footer><button type="button" class="btn btn-ghost btn-sm" data-modal-close>{dt('Cancel')}</button><button type="submit" class="btn btn-accent btn-sm" data-keep>{dt('Save')}</button></footer>
      </form>
    </Modal>
  ))}
</DashGuildLayout>


<style>
  .md-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  h1 { font-size: 24px; margin: 0 0 6px; }
  .md-lead { margin: 0; font-size: 13.5px; line-height: 1.5; color: var(--text-muted); max-width: 70ch; }
  .md-top .btn { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; flex: none; }
  .md-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 14px; align-items: start; margin-bottom: 14px; }
  .md-rule { min-width: 0; text-align: left; font: inherit; color: inherit; }
  .md-head { display: flex; align-items: center; gap: 12px; }
  .md-ico { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); flex: none; }
  .md-main { flex: 1; min-width: 0; display: grid; gap: 2px; }
  .md-main b { font-size: 15px; overflow-wrap: anywhere; }
  .md-main span { font-size: 12.5px; color: var(--text-dim); }
  .md-allow { display: grid; gap: 8px; }
  .md-line { display: flex; align-items: flex-start; gap: 10px; }
  .md-line-label { flex: none; width: 76px; padding-top: 4px; font-size: 12px; color: var(--text-dim); }
  .md-chips { display: flex; flex-wrap: wrap; gap: 6px; min-width: 0; }
  .md-site { display: inline-flex; align-items: center; gap: 5px; font: 600 11.5px var(--sans); border-radius: 999px; padding: 3px 10px 3px 8px; color: var(--text-muted); background: color-mix(in srgb, var(--text) 7%, transparent); white-space: nowrap; }
  .md-preview { display: grid; gap: 8px; border-radius: 12px; background: var(--bg-raise, rgba(255, 255, 255, .03)); border: 1px solid var(--border-soft, var(--border)); padding: 12px; }
  .md-pv-msg { display: flex; align-items: flex-start; gap: 10px; font-size: 13px; }
  .md-pv-msg > div { flex: 1; min-width: 0; display: grid; gap: 4px; }
  .md-pv-msg p { margin: 0; color: var(--text-muted); }
  .md-pv-av { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font-size: 11px; font-weight: 700; background: var(--accent-soft); color: var(--accent); flex: none; }
  .md-pv-img { display: block; width: 100%; max-width: 220px; height: 96px; object-fit: cover; border-radius: 8px; }
  .md-pv-link { display: inline-flex; align-items: center; gap: 5px; color: var(--accent) !important; }
  .md-pv-ok :global(.md-pv-mark) { color: var(--green); }
  .md-pv-no { opacity: .6; }
  .md-pv-no p { text-decoration: line-through; }
  .md-pv-no :global(.md-pv-mark) { color: var(--red, #ff6b6b); }
  .md-foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .md-tags { display: flex; flex-wrap: wrap; gap: 6px; min-width: 0; }
  .md-add { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; height: 120px; border: 1px dashed var(--border); border-radius: 14px; background: transparent; cursor: pointer; color: var(--text-muted); transition: border-color var(--m-fast) ease, color var(--m-fast) ease; }
  .md-add b { font-size: 14px; }
  .md-add:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .md-add:disabled { opacity: .5; cursor: not-allowed; }
  .md-empty { align-items: center; text-align: center; gap: 8px; padding: 24px 18px; margin-bottom: 14px; border-style: dashed; }
  .md-empty h2 { margin: 0; font-size: 16px; }
  .md-empty p { margin: 0; max-width: 360px; font-size: 13.5px; color: var(--text-dim); }
  .md-empty .btn { display: inline-flex; align-items: center; gap: 6px; margin-top: 4px; }
  .md-empty-ico { width: 52px; height: 52px; border-radius: 16px; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); }
  .md-free { margin-bottom: 14px; }
  .md-free .sx-lead { margin: 0; }
  .md-freelist { display: flex; flex-wrap: wrap; gap: 8px; }
  .md-freechip { display: inline-flex; align-items: center; gap: 5px; max-width: 100%; min-width: 0; text-align: left; overflow-wrap: anywhere; border: 1px solid var(--border); border-radius: 999px; padding: 6px 12px 6px 10px; background: var(--card); color: var(--text-muted); font: inherit; font-size: 13px; cursor: pointer; transition: background-color var(--m-fast) ease, border-color var(--m-fast) ease, color var(--m-fast) ease; }
  .md-freechip :global(svg) { flex: none; }
  .md-freechip:hover { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }
  .md-more { align-self: center; font-size: 12.5px; color: var(--text-dim); }
  .md-help .sx-panel p { margin: 0; }
  .md-acts { display: flex; align-items: center; gap: 6px; flex: none; }
  .md-acts form { margin: 0; }
  .md-act { width: 34px; height: 34px; border-radius: 9px; border: 1px solid var(--border); background: none; color: var(--text-muted); display: grid; place-items: center; cursor: pointer; transition: transform var(--m-instant) ease, border-color var(--m-fast) ease, color var(--m-fast) ease; }
  .md-act:hover { border-color: var(--text-dim); color: var(--text); }
  .md-act:active { transform: scale(var(--m-press)); }
  .md-del:hover { color: var(--red, #ff6b6b); border-color: var(--red, #ff6b6b); }
  .md-form { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  .md-lede { margin: -6px 0 0; font-size: 13px; color: var(--text-dim); }
  .md-field { display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px; }
  .md-field label { font-size: 13px; font-weight: 600; }
  .md-field select { border: 1px solid var(--border); border-radius: 9px; padding: 9px 10px; background: var(--card); color: var(--text); font: inherit; font-size: 13.5px; min-width: 0; }
  .md-form footer { display: flex; justify-content: flex-end; gap: 8px; padding-top: 4px; }
  @media (prefers-reduced-motion: reduce) { .md-grid > * { animation: none; } }
  @media (max-width: 720px) { .md-top { flex-wrap: wrap; } .md-line { flex-direction: column; gap: 4px; } .md-line-label { width: auto; padding-top: 0; } }
</style>
