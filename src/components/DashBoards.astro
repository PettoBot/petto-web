---
// Boards (Automation): the starboard, the monkeyboard and the clownboard in one place. Each board is a panel with its emojis and channel;
// adding and editing happen in pop-up windows, like Media channels.
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import EmojiPicker from './EmojiPicker.astro';
import Modal from './Modal.astro';
import BoardFields from './BoardFields.astro';
import { getDashLang, makeT } from '../i18n/dash';
import { BOARD_KINDS, blankBoard, type BoardRow } from '../data/boardKinds';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  boards: BoardRow[];
  /** How many messages each board has reposted (null: not known). */
  entryCounts: (number | null)[];
  channels: { id: string; name: string }[];
  roles: { id: string; name: string }[];
  templates: string[];
  customEmojis: { id: string; name: string; animated: boolean }[];
  ready: boolean[];
  saved: string;
  failed: string;
}
const { user, guildId, guildName, guildIcon, boards, entryCounts, channels, roles, templates, customEmojis, ready, saved, failed } = Astro.props;
const names = new Map(channels.map((c) => [c.id, c.name]));
const byKind = new Map(boards.map((b) => [b.kind, b]));
const free = BOARD_KINDS.filter((k, i) => !byKind.has(k.id) && ready[i]);
const kindNames: Record<string, string> = { star: dt('Starboard'), monkey: dt('Monkeyboard'), clown: dt('Clownboard') };
const savedText: Record<string, string> = { saved: dt('Saved.'), removed: dt('Board removed.') };
const errors: Record<string, string> = { board: dt('Choose a board from the list.'), save: dt('It could not be saved. Try again in a moment.') };
const allReady = ready.every(Boolean);
const hex = (n: number) => `#${n.toString(16).padStart(6, '0')}`;
const blurb: Record<string, string> = {
  star: dt('What the server loves: the messages with enough reactions are reposted in its own channel.'),
  monkey: dt('The opposite of the starboard: the messages that deserve a facepalm.'),
  clown: dt('The messages that make the server laugh at someone.'),
};
// The numbers on top: all of them come from the boards the page already reads (the reposted ones from the count of their entries).
const kindIndex = new Map(BOARD_KINDS.map((k, i) => [k.id, i]));
const reposted = boards.map((b) => entryCounts[kindIndex.get(b.kind) ?? 0]);
const repostedKnown = reposted.length > 0 && reposted.every((n) => n !== null);
const repostedTotal = reposted.reduce<number>((sum, n) => sum + (n ?? 0), 0);
const emojiTotal = boards.reduce((sum, b) => sum + 1 + b.extraEmojis.length, 0);
const ignoredOf = (b: BoardRow) => b.ignoredChannelIds.length + b.ignoredRoleIds.length + b.ignoredUserIds.length;
const ignoredTotal = boards.reduce((sum, b) => sum + ignoredOf(b), 0);
const emojiHtml = (e: string) => {
  const m = /^<(a?):\w+:(\d+)>$/.exec(e);
  return m ? `<img src="https://cdn.discordapp.com/emojis/${m[2]}.${m[1] ? 'gif' : 'png'}?size=32" alt="" width="18" height="18">` : e;
};
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="boards" pageTitle={dt('Boards')}>
  <DashSettingsKit />
  <div class="sx-page bd">
  <div class="bd-top">
    <div>
      <h1>{dt('Boards')}</h1>
      <p class="bd-lead">{dt('Messages that get enough reactions are reposted in a channel of their own.')}</p>
    </div>
    <button type="button" class="btn btn-accent btn-sm" data-modal-open="bd-new" disabled={!free.length}><Icon name="ph:plus-bold" width="14" height="14" />{dt('Add board')}</button>
  </div>
  {saved && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{savedText[saved] ?? savedText.saved}</div>}
  {failed && <div class="sx-flash sx-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{errors[failed] ?? errors.save}</div>}
  {!allReady && <div class="sx-flash sx-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('Some boards arrive with the next Petto update.')}</div>}

  <DashStatTiles tiles={[
    { label: dt('Active boards'), value: boards.length, tone: 'joins' },
    ...(repostedKnown ? [{ label: dt('Messages reposted'), value: repostedTotal, tone: 'messages' as const }] : []),
    { label: dt('Emojis watched'), value: emojiTotal, tone: 'reactions' },
    { label: dt('Ignored'), value: ignoredTotal, tone: 'leaves' },
  ]} />

  <div class="bd-grid dgl-stagger">
    {BOARD_KINDS.map((kind, i) => {
      const b = byKind.get(kind.id);
      const color = hex(b?.color ?? kind.color);
      const count = entryCounts[i];
      return (
        <article class={`sx-panel bd-board${b ? '' : ' bd-board-off'}`} style={`--c:${color}`}>
          <header class="bd-head">
            <span class="bd-ico"><Icon name={kind.icon} width="18" height="18" /></span>
            <div class="bd-main">
              <b>{kindNames[kind.id]}</b>
              <span>{b ? `${b.channelId ? `#${names.get(b.channelId) ?? b.channelId}` : dt('No channel')} · ${dt('{n} reactions', { n: b.threshold })}` : blurb[kind.id]}</span>
            </div>
          </header>

          <div class="bd-preview" aria-label={dt('Preview')}>
            <p class="bd-pv-line"><span set:html={emojiHtml(b?.emoji ?? kind.emoji)}></span> <b>{b?.threshold ?? 3}</b> <i>{b?.channelId ? `#${names.get(b.channelId) ?? ''}` : '#memes'}</i></p>
            {b?.template ? (
              <p class="bd-pv-design"><Icon name="ph:paint-brush-fill" width="14" height="14" />{dt('Uses the saved design {name}.', { name: b.template })}</p>
            ) : (
              <div class="bd-pv-embed">
                <div class="bd-pv-author"><span class="bd-pv-av">L</span><b>Liam</b></div>
                <p class="bd-pv-text">{dt('this is the best meme')}</p>
                <img class="bd-pv-img" src={`/assets/memes/${kind.id}.jpg`} alt="" width="320" height="180" loading="lazy" decoding="async" />
                {(b?.jumpurl ?? true) && <span class="bd-pv-btn"><Icon name="ph:arrow-square-out-bold" width="12" height="12" />{dt('Original message')}</span>}
              </div>
            )}
          </div>

          {b ? (
            <>
              <ul class="bd-flags">
                {[[dt('Timestamp'), b.timestamp], [dt('Original message'), b.jumpurl], [dt('Attachments'), b.attachments], [dt('Own reaction'), b.selfstar]].map(([label, on]) => (
                  <li class:list={{ on }}><Icon name={on ? 'ph:check-circle-fill' : 'ph:minus-circle-fill'} width="14" height="14" />{label}</li>
                ))}
              </ul>
              <div class="bd-tags">
                <span class="sx-tag bd-tag-on">{dt('Active')}</span>
                {count !== null && <span class="sx-tag">{dt('Reposted: {n}', { n: count.toLocaleString(dashLang) })}</span>}
                {ignoredOf(b) > 0 && <span class="sx-tag">{dt('Ignores {n}', { n: ignoredOf(b) })}</span>}
              </div>
              <div class="bd-foot">
                <span class="bd-emojis" set:html={[b.emoji, ...b.extraEmojis].map(emojiHtml).join(' ')}></span>
                <div class="bd-acts">
                  <button type="button" class="bd-act" data-modal-open={`bd-${b.kind}`} aria-label={dt('Edit')} title={dt('Edit')}><Icon name="ph:pencil-simple-fill" width="15" height="15" /></button>
                  <form method="POST" data-no-dirty>
                    <input type="hidden" name="action" value="disable" /><input type="hidden" name="board" value={b.kind} />
                    <button type="submit" class="bd-act bd-del" aria-label={dt('Remove board')} title={dt('Remove board')} data-confirm={dt('Remove this board? Its reposts are forgotten, the messages already posted stay in the channel.')}><Icon name="ph:trash-fill" width="15" height="15" /></button>
                  </form>
                </div>
              </div>
            </>
          ) : (
            <>
              <div class="bd-tags"><span class="sx-tag">{dt('Not set up')}</span></div>
              <div class="bd-foot">
                <span class="bd-emojis">{kind.emoji}</span>
                <button type="button" class="btn btn-accent btn-sm" data-modal-open="bd-new" data-board-pick={kind.id} disabled={!ready[i]}><Icon name="ph:plus-bold" width="14" height="14" />{dt('Set up')}</button>
              </div>
            </>
          )}
        </article>
      );
    })}
  </div>

  <div class="sx-duo bd-help">
    <section class="sx-panel">
      <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#ffc107"><Icon name="ph:star-fill" width="17" height="17" /></span><h2>{dt('How reactions count')}</h2></div>
      <p class="sx-lead">{dt('The first is the main one, the others are optional. Any of them counts, and whoever reacts with several counts once.')}</p>
    </section>
    <section class="sx-panel">
      <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#9bd0f5"><Icon name="ph:terminal-window-fill" width="17" height="17" /></span><h2>{dt('Commands')}</h2></div>
      <p class="sx-lead">{dt('With the prefix: !starboard, !monkeyboard and !clownboard, for example !starboard emoji ⭐ 🍌.')}</p>
    </section>
  </div>
  </div>

  <Modal id="bd-new" title={dt('New board')} icon="ph:star-fill">
    <form method="POST" class="bd-form" data-no-dirty data-board-add>
      <input type="hidden" name="action" value="save" />
      <div class="bd-kinds" role="radiogroup" aria-label={dt('Which board')}>
        {free.map((k, i) => (
          <label class="bd-kind"><input type="radio" name="board" value={k.id} checked={i === 0} data-kind-emoji={k.emoji} /><span><Icon name={k.icon} width="15" height="15" />{kindNames[k.id]} <em>{k.emoji}</em></span></label>
        ))}
      </div>
      {free[0] && <BoardFields kind={free[0]} board={blankBoard(free[0])} channels={channels} roles={roles} templates={templates} uid="new" />}
      <footer><button type="button" class="btn btn-ghost btn-sm" data-modal-close>{dt('Cancel')}</button><button type="submit" class="btn btn-accent btn-sm" data-keep>{dt('Create')}</button></footer>
    </form>
  </Modal>

  {boards.map((b) => {
    const kind = BOARD_KINDS.find((k) => k.id === b.kind)!;
    return (
      <Modal id={`bd-${b.kind}`} title={kindNames[b.kind]} icon={kind.icon}>
        <form method="POST" class="bd-form" data-no-dirty>
          <input type="hidden" name="action" value="save" /><input type="hidden" name="board" value={b.kind} />
          <BoardFields kind={kind} board={b} channels={channels} roles={roles} templates={templates} uid={b.kind} />
          <footer><button type="button" class="btn btn-ghost btn-sm" data-modal-close>{dt('Cancel')}</button><button type="submit" class="btn btn-accent btn-sm" data-keep>{dt('Save')}</button></footer>
        </form>
      </Modal>
    );
  })}
  <EmojiPicker customEmojis={customEmojis} />
</DashGuildLayout>

<script>
  // The Set up button of a card opens the New board window with that board already chosen.
  document.addEventListener('click', (event) => {
    const pick = (event.target as HTMLElement | null)?.closest<HTMLElement>('[data-board-pick]');
    if (!pick) return;
    const radio = document.querySelector<HTMLInputElement>(`#bd-new input[name="board"][value="${pick.dataset.boardPick}"]`);
    if (radio && !radio.checked) { radio.checked = true; radio.dispatchEvent(new Event('change', { bubbles: true })); }
  });
  // Choosing which board to add puts its own emoji in the first box (when nothing else was typed there).
  document.addEventListener('change', (event) => {
    const radio = event.target as HTMLInputElement | null;
    if (!radio || radio.name !== 'board' || !radio.dataset.kindEmoji) return;
    const form = radio.closest('form[data-board-add]');
    const first = form?.querySelector<HTMLInputElement>('input[name="emoji"]');
    if (first && (!first.value || first.dataset.auto === '1' || ['⭐', '🐒', '🤡'].includes(first.value))) { first.value = radio.dataset.kindEmoji; first.dataset.auto = '1'; first.dispatchEvent(new Event('input', { bubbles: true })); }
  });
</script>

<style>
  .bd-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  h1 { font-size: 24px; margin: 0 0 6px; }
  .bd-lead { margin: 0; font-size: 13.5px; line-height: 1.5; color: var(--text-muted); max-width: 70ch; }
  .bd-top .btn { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; flex: none; }
  .bd-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; align-items: start; margin-bottom: 14px; }
  @media (max-width: 1239px) { .bd-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .bd-grid > :last-child:nth-child(odd) { grid-column: 1 / -1; } }
  @media (max-width: 720px) { .bd-grid { grid-template-columns: minmax(0, 1fr); } }
  .bd-board { min-width: 0; gap: 12px; transition: border-color var(--m-fast) ease; }
  .bd-board:hover { border-color: color-mix(in srgb, var(--c) 45%, var(--border)); }
  .bd-board-off { background: transparent; border-style: dashed; }
  .bd-head { display: flex; align-items: flex-start; gap: 12px; }
  .bd-ico { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: color-mix(in srgb, var(--c) 18%, transparent); color: var(--c); flex: none; }
  .bd-main { flex: 1; min-width: 0; display: grid; gap: 2px; }
  .bd-main b { font-size: 15px; }
  .bd-main span { font-size: 12.5px; color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 4; line-clamp: 4; -webkit-box-orient: vertical; overflow-wrap: anywhere; }
  .bd-preview { display: grid; gap: 8px; border-radius: 12px; background: var(--bg-raise, rgba(255, 255, 255, .03)); border: 1px solid var(--border-soft, var(--border)); padding: 12px; }
  .bd-board-off .bd-preview { opacity: .6; }
  .bd-pv-line { margin: 0; display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--text-muted); }
  .bd-pv-line i { font-style: normal; color: var(--accent); }
  .bd-pv-embed { display: grid; gap: 8px; border-left: 4px solid var(--c); border-radius: 6px; background: var(--card); padding: 10px 12px; }
  .bd-pv-author { display: flex; align-items: center; gap: 8px; font-size: 13px; }
  .bd-pv-av { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-size: 11px; font-weight: 700; background: var(--accent-soft); color: var(--accent); }
  .bd-pv-text { margin: 0; font-size: 13.5px; color: var(--text); }
  .bd-pv-img { display: block; width: 100%; height: 104px; object-fit: cover; border-radius: 8px; }
  .bd-pv-btn { display: inline-flex; align-items: center; gap: 5px; width: fit-content; font-size: 11.5px; padding: 4px 10px; border-radius: 6px; background: var(--card-hover, rgba(255, 255, 255, .06)); color: var(--text-muted); }
  .bd-pv-design { margin: 0; display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-dim); overflow-wrap: anywhere; }
  .bd-flags { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 10px; }
  .bd-flags li { display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-dim); min-width: 0; }
  .bd-flags li :global(svg) { flex: none; }
  .bd-flags li.on { color: var(--text-muted); }
  .bd-flags li.on :global(svg) { color: var(--green); }
  .bd-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .bd-tag-on { color: var(--green); background: var(--green-soft); }
  .bd-foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .bd-foot .btn { display: inline-flex; align-items: center; gap: 6px; }
  .bd-emojis { display: inline-flex; align-items: center; flex-wrap: wrap; gap: 4px; font-size: 18px; min-width: 0; }
  .bd-emojis :global(img), .bd-pv-line :global(img) { display: block; }
  .bd-acts { display: flex; align-items: center; gap: 6px; flex: none; }
  .bd-acts form { margin: 0; }
  .bd-act { width: 34px; height: 34px; border-radius: 9px; border: 1px solid var(--border); background: none; color: var(--text-muted); display: grid; place-items: center; cursor: pointer; transition: transform var(--m-instant) ease, border-color var(--m-fast) ease, color var(--m-fast) ease; }
  .bd-act:hover { border-color: var(--text-dim); color: var(--text); }
  .bd-act:active { transform: scale(var(--m-press)); }
  .bd-del:hover { color: var(--red, #ff6b6b); border-color: var(--red, #ff6b6b); }
  .bd-help .sx-panel p { margin: 0; }
  .bd-form { display: grid; gap: 16px; }
  .bd-form footer { display: flex; justify-content: flex-end; gap: 8px; padding-top: 4px; }
  .bd-kinds { display: flex; flex-wrap: wrap; gap: 6px; }
  .bd-kind input { position: absolute; opacity: 0; pointer-events: none; }
  .bd-kind span { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--border); border-radius: 999px; padding: 8px 14px; font-size: 13px; cursor: pointer; transition: background var(--m-fast) ease, border-color var(--m-fast) ease, color var(--m-fast) ease; }
  .bd-kind em { font-style: normal; }
  .bd-kind input:checked + span { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }
  .bd-kind input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .bd-grid > * { animation: none; } }
  @media (max-width: 720px) { .bd-top { flex-wrap: wrap; } }
</style>
