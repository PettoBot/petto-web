---
import Base from '../layouts/Base.astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const b = t.blogEmbedBuilder;
---
<Base title={b.title} lang={lang}>
  <main>
    <article class="post">
      <div class="wrap">
        <div class="post-banner reveal">
          <img src="/assets/embed-builder-banner.webp" alt="Embed Builder: a yellow hard hat between two Discord embed cards" />
        </div>
        <div class="post-head reveal">
          <span class="pill">{b.pill}</span>
          <h1>{b.h1}</h1>
          <div class="post-byline">
            <img src="/assets/embed-builder-icon.webp" alt="" />
            <span>{t.newsPosts.writtenBy} <b>{t.newsPosts.embedBuilder.author}</b> · {b.date}</span>
          </div>
        </div>

        <div class="post-body reveal">
          <p class="lede">{b.lede}</p>

          <h2>{b.h2_1}</h2>
          <p>{b.p1}</p>

          <h2>{b.h2_2}</h2>
          <ul>
            {b.list.map(([bold, rest]) => <li><b>{bold}</b>{rest}</li>)}
          </ul>

          <h2>{b.h2_3}</h2>
          <p>{b.p3}</p>

          <h2>{b.h2_4}</h2>
          <p>{b.p4}</p>
        </div>
      </div>
    </article>
  </main>
</Base>

<style>
  .post { padding: 56px 0 100px; }
  .post-banner { border-radius: 16px; overflow: hidden; border: 1px solid var(--border-soft); margin-bottom: 28px; background: var(--card); }
  .post-banner img { width: 100%; height: auto; display: block; }
  .post-head { max-width: 68ch; margin: 0 auto 44px; }
  .pill { display: inline-block; font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); background: var(--bg-raise); border: 1px solid var(--border-soft); padding: 5px 12px; border-radius: 999px; margin-bottom: 18px; }
  .post-head h1 { font-size: 38px; line-height: 1.16; margin-bottom: 16px; }
  .post-byline { display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--text-dim); }
  .post-byline img { width: 26px; height: 26px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border); }
  .post-byline b { color: var(--text); font-weight: 600; }

  .post-body { max-width: 68ch; margin: 0 auto; }
  .post-body .lede { font-size: 18px; color: var(--text-muted); line-height: 1.6; margin-bottom: 36px; }
  .post-body h2 { font-size: 22px; margin: 40px 0 14px; }
  .post-body p { font-size: 16px; line-height: 1.75; color: var(--text-muted); margin: 0 0 16px; }
  .post-body p b { color: var(--text); font-weight: 600; }
  .post-body ul { margin: 0 0 16px; padding-left: 22px; display: flex; flex-direction: column; gap: 10px; }
  .post-body ul li { font-size: 16px; line-height: 1.65; color: var(--text-muted); }
  .post-body ul li b { color: var(--text); font-weight: 600; }

  @media (max-width: 700px) {
    .post-head h1 { font-size: 29px; }
  }
</style>
