---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MaintenanceGate from './MaintenanceGate.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';

import { getDashLang, makeT, dashLocale } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Backup { id: string | number; backup_number: string | number; label: string; source: string; created_at: string; }
interface Audit { id: string | number; actor_id: string; action: string; backup_number: string | number | null; created_at: string; }
interface Schedule { interval_hours: number; retention_count: number; next_run_at: string; }
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  backups: Backup[];
  audit: Audit[];
  schedule: Schedule | null;
  connected: boolean;
  message: string | null;
  error: string | null;
  maintenance?: boolean;
  teamNotice?: boolean;
  restoreJob?: { status: string } | null;
}
const { user, guildId, guildName, guildIcon, backups, audit, schedule, connected, message, error, maintenance = false, teamNotice = false, restoreJob = null } = Astro.props;
function date(value: string) { return new Date(value).toLocaleString(dashLocale(dashLang), { day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit' }); }
function ago(value: string) {
  const mins = Math.floor((Date.now() - new Date(value).getTime()) / 60000);
  if (mins < 1) return dt('just now');
  if (mins < 60) return dt('{n}m ago', { n: mins });
  const hours = Math.floor(mins / 60);
  if (hours < 24) return dt('{n}h ago', { n: hours });
  return dt('{n}d ago', { n: Math.floor(hours / 24) });
}
function inTime(value: string) {
  const mins = Math.ceil((new Date(value).getTime() - Date.now()) / 60000);
  if (!Number.isFinite(mins) || mins <= 1) return dt('any moment now');
  if (mins < 60) return dt('in {n}m', { n: mins });
  const hours = Math.round(mins / 60);
  return hours < 48 ? dt('in {n}h', { n: hours }) : dt('in {n}d', { n: Math.round(hours / 24) });
}
function sourceLabel(source: string) { return source === 'scheduled' ? dt('Automatic') : dt('Manual'); }
function actionLabel(action: string) {
  return ({ backup_created: dt('Backup created'), backup_exported: dt('Backup exported'), backup_restored: dt('Backup restored'), schedule_updated: dt('Schedule updated'), schedule_disabled: dt('Schedule disabled') } as Record<string, string>)[action] ?? action;
}

// Every text of the restore dialog, in the language of the dashboard (the dialog is drawn by its script).
const restoreText = {
  deleteTitle: dt('Delete a backup'), deleteOne: dt('Delete backup #{a}? This cannot be undone.'),
  deleteAllTitle: dt('Delete all backups'), deleteAll: dt('Delete all {a} backups of this server and turn off the automatic backups? This cannot be undone.'), delete: dt('Delete'),
  title: dt('Restore a backup'), close: dt('Close'), cancel: dt('Cancel'), back: dt('Back'), loading: dt('Loading...'),
  mergeTitle: dt('Merge (safe)'), mergeBody: dt('Creates what is missing and updates what exists. Deletes nothing.'),
  replaceTitle: dt('Replace'), replaceBody: dt('Makes the server match the backup: it also deletes the channels and roles that are not in it.'),
  review: dt('Review what will change'), continue: dt('Continue'),
  partsTitle: dt('What to bring back'), partsHint: dt('Untick what should stay as it is now. Replace only deletes in the parts you bring back.'), partsNone: dt('Pick at least one part.'),
  parts: { roles: dt('Roles'), channels: dt('Channels, categories and permissions'), settings: dt('Server settings'), emojis: dt('Emojis'), stickers: dt('Stickers'), automod: dt('AutoMod rules') },
  contents: dt('This backup holds {a} roles, {b} categories, {c} channels with {d} permission overwrites, {e} emojis, {f} stickers and {g} AutoMod rules.'),
  partsOnly: dt('Only: {a}'),
  roles: dt('Roles'), channels: dt('Channels'), emojis: dt('Emojis'), plan: dt('{a} to create · {b} to update'),
  deleting: dt('It will delete {a} channels and {b} roles that are not in this backup:'), deletingNothing: dt('Nothing will be deleted.'),
  safety: dt('A safety backup of the server as it is now is saved first, so you can go back.'),
  checkTitle: dt('Prove you are a person'), letters: dt('Type the letters of the picture.'), serverName: dt('Type the exact name of this server: {a}'),
  placeholder: dt('Your answer'), newPicture: dt('New picture'), start: dt('Start restore'),
  progress: dt('Restoring backup #{a}'), step: dt('Step {a} of {b}'), stop: dt('Stop restore'), stopping: dt('Stopping after the current step...'),
  hint: dt('You can stop it. What was already restored stays, and nothing else is deleted.'),
  phases: { stickers: dt('Restoring stickers...'), automod: dt('Restoring AutoMod rules...'), safety: dt('Saving a safety backup...'), roles: dt('Restoring roles...'), channels: dt('Restoring channels...'), settings: dt('Restoring server settings...'), emojis: dt('Restoring emojis...'), cleanup: dt('Deleting what is not in the backup...') },
  done: dt('Restore finished.'), stopped: dt('Restore stopped. What was already restored stays, and nothing more was deleted.'),
  failed: dt('The restore failed: {a}'), safetyKept: dt('Safety backup #{a} has the server as it was before.'),
  skipped: dt('Some roles or channels could not be created, so nothing was deleted.'),
  summary: dt('Created {a} · updated {b} · deleted {c}'), warnings: dt('Finished with warnings:'),
  errors: {
    generic: dt('Something went wrong. Try again.'), bot_unavailable: dt('Petto could not be reached. Try again in a moment.'),
    administrator_required: dt('Only server administrators can restore backups.'), restore_running: dt('A restore is already running in this server.'),
    captcha_expired: dt('That check expired. Get a new picture.'), captcha_wrong: dt('That is not right. Get a new picture and try again.'),
    captcha_locked: dt('Too many wrong answers. Try again in 10 minutes.'), backup_not_found: dt('That backup no longer exists.'), maintenance: dt('Backups are under maintenance'),
  },
};
const backupCount = backups.length;
const restoreRunning = restoreJob && ['running', 'cancelling'].includes(restoreJob.status);
const titleOf = (backup: Backup) => backup.label || (backup.source === 'scheduled' ? dt('Automatic backup') : dt('Manual backup'));
const autoCount = backups.filter((backup) => backup.source === 'scheduled').length;
const manualCount = backupCount - autoCount;
const lastAt = backups.reduce((latest, backup) => Math.max(latest, new Date(backup.created_at).getTime() || 0), 0);
const lastText = lastAt ? ago(new Date(lastAt).toISOString()) : '–';
// The choices of the schedule form (the values the bot accepts); one that is not in the list falls back to the usual one.
const everyOptions: [number, string][] = [[6, dt('6 hours')], [12, dt('12 hours')], [24, dt('24 hours')], [48, dt('48 hours')], [168, dt('7 days')]];
const keepOptions: [number, string][] = [[3, dt('3 copies')], [7, dt('7 copies')], [14, dt('14 copies')], [30, dt('30 copies')]];
const everyNow = everyOptions.some(([n]) => n === schedule?.interval_hours) ? (schedule?.interval_hours as number) : 24;
const keepNow = keepOptions.some(([n]) => n === schedule?.retention_count) ? (schedule?.retention_count as number) : 7;
const keptShare = schedule && schedule.retention_count > 0 ? Math.min(100, Math.round((autoCount / schedule.retention_count) * 100)) : 0;
const AUDIT_ICON: Record<string, string> = { backup_created: 'ph:plus-circle-fill', backup_exported: 'ph:download-simple-bold', backup_restored: 'ph:arrow-counter-clockwise-bold', schedule_updated: 'ph:clock-fill', schedule_disabled: 'ph:prohibit-fill' };
const AUDIT_COLOR: Record<string, string> = { backup_created: '#86b894', backup_exported: '#9bd0f5', backup_restored: '#f5c26b', schedule_updated: '#c6a8f5', schedule_disabled: '#c98791' };
---

<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="backups" pageTitle="Backups">
  <DashSettingsKit />
  <DashFormKit />
  <div class="vb-page">
  <MaintenanceGate active={maintenance} title={dt('Backups are under maintenance')} description={dt('Backups are paused for now and cannot be used, here or with the commands. Your saved backups and schedules are kept as they are, and they will come back later.')}>
  {teamNotice && <div class="vb-team-note"><Icon name="ph:wrench-fill" width="14" height="14" />{dt('Backups are under maintenance for everyone else. You can use them because you are part of the Petto team.')}</div>}
  <div class="vb-heading">
    <div>
      <div class="vb-eyebrow"><Icon name="ph:archive-fill" width="14" height="14" />{dt('Petto Vault')}</div>
      <h1>{dt('Backups')}</h1>
    </div>
    <span class:list={['vb-status', { online: connected }]}><i></i>{connected ? dt('Vault connected') : dt('Vault unavailable')}</span>
  </div>

  {message && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{message}</div>}
  {error && <div class="sx-flash sx-flash-bad"><Icon name="ph:warning-fill" width="15" height="15" />{error}</div>}

  {!connected ? (
    <section class="vb-empty">
      <Icon name="ph:cloud-slash-fill" width="26" height="26" />
      <div><strong>{dt('Vault is not connected to the dashboard yet.')}</strong><p>{dt('The bot needs its private Vault database and the shared dashboard secret configured before this page can manage backups.')}</p></div>
    </section>
  ) : (
    <>
      <DashStatTiles tiles={[
        { label: dt('Saved backups'), value: backupCount, tone: 'invites' },
        { label: dt('Manual'), value: manualCount, tone: 'messages' },
        { label: dt('Automatic'), value: autoCount, tone: 'voice' },
        { label: dt('Last backup'), value: 0, text: lastText, tone: 'joins' },
      ]} />

      <div class="vb-layout">
        <div class="vb-col vb-col-main">
          <section class="sx-panel vb-saved" data-vb-saved>
            <div class="sx-panel-head">
              <span class="sx-panel-icon" style="--c:#c6a8f5"><Icon name="ph:stack-fill" width="17" height="17" /></span>
              <h2>{dt('Saved backups')}</h2>
              <span class="sx-tag" data-vb-count>{backupCount}</span>
            </div>
            {schedule && (
              <div class="vb-keep">
                <span>{dt('{a} of {b} automatic copies kept', { a: autoCount, b: schedule.retention_count })}</span>
                <span class="vb-keep-bar"><i style={`width:${keptShare}%`}></i></span>
              </div>
            )}
            {backups.length > 0 && (
              <div class="dfx-chips vb-chips" role="radiogroup" aria-label={dt('Filter')}>
                <label class="dfx-chip vb-chip"><input type="radio" name="vb-source" value="" checked />{dt('All')}<b>{backupCount}</b></label>
                <label class="dfx-chip vb-chip"><input type="radio" name="vb-source" value="manual" disabled={manualCount === 0} />{dt('Manual')}<b>{manualCount}</b></label>
                <label class="dfx-chip vb-chip"><input type="radio" name="vb-source" value="scheduled" disabled={autoCount === 0} />{dt('Automatic')}<b>{autoCount}</b></label>
              </div>
            )}
            {backups.length ? (
              <div class="vb-list dgl-stagger">
                {backups.map((backup) => (
                  <div class:list={['vb-row', { auto: backup.source === 'scheduled' }]} data-vb-source={backup.source === 'scheduled' ? 'scheduled' : 'manual'}>
                    <span class="vb-row-icon"><Icon name={backup.source === 'scheduled' ? 'ph:clock-fill' : 'ph:archive-fill'} width="16" height="16" /></span>
                    <div class="vb-row-main">
                      <div class="vb-row-title"><strong>{titleOf(backup)}</strong><em>{ago(backup.created_at)}</em></div>
                      <span>#{backup.backup_number} · {sourceLabel(backup.source)} · {date(backup.created_at)}</span>
                    </div>
                    <div class="vb-row-actions">
                      <button class="btn btn-ghost btn-sm" type="button" data-vb-restore={String(backup.backup_number)} data-vb-label={titleOf(backup)}><Icon name="ph:arrow-counter-clockwise-bold" width="14" height="14" />{dt('Restore')}</button>
                      <a class="btn btn-ghost btn-sm vb-icon-btn" href={`/dash/guild/${guildId}/backups-export?id=${encodeURIComponent(String(backup.backup_number))}`} aria-label={dt('Export')} title={dt('Export')}><Icon name="ph:download-simple-bold" width="14" height="14" /></a>
                      <button class="btn btn-ghost btn-sm vb-del vb-icon-btn" type="button" data-vb-delete={String(backup.backup_number)} aria-label={dt('Delete')} title={dt('Delete')}><Icon name="ph:trash-fill" width="14" height="14" /></button>
                    </div>
                  </div>
                ))}
              </div>
            ) : <div class="vb-empty-inline"><Icon name="ph:archive-fill" width="24" height="24" /><p>{dt('No backups yet. Create the first one.')}</p></div>}
            <p class="sx-empty vb-none" hidden><Icon name="ph:magnifying-glass-bold" width="16" height="16" />{dt('No backup matches that.')}</p>
          </section>

          <section class="sx-panel vb-activity">
            <div class="sx-panel-head">
              <span class="sx-panel-icon" style="--c:#f0a88f"><Icon name="ph:list-dashes-fill" width="17" height="17" /></span>
              <h2>{dt('Activity history')}</h2>
              {audit.length > 0 && <span class="sx-tag">{audit.length}</span>}
            </div>
            {audit.length ? (
              <div class="vb-audit-list dgl-stagger">
                {audit.map((entry) => (
                  <div class="vb-audit-row">
                    <span class="vb-audit-icon" style={`--c:${AUDIT_COLOR[entry.action] ?? '#94a3b8'}`}><Icon name={AUDIT_ICON[entry.action] ?? 'ph:clock-fill'} width="14" height="14" /></span>
                    <div>
                      <strong>{actionLabel(entry.action)}{entry.backup_number ? <span class="vb-audit-num"> #{entry.backup_number}</span> : null}</strong>
                      <span>{dt('User {a}', { a: entry.actor_id })} · {date(entry.created_at)}</span>
                    </div>
                    <em>{ago(entry.created_at)}</em>
                  </div>
                ))}
              </div>
            ) : <div class="vb-empty-inline"><Icon name="ph:list-dashes-fill" width="24" height="24" /><p>{dt('No Vault activity recorded yet.')}</p></div>}
          </section>
        </div>

        <div class="vb-col vb-col-side">
          <section class="sx-panel vb-create">
            <div class="sx-panel-head">
              <span class="sx-panel-icon" style="--c:#86b894"><Icon name="ph:plus-circle-fill" width="17" height="17" /></span>
              <h2>{dt('Create a backup')}</h2>
            </div>
            <p class="sx-lead">{dt('Save the current roles, channels, permissions, emojis, and server settings.')}</p>
            <form method="POST" enctype="multipart/form-data" class="vb-form" data-no-dirty>
              <input type="hidden" name="action" value="create" />
              <div class="dfx-field"><label for="vb-label">{dt('Backup name')}</label><textarea id="vb-label" name="label" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count maxlength="80" placeholder={dt('Before changing roles')}></textarea></div>
              <div class="sx-foot"><button class="btn btn-accent btn-sm" type="submit"><Icon name="ph:archive-fill" width="14" height="14" />{dt('Create backup')}</button></div>
            </form>
          </section>

          <section class="sx-panel vb-schedule">
            <div class="sx-panel-head">
              <span class="sx-panel-icon" style="--c:#9bd0f5"><Icon name="ph:clock-fill" width="17" height="17" /></span>
              <h2>{dt('Automatic backups')}</h2>
              <span class:list={['sx-pill-state', { on: Boolean(schedule) }]}>{schedule ? dt('On') : dt('Off')}</span>
            </div>
            <p class="sx-lead">{schedule ? dt('Every {a} hours · keeps {b}', { a: schedule.interval_hours, b: schedule.retention_count }) : dt('No schedule is active for this server.')}{schedule?.next_run_at ? ` · ${dt('Next one {a}', { a: inTime(schedule.next_run_at) })}` : ''}</p>
            <form method="POST" enctype="multipart/form-data" class="vb-form vb-schedule-form">
              <input type="hidden" name="action" value="schedule" />
              <div class="dfx-field"><span class="dfx-label">{dt('Every')}</span>
                <div class="dfx-chips vb-chips">
                  {everyOptions.map(([n, label]) => <label class="dfx-chip vb-chip"><input type="radio" name="hours" value={n} checked={n === everyNow} />{label}</label>)}
                </div>
              </div>
              <div class="dfx-field"><span class="dfx-label">{dt('Keep')}</span>
                <div class="dfx-chips vb-chips">
                  {keepOptions.map(([n, label]) => <label class="dfx-chip vb-chip"><input type="radio" name="retention" value={n} checked={n === keepNow} />{label}</label>)}
                </div>
              </div>
              <div class="sx-foot"><button class="btn btn-accent btn-sm" type="submit">{dt('Save schedule')}</button></div>
            </form>
            {schedule && <form method="POST" enctype="multipart/form-data" class="vb-unschedule" data-no-dirty><input type="hidden" name="action" value="unschedule" /><button type="submit">{dt('Disable schedule')}</button></form>}
          </section>

          <section class="sx-panel vb-data">
            <div class="sx-panel-head">
              <span class="sx-panel-icon" style="--c:#c98791"><Icon name="ph:lock-key-fill" width="17" height="17" /></span>
              <h2>{dt('Your data')}</h2>
            </div>
            <p class="sx-lead">{dt('A backup keeps names, permissions and settings: no messages and no member list. Backups of a server Petto has left are deleted after 30 days.')}</p>
            <div class="vb-data-actions">
              {schedule && <form method="POST" enctype="multipart/form-data" class="vb-inline-form" data-no-dirty><input type="hidden" name="action" value="unschedule" /><button class="btn btn-ghost btn-sm" type="submit"><Icon name="ph:clock-fill" width="14" height="14" />{dt('Disable automatic backups')}</button></form>}
              {backupCount > 0 && <button class="btn btn-ghost btn-sm vb-del" type="button" data-vb-delete-all={String(backupCount)}><Icon name="ph:trash-fill" width="14" height="14" />{dt('Delete all backups')}</button>}
              {!schedule && backupCount === 0 && <span class="vb-data-ok"><Icon name="ph:check-circle-fill" width="14" height="14" />{dt('Nothing is being kept for this server.')}</span>}
            </div>
          </section>
        </div>
      </div>

      <form method="POST" enctype="multipart/form-data" id="vb-delete-form" hidden data-no-dirty><input type="hidden" name="action" value="delete" /><input type="hidden" name="backup_id" value="" /></form>
      <dialog class="vb-dialog" id="vb-restore" data-guild={guildId} data-running={restoreRunning ? '1' : ''} data-text={JSON.stringify(restoreText)}>
        <div class="vb-dlg-head"><h2 data-r="title"></h2><button type="button" class="vb-dlg-x" data-r="x" aria-label={dt('Close')}><Icon name="ph:x-bold" width="14" height="14" /></button></div>
        <div class="vb-dlg-body" data-r="body"></div>
        <div class="vb-dlg-foot" data-r="foot"></div>
      </dialog>
      <script is:inline>
        (function () {
          var dlg = document.getElementById('vb-restore');
          if (!dlg) return;
          var T = JSON.parse(dlg.dataset.text);
          var base = '/dash/guild/' + dlg.dataset.guild + '/backups-restore';
          var ALL_PARTS = ['roles', 'channels', 'settings', 'emojis', 'stickers', 'automod'];
          var S = { number: 0, label: '', mode: 'merge', parts: ALL_PARTS.slice(), challenge: null, timer: 0, view: '', refs: null };
          var body = dlg.querySelector('[data-r=body]'), foot = dlg.querySelector('[data-r=foot]');
          dlg.querySelector('[data-r=title]').textContent = T.title;
          function el(tag, cls, text) { var n = document.createElement(tag); if (cls) n.className = cls; if (text != null) n.textContent = text; return n; }
          function fill(text, map) { return String(text).replace(/\{(\w+)\}/g, function (_, k) { return map[k] != null ? map[k] : ''; }); }
          function api(step, opts) {
            opts = opts || {};
            var post = Boolean(opts.post);
            return fetch(base + '?step=' + step + (opts.query ? '&' + opts.query : ''), {
              method: post ? 'POST' : 'GET', cache: 'no-store',
              headers: { Accept: 'application/json', 'Content-Type': 'application/json', 'X-Petto-Dash': '1' },
              body: post ? JSON.stringify(opts.body || {}) : undefined,
            }).then(function (r) { return r.json().catch(function () { return { ok: false, error: 'generic' }; }); }).catch(function () { return { ok: false, error: 'bot_unavailable' }; });
          }
          function say(code) { return T.errors[code] || T.errors.generic; }
          function button(label, cls, onClick, disabled) { var b = el('button', 'btn btn-sm ' + cls, label); b.type = 'button'; if (disabled) b.disabled = true; b.addEventListener('click', onClick); return b; }
          function setFoot() { foot.replaceChildren.apply(foot, arguments); }
          function note(text, kind) { return el('div', 'vb-note ' + (kind || ''), text); }
          function stopPoll() { if (S.timer) { clearInterval(S.timer); S.timer = 0; } }
          function close() { stopPoll(); if (dlg.open) dlg.close(); if (S.view === 'end') location.reload(); }
          dlg.querySelector('[data-r=x]').addEventListener('click', close);
          // A press on the dimmed area around the box (it started there too) closes it, like the X.
          var downOutside = false;
          var outside = function (e) { var r = dlg.getBoundingClientRect(); return e.target === dlg && (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom); };
          dlg.addEventListener('pointerdown', function (e) { downOutside = outside(e); });
          dlg.addEventListener('click', function (e) { if (downOutside && outside(e)) close(); downOutside = false; });
          dlg.addEventListener('cancel', function () { stopPoll(); if (S.view === 'end') setTimeout(function () { location.reload(); }, 0); });

          function showMode() {
            S.view = 'mode'; stopPoll();
            var wrap = el('div', 'vb-modes');
            [['merge', T.mergeTitle, T.mergeBody], ['replace', T.replaceTitle, T.replaceBody]].forEach(function (m) {
              var label = el('label', 'vb-mode' + (m[0] === 'replace' ? ' danger' : '') + (S.mode === m[0] ? ' on' : ''));
              var input = el('input'); input.type = 'radio'; input.name = 'vb-mode'; input.value = m[0]; input.checked = S.mode === m[0];
              input.addEventListener('change', function () { S.mode = m[0]; wrap.querySelectorAll('.vb-mode').forEach(function (n) { n.classList.toggle('on', n === label); }); });
              var text = el('span'); text.append(el('strong', null, m[1]), el('small', null, m[2]));
              label.append(input, text); wrap.append(label);
            });
            // Selective restore: only some parts of the backup (the bot leaves the rest, and Replace only deletes in the parts chosen).
            var parts = el('fieldset', 'vb-parts');
            parts.append(el('legend', null, T.partsTitle));
            var review = button(T.review, 'btn-accent', showPreview, !S.parts.length);
            ALL_PARTS.forEach(function (part) {
              var label = el('label', 'vb-part');
              var box = el('input'); box.type = 'checkbox'; box.value = part; box.checked = S.parts.indexOf(part) !== -1;
              box.addEventListener('change', function () {
                S.parts = ALL_PARTS.filter(function (p) { var b = parts.querySelector('input[value="' + p + '"]'); return b && b.checked; });
                review.disabled = !S.parts.length; hint.textContent = S.parts.length ? T.partsHint : T.partsNone;
              });
              label.append(box, el('span', null, T.parts[part]));
              parts.append(label);
            });
            var hint = el('small', 'vb-parts-hint', S.parts.length ? T.partsHint : T.partsNone);
            parts.append(hint);
            body.replaceChildren(el('p', 'vb-dlg-sub', '#' + S.number + ' · ' + S.label), wrap, parts);
            setFoot(button(T.cancel, 'btn-ghost', close), review);
          }
          function row(name, plan) { var r = el('div', 'vb-plan-row'); r.append(el('strong', null, name), el('span', null, fill(T.plan, { a: plan[0], b: plan[1] }))); return r; }
          function showPreview() {
            S.view = 'preview';
            body.replaceChildren(note(T.loading)); setFoot(button(T.back, 'btn-ghost', showMode));
            api('preview', { query: 'backup_id=' + S.number + '&mode=' + S.mode + '&parts=' + encodeURIComponent(S.parts.join(',')) }).then(function (r) {
