---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Backup { id: string | number; backup_number: string | number; label: string; source: string; created_at: string; }
interface Audit { id: string | number; actor_id: string; action: string; backup_number: string | number | null; created_at: string; }
interface Schedule { interval_hours: number; retention_count: number; next_run_at: string; }
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  backups: Backup[];
  audit: Audit[];
  schedule: Schedule | null;
  connected: boolean;
  message: string | null;
  error: string | null;
  maintenance?: boolean;
}
const { user, guildId, guildName, guildIcon, backups, audit, schedule, connected, message, error, maintenance = false } = Astro.props;
function date(value: string) { return new Date(value).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' }); }
function sourceLabel(source: string) { return source === 'scheduled' ? dt('Automatic') : dt('Manual'); }
function actionLabel(action: string) {
  return ({ backup_created: dt('Backup created'), backup_exported: dt('Backup exported'), backup_restored: dt('Backup restored'), schedule_updated: dt('Schedule updated'), schedule_disabled: dt('Schedule disabled') } as Record<string, string>)[action] ?? action;
}
---

<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="backups" pageTitle="Backups">
  {maintenance ? (
    <div class="vb-maint">
      <span class="vb-maint-icon"><Icon name="ph:wrench-fill" width="22" height="22" /></span>
      <h2>{dt('Backups are under maintenance')}</h2>
      <p>{dt('Backups are paused for now and cannot be used, here or with the commands. Your saved backups and schedules are kept as they are, and they will come back later.')}</p>
    </div>
  ) : (<Fragment>
  <div class="vb-heading">
    <div>
      <div class="vb-eyebrow"><Icon name="ph:archive-fill" width="13" height="13" />{dt('Petto Vault')}</div>
      <h1>{dt('Backups for {a}', { a: (guildName) })}</h1>
      <p>{dt('Keep your server configuration safe, export a snapshot whenever you need it, and let Petto create copies on a schedule. Backup numbers are scoped to this server.')}</p>
    </div>
    <span class:list={['vb-status', { online: connected }]}><i></i>{connected ? dt('Vault connected') : dt('Vault unavailable')}</span>
  </div>

  {message && <div class="vb-notice success"><Icon name="ph:check-circle-fill" width="15" height="15" />{message}</div>}
  {error && <div class="vb-notice error"><Icon name="ph:warning-fill" width="15" height="15" />{error}</div>}

  {!connected ? (
    <section class="vb-empty">
      <Icon name="ph:cloud-slash-fill" width="22" height="22" />
      <div><strong>{dt('Vault is not connected to the dashboard yet.')}</strong><p>{dt('The bot needs its private Vault database and the shared dashboard secret configured before this page can manage backups.')}</p></div>
    </section>
  ) : (
    <>
      <div class="vb-grid vb-grid-top">
        <section class="vb-card vb-card-accent">
          <div class="vb-card-title"><span class="vb-icon green"><Icon name="ph:plus-circle-fill" width="15" height="15" /></span><div><h2>{dt('Create a backup')}</h2><p>{dt('Save the current roles, channels, permissions, emojis, and server settings.')}</p></div></div>
          <form method="POST" class="vb-form">
            <input type="hidden" name="action" value="create" />
            <label>{dt('Backup name')} <input type="text" name="label" maxlength="80" placeholder={dt('Before changing roles')} /></label>
            <button class="btn btn-accent btn-sm" type="submit"><Icon name="ph:archive-fill" width="14" height="14" />{dt('Create backup')}</button>
          </form>
        </section>

        <section class="vb-card">
          <div class="vb-card-title"><span class="vb-icon accent"><Icon name="ph:clock-fill" width="15" height="15" /></span><div><h2>{dt('Automatic backups')}</h2><p>{schedule ? `Every ${schedule.interval_hours} hours · keeps ${schedule.retention_count}` : 'No schedule is active for this server.'}</p></div></div>
          <form method="POST" class="vb-form vb-schedule-form">
            <input type="hidden" name="action" value="schedule" />
            <label>{dt('Every')} <select name="hours"><option value="6">{dt('6 hours')}</option><option value="12">{dt('12 hours')}</option><option value="24" selected={schedule?.interval_hours === 24 || !schedule}>{dt('24 hours')}</option><option value="48">{dt('48 hours')}</option><option value="168">{dt('7 days')}</option></select></label>
            <label>{dt('Keep')} <select name="retention"><option value="3">{dt('3 copies')}</option><option value="7" selected={schedule?.retention_count === 7 || !schedule}>{dt('7 copies')}</option><option value="14">{dt('14 copies')}</option><option value="30">{dt('30 copies')}</option></select></label>
            <button class="btn btn-ghost btn-sm" type="submit">{dt('Save schedule')}</button>
          </form>
          {schedule && <form method="POST" class="vb-unschedule"><input type="hidden" name="action" value="unschedule" /><button type="submit">{dt('Disable schedule')}</button></form>}
        </section>
      </div>

      <section class="vb-card vb-section-card">
        <div class="vb-section-head"><div><h2><Icon name="ph:stack-fill" width="16" height="16" />{dt('Saved backups')}</h2><p>{dt('Recent snapshots for this server. Manual backups are kept until you remove them.')}</p></div><span class="vb-count">{backups.length} recent</span></div>
        {backups.length ? <div class="vb-list">{backups.map((backup) => <div class="vb-row"><span class="vb-row-icon"><Icon name={backup.source === 'scheduled' ? 'ph:clock-fill' : 'ph:archive-fill'} width="15" height="15" /></span><div class="vb-row-main"><strong>{backup.label || 'Manual backup'}</strong><span>#{backup.backup_number} · {sourceLabel(backup.source)} · {date(backup.created_at)}</span></div><a class="btn btn-ghost btn-sm" href={`/dash/guild/${guildId}/backups-export?id=${encodeURIComponent(String(backup.backup_number))}`}><Icon name="ph:download-simple-bold" width="14" height="14" />{dt('Export')}</a><form method="POST" class="vb-inline-form"><input type="hidden" name="action" value="restore" /><input type="hidden" name="backup_id" value={String(backup.backup_number)} /><input type="hidden" name="mode" value="merge" /><input type="hidden" name="confirm" value="true" /><button class="btn btn-ghost btn-sm" type="submit"><Icon name="ph:archive-fill" width="14" height="14" />{dt('Restore')}</button></form><form method="POST" class="vb-inline-form" onsubmit="return confirm('Replace mode deletes channels and roles that are not in this backup. Continue?')"><input type="hidden" name="action" value="restore" /><input type="hidden" name="backup_id" value={String(backup.backup_number)} /><input type="hidden" name="mode" value="replace" /><input type="hidden" name="confirm" value="true" /><button class="btn btn-danger btn-sm" type="submit">{dt('Replace')}</button></form></div>)}</div> : <p class="vb-empty-inline">{dt('No backups yet. Create your first snapshot above.')}</p>}
      </section>

      <section class="vb-card vb-section-card">
        <div class="vb-section-head"><div><h2><Icon name="ph:list-dashes-fill" width="16" height="16" />{dt('Activity history')}</h2><p>{dt('See who created, exported, or changed a Vault schedule.')}</p></div></div>
        {audit.length ? <div class="vb-audit-list">{audit.map((entry) => <div class="vb-audit-row"><span class="vb-audit-dot"></span><div><strong>{actionLabel(entry.action)}</strong><span>{dt('User {a} {b}· {c}', { a: (entry.actor_id), b: (entry.backup_number ? `· backup #${entry.backup_number} ` : ''), c: (date(entry.created_at)) })}</span></div></div>)}</div> : <p class="vb-empty-inline">{dt('No Vault activity recorded yet.')}</p>}
      </section>
    </>
  )}
  </Fragment>)}
</DashGuildLayout>

<style>
  .vb-maint { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; padding: 56px 20px; max-width: 520px; margin: 0 auto; }
  .vb-maint-icon { display: inline-flex; align-items: center; justify-content: center; width: 54px; height: 54px; border-radius: 16px; color: var(--yellow); background: color-mix(in srgb, var(--yellow) 14%, transparent); animation: vb-maint-sway 3.2s ease-in-out infinite; }
  .vb-maint h2 { margin: 6px 0 0; font-size: 24px; }
  .vb-maint p { margin: 0; font-size: 14px; color: var(--text-muted); line-height: 1.6; }
  @keyframes vb-maint-sway { 0%, 100% { transform: rotate(-8deg); } 50% { transform: rotate(8deg); } }
  @media (prefers-reduced-motion: reduce) { .vb-maint-icon { animation: none; } }

  h1 { font-size: 24px; margin: 0 0 6px; }
  h2 { font-size: 15px; margin: 0 0 4px; display: flex; align-items: center; gap: 8px; }
  p { color: var(--text-dim); font-size: 12.5px; line-height: 1.55; margin: 0; }
  .vb-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin-bottom: 24px; }
  .vb-heading > div { min-width: 0; }
  .vb-heading p { max-width: 68ch; }
  .vb-eyebrow { display: flex; align-items: center; gap: 6px; color: var(--accent); font: 600 10px var(--mono); letter-spacing: .08em; text-transform: uppercase; margin-bottom: 8px; }
  .vb-status { display: inline-flex; align-items: center; gap: 7px; flex-shrink: 0; border: 1px solid var(--border); border-radius: 999px; padding: 7px 10px; color: var(--text-dim); font: 600 10px var(--mono); text-transform: uppercase; letter-spacing: .04em; }
  .vb-status i { width: 7px; height: 7px; border-radius: 50%; background: var(--text-dim); }
  .vb-status.online { color: var(--green); border-color: var(--green); background: var(--green-soft); }
  .vb-status.online i { background: var(--green); }
  .vb-notice, .vb-empty { display: flex; align-items: flex-start; gap: 9px; border: 1px solid; border-radius: 10px; padding: 11px 14px; margin-bottom: 18px; font-size: 13px; }
  .vb-notice.success { color: var(--green); border-color: var(--green); background: var(--green-soft); }
  .vb-notice.error { color: var(--red); border-color: var(--red); background: var(--red-soft); }
  .vb-empty { color: var(--text-muted); border-color: var(--border); background: var(--card); padding: 20px; }
  .vb-empty strong { color: var(--text); display: block; margin-bottom: 4px; }
  .vb-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .vb-card { border: 1px solid var(--border); border-radius: 14px; padding: 18px; background: var(--card); }
  .vb-card-accent { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
  .vb-grid-top { margin-bottom: 14px; }
  .vb-card-title { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 18px; }
  .vb-card-title p { max-width: 40ch; }
  .vb-icon { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; flex-shrink: 0; }
  .vb-icon.green { color: var(--green); background: var(--green-soft); }
  .vb-icon.accent { color: var(--accent); background: var(--accent-soft); }
  .vb-form { display: flex; align-items: flex-end; gap: 9px; flex-wrap: wrap; }
  .vb-form label { display: flex; flex-direction: column; gap: 6px; color: var(--text-muted); font-size: 11.5px; }
  .vb-form input, .vb-form select { min-width: 0; border: 1px solid var(--border); border-radius: 8px; padding: 9px 10px; background: var(--bg-raise); color: var(--text); font: 13px var(--sans); }
  .vb-form input { width: min(250px, 100%); }
  .vb-form input:focus, .vb-form select:focus { outline: 2px solid var(--accent-soft); border-color: var(--accent); }
  .btn-sm { display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; font-size: 12px; }
  .vb-unschedule { margin-top: 12px; }
  .vb-unschedule button { border: 0; padding: 0; color: var(--red); background: transparent; font-size: 11px; cursor: pointer; }
  .vb-section-card + .vb-section-card { margin-top: 14px; }
  .vb-section-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .vb-section-head h2 { color: var(--text); }
  .vb-section-head h2 :global(svg) { color: var(--accent); }
  .vb-count { color: var(--text-dim); font: 10px var(--mono); text-transform: uppercase; }
  .vb-list { display: flex; flex-direction: column; gap: 7px; }
  .vb-row { display: flex; align-items: center; gap: 10px; min-width: 0; border: 1px solid var(--border-soft); border-radius: 10px; padding: 10px 12px; background: var(--bg-raise); }
  .vb-row-icon { display: grid; place-items: center; width: 27px; height: 27px; border-radius: 7px; color: var(--accent); background: var(--accent-soft); flex-shrink: 0; }
  .vb-row-main { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1; }
  .vb-row-main strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text); font-size: 13px; }
  .vb-row-main span, .vb-audit-row span { color: var(--text-dim); font-size: 11px; }
  .vb-inline-form { display: inline-flex; margin: 0; }
  .btn-danger { color: var(--red); border-color: color-mix(in srgb, var(--red) 45%, var(--border)); }
  .vb-empty-inline { border: 1px dashed var(--border); border-radius: 9px; padding: 14px; }
  .vb-audit-list { display: flex; flex-direction: column; gap: 10px; }
  .vb-audit-row { display: flex; align-items: flex-start; gap: 10px; }
  .vb-audit-dot { width: 7px; height: 7px; border-radius: 50%; margin: 5px 2px 0; background: var(--accent); flex-shrink: 0; }
  .vb-audit-row div { display: flex; flex-direction: column; gap: 3px; }
  .vb-audit-row strong { color: var(--text); font-size: 12.5px; }
  @media (max-width: 680px) { .vb-heading { flex-direction: column; } .vb-grid { grid-template-columns: 1fr; } }
  @media (max-width: 430px) { .vb-row { align-items: flex-start; flex-wrap: wrap; } .vb-row .btn { margin-left: 37px; } .vb-form > * { width: 100%; } .vb-form input, .vb-form select { width: 100%; } }
</style>
