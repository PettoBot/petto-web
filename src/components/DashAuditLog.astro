---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';

interface Entry { id: number; actorId: string; actorName: string; action: string; summary: string; createdAt: string; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  entries: Entry[];
}
const { user, guildId, guildName, guildIcon, entries } = Astro.props;

const ACTION_ICON: Record<string, string> = {
  create_group: 'ph:plus-circle-fill',
  delete_group: 'ph:trash-fill',
  update_group_level: 'ph:gauge-fill',
  set_command_level: 'ph:gauge-fill',
  add_member: 'ph:user-plus-fill',
  remove_member: 'ph:user-minus-fill',
};
const ACTION_COLOR: Record<string, string> = {
  create_group: '#a5ea7a',
  delete_group: '#fe6465',
  update_group_level: '#fed53c',
  set_command_level: '#8399ff',
  add_member: '#a5ea7a',
  remove_member: '#fe6465',
};

function timeAgo(iso: string): string {
  const diffMs = Date.now() - new Date(iso).getTime();
  const mins = Math.floor(diffMs / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins}m ago`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  if (days < 30) return `${days}d ago`;
  return new Date(iso).toLocaleDateString();
}
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="audit" pageTitle="Audit Log">
  <h1>Audit Log</h1>
  <p class="al-sub">Every change made in <a href={`/dash/guild/${guildId}/permissions`}>Permissions</a> for <b>{guildName}</b>, who did it, and when. Nothing here is enforced, it's a paper trail so multiple staff editing levels don't step on each other silently.</p>

  {entries.length === 0 ? (
    <p class="al-empty">Nothing logged yet, changes made on the Permissions page will show up here.</p>
  ) : (
    <div class="al-timeline">
      {entries.map((e, i) => (
        <div class="al-row" style={`animation-delay:${Math.min(i, 20) * 0.025}s`}>
          <div class="al-icon" style={`--c:${ACTION_COLOR[e.action] ?? '#94a3b8'}`}>
            <Icon name={ACTION_ICON[e.action] ?? 'ph:pencil-fill'} width="14" height="14" />
          </div>
          <div class="al-body">
            <p class="al-summary"><b>{e.actorName}</b> {e.summary}</p>
            <span class="al-time" title={new Date(e.createdAt).toLocaleString()}>{timeAgo(e.createdAt)}</span>
          </div>
        </div>
      ))}
    </div>
  )}
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  .al-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 24px; max-width: 74ch; }
  .al-sub b { color: var(--text); }
  .al-sub a { color: var(--accent); text-decoration: none; }
  .al-sub a:hover { text-decoration: underline; }

  .al-empty { font-size: 13px; color: var(--text-dim); }

  .al-timeline { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 14px; background: var(--card); overflow: hidden; max-width: 620px; }
  .al-row { display: flex; align-items: flex-start; gap: 12px; padding: 12px 16px; animation: al-row-in 0.25s cubic-bezier(0.16,1,0.3,1) backwards; }
  @keyframes al-row-in { from { opacity: 0; transform: translateX(-6px); } to { opacity: 1; transform: none; } }
  .al-row + .al-row { border-top: 1px solid var(--border-soft); }
  .al-icon { width: 28px; height: 28px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: color-mix(in srgb, var(--c) 16%, transparent); color: var(--c); transition: transform 0.15s; }
  .al-row:hover .al-icon { transform: scale(1.12); }
  .al-body { flex: 1; min-width: 0; }
  .al-summary { font-size: 13px; color: var(--text-muted); margin: 0 0 2px; line-height: 1.5; }
  .al-summary b { color: var(--text); }
  .al-time { font-size: 11px; color: var(--text-dim); font-family: var(--mono); }
</style>
