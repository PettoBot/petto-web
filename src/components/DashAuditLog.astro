---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Entry { id: string; actorId: string | null; actorName: string; actionKey: string; action: string; target: string; reason: string | null; createdAt: string; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  entries: Entry[];
  error?: string | null;
}
const { user, guildId, guildName, guildIcon, entries, error } = Astro.props;

const ACTION_ICON: Record<string, string> = {
  create_group: 'ph:plus-circle-fill',
  delete_group: 'ph:trash-fill',
  update_group_level: 'ph:gauge-fill',
  set_command_level: 'ph:gauge-fill',
  add_member: 'ph:user-plus-fill',
  remove_member: 'ph:user-minus-fill',
};
const ACTION_COLOR: Record<string, string> = {
  create_group: '#a5ea7a',
  delete_group: '#fe6465',
  update_group_level: '#fed53c',
  set_command_level: '#8399ff',
  add_member: '#a5ea7a',
  remove_member: '#fe6465',
};

function timeAgo(iso: string): string {
  const diffMs = Date.now() - new Date(iso).getTime();
  const mins = Math.floor(diffMs / 60000);
  if (mins < 1) return dt('just now');
  if (mins < 60) return dt('{n}m ago', { n: mins });
  const hours = Math.floor(mins / 60);
  if (hours < 24) return dt('{n}h ago', { n: hours });
  const days = Math.floor(hours / 24);
  if (days < 30) return dt('{n}d ago', { n: days });
  return new Date(iso).toLocaleDateString(dashLang);
}
const people = new Set(entries.map((e) => e.actorId ?? e.actorName)).size;
const latest = entries.length ? timeAgo(entries[0].createdAt) : '–';
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="audit" pageTitle="Audit Log">
  <span hidden data-dash-live="60"></span>
  <div class="al">
    <h1>{dt('Audit Log')}</h1>

    {error && <div class="al-error"><Icon name="ph:warning-fill" width="15" height="15" />{error}</div>}

    <div class="al-stats">
      <div class="al-stat"><span>{dt('Events')}</span><b>{entries.length}</b></div>
      <div class="al-stat"><span>{dt('People')}</span><b>{people}</b></div>
      <div class="al-stat"><span>{dt('Latest')}</span><b>{latest}</b></div>
    </div>

    <section class="al-card">
      <div class="al-card-head"><h2>{dt('Recent events')}</h2></div>
      {entries.length === 0 ? (
        <div class="al-empty"><Icon name="ph:clipboard-text-fill" width="22" height="22" /><p>{dt('No Discord audit events were returned for this server.')}</p></div>
      ) : (
        <div class="al-timeline dgl-stagger">
          {entries.map((e) => (
            <div class="al-row">
              <div class="al-icon" style={`--c:${ACTION_COLOR[e.actionKey] ?? '#94a3b8'}`}>
                <Icon name={ACTION_ICON[e.actionKey] ?? 'ph:pencil-fill'} width="14" height="14" />
              </div>
              <div class="al-body">
                <p class="al-summary"><b>{e.actorName}</b> {e.action}</p>
                {(e.target || e.reason) && (
                  <div class="al-tags">
                    {e.target && <span class="al-target">{e.target}</span>}
                    {e.reason && <span class="al-reason">{dt('Reason')}: {e.reason}</span>}
                  </div>
                )}
              </div>
              <span class="al-time" title={new Date(e.createdAt).toLocaleString(dashLang)}>{timeAgo(e.createdAt)}</span>
            </div>
          ))}
        </div>
      )}
    </section>
  </div>
</DashGuildLayout>

<style>
  .al { max-width: 1180px; display: flex; flex-direction: column; min-height: 100%; }
  h1 { font-size: 24px; margin: 0 0 18px; }
  .al-error { display: flex; align-items: flex-start; gap: 8px; margin: 0 0 16px; padding: 11px 14px; color: var(--red); background: var(--red-soft); border: 1px solid var(--red); border-radius: 10px; font-size: 13px; line-height: 1.45; overflow-wrap: anywhere; }
  .al-error :global(svg) { flex: none; margin-top: 2px; }

  .al-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 0 0 16px; }
  .al-stat { display: flex; flex-direction: column; gap: 4px; min-width: 0; padding: 12px 16px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); }
  .al-stat span { font-size: 12.5px; color: var(--text-dim); }
  .al-stat b { font-size: 22px; line-height: 1.15; font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .al-card { padding: 0; margin: 0; flex: 1 1 auto; display: flex; flex-direction: column; min-width: 0; border: 1px solid var(--border); border-radius: 14px; background: var(--card); overflow: hidden; }
  .al-card-head { padding: 12px 16px; border-bottom: 1px solid var(--border); }
  .al-card-head h2 { font-size: 15px; margin: 0; }
  .al-empty { flex: 1 1 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 22px 16px; color: var(--text-dim); text-align: center; }
  .al-empty p { margin: 0; font-size: 13.5px; }
  .al-empty :global(svg) { color: var(--accent); }

  .al-timeline { display: flex; flex-direction: column; }
  .al-row { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; align-items: start; gap: 12px; padding: 12px 16px; }
  .al-row + .al-row { border-top: 1px solid var(--border-soft); }
  .al-icon { width: 28px; height: 28px; border-radius: 8px; display: flex; align-items: center; justify-content: center; background: color-mix(in srgb, var(--c) 16%, transparent); color: var(--c); transition: transform var(--m-fast) var(--m-out); }
  .al-row:hover .al-icon { transform: scale(1.12); }
  .al-body { min-width: 0; }
  .al-summary { font-size: 13px; color: var(--text-muted); margin: 0; line-height: 1.5; overflow-wrap: anywhere; }
  .al-summary :global(b){ color: var(--text); }
  .al-tags { display: flex; flex-wrap: wrap; gap: 4px 6px; margin-top: 4px; }
  .al-target, .al-reason { display: block; width: fit-content; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 3px 7px; border: 1px solid var(--border-soft); border-radius: 6px; background: var(--bg-raise); color: var(--text-muted); font-size: 11.5px; }
  .al-reason { color: var(--text-dim); font-style: italic; }
  .al-time { padding-top: 5px; font-size: 11px; color: var(--text-dim); font-family: var(--mono); white-space: nowrap; }

  @media (max-width: 520px) {
    .al-stats { gap: 8px; }
    .al-stat { padding: 10px 12px; }
    .al-stat b { font-size: 18px; }
    .al-row { grid-template-columns: 28px minmax(0, 1fr); padding: 11px 14px; }
    .al-time { grid-column: 2; padding-top: 0; }
  }
</style>
