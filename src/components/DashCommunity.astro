              ))}
            </div>
          </section>
        </div>

        <div class="sx-foot"><button type="submit" class="btn btn-accent btn-sm">{dt('Save changes')}</button></div>
      </form>

      <div class="cm-sec-head">
        <h2>{dt('Booster roles in this server')} <span class="cm-count">{num(boosterRoles.length)}</span></h2>
