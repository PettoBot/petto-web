---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';

interface ReportConfig { enabled: boolean; channelId: string | null; }
interface BoosterConfig {
  baseRoleId: string | null;
  roleLimit: number;
  shareMax: number;
  filteredWords: string[];
  colorCooldownHours: number;
  iconCooldownHours: number;
  renameCooldownHours: number;
}
interface BoosterRole { userId: string; roleId: string; color: string | null; }
interface ReputationConfig { enabled: boolean; cooldownHours: number; }
interface ReputationRow { userId: string; points: number; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  report: ReportConfig;
  booster: BoosterConfig;
  boosterRoles: BoosterRole[];
  roles: { id: string; name: string }[];
  channels: { id: string; name: string }[];
  saved: boolean;
  reputation: ReputationConfig;
  reputationTop: ReputationRow[];
  section?: string;
}
const { user, guildId, guildName, guildIcon, report, booster, boosterRoles, roles, channels, saved, reputation, reputationTop, section } = Astro.props;

const sectionMeta: Record<string, string> = { settings: 'Community settings', reputation: 'Reputation leaderboard', boosters: 'Active booster roles' };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'settings';
const selectedTitle = sectionMeta[selectedSection];

function roleName(id: string) {
  return roles.find((r) => r.id === id)?.name ?? id;
}
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'settings' ? 'community' : `community-${selectedSection}`} pageTitle={selectedTitle}>
  <h1>{selectedTitle}</h1>
  <p class="cm-sub">Member reports and booster color roles in <b>{guildName}</b>. Personal tools like <code>/remind</code> and <code>/afk</code> need no setup.</p>

  {saved && <div class="cm-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />Saved.</div>}

  <div class:list={['cm-grid', { 'cm-section-hidden': selectedSection !== 'settings' }]}>
    <form method="POST" class="cm-card">
      <input type="hidden" name="action" value="report" />
      <div class="cm-card-head">
        <div class="cm-card-icon" style="--c:#fe6465"><Icon name="ph:flag-fill" width="16" height="16" /></div>
        <div class="cm-card-title">Reports</div>
        <label class="cm-switch"><input type="checkbox" name="enabled" checked={report.enabled} /><span></span></label>
      </div>
      <p class="cm-card-desc">Where <code>/report</code> and the "Report Message" action send reports to staff.</p>
      <div class="cm-row">
        <label>Destination channel</label>
        <select name="channel_id">
          <option value="">None</option>
          {channels.map((c) => <option value={c.id} selected={c.id === report.channelId}>#{c.name}</option>)}
        </select>
      </div>
      <button type="submit" class="btn btn-ghost btn-sm">Save</button>
    </form>

    <form method="POST" class="cm-card">
      <input type="hidden" name="action" value="booster" />
      <div class="cm-card-head">
        <div class="cm-card-icon" style="--c:#f78fb3"><Icon name="ph:sparkle-fill" width="16" height="16" /></div>
        <div class="cm-card-title">Booster roles</div>
      </div>
      <p class="cm-card-desc">Custom colored roles boosters can create for themselves with <code>/boosterrole</code>.</p>
      <div class="cm-row">
        <label>Anchor role (position reference)</label>
        <select name="base_role_id">
          <option value="">None</option>
          {roles.map((r) => <option value={r.id} selected={r.id === booster.baseRoleId}>{r.name}</option>)}
        </select>
      </div>
      <div class="cm-row-pair">
        <div class="cm-row">
          <label>Roles per booster</label>
          <input type="number" name="role_limit" value={booster.roleLimit} min="1" max="5" />
        </div>
        <div class="cm-row">
          <label>Max people to share with</label>
          <input type="number" name="share_max" value={booster.shareMax} min="0" max="20" />
        </div>
      </div>
      <div class="cm-row-pair">
        <div class="cm-row">
          <label>Color change cooldown (hours)</label>
          <input type="number" name="color_cooldown_hours" value={booster.colorCooldownHours} min="0" max="720" />
        </div>
        <div class="cm-row">
          <label>Rename cooldown (hours)</label>
          <input type="number" name="rename_cooldown_hours" value={booster.renameCooldownHours} min="0" max="720" />
        </div>
      </div>
      <div class="cm-row">
        <label>Icon change cooldown (hours)</label>
        <input type="number" name="icon_cooldown_hours" value={booster.iconCooldownHours} min="0" max="720" />
      </div>
      <div class="cm-row">
        <label>Filtered words</label>
        <input type="text" name="filtered_words" value={booster.filteredWords.join(', ')} placeholder="comma, separated" />
      </div>
      <button type="submit" class="btn btn-ghost btn-sm">Save</button>
    </form>

    <form method="POST" class="cm-card">
      <input type="hidden" name="action" value="reputation" />
      <div class="cm-card-head">
        <div class="cm-card-icon" style="--c:#fed53c"><Icon name="ph:medal-fill" width="16" height="16" /></div>
        <div class="cm-card-title">Reputation</div>
        <label class="cm-switch"><input type="checkbox" name="enabled" checked={reputation.enabled} /><span></span></label>
      </div>
      <p class="cm-card-desc">A simple point members give each other with <code>/rep give</code>. No setup beyond this needed.</p>
      <div class="cm-row">
        <label>Cooldown between gives (hours)</label>
        <input type="number" name="cooldown_hours" value={reputation.cooldownHours} min="0" max="720" />
      </div>
      <button type="submit" class="btn btn-ghost btn-sm">Save</button>
    </form>
  </div>

  {reputationTop.length > 0 && (
    <div class:list={['cm-section', { 'cm-section-hidden': selectedSection !== 'reputation' }]}>
      <h2>Reputation leaderboard <span class="cm-count">{reputationTop.length}</span></h2>
      <div class="cm-list">
        {reputationTop.map((r) => (
          <div class="cm-list-row">
            <code>{r.userId}</code>
            <span class="cm-rep-points">{r.points} pts</span>
            <form method="POST">
              <input type="hidden" name="action" value="reset_reputation" />
              <input type="hidden" name="user_id" value={r.userId} />
              <button type="submit" class="cm-rep-reset" title="Reset to 0"><Icon name="ph:arrow-counter-clockwise-fill" width="13" height="13" /></button>
            </form>
          </div>
        ))}
      </div>
    </div>
  )}

  {boosterRoles.length > 0 && (
    <div class:list={['cm-section', { 'cm-section-hidden': selectedSection !== 'boosters' }]}>
      <h2>Active booster roles <span class="cm-count">{boosterRoles.length}</span></h2>
      <div class="cm-list">
        {boosterRoles.map((b) => (
          <div class="cm-list-row">
            <code>{b.userId}</code>
            <span>{roleName(b.roleId)}</span>
            {b.color && <span class="cm-swatch" style={`--sw:${b.color}`} />}
          </div>
        ))}
      </div>
    </div>
  )}
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  h2 { font-size: 14.5px; margin: 0 0 14px; }
  .cm-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 24px; max-width: 68ch; }
  .cm-sub b { color: var(--text); }
  .cm-sub code { font-family: var(--mono); color: var(--accent); }

  .cm-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 20px; max-width: fit-content; }

  .cm-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; margin-bottom: 36px; }
  .cm-card { border: 1px solid var(--border); border-radius: 14px; padding: 16px; background: var(--card); display: flex; flex-direction: column; gap: 13px; align-items: flex-start; }
  .cm-card-head { display: flex; align-items: center; gap: 10px; width: 100%; }
  .cm-card-icon { width: 30px; height: 30px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: color-mix(in srgb, var(--c) 16%, transparent); color: var(--c); }
  .cm-card-title { flex: 1; font-size: 13.5px; font-weight: 600; color: var(--text); }
  .cm-card-desc { font-size: 12px; color: var(--text-dim); line-height: 1.5; margin: 0; }
  .cm-card-desc code { font-family: var(--mono); color: var(--accent); }

  .cm-switch { position: relative; display: inline-block; width: 34px; height: 20px; flex-shrink: 0; }
  .cm-switch input { opacity: 0; width: 0; height: 0; }
  .cm-switch span { position: absolute; inset: 0; background: var(--border); border-radius: 20px; transition: background 0.15s; cursor: pointer; }
  .cm-switch span::before { content: ''; position: absolute; width: 14px; height: 14px; left: 3px; top: 3px; background: var(--card); border-radius: 50%; transition: transform 0.15s; }
  .cm-switch input:checked + span { background: var(--accent); }
  .cm-switch input:checked + span::before { transform: translateX(14px); }

  .cm-row { display: flex; flex-direction: column; gap: 5px; width: 100%; }
  .cm-row label { font-size: 11px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.03em; }
  .cm-row input, .cm-row select { width: 100%; box-sizing: border-box; border: 1px solid var(--border); border-radius: 8px; padding: 7px 9px; background: var(--bg-raise); color: var(--text); font-family: var(--sans); font-size: 13px; }
  .cm-row-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%; }

  .cm-section { margin-bottom: 30px; }
  .cm-section-hidden { display: none; }
  .cm-count { font-family: var(--mono); font-size: 11px; color: var(--text-dim); font-weight: 400; }
  .cm-list { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; max-width: 420px; }
  .cm-list-row { display: flex; align-items: center; gap: 12px; padding: 8px 14px; font-size: 13px; background: var(--card); }
  .cm-list-row + .cm-list-row { border-top: 1px solid var(--border-soft); }
  .cm-list-row code { font-family: var(--mono); font-size: 11.5px; color: var(--text-dim); }
  .cm-swatch { width: 14px; height: 14px; border-radius: 50%; background: var(--sw); margin-left: auto; }
  .cm-rep-points { margin-left: auto; font-family: var(--mono); color: var(--accent); font-size: 12px; }
  .cm-rep-reset { border: none; background: transparent; color: var(--text-dim); cursor: pointer; padding: 4px; border-radius: 6px; display: flex; }
  .cm-rep-reset:hover { color: var(--red); background: var(--red-soft); }

  @media (max-width: 480px) {
    .cm-row-pair { grid-template-columns: 1fr; }
  }

  @media (max-width: 660px) {
    .cm-grid { grid-template-columns: 1fr; }
  }
</style>
