          <section class="sx-panel" data-sx-needs="enabled">
            <div class="sx-panel-head">
              <span class="sx-panel-icon" style="--c:#5b8def"><Icon name="ph:users-three-fill" width="17" height="17" /></span>
              <h2>{dt('Limits')}</h2>
            </div>
            <div class="sx-grid">
              <div class="sx-field"><label for="cm-role-limit">{dt('Roles per booster')}</label><SxNumber id="cm-role-limit" name="role_limit" value={booster.roleLimit} min="0" max="25" /></div>
              <div class="sx-field"><label for="cm-share-max">{dt('Share with up to')}</label><SxNumber id="cm-share-max" name="share_max" value={booster.shareMax} min="0" max="25" /></div>
            </div>
            <span class="sx-hint"><Fragment set:html={dth('0 = no limit. Boosters share their role with friends with <code>{p}boosterrole share @member</code>.', { p: prefix })} /></span>
          </section>
        </div>

        <section class="sx-panel" data-sx-needs="enabled">
          <div class="sx-panel-head">
            <span class="sx-panel-icon" style="--c:#a78bfa"><Icon name="ph:palette-fill" width="17" height="17" /></span>
            <h2>{dt('What boosters can change')}</h2>
          </div>
          <div class="sx-switches">
            <label class="sx-switch"><input type="checkbox" name="allow_gradient" checked={booster.allowGradient} /><span class="sx-switch-text"><b>{dt('Gradients (a second color)')}</b></span><i class="sx-toggle"></i></label>
            <label class="sx-switch"><input type="checkbox" name="allow_icon" checked={booster.allowIcon} /><span class="sx-switch-text"><b>{dt('Role icons')}</b>{boosterStatus.live && boosterStatus.premiumTier < 2 && <em>{dt('(needs boost level 2)')}</em>}</span><i class="sx-toggle"></i></label>
          </div>
          <div class="sx-sub">
            <h3>{dt('Wait between changes')}</h3>
            <div class="sx-grid sx-grid-3">
              <div class="sx-field"><label for="cm-wait-color">{dt('Color wait (h)')}</label><SxNumber id="cm-wait-color" name="color_cooldown_hours" value={booster.colorCooldownHours} min="0" max="720" /></div>
              <div class="sx-field"><label for="cm-wait-rename">{dt('Rename wait (h)')}</label><SxNumber id="cm-wait-rename" name="rename_cooldown_hours" value={booster.renameCooldownHours} min="0" max="720" /></div>
              <div class="sx-field"><label for="cm-wait-icon">{dt('Icon wait (h)')}</label><SxNumber id="cm-wait-icon" name="icon_cooldown_hours" value={booster.iconCooldownHours} min="0" max="720" /></div>
            </div>
            <span class="sx-hint">{dt('Hours a booster waits between two changes of the same kind. 0 = no wait.')}</span>
