---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import UserChip from './UserChip.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface ReportConfig { enabled: boolean; channelId: string | null; urgentRoleId: string | null; anonymousReportingEnabled: boolean; }
interface BoosterConfig {
  baseRoleId: string | null;
  roleLimit: number;
  shareMax: number;
  filteredWords: string[];
  colorCooldownHours: number;
  iconCooldownHours: number;
  renameCooldownHours: number;
}
interface BoosterRole { userId: string; roleId: string; color: string | null; }
interface ReputationConfig { enabled: boolean; cooldownHours: number; }
interface ReputationRow { userId: string; points: number; }
interface Poll { id: number; channel_id: string; message_id: string; embed_template?: string | null; question: string; options: string[]; image: string | null; multi: boolean; ends_at: string | null; closed: boolean; created_at: string; voters: number; counts: number[]; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  report: ReportConfig;
  booster: BoosterConfig;
  boosterRoles: BoosterRole[];
  roles: { id: string; name: string }[];
  channels: { id: string; name: string }[];
  saved: boolean;
  reputation: ReputationConfig;
  reputationTop: ReputationRow[];
  polls: Poll[];
  pollError: string | null;
  people?: Record<string, { name: string; avatar: string }>;
  pollDesigns?: string[];
  section?: string;
}
const { user, guildId, guildName, guildIcon, report, booster, boosterRoles, roles, channels, saved, reputation, reputationTop, polls, pollError, people = {}, pollDesigns = [], section } = Astro.props;

const sectionMeta: Record<string, string> = { settings: dt('Community settings'), reputation: dt('Reputation leaderboard'), boosters: dt('Active booster roles'), polls: dt('Polls') };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'settings';
const selectedTitle = sectionMeta[selectedSection];

function roleName(id: string) {
  return roles.find((r) => r.id === id)?.name ?? id;
}
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'settings' ? 'community' : `community-${selectedSection}`} pageTitle={selectedTitle}>
  <h1>{selectedTitle}</h1>
  <p class="cm-sub"><Fragment set:html={dth('Member reports and booster color roles in <b>{a}</b>. Personal tools like <code>/remind</code> and <code>/afk</code> need no setup.', { a: (guildName) })} /></p>

  {saved && <div class="cm-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}

  {selectedSection === 'settings' && (
  <div class:list={['cm-grid', { 'cm-section-hidden': selectedSection !== 'settings' }]}>
    <form method="POST" class="cm-card">
      <input type="hidden" name="action" value="report" />
      <div class="cm-card-head">
        <div class="cm-card-icon" style="--c:#fe6465"><Icon name="ph:flag-fill" width="16" height="16" /></div>
        <div class="cm-card-title">{dt('Reports')}</div>
        <label class="cm-switch"><input type="checkbox" name="enabled" checked={report.enabled} /><span></span></label>
      </div>
      <p class="cm-card-desc"><Fragment set:html={dth('Where <code>/report</code> and the "Report Message" action send reports to staff.')} /></p>
      <div class="cm-row">
        <label>{dt('Destination channel')}</label>
        <select name="channel_id">
          <option value="">{dt('None')}</option>
          {channels.map((c) => <option value={c.id} selected={c.id === report.channelId}>#{c.name}</option>)}
        </select>
      </div>
      <div class="cm-row">
        <label><Fragment set:html={dth('Urgent moderator role <span class="cm-label-muted">optional</span>')} /></label>
        <select name="urgent_role_id">
          <option value="">{dt('No role mention')}</option>
          {roles.map((r) => <option value={r.id} selected={r.id === report.urgentRoleId}>@{r.name}</option>)}
        </select>
        <span class="cm-help">{dt('Members can choose “Ping Moderators” in the report form. This role is mentioned only for those urgent reports.')}</span>
      </div>
      <label class="cm-check"><input type="checkbox" name="anonymous_reporting_enabled" checked={report.anonymousReportingEnabled} />{dt('Allow anonymous reports')}</label>
      <button type="submit" class="btn btn-ghost btn-sm">{dt('Save')}</button>
    </form>

    <form method="POST" class="cm-card">
      <input type="hidden" name="action" value="booster" />
      <div class="cm-card-head">
        <div class="cm-card-icon" style="--c:#f78fb3"><Icon name="ph:sparkle-fill" width="16" height="16" /></div>
        <div class="cm-card-title">{dt('Booster roles')}</div>
      </div>
      <p class="cm-card-desc"><Fragment set:html={dth('Custom colored roles boosters can create for themselves with <code>/boosterrole</code>.')} /></p>
      <div class="cm-row">
        <label>{dt('Anchor role (position reference)')}</label>
        <select name="base_role_id">
          <option value="">{dt('None')}</option>
          {roles.map((r) => <option value={r.id} selected={r.id === booster.baseRoleId}>{r.name}</option>)}
        </select>
      </div>
      <div class="cm-row-pair">
        <div class="cm-row">
          <label>{dt('Roles per booster')}</label>
          <input type="number" name="role_limit" value={booster.roleLimit} min="1" max="5" />
        </div>
        <div class="cm-row">
          <label>{dt('Max people to share with')}</label>
          <input type="number" name="share_max" value={booster.shareMax} min="0" max="20" />
        </div>
      </div>
      <div class="cm-row-pair">
        <div class="cm-row">
          <label>{dt('Color change cooldown (hours)')}</label>
          <input type="number" name="color_cooldown_hours" value={booster.colorCooldownHours} min="0" max="720" />
        </div>
        <div class="cm-row">
          <label>{dt('Rename cooldown (hours)')}</label>
          <input type="number" name="rename_cooldown_hours" value={booster.renameCooldownHours} min="0" max="720" />
        </div>
      </div>
      <div class="cm-row">
        <label>{dt('Icon change cooldown (hours)')}</label>
        <input type="number" name="icon_cooldown_hours" value={booster.iconCooldownHours} min="0" max="720" />
      </div>
      <div class="cm-row">
        <label>{dt('Filtered words')}</label>
        <input type="text" name="filtered_words" value={booster.filteredWords.join(', ')} placeholder={dt('comma, separated')} />
      </div>
      <button type="submit" class="btn btn-ghost btn-sm">{dt('Save')}</button>
    </form>

    <form method="POST" class="cm-card">
      <input type="hidden" name="action" value="reputation" />
      <div class="cm-card-head">
        <div class="cm-card-icon" style="--c:#fed53c"><Icon name="ph:medal-fill" width="16" height="16" /></div>
        <div class="cm-card-title">{dt('Reputation')}</div>
        <label class="cm-switch"><input type="checkbox" name="enabled" checked={reputation.enabled} /><span></span></label>
      </div>
      <p class="cm-card-desc"><Fragment set:html={dth('A simple point members give each other with <code>/rep give</code>. No setup beyond this needed.')} /></p>
      <div class="cm-row">
        <label>{dt('Cooldown between gives (hours)')}</label>
        <input type="number" name="cooldown_hours" value={reputation.cooldownHours} min="0" max="720" />
      </div>
      <button type="submit" class="btn btn-ghost btn-sm">{dt('Save')}</button>
    </form>
  </div>
  )}

  {selectedSection === 'reputation' && reputationTop.length > 0 && (
    <div class:list={['cm-section', { 'cm-section-hidden': selectedSection !== 'reputation' }]}>
      <h2><Fragment set:html={dth('Reputation leaderboard <span class="cm-count">{a}</span>', { a: (reputationTop.length) })} /></h2>
      <div class="cm-list">
        {reputationTop.map((r) => (
          <div class="cm-list-row">
            <UserChip id={r.userId} person={people[r.userId]} />
            <span class="cm-rep-points">{r.points} pts</span>
            <form method="POST">
              <input type="hidden" name="action" value="reset_reputation" />
              <input type="hidden" name="user_id" value={r.userId} />
              <button type="submit" class="cm-rep-reset" title={dt('Reset to 0')}><Icon name="ph:arrow-counter-clockwise-fill" width="13" height="13" /></button>
            </form>
          </div>
        ))}
      </div>
    </div>
  )}

  {selectedSection === 'boosters' && boosterRoles.length > 0 && (
    <div class:list={['cm-section', { 'cm-section-hidden': selectedSection !== 'boosters' }]}>
      <h2><Fragment set:html={dth('Active booster roles <span class="cm-count">{a}</span>', { a: (boosterRoles.length) })} /></h2>
      <div class="cm-list">
        {boosterRoles.map((b) => (
          <div class="cm-list-row">
            <UserChip id={b.userId} person={people[b.userId]} />
            <span>{roleName(b.roleId)}</span>
            {b.color && <span class="cm-swatch" style={`--sw:${b.color}`} />}
          </div>
        ))}
      </div>
    </div>
  )}

  {selectedSection === 'polls' && (
  <div class:list={['cm-section cm-polls', { 'cm-section-hidden': selectedSection !== 'polls' }]}>
    <div class="cm-polls-head">
      <div>
        <h2>{dt('Create a poll')}</h2>
        <p class="cm-section-sub">{dt('Publish a button-voted poll directly to a channel. Members can change their vote until you close it.')}</p>
      </div>
    </div>
    {pollError && <div class="cm-error"><Icon name="ph:warning-fill" width="15" height="15" />{pollError}</div>}
    <form method="POST" class="cm-card cm-poll-create">
      <input type="hidden" name="action" value="create_poll" />
      <div class="cm-row">
        <label>{dt('Question')}</label>
        <input type="text" name="question" maxlength="200" placeholder={dt('What should we build next?')} required />
      </div>
      <div class="cm-row">
        <label>{dt('Options')}</label>
        <textarea name="options" rows="5" maxlength="800" placeholder={dt('One option per line\nA new command\nA dashboard module')} required></textarea>
        <span class="cm-help">{dt('Use 2 to 10 options. Each option can be up to 80 characters.')}</span>
      </div>
      <div class="cm-row-pair">
        <div class="cm-row">
          <label>{dt('Channel')}</label>
          <select name="channel_id" required>
            <option value="" disabled selected>{dt('Choose a channel')}</option>
            {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
          </select>
        </div>
        <div class="cm-row">
          <label>{dt('Auto-close in minutes')}</label>
          <input type="number" name="duration_minutes" min="0" max="525600" placeholder={dt('0 = never')} />
        </div>
      </div>
      <div class="cm-row">
        <label><Fragment set:html={dth('Image URL <span class="cm-label-muted">optional</span>')} /></label>
        <input type="url" name="image" maxlength="1000" placeholder="https://..." />
      </div>
      <div class="cm-row">
        <label><Fragment set:html={dth('Design <span class="cm-label-muted">optional</span>')} /></label>
        <select name="embed_template">
          <option value="">{dt('Petto card (default)')}</option>
          {pollDesigns.map((name) => <option value={name}>{name}</option>)}
        </select>
        <span class="cm-help">{dt('Pick a saved V2 embed to design the poll with the poll variables. The vote buttons stay under it.')}</span>
      </div>
      <label class="cm-check"><input type="checkbox" name="multi" />{dt('Allow members to choose more than one option')}</label>
      <div class="cm-pv" data-poll-preview aria-live="polite">
        <div class="cm-pv-label">{dt('Preview')}</div>
        <div class="cm-pv-q" data-pv-q>{dt('What should we build next?')}</div>
        <div class="cm-pv-type" data-pv-type data-multi={dt('Multiple choice')}>{dt('Single choice')}</div>
        <div class="cm-pv-opts" data-pv-opts></div>
        <div class="cm-pv-foot">{dt('0 votes · open')}</div>
      </div>
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:paper-plane-tilt-fill" width="13" height="13" />{dt('Publish poll')}</button>
    </form>

    <div class="cm-polls-existing" data-live-url={`/dash/guild/${guildId}/live?kind=polls`}>
      <h2><Fragment set:html={dth('Recent polls <span class="cm-count">{a}</span>', { a: (polls.length) })} /></h2>
      {polls.length === 0 ? (
        <div class="cm-empty"><Icon name="ph:chart-bar" width="18" height="18" /><span>{dt('No polls have been published in this server yet.')}</span></div>
      ) : (
        <div class="cm-poll-list">
          {polls.map((poll) => {
            const total = poll.voters;
            return (
              <article class:list={['cm-poll-card', { closed: poll.closed }]} data-poll-id={poll.id} data-open={poll.closed ? '' : '1'}>
                <div class="cm-poll-card-head"><div><h3>{poll.question}</h3><p>{dt('#{a} · {b} voter{c} · {d}', { a: (channels.find((c) => c.id === poll.channel_id)?.name ?? poll.channel_id), b: (total), c: (total === 1 ? '' : 's'), d: (poll.closed ? 'Closed' : 'Open') })}</p>
                  <p class="cm-poll-meta">
                    <span><Icon name="ph:users-three-fill" width="11" height="11" /> <b data-poll-voters>{total}</b></span>
                    {poll.ends_at && !poll.closed && <span><Icon name="ph:clock-fill" width="11" height="11" /> {dt('Closes')} <time datetime={poll.ends_at} data-local-time>{poll.ends_at}</time></span>}
                    {poll.multi && <span>{dt('Multiple choice')}</span>}
                    {poll.embed_template && <span>{dt('Design')}: {poll.embed_template}</span>}
                  </p></div><span class="cm-poll-status" data-poll-status data-label-live="Live" data-label-closed="Closed">{poll.closed ? 'Closed' : 'Live'}</span></div>
                <div class="cm-poll-options">
                  {poll.options.map((option, index) => {
                    const count = poll.counts[index] ?? 0;
                    const pct = total > 0 ? Math.round((count / total) * 100) : 0;
                    return <div class="cm-poll-option" data-poll-option={index}><div class="cm-poll-option-line"><span>{index + 1}. {option}</span><b data-poll-count>{count} · {pct}%</b></div><div class="cm-poll-bar"><i data-poll-bar style={`width:${pct}%`} /></div></div>;
                  })}
                </div>
                <div class="cm-poll-actions">
                  <a class="cm-link" href={`https://discord.com/channels/${guildId}/${poll.channel_id}/${poll.message_id}`} target="_blank" rel="noopener"><Icon name="ph:arrow-square-out" width="13" height="13" />{dt('Open in Discord')}</a>
                  {!poll.closed && <form method="POST"><input type="hidden" name="action" value="close_poll" /><input type="hidden" name="poll_id" value={poll.id} /><button type="submit" class="cm-del-text" data-confirm={dt('End this poll now? Nobody can vote after that.')}><Icon name="ph:stop-circle-fill" width="13" height="13" />{dt('End poll')}</button></form>}
                  <form method="POST"><input type="hidden" name="action" value="delete_poll" /><input type="hidden" name="poll_id" value={poll.id} /><button type="submit" class="cm-del-text" data-confirm={dt('Delete this poll? Its message in Discord and its votes are removed.')}><Icon name="ph:trash-fill" width="13" height="13" />{dt('Delete')}</button></form>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </div>
  )}
</DashGuildLayout>

<script is:inline>
  (function () {
    var letters = ['\u{1F1E6}','\u{1F1E7}','\u{1F1E8}','\u{1F1E9}','\u{1F1EA}','\u{1F1EB}','\u{1F1EC}','\u{1F1ED}','\u{1F1EE}','\u{1F1EF}'];
    function renderPollPreview(form) {
      var box = form.querySelector('[data-poll-preview]');
      if (!box) return;
      var q = form.querySelector('[name="question"]').value.trim();
      var lines = form.querySelector('[name="options"]').value.split(/\r?\n/).map(function (x) { return x.trim(); }).filter(Boolean).slice(0, 10);
      var multi = form.querySelector('[name="multi"]').checked;
      var qEl = box.querySelector('[data-pv-q]');
      if (qEl) { if (!qEl.getAttribute('data-sample')) qEl.setAttribute('data-sample', qEl.textContent); qEl.textContent = q || qEl.getAttribute('data-sample'); }
      var typeEl = box.querySelector('[data-pv-type]');
      if (typeEl) { if (!typeEl.getAttribute('data-single')) typeEl.setAttribute('data-single', typeEl.textContent); typeEl.textContent = multi ? typeEl.getAttribute('data-multi') || typeEl.getAttribute('data-single') : typeEl.getAttribute('data-single'); }
      var opts = box.querySelector('[data-pv-opts]');
      if (!opts) return;
      opts.textContent = '';
      lines.forEach(function (line, i) {
        var row = document.createElement('div');
        row.className = 'cm-pv-opt';
        var name = document.createElement('span');
        name.textContent = letters[i] + ' ' + line;
        var bar = document.createElement('i');
        row.appendChild(name); row.appendChild(bar);
        opts.appendChild(row);
      });
    }
    function init() {
      var f = document.querySelector('.cm-poll-create');
      if (f) renderPollPreview(f);
      document.querySelectorAll('time[data-local-time]').forEach(function (t) { var d = new Date(t.getAttribute('datetime')); if (!isNaN(d.getTime())) t.textContent = d.toLocaleString(); });
    }
    if (!window.__pollPreviewBound) {
      window.__pollPreviewBound = true;
      document.addEventListener('input', function (event) {
        var form = event.target && event.target.closest ? event.target.closest('.cm-poll-create') : null;
        if (form) renderPollPreview(form);
      });
    }
    init();

    // The votes of the open polls follow the votes as they come in, every 4 seconds while the page is in view.
    if (!window.__pollLive) {
      window.__pollLive = true;
      var pollTimer = null;
      var pollTick = function () {
        var box = document.querySelector('.cm-polls-existing[data-live-url]');
        var openCards = box ? box.querySelectorAll('.cm-poll-card[data-open="1"]') : [];
        if (!box || !openCards.length || document.hidden) { pollTimer = setTimeout(pollTick, 4000); return; }
        fetch(box.getAttribute('data-live-url'), { cache: 'no-store', headers: { Accept: 'application/json' } })
          .then(function (res) { return res.ok ? res.json() : null; })
          .then(function (data) {
            if (!data || !Array.isArray(data.polls)) return;
            data.polls.forEach(function (poll) {
              var card = box.querySelector('.cm-poll-card[data-poll-id="' + poll.id + '"]');
              if (!card) return;
              var voters = card.querySelector('[data-poll-voters]');
              if (voters) voters.textContent = String(poll.voters);
              card.querySelectorAll('[data-poll-option]').forEach(function (row) {
                var index = Number(row.getAttribute('data-poll-option'));
                var count = poll.counts[index] || 0;
                var pct = poll.voters > 0 ? Math.round((count / poll.voters) * 100) : 0;
                var label = row.querySelector('[data-poll-count]');
                if (label) label.textContent = count + ' · ' + pct + '%';
                var bar = row.querySelector('[data-poll-bar]');
                if (bar) bar.style.width = pct + '%';
              });
              if (poll.closed && card.getAttribute('data-open') === '1') {
                card.setAttribute('data-open', '');
                card.classList.add('closed');
                var status = card.querySelector('[data-poll-status]');
                if (status) status.textContent = status.getAttribute('data-label-closed') || 'Closed';
                var end = card.querySelector('form [value="close_poll"]');
                if (end && end.closest('form')) end.closest('form').hidden = true;
              }
            });
          })
          .catch(function () {})
          .then(function () { pollTimer = setTimeout(pollTick, 4000); });
      };
      document.addEventListener('visibilitychange', function () { if (!document.hidden) { clearTimeout(pollTimer); pollTimer = setTimeout(pollTick, 300); } });
      pollTimer = setTimeout(pollTick, 4000);
    }
  })();
</script>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  h2 { font-size: 14.5px; margin: 0 0 14px; }
  .cm-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 24px; max-width: 68ch; }
  .cm-sub :global(b){ color: var(--text); }
  .cm-sub :global(code){ font-family: var(--mono); color: var(--accent); }

  .cm-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 20px; max-width: fit-content; }

  .cm-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 16px; margin-bottom: 36px; }
  .cm-card { border: 1px solid var(--border); border-radius: 14px; padding: 16px; background: var(--card); display: flex; flex-direction: column; gap: 13px; align-items: flex-start; }
  .cm-card-head { display: flex; align-items: center; gap: 10px; width: 100%; }
  .cm-card-icon { width: 30px; height: 30px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: color-mix(in srgb, var(--c) 16%, transparent); color: var(--c); }
  .cm-card-title { flex: 1; font-size: 13.5px; font-weight: 600; color: var(--text); }
  .cm-card-desc { font-size: 12px; color: var(--text-dim); line-height: 1.5; margin: 0; }
  .cm-card-desc :global(code){ font-family: var(--mono); color: var(--accent); }

  .cm-switch { position: relative; display: inline-block; width: 34px; height: 20px; flex-shrink: 0; }
  .cm-switch input { opacity: 0; width: 0; height: 0; }
  .cm-switch :global(span){ position: absolute; inset: 0; background: var(--border); border-radius: 20px; transition: background 0.15s; cursor: pointer; }
  .cm-switch :global(span::before){ content: ''; position: absolute; width: 14px; height: 14px; left: 3px; top: 3px; background: var(--card); border-radius: 50%; transition: transform 0.15s; }
  .cm-switch input:checked + :global(span){ background: var(--accent); }
  .cm-switch input:checked + :global(span::before){ transform: translateX(14px); }

  .cm-row { display: flex; flex-direction: column; gap: 5px; width: 100%; }
  .cm-row label { font-size: 11px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.03em; }
  .cm-row input, .cm-row select { width: 100%; box-sizing: border-box; border: 1px solid var(--border); border-radius: 8px; padding: 7px 9px; background: var(--bg-raise); color: var(--text); font-family: var(--sans); font-size: 13px; }
  .cm-row-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%; }

  .cm-section { margin-bottom: 30px; }
  .cm-section-sub { font-size: 12.5px; color: var(--text-dim); margin: -6px 0 18px; max-width: 68ch; line-height: 1.5; }
  .cm-section-hidden { display: none; }
  :global(.cm-count){ font-family: var(--mono); font-size: 11px; color: var(--text-dim); font-weight: 400; }
  .cm-list { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; max-width: 520px; }
  .cm-list-row { display: flex; align-items: center; gap: 12px; padding: 8px 14px; font-size: 13px; background: var(--card); }
