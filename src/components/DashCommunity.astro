      {boosterStatus.live && !boosterStatus.canManageRoles && <div class="sx-flash sx-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('Petto needs the Manage Roles permission to create and change booster roles.')}</div>}

      <form method="POST" class="sx-stack cm-settings">
        <input type="hidden" name="action" value="booster" />
        <div class="sx-duo cm-duo">
          <section class="sx-panel">
            <div class="sx-panel-head">
              <span class="sx-panel-icon" style="--c:#f78fb3"><Icon name="ph:sparkle-fill" width="17" height="17" /></span>
