---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import UserChip from './UserChip.astro';
import MultiSelect from './MultiSelect.astro';
import ColorPicker from './ColorPicker.astro';
import MemberPick from './MemberPick.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import SxNumber from './SxNumber.astro';
import type { BoosterRoleInfo } from '../utils/pettoBotApi';

import { dashLocale, getDashLang, makeT } from '../i18n/dash';
import { formatDuration } from '../utils/formatDuration';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface ReportConfig { enabled: boolean; channelId: string | null; urgentRoleId: string | null; anonymousReportingEnabled: boolean; }
interface MessageLinksConfig { enabled: boolean; ignoredChannels: string[]; }
interface BoosterConfig {
  enabled: boolean;
  baseRoleId: string | null;
  roleLimit: number;
  shareMax: number;
  allowGradient: boolean;
  allowIcon: boolean;
  onUnboost: 'keep' | 'remove' | 'delete';
  filteredWords: string[];
  colorCooldownHours: number;
  iconCooldownHours: number;
  renameCooldownHours: number;
}
interface BoosterStatus { live: boolean; canManageRoles: boolean; boostCount: number; premiumTier: number; withoutRole: string[]; }
interface ReputationConfig { enabled: boolean; cooldownHours: number; giverRoleIds: string[]; blockedRoleIds: string[]; channelIds: string[]; rewards: { points: number; roleId: string }[]; }
interface ReputationRow { userId: string; points: number; }
interface RepLogRow { giverId: string; receiverId: string; channelId: string | null; at: string; }
interface Poll { id: number; channel_id: string; message_id: string; embed_template?: string | null; question: string; options: string[]; image: string | null; multi: boolean; ends_at: string | null; closed: boolean; created_at: string; voters: number; counts: number[]; }
interface CommunityEvent { kind: 'rep' | 'poll' | 'booster'; at: string; userId: string; otherId: string | null; channelId: string | null; text: string; closed: boolean; }
/** What Community Settings shows of the other three parts: how many, and the latest thing that happened in them. */
interface CommunityOverview { boosterRoles: number; reputationMembers: number; openPolls: number; polls: number; feed: CommunityEvent[]; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  report: ReportConfig;
  messageLinks?: MessageLinksConfig;
  booster: BoosterConfig;
  boosterRoles: BoosterRoleInfo[];
  boosterStatus: BoosterStatus;
  roleDetails: { id: string; name: string; color: number; managed: boolean }[];
  prefix: string;
  notice?: { ok: boolean; text: string } | null;
  reputationTotal?: number;
  repLog?: RepLogRow[];
  roles: { id: string; name: string }[];
  channels: { id: string; name: string }[];
  saved: boolean;
  reputation: ReputationConfig;
  reputationTop: ReputationRow[];
  polls: Poll[];
  community?: CommunityOverview;
  pollError: string | null;
  people?: Record<string, { name: string; avatar: string }>;
  pollDesigns?: string[];
  section?: string;
}
const { user, guildId, guildName, guildIcon, report, messageLinks = { enabled: false, ignoredChannels: [] }, booster, boosterRoles, boosterStatus, roleDetails, prefix, notice = null, reputationTotal = 0, repLog = [], roles, channels, saved, reputation, reputationTop, polls, community = { boosterRoles: 0, reputationMembers: 0, openPolls: 0, polls: 0, feed: [] }, pollError, people = {}, pollDesigns = [], section } = Astro.props;

const sectionMeta: Record<string, string> = { settings: dt('Community settings'), reputation: dt('Reputation'), boosters: dt('Booster roles'), polls: dt('Polls') };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'settings';
const selectedTitle = sectionMeta[selectedSection];

const locale = dashLocale(dashLang);
const num = (value: number) => value.toLocaleString(locale);
function roleName(id: string) {
  return roles.find((r) => r.id === id)?.name ?? id;
}
function roleHex(id: string) {
  const color = roleDetails.find((r) => r.id === id)?.color ?? 0;
  return color ? `#${color.toString(16).padStart(6, '0')}` : null;
}
const channelName = (id: string | null) => (id ? channels.find((c) => c.id === id)?.name ?? id : null);
const nameOf = (id: string) => people[id]?.name ?? id;
const avatarOf = (id: string) => people[id]?.avatar ?? `https://cdn.discordapp.com/embed/avatars/${Number(id.slice(-3)) % 6}.png`;
// "3h ago", "12d ago" (a date from a month on) and "20h" until a moment ahead: always the shared compact duration.
const ago = (iso: string) => {
  const seconds = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000);
  return seconds >= 30 * 86400 ? new Date(iso).toLocaleDateString(locale) : dt('{a} ago', { a: formatDuration(seconds, { locale }) });
};
const until = (iso: string) => formatDuration(Math.max(0, (new Date(iso).getTime() - Date.now()) / 1000), { locale });
// Booster roles whose owner no longer boosts (or left): what "Clean up" would delete.
const lapsed = boosterRoles.filter((row) => row.boosting === false || row.in_server === false);
const eventIcon = { rep: 'ph:medal-fill', poll: 'ph:chart-bar-fill', booster: 'ph:sparkle-fill' } as const;
const eventColor = { rep: '#fed53c', poll: '#6fb4ea', booster: '#f78fb3' } as const;
const eventLabel = { rep: dt('Reputation'), poll: dt('Polls'), booster: dt('Booster roles') } as const;
const unboostChoices: [string, string, string, string][] = [
  ['keep', 'ph:lock-simple-fill', dt('Keep the role'), dt('Nothing happens. Use Clean up below when you want to remove old roles.')],
  ['remove', 'ph:user-minus-fill', dt('Take it off'), dt('The role is taken off the member and the people it is shared with, and given back if they boost again.')],
  ['delete', 'ph:trash-fill', dt('Delete it'), dt('The role is deleted, also when the member leaves the server.')],
];
const maxPoints = Math.max(1, reputationTop[0]?.points ?? 1);
const pollVotes = polls.reduce((sum, poll) => sum + poll.voters, 0);
const pollsOpen = polls.filter((poll) => !poll.closed).length;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'settings' ? 'community' : `community-${selectedSection}`} pageTitle={selectedTitle}>
  <DashSettingsKit />
  <DashFormKit />
  <h1>{selectedTitle}</h1>

  {saved && !notice && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {notice && (notice.ok
    ? <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{notice.text}</div>
    : <div class="sx-flash sx-flash-bad" role="alert"><Icon name="ph:warning-fill" width="15" height="15" />{notice.text}</div>)}

  {selectedSection === 'settings' && (
  <div class="sx-page cm-page">
    <DashStatTiles tiles={[
      { label: dt('Reports'), value: 0, text: report.enabled ? dt('On') : dt('Off'), tone: 'messages' },
      { label: dt('Message links'), value: 0, text: messageLinks.enabled ? dt('On') : dt('Off'), tone: 'voice' },
      { label: dt('Booster roles'), value: community.boosterRoles, tone: 'invites' },
      { label: dt('Members with points'), value: community.reputationMembers, tone: 'reactions' },
      { label: dt('Open polls'), value: community.openPolls, tone: 'joins' },
    ]} />

    <div class="sx-duo cm-duo">
      <form method="POST" class="sx-panel cm-form">
        <input type="hidden" name="action" value="report" />
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style="--c:#fe6465"><Icon name="ph:flag-fill" width="17" height="17" /></span>
          <h2>{dt('Reports')}</h2>
          <label class="sx-toggle-only"><input type="checkbox" name="enabled" checked={report.enabled} aria-label={dt('Reports')} /><i class="sx-toggle"></i></label>
        </div>
        <p class="sx-lead cm-lead"><Fragment set:html={dth('Where <code>/report</code> and the "Report Message" action send reports to staff.')} /></p>
        <div class="cm-body" data-sx-needs="enabled">
          <div class="sx-field">
            <label for="cm-report-channel">{dt('Destination channel')}</label>
            <select id="cm-report-channel" name="channel_id">
              <option value="">{dt('None')}</option>
              {channels.map((c) => <option value={c.id} selected={c.id === report.channelId}>#{c.name}</option>)}
            </select>
          </div>
          <div class="sx-field">
            <label for="cm-report-role"><Fragment set:html={dth('Urgent moderator role <span class="cm-label-muted">optional</span>')} /></label>
            <select id="cm-report-role" name="urgent_role_id">
              <option value="">{dt('No role mention')}</option>
              {roles.map((r) => <option value={r.id} selected={r.id === report.urgentRoleId}>@{r.name}</option>)}
            </select>
            <span class="sx-hint">{dt('Members can choose “Ping Moderators” in the report form. This role is mentioned only for those urgent reports.')}</span>
          </div>
          <label class="sx-switch"><input type="checkbox" name="anonymous_reporting_enabled" checked={report.anonymousReportingEnabled} /><span class="sx-switch-text"><b>{dt('Allow anonymous reports')}</b></span><i class="sx-toggle"></i></label>
        </div>
        <div class="sx-foot cm-foot"><button type="submit" class="btn btn-accent btn-sm">{dt('Save')}</button></div>
      </form>

      <form method="POST" class="sx-panel cm-form">
        <input type="hidden" name="action" value="message_links" />
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style="--c:#7aa7ff"><Icon name="ph:link-fill" width="17" height="17" /></span>
          <h2>{dt('Message link embeds')}</h2>
          <label class="sx-toggle-only"><input type="checkbox" name="enabled" checked={messageLinks.enabled} aria-label={dt('Message link embeds')} /><i class="sx-toggle"></i></label>
        </div>
        <p class="sx-lead cm-lead"><Fragment set:html={dth('When a member posts the link of a message of this server, Petto shows it in an embed. Also <code>{p}messagelinks</code>. Off until you turn it on.', { p: prefix })} /></p>
        <div class="cm-body" data-sx-needs="enabled">
          <div class="sx-field">
            <span class="sx-label">{dt('Ignored channels')}</span>
            <MultiSelect name="ignored_channels" options={channels.map((c) => ({ id: c.id, name: `#${c.name}` }))} selected={messageLinks.ignoredChannels} placeholder={dt('None')} />
            <span class="sx-hint">{dt('Links posted in these channels, and messages that live in them, are never shown in embeds.')}</span>
          </div>
          <p class="cm-note"><Icon name="ph:eye-slash-fill" width="15" height="15" />{dt('It only shows messages the member who posted the link can already see: links to other servers, and to NSFW channels from a channel that is not NSFW, are left alone.')}</p>
        </div>
        <div class="sx-foot cm-foot"><button type="submit" class="btn btn-accent btn-sm">{dt('Save')}</button></div>
      </form>
    </div>

    <div class="cm-links dgl-stagger">
      <a class="cm-link" href={`/dash/guild/${guildId}/community?section=reputation`}>
        <span class="sx-panel-icon" style="--c:#fed53c"><Icon name="ph:medal-fill" width="17" height="17" /></span>
        <span class="cm-link-text">
          <span class="cm-link-title"><b>{dt('Reputation')}</b><span class:list={['cm-pill', reputation.enabled ? 'on' : 'off']}>{reputation.enabled ? dt('On') : dt('Off')}</span></span>
          <em><Fragment set:html={dth('A point members give each other with <code>{p}rep give</code>: who can give and where, reward roles, the leaderboard and the recent points.', { p: prefix })} /></em>
          <small>{dt('{a} members with points · {b} reward roles', { a: num(community.reputationMembers), b: num(reputation.rewards.length) })}</small>
        </span>
        <Icon name="ph:arrow-right-bold" class="cm-link-go" width="14" height="14" />
      </a>
      <a class="cm-link" href={`/dash/guild/${guildId}/community?section=boosters`}>
        <span class="sx-panel-icon" style="--c:#f78fb3"><Icon name="ph:sparkle-fill" width="17" height="17" /></span>
        <span class="cm-link-text">
          <span class="cm-link-title"><b>{dt('Booster roles')}</b><span class:list={['cm-pill', booster.enabled ? 'on' : 'off']}>{booster.enabled ? dt('On') : dt('Off')}</span></span>
          <em><Fragment set:html={dth('Custom colored roles boosters create for themselves with <code>{p}boosterrole</code>: what they may change, limits, the name filter and every booster role.', { p: prefix })} /></em>
          <small>{dt('{a} booster roles', { a: num(community.boosterRoles) })}</small>
        </span>
        <Icon name="ph:arrow-right-bold" class="cm-link-go" width="14" height="14" />
      </a>
      <a class="cm-link" href={`/dash/guild/${guildId}/community?section=polls`}>
        <span class="sx-panel-icon" style="--c:#6fb4ea"><Icon name="ph:chart-bar-fill" width="17" height="17" /></span>
        <span class="cm-link-text">
          <span class="cm-link-title"><b>{dt('Polls')}</b></span>
          <em>{dt('Publish a button-voted poll directly to a channel. Members can change their vote until you close it.')}</em>
          <small>{dt('{a} open polls · {b} recent', { a: num(community.openPolls), b: num(community.polls) })}</small>
        </span>
        <Icon name="ph:arrow-right-bold" class="cm-link-go" width="14" height="14" />
      </a>
    </div>

    <section class="sx-panel cm-feed">
      <div class="sx-panel-head">
        <span class="sx-panel-icon" style="--c:#86b894"><Icon name="ph:clock-counter-clockwise-fill" width="17" height="17" /></span>
        <h2>{dt('Latest in the community')}</h2>
      </div>
      {community.feed.length === 0 ? (
        <p class="sx-empty"><Icon name="ph:clock-counter-clockwise" width="20" height="20" />{dt('Points given, polls and booster roles show up here as they happen.')}</p>
      ) : (
        <ul class="cm-events" style={`--rows:${Math.ceil(community.feed.length / 2)}`}>
          {community.feed.map((event) => (
            <li class="cm-event" style={`--c:${eventColor[event.kind]}`}>
              <span class="cm-event-icon"><Icon name={eventIcon[event.kind]} width="15" height="15" /></span>
              <span class="cm-event-text">
                <span>
                  {event.kind === 'rep' && <Fragment set:html={dth('<b>{a}</b> gave a point to <b>{b}</b>', { a: nameOf(event.userId), b: nameOf(event.otherId ?? '') })} />}
                  {event.kind === 'poll' && <Fragment set:html={dth('<b>{a}</b> started the poll “{b}”', { a: nameOf(event.userId), b: event.text.length > 70 ? `${event.text.slice(0, 69)}…` : event.text })} />}
                  {event.kind === 'booster' && <Fragment set:html={dth('<b>{a}</b> got a booster role', { a: nameOf(event.userId) })} />}
                </span>
                <small>{eventLabel[event.kind]}{event.channelId ? ` · #${channelName(event.channelId)}` : ''}</small>
              </span>
              <time class="cm-event-when" datetime={event.at}>{ago(event.at)}</time>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
  )}

  {selectedSection === 'reputation' && (
    <div class="sx-page cm-page">
      <DashStatTiles tiles={[
        { label: dt('Reputation'), value: 0, text: reputation.enabled ? dt('On') : dt('Off'), tone: 'joins' },
        { label: dt('Members with points'), value: reputationTotal, tone: 'messages' },
        { label: dt('Most points'), value: reputationTop[0]?.points ?? 0, tone: 'reactions' },
        { label: dt('Reward roles'), value: reputation.rewards.length, tone: 'invites' },
        { label: dt('Wait between gives'), value: 0, text: reputation.cooldownHours ? formatDuration(reputation.cooldownHours * 3600, { locale }) : dt('None'), tone: 'voice' },
      ]} />

      <form method="POST" class="sx-panel cm-form">
        <input type="hidden" name="action" value="reputation" />
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style="--c:#fed53c"><Icon name="ph:medal-fill" width="17" height="17" /></span>
          <h2>{dt('Reputation')}</h2>
          <label class="sx-toggle-only"><input type="checkbox" name="enabled" checked={reputation.enabled} aria-label={dt('Reputation')} /><i class="sx-toggle"></i></label>
        </div>
        <p class="sx-lead cm-lead">{dt('When off, nobody can give points. The points and the leaderboard stay.')}</p>
        <div class="cm-cols" data-sx-needs="enabled">
          <div class="cm-body">
            <div class="sx-field">
              <label for="cm-rep-wait">{dt('Wait between gives (hours)')}</label>
              <SxNumber id="cm-rep-wait" name="cooldown_hours" value={reputation.cooldownHours} min="0" max="720" />
              <span class="sx-hint">{dt('How long a member waits before giving another point. 0 = no wait.')}</span>
            </div>
            <div class="sx-sub">
              <h3>{dt('Where')}</h3>
              <div class="sx-field">
                <span class="sx-label">{dt('Only in these channels')}</span>
                <MultiSelect name="channel_ids" options={channels.map((c) => ({ id: c.id, name: `#${c.name}` }))} selected={reputation.channelIds} placeholder={dt('Every channel')} />
                <span class="sx-hint">{dt('Empty: every channel. Threads count as their channel.')}</span>
              </div>
            </div>
          </div>
          <div class="cm-body">
            <h3 class="cm-h3">{dt('Who can give')}</h3>
            <div class="sx-field">
              <span class="sx-label">{dt('Only members with these roles')}</span>
              <MultiSelect name="giver_role_ids" options={roles} selected={reputation.giverRoleIds} placeholder={dt('Everyone')} />
              <span class="sx-hint">{dt('Empty: everyone can give.')}</span>
            </div>
            <div class="sx-field">
              <span class="sx-label">{dt('Blocked roles')}</span>
              <MultiSelect name="blocked_role_ids" options={roles} selected={reputation.blockedRoleIds} placeholder={dt('None')} />
              <span class="sx-hint">{dt('Members with one of these roles can neither give nor receive points.')}</span>
            </div>
          </div>
        </div>
        <div class="sx-foot cm-foot"><button type="submit" class="btn btn-accent btn-sm">{dt('Save')}</button></div>
      </form>

      <div class="sx-duo cm-duo">
        <section class="sx-panel">
          <div class="sx-panel-head">
            <span class="sx-panel-icon" style="--c:#f78fb3"><Icon name="ph:gift-fill" width="17" height="17" /></span>
            <h2>{dt('Reward roles')}</h2>
          </div>
          <p class="sx-lead cm-lead">{dt('A member gets the role when they reach the points. Roles already given stay when points are reset.')}</p>
          {reputation.rewards.length > 0 ? (
            <div class="sx-list">
              {reputation.rewards.map((reward) => (
                <form method="POST" class="sx-row cm-reward" data-no-dirty>
                  <input type="hidden" name="action" value="rep_reward_remove" />
                  <input type="hidden" name="points" value={reward.points} />
                  <b class="cm-pts-badge">{dt('{a} pts', { a: num(reward.points) })}</b>
                  <Icon name="ph:arrow-right" width="12" height="12" class="cm-arrow" />
                  <span class="cm-role"><i class="cm-dot" style={`--c:${roleHex(reward.roleId) ?? 'var(--text-dim)'}`}></i>@{roleName(reward.roleId)}</span>
                  <button type="submit" class="sx-iconbtn" title={dt('Remove')} aria-label={dt('Remove')}><Icon name="ph:x-bold" width="13" height="13" /></button>
                </form>
              ))}
            </div>
          ) : (
            <p class="sx-empty"><Icon name="ph:gift-fill" width="20" height="20" />{dt('No reward roles yet. Add the first one below.')}</p>
          )}
          <form method="POST" class="sx-sub cm-add" data-no-dirty>
            <input type="hidden" name="action" value="rep_reward_add" />
            <h3>{dt('Add')}</h3>
            <div class="cm-add-row">
              <div class="sx-field"><label for="cm-reward-points">{dt('Points')}</label><SxNumber id="cm-reward-points" name="points" value="" min="1" max="1000000" placeholder="10" required /></div>
              <div class="sx-field">
                <label for="cm-reward-role">{dt('Role')}</label>
                <select id="cm-reward-role" name="role_id" required>
                  <option value="" disabled selected>{dt('Choose a role')}</option>
                  {roleDetails.filter((r) => !r.managed).map((r) => <option value={r.id}>@{r.name}</option>)}
                </select>
              </div>
            </div>
            <div class="sx-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button></div>
          </form>
        </section>

        <form method="POST" class="sx-panel cm-form" data-no-dirty>
          <input type="hidden" name="action" value="rep_set" />
          <div class="sx-panel-head">
            <span class="sx-panel-icon" style="--c:#a78bfa"><Icon name="ph:sliders-horizontal-fill" width="17" height="17" /></span>
            <h2>{dt('Change a member\'s points')}</h2>
          </div>
          <p class="sx-lead cm-lead">{dt('Sets the points of any member. 0 resets them.')}</p>
          <div class="cm-body">
            <div class="sx-field"><span class="sx-label">{dt('Member')}</span><MemberPick guildId={guildId} /></div>
            {reputationTop.length > 0 && (
              <div class="sx-field">
                <span class="sx-label">{dt('Pick from the top')}</span>
                <div class="cm-picks">
                  {reputationTop.slice(0, 5).map((r) => <button type="button" data-pick-quick={r.userId} data-pick-name={people[r.userId]?.name ?? r.userId}><img src={avatarOf(r.userId)} alt="" width="22" height="22" loading="lazy" /><span>{people[r.userId]?.name ?? r.userId}</span><b>{dt(r.points === 1 ? '{a} pt' : '{a} pts', { a: num(r.points) })}</b></button>)}
                </div>
              </div>
            )}
            <div class="sx-field"><label for="cm-rep-points">{dt('Points')}</label><SxNumber id="cm-rep-points" name="points" value="0" min="0" max="1000000" required /></div>
          </div>
          <div class="sx-foot cm-foot"><button type="submit" class="btn btn-accent btn-sm">{dt('Save')}</button></div>
        </form>
      </div>

      <section class="sx-panel cm-lb-panel">
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style="--c:#e6c56f"><Icon name="ph:trophy-fill" width="17" height="17" /></span>
          <h2>{dt('Leaderboard')} <span class="cm-count">{num(reputationTotal)}</span></h2>
          {reputationTop.length > 0 && (
            <form method="POST" data-no-dirty class="cm-inline">
              <input type="hidden" name="action" value="reset_all_reputation" />
              <button type="submit" class="cm-danger" data-confirm={dt('Reset the points of every member to 0? This cannot be undone.')}><Icon name="ph:arrow-counter-clockwise-bold" width="12" height="12" />{dt('Reset everyone')}</button>
            </form>
          )}
        </div>
        {reputationTop.length === 0 ? (
          <p class="sx-empty"><Icon name="ph:medal" width="20" height="20" /><span><Fragment set:html={dth('Nobody has points yet. They appear here after the first <code>{p}rep give</code>.', { p: prefix })} /></span></p>
        ) : (
          <ol class="cm-lb" style={`--rows:${Math.ceil(reputationTop.length / 2)}`}>
            {reputationTop.map((r, index) => (
              <li class="cm-lb-row">
                <span class:list={['cm-rank', index < 3 && `top-${index + 1}`]}>{index + 1}</span>
                <UserChip id={r.userId} person={people[r.userId]} />
                <span class="cm-lb-points">
                  <b>{dt(r.points === 1 ? '{a} pt' : '{a} pts', { a: num(r.points) })}</b>
                  <span class="cm-meter"><i style={`width:${Math.max(3, Math.round((r.points / maxPoints) * 100))}%`}></i></span>
                </span>
                <form method="POST" data-no-dirty class="cm-inline">
                  <input type="hidden" name="action" value="reset_reputation" />
                  <input type="hidden" name="user_id" value={r.userId} />
                  <button type="submit" class="sx-iconbtn" title={dt('Reset to 0')} aria-label={dt('Reset to 0')} data-confirm={dt('Reset the points of {a} to 0?', { a: people[r.userId]?.name ?? r.userId })}><Icon name="ph:arrow-counter-clockwise-fill" width="14" height="14" /></button>
                </form>
              </li>
            ))}
          </ol>
        )}
      </section>

      <section class="sx-panel">
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style="--c:#6fb4ea"><Icon name="ph:clock-counter-clockwise-fill" width="17" height="17" /></span>
