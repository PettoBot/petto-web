---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import UserChip from './UserChip.astro';
import MultiSelect from './MultiSelect.astro';
import ColorPicker from './ColorPicker.astro';
import MemberPick from './MemberPick.astro';
import type { BoosterRoleInfo } from '../utils/pettoBotApi';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface ReportConfig { enabled: boolean; channelId: string | null; urgentRoleId: string | null; anonymousReportingEnabled: boolean; }
interface MessageLinksConfig { enabled: boolean; ignoredChannels: string[]; }
interface BoosterConfig {
  enabled: boolean;
  baseRoleId: string | null;
  roleLimit: number;
  shareMax: number;
  allowGradient: boolean;
  allowIcon: boolean;
  onUnboost: 'keep' | 'remove' | 'delete';
  filteredWords: string[];
  colorCooldownHours: number;
  iconCooldownHours: number;
  renameCooldownHours: number;
}
interface BoosterStatus { live: boolean; canManageRoles: boolean; boostCount: number; premiumTier: number; withoutRole: string[]; }
interface ReputationConfig { enabled: boolean; cooldownHours: number; giverRoleIds: string[]; blockedRoleIds: string[]; channelIds: string[]; rewards: { points: number; roleId: string }[]; }
interface ReputationRow { userId: string; points: number; }
interface RepLogRow { giverId: string; receiverId: string; channelId: string | null; at: string; }
interface Poll { id: number; channel_id: string; message_id: string; embed_template?: string | null; question: string; options: string[]; image: string | null; multi: boolean; ends_at: string | null; closed: boolean; created_at: string; voters: number; counts: number[]; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  report: ReportConfig;
  messageLinks?: MessageLinksConfig;
  booster: BoosterConfig;
  boosterRoles: BoosterRoleInfo[];
  boosterStatus: BoosterStatus;
  roleDetails: { id: string; name: string; color: number; managed: boolean }[];
  prefix: string;
  notice?: { ok: boolean; text: string } | null;
  reputationTotal?: number;
  repLog?: RepLogRow[];
  roles: { id: string; name: string }[];
  channels: { id: string; name: string }[];
  saved: boolean;
  reputation: ReputationConfig;
  reputationTop: ReputationRow[];
  polls: Poll[];
  pollError: string | null;
  people?: Record<string, { name: string; avatar: string }>;
  pollDesigns?: string[];
  section?: string;
}
const { user, guildId, guildName, guildIcon, report, messageLinks = { enabled: false, ignoredChannels: [] }, booster, boosterRoles, boosterStatus, roleDetails, prefix, notice = null, reputationTotal = 0, repLog = [], roles, channels, saved, reputation, reputationTop, polls, pollError, people = {}, pollDesigns = [], section } = Astro.props;

const sectionMeta: Record<string, string> = { settings: dt('Community settings'), reputation: dt('Reputation'), boosters: dt('Booster roles'), polls: dt('Polls') };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'settings';
const selectedTitle = sectionMeta[selectedSection];

function roleName(id: string) {
  return roles.find((r) => r.id === id)?.name ?? id;
}
// Booster roles whose owner no longer boosts (or left): what "Clean up" would delete.
const lapsed = boosterRoles.filter((row) => row.boosting === false || row.in_server === false);
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'settings' ? 'community' : `community-${selectedSection}`} pageTitle={selectedTitle}>
  <h1>{selectedTitle}</h1>

  {saved && !notice && <div class="cm-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {notice && (notice.ok
    ? <div class="cm-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{notice.text}</div>
    : <div class="cm-error" role="alert"><Icon name="ph:warning-fill" width="15" height="15" />{notice.text}</div>)}

  {selectedSection === 'settings' && (
  <div class:list={['cm-grid dgl-stagger', { 'cm-section-hidden': selectedSection !== 'settings' }]}>
    <form method="POST" class="cm-card">
      <input type="hidden" name="action" value="report" />
      <div class="cm-card-head">
        <div class="cm-card-icon" style="--c:#fe6465"><Icon name="ph:flag-fill" width="16" height="16" /></div>
        <div class="cm-card-title">{dt('Reports')}</div>
        <label class="cm-switch"><input type="checkbox" name="enabled" checked={report.enabled} /><span></span></label>
      </div>
      <p class="cm-card-desc"><Fragment set:html={dth('Where <code>/report</code> and the "Report Message" action send reports to staff.')} /></p>
      <div class="cm-row">
        <label>{dt('Destination channel')}</label>
        <select name="channel_id">
          <option value="">{dt('None')}</option>
          {channels.map((c) => <option value={c.id} selected={c.id === report.channelId}>#{c.name}</option>)}
        </select>
      </div>
      <div class="cm-row">
        <label><Fragment set:html={dth('Urgent moderator role <span class="cm-label-muted">optional</span>')} /></label>
        <select name="urgent_role_id">
          <option value="">{dt('No role mention')}</option>
          {roles.map((r) => <option value={r.id} selected={r.id === report.urgentRoleId}>@{r.name}</option>)}
        </select>
        <span class="cm-help">{dt('Members can choose “Ping Moderators” in the report form. This role is mentioned only for those urgent reports.')}</span>
      </div>
      <label class="cm-check"><input type="checkbox" name="anonymous_reporting_enabled" checked={report.anonymousReportingEnabled} />{dt('Allow anonymous reports')}</label>
      <button type="submit" class="btn btn-ghost btn-sm">{dt('Save')}</button>
    </form>

    <form method="POST" class="cm-card">
      <input type="hidden" name="action" value="message_links" />
      <div class="cm-card-head">
        <div class="cm-card-icon" style="--c:#7aa7ff"><Icon name="ph:link-fill" width="16" height="16" /></div>
        <div class="cm-card-title">{dt('Message link embeds')}</div>
        <label class="cm-switch"><input type="checkbox" name="enabled" checked={messageLinks.enabled} /><span></span></label>
      </div>
      <p class="cm-card-desc"><Fragment set:html={dth('When a member posts the link of a message of this server, Petto shows it in an embed. Also <code>{p}messagelinks</code>. Off until you turn it on.', { p: prefix })} /></p>
      <div class="cm-row">
        <label>{dt('Ignored channels')}</label>
        <MultiSelect name="ignored_channels" options={channels.map((c) => ({ id: c.id, name: `#${c.name}` }))} selected={messageLinks.ignoredChannels} placeholder={dt('None')} />
        <span class="cm-help">{dt('Links posted in these channels, and messages that live in them, are never shown in embeds.')}</span>
      </div>
      <span class="cm-help">{dt('It only shows messages the member who posted the link can already see: links to other servers, and to NSFW channels from a channel that is not NSFW, are left alone.')}</span>
      <button type="submit" class="btn btn-ghost btn-sm">{dt('Save')}</button>
    </form>

    <a class="cm-card cm-card-link dgl-card" href={`/dash/guild/${guildId}/community?section=boosters`}>
      <div class="cm-card-head">
        <div class="cm-card-icon" style="--c:#f78fb3"><Icon name="ph:sparkle-fill" width="16" height="16" /></div>
        <div class="cm-card-title">{dt('Booster roles')}</div>
        <span class:list={['cm-pill', booster.enabled ? 'on' : 'off']}>{booster.enabled ? dt('On') : dt('Off')}</span>
      </div>
      <p class="cm-card-desc"><Fragment set:html={dth('Custom colored roles boosters create for themselves with <code>{p}boosterrole</code>: what they may change, limits, the name filter and every booster role.', { p: prefix })} /></p>
      <span class="cm-link">{dt('Open booster roles')}<Icon name="ph:arrow-right-bold" width="12" height="12" /></span>
    </a>

    <a class="cm-card cm-card-link dgl-card" href={`/dash/guild/${guildId}/community?section=reputation`}>
      <div class="cm-card-head">
        <div class="cm-card-icon" style="--c:#fed53c"><Icon name="ph:medal-fill" width="16" height="16" /></div>
        <div class="cm-card-title">{dt('Reputation')}</div>
        <span class:list={['cm-pill', reputation.enabled ? 'on' : 'off']}>{reputation.enabled ? dt('On') : dt('Off')}</span>
      </div>
      <p class="cm-card-desc"><Fragment set:html={dth('A point members give each other with <code>{p}rep give</code>: who can give and where, reward roles, the leaderboard and the recent points.', { p: prefix })} /></p>
      <span class="cm-link">{dt('Open reputation')}<Icon name="ph:arrow-right-bold" width="12" height="12" /></span>
    </a>
  </div>
  )}

  {selectedSection === 'reputation' && (
    <div class="cm-page">
      <div class="cm-stats dgl-stagger">
        <div class="cm-stat"><b>{reputation.enabled ? dt('On') : dt('Off')}</b><span>{dt('Reputation')}</span></div>
        <div class="cm-stat"><b>{reputationTotal}</b><span>{dt('Members with points')}</span></div>
        <div class="cm-stat"><b>{reputationTop[0]?.points ?? 0}</b><span>{dt('Most points')}</span></div>
        <div class="cm-stat"><b>{reputation.cooldownHours ? dt('{a} h', { a: reputation.cooldownHours }) : dt('None')}</b><span>{dt('Wait between gives')}</span></div>
      </div>

      <form method="POST" class="cm-settings">
        <input type="hidden" name="action" value="reputation" />
        <div class="cm-grid">
          <div class="cm-card">
            <div class="cm-card-head">
              <div class="cm-card-icon" style="--c:#fed53c"><Icon name="ph:medal-fill" width="16" height="16" /></div>
              <div class="cm-card-title">{dt('Reputation')}</div>
              <label class="cm-switch" title={dt('On')}><input type="checkbox" name="enabled" checked={reputation.enabled} /><span></span></label>
            </div>
            <p class="cm-card-desc">{dt('When off, nobody can give points. The points and the leaderboard stay.')}</p>
            <div class="cm-row">
              <label>{dt('Wait between gives (hours)')}</label>
              <input type="number" name="cooldown_hours" value={reputation.cooldownHours} min="0" max="720" />
              <span class="cm-help">{dt('How long a member waits before giving another point. 0 = no wait.')}</span>
            </div>
          </div>

          <div class="cm-card">
            <div class="cm-card-head">
              <div class="cm-card-icon" style="--c:#5b8def"><Icon name="ph:user-check-fill" width="16" height="16" /></div>
              <div class="cm-card-title">{dt('Who can give')}</div>
            </div>
            <div class="cm-row">
              <label>{dt('Only members with these roles')}</label>
              <MultiSelect name="giver_role_ids" options={roles} selected={reputation.giverRoleIds} placeholder={dt('Everyone')} />
              <span class="cm-help">{dt('Empty: everyone can give.')}</span>
            </div>
            <div class="cm-row">
              <label>{dt('Blocked roles')}</label>
              <MultiSelect name="blocked_role_ids" options={roles} selected={reputation.blockedRoleIds} placeholder={dt('None')} />
              <span class="cm-help">{dt('Members with one of these roles can neither give nor receive points.')}</span>
            </div>
          </div>

          <div class="cm-card">
            <div class="cm-card-head">
              <div class="cm-card-icon" style="--c:#2dd4a7"><Icon name="ph:hash-bold" width="16" height="16" /></div>
              <div class="cm-card-title">{dt('Where')}</div>
            </div>
            <div class="cm-row">
              <label>{dt('Only in these channels')}</label>
              <MultiSelect name="channel_ids" options={channels.map((c) => ({ id: c.id, name: `#${c.name}` }))} selected={reputation.channelIds} placeholder={dt('Every channel')} />
              <span class="cm-help">{dt('Empty: every channel. Threads count as their channel.')}</span>
            </div>
          </div>
        </div>
        <button type="submit" class="btn btn-ghost btn-sm">{dt('Save')}</button>
      </form>

      <div class="cm-grid">
        <div class="cm-card">
          <div class="cm-card-head">
            <div class="cm-card-icon" style="--c:#f78fb3"><Icon name="ph:gift-fill" width="16" height="16" /></div>
            <div class="cm-card-title">{dt('Reward roles')}</div>
          </div>
          <p class="cm-card-desc">{dt('A member gets the role when they reach the points. Roles already given stay when points are reset.')}</p>
          {reputation.rewards.length > 0 && (
            <div class="cm-rewards">
              {reputation.rewards.map((reward) => (
                <form method="POST" class="cm-reward" data-no-dirty>
                  <input type="hidden" name="action" value="rep_reward_remove" />
                  <input type="hidden" name="points" value={reward.points} />
                  <b>{dt('{a} pts', { a: reward.points })}</b>
                  <Icon name="ph:arrow-right" width="12" height="12" />
                  <span>@{roleName(reward.roleId)}</span>
                  <button type="submit" class="cm-rep-reset" title={dt('Remove')}><Icon name="ph:x-bold" width="12" height="12" /></button>
                </form>
              ))}
            </div>
          )}
          <form method="POST" class="cm-reward-add" data-no-dirty>
            <input type="hidden" name="action" value="rep_reward_add" />
            <div class="cm-row"><label>{dt('Points')}</label><input type="number" name="points" min="1" max="1000000" placeholder="10" required /></div>
            <div class="cm-row">
              <label>{dt('Role')}</label>
              <select name="role_id" required>
                <option value="" disabled selected>{dt('Choose a role')}</option>
                {roleDetails.filter((r) => !r.managed).map((r) => <option value={r.id}>@{r.name}</option>)}
              </select>
            </div>
            <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button>
          </form>
        </div>

        <form method="POST" class="cm-card" data-no-dirty>
          <input type="hidden" name="action" value="rep_set" />
          <div class="cm-card-head">
            <div class="cm-card-icon" style="--c:#a78bfa"><Icon name="ph:sliders-horizontal-fill" width="16" height="16" /></div>
            <div class="cm-card-title">{dt('Change a member\'s points')}</div>
          </div>
          <p class="cm-card-desc">{dt('Sets the points of any member. 0 resets them.')}</p>
          <div class="cm-row"><label>{dt('Member')}</label><MemberPick guildId={guildId} /></div>
          <div class="cm-row"><label>{dt('Points')}</label><input type="number" name="points" min="0" max="1000000" value="0" required /></div>
          <button type="submit" class="btn btn-ghost btn-sm">{dt('Save')}</button>
        </form>

        <div class="cm-card">
          <div class="cm-card-head">
            <div class="cm-card-icon" style="--c:#8b8fa3"><Icon name="ph:terminal-window-fill" width="16" height="16" /></div>
            <div class="cm-card-title">{dt('Commands')}</div>
          </div>
          <ul class="cm-cmds">
            <li><code>{prefix}rep give @member</code><span>{dt('Give a point')}</span></li>
            <li><code>{prefix}rep view @member</code><span>{dt('See the points of a member')}</span></li>
            <li><code>{prefix}rep leaderboard</code><span>{dt('The top 10')}</span></li>
            <li><code>{prefix}rep reset @member</code><span>{dt('Reset a member (Manage Server)')}</span></li>
          </ul>
        </div>
      </div>

      <div class="cm-two">
        <div class="cm-section">
          <div class="cm-section-head">
            <h2><Fragment set:html={dth('Leaderboard <span class="cm-count">{a}</span>', { a: reputationTotal })} /></h2>
            {reputationTop.length > 0 && (
              <form method="POST" data-no-dirty>
                <input type="hidden" name="action" value="reset_all_reputation" />
                <button type="submit" class="cm-del-text" data-confirm={dt('Reset the points of every member to 0? This cannot be undone.')}><Icon name="ph:arrow-counter-clockwise-bold" width="12" height="12" />{dt('Reset everyone')}</button>
              </form>
            )}
          </div>
          {reputationTop.length === 0 ? (
            <div class="cm-empty"><Icon name="ph:medal" width="18" height="18" /><span><Fragment set:html={dth('Nobody has points yet. They appear here after the first <code>{p}rep give</code>.', { p: prefix })} /></span></div>
          ) : (
            <div class="cm-list cm-lb">
              {reputationTop.map((r, index) => (
                <div class="cm-list-row">
                  <span class:list={['cm-rank', { top: index < 3 }]}>{index + 1}</span>
                  <UserChip id={r.userId} person={people[r.userId]} />
                  <span class="cm-rep-points">{dt(r.points === 1 ? '{a} pt' : '{a} pts', { a: r.points })}</span>
                  <form method="POST" data-no-dirty>
                    <input type="hidden" name="action" value="reset_reputation" />
                    <input type="hidden" name="user_id" value={r.userId} />
                    <button type="submit" class="cm-rep-reset" title={dt('Reset to 0')} data-confirm={dt('Reset the points of {a} to 0?', { a: people[r.userId]?.name ?? r.userId })}><Icon name="ph:arrow-counter-clockwise-fill" width="13" height="13" /></button>
                  </form>
                </div>
              ))}
            </div>
          )}
        </div>

        <div class="cm-section">
          <div class="cm-section-head"><h2>{dt('Recent points')}</h2></div>
          {repLog.length === 0 ? (
            <div class="cm-empty"><Icon name="ph:clock-counter-clockwise" width="18" height="18" /><span>{dt('The points given from now on are listed here.')}</span></div>
          ) : (
            <div class="cm-list cm-log">
              {repLog.map((row) => (
                <div class="cm-list-row">
                  <UserChip id={row.giverId} person={people[row.giverId]} />
                  <Icon name="ph:arrow-right-bold" width="12" height="12" class="cm-log-arrow" />
                  <UserChip id={row.receiverId} person={people[row.receiverId]} />
                  <span class="cm-log-meta">{row.channelId && <span>#{channels.find((c) => c.id === row.channelId)?.name ?? row.channelId}</span>}<time datetime={row.at} data-local-time>{row.at}</time></span>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  )}

  {selectedSection === 'boosters' && (
    <div class="cm-page">
      <div class="cm-stats dgl-stagger">
        <div class="cm-stat"><b>{boosterRoles.length}</b><span>{dt('Booster roles')}</span></div>
        <div class="cm-stat"><b>{boosterStatus.boostCount}</b><span>{dt('Boosts')}</span></div>
        <div class="cm-stat"><b>{dt('Level {a}', { a: boosterStatus.premiumTier })}</b><span>{dt('Server boost level')}</span></div>
        <div class="cm-stat"><b>{lapsed.length}</b><span>{dt('No longer boosting')}</span></div>
      </div>
      {!boosterStatus.live && <div class="cm-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('Petto did not answer, so the list shows the saved roles without their Discord details. Changes may not work right now.')}</div>}
      {boosterStatus.live && !boosterStatus.canManageRoles && <div class="cm-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('Petto needs the Manage Roles permission to create and change booster roles.')}</div>}

      <form method="POST" class="cm-settings">
        <input type="hidden" name="action" value="booster" />
        <div class="cm-grid">
          <div class="cm-card">
            <div class="cm-card-head">
              <div class="cm-card-icon" style="--c:#f78fb3"><Icon name="ph:sparkle-fill" width="16" height="16" /></div>
              <div class="cm-card-title">{dt('Booster roles')}</div>
              <label class="cm-switch" title={dt('On')}><input type="checkbox" name="enabled" checked={booster.enabled} /><span></span></label>
            </div>
            <p class="cm-card-desc">{dt('When off, boosters cannot create or change a role. They can still remove theirs, and staff can still manage them here.')}</p>
            <div class="cm-row">
              <label>{dt('Place new roles above')}</label>
              <select name="base_role_id">
                <option value="">{dt('The Server Booster role (default)')}</option>
                {roles.map((r) => <option value={r.id} selected={r.id === booster.baseRoleId}>@{r.name}</option>)}
              </select>
              <span class="cm-help">{dt('New booster roles go right above this role, newest on top, so their color shows. Petto\'s own role must be higher.')}</span>
            </div>
          </div>

          <div class="cm-card">
            <div class="cm-card-head">
              <div class="cm-card-icon" style="--c:#a78bfa"><Icon name="ph:palette-fill" width="16" height="16" /></div>
              <div class="cm-card-title">{dt('What boosters can change')}</div>
            </div>
            <label class="cm-check"><input type="checkbox" name="allow_gradient" checked={booster.allowGradient} />{dt('Gradients (a second color)')}</label>
            <label class="cm-check"><input type="checkbox" name="allow_icon" checked={booster.allowIcon} />{dt('Role icons')}{boosterStatus.live && boosterStatus.premiumTier < 2 && <span class="cm-label-muted">{dt('(needs boost level 2)')}</span>}</label>
            <div class="cm-row-trio">
              <div class="cm-row">
                <label>{dt('Color wait (h)')}</label>
                <input type="number" name="color_cooldown_hours" value={booster.colorCooldownHours} min="0" max="720" />
              </div>
              <div class="cm-row">
                <label>{dt('Rename wait (h)')}</label>
                <input type="number" name="rename_cooldown_hours" value={booster.renameCooldownHours} min="0" max="720" />
              </div>
              <div class="cm-row">
                <label>{dt('Icon wait (h)')}</label>
                <input type="number" name="icon_cooldown_hours" value={booster.iconCooldownHours} min="0" max="720" />
              </div>
            </div>
            <span class="cm-help">{dt('Hours a booster waits between two changes of the same kind. 0 = no wait.')}</span>
          </div>

          <div class="cm-card">
            <div class="cm-card-head">
              <div class="cm-card-icon" style="--c:#5b8def"><Icon name="ph:users-three-fill" width="16" height="16" /></div>
              <div class="cm-card-title">{dt('Limits')}</div>
            </div>
            <div class="cm-row-pair">
              <div class="cm-row">
                <label>{dt('Roles per booster')}</label>
                <input type="number" name="role_limit" value={booster.roleLimit} min="0" max="25" />
              </div>
              <div class="cm-row">
                <label>{dt('Share with up to')}</label>
                <input type="number" name="share_max" value={booster.shareMax} min="0" max="25" />
              </div>
            </div>
            <span class="cm-help"><Fragment set:html={dth('0 = no limit. Boosters share their role with friends with <code>{p}boosterrole share @member</code>.', { p: prefix })} /></span>
          </div>

          <div class="cm-card">
            <div class="cm-card-head">
              <div class="cm-card-icon" style="--c:#fe6465"><Icon name="ph:prohibit-fill" width="16" height="16" /></div>
              <div class="cm-card-title">{dt('Name filter')}</div>
            </div>
            <div class="cm-row">
              <textarea name="filtered_words" rows="4" maxlength="6000" placeholder={dt('One word or phrase per line')}>{booster.filteredWords.join('\n')}</textarea>
              <span class="cm-help">{dt('A role name that contains any of these is refused. Capital letters do not matter.')}</span>
            </div>
          </div>

          <div class="cm-card cm-card-wide">
            <div class="cm-card-head">
              <div class="cm-card-icon" style="--c:#f5c945"><Icon name="ph:clock-counter-clockwise-fill" width="16" height="16" /></div>
              <div class="cm-card-title">{dt('When a member stops boosting')}</div>
            </div>
            <div class="cm-choices">
              <label class="cm-choice"><input type="radio" name="on_unboost" value="keep" checked={booster.onUnboost === 'keep'} /><span><b>{dt('Keep the role')}</b><small>{dt('Nothing happens. Use Clean up below when you want to remove old roles.')}</small></span></label>
              <label class="cm-choice"><input type="radio" name="on_unboost" value="remove" checked={booster.onUnboost === 'remove'} /><span><b>{dt('Take it off')}</b><small>{dt('The role is taken off the member and the people it is shared with, and given back if they boost again.')}</small></span></label>
              <label class="cm-choice"><input type="radio" name="on_unboost" value="delete" checked={booster.onUnboost === 'delete'} /><span><b>{dt('Delete it')}</b><small>{dt('The role is deleted, also when the member leaves the server.')}</small></span></label>
            </div>
          </div>
        </div>
        <button type="submit" class="btn btn-ghost btn-sm">{dt('Save')}</button>
      </form>

      <div class="cm-section">
        <div class="cm-section-head">
          <h2><Fragment set:html={dth('Booster roles in this server <span class="cm-count">{a}</span>', { a: boosterRoles.length })} /></h2>
          {boosterRoles.length > 0 && (
            <form method="POST" data-no-dirty>
              <input type="hidden" name="action" value="br_cleanup" />
              <button type="submit" class="btn btn-ghost btn-sm" data-confirm={dt('Delete the booster roles of every member who no longer boosts?')}><Icon name="ph:broom-fill" width="13" height="13" />{dt('Clean up ({a})', { a: lapsed.length })}</button>
            </form>
          )}
        </div>
        {boosterRoles.length === 0 ? (
          <div class="cm-empty"><Icon name="ph:sparkle" width="18" height="18" /><span><Fragment set:html={dth('No booster roles yet. Boosters create theirs with <code>{p}boosterrole create</code>, or give one to a member below.', { p: prefix })} /></span></div>
        ) : (
          <div class="cm-br-list dgl-stagger">
            {boosterRoles.map((row) => {
              const state = row.boosting === true ? 'on' : row.in_server === false ? 'left' : row.boosting === false ? 'off' : 'unknown';
              const label = state === 'on' ? dt('Boosting') : state === 'left' ? dt('Left the server') : state === 'off' ? dt('Not boosting') : dt('Unknown');
              const roleTitle = row.exists ? (row.name ?? roleName(row.role_id)) : dt('Deleted role');
              return (
                <article class:list={['cm-br', { gone: !row.exists }]}>
                  <div class="cm-br-main">
                    <span class="cm-br-swatch" style={`--a:${row.color ?? '#7c8a94'};--b:${row.color2 ?? row.color ?? '#7c8a94'}`}>{row.icon && <img src={row.icon} alt="" width="18" height="18" loading="lazy" />}</span>
                    <div class="cm-br-name">
                      <b style={row.color ? `color:${row.color}` : undefined}>{roleTitle}</b>
                      <code>{row.color ?? dt('No color')}{row.color2 ? ` → ${row.color2}` : ''}</code>
                    </div>
                    <UserChip id={row.user_id} person={people[row.user_id]} />
                    <span class:list={['cm-pill', state]}>{label}</span>
                    {row.shared_with.length > 0 && (
                      <span class="cm-br-shared" title={row.shared_with.map((userId) => people[userId]?.name ?? userId).join(', ')}>
                        {row.shared_with.slice(0, 4).map((userId) => <img src={people[userId]?.avatar ?? `https://cdn.discordapp.com/embed/avatars/${Number(userId.slice(-3)) % 6}.png`} alt="" width="18" height="18" loading="lazy" />)}
                        <span>{dt('+{a} shared', { a: row.shared_with.length })}</span>
                      </span>
                    )}
                  </div>
                  <div class="cm-br-actions">
                    {row.exists && (
                      <details class="cm-br-edit">
                        <summary><Icon name="ph:pencil-simple-fill" width="12" height="12" />{dt('Edit')}</summary>
                        <form method="POST" class="cm-br-form" data-no-dirty>
                          <input type="hidden" name="action" value="br_edit" />
                          <input type="hidden" name="member_id" value={row.user_id} />
                          <div class="cm-row"><label>{dt('Name')}</label><input type="text" name="name" value={roleTitle} maxlength="100" /></div>
                          <div class="cm-br-colors">
                            <ColorPicker name="hex" value={row.color ?? '#f78fb3'} label={dt('Color')} />
                            <ColorPicker name="hex2" value={row.color2 ?? ''} allowNone label={dt('Second color')} />
                          </div>
                          <div class="cm-row"><label><Fragment set:html={dth('Icon <span class="cm-label-muted">a picture link or a custom emoji; leave empty to keep it</span>')} /></label><input type="text" name="icon" value="" maxlength="500" placeholder="https://… / <:emoji:123>" /></div>
                          {row.icon && <label class="cm-check"><input type="checkbox" name="icon_remove" />{dt('Remove the icon')}</label>}
                          <button type="submit" class="btn btn-ghost btn-sm">{dt('Save role')}</button>
                        </form>
                      </details>
                    )}
                    <form method="POST" data-no-dirty>
                      <input type="hidden" name="action" value="br_remove" />
                      <input type="hidden" name="member_id" value={row.user_id} />
                      <button type="submit" class="cm-del-text" data-confirm={dt('Delete this booster role? The role is deleted in Discord.')}><Icon name="ph:trash-fill" width="12" height="12" />{dt('Delete')}</button>
                    </form>
                  </div>
                </article>
              );
            })}
          </div>
        )}
      </div>

      <div class="cm-grid">
        <form method="POST" class="cm-card" data-no-dirty>
          <input type="hidden" name="action" value="br_set" />
          <div class="cm-card-head">
            <div class="cm-card-icon" style="--c:#2dd4a7"><Icon name="ph:gift-fill" width="16" height="16" /></div>
            <div class="cm-card-title">{dt('Give a booster role')}</div>
          </div>
          <p class="cm-card-desc">{dt('Creates a role for a member, or changes the one they have. No limit or wait applies, like the staff command.')}</p>
          <div class="cm-row"><label>{dt('Member')}</label><MemberPick guildId={guildId} /></div>
          {boosterStatus.withoutRole.length > 0 && (
            <div class="cm-row">
              <label>{dt('Boosting without a role')}</label>
              <div class="cm-pick-quick">
                {boosterStatus.withoutRole.slice(0, 12).map((userId) => <button type="button" data-pick-quick={userId} data-pick-name={people[userId]?.name ?? userId}><img src={people[userId]?.avatar ?? ''} alt="" width="18" height="18" loading="lazy" />{people[userId]?.name ?? userId}</button>)}
              </div>
            </div>
          )}
          <div class="cm-row"><label>{dt('Role name')}</label><input type="text" name="name" maxlength="100" placeholder={dt('Leave empty to use their name')} /></div>
          <div class="cm-br-colors">
            <ColorPicker name="hex" value="#f78fb3" label={dt('Color')} />
            <ColorPicker name="hex2" value="#5b8def" label={dt('Second color')} />
          </div>
          <label class="cm-check"><input type="checkbox" name="gradient" />{dt('Use the second color (gradient)')}</label>
          <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:check-bold" width="12" height="12" />{dt('Create or update')}</button>
        </form>

        <form method="POST" class="cm-card" data-no-dirty>
          <input type="hidden" name="action" value="br_link" />
          <div class="cm-card-head">
            <div class="cm-card-icon" style="--c:#5b8def"><Icon name="ph:link-fill" width="16" height="16" /></div>
            <div class="cm-card-title">{dt('Link an existing role')}</div>
          </div>
          <p class="cm-card-desc">{dt('Makes a role the server already has the booster role of a member, so they can change it with the commands. The member gets the role.')}</p>
          <div class="cm-row"><label>{dt('Member')}</label><MemberPick guildId={guildId} /></div>
          <div class="cm-row">
            <label>{dt('Role')}</label>
            <select name="role_id" required>
              <option value="" disabled selected>{dt('Choose a role')}</option>
              {roleDetails.filter((r) => !r.managed).map((r) => <option value={r.id}>@{r.name}</option>)}
            </select>
          </div>
          <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:link-fill" width="12" height="12" />{dt('Link')}</button>
        </form>

        <div class="cm-card">
          <div class="cm-card-head">
            <div class="cm-card-icon" style="--c:#8b8fa3"><Icon name="ph:terminal-window-fill" width="16" height="16" /></div>
            <div class="cm-card-title">{dt('Commands for boosters')}</div>
          </div>
          <ul class="cm-cmds">
            <li><code>{prefix}boosterrole create {dt('name')} #hex</code><span>{dt('Create the role')}</span></li>
            <li><code>{prefix}boosterrole color #hex #hex2</code><span>{dt('Change the color')}</span></li>
            <li><code>{prefix}boosterrole rename {dt('name')}</code><span>{dt('Rename it')}</span></li>
            <li><code>{prefix}boosterrole icon</code><span>{dt('Set an icon (link, emoji or attached image)')}</span></li>
            <li><code>{prefix}boosterrole random</code><span>{dt('A random color')}</span></li>
            <li><code>{prefix}boosterrole share @member</code><span>{dt('Share it')}</span></li>
            <li><code>{prefix}boosterrole remove</code><span>{dt('Delete it')}</span></li>
          </ul>
        </div>
      </div>
    </div>
  )}

  {selectedSection === 'polls' && (
  <div class:list={['cm-section cm-polls', { 'cm-section-hidden': selectedSection !== 'polls' }]}>
    <div class="cm-polls-head">
      <div>
        <h2>{dt('Create a poll')}</h2>
        <p class="cm-section-sub">{dt('Publish a button-voted poll directly to a channel. Members can change their vote until you close it.')}</p>
      </div>
    </div>
    {pollError && <div class="cm-error"><Icon name="ph:warning-fill" width="15" height="15" />{pollError}</div>}
    <form method="POST" class="cm-card cm-poll-create" data-no-dirty>
      <input type="hidden" name="action" value="create_poll" />
      <div class="cm-row">
        <label>{dt('Question')}</label>
        <input type="text" name="question" maxlength="200" placeholder={dt('What should we build next?')} required />
      </div>
      <div class="cm-row">
        <label>{dt('Options')}</label>
        <textarea name="options" rows="5" maxlength="800" placeholder={dt('One option per line\nA new command\nA dashboard module')} required></textarea>
        <span class="cm-help">{dt('Use 2 to 10 options. Each option can be up to 80 characters.')}</span>
      </div>
      <div class="cm-row-pair">
        <div class="cm-row">
          <label>{dt('Channel')}</label>
          <select name="channel_id" required>
            <option value="" disabled selected>{dt('Choose a channel')}</option>
            {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
          </select>
        </div>
        <div class="cm-row">
          <label>{dt('Auto-close in minutes')}</label>
          <input type="number" name="duration_minutes" min="0" max="525600" placeholder={dt('0 = never')} />
        </div>
      </div>
      <div class="cm-row">
        <label><Fragment set:html={dth('Image URL <span class="cm-label-muted">optional</span>')} /></label>
        <input type="url" name="image" maxlength="1000" placeholder="https://..." />
      </div>
      <div class="cm-row">
        <label><Fragment set:html={dth('Design <span class="cm-label-muted">optional</span>')} /></label>
        <select name="embed_template">
          <option value="">{dt('Petto card (default)')}</option>
          {pollDesigns.map((name) => <option value={name}>{name}</option>)}
        </select>
        <span class="cm-help">{dt('Pick a saved V2 embed to design the poll with the poll variables. The vote buttons stay under it.')}</span>
      </div>
      <label class="cm-check"><input type="checkbox" name="multi" />{dt('Allow members to choose more than one option')}</label>
      <div class="cm-pv" data-poll-preview aria-live="polite">
        <div class="cm-pv-label">{dt('Preview')}</div>
        <div class="cm-pv-q" data-pv-q>{dt('What should we build next?')}</div>
        <div class="cm-pv-type" data-pv-type data-multi={dt('Multiple choice')}>{dt('Single choice')}</div>
        <div class="cm-pv-opts" data-pv-opts></div>
        <div class="cm-pv-foot">{dt('0 votes · open')}</div>
      </div>
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:paper-plane-tilt-fill" width="13" height="13" />{dt('Publish poll')}</button>
    </form>

    <div class="cm-polls-existing" data-live-url={`/dash/guild/${guildId}/live?kind=polls`}>
      <h2><Fragment set:html={dth('Recent polls <span class="cm-count">{a}</span>', { a: (polls.length) })} /></h2>
      {polls.length === 0 ? (
        <div class="cm-empty"><Icon name="ph:chart-bar" width="18" height="18" /><span>{dt('No polls have been published in this server yet.')}</span></div>
      ) : (
        <div class="cm-poll-list dgl-stagger">
          {polls.map((poll) => {
            const total = poll.voters;
            return (
              <article class:list={['cm-poll-card', { closed: poll.closed }]} data-poll-id={poll.id} data-open={poll.closed ? '' : '1'}>
                <div class="cm-poll-card-head"><div><h3>{poll.question}</h3><p>{dt('#{a} · {b} voter{c} · {d}', { a: (channels.find((c) => c.id === poll.channel_id)?.name ?? poll.channel_id), b: (total), c: (total === 1 ? '' : 's'), d: (poll.closed ? 'Closed' : 'Open') })}</p>
                  <p class="cm-poll-meta">
                    <span><Icon name="ph:users-three-fill" width="11" height="11" /> <b data-poll-voters>{total}</b></span>
                    {poll.ends_at && !poll.closed && <span><Icon name="ph:clock-fill" width="11" height="11" /> {dt('Closes')} <time datetime={poll.ends_at} data-local-time>{poll.ends_at}</time></span>}
                    {poll.multi && <span>{dt('Multiple choice')}</span>}
                    {poll.embed_template && <span>{dt('Design')}: {poll.embed_template}</span>}
                  </p></div><span class="cm-poll-status" data-poll-status data-label-live="Live" data-label-closed="Closed">{poll.closed ? 'Closed' : 'Live'}</span></div>
                <div class="cm-poll-options">
                  {poll.options.map((option, index) => {
                    const count = poll.counts[index] ?? 0;
                    const pct = total > 0 ? Math.round((count / total) * 100) : 0;
                    return <div class="cm-poll-option" data-poll-option={index}><div class="cm-poll-option-line"><span>{index + 1}. {option}</span><b data-poll-count>{count} · {pct}%</b></div><div class="cm-poll-bar"><i data-poll-bar style={`width:${pct}%`} /></div></div>;
                  })}
                </div>
                <div class="cm-poll-actions">
                  <a class="cm-link" href={`https://discord.com/channels/${guildId}/${poll.channel_id}/${poll.message_id}`} target="_blank" rel="noopener"><Icon name="ph:arrow-square-out" width="13" height="13" />{dt('Open in Discord')}</a>
                  {!poll.closed && <form method="POST"><input type="hidden" name="action" value="close_poll" /><input type="hidden" name="poll_id" value={poll.id} /><button type="submit" class="cm-del-text" data-confirm={dt('End this poll now? Nobody can vote after that.')}><Icon name="ph:stop-circle-fill" width="13" height="13" />{dt('End poll')}</button></form>}
                  <form method="POST"><input type="hidden" name="action" value="delete_poll" /><input type="hidden" name="poll_id" value={poll.id} /><button type="submit" class="cm-del-text" data-confirm={dt('Delete this poll? Its message in Discord and its votes are removed.')}><Icon name="ph:trash-fill" width="13" height="13" />{dt('Delete')}</button></form>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </div>
  )}
</DashGuildLayout>

<script is:inline>
  (function () {
    var letters = ['\u{1F1E6}','\u{1F1E7}','\u{1F1E8}','\u{1F1E9}','\u{1F1EA}','\u{1F1EB}','\u{1F1EC}','\u{1F1ED}','\u{1F1EE}','\u{1F1EF}'];
    function renderPollPreview(form) {
      var box = form.querySelector('[data-poll-preview]');
      if (!box) return;
      var q = form.querySelector('[name="question"]').value.trim();
      var lines = form.querySelector('[name="options"]').value.split(/\r?\n/).map(function (x) { return x.trim(); }).filter(Boolean).slice(0, 10);
      var multi = form.querySelector('[name="multi"]').checked;
      var qEl = box.querySelector('[data-pv-q]');
      if (qEl) { if (!qEl.getAttribute('data-sample')) qEl.setAttribute('data-sample', qEl.textContent); qEl.textContent = q || qEl.getAttribute('data-sample'); }
      var typeEl = box.querySelector('[data-pv-type]');
      if (typeEl) { if (!typeEl.getAttribute('data-single')) typeEl.setAttribute('data-single', typeEl.textContent); typeEl.textContent = multi ? typeEl.getAttribute('data-multi') || typeEl.getAttribute('data-single') : typeEl.getAttribute('data-single'); }
      var opts = box.querySelector('[data-pv-opts]');
      if (!opts) return;
      opts.textContent = '';
      lines.forEach(function (line, i) {
        var row = document.createElement('div');
        row.className = 'cm-pv-opt';
        var name = document.createElement('span');
        name.textContent = letters[i] + ' ' + line;
        var bar = document.createElement('i');
        row.appendChild(name); row.appendChild(bar);
        opts.appendChild(row);
      });
    }
    function init() {
      var f = document.querySelector('.cm-poll-create');
      if (f) renderPollPreview(f);
      document.querySelectorAll('time[data-local-time]').forEach(function (t) { var d = new Date(t.getAttribute('datetime')); if (!isNaN(d.getTime())) t.textContent = d.toLocaleString(); });
    }
    if (!window.__pollPreviewBound) {
      window.__pollPreviewBound = true;
      document.addEventListener('input', function (event) {
        var form = event.target && event.target.closest ? event.target.closest('.cm-poll-create') : null;
        if (form) renderPollPreview(form);
      });
    }
    init();

    // The votes of the open polls follow the votes as they come in, every 4 seconds while the page is in view.
    if (!window.__pollLive) {
      window.__pollLive = true;
      var pollTimer = null;
      var pollTick = function () {
        var box = document.querySelector('.cm-polls-existing[data-live-url]');
        var openCards = box ? box.querySelectorAll('.cm-poll-card[data-open="1"]') : [];
        if (!box || !openCards.length || document.hidden) { pollTimer = setTimeout(pollTick, 4000); return; }
        fetch(box.getAttribute('data-live-url'), { cache: 'no-store', headers: { Accept: 'application/json' } })
          .then(function (res) { return res.ok ? res.json() : null; })
          .then(function (data) {
            if (!data || !Array.isArray(data.polls)) return;
            data.polls.forEach(function (poll) {
              var card = box.querySelector('.cm-poll-card[data-poll-id="' + poll.id + '"]');
              if (!card) return;
              var voters = card.querySelector('[data-poll-voters]');
              if (voters) voters.textContent = String(poll.voters);
              card.querySelectorAll('[data-poll-option]').forEach(function (row) {
                var index = Number(row.getAttribute('data-poll-option'));
                var count = poll.counts[index] || 0;
                var pct = poll.voters > 0 ? Math.round((count / poll.voters) * 100) : 0;
                var label = row.querySelector('[data-poll-count]');
                if (label) label.textContent = count + ' · ' + pct + '%';
                var bar = row.querySelector('[data-poll-bar]');
                if (bar) bar.style.width = pct + '%';
              });
              if (poll.closed && card.getAttribute('data-open') === '1') {
                card.setAttribute('data-open', '');
                card.classList.add('closed');
                var status = card.querySelector('[data-poll-status]');
                if (status) status.textContent = status.getAttribute('data-label-closed') || 'Closed';
                var end = card.querySelector('form [value="close_poll"]');
                if (end && end.closest('form')) end.closest('form').hidden = true;
              }
            });
          })
          .catch(function () {})
          .then(function () { pollTimer = setTimeout(pollTick, 4000); });
      };
      document.addEventListener('visibilitychange', function () { if (!document.hidden) { clearTimeout(pollTimer); pollTimer = setTimeout(pollTick, 300); } });
      pollTimer = setTimeout(pollTick, 4000);
    }
  })();
</script>

<style>
  h1 { font-size: 24px; margin: 0 0 20px; }
  h2 { font-size: 14.5px; margin: 0 0 14px; }

  .cm-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 20px; max-width: fit-content; }

  .cm-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 16px; margin-bottom: 36px; }
  .cm-card { border: 1px solid var(--border); border-radius: 14px; padding: 16px; background: var(--card); display: flex; flex-direction: column; gap: 13px; align-items: flex-start; }
  .cm-card-head { display: flex; align-items: center; gap: 10px; width: 100%; }
  .cm-card-icon { width: 30px; height: 30px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: color-mix(in srgb, var(--c) 16%, transparent); color: var(--c); }
  .cm-card-title { flex: 1; font-size: 13.5px; font-weight: 600; color: var(--text); }
  .cm-card-desc { font-size: 12px; color: var(--text-dim); line-height: 1.5; margin: 0; }
  .cm-card-desc :global(code){ font-family: var(--mono); color: var(--accent); }

  .cm-switch { position: relative; display: inline-block; width: 34px; height: 20px; flex-shrink: 0; }
  .cm-switch input { opacity: 0; width: 0; height: 0; }
  .cm-switch :global(span){ position: absolute; inset: 0; background: var(--border); border-radius: 20px; transition: background 0.15s; cursor: pointer; }
  .cm-switch :global(span::before){ content: ''; position: absolute; width: 14px; height: 14px; left: 3px; top: 3px; background: var(--card); border-radius: 50%; transition: transform 0.15s; }
  .cm-switch input:checked + :global(span){ background: var(--accent); }
  .cm-switch input:checked + :global(span::before){ transform: translateX(14px); }
  .cm-switch input:focus-visible + :global(span){ outline: 2px solid var(--accent); outline-offset: 2px; }

  .cm-row { display: flex; flex-direction: column; gap: 5px; width: 100%; }
  .cm-row label { font-size: 11px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.03em; }
  .cm-row input, .cm-row select { width: 100%; box-sizing: border-box; border: 1px solid var(--border); border-radius: 8px; padding: 7px 9px; background: var(--bg-raise); color: var(--text); font-family: var(--sans); font-size: 13px; }
  .cm-row-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%; }

  .cm-section { margin-bottom: 30px; }
  .cm-section-sub { font-size: 12.5px; color: var(--text-dim); margin: -6px 0 18px; max-width: 68ch; line-height: 1.5; }
  .cm-section-hidden { display: none; }
  :global(.cm-count){ font-family: var(--mono); font-size: 11px; color: var(--text-dim); font-weight: 400; }
  .cm-list { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; max-width: 520px; }
