            </div>
            <div class="sx-field">
              <textarea id="cm-filter" name="filtered_words" class="dgl-autogrow sx-mono" rows="4" maxlength="6000" data-count aria-label={dt('Name filter')} placeholder={dt('One word or phrase per line')}>{booster.filteredWords.join('\n')}</textarea>
              <span class="sx-hint">{dt('A role name that contains any of these is refused. Capital letters do not matter.')}</span>
            </div>
          </section>

          <section class="sx-panel">
            <div class="sx-panel-head">
              <span class="sx-panel-icon" style="--c:#f5c945"><Icon name="ph:clock-counter-clockwise-fill" width="17" height="17" /></span>
              <h2 id="cm-unboost-h">{dt('When a member stops boosting')}</h2>
