            <input type="hidden" name="action" value="br_cleanup" />
            <button type="submit" class="btn btn-ghost btn-sm cm-btn" data-confirm={dt('Delete the booster roles of every member who no longer boosts?')}><Icon name="ph:broom-fill" width="13" height="13" />{dt('Clean up ({a})', { a: lapsed.length })}</button>
          </form>
        )}
      </div>
      {boosterRoles.length === 0 ? (
        <p class="sx-empty"><Icon name="ph:sparkle" width="20" height="20" /><span><Fragment set:html={dth('No booster roles yet. Boosters create theirs with <code>{p}boosterrole create</code>, or give one to a member below.', { p: prefix })} /></span></p>
      ) : (
        <div class="cm-br-list dgl-stagger">
          {boosterRoles.map((row) => {
            const state = row.boosting === true ? 'on' : row.in_server === false ? 'left' : row.boosting === false ? 'off' : 'unknown';
            const label = state === 'on' ? dt('Boosting') : state === 'left' ? dt('Left the server') : state === 'off' ? dt('Not boosting') : dt('Unknown');
            const roleTitle = row.exists ? (row.name ?? roleName(row.role_id)) : dt('Deleted role');
            return (
              <article class:list={['cm-br', { gone: !row.exists }]}>
                <div class="cm-br-top">
                  <span class="cm-br-swatch" style={`--a:${row.color ?? '#7c8a94'};--b:${row.color2 ?? row.color ?? '#7c8a94'}`}>{row.icon && <img src={row.icon} alt="" width="18" height="18" loading="lazy" />}</span>
                  <div class="cm-br-name">
                    <b style={row.color ? `color:${row.color}` : undefined}>{roleTitle}</b>
                    <code>{row.color ?? dt('No color')}{row.color2 ? ` → ${row.color2}` : ''}</code>
                  </div>
                  <span class:list={['cm-pill', state]}>{label}</span>
                  <form method="POST" data-no-dirty class="cm-inline">
                    <input type="hidden" name="action" value="br_remove" />
                    <input type="hidden" name="member_id" value={row.user_id} />
                    <button type="submit" class="sx-iconbtn" title={dt('Delete')} aria-label={dt('Delete')} data-confirm={dt('Delete this booster role? The role is deleted in Discord.')}><Icon name="ph:trash-fill" width="14" height="14" /></button>
                  </form>
                </div>
                <div class="cm-br-meta">
                  <UserChip id={row.user_id} person={people[row.user_id]} />
                  {row.shared_with.length > 0 && (
                    <span class="cm-br-shared" title={row.shared_with.map((userId) => people[userId]?.name ?? userId).join(', ')}>
                      {row.shared_with.slice(0, 4).map((userId) => <img src={avatarOf(userId)} alt="" width="20" height="20" loading="lazy" />)}
                      <span>{dt('+{a} shared', { a: row.shared_with.length })}</span>
                    </span>
                  )}
                  {row.created_at && <time class="cm-br-since" datetime={row.created_at} title={dt('Created')}><Icon name="ph:clock-fill" width="11" height="11" />{ago(row.created_at)}</time>}
                </div>
                {row.exists && (
                  <details class="cm-br-edit">
                    <summary><Icon name="ph:pencil-simple-fill" width="12" height="12" />{dt('Edit')}<Icon name="ph:caret-down-bold" class="cm-caret" width="12" height="12" /></summary>
                    <form method="POST" class="cm-br-form" data-no-dirty>
                      <input type="hidden" name="action" value="br_edit" />
                      <input type="hidden" name="member_id" value={row.user_id} />
                      <div class="sx-field"><label>{dt('Name')}</label><textarea name="name" class="dgl-autogrow sx-one" rows="1" data-one-line data-count maxlength="100">{roleTitle}</textarea></div>
                      <div class="cm-colors">
                        <ColorPicker name="hex" value={row.color ?? '#f78fb3'} label={dt('Color')} />
                        <ColorPicker name="hex2" value={row.color2 ?? ''} allowNone label={dt('Second color')} />
                      </div>
                      <div class="sx-field"><label><Fragment set:html={dth('Icon <span class="cm-label-muted">a picture link or a custom emoji; leave empty to keep it</span>')} /></label><textarea name="icon" class="dgl-autogrow sx-one" rows="1" data-one-line data-count maxlength="500" inputmode="url" placeholder="https://… / <:emoji:123>"></textarea></div>
                      {row.icon && <label class="sx-switch"><input type="checkbox" name="icon_remove" /><span class="sx-switch-text"><b>{dt('Remove the icon')}</b></span><i class="sx-toggle"></i></label>}
                      <div class="sx-foot"><button type="submit" class="btn btn-accent btn-sm">{dt('Save role')}</button></div>
                    </form>
                  </details>
                )}
              </article>
            );
          })}
        </div>
      )}

      <div class="sx-duo cm-duo">
        <form method="POST" class="sx-panel cm-form" data-no-dirty>
          <input type="hidden" name="action" value="br_set" />
          <div class="sx-panel-head">
            <span class="sx-panel-icon" style="--c:#2dd4a7"><Icon name="ph:gift-fill" width="17" height="17" /></span>
            <h2>{dt('Give a booster role')}</h2>
          </div>
          <p class="sx-lead cm-lead">{dt('Creates a role for a member, or changes the one they have. No limit or wait applies, like the staff command.')}</p>
          <div class="cm-body">
            <div class="sx-field"><span class="sx-label">{dt('Member')}</span><MemberPick guildId={guildId} /></div>
            {boosterStatus.withoutRole.length > 0 && (
              <div class="sx-field">
                <span class="sx-label">{dt('Boosting without a role')}</span>
                <div class="cm-quick">
                  {boosterStatus.withoutRole.slice(0, 12).map((userId) => <button type="button" data-pick-quick={userId} data-pick-name={people[userId]?.name ?? userId}><img src={avatarOf(userId)} alt="" width="20" height="20" loading="lazy" />{people[userId]?.name ?? userId}</button>)}
                </div>
              </div>
            )}
            <div class="sx-field"><label for="cm-give-name">{dt('Role name')}</label><textarea id="cm-give-name" name="name" class="dgl-autogrow sx-one" rows="1" data-one-line data-count maxlength="100" placeholder={dt('Leave empty to use their name')}></textarea></div>
            <div class="cm-colors">
              <ColorPicker name="hex" value="#f78fb3" label={dt('Color')} />
              <ColorPicker name="hex2" value="#5b8def" label={dt('Second color')} />
            </div>
            <label class="sx-switch"><input type="checkbox" name="gradient" /><span class="sx-switch-text"><b>{dt('Use the second color (gradient)')}</b></span><i class="sx-toggle"></i></label>
          </div>
          <div class="sx-foot cm-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:check-bold" width="12" height="12" />{dt('Create or update')}</button></div>
        </form>

        <form method="POST" class="sx-panel cm-form" data-no-dirty>
          <input type="hidden" name="action" value="br_link" />
          <div class="sx-panel-head">
            <span class="sx-panel-icon" style="--c:#5b8def"><Icon name="ph:link-fill" width="17" height="17" /></span>
            <h2>{dt('Link an existing role')}</h2>
          </div>
          <p class="sx-lead cm-lead">{dt('Makes a role the server already has the booster role of a member, so they can change it with the commands. The member gets the role.')}</p>
          <div class="cm-body">
            <div class="sx-field"><span class="sx-label">{dt('Member')}</span><MemberPick guildId={guildId} /></div>
            {boosterStatus.withoutRole.length > 0 && (
              <div class="sx-field">
                <span class="sx-label">{dt('Boosting without a role')}</span>
                <div class="cm-quick">
                  {boosterStatus.withoutRole.slice(0, 12).map((userId) => <button type="button" data-pick-quick={userId} data-pick-name={people[userId]?.name ?? userId}><img src={avatarOf(userId)} alt="" width="20" height="20" loading="lazy" />{people[userId]?.name ?? userId}</button>)}
                </div>
              </div>
            )}
            <div class="sx-field">
              <label for="cm-link-role">{dt('Role')}</label>
              <select id="cm-link-role" name="role_id" required>
                <option value="" disabled selected>{dt('Choose a role')}</option>
                {roleDetails.filter((r) => !r.managed).map((r) => <option value={r.id}>@{r.name}</option>)}
              </select>
              <span class="sx-hint">{dt('Roles made by a bot or an integration are not listed.')}</span>
            </div>
          </div>
          <div class="sx-foot cm-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:link-fill" width="12" height="12" />{dt('Link')}</button></div>
        </form>
      </div>

      <section class="sx-panel">
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style="--c:#8b8fa3"><Icon name="ph:terminal-window-fill" width="17" height="17" /></span>
          <h2>{dt('Commands for boosters')}</h2>
        </div>
        <ul class="cm-cmds">
          <li><code>{prefix}boosterrole create {dt('name')} #hex</code><span>{dt('Create the role')}</span></li>
          <li><code>{prefix}boosterrole color #hex #hex2</code><span>{dt('Change the color')}</span></li>
          <li><code>{prefix}boosterrole rename {dt('name')}</code><span>{dt('Rename it')}</span></li>
          <li><code>{prefix}boosterrole icon</code><span>{dt('Set an icon (link, emoji or attached image)')}</span></li>
          <li><code>{prefix}boosterrole random</code><span>{dt('A random color')}</span></li>
          <li><code>{prefix}boosterrole share @member</code><span>{dt('Share it')}</span></li>
          <li><code>{prefix}boosterrole remove</code><span>{dt('Delete it')}</span></li>
        </ul>
      </section>
    </div>
  )}

  {selectedSection === 'polls' && (
  <div class="sx-page cm-page">
    <DashStatTiles tiles={[
      { label: dt('Recent polls'), value: polls.length, tone: 'invites' },
      { label: dt('Open polls'), value: pollsOpen, tone: 'joins' },
      { label: dt('Closed polls'), value: polls.length - pollsOpen, tone: 'leaves' },
      { label: dt('Votes cast'), value: pollVotes, tone: 'reactions' },
    ]} />

    {pollError && <div class="sx-flash sx-flash-bad" role="alert"><Icon name="ph:warning-fill" width="15" height="15" />{pollError}</div>}
    <form method="POST" class="cm-create cm-poll-create" data-no-dirty>
      <input type="hidden" name="action" value="create_poll" />
      <section class="sx-panel cm-form">
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style="--c:#6fb4ea"><Icon name="ph:chart-bar-fill" width="17" height="17" /></span>
          <h2>{dt('Create a poll')}</h2>
        </div>
        <p class="sx-lead cm-lead">{dt('Publish a button-voted poll directly to a channel. Members can change their vote until you close it.')}</p>
        <div class="cm-body">
          <div class="sx-field"><label for="cm-poll-q">{dt('Question')}</label><textarea id="cm-poll-q" name="question" class="dgl-autogrow sx-one" rows="1" data-one-line data-count maxlength="200" placeholder={dt('What should we build next?')} required></textarea></div>
          <div class="sx-field">
            <label for="cm-poll-opts">{dt('Options')}</label>
            <textarea id="cm-poll-opts" name="options" class="dgl-autogrow" rows="4" maxlength="800" data-count placeholder={dt('One option per line\nA new command\nA dashboard module')} required></textarea>
            <span class="sx-hint">{dt('Use 2 to 10 options. Each option can be up to 80 characters.')}</span>
          </div>
          <div class="sx-grid">
            <div class="sx-field">
              <label for="cm-poll-channel">{dt('Channel')}</label>
              <select id="cm-poll-channel" name="channel_id" required>
                <option value="" disabled selected>{dt('Choose a channel')}</option>
                {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
              </select>
            </div>
            <div class="sx-field"><label for="cm-poll-close">{dt('Auto-close in minutes')}</label><SxNumber id="cm-poll-close" name="duration_minutes" value="" min="0" max="525600" placeholder={dt('0 = never')} /></div>
            <div class="sx-field"><label for="cm-poll-image"><Fragment set:html={dth('Image URL <span class="cm-label-muted">optional</span>')} /></label><textarea id="cm-poll-image" name="image" class="dgl-autogrow sx-one" rows="1" data-one-line data-count maxlength="1000" inputmode="url" placeholder="https://..."></textarea></div>
            <div class="sx-field">
              <label for="cm-poll-design"><Fragment set:html={dth('Design <span class="cm-label-muted">optional</span>')} /></label>
              <select id="cm-poll-design" name="embed_template">
                <option value="">{dt('Petto card (default)')}</option>
                {pollDesigns.map((name) => <option value={name}>{name}</option>)}
              </select>
            </div>
          </div>
          <span class="sx-hint cm-design-hint">{dt('Pick a saved V2 embed to design the poll with the poll variables. The vote buttons stay under it.')}</span>
          <label class="sx-switch"><input type="checkbox" name="multi" /><span class="sx-switch-text"><b>{dt('Allow members to choose more than one option')}</b></span><i class="sx-toggle"></i></label>
        </div>
        <div class="sx-foot cm-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:paper-plane-tilt-fill" width="13" height="13" />{dt('Publish poll')}</button></div>
      </section>

      <div class="cm-create-side">
        <aside class="sx-panel cm-pv-panel" aria-label={dt('Preview')}>
          <div class="sx-panel-head">
            <span class="sx-panel-icon" style="--c:#f0a88f"><Icon name="ph:eye-fill" width="17" height="17" /></span>
            <h2>{dt('Preview')}</h2>
          </div>
          <p class="sx-lead cm-lead">{dt('The poll as Petto posts it. It changes while you write.')}</p>
          <div class="cm-pv" data-poll-preview aria-live="polite" data-sample-opts={JSON.stringify([dt('A new command'), dt('A dashboard module')])}>
            <div class="cm-pv-q" data-pv-q>{dt('What should we build next?')}</div>
            <div class="cm-pv-type" data-pv-type data-multi={dt('Multiple choice')}>{dt('Single choice')}</div>
            <div class="cm-pv-opts" data-pv-opts></div>
            <div class="cm-pv-foot">{dt('0 votes · open')}</div>
          </div>
        </aside>

        <section class="sx-panel cm-running">
          <div class="sx-panel-head">
            <span class="sx-panel-icon" style="--c:#86b894"><Icon name="ph:timer-fill" width="17" height="17" /></span>
            <h2>{dt('Running now')}</h2>
          </div>
          {pollsOpen === 0 ? (
            <p class="sx-empty"><Icon name="ph:chart-bar" width="20" height="20" />{dt('No poll is running right now.')}</p>
          ) : (
            <ul class="cm-run">
              {polls.filter((poll) => !poll.closed).slice(0, 4).map((poll) => (
                <li data-run={poll.id}>
                  <b>{poll.question}</b>
                  <small>#{channelName(poll.channel_id)} · <span data-run-voters>{poll.voters}</span> {dt('Voters')} · {poll.ends_at ? dt('Closes in {a}', { a: until(poll.ends_at) }) : dt('No end')}</small>
                </li>
              ))}
            </ul>
          )}
        </section>
      </div>
    </form>

    <div class="cm-polls-existing" data-live-url={`/dash/guild/${guildId}/live?kind=polls`}>
      <div class="cm-sec-head">
        <h2>{dt('Recent polls')} <span class="cm-count">{num(polls.length)}</span></h2>
        {pollsOpen > 0 && <p class="sx-hint cm-live-hint"><i class="cm-live-dot"></i>{dt('The votes of open polls update by themselves.')}</p>}
      </div>
      {polls.length === 0 ? (
        <p class="sx-empty"><Icon name="ph:chart-bar" width="20" height="20" />{dt('No polls have been published in this server yet.')}</p>
      ) : (
        <div class="cm-poll-list dgl-stagger">
          {polls.map((poll) => {
            const total = poll.voters;
            const best = poll.closed ? Math.max(0, ...poll.counts) : 0;
            return (
              <article class:list={['cm-poll', { closed: poll.closed }]} data-poll-id={poll.id} data-open={poll.closed ? '' : '1'}>
                <div class="cm-poll-head">
                  <div class="cm-poll-title">
                    <h3>{poll.question}</h3>
                    <p>#{channelName(poll.channel_id)} · {ago(poll.created_at)}</p>
                  </div>
                  <span class="cm-poll-status" data-poll-status data-label-live={dt('Live')} data-label-closed={dt('Closed')}>{poll.closed ? dt('Closed') : dt('Live')}</span>
                </div>
                <p class="cm-poll-meta">
                  <span><Icon name="ph:users-three-fill" width="12" height="12" /><b data-poll-voters>{total}</b> {dt('Voters')}</span>
                  {poll.ends_at && !poll.closed && <span><Icon name="ph:clock-fill" width="12" height="12" />{dt('Closes in {a}', { a: until(poll.ends_at) })}</span>}
                  {poll.multi && <span><Icon name="ph:check-circle-fill" width="12" height="12" />{dt('Multiple choice')}</span>}
                  {poll.image && <span><Icon name="ph:image-fill" width="12" height="12" />{dt('Image')}</span>}
                  {poll.embed_template && <span><Icon name="ph:palette-fill" width="12" height="12" />{poll.embed_template}</span>}
                </p>
                <div class="cm-poll-options">
                  {poll.options.map((option, index) => {
                    const count = poll.counts[index] ?? 0;
                    const pct = total > 0 ? Math.round((count / total) * 100) : 0;
                    return (
                      <div class:list={['cm-opt', { win: poll.closed && best > 0 && count === best }]} data-poll-option={index}>
                        <div class="cm-opt-line"><span class="cm-opt-n">{index + 1}</span><span class="cm-opt-text">{option}</span><b data-poll-count>{count} · {pct}%</b></div>
                        <div class="cm-meter"><i data-poll-bar style={`width:${pct}%`}></i></div>
                      </div>
                    );
                  })}
                </div>
                <div class="cm-poll-actions">
                  <a class="cm-act" href={`https://discord.com/channels/${guildId}/${poll.channel_id}/${poll.message_id}`} target="_blank" rel="noopener"><Icon name="ph:arrow-square-out" width="13" height="13" />{dt('Open in Discord')}</a>
                  <span class="cm-poll-spacer"></span>
                  {!poll.closed && <form method="POST" data-no-dirty class="cm-inline"><input type="hidden" name="action" value="close_poll" /><input type="hidden" name="poll_id" value={poll.id} /><button type="submit" class="cm-danger" data-confirm={dt('End this poll now? Nobody can vote after that.')}><Icon name="ph:stop-circle-fill" width="13" height="13" />{dt('End poll')}</button></form>}
                  <form method="POST" data-no-dirty class="cm-inline"><input type="hidden" name="action" value="delete_poll" /><input type="hidden" name="poll_id" value={poll.id} /><button type="submit" class="cm-danger" data-confirm={dt('Delete this poll? Its message in Discord and its votes are removed.')}><Icon name="ph:trash-fill" width="13" height="13" />{dt('Delete')}</button></form>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </div>
  )}

  <script is:inline>
    (function () {
      var letters = ['\u{1F1E6}','\u{1F1E7}','\u{1F1E8}','\u{1F1E9}','\u{1F1EA}','\u{1F1EB}','\u{1F1EC}','\u{1F1ED}','\u{1F1EE}','\u{1F1EF}'];
      function renderPollPreview(form) {
        var box = form.querySelector('[data-poll-preview]');
        if (!box) return;
        var q = form.querySelector('[name="question"]').value.trim();
        var lines = form.querySelector('[name="options"]').value.split(/\r?\n/).map(function (x) { return x.trim(); }).filter(Boolean).slice(0, 10);
        var multi = form.querySelector('[name="multi"]').checked;
        var qEl = box.querySelector('[data-pv-q]');
        if (qEl) { if (!qEl.getAttribute('data-sample')) qEl.setAttribute('data-sample', qEl.textContent); qEl.textContent = q || qEl.getAttribute('data-sample'); }
        var typeEl = box.querySelector('[data-pv-type]');
        if (typeEl) { if (!typeEl.getAttribute('data-single')) typeEl.setAttribute('data-single', typeEl.textContent); typeEl.textContent = multi ? typeEl.getAttribute('data-multi') || typeEl.getAttribute('data-single') : typeEl.getAttribute('data-single'); }
        var opts = box.querySelector('[data-pv-opts]');
        if (!opts) return;
        // Nothing written yet: two sample options show how the poll will look.
        var sample = false;
        if (!lines.length) { try { lines = JSON.parse(box.getAttribute('data-sample-opts') || '[]'); sample = true; } catch (e) { lines = []; } }
        opts.classList.toggle('is-sample', sample);
        opts.textContent = '';
        lines.forEach(function (line, i) {
          var row = document.createElement('div');
          row.className = 'cm-pv-opt';
          var name = document.createElement('span');
          name.textContent = letters[i] + ' ' + line;
          var bar = document.createElement('i');
          row.appendChild(name); row.appendChild(bar);
          opts.appendChild(row);
        });
      }
      function init() {
        var f = document.querySelector('.cm-poll-create');
        if (f) renderPollPreview(f);
      }
      if (!window.__pollPreviewBound) {
        window.__pollPreviewBound = true;
        document.addEventListener('input', function (event) {
          var form = event.target && event.target.closest ? event.target.closest('.cm-poll-create') : null;
          if (form) renderPollPreview(form);
        });
        document.addEventListener('change', function (event) {
          var form = event.target && event.target.closest ? event.target.closest('.cm-poll-create') : null;
          if (form) renderPollPreview(form);
        });
      }
      init();

      // The votes of the open polls follow the votes as they come in, every 4 seconds while the page is in view.
      if (!window.__pollLive) {
        window.__pollLive = true;
        var pollTimer = null;
        var pollTick = function () {
          var box = document.querySelector('.cm-polls-existing[data-live-url]');
          var openPolls = box ? box.querySelectorAll('.cm-poll[data-open="1"]') : [];
          if (!box || !openPolls.length || document.hidden) { pollTimer = setTimeout(pollTick, 4000); return; }
          fetch(box.getAttribute('data-live-url'), { cache: 'no-store', headers: { Accept: 'application/json' } })
            .then(function (res) { return res.ok ? res.json() : null; })
            .then(function (data) {
              if (!data || !Array.isArray(data.polls)) return;
              data.polls.forEach(function (poll) {
                var card = box.querySelector('.cm-poll[data-poll-id="' + poll.id + '"]');
                if (!card) return;
                var voters = card.querySelector('[data-poll-voters]');
                if (voters) voters.textContent = String(poll.voters);
                var run = document.querySelector('.cm-run [data-run="' + poll.id + '"]');
                if (run) {
                  if (poll.closed) run.remove();
                  else { var runVoters = run.querySelector('[data-run-voters]'); if (runVoters) runVoters.textContent = String(poll.voters); }
                }
                card.querySelectorAll('[data-poll-option]').forEach(function (row) {
                  var index = Number(row.getAttribute('data-poll-option'));
                  var count = poll.counts[index] || 0;
                  var pct = poll.voters > 0 ? Math.round((count / poll.voters) * 100) : 0;
                  var label = row.querySelector('[data-poll-count]');
                  if (label) label.textContent = count + ' · ' + pct + '%';
                  var bar = row.querySelector('[data-poll-bar]');
                  if (bar) bar.style.width = pct + '%';
                });
                if (poll.closed && card.getAttribute('data-open') === '1') {
                  card.setAttribute('data-open', '');
                  card.classList.add('closed');
                  var status = card.querySelector('[data-poll-status]');
                  if (status) status.textContent = status.getAttribute('data-label-closed') || 'Closed';
                  var end = card.querySelector('form [value="close_poll"]');
                  if (end && end.closest('form')) end.closest('form').hidden = true;
                }
              });
            })
            .catch(function () {})
            .then(function () { pollTimer = setTimeout(pollTick, 4000); });
        };
        document.addEventListener('visibilitychange', function () { if (!document.hidden) { clearTimeout(pollTimer); pollTimer = setTimeout(pollTick, 300); } });
        pollTimer = setTimeout(pollTick, 4000);
      }
    })();
  </script>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 18px; }
  h2 { margin: 0; }

  .cm-page { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .cm-page > :global(.stt) { margin-bottom: 0; }
  /* Two columns that follow the window (the panel is narrower than the window by the menu). */
  .cm-duo { align-items: start; }
  @media (max-width: 1000px) { .cm-duo { grid-template-columns: minmax(0, 1fr); } }
  .cm-form { min-width: 0; }
  .cm-lead { margin-top: -4px; }
  .cm-lead :global(code), .cm-note :global(code), .cm-link-text :global(code), .cm-empty :global(code), .sx-empty :global(code), .sx-hint :global(code) { font-family: var(--mono); color: var(--accent); }
  :global(.cm-label-muted) { font-size: 12px; color: var(--text-dim); font-weight: 400; }
  .cm-body { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .cm-foot { padding-top: 2px; }
  .cm-note { display: flex; gap: 9px; align-items: flex-start; margin: 0; padding: 11px 13px; border-radius: 11px; background: color-mix(in srgb, var(--text) 4%, var(--card)); font-size: 12.5px; line-height: 1.5; color: var(--text-dim); }
  .cm-note :global(svg) { flex: none; margin-top: 2px; color: var(--text-dim); }
  .cm-inline { margin: 0; flex: none; }
  .cm-count { font-family: var(--mono); font-size: 11.5px; font-weight: 500; color: var(--text-dim); background: color-mix(in srgb, var(--text) 7%, transparent); border-radius: 999px; padding: 2px 9px; margin-left: 4px; vertical-align: 2px; }
  .cm-sec-head { display: flex; align-items: center; justify-content: space-between; gap: 6px 14px; flex-wrap: wrap; margin: 14px 0 -2px; }
  .cm-sec-head h2 { font-size: 16px; }
  .cm-btn { display: inline-flex; align-items: center; gap: 6px; }
  .cm-danger { display: inline-flex; align-items: center; gap: 6px; border: 0; border-radius: 8px; padding: 5px 9px; background: transparent; color: var(--red); font: 600 12.5px var(--sans); cursor: pointer; transition: background-color .25s ease; }
  .cm-danger:hover { background: var(--red-soft); }
  .cm-act { display: inline-flex; align-items: center; gap: 6px; border-radius: 8px; padding: 5px 9px; color: var(--accent); font: 600 12.5px var(--sans); text-decoration: none; transition: background-color .25s ease; }
  .cm-act:hover { background: var(--accent-soft); }
  .cm-act:active, .cm-danger:active { transform: none; filter: none; }

  .cm-pill { flex: none; border-radius: 999px; padding: 3px 10px; font: 600 11.5px var(--sans); color: var(--text-dim); background: color-mix(in srgb, var(--text) 7%, transparent); white-space: nowrap; }
  .cm-pill.on { color: var(--green); background: var(--green-soft); }
  .cm-pill.off, .cm-pill.left { color: var(--red); background: var(--red-soft); }

  /* Community Settings: the way into the other parts, and the latest events. */
  .cm-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; align-items: start; }
  .cm-link { display: flex; align-items: flex-start; gap: 13px; text-decoration: none; color: inherit; border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 15px 16px; min-width: 0; transition: background-color .3s ease, border-color .3s ease; }
  .cm-link:hover { background: var(--card-hover); border-color: color-mix(in srgb, var(--accent) 35%, var(--border)); }
  .cm-link:active { transform: none; filter: none; background: color-mix(in srgb, var(--text) 10%, transparent); }
  .cm-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cm-link-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .cm-link-title { display: flex; align-items: center; gap: 9px; }
  .cm-link-title b { font-size: 14.5px; }
  .cm-link-text em { font-style: normal; font-size: 12.5px; line-height: 1.5; color: var(--text-dim); }
  .cm-link-text small { font-size: 12px; font-weight: 600; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .cm-link :global(.cm-link-go) { flex: none; margin-top: 9px; color: var(--text-dim); transition: transform .35s cubic-bezier(.22, 1, .36, 1), color .25s ease; }
  .cm-link:hover :global(.cm-link-go) { color: var(--accent); transform: translateX(3px); }
  .cm-feed { min-width: 0; }
  .cm-events { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(var(--rows, 1), auto); grid-auto-flow: column; gap: 6px 14px; }
  .cm-event { display: grid; grid-template-columns: 32px minmax(0, 1fr) auto; align-items: center; gap: 11px; padding: 8px 12px 8px 10px; border: 1px solid var(--border-soft); border-radius: 12px; background: color-mix(in srgb, var(--text) 3%, var(--card)); }
  .cm-event-icon { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 10px; color: var(--c); background: color-mix(in srgb, var(--c) 15%, transparent); }
  .cm-event-text { display: flex; flex-direction: column; gap: 1px; min-width: 0; font-size: 13.5px; line-height: 1.4; overflow-wrap: anywhere; }
  .cm-event-text b { font-weight: 600; }
  .cm-event-text small { font-size: 11.5px; color: var(--text-dim); }
  .cm-event-when { font-size: 12px; color: var(--text-dim); white-space: nowrap; font-variant-numeric: tabular-nums; }

  /* Reputation */
  .cm-lb-panel { min-width: 0; }
  .cm-lb-panel .sx-panel-head h2 { white-space: nowrap; }
  .cm-lb { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(var(--rows, 1), auto); grid-auto-flow: column; gap: 6px 14px; }
  .cm-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 28px; align-items: start; min-width: 0; }
  .cm-h3 { margin: 0; font-size: 13.5px; color: var(--text-muted); font-weight: 600; }
  .cm-lb-row { display: grid; grid-template-columns: 28px minmax(0, 1fr) minmax(76px, 104px) 32px; align-items: center; gap: 10px; border: 1px solid var(--border-soft); border-radius: 12px; padding: 6px 6px 6px 9px; background: color-mix(in srgb, var(--text) 3%, var(--card)); transition: background-color .3s ease, border-color .3s ease; }
  .cm-lb-row:hover { border-color: var(--border); background: var(--card-hover); }
  .cm-rank { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; font: 700 12px var(--mono); color: var(--text-dim); background: color-mix(in srgb, var(--text) 7%, transparent); }
  .cm-rank.top-1 { color: #1a1300; background: #e6c56f; }
  .cm-rank.top-2 { color: #14181d; background: #c3ccd8; }
  .cm-rank.top-3 { color: #1d1108; background: #d39a6a; }
  .cm-lb-row :global(.uc) { min-width: 0; }
  .cm-lb-points { display: flex; flex-direction: column; align-items: flex-end; gap: 5px; }
  .cm-lb-points b { font: 600 12.5px var(--mono); color: var(--accent); font-variant-numeric: tabular-nums; }
  .cm-meter { width: 100%; height: 4px; border-radius: 999px; background: color-mix(in srgb, var(--text) 9%, transparent); overflow: hidden; }
  .cm-meter i { display: block; height: 100%; border-radius: inherit; background: var(--accent); transform-origin: left; animation: cm-grow .8s var(--m-out) backwards; }
  @keyframes cm-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .cm-reward { align-items: center; }
  .cm-pts-badge { flex: none; font: 700 12px var(--mono); color: var(--accent); background: var(--accent-soft); border-radius: 999px; padding: 3px 10px; font-variant-numeric: tabular-nums; }
  .cm-reward :global(.cm-arrow), .cm-log :global(.cm-arrow) { flex: none; color: var(--text-dim); }
  .cm-role { flex: 1; min-width: 0; display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cm-dot { flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--c); }
  .cm-add { margin-top: 2px; }
  .cm-add-row { display: grid; grid-template-columns: minmax(130px, 170px) minmax(0, 1fr); gap: 12px; align-items: end; }
  .cm-add .btn { display: inline-flex; align-items: center; gap: 6px; }
  .cm-log { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 14px; }
  .cm-log-row { display: flex; align-items: center; gap: 9px; border: 1px solid var(--border-soft); border-radius: 12px; padding: 7px 12px; background: color-mix(in srgb, var(--text) 3%, var(--card)); min-width: 0; }
  .cm-log-row :global(.uc) { flex: 1 1 0; min-width: 0; }
  .cm-log-row :global(.uc-text code) { display: none; }
  .cm-log-meta { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 1px; font-size: 11.5px; line-height: 1.3; color: var(--text-dim); white-space: nowrap; max-width: 42%; }
  .cm-log-meta span { overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  .cm-cmds { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 14px; }
  .cm-cmds li { display: flex; flex-direction: column; align-items: flex-start; gap: 5px; min-width: 0; padding: 10px 12px; border: 1px solid var(--border-soft); border-radius: 12px; background: color-mix(in srgb, var(--text) 3%, var(--card)); }
  .cm-cmds code { font-family: var(--mono); font-size: 12.5px; color: var(--accent); overflow-wrap: anywhere; }
  .cm-cmds span { font-size: 12.5px; color: var(--text-dim); }

  /* Booster roles */
  .cm-settings { margin: 0; }
  .cm-choices { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; }
  .cm-choices :global(.sx-choice-body) { display: grid; grid-template-columns: 22px minmax(0, 1fr); column-gap: 10px; row-gap: 2px; align-items: start; padding: 11px 13px; }
  .cm-choices :global(.sx-choice-body > svg) { grid-row: 1 / span 2; margin-top: 2px; }
  .cm-br-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; align-items: start; }
  @media (max-width: 1000px) { .cm-br-list, .cm-poll-list, .cm-cols, .cm-links, .cm-events, .cm-lb { grid-template-columns: minmax(0, 1fr); } .cm-events, .cm-lb { grid-template-rows: none; grid-auto-flow: row; } .cm-lb { max-height: 520px; overflow-y: auto; scrollbar-width: thin; } }
  .cm-br { display: flex; flex-direction: column; gap: 11px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 14px 14px 12px 16px; min-width: 0; transition: border-color .3s ease; }
  .cm-br:hover { border-color: color-mix(in srgb, var(--accent) 28%, var(--border)); }
  .cm-br.gone { opacity: .72; }
  .cm-br-top { display: flex; align-items: center; gap: 11px; min-width: 0; }
  .cm-br-swatch { flex: none; width: 36px; height: 36px; border-radius: 11px; background: linear-gradient(135deg, var(--a), var(--b)); display: grid; place-items: center; }
  .cm-br-swatch img { border-radius: 4px; }
  .cm-br-name { flex: 1; display: flex; flex-direction: column; min-width: 0; gap: 1px; }
  .cm-br-name b { font-size: 14.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .cm-br-name code { font-family: var(--mono); font-size: 11px; color: var(--text-dim); }
  .cm-br-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 16px; min-width: 0; }
  .cm-br-meta :global(.uc) { flex: 1 1 150px; }
  .cm-br-shared { display: inline-flex; align-items: center; gap: 2px; font-size: 12px; color: var(--text-dim); }
  .cm-br-shared img { border-radius: 50%; border: 2px solid var(--card); margin-left: -6px; }
  .cm-br-shared img:first-child { margin-left: 0; }
  .cm-br-shared span { margin-left: 7px; }
  .cm-br-since { margin-left: auto; display: inline-flex; align-items: center; gap: 5px; font-size: 12px; color: var(--text-dim); white-space: nowrap; }
  .cm-br-edit { interpolate-size: allow-keywords; border-top: 1px solid var(--border-soft); margin: 0 -4px 0 -2px; padding-top: 8px; }
  .cm-br-edit > summary { list-style: none; display: flex; align-items: center; gap: 7px; padding: 4px 6px; border-radius: 8px; font: 600 12.5px var(--sans); color: var(--accent); cursor: pointer; transition: background-color .25s ease; }
  .cm-br-edit > summary::-webkit-details-marker { display: none; }
  .cm-br-edit > summary:hover { background: var(--accent-soft); }
  .cm-br-edit > summary:active { transform: none; filter: none; }
