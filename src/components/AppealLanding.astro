---
import { Icon } from 'astro-icon/components';
import AppealLayout from './AppealLayout.astro';
import { appealText, type AppealLang } from '../i18n/appeal';
import { linkPreview, safeUrl, pictureUrl, timeAgo, type AppealConfig, type AppealForm, type PunishmentView } from '../utils/appeals';

interface Props {
  lang: AppealLang; guild: { id: string; name: string; icon: string | null; members?: number | null }; config: AppealConfig;
  state: 'closed' | 'login' | 'ready' | 'unavailable';
  loginHref: string; user?: { name: string; avatar: string | null } | null;
  punishments?: PunishmentView[]; blockedUntil?: string | null; blocked?: boolean;
  forms?: AppealForm[]; mine?: { id: string; form_name: string; status: string; created_at: string }[];
}
const { lang, guild, config, state, loginHref, user = null, punishments = [], blocked = false, blockedUntil = null, forms = [], mine = [] } = Astro.props;
const t = appealText(lang);
const preview = linkPreview(config, guild, lang, { path: (guild as any).path ?? guild.id, origin: Astro.url.origin });
const icon = pictureUrl(config.brand?.icon_url, 'icon', { path: (guild as any).path ?? guild.id, origin: Astro.url.origin }) ?? guild.icon;
const when = (iso: string | null | undefined) => (iso ? new Date(iso).toLocaleString(lang === 'pt-BR' ? 'pt-BR' : lang, { dateStyle: 'medium', timeStyle: 'short' }) : '');
const typeList = (types: string[]) => types.map((x) => t(`type_${x}` as any)).join(' / ');
const have = new Set(punishments.map((p) => p.type));
const meets = (form: AppealForm) => !form.requirement_types.length || form.requirement_types.some((x) => have.has(x));
const greeting = (config.greeting || '').trim() || t('defaultGreeting');
---
<AppealLayout lang={lang} config={config} guild={guild} preview={preview}>
  <div class="ap-server">
    {icon && <img src={icon} alt="" width="62" height="62" />}
    <div>
      <h1>{state === 'closed' ? t('closedTitle') : t('appealTo', { server: config.brand?.name || guild.name })}</h1>
      {config.brand?.tagline && <p class="ap-muted">{config.brand.tagline}</p>}
    </div>
  </div>

  {state === 'closed' && <div class="ap-card soft"><p>{t('closedBody')}</p></div>}
  {state === 'unavailable' && <div class="ap-card bad"><p>{t('serverUnavailable')}</p></div>}

  {state === 'login' && (
    <div class="ap-card soft">
      <p style="white-space:pre-wrap">{greeting}</p>
      <div class="ap-row"><a class="ap-btn" href={loginHref}>{t('signIn')}</a><span class="ap-muted">{t('signInHint')}</span></div>
    </div>
  )}

  {state === 'ready' && (
    <>
      <p style="white-space:pre-wrap">{greeting}</p>
      {user && <div class="ap-row"><span class="ap-muted">{t('signedInAs', { name: user.name })}</span><a class="ap-btn ghost" href={`${loginHref.replace(/login.*$/, '')}logout`}>{t('signOut')}</a></div>}

      {blocked && (
        <div class="ap-card bad">
          <h3>{t('blockedTitle')}</h3>
          <p>{blockedUntil ? t('blockedUntil', { when: timeAgo(blockedUntil, lang) || when(blockedUntil) }) : t('blockedForever')}</p>
        </div>
      )}

      <section class="ap-list">
        <h2>{t('yourPunishments')}</h2>
        {punishments.length === 0 && <div class="ap-card soft"><p>{t('noPunishments')}</p><p class="ap-muted">{t('noPunishmentsHint')}</p></div>}
        {punishments.map((p) => (
          <div class="ap-card">
            <div class="ap-row"><h3>{t(`type_${p.type}` as any)}</h3><span class="ap-chip">{t(`source_${p.source}` as any)}</span></div>
            {p.reason && <p>{p.reason}</p>}
            {'until' in p && <p class="ap-muted">{p.until ? `${t('until')}: ${when(p.until)}` : t('forever')}</p>}
            {p.moderator && <p class="ap-muted">{t('moderator')}: {p.moderator}</p>}
          </div>
        ))}
      </section>

      <section class="ap-list">
        <h2>{t('forms')}</h2>
        {forms.length === 0 && <div class="ap-card soft"><p>{t('noForms')}</p></div>}
        {forms.map((form) => {
          const ok = meets(form) && !blocked;
          return (
            <div class:list={['ap-card', { soft: !ok }]}>
              <div class="ap-row"><h3>{form.icon && <Icon name={`ph:${form.icon}-fill`} width="18" height="18" class="ap-ico" />}{form.name}</h3>{!ok && <span class="ap-chip">{t('locked')}</span>}</div>
              {form.short_description && <p class="ap-muted">{form.short_description}</p>}
              {!meets(form) && <p class="ap-muted">{t('needs', { types: typeList(form.requirement_types) })}</p>}
              <div><a class:list={['ap-btn', { off: !ok }]} href={ok ? `/appeal/${(guild as any).path ?? guild.id}/form/${form.id}` : undefined} aria-disabled={!ok}>{t('openForm')}</a></div>
            </div>
          );
        })}
      </section>

      <section class="ap-list">
        <h2>{t('yourAppeals')}</h2>
        {mine.length === 0 && <p class="ap-muted">{t('noAppeals')}</p>}
        {mine.map((s) => (
          <a class="ap-card" href={`/appeal/${(guild as any).path ?? guild.id}/status/${s.id}`} style="text-decoration:none">
            <div class="ap-row"><h3>{s.form_name}</h3><span class:list={['ap-chip', s.status]}>{t(`status_${s.status}` as any)}</span></div>
            <p class="ap-muted">{t('sent', { when: timeAgo(s.created_at, lang) })}</p>
          </a>
        ))}
      </section>
    </>
  )}
</AppealLayout>
