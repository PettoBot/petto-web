---
// A box under a text field that shows the text the way Discord draws it, as the person types.
// The field gets data-lm-source="<id>" and this box gets the same id.
interface Props { id: string; label?: string; text?: string }
const { id, label, text = '' } = Astro.props;
import { renderMarkdown } from '../utils/discordPreview';
---
<div class="lm-box" data-lm-preview={id} hidden={!text.trim()}>
  {label && <span class="lm-label">{label}</span>}
  <div class="lm-body" set:html={renderMarkdown(text)} />
</div>
<script>
  import { renderMarkdown } from '../utils/discordPreview';
  const w = window as unknown as { __lmBound?: boolean };
  if (!w.__lmBound) {
    w.__lmBound = true;
    document.addEventListener('input', (event) => {
      const field = event.target as HTMLInputElement | HTMLTextAreaElement | null;
      const id = field?.getAttribute?.('data-lm-source');
      if (!field || !id) return;
      const box = document.querySelector<HTMLElement>(`[data-lm-preview="${id}"]`);
      const body = box?.querySelector<HTMLElement>('.lm-body');
      if (!box || !body) return;
      box.hidden = !field.value.trim();
      body.innerHTML = renderMarkdown(field.value);
    });
  }
</script>
<style is:global>
  .lm-box { margin-top: 8px; background: #2b2d31; color: #dbdee1; border-radius: 9px; padding: 9px 12px; font-size: 14px; line-height: 1.4; word-break: break-word; }
  .lm-box[hidden] { display: none; }
  .lm-label { display: block; font-family: var(--mono); font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: #949ba4; margin-bottom: 4px; }
  .lm-box .dp-mention { color: #c9cdfb; background: rgba(88, 101, 242, .3); border-radius: 3px; padding: 0 2px; font-weight: 500; }
  .lm-box .dp-code { font-family: var(--mono); background: #1e1f22; border-radius: 4px; padding: 0 4px; font-size: 13px; }
  .lm-box .dp-codeblock { background: #1e1f22; border: 1px solid #3b3d44; border-radius: 6px; padding: 8px; margin: 4px 0; font-family: var(--mono); font-size: 12.5px; white-space: pre-wrap; }
  .lm-box .dp-quote { display: block; border-left: 3px solid #4e5058; padding-left: 8px; color: #b5bac1; }
  .lm-box .dp-h1 { display: block; font-size: 1.5em; font-weight: 700; } .lm-box .dp-h2 { display: block; font-size: 1.25em; font-weight: 700; } .lm-box .dp-h3 { display: block; font-size: 1.1em; font-weight: 700; }
  .lm-box .dp-sub { display: block; font-size: 12px; color: #949ba4; }
  .lm-box .dp-link { color: #00a8fc; text-decoration: none; }
  .lm-box .dp-var { color: #f0b232; font-family: var(--mono); font-size: 13px; }
  .lm-box .dp-emoji { width: 20px; height: 20px; vertical-align: -4px; }
  .lm-box .dp-spoiler { background: #1e1f22; color: transparent; border-radius: 3px; cursor: pointer; } .lm-box .dp-spoiler:hover { color: inherit; }
</style>
