---
// What the typed autocomplete of the message fields offers on this page (DashAutocomplete.astro): the roles, channels and custom emojis the
// page already read, written once as compact JSON. It adds no request: give it only what the page loads anyway. The variables come from the
// same list as the Variables menu (written once per page by whichever of the two is drawn first).
import { getDashLang, makeT } from '../i18n/dash';
import { firstInRequest } from '../utils/oncePerRequest';
import { variableGroupsJson } from '../utils/variableGroups';
interface Props {
  roles?: { id: string; name: string; color?: number | null }[];
  channels?: { id: string; name: string; type?: number }[];
  emojis?: { id: string; name: string; animated: boolean }[];
}
const { roles = [], channels = [], emojis = [] } = Astro.props;
const dt = makeT(getDashLang(Astro));
const data = JSON.stringify({
  r: roles.filter((role) => role.name !== '@everyone').map((role) => [role.id, role.name, role.color ? `#${Number(role.color).toString(16).padStart(6, '0')}` : '']),
  c: channels.map((channel) => [channel.id, channel.name, channel.type ?? 0]),
  e: emojis.map((emoji) => [emoji.id, emoji.name, emoji.animated ? 1 : 0]),
}).replace(/</g, '\\u003c');
const first = firstInRequest(Astro.request, 'variables');
// Never a call to the bot from here: the list it gave lately, or the built-in one.
const vars = first ? await variableGroupsJson(Astro, dt, { ask: false }) : '';
---
<script type="application/json" data-ac-data set:html={data}></script>
{first && <script type="application/json" data-var-groups set:html={vars}></script>}
