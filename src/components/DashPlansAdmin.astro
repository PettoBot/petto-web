---
// The plans of the people (/dash/plans-admin, only the owner): who has a plan, give one (Bronze, Silver or Gold, for some days or with no end) and end one. It is how a plan is
// given until the payment is connected. The bot checks and saves; this page asks.
import DashMeLayout from './DashMeLayout.astro';
import DashPanelHead from './DashPanelHead.astro';
import DashShopAdminShared from './DashShopAdminShared.astro';
import { getDashLang, makeT } from '../i18n/dash';
import type { Session } from '../utils/session';

interface Row { userId: string; plan: string; endsAt: string | null; source: string; note: string | null }
interface Props { user: Session; plans: Row[] | null }
const { user, plans } = Astro.props;
const lang = getDashLang(Astro);
const dt = makeT(lang);
const date = new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'short', year: 'numeric' });
const names: Record<string, string> = { bronze: dt('Bronze'), silver: dt('Silver'), gold: dt('Gold') };
const ui = {
  saved: dt('Saved.'), saving: dt('Saving…'), down: dt('Petto did not answer. Try again in a moment.'),
  errors: { bad_person: dt('The id of the person is 15 to 25 digits.'), bad_plan: dt('That plan does not exist.'), bad_days: dt('The days are a whole number from 1 to 3650, or empty for no end.'), not_found: dt('That person has no active plan.'), forbidden: dt('Only the owner can do this.'), failed: dt('That did not work. Try again in a moment.') },
};
const boot = JSON.stringify({ ui }).replace(/</g, '\\u003c');
---
<DashMeLayout user={user} active="staff-plans" pageTitle="User plans">
  <DashShopAdminShared />
  <DashPanelHead title={dt('User plans')} eyebrow={dt('Staff')} icon="ph:star-fill" back={false} />
  {!plans && <p class="be-down" role="alert">{ui.down}</p>}
  {plans && (
    <div class="be" id="be" data-boot={boot}>
      <p class="be-intro">{dt('Give a plan to a person until the payment is connected. The person gets the places in the showcase and the daily ceramos of the plan at once.')}</p>
      <div class="be-list">
        {plans.length === 0 && <p class="be-empty">{dt('Nobody has a plan yet.')}</p>}
        {plans.map((row) => (
          <article class="be-row">
            <span class="be-hex" style="--c:#8f7bd6"><img src={`/assets/badges/plan-${row.plan}.png`} alt="" width="40" height="40" /></span>
            <div class="be-info">
              <strong>{row.userId}</strong>
              <span class="be-meta"><i class="be-chip be-live">{names[row.plan] ?? row.plan}</i><span>{row.endsAt ? dt('Until {date}', { date: date.format(new Date(row.endsAt)) }) : dt('No end date')}</span>{row.note && <span>{row.note}</span>}</span>
            </div>
            <div class="be-actions"><button type="button" class="btn be-off" data-end={row.userId}>{dt('End plan')}</button></div>
          </article>
        ))}
      </div>
      <form class="be-form" id="be-form" autocomplete="off">
        <h2>{dt('Give a plan')}</h2>
        <div class="be-grid">
          <label>{dt('Id of the person (Discord)')}<input name="person" required inputmode="numeric" pattern="[0-9]{15,25}" placeholder="293504726505357312" /></label>
          <label>{dt('Plan')}<select name="plan"><option value="bronze">{dt('Bronze')}</option><option value="silver">{dt('Silver')}</option><option value="gold">{dt('Gold')}</option></select></label>
          <label>{dt('Days (empty: no end)')}<input name="days" type="number" min="1" max="3650" step="1" value="30" /></label>
          <label>{dt('Note (only the team sees it)')}<input name="note" maxlength="200" /></label>
        </div>
        <p class="be-msg" id="be-msg" role="status" hidden></p>
        <div class="be-buttons"><button type="submit" class="btn be-save" id="be-save">{dt('Give plan')}</button></div>
      </form>
    </div>
  )}
</DashMeLayout>

<script>
  const root = document.getElementById('be');
  const form = document.getElementById('be-form') as HTMLFormElement | null;
  if (root?.dataset.boot && form) {
    const { ui } = JSON.parse(root.dataset.boot) as { ui: any };
    const msg = document.getElementById('be-msg') as HTMLElement;
    const say = (text: string, level: 'ok' | 'error') => { msg.hidden = false; msg.textContent = text; msg.className = `be-msg is-${level}`; };
    const send = async (action: string, body: unknown) => {
      const response = await fetch(`/dash/plans-admin-act?action=${action}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      const data = await response.json().catch(() => null);
      return { ok: Boolean(response.ok && data?.ok), error: data?.error as string | undefined };
    };
    const why = (code?: string) => ui.errors[code ?? 'failed'] ?? ui.errors.failed;
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = document.getElementById('be-save') as HTMLButtonElement; button.disabled = true; say(ui.saving, 'ok');
      const out = await send('grant', { person: field('person').value.trim(), plan: field('plan').value, days: field('days').value === '' ? null : Number(field('days').value), note: field('note').value });
      if (out.ok) location.reload(); else { button.disabled = false; say(why(out.error), 'error'); }
    });
    document.querySelectorAll<HTMLButtonElement>('[data-end]').forEach((button) => button.addEventListener('click', async () => {
      button.disabled = true;
      const out = await send('end', { person: button.dataset.end });
      if (out.ok) location.reload(); else { button.disabled = false; say(why(out.error), 'error'); }
    }));
  }
</script>
