---
import { Icon } from 'astro-icon/components';
import { getDashLang, makeT } from '../i18n/dash';
const dt = makeT(getDashLang(Astro));
interface Props { guildId: string; section: string; typeCount: number; panelCount: number; postedCount: number }
const { guildId, section, typeCount, panelCount, postedCount } = Astro.props;
const base = `/dash/guild/${guildId}/tickets`;
const steps = [
  { n: 1, id: 'types', done: typeCount > 0, title: dt('Create a support type'), text: dt('It is what the member picks: Support, Report a player, Purchases... Each one has its own staff, channel name and welcome text.'), href: `${base}?section=types`, cta: dt('Support types') },
  { n: 2, id: 'panels', done: panelCount > 0, title: dt('Create the panel'), text: dt('The message with buttons or a dropdown, in a channel. Here the member opens their ticket. Pick a ready design or make your own.'), href: `${base}?section=panels`, cta: dt('Panels') },
  { n: 3, id: 'post', done: postedCount > 0, title: dt('Post it and try it'), text: dt('Saving posts the panel in Discord. Open a ticket yourself to see it as a member does.'), href: `${base}?section=panels`, cta: dt('Panels') },
];
const next = steps.find((s) => !s.done)?.n ?? 0;
---
<section class="tg" aria-label={dt('How to set up tickets')}>
  <div class="tg-head">
    <strong>{dt('How to set up tickets')}</strong>
    <span>{next === 0 ? dt('Everything is ready. You can still adjust closing, ratings and hours in Ticket Settings.') : dt('Three steps, in this order.')}</span>
  </div>
  <ol class="tg-steps">
    {steps.map((s) => (
      <li class:list={['tg-step', { 'tg-done': s.done, 'tg-next': s.n === next }]}>
        <span class="tg-n">{s.done ? <Icon name="ph:check-bold" width="13" height="13" /> : s.n}</span>
        <div>
          <b>{s.title}</b>
          <p>{s.text}</p>
          {s.id !== section && !s.done && <a href={s.href}>{s.cta} →</a>}
        </div>
      </li>
    ))}
  </ol>
</section>
<style>
  .tg { border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 14px 16px; margin: 0 0 26px; max-width: 980px; }
  .tg-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin-bottom: 12px; }
  .tg-head strong { font-size: 14px; }
  .tg-head span { font-size: 12.5px; color: var(--text-dim); }
  .tg-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .tg-step { display: flex; gap: 10px; border: 1px solid var(--border-soft); border-radius: 11px; padding: 10px 12px; background: var(--bg-raise); }
  .tg-next { border-color: var(--accent); background: var(--accent-soft); }
  .tg-n { flex: none; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-size: 12px; font-weight: 700; background: var(--border-soft); color: var(--text); }
  .tg-done .tg-n { background: var(--green-soft); color: var(--green); }
  .tg-next .tg-n { background: var(--accent); color: var(--bg, #141416); }
  .tg-step b { font-size: 13px; display: block; margin-bottom: 3px; }
  .tg-step p { margin: 0 0 4px; font-size: 12px; line-height: 1.5; color: var(--text-muted); }
  .tg-step a { font-size: 12px; color: var(--accent); text-decoration: none; font-weight: 600; }
  @media (max-width: 800px) { .tg-steps { grid-template-columns: 1fr; } }
</style>
