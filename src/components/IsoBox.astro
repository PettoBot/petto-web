---
// One box of the isometric drawings (HomeLayers): three faces drawn as polygons, back to front, so the lines show only what is in front.
interface Props { top: string; left: string; right: string; class?: string; style?: string }
const { top, left, right, class: className = '', style } = Astro.props;
---
<g class:list={['bx', className]} style={style}>
  <polygon class="f-left" points={left} />
  <polygon class="f-right" points={right} />
  <polygon class="f-top" points={top} />
</g>
