---
// The chosen entry of a select whose full list comes from a <SelectSource> (see there). Nothing when nothing, or something gone, is chosen,
// exactly as the full list would select nothing then.
interface Props { items: { id: string; name: string; note?: string }[]; selected?: string | null; prefix?: string }
const { items, selected, prefix = '' } = Astro.props;
const item = selected ? items.find((i) => i.id === selected) : undefined;
---
{item && <option value={item.id} selected data-fill-item data-note={item.note || undefined}>{prefix}{item.name}</option>}
