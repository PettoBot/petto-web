---
// A simulated screenshot of Discord: a window with a channel and some messages, drawn like Discord draws them. A message can carry what Petto
// really sends: plain text, classic embeds, Components V2 (cards, text, pictures, separators and buttons), buttons under an embed, attached
// pictures and a reply. The fixtures are in src/data/shots, written by scripts/make-shots.mjs from the bot's own code.
import DiscordPart from './DiscordPart.astro';
import { markdown, type MarkdownContext } from '../utils/discordMarkdown';
import people from '../data/shotPeople.json';

interface ShotPart { type: number; accent_color?: number; components?: ShotPart[]; [key: string]: unknown }
export type ShotComponent = ShotPart;
export interface ShotEmbed {
  color?: number;
  author?: { name: string; icon_url?: string };
  title?: string;
  url?: string;
  description?: string;
  fields?: { name: string; value: string; inline?: boolean }[];
  thumbnail?: { url: string };
  image?: { url: string };
  footer?: { text: string; icon_url?: string };
  timestamp?: string;
}
export interface ShotMessage {
  user: { name: string; avatar?: string; bot?: boolean; color?: string; /** The picture is drawn as it is, without the round dark disc (a character with a transparent background). */ plain?: boolean };
  /** The line Discord puts over the answer of a slash command: `liam used /purge`, with the command in blue. */
  interaction?: { name: string; avatar?: string; command: string };
  time?: string;
  text?: string;
  reply?: { name: string; avatar?: string; text: string };
  embeds?: ShotEmbed[];
  images?: { url: string; alt?: string }[];
  components?: ShotComponent[];
  reactions?: { emoji: string; count: number }[];
}
export interface Shot { channel: string; now?: number; locale?: string; names?: Record<string, string>; messages: ShotMessage[] }

interface Props { shot: Shot; label?: string }
const { shot, label } = Astro.props;
const names: Record<string, string> = { ...Object.fromEntries(Object.entries(people).map(([id, person]) => [id, (person as { name: string }).name])), ...(shot.names ?? {}) };
const context: MarkdownContext = { now: shot.now ?? Date.now(), locale: shot.locale ?? 'en', names };
const text = (value?: string) => markdown(value ?? '', context);
const hex = (value?: number) => (value === undefined ? undefined : `#${value.toString(16).padStart(6, '0')}`);
const stamp = (value?: string) => (value ? new Intl.DateTimeFormat(context.locale, { dateStyle: 'short', timeStyle: 'short', timeZone: 'America/Bogota' }).format(new Date(value)) : '');
---
<figure class="dshot" aria-label={label}>
  <div class="dshot-bar"><span class="dshot-hash">#</span>{shot.channel}</div>
  <div class="dshot-body">
    {shot.messages.map((message) => (
      <div class="dshot-msg">
        {message.interaction && (
          <div class="dshot-reply dshot-used">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18V9a4 4 0 0 1 4-4h12v2H8a2 2 0 0 0-2 2v9H4z" fill="currentColor" /></svg>
            {message.interaction.avatar && <img src={message.interaction.avatar} alt="" />}
            <b>{message.interaction.name}</b><span>used</span><span class="dshot-cmd">{message.interaction.command}</span>
          </div>
        )}
        {message.reply && (
          <div class="dshot-reply">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 18V9a4 4 0 0 1 4-4h12v2H8a2 2 0 0 0-2 2v9H4z" fill="currentColor" /></svg>
            {message.reply.avatar && <img src={message.reply.avatar} alt="" />}
            <b>{message.reply.name}</b><span>{message.reply.text}</span>
          </div>
        )}
        <div class={`dshot-av${message.user.plain ? ' plain' : ''}`}>
          {message.user.avatar ? <img src={message.user.avatar} alt="" loading="lazy" /> : <span>{message.user.name.slice(0, 1).toUpperCase()}</span>}
        </div>
        <div class="dshot-main">
          <div class="dshot-meta"><b style={message.user.color && !message.user.bot ? `color:${message.user.color}` : undefined}>{message.user.name}</b>{message.user.bot && <span class="dshot-app">APP</span>}{message.time && <span class="dshot-time">{message.time}</span>}</div>
          {message.text && <div class="dshot-text" set:html={text(message.text)} />}
          {(message.embeds ?? []).map((embed) => (
            <div class="dshot-embed" style={`border-left-color:${hex(embed.color) ?? '#1e1f22'}`}>
              <div class="dshot-embed-grid">
                <div class="dshot-embed-main">
                  {embed.author && <div class="dshot-embed-author">{embed.author.icon_url && <img src={embed.author.icon_url} alt="" />}<span>{embed.author.name}</span></div>}
                  {embed.title && <div class="dshot-embed-title">{embed.title}</div>}
                  {embed.description && <div class="dshot-t" set:html={text(embed.description)} />}
                  {embed.fields && embed.fields.length > 0 && (
                    <div class="dshot-fields">
                      {embed.fields.map((field) => (
                        <div class={`dshot-field${field.inline ? ' inline' : ''}`}><div class="dshot-field-name" set:html={text(field.name)} /><div class="dshot-t" set:html={text(field.value)} /></div>
                      ))}
                    </div>
                  )}
                  {embed.image && <img class="dshot-embed-image" src={embed.image.url} alt="" loading="lazy" />}
                  {(embed.footer || embed.timestamp) && (
                    <div class="dshot-embed-footer">{embed.footer?.icon_url && <img src={embed.footer.icon_url} alt="" />}<span>{[embed.footer?.text, stamp(embed.timestamp)].filter(Boolean).join(' • ')}</span></div>
                  )}
                </div>
                {embed.thumbnail && <img class="dshot-embed-thumb" src={embed.thumbnail.url} alt="" loading="lazy" />}
              </div>
            </div>
          ))}
          {(message.images ?? []).map((image) => <img class="dshot-attach" src={image.url} alt={image.alt ?? ''} loading="lazy" />)}
          {(message.components ?? []).map((top) => (
            top.type === 17 ? (
              <div class="dshot-card" style={top.accent_color !== undefined && top.accent_color !== null ? `border-left-color:${hex(top.accent_color)}` : undefined} data-accent={top.accent_color !== undefined && top.accent_color !== null ? 'yes' : 'no'}>
                {(top.components ?? []).map((part) => <DiscordPart part={part as never} context={context} />)}
              </div>
            ) : <DiscordPart part={top as never} context={context} />
          ))}
          {message.reactions && message.reactions.length > 0 && <div class="dshot-reacts">{message.reactions.map((reaction) => <span class="dshot-react">{reaction.emoji} <b>{reaction.count}</b></span>)}</div>}
        </div>
      </div>
    ))}
  </div>
</figure>

<style is:global>
  /* Always dark, like Discord, whatever the theme of the site is. */
  .dshot { --d-bg: #313338; --d-card: #2b2d31; --d-text: #dbdee1; --d-dim: #949ba4; --d-line: #3f4147; margin: 0; background: var(--d-bg); color: var(--d-text); border-radius: 14px; overflow: hidden; border: 1px solid rgba(255,255,255,.06); box-shadow: 0 24px 48px -28px rgba(0,0,0,.55); font-family: 'gg sans', 'Noto Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.375; text-align: left; }
  .dshot-bar { padding: 11px 16px; border-bottom: 1px solid #26282c; font-weight: 600; font-size: 14.5px; display: flex; gap: 6px; align-items: baseline; }
  .dshot-hash { color: var(--d-dim); font-weight: 500; }
  .dshot-body { padding: 14px 16px 18px; display: flex; flex-direction: column; gap: 16px; }
  .dshot-msg { display: grid; grid-template-columns: 40px minmax(0, 1fr); column-gap: 14px; align-items: start; }
  .dshot-reply { grid-column: 2; display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--d-dim); margin-bottom: 2px; min-width: 0; }
  .dshot-reply svg { width: 16px; height: 16px; flex: 0 0 16px; transform: scaleX(-1) translateY(-2px); opacity: .7; }
  .dshot-reply img { width: 16px; height: 16px; border-radius: 50%; }
  .dshot-reply b { font-weight: 600; color: #c4c9ce; }
  .dshot-reply span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dshot-av { grid-column: 1; width: 40px; height: 40px; border-radius: 50%; background: #1e1f22; display: flex; align-items: center; justify-content: center; font-weight: 700; color: #fff; overflow: hidden; }
  .dshot-av img { width: 100%; height: 100%; object-fit: cover; }
  .dshot-av.plain { background: transparent; border-radius: 0; overflow: visible; }
  .dshot-av.plain img { object-fit: contain; }
  /* A slash command in a message, like Discord draws it: the name in blue on a soft blue chip. */
  .dshot-cmd { color: #5ab0f0; background: rgba(0, 168, 252, 0.14); border-radius: 4px; padding: 0 4px; font-weight: 500; }
  .dshot-main { grid-column: 2; min-width: 0; }
  .dshot-reply + .dshot-av { grid-row: 2; } .dshot-reply ~ .dshot-main { grid-row: 2; }
  .dshot-meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-bottom: 2px; }
  .dshot-meta b { font-weight: 600; font-size: 15.5px; }
  .dshot-app { background: #5865f2; color: #fff; font-size: 10.5px; font-weight: 600; padding: 1px 5px; border-radius: 4px; line-height: 1.25; text-transform: uppercase; }
  .dshot-time { color: var(--d-dim); font-size: 12px; }
  .dshot-text { white-space: pre-wrap; word-break: break-word; }
  .dshot-card { margin-top: 6px; background: var(--d-card); border: 1px solid var(--d-line); border-left-width: 1px; border-radius: 8px; padding: 14px 16px; max-width: 520px; display: flex; flex-direction: column; gap: 8px; }
  .dshot-card[data-accent='yes'] { border-left-width: 4px; }
  .dshot-main > .dshot-t, .dshot-main > .dshot-section, .dshot-main > .dshot-row, .dshot-main > .dshot-gallery { margin-top: 4px; max-width: 520px; }
  .dshot-t { min-width: 0; word-break: break-word; }
  .dshot-embed { margin-top: 6px; max-width: 520px; background: var(--d-card); border: 1px solid var(--d-line); border-left: 4px solid #1e1f22; border-radius: 4px; padding: 8px 16px 16px 12px; }
  .dshot-embed-grid { display: flex; gap: 16px; justify-content: space-between; }
  .dshot-embed-main { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 8px; padding-top: 8px; }
  .dshot-embed-author { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; } .dshot-embed-author img { width: 24px; height: 24px; border-radius: 50%; object-fit: cover; }
  .dshot-embed-title { font-weight: 700; font-size: 16px; }
  .dshot-embed-thumb { width: 80px; height: 80px; border-radius: 4px; object-fit: cover; flex: 0 0 80px; margin-top: 8px; }
  .dshot-embed-image { max-width: 100%; border-radius: 4px; margin-top: 4px; }
  .dshot-embed-footer { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--d-dim); } .dshot-embed-footer img { width: 20px; height: 20px; border-radius: 50%; }
  .dshot-fields { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .dshot-field { grid-column: 1 / -1; min-width: 0; } .dshot-field.inline { grid-column: auto; }
  .dshot-field-name { font-weight: 700; font-size: 14px; margin-bottom: 2px; }
  .dshot-attach { display: block; margin-top: 6px; max-width: min(100%, 460px); border-radius: 8px; }
  .ds-p { margin: 0; } .ds-gap { height: 6px; }
  .ds-h { font-weight: 700; margin: 0; } .ds-h1 { font-size: 22px; } .ds-h2 { font-size: 19px; } .ds-h3 { font-size: 16.5px; }
  .ds-small { font-size: 12px; color: var(--d-dim); } .ds-li { padding-left: 14px; position: relative; } .ds-li::before { content: '•'; position: absolute; left: 2px; }
  .ds-pre { margin: 4px 0; padding: 8px 10px; border-radius: 6px; background: #1e1f22; border: 1px solid #2b2d31; font-family: Consolas, 'Courier New', monospace; font-size: 13px; overflow: auto; }
  .dshot code { font-family: Consolas, 'Courier New', monospace; font-size: 13.5px; background: #1e1f22; padding: 1px 5px; border-radius: 4px; }
  .ds-link { color: #00a8fc; text-decoration: none; } .ds-link:hover { text-decoration: underline; }
  .ds-mention { background: rgba(88,101,242,.3); color: #c9cdfb; padding: 0 3px; border-radius: 3px; font-weight: 500; }
  .ds-time { background: rgba(255,255,255,.06); padding: 0 4px; border-radius: 3px; }
  .ds-emoji { width: 1.25em; height: 1.25em; vertical-align: -0.3em; object-fit: contain; display: inline-block; }
  .dshot-section { display: flex; gap: 14px; align-items: flex-start; justify-content: space-between; }
  .dshot-section-text { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 4px; }
  .dshot-thumb { width: 80px; height: 80px; border-radius: 8px; object-fit: cover; flex: 0 0 80px; }
  .dshot-gallery { display: grid; gap: 4px; border-radius: 8px; overflow: hidden; }
  .dshot-gallery.n2 { grid-template-columns: 1fr 1fr; } .dshot-gallery.n3, .dshot-gallery.n4 { grid-template-columns: 1fr 1fr; }
  .dshot-gallery img { width: 100%; display: block; object-fit: cover; border-radius: 6px; }
  .dshot-sep { height: 1px; background: var(--d-line); margin: 4px 0; } .dshot-sep.none { background: transparent; height: 0; margin: 2px 0; } .dshot-sep.large { margin: 8px 0; }
  .dshot-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 2px; }
  .dshot-btn { display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 6px; font-size: 14px; font-weight: 500; background: #4e5058; color: #fff; }
  .dshot-btn.primary { background: #5865f2; } .dshot-btn.success { background: #248046; } .dshot-btn.danger { background: #da373c; } .dshot-btn.link { background: #4e5058; }
  .dshot-btn.off { opacity: .5; } .dshot-ext { width: 14px; height: 14px; }
  .dshot-select { display: flex; align-items: center; justify-content: space-between; width: 100%; max-width: 420px; padding: 8px 12px; border-radius: 6px; background: #1e1f22; color: var(--d-dim); font-size: 14px; } .dshot-select svg { width: 20px; height: 20px; }
  .dshot-reacts { display: flex; gap: 6px; margin-top: 6px; } .dshot-react { background: #2b2d31; border: 1px solid #5865f2; border-radius: 8px; padding: 1px 8px; font-size: 14px; }
</style>
