---
// A simulated screenshot of Discord: a window with a channel and some messages. A message can carry the same Components V2 JSON that Petto sends
// (containers, sections, text, pictures, separators and buttons), so a screenshot shows exactly what the bot builds. The fixtures are in
// src/data/shots, written by scripts/make-shots.mjs from the bot's own code.
import { markdown } from '../utils/discordMarkdown';

export interface ShotComponent {
  type: number;
  accent_color?: number;
  components?: ShotComponent[];
  content?: string;
  accessory?: ShotComponent;
  media?: { url: string };
  items?: { media: { url: string }; description?: string }[];
  divider?: boolean;
  spacing?: number;
  label?: string;
  style?: number;
  url?: string;
  disabled?: boolean;
  emoji?: { name?: string };
}
export interface ShotMessage {
  user: { name: string; avatar?: string; bot?: boolean; color?: string };
  time?: string;
  text?: string;
  components?: ShotComponent[];
  reactions?: { emoji: string; count: number }[];
}
export interface Shot { channel: string; now?: number; locale?: string; messages: ShotMessage[] }

interface Props { shot: Shot; label?: string }
const { shot, label } = Astro.props;
const now = shot.now ?? Date.now();
const locale = shot.locale ?? 'en';
const text = (value?: string) => markdown(value ?? '', now, locale);
const hex = (value?: number) => (value === undefined ? undefined : `#${value.toString(16).padStart(6, '0')}`);
const styleName = (style?: number) => ({ 1: 'primary', 2: 'secondary', 3: 'success', 4: 'danger', 5: 'link' }[style ?? 2] ?? 'secondary');
---
<figure class="dshot" aria-label={label}>
  <div class="dshot-bar"><span class="dshot-hash">#</span>{shot.channel}</div>
  <div class="dshot-body">
    {shot.messages.map((message) => (
      <div class="dshot-msg">
        <div class={`dshot-av${message.user.bot ? ' bot' : ''}`} style={message.user.color ? `background:${message.user.color}` : undefined}>
          {message.user.avatar ? <img src={message.user.avatar} alt="" loading="lazy" /> : <span>{message.user.name.slice(0, 1).toUpperCase()}</span>}
        </div>
        <div class="dshot-main">
          <div class="dshot-meta"><b style={message.user.color && !message.user.bot ? `color:${message.user.color}` : undefined}>{message.user.name}</b>{message.user.bot && <span class="dshot-app">APP</span>}{message.time && <span class="dshot-time">{message.time}</span>}</div>
          {message.text && <div class="dshot-text" set:html={text(message.text)} />}
          {(message.components ?? []).map((top) => (
            top.type === 17 ? (
              <div class="dshot-card" style={top.accent_color !== undefined ? `border-left-color:${hex(top.accent_color)}` : undefined} data-accent={top.accent_color !== undefined ? 'yes' : 'no'}>
                {(top.components ?? []).map((part) => (
                  part.type === 10 ? <div class="dshot-t" set:html={text(part.content)} />
                  : part.type === 9 ? (
                    <div class="dshot-section">
                      <div class="dshot-section-text">{(part.components ?? []).map((inner) => <div class="dshot-t" set:html={text(inner.content)} />)}</div>
                      {part.accessory?.type === 11 && <img class="dshot-thumb" src={part.accessory.media?.url} alt="" loading="lazy" />}
                      {part.accessory?.type === 2 && <span class={`dshot-btn ${styleName(part.accessory.style)}`}>{part.accessory.label}</span>}
                    </div>
                  )
                  : part.type === 12 ? <div class={`dshot-gallery n${Math.min((part.items ?? []).length, 4)}`}>{(part.items ?? []).map((item) => <img src={item.media.url} alt={item.description ?? ''} loading="lazy" />)}</div>
                  : part.type === 14 ? <div class={`dshot-sep${part.divider === false ? ' none' : ''}${part.spacing === 2 ? ' large' : ''}`}></div>
                  : part.type === 1 ? (
                    <div class="dshot-row">{(part.components ?? []).map((button) => <span class={`dshot-btn ${styleName(button.style)}${button.disabled ? ' off' : ''}`}>{button.emoji?.name && <span class="dshot-btn-emoji">{button.emoji.name}</span>}{button.label}{button.style === 5 && <svg class="dshot-ext" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7h-2V6.4l-8.3 8.3-1.4-1.4L17.6 5H14V3zM5 5h6v2H5v12h12v-6h2v8H3V5h2z" fill="currentColor"/></svg>}</span>)}</div>
                  ) : null
                ))}
              </div>
            ) : null
          ))}
          {message.reactions && message.reactions.length > 0 && <div class="dshot-reacts">{message.reactions.map((reaction) => <span class="dshot-react">{reaction.emoji} <b>{reaction.count}</b></span>)}</div>}
        </div>
      </div>
    ))}
  </div>
</figure>

<style is:global>
  /* Always dark, like Discord, whatever the theme of the site is. */
  .dshot { --d-bg: #313338; --d-card: #2b2d31; --d-text: #dbdee1; --d-dim: #949ba4; --d-line: #3f4147; margin: 0; background: var(--d-bg); color: var(--d-text); border-radius: 14px; overflow: hidden; border: 1px solid rgba(255,255,255,.06); box-shadow: 0 24px 48px -28px rgba(0,0,0,.55); font-family: 'gg sans', 'Noto Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.375; text-align: left; }
  .dshot-bar { padding: 11px 16px; border-bottom: 1px solid #26282c; font-weight: 600; font-size: 14.5px; display: flex; gap: 6px; align-items: baseline; }
  .dshot-hash { color: var(--d-dim); font-weight: 500; }
  .dshot-body { padding: 14px 16px 18px; display: flex; flex-direction: column; gap: 16px; }
  .dshot-msg { display: flex; gap: 14px; align-items: flex-start; }
  .dshot-av { width: 40px; height: 40px; border-radius: 50%; flex: 0 0 40px; background: #5865f2; display: flex; align-items: center; justify-content: center; font-weight: 700; color: #fff; overflow: hidden; }
  .dshot-av img { width: 100%; height: 100%; object-fit: cover; }
  .dshot-main { min-width: 0; flex: 1; }
  .dshot-meta { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-bottom: 2px; }
  .dshot-meta b { font-weight: 600; font-size: 15.5px; }
  .dshot-app { background: #5865f2; color: #fff; font-size: 10.5px; font-weight: 600; padding: 1px 5px; border-radius: 4px; line-height: 1.25; text-transform: uppercase; }
  .dshot-time { color: var(--d-dim); font-size: 12px; }
  .dshot-text { white-space: pre-wrap; word-break: break-word; }
  .dshot-card { margin-top: 6px; background: var(--d-card); border: 1px solid var(--d-line); border-left-width: 1px; border-radius: 8px; padding: 14px 16px; max-width: 520px; display: flex; flex-direction: column; gap: 8px; }
  .dshot-card[data-accent='yes'] { border-left-width: 4px; }
  .dshot-t { min-width: 0; word-break: break-word; }
  .ds-p { margin: 0; } .ds-gap { height: 6px; }
  .ds-h { font-weight: 700; margin: 0; } .ds-h1 { font-size: 22px; } .ds-h2 { font-size: 19px; } .ds-h3 { font-size: 16.5px; }
  .ds-small { font-size: 12px; color: var(--d-dim); } .ds-li { padding-left: 14px; position: relative; } .ds-li::before { content: '•'; position: absolute; left: 2px; }
  .ds-pre { margin: 4px 0; padding: 8px 10px; border-radius: 6px; background: #1e1f22; border: 1px solid #2b2d31; font-family: Consolas, 'Courier New', monospace; font-size: 13px; overflow: auto; }
  .dshot code { font-family: Consolas, 'Courier New', monospace; font-size: 13.5px; background: #1e1f22; padding: 1px 5px; border-radius: 4px; }
  .ds-link { color: #00a8fc; text-decoration: none; } .ds-link:hover { text-decoration: underline; }
  .ds-mention { background: rgba(88,101,242,.3); color: #c9cdfb; padding: 0 3px; border-radius: 3px; font-weight: 500; }
  .ds-time { background: rgba(255,255,255,.06); padding: 0 4px; border-radius: 3px; }
  .ds-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--d-dim); margin: 0 7px 1px 1px; vertical-align: middle; }
  .dshot-section { display: flex; gap: 14px; align-items: flex-start; justify-content: space-between; }
  .dshot-section-text { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 4px; }
  .dshot-thumb { width: 80px; height: 80px; border-radius: 8px; object-fit: cover; flex: 0 0 80px; }
  .dshot-gallery { display: grid; gap: 4px; border-radius: 8px; overflow: hidden; }
  .dshot-gallery.n2 { grid-template-columns: 1fr 1fr; } .dshot-gallery.n3, .dshot-gallery.n4 { grid-template-columns: 1fr 1fr; }
  .dshot-gallery img { width: 100%; display: block; object-fit: cover; border-radius: 6px; }
  .dshot-sep { height: 1px; background: var(--d-line); margin: 4px 0; } .dshot-sep.none { background: transparent; height: 0; margin: 2px 0; } .dshot-sep.large { margin: 8px 0; }
  .dshot-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 2px; }
  .dshot-btn { display: inline-flex; align-items: center; gap: 6px; padding: 5px 14px; border-radius: 6px; font-size: 14px; font-weight: 500; background: #4e5058; color: #fff; }
  .dshot-btn.primary { background: #5865f2; } .dshot-btn.success { background: #248046; } .dshot-btn.danger { background: #da373c; } .dshot-btn.link { background: #4e5058; }
  .dshot-btn.off { opacity: .5; } .dshot-ext { width: 14px; height: 14px; }
  .dshot-reacts { display: flex; gap: 6px; margin-top: 6px; } .dshot-react { background: #2b2d31; border: 1px solid #5865f2; border-radius: 8px; padding: 1px 8px; font-size: 14px; }
</style>
