---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MultiSelect from './MultiSelect.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import SxNumber from './SxNumber.astro';
import { TEMPLATES, PACKS } from '../utils/automodTemplates';
import { getDashLang, makeT } from '../i18n/dash';
import { MAX_ALLOWED_DOMAINS } from '../utils/linkDomains.mjs';
import { formatDuration } from '../utils/formatDuration';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  filters: { id: number; name: string; template: string; options: Record<string, boolean | number>; action: string; mute_minutes: number; enabled: boolean; hits: number }[];
  roles: { id: string; name: string }[];
  channels: { id: string; name: string; category: boolean }[];
  linkDomains?: string[];
  linkDomainsSupported?: boolean;
}
const { user, guildId, guildName, guildIcon, filters, roles, channels, linkDomains = [], linkDomainsSupported = true } = Astro.props;
const textChannels = channels.filter((c) => !c.category);

const info: Record<string, { name: string; text: string; sample: string }> = {
  links: { name: dt('All links'), text: dt('Blocks every link, even the ones written with spaces or odd symbols to get past filters.'), sample: 'https://example.com' },
  invites: { name: dt('Invite links'), text: dt('Blocks Discord invites and server pages.'), sample: 'discord.gg/abc123' },
  inline_links: { name: dt('Inline links'), text: dt('Blocks links hidden behind a text, like a button that says one thing and goes somewhere else.'), sample: '[click here](https://example.com)' },
  emails: { name: dt('Email addresses'), text: dt('Stops email addresses from being sent.'), sample: 'name@example.com' },
  scam: { name: dt('Scam text'), text: dt('Catches the usual lines of scams: free Nitro, gifts, Robux, airdrops, wallets.'), sample: 'FREE NITRO click here' },
  fake_pings: { name: dt('Fake pings'), text: dt('Blocks the text @everyone and @here, even from people who cannot ping.'), sample: '@everyone' },
  ip_addresses: { name: dt('IP addresses'), text: dt('Blocks IP addresses.'), sample: '192.168.1.20' },
  phone_numbers: { name: dt('Phone numbers'), text: dt('Blocks phone numbers.'), sample: '+57 300 123 4567' },
  emojis: { name: dt('Emoji spam'), text: dt('Limits how many emojis fit in one message.'), sample: '😀😀😀😀😀😀😀' },
  zalgo: { name: dt('Zalgo text'), text: dt('Blocks text with stacked marks that looks glitchy.'), sample: 'h̷̢͠o̸̡͞l̵̨͠a̴' },
  headings: { name: dt('Headings'), text: dt('Blocks big heading text made with #.'), sample: '# TITLE' },
  subtext: { name: dt('Subtext'), text: dt('Blocks small text that can be used to fake official notices.'), sample: '-# small text' },
  caps: { name: dt('Shouting'), text: dt('Blocks messages written in capital letters.'), sample: 'THIS IS A VERY LONG SHOUT' },
  repeated_characters: { name: dt('Repeated characters'), text: dt('Blocks letters or symbols repeated again and again.'), sample: 'holaaaaaaaaaaaa!!!!!!!!!!' },
  spoilers: { name: dt('Spoiler spam'), text: dt('Blocks many spoilers in one message.'), sample: '||a|| ||b|| ||c|| ||d||' },
  invisible_text: { name: dt('Invisible text'), text: dt('Blocks zero-width characters used to hide or break words.'), sample: '(nothing you can see)' },
};
const optionLabels: Record<string, string> = {
  nonClickable: dt('Also links without https (can block normal text like a.b)'),
  thirdParty: dt('Also invites from other sites (dsc.gg and similar)'),
  disguisedOnly: dt('Only when the text looks like a web address'),
  max: dt('Most allowed'),
  filterAccents: dt('Also block normal accents'),
  level: dt('Biggest heading allowed to block (1 to 3)'),
  words: dt('Words in capitals to block'),
  times: dt('Repetitions to block'),
};
const packInfo: Record<string, { name: string; text: string }> = {
  basic: { name: dt('Basic'), text: dt('Invites, zalgo, subtext and fake pings. A good start for any server.') },
  clean_chat: { name: dt('Clean chat'), text: dt('Shouting, repeated characters, emoji and spoiler spam and invisible text.') },
  anti_scam: { name: dt('Anti scam'), text: dt('Scam text, links, hidden links and fake pings.') },
  strict: { name: dt('Strict'), text: dt('All links, all invites, emails, zalgo, headings and subtext.') },
};
const groups = [
  { id: 'links', label: dt('Links and addresses') },
  { id: 'safety', label: dt('Safety') },
  { id: 'text', label: dt('Text and noise') },
];
const actionNames: Record<string, string> = { delete: dt('Delete the message'), warn: dt('Warn'), mute: dt('Mute'), kick: dt('Kick') };
const jump = [
  { id: 'am-packs', label: dt('Packs') },
  ...groups.map((g) => ({ id: `am-g-${g.id}`, label: g.label })),
  { id: 'am-discord-own', label: dt('What Discord does by itself') },
  { id: 'am-active-discord', label: dt('Active in Discord') },
  { id: 'am-active-petto', label: dt('Active in Petto') },
];
const ruleName = (r: { id: number; name: string; template: string }) => info[r.template]?.name ?? r.name;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="automod-templates" pageTitle={dt('AutoMod templates')}>
  <DashSettingsKit />
  <div class="sx-page">
  <h1>{dt('AutoMod templates')}</h1>

  <a class="am-where" href={`/dash/guild/${guildId}/moderation#anti-spam`}>
    <Icon name="ph:chats-fill" width="18" height="18" />
    <span><b>{dt('Looking for the spam, shouting or mute settings?')}</b><em>{dt('Petto\'s own Anti-spam (repeated messages, mentions, invites and capital letters) and the Strikes that mute a member are in Moderation. These templates are filters that you add in Discord or in Petto.')}</em></span>
    <Icon name="ph:arrow-right-bold" width="14" height="14" />
  </a>

  <div class="am-msg" data-am-msg hidden></div>

  <div class="sx-tiles am-slots">
    <div class="sx-tile"><span class="sx-tile-label">{dt('Keyword rules of Discord')}</span><b data-native-count>–</b></div>
    <div class="sx-tile"><span class="sx-tile-label">{dt('Petto filters')}</span><b>{filters.length}/40</b></div>
  </div>
  <p class="am-warn" data-native-warn hidden>{dt('Discord AutoMod could not be read right now.')} {dt('The Petto filters work anyway.')}</p>

  <section class="sx-panel am-settings" data-am-settings>
    <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:funnel-fill" width="17" height="17" /></span><h2>{dt('Settings for what you add')}</h2></div>
    <div class="sx-grid">
      <div class="sx-field"><label for="am-s-alert">{dt('Discord: alert channel')}</label>
        <select id="am-s-alert" data-s="alert"><option value="">{dt('No alert')}</option>{textChannels.map((c) => <option value={c.id}>#{c.name}</option>)}</select>
      </div>
      <div class="sx-field"><label for="am-s-timeout">{dt('Discord: also mute the member (minutes, 0 for no)')}</label><SxNumber id="am-s-timeout" data-s="timeout" value="0" min="0" max="40320" /></div>
      <div class="sx-field sx-wide"><label for="am-s-message">{dt('Discord: text the member sees when blocked')}</label><textarea id="am-s-message" class="dgl-autogrow sx-one" rows="1" data-s="message" maxlength="150" placeholder={dt('Optional')}></textarea></div>
      <div class="sx-field"><label for="am-s-action">{dt('Petto: what happens')}</label>
        <select id="am-s-action" data-s="action">{Object.entries(actionNames).map(([k, v]) => <option value={k}>{v}</option>)}</select>
      </div>
      <div class="sx-field"><label for="am-s-mute">{dt('Petto: minutes of mute')}</label><SxNumber id="am-s-mute" data-s="mute" value="10" min="1" max="40320" /></div>
      <div class="sx-field sx-wide"><span class="sx-label">{dt('Roles that are never checked')}</span><MultiSelect name="am_exempt_roles" options={roles} selected={[]} placeholder={dt('Search roles...')} /></div>
      <div class="sx-field sx-wide"><span class="sx-label">{dt('Channels that are never checked')}</span><MultiSelect name="am_exempt_channels" options={channels} selected={[]} placeholder={dt('Search channels...')} /></div>
    </div>
    <p class="sx-hint">{dt('Staff with Manage Messages and the immune roles are never checked by the Petto filters.')}</p>
  </section>

  <section class="sx-panel am-domains" data-am-domains>
    <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--blue)"><Icon name="ph:link-simple-bold" width="17" height="17" /></span><h2>{dt('Allowed domains')}</h2></div>
    <p class="sx-lead">{dt('The "All links" filter of Petto lets a message through when every link in it is on this list (or a subdomain of one). Write one domain per line, like youtube.com.')}</p>
    <div class="sx-field"><textarea id="am-allowed-domains" class="dgl-autogrow sx-mono" data-domains rows="4" maxlength="4000" aria-label={dt('Allowed domains')} placeholder={dt('youtube.com, one per line')} disabled={!linkDomainsSupported}>{linkDomains.join('\n')}</textarea></div>
    <div class="sx-foot">
      <button type="button" class="btn btn-accent btn-sm" data-save-domains disabled={!linkDomainsSupported}>{dt('Save domains')}</button>
      <span class="sx-hint">{dt('Up to {n} domains. Links to anything else are still caught, and Discord rules are not changed by this list.', { n: MAX_ALLOWED_DOMAINS })}</span>
    </div>
    <p class="am-note" data-domains-note hidden={linkDomainsSupported}><Icon name="ph:warning-fill" width="15" height="15" />{dt('This setting is not available yet: Petto has not been updated on the server for it. Try again later.')}</p>
    <p class="am-note" data-domains-bad hidden></p>
  </section>

  <div class="am-toolbar">
    <nav class="am-jump" aria-label={dt('AutoMod templates')}>
      {jump.map((j) => <button type="button" class="am-jump-btn" data-am-jump={j.id}>{j.label}</button>)}
    </nav>
    <input type="search" class="am-search" data-am-filter placeholder={dt('Search filters...')} aria-label={dt('Search filters...')} />
  </div>

  <h2 class="am-h" id="am-packs" data-am-heading>{dt('Packs')}<span class="am-h-n">{PACKS.length}</span></h2>
  <div class="am-tiles dgl-stagger">
    {PACKS.map((pack) => (
      <div class="am-tile" data-pack={pack} data-am-search={`${packInfo[pack].name} ${packInfo[pack].text}`.toLowerCase()}>
        <div class="am-tile-head"><span class="am-tile-icon"><Icon name="ph:shield-check-fill" width="17" height="17" /></span><b>{packInfo[pack].name}</b></div>
        <p>{packInfo[pack].text}</p>
        <div class="am-btns"><button type="button" class="btn btn-accent btn-sm" data-add-native-pack={pack}>{dt('Add to Discord (one rule)')}</button></div>
      </div>
    ))}
  </div>

  {groups.map((group) => (
    <>
      <h2 class="am-h" id={`am-g-${group.id}`} data-am-heading>{group.label}<span class="am-h-n">{TEMPLATES.filter((t) => t.group === group.id).length}</span></h2>
      <div class="am-tiles dgl-stagger">
        {TEMPLATES.filter((t) => t.group === group.id).map((t) => (
          <div class="am-tile" data-template={t.id} data-am-search={`${info[t.id].name} ${info[t.id].text}`.toLowerCase()}>
            <div class="am-tile-head"><span class="am-tile-icon"><Icon name={t.icon} width="17" height="17" /></span><b>{info[t.id].name}</b></div>
            <p>{info[t.id].text}</p>
            <code class="am-sample">{info[t.id].sample}</code>
            {t.options.length > 0 && <div class="am-opts">
            {t.options.map((o) => o.type === 'boolean' ? (
              <label class="sx-switch am-opt"><input type="checkbox" data-opt={o.key} checked={Boolean(o.default)} /><span class="sx-switch-text"><b>{optionLabels[o.key]}</b></span><i class="sx-toggle"></i></label>
            ) : (
              <div class="am-opt am-opt-num"><span>{optionLabels[o.key]}</span><SxNumber data-opt={o.key} value={Number(o.default)} min={o.min} max={o.max} /></div>
            ))}
            </div>}
            <div class="am-btns">
              <button type="button" class="btn btn-accent btn-sm" data-add-native={t.id}>{dt('Add to Discord')}</button>
              <button type="button" class="btn btn-ghost btn-sm" data-add-filter={t.id}>{dt('Add to Petto')}</button>
            </div>
          </div>
        ))}
      </div>
    </>
  ))}

  <h2 class="am-h" id="am-discord-own" data-am-heading>{dt('What Discord does by itself')}<span class="am-h-n">3</span></h2>
  <div class="am-tiles dgl-stagger">
    <div class="am-tile" data-kind="spam" data-am-search={`${dt('Spam')} ${dt('Discord detects spam and floods of messages on its own.')}`.toLowerCase()}>
      <div class="am-tile-head"><span class="am-tile-icon"><Icon name="ph:siren-fill" width="17" height="17" /></span><b>{dt('Spam')}</b></div>
      <p>{dt('Discord detects spam and floods of messages on its own.')}</p>
      <div class="am-btns"><button type="button" class="btn btn-accent btn-sm" data-add-kind="spam">{dt('Add to Discord')}</button></div>
    </div>
    <div class="am-tile" data-kind="mentions" data-am-search={`${dt('Mention limit')} ${dt('Blocks messages that mention too many people or roles, and mention raids.')}`.toLowerCase()}>
      <div class="am-tile-head"><span class="am-tile-icon"><Icon name="ph:users-three-fill" width="17" height="17" /></span><b>{dt('Mention limit')}</b></div>
      <p>{dt('Blocks messages that mention too many people or roles, and mention raids.')}</p>
      <div class="am-opts"><div class="am-opt am-opt-num"><span>{dt('Most mentions allowed')}</span><SxNumber data-limit value="5" min="1" max="50" /></div></div>
      <div class="am-btns"><button type="button" class="btn btn-accent btn-sm" data-add-kind="mentions">{dt('Add to Discord')}</button></div>
    </div>
    <div class="am-tile" data-kind="presets" data-am-search={`${dt('Word lists')} ${dt('The lists of words Discord keeps up to date.')}`.toLowerCase()}>
      <div class="am-tile-head"><span class="am-tile-icon"><Icon name="ph:funnel-fill" width="17" height="17" /></span><b>{dt('Word lists')}</b></div>
      <p>{dt('The lists of words Discord keeps up to date.')}</p>
      <div class="am-opts">
        <label class="sx-switch am-opt"><input type="checkbox" data-preset="profanity" checked /><span class="sx-switch-text"><b>{dt('Profanity')}</b></span><i class="sx-toggle"></i></label>
        <label class="sx-switch am-opt"><input type="checkbox" data-preset="sexual" checked /><span class="sx-switch-text"><b>{dt('Sexual content')}</b></span><i class="sx-toggle"></i></label>
        <label class="sx-switch am-opt"><input type="checkbox" data-preset="slurs" checked /><span class="sx-switch-text"><b>{dt('Slurs')}</b></span><i class="sx-toggle"></i></label>
      </div>
      <div class="am-btns"><button type="button" class="btn btn-accent btn-sm" data-add-kind="presets">{dt('Add to Discord')}</button></div>
    </div>
  </div>

  <h2 class="am-h" id="am-active-discord" data-am-heading>{dt('Active in Discord')}</h2>
  <div class="am-list" data-native-list aria-busy="true"><div class="sk-rows" aria-hidden="true"><span class="sk"></span><span class="sk"></span><span class="sk"></span></div></div>
  <p class="sx-empty" data-native-empty hidden><Icon name="ph:shield-check" width="16" height="16" />{dt('No AutoMod rules in Discord yet.')}</p>

  <h2 class="am-h" id="am-active-petto" data-am-heading>{dt('Active in Petto')}<span class="am-h-n">{filters.length}</span></h2>
  {filters.length === 0 ? <p class="sx-empty"><Icon name="ph:sparkle" width="16" height="16" />{dt('No Petto filters yet.')}</p> : (
    <div class="am-list">
      {filters.map((f) => (
        <div class="am-item">
          <div class="am-item-main"><b>{ruleName(f)}</b><em>{actionNames[f.action] ?? f.action}{f.action === 'mute' ? ` · ${formatDuration(f.mute_minutes * 60)}` : ''} · {dt('{n} hit(s)', { n: f.hits })}</em></div>
          <label class="am-switch"><input type="checkbox" checked={f.enabled} data-filter-toggle={f.id} /><span></span></label>
          <button type="button" class="am-del" data-filter-delete={f.id} title={dt('Remove')}><Icon name="ph:trash-fill" width="14" height="14" /></button>
        </div>
      ))}
    </div>
  )}
  </div>
</DashGuildLayout>

<script is:inline>
  (function () {
    var guildOf = function () { return location.pathname.replace(/^\/(es|pt-br)(?=\/)/i, '').split('/')[3]; };
    var renderNative = function (data) {
      var list = document.querySelector('[data-native-list]');
      var empty = document.querySelector('[data-native-empty]');
      var count = document.querySelector('[data-native-count]');
      var warn = document.querySelector('[data-native-warn]');
      if (!list) return;
      if (!data || !data.ok) { list.hidden = true; list.removeAttribute('aria-busy'); if (warn) warn.hidden = false; if (count) count.textContent = '–'; return; }
      if (count) count.textContent = ((data.used && data.used.keyword) || 0) + '/' + ((data.limits && data.limits.keyword) || 6);
      list.textContent = '';
      var rules = data.rules || [];
      list.hidden = rules.length === 0;
      if (empty) empty.hidden = rules.length !== 0;
      rules.forEach(function (r) {
        var item = document.createElement('div'); item.className = 'am-item';
        var main = document.createElement('div'); main.className = 'am-item-main';
        var name = document.createElement('b'); name.textContent = r.name; main.appendChild(name);
        if (r.official) { var tag = document.createElement('span'); tag.className = 'am-tag'; tag.textContent = cdt('Petto Official'); main.appendChild(tag); }
        if (r.patterns > 0) { var em = document.createElement('em'); em.textContent = cdt('{n} pattern(s)', { n: r.patterns }); main.appendChild(em); }
        item.appendChild(main);
        if (r.mine) {
          var sw = document.createElement('label'); sw.className = 'am-switch';
          var cb = document.createElement('input'); cb.type = 'checkbox'; cb.checked = r.enabled; cb.setAttribute('data-native-toggle', r.id);
          sw.appendChild(cb); sw.appendChild(document.createElement('span')); item.appendChild(sw);
          var del = document.createElement('button'); del.type = 'button'; del.className = 'am-del'; del.setAttribute('data-native-delete', r.id); del.title = cdt('Remove'); del.textContent = '✕'; item.appendChild(del);
        } else { var st = document.createElement('span'); st.className = 'am-tag'; st.textContent = r.enabled ? cdt('Active') : cdt('Inactive'); item.appendChild(st); }
        list.appendChild(item);
      });
      list.removeAttribute('aria-busy');
      if (window.dglLoad) window.dglLoad.reveal(list);
    };
    var loadNative = function () {
      var list = document.querySelector('[data-native-list]');
      if (!list) return;
      var g = guildOf();
      if (!g) { renderNative(null); return; }
      fetch('/dash/guild/' + g + '/automod-api', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ op: 'native_list' }) })
        .then(function (r) { return r.json(); }).then(renderNative).catch(function () { renderNative(null); });
    };
    loadNative();

    if (window.__amBound) return;
    window.__amBound = true;
    // The answer is a toast at the bottom (the page is long, the button pressed may be far from the top); without it, the box at the top.
    var msg = function (text, ok) {
      if (window.dglToast) { window.dglToast(text, { kind: ok ? 'ok' : 'error' }); return; }
      var box = document.querySelector('[data-am-msg]');
      if (!box) return;
      box.hidden = false; box.textContent = text; box.className = 'am-msg ' + (ok ? 'ok' : 'bad');
      box.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    };
    var send = function (body, button, okText) {
      if (button) button.disabled = true;
      return fetch('/dash/guild/' + guildOf() + '/automod-api', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data && data.ok) { msg(okText || cdt('Done.'), true); setTimeout(function () { location.reload(); }, 900); }
          else { msg((data && data.message) || cdt('It could not be done.'), false); if (button) button.disabled = false; }
        })
        .catch(function () { msg(cdt('It could not be done.'), false); if (button) button.disabled = false; });
    };
    var settings = function () {
      var root = document.querySelector('[data-am-settings]');
      var val = function (k) { var el = root.querySelector('[data-s="' + k + '"]'); return el ? el.value : ''; };
      var checked = function (name) { return Array.prototype.map.call(root.querySelectorAll('input[name="' + name + '"]:checked'), function (i) { return i.value; }); };
      return { alertChannelId: val('alert'), timeoutMinutes: Number(val('timeout')) || 0, customMessage: val('message'), action: val('action'), muteMinutes: Number(val('mute')) || 10, exemptRoleIds: checked('am_exempt_roles'), exemptChannelIds: checked('am_exempt_channels') };
    };
    var options = function (tile) {
      var out = {};
      tile.querySelectorAll('[data-opt]').forEach(function (el) { out[el.getAttribute('data-opt')] = el.type === 'checkbox' ? el.checked : Number(el.value); });
      return out;
    };
    var saveDomains = function (btn) {
      var box = document.querySelector('[data-am-domains]');
      var area = box.querySelector('[data-domains]');
      var bad = box.querySelector('[data-domains-bad]');
      btn.disabled = true;
      fetch('/dash/guild/' + guildOf() + '/automod-api', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ op: 'link_domains_save', domains: area.value }) })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          btn.disabled = false;
          if (data && data.ok) {
            area.value = data.domains.join('\n');
            var parts = [];
            if (data.invalid.length) parts.push(cdt('These were not valid domains and were skipped: {a}', { a: data.invalid.join(', ') }));
            if (data.overflow) parts.push(cdt('Only the first {a} domains were kept.', { a: data.domains.length }));
            bad.textContent = parts.join(' '); bad.hidden = parts.length === 0;
            msg(cdt('Domains saved.'), true);
          } else if (data && data.unsupported) {
            area.disabled = true; btn.disabled = true;
            box.querySelector('[data-domains-note]').hidden = false;
          } else msg((data && data.message) || cdt('It could not be done.'), false);
        })
        .catch(function () { btn.disabled = false; msg(cdt('It could not be done.'), false); });
    };
    document.addEventListener('click', function (event) {
      var t = event.target;
      var btn = t.closest && t.closest('button');
      if (!btn) return;
      if (btn.hasAttribute('data-save-domains')) { saveDomains(btn); return; }
      var tile = btn.closest('.am-tile');
      var s = settings();
      var native = btn.getAttribute('data-add-native');
      var pack = btn.getAttribute('data-add-native-pack');
      var filter = btn.getAttribute('data-add-filter');
      var kind = btn.getAttribute('data-add-kind');
      if (native) send(Object.assign({ op: 'native_add', template: native, options: options(tile) }, s), btn, cdt('Rule added to Discord.'));
      else if (pack) send(Object.assign({ op: 'native_add', pack: pack }, s), btn, cdt('Pack added to Discord.'));
      else if (kind) {
        var extra = kind === 'mentions' ? { mentionLimit: Number(tile.querySelector('[data-limit]').value) } : kind === 'presets' ? { presets: Array.prototype.map.call(tile.querySelectorAll('[data-preset]:checked'), function (i) { return i.getAttribute('data-preset'); }) } : {};
        send(Object.assign({ op: 'native_add', kind: kind }, extra, s), btn, cdt('Rule added to Discord.'));
      } else if (filter) send({ op: 'filter_add', template: filter, options: options(tile), action: s.action, muteMinutes: s.muteMinutes, exemptRoleIds: s.exemptRoleIds, exemptChannelIds: s.exemptChannelIds }, btn, cdt('Filter added to Petto.'));
      else if (btn.hasAttribute('data-native-delete')) { window.dglConfirm(cdt('Remove this rule from Discord?'), { confirm: cdt('Remove') }).then(function (ok) { if (ok) send({ op: 'native_delete', id: btn.getAttribute('data-native-delete') }, btn, cdt('Rule removed.')); }); }
      else if (btn.hasAttribute('data-filter-delete')) { window.dglConfirm(cdt('Remove this filter?'), { confirm: cdt('Remove') }).then(function (ok) { if (ok) send({ op: 'filter_delete', id: Number(btn.getAttribute('data-filter-delete')) }, btn, cdt('Filter removed.')); }); }
    });
    document.addEventListener('change', function (event) {
      var el = event.target;
      if (el.hasAttribute && el.hasAttribute('data-native-toggle')) send({ op: 'native_toggle', id: el.getAttribute('data-native-toggle'), enabled: el.checked }, el, el.checked ? cdt('Rule on.') : cdt('Rule off.'));
      else if (el.hasAttribute && el.hasAttribute('data-filter-toggle')) send({ op: 'filter_toggle', id: Number(el.getAttribute('data-filter-toggle')), enabled: el.checked }, el, el.checked ? cdt('Filter on.') : cdt('Filter off.'));
    });
  }
</script>


<script is:inline>
  // The shortcuts scroll to a part of the long page, and the search hides the filters that do not match (and the headings left empty).
  (function () {
    if (window.__amNav) return;
    window.__amNav = true;
    document.addEventListener('click', function (event) {
      var button = event.target.closest && event.target.closest('[data-am-jump]'); if (!button) return;
      var id = button.getAttribute('data-am-jump');
      var target = id ? document.getElementById(id) : null;
      if (!target) return;
      if (target.hidden) {
        var filter = document.querySelector('[data-am-filter]');
        if (filter) { filter.value = ''; filter.dispatchEvent(new Event('input', { bubbles: true })); }
      }
      document.querySelectorAll('.am-jump-btn').forEach(function (b) { b.classList.toggle('is-on', b === button); });
      var behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
      var scroller = document.getElementById('dgl-content');
      if (scroller && scroller.scrollHeight > scroller.clientHeight + 2) {
        var top = target.getBoundingClientRect().top - scroller.getBoundingClientRect().top + scroller.scrollTop - 16;
        scroller.scrollTo({ top: Math.max(0, top), behavior: behavior });
      } else {
        target.scrollIntoView({ behavior: behavior, block: 'start' });
      }
    });
    document.addEventListener('input', function (event) {
      var box = event.target; if (!box.matches || !box.matches('[data-am-filter]')) return;
      var q = box.value.trim().toLowerCase();
      document.querySelectorAll('.am-tile').forEach(function (tile) { tile.hidden = !!q && (tile.getAttribute('data-am-search') || '').indexOf(q) === -1; });
      document.querySelectorAll('[data-am-heading]').forEach(function (heading) {
        var grid = heading.nextElementSibling; if (!grid || !grid.classList.contains('am-tiles')) return;
        var any = grid.querySelectorAll('.am-tile:not([hidden])').length > 0;
        heading.hidden = !any; grid.hidden = !any;
      });
    });
  })();
</script>

