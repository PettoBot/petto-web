---
// Three small animated scenes in pure CSS (no script): a message is moderated, a member levels up, a ticket is opened. Each loops by itself and stops
// with "reduce motion" (the final state is what is drawn when nothing moves).
import { Icon } from 'astro-icon/components';
import { HOME_COPY } from '../data/homeCopy';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = HOME_COPY[lang].scenes;
---
<div class="scenes">
  <article class="scene s-lvl">
    <div class="scene-copy">
      <span class="chip"><Icon name="ph:chart-line-fill" width="14" height="14" />{c.leveling.chip}</span>
      <h3>{t.features.levelingTitle}</h3>
      <p>{t.features.levelingDesc}</p>
    </div>
    <div class="stage" aria-hidden="true">
      <div class="lvl-row">
        <img class="av" src="/assets/user-liam.png" alt="" />
        <div class="lvl-main"><b>kiwi</b><div class="bar"><span class="fill"></span></div><div class="xp">{c.leveling.next}</div></div>
      </div>
      <div class="toast"><Icon name="ph:sparkle-fill" width="16" height="16" />{c.leveling.levelUp}</div>
    </div>
  </article>

  <article class="scene s-tk">
    <div class="scene-copy">
      <span class="chip"><Icon name="ph:ticket-fill" width="14" height="14" />{c.tickets.chip}</span>
      <h3>{t.features.ticketsTitle}</h3>
      <p>{t.features.ticketsDesc}</p>
    </div>
    <div class="stage" aria-hidden="true">
      <div class="tk-card">
        <div class="tk-t">Need help?</div>
        <button class="tk-btn" tabindex="-1" type="button"><Icon name="ph:ticket-fill" width="15" height="15" />{c.tickets.button}<i class="ripple"></i></button>
      </div>
      <div class="sys sys-1">{c.tickets.opened}</div>
      <div class="sys sys-2"><Icon name="ph:check-circle-fill" width="14" height="14" />{c.tickets.joined}</div>
    </div>
  </article>
</div>

<style>
  .scenes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .scene { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 24px; background: var(--card); overflow: hidden; }
  .scene-copy { padding: 26px 26px 0; }
  .chip { display: inline-flex; align-items: center; gap: 7px; padding: 5px 12px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-text); font-size: 12.5px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
  .scene h3 { margin: 16px 0 8px; font-size: 21px; line-height: 1.25; }
  .scene p { margin: 0; color: var(--text-muted); font-size: 14.5px; line-height: 1.6; }
  .stage { position: relative; margin-top: 24px; flex: 1; min-height: 232px; padding: 20px 20px 22px; border-top: 1px solid var(--border-soft);
    background: radial-gradient(120% 90% at 50% 0%, var(--ash-glow, transparent), transparent 70%), var(--bg-raise); display: flex; flex-direction: column; gap: 14px; justify-content: center; overflow: hidden; }
  .av { width: 34px; height: 34px; border-radius: 50%; flex: none; object-fit: cover; background: var(--border); }

  .lvl-row { display: flex; align-items: center; gap: 12px; padding: 14px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); }
  .lvl-main { flex: 1; min-width: 0; } .lvl-main b { font-size: 14px; }
  .bar { height: 9px; margin: 9px 0 7px; border-radius: 999px; background: var(--border-soft); overflow: hidden; }
  .fill { display: block; height: 100%; width: 64%; border-radius: inherit; background: var(--green); }
  .xp { font-family: var(--mono); font-size: 12px; color: var(--text-dim); }
  .toast { display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; padding: 9px 14px; border-radius: 12px; background: var(--green-soft); color: var(--green-text); border: 1px solid color-mix(in srgb, var(--green) 40%, transparent); font-size: 13.5px; font-weight: 600; }

  .tk-card { padding: 16px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); }
  .tk-t { font-family: var(--serif); font-weight: 600; font-size: 16px; margin-bottom: 12px; }
  .tk-btn { position: relative; overflow: hidden; display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border: 0; border-radius: 9px; background: var(--accent); color: var(--accent-ink); font: 700 13.5px var(--sans); cursor: default; }
  .ripple { position: absolute; inset: 0; border-radius: inherit; background: rgba(255, 255, 255, 0.5); opacity: 0; }
  .sys { display: flex; align-items: center; gap: 7px; font-size: 13px; color: var(--text-muted); } .sys :global(svg) { color: var(--green); }

  /* The loops: 8 seconds, every scene starts from nothing and builds up. Without motion the base styles above (the final state) are what shows. */
  @media (prefers-reduced-motion: no-preference) {
    .fill { animation: lFill 8s ease-in-out infinite; }
    .toast { animation: lToast 8s cubic-bezier(.34, 1.56, .64, 1) infinite; }
    .tk-btn { animation: tPress 8s ease-in-out infinite; }
    .ripple { animation: tRipple 8s ease-out infinite; }
    .sys-1 { animation: tSys1 8s ease-out infinite; }
    .sys-2 { animation: tSys2 8s ease-out infinite; }
  }
  @keyframes lFill { 0% { width: 6%; } 50%, 100% { width: 100%; } }
  @keyframes lToast { 0%, 52% { opacity: 0; transform: translateY(10px) scale(.9); } 62%, 92% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  @keyframes tPress { 0%, 18% { transform: none; } 22% { transform: scale(.95); } 28%, 100% { transform: none; } }
  @keyframes tRipple { 0%, 20% { opacity: 0; transform: scale(.6); } 22% { opacity: .55; } 40%, 100% { opacity: 0; transform: scale(1.1); } }
  @keyframes tSys1 { 0%, 28% { opacity: 0; transform: translateY(8px); } 38%, 92% { opacity: 1; transform: none; } 100% { opacity: 0; } }
  @keyframes tSys2 { 0%, 56% { opacity: 0; transform: translateY(8px); } 66%, 92% { opacity: 1; transform: none; } 100% { opacity: 0; } }

  @media (max-width: 760px) { .scenes { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; } }
</style>
