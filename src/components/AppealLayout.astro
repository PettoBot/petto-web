---
// The frame of the public appeal site: a little console whose colors the server picks, and the tags of the link preview.
import { themeFor, safeUrl, type AppealConfig } from '../utils/appeals';
import { appealText, type AppealLang, APPEAL_LANGS } from '../i18n/appeal';

interface Props {
  lang: AppealLang; config: Pick<AppealConfig, 'brand'>; guild: { id: string; name: string; icon: string | null };
  preview: { title: string; description: string; image: string | null; color: string; siteName: string };
}
const { lang, config, guild, preview } = Astro.props;
const t = appealText(lang);
const theme = themeFor(config.brand);
const banner = safeUrl(config.brand?.banner_url);
const icon = safeUrl(config.brand?.icon_url) ?? guild.icon;
const siteName = (config.brand?.name || guild.name).slice(0, 60);
const langLabels: Record<AppealLang, string> = { en: 'EN', es: 'ES', 'pt-BR': 'PT' };
const here = Astro.url.pathname;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://petto.sbs').toString();
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{preview.title}</title>
  <meta name="description" content={preview.description} />
  <meta name="theme-color" content={preview.color} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={icon ?? '/assets/mascot-icon.png'} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={preview.title} />
  <meta property="og:description" content={preview.description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={preview.siteName} />
  {preview.image && <meta property="og:image" content={preview.image} />}
  <meta name="twitter:card" content={preview.image ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={preview.title} />
  <meta name="twitter:description" content={preview.description} />
  {preview.image && <meta name="twitter:image" content={preview.image} />}
  <meta name="robots" content="noindex" />
  <style is:global set:html={`
    @font-face { font-family: 'Jakarta Variable'; src: url('/fonts/dash/plus-jakarta-sans-latin-wght-normal.woff2') format('woff2-variations'); font-weight: 200 800; font-display: swap; unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122; }
    @font-face { font-family: 'Jakarta Variable'; src: url('/fonts/dash/plus-jakarta-sans-latin-ext-wght-normal.woff2') format('woff2-variations'); font-weight: 200 800; font-display: swap; unicode-range: U+0100-02BA, U+1E00-1EFF, U+2C60-2C7F, U+A720-A7FF; }
    @font-face { font-family: 'Fraunces Variable'; src: url('/fonts/dash/fraunces-latin-wght-normal.woff2') format('woff2-variations'); font-weight: 100 900; font-display: swap; unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122; }
    @font-face { font-family: 'Fraunces Variable'; src: url('/fonts/dash/fraunces-latin-ext-wght-normal.woff2') format('woff2-variations'); font-weight: 100 900; font-display: swap; unicode-range: U+0100-02BA, U+1E00-1EFF, U+2C60-2C7F, U+A720-A7FF; }
  `} />
</head>
<body class="ap" style={`--accent:${theme.accent}`}>
  <div class="ap-shell">
    <header class="ap-top">
      <a class="ap-brand" href={`/appeal/${guild.id}`}><img src={icon ?? '/assets/mascot-icon.webp'} alt="" width="34" height="34" /><span>{siteName}</span></a>
      <nav class="ap-langs" aria-label="Language">
        {APPEAL_LANGS.map((l) => <a href={`${here}?lang=${l}`} class:list={['ap-lang', { on: l === lang }]} hreflang={l}>{langLabels[l]}</a>)}
      </nav>
    </header>
    <main class="ap-screen">
      {banner && <div class="ap-banner" style={`background-image:url(${JSON.stringify(banner)})`}></div>}
      <div class="ap-inner"><slot /></div>
    </main>
    <footer class="ap-foot"><a href="https://petto.sbs" rel="noopener"><img src="/assets/mascot-icon.webp" alt="" width="18" height="18" />{t('madeWith')}</a></footer>
  </div>
</body>
</html>
<style is:global>
  .ap-ico { display: inline-block; vertical-align: -3px; margin-right: 8px; color: var(--accent, #f0a88f); }
  .ap { --bg: #18191d; --raise: #1e2024; --card: #212328; --border: #34373e; --text: #d6d3cc; --muted: #9b978f; --dim: #6e6a63; --accent-ink: #2b1a13; --green: #a5ea7a; --yellow: #fed53c; --red: #fe6465;
    margin: 0; min-height: 100vh; background: var(--bg); color: var(--text); font-family: 'Jakarta Variable', -apple-system, system-ui, sans-serif; font-size: 14px; line-height: 1.55; -webkit-font-smoothing: antialiased; }
  @media (prefers-color-scheme: light) { .ap { --bg: #f4f5f7; --raise: #fff; --card: #fff; --border: #e3e6eb; --text: #20242b; --muted: #66707d; --dim: #8c96a3; --accent-ink: #fff; } }
  .ap *, .ap *::before, .ap *::after { box-sizing: border-box; }
  .ap-shell { max-width: 720px; margin: 0 auto; padding: 18px 14px 40px; }
  .ap-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .ap-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--text); font-family: 'Fraunces Variable', Georgia, serif; font-weight: 600; font-size: 18px; min-width: 0; }
  .ap-brand img { border-radius: 10px; flex: none; object-fit: cover; }
  .ap-brand span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ap-langs { display: flex; gap: 4px; }
  .ap-lang { text-decoration: none; font-size: 12px; font-weight: 600; padding: 5px 9px; border-radius: 8px; color: var(--muted); border: 1px solid transparent; }
  .ap-lang:hover { color: var(--text); } .ap-lang.on { color: var(--text); background: color-mix(in srgb, var(--accent) 14%, transparent); border-color: color-mix(in srgb, var(--accent) 40%, transparent); }
  .ap-screen { position: relative; background: var(--card); border: 1px solid var(--border); border-radius: 18px; overflow: hidden; margin-bottom: 24px; }
  .ap-banner { height: 130px; background-size: cover; background-position: center; border-bottom: 1px solid var(--border); }
  .ap-inner { padding: 22px 20px 26px; display: flex; flex-direction: column; gap: 18px; }
  .ap h1, .ap h2 { font-family: 'Fraunces Variable', Georgia, serif; font-weight: 600; letter-spacing: -0.015em; margin: 0; color: var(--text); }
  .ap h1 { font-size: 24px; line-height: 1.2; } .ap h2 { font-size: 17px; }
  .ap h3 { margin: 0; font-size: 14px; font-weight: 700; }
  .ap p { margin: 0; }
  .ap-muted { color: var(--muted); font-size: 13px; }
  .ap-server { display: flex; align-items: center; gap: 14px; }
  .ap-server img { width: 58px; height: 58px; border-radius: 16px; border: 1px solid var(--border); background: var(--raise); object-fit: cover; flex: none; }
  .ap-card { background: var(--raise); border: 1px solid var(--border); border-radius: 13px; padding: 13px 15px; display: flex; flex-direction: column; gap: 7px; }
  .ap-card.soft { background: transparent; }
  .ap-card.warn { background: color-mix(in srgb, var(--yellow) 10%, transparent); border-color: color-mix(in srgb, var(--yellow) 45%, transparent); }
  .ap-card.bad { background: color-mix(in srgb, var(--red) 10%, transparent); border-color: color-mix(in srgb, var(--red) 45%, transparent); }
  .ap-card.good { background: color-mix(in srgb, var(--green) 10%, transparent); border-color: color-mix(in srgb, var(--green) 45%, transparent); }
  a.ap-card { color: inherit; transition: border-color .15s; } a.ap-card:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); }
  .ap-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .ap-list { display: flex; flex-direction: column; gap: 10px; }
  .ap-chip { display: inline-flex; align-items: center; font-size: 10.5px; font-weight: 700; letter-spacing: .05em; padding: 3px 9px; border-radius: 999px; border: 1px solid var(--border); background: var(--card); color: var(--muted); text-transform: uppercase; }
  .ap-chip.pending { color: var(--yellow); border-color: color-mix(in srgb, var(--yellow) 45%, transparent); background: color-mix(in srgb, var(--yellow) 10%, transparent); }
  .ap-chip.accepted { color: var(--green); border-color: color-mix(in srgb, var(--green) 45%, transparent); background: color-mix(in srgb, var(--green) 10%, transparent); }
  .ap-chip.rejected { color: var(--red); border-color: color-mix(in srgb, var(--red) 45%, transparent); background: color-mix(in srgb, var(--red) 10%, transparent); }
  .ap-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; font: 600 13.5px 'Jakarta Variable', sans-serif; text-decoration: none; cursor: pointer; padding: 9px 16px; border-radius: 10px; border: 1px solid transparent; background: var(--accent); color: var(--accent-ink); transition: filter .15s, transform .15s; }
  .ap-btn:hover { filter: brightness(1.07); } .ap-btn:active { transform: scale(.98); }
  .ap-btn.sec { background: var(--raise); color: var(--text); border-color: var(--border); }
  .ap-btn.ghost { background: transparent; color: var(--muted); padding: 5px 4px; } .ap-btn.ghost:hover { color: var(--text); }
  .ap-btn[disabled], .ap-btn.off { opacity: .45; pointer-events: none; }
  .ap-field { display: flex; flex-direction: column; gap: 6px; }
  .ap-q { font-weight: 600; font-size: 13.5px; }
  .ap-help { font-size: 12px; color: var(--muted); font-weight: 400; }
  .ap-req { color: var(--accent); font-weight: 700; margin-left: 3px; }
  .ap-input, .ap-area { width: 100%; font: 400 13.5px 'Jakarta Variable', sans-serif; color: var(--text); background: var(--raise); border: 1px solid var(--border); border-radius: 10px; padding: 9px 12px; outline: none; transition: border-color .15s, box-shadow .15s; }
  .ap-area { min-height: 120px; resize: vertical; }
  .ap-input:focus, .ap-area:focus { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent); }
  .ap-field.err .ap-input, .ap-field.err .ap-area { border-color: var(--red); } .ap-err { color: var(--red); font-size: 12px; font-weight: 600; }
  .ap-opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .ap-opt { position: relative; } .ap-opt input { position: absolute; opacity: 0; inset: 0; cursor: pointer; }
  .ap-opt span { display: inline-block; padding: 7px 13px; border-radius: 10px; border: 1px solid var(--border); background: var(--raise); font-weight: 500; font-size: 13px; }
  .ap-opt input:checked + span { background: color-mix(in srgb, var(--accent) 16%, transparent); border-color: var(--accent); color: var(--text); }
  .ap-opt input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ap-sec { border-top: 1px solid var(--border); padding-top: 16px; display: flex; flex-direction: column; gap: 14px; }
  .ap-step { font: 700 10.5px 'Jakarta Variable', sans-serif; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }
  .ap-chat { display: flex; flex-direction: column; gap: 10px; }
  .ap-msg { max-width: 88%; padding: 9px 13px; border-radius: 14px; border: 1px solid var(--border); background: var(--raise); display: flex; flex-direction: column; gap: 3px; white-space: pre-wrap; word-break: break-word; }
  .ap-msg small { font-weight: 700; font-size: 10.5px; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); }
  .ap-msg.user { align-self: flex-end; background: color-mix(in srgb, var(--accent) 12%, var(--raise)); border-color: color-mix(in srgb, var(--accent) 35%, var(--border)); }
  .ap-msg.system { align-self: center; background: transparent; border-style: dashed; max-width: 100%; text-align: center; color: var(--muted); }
  .ap-answer { padding: 10px 0; border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: 3px; } .ap-answer:last-child { border-bottom: 0; }
  .ap-answer b { font-size: 12.5px; color: var(--muted); font-weight: 600; } .ap-answer span { white-space: pre-wrap; word-break: break-word; }
  .ap-foot { text-align: center; } .ap-foot a { display: inline-flex; align-items: center; gap: 7px; color: var(--dim); font-size: 12px; text-decoration: none; } .ap-foot a:hover { color: var(--muted); }
  .ap-screen a:not(.ap-btn):not(.ap-card) { color: var(--accent); }
  @media (max-width: 560px) { .ap-inner { padding: 18px 14px 22px; } .ap h1 { font-size: 22px; } .ap-msg { max-width: 96%; } }
  @media (prefers-reduced-motion: reduce) { .ap-btn, a.ap-card { transition: none; } }
</style>
