  :global(.shard-card) { position: relative; border: 1px solid color-mix(in srgb, var(--tier) 45%, var(--border)); border-radius: 14px; padding: 16px 18px; background: color-mix(in srgb, var(--tier) 8%, var(--card)); outline: none; transition: border-color 0.15s ease, background 0.15s ease; }
