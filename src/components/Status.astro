  :global(.tier-dot) { width: 10px; height: 10px; border-radius: 3px; background: var(--tier, var(--text-dim)); flex-shrink: 0; }
  .tier-legend { list-style: none; margin: 0 0 12px; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 12.5px; color: var(--text-dim); }
