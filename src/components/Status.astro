---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { useTranslations, localePath, type Locale } from '../i18n/ui';
import { getEnv } from '../utils/env';
import { getStatusHistory, startedDay, type StatusHistory } from '../utils/statusHistory';
import { incidentDays } from '../utils/statusDays.mjs';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const s = t.simplePages.status;
const localeBase = localePath[lang] ?? '';

// The status page reads the Discloud-backed primary through the private bot API.
// Browser polling goes through the web Worker so the dashboard secret never leaves it.
const statusEndpoint = new URL('/api/status', Astro.url).pathname;
const searchEndpoint = new URL('/api/status-search', Astro.url).pathname;

const STALE_MS = 5 * 60 * 1000;

async function botApiGet(table: string) {
  const url = getEnv(Astro, 'PETTO_BOT_API_URL');
  const key = getEnv(Astro, 'PETTO_BOT_API_SECRET');
  if (!url || !key) return null;
  try {
    const res = await fetch(`${url}/rest/v1/${table}?select=*`, {
      headers: {
        apikey: key,
        Authorization: `Bearer ${key}`,
        'X-Petto-Dashboard-Key': key,
      },
    });
    if (!res.ok) return null;
    const rows = await res.json();
    return Array.isArray(rows) && rows.length > 0 ? rows : null;
  } catch {
    return null;
  }
}

function bucket(rawStatus: string, updatedAt: string, now: number) {
  const staleAt = new Date(updatedAt).getTime() + STALE_MS;
  if (staleAt < now) return 'offline';
  if (rawStatus === 'Ready') return 'operational';
  if (rawStatus === 'Disconnected') return 'offline';
  return 'reconnecting';
}

function formatUptime(totalSeconds: number) {
  const d = Math.floor(totalSeconds / 86400);
  const h = Math.floor((totalSeconds % 86400) / 3600);
  const m = Math.floor((totalSeconds % 3600) / 60);
  if (d > 0) return `${d}d ${h}h`;
  if (h > 0) return `${h}h ${m}m`;
  return `${m}m`;
}

// The history of every service (90 UTC days) and what each one is doing now: read from the database at most once a minute (statusHistory.ts).
const history: StatusHistory = await getStatusHistory(Astro).catch(() => ({ available: false, generatedAt: new Date().toISOString(), startedAt: null, days: [], services: [], incidents: [] }));
const historyEndpoint = new URL('/api/status-history', Astro.url).pathname;
const serviceNames: Record<string, string> = { bot: s.svcBot, site: s.svcSite, database: s.svcDatabase };
const nowLabel: Record<string, string> = { up: s.shardOperational, degraded: s.nowDegraded, down: s.nowDown, unknown: s.nowUnknown };
const overallOf = (h: StatusHistory) => {
  const states = h.services.map((svc) => svc.now);
  if (!h.available || !states.length || states.every((state) => state === 'unknown')) return 'unknown';
  return states.includes('down') ? 'down' : states.includes('degraded') ? 'degraded' : 'up';
};
const overall = overallOf(history);
const headingFor = (state: string) => (state === 'down' ? s.headingDown : state === 'degraded' ? s.headingDegraded : state === 'unknown' ? s.headingUnknown : s.heading);
const dateLocale = lang === 'pt-BR' ? 'pt-BR' : lang;
const dayLabel = (day: string) => new Date(`${day}T00:00:00Z`).toLocaleDateString(dateLocale, { timeZone: 'UTC', day: 'numeric', month: 'short', year: 'numeric' });
const fill = (text: string, values: Record<string, string | number>) => text.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? ''));
const started = startedDay(history);
const barClass = (state: string) => (state === 'down' ? 'down' : state === 'warn' ? 'warn' : state === 'nodata' ? 'none' : 'up');
const barTip = (mark: { d: string; s: string; c?: number; dm?: number; um?: number; gm?: number }) => {
  const lines = [dayLabel(mark.d)];
  if (mark.s === 'pre') lines.push(started ? fill(s.tipPre, { date: dayLabel(started) }) : s.startingNote);
  else if (mark.s === 'nodata') lines.push(s.tipNone);
  else if (mark.s === 'up') lines.push(s.tipUp);
  else {
    if (mark.dm) lines.push(fill(s.tipDown, { n: mark.dm }));
    if (mark.um) lines.push(fill(s.tipUnconfirmed, { n: mark.um }));
    if (mark.gm) lines.push(fill(s.tipGap, { n: mark.gm }));
  }
  if (mark.c) lines.push(fill(s.tipChecks, { n: mark.c }));
  return lines.join('\n');
};
const incidentText = (inc: { kind: string; minutes: number; unconfirmed: number }) =>
  inc.kind === 'down' ? fill(s.incDown, { n: inc.minutes }) : inc.kind === 'nodata' ? s.incNone : inc.minutes && !inc.unconfirmed ? fill(s.incGap, { n: inc.minutes }) : s.incWarn;
const clientText = { incidentNoneDay: s.incidentNoneDay, incidentNoneToday: s.incidentNoneToday, up: s.shardOperational, degraded: s.nowDegraded, down: s.nowDown, unknown: s.nowUnknown, tipPre: s.tipPre, startingNote: s.startingNote, tipNone: s.tipNone, tipUp: s.tipUp, tipDown: s.tipDown, tipUnconfirmed: s.tipUnconfirmed, tipGap: s.tipGap, tipChecks: s.tipChecks, daysAgo: s.daysAgo, today: s.today, headingOk: s.heading, headingDegraded: s.headingDegraded, headingDown: s.headingDown, headingUnknown: s.headingUnknown, startedNote: s.startedNote, incDown: s.incDown, incWarn: s.incWarn, incGap: s.incGap, incNone: s.incNone, incidentsNone: s.incidentsNone, unavailable: s.histUnavailable, svcBot: s.svcBot, svcSite: s.svcSite, svcDatabase: s.svcDatabase };
// Like "Past incidents" of Discord Status: the last 14 days, each with what happened or a line that says nothing did.
const incidentList = incidentDays(history.days, history.incidents, started, 14);
const noteOf = (inc: { note?: Record<string, string> }) => inc.note?.[lang] ?? inc.note?.en ?? '';
const now = Date.now();
const shardRows = await botApiGet('bot_status');
// The colour of a shard card follows its ping (green up to 50 ms, yellow up to 150, orange up to 300, red above that or when it is offline).
// The same rule is in the script below, which redraws the cards every 10 seconds.
function tierOf(state: string, ping: number | null | undefined) {
  if (state === 'offline') return 'down';
  if (state === 'reconnecting') return 'slow';
  if (ping === null || ping === undefined || !Number.isFinite(Number(ping))) return 'unknown';
  return Number(ping) <= 50 ? 'good' : Number(ping) <= 150 ? 'warn' : Number(ping) <= 300 ? 'slow' : 'down';
}
const shards = shardRows
  ? (shardRows as any[]).sort((a, b) => a.shard_id - b.shard_id).map((r) => {
      const state = bucket(r.status, r.updated_at, now);
      return { id: r.shard_id, guildCount: r.guild_count, members: r.member_count ?? null, ping: r.ping_ms, state, tier: tierOf(state, r.ping_ms), cluster: r.cluster_name ?? null, place: r.cluster_location ?? null };
    })
  : null;
const numberFormat = new Intl.NumberFormat(lang === 'pt-BR' ? 'pt-BR' : lang);
const clusterText = (name: string | null, place: string | null) => [name, place].filter(Boolean).join(' · ');

// The servers of every shard that is running now, the same count the home page shows.
const totalServers = shards ? shards.filter((sh) => sh.state !== 'offline').reduce((total, sh) => total + (Number(sh.guildCount) || 0), 0) : null;

const hostRows = await botApiGet('bot_host');
const host = hostRows ? hostRows[0] : null;

const stateLabel: Record<string, string> = {
  operational: s.shardOperational,
  offline: s.shardOffline,
  reconnecting: s.shardReconnecting,
};
---
<Base title={`${s.title} · Petto`} lang={lang}>
  <main>
    <section class="status-sec">
      <div class="wrap status-wrap">
        <div class="eyebrow">{s.pill}</div>
        <h1 id="statusHeading"><span class:list={['status-hero-dot', overall]}></span><span id="statusHeadingText">{headingFor(overall)}</span></h1>
        <p class="status-desc">{s.desc}</p>

        <div
          id="statusBlock"
          data-status-endpoint={statusEndpoint}
          data-stale-ms={STALE_MS}
          data-label-operational={s.shardOperational}
          data-label-offline={s.shardOffline}
          data-label-reconnecting={s.shardReconnecting}
          data-label-servers={s.guildsCol}
          data-label-ping={s.pingCol}
          data-label-nodata={s.noShardData}
          data-label-shard={s.shardName}
          data-label-uptime={s.uptimeLabel}
          data-label-members={s.membersCol}
          data-label-state={s.statusCol}
          data-label-cluster={s.clusterLabel}
          data-locale={lang === 'pt-BR' ? 'pt-BR' : lang}
        >
          <div class="status-block-head">
            <span class="status-block-label">{s.shardsTitle}</span>
            <span class="live-badge" id="liveBadge"><span class="live-dot"></span>{s.live}</span>
          </div>

          <div class="status-total">
            <span class="n" id="statusTotal">{totalServers ?? '-'}</span>
            <span class="l">{s.totalServers}</span>
          </div>

          <form class="status-search" id="statusSearch" role="search" data-endpoint={searchEndpoint} data-short={s.searchShort} data-empty={s.searchEmpty} data-error={s.searchError} data-limited={s.searchLimited} data-offline={s.shardOffline} data-operational={s.shardOperational} data-reconnecting={s.shardReconnecting} data-shard={s.shardName}>
            <label for="statusSearchInput" class="status-block-label">{s.searchTitle}</label>
            <div class="status-search-row">
              <Icon name="ph:magnifying-glass" class="status-search-ic" />
              <input id="statusSearchInput" type="search" name="q" autocomplete="off" maxlength="100" placeholder={s.searchPlaceholder} />
            </div>
            <p class="status-search-hint" id="statusSearchHint">{s.searchHint}</p>
            <ul class="status-search-results" id="statusSearchResults" aria-live="polite"></ul>
          </form>

          <ul class="tier-legend" aria-label={s.legendTitle}>
            <li><span class="tier-dot good"></span>{s.tierGood}</li>
            <li><span class="tier-dot warn"></span>{s.tierWarn}</li>
            <li><span class="tier-dot slow"></span>{s.tierSlow}</li>
            <li><span class="tier-dot down"></span>{s.tierDown}</li>
          </ul>

          <div id="shardsContent" class="shard-grid">
            {shards ? (
              shards.map((sh) => (
                <div class="shard-card" data-shard-id={sh.id} data-tier={sh.tier} tabindex="0">
                  <div class="shard-card-head">
                    <span class="tier-dot" aria-hidden="true"></span>
                    <span class="shard-name">{s.shardName} {Number(sh.id) + 1}</span>
                    <span class:list={['status-pill', sh.state]}>{stateLabel[sh.state] ?? s.shardUnknown}</span>
                  </div>
                  <div class="shard-card-stats">
                    <div class="shard-stat"><span class="n">{sh.guildCount}</span><span class="l">{s.guildsCol}</span></div>
                    <div class="shard-stat"><span class="n">{sh.ping != null ? `${sh.ping}` : 'n/a'}<em>ms</em></span><span class="l">{s.pingCol}</span></div>
                  </div>
                  <dl class="shard-tip" role="tooltip">
                    <div><dt>{s.guildsCol}</dt><dd>{numberFormat.format(Number(sh.guildCount) || 0)}</dd></div>
                    {sh.members != null && <div><dt>{s.membersCol}</dt><dd>{numberFormat.format(Number(sh.members) || 0)}</dd></div>}
                    <div><dt>{s.pingCol}</dt><dd>{sh.ping != null ? `${sh.ping} ms` : 'n/a'} · {stateLabel[sh.state] ?? s.shardUnknown}</dd></div>
                    {clusterText(sh.cluster, sh.place) && <div><dt>{s.clusterLabel}</dt><dd>{clusterText(sh.cluster, sh.place)}</dd></div>}
                  </dl>
                </div>
              ))
            ) : (
              <p class="no-shard-data">{s.noShardData}</p>
            )}
          </div>

          <div class="status-block-label host-label">{s.hostTitle}</div>
          <div id="hostContent" class="host-card">
            {host ? (
              <>
                <div class="shard-stat"><span class="n">{formatUptime(host.uptime_seconds)}</span><span class="l">{s.uptimeLabel}</span></div>
                <div class="shard-stat"><span class="n">{host.node_version}</span><span class="l">{s.nodeLabel}</span></div>
              </>
            ) : (
              <p class="no-shard-data">{s.noShardData}</p>
            )}
          </div>
        </div>

        <div class="hist" id="statusHistory" data-endpoint={historyEndpoint} data-locale={dateLocale} data-text={JSON.stringify(clientText)} data-period="90">
          <div class="hist-head">
            <h2 class="hist-title">{s.histTitle}</h2>
            <label class="hist-period">
              <span class="sr-only">{s.periodLabel}</span>
              <select id="histPeriod" aria-label={s.periodLabel}>
                <option value="90" selected>{s.period90}</option>
                <option value="60">{s.period60}</option>
                <option value="30">{s.period30}</option>
              </select>
            </label>
          </div>
          {!history.available && <p class="hist-problem" role="status">{s.histUnavailable}</p>}
          <div class="hist-cards" id="histCards">
            {history.services.map((svc) => (
              <article class="hist-card" data-svc={svc.id}>
                <header class="hist-card-head">
                  <h3>{serviceNames[svc.id]}</h3>
                  <span class={`hist-now ${svc.now}`}>{nowLabel[svc.now]}</span>
                </header>
                <div class="bars" role="img" aria-label={fill(s.serviceHistory, { n: 90 })}>
                  {svc.marks.map((mark) => <i class={`b ${barClass(mark.s)}${mark.s === 'pre' ? ' pre' : ''}`} data-d={mark.d} data-tip={barTip(mark)}></i>)}
                </div>
                <div class="bars-axis"><span data-axis-start>{fill(s.daysAgo, { n: 90 })}</span><span>{s.today}</span></div>
              </article>
            ))}
          </div>
          <div class="hist-tip" id="histTip" role="tooltip" hidden></div>
          <ul class="hist-legend">
            <li><i class="b up"></i>{s.legendUp}</li>
            <li><i class="b warn"></i>{s.legendWarn}</li>
            <li><i class="b down"></i>{s.legendDown}</li>
            <li><i class="b none"></i>{s.legendNone}</li>
          </ul>
          <p class="hist-note">{s.histNote}</p>
          <p class="hist-meta"><span>{s.everyTwo}</span>{history.available && <span id="histStarted"> · {started ? fill(s.startedNote, { date: dayLabel(started) }) : s.startingNote}</span>}</p>
          <h2 class="hist-title hist-incidents-title">{s.incidentsTitle}</h2>
          <div class="hist-incidents" id="histIncidents">
            {history.available && incidentList.map((entry) => (
              <div class="inc-day">
                <h3>{dayLabel(entry.day)}</h3>
                {entry.incidents.length === 0
                  ? <p class="inc-none">{entry.today ? s.incidentNoneToday : s.incidentNoneDay}</p>
                  : <ul>{entry.incidents.map((inc) => <li class={inc.kind}><i class={`b ${barClass(inc.kind)}`}></i><div><b>{serviceNames[inc.service]}</b><em>{incidentText(inc)}</em>{noteOf(inc) && <p>{noteOf(inc)}</p>}</div></li>)}</ul>}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import { incidentDays } from '../utils/statusDays.mjs';
  // The history follows the real state: it asks again every minute (the answer is kept a minute on the server), changes the cards, the bars,
  // the heading and the incidents, and the period selector shows the last 30, 60 or 90 days. Everything is written as text, never as HTML.
  const hist = document.getElementById('statusHistory');
  if (hist) {
    const text: Record<string, string> = JSON.parse(hist.dataset.text || '{}');
    const locale = hist.dataset.locale || 'en';
    const tip = document.getElementById('histTip')!;
    const cards = document.getElementById('histCards')!;
    const select = document.getElementById('histPeriod') as HTMLSelectElement;
    const fill = (template: string, values: Record<string, string | number>) => template.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? ''));
    const dayLabel = (day: string) => new Date(`${day}T00:00:00Z`).toLocaleDateString(locale, { timeZone: 'UTC', day: 'numeric', month: 'short', year: 'numeric' });
    const barClass = (state: string) => (state === 'down' ? 'down' : state === 'warn' ? 'warn' : state === 'nodata' ? 'none' : 'up');
    let started: string | null = null;

    function tipFor(mark: any) {
      const lines = [dayLabel(mark.d)];
      if (mark.s === 'pre') lines.push(started ? fill(text.tipPre, { date: dayLabel(started) }) : text.startingNote);
      else if (mark.s === 'nodata') lines.push(text.tipNone);
      else if (mark.s === 'up') lines.push(text.tipUp);
      else {
        if (mark.dm) lines.push(fill(text.tipDown, { n: mark.dm }));
        if (mark.um) lines.push(fill(text.tipUnconfirmed, { n: mark.um }));
        if (mark.gm) lines.push(fill(text.tipGap, { n: mark.gm }));
      }
      if (mark.c) lines.push(fill(text.tipChecks, { n: mark.c }));
      return lines.join('\n');
    }

    function applyPeriod() {
      const n = Number(select.value) || 90;
      hist!.dataset.period = String(n);
      cards.querySelectorAll('.bars').forEach((bars) => {
        const items = Array.from(bars.children) as HTMLElement[];
        items.forEach((bar, index) => { bar.hidden = index < items.length - n; });
      });
      cards.querySelectorAll('[data-axis-start]').forEach((label) => { label.textContent = fill(text.daysAgo, { n }); });
    }

    function render(data: any) {
      if (!Array.isArray(data?.services)) return;
      started = data.startedAt ? String(data.startedAt).slice(0, 10) : null;
      const states: string[] = [];
      for (const svc of data.services) {
        const card = cards.querySelector<HTMLElement>(`[data-svc="${svc.id}"]`);
        if (!card) continue;
        states.push(svc.now);
        const now = card.querySelector('.hist-now');
        if (now) { now.className = `hist-now ${svc.now}`; now.textContent = text[svc.now] ?? ''; }
        const bars = card.querySelector('.bars')!;
        const fragment = document.createDocumentFragment();
        for (const mark of svc.marks) {
          const bar = document.createElement('i');
          bar.className = `b ${barClass(mark.s)}${mark.s === 'pre' ? ' pre' : ''}`;
          bar.dataset.d = mark.d;
          bar.dataset.tip = tipFor(mark);
          fragment.appendChild(bar);
        }
        bars.replaceChildren(fragment);
      }
      const overall = !data.available || !states.length || states.every((state) => state === 'unknown') ? 'unknown' : states.includes('down') ? 'down' : states.includes('degraded') ? 'degraded' : 'up';
      const headingText = document.getElementById('statusHeadingText');
      const dot = document.querySelector('#statusHeading .status-hero-dot');
      if (headingText) headingText.textContent = ({ up: text.headingOk, degraded: text.headingDegraded, down: text.headingDown, unknown: text.headingUnknown } as Record<string, string>)[overall] ?? '';
      if (dot) dot.className = `status-hero-dot ${overall}`;
      const startedNote = document.getElementById('histStarted');
      if (startedNote) startedNote.textContent = data.available ? ` · ${started ? fill(text.startedNote, { date: dayLabel(started) }) : text.startingNote}` : '';
      const list = document.getElementById('histIncidents');
      if (list) {
        const names: Record<string, string> = { bot: text.svcBot, site: text.svcSite, database: text.svcDatabase };
        const sections: HTMLElement[] = [];
        if (data.available) {
          for (const entry of incidentDays(data.days ?? [], data.incidents ?? [], started, 14)) {
            const section = document.createElement('div'); section.className = 'inc-day';
            const heading = document.createElement('h3'); heading.textContent = dayLabel(entry.day);
            section.append(heading);
            if (!entry.incidents.length) {
              const none = document.createElement('p'); none.className = 'inc-none'; none.textContent = entry.today ? text.incidentNoneToday : text.incidentNoneDay;
              section.append(none);
            } else {
              const ul = document.createElement('ul');
              for (const inc of entry.incidents) {
                const li = document.createElement('li');
                li.className = inc.kind;
                const dotEl = document.createElement('i'); dotEl.className = `b ${barClass(inc.kind)}`;
                const name = document.createElement('b'); name.textContent = names[inc.service] ?? '';
                const what = document.createElement('em');
                what.textContent = inc.kind === 'down' ? fill(text.incDown, { n: inc.minutes }) : inc.kind === 'nodata' ? text.incNone : inc.minutes && !inc.unconfirmed ? fill(text.incGap, { n: inc.minutes }) : text.incWarn;
                const main = document.createElement('div'); main.append(name, what);
                const note = inc.note?.[locale] ?? inc.note?.en;
                if (note) { const paragraph = document.createElement('p'); paragraph.textContent = note; main.append(paragraph); }
                li.append(dotEl, main);
                ul.append(li);
              }
              section.append(ul);
            }
            sections.push(section);
          }
        }
        list.replaceChildren(...sections);
      }
      applyPeriod();
    }

    let current: HTMLElement | null = null;
    function showTip(bar: HTMLElement) {
      if (!bar.dataset.tip) return;
      current = bar;
      tip.textContent = bar.dataset.tip;
      tip.hidden = false;
      tip.style.left = '0px'; tip.style.top = '0px';
      const box = hist!.getBoundingClientRect();
      const rect = bar.getBoundingClientRect();
      const width = tip.offsetWidth;
      const left = Math.min(Math.max(rect.left + rect.width / 2 - box.left - width / 2, 0), Math.max(0, box.width - width));
      tip.style.left = `${left}px`;
      tip.style.top = `${rect.top - box.top - tip.offsetHeight - 8}px`;
    }
    const hideTip = () => { tip.hidden = true; current = null; };
    cards.addEventListener('pointerover', (event) => { const bar = (event.target as HTMLElement).closest<HTMLElement>('.b'); if (bar && (event as PointerEvent).pointerType !== 'touch') showTip(bar); });
    cards.addEventListener('pointerleave', hideTip);
    cards.addEventListener('click', (event) => { const bar = (event.target as HTMLElement).closest<HTMLElement>('.b'); if (!bar) return hideTip(); if (current === bar) hideTip(); else showTip(bar); });
    document.addEventListener('click', (event) => { if (!(event.target as HTMLElement).closest('#histCards')) hideTip(); });
    select.addEventListener('change', () => { hideTip(); applyPeriod(); });

    async function refresh() {
      try {
        const response = await fetch(hist!.dataset.endpoint!, { headers: { Accept: 'application/json' } });
        if (response.ok) render(await response.json());
      } catch { /* the last values stay on the screen */ }
    }
    applyPeriod();
    window.setInterval(refresh, 60_000);
    // The server paints the first state; the tooltips of that first paint were written there with the date of the first check.
    refresh();
  }
</script>

<script>
  const searchForm = document.getElementById('statusSearch') as HTMLFormElement | null;
  if (searchForm) {
    const input = document.getElementById('statusSearchInput') as HTMLInputElement;
    const hint = document.getElementById('statusSearchHint')!;
    const list = document.getElementById('statusSearchResults')!;
    const hintText = hint.textContent ?? '';
    const labels: Record<string, string> = {
      operational: searchForm.dataset.operational || 'Operational',
      offline: searchForm.dataset.offline || 'Offline',
      reconnecting: searchForm.dataset.reconnecting || 'Reconnecting',
    };
    const text = (value: unknown) => String(value ?? '');
    let timer: ReturnType<typeof setTimeout> | undefined;
    let latest = 0;

    function show(message: string, problem = false) {
      hint.textContent = message;
      hint.classList.toggle('problem', problem);
    }

    async function search() {
      const q = input.value.trim();
      const ticket = ++latest;
      list.textContent = '';
      if (!q) { show(hintText); return; }
      if (!/^\d{15,22}$/.test(q) && q.length < 3) { show(searchForm!.dataset.short || ''); return; }
      try {
        const response = await fetch(`${searchForm!.dataset.endpoint}?q=${encodeURIComponent(q)}`, { headers: { Accept: 'application/json' }, cache: 'no-store' });
        if (ticket !== latest) return;
        if (response.status === 429) { show(searchForm!.dataset.limited || '', true); return; }
        const payload = await response.json().catch(() => null);
        if (!response.ok || !Array.isArray(payload?.results)) { show(searchForm!.dataset.error || '', true); return; }
        if (!payload.results.length) { show(searchForm!.dataset.empty || ''); return; }
        show(hintText);
        for (const row of payload.results) {
          const item = document.createElement('li');
          item.className = 'status-result';
          const icon = document.createElement('span');
          icon.className = 'status-result-icon';
          if (row.icon && /^https:\/\/cdn\.discordapp\.com\//.test(row.icon)) { const img = document.createElement('img'); img.src = row.icon; img.alt = ''; img.loading = 'lazy'; icon.appendChild(img); }
          else icon.textContent = text(row.name).slice(0, 1).toUpperCase();
          const name = document.createElement('span');
          name.className = 'status-result-name';
          name.textContent = text(row.name);
          const meta = document.createElement('span');
          meta.className = 'status-result-meta';
          meta.textContent = `${searchForm!.dataset.shard || 'Shard'} ${(Number.isFinite(Number(row.shard)) ? Number(row.shard) + 1 : text(row.shard))}${row.ping != null ? ` · ${text(row.ping)} ms` : ''}${row.cluster ? ` · ${text(row.cluster)}` : ''}`;
          const pill = document.createElement('span');
          pill.className = `status-pill ${text(row.state)}`;
          pill.textContent = labels[text(row.state)] ?? text(row.state);
          item.append(icon, name, meta, pill);
          list.appendChild(item);
        }
      } catch {
        if (ticket === latest) show(searchForm!.dataset.error || '', true);
      }
    }

    input.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(search, 350); });
    searchForm.addEventListener('submit', (event) => { event.preventDefault(); clearTimeout(timer); search(); });
  }
</script>

<script>
  const block = document.getElementById('statusBlock');
  const endpoint = block?.dataset.statusEndpoint;
  if (block && endpoint) {
    const staleMs = Number(block.dataset.staleMs || 300000);
    const labels: Record<string, string> = {
      operational: block.dataset.labelOperational || 'Operational',
      offline: block.dataset.labelOffline || 'Offline',
      reconnecting: block.dataset.labelReconnecting || 'Reconnecting',
    };
    const colServers = block.dataset.labelServers || 'Servers';
    const colPing = block.dataset.labelPing || 'Ping';
    const noDataText = block.dataset.labelNodata || '';
    const shardWord = block.dataset.labelShard || 'Shard';
    const uptimeWord = block.dataset.labelUptime || 'Uptime';
    const colMembers = block.dataset.labelMembers || 'Members';
    const colCluster = block.dataset.labelCluster || 'Cluster';
    const numberFormat = new Intl.NumberFormat(block.dataset.locale || 'en');
    const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
    const shardsContent = document.getElementById('shardsContent');
    const hostContent = document.getElementById('hostContent');
    const liveBadge = document.getElementById('liveBadge');

    function bucketState(rawStatus: string, updatedAt: string) {
      const staleAt = new Date(updatedAt).getTime() + staleMs;
      if (staleAt < Date.now()) return 'offline';
      if (rawStatus === 'Ready') return 'operational';
      if (rawStatus === 'Disconnected') return 'offline';
      return 'reconnecting';
    }

    function formatUptime(totalSeconds: number) {
      const d = Math.floor(totalSeconds / 86400);
      const h = Math.floor((totalSeconds % 86400) / 3600);
      const m = Math.floor((totalSeconds % 3600) / 60);
      if (d > 0) return `${d}d ${h}h`;
      if (h > 0) return `${h}h ${m}m`;
      return `${m}m`;
    }

    function renderTotal(rows: any[]) {
      const total = rows
        .filter((r) => bucketState(r.status, r.updated_at) !== 'offline')
        .reduce((sum, r) => sum + (Number(r.guild_count) || 0), 0);
      const target = document.getElementById('statusTotal');
      if (target) target.textContent = String(total);
    }

    // The same colours as the server render: green up to 50 ms, yellow up to 150, orange up to 300, red above that or offline.
    function tierOf(state: string, ping: unknown) {
      if (state === 'offline') return 'down';
      if (state === 'reconnecting') return 'slow';
      if (ping === null || ping === undefined || !Number.isFinite(Number(ping))) return 'unknown';
      return Number(ping) <= 50 ? 'good' : Number(ping) <= 150 ? 'warn' : Number(ping) <= 300 ? 'slow' : 'down';
    }

    function renderShards(rows: any[]) {
      if (!shardsContent) return;
      if (!rows.length) {
        shardsContent.innerHTML = `<p class="no-shard-data">${noDataText}</p>`;
        return;
      }
      const sorted = [...rows].sort((a, b) => a.shard_id - b.shard_id);
      const cards = sorted.map((r) => {
        const state = bucketState(r.status, r.updated_at);
        const ping = r.ping_ms != null ? `${r.ping_ms}` : 'n/a';
        const place = [r.cluster_name, r.cluster_location].filter(Boolean).map(escapeHtml).join(' · ');
        const members = r.member_count != null ? `<div><dt>${colMembers}</dt><dd>${numberFormat.format(Number(r.member_count) || 0)}</dd></div>` : '';
        const tip = `<dl class="shard-tip" role="tooltip"><div><dt>${colServers}</dt><dd>${numberFormat.format(Number(r.guild_count) || 0)}</dd></div>${members}<div><dt>${colPing}</dt><dd>${ping}${r.ping_ms != null ? ' ms' : ''} · ${labels[state] ?? state}</dd></div>${place ? `<div><dt>${colCluster}</dt><dd>${place}</dd></div>` : ''}</dl>`;
        const inner = `<div class="shard-card-head"><span class="tier-dot" aria-hidden="true"></span><span class="shard-name">${shardWord} ${Number(r.shard_id) + 1}</span><span class="status-pill ${state}">${labels[state] ?? state}</span></div><div class="shard-card-stats"><div class="shard-stat"><span class="n">${r.guild_count}</span><span class="l">${colServers}</span></div><div class="shard-stat"><span class="n">${ping}<em>ms</em></span><span class="l">${colPing}</span></div></div>${tip}`;
        return { id: String(r.shard_id), tier: tierOf(state, r.ping_ms), inner };
      });
      const shown = [...shardsContent.querySelectorAll<HTMLElement>('.shard-card')];
      // The same shards as the last time: the cards are updated where they are, so a tooltip that is open (the mouse or the finger is on the card) does not close every 10 seconds.
      if (shown.length === cards.length && shown.every((el, i) => el.dataset.shardId === cards[i].id)) {
        shown.forEach((el, i) => { el.dataset.tier = cards[i].tier; el.innerHTML = cards[i].inner; });
        return;
      }
      shardsContent.innerHTML = cards.map((c) => `<div class="shard-card" data-shard-id="${c.id}" data-tier="${c.tier}" tabindex="0">${c.inner}</div>`).join('');
    }

    function renderHost(row: any) {
      if (!hostContent || !row) return;
      hostContent.innerHTML = `<div class="shard-stat"><span class="n">${formatUptime(row.uptime_seconds)}</span><span class="l">${uptimeWord}</span></div><div class="shard-stat"><span class="n">${row.node_version ?? ''}</span><span class="l">Node.js</span></div>`;
    }

    async function poll() {
      if (!endpoint) return;
      try {
        const response = await fetch(endpoint, { headers: { Accept: 'application/json' }, cache: 'no-store' });
        if (!response.ok) return;
        const payload = await response.json();
        if (Array.isArray(payload.shards)) { renderShards(payload.shards); renderTotal(payload.shards); }
        if (payload.host) renderHost(payload.host);
        liveBadge?.classList.add('on');
      } catch {
        // Silently keep whatever was last rendered; the next poll retries.
      }
    }

    poll();
    setInterval(poll, 10000);
  }
</script>

