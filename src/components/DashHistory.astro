---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { getDashLang, makeT } from '../i18n/dash';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null; userId: string };
  profile: { id: string; name: string; username: string; avatar: string | null };
  own: boolean;
  invalid: boolean;
  ready: boolean;
  hidden: boolean;
  optedOut: boolean;
  avatars: Array<{ value: string; seen_at: string }>;
  stored: string[];
  avatarTotal: number;
  names: Array<{ value: string; seen_at: string }>;
  nicknames: Array<{ value: string; seen_at: string }>;
  page: number;
  pageSize: number;
  createdMs: number | null;
  flash: string;
}
const { user, profile, own, invalid, ready, hidden, optedOut, avatars, stored, avatarTotal, names, nicknames, page, pageSize, createdMs, flash } = Astro.props;
const locale = dashLang === 'pt-BR' ? 'pt-BR' : dashLang === 'es' ? 'es' : 'en';
const fmt = new Intl.DateTimeFormat(locale, { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
const rel = new Intl.RelativeTimeFormat(locale, { numeric: 'auto' });
const ago = (value: string) => {
  const days = Math.round((new Date(value).getTime() - Date.now()) / 86_400_000);
  if (Math.abs(days) < 1) return rel.format(0, 'day');
  if (Math.abs(days) < 30) return rel.format(days, 'day');
  if (Math.abs(days) < 365) return rel.format(Math.round(days / 30), 'month');
  return rel.format(Math.round(days / 365), 'year');
};
const cdnSrc = (hash: string) => `https://cdn.discordapp.com/avatars/${profile.id}/${hash}.png?size=256`;
// The copy Petto kept first (it stays after Discord stops serving the avatar), else Discord's link; the page falls back from one to the other.
const kept = new Set(stored);
const avatarSrc = (hash: string) => (kept.has(hash) ? `/dash/history/avatar/${profile.id}/${hash}` : cdnSrc(hash));
const totalPages = Math.max(1, Math.ceil(avatarTotal / pageSize));
const link = (to: number) => `/dash/history?${[own ? '' : `id=${profile.id}`, to > 1 ? `page=${to}` : ''].filter(Boolean).join('&')}`;
const from = avatarTotal ? (page - 1) * pageSize + 1 : 0;
const upTo = Math.min(page * pageSize, avatarTotal);
---
<Base title={dt('History · Petto')} active="dash" showFooter>
  <main>
    <section class="hs">
      <div class="wrap hs-wrap">
        <form class="hs-search" method="GET" action="/dash/history">
          <input type="text" name="id" inputmode="numeric" placeholder={dt('Search the history of another user by ID...')} value={own ? '' : profile.id} aria-label={dt('User ID')} />
          <button class="btn btn-primary btn-sm" type="submit"><Icon name="ph:magnifying-glass" width="14" height="14" />{dt('Search')}</button>
        </form>
        <p class="hs-who"><Icon name="ph:user" width="15" height="15" />{own ? dt('Viewing your history') : dt('Viewing the history of {a}', { a: profile.name })}{!own && <a href="/dash/history">{dt('Back to mine')}</a>}</p>

        {flash === 'cleared' && <div class="hs-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Deleted.')}</div>}
        {flash === 'record_off' && <div class="hs-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Petto stops saving your history, and nobody else can see it. The copies of your old avatars are deleted.')}</div>}
        {flash === 'record_on' && <div class="hs-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Your history is saved again.')}</div>}
        {flash === 'error' && <div class="hs-flash hs-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('It could not be saved. Try again in a moment.')}</div>}

        {invalid ? (
          <p class="hs-empty">{dt('That is not a user ID. It is a number of 17 to 20 digits.')}</p>
        ) : !ready ? (
          <p class="hs-empty">{dt('This arrives with the next Petto update.')}</p>
        ) : (
          <>
            <header class="hs-profile">
              {profile.avatar ? <img src={profile.avatar} alt="" width="84" height="84" /> : <span class="hs-ph"><Icon name="ph:user-fill" width="32" height="32" /></span>}
              <div>
                <h1>{profile.name}</h1>
                {profile.username && <div class="hs-user">@{profile.username}</div>}
                <div class="hs-id">{profile.id}</div>
              </div>
            </header>

            {hidden ? (
              <p class="hs-empty">{dt('This person turned their history off.')}</p>
            ) : (
              <>
                <div class="hs-stats">
                  <div><Icon name="ph:clock" width="18" height="18" /><span>{dt('Account created')}</span><b>{createdMs ? fmt.format(new Date(createdMs)) : '—'}</b></div>
                  <div><Icon name="ph:image" width="18" height="18" /><span>{dt('Avatars')}</span><b>{avatarTotal}</b></div>
                  <div><Icon name="ph:text-t" width="18" height="18" /><span>{dt('Names')}</span><b>{names.length + nicknames.length}</b></div>
                </div>

                <h2 class="hs-h"><Icon name="ph:image" width="18" height="18" />{dt('Avatars')}<span class="hs-count">{avatarTotal}</span></h2>
                {avatars.length === 0 ? <p class="hs-empty">{dt('No avatars saved yet. They are saved from the moment Petto sees a change.')}</p> : (
                  <div class="hs-grid">
                    {avatars.map((entry) => (
                      <a class="hs-av" href={avatarSrc(entry.value)} target="_blank" rel="noopener noreferrer">
                        {/* Petto's copy first, then Discord's link; when neither has the picture, the card says so instead of showing a broken image. */}
                        <span class="hs-pic">
                          <img src={avatarSrc(entry.value)} data-cdn={kept.has(entry.value) ? cdnSrc(entry.value) : undefined} alt="" loading="lazy" width="256" height="256" onerror="if(this.dataset.cdn){this.src=this.dataset.cdn;this.removeAttribute('data-cdn');this.closest('a').href=this.src}else{this.closest('.hs-av').classList.add('hs-gone')}" />
                          <span class="hs-gone-note"><Icon name="ph:image-broken" width="26" height="26" />{dt('Discord no longer has this picture')}</span>
                        </span>
                        <b>{fmt.format(new Date(entry.seen_at))}</b>
                        <span>{ago(entry.seen_at)}</span>
                      </a>
                    ))}
                  </div>
                )}
                {totalPages > 1 && (
                  <nav class="hs-pager" aria-label={dt('Pages')}>
                    {page > 1 ? <a class="btn btn-ghost btn-sm" href={link(page - 1)} rel="prev">‹</a> : <span class="btn btn-ghost btn-sm hs-off">‹</span>}
                    <span><b>{from}–{upTo}</b> {dt('of {a} avatars', { a: avatarTotal })}</span>
                    {page < totalPages ? <a class="btn btn-ghost btn-sm" href={link(page + 1)} rel="next">›</a> : <span class="btn btn-ghost btn-sm hs-off">›</span>}
                  </nav>
                )}

                <h2 class="hs-h"><Icon name="ph:text-t" width="18" height="18" />{dt('Names and nicknames')}<span class="hs-count">{names.length + nicknames.length}</span></h2>
                <h3 class="hs-sub"><Icon name="ph:text-t" width="15" height="15" />{dt('Global names')}<span class="hs-count">{names.length}</span></h3>
                {names.length === 0 ? <p class="hs-empty">{dt('No names saved yet.')}</p> : (
                  <ul class="hs-list">
                    {names.map((entry) => <li><i class="hs-dot"></i><div><strong>{entry.value}</strong><small>{fmt.format(new Date(entry.seen_at))} · {ago(entry.seen_at)}</small></div></li>)}
                  </ul>
                )}
                <h3 class="hs-sub"><Icon name="ph:users" width="15" height="15" />{dt('Nicknames in servers')}<span class="hs-count">{nicknames.length}</span></h3>
                {nicknames.length === 0 ? <p class="hs-empty">{dt('No nicknames saved yet.')}</p> : (
                  <ul class="hs-list">
                    {nicknames.map((entry) => <li><i class="hs-dot hs-dot-nick"></i><div><strong>{entry.value}</strong><small>{fmt.format(new Date(entry.seen_at))} · {ago(entry.seen_at)}</small></div></li>)}
                  </ul>
                )}
              </>
            )}

            {own && (
              <form method="POST" class="hs-own">
                <h2 class="hs-h"><Icon name="ph:shield-check" width="18" height="18" />{dt('Your privacy')}</h2>
                <p>{dt('You decide what Petto keeps. Anyone can look up a history by ID, but only you can delete yours.')}</p>
                <div class="hs-actions">
                  <button class="btn btn-ghost btn-sm" type="submit" name="action" value="clear_avatars">{dt('Delete avatars')}</button>
                  <button class="btn btn-ghost btn-sm" type="submit" name="action" value="clear_names">{dt('Delete names')}</button>
                  <button class="btn btn-ghost btn-sm" type="submit" name="action" value="clear_nicknames">{dt('Delete nicknames')}</button>
                  <button class="btn btn-ghost btn-sm" type="submit" name="action" value="clear_all">{dt('Delete everything')}</button>
                  {optedOut
                    ? <button class="btn btn-primary btn-sm" type="submit" name="action" value="record_on">{dt('Save my history again')}</button>
                    : <button class="btn btn-ghost btn-sm" type="submit" name="action" value="record_off">{dt('Stop saving my history')}</button>}
                </div>
              </form>
            )}
          </>
        )}
      </div>
    </section>
  </main>
</Base>

<style>
  .hs { padding: 48px 0 72px; }
  .hs-wrap { max-width: 860px; }
  .hs-search { display: flex; gap: 10px; flex-wrap: wrap; }
  .hs-search input { flex: 1 1 260px; min-width: 0; border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; background: var(--card); color: var(--text); font: inherit; font-size: 14px; }
  .hs-who { display: flex; align-items: center; gap: 8px; margin: 22px 0 8px; color: var(--text-muted); font-size: 14px; flex-wrap: wrap; }
  .hs-who a { color: var(--accent); text-decoration: none; margin-left: 6px; }
  .hs-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin: 12px 0; }
  .hs-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: var(--yellow); }
  .hs-profile { display: flex; align-items: center; gap: 20px; margin: 26px 0 22px; flex-wrap: wrap; }
  .hs-profile img, .hs-ph { width: 84px; height: 84px; border-radius: 50%; object-fit: cover; background: var(--bg-raise); display: grid; place-items: center; color: var(--text-dim); flex: none; }
  .hs-profile h1 { font-size: 26px; margin: 0 0 4px; overflow-wrap: anywhere; }
  .hs-user { color: var(--accent); font-family: var(--mono); font-size: 14px; }
  .hs-id { color: var(--text-dim); font-family: var(--mono); font-size: 13px; margin-top: 4px; }
  .hs-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; padding: 18px 0; border-top: 1px dashed var(--border); border-bottom: 1px solid var(--border); margin-bottom: 26px; }
  .hs-stats div { display: grid; grid-template-columns: auto 1fr; column-gap: 10px; align-items: center; }
  .hs-stats :global(svg) { color: var(--accent); grid-row: span 2; }
  .hs-stats span { font-size: 12.5px; color: var(--text-muted); }
  .hs-stats b { font-size: 19px; }
  .hs-h { display: flex; align-items: center; gap: 10px; font-size: 18px; margin: 30px 0 14px; }
  .hs-h :global(svg), .hs-sub :global(svg) { color: var(--accent); }
  .hs-sub { display: flex; align-items: center; gap: 8px; font-size: 14.5px; color: var(--text-muted); margin: 18px 0 8px; }
  .hs-count { margin-left: auto; font-size: 12.5px; font-weight: 600; background: var(--bg-raise); border-radius: 999px; padding: 3px 12px; color: var(--text-muted); }
  .hs-sub .hs-count { margin-left: 8px; }
  .hs-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .hs-av { display: block; text-decoration: none; color: inherit; }
  .hs-av img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 12px; background: var(--bg-raise); display: block; margin-bottom: 8px; }
  .hs-pic { display: block; position: relative; }
  .hs-gone-note { display: none; aspect-ratio: 1; margin-bottom: 8px; border-radius: 12px; background: var(--bg-raise); border: 1px dashed var(--border); flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 12px; text-align: center; font-size: 12.5px; color: var(--text-dim); }
  .hs-av.hs-gone { pointer-events: none; }
  .hs-av.hs-gone img { display: none; }
  .hs-av.hs-gone .hs-gone-note { display: flex; }
  .hs-av b { display: block; font-size: 14px; }
  .hs-av span { font-size: 12.5px; color: var(--text-dim); }
  .hs-pager { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 22px 0 4px; color: var(--text-muted); font-size: 13.5px; flex-wrap: wrap; }
  .hs-off { opacity: .4; pointer-events: none; }
  .hs-list { list-style: none; margin: 0; padding: 0; }
  .hs-list li { display: flex; align-items: flex-start; gap: 12px; padding: 14px 4px; border-bottom: 1px solid var(--border); }
  .hs-dot { width: 12px; height: 12px; border-radius: 50%; background: #3b9ae1; margin-top: 7px; flex: none; }
  .hs-dot-nick { background: #9b6cf0; }
  .hs-list strong { display: block; font-size: 17px; overflow-wrap: anywhere; }
  .hs-list small { color: var(--text-dim); font-size: 12.5px; }
  .hs-empty { color: var(--text-muted); font-size: 14px; margin: 14px 0; }
  .hs-own { margin-top: 40px; border-top: 1px solid var(--border); padding-top: 4px; }
  .hs-own p { color: var(--text-muted); font-size: 13.5px; margin: 0 0 14px; max-width: 60ch; }
  .hs-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  @media (max-width: 640px) { .hs-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .hs-stats { grid-template-columns: 1fr; } }
</style>
