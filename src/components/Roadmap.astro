---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { useTranslations, localePath, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = localePath[lang];
const r = t.roadmapPage;

const colIcon: Record<string, string> = {
  shipped: 'ph:check-circle-fill',
  testing: 'ph:flask-fill',
  planned: 'ph:circle-dashed',
  considering: 'ph:chats-circle-fill',
};
---
<Base title={`${r.eyebrow} · Petto`} lang={lang}>
  <main>
    <section class="rm-sec">
      <div class="wrap rm-wrap">
        <div class="eyebrow">{r.eyebrow}</div>
        <h1>{r.title}</h1>
        <p class="rm-lede">{r.lede}</p>

        <div class="rm-board reveal">
          {r.columns.map((col) => (
            <div class={`rm-col rm-col-${col.key}`}>
              <div class="rm-col-head">
                <Icon name={colIcon[col.key] ?? 'ph:circle-dashed'} class="rm-col-ic" />
                <span>{col.label}</span>
                <span class="rm-col-count">{col.items.length}</span>
              </div>
              <div class="rm-col-items">
                {col.items.map((it) => (
                  it.href ? (
                    <a class="rm-card" href={`${base}${it.href}`}>
                      <div class="rm-card-t">{it.title}</div>
                      <p>{it.desc}</p>
                    </a>
                  ) : (
                    <div class="rm-card rm-card-static">
                      <div class="rm-card-t">{it.title}</div>
                      <p>{it.desc}</p>
                    </div>
                  )
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .rm-sec { padding: 64px 0 110px; }
  .rm-wrap { max-width: 1120px; }
  .rm-sec h1 { font-size: 32px; margin: 14px 0 12px; }
  .rm-lede { color: var(--text-muted); font-size: 15.5px; line-height: 1.65; max-width: 66ch; margin-bottom: 40px; }

  .rm-board { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; align-items: start; }
  .rm-col { border: 1px solid var(--border-soft); border-radius: 14px; padding: 14px; background: var(--bg-raise); }
  .rm-col-head { display: flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 11.5px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 14px; padding-bottom: 12px; border-bottom: 2px solid var(--border); }
  .rm-col-head :global(.rm-col-ic) { width: 14px; height: 14px; }
  .rm-col-count { margin-left: auto; background: var(--border-soft); color: var(--text-dim); border-radius: 999px; padding: 1px 7px; font-size: 10.5px; }
  .rm-col-shipped .rm-col-head { color: var(--green); border-color: var(--green); }
  .rm-col-testing .rm-col-head { color: var(--yellow); border-color: var(--yellow); }
  .rm-col-planned .rm-col-head { color: var(--accent); border-color: var(--accent); }
  .rm-col-considering .rm-col-head { color: var(--text-dim); border-color: var(--border); }

  .rm-col-items { display: flex; flex-direction: column; gap: 10px; }
  .rm-card { display: block; border: 1px solid var(--border); border-left: 3px solid var(--border); border-radius: 10px; padding: 14px 16px; background: var(--card); text-decoration: none; color: inherit; transition: border-color 0.15s ease, transform 0.15s ease; }
  a.rm-card:hover { border-color: var(--text-dim); transform: translateX(2px); }
  .rm-col-shipped .rm-card { border-left-color: var(--green); }
  .rm-col-testing .rm-card { border-left-color: var(--yellow); }
  .rm-col-planned .rm-card { border-left-color: var(--accent); }
  .rm-col-considering .rm-card { border-left-color: var(--border); }
  .rm-card-static { opacity: 0.85; }
  .rm-card-t { font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 6px; }
  .rm-card p { font-size: 12.5px; color: var(--text-muted); line-height: 1.5; margin: 0; }

  @media (max-width: 880px) {
    .rm-board { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .rm-board { grid-template-columns: 1fr; }
  }
</style>
