---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { useTranslations, localePath, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = localePath[lang];
const hrefFor = (href: string) => href.startsWith('/dash') ? href : `${base}${href}`;
const r = t.roadmapPage;

const colIcon: Record<string, string> = {
  shipped: 'ph:check-circle-fill',
  testing: 'ph:flask-fill',
  planned: 'ph:circle-dashed',
  considering: 'ph:chats-circle-fill',
};
---
<Base title={`${r.eyebrow} · Petto`} lang={lang}>
  <main>
    <section class="rm-sec">
      <div class="wrap rm-wrap">
        <div class="rm-intro">
          <div class="eyebrow">{r.eyebrow}</div>
          <h1>{r.title}</h1>
          <p class="rm-lede">{r.lede}</p>
        </div>

        <div class="rm-board reveal">
          {r.columns.map((col) => (
            <div class={`rm-col rm-col-${col.key}`}>
              <div class="rm-col-head">
                <Icon name={colIcon[col.key] ?? 'ph:circle-dashed'} class="rm-col-ic" />
                <span>{col.label}</span>
                <span class="rm-col-count">{col.items.length}</span>
              </div>
              <div class="rm-col-items">
                {col.items.map((it) => (
                  it.href ? (
                    <a class="rm-card" href={hrefFor(it.href)}>
                      <div class="rm-card-t">{it.title}</div>
                      <p>{it.desc}</p>
                    </a>
                  ) : (
                    <div class="rm-card rm-card-static">
                      <div class="rm-card-t">{it.title}</div>
                      <p>{it.desc}</p>
                    </div>
                  )
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .rm-sec { padding: 72px 0 110px; }
  .rm-wrap { max-width: 1120px; }
  .rm-intro { max-width: 720px; margin-bottom: 42px; }
  .rm-sec h1 { font-size: clamp(32px, 4vw, 46px); line-height: 1.08; letter-spacing: -0.035em; margin: 14px 0 14px; }
  .rm-lede { color: var(--text-muted); font-size: 16px; line-height: 1.65; max-width: 66ch; margin: 0; }

  .rm-board { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; align-items: stretch; }
  .rm-col { --rm-color: var(--text-dim); position: relative; min-width: 0; border: 1px solid var(--border); border-radius: 16px; padding: 16px; background: var(--bg); box-shadow: 0 16px 30px -30px rgba(0,0,0,0.8); overflow: hidden; }
  .rm-col::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--rm-color); opacity: 0.9; }
  .rm-col-head { display: flex; align-items: center; gap: 8px; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--rm-color); margin-bottom: 16px; padding: 2px 0 14px; border-bottom: 1px solid var(--border-soft); }
  .rm-col-head :global(.rm-col-ic) { width: 16px; height: 16px; }
  .rm-col-count { margin-left: auto; background: color-mix(in srgb, var(--rm-color) 14%, var(--bg)); color: var(--rm-color); border-radius: 999px; padding: 3px 8px; font-size: 10.5px; }
  .rm-col-shipped { --rm-color: var(--green); }
  .rm-col-testing { --rm-color: var(--yellow); }
  .rm-col-planned { --rm-color: var(--accent); }
  .rm-col-considering { --rm-color: var(--text-dim); }

  .rm-col-items { display: flex; flex-direction: column; gap: 10px; }
  .rm-card { display: block; border: 1px solid var(--border); border-left: 3px solid var(--rm-color); border-radius: 11px; padding: 15px 15px 16px; background: var(--card); text-decoration: none; color: inherit; transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease; }
  a.rm-card:hover { border-color: color-mix(in srgb, var(--rm-color) 65%, var(--border)); transform: translateY(-2px); box-shadow: 0 14px 24px -24px rgba(0,0,0,0.8); }
  .rm-card-static { opacity: 0.72; }
  .rm-card-t { font-size: 14px; font-weight: 700; color: var(--text); margin-bottom: 7px; line-height: 1.35; }
  .rm-card p { font-size: 12.5px; color: var(--text-muted); line-height: 1.55; margin: 0; }

  @media (max-width: 880px) {
    .rm-board { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .rm-board { grid-template-columns: 1fr; }
  }
</style>
