---
// The look the pages of the editor of the shop share (the badges made by hand, the badges of the code, the packs, the banners and the name fonts): the list of rows, the chips
// that say how each stands, the form and its fields. Written once here so a change reaches every page of the editor.
---
<style is:global>
  .be { display: flex; flex-direction: column; gap: 18px; }
  .be-intro, .be-empty { margin: 0; color: var(--text-muted); font-size: 14px; }
  .be-down { color: var(--red-text); }
  .be-list { display: flex; flex-direction: column; gap: 10px; }
  .be-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding: 12px 14px; border: 1px solid var(--border-soft); border-radius: 16px; background: color-mix(in srgb, var(--text) 3%, transparent); }
  .be-hex { flex: none; width: 52px; height: 60px; display: grid; place-items: center; overflow: hidden; background: var(--c); clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%); color: #fff; }
  .be-hex img { width: 100%; height: 100%; object-fit: cover; }
  .be-hex.be-bare { background: none; clip-path: none; }
  .be-hex.be-bare img { object-fit: contain; }
  .be-hex.be-nobg { background: transparent; }
  .be-hex.be-nobg img { object-fit: contain; }
  .be-nobg-check { flex-direction: row !important; align-items: center; gap: 7px !important; margin-top: 2px; font-size: 12.5px !important; color: var(--text-muted); cursor: pointer; }
  .be-info { flex: 1 1 220px; min-width: 0; display: flex; flex-direction: column; gap: 5px; }
  .be-info strong { font-size: 15px; overflow-wrap: anywhere; }
  .be-meta { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: center; font-size: 13px; color: var(--text-muted); }
  .be-chip { font-style: normal; font-weight: 700; font-size: 12px; padding: 2px 9px; border-radius: 999px; background: color-mix(in srgb, var(--text) 10%, transparent); }
  .be-live { background: var(--green-soft); color: var(--green-text); } .be-scheduled { background: rgba(122,208,255,.16); color: #9bdcff; } .be-ended, .be-retired { background: var(--red-soft); color: var(--red-text); } .be-rule { background: rgba(199,155,255,.16); color: #d8b9ff; }
  .be-warn { color: var(--yellow-text, #ffe08a); }
  .be-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .be-off { background: var(--red-soft); color: var(--red-text); } .be-on, .be-save { background: var(--green); color: var(--green-ink); border-color: transparent; }
  .be-form { border: 1px solid var(--border-soft); border-radius: 18px; padding: 20px 22px; background: color-mix(in srgb, var(--text) 3%, transparent); }
  .be-form h2 { margin: 0 0 16px; font-size: 18px; }
  .be-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px 16px; align-items: end; }
  .be-grid label { display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: var(--text-muted); min-width: 0; transition: opacity .2s ease; }
  .be-grid label.is-muted { opacity: .48; }
  .be-grid input:not([type=color]):not([type=file]):not([type=checkbox]), .be-grid select { height: 40px; box-sizing: border-box; padding: 0 12px; border-radius: 10px; border: 1px solid var(--border-soft); background: color-mix(in srgb, var(--text) 4%, transparent); color: var(--text); font: inherit; min-width: 0; }
  .be-pickfield { display: flex; flex-direction: column; gap: 6px; font-size: 13px; color: var(--text-muted); min-width: 0; transition: opacity .2s ease; }
  .be-pickfield.is-muted { opacity: .45; }
  .be-pickfield :global(.dgl-cp) { display: flex; }
  .be-pickfield :global(.dgl-cp-trigger) { flex: 1; height: 40px; min-height: 40px; box-sizing: border-box; border-radius: 10px; border-color: var(--border-soft); }
  .be-pickfield :global(.dgl-cp-fieldlabel:empty) { display: none; }
  .be-pickfield :global(.dgl-cp-panel input) { padding: 6px 4px; border-radius: 7px; }
  .be-grid input:not([type=file]):focus, .be-grid select:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .be-grid .be-check { grid-column: auto; flex-direction: row !important; align-items: center; gap: 9px !important; height: 40px; padding: 0 12px; border-radius: 10px; border: 1px solid var(--border-soft); background: color-mix(in srgb, var(--text) 3%, transparent); color: var(--text); cursor: pointer; }
  .be-nobg-check { flex-direction: row !important; align-items: center; gap: 7px !important; margin-top: 2px; font-size: 12.5px !important; color: var(--text-muted); cursor: pointer; }
  .be-file { grid-column: 1 / -1; width: fit-content; max-width: 100%; justify-self: start; align-items: flex-start; }
  .be-file input[type="file"] { display: inline-block; width: auto; max-width: 100%; font-size: 12.5px; color: var(--text-muted); border: 0 !important; box-shadow: none !important; outline: none !important; padding: 0 !important; background: transparent !important; }
  .be-file input[type="file"]::file-selector-button { padding: 5px 12px; font-size: 12.5px; border-radius: 8px; margin-right: 8px; border: 1px solid var(--border-soft); background: color-mix(in srgb, var(--text) 6%, transparent); color: var(--text); cursor: pointer; }
  .be-file input[type="file"]::file-selector-button:hover { background: color-mix(in srgb, var(--text) 11%, transparent); }
  .be-file input[type="file"]:focus-visible::file-selector-button { outline: 2px solid var(--accent); outline-offset: 2px; }
  .be-msg { margin: 14px 0 0; font-size: 14px; } .be-msg.is-error { color: var(--red-text); } .be-msg.is-ok { color: var(--green-text); }
  .be-buttons { display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex-wrap: wrap; margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--border-soft); }
  .be-buttons .btn { min-height: 40px; padding: 0 18px; border-radius: 10px; }
</style>
