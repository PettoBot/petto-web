---
// The notice that goes under the head of every page where the ceramos are shown (daily reward, movements, badges, name, profile and rank card): today they are scarce and
// come mostly with a paid plan, and the team is working on new ways to get them. Written once here so the words are the same everywhere and one change reaches every page.
import { Icon } from 'astro-icon/components';
import { getDashLang, makeT } from '../i18n/dash';
const dt = makeT(getDashLang(Astro));
---
<div class="cn-note" role="note">
  <Icon name="ph:hammer-fill" width="18" height="18" />
  <p><b>{dt('We are working on new ways to get ceramos.')}</b> {dt('For now you get them with the daily reward, with a plan or by buying a pack. A new way to earn them is on its way.')}</p>
</div>
<style is:global>
  .cn-note { display: flex; gap: 12px; align-items: flex-start; margin: 0 0 16px; padding: 12px 16px; border-radius: 14px; background: var(--yellow-soft, color-mix(in srgb, #ffd23f 12%, transparent)); color: var(--text); font-size: 14px; line-height: 1.45; }
  .cn-note svg { flex: none; margin-top: 2px; color: var(--yellow-text, #ffd666); }
  .cn-note p { margin: 0; color: var(--text-muted); } .cn-note b { color: var(--text); font-weight: 600; }
</style>
