---
// The server switcher of the dashboard menu: a bottom sheet on a phone and the same sheet centered on a desktop. It opens from the
// selector in the menu header (DashSideHead.astro, any [data-sheet-open]) and lists the account row ("See your profile"), the servers where
// Petto is ("Your servers") and the servers the visitor manages without Petto ("Invite Petto", each with a "+" that opens the invite).
import { Icon } from 'astro-icon/components';
import InlineIcon from './InlineIcon.astro';
import { makeT, getDashLang } from '../i18n/dash';

interface Props {
  user: { name: string; avatar: string | null };
  /** Where "See your profile" goes. */
  profileHref: string;
  /** The profile page is the one open (the row is marked instead of a server). */
  onProfile?: boolean;
  /** The server that is open, if any. */
  currentId?: string | null;
  servers: { id: string; name: string; icon: string | null; premium: boolean }[];
  invites: { id: string; name: string; icon: string | null; href: string }[];
}
const { user, profileHref, onProfile = false, currentId = null, servers, invites } = Astro.props;
const dt = makeT(getDashLang(Astro));
---
<div class="ds-veil" data-sheet-veil hidden></div>
<div class="ds-sheet" id="ds-sheet" role="dialog" aria-modal="true" aria-labelledby="ds-title" tabindex="-1" hidden data-sheet>
  <div class="ds-top" data-sheet-grab>
    <span class="ds-grab" aria-hidden="true"></span>
    <h2 class="ds-title" id="ds-title">{dt('Switch server')}</h2>
    <button type="button" class="ds-close" data-sheet-close aria-label={dt('Close')}><Icon name="ph:x" width="16" height="16" /></button>
  </div>
  <div class="ds-body">
    <a class:list={['ds-profile', { current: onProfile }]} href={profileHref} aria-current={onProfile ? 'page' : undefined}>
      {user.avatar ? <img src={user.avatar} alt="" width="44" height="44" class="ds-avatar" referrerpolicy="no-referrer" /> : <span class="ds-avatar ds-avatar-fallback"><Icon name="ph:user-fill" width="18" height="18" /></span>}
      <span class="ds-profile-text"><strong>{user.name}</strong><small>{dt('See your profile')}</small></span>
      <Icon name="ph:caret-right-bold" width="14" height="14" />
    </a>

    <h3 class="ds-head">{dt('Your servers')}</h3>
    {servers.length > 0 ? (
      <ul class="ds-list">
        {servers.map((g) => (
          <li>
            <a class:list={['ds-row', { current: g.id === currentId }]} href={`/dash/guild/${g.id}/overview`} aria-current={g.id === currentId ? 'page' : undefined}>
              {g.icon ? <img src={g.icon} alt="" width="40" height="40" loading="lazy" class="ds-icon" referrerpolicy="no-referrer" /> : <span class="ds-icon ds-icon-fallback"><Icon name="ph:buildings-fill" width="16" height="16" /></span>}
              <span class="ds-name">{g.name}</span>
              {g.premium && <span class="ds-premium"><InlineIcon name="ph:crown-fill" width="11" height="11" />Premium</span>}
              {g.id === currentId && <Icon name="ph:check-circle-fill" width="16" height="16" class="ds-check" />}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="ds-empty">{dt('Petto is not in any of your servers yet.')}</p>
    )}

    {invites.length > 0 && (
      <Fragment>
        <h3 class="ds-head">{dt('Invite Petto')}</h3>
        <ul class="ds-list">
          {invites.map((g) => (
            <li class="ds-row ds-row-invite">
              {g.icon ? <img src={g.icon} alt="" width="40" height="40" loading="lazy" class="ds-icon" referrerpolicy="no-referrer" /> : <span class="ds-icon ds-icon-fallback"><Icon name="ph:buildings-fill" width="16" height="16" /></span>}
              <span class="ds-name">{g.name}</span>
              <a class="ds-plus" href={g.href} target="_blank" rel="noopener noreferrer" aria-label={dt('Add Petto to {a}', { a: g.name })} title={dt('Add Petto')}><Icon name="ph:plus-bold" width="15" height="15" /></a>
            </li>
          ))}
        </ul>
      </Fragment>
    )}
  </div>
</div>

<script is:inline>
  (function () {
    var sheet = document.getElementById('ds-sheet');
    var veil = document.querySelector('[data-sheet-veil]');
    if (!sheet || !veil || sheet.dataset.bound) return;
    sheet.dataset.bound = '1';
    var openers = Array.prototype.slice.call(document.querySelectorAll('[data-sheet-open]'));
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var returnTo = null;
    var closing = 0;

    function focusables() {
      return Array.prototype.slice.call(sheet.querySelectorAll('a[href], button:not([disabled])')).filter(function (el) { return el.offsetParent !== null; });
    }
    function setOpen(open) {
      var isOpen = !sheet.hidden && sheet.classList.contains('is-open');
      if (open === isOpen) return;
      clearTimeout(closing);
      openers.forEach(function (b) { b.setAttribute('aria-expanded', String(open)); });
      if (open) {
        returnTo = document.activeElement;
        sheet.hidden = false; veil.hidden = false;
        sheet.style.transform = '';
        void sheet.offsetWidth;
        sheet.classList.add('is-open'); veil.classList.add('is-open');
        document.documentElement.classList.add('ds-open');
        var current = sheet.querySelector('[aria-current]');
        sheet.focus({ preventScroll: true });
        if (current && current.scrollIntoView) current.scrollIntoView({ block: 'nearest' });
      } else {
        sheet.classList.remove('is-open'); veil.classList.remove('is-open');
        document.documentElement.classList.remove('ds-open');
        var done = function () { sheet.hidden = true; veil.hidden = true; sheet.style.transform = ''; };
        if (reduce.matches) done(); else closing = setTimeout(done, 240);
        if (returnTo && returnTo.focus) returnTo.focus({ preventScroll: true });
        returnTo = null;
      }
    }
    openers.forEach(function (b) { b.addEventListener('click', function () { setOpen(true); }); });
    veil.addEventListener('click', function () { setOpen(false); });
    sheet.querySelectorAll('[data-sheet-close]').forEach(function (b) { b.addEventListener('click', function () { setOpen(false); }); });

    // Escape closes only the sheet (the menu drawer under it stays), and Tab stays inside the sheet.
    document.addEventListener('keydown', function (e) {
      if (sheet.hidden || !sheet.classList.contains('is-open')) return;
      if (e.key === 'Escape') { e.preventDefault(); e.stopImmediatePropagation(); setOpen(false); return; }
      if (e.key !== 'Tab') return;
      var list = focusables();
      if (!list.length) { e.preventDefault(); return; }
      var first = list[0], last = list[list.length - 1];
      if (!sheet.contains(document.activeElement) || document.activeElement === sheet) { e.preventDefault(); (e.shiftKey ? last : first).focus(); }
      else if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }, true);

    // On a phone, a swipe down on the top of the sheet closes it.
    var grab = sheet.querySelector('[data-sheet-grab]');
    var startY = null, delta = 0;
    grab.addEventListener('touchstart', function (e) { startY = e.touches[0].clientY; delta = 0; sheet.style.transition = 'none'; }, { passive: true });
    grab.addEventListener('touchmove', function (e) {
      if (startY === null) return;
      delta = Math.max(0, e.touches[0].clientY - startY);
      sheet.style.transform = 'translateY(' + delta + 'px)';
    }, { passive: true });
    function release() {
      if (startY === null) return;
      startY = null;
      sheet.style.transition = '';
      if (delta > 80) setOpen(false); else sheet.style.transform = '';
    }
    grab.addEventListener('touchend', release);
    grab.addEventListener('touchcancel', release);
  })();
</script>

<style>
  .ds-veil { position: fixed; inset: 0; z-index: 1100; background: rgba(8, 9, 12, .6); opacity: 0; transition: opacity .22s ease; touch-action: none; }
  .ds-veil.is-open { opacity: 1; }
  .ds-sheet {
    position: fixed; z-index: 1101; left: 50%; bottom: 0; width: min(100%, 520px); max-height: min(88dvh, 720px);
    display: flex; flex-direction: column; background: var(--card); color: var(--text); border: 1px solid var(--border); border-bottom: 0;
    border-radius: 22px 22px 0 0; box-shadow: 0 -18px 50px -12px rgba(0, 0, 0, .55); outline: none;
    transform: translate(-50%, 104%); transition: transform .26s cubic-bezier(.22, 1, .36, 1); will-change: transform;
  }
  .ds-sheet.is-open { transform: translate(-50%, 0); }
  .ds-top { position: relative; flex: none; display: flex; align-items: center; justify-content: center; min-height: 28px; padding: 4px 12px 0; touch-action: none; }
  .ds-grab { width: 42px; height: 5px; border-radius: 99px; background: var(--border); margin: 8px 0 4px; }
  .ds-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ds-close { display: none; position: absolute; right: 10px; top: 8px; width: 32px; height: 32px; place-items: center; border-radius: 10px; border: 1px solid var(--border-soft); background: transparent; color: var(--text-muted); cursor: pointer; }
  .ds-close:hover { color: var(--text); background: var(--card-hover); }
  .ds-body { overflow-y: auto; overscroll-behavior: contain; padding: 4px 12px calc(14px + env(safe-area-inset-bottom, 0px)); }

  .ds-profile { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 16px; background: color-mix(in srgb, var(--text) 4%, transparent); border: 1px solid var(--border-soft); color: var(--text); text-decoration: none; transition: background-color var(--m-fast) ease, border-color var(--m-fast) ease; }
  .ds-profile:hover, .ds-profile.current { background: var(--card-hover); border-color: var(--border); }
  .ds-profile.current { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
  .ds-avatar { flex: none; width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
  .ds-avatar-fallback { display: grid; place-items: center; background: var(--bg-raise); color: var(--text-dim); }
  .ds-profile-text { flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.3; }
  .ds-profile-text strong { font-size: 15.5px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ds-profile-text small { font-size: 12.5px; color: var(--text-muted); }
  .ds-profile > :global(svg) { flex: none; color: var(--text-dim); }

  .ds-head { margin: 16px 6px 6px; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--text-dim); }
  .ds-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .ds-row { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 6px 8px; border-radius: 14px; color: var(--text); text-decoration: none; transition: background-color var(--m-fast) ease; }
  a.ds-row:hover { background: var(--card-hover); }
  .ds-row.current { background: var(--accent-soft); }
  .ds-icon { flex: none; width: 40px; height: 40px; border-radius: 12px; object-fit: cover; background: var(--bg-raise); }
  .ds-icon-fallback { display: grid; place-items: center; color: var(--text-dim); }
  .ds-name { flex: 1; min-width: 0; font-size: 14.5px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ds-row-invite .ds-name { color: var(--text-muted); font-weight: 500; }
  .ds-row-invite .ds-icon { filter: grayscale(.85); opacity: .75; }
  .ds-premium { display: inline-flex; align-items: center; gap: 4px; flex: none; color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border: 1px solid color-mix(in srgb, var(--yellow) 42%, var(--border)); border-radius: 999px; font-family: var(--mono); font-size: 9px; font-weight: 700; line-height: 1; padding: 4px 6px; }
  .ds-row :global(.ds-check) { flex: none; color: var(--accent); }
  .ds-plus { flex: none; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 11px; border: 1px solid var(--border); background: color-mix(in srgb, var(--text) 4%, transparent); color: var(--text-muted); text-decoration: none; touch-action: manipulation; transition: background-color var(--m-fast) ease, color var(--m-fast) ease, border-color var(--m-fast) ease; }
  .ds-plus:hover { background: var(--accent-soft); color: var(--accent); border-color: color-mix(in srgb, var(--accent) 50%, var(--border)); }
  .ds-empty { margin: 4px 6px 2px; font-size: 13.5px; color: var(--text-muted); }
  .ds-profile:focus-visible, a.ds-row:focus-visible, .ds-plus:focus-visible, .ds-close:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* On a desktop the same sheet is centered. */
  @media (min-width: 681px) {
    .ds-sheet { bottom: auto; top: 50%; width: 440px; max-height: min(80dvh, 640px); border-bottom: 1px solid var(--border); border-radius: 20px; box-shadow: 0 30px 80px -20px rgba(0, 0, 0, .6); transform: translate(-50%, calc(-50% + 16px)) scale(.97); opacity: 0; transition: transform .22s cubic-bezier(.22, 1, .36, 1), opacity .18s ease; }
    .ds-sheet.is-open { transform: translate(-50%, -50%); opacity: 1; }
    .ds-top { justify-content: flex-start; min-height: 52px; padding: 0 12px 0 20px; }
    .ds-grab { display: none; }
    .ds-title { position: static; width: auto; height: auto; overflow: visible; clip: auto; font-size: 16px; font-weight: 700; letter-spacing: -.01em; }
    .ds-close { display: grid; top: 10px; right: 12px; }
    .ds-body { padding-top: 2px; }
  }
  @media (prefers-reduced-motion: reduce) { .ds-sheet, .ds-veil { transition: none; } }
</style>

<style is:global>
  html.ds-open, html.ds-open body { overflow: hidden; }
</style>
