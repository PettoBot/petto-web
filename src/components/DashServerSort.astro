---
// A small "sort by" switch for a list of servers (the server picker and the developer view): by members (the
// biggest first; a server whose count is unknown goes last) or by name. The choice is kept for the person in this browser.
// Each sorted item carries data-members (a number, or empty) and data-name; `targets` is a CSS selector of the lists to reorder.
import { getDashLang, makeT } from '../i18n/dash';
interface Props { targets: string; compact?: boolean }
const { targets, compact = false } = Astro.props;
const dt = makeT(getDashLang(Astro));
---
<div class:list={['dss', { 'dss-compact': compact }]} role="group" aria-label={dt('Sort servers')} data-dss={targets}>
  {!compact && <span class="dss-label">{dt('Sort')}</span>}
  <button type="button" class="dss-btn" data-sort="members" aria-pressed="true">{dt('Members')}</button>
  <button type="button" class="dss-btn" data-sort="name" aria-pressed="false">{dt('Name')}</button>
</div>

<script is:inline>
  (function () {
    var KEY = 'petto-dash-server-sort';
    function apply(root, how) {
      var lists = document.querySelectorAll(root.getAttribute('data-dss'));
      lists.forEach(function (list) {
        var items = Array.prototype.slice.call(list.children).filter(function (el) { return el.hasAttribute('data-name'); });
        items.sort(function (a, b) {
          if (how === 'name') return a.getAttribute('data-name').localeCompare(b.getAttribute('data-name'));
          var x = a.getAttribute('data-members'), y = b.getAttribute('data-members');
          var nx = x === '' || x === null ? -1 : Number(x), ny = y === '' || y === null ? -1 : Number(y);
          return ny - nx || a.getAttribute('data-name').localeCompare(b.getAttribute('data-name'));
        });
        items.forEach(function (el) { list.appendChild(el); });
      });
      root.querySelectorAll('.dss-btn').forEach(function (btn) { btn.setAttribute('aria-pressed', String(btn.getAttribute('data-sort') === how)); });
    }
    document.querySelectorAll('[data-dss]').forEach(function (root) {
      if (root.dataset.dssBound) return;
      root.dataset.dssBound = '1';
      var saved = null;
      try { saved = localStorage.getItem(KEY); } catch (e) { saved = null; }
      // The page is drawn by members already; only another saved choice reorders it.
      if (saved === 'name') apply(root, 'name');
      root.addEventListener('click', function (event) {
        var btn = event.target.closest && event.target.closest('.dss-btn');
        if (!btn) return;
        var how = btn.getAttribute('data-sort');
        apply(root, how);
        try { localStorage.setItem(KEY, how); } catch (e) { /* private window: the choice lasts for this page */ }
        // Other switches on the page (the menu and the list) follow.
        document.querySelectorAll('[data-dss]').forEach(function (other) { if (other !== root) apply(other, how); });
      });
    });
  })();
</script>

<style is:global>
  .dss { display: inline-flex; align-items: center; gap: 4px; padding: 3px; border: 1px solid var(--border); border-radius: 999px; background: var(--card); }
  .dss-label { padding: 0 6px 0 8px; font-family: var(--mono); font-size: 10px; letter-spacing: .07em; text-transform: uppercase; color: var(--text-dim); }
  .dss-btn { min-height: 30px; padding: 4px 11px; border: 0; border-radius: 999px; background: transparent; color: var(--text-muted); font: 600 12px var(--sans); cursor: pointer; transition: background-color var(--m-fast, .14s) ease, color var(--m-fast, .14s) ease, transform var(--m-instant, 90ms) ease; }
  .dss-btn:hover { color: var(--text); }
  .dss-btn:active { transform: scale(var(--m-press, .97)); }
  .dss-btn[aria-pressed="true"] { background: var(--accent-soft); color: var(--accent); }
  .dss-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .dss-compact { padding: 2px; }
  .dss-compact .dss-btn { min-height: 26px; padding: 3px 9px; font-size: 11px; }
</style>
