---
import DashGuildLayout from './DashGuildLayout.astro';
import EmbedBuilderApp from '../react/embeds/EmbedBuilderApp';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  botName: string;
  botIcon: string;
  templateNames: string[];
  selected: string;
  channels: { id: string; name: string }[];
  variableGroups?: { label: string; vars: { tok: string; desc: string }[] }[] | null;
  paginations?: any[];
  paginationsReady?: boolean;
  paginationMessage?: { kind: 'ok' | 'err'; text: string } | null;
}
const { user, guildId, guildName, guildIcon, botName, botIcon, templateNames, selected, channels, variableGroups, paginations = [], paginationsReady = true, paginationMessage = null } = Astro.props;
const userAvatarUrl = user.avatar ?? '/assets/mascot-icon.webp';
import SkeletonBlocks from './SkeletonBlocks.astro';
import DashReactWords from './DashReactWords.astro';
import DashPaginations from './DashPaginations.astro';
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="embeds" pageTitle="Embeds">
  <h1>{dt('Embeds')}</h1>
  <p class="eb-sub"><Fragment set:html={dth('Rich message templates for <b>{a}</b>. Point a custom command or autoresponder at one by name, or send it directly with <code>/embed send</code>.', { a: (guildName) })} /></p>

  <DashReactWords />
  <EmbedBuilderApp
    client:only="react"
    guildId={guildId}
    botName={botName}
    botIcon={botIcon}
    userAvatarUrl={userAvatarUrl}
    guildIconUrl={guildIcon}
    initialTemplateNames={templateNames}
    initialSelected={selected}
    channels={channels}
    serverName={guildName}
    variableGroups={variableGroups}
    generatorUrl="https://embed-generator.petto.sbs"
  ><SkeletonBlocks slot="fallback" variant="editor" /></EmbedBuilderApp>

  <DashPaginations paginations={paginations} ready={paginationsReady} message={paginationMessage} templateNames={templateNames} channels={channels} />
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  .eb-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 24px; max-width: 68ch; }
  .eb-sub :global(b){ color: var(--text); }
  .eb-sub :global(code){ font-family: var(--mono); color: var(--accent); }
</style>
