---
import DashGuildLayout from './DashGuildLayout.astro';
import EmbedBuilderApp from '../react/embeds/EmbedBuilderApp';

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  botName: string;
  botIcon: string;
  templateNames: string[];
  selected: string;
  premiumActive: boolean;
}
const { user, guildId, guildName, guildIcon, botName, botIcon, templateNames, selected, premiumActive } = Astro.props;
const userAvatarUrl = user.avatar ?? '/assets/mascot-icon.png';
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="embeds" pageTitle="Embeds">
  <h1>Embeds</h1>
  <p class="eb-sub">Rich message templates for <b>{guildName}</b>. Point a custom command or autoresponder at one by name, or send it directly with <code>/embed send</code>.</p>

  <EmbedBuilderApp
    client:only="react"
    guildId={guildId}
    botName={botName}
    botIcon={botIcon}
    userAvatarUrl={userAvatarUrl}
    guildIconUrl={guildIcon}
    initialTemplateNames={templateNames}
    initialSelected={selected}
    premiumActive={premiumActive}
  />
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  .eb-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 24px; max-width: 68ch; }
  .eb-sub b { color: var(--text); }
  .eb-sub code { font-family: var(--mono); color: var(--accent); }
</style>
