---
import { Icon } from 'astro-icon/components';
import { getDashLang, makeT } from '../i18n/dash';
import DashConfigImport from './DashConfigImport.astro';

// The "Config Management" page: what the snapshot holds (numbers read from the snapshot itself), the snapshot as a YAML viewer,
// the JSON download and the reset. The YAML comes from general-config-preview and the numbers are read from that same text in
// the browser, so the strip and the viewer can never disagree.
interface Props { guildId: string }
const { guildId } = Astro.props;
const dt = makeT(getDashLang(Astro));

// Each tile jumps to the part of the YAML it was counted from (`jump` is that part's key in the file).
const tiles = [
  { id: 'protections', jump: 'moderation', module: dt('Moderation'), label: dt('Protections on') },
  { id: 'welcome', jump: 'onboarding', module: dt('Onboarding'), label: dt('Welcome, leave and boost channels') },
  { id: 'custom_commands', jump: 'automation', module: dt('Automation'), label: dt('Custom commands') },
  { id: 'autoresponders', jump: 'automation', module: dt('Automation'), label: dt('Autoresponders') },
  { id: 'reaction_roles', jump: 'automation', module: dt('Automation'), label: dt('Reaction roles') },
  { id: 'timers', jump: 'automation', module: dt('Automation'), label: dt('Timers') },
  { id: 'feeds', jump: 'automation', module: dt('Automation'), label: dt('Feeds') },
  { id: 'log_routes', jump: 'logging', module: dt('Logging'), label: dt('Log channels set') },
  { id: 'ticket_types', jump: 'tickets', module: dt('Tickets'), label: dt('Ticket categories') },
  { id: 'level_rewards', jump: 'leveling', module: dt('Leveling'), label: dt('Level rewards') },
  { id: 'embed_templates', jump: 'design', module: dt('Design'), label: dt('Saved embeds') },
  { id: 'image_cards', jump: 'design', module: dt('Design'), label: dt('Image cards') },
];

const texts = {
  loading: dt('Loading...'),
  failed: dt("Couldn't load the preview, try refreshing."),
  retry: dt('Try again'),
  lines: dt('{n} lines'),
  copy: dt('Copy'),
  copied: dt('Copied'),
  matches: dt('{n} matches'),
  noMatches: dt('No matches.'),
  server: dt('Server'),
  sections: {
    bot_profile: dt('Bot profile'),
    permissions: dt('Permissions'),
    moderation: dt('Moderation'),
    appeals: dt('Appeals'),
    leveling: dt('Leveling'),
    tickets: dt('Tickets'),
    giveaways: dt('Giveaways'),
    automation: dt('Automation'),
    design: dt('Design'),
    logging: dt('Logging'),
    community: dt('Community'),
    boards: dt('Boards'),
    vanity: dt('Vanity roles'),
    forms: dt('Forms'),
    onboarding: dt('Onboarding'),
  },
};
---
<div class="cm sx-stack" data-cm data-guild={guildId} data-src={`/dash/guild/${guildId}/general-config-preview`} data-text={JSON.stringify(texts)}>
  <p class="sx-lead cm-intro">{dt('Back up or reset what\'s on this page and Petto\'s look in this server.')}</p>

  <section class="sx-panel cm-summary" aria-labelledby="cm-sum-h">
    <div class="sx-panel-head">
      <span class="sx-panel-icon" style="--c:#a5ea7a"><Icon name="ph:list-dashes-fill" width="17" height="17" /></span>
      <h2 id="cm-sum-h">{dt('What your snapshot holds')}</h2>
    </div>
    <p class="sx-lead">{dt('The numbers are read from the snapshot below. Press one to see where it comes from.')}</p>
    <div class="cm-tiles">
      {tiles.map((t) => (
        <button type="button" class={`sx-tile cm-tile cm-m-${t.jump}`} data-tile={t.id} data-jump={t.jump}>
          <span class="sx-tile-label">{t.module}</span>
          <b data-v>-</b>
          <span class="cm-tile-l">{t.label}</span>
        </button>
      ))}
    </div>
  </section>

  <section class="sx-panel cm-viewer" aria-labelledby="cm-view-h">
    <div class="sx-panel-head cm-vhead">
      <span class="sx-panel-icon" style="--c:#a5ea7a"><Icon name="ph:file-code-fill" width="17" height="17" /></span>
      <h2 id="cm-view-h">{dt('Current configuration (YAML)')}</h2>
      <span class="sx-tag cm-lines" data-cm-lines></span>
      <div class="cm-vbtns">
        <button type="button" class="btn btn-ghost btn-sm" data-cm-copy><Icon name="ph:copy-bold" width="14" height="14" /><span data-cm-copy-l>{dt('Copy')}</span></button>
        <button type="button" class="btn btn-ghost btn-sm" data-cm-yaml><Icon name="ph:download-simple-bold" width="14" height="14" />{dt('Download YAML')}</button>
      </div>
    </div>
    <p class="sx-lead">{dt('Read-only, a snapshot of what\'s saved. Change it from its own page of the dashboard, not by editing this.')}</p>

    <div class="cm-toolbar">
      <label class="cm-search">
        <Icon name="ph:magnifying-glass-bold" width="14" height="14" />
        <input type="search" data-cm-q placeholder={dt('Search the snapshot')} aria-label={dt('Search the snapshot')} autocomplete="off" spellcheck="false" />
        <span class="cm-count" data-cm-count aria-live="polite"></span>
      </label>
      <label class="dfx-chip"><input type="checkbox" data-cm-only />{dt('Only matching lines')}</label>
      <label class="dfx-chip"><input type="checkbox" data-cm-wrap />{dt('Wrap lines')}</label>
    </div>

    <div class="cm-body">
      <nav class="cm-nav" data-cm-nav aria-label={dt('Jump to a part of the file')}></nav>
      <div class="cm-codebox">
        <div class="cm-code" data-cm-code tabindex="0" role="region" aria-label={dt('Current configuration (YAML)')}>
          <div class="cm-skel" aria-hidden="true">
            {[62, 38, 74, 50, 30, 66, 44, 58, 36, 70, 48, 28].map((w) => <span style={`width:${w}%`}></span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="sx-duo cm-duo">
    <section class="sx-panel cm-download" aria-labelledby="cm-dl-h">
      <div class="sx-panel-head">
        <span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:download-simple-bold" width="17" height="17" /></span>
        <h2 id="cm-dl-h">{dt('Download')}</h2>
      </div>
      <p class="sx-lead">{dt('A JSON file with the settings of these modules, row by row. Keep it as a copy or to compare two servers. Petto cannot import this one back: to bring settings back, import the YAML file.')}</p>
      <div class="cm-actions">
        <a href={`/dash/guild/${guildId}/general-export`} class="btn btn-accent btn-sm">
          <Icon name="ph:download-simple-bold" width="14" height="14" />
          {dt('Download config')}
        </a>
        <span class="cm-file">petto-{guildId}-config.json</span>
      </div>
      <p class="sx-hint cm-backups"><Icon name="ph:archive-fill" width="15" height="15" /><span>{dt('To bring back the server itself (roles, channels, emojis), use')} <a href={`/dash/guild/${guildId}/backups`}>{dt('Backups')}</a>.</span></p>
    </section>

    <section class="sx-panel cm-danger" aria-labelledby="cm-danger-h">
      <div class="sx-panel-head">
        <span class="sx-panel-icon" style="--c:var(--red)"><Icon name="ph:warning-fill" width="17" height="17" /></span>
        <h2 id="cm-danger-h">{dt('Danger zone')}</h2>
      </div>
      <p class="sx-lead">{dt('Reset config puts these back to their defaults:')}</p>
      <ul class="cm-list">
        <li>{dt('The command prefix goes back to !.')}</li>
        <li>{dt('The mute role is cleared, so Petto uses Discord\'s native timeout.')}</li>
        <li>{dt('The bot\'s nickname, picture, banner and about me in this server (on Discord too).')}</li>
      </ul>
      <p class="sx-hint">{dt('Nothing else changes: AutoMod, levels, automation and the other modules, and the members\' data, stay as they are. This can\'t be undone.')}</p>
      <form method="POST" class="dg-reset-form cm-reset" data-no-dirty>
        <input type="hidden" name="action" value="reset" />
        <button type="submit" class="btn btn-danger btn-sm" data-confirm={dt("Reset the prefix, mute role, and the bot's nickname/avatar/banner/description in this server back to default? This can't be undone.")}>
          <Icon name="ph:arrow-counter-clockwise-bold" width="14" height="14" />
          {dt('Reset config')}
        </button>
      </form>
    </section>
  </div>

  <DashConfigImport guildId={guildId} />

  <section class="sx-panel cm-scope" aria-labelledby="cm-scope-h">
    <div class="sx-panel-head">
      <span class="sx-panel-icon" style="--c:#8399ff"><Icon name="ph:info-fill" width="17" height="17" /></span>
      <h2 id="cm-scope-h">{dt('What is in a snapshot')}</h2>
    </div>
    <div class="cm-folds">
      <details class="dfx-acc cm-yes" open>
        <summary><Icon name="ph:check-circle-fill" width="17" height="17" class="cm-fold-ico" /><span class="dfx-acc-title"><b>{dt('Included')}</b></span><Icon name="ph:caret-down-bold" class="dfx-caret" width="14" height="14" /></summary>
        <div class="dfx-acc-body">
          <ul class="cm-list">
            <li>{dt('The prefix, the mute role and the bot\'s look (nickname, picture, banner, about me).')}</li>
            <li>{dt('The settings of AutoMod, anti-nuke, levels, giveaways, reports, booster roles, welcome, leave and boost messages, verification, bump reminders and ping on join.')}</li>
            <li>{dt('How many custom commands, autoresponders, sticky messages, reaction roles, timers, feeds, counters, log channels, ticket categories, level rewards, saved embeds and image cards the server has. The JSON file has each one, row by row.')}</li>
          </ul>
        </div>
      </details>
      <details class="dfx-acc cm-no" open>
        <summary><Icon name="ph:x-circle-fill" width="17" height="17" class="cm-fold-ico" /><span class="dfx-acc-title"><b>{dt('Not included')}</b></span><Icon name="ph:caret-down-bold" class="dfx-caret" width="14" height="14" /></summary>
        <div class="dfx-acc-body">
          <ul class="cm-list">
            <li>{dt('Members\' data: XP and levels, warnings, cases, notes and tickets.')}</li>
            <li>{dt('Messages, and the pictures and files you uploaded.')}</li>
            <li>{dt('Tokens, keys and passwords.')}</li>
            <li>{dt('Premium, billing and dashboard access.')}</li>
            <li>{dt('The settings of pages not listed above, such as suggestions, forms, birthdays and permissions.')}</li>
          </ul>
        </div>
      </details>
    </div>
  </section>

  <script is:inline>
    (function () {
      var root = document.querySelector('[data-cm]');
      if (!root || root.dataset.cmBound) return;
      root.dataset.cmBound = '1';
      var T = JSON.parse(root.dataset.text);
      var codeEl = root.querySelector('[data-cm-code]');
      var navEl = root.querySelector('[data-cm-nav]');
      var qEl = root.querySelector('[data-cm-q]');
      var countEl = root.querySelector('[data-cm-count]');
      var linesEl = root.querySelector('[data-cm-lines]');
      var onlyEl = root.querySelector('[data-cm-only]');
      var wrapEl = root.querySelector('[data-cm-wrap]');
      var copyBtn = root.querySelector('[data-cm-copy]');
      var copyLabel = root.querySelector('[data-cm-copy-l]');
      var yamlBtn = root.querySelector('[data-cm-yaml]');
      var text = '';
      var lines = [];
      var rows = [];
      var sections = [];
      var hits = [];
      var cur = -1;
      var vals = {};
      // The part chosen from the list or a tile stays marked while the file settles there, even when it is too near the end to reach the top.
      var forced = '';

      function fill(s, n) { return String(s).replace('{n}', n); }
      function el(tag, cls, t) { var n = document.createElement(tag); if (cls) n.className = cls; if (t != null) n.textContent = t; return n; }

      // The values of the file as "path.to.key" -> text (the file is ours: two spaces per level, one key per line).
      function parse() {
        vals = {};
        var stack = [];
        lines.forEach(function (l) {
          var m = /^( *)([A-Za-z0-9_]+):(?: +(.*))?$/.exec(l);
          if (!m) return;
          var d = m[1].length / 2;
          stack.length = d; stack[d] = m[2];
          var v = m[3];
          if (v != null && v.trim() && v.trim().charAt(0) !== '#') vals[stack.slice(0, d + 1).join('.')] = v.replace(/\s+#.*$/, '').trim();
        });
      }
      function num(k) { var n = Number(vals[k]); return isFinite(n) ? n : 0; }
      function on(k) { return vals[k] === 'true'; }
      function set(k) { return vals[k] != null && vals[k] !== 'null'; }

      function tileValues() {
        var protections = ['moderation.automod.word_filter_enabled', 'moderation.automod.anti_spam_enabled', 'moderation.automod.anti_raid_enabled', 'moderation.automod.anti_alt_enabled', 'moderation.antinuke.enabled'].filter(on).length;
        var welcome = ['onboarding.welcome_channel_id', 'onboarding.leave_channel_id', 'onboarding.boost_channel_id'].filter(set).length;
        return {
          protections: protections + '/5',
          welcome: welcome + '/3',
          custom_commands: num('automation.custom_commands_count'),
          autoresponders: num('automation.autoresponders_count'),
          reaction_roles: num('automation.reaction_roles_count'),
          timers: num('automation.timers_count'),
          feeds: num('automation.feeds_count'),
          log_routes: num('logging.routed_events_count'),
          ticket_types: num('tickets.support_types_count'),
          level_rewards: num('leveling.rewards_count'),
          embed_templates: num('design.embed_templates_count'),
          image_cards: num('design.image_cards_count'),
        };
      }
      function drawTiles() {
        var v = tileValues();
        root.querySelectorAll('[data-tile]').forEach(function (tile) {
          var x = v[tile.dataset.tile];
          tile.querySelector('[data-v]').textContent = x == null ? '-' : x;
          tile.classList.toggle('zero', x === 0 || x === '0/5' || x === '0/3');
        });
      }

      // A YAML line as [class, text] pieces: key, comment, quoted text, numbers, true/false, null.
      function pieces(line) {
        var out = [];
        var m = /^( *)(- )?([A-Za-z0-9_]+)(:)(.*)$/.exec(line);
        var rest = line;
        if (/^\s*#/.test(line)) return [['c', line]];
        if (m) { if (m[1]) out.push(['', m[1]]); if (m[2]) out.push(['p', m[2]]); out.push(['k', m[3]], ['p', m[4]]); rest = m[5]; }
        var re = /('(?:[^']|'')*')|("(?:[^"\\]|\\.)*")|(-?\b\d+(?:\.\d+)?\b)|(\btrue\b|\bfalse\b)|(\bnull\b)|(#.*$)/g;
        var last = 0, t;
        while ((t = re.exec(rest))) {
          if (t.index > last) out.push(['', rest.slice(last, t.index)]);
          out.push([t[1] || t[2] ? 's' : t[3] ? 'n' : t[4] ? 'b' : t[5] ? 'z' : 'c', t[0]]);
          last = t.index + t[0].length;
        }
        if (last < rest.length) out.push(['', rest.slice(last)]);
        return out;
      }

      function addPiece(parent, cls, str, q, hitList) {
        var host = cls ? el('span', 'y-' + cls) : parent;
        if (!q) { host.appendChild(document.createTextNode(str)); }
        else {
          var low = str.toLowerCase(), at = 0, i;
          while ((i = low.indexOf(q, at)) !== -1) {
            if (i > at) host.appendChild(document.createTextNode(str.slice(at, i)));
            var mark = el('mark', 'cm-hit', str.slice(i, i + q.length));
            host.appendChild(mark); hitList.push(mark);
            at = i + q.length;
          }
          if (at < str.length) host.appendChild(document.createTextNode(str.slice(at)));
        }
        if (cls) parent.appendChild(host);
      }

      function draw() {
        var q = qEl.value.trim().toLowerCase();
        var only = onlyEl.checked && q;
        hits = []; cur = -1;
        var frag = document.createDocumentFragment();
        rows = [];
        lines.forEach(function (line, i) {
          var row = el('div', 'cm-line');
          var n = el('span', 'cm-n', String(i + 1));
          var t = el('span', 'cm-t');
          var before = hits.length;
          pieces(line).forEach(function (p) { addPiece(t, p[0], p[1], q, hits); });
          if (!t.firstChild) t.appendChild(document.createTextNode(' '));
          if (only && hits.length === before) row.hidden = true;
          row.append(n, t);
          frag.appendChild(row);
          rows.push(row);
        });
        codeEl.replaceChildren(frag);
        codeEl.classList.toggle('wrap', wrapEl.checked);
        countEl.textContent = q ? (hits.length ? fill(T.matches, hits.length) : T.noMatches) : '';
        countEl.classList.toggle('none', Boolean(q) && !hits.length);
        if (q && hits.length) step(1);
        activeSection();
      }

      function top(row) { return row.offsetTop; }
      function scrollRow(row, smooth) {
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        codeEl.scrollTo({ top: Math.max(0, top(row) - 6), behavior: smooth && !reduce ? 'smooth' : 'auto' });
      }
      // Enter goes to the next match, Shift+Enter to the one before.
      function step(dir) {
        if (!hits.length) return;
        if (cur >= 0) hits[cur].classList.remove('cur');
        cur = (cur + dir + hits.length) % hits.length;
        var mark = hits[cur];
        mark.classList.add('cur');
        var row = mark.closest('.cm-line');
        var y = row.offsetTop, box = codeEl.clientHeight;
        if (y < codeEl.scrollTop + 8 || y > codeEl.scrollTop + box - 40) codeEl.scrollTo({ top: Math.max(0, y - box / 3), behavior: 'auto' });
      }

      function buildSections() {
        sections = [];
        lines.forEach(function (l, i) {
          if (/^guild_id:/.test(l)) sections.push({ key: 'server', label: T.server, line: i });
          var m = /^([a-z_]+):\s*(#.*)?$/.exec(l);
          if (m) sections.push({ key: m[1], label: T.sections[m[1]] || m[1], line: i });
        });
        sections.forEach(function (s, i) { s.end = i + 1 < sections.length ? sections[i + 1].line : lines.length; });
        navEl.replaceChildren();
        sections.forEach(function (s) {
          var b = el('button', 'cm-nav-i');
          b.type = 'button'; b.dataset.key = s.key;
          b.append(el('span', 'cm-nav-l', s.label), el('span', 'cm-nav-n', String(s.line + 1)));
          b.addEventListener('click', function () { jump(s.key); });
          navEl.appendChild(b);
          s.btn = b;
        });
      }
      function jump(key) {
        var s = sections.filter(function (x) { return x.key === key; })[0];
        if (!s || !rows[s.line]) return;
        // A line filtered out by the search is shown again, so the part can be seen.
        if (onlyEl.checked) { onlyEl.checked = false; draw(); }
        forced = key;
        scrollRow(rows[s.line], true);
        activeSection();
        for (var i = s.line; i < Math.min(s.end, s.line + 3); i++) { if (rows[i]) { rows[i].classList.remove('flash'); void rows[i].offsetWidth; rows[i].classList.add('flash'); } }
        root.querySelector('[data-cm-code]').focus({ preventScroll: true });
      }
      var frame = 0;
      function activeSection() {
        if (!sections.length || !rows.length) return;
        var y = codeEl.scrollTop + 12, found = sections[0];
        sections.forEach(function (s) { var r = rows[s.line]; if (r && !r.hidden && r.offsetTop <= y) found = s; });
        if (forced) found = sections.filter(function (s) { return s.key === forced; })[0] || found;
        sections.forEach(function (s) { s.btn.classList.toggle('on', s === found); });
      }
      ['wheel', 'touchstart', 'pointerdown', 'keydown'].forEach(function (ev) { codeEl.addEventListener(ev, function () { forced = ''; }, { passive: true }); });
      codeEl.addEventListener('scroll', function () { if (frame) return; frame = requestAnimationFrame(function () { frame = 0; activeSection(); }); });

      qEl.addEventListener('input', function () { forced = ''; draw(); });
      qEl.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); step(e.shiftKey ? -1 : 1); }
        else if (e.key === 'Escape' && qEl.value) { e.preventDefault(); qEl.value = ''; draw(); }
      });
      onlyEl.addEventListener('change', draw);
      wrapEl.addEventListener('change', function () { codeEl.classList.toggle('wrap', wrapEl.checked); activeSection(); });
      root.querySelectorAll('[data-jump]').forEach(function (b) { b.addEventListener('click', function () { if (text) jump(b.dataset.jump); }); });

      function copyText(s) {
        if (navigator.clipboard && navigator.clipboard.writeText) return navigator.clipboard.writeText(s);
        return new Promise(function (resolve, reject) {
          var ta = el('textarea'); ta.value = s; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;opacity:0;top:0;left:0';
          document.body.appendChild(ta); ta.select();
          var ok = false; try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
          ta.remove(); ok ? resolve() : reject();
        });
      }
      var copyTimer = 0;
      copyBtn.addEventListener('click', function () {
        if (!text) return;
        copyText(text).then(function () {
          copyLabel.textContent = T.copied; copyBtn.classList.add('done');
          clearTimeout(copyTimer);
          copyTimer = setTimeout(function () { copyLabel.textContent = T.copy; copyBtn.classList.remove('done'); }, 1800);
        }).catch(function () {});
      });
      yamlBtn.addEventListener('click', function () {
        if (!text) return;
        var url = URL.createObjectURL(new Blob([text], { type: 'text/yaml;charset=utf-8' }));
        var a = document.createElement('a');
        a.href = url; a.download = 'petto-' + root.dataset.guild + '-config.yaml';
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
      });

      function failed() {
        var box = el('div', 'cm-fail');
        var retry = el('button', 'btn btn-ghost btn-sm', T.retry); retry.type = 'button';
        retry.addEventListener('click', load);
        box.append(el('span', null, T.failed), retry);
        codeEl.replaceChildren(box);
      }
      function load() {
        var skel = el('div', 'cm-skel'); skel.setAttribute('aria-hidden', 'true');
        [62, 38, 74, 50, 30, 66, 44, 58, 36, 70, 48, 28].forEach(function (w) { var s = el('span'); s.style.width = w + '%'; skel.appendChild(s); });
        codeEl.replaceChildren(skel);
        fetch(root.dataset.src, { credentials: 'same-origin' })
          .then(function (res) { return res.ok ? res.text() : Promise.reject(); })
          .then(function (body) {
            text = body.replace(/\n$/, '');
            lines = text.split('\n');
            linesEl.textContent = fill(T.lines, lines.length);
            parse(); drawTiles(); buildSections(); draw();
            // Open past the banner, on the first setting; the banner is still there above.
            if (sections.length && rows[sections[0].line]) { codeEl.scrollTop = Math.max(0, rows[sections[0].line].offsetTop - 8); activeSection(); }
            // The file is uncovered from the top down instead of popping in.
            if (!(window.dglMotion && window.dglMotion.reduced())) { codeEl.classList.add('dgl-reveal-down'); codeEl.addEventListener('animationend', function done(e) { if (e.target !== codeEl) return; codeEl.classList.remove('dgl-reveal-down'); codeEl.removeEventListener('animationend', done); }); }
          })
          .catch(failed);
      }
      load();
      // The import panel asks for the file to be read again after it applies a file (no page reload).
      root.addEventListener('cm:reload', function () { load(); });
    })();
  </script>
</div>

<style is:global>
  /* The page is a stack of panels of the settings kit; what is here is only what the kit does not have: the tiles that jump to a part of the file, and the file viewer. */
  .cm { container: cm / inline-size; min-width: 0; --cm-moderation: #c98791; --cm-onboarding: #86b894; --cm-automation: #9bd0f5; --cm-logging: #f5c26b; --cm-tickets: #c6a8f5; --cm-leveling: #f0a88f; --cm-design: #8399ff; }
  :root[data-theme="light"] .cm { --cm-moderation: #a85565; --cm-onboarding: #3f7a52; --cm-automation: #3a7fb8; --cm-logging: #b07a0c; --cm-tickets: #7b55c4; --cm-leveling: #c4573a; --cm-design: #4a5fd0; }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) .cm { --cm-moderation: #a85565; --cm-onboarding: #3f7a52; --cm-automation: #3a7fb8; --cm-logging: #b07a0c; --cm-tickets: #7b55c4; --cm-leveling: #c4573a; --cm-design: #4a5fd0; }
  }
  .cm .cm-intro { margin: 0; max-width: 70ch; }
  .cm .sx-lead a, .cm .sx-hint a { color: var(--accent); }

  /* The numbers: twelve tiles, always whole rows (4, 3 or 2 per row). Each is a button that jumps to the part of the file it was counted from. */
  .cm .cm-tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  @container cm (min-width: 560px) { .cm .cm-tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @container cm (min-width: 760px) { .cm .cm-tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .cm .cm-tile { font: inherit; color: inherit; text-align: left; cursor: pointer; transition: border-color .3s ease, background-color .3s ease; }
  .cm .cm-tile:hover { border-color: color-mix(in srgb, var(--m) 55%, var(--border)); }
  .cm .cm-tile:active { background: linear-gradient(180deg, color-mix(in srgb, var(--m) 16%, var(--card)), var(--card) 70%); transform: none; filter: none; }
  .cm .cm-tile:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cm .cm-m-moderation { --m: var(--cm-moderation); } .cm .cm-m-onboarding { --m: var(--cm-onboarding); } .cm .cm-m-automation { --m: var(--cm-automation); } .cm .cm-m-logging { --m: var(--cm-logging); }
  .cm .cm-m-tickets { --m: var(--cm-tickets); } .cm .cm-m-leveling { --m: var(--cm-leveling); } .cm .cm-m-design { --m: var(--cm-design); }
  .cm .cm-tile > b { font-variant-numeric: lining-nums tabular-nums; }
  .cm .cm-tile.zero > b { color: var(--text-dim); }
  .cm .cm-tile-l { font-size: 12.5px; color: var(--text-muted); line-height: 1.3; }

  /* The viewer */
  .cm .cm-viewer { container: cmv / inline-size; }
  .cm .cm-vhead { flex-wrap: wrap; row-gap: 10px; }
  .cm .cm-vhead h2 { flex: 1 1 auto; }
  .cm .cm-vbtns { display: flex; gap: 8px; flex-wrap: wrap; margin-left: auto; }
  .cm .cm-vbtns .btn { display: inline-flex; align-items: center; gap: 6px; }
  .cm .cm-vbtns .btn.done { color: var(--green); border-color: var(--green); }
  .cm .cm-lines { font-family: var(--mono); font-weight: 400; }
  .cm .cm-lines:empty { display: none; }
  .cm .cm-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; }
  .cm .cm-search { flex: 1 1 240px; min-width: 0; max-width: 420px; display: flex; align-items: center; gap: 8px; border: 1px solid var(--border); border-radius: 10px; padding: 0 12px; background: var(--card); color: var(--text-dim); transition: border-color .25s ease, box-shadow .25s ease; }
  .cm .cm-search:hover { border-color: color-mix(in srgb, var(--text) 24%, var(--border)); }
  .cm .cm-search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .cm .cm-search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--text); font-family: var(--sans); font-size: 13.5px; padding: 9px 0; }
  .cm .cm-count { font-family: var(--mono); font-size: 10.5px; color: var(--text-dim); white-space: nowrap; }
  .cm .cm-count.none { color: var(--red); }

  .cm .cm-body { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; min-width: 0; grid-template-rows: auto minmax(0, 1fr); }
  .cm .cm-nav { display: flex; flex-wrap: wrap; gap: 6px; }
  .cm .cm-nav-i { flex: 0 0 auto; display: inline-flex; align-items: baseline; gap: 7px; border: 1px solid var(--border); border-radius: 8px; padding: 5px 10px; background: var(--card); color: var(--text-muted); font-family: var(--sans); font-size: 12.5px; cursor: pointer; transition: background-color .25s ease, border-color .25s ease, color .25s ease; }
  .cm .cm-nav-i:hover { color: var(--text); background: var(--card-hover); }
  .cm .cm-nav-i.on { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  .cm .cm-nav-n { font-family: var(--mono); font-size: 10px; opacity: .6; }
  @container cmv (min-width: 820px) {
    .cm .cm-body { grid-template-columns: 176px minmax(0, 1fr); grid-template-rows: minmax(0, 1fr); gap: 14px; align-items: stretch; }
    .cm .cm-nav { flex-direction: column; flex-wrap: nowrap; align-content: start; overflow-y: auto; padding: 0; gap: 3px; }
    .cm .cm-nav-i { justify-content: space-between; width: 100%; border-color: transparent; background: transparent; }
    .cm .cm-nav-i.on { border-color: var(--accent); }
  }

  /* The box has the height; the code scrolls inside it, so a long file never makes the page endless. */
  .cm .cm-codebox { position: relative; height: clamp(360px, 62vh, 700px); min-width: 0; }
  .cm .cm-code { position: absolute; inset: 0; background: var(--bg-raise); border: 1px solid var(--border-soft); border-radius: 10px; overflow: auto; font-family: var(--mono); font-size: 12px; line-height: 1.65; padding: 8px 0; outline: none; }
  .cm .cm-code:focus-visible { border-color: var(--accent); }
  .cm .cm-line { display: flex; min-width: max-content; }
  .cm .cm-code.wrap .cm-line { min-width: 0; }
  .cm .cm-line[hidden] { display: none; }
  .cm .cm-n { position: sticky; left: 0; flex: 0 0 auto; width: 46px; box-sizing: border-box; padding-right: 12px; text-align: right; color: var(--text-dim); opacity: .7; background: var(--bg-raise); user-select: none; font-size: 11px; }
  .cm .cm-t { padding: 0 16px 0 6px; white-space: pre; color: var(--text); }
  .cm .cm-code.wrap .cm-t { white-space: pre-wrap; overflow-wrap: anywhere; min-width: 0; }
  .cm .cm-line.flash .cm-t, .cm .cm-line.flash .cm-n { animation: cm-flash 1.4s ease-out; }
  @keyframes cm-flash { from { background: var(--accent-soft); } to { background: transparent; } }
  .cm .cm-line.flash .cm-n { animation-name: cm-flash-n; }
  @keyframes cm-flash-n { from { background: var(--accent-soft); } to { background: var(--bg-raise); } }
  .cm .cm-code .y-k { color: var(--accent); }
  .cm .cm-code .y-p { color: var(--text-dim); }
  .cm .cm-code .y-s { color: #a5ea7a; }
  .cm .cm-code .y-n { color: #fed53c; }
  .cm .cm-code .y-b { color: #8399ff; }
  .cm .cm-code .y-z { color: var(--text-dim); font-style: italic; }
  .cm .cm-code .y-c { color: var(--text-dim); }
  :root[data-theme="light"] .cm .cm-code .y-s { color: #2f7a3d; } :root[data-theme="light"] .cm .cm-code .y-n { color: #9a6200; } :root[data-theme="light"] .cm .cm-code .y-b { color: #3b4fd0; }
  @media (prefers-color-scheme: light) { :root:not([data-theme="dark"]) .cm .cm-code .y-s { color: #2f7a3d; } :root:not([data-theme="dark"]) .cm .cm-code .y-n { color: #9a6200; } :root:not([data-theme="dark"]) .cm .cm-code .y-b { color: #3b4fd0; } }
  .cm .cm-code .cm-hit { background: color-mix(in srgb, var(--yellow) 38%, transparent); color: inherit; border-radius: 3px; }
  .cm .cm-code .cm-hit.cur { background: var(--yellow); color: #1b1b1b; }
  .cm .cm-skel { display: grid; gap: 10px; padding: 14px 18px; }
  .cm .cm-skel span { display: block; height: 10px; border-radius: 5px; background: var(--border-soft); animation: cm-pulse 1.4s ease-in-out infinite; }
  @keyframes cm-pulse { 50% { opacity: .45; } }
  .cm .cm-fail { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; padding: 18px; font-family: var(--sans); font-size: 13px; color: var(--text-muted); }

  /* Download and reset side by side */
  .cm .cm-duo { align-items: stretch; }
  @container cm (max-width: 640px) { .cm .cm-duo { grid-template-columns: minmax(0, 1fr); } }
  .cm .cm-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .cm .cm-actions .btn { display: inline-flex; align-items: center; gap: 6px; }
  .cm .cm-file { font-family: var(--mono); font-size: 11.5px; color: var(--text-dim); overflow-wrap: anywhere; min-width: 0; }
  .cm .cm-list { margin: 0; padding: 0 0 0 18px; display: grid; gap: 7px; font-size: 13px; line-height: 1.5; color: var(--text-muted); }
  .cm .cm-list li::marker { color: var(--text-dim); }
  .cm .cm-danger { border-color: color-mix(in srgb, var(--red) 50%, var(--border)); background: color-mix(in srgb, var(--red) 4%, var(--card)); }
  .cm .cm-reset { margin: auto 0 0; padding-top: 2px; }
  .cm .cm-backups { display: flex; align-items: flex-start; gap: 9px; margin-top: auto; padding-top: 14px; border-top: 1px solid var(--border-soft); font-size: 12.5px; }
  .cm .cm-backups svg { flex: none; margin-top: 1px; color: var(--text-dim); }
  .cm .cm-danger .btn { display: inline-flex; align-items: center; gap: 6px; }
  .cm .btn-danger { background: var(--red-soft); color: var(--red); border: 1px solid var(--red); }
  .cm .btn-danger:hover { background: var(--red); color: var(--accent-ink); }
  .cm .btn-sm { padding: 8px 16px; font-size: 13px; }

  /* What is in a snapshot: two folds side by side */
  .cm .cm-folds { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; align-items: start; }
  @container cm (max-width: 640px) { .cm .cm-folds { grid-template-columns: minmax(0, 1fr); } }
  .cm .cm-folds summary:active { transform: none; filter: none; }
  .cm .cm-fold-ico { flex: none; }
  .cm .cm-yes .cm-fold-ico { color: var(--green); }
  .cm .cm-no .cm-fold-ico { color: var(--red); }

  @container cm (max-width: 520px) {
    .cm .cm-vbtns { width: 100%; } .cm .cm-vbtns .btn { flex: 1 1 auto; justify-content: center; white-space: nowrap; }
    .cm .cm-search { max-width: none; flex-basis: 100%; }
    .cm .cm-codebox { height: clamp(320px, 60vh, 520px); }
    .cm .cm-code { font-size: 11.5px; }
    .cm .cm-nav { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 4px; }
    .cm .cm-danger .btn, .cm .cm-actions .btn { width: 100%; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) { .cm .cm-line.flash .cm-t, .cm .cm-line.flash .cm-n, .cm .cm-skel span { animation: none; } }
</style>
