---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import type { Locale } from '../i18n/ui';
import { getCredits, CREDIT_KINDS, type CreditRow } from '../utils/credits';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const copy = {
  en: {
    eyebrow: 'Credits',
    title: 'Thank you.',
    lede: 'Petto stands on the work of many people, communities and tools. These are the ones that make it possible.',
    note: 'Missing someone, or want your credit changed? Open a ticket in the Petto support Discord and we will fix it.',
    support: 'Open a support ticket',
    visit: (name: string) => `Visit ${name}`,
    kinds: { people: 'People', features: 'Features', data: 'Data sources', systems: 'Systems', tools: 'Tools and libraries', art: 'Art and icons', other: 'And more' },
  },
  es: {
    eyebrow: 'Créditos',
    title: 'Gracias.',
    lede: 'Petto se apoya en el trabajo de muchas personas, comunidades y herramientas. Estas son las que lo hacen posible.',
    note: '¿Falta alguien o quieres cambiar tu crédito? Abre un ticket en el Discord de soporte de Petto y lo arreglamos.',
    support: 'Abrir un ticket de soporte',
    visit: (name: string) => `Visitar ${name}`,
    kinds: { people: 'Personas', features: 'Funciones', data: 'Fuentes de datos', systems: 'Sistemas', tools: 'Herramientas y librerías', art: 'Arte e iconos', other: 'Y más' },
  },
  'pt-BR': {
    eyebrow: 'Créditos',
    title: 'Obrigado.',
    lede: 'O Petto se apoia no trabalho de muitas pessoas, comunidades e ferramentas. Estas são as que o tornam possível.',
    note: 'Faltou alguém, ou quer mudar o seu crédito? Abra um ticket no Discord de suporte do Petto e a gente corrige.',
    support: 'Abrir um ticket de suporte',
    visit: (name: string) => `Visitar ${name}`,
    kinds: { people: 'Pessoas', features: 'Funções', data: 'Fontes de dados', systems: 'Sistemas', tools: 'Ferramentas e bibliotecas', art: 'Arte e ícones', other: 'E mais' },
  },
} as const;

const t = copy[lang];

// The credits come from the table the team edits in the dashboard (or the original list), grouped by type.
const { credits } = await getCredits(Astro);
const groups = CREDIT_KINDS.map((kind) => ({ kind, items: credits.filter((credit) => credit.kind === kind) })).filter((group) => group.items.length > 0);
const descriptionOf = (credit: CreditRow) => (lang === 'es' ? credit.description_es : lang === 'pt-BR' ? credit.description_pt : credit.description_en) || credit.description_en;
---

<Base title={`${t.eyebrow} · Petto`} lang={lang}>
  <main>
    <section class="cr-hero">
      <div class="wrap">
        <div class="eyebrow reveal">{t.eyebrow}</div>
        <h1 class="reveal">{t.title}</h1>
        <p class="cr-lede reveal">{t.lede}</p>
      </div>
    </section>

    <section class="cr-content">
      <div class="wrap">
        {groups.map((group) => (
          <div class="cr-group reveal">
            <h2 class="cr-kind">{t.kinds[group.kind]}</h2>
            <div class="cr-grid">
              {group.items.map((credit) => (
                <article class="cr-card">
                  <div class="cr-top">
                    {credit.logo_url
                      ? <div class="cr-icon cr-icon-logo"><img src={credit.logo_url} alt={credit.name} width="40" height="40" loading="lazy" /></div>
                      : <div class="cr-icon" aria-hidden="true">{credit.name.slice(0, 1).toUpperCase()}</div>}
                    <h3>{credit.name}</h3>
                  </div>
                  <p>{descriptionOf(credit)}</p>
                  {credit.url && (
                    <a class="cr-link" href={credit.url} target="_blank" rel="noopener noreferrer">
                      {t.visit(credit.name)}<Icon name="ph:arrow-up-right" width="14" height="14" />
                    </a>
                  )}
                </article>
              ))}
            </div>
          </div>
        ))}

        <div class="cr-contact reveal">
          <p>{t.note}</p>
          <a class="btn btn-ghost btn-sm" href="https://petto.sbs/support" target="_blank" rel="noopener">
            <Icon name="ph:ticket" width="14" height="14" />
            {t.support}
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .cr-hero { padding: 64px 0 32px; text-align: center; }
  .cr-hero h1 { font-size: 36px; margin: 14px 0 12px; }
  .cr-lede { color: var(--text-muted); font-size: 15.5px; max-width: 58ch; margin: 0 auto; line-height: 1.65; }
  .cr-content { padding: 8px 0 72px; }
  .cr-group { margin-top: 30px; }
  .cr-kind { font-size: 13px; font-family: var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--text-dim); margin: 0 0 12px; font-weight: 600; text-align: center; }
  .cr-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; }
  .cr-card { flex: 0 1 360px; min-width: 0; border: 1px solid var(--border); border-radius: 16px; padding: 20px; background: var(--card); display: flex; flex-direction: column; gap: 10px; transition: transform .18s ease, border-color .18s ease; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .cr-card:hover { transform: translateY(-2px); border-color: var(--text-dim); } }
  .cr-top { display: flex; align-items: center; gap: 12px; }
  .cr-top h3 { margin: 0; font-size: 18px; }
  .cr-icon { display: grid; place-items: center; flex: none; width: 44px; height: 44px; border-radius: 12px; color: var(--accent); background: var(--accent-soft); font-weight: 700; font-size: 19px; }
  .cr-icon-logo { background: var(--bg-raise); }
  .cr-icon-logo img { width: 34px; height: 34px; object-fit: contain; border-radius: 8px; }
  .cr-card p { margin: 0; color: var(--text-muted); font-size: 14px; line-height: 1.65; flex: 1; white-space: pre-line; }
  .cr-link { display: inline-flex; min-height: 36px; align-items: center; gap: 6px; color: var(--accent); font-size: 13.5px; font-weight: 600; text-decoration: none; }
  .cr-link:hover { text-decoration: underline; }
  .cr-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .cr-contact { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 14px 20px; max-width: 760px; margin: 0 auto; padding-top: 38px; color: var(--text-muted); text-align: center; }
  .cr-contact p { margin: 0; font-size: 13.5px; line-height: 1.6; }
  .cr-contact .btn { flex: 0 0 auto; }
  @media (max-width: 560px) {
    .cr-hero h1 { font-size: 30px; }
    .cr-card { flex-basis: 100%; }
    .cr-contact { flex-direction: column; }
  }
</style>
