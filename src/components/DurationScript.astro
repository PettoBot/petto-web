---
// Puts `window.dglDuration` on the page: the same function as src/utils/formatDuration.ts (its source is copied, it is self-contained), for the
// scripts of a page that write a time themselves (a live "5m ago", a countdown). Put it once in a page that needs it; it does nothing twice.
import { formatDuration } from '../utils/formatDuration';
const source = `window.dglDuration = window.dglDuration || (${formatDuration.toString()});`;
---
<script is:inline set:html={source}></script>
