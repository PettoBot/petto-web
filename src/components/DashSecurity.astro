---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';

interface RoleFinding { id: string; name: string; isEveryone: boolean; isAdmin: boolean; matched: string[]; severity: 'critical' | 'high' | 'medium'; }
interface CommandInfo { name: string; category: string; categoryTitle: string; desc: string; }
interface Protection { antinuke: boolean; antiSpam: boolean; antiRaid: boolean; verification: boolean; logs: boolean; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  roleFindings: RoleFinding[];
  unrestrictedCommands: CommandInfo[];
  securityScore: number;
  protection: Protection;
  recommendations: string[];
  section?: string;
}
const { user, guildId, guildName, guildIcon, roleFindings, unrestrictedCommands, securityScore, protection, recommendations, section } = Astro.props;

const sectionMeta: Record<string, string> = { score: 'Security overview', elevated: 'Elevated roles', unrestricted: 'Unrestricted commands' };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'score';
const selectedTitle = sectionMeta[selectedSection];

const SEVERITY_LABEL: Record<string, string> = { critical: 'Critical', high: 'Admin role', medium: 'Elevated' };
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'unrestricted' ? 'security-unrestricted' : 'security'} pageTitle={selectedTitle}>
  <h1>{selectedTitle}</h1>
  <p class="sc-sub">A read-only scan of <b>{guildName}</b>'s protections, role permissions and command coverage. Nothing here changes your server automatically.</p>

  <div class:list={['sc-section', { 'sc-section-hidden': selectedSection !== 'score' }]}>
    <div class="sc-score-card">
      <div>
        <span class="sc-eyebrow">Petto Security Score</span>
        <strong>{securityScore}<small>/100</small></strong>
        <p>{securityScore >= 80 ? 'Good baseline. Keep reviewing it as the server grows.' : securityScore >= 55 ? 'A few protections deserve attention.' : 'Several high-impact protections are missing.'}</p>
      </div>
      <div class="sc-score-ring" style={`--score: ${securityScore * 3.6}deg`}><span>{securityScore}</span></div>
    </div>
    <h2><Icon name="ph:shield-check-fill" width="15" height="15" />Protection status</h2>
    <div class="sc-protection-grid">
      {Object.entries({ 'Anti-nuke': protection.antinuke, 'Anti-spam': protection.antiSpam, 'Anti-raid': protection.antiRaid, Verification: protection.verification, 'Audit logs': protection.logs }).map(([label, enabled]) => (
        <div class:list={['sc-protection', { enabled }]}><Icon name={enabled ? 'ph:check-circle-fill' : 'ph:warning-fill'} width="15" height="15" /><span>{label}</span><b>{enabled ? 'Enabled' : 'Needs setup'}</b></div>
      ))}
    </div>
    <h2 class="sc-recommendation-title"><Icon name="ph:lightbulb-fill" width="15" height="15" />Recommended next steps</h2>
    {recommendations.length ? <ul class="sc-recommendations">{recommendations.slice(0, 6).map((recommendation) => <li>{recommendation}</li>)}</ul> : <p class="sc-empty-note"><Icon name="ph:check-circle-fill" width="14" height="14" />No high-impact gaps were found.</p>}
  </div>

  <div class:list={['sc-section', { 'sc-section-hidden': selectedSection !== 'elevated' }]}>
    <h2><Icon name="ph:shield-warning-fill" width="15" height="15" />Roles with elevated permissions <span class="sc-count">{roleFindings.length}</span></h2>
    <p class="sc-section-note">Roles that can moderate, manage the server, or reach @everyone. Not necessarily wrong, review who's actually in each one.</p>
    {roleFindings.length === 0 ? (
      <p class="sc-empty-note"><Icon name="ph:check-circle-fill" width="14" height="14" />No roles outside the obvious admin ones carry elevated permissions.</p>
    ) : (
      <div class="sc-list">
        {roleFindings.map((r) => (
          <div class={`sc-row sc-row-${r.severity}`}>
            <span class={`sc-sev sc-sev-${r.severity}`}>{SEVERITY_LABEL[r.severity]}</span>
            <span class="sc-role-name">{r.isEveryone ? '@everyone' : r.name}</span>
            <span class="sc-perms">
              {r.isAdmin ? <span class="sc-perm-chip sc-perm-admin">Administrator</span> : r.matched.map((m) => <span class="sc-perm-chip">{m}</span>)}
            </span>
          </div>
        ))}
      </div>
    )}
  </div>

  <div class:list={['sc-section', { 'sc-section-hidden': selectedSection !== 'unrestricted' }]}>
    <h2><Icon name="ph:key-fill" width="15" height="15" />Commands without a custom permission level <span class="sc-count">{unrestrictedCommands.length}</span></h2>
    <p class="sc-section-note">
      These still respect Discord's own per-command permissions, they just don't have an extra level set on the <a href={`/dash/guild/${guildId}/permissions`}>Permissions</a> page yet.
    </p>
    {unrestrictedCommands.length === 0 ? (
      <p class="sc-empty-note"><Icon name="ph:check-circle-fill" width="14" height="14" />Every moderation/setup command has a custom level configured.</p>
    ) : (
      <div class="sc-cmd-grid">
        {unrestrictedCommands.map((c) => (
          <a href={`/dash/guild/${guildId}/permissions`} class="sc-cmd-chip" title={c.desc}>
            <span class="sc-cmd-name">{c.name}</span>
            <span class="sc-cmd-cat">{c.categoryTitle}</span>
          </a>
        ))}
      </div>
    )}
  </div>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  h2 { font-size: 14.5px; margin: 0 0 6px; display: flex; align-items: center; gap: 9px; }
  .sc-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 24px; max-width: 74ch; }
  .sc-sub b { color: var(--text); }

  .sc-section { margin-bottom: 32px; }
  .sc-section-hidden { display: none; }
  .sc-section-note { font-size: 12.5px; color: var(--text-dim); margin: 0 0 14px; max-width: 70ch; }
  .sc-section-note a { color: var(--accent); text-decoration: none; }
  .sc-section-note a:hover { text-decoration: underline; }
  .sc-count { font-family: var(--mono); font-size: 11px; color: var(--text-dim); font-weight: 400; }

  .sc-empty-note { display: flex; align-items: center; gap: 7px; font-size: 13px; color: var(--green); margin: 0; }

  .sc-score-card { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px; margin-bottom: 24px; border: 1px solid var(--border); border-radius: 14px; background: var(--bg-raise); }
  .sc-eyebrow { display: block; color: var(--text-dim); font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 8px; }
  .sc-score-card strong { display: block; color: var(--text); font-size: 44px; line-height: 1; }
  .sc-score-card strong small { color: var(--text-dim); font-size: 16px; font-weight: 500; }
  .sc-score-card p { color: var(--text-muted); font-size: 12.5px; margin: 8px 0 0; }
  .sc-score-ring { width: 74px; height: 74px; border-radius: 50%; display: grid; place-items: center; background: conic-gradient(var(--accent) var(--score), var(--border) 0); position: relative; flex-shrink: 0; }
  .sc-score-ring::after { content: ''; position: absolute; inset: 7px; border-radius: 50%; background: var(--bg-raise); }
  .sc-score-ring span { position: relative; z-index: 1; color: var(--text); font-size: 17px; font-weight: 700; }
  .sc-protection-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-bottom: 24px; }
  .sc-protection { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 8px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 9px; color: var(--text-muted); background: var(--card); font-size: 12.5px; }
  .sc-protection :global(svg) { color: var(--yellow); }
  .sc-protection.enabled :global(svg) { color: var(--green); }
  .sc-protection b { color: var(--text-dim); font-size: 10px; font-weight: 600; }
  .sc-protection.enabled b { color: var(--green); }
  .sc-recommendation-title { margin-top: 24px; }
  .sc-recommendations { margin: 0; padding-left: 18px; color: var(--text-muted); font-size: 13px; line-height: 1.7; }

  .sc-list { display: flex; flex-direction: column; gap: 8px; }
  .sc-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; border: 1px solid var(--border); border-radius: 10px; padding: 10px 14px; background: var(--card); }
  .sc-row-critical { border-color: var(--red); background: var(--red-soft); }
  .sc-role-name { font-size: 13.5px; font-weight: 600; color: var(--text); }
  .sc-perms { display: flex; flex-wrap: wrap; gap: 6px; margin-left: auto; }
  .sc-perm-chip { font-size: 11px; color: var(--text-muted); background: var(--bg-raise); border: 1px solid var(--border); border-radius: 6px; padding: 2px 8px; }
  .sc-perm-admin { color: var(--red); border-color: var(--red); }

  .sc-sev { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; border-radius: 6px; padding: 3px 8px; flex-shrink: 0; }
  .sc-sev-critical { color: var(--red); background: color-mix(in srgb, var(--red) 18%, transparent); }
  .sc-sev-high { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 18%, transparent); }
  .sc-sev-medium { color: var(--text-dim); background: var(--bg-raise); }

  .sc-cmd-grid { display: flex; flex-wrap: wrap; gap: 8px; }
  .sc-cmd-chip { display: flex; flex-direction: column; gap: 2px; border: 1px solid var(--border); border-radius: 9px; padding: 8px 12px; background: var(--card); text-decoration: none; }
  .sc-cmd-chip:hover { border-color: var(--accent); background: var(--accent-soft); }
  .sc-cmd-name { font-family: var(--mono); font-size: 12.5px; color: var(--text); }
  .sc-cmd-cat { font-size: 10px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.03em; }

  @media (max-width: 560px) {
    .sc-protection-grid { grid-template-columns: 1fr; }
    .sc-score-card { padding: 16px; }
  }
</style>
