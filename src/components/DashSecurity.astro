---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface RoleFinding { id: string; name: string; isEveryone: boolean; isAdmin: boolean; matched: string[]; severity: 'critical' | 'high' | 'medium'; }
import type { AccessCommand } from '../utils/commandAccess';
interface Protection { antinuke: boolean; antiSpam: boolean; antiRaid: boolean; verification: boolean; logs: boolean; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  roleFindings: RoleFinding[];
  coverage: AccessCommand[];
  roleNames: Record<string, string>;
  securityScore: number;
  protection: Protection;
  recommendations: string[];
  section?: string;
}
const { user, guildId, guildName, guildIcon, roleFindings, coverage, roleNames, securityScore, protection, recommendations, section } = Astro.props;

const sectionMeta: Record<string, string> = { score: dt('Security overview'), elevated: dt('Elevated roles'), unrestricted: dt('Command coverage') };
const gateOf = (c: AccessCommand) => (c.disabledServer ? 'disabled' : c.restrictRoles.length ? 'roles' : c.level > 0 ? 'level' : c.permissionNames.length ? 'discord' : 'open');
const gateCount = (g: string) => coverage.filter((c) => gateOf(c) === g).length;
const gates = [
  { id: 'roles', label: dt('Restricted to roles'), hint: dt('!restrictcommand: only the roles you chose.') },
  { id: 'level', label: dt('Petto level'), hint: dt('A level set on the Permissions page.') },
  { id: 'discord', label: dt('Discord permission only'), hint: dt('Anyone with the Discord permission of the action can use it.') },
  { id: 'open', label: dt('No gate'), hint: dt('Nothing extra: any member can use it.') },
  { id: 'disabled', label: dt('Disabled'), hint: dt('Turned off in the server.') },
];
const covered = coverage.length ? Math.round(((gateCount('roles') + gateCount('level') + gateCount('disabled')) / coverage.length) * 100) : 100;
const coverageCats = [...new Map(coverage.map((c) => [c.category, c.categoryTitle])).entries()];
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'score';
const selectedTitle = sectionMeta[selectedSection];

const SEVERITY_LABEL: Record<string, string> = { critical: dt('Critical'), high: dt('Admin role'), medium: dt('Elevated') };
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'unrestricted' ? 'security-unrestricted' : 'security'} pageTitle={selectedTitle}>
  <h1>{selectedTitle}</h1>

  <div class:list={['sc-section', { 'sc-section-hidden': selectedSection !== 'score' }]}>
    <div class="sc-score-card">
      <div>
        <span class="sc-eyebrow">{dt('Petto Security Score')}</span>
        <strong>{securityScore}<small>/100</small></strong>
        <p>{securityScore >= 80 ? dt('Good baseline. Keep reviewing it as the server grows.') : securityScore >= 55 ? dt('A few protections deserve attention.') : dt('Several high-impact protections are missing.')}</p>
      </div>
      <div class="sc-score-ring" style={`--score: ${securityScore * 3.6}deg`}><span>{securityScore}</span></div>
    </div>
    <h2><Icon name="ph:shield-check-fill" width="15" height="15" />{dt('Protection status')}</h2>
    <div class="sc-protection-grid dgl-stagger">
      {Object.entries({ 'Anti-nuke': protection.antinuke, 'Anti-spam': protection.antiSpam, 'Anti-raid': protection.antiRaid, Verification: protection.verification, 'Audit logs': protection.logs }).map(([label, enabled]) => (
        <div class:list={['sc-protection', { enabled }]}><Icon name={enabled ? 'ph:check-circle-fill' : 'ph:warning-fill'} width="15" height="15" /><span>{label}</span><b>{enabled ? dt('Enabled') : dt('Needs setup')}</b></div>
      ))}
    </div>
    <h2 class="sc-recommendation-title"><Icon name="ph:lightbulb-fill" width="15" height="15" />{dt('Recommended next steps')}</h2>
    {recommendations.length ? <ul class="sc-recommendations">{recommendations.slice(0, 6).map((recommendation) => <li>{recommendation}</li>)}</ul> : <p class="sc-empty-note"><Icon name="ph:check-circle-fill" width="14" height="14" />{dt('No high-impact gaps were found.')}</p>}
  </div>

  <div class:list={['sc-section', { 'sc-section-hidden': selectedSection !== 'elevated' }]}>
    <h2><Icon name="ph:shield-warning-fill" width="15" height="15" /><Fragment set:html={dth('Roles with elevated permissions <span class="sc-count">{a}</span>', { a: (roleFindings.length) })} /></h2>
    <p class="sc-section-note">{dt('Roles that can moderate, manage the server, or reach @everyone. Not necessarily wrong, review who\'s actually in each one.')}</p>
    {roleFindings.length === 0 ? (
      <p class="sc-empty-note"><Icon name="ph:check-circle-fill" width="14" height="14" />{dt('No roles outside the obvious admin ones carry elevated permissions.')}</p>
    ) : (
      <div class="sc-list">
        {roleFindings.map((r) => (
          <div class={`sc-row sc-row-${r.severity}`}>
            <span class={`sc-sev sc-sev-${r.severity}`}>{SEVERITY_LABEL[r.severity]}</span>
            <span class="sc-role-name">{r.isEveryone ? '@everyone' : r.name}</span>
            <span class="sc-perms">
              {r.isAdmin ? <span class="sc-perm-chip sc-perm-admin">{dt('Administrator')}</span> : r.matched.map((m) => <span class="sc-perm-chip">{m}</span>)}
            </span>
          </div>
        ))}
      </div>
    )}
  </div>

  <div class:list={['sc-section', { 'sc-section-hidden': selectedSection !== 'unrestricted' }]} data-coverage>
    <div class="cv-head">
      <div class="cv-score">
        <span class="sc-eyebrow">{dt('Extra protection')}</span>
        <strong>{covered}<small>%</small></strong>
        <p>{dt('{a} of {b} staff commands have a Petto level, a role restriction or are disabled. The rest rely on the Discord permission of the action.', { a: gateCount('roles') + gateCount('level') + gateCount('disabled'), b: coverage.length })}</p>
      </div>
      <div class="cv-bar" role="img" aria-label={dt('How the staff commands are protected')}>
        {gates.map((g) => gateCount(g.id) > 0 && <i class={`cv-${g.id}`} style={`flex:${gateCount(g.id)}`} title={`${g.label}: ${gateCount(g.id)}`} />)}
      </div>
      <div class="cv-legend">
        {gates.map((g) => (
          <button type="button" class={`cv-key cv-${g.id}`} data-gate={g.id} aria-pressed="false" title={g.hint}><i />{g.label}<b>{gateCount(g.id)}</b></button>
        ))}
      </div>
    </div>
    <div class="cv-tools">
      <label class="cv-search"><Icon name="ph:magnifying-glass-bold" width="14" height="14" /><input type="search" placeholder={dt('Search a command')} data-cv-search /></label>
      <a class="btn btn-ghost btn-sm" href={`/dash/guild/${guildId}/permissions`}><Icon name="ph:key-fill" width="13" height="13" />{dt('Set levels and roles')}</a>
    </div>
    {coverageCats.map(([cat, title]) => (
      <details class="cv-cat" data-cv-cat open>
        <summary><h3>{title}</h3><span class="cv-cat-n">{coverage.filter((c) => c.category === cat).length}</span></summary>
        <ul class="cv-list">
          {coverage.filter((c) => c.category === cat).map((c) => {
            const gate = gateOf(c);
            return (
              <li class={`cv-row cv-${gate}`} data-gate={gate} data-name={`${c.name} ${c.aliases.join(' ')}`}>
                <div class="cv-main"><code>{c.slash ? '/' : '!'}{c.name}</code><span>{c.desc}</span></div>
                <div class="cv-tags">
                  {c.disabledServer && <span class="cv-tag cv-t-off">{dt('Disabled')}</span>}
                  {c.restrictRoles.map((id) => <span class="cv-tag cv-t-role">@{roleNames[id] ?? id}</span>)}
                  {c.level > 0 && <span class="cv-tag cv-t-level">{dt('Level {a}', { a: c.level })}</span>}
                  {c.permissionNames.map((p) => <span class="cv-tag cv-t-perm">{dt(p)}</span>)}
                  {gate === 'open' && <span class="cv-tag cv-t-open">{dt('No gate')}</span>}
                  {!c.disabledServer && c.disabledChannels.length > 0 && <span class="cv-tag cv-t-off">{dt('Off in {a} channels', { a: c.disabledChannels.length })}</span>}
                </div>
              </li>
            );
          })}
        </ul>
      </details>
    ))}
    <p class="sc-empty-note cv-none" hidden><Icon name="ph:check-circle-fill" width="14" height="14" />{dt('No command matches.')}</p>
  </div>
  <script is:inline>
    // Command coverage: search and the legend as filters. Works again when the dashboard swaps the page in.
    (function bind() {
      var root = document.querySelector('[data-coverage]:not([data-bound])');
      if (!root) return;
      root.setAttribute('data-bound', '1');
      var input = root.querySelector('[data-cv-search]');
      var keys = Array.prototype.slice.call(root.querySelectorAll('.cv-key'));
      var active = '';
      var apply = function () {
        var q = (input && input.value || '').trim().toLowerCase().replace(/^[!\/]/, '');
        var any = false;
        root.querySelectorAll('[data-cv-cat]').forEach(function (cat) {
          var shown = 0;
          cat.querySelectorAll('.cv-row').forEach(function (row) {
            var ok = (!active || row.getAttribute('data-gate') === active) && (!q || row.getAttribute('data-name').indexOf(q) !== -1 || row.textContent.toLowerCase().indexOf(q) !== -1);
            row.hidden = !ok; if (ok) shown++;
          });
          cat.hidden = shown === 0; if (shown) any = true;
        });
        var none = root.querySelector('.cv-none'); if (none) none.hidden = any;
      };
      if (input) input.addEventListener('input', apply);
      keys.forEach(function (key) {
        key.addEventListener('click', function () {
          var gate = key.getAttribute('data-gate');
          active = active === gate ? '' : gate;
          keys.forEach(function (k) { k.setAttribute('aria-pressed', String(k.getAttribute('data-gate') === active)); });
          apply();
        });
      });
    })();
  </script>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 20px; }
  h2 { font-size: 14.5px; margin: 0 0 6px; display: flex; align-items: center; gap: 9px; }

  .sc-section { margin-bottom: 32px; }
  .sc-section-hidden { display: none; }
  .sc-section-note { font-size: 12.5px; color: var(--text-dim); margin: 0 0 14px; max-width: 70ch; }
  .sc-section-note a { color: var(--accent); text-decoration: none; }
  .sc-section-note a:hover { text-decoration: underline; }
  :global(.sc-count){ font-family: var(--mono); font-size: 11px; color: var(--text-dim); font-weight: 400; }

  .sc-empty-note { display: flex; align-items: center; gap: 7px; font-size: 13px; color: var(--green); margin: 0; }
  /* The search and the legend of the command coverage hide rows, categories and the "no match" line with the hidden attribute. */
  .cv-row[hidden], .cv-cat[hidden], .sc-empty-note[hidden] { display: none; }

  .sc-score-card { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 20px; margin-bottom: 24px; border: 1px solid var(--border); border-radius: 14px; background: var(--bg-raise); }
  .sc-eyebrow { display: block; color: var(--text-dim); font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 8px; }
  .sc-score-card strong { display: block; color: var(--text); font-size: 44px; line-height: 1; }
  .sc-score-card strong small { color: var(--text-dim); font-size: 16px; font-weight: 500; }
  .sc-score-card p { color: var(--text-muted); font-size: 12.5px; margin: 8px 0 0; }
  .sc-score-ring { width: 74px; height: 74px; border-radius: 50%; display: grid; place-items: center; background: conic-gradient(var(--accent) var(--score), var(--border) 0); position: relative; flex-shrink: 0; }
  .sc-score-ring::after { content: ''; position: absolute; inset: 7px; border-radius: 50%; background: var(--bg-raise); }
  .sc-score-ring :global(span){ position: relative; z-index: 1; color: var(--text); font-size: 17px; font-weight: 700; }
  .sc-protection-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-bottom: 24px; }
  .sc-protection { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 8px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 9px; color: var(--text-muted); background: var(--card); font-size: 12.5px; }
  .sc-protection :global(svg) { color: var(--yellow); }
  .sc-protection.enabled :global(svg) { color: var(--green); }
  .sc-protection :global(b){ color: var(--text-dim); font-size: 10px; font-weight: 600; }
  .sc-protection.enabled :global(b){ color: var(--green); }
  .sc-recommendation-title { margin-top: 24px; }
  .sc-recommendations { margin: 0; padding-left: 18px; color: var(--text-muted); font-size: 13px; line-height: 1.7; }

  .sc-list { display: flex; flex-direction: column; gap: 8px; }
  .sc-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; border: 1px solid var(--border); border-radius: 10px; padding: 10px 14px; background: var(--card); }
  .sc-row-critical { border-color: var(--red); background: var(--red-soft); }
  .sc-role-name { font-size: 13.5px; font-weight: 600; color: var(--text); }
  .sc-perms { display: flex; flex-wrap: wrap; gap: 6px; margin-left: auto; }
  .sc-perm-chip { font-size: 11px; color: var(--text-muted); background: var(--bg-raise); border: 1px solid var(--border); border-radius: 6px; padding: 2px 8px; }
  .sc-perm-admin { color: var(--red); border-color: var(--red); }

  .sc-sev { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; border-radius: 6px; padding: 3px 8px; flex-shrink: 0; }
  .sc-sev-critical { color: var(--red); background: color-mix(in srgb, var(--red) 18%, transparent); }
  .sc-sev-high { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 18%, transparent); }
  .sc-sev-medium { color: var(--text-dim); background: var(--bg-raise); }

  .sc-cmd-grid { display: flex; flex-wrap: wrap; gap: 8px; }
  .sc-cmd-chip { display: flex; flex-direction: column; gap: 2px; border: 1px solid var(--border); border-radius: 9px; padding: 8px 12px; background: var(--card); text-decoration: none; }
  .sc-cmd-chip:hover { border-color: var(--accent); background: var(--accent-soft); }
  .sc-cmd-name { font-family: var(--mono); font-size: 12.5px; color: var(--text); }
  .sc-cmd-cat { font-size: 10px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.03em; }


  .cv-head { border: 1px solid var(--border); border-radius: 16px; background: var(--bg-raise); padding: 18px; margin-bottom: 14px; display: flex; flex-direction: column; gap: 14px; animation: cv-rise .4s cubic-bezier(.2, .8, .2, 1) both; }
  .cv-score strong { display: block; font-size: 40px; line-height: 1; }
  .cv-score strong small { font-size: 16px; color: var(--text-dim); }
  .cv-score p { margin: 8px 0 0; font-size: 12.5px; color: var(--text-muted); max-width: 70ch; }
  .cv-bar { display: flex; height: 10px; border-radius: 99px; overflow: hidden; background: var(--border); gap: 2px; }
  .cv-bar i { display: block; height: 100%; animation: cv-grow .7s cubic-bezier(.2, .8, .2, 1) both; transform-origin: left; }
  .cv-legend { display: flex; flex-wrap: wrap; gap: 6px; }
  .cv-key { display: inline-flex; align-items: center; gap: 7px; border: 1px solid var(--border); background: var(--card); color: var(--text-muted); border-radius: 999px; padding: 5px 11px; font: inherit; font-size: 12.5px; cursor: pointer; transition: border-color .15s ease, background .15s ease; }
  .cv-key i { width: 9px; height: 9px; border-radius: 50%; }
  .cv-key b { color: var(--text); font-variant-numeric: tabular-nums; }
  .cv-key[aria-pressed=true] { border-color: var(--accent); background: var(--accent-soft); color: var(--text); }
  .cv-roles { --g: var(--green); } .cv-level { --g: var(--accent); } .cv-discord { --g: #fb923c; } .cv-open { --g: var(--red); } .cv-disabled { --g: var(--text-dim); }
  .cv-bar i, .cv-key i { background: var(--g); }
  .cv-tools { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 8px; }
  .cv-search { flex: 1 1 240px; display: flex; align-items: center; gap: 8px; border: 1px solid var(--border); border-radius: 9px; padding: 0 10px; color: var(--text-dim); background: var(--card); }
  .cv-search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .cv-search input { flex: 1; border: 0; outline: none; background: transparent; color: var(--text); font: inherit; font-size: 13.5px; padding: 8px 0; min-width: 0; }
  .cv-cat > summary { display: flex; align-items: center; gap: 8px; cursor: pointer; list-style: none; margin: 16px 0 8px; }
  .cv-cat > summary::-webkit-details-marker { display: none; }
  .cv-cat h3 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--text-dim); margin: 0; }
  .cv-cat-n { font-size: 11px; color: var(--text-dim); border: 1px solid var(--border); border-radius: 999px; padding: 0 7px; }
  .cv-cat > summary::after { content: ''; width: 7px; height: 7px; border-right: 1.5px solid var(--text-dim); border-bottom: 1.5px solid var(--text-dim); transform: rotate(45deg); margin-left: auto; transition: transform .2s ease; }
  .cv-cat:not([open]) > summary::after { transform: rotate(-45deg); }
  .cv-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .cv-row { border: 1px solid var(--border); border-left: 3px solid var(--g); border-radius: 11px; background: var(--card); padding: 10px 12px; display: flex; flex-direction: column; gap: 7px; min-width: 0; transition: background .15s ease, transform .15s ease; }
  .cv-row:hover { background: var(--card-hover); }
  .cv-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .cv-main code { font-family: var(--mono); font-size: 13px; color: var(--accent); }
  .cv-main span { font-size: 12px; color: var(--text-muted); line-height: 1.4; }
  .cv-tags { display: flex; flex-wrap: wrap; gap: 4px; }
  .cv-tag { font-size: 11px; border-radius: 6px; padding: 1px 7px; border: 1px solid var(--border); color: var(--text-muted); }
  .cv-t-role { color: var(--green); } .cv-t-level { color: var(--accent); } .cv-t-perm { color: #fb923c; } .cv-t-open, .cv-t-off { color: var(--red); }
  @keyframes cv-rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes cv-grow { from { transform: scaleX(0); } to { transform: none; } }
  @media (prefers-reduced-motion: reduce) { .cv-head, .cv-bar i { animation: none; } }
  @media (max-width: 700px) { .cv-list { grid-template-columns: 1fr; } }
  @media (max-width: 560px) {
    .sc-protection-grid { grid-template-columns: 1fr; }
    .sc-score-card { padding: 16px; }
  }
</style>
