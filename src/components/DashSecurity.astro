---
// Security: how well the server is protected (overview), which roles carry strong permissions (elevated roles) and which staff commands have an extra gate
// besides the Discord permission (command coverage). Only the part picked in the address (?section=) is drawn; the three have links to each other.
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface RoleFinding { id: string; name: string; isEveryone: boolean; isAdmin: boolean; matched: string[]; severity: 'critical' | 'high' | 'medium'; }
import type { AccessCommand } from '../utils/commandAccess';
interface Protection { antinuke: boolean; antiSpam: boolean; antiRaid: boolean; verification: boolean; logs: boolean; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  roleFindings: RoleFinding[];
  coverage: AccessCommand[];
  roleNames: Record<string, string>;
  securityScore: number;
  protection: Protection;
  recommendations: string[];
  section?: string;
}
const { user, guildId, guildName, guildIcon, roleFindings, coverage, roleNames, securityScore, protection, recommendations, section } = Astro.props;

const sectionMeta: Record<string, string> = { score: dt('Security overview'), elevated: dt('Elevated roles'), unrestricted: dt('Command coverage') };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'score';
const selectedTitle = sectionMeta[selectedSection];
const base = `/dash/guild/${guildId}`;

const gateOf = (c: AccessCommand) => (c.disabledServer ? 'disabled' : c.restrictRoles.length ? 'roles' : c.level > 0 ? 'level' : c.permissionNames.length ? 'discord' : 'open');
const gateCount = (g: string) => coverage.filter((c) => gateOf(c) === g).length;
const gates = [
  { id: 'roles', label: dt('Restricted to roles'), hint: dt('!restrictcommand: only the roles you chose.') },
  { id: 'level', label: dt('Petto level'), hint: dt('A level set on the Permissions page.') },
  { id: 'discord', label: dt('Discord permission only'), hint: dt('Anyone with the Discord permission of the action can use it.') },
  { id: 'open', label: dt('No gate'), hint: dt('Nothing extra: any member can use it.') },
  { id: 'disabled', label: dt('Disabled'), hint: dt('Turned off in the server.') },
];
const gated = gateCount('roles') + gateCount('level') + gateCount('disabled');
const covered = coverage.length ? Math.round((gated / coverage.length) * 100) : 100;
const coverageCats = [...new Map(coverage.map((c) => [c.category, c.categoryTitle])).entries()];

// Each protection, where it is switched on, and what it does.
const protections = [
  { on: protection.antinuke, label: dt('Anti-nuke'), hint: dt('Answers destructive attacks, like mass bans and deleted channels.'), href: `${base}/antinuke`, icon: 'ph:siren-fill' },
  { on: protection.antiSpam, label: dt('Anti-spam'), hint: dt('Blocks flooding and mass mentions.'), href: `${base}/moderation?section=protection`, icon: 'ph:funnel-fill' },
  { on: protection.antiRaid, label: dt('Anti-raid'), hint: dt('Detects waves of joins.'), href: `${base}/moderation?section=protection`, icon: 'ph:users-three-fill' },
  { on: protection.verification, label: dt('Verification'), hint: dt('Checks newcomers before they get in.'), href: `${base}/onboarding`, icon: 'ph:seal-check-fill' },
  { on: protection.logs, label: dt('Audit logs'), hint: dt('Writes what happens in the server to a channel.'), href: `${base}/logging`, icon: 'ph:notebook-fill' },
];
const protectionsOn = protections.filter((p) => p.on).length;
const scoreTone = securityScore >= 80 ? 'joins' : securityScore >= 55 ? 'reactions' : 'leaves';
const scoreColor = securityScore >= 80 ? 'var(--green)' : securityScore >= 55 ? 'var(--yellow)' : 'var(--red)';

// The permissions the check looks at, and which of the roles with elevated permissions hold each one.
const roleLabel = (r: RoleFinding) => (r.isEveryone ? '@everyone' : r.name);
const checked = [
  { key: 'Administrator', holders: roleFindings.filter((r) => r.isAdmin) },
  ...['Manage Server', 'Manage Roles', 'Manage Channels', 'Ban Members', 'Kick Members', 'Timeout Members', 'Manage Webhooks', 'Manage Messages', 'Mention @everyone', 'Manage Nicknames']
    .map((key) => ({ key, holders: roleFindings.filter((r) => r.matched.includes(key)) })),
];
const adminRoles = roleFindings.filter((r) => r.isAdmin && !r.isEveryone).length;
const elevatedOnly = roleFindings.filter((r) => r.severity === 'medium').length;
const everyoneRisk = roleFindings.filter((r) => r.isEveryone).length;
const serverRoles = Object.values(roleNames).filter((name) => name !== '@everyone').length;

const SEVERITY_LABEL: Record<string, string> = { critical: dt('Critical'), high: dt('Admin role'), medium: dt('Elevated') };

const tabs = [
  { id: 'score', icon: 'ph:shield-check-fill', count: null as number | null },
  { id: 'elevated', icon: 'ph:shield-warning-fill', count: roleFindings.length },
  { id: 'unrestricted', icon: 'ph:keyhole-fill', count: null as number | null },
];
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'unrestricted' ? 'security-unrestricted' : 'security'} pageTitle={selectedTitle}>
  <DashSettingsKit />
  <DashFormKit />
  <div class="sc-page">
  <h1>{selectedTitle}</h1>
  <nav class="sc-tabs" aria-label={dt('Security')}>
    {tabs.map((tab) => (
      <a href={`?section=${tab.id}`} class:list={['sc-tab', { on: selectedSection === tab.id }]} aria-current={selectedSection === tab.id ? 'page' : undefined}>
        <Icon name={tab.icon} width="14" height="14" />{sectionMeta[tab.id]}{tab.count ? <em>{tab.count}</em> : null}
      </a>
    ))}
  </nav>

  {selectedSection === 'score' && (
    <div class="sc-body">
      <DashStatTiles tiles={[
        { label: dt('Security score'), value: securityScore, tone: scoreTone },
        { label: dt('Protections on'), value: protectionsOn, text: `${protectionsOn} / ${protections.length}`, tone: 'voice' },
        { label: dt('Elevated roles'), value: roleFindings.length, tone: 'leaves' },
        { label: dt('Extra protection'), value: gated, tone: 'invites' },
      ]} />

      <div class="sc-duo">
        <div class="sc-col">
          <section class="sx-panel sc-score" style={`--sc:${scoreColor}`}>
            <div class="sc-score-ring" style={`--score: ${securityScore * 3.6}deg`}><span>{securityScore}</span></div>
            <div class="sc-score-text">
              <h2>{dt('Petto Security Score')}</h2>
              <p>{securityScore >= 80 ? dt('Good baseline. Keep reviewing it as the server grows.') : securityScore >= 55 ? dt('A few protections deserve attention.') : dt('Several high-impact protections are missing.')}</p>
              <span class="sc-score-scale">{dt('Out of 100: every missing protection and every risky role takes points off.')}</span>
            </div>
          </section>

          <section class="sx-panel sc-recs">
            <div class="sx-panel-head">
              <span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:lightbulb-fill" width="17" height="17" /></span>
              <h2>{dt('Recommended next steps')}</h2>
              {recommendations.length > 0 && <span class="sx-tag">{Math.min(recommendations.length, 6)}</span>}
            </div>
            {recommendations.length ? (
              <ul class="sc-steps dgl-stagger">
                {recommendations.slice(0, 6).map((recommendation, i) => <li><b>{i + 1}</b><span>{recommendation}</span></li>)}
              </ul>
            ) : (
              <p class="sx-empty sc-ok"><Icon name="ph:check-circle-fill" width="18" height="18" />{dt('No high-impact gaps were found.')}</p>
            )}
          </section>
        </div>

        <section class="sx-panel sc-prot">
          <div class="sx-panel-head">
            <span class="sx-panel-icon" style="--c:var(--green)"><Icon name="ph:shield-check-fill" width="17" height="17" /></span>
            <h2>{dt('Protection status')}</h2>
            <span class="sx-tag sx-tag-accent">{protectionsOn} / {protections.length}</span>
          </div>
          <p class="sx-lead">{dt('Open one to turn it on or change it.')}</p>
          <div class="sc-prot-list dgl-stagger">
            {protections.map((p) => (
              <a class:list={['sc-prot-row', { on: p.on }]} href={p.href}>
                <span class="sc-prot-icon"><Icon name={p.icon} width="17" height="17" /></span>
                <span class="sc-prot-main"><b>{p.label}</b><em>{p.hint}</em></span>
                <span class="sc-prot-state"><Icon name={p.on ? 'ph:check-circle-fill' : 'ph:warning-fill'} width="13" height="13" />{p.on ? dt('Enabled') : dt('Needs setup')}</span>
                <Icon name="ph:arrow-right-bold" class="sc-go" width="13" height="13" />
              </a>
            ))}
          </div>
        </section>
      </div>

      <div class="sc-duo sc-duo-start">
        <section class="sx-panel">
          <div class="sx-panel-head">
            <span class="sx-panel-icon" style="--c:var(--red)"><Icon name="ph:shield-warning-fill" width="17" height="17" /></span>
            <h2>{dt('Elevated roles')}</h2>
            <span class="sx-tag">{roleFindings.length}</span>
          </div>
          <p class="sx-lead">{dt('Roles that can moderate, manage the server, or reach @everyone.')}</p>
          {roleFindings.length === 0 ? (
            <p class="sx-empty sc-ok"><Icon name="ph:check-circle-fill" width="18" height="18" />{dt('No roles outside the obvious admin ones carry elevated permissions.')}</p>
          ) : (
            <ul class="sc-mini">
              {roleFindings.slice(0, 4).map((r) => (
                <li><span class={`sc-sev sc-sev-${r.severity}`}>{SEVERITY_LABEL[r.severity]}</span><b>{roleLabel(r)}</b></li>
              ))}
              {roleFindings.length > 4 && <li class="sc-more">{dt('and {n} more', { n: roleFindings.length - 4 })}</li>}
            </ul>
          )}
          <a class="sc-link" href="?section=elevated">{dt('Review the roles')}<Icon name="ph:arrow-right-bold" width="12" height="12" /></a>
        </section>

        <section class="sx-panel">
          <div class="sx-panel-head">
            <span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:keyhole-fill" width="17" height="17" /></span>
            <h2>{dt('Command coverage')}</h2>
            <span class="sx-tag sx-tag-accent">{covered}%</span>
          </div>
          <p class="sx-lead">{dt('{a} of {b} staff commands have a Petto level, a role restriction or are disabled.', { a: gated, b: coverage.length })}</p>
          <div class="cv-bar" role="img" aria-label={dt('How the staff commands are protected')}>
            {gates.map((g) => gateCount(g.id) > 0 && <i class={`cv-${g.id}`} style={`flex:${gateCount(g.id)}`} title={`${g.label}: ${gateCount(g.id)}`} />)}
          </div>
          <ul class="sc-legend">
            {gates.map((g) => <li class={`cv-${g.id}`}><i></i><span>{g.label}</span><b>{gateCount(g.id)}</b></li>)}
          </ul>
          <a class="sc-link" href="?section=unrestricted">{dt('Review the commands')}<Icon name="ph:arrow-right-bold" width="12" height="12" /></a>
        </section>
      </div>
    </div>
  )}

  {selectedSection === 'elevated' && (
    <div class="sc-body">
      <DashStatTiles tiles={[
        { label: dt('Elevated roles'), value: roleFindings.length, tone: 'leaves' },
        { label: dt('Administrator roles'), value: adminRoles, tone: 'reactions' },
        { label: dt('Elevated only'), value: elevatedOnly, tone: 'messages' },
        { label: dt('Roles in the server'), value: serverRoles, tone: 'voice' },
      ]} />

      {everyoneRisk > 0 && (
        <div class="sx-flash sx-flash-bad"><Icon name="ph:warning-fill" width="15" height="15" />{dt('@everyone has elevated permissions.')}</div>
      )}

      <section class="sx-panel">
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style="--c:var(--red)"><Icon name="ph:shield-warning-fill" width="17" height="17" /></span>
          <h2>{dt('Roles with elevated permissions')}</h2>
          <span class="sx-tag">{roleFindings.length}</span>
        </div>
        <p class="sx-lead">{dt('Roles that can moderate, manage the server, or reach @everyone. Not necessarily wrong, review who\'s actually in each one.')}</p>
        {roleFindings.length === 0 ? (
          <p class="sx-empty sc-ok"><Icon name="ph:check-circle-fill" width="18" height="18" />{dt('No roles outside the obvious admin ones carry elevated permissions.')}</p>
        ) : (
          <ul class="sc-roles dgl-stagger">
            {roleFindings.map((r) => (
              <li class={`sc-role sc-role-${r.severity}`}>
                <span class={`sc-sev sc-sev-${r.severity}`}>{SEVERITY_LABEL[r.severity]}</span>
                <b class="sc-role-name">{roleLabel(r)}</b>
                <span class="sc-perms">
                  {r.isAdmin ? <span class="sc-perm sc-perm-admin">{dt('Administrator')}</span> : r.matched.map((m) => <span class="sc-perm">{dt(m)}</span>)}
                </span>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="sx-panel">
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style="--c:var(--blue)"><Icon name="ph:list-checks-fill" width="17" height="17" /></span>
          <h2>{dt('Permissions that are checked')}</h2>
        </div>
        <p class="sx-lead">{dt('How many of the roles above hold each one. Administrator already includes all the others.')}</p>
        <div class="sc-checks">
          {checked.map((item) => (
            <div class:list={['sc-check', { none: item.holders.length === 0 }]}>
              <div class="sc-check-top"><b>{dt(item.key)}</b><span class="sx-tag">{item.holders.length}</span></div>
              <div class="sc-check-bar"><i style={`width:${roleFindings.length ? Math.round((item.holders.length / roleFindings.length) * 100) : 0}%`}></i></div>
              <p>{item.holders.length === 0 ? dt('No role has it.') : <>{item.holders.slice(0, 3).map(roleLabel).join(', ')}{item.holders.length > 3 ? ` +${item.holders.length - 3}` : ''}</>}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  )}

  {selectedSection === 'unrestricted' && (
    <div class="sc-body" data-coverage>
      <DashStatTiles tiles={[
        { label: dt('Staff commands'), value: coverage.length, tone: 'voice' },
        { label: dt('Extra protection'), value: gated, tone: 'joins' },
        { label: dt('Discord only'), value: gateCount('discord'), tone: 'reactions' },
        { label: dt('No gate'), value: gateCount('open'), tone: 'leaves' },
      ]} />

      <section class="sx-panel cv-sum">
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:keyhole-fill" width="17" height="17" /></span>
          <h2>{dt('Extra protection')}</h2>
          <span class="sx-tag sx-tag-accent">{covered}%</span>
        </div>
        <p class="sx-lead">{dt('{a} of {b} staff commands have a Petto level, a role restriction or are disabled. The rest rely on the Discord permission of the action.', { a: gated, b: coverage.length })}</p>
        <div class="cv-bar" role="img" aria-label={dt('How the staff commands are protected')}>
          {gates.map((g) => gateCount(g.id) > 0 && <i class={`cv-${g.id}`} style={`flex:${gateCount(g.id)}`} title={`${g.label}: ${gateCount(g.id)}`} />)}
        </div>
        <div class="dfx-chips cv-chips" role="radiogroup" aria-label={dt('Filter')}>
          <label class="dfx-chip cv-chip"><input type="radio" name="cv-gate" value="" checked />{dt('All')}<b>{coverage.length}</b></label>
          {gates.map((g) => (
            <label class={`dfx-chip cv-chip cv-${g.id}`} title={g.hint}><input type="radio" name="cv-gate" value={g.id} disabled={gateCount(g.id) === 0} /><i class="cv-dot"></i>{g.label}<b>{gateCount(g.id)}</b></label>
          ))}
        </div>
      </section>

      <div class="cv-tools">
        <label class="cv-search"><Icon name="ph:magnifying-glass-bold" width="14" height="14" /><input type="search" placeholder={dt('Search a command')} aria-label={dt('Search a command')} data-cv-search /></label>
        <span class="cv-bulk"><button type="button" class="btn btn-ghost btn-sm" data-cv-bulk="open">{dt('Expand all')}</button><button type="button" class="btn btn-ghost btn-sm" data-cv-bulk="close">{dt('Collapse all')}</button></span>
        <a class="btn btn-ghost btn-sm" href={`${base}/permissions`}><Icon name="ph:key-fill" width="13" height="13" />{dt('Set levels and roles')}</a>
      </div>

      <div class="cv-cats">
        {coverageCats.map(([cat, title]) => {
          const list = coverage.filter((c) => c.category === cat);
          return (
            <details class="dfx-acc cv-cat" data-cv-cat data-total={list.length}>
              <summary>
                <span class="dfx-acc-title"><b>{title}</b></span>
                <span class="cv-cat-bar" aria-hidden="true">{gates.map((g) => { const n = list.filter((c) => gateOf(c) === g.id).length; return n > 0 && <i class={`cv-${g.id}`} style={`flex:${n}`} />; })}</span>
                <span class="sx-tag cv-cat-n" data-cv-n>{list.length}</span>
                <svg class="dfx-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </summary>
              <ul class="cv-list">
                {list.map((c) => {
                  const gate = gateOf(c);
                  return (
                    <li class={`cv-row cv-${gate}`} data-gate={gate} data-name={`${c.name} ${c.aliases.join(' ')}`}>
                      <div class="cv-main"><code>{c.slash ? '/' : '!'}{c.name}</code><span>{c.desc}</span></div>
                      <div class="cv-tags">
                        {c.disabledServer && <span class="cv-tag cv-t-off">{dt('Disabled')}</span>}
                        {c.restrictRoles.map((id) => <span class="cv-tag cv-t-role">@{roleNames[id] ?? id}</span>)}
                        {c.level > 0 && <span class="cv-tag cv-t-level">{dt('Level {a}', { a: c.level })}</span>}
                        {c.permissionNames.map((p) => <span class="cv-tag cv-t-perm">{dt(p)}</span>)}
                        {gate === 'open' && <span class="cv-tag cv-t-open">{dt('No gate')}</span>}
                        {!c.disabledServer && c.disabledChannels.length > 0 && <span class="cv-tag cv-t-off">{dt('Off in {a} channels', { a: c.disabledChannels.length })}</span>}
                      </div>
                    </li>
                  );
                })}
              </ul>
            </details>
          );
        })}
      </div>
      <p class="sx-empty cv-none" hidden><Icon name="ph:magnifying-glass-bold" width="16" height="16" />{dt('No command matches.')}</p>
    </div>
  )}
  </div>

  <script is:inline>
    // Command coverage: the search, the gate chips and the open/close of the groups. Works again when the dashboard swaps the page in.
    (function bind() {
      var root = document.querySelector('[data-coverage]:not([data-bound])');
      if (!root) return;
      root.setAttribute('data-bound', '1');
      var input = root.querySelector('[data-cv-search]');
      var cats = Array.prototype.slice.call(root.querySelectorAll('[data-cv-cat]'));
      var before = new Map();
      var filtering = false;
      var gate = function () { var on = root.querySelector('input[name="cv-gate"]:checked'); return on ? on.value : ''; };
      var apply = function () {
        var q = (input && input.value || '').trim().toLowerCase().replace(/^[!\/]/, '');
        var active = gate();
        var now = Boolean(q || active);
        // While something is searched or filtered the groups with a match are open; when it is cleared they go back as they were.
        if (now && !filtering) cats.forEach(function (cat) { before.set(cat, cat.open); });
        var any = false;
        cats.forEach(function (cat) {
          var shown = 0;
          cat.querySelectorAll('.cv-row').forEach(function (row) {
            var ok = (!active || row.getAttribute('data-gate') === active) && (!q || row.getAttribute('data-name').indexOf(q) !== -1 || row.textContent.toLowerCase().indexOf(q) !== -1);
            row.hidden = !ok; if (ok) shown++;
          });
          cat.hidden = shown === 0; if (shown) any = true;
          var n = cat.querySelector('[data-cv-n]');
          if (n) n.textContent = now ? shown + ' / ' + cat.getAttribute('data-total') : cat.getAttribute('data-total');
          if (now) cat.open = shown > 0; else if (filtering) cat.open = Boolean(before.get(cat));
        });
        filtering = now;
        var none = root.querySelector('.cv-none'); if (none) none.hidden = any;
      };
      if (input) input.addEventListener('input', apply);
      root.querySelectorAll('input[name="cv-gate"]').forEach(function (radio) { radio.addEventListener('change', apply); });
      root.querySelectorAll('[data-cv-bulk]').forEach(function (button) {
        button.addEventListener('click', function () {
          var open = button.getAttribute('data-cv-bulk') === 'open';
          cats.forEach(function (cat) { if (!cat.hidden) cat.open = open; if (!filtering) before.set(cat, open); });
        });
      });
    })();
  </script>
</DashGuildLayout>

<style>
  .sc-page { max-width: 1000px; }
  h1 { font-size: 24px; margin: 0 0 14px; }
  h2 { font-size: 15.5px; margin: 0; }
  p { margin: 0; }
  .sc-body { display: flex; flex-direction: column; gap: 14px; }
  .sc-body > :global(.stt) { margin-bottom: 0; }
  .sc-body > :global(.sx-flash) { margin-bottom: 0; }

  /* The three parts, as chips that link to each other. */
  .sc-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 14px; }
  .sc-tab { display: inline-flex; align-items: center; gap: 7px; padding: 7px 14px; border: 1px solid var(--border); border-radius: 999px; font-size: 13px; color: var(--text-muted); text-decoration: none; transition: background-color .3s ease, border-color .3s ease, color .3s ease; }
  .sc-tab:hover { background: var(--card-hover); color: var(--text); }
  .sc-tab.on { background: var(--green-soft); border-color: color-mix(in srgb, var(--green) 55%, var(--border)); color: var(--green); font-weight: 600; }
  .sc-tab em { font-style: normal; font-size: 11.5px; font-variant-numeric: tabular-nums; border-radius: 999px; padding: 0 7px; background: color-mix(in srgb, var(--text) 9%, transparent); }
  .sc-tab.on em { background: color-mix(in srgb, var(--green) 18%, transparent); }

  .sc-duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; align-items: start; }
  .sc-duo-start { align-items: start; }
  .sc-duo > :global(.sx-panel), .sc-col > :global(.sx-panel) { animation: m-rise-in var(--m-slow) var(--m-out) backwards; }
  .sc-col { display: flex; flex-direction: column; gap: 14px; min-width: 0; }

  /* Score: the ring and what it says. */
  .sc-score { flex-direction: row; align-items: center; gap: 20px; background: linear-gradient(180deg, color-mix(in srgb, var(--sc) 8%, var(--card)), var(--card) 75%); }
  .sc-score-ring { width: 92px; height: 92px; border-radius: 50%; display: grid; place-items: center; background: conic-gradient(var(--sc) var(--score), color-mix(in srgb, var(--text) 12%, transparent) 0); position: relative; flex: none; }
  .sc-score-ring::after { content: ''; position: absolute; inset: 8px; border-radius: 50%; background: var(--card); }
