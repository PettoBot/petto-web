---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import { MAX_REASON } from '../utils/roleTriggers.mjs';
import { formatDuration } from '../utils/formatDuration';
import { getDashLang, makeT } from '../i18n/dash';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const docsUrl = `https://wiki.petto.sbs${dashLang === 'es' ? '/es' : dashLang === 'pt-BR' ? '/pt-br' : ''}/moderation/role-triggers`;
interface Rule { roleId: string; roleName: string | null; roleColor: number; action: string; durationMs: number; reason: string; on: string }
interface Props {
  user: { username: string; avatar: string | null; userId?: string };
  guildId: string;
  guildName: string;
  guildIcon: string;
  rules: Rule[];
  roles: { id: string; name: string; color: number; hasRule: boolean }[];
  state: 'ok' | 'unavailable' | 'error';
  canEdit: boolean;
  message: { kind: 'ok' | 'err'; text: string } | null;
  max: number;
  activity: { caseNumber: number; type: string; name: string; avatar: string; reason: string; at: string }[];
  limit: { chosen: number | null; fallback: number; available: boolean; min: number; max: number; minutes: number; queueMinutes: number };
}
const { user, guildId, guildName, guildIcon, rules, roles, state, canEdit, message, max, limit, activity } = Astro.props;
const shownLimit = limit.chosen ?? limit.fallback;

const actions = [
  { id: 'warn', label: dt('Warn') }, { id: 'mute', label: dt('Mute') }, { id: 'jail', label: dt('Jail') },
  { id: 'kick', label: dt('Kick') }, { id: 'ban', label: dt('Ban') }, { id: 'remove_role', label: dt('Remove the role') },
];
const moments = [
  { id: 'role_added', label: dt('When it is given') },
  { id: 'onboarding', label: dt('When onboarding is finished') },
  { id: 'either', label: dt('When it is given or onboarding is finished') },
];
const typeLabel = (type: string) => ({ warn: dt('Warn'), mute: dt('Mute'), tempmute: dt('Mute'), jail: dt('Jail'), kick: dt('Kick'), ban: dt('Ban'), tempban: dt('Ban') } as Record<string, string>)[type] ?? type;
const when = (iso: string) => {
  const date = new Date(iso);
  return Number.isFinite(date.getTime()) ? date.toLocaleString(dashLang, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '';
};
const label = (list: { id: string; label: string }[], id: string) => list.find((item) => item.id === id)?.label ?? id;
const hex = (color: number) => (color > 0 ? `#${color.toString(16).padStart(6, '0')}` : '#99aab5');
const ready = state === 'ok';
const editable = ready && canEdit;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="role-triggers" pageTitle={dt('Role triggers')}>
  <div class="rt">
    <header class="rt-head">
      <h1>{dt('Role triggers')}</h1>
      <a class="btn btn-sm rt-docs" href={docsUrl} target="_blank" rel="noopener"><Icon name="ph:book-open-fill" width="13" height="13" />{dt('Read the docs')}</a>
    </header>

    {message && <div class:list={['rt-flash', { 'rt-flash-err': message.kind === 'err' }]} role="status"><Icon name={message.kind === 'ok' ? 'ph:check-circle-fill' : 'ph:warning-fill'} width="15" height="15" />{message.text}</div>}
    {state === 'unavailable' && <div class="rt-flash rt-flash-warn"><Icon name="ph:plug-fill" width="15" height="15" />{dt('Role triggers are not available yet. Petto is being updated: try again in a few minutes.')}</div>}
    {state === 'error' && <div class="rt-flash rt-flash-warn"><Icon name="ph:plug-fill" width="15" height="15" />{dt('The role triggers could not be read. Try again in a moment.')}</div>}
    {ready && !canEdit && <div class="rt-flash rt-flash-warn" data-rt-readonly><Icon name="ph:eye-fill" width="15" height="15" />{dt('Only administrators can change role triggers, the same as the command. You can look at the rules.')}</div>}

    <div class="rt-grid">
      <div class="rt-left">
      <section class="rt-card rt-list">
        <div class="rt-card-head">
          <h2>{dt('Rules')}</h2>
          <span class:list={['rt-count', { 'rt-count-full': rules.length >= max }]}>{dt('{n} of {max}', { n: rules.length, max })}</span>
        </div>
        {rules.length === 0 ? (
          <p class="rt-empty">{ready ? dt('No role triggers yet. Add the first one with the form.') : dt('There are no rules to show.')}</p>
        ) : (
          <ul class="rt-rules">
            {rules.map((rule) => (
              <li class="rt-rule" data-rt-rule>
                <div class="rt-rule-main">
                  <span class:list={['rt-role', { 'rt-role-gone': rule.roleName === null }]} style={`--c:${hex(rule.roleColor)}`}>
                    <i aria-hidden="true"></i><b>{rule.roleName ?? dt('Deleted role')}</b>
                  </span>
                  <span class:list={['rt-action', `rt-action-${rule.action}`]}>{label(actions, rule.action)}</span>
                  {rule.durationMs > 0 && <span class="rt-duration">{formatDuration(rule.durationMs / 1000)}</span>}
                </div>
                <p class="rt-when">{label(moments, rule.on)}{rule.reason ? <span class="rt-reason"> · {rule.reason}</span> : null}</p>
                {editable && (
                  <form method="POST" class="rt-remove" data-no-dirty>
                    <input type="hidden" name="action" value="remove" />
                    <input type="hidden" name="role_id" value={rule.roleId} />
                    <button class="btn btn-ghost btn-sm" type="submit" data-confirm={dt('Remove the rule of this role?')} aria-label={dt('Remove')}><Icon name="ph:trash-bold" width="13" height="13" /><span>{dt('Remove')}</span></button>
                  </form>
                )}
              </li>
            ))}
          </ul>
        )}
      </section>


      <section class="rt-card rt-stop" data-rt-stop>
        <div class="rt-card-head"><h2>{dt('Safety stop')}</h2></div>
        <form method="POST" class="rt-stop-form" data-no-dirty>
          <p>{dt('Past this many actions a minute, the rest wait in line.')}</p>
          <div class="rt-stop-row">
            <label class="rt-field"><span>{dt('Actions a minute')}</span>
              <input type="number" name="limit" min={limit.min} max={limit.max} step="1" value={shownLimit} inputmode="numeric" required disabled={!editable || !limit.available} />
            </label>
            <button class="btn btn-accent btn-sm" type="submit" name="action" value="set_limit" disabled={!editable || !limit.available}>{dt('Save limit')}</button>
            {limit.chosen !== null && <button class="btn btn-sm" type="submit" name="action" value="reset_limit" formnovalidate disabled={!editable || !limit.available}>{dt('Use the default')}</button>}
          </div>
          <p class="rt-hint">{limit.chosen !== null ? dt('Default for its size: {n}.', { n: limit.fallback }) : dt('Default for this size.')}</p>
        </form>
      </section>
      </div>

      <div class="rt-right">
      <section class="rt-card rt-add" data-rt-add>
        <div class="rt-card-head"><h2>{dt('Add a rule')}</h2></div>
        <form method="POST" class="rt-form" data-no-dirty>
          <input type="hidden" name="action" value="add" />
          <label class="rt-field"><span>{dt('Role')}</span>
            <select name="role_id" required disabled={!editable}>
              <option value="">{dt('Choose a role')}</option>
              {roles.map((role) => <option value={role.id}>{role.hasRule ? dt('{name} (replaces its rule)', { name: role.name }) : role.name}</option>)}
            </select>
          </label>
          <label class="rt-field"><span>{dt('Action')}</span>
            <select name="rule_action" disabled={!editable} data-rt-action>
              {actions.map((a) => <option value={a.id}>{a.label}</option>)}
            </select>
          </label>
          <label class="rt-field rt-duration-field"><span>{dt('Duration')}</span>
            <input type="text" name="duration" maxlength="64" placeholder="1h, 12h, 1d" autocomplete="off" disabled={!editable} />
            <em>{dt('Optional. Empty means no end. A mute can last up to 28 days; a ban with a duration is a temporary ban.')}</em>
          </label>
          <label class="rt-field"><span>{dt('When')}</span>
            <select name="on" disabled={!editable}>
              {moments.map((m) => <option value={m.id}>{m.label}</option>)}
            </select>
          </label>
          <label class="rt-field"><span>{dt('Reason')}</span>
            <input type="text" name="reason" maxlength={MAX_REASON} placeholder={dt('Optional, added to the case')} autocomplete="off" disabled={!editable} />
          </label>
          <button class="btn btn-accent btn-sm" type="submit" disabled={!editable || (rules.length >= max)}><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add rule')}</button>
          <p class="rt-hint">{dt('A role has one rule: adding it again replaces the old one.')}</p>
        </form>
      </section>

      </div>
    </div>

    <section class="rt-card rt-activity">
      <div class="rt-card-head"><h2>{dt('Recent activity')}</h2></div>
      {activity.length === 0 ? (
        <div class="rt-activity-empty"><Icon name="ph:lightning-fill" width="22" height="22" /><p>{dt('Nothing yet. What the rules do shows up here.')}</p></div>
      ) : (
        <ul class="rt-acts">
          {activity.map((item) => (
            <li class="rt-act">
              <span class="rt-act-who">{item.avatar ? <img src={item.avatar} alt="" width="20" height="20" loading="lazy" referrerpolicy="no-referrer" /> : <i aria-hidden="true"></i>}<b>{item.name}</b></span>
              <span class:list={['rt-action', `rt-action-${item.type.replace(/^temp/, '')}`]}>{typeLabel(item.type)}</span>
              <span class="rt-act-why">{item.reason}</span>
              <time class="rt-act-when" datetime={item.at}>{when(item.at)}</time>
            </li>
          ))}
        </ul>
      )}
    </section>

  </div>
</DashGuildLayout>

<style>
  .rt { max-width: 1180px; display: flex; flex-direction: column; min-height: 100%; }
  .rt-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 14px; margin: 0 0 18px; }
  .rt-head h1 { font-size: 24px; margin: 0; }
  .rt-docs { display: inline-flex; align-items: center; gap: 6px; }
  .rt h2 { font-size: 15px; margin: 0 0 8px; }
  .rt-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid color-mix(in srgb, var(--green) 55%, transparent); border-radius: 10px; padding: 10px 14px; margin: 0 0 14px; max-width: 820px; overflow-wrap: anywhere; }
  .rt-flash :global(svg) { flex: none; }
  .rt-flash-err { color: var(--red, #ff6b6b); background: color-mix(in srgb, var(--red, #ff6b6b) 10%, transparent); border-color: color-mix(in srgb, var(--red, #ff6b6b) 55%, transparent); }
  .rt-flash-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: color-mix(in srgb, var(--yellow) 55%, transparent); }
  .rt-card.rt-activity { margin-top: 16px; flex: 1 1 auto; display: flex; flex-direction: column; }
  .rt-acts { list-style: none; margin: 0; padding: 0; }
  .rt-act { display: grid; grid-template-columns: minmax(0, 1.1fr) 120px minmax(0, 2fr) 118px; align-items: center; gap: 4px 12px; padding: 9px 16px; border-top: 1px solid var(--border); font-size: 13.5px; }
  .rt-act:first-child { border-top: 0; }
  .rt-act-who { display: inline-flex; align-items: center; gap: 8px; min-width: 0; }
  .rt-act-who img, .rt-act-who i { width: 20px; height: 20px; border-radius: 50%; flex: none; background: color-mix(in srgb, var(--text) 10%, transparent); }
  .rt-act-who b { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rt-act-why { color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .rt-act-when { color: var(--text-dim); font-size: 12.5px; white-space: nowrap; font-variant-numeric: tabular-nums; text-align: right; }
  .rt-act .rt-action { justify-self: start; }
  .rt-activity-empty { flex: 1 1 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 22px 16px; color: var(--text-dim); text-align: center; }
  .rt-activity-empty p { margin: 0; font-size: 13.5px; }
  .rt-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 16px; align-items: stretch; }
  .rt-card { border: 1px solid var(--border); border-radius: 14px; background: var(--card); min-width: 0; padding: 0; margin: 0; }
  .rt-card-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--border); }
  .rt-card-head h2 { margin: 0; }
  .rt-count { font-size: 12.5px; font-weight: 700; padding: 2px 10px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }
  .rt-count-full { background: color-mix(in srgb, var(--yellow) 18%, transparent); color: var(--yellow); }
  .rt-empty { margin: 0; padding: 18px 16px; font-size: 13.5px; color: var(--text-dim); }
  .rt-rules { list-style: none; margin: 0; padding: 0; }
  .rt-rule { position: relative; display: grid; gap: 4px; padding: 11px 16px; border-top: 1px solid var(--border); }
  .rt-rule:first-child { border-top: 0; }
  .rt-rule-main { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; padding-right: 96px; min-width: 0; }
  .rt-role { display: inline-flex; align-items: center; gap: 6px; max-width: 100%; min-width: 0; padding: 2px 10px 2px 8px; border-radius: 999px; background: color-mix(in srgb, var(--c) 14%, transparent); border: 1px solid color-mix(in srgb, var(--c) 45%, var(--border)); font-size: 13px; }
  .rt-role i { width: 10px; height: 10px; border-radius: 50%; background: var(--c); flex: none; }
  .rt-role b { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rt-role-gone { background: transparent; border-style: dashed; color: var(--text-dim); }
  .rt-role-gone i { background: transparent; border: 1px dashed var(--text-dim); }
  .rt-action { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; border-radius: 999px; padding: 2px 8px; background: var(--accent-soft); color: var(--accent); }
  .rt-action-ban, .rt-action-kick { background: color-mix(in srgb, var(--red, #ff6b6b) 16%, transparent); color: var(--red, #e5484d); }
  .rt-action-mute, .rt-action-jail { background: color-mix(in srgb, #d99a3d 18%, transparent); color: #b7791f; }
  .rt-action-remove_role { background: color-mix(in srgb, var(--text) 8%, transparent); color: var(--text-muted); }
  .rt-duration { font-size: 12.5px; font-weight: 600; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .rt-when { margin: 0; font-size: 12.5px; color: var(--text-dim); overflow-wrap: anywhere; }
  .rt-reason { color: var(--text-muted); }
  .rt-remove { position: absolute; top: 9px; right: 12px; margin: 0; }
  .rt-remove :global(button) { color: var(--red, #e5484d); }
  .rt-right { display: grid; grid-template-rows: 1fr; gap: 16px; min-width: 0; }
  .rt-form { display: flex; flex-direction: column; gap: 12px; padding: 14px 16px 16px; }
  .rt-field { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .rt-field > span { font-size: 13px; font-weight: 600; }
  .rt-field select, .rt-field input { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; min-width: 0; max-width: 100%; }
  .rt-field select:disabled, .rt-field input:disabled { opacity: .6; }
  .rt-form button[type="submit"]:disabled { opacity: .5; cursor: not-allowed; }
  .rt-field em { font-style: normal; font-size: 12px; color: var(--text-dim); }
  /* The duration only shows for the actions that take one (the select is read by CSS, so it is right from the first paint). */
  .rt-duration-field { display: none; }
  .rt-form:has(select[data-rt-action] option[value='mute']:checked) .rt-duration-field,
  .rt-form:has(select[data-rt-action] option[value='jail']:checked) .rt-duration-field,
  .rt-form:has(select[data-rt-action] option[value='ban']:checked) .rt-duration-field { display: flex; }
  .rt-form button { align-self: flex-start; }
  .rt-hint { font-size: 12.5px; color: var(--text-dim); margin: 0; }
  .rt-left { display: grid; grid-template-rows: 1fr auto; gap: 16px; min-width: 0; }
  .rt-stop-form { display: grid; gap: 10px; padding: 12px 16px 16px; }
  .rt-stop-form > p:first-child { margin: 0; font-size: 13.5px; color: var(--text-muted); }
  .rt-stop-row { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px; }
  .rt-stop-row .rt-field { width: 140px; }
  .rt-stop-row button:disabled { opacity: .5; cursor: not-allowed; }
  @media (max-width: 1000px) {
    .rt-grid { grid-template-columns: minmax(0, 1fr); }
    .rt-add { position: static; }
  }
  @media (max-width: 720px) {
    .rt-act { grid-template-columns: minmax(0, 1fr) auto; }
    .rt-act-why { grid-column: 1 / -1; order: 3; white-space: normal; }
    .rt-card-head { padding: 10px 14px; }
    .rt-rule { padding: 10px 14px; }
    .rt-rule-main { padding-right: 0; }
    .rt-remove { position: static; justify-self: start; margin-top: 2px; }
  }
</style>
