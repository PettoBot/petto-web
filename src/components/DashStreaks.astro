---
// Streaks: what an active day is in this server. A member keeps a streak by being active every day; the bot works it out from the messages and the minutes in voice it already counts.
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string; guildName: string; guildIcon: string;
  row: { enabled: boolean; minMessages: number; minVoice: number };
  ready: boolean; saved: boolean; problem: string | null;
}
const { user, guildId, guildName, guildIcon, row, ready, saved, problem } = Astro.props;
const docsUrl = `https://wiki.petto.sbs${dashLang === 'es' ? '/es' : dashLang === 'pt-BR' ? '/pt-br' : ''}/utility/streak`;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="streaks" pageTitle="Streaks">
  <DashSettingsKit />
  <div class="sx-page stk">
    <div class="stk-head">
      <h1>{dt('Streaks')}</h1>
      <a class="btn btn-sm" href={docsUrl} target="_blank" rel="noopener"><Icon name="ph:book-open-fill" width="13" height="13" />{dt('Read the docs')}</a>
    </div>
    <p class="sx-lead">{dt('Members keep a streak by being active every day. Choose what an active day is in this server. A day is counted in UTC, and a plan gives a member freezes that save a missed day.')}</p>

    {saved && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
    {problem && <div class="sx-flash sx-flash-bad" role="alert"><Icon name="ph:warning-fill" width="15" height="15" />{problem}</div>}
    {!ready && <div class="sx-flash sx-flash-warn"><Icon name="ph:plug-fill" width="15" height="15" />{dt('Streaks are not available yet. Petto is being updated: try again in a few minutes.')}</div>}

    <form method="POST" class="sx-panel stk-box">
      <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--green)"><Icon name="ph:fire-fill" width="17" height="17" /></span><h2>{dt('Active day')}</h2></div>
      <label class="sx-switch stk-switch"><input type="checkbox" name="enabled" role="switch" checked={row.enabled} disabled={!ready} /><span class="sx-toggle"></span><span>{dt('Count streaks in this server')}</span></label>
      <div class="stk-two">
        <div class="sx-field"><label for="st-msg">{dt('Messages in the day')}</label>
          <input id="st-msg" type="number" name="min_messages" min="0" max="1000" value={row.minMessages} disabled={!ready} />
          <p class="sx-hint">{dt('A member is active that day with this many messages.')}</p>
        </div>
        <div class="sx-field"><label for="st-voice">{dt('Minutes in voice in the day')}</label>
          <input id="st-voice" type="number" name="min_voice_minutes" min="0" max="1440" value={row.minVoice} disabled={!ready} />
          <p class="sx-hint">{dt('Or this many minutes in a voice channel. Use 0 to ignore voice.')}</p>
        </div>
      </div>
      <p class="sx-hint stk-note"><Icon name="ph:info-fill" width="14" height="14" />{dt('Members see their streak with /streak and on their Summary page. Nothing changes for the days that already passed: the streak is worked out again from the activity.')}</p>
      <div class="sx-foot"><button type="submit" class="btn btn-accent btn-sm" disabled={!ready}><Icon name="ph:floppy-disk-fill" width="13" height="13" />{dt('Save')}</button></div>
    </form>
  </div>
  <DashFormKit />
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0; }
  .stk { max-width: 720px; }
  .stk-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
  .stk :global(.sx-lead) { margin-bottom: 16px; }
  .stk-box { gap: 14px; }
  .stk-two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  @media (max-width: 560px) { .stk-two { grid-template-columns: minmax(0, 1fr); } }
  .stk :global(.sx-field input[type=number]) { border: 1px solid var(--border); border-radius: 9px; padding: 9px 11px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; width: 100%; box-sizing: border-box; min-width: 0; }
  .stk-note { display: flex; align-items: flex-start; gap: 8px; margin: 0; }
  .stk-note :global(svg) { flex: none; margin-top: 2px; color: var(--text-dim); }
</style>
