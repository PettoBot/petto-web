---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import type { VanityOverview, VanityRule, VanityRole } from '../utils/vanityBot';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  state: 'ok' | 'not_configured' | 'not_installed' | 'no_access' | 'unavailable';
  overview: VanityOverview | null;
  section: string;
  saved: boolean;
  note: string | null;
  error: string | null;
}
const { user, guildId, guildName, guildIcon, state, overview, section, saved, note, error } = Astro.props;

const activeNav: Record<string, string> = { rules: 'vanity', tags: 'vanity-tags', messages: 'vanity-messages', logs: 'vanity-logs' };
const titles: Record<string, string> = { rules: dt('Vanity rules'), tags: dt('Server Tag rules'), messages: dt('Thank-you messages'), logs: dt('Vanity logs') };

const sourceLabel: Record<string, string> = {
  custom_status: dt('Custom Status'), username: dt('Username'), global_name: dt('Global name'), guild_nickname: dt('Server nickname'), display_name: dt('Display name'),
};
const sourceIcon: Record<string, string> = { custom_status: 'ph:chat-circle-dots-fill', username: 'ph:user-fill', global_name: 'ph:identification-badge-fill', guild_nickname: 'ph:tag-fill', display_name: 'ph:user-circle-fill' };
const comparisonLabel: Record<string, string> = {
  equals: dt('is exactly'), contains: dt('contains'), starts_with: dt('starts with'), ends_with: dt('ends with'), regex: dt('matches the pattern'),
};
const conditionLabel: Record<string, string> = {
  is_guild_id: dt('Identity server is'), is_not_guild_id: dt('Identity server is not'), identity_enabled: dt('Server Tag is shown'),
  identity_disabled: dt('Server Tag is hidden'), tag_equals: dt('Tag text is'), tag_not_equals: dt('Tag text is not'),
};
const conditionIcon: Record<string, string> = { is_guild_id: 'ph:buildings-fill', is_not_guild_id: 'ph:buildings-fill', identity_enabled: 'ph:eye-fill', identity_disabled: 'ph:eye-slash-fill', tag_equals: 'ph:tag-fill', tag_not_equals: 'ph:tag-fill' };
const actionLabel: Record<string, string> = { add_role: dt('Add the role'), remove_role: dt('Remove the role') };
const eventLabel: Record<string, string> = {
  vanity_add: dt('Vanity role added'), vanity_remove: dt('Vanity role removed'), tag_add: dt('Server Tag role added'), tag_remove: dt('Server Tag role removed'), error: dt('Errors'),
};
const eventIcon: Record<string, [string, string]> = {
  vanity_add: ['ph:plus-circle-fill', '#a5ea7a'], vanity_remove: ['ph:x-circle-fill', '#f0a88f'], tag_add: ['ph:plus-circle-fill', '#6ec6ff'], tag_remove: ['ph:x-circle-fill', '#c6a8f5'], error: ['ph:warning-fill', '#fe6465'],
};
const needsValue = (condition: string) => ['is_guild_id', 'is_not_guild_id', 'tag_equals', 'tag_not_equals'].includes(condition);

const roles = overview?.roles ?? [];
const channels = overview?.channels ?? [];
const roleName = (roleId: string) => roles.find((role) => role.id === roleId)?.name ?? roleId;
const roleColor = (roleId: string) => { const color = roles.find((role) => role.id === roleId)?.color ?? 0; return color > 0 ? `#${color.toString(16).padStart(6, '0')}` : '#99aab5'; };
const channelName = (channelId: string) => channels.find((channel) => channel.id === channelId)?.name ?? '';
const roleHint = (role: VanityRole) => (role.reason === 'managed' ? ` (${dt('managed')})` : role.reason === 'above_bot' ? ` (${dt('above the bot')})` : '');
const vanityRules = overview?.rules.vanity ?? [];
const tagRules = overview?.rules.guildtag ?? [];
const eventsOn = new Set(overview?.logs.events ?? []);
const unassignable = (rule: VanityRule) => roles.find((role) => role.id === rule.role_id && !role.assignable);
const shown = (text: string, max = 12) => (text.length > max ? `${text.slice(0, max - 1)}…` : text);
const rulesOf = (kind: 'vanity' | 'guildtag') => (kind === 'vanity' ? vanityRules : tagRules);
const countOn = (list: VanityRule[]) => list.filter((rule) => rule.enabled).length;
const ruleTiles = (list: VanityRule[]) => [
  { label: dt('Rules'), value: list.length, tone: 'messages' as const },
  { label: dt('Active'), value: countOn(list), tone: 'joins' as const },
  { label: dt('Turned off'), value: list.length - countOn(list), tone: 'leaves' as const },
  { label: dt('Roles used'), value: new Set(list.map((rule) => rule.role_id)).size, tone: 'voice' as const },
];
const pingOptions: [string, string][] = [['user', dt('Mention the member')], ['none', dt('Do not mention')]];
const notified = (source: 'vanity' | 'guildtag') => Boolean(overview?.notifications[source].channel_id);
const embedsOnLog = (overview?.logs.events ?? []).filter((event) => overview?.logs.embeds?.[event]).length;
const here = (target: string) => `/dash/guild/${guildId}/vanity?section=${target}`;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={activeNav[section] ?? 'vanity'} pageTitle="Vanity roles">
  <DashSettingsKit />
  <DashFormKit />
  <div class="sx-page vn">
  <h1 class="sx-title">{titles[section] ?? dt('Vanity roles')}</h1>

  {saved && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')} {note ? dt(note) : ''}</div>}
  {error && <div class="sx-flash sx-flash-bad" role="alert"><Icon name="ph:warning-fill" width="15" height="15" />{error}</div>}

  {state === 'not_configured' && (
    <div class="sx-panel vn-state"><Icon name="ph:plug-fill" width="26" height="26" /><p>{dt('The dashboard is not connected to the bot yet.')}</p></div>
  )}

  {state === 'unavailable' && (
    <div class="sx-panel vn-state"><Icon name="ph:hourglass-medium-fill" width="26" height="26" /><p>{dt('The bot did not answer in time. Reload the page in a few seconds.')}</p></div>
  )}

  {state === 'no_access' && (
    <div class="sx-panel vn-state"><Icon name="ph:lock-fill" width="26" height="26" /><p>{dt('You need Manage Server or Administrator in this server to use Vanity roles.')}</p></div>
  )}

  {state === 'not_installed' && (
    <div class="sx-panel vn-state">
      <Icon name="ph:sparkle-fill" width="26" height="26" />
      <h2>{dt('Petto is not in this server yet')}</h2>
      <p>{dt('Add Petto to the server, give it Manage Roles, and put its role above the roles it should hand out. Then come back to set up rules here.')}</p>
      <a class="btn btn-accent btn-sm" href="/dash/manage"><Icon name="ph:share-network-fill" width="13" height="13" /> {dt('Manage servers')}</a>
    </div>
  )}

  {state === 'ok' && overview && section === 'rules' && (
    <>
      <DashStatTiles tiles={ruleTiles(vanityRules)} />

      <section class="sx-panel vn-create">
        <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#a5ea7a"><Icon name="ph:plus-circle-fill" width="17" height="17" /></span><h2>{dt('Create a rule')}</h2></div>
        <p class="sx-lead"><Fragment set:html={dth('Example: when a member\'s Custom Status <b>contains</b> your server word, give them a role.')} /></p>
        <form method="POST" class="vn-form" data-no-dirty>
          <input type="hidden" name="action" value="vanity_create" />
          <div class="sx-grid">
            <div class="sx-field"><label for="vn-name">{dt('Name')}</label><input id="vn-name" type="text" name="name" maxlength="40" required placeholder="cinnamochi" data-count autocomplete="off" /></div>
            <div class="sx-field"><label for="vn-role">{dt('Role')}</label>
              <select id="vn-role" name="role_id" required>
                <option value="" disabled selected>{dt('Choose a role')}</option>
                {roles.map((role) => <option value={role.id} disabled={!role.assignable}>{role.name}{roleHint(role)}</option>)}
              </select>
            </div>
            <div class="sx-field"><span class="sx-label" id="vn-src-l">{dt('What to check')}</span>
              <div class="dfx-chips" role="radiogroup" aria-labelledby="vn-src-l">{overview.options.vanity_sources.map((value, i) => <label class="dfx-chip"><input type="radio" name="source" value={value} checked={i === 0} /><Icon name={sourceIcon[value] ?? 'ph:user-fill'} width="14" height="14" />{sourceLabel[value] ?? value}</label>)}</div>
            </div>
            <div class="sx-field"><span class="sx-label" id="vn-cmp-l">{dt('How it matches')}</span>
              <div class="dfx-chips" role="radiogroup" aria-labelledby="vn-cmp-l">{overview.options.comparisons.map((value) => <label class="dfx-chip"><input type="radio" name="comparison" value={value} checked={value === 'contains'} />{comparisonLabel[value] ?? value}</label>)}</div>
            </div>
            <div class="sx-field sx-wide"><label for="vn-word">{dt('Text to match')}</label><textarea id="vn-word" name="word" class="dgl-autogrow sx-one" rows="1" data-one-line data-count maxlength="256" required placeholder="discord.gg/petto"></textarea></div>
            <div class="sx-field"><span class="sx-label" id="vn-act-l">{dt('When it matches')}</span>
              <div class="dfx-chips" role="radiogroup" aria-labelledby="vn-act-l">{overview.options.actions.map((value, i) => <label class="dfx-chip"><input type="radio" name="rule_action" value={value} checked={i === 0} />{actionLabel[value] ?? value}</label>)}</div>
            </div>
            <div class="sx-field"><span class="sx-label">{dt('Matching')}</span>
              <div class="sx-chips">
                <label class="sx-chip"><input type="checkbox" name="case_fold" checked /><span>{dt('Ignore capital letters')}</span></label>
                <label class="sx-chip"><input type="checkbox" name="trim_space" checked /><span>{dt('Ignore spaces at the ends')}</span></label>
                <label class="sx-chip"><input type="checkbox" name="collapse_space" checked /><span>{dt('Treat repeated spaces as one')}</span></label>
              </div>
            </div>
          </div>
          <div class="sx-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="13" height="13" />{dt('Create rule')}</button></div>
        </form>
      </section>

      <div class="sx-duo vn-top">
        <form method="POST" class="sx-panel vn-offline">
          <input type="hidden" name="action" value="settings_set" />
          <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#9bd0f5"><Icon name="ph:moon-fill" width="17" height="17" /></span><h2>{dt('When a member goes offline')}</h2></div>
          <p class="sx-lead">{dt('Discord hides the Custom Status of a member who is offline or invisible. Choose what Petto does with the role of a rule that reads the Custom Status when that happens.')}</p>
          <div class="sx-field"><span class="sx-label" id="vn-off-l">{dt('Role of a member who goes offline')}</span>
            <div class="sx-choices" role="radiogroup" aria-labelledby="vn-off-l">
              <label class="sx-choice"><input type="radio" name="offline_mode" value="remove" checked={overview.settings.offline_mode !== 'keep'} /><span class="sx-choice-body"><Icon name="ph:x-circle-fill" width="17" height="17" /><b>{dt('Take the role away (default)')}</b></span></label>
              <label class="sx-choice"><input type="radio" name="offline_mode" value="keep" checked={overview.settings.offline_mode === 'keep'} /><span class="sx-choice-body"><Icon name="ph:check-circle-fill" width="17" height="17" /><b>{dt('Keep the role')}</b></span></label>
            </div>
          </div>
          <p class="sx-hint">{dt('Petto only takes away roles it gave itself, and gives the role back, and thanks the member again, when they are online with a matching status. A member it simply has no presence for is never changed. If another rule for the same role (a name or a Server Tag rule) still matches, the role stays.')}</p>
          <div class="sx-foot vn-save"><button type="submit" class="btn btn-accent btn-sm">{dt('Save')}</button></div>
        </form>

        <section class="sx-panel vn-links-panel">
          <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#f0a88f"><Icon name="ph:chat-teardrop-text-fill" width="17" height="17" /></span><h2>{dt('Messages and log')}</h2></div>
          <div class="vn-links">
            <a class="vn-link" href={here('messages')}>
              <span class="vn-link-text"><b>{dt('Vanity thank-you message')}</b><em>{notified('vanity') ? `#${channelName(overview.notifications.vanity.channel_id) || overview.notifications.vanity.channel_id}` : dt('Not set up yet')}</em></span>
              <Icon name="ph:arrow-right-bold" class="vn-link-go" width="14" height="14" />
            </a>
            <a class="vn-link" href={here('logs')}>
              <span class="vn-link-text"><b>{dt('Staff action log')}</b><em>{overview.logs.channel_id ? `#${channelName(overview.logs.channel_id) || overview.logs.channel_id}` : dt('Not set up yet')}</em></span>
              <Icon name="ph:arrow-right-bold" class="vn-link-go" width="14" height="14" />
            </a>
          </div>
        </section>
      </div>

      <section class="sx-panel vn-list-panel">
        <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#fed53c"><Icon name="ph:list-checks-fill" width="17" height="17" /></span><h2>{dt('Your rules')}</h2><span class="sx-tag">{vanityRules.length}</span></div>
        {vanityRules.length === 0 ? <p class="vn-empty"><Icon name="ph:sparkle-fill" width="22" height="22" />{dt('No rules yet.')}</p> : (
          <div class="vn-list dgl-stagger">
            {vanityRules.map((rule) => (
              <details class:list={['dfx-acc', 'vn-rule', { 'vn-off': !rule.enabled }]}>
                <summary>
                  <span class="vn-ico"><Icon name={sourceIcon[rule.source ?? ''] ?? 'ph:user-fill'} width="16" height="16" /></span>
                  <span class="dfx-acc-title"><b>{rule.name}</b><em>{sourceLabel[rule.source ?? ''] ?? rule.source} {comparisonLabel[rule.comparison ?? ''] ?? rule.comparison} <code>{rule.word}</code></em></span>
                  <span class="vn-tags">
                    <span class="vn-role" style={`--c:${roleColor(rule.role_id)}`}><i></i><b>{roleName(rule.role_id)}</b></span>
                    <span class="sx-tag">{actionLabel[rule.action]}</span>
                    {!rule.enabled && <span class="sx-tag vn-tag-off">{dt('Off')}</span>}
                    {unassignable(rule) && <span class="sx-tag vn-tag-warn">{unassignable(rule)?.reason === 'managed' ? dt('Managed by an integration, Petto cannot give it') : dt("Above Petto's highest role: move Petto's role above it")}</span>}
                  </span>
                  <Icon name="ph:caret-down-bold" class="dfx-caret" width="14" height="14" />
                </summary>
                <div class="dfx-acc-body">
                  <form method="POST" class="vn-form vn-edit">
                    <input type="hidden" name="action" value="vanity_update" />
                    <input type="hidden" name="name" value={rule.name} />
                    <div class="sx-grid">
                      <div class="sx-field sx-wide"><span class="sx-label">{dt('What to check')}</span>
                        <div class="dfx-chips" role="radiogroup" aria-label={dt('What to check')}>{overview.options.vanity_sources.map((value) => <label class="dfx-chip"><input type="radio" name="source" value={value} checked={value === rule.source} /><Icon name={sourceIcon[value] ?? 'ph:user-fill'} width="14" height="14" />{sourceLabel[value] ?? value}</label>)}</div>
                      </div>
                      <div class="sx-field sx-wide"><span class="sx-label">{dt('How it matches')}</span>
                        <div class="dfx-chips" role="radiogroup" aria-label={dt('How it matches')}>{overview.options.comparisons.map((value) => <label class="dfx-chip"><input type="radio" name="comparison" value={value} checked={value === rule.comparison} />{comparisonLabel[value] ?? value}</label>)}</div>
                      </div>
                      <div class="sx-field"><label>{dt('Text to match')}</label><textarea name="word" class="dgl-autogrow sx-one" rows="1" data-one-line data-count maxlength="256" required aria-label={dt('Text to match')}>{rule.word}</textarea></div>
                      <div class="sx-field"><label>{dt('Role')}</label>
                        <select name="role_id" aria-label={dt('Role')}>{roles.map((role) => <option value={role.id} selected={role.id === rule.role_id} disabled={!role.assignable && role.id !== rule.role_id}>{role.name}{roleHint(role)}</option>)}</select>
                      </div>
                    </div>
                    <div class="sx-foot vn-save"><button type="submit" class="btn btn-ghost btn-sm">{dt('Save changes')}</button></div>
                  </form>
                  <div class="vn-row-actions">
                    <form method="POST" data-no-dirty><input type="hidden" name="action" value="vanity_toggle" /><input type="hidden" name="name" value={rule.name} /><input type="hidden" name="enabled" value={rule.enabled ? '0' : '1'} /><button type="submit" class="btn btn-ghost btn-sm">{rule.enabled ? dt('Turn off') : dt('Turn on')}</button></form>
                    <form method="POST" data-no-dirty><input type="hidden" name="action" value="vanity_delete" /><input type="hidden" name="name" value={rule.name} /><button type="submit" class="btn btn-danger btn-sm" data-confirm={dt('Delete this rule? Roles it gave stay until the next check.')}>{dt('Delete')}</button></form>
                  </div>
                </div>
              </details>
            ))}
          </div>
        )}
      </section>
    </>
  )}

  {state === 'ok' && overview && section === 'tags' && (
    <>
      <DashStatTiles tiles={ruleTiles(tagRules)} />

      <section class="sx-panel vn-create">
        <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#a5ea7a"><Icon name="ph:plus-circle-fill" width="17" height="17" /></span><h2>{dt('Create a rule')}</h2></div>
        <p class="sx-lead">{dt('Server Tags come from the server a member shows on their Discord profile. Use the server ID to match a specific server.')}</p>
        <form method="POST" class="vn-form" data-no-dirty>
          <input type="hidden" name="action" value="guildtag_create" />
          <div class="sx-grid">
            <div class="sx-field"><label for="vn-tname">{dt('Name')}</label><input id="vn-tname" type="text" name="name" maxlength="40" required placeholder="partner-server" data-count autocomplete="off" /></div>
            <div class="sx-field"><label for="vn-trole">{dt('Role')}</label>
              <select id="vn-trole" name="role_id" required>
                <option value="" disabled selected>{dt('Choose a role')}</option>
                {roles.map((role) => <option value={role.id} disabled={!role.assignable}>{role.name}{roleHint(role)}</option>)}
              </select>
            </div>
            <div class="sx-field"><label for="vn-cond">{dt('Condition')}</label>
              <select id="vn-cond" name="condition">{overview.options.conditions.map((value) => <option value={value}>{conditionLabel[value] ?? value}</option>)}</select>
            </div>
            <div class="sx-field"><label for="vn-value">{dt('Server ID or tag text')}</label><input id="vn-value" type="text" name="value" maxlength="32" placeholder="707307527846625280" data-count autocomplete="off" /></div>
            <div class="sx-field"><span class="sx-label" id="vn-tact-l">{dt('When it matches')}</span>
              <div class="dfx-chips" role="radiogroup" aria-labelledby="vn-tact-l">{overview.options.actions.map((value, i) => <label class="dfx-chip"><input type="radio" name="rule_action" value={value} checked={i === 0} />{actionLabel[value] ?? value}</label>)}</div>
            </div>
            <span class="sx-hint vn-after-value">{dt('Leave empty for conditions that need no value.')}</span>
          </div>
          <div class="sx-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="13" height="13" />{dt('Create rule')}</button></div>
        </form>
      </section>

      <div class="vn-links vn-links-row vn-top">
        <a class="vn-link" href={here('messages')}>
          <span class="sx-panel-icon" style="--c:#6ec6ff"><Icon name="ph:tag-fill" width="17" height="17" /></span>
          <span class="vn-link-text"><b>{dt('Server Tag thank-you message')}</b><em>{notified('guildtag') ? `#${channelName(overview.notifications.guildtag.channel_id) || overview.notifications.guildtag.channel_id}` : dt('Not set up yet')}</em></span>
          <Icon name="ph:arrow-right-bold" class="vn-link-go" width="14" height="14" />
        </a>
        <a class="vn-link" href={here('logs')}>
          <span class="sx-panel-icon" style="--c:#6ec6ff"><Icon name="ph:scroll-fill" width="17" height="17" /></span>
          <span class="vn-link-text"><b>{dt('Staff action log')}</b><em>{overview.logs.channel_id ? `#${channelName(overview.logs.channel_id) || overview.logs.channel_id}` : dt('Not set up yet')}</em></span>
          <Icon name="ph:arrow-right-bold" class="vn-link-go" width="14" height="14" />
        </a>
        <a class="vn-link" href={here('rules')}>
          <span class="sx-panel-icon" style="--c:#a5ea7a"><Icon name="ph:list-checks-fill" width="17" height="17" /></span>
          <span class="vn-link-text"><b>{dt('Vanity rules')}</b><em>{dt('{n} of {max}', { n: countOn(vanityRules), max: vanityRules.length })} · {dt('Active')}</em></span>
          <Icon name="ph:arrow-right-bold" class="vn-link-go" width="14" height="14" />
        </a>
      </div>

      <section class="sx-panel vn-list-panel">
        <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#fed53c"><Icon name="ph:list-checks-fill" width="17" height="17" /></span><h2>{dt('Your rules')}</h2><span class="sx-tag">{tagRules.length}</span></div>
        {tagRules.length === 0 ? <p class="vn-empty"><Icon name="ph:sparkle-fill" width="22" height="22" />{dt('No rules yet.')}</p> : (
          <div class="vn-list dgl-stagger">
            {tagRules.map((rule) => (
              <details class:list={['dfx-acc', 'vn-rule', { 'vn-off': !rule.enabled }]}>
                <summary>
                  <span class="vn-ico"><Icon name={conditionIcon[rule.condition ?? ''] ?? 'ph:tag-fill'} width="16" height="16" /></span>
                  <span class="dfx-acc-title"><b>{rule.name}</b><em>{conditionLabel[rule.condition ?? ''] ?? rule.condition} {needsValue(rule.condition ?? '') && <code>{rule.value}</code>}</em></span>
                  <span class="vn-tags">
                    <span class="vn-role" style={`--c:${roleColor(rule.role_id)}`}><i></i><b>{roleName(rule.role_id)}</b></span>
                    <span class="sx-tag">{actionLabel[rule.action]}</span>
                    {!rule.enabled && <span class="sx-tag vn-tag-off">{dt('Off')}</span>}
                    {unassignable(rule) && <span class="sx-tag vn-tag-warn">{unassignable(rule)?.reason === 'managed' ? dt('Managed by an integration, Petto cannot give it') : dt("Above Petto's highest role: move Petto's role above it")}</span>}
                  </span>
                  <Icon name="ph:caret-down-bold" class="dfx-caret" width="14" height="14" />
                </summary>
                <div class="dfx-acc-body">
                  <form method="POST" class="vn-form vn-edit">
                    <input type="hidden" name="action" value="guildtag_update" />
                    <input type="hidden" name="name" value={rule.name} />
                    <div class="sx-grid">
                      <div class="sx-field"><label>{dt('Condition')}</label>
                        <select name="condition" aria-label={dt('Condition')}>{overview.options.conditions.map((value) => <option value={value} selected={value === rule.condition}>{conditionLabel[value] ?? value}</option>)}</select>
                      </div>
                      <div class="sx-field"><label>{dt('Role')}</label>
                        <select name="role_id" aria-label={dt('Role')}>{roles.map((role) => <option value={role.id} selected={role.id === rule.role_id} disabled={!role.assignable && role.id !== rule.role_id}>{role.name}{roleHint(role)}</option>)}</select>
                      </div>
                      <div class="sx-field sx-wide"><label>{dt('Server ID or tag text')}</label><input type="text" name="value" maxlength="32" value={rule.value} data-count aria-label={dt('Server ID or tag text')} autocomplete="off" /></div>
                    </div>
                    <div class="sx-foot vn-save"><button type="submit" class="btn btn-ghost btn-sm">{dt('Save changes')}</button></div>
                  </form>
                  <div class="vn-row-actions">
                    <form method="POST" data-no-dirty><input type="hidden" name="action" value="guildtag_toggle" /><input type="hidden" name="name" value={rule.name} /><input type="hidden" name="enabled" value={rule.enabled ? '0' : '1'} /><button type="submit" class="btn btn-ghost btn-sm">{rule.enabled ? dt('Turn off') : dt('Turn on')}</button></form>
                    <form method="POST" data-no-dirty><input type="hidden" name="action" value="guildtag_delete" /><input type="hidden" name="name" value={rule.name} /><button type="submit" class="btn btn-danger btn-sm" data-confirm={dt('Delete this rule? Roles it gave stay until the next check.')}>{dt('Delete')}</button></form>
                  </div>
                </div>
              </details>
            ))}
          </div>
        )}
      </section>
    </>
  )}

  {state === 'ok' && overview && section === 'messages' && (
    <>
      <DashStatTiles tiles={[
        { label: dt('Vanity thank-you'), value: 0, text: notified('vanity') ? dt('On') : dt('Off'), tone: 'joins' },
        { label: dt('Server Tag thank-you'), value: 0, text: notified('guildtag') ? dt('On') : dt('Off'), tone: 'voice' },
        { label: dt('Saved embeds'), value: overview.embeds.length, tone: 'messages' },
        { label: dt('Rules'), value: vanityRules.length + tagRules.length, tone: 'invites' },
      ]} />
      <div class="sx-duo vn-two">
        {(['vanity', 'guildtag'] as const).map((source) => {
          const current = overview.notifications[source];
          const list = rulesOf(source);
          return (
            <form method="POST" class="sx-panel vn-msg">
              <input type="hidden" name="action" value="notify_set" />
              <input type="hidden" name="notify_source" value={source} />
              <div class="sx-panel-head"><span class="sx-panel-icon" style={`--c:${source === 'vanity' ? '#f0a88f' : '#9bd0f5'}`}><Icon name={source === 'vanity' ? 'ph:hand-heart-fill' : 'ph:tag-fill'} width="17" height="17" /></span><h2>{source === 'vanity' ? dt('Vanity thank-you message') : dt('Server Tag thank-you message')}</h2></div>
              <p class="sx-lead">{dt('Sent when a member starts matching a rule. It does not repeat on every presence or member update.')}</p>
              <div class="sx-field"><label for={`vn-ch-${source}`}>{dt('Channel')}</label>
                <select id={`vn-ch-${source}`} name="channel_id" required>
                  <option value="" disabled selected={!current.channel_id}>{dt('Choose a channel')}</option>
                  {channels.map((channel) => <option value={channel.id} selected={channel.id === current.channel_id}>#{channel.name}</option>)}
                </select>
              </div>
              <div class="sx-field"><label for={`vn-em-${source}`}>{dt('Message')}</label>
                <select id={`vn-em-${source}`} name="embed" data-dp-template-only>
                  <option value="" selected={!current.embed}>{dt('Default message')}</option>
                  {overview.embeds.map((name) => <option value={name} selected={name === current.embed}>{name}</option>)}
                </select>
              </div>
              <div class="sx-field"><span class="sx-label" id={`vn-ping-${source}`}>{dt('Mention the member')}</span>
                <div class="dfx-chips" role="radiogroup" aria-labelledby={`vn-ping-${source}`}>{pingOptions.map(([value, label]) => <label class="dfx-chip"><input type="radio" name="ping" value={value} checked={current.ping === value} />{label}</label>)}</div>
              </div>
              <div class="sx-sub vn-feeds">
                <h3>{dt('Rules that send it')}</h3>
                {list.length === 0 ? <p class="sx-hint">{dt('No rules yet.')} <a href={here(source === 'vanity' ? 'rules' : 'tags')}>{source === 'vanity' ? dt('Vanity rules') : dt('Server Tag rules')}</a></p> : (
                  <div class="vn-feed-chips">{list.map((rule) => <a class:list={['vn-feed', { 'vn-feed-off': !rule.enabled }]} href={here(source === 'vanity' ? 'rules' : 'tags')} title={rule.enabled ? undefined : dt('Off')}>{rule.name}</a>)}</div>
                )}
              </div>
              <div class="sx-foot vn-save"><button type="submit" class="btn btn-accent btn-sm">{dt('Save')}</button></div>
            </form>
          );
        })}
      </div>
      <section class="sx-panel vn-embeds">
        <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#c6a8f5"><Icon name="ph:clipboard-text-fill" width="17" height="17" /></span><h2>{dt('Saved embeds')}</h2>{overview.embeds.length > 0 && <span class="sx-tag">{overview.embeds.length}</span>}</div>
        <p class="sx-lead"><Fragment set:html={dth('Write your own messages in <a href="{a}">Embeds</a> (the same ones Petto uses everywhere, classic or V2) and pick them here. Their variables are listed under Vanity and Server Tag.', { a: `/dash/guild/${guildId}/embeds` })} /></p>
        {overview.embeds.length > 0 ? <div class="vn-feed-chips">{overview.embeds.map((name) => <a class="vn-feed" href={`/dash/guild/${guildId}/embeds`}>{name}</a>)}</div> : (
          <p class="vn-empty"><Icon name="ph:clipboard-text-fill" width="22" height="22" />{dt('No saved embeds yet.')}<a class="btn btn-ghost btn-sm" href={`/dash/guild/${guildId}/embeds`}>{dt('Open Embeds')}</a></p>
        )}
      </section>
    </>
  )}

  {state === 'ok' && overview && section === 'logs' && (
    <>
      <DashStatTiles tiles={[
        { label: dt('Log channel'), value: 0, text: overview.logs.channel_id ? `#${shown(channelName(overview.logs.channel_id) || overview.logs.channel_id)}` : dt('Off'), tone: 'voice' },
        { label: dt('Events logged'), value: eventsOn.size, tone: 'joins' },
        { label: dt('With a saved embed'), value: embedsOnLog, tone: 'invites' },
        { label: dt('Errors'), value: 0, text: eventsOn.has('error') ? dt('On') : dt('Off'), tone: 'leaves' },
      ]} />
      <form method="POST" class="sx-panel vn-logs">
        <input type="hidden" name="action" value="logs_set" />
        <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#6ec6ff"><Icon name="ph:scroll-fill" width="17" height="17" /></span><h2>{dt('Staff action log')}</h2></div>
        <p class="sx-lead">{dt('A private log of roles the bot adds or removes, with the reason, and of errors.')}</p>
        <div class="sx-field vn-logs-channel"><label for="vn-log-ch">{dt('Channel')}</label>
          <select id="vn-log-ch" name="channel_id" required>
            <option value="" disabled selected={!overview.logs.channel_id}>{dt('Choose a channel')}</option>
            {channels.map((channel) => <option value={channel.id} selected={channel.id === overview.logs.channel_id}>#{channel.name}</option>)}
          </select>
        </div>
        <div class="sx-sub vn-events">
          <h3>{dt('What is written')}</h3>
          {overview.options.log_events.map((key) => (
            <div class="vn-event" style={`--c:${(eventIcon[key] ?? ['', '#94a3b8'])[1]}`}>
              <label class="sx-switch">
                <input type="checkbox" name="events" value={key} checked={overview.logs.channel_id ? eventsOn.has(key) : true} />
                <span class="vn-event-icon"><Icon name={(eventIcon[key] ?? ['ph:scroll-fill'])[0]} width="17" height="17" /></span>
                <span class="sx-switch-text"><b>{eventLabel[key] ?? key}</b></span>
                <i class="sx-toggle"></i>
              </label>
              <select name={`embed_${key}`} aria-label={dt('Message for this entry')}>
                <option value="" selected={!overview.logs.embeds?.[key]}>{dt('Default card')}</option>
                {overview.embeds.map((name) => <option value={name} selected={name === overview.logs.embeds?.[key]}>{name}</option>)}
              </select>
            </div>
          ))}
          <p class="sx-hint">{dt('Each entry can use a saved embed from Embeds, or the default card.')}</p>
        </div>
        <div class="sx-foot vn-save"><button type="submit" class="btn btn-accent btn-sm">{dt('Save')}</button></div>
      </form>

      <section class="vn-more">
        <div class="vn-links vn-links-row">
          <a class="vn-link" href={here('rules')}>
            <span class="sx-panel-icon" style="--c:#a5ea7a"><Icon name="ph:list-checks-fill" width="17" height="17" /></span>
            <span class="vn-link-text"><b>{dt('Vanity rules')}</b><em>{dt('{n} of {max}', { n: countOn(vanityRules), max: vanityRules.length })} · {dt('Active')}</em></span>
            <Icon name="ph:arrow-right-bold" class="vn-link-go" width="14" height="14" />
          </a>
          <a class="vn-link" href={here('tags')}>
            <span class="sx-panel-icon" style="--c:#6ec6ff"><Icon name="ph:tag-fill" width="17" height="17" /></span>
            <span class="vn-link-text"><b>{dt('Server Tag rules')}</b><em>{dt('{n} of {max}', { n: countOn(tagRules), max: tagRules.length })} · {dt('Active')}</em></span>
            <Icon name="ph:arrow-right-bold" class="vn-link-go" width="14" height="14" />
          </a>
          <a class="vn-link" href={here('messages')}>
            <span class="sx-panel-icon" style="--c:#f0a88f"><Icon name="ph:hand-heart-fill" width="17" height="17" /></span>
            <span class="vn-link-text"><b>{dt('Thank-you messages')}</b><em>{[notified('vanity'), notified('guildtag')].filter(Boolean).length} / 2 · {dt('On')}</em></span>
            <Icon name="ph:arrow-right-bold" class="vn-link-go" width="14" height="14" />
          </a>
        </div>
      </section>
    </>
  )}
  </div>
</DashGuildLayout>

<style>
  .vn { max-width: 1040px; }
  h1 { font-size: 24px; margin: 0 0 16px; }
  .vn-state { align-items: center; text-align: center; gap: 10px; padding: 34px 20px; color: var(--text-dim); }
  .vn-state :global(svg) { color: var(--accent); }
  .vn-state h2 { margin: 0; font-size: 16px; color: var(--text); }
  .vn-state p { margin: 0; max-width: 60ch; font-size: 14px; line-height: 1.5; color: var(--text-muted); }
  .vn-state .btn { display: inline-flex; align-items: center; gap: 6px; margin-top: 4px; }

  .vn-top { align-items: start; margin-bottom: 14px; }
  .vn-create { gap: 12px; margin-bottom: 14px; animation: m-rise-in var(--m-slow) var(--m-out) both; }
  .vn-after-value { grid-column: 1 / -1; margin-top: -8px; }
  .vn-form { display: flex; flex-direction: column; gap: 14px; }
  .vn-form .sx-label { font-size: 13px; font-weight: 600; }
  .vn-form .btn, .vn-edit .btn { display: inline-flex; align-items: center; gap: 7px; }
  .vn-form .dfx-chip :global(svg) { flex: none; }
  .vn-offline .sx-choices { grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }
  /* its only button is the Save that the bar of unsaved changes stands in for: no empty row is left */
  .vn-save:not(:has(> :not(.dgl-bar-save))) { display: none; }

  .vn-links { display: flex; flex-direction: column; gap: 8px; }
  .vn-link { display: flex; align-items: center; gap: 12px; min-width: 0; padding: 12px 14px; border: 1px solid var(--border-soft); border-radius: 12px; background: color-mix(in srgb, var(--text) 3%, var(--card)); color: var(--text); text-decoration: none; transition: background-color .3s ease, border-color .3s ease; }
  .vn-link:hover { background: var(--card-hover); border-color: var(--border); }
  .vn-link:active { background: color-mix(in srgb, var(--text) 10%, transparent); transform: none; filter: none; }
  .vn-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .vn-link-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .vn-link-text b { font-size: 13.5px; font-weight: 600; overflow-wrap: anywhere; }
  .vn-link-text em { font-style: normal; font-size: 12px; color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .vn-link :global(.vn-link-go) { flex: none; color: var(--text-dim); }
  .vn-links-row { flex-direction: row; gap: 10px; }
  .vn-links-row .vn-link { flex: 1 1 0; }
  .vn-more { padding: 14px 0 0; }

  .vn-list-panel { gap: 12px; }
  .vn-list { display: flex; flex-direction: column; gap: 8px; }
  .vn-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; margin: 0; padding: 26px 16px; border: 1px dashed var(--border); border-radius: 12px; font-size: 13.5px; color: var(--text-dim); text-align: center; }
  .vn-empty :global(svg) { color: var(--accent); }
  .vn-rule { background: color-mix(in srgb, var(--text) 3%, var(--card)); border-color: var(--border-soft); }
  .vn-rule > summary { gap: 12px; flex-wrap: wrap; padding: 11px 14px; }
  .vn-rule.vn-off .dfx-acc-title, .vn-rule.vn-off .vn-ico { opacity: .6; }
  .vn-ico { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; color: var(--accent); background: var(--accent-soft); }
  .vn-rule .dfx-acc-title b { overflow-wrap: anywhere; }
  .vn-rule .dfx-acc-title em { overflow-wrap: anywhere; line-height: 1.5; }
  .vn-rule .dfx-acc-title { flex: 1 1 220px; }
  .vn-rule code { font-family: var(--mono); font-size: 11.5px; padding: 1px 6px; border-radius: 5px; background: color-mix(in srgb, var(--text) 8%, transparent); color: var(--text); }
  .vn-tags { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 6px; min-width: 0; }
  .vn-role { display: inline-flex; align-items: center; gap: 6px; max-width: 100%; min-width: 0; padding: 3px 10px 3px 8px; border-radius: 999px; background: color-mix(in srgb, var(--c) 14%, transparent); border: 1px solid color-mix(in srgb, var(--c) 45%, var(--border)); font-size: 12.5px; }
  .vn-role i { width: 9px; height: 9px; border-radius: 50%; background: var(--c); flex: none; }
  .vn-role b { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .vn-tag-off { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 14%, transparent); }
  .vn-tag-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 14%, transparent); white-space: normal; }
  .vn-rule .dfx-acc-body { gap: 14px; padding: 6px 14px 14px; }
  .vn-row-actions { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 12px; border-top: 1px solid var(--border-soft); }
  .vn-row-actions form { margin: 0; }

  .vn-two { align-items: start; margin-bottom: 14px; }
  .vn-msg { gap: 14px; }
  .vn-feed-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .vn-feed { display: inline-flex; align-items: center; max-width: 100%; min-width: 0; overflow-wrap: anywhere; padding: 4px 11px; border-radius: 999px; border: 1px solid var(--border); background: color-mix(in srgb, var(--text) 4%, var(--card)); color: var(--text-muted); font-size: 12.5px; text-decoration: none; transition: background-color .3s ease, color .3s ease; }
  .vn-feed:hover { background: var(--card-hover); color: var(--text); }
  .vn-feed-off { opacity: .55; text-decoration: line-through; }
  .vn-embeds { gap: 12px; }
  .vn-empty .btn { color: var(--text); }
  .vn-embeds .sx-lead { margin: 0; }
  .vn-embeds :global(a), .vn-msg :global(a) { color: var(--accent); }
  .vn-msg .vn-feed, .vn-embeds .vn-feed { color: var(--text-muted); }

  .vn-logs { gap: 14px; margin-bottom: 0; }
  .vn-logs-channel { max-width: 420px; }
  .vn-events { gap: 8px; }
  .vn-events > h3 { margin-bottom: 2px; }
  .vn-event { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 10px; align-items: center; }
  .vn-event select { border: 1px solid var(--border); border-radius: 9px; padding: 9px 11px; background-color: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; width: 100%; box-sizing: border-box; min-width: 0; min-height: 44px; }
  .vn-event select:focus-visible { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .vn-event-icon { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; color: var(--c); background: color-mix(in srgb, var(--c) 14%, transparent); }

  @media (max-width: 1060px) {
    .vn-top, .vn-two { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 720px) {
    .vn-event, .vn-links-row { grid-template-columns: minmax(0, 1fr); flex-direction: column; align-items: stretch; }
    .vn-links-row .vn-link { flex: 1 1 auto; }
    .vn-rule > summary { padding: 10px 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .vn-create { animation: none; } }
</style>
