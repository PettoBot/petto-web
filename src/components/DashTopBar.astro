---
// Shared Vetox-style top bar for both dashboard shells (guild pages and account/profile pages):
// Left: mobile drawer button + context breadcrumb (server or user -> active page).
// Center: search trigger (/ or Ctrl+K) opening the command palette.
// Right: animated popovers for Language, Help/Resources, Theme switch, and Account/Settings.
import { Icon } from 'astro-icon/components';
import { localePath, type Locale } from '../i18n/ui';
import { getDashLang, makeT } from '../i18n/dash';
import { guildLetter, guildLetterStyle } from '../utils/guildLetter.mjs';

interface Props {
  kind: 'guild' | 'user';
  contextName: string;
  contextIcon: string | null;
  pageLabel: string;
  user: { username: string; avatar: string | null };
  menuBtnId: 'dgl-menu-btn' | 'dme-burger';
  sideId: 'dgl-side' | 'dme-side';
}

const { kind, contextName, contextIcon, pageLabel, user, menuBtnId, sideId } = Astro.props;
const lang: Locale = getDashLang(Astro);
const dt = makeT(lang);
const base = localePath[lang];

const langOptions: { code: Locale; label: string; flag: string }[] = [
  { code: 'en', label: 'English', flag: '/assets/flags/us.svg' },
  { code: 'es', label: 'Español', flag: '/assets/flags/es.svg' },
  { code: 'pt-BR', label: 'Português (Brasil)', flag: '/assets/flags/br.svg' },
];
const langNow = langOptions.find((o) => o.code === lang) ?? langOptions[0];
const languageHref = (target: Locale) => `/dash/lang?to=${encodeURIComponent(target)}&next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;
---
<header class="dtb" data-dtb>
  <div class="dtb-left">
    <button type="button" class="dtb-burger dash-menu-btn" id={menuBtnId} aria-controls={sideId} aria-expanded="false" aria-label={dt('Open the menu')}>
      <Icon name="ph:list" width="20" height="20" />
    </button>
    <button type="button" class="dtb-ctx" data-sheet-open aria-haspopup="dialog" aria-expanded="false" aria-controls="ds-sheet" title={kind === 'guild' ? dt('Switch server') : dt('Select a server')}>
      <span class:list={['dtb-ctx-av', `is-${kind}`]}>
        {contextIcon
          ? <img src={contextIcon} alt="" width="22" height="22" referrerpolicy="no-referrer" />
          : kind === 'guild'
            ? <span class="dtb-ctx-fallback" style={guildLetterStyle(contextName)}>{guildLetter(contextName)}</span>
            : <span class="dtb-ctx-fallback"><Icon name="ph:user-fill" width="13" height="13" /></span>}
      </span>
      <span class="dtb-ctx-name">{contextName}</span>
    </button>
    <Icon name="ph:caret-right" width="12" height="12" class="dtb-sep" />
    <span class="dtb-page" id={kind === 'guild' ? 'dgl-menu-label' : 'dme-bar-label'}>{pageLabel}</span>
  </div>

  <div class="dtb-center">
    <button
      type="button"
      class="dtb-search"
      id="dgl-find"
      data-placeholder={dt('Jump to a page or a setting…')}
      data-empty={dt('Nothing matches.')}
      data-pages-word={dt('Pages')}
      data-settings-word={dt('Settings')}
      data-settings-url={kind === 'guild' ? '/dash/search-index.json' : undefined}
      aria-haspopup="dialog"
      aria-label={dt('Search')}
    >
      <Icon name="ph:magnifying-glass" width="15" height="15" class="dtb-search-ic" />
      <span class="dtb-search-text">{dt('Search')}</span>
      <kbd class="dtb-search-kbd" aria-hidden="true">/</kbd>
    </button>
  </div>

  <div class="dtb-right">
    <div class="dtb-pop" data-dtb-pop>
      <button type="button" class="dtb-lang-btn" data-dtb-trigger aria-haspopup="menu" aria-expanded="false" aria-label={langNow.label}>
        <img class="dtb-flag" src={langNow.flag} alt="" width="20" height="14" />
        <span class="dtb-lang-text">{langNow.label}</span>
        <Icon name="ph:caret-down" width="12" height="12" class="dtb-caret" />
      </button>
      <div class="dtb-menu dtb-menu-lang" role="menu">
        {langOptions.map((o) => (
          <a role="menuitem" href={languageHref(o.code)} data-set-lang={o.code} lang={o.code} aria-current={o.code === lang ? 'true' : undefined} class:list={['dtb-item', { active: o.code === lang }]}>
            <span class="dtb-item-main">
              <img class="dtb-flag" src={o.flag} alt="" width="22" height="15" />
              <span>{o.label}</span>
            </span>
            {o.code === lang && <Icon name="ph:check-bold" width="14" height="14" class="dtb-check" />}
          </a>
        ))}
      </div>
    </div>

    <div class="dtb-pop" data-dtb-pop>
      <button type="button" class="dtb-icon-btn" data-dtb-trigger aria-haspopup="menu" aria-expanded="false" aria-label={dt('Help and resources')} title={dt('Help and resources')}>
        <Icon name="ph:question-fill" width="17" height="17" />
      </button>
      <div class="dtb-menu dtb-menu-help" role="menu">
        <div class="dtb-menu-head">
          <img src="/assets/mascot-icon.webp" alt="" width="22" height="22" />
          <span>Petto</span>
        </div>
        <div class="dtb-sep-line" role="separator"></div>
        <a role="menuitem" class="dtb-item" href="https://wiki.petto.sbs" target="_blank" rel="noopener">
          <span class="dtb-item-main"><Icon name="ph:book-open-fill" width="16" height="16" /><span>{dt('Documentation')}</span></span>
          <Icon name="ph:arrow-up-right" width="13" height="13" class="dtb-ext" />
        </a>
        <a role="menuitem" class="dtb-item" href="https://petto.sbs/support" target="_blank" rel="noopener">
          <span class="dtb-item-main"><Icon name="ph:headset-fill" width="16" height="16" /><span>{dt('Support server')}</span></span>
          <Icon name="ph:arrow-up-right" width="13" height="13" class="dtb-ext" />
        </a>
        <a role="menuitem" class="dtb-item" href={`${base}/commands`}>
          <span class="dtb-item-main"><Icon name="ph:terminal-window-fill" width="16" height="16" /><span>{dt('Commands')}</span></span>
        </a>
        <a role="menuitem" class="dtb-item" href={`${base}/changelog`}>
          <span class="dtb-item-main"><Icon name="ph:newspaper-fill" width="16" height="16" /><span>{dt('Changelog')}</span></span>
        </a>
        <a role="menuitem" class="dtb-item" href={`${base}/status`}>
          <span class="dtb-item-main"><Icon name="ph:pulse-fill" width="16" height="16" /><span>{dt('Status')}</span></span>
          <span class="dtb-status-dot" aria-hidden="true"></span>
        </a>
        <div class="dtb-sep-line" role="separator"></div>
        <a role="menuitem" class="dtb-item" href={`${base}/`}>
          <span class="dtb-item-main"><Icon name="ph:globe-fill" width="16" height="16" /><span>{dt('Back to home')}</span></span>
        </a>
      </div>
    </div>

    <button type="button" class="dtb-icon-btn" id="dtbThemeToggle" aria-label={dt('Toggle theme')} title={dt('Toggle theme')}>
      <Icon name="ph:sun-fill" width="16" height="16" class="dtb-theme-sun" />
      <Icon name="ph:moon-fill" width="16" height="16" class="dtb-theme-moon" />
    </button>

    <div class="dtb-pop" data-dtb-pop>
      <button type="button" class="dtb-icon-btn" data-dtb-trigger aria-haspopup="menu" aria-expanded="false" aria-label={dt('Account and settings')} title={dt('Account and settings')}>
        <Icon name="ph:gear-six-fill" width="16" height="16" />
      </button>
      <div class="dtb-menu dtb-menu-account" role="menu">
        <div class="dtb-acc-head">
          <span class="dtb-acc-av">
            {user.avatar
              ? <img src={user.avatar} alt="" width="28" height="28" referrerpolicy="no-referrer" />
              : <Icon name="ph:user-fill" width="15" height="15" />}
          </span>
          <span class="dtb-acc-name" title={user.username}>{user.username}</span>
        </div>
        <div class="dtb-sep-line" role="separator"></div>
        <a role="menuitem" class="dtb-item" href="/dash/me">
          <span class="dtb-item-main"><Icon name="ph:user-circle-fill" width="16" height="16" /><span>{dt('Your profile')}</span></span>
        </a>
        <a role="menuitem" class="dtb-item" href="/dash/manage">
          <span class="dtb-item-main"><Icon name="ph:squares-four-fill" width="16" height="16" /><span>{dt('Your servers')}</span></span>
        </a>
        <a role="menuitem" class="dtb-item" href="/dash/premium">
          <span class="dtb-item-main"><Icon name="ph:crown-fill" width="16" height="16" /><span>{dt('Manage premium')}</span></span>
        </a>
        <a role="menuitem" class="dtb-item" href="/dash/preferences">
          <span class="dtb-item-main"><Icon name="ph:sliders-horizontal-fill" width="16" height="16" /><span>{dt('Preferences')}</span></span>
        </a>
        <div class="dtb-sep-line" role="separator"></div>
        <a role="menuitem" class="dtb-item dtb-item-danger" href="/dash/logout">
          <span class="dtb-item-main"><Icon name="ph:sign-out-fill" width="16" height="16" /><span>{dt('Log out')}</span></span>
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    if (window.__pettoDashTopBar) return;
    window.__pettoDashTopBar = true;

    var pops = Array.prototype.slice.call(document.querySelectorAll('[data-dtb-pop]'));
    function closeAll(except) {
      pops.forEach(function (pop) {
        if (pop === except) return;
        pop.classList.remove('open');
        var btn = pop.querySelector('[data-dtb-trigger]');
        if (btn) btn.setAttribute('aria-expanded', 'false');
      });
    }

    pops.forEach(function (pop) {
      var trigger = pop.querySelector('[data-dtb-trigger]');
      var menu = pop.querySelector('.dtb-menu');
      if (!trigger || !menu) return;
      trigger.addEventListener('click', function (e) {
        e.stopPropagation();
        var next = !pop.classList.contains('open');
        closeAll(next ? pop : null);
        pop.classList.toggle('open', next);
        trigger.setAttribute('aria-expanded', String(next));
      });
      if (window.matchMedia && window.matchMedia('(hover: hover)').matches) {
        var timer = 0;
        pop.addEventListener('mouseenter', function () {
          clearTimeout(timer);
          if (pops.some(function (p) { return p !== pop && p.classList.contains('open'); })) {
            closeAll(pop);
            pop.classList.add('open');
            trigger.setAttribute('aria-expanded', 'true');
          }
        });
        pop.addEventListener('mouseleave', function () {
          clearTimeout(timer);
          timer = setTimeout(function () {
            if (pop.classList.contains('open') && !pop.contains(document.activeElement)) {
              pop.classList.remove('open');
              trigger.setAttribute('aria-expanded', 'false');
            }
          }, 180);
        });
      }
      menu.addEventListener('click', function (e) {
        var link = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (link) closeAll(null);
      });
    });

    document.addEventListener('click', function (e) {
      if (!(e.target instanceof Element) || !e.target.closest('[data-dtb-pop]')) closeAll(null);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeAll(null);
    });

    var themeBtn = document.getElementById('dtbThemeToggle');
    if (themeBtn) {
      themeBtn.addEventListener('click', function () {
        var root = document.documentElement;
        var cur = root.getAttribute('data-theme') || (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        var next = cur === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('petto-theme', next); } catch (err) {}
      });
    }

    // Account pages (DashMeLayout) do not load DashGuildLayout's palette script: give them the same instant finder over account pages & servers.
    if (!document.body.classList.contains('dash-body')) {
      var trigger = document.getElementById('dgl-find');
      var pal = null;
      var norm = function (t) { return String(t || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim(); };
      function openMeSearch() {
        if (!trigger) return;
        closeAll(null);
        if (!pal) {
          var veil = document.createElement('div');
          veil.className = 'dtb-pal-veil';
          veil.hidden = true;
          var box = document.createElement('div');
          box.className = 'dtb-pal';
          box.setAttribute('role', 'dialog');
          box.setAttribute('aria-modal', 'true');
          var field = document.createElement('div');
          field.className = 'dtb-pal-field';
          var input = document.createElement('input');
          input.type = 'text';
          input.autocomplete = 'off';
          input.spellcheck = false;
          input.placeholder = trigger.getAttribute('data-placeholder') || '';
          var esc = document.createElement('kbd');
          esc.textContent = 'Esc';
          field.appendChild(input);
          field.appendChild(esc);
          var list = document.createElement('div');
          list.className = 'dtb-pal-list';
          box.appendChild(field);
          box.appendChild(list);
          veil.appendChild(box);
          document.body.appendChild(veil);

          var entries = [];
          Array.prototype.forEach.call(document.querySelectorAll('.dme-link'), function (a) {
            entries.push({ href: a.getAttribute('href'), name: (a.textContent || '').trim(), group: '', active: a.classList.contains('active') });
          });
          Array.prototype.forEach.call(document.querySelectorAll('.ds-sheet a[href*="/dash/guild/"]'), function (a) {
            var strong = a.querySelector('strong');
            if (strong) entries.push({ href: a.getAttribute('href'), name: (strong.textContent || '').trim(), group: 'Server', active: false });
          });

          var shown = [];
          var idx = 0;
          var draw = function () {
            var q = norm(input.value);
            shown = entries.filter(function (it) { return !q || norm(it.name + ' ' + it.group).indexOf(q) !== -1; }).slice(0, 30);
            idx = Math.min(idx, Math.max(0, shown.length - 1));
            list.textContent = '';
            if (!shown.length) {
              var empty = document.createElement('div');
              empty.className = 'dtb-pal-empty';
              empty.textContent = trigger.getAttribute('data-empty') || '';
              list.appendChild(empty);
              return;
            }
            shown.forEach(function (it, i) {
              var row = document.createElement('a');
              row.href = it.href;
              row.className = 'dtb-pal-row' + (i === idx ? ' on' : '');
              var span = document.createElement('span');
              span.textContent = it.name;
              row.appendChild(span);
              if (it.group) {
                var small = document.createElement('small');
                small.textContent = it.group;
                row.appendChild(small);
              }
              list.appendChild(row);
            });
          };
          input.addEventListener('input', function () { idx = 0; draw(); });
          input.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
              e.preventDefault();
              if (!shown.length) return;
              idx = (idx + (e.key === 'ArrowDown' ? 1 : -1) + shown.length) % shown.length;
              draw();
            } else if (e.key === 'Enter') {
              e.preventDefault();
              if (shown[idx]) window.location.href = shown[idx].href;
            } else if (e.key === 'Escape') {
              e.preventDefault();
              veil.hidden = true;
            }
          });
          veil.addEventListener('mousedown', function (e) { if (e.target === veil) veil.hidden = true; });
          pal = { veil: veil, input: input, draw: draw };
        }
        pal.veil.hidden = false;
        pal.input.value = '';
        pal.draw();
        pal.input.focus({ preventScroll: true });
      }
      if (trigger) trigger.addEventListener('click', openMeSearch);
      document.addEventListener('keydown', function (e) {
        var typing = e.target && (/^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName) || e.target.isContentEditable);
        if ((e.ctrlKey || e.metaKey) && !e.shiftKey && !e.altKey && (e.key === 'k' || e.key === 'K')) {
          e.preventDefault();
          if (pal && !pal.veil.hidden) pal.veil.hidden = true; else openMeSearch();
        } else if (e.key === '/' && !typing && !e.ctrlKey && !e.metaKey && !e.altKey) {
          e.preventDefault();
          openMeSearch();
        }
      });
    }
  })();
</script>

<style>
  .dtb {
    position: sticky;
    top: 0;
    z-index: 45;
    flex: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(200px, 380px) minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    height: 56px;
    padding: 0 24px;
    background: var(--dgl-topbar-bg, var(--bg));
    border-bottom: 1px solid var(--border-soft);
  }

  .dtb-left {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .dtb-burger {
    display: none;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 36px;
    height: 36px;
    padding: 0;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--bg-raise);
    color: var(--text);
    cursor: pointer;
  }

  .dtb-ctx {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    max-width: 220px;
    padding: 5px 8px 5px 5px;
    border-radius: 9px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.16s ease, border-color 0.16s ease;
  }
  .dtb-ctx:hover {
    background: var(--card-hover);
    border-color: var(--border-soft);
  }
  .dtb-ctx-av {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--bg-raise);
  }
  .dtb-ctx-av.is-user {
    border-radius: 50%;
  }
  .dtb-ctx-av img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dtb-ctx-fallback {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
  }
  .dtb-ctx-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dtb-sep {
    flex: none;
    color: var(--text-dim);
  }

  .dtb-page {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .dtb-center {
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .dtb-search {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    height: 35px;
    padding: 0 10px 0 12px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--bg-raise);
    color: var(--text-dim);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: background-color 0.16s ease, border-color 0.16s ease, color 0.16s ease;
  }
  .dtb-search:hover {
    background: var(--card-hover);
    border-color: color-mix(in srgb, var(--text) 18%, var(--border));
    color: var(--text-muted);
  }
  .dtb-search-ic {
    flex: none;
    color: var(--text-dim);
  }
  .dtb-search-text {
    flex: 1;
    min-width: 0;
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dtb-search-kbd {
    flex: none;
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 5px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--text) 4%, transparent);
    color: var(--text-dim);
    font: 600 11px/1 var(--mono);
  }

  .dtb-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }

  .dtb-pop {
    position: relative;
  }

  .dtb-lang-btn,
  .dtb-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 34px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--bg-raise);
    color: var(--text-muted);
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.16s ease, border-color 0.16s ease, color 0.16s ease;
  }
  .dtb-lang-btn {
    padding: 0 11px;
    color: var(--text);
  }
  .dtb-icon-btn {
    width: 34px;
    padding: 0;
  }
  .dtb-lang-btn:hover,
  .dtb-icon-btn:hover,
  .dtb-pop.open > .dtb-lang-btn,
  .dtb-pop.open > .dtb-icon-btn {
    background: var(--card-hover);
    border-color: color-mix(in srgb, var(--text) 18%, var(--border));
    color: var(--text);
  }

  .dtb-flag {
    width: 19px;
    height: 13px;
    border-radius: 3px;
    object-fit: cover;
    flex: none;
    box-shadow: 0 0 0 1px rgba(128, 128, 128, 0.28);
  }
  .dtb-caret {
    flex: none;
    color: var(--text-dim);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .dtb-pop.open .dtb-caret {
    transform: rotate(180deg);
  }

  /* Theme icon swap: sun in dark mode (click to switch to light), moon in light mode. */
  .dtb-theme-moon { display: none; }
  :global(:root[data-theme="light"]) .dtb-theme-sun { display: none; }
  :global(:root[data-theme="light"]) .dtb-theme-moon { display: block; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme="dark"])) .dtb-theme-sun { display: none; }
    :global(:root:not([data-theme="dark"])) .dtb-theme-moon { display: block; }
  }

  /* Animated popovers matching the public bar's menus (smooth fade + rise + subtle scale). */
  .dtb-menu {
    position: absolute;
    top: calc(100% + 9px);
    right: 0;
    z-index: 95;
    min-width: 224px;
    padding: 6px;
    background: color-mix(in srgb, var(--card) 68%, transparent);
    -webkit-backdrop-filter: blur(24px) saturate(1.65);
    backdrop-filter: blur(24px) saturate(1.65);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    box-shadow: 0 20px 44px -14px rgba(0, 0, 0, 0.65), 0 1px 0 rgba(255, 255, 255, 0.08) inset;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(0.975);
    transform-origin: top right;
    pointer-events: none;
