  <script is:inline>
    // Inside the content, so it also runs when the page is reached from the menu (the dashboard runs the scripts of the content it
    // draws; a script after the layout only ran on a full load, and then the Lift button and the case search did nothing).
    // The listeners are on the document and bound once; what depends on the drawn page runs on every draw.
    (function () {
      if (!window.__mdCasesBound) {
        window.__mdCasesBound = true;
        // Typing filters the cases already on the page at once; Enter (or Search) asks the server, which searches every case.
        var filterRows = function (input) {
          var log = input.closest('[data-case-log]');
          if (!log) return;
          var q = (input.value || '').trim().toLowerCase();
          var local = q !== (input.defaultValue || '').trim().toLowerCase();
          var shown = 0;
          log.querySelectorAll('[data-case-list] .md-case-row').forEach(function (row) {
            var ok = !local || !q || (row.getAttribute('data-search') || '').indexOf(q) !== -1;
            row.hidden = !ok;
            if (ok) shown += 1;
          });
          var none = log.querySelector('[data-case-none]');
          if (none) none.hidden = shown !== 0;
          var hint = log.querySelector('[data-case-hint]');
          if (hint) hint.hidden = !local || !q;
        };
        document.addEventListener('input', function (event) {
          var target = event.target;
          if (target && target.matches && target.matches('[data-case-search]')) filterRows(target);
        });
        document.addEventListener('submit', function (event) {
          var form = event.target;
          if (!form || !form.matches || !form.matches('[data-case-tools]') || !window.dglNavigate) return;
          event.preventDefault();
          var params = new URLSearchParams(new FormData(form));
          if (!String(params.get('q') || '').trim()) params.delete('q');
          window.dglNavigate('?' + params.toString());
        });
        // The edit form of a case, put in its row from the template (one form on the page at a time). While it is open the
        // dashboard does not redraw the page for a live update (data-dash-hold), so what is typed stays.
        var closeEditor = function (form) {
          var row = form.closest('.md-case-row');
          var link = row && row.querySelector('[data-case-edit]');
          if (link) { link.classList.remove('on'); link.setAttribute('aria-expanded', 'false'); }
          form.remove();
        };
        var openEditor = function (row) {
          var log = row.closest('[data-case-log]');
          var template = log && log.querySelector('template[data-case-form-template]');
          if (!template) return false;
          log.querySelectorAll('[data-case-list] [data-case-form]').forEach(closeEditor);
          var number = row.getAttribute('data-case');
          var form = template.content.firstElementChild.cloneNode(true);
          form.querySelector('input[name=case]').value = number;
          var label = form.querySelector('[data-case-label]');
          label.textContent = label.getAttribute('data-case-label').replace('{n}', number);
          var area = form.querySelector('textarea');
          area.defaultValue = row.getAttribute('data-reason') || '';
          var del = form.querySelector('[data-case-confirm]');
          del.setAttribute('data-confirm', del.getAttribute('data-case-confirm').replace('{n}', number));
          row.appendChild(form);
          var link = row.querySelector('[data-case-edit]');
          if (link) { link.classList.add('on'); link.setAttribute('aria-expanded', 'true'); }
          if (window.dglInitContent) window.dglInitContent(row);
          if (window.__dfxKit) window.__dfxKit();
          area.focus();
          area.setSelectionRange(area.value.length, area.value.length);
          return true;
        };
        // Capture: these run before the dashboard's own handling of the links (which would load the page).
        document.addEventListener('click', function (event) {
          var target = event.target;
          if (!target || !target.closest || !target.closest('#dgl-content [data-case-log]')) return;
          var edit = target.closest('[data-case-edit]');
          if (edit) {
            var row = edit.closest('.md-case-row');
            var open = row && row.querySelector('[data-case-form]');
            if (open) { event.preventDefault(); event.stopPropagation(); closeEditor(open); return; }
            if (row && openEditor(row)) { event.preventDefault(); event.stopPropagation(); }
            return;
          }
          var close = target.closest('[data-case-edit-close]');
          if (close) {
            var form = close.closest('[data-case-form]');
            if (form) { event.preventDefault(); event.stopPropagation(); closeEditor(form); }
            return;
          }
          // A kind chosen while words are typed but not searched yet: the words go with it.
          var pill = target.closest('[data-case-pill]');
          if (pill) {
            var input = document.querySelector('#dgl-content [data-case-search]');
            if (input && input.value !== input.defaultValue) {
              var url = new URL(pill.getAttribute('href'), window.location.href);
              if (input.value.trim()) url.searchParams.set('q', input.value.trim()); else url.searchParams.delete('q');
              pill.setAttribute('href', url.search);
            }
          }
        }, true);
        document.addEventListener('click', function (event) {
          var target = event.target;
          // The Lift button of the active sanctions: the bot lifts it and the page is read again.
          var btn = target && target.closest ? target.closest('[data-lift]') : null;
          if (!btn) return;
          if (!window.confirm(btn.getAttribute('data-lift-confirm') || 'Lift this sanction now?')) return;
          var guild = window.location.pathname.split('/dash/guild/')[1].split('/')[0];
          var failed = btn.getAttribute('data-lift-error') || 'It could not be lifted.';
          var say = function (text) { if (window.dglToast) window.dglToast(text, { kind: 'error' }); else window.alert(text); };
          btn.disabled = true; btn.classList.add('dgl-busy');
          fetch('/dash/guild/' + guild + '/moderation-api', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ case: Number(btn.getAttribute('data-lift')) }) })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (data && data.ok) { if (window.dglRefreshPage) window.dglRefreshPage(true); else window.location.reload(); }
              else { say((data && data.message) || failed); btn.disabled = false; btn.classList.remove('dgl-busy'); }
            })
            .catch(function () { say(failed); btn.disabled = false; btn.classList.remove('dgl-busy'); });
        });
      }
      document.querySelectorAll('#dgl-content time[data-local-time]').forEach(function (t) {
        var d = new Date(t.getAttribute('datetime'));
        if (!isNaN(d.getTime())) t.textContent = d.toLocaleString();
      });
    })();
  </script>
</DashGuildLayout>

