---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MultiSelect from './MultiSelect.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface AutomodConfig {
  wordFilterEnabled: boolean;
  wordFilterAction: string;
  bannedWords: string[];
  antiSpamEnabled: boolean;
  maxMentions: number;
  antiRaidEnabled: boolean;
  raidJoinThreshold: number;
  raidWindowSeconds: number;
  raidAction: string;
  antiAltEnabled: boolean;
  antiAltMinAgeDays: number;
  antiAltAction: string;
  immuneRoleIds: string[];
  repeatThreshold: number;
  repeatWindow: number;
  capsPercent: number;
  capsMinLength: number;
  maxMessageLength: number;
  maxLines: number;
  exemptChannelIds: string[];
  spamRepeat: boolean;
  spamMentions: boolean;
  spamInvites: boolean;
  spamCaps: boolean;
  strikeLimit: number;
  strikeWindow: number;
  strikeMute: number;
}
interface AntinukeConfig {
  enabled: boolean;
  actionThreshold: number;
  windowSeconds: number;
  whitelistIds: string;
}
interface Case {
  caseNumber: number;
  type: string;
  userId: string;
  moderatorId: string;
  reason: string | null;
  active: boolean;
  createdAt: string;
  evidence?: string[];
}
interface ActiveSanction { caseNumber: number; type: string; userId: string; moderatorId: string; reason: string | null; createdAt: string; expiresAt: string | null; }
interface ModStats { total: number; automatic: number; byType: [string, number][]; moderators: { userId: string; count: number }[]; days: { label: string; count: number }[]; }
interface SilentChannel { channelId: string; name: string; action: string; }
interface EscalationRule { warnCount: number; action: string; durationMinutes: number | null; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  automod: AutomodConfig;
  antinuke: AntinukeConfig;
  cases: Case[];
  activeSanctions?: ActiveSanction[];
  modStats?: ModStats;
  people?: Record<string, { name: string; avatar: string }>;
  casesLimit?: number;
  stickyRolesEnabled: boolean;
  silentChannels: SilentChannel[];
  escalationRules: EscalationRule[];
  roles: { id: string; name: string }[];
  channels: { id: string; name: string }[];
  saved: boolean;
  sanctionTemplates: Record<string, { dm: string; reply: string; log: string }>;
  sanctionMessagesReady: boolean;
  embedTemplateNames: string[];
  section?: string;
}
const { user, guildId, guildName, guildIcon, automod, antinuke, stickyRolesEnabled, cases, activeSanctions = [], modStats = { total: 0, automatic: 0, byType: [], moderators: [], days: [] }, people = {}, casesLimit = 25, silentChannels, escalationRules, sanctionTemplates, sanctionMessagesReady, embedTemplateNames, roles, channels, saved, section } = Astro.props;

const typeColor: Record<string, string> = {
  ban: '#fe6465', tempban: '#fe6465', kick: '#ff9f5a', warn: '#fed53c',
  mute: '#c792ea', tempmute: '#c792ea', unban: '#a5ea7a', unmute: '#a5ea7a',
};
const sectionMeta: Record<string, string> = { protection: dt('Protection'), 'silent-channels': dt('Silent channels'), 'warn-escalation': dt('Warn escalation'), 'sanction-messages': dt('Sanction messages'), cases: dt('Case log'), active: dt('Active sanctions'), stats: dt('Moderator stats') };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'protection';
const selectedTitle = sectionMeta[selectedSection];
const showSection = (id: string) => selectedSection === id ? '' : 'md-section-hidden';
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'protection' ? 'moderation' : selectedSection === 'stats' ? 'mod-stats' : selectedSection === 'active' ? 'active-sanctions' : selectedSection} pageTitle={selectedTitle}>
  <h1>{selectedTitle}</h1>
  <p class="md-sub"><Fragment set:html={dth('Automatic protection for <b>{a}</b>, plus the case log every <code>/ban</code>, <code>/kick</code>, <code>/mute</code> and <code>/warn</code> writes to.', { a: (guildName) })} /></p>

  {saved && <div class="md-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}

  {selectedSection === 'protection' && (
  <form method="POST" class:list={['md-form', { 'md-section-hidden': selectedSection !== 'protection' }]} id="mdForm">
    <input type="hidden" name="action" value="config" />
    <div class="md-grid">
      <div class="md-card">
        <div class="md-card-head">
          <div class="md-card-icon" style="--c:#fe6465"><Icon name="ph:funnel-fill" width="16" height="16" /></div>
          <div class="md-card-title">{dt('Word filter')}</div>
          <label class="md-switch"><input type="checkbox" name="word_filter_enabled" checked={automod.wordFilterEnabled} /><span></span></label>
        </div>
        <p class="md-card-desc">{dt('Blocks messages containing banned words or phrases.')}</p>
        <div class="md-row">
          <label>{dt('Action')}</label>
          <select name="word_filter_action">
            {['warn', 'mute', 'kick', 'delete'].map((a) => <option value={a} selected={a === automod.wordFilterAction}>{a}</option>)}
          </select>
        </div>
        <div class="md-row">
          <label>{dt('Banned words')}</label>
          <textarea name="banned_words" rows="2" placeholder={dt('comma, separated, words')}>{automod.bannedWords.join(', ')}</textarea>
        </div>
        <div class="md-row">
          <label>{dt('Immune roles')}</label>
          <MultiSelect name="immune_role_ids" options={roles} selected={automod.immuneRoleIds} placeholder={dt('Search roles...')} />
          <p class="md-row-hint">{dt('Skips both the word filter and anti-spam entirely.')}</p>
        </div>
      </div>

      <div class="md-card">
        <div class="md-card-head">
          <div class="md-card-icon" style="--c:var(--accent)"><Icon name="ph:chats-fill" width="16" height="16" /></div>
          <div class="md-card-title">{dt('Anti-spam')}</div>
          <label class="md-switch"><input type="checkbox" name="anti_spam_enabled" checked={automod.antiSpamEnabled} /><span></span></label>
        </div>
        <p class="md-card-desc">{dt('Flags messages that mass-mention members.')}</p>
        <div class="md-row">
          <label>{dt('Max mentions per message')}</label>
          <input type="number" name="max_mentions" value={automod.maxMentions} min="1" max="50" />
        </div>
        <label class="md-check"><input type="checkbox" name="spam_repeat" checked={automod.spamRepeat} />{dt('Catch the same message again and again')}</label>
        <div class="md-row md-row-2">
          <div><label>{dt('Copies that count as a flood')}</label><input type="number" name="repeat_threshold" value={automod.repeatThreshold} min="2" max="20" /></div>
          <div><label>{dt('In how many seconds')}</label><input type="number" name="repeat_window_seconds" value={automod.repeatWindow} min="3" max="120" /></div>
        </div>
        <label class="md-check"><input type="checkbox" name="spam_mentions" checked={automod.spamMentions} />{dt('Catch mass mentions')}</label>
        <label class="md-check"><input type="checkbox" name="spam_invites" checked={automod.spamInvites} />{dt('Catch invites that are not on the allow-list')}</label>
        <label class="md-check"><input type="checkbox" name="spam_caps" checked={automod.spamCaps} />{dt('Catch shouting (capital letters)')}</label>
        <div class="md-row md-row-2">
          <div><label>{dt('Percent in capitals')}</label><input type="number" name="caps_percent" value={automod.capsPercent} min="30" max="100" /></div>
          <div><label>{dt('Shortest message checked')}</label><input type="number" name="caps_min_length" value={automod.capsMinLength} min="4" max="200" /></div>
        </div>
        <div class="md-row md-row-2">
          <div><label>{dt('Delete messages longer than (characters)')}</label><input type="number" name="max_message_length" value={automod.maxMessageLength} min="0" max="2000" /></div>
          <div><label>{dt('Delete messages with more lines than')}</label><input type="number" name="max_lines" value={automod.maxLines} min="0" max="100" /></div>
        </div>
        <p class="md-row-hint">{dt('0 turns a limit off. Long messages are only deleted, nobody is punished for them.')}</p>
        <div class="md-row">
          <label>{dt('Channels the automod never checks')}</label>
          <MultiSelect name="exempt_channel_ids" options={channels} selected={automod.exemptChannelIds} placeholder={dt('Search channels...')} />
        </div>
      </div>

      <div class="md-card">
        <div class="md-card-head">
          <div class="md-card-icon" style="--c:#ff6b6b"><Icon name="ph:warning-fill" width="16" height="16" /></div>
          <div class="md-card-title">{dt('Strikes')}</div>
        </div>
        <p class="md-card-desc">{dt('Mutes a member who breaks the automod again and again, on top of what each rule does.')}</p>
        <div class="md-row md-row-2">
          <div><label>{dt('Violations that trigger the mute (0 for off)')}</label><input type="number" name="strike_limit" value={automod.strikeLimit} min="0" max="20" /></div>
          <div><label>{dt('In how many minutes')}</label><input type="number" name="strike_window_minutes" value={automod.strikeWindow} min="1" max="1440" /></div>
        </div>
        <div class="md-row"><label>{dt('Minutes of mute')}</label><input type="number" name="strike_mute_minutes" value={automod.strikeMute} min="1" max="40320" /></div>
      </div>

      <div class="md-card">
        <div class="md-card-head">
          <div class="md-card-icon" style="--c:#ff9f5a"><Icon name="ph:users-three-fill" width="16" height="16" /></div>
          <div class="md-card-title">{dt('Anti-raid')}</div>
          <label class="md-switch"><input type="checkbox" name="anti_raid_enabled" checked={automod.antiRaidEnabled} /><span></span></label>
        </div>
        <p class="md-card-desc">{dt('Reacts when too many members join in a short burst.')}</p>
        <div class="md-row">
          <label>{dt('Join threshold')}</label>
          <input type="number" name="raid_join_threshold" value={automod.raidJoinThreshold} min="2" max="50" />
        </div>
        <div class="md-row">
          <label>{dt('Window (seconds)')}</label>
          <input type="number" name="raid_window_seconds" value={automod.raidWindowSeconds} min="5" max="120" />
        </div>
        <div class="md-row">
          <label>{dt('Action')}</label>
          <select name="raid_action">
            {['alert', 'kick', 'lockdown'].map((a) => <option value={a} selected={a === automod.raidAction}>{a}</option>)}
          </select>
        </div>
      </div>

      <div class="md-card">
        <div class="md-card-head">
          <div class="md-card-icon" style="--c:#5eead4"><Icon name="ph:identification-badge-fill" width="16" height="16" /></div>
          <div class="md-card-title">{dt('Anti-alt')}</div>
          <label class="md-switch"><input type="checkbox" name="anti_alt_enabled" checked={automod.antiAltEnabled} /><span></span></label>
        </div>
        <p class="md-card-desc">{dt('Flags accounts newer than a minimum age on join.')}</p>
        <div class="md-row">
          <label>{dt('Minimum account age (days)')}</label>
          <input type="number" name="anti_alt_min_age_days" value={automod.antiAltMinAgeDays} min="0" max="365" />
        </div>
        <div class="md-row">
          <label>{dt('Action')}</label>
          <select name="anti_alt_action">
            {['kick', 'flag'].map((a) => <option value={a} selected={a === automod.antiAltAction}>{a}</option>)}
          </select>
        </div>
      </div>

      <a class="md-card md-card-link" href={`/dash/guild/${guildId}/antinuke`}>
        <div class="md-card-head">
          <div class="md-card-icon" style="--c:#f78fb3"><Icon name="ph:siren-fill" width="16" height="16" /></div>
          <div class="md-card-title">{dt('Anti-raid & nuke')}</div>
        </div>
        <p class="md-card-desc">{dt('Each protection (bans, channels, roles, bots, webhooks...) now has its own page with its own limit, action, trusted accounts and a log to restore what was stopped.')}</p>
      </a>

      <a class="md-card md-card-link" href={`/dash/guild/${guildId}/automod`}>
        <div class="md-card-head">
          <div class="md-card-icon" style="--c:#ffb86c"><Icon name="ph:funnel-fill" width="16" height="16" /></div>
          <div class="md-card-title">{dt('AutoMod templates')}</div>
        </div>
        <p class="md-card-desc">{dt('Ready filters for links, invites, emojis, zalgo, scams and more, in Discord AutoMod or in Petto, with packs.')}</p>
      </a>

      <div class="md-card">
        <div class="md-card-head">
          <div class="md-card-icon" style="--c:#a5ea7a"><Icon name="ph:link-fill" width="16" height="16" /></div>
          <div class="md-card-title">{dt('Sticky roles')}</div>
          <label class="md-switch"><input type="checkbox" name="sticky_roles_enabled" checked={stickyRolesEnabled} /><span></span></label>
        </div>
        <p class="md-card-desc">{dt('If a member leaves and rejoins within 90 days, their roles (except managed ones, e.g. booster/bot roles) are automatically restored.')}</p>
      </div>
    </div>
  </form>
  )}

  {selectedSection === 'silent-channels' && (
  <div class:list={['md-section', showSection('silent-channels')]}>
    <h2><Fragment set:html={dth('Silent channels <span class="md-count">{a}</span>', { a: (silentChannels.length) })} /></h2>
    <p class="md-section-note">{dt('Any message here counts as a violation, independent of the word filter or anti-spam toggles.')}</p>
    <div class="md-list-grid">
      {silentChannels.map((s) => (
        <form method="POST" class="md-list-row">
          <input type="hidden" name="action" value="delete_silent_channel" />
          <input type="hidden" name="channel_id" value={s.channelId} />
          <span class="md-list-name">#{s.name}</span>
          <span class="md-list-tag">{s.action}</span>
          <button type="submit" class="md-list-del"><Icon name="ph:trash-fill" width="13" height="13" /></button>
        </form>
      ))}
    </div>
    <form method="POST" class="md-add-row">
      <input type="hidden" name="action" value="add_silent_channel" />
      <select name="channel_id" required>
        <option value="" disabled selected>{dt('Channel')}</option>
        {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
      </select>
      <select name="silent_action">
        {['warn', 'mute', 'kick'].map((act) => <option value={act}>{act}</option>)}
      </select>
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button>
    </form>
  </div>
  )}

  {selectedSection === 'warn-escalation' && (
  <div class:list={['md-section', showSection('warn-escalation')]}>
    <h2><Fragment set:html={dth('Warn escalation <span class="md-count">{a}</span>', { a: (escalationRules.length) })} /></h2>
    <p class="md-section-note">{dt('At warning #N, automatically take an action, checked against the member\'s live active-warn count.')}</p>
    <div class="md-list-grid">
      {escalationRules.map((r) => (
        <form method="POST" class="md-list-row">
          <input type="hidden" name="action" value="delete_escalation" />
          <input type="hidden" name="warn_count" value={r.warnCount} />
          <span class="md-list-name">{dt('Warn #{a}', { a: (r.warnCount) })}</span>
          <span class="md-list-tag">{r.action}{r.durationMinutes ? ` (${r.durationMinutes}m)` : ''}</span>
          <button type="submit" class="md-list-del"><Icon name="ph:trash-fill" width="13" height="13" /></button>
        </form>
      ))}
    </div>
    <form method="POST" class="md-add-row">
      <input type="hidden" name="action" value="add_escalation" />
      <input type="number" name="warn_count" placeholder={dt('Warn #')} min="1" max="50" required />
      <select name="esc_action">
        {['mute', 'tempmute', 'kick', 'ban'].map((act) => <option value={act}>{act}</option>)}
      </select>
      <input type="number" name="duration_minutes" placeholder={dt('Minutes (temp only)')} min="0" />
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button>
    </form>
  </div>
  )}

  {selectedSection === 'sanction-messages' && (
  <div class:list={['md-section', showSection('sanction-messages')]}>
    <h2>{dt('Sanction messages')}</h2>
    <p class="md-section-note">{dt('Use a saved design from the Embeds page for what a member receives, what is posted where the command was used, and the log entry. A type without its own design uses the Default row. Variables start with {case.…}, for example {case.reason} and {case.moderator}.')}</p>
    {!sanctionMessagesReady && <p class="md-empty-note">{dt('This arrives with the next Petto update.')}</p>}
    {sanctionMessagesReady && (
      <form method="POST" class="md-msg-form">
        <input type="hidden" name="action" value="save_sanction_messages" />
        <div class="md-msg-grid">
          <span class="md-msg-head"></span>
          <span class="md-msg-head">{dt('DM to the member')}</span>
          <span class="md-msg-head">{dt('Reply in the channel')}</span>
          <span class="md-msg-head">{dt('Sanctions log')}</span>
          {['default', 'ban', 'tempban', 'softban', 'unban', 'kick', 'mute', 'tempmute', 'unmute', 'warn', 'jail', 'unjail'].map((type) => (
            <>
              <span class="md-msg-type">{type}</span>
              {(['dm', 'reply', 'log'] as const).map((slot) => (
                <select name={`${type}__${slot}`} aria-label={`${type} ${slot}`}>
                  <option value="" selected={!sanctionTemplates[type]?.[slot]}>{type === 'default' ? dt('Usual message') : dt('Same as default')}</option>
                  {embedTemplateNames.map((name) => <option value={name} selected={name === sanctionTemplates[type]?.[slot]}>{name}</option>)}
                </select>
              ))}
            </>
          ))}
        </div>
        <button type="submit" class="btn btn-accent btn-sm">{dt('Save changes')}</button>
      </form>
    )}
  </div>
  )}

  {selectedSection === 'active' && (
  <div class:list={['md-section', showSection('active')]}>
    <h2><Fragment set:html={dth('Active sanctions <span class="md-count">{a}</span>', { a: (activeSanctions.length) })} /></h2>
    <p class="md-sub">{dt('Bans, mutes and jails that are on right now. Lift one here and the bot does it, writing the case of the lifting.')}</p>
    {activeSanctions.length === 0 ? <p class="md-empty-note">{dt('Nothing is active right now.')}</p> : (
      <div class="md-case-list">
        {activeSanctions.map((c) => (
          <div class="md-case-row">
            <span class="md-case-num">#{c.caseNumber}</span>
            <span class="md-case-type" style={`--c:${typeColor[c.type] ?? '#94a3b8'}`}>{c.type}</span>
            <span class="md-case-person">
              {people[c.userId] ? <img src={people[c.userId].avatar} alt="" width="20" height="20" loading="lazy" /> : null}
              <span><b>{people[c.userId]?.name ?? c.userId}</b><code>{c.userId}</code></span>
            </span>
            <span class="md-case-by">{dt('by')} {people[c.moderatorId]?.name ?? c.moderatorId}</span>
            {c.expiresAt ? <time class="md-case-when" datetime={c.expiresAt} data-local-time>{c.expiresAt}</time> : <span class="md-case-when">{dt('No end')}</span>}
            {c.reason && <span class="md-case-reason">{c.reason}</span>}
            {c.type === 'hardban'
              ? <span class="md-case-inactive">{dt('Only the owner can lift it')}</span>
              : <button type="button" class="btn btn-ghost btn-sm md-lift" data-lift={c.caseNumber}>{dt('Lift')}</button>}
          </div>
        ))}
      </div>
    )}
  </div>
  )}

  {selectedSection === 'stats' && (
  <div class:list={['md-section', showSection('stats')]}>
    <h2>{dt('Moderator stats')} <span class="md-count">{dt('last 30 days')}</span></h2>
    <div class="md-stat-strip">
      <div><b>{modStats.total}</b><span>{dt('Cases')}</span></div>
      <div><b>{modStats.total - modStats.automatic}</b><span>{dt('By moderators')}</span></div>
      <div><b>{modStats.automatic}</b><span>{dt('By the bot (automatic)')}</span></div>
    </div>
    <div class="md-bars" aria-label={dt('Cases in the last 14 days')}>
      {modStats.days.map((d) => <div class="md-bar" title={`${d.label}: ${d.count}`}><i style={`height:${Math.max(4, d.count / Math.max(1, ...modStats.days.map((x) => x.count)) * 100)}%`}></i><span>{d.label.slice(3)}</span></div>)}
    </div>
    <div class="md-stat-cols">
      <div>
        <h3>{dt('By kind')}</h3>
        {modStats.byType.length === 0 ? <p class="md-empty-note">{dt('Nothing yet.')}</p> : modStats.byType.map(([type, count]) => <div class="md-stat-line"><span class="md-case-type" style={`--c:${typeColor[type] ?? '#94a3b8'}`}>{type}</span><b>{count}</b></div>)}
      </div>
      <div>
        <h3>{dt('Moderators')}</h3>
        {modStats.moderators.length === 0 ? <p class="md-empty-note">{dt('Nothing yet.')}</p> : modStats.moderators.map((m) => <div class="md-stat-line"><span class="md-case-person">{people[m.userId] ? <img src={people[m.userId].avatar} alt="" width="20" height="20" loading="lazy" /> : null}<b>{people[m.userId]?.name ?? m.userId}</b></span><b>{m.count}</b></div>)}
      </div>
    </div>
  </div>
  )}

  {selectedSection === 'cases' && (
  <div class:list={['md-section', showSection('cases')]}>
    <h2><Fragment set:html={dth('Recent cases <span class="md-count">{a}</span>', { a: (cases.length) })} /></h2>
    {cases.length === 0 ? (
      <p class="md-empty-note"><Fragment set:html={dth('No cases yet. They show up here the moment a mod uses <code>/ban</code>, <code>/kick</code>, <code>/mute</code> or <code>/warn</code>.')} /></p>
    ) : (
      <>
        <div class="md-case-tools" data-case-tools>
          <input type="search" class="md-case-search" placeholder={dt('Search by member, moderator, reason or case number')} autocomplete="off" data-case-search />
          <div class="md-case-types">
            <button type="button" class="md-case-pill on" data-case-type="">{dt('All')}</button>
            {[...new Set(cases.map((c) => c.type))].map((type) => <button type="button" class="md-case-pill" data-case-type={type} style={`--c:${typeColor[type] ?? '#94a3b8'}`}>{type}</button>)}
          </div>
        </div>
        <div class="md-case-list" data-case-list>
          {cases.map((c) => (
            <div class="md-case-row" data-type={c.type} data-search={`${c.caseNumber} ${c.type} ${c.userId} ${c.moderatorId} ${people[c.userId]?.name ?? ''} ${people[c.moderatorId]?.name ?? ''} ${c.reason ?? ''}`.toLowerCase()}>
              <span class="md-case-num">#{c.caseNumber}</span>
              <span class="md-case-type" style={`--c:${typeColor[c.type] ?? '#94a3b8'}`}>{c.type}</span>
              <span class="md-case-person">
                {people[c.userId] ? <img src={people[c.userId].avatar} alt="" width="20" height="20" loading="lazy" /> : null}
                <span><b>{people[c.userId]?.name ?? c.userId}</b><code>{c.userId}</code></span>
              </span>
              <span class="md-case-by">{dt('by')} {people[c.moderatorId]?.name ?? c.moderatorId}</span>
              <time class="md-case-when" datetime={c.createdAt} data-local-time>{c.createdAt}</time>
              {c.reason && <span class="md-case-reason">{c.reason}</span>}
              {(c.evidence ?? []).length > 0 && <span class="md-case-evidence">{dt('Proof')}: {(c.evidence ?? []).map((url, i) => <a href={url} target="_blank" rel="noopener noreferrer">{i + 1}</a>)}</span>}
              {!c.active && <span class="md-case-inactive">{dt('expired')}</span>}
            </div>
          ))}
        </div>
        <p class="md-case-none" data-case-none hidden>{dt('No case matches that.')}</p>
        {cases.length >= casesLimit && casesLimit < 200 && <a class="btn btn-ghost btn-sm md-case-more" href={`?section=cases&cases=${casesLimit === 25 ? 50 : casesLimit === 50 ? 100 : 200}`}>{dt('Show more cases')}</a>}
      </>
    )}
  </div>
  )}

  {selectedSection === 'protection' && <button type="submit" form="mdForm" class="btn btn-accent btn-sm">{dt('Save changes')}</button>}
</DashGuildLayout>

<script is:inline>
  // The Lift button of the active sanctions: the bot lifts it and the page is read again.
  if (!window.__mdLiftBound) {
    window.__mdLiftBound = true;
    document.addEventListener('click', function (event) {
      var btn = event.target.closest && event.target.closest('[data-lift]');
      if (!btn) return;
      if (!confirm('Lift this sanction now?')) return;
      var guild = location.pathname.split('/')[3];
      btn.disabled = true;
      fetch('/dash/guild/' + guild + '/moderation-api', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ case: Number(btn.getAttribute('data-lift')) }) })
        .then(function (r) { return r.json(); })
        .then(function (data) { if (data && data.ok) location.reload(); else { alert((data && data.message) || 'It could not be lifted.'); btn.disabled = false; } })
        .catch(function () { alert('It could not be lifted.'); btn.disabled = false; });
    });
  }
</script>

<script is:inline>
  (function () {
    function apply() {
      var tools = document.querySelector('[data-case-tools]');
      if (!tools) return;
      var q = (tools.querySelector('[data-case-search]').value || '').trim().toLowerCase();
      var active = tools.querySelector('.md-case-pill.on');
      var type = active ? active.getAttribute('data-case-type') : '';
      var shown = 0;
      document.querySelectorAll('[data-case-list] .md-case-row').forEach(function (row) {
        var ok = (!type || row.getAttribute('data-type') === type) && (!q || (row.getAttribute('data-search') || '').indexOf(q) !== -1);
        row.hidden = !ok;
        if (ok) shown += 1;
      });
      var none = document.querySelector('[data-case-none]');
      if (none) none.hidden = shown !== 0;
    }
    if (!window.__caseToolsBound) {
      window.__caseToolsBound = true;
      document.addEventListener('input', function (event) { if (event.target && event.target.matches && event.target.matches('[data-case-search]')) apply(); });
      document.addEventListener('click', function (event) {
        var pill = event.target && event.target.closest ? event.target.closest('.md-case-pill') : null;
        if (!pill) return;
        pill.parentNode.querySelectorAll('.md-case-pill').forEach(function (other) { other.classList.remove('on'); });
        pill.classList.add('on');
        apply();
      });
    }
    document.querySelectorAll('time[data-local-time]').forEach(function (t) { var d = new Date(t.getAttribute('datetime')); if (!isNaN(d.getTime())) t.textContent = d.toLocaleString(); });
  })();
</script>

