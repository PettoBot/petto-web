---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MultiSelect from './MultiSelect.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface AutomodConfig {
  wordFilterEnabled: boolean;
  wordFilterAction: string;
  bannedWords: string[];
  antiSpamEnabled: boolean;
  maxMentions: number;
  antiRaidEnabled: boolean;
  raidJoinThreshold: number;
  raidWindowSeconds: number;
  raidAction: string;
  antiAltEnabled: boolean;
  antiAltMinAgeDays: number;
  antiAltAction: string;
  immuneRoleIds: string[];
}
interface AntinukeConfig {
  enabled: boolean;
  actionThreshold: number;
  windowSeconds: number;
  whitelistIds: string;
}
interface Case {
  caseNumber: number;
  type: string;
  userId: string;
  moderatorId: string;
  reason: string | null;
  active: boolean;
  createdAt: string;
}
interface SilentChannel { channelId: string; name: string; action: string; }
interface EscalationRule { warnCount: number; action: string; durationMinutes: number | null; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  automod: AutomodConfig;
  antinuke: AntinukeConfig;
  cases: Case[];
  stickyRolesEnabled: boolean;
  silentChannels: SilentChannel[];
  escalationRules: EscalationRule[];
  roles: { id: string; name: string }[];
  channels: { id: string; name: string }[];
  saved: boolean;
  section?: string;
}
const { user, guildId, guildName, guildIcon, automod, antinuke, stickyRolesEnabled, cases, silentChannels, escalationRules, roles, channels, saved, section } = Astro.props;

const typeColor: Record<string, string> = {
  ban: '#fe6465', tempban: '#fe6465', kick: '#ff9f5a', warn: '#fed53c',
  mute: '#c792ea', tempmute: '#c792ea', unban: '#a5ea7a', unmute: '#a5ea7a',
};
const sectionMeta: Record<string, string> = { protection: dt('Protection'), 'silent-channels': dt('Silent channels'), 'warn-escalation': dt('Warn escalation'), cases: dt('Case log') };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'protection';
const selectedTitle = sectionMeta[selectedSection];
const showSection = (id: string) => selectedSection === id ? '' : 'md-section-hidden';
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'protection' ? 'moderation' : selectedSection} pageTitle={selectedTitle}>
  <h1>{selectedTitle}</h1>
  <p class="md-sub"><Fragment set:html={dth('Automatic protection for <b>{a}</b>, plus the case log every <code>/ban</code>, <code>/kick</code>, <code>/mute</code> and <code>/warn</code> writes to.', { a: (guildName) })} /></p>

  {saved && <div class="md-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}

  <form method="POST" class:list={['md-form', { 'md-section-hidden': selectedSection !== 'protection' }]} id="mdForm">
    <input type="hidden" name="action" value="config" />
    <div class="md-grid">
      <div class="md-card">
        <div class="md-card-head">
          <div class="md-card-icon" style="--c:#fe6465"><Icon name="ph:funnel-fill" width="16" height="16" /></div>
          <div class="md-card-title">{dt('Word filter')}</div>
          <label class="md-switch"><input type="checkbox" name="word_filter_enabled" checked={automod.wordFilterEnabled} /><span></span></label>
        </div>
        <p class="md-card-desc">{dt('Blocks messages containing banned words or phrases.')}</p>
        <div class="md-row">
          <label>{dt('Action')}</label>
          <select name="word_filter_action">
            {['warn', 'mute', 'kick', 'delete'].map((a) => <option value={a} selected={a === automod.wordFilterAction}>{a}</option>)}
          </select>
        </div>
        <div class="md-row">
          <label>{dt('Banned words')}</label>
          <textarea name="banned_words" rows="2" placeholder={dt('comma, separated, words')}>{automod.bannedWords.join(', ')}</textarea>
        </div>
        <div class="md-row">
          <label>{dt('Immune roles')}</label>
          <MultiSelect name="immune_role_ids" options={roles} selected={automod.immuneRoleIds} placeholder={dt('Search roles...')} />
          <p class="md-row-hint">{dt('Skips both the word filter and anti-spam entirely.')}</p>
        </div>
      </div>

      <div class="md-card">
        <div class="md-card-head">
          <div class="md-card-icon" style="--c:#8399ff"><Icon name="ph:chats-fill" width="16" height="16" /></div>
          <div class="md-card-title">{dt('Anti-spam')}</div>
          <label class="md-switch"><input type="checkbox" name="anti_spam_enabled" checked={automod.antiSpamEnabled} /><span></span></label>
        </div>
        <p class="md-card-desc">{dt('Flags messages that mass-mention members.')}</p>
        <div class="md-row">
          <label>{dt('Max mentions per message')}</label>
          <input type="number" name="max_mentions" value={automod.maxMentions} min="1" max="50" />
        </div>
      </div>

      <div class="md-card">
        <div class="md-card-head">
          <div class="md-card-icon" style="--c:#ff9f5a"><Icon name="ph:users-three-fill" width="16" height="16" /></div>
          <div class="md-card-title">{dt('Anti-raid')}</div>
          <label class="md-switch"><input type="checkbox" name="anti_raid_enabled" checked={automod.antiRaidEnabled} /><span></span></label>
        </div>
        <p class="md-card-desc">{dt('Reacts when too many members join in a short burst.')}</p>
        <div class="md-row">
          <label>{dt('Join threshold')}</label>
          <input type="number" name="raid_join_threshold" value={automod.raidJoinThreshold} min="2" max="50" />
        </div>
        <div class="md-row">
          <label>{dt('Window (seconds)')}</label>
          <input type="number" name="raid_window_seconds" value={automod.raidWindowSeconds} min="5" max="120" />
        </div>
        <div class="md-row">
          <label>{dt('Action')}</label>
          <select name="raid_action">
            {['alert', 'kick'].map((a) => <option value={a} selected={a === automod.raidAction}>{a}</option>)}
          </select>
        </div>
      </div>

      <div class="md-card">
        <div class="md-card-head">
          <div class="md-card-icon" style="--c:#5eead4"><Icon name="ph:identification-badge-fill" width="16" height="16" /></div>
          <div class="md-card-title">{dt('Anti-alt')}</div>
          <label class="md-switch"><input type="checkbox" name="anti_alt_enabled" checked={automod.antiAltEnabled} /><span></span></label>
        </div>
        <p class="md-card-desc">{dt('Flags accounts newer than a minimum age on join.')}</p>
        <div class="md-row">
          <label>{dt('Minimum account age (days)')}</label>
          <input type="number" name="anti_alt_min_age_days" value={automod.antiAltMinAgeDays} min="0" max="365" />
        </div>
        <div class="md-row">
          <label>{dt('Action')}</label>
          <select name="anti_alt_action">
            {['kick', 'flag'].map((a) => <option value={a} selected={a === automod.antiAltAction}>{a}</option>)}
          </select>
        </div>
      </div>

      <div class="md-card">
        <div class="md-card-head">
          <div class="md-card-icon" style="--c:#f78fb3"><Icon name="ph:siren-fill" width="16" height="16" /></div>
          <div class="md-card-title">{dt('Anti-nuke')}</div>
          <label class="md-switch"><input type="checkbox" name="antinuke_enabled" checked={antinuke.enabled} /><span></span></label>
        </div>
        <p class="md-card-desc">{dt('Quarantines whoever bans, kicks, or deletes channels in a burst, most likely a compromised account.')}</p>
        <div class="md-row">
          <label>{dt('Action threshold')}</label>
          <input type="number" name="antinuke_action_threshold" value={antinuke.actionThreshold} min="2" max="30" />
        </div>
        <div class="md-row">
          <label>{dt('Window (seconds)')}</label>
          <input type="number" name="antinuke_window_seconds" value={antinuke.windowSeconds} min="5" max="120" />
        </div>
        <div class="md-row">
          <label>{dt('Whitelisted IDs')}</label>
          <input type="text" name="whitelist_ids" value={antinuke.whitelistIds} placeholder={dt('user or bot IDs, comma separated')} />
          <p class="md-row-hint">{dt('Never auto-actioned, even if they trip the threshold. The server owner is always exempt too.')}</p>
        </div>
      </div>

      <div class="md-card">
        <div class="md-card-head">
          <div class="md-card-icon" style="--c:#a5ea7a"><Icon name="ph:link-fill" width="16" height="16" /></div>
          <div class="md-card-title">{dt('Sticky roles')}</div>
          <label class="md-switch"><input type="checkbox" name="sticky_roles_enabled" checked={stickyRolesEnabled} /><span></span></label>
        </div>
        <p class="md-card-desc">{dt('If a member leaves and rejoins within 90 days, their roles (except managed ones, e.g. booster/bot roles) are automatically restored.')}</p>
      </div>
    </div>
  </form>

  <div class:list={['md-section', showSection('silent-channels')]}>
    <h2><Fragment set:html={dth('Silent channels <span class="md-count">{a}</span>', { a: (silentChannels.length) })} /></h2>
    <p class="md-section-note">{dt('Any message here counts as a violation, independent of the word filter or anti-spam toggles.')}</p>
    <div class="md-list-grid">
      {silentChannels.map((s) => (
        <form method="POST" class="md-list-row">
          <input type="hidden" name="action" value="delete_silent_channel" />
          <input type="hidden" name="channel_id" value={s.channelId} />
          <span class="md-list-name">#{s.name}</span>
          <span class="md-list-tag">{s.action}</span>
          <button type="submit" class="md-list-del"><Icon name="ph:trash-fill" width="13" height="13" /></button>
        </form>
      ))}
    </div>
    <form method="POST" class="md-add-row">
      <input type="hidden" name="action" value="add_silent_channel" />
      <select name="channel_id" required>
        <option value="" disabled selected>{dt('Channel')}</option>
        {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
      </select>
      <select name="silent_action">
        {['warn', 'mute', 'kick'].map((act) => <option value={act}>{act}</option>)}
      </select>
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button>
    </form>
  </div>

  <div class:list={['md-section', showSection('warn-escalation')]}>
    <h2><Fragment set:html={dth('Warn escalation <span class="md-count">{a}</span>', { a: (escalationRules.length) })} /></h2>
    <p class="md-section-note">{dt('At warning #N, automatically take an action, checked against the member\'s live active-warn count.')}</p>
    <div class="md-list-grid">
      {escalationRules.map((r) => (
        <form method="POST" class="md-list-row">
          <input type="hidden" name="action" value="delete_escalation" />
          <input type="hidden" name="warn_count" value={r.warnCount} />
          <span class="md-list-name">{dt('Warn #{a}', { a: (r.warnCount) })}</span>
          <span class="md-list-tag">{r.action}{r.durationMinutes ? ` (${r.durationMinutes}m)` : ''}</span>
          <button type="submit" class="md-list-del"><Icon name="ph:trash-fill" width="13" height="13" /></button>
        </form>
      ))}
    </div>
    <form method="POST" class="md-add-row">
      <input type="hidden" name="action" value="add_escalation" />
      <input type="number" name="warn_count" placeholder={dt('Warn #')} min="1" max="50" required />
      <select name="esc_action">
        {['mute', 'tempmute', 'kick', 'ban'].map((act) => <option value={act}>{act}</option>)}
      </select>
      <input type="number" name="duration_minutes" placeholder={dt('Minutes (temp only)')} min="0" />
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button>
    </form>
  </div>

  <div class:list={['md-section', showSection('cases')]}>
    <h2><Fragment set:html={dth('Recent cases <span class="md-count">{a}</span>', { a: (cases.length) })} /></h2>
    {cases.length === 0 ? (
      <p class="md-empty-note"><Fragment set:html={dth('No cases yet. They show up here the moment a mod uses <code>/ban</code>, <code>/kick</code>, <code>/mute</code> or <code>/warn</code>.')} /></p>
    ) : (
      <div class="md-case-list">
        {cases.map((c) => (
          <div class="md-case-row">
            <span class="md-case-num">#{c.caseNumber}</span>
            <span class="md-case-type" style={`--c:${typeColor[c.type] ?? '#94a3b8'}`}>{c.type}</span>
            <span class="md-case-user">on <code>{c.userId}</code></span>
            <span class="md-case-mod">by <code>{c.moderatorId}</code></span>
            {c.reason && <span class="md-case-reason">{c.reason}</span>}
            {!c.active && <span class="md-case-inactive">expired</span>}
          </div>
        ))}
      </div>
    )}
  </div>

  <button type="submit" form="mdForm" class="btn btn-accent btn-sm">{dt('Save changes')}</button>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  h2 { font-size: 14.5px; margin: 0 0 14px; }
  .md-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 24px; max-width: 68ch; }
  .md-sub :global(b){ color: var(--text); }
  .md-sub :global(code){ font-family: var(--mono); color: var(--accent); }

  .md-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 20px; max-width: fit-content; }

  .md-form { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; margin-bottom: 40px; }
  .md-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; width: 100%; }
  .md-card { border: 1px solid var(--border); border-radius: 13px; padding: 15px; background: var(--card); display: flex; flex-direction: column; gap: 11px; }
  .md-card-head { display: flex; align-items: center; gap: 10px; }
  .md-card-icon { width: 30px; height: 30px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: color-mix(in srgb, var(--c) 16%, transparent); color: var(--c); }
  .md-card-title { flex: 1; font-size: 13.5px; font-weight: 600; color: var(--text); }
  .md-card-desc { font-size: 12px; color: var(--text-dim); line-height: 1.5; margin: 0; }

  .md-row { display: flex; flex-direction: column; gap: 5px; }
  .md-row label { font-size: 11px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.04em; }
  .md-row input, .md-row select, .md-row textarea { width: 100%; box-sizing: border-box; border: 1px solid var(--border); border-radius: 8px; padding: 7px 9px; background: var(--bg-raise); color: var(--text); font-family: var(--sans); font-size: 13px; resize: vertical; }
  .md-row-hint { font-size: 11px; color: var(--text-dim); margin: 0; line-height: 1.4; }

  .md-role-list { border: 1px solid var(--border); border-radius: 8px; background: var(--bg-raise); max-height: 130px; overflow-y: auto; padding: 4px; display: flex; flex-direction: column; }
  .md-role-item { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 8px; padding: 5px 7px; border-radius: 6px; font-size: 12.5px; color: var(--text-muted); cursor: pointer; }
  .md-role-item:hover { background: var(--card-hover); color: var(--text); }
  .md-role-item input { flex-shrink: 0; accent-color: var(--accent); }
  .md-role-item :global(span){ overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .md-switch { position: relative; display: inline-block; width: 34px; height: 20px; flex-shrink: 0; }
  .md-switch input { opacity: 0; width: 0; height: 0; }
  .md-switch :global(span){ position: absolute; inset: 0; background: var(--border); border-radius: 20px; transition: background 0.15s; cursor: pointer; }
  .md-switch :global(span::before){ content: ''; position: absolute; width: 14px; height: 14px; left: 3px; top: 3px; background: var(--card); border-radius: 50%; transition: transform 0.15s; }
  .md-switch input:checked + :global(span){ background: var(--accent); }
  .md-switch input:checked + :global(span::before){ transform: translateX(14px); }

  .md-section { margin-top: 8px; margin-bottom: 34px; }
  .md-section-hidden { display: none; }
  :global(.md-count){ font-family: var(--mono); font-size: 11px; color: var(--text-dim); font-weight: 400; }
  .md-section-note { font-size: 12.5px; color: var(--text-dim); margin: 0 0 14px; max-width: 62ch; }
  .md-empty-note { font-size: 13px; color: var(--text-dim); }
  .md-empty-note :global(code){ font-family: var(--mono); color: var(--accent); }

  .md-list-grid { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
  .md-list-row { display: flex; align-items: center; gap: 8px; border: 1px solid var(--border); border-radius: 9px; padding: 7px 8px 7px 12px; background: var(--card); }
  .md-list-name { font-size: 12.5px; color: var(--text); font-weight: 600; }
  .md-list-tag { font-family: var(--mono); font-size: 10.5px; color: var(--text-dim); background: var(--bg-raise); padding: 2px 7px; border-radius: 5px; }
  .md-list-del { border: none; background: transparent; color: var(--text-dim); cursor: pointer; padding: 3px; border-radius: 6px; }
  .md-list-del:hover { color: var(--red); background: var(--red-soft); }

  .md-add-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .md-add-row input, .md-add-row select { border: 1px solid var(--border); border-radius: 8px; padding: 7px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 12.5px; }
  .md-add-row .btn { display: inline-flex; align-items: center; gap: 6px; }

  .md-case-list { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
  .md-case-row { display: flex; align-items: center; gap: 12px; padding: 9px 14px; font-size: 12.5px; background: var(--card); flex-wrap: wrap; }
  .md-case-row + .md-case-row { border-top: 1px solid var(--border-soft); }
  .md-case-num { font-family: var(--mono); color: var(--text-dim); }
  .md-case-type { font-family: var(--mono); font-size: 10.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--c); background: color-mix(in srgb, var(--c) 16%, transparent); padding: 2px 7px; border-radius: 5px; }
  .md-case-user, .md-case-mod { color: var(--text-dim); }
  .md-case-user :global(code), .md-case-mod :global(code){ font-family: var(--mono); }
  .md-case-reason { color: var(--text-muted); }
  .md-case-inactive { margin-left: auto; font-size: 11px; color: var(--text-dim); font-style: italic; }
</style>
