---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MultiSelect from './MultiSelect.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import SxNumber from './SxNumber.astro';
import { CASE_FILTERS, caseLogHref } from '../utils/caseLog';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface AutomodConfig {
  wordFilterEnabled: boolean;
  wordFilterAction: string;
  bannedWords: string[];
  antiSpamEnabled: boolean;
  maxMentions: number;
  antiRaidEnabled: boolean;
  raidJoinThreshold: number;
  raidWindowSeconds: number;
  raidAction: string;
  antiAltEnabled: boolean;
  antiAltMinAgeDays: number;
  antiAltAction: string;
  immuneRoleIds: string[];
  repeatThreshold: number;
  repeatWindow: number;
  capsPercent: number;
  capsMinLength: number;
  maxMessageLength: number;
  maxLines: number;
  exemptChannelIds: string[];
  allowedInviteCodes: string[];
  spamRepeat: boolean;
  spamMentions: boolean;
  spamInvites: boolean;
  spamCaps: boolean;
  strikeLimit: number;
  strikeWindow: number;
  strikeMute: number;
}
interface AntinukeConfig {
  enabled: boolean;
  actionThreshold: number;
  windowSeconds: number;
  whitelistIds: string;
}
interface Case {
  caseNumber: number;
  type: string;
  userId: string;
  moderatorId: string;
  reason: string | null;
  active: boolean;
  createdAt: string;
  evidence?: string[];
}
interface ActiveSanction { caseNumber: number; type: string; userId: string; moderatorId: string; reason: string | null; createdAt: string; expiresAt: string | null; }
interface ModStats { total: number; automatic: number; byType: [string, number][]; moderators: { userId: string; count: number }[]; days: { label: string; count: number }[]; }
interface SilentChannel { channelId: string; name: string; action: string; }
interface EscalationRule { warnCount: number; action: string; durationMinutes: number | null; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  automod: AutomodConfig;
  antinuke: AntinukeConfig;
  cases: Case[];
  activeSanctions?: ActiveSanction[];
  modStats?: ModStats;
  people?: Record<string, { name: string; avatar: string }>;
  casesLimit?: number;
  /** The filters of the case log (kind, search, page), read from the address and applied in the database. */
  caseLog?: { type: string; filter: string; q: string; before: number | null; older: boolean; failed: boolean; edit: number | null };
  stickyRolesEnabled: boolean;
  silentChannels: SilentChannel[];
  escalationRules: EscalationRule[];
  roles: { id: string; name: string }[];
  channels: { id: string; name: string }[];
  saved: boolean;
  badInvites?: string[];
  tooManyInvites?: boolean;
  sanctionTemplates: Record<string, { dm: string; reply: string; log: string }>;
  sanctionMessagesReady: boolean;
  embedTemplateNames: string[];
  caseMessage?: { kind: 'ok' | 'err'; text: string; number: number } | null;
  section?: string;
  /** The server's prefix, for the commands named in the texts. */
  prefix?: string;
}
const { user, guildId, guildName, guildIcon, automod, antinuke, stickyRolesEnabled, cases, activeSanctions = [], modStats = { total: 0, automatic: 0, byType: [], moderators: [], days: [] }, people = {}, casesLimit = 25, caseLog = { type: '', filter: '', q: '', before: null, older: false, failed: false, edit: null }, silentChannels, escalationRules, sanctionTemplates, sanctionMessagesReady, embedTemplateNames, roles, channels, saved, badInvites = [], tooManyInvites = false, caseMessage = null, section, prefix = '!' } = Astro.props;

const typeColor: Record<string, string> = {
  ban: '#fe6465', tempban: '#fe6465', kick: '#ff9f5a', warn: '#fed53c',
  mute: '#c792ea', tempmute: '#c792ea', unban: '#a5ea7a', unmute: '#a5ea7a',
  hardban: '#fe6465', softban: '#ff7a7a', jail: '#7aa2f7', unjail: '#a5ea7a',
};
// Any filter on the case log (a kind, a search or an older page): an empty answer then means "nothing matches", not "no cases yet".
const caseFiltered = Boolean(caseLog.type || caseLog.q || caseLog.before);
const nextCasesLimit = casesLimit === 25 ? 50 : 100;
const lastCaseNumber = cases.length ? cases[cases.length - 1].caseNumber : null;
// The case whose form is open: the one asked for in the address (?edit=, the Edit link without the script), or the one whose change
// the bot refused, so what was typed can be fixed. A change that worked closes it.
const editCase = caseMessage?.kind === 'err' ? caseMessage.number : caseMessage?.kind === 'ok' ? null : caseLog.edit;
const sectionMeta: Record<string, string> = { protection: dt('Protection'), 'silent-channels': dt('Silent channels'), 'warn-escalation': dt('Warn escalation'), 'sanction-messages': dt('Sanction messages'), cases: dt('Case log'), active: dt('Active sanctions'), stats: dt('Moderator stats') };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'protection';
const selectedTitle = sectionMeta[selectedSection];
const wordActions: [string, string, string][] = [['warn', dt('Warn'), 'ph:warning-fill'], ['mute', dt('Mute'), 'ph:speaker-slash-fill'], ['kick', dt('Kick'), 'ph:sign-out-fill'], ['delete', dt('Delete the message'), 'ph:trash-fill']];
const raidActions: [string, string, string][] = [['alert', dt('Alert'), 'ph:bell-ringing-fill'], ['kick', dt('Kick'), 'ph:sign-out-fill'], ['lockdown', dt('Lockdown'), 'ph:lock-fill']];
const altActions: [string, string, string][] = [['kick', dt('Kick'), 'ph:sign-out-fill'], ['flag', dt('Flag'), 'ph:flag-fill']];
const protectionsOn = [automod.wordFilterEnabled, automod.antiSpamEnabled, automod.antiRaidEnabled, automod.antiAltEnabled, stickyRolesEnabled].filter(Boolean).length;
const messageKinds = ['default', 'ban', 'tempban', 'softban', 'unban', 'kick', 'mute', 'tempmute', 'unmute', 'warn', 'jail', 'unjail'];
const messageSlots = ['dm', 'reply', 'log'] as const;
const showSection = (id: string) => selectedSection === id ? '' : 'md-section-hidden';
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'protection' ? 'moderation' : selectedSection === 'stats' ? 'mod-stats' : selectedSection === 'active' ? 'active-sanctions' : selectedSection} pageTitle={selectedTitle}>
  <DashSettingsKit />
  <DashFormKit />
  <h1>{selectedTitle}</h1>

  {saved && <div class="md-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {badInvites.length > 0 && <div class="md-flash md-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('These invites were not valid and were skipped: {a}', { a: badInvites.join(', ') })}</div>}
  {tooManyInvites && <div class="md-flash md-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('Only the first {a} invites were kept.', { a: 50 })}</div>}

  {selectedSection === 'protection' && (
  <div class="sx-page">
  <DashStatTiles tiles={[
    { label: dt('Protections on'), value: protectionsOn, tone: 'joins' },
    { label: dt('Banned words'), value: automod.bannedWords.length, tone: 'leaves' },
    { label: dt('Ignored roles'), value: automod.immuneRoleIds.length, tone: 'voice' },
    { label: dt('Ignored channels'), value: automod.exemptChannelIds.length, tone: 'invites' },
  ]} />
  <form method="POST" class="sx-stack mp-form" id="mdForm">
    <input type="hidden" name="action" value="config" />

    <section class="sx-panel mp-block">
      <div class="sx-panel-head">
        <span class="sx-panel-icon" style="--c:#fe6465"><Icon name="ph:funnel-fill" width="17" height="17" /></span>
        <h2>{dt('Word filter')}</h2>
        <label class="sx-toggle-only"><input type="checkbox" name="word_filter_enabled" checked={automod.wordFilterEnabled} aria-label={dt('Word filter')} /><i class="sx-toggle"></i></label>
      </div>
      <p class="sx-lead">{dt('Blocks messages containing banned words or phrases.')}</p>
      <div class="mp-body" data-sx-needs="word_filter_enabled">
        <div class="sx-field"><span class="sx-label">{dt('Action')}</span>
          <div class="sx-choices">
            {wordActions.map(([value, label, icon]) => <label class="sx-choice"><input type="radio" name="word_filter_action" value={value} checked={automod.wordFilterAction === value} /><span class="sx-choice-body"><Icon name={icon} width="17" height="17" /><b>{label}</b></span></label>)}
          </div>
        </div>
        <div class="sx-field"><label for="mp-words">{dt('Banned words')}</label>
          <textarea id="mp-words" name="banned_words" class="dgl-autogrow" rows="3" placeholder={dt('comma, separated, words')}>{automod.bannedWords.join(', ')}</textarea>
          <span class="sx-hint">{dt('Roles and channels the automod never checks are set under Anti-spam.')}</span>
        </div>
      </div>
    </section>

    <section class="sx-panel mp-block">
      <div class="sx-panel-head">
        <span class="sx-panel-icon" style="--c:#f0a88f"><Icon name="ph:chats-fill" width="17" height="17" /></span>
        <h2>{dt('Anti-spam')}</h2>
        <label class="sx-toggle-only"><input type="checkbox" name="anti_spam_enabled" checked={automod.antiSpamEnabled} aria-label={dt('Anti-spam')} /><i class="sx-toggle"></i></label>
      </div>
      <p class="sx-lead">{dt('Flags messages that mass-mention members.')}</p>

      <div class="mp-subs">
      <div class="sx-sub">
        <h3>{dt('Mentions')}</h3>
        <div class="sx-grid">
          <div class="sx-field"><label for="mp-mentions">{dt('Max mentions per message')}</label><SxNumber id="mp-mentions" name="max_mentions" value={automod.maxMentions} min="1" max="50" /></div>
        </div>
        <label class="sx-switch"><input type="checkbox" name="spam_mentions" checked={automod.spamMentions} /><span class="sx-switch-text"><b>{dt('Catch mass mentions')}</b></span><i class="sx-toggle"></i></label>
      </div>

      <div class="sx-sub">
        <h3>{dt('Repeated messages')}</h3>
        <label class="sx-switch"><input type="checkbox" name="spam_repeat" checked={automod.spamRepeat} /><span class="sx-switch-text"><b>{dt('Catch the same message again and again')}</b></span><i class="sx-toggle"></i></label>
        <div class="sx-grid" data-sx-needs="spam_repeat">
          <div class="sx-field"><label for="mp-rep">{dt('Copies that count as a flood')}</label><SxNumber id="mp-rep" name="repeat_threshold" value={automod.repeatThreshold} min="2" max="20" /></div>
          <div class="sx-field"><label for="mp-repw">{dt('In how many seconds')}</label><SxNumber id="mp-repw" name="repeat_window_seconds" value={automod.repeatWindow} min="3" max="120" /></div>
        </div>
      </div>

      <div class="sx-sub">
        <h3>{dt('Capital letters')}</h3>
        <label class="sx-switch"><input type="checkbox" name="spam_caps" checked={automod.spamCaps} /><span class="sx-switch-text"><b>{dt('Catch shouting (capital letters)')}</b></span><i class="sx-toggle"></i></label>
        <div class="sx-grid" data-sx-needs="spam_caps">
          <div class="sx-field"><label for="mp-caps">{dt('Percent in capitals')}</label><SxNumber id="mp-caps" name="caps_percent" value={automod.capsPercent} min="30" max="100" /></div>
          <div class="sx-field"><label for="mp-capsm">{dt('Shortest message checked')}</label><SxNumber id="mp-capsm" name="caps_min_length" value={automod.capsMinLength} min="4" max="200" /></div>
        </div>
      </div>

      <div class="sx-sub">
        <h3>{dt('Long messages')}</h3>
        <div class="sx-grid">
          <div class="sx-field"><label for="mp-len">{dt('Delete messages longer than (characters)')}</label><SxNumber id="mp-len" name="max_message_length" value={automod.maxMessageLength} min="0" max="2000" /></div>
          <div class="sx-field"><label for="mp-lines">{dt('Delete messages with more lines than')}</label><SxNumber id="mp-lines" name="max_lines" value={automod.maxLines} min="0" max="100" /></div>
        </div>
        <span class="sx-hint">{dt('0 turns a limit off. Long messages are only deleted, nobody is punished for them.')}</span>
      </div>

      <div class="sx-sub mp-wide">
        <h3>{dt('Invites')}</h3>
        <label class="sx-switch"><input type="checkbox" name="spam_invites" checked={automod.spamInvites} /><span class="sx-switch-text"><b>{dt('Catch invites that are not on the allow-list')}</b></span><i class="sx-toggle"></i></label>
        <div class="sx-field" data-sx-needs="spam_invites"><label for="md-allowed-invites">{dt('Allowed invites')}</label>
          <textarea id="md-allowed-invites" name="allowed_invite_codes" class="dgl-autogrow sx-mono" rows="3" placeholder={dt('discord.gg/petto, one per line')}>{automod.allowedInviteCodes.join('\n')}</textarea>
          <span class="sx-hint">{dt('Discord invites that members may post. Paste the full link or only the code. Other web links are filtered in the AutoMod filters page.')} <a href={`/dash/guild/${guildId}/automod`}>{dt('Open the AutoMod filters')}</a> {dt('The web domains that the All links filter lets through are set there too.')}</span>
        </div>
      </div>

      <div class="sx-sub mp-wide">
        <h3>{dt('Exceptions')}</h3>
        <div class="sx-field"><span class="sx-label">{dt('Ignored roles')}</span>
          <MultiSelect lazy name="immune_role_ids" options={roles} selected={automod.immuneRoleIds} placeholder={dt('Search roles...')} />
          <span class="sx-hint">{dt('Members with these roles are never checked by the word filter, anti-spam or the Petto filters.')}</span>
        </div>
        <div class="sx-field"><span class="sx-label">{dt('Ignored channels')}</span>
          <MultiSelect lazy name="exempt_channel_ids" options={channels} selected={automod.exemptChannelIds} placeholder={dt('Search channels...')} />
          <span class="sx-hint">{dt('Nothing is checked in these channels.')}</span>
        </div>
      </div>
      </div>
    </section>

    <section class="sx-panel mp-block">
      <div class="sx-panel-head">
        <span class="sx-panel-icon" style="--c:#ff6b6b"><Icon name="ph:warning-fill" width="17" height="17" /></span>
        <h2>{dt('Strikes')}</h2>
      </div>
      <p class="sx-lead">{dt('Mutes a member who breaks the automod again and again, on top of what each rule does.')}</p>
      <div class="sx-grid sx-grid-3">
        <div class="sx-field"><label for="mp-sl">{dt('Violations that trigger the mute (0 for off)')}</label><SxNumber id="mp-sl" name="strike_limit" value={automod.strikeLimit} min="0" max="20" /></div>
        <div class="sx-field"><label for="mp-sw">{dt('In how many minutes')}</label><SxNumber id="mp-sw" name="strike_window_minutes" value={automod.strikeWindow} min="1" max="1440" /></div>
        <div class="sx-field"><label for="mp-sm">{dt('Minutes of mute')}</label><SxNumber id="mp-sm" name="strike_mute_minutes" value={automod.strikeMute} min="1" max="40320" /></div>
      </div>
    </section>

    <div class="sx-duo">
      <section class="sx-panel mp-block">
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style="--c:#ff9f5a"><Icon name="ph:users-three-fill" width="17" height="17" /></span>
          <h2>{dt('Anti-raid')}</h2>
          <label class="sx-toggle-only"><input type="checkbox" name="anti_raid_enabled" checked={automod.antiRaidEnabled} aria-label={dt('Anti-raid')} /><i class="sx-toggle"></i></label>
        </div>
        <p class="sx-lead">{dt('Reacts when too many members join in a short burst.')}</p>
        <div class="mp-body" data-sx-needs="anti_raid_enabled">
          <div class="sx-grid">
            <div class="sx-field"><label for="mp-rj">{dt('Join threshold')}</label><SxNumber id="mp-rj" name="raid_join_threshold" value={automod.raidJoinThreshold} min="2" max="50" /></div>
            <div class="sx-field"><label for="mp-rw">{dt('Window (seconds)')}</label><SxNumber id="mp-rw" name="raid_window_seconds" value={automod.raidWindowSeconds} min="5" max="120" /></div>
          </div>
          <div class="sx-field"><span class="sx-label">{dt('Action')}</span>
            <div class="sx-choices mp-choices-sm">
              {raidActions.map(([value, label, icon]) => <label class="sx-choice"><input type="radio" name="raid_action" value={value} checked={automod.raidAction === value} /><span class="sx-choice-body"><Icon name={icon} width="17" height="17" /><b>{label}</b></span></label>)}
            </div>
          </div>
        </div>
      </section>

      <section class="sx-panel mp-block">
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style="--c:#5eead4"><Icon name="ph:identification-badge-fill" width="17" height="17" /></span>
          <h2>{dt('Anti-alt')}</h2>
          <label class="sx-toggle-only"><input type="checkbox" name="anti_alt_enabled" checked={automod.antiAltEnabled} aria-label={dt('Anti-alt')} /><i class="sx-toggle"></i></label>
        </div>
        <p class="sx-lead">{dt('Flags accounts newer than a minimum age on join.')}</p>
        <div class="mp-body" data-sx-needs="anti_alt_enabled">
          <div class="sx-field"><label for="mp-aa">{dt('Minimum account age (days)')}</label><SxNumber id="mp-aa" name="anti_alt_min_age_days" value={automod.antiAltMinAgeDays} min="0" max="365" /></div>
          <div class="sx-field"><span class="sx-label">{dt('Action')}</span>
            <div class="sx-choices mp-choices-sm">
              {altActions.map(([value, label, icon]) => <label class="sx-choice"><input type="radio" name="anti_alt_action" value={value} checked={automod.antiAltAction === value} /><span class="sx-choice-body"><Icon name={icon} width="17" height="17" /><b>{label}</b></span></label>)}
            </div>
          </div>
        </div>
      </section>
    </div>

    <label class="sx-switch"><input type="checkbox" name="sticky_roles_enabled" checked={stickyRolesEnabled} /><span class="sx-panel-icon" style="--c:#a5ea7a"><Icon name="ph:link-fill" width="17" height="17" /></span><span class="sx-switch-text"><b>{dt('Sticky roles')}</b><em>{dt('If a member leaves and rejoins within 90 days, their roles (except managed ones, e.g. booster/bot roles) are automatically restored.')}</em></span><i class="sx-toggle"></i></label>

    <div class="sx-foot mp-foot"><button type="submit" class="btn btn-accent btn-sm">{dt('Save changes')}</button></div>
  </form>

  <h2 class="mp-related-title">{dt('More protection')}</h2>
  <div class="mp-links dgl-stagger">
    <a class="mp-link" href={`/dash/guild/${guildId}/antinuke`}>
      <span class="sx-panel-icon" style="--c:#f78fb3"><Icon name="ph:siren-fill" width="17" height="17" /></span>
      <span class="mp-link-text"><b>{dt('Anti-raid & nuke')}</b><em>{dt('Each protection (bans, channels, roles, bots, webhooks...) now has its own page with its own limit, action, trusted accounts and a log to restore what was stopped.')}</em></span>
      <Icon name="ph:arrow-right-bold" class="mp-link-go" width="14" height="14" />
    </a>
    <a class="mp-link" href={`/dash/guild/${guildId}/antiscam`}>
      <span class="sx-panel-icon" style="--c:#ff6b6b"><Icon name="ph:shield-warning-fill" width="17" height="17" /></span>
      <span class="mp-link-text"><b>{dt('Anti scam')}</b><em>{dt('Catches hijacked accounts that spam the MrBeast giveaway scam, fake withdrawals and casino promos.')}</em></span>
      <Icon name="ph:arrow-right-bold" class="mp-link-go" width="14" height="14" />
    </a>
    <a class="mp-link" href={`/dash/guild/${guildId}/automod`}>
      <span class="sx-panel-icon" style="--c:#ffb86c"><Icon name="ph:funnel-fill" width="17" height="17" /></span>
      <span class="mp-link-text"><b>{dt('AutoMod templates')}</b><em>{dt('Ready filters for links, invites, emojis, zalgo, scams and more, in Discord AutoMod or in Petto, with packs.')}</em></span>
      <Icon name="ph:arrow-right-bold" class="mp-link-go" width="14" height="14" />
    </a>
  </div>
  </div>
  )}

  {selectedSection === 'silent-channels' && (
  <div class:list={['mdx-page', showSection('silent-channels')]}>
    <DashStatTiles tiles={[
      { label: dt('Silent channels'), value: silentChannels.length, tone: 'invites' },
      { label: dt('Warn'), value: silentChannels.filter((s) => s.action === 'warn').length, tone: 'reactions' },
      { label: dt('Mute'), value: silentChannels.filter((s) => s.action === 'mute').length, tone: 'voice' },
      { label: dt('Kick'), value: silentChannels.filter((s) => s.action === 'kick').length, tone: 'messages' },
    ]} />
    <div class="mdx-head">
      <h2>{dt('Silent channels')} <span class="mdx-count">{silentChannels.length}</span></h2>
      <p>{dt('Any message here counts as a violation, independent of the word filter or anti-spam toggles.')}</p>
    </div>
    {silentChannels.length === 0 && <p class="mdx-empty"><Icon name="ph:speaker-slash-fill" width="18" height="18" />{dt('No silent channels yet. Add one below.')}</p>}
    <div class="mdx-list dgl-stagger">
      {silentChannels.map((s) => (
        <form method="POST" class="mdx-item md-list-row" data-no-dirty>
          <input type="hidden" name="action" value="delete_silent_channel" />
          <input type="hidden" name="channel_id" value={s.channelId} />
          <span class="mdx-icon" style="--c:#8fb3ff"><Icon name="ph:speaker-slash-fill" width="16" height="16" /></span>
          <span class="mdx-item-main"><b>#{s.name}</b></span>
          <span class="mdx-pill" style={`--c:${typeColor[s.action] ?? '#94a3b8'}`}>{s.action}</span>
          <button type="submit" class="mdx-del" aria-label={dt('Remove')} title={dt('Remove')}><Icon name="ph:trash-fill" width="15" height="15" /></button>
        </form>
      ))}
    </div>
    <form method="POST" class="mdx-add" data-no-dirty>
      <input type="hidden" name="action" value="add_silent_channel" />
      <div class="mdx-add-title"><Icon name="ph:plus-circle-fill" width="16" height="16" />{dt('Add')}</div>
      <div class="sx-grid">
        <div class="sx-field"><label for="mdx-silent-channel">{dt('Channel')}</label>
          <select id="mdx-silent-channel" name="channel_id" required>
            <option value="" disabled selected>{dt('Channel')}</option>
            {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
          </select>
        </div>
        <div class="sx-field">
          <span class="sx-label" id="mdx-silent-action">{dt('Action')}</span>
          <div class="dfx-chips" role="radiogroup" aria-labelledby="mdx-silent-action">
            {['warn', 'mute', 'kick'].map((act, i) => <label class="dfx-chip"><input type="radio" name="silent_action" value={act} checked={i === 0} /><i class="mdx-dot" style={`--c:${typeColor[act]}`}></i>{act}</label>)}
          </div>
        </div>
      </div>
      <div class="mdx-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button></div>
    </form>
  </div>
  )}

  {selectedSection === 'warn-escalation' && (
  <div class:list={['mdx-page', showSection('warn-escalation')]}>
    <DashStatTiles tiles={[
      { label: dt('Steps'), value: escalationRules.length, tone: 'invites' },
      { label: dt('First step'), value: escalationRules[0]?.warnCount ?? 0, text: escalationRules.length ? dt('Warn #{a}', { a: escalationRules[0].warnCount }) : '-', tone: 'reactions' },
