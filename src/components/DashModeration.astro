---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MultiSelect from './MultiSelect.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import SxNumber from './SxNumber.astro';
import { CASE_FILTERS, caseLogHref } from '../utils/caseLog';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface AutomodConfig {
  wordFilterEnabled: boolean;
  wordFilterAction: string;
  bannedWords: string[];
  antiSpamEnabled: boolean;
  maxMentions: number;
  antiRaidEnabled: boolean;
  raidJoinThreshold: number;
  raidWindowSeconds: number;
  raidAction: string;
  antiAltEnabled: boolean;
  antiAltMinAgeDays: number;
  antiAltAction: string;
  immuneRoleIds: string[];
  repeatThreshold: number;
  repeatWindow: number;
  capsPercent: number;
  capsMinLength: number;
  maxMessageLength: number;
  maxLines: number;
  exemptChannelIds: string[];
  allowedInviteCodes: string[];
  spamRepeat: boolean;
  spamMentions: boolean;
  spamInvites: boolean;
  spamCaps: boolean;
  strikeLimit: number;
  strikeWindow: number;
  strikeMute: number;
}
interface AntinukeConfig {
  enabled: boolean;
  actionThreshold: number;
  windowSeconds: number;
  whitelistIds: string;
}
interface Case {
  caseNumber: number;
  type: string;
  userId: string;
  moderatorId: string;
  reason: string | null;
  active: boolean;
  createdAt: string;
  evidence?: string[];
}
interface ActiveSanction { caseNumber: number; type: string; userId: string; moderatorId: string; reason: string | null; createdAt: string; expiresAt: string | null; }
interface ModStats { total: number; automatic: number; byType: [string, number][]; moderators: { userId: string; count: number }[]; days: { label: string; count: number }[]; }
interface SilentChannel { channelId: string; name: string; action: string; }
interface EscalationRule { warnCount: number; action: string; durationMinutes: number | null; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  automod: AutomodConfig;
  antinuke: AntinukeConfig;
  cases: Case[];
  activeSanctions?: ActiveSanction[];
  modStats?: ModStats;
  people?: Record<string, { name: string; avatar: string }>;
  casesLimit?: number;
  /** The filters of the case log (kind, search, page), read from the address and applied in the database. */
  caseLog?: { type: string; filter: string; q: string; before: number | null; older: boolean; failed: boolean; edit: number | null };
  stickyRolesEnabled: boolean;
  silentChannels: SilentChannel[];
  escalationRules: EscalationRule[];
  roles: { id: string; name: string }[];
  channels: { id: string; name: string }[];
  saved: boolean;
  badInvites?: string[];
  tooManyInvites?: boolean;
  sanctionTemplates: Record<string, { dm: string; reply: string; log: string }>;
  sanctionMessagesReady: boolean;
  embedTemplateNames: string[];
  caseMessage?: { kind: 'ok' | 'err'; text: string; number: number } | null;
  section?: string;
  /** The server's prefix, for the commands named in the texts. */
  prefix?: string;
}
const { user, guildId, guildName, guildIcon, automod, antinuke, stickyRolesEnabled, cases, activeSanctions = [], modStats = { total: 0, automatic: 0, byType: [], moderators: [], days: [] }, people = {}, casesLimit = 25, caseLog = { type: '', filter: '', q: '', before: null, older: false, failed: false, edit: null }, silentChannels, escalationRules, sanctionTemplates, sanctionMessagesReady, embedTemplateNames, roles, channels, saved, badInvites = [], tooManyInvites = false, caseMessage = null, section, prefix = '!' } = Astro.props;

const typeColor: Record<string, string> = {
  ban: '#fe6465', tempban: '#fe6465', kick: '#ff9f5a', warn: '#fed53c',
  mute: '#c792ea', tempmute: '#c792ea', unban: '#a5ea7a', unmute: '#a5ea7a',
  hardban: '#fe6465', softban: '#ff7a7a', jail: '#7aa2f7', unjail: '#a5ea7a',
};
// Any filter on the case log (a kind, a search or an older page): an empty answer then means "nothing matches", not "no cases yet".
const caseFiltered = Boolean(caseLog.type || caseLog.q || caseLog.before);
const nextCasesLimit = casesLimit === 25 ? 50 : 100;
const lastCaseNumber = cases.length ? cases[cases.length - 1].caseNumber : null;
// The case whose form is open: the one asked for in the address (?edit=, the Edit link without the script), or the one whose change
// the bot refused, so what was typed can be fixed. A change that worked closes it.
const editCase = caseMessage?.kind === 'err' ? caseMessage.number : caseMessage?.kind === 'ok' ? null : caseLog.edit;
const sectionMeta: Record<string, string> = { protection: dt('Protection'), 'silent-channels': dt('Silent channels'), 'warn-escalation': dt('Warn escalation'), 'sanction-messages': dt('Sanction messages'), cases: dt('Case log'), active: dt('Active sanctions'), stats: dt('Moderator stats') };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'protection';
const selectedTitle = sectionMeta[selectedSection];
const wordActions: [string, string, string][] = [['warn', dt('Warn'), 'ph:warning-fill'], ['mute', dt('Mute'), 'ph:speaker-slash-fill'], ['kick', dt('Kick'), 'ph:sign-out-fill'], ['delete', dt('Delete the message'), 'ph:trash-fill']];
const raidActions: [string, string, string][] = [['alert', dt('Alert'), 'ph:bell-ringing-fill'], ['kick', dt('Kick'), 'ph:sign-out-fill'], ['lockdown', dt('Lockdown'), 'ph:lock-fill']];
const altActions: [string, string, string][] = [['kick', dt('Kick'), 'ph:sign-out-fill'], ['flag', dt('Flag'), 'ph:flag-fill']];
const protectionsOn = [automod.wordFilterEnabled, automod.antiSpamEnabled, automod.antiRaidEnabled, automod.antiAltEnabled, stickyRolesEnabled].filter(Boolean).length;
const showSection = (id: string) => selectedSection === id ? '' : 'md-section-hidden';
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'protection' ? 'moderation' : selectedSection === 'stats' ? 'mod-stats' : selectedSection === 'active' ? 'active-sanctions' : selectedSection} pageTitle={selectedTitle}>
  <DashSettingsKit />
  <h1>{selectedTitle}</h1>

  {saved && <div class="md-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {badInvites.length > 0 && <div class="md-flash md-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('These invites were not valid and were skipped: {a}', { a: badInvites.join(', ') })}</div>}
  {tooManyInvites && <div class="md-flash md-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('Only the first {a} invites were kept.', { a: 50 })}</div>}

  {selectedSection === 'protection' && (
  <div class="sx-page">
  <DashStatTiles tiles={[
    { label: dt('Protections on'), value: protectionsOn, tone: 'joins' },
    { label: dt('Banned words'), value: automod.bannedWords.length, tone: 'leaves' },
    { label: dt('Ignored roles'), value: automod.immuneRoleIds.length, tone: 'voice' },
    { label: dt('Ignored channels'), value: automod.exemptChannelIds.length, tone: 'invites' },
  ]} />
  <form method="POST" class="sx-stack mp-form" id="mdForm">
    <input type="hidden" name="action" value="config" />

    <section class="sx-panel mp-block">
      <div class="sx-panel-head">
        <span class="sx-panel-icon" style="--c:#fe6465"><Icon name="ph:funnel-fill" width="17" height="17" /></span>
        <h2>{dt('Word filter')}</h2>
        <label class="sx-toggle-only"><input type="checkbox" name="word_filter_enabled" checked={automod.wordFilterEnabled} aria-label={dt('Word filter')} /><i class="sx-toggle"></i></label>
      </div>
      <p class="sx-lead">{dt('Blocks messages containing banned words or phrases.')}</p>
      <div class="mp-body" data-sx-needs="word_filter_enabled">
        <div class="sx-field"><span class="sx-label">{dt('Action')}</span>
          <div class="sx-choices">
            {wordActions.map(([value, label, icon]) => <label class="sx-choice"><input type="radio" name="word_filter_action" value={value} checked={automod.wordFilterAction === value} /><span class="sx-choice-body"><Icon name={icon} width="17" height="17" /><b>{label}</b></span></label>)}
          </div>
        </div>
        <div class="sx-field"><label for="mp-words">{dt('Banned words')}</label>
          <textarea id="mp-words" name="banned_words" class="dgl-autogrow" rows="3" placeholder={dt('comma, separated, words')}>{automod.bannedWords.join(', ')}</textarea>
          <span class="sx-hint">{dt('Roles and channels the automod never checks are set under Anti-spam.')}</span>
        </div>
      </div>
    </section>

    <section class="sx-panel mp-block">
      <div class="sx-panel-head">
        <span class="sx-panel-icon" style="--c:#f0a88f"><Icon name="ph:chats-fill" width="17" height="17" /></span>
        <h2>{dt('Anti-spam')}</h2>
        <label class="sx-toggle-only"><input type="checkbox" name="anti_spam_enabled" checked={automod.antiSpamEnabled} aria-label={dt('Anti-spam')} /><i class="sx-toggle"></i></label>
      </div>
      <p class="sx-lead">{dt('Flags messages that mass-mention members.')}</p>

      <div class="mp-subs">
      <div class="sx-sub">
        <h3>{dt('Mentions')}</h3>
        <div class="sx-grid">
          <div class="sx-field"><label for="mp-mentions">{dt('Max mentions per message')}</label><SxNumber id="mp-mentions" name="max_mentions" value={automod.maxMentions} min="1" max="50" /></div>
        </div>
        <label class="sx-switch"><input type="checkbox" name="spam_mentions" checked={automod.spamMentions} /><span class="sx-switch-text"><b>{dt('Catch mass mentions')}</b></span><i class="sx-toggle"></i></label>
      </div>

      <div class="sx-sub">
        <h3>{dt('Repeated messages')}</h3>
        <label class="sx-switch"><input type="checkbox" name="spam_repeat" checked={automod.spamRepeat} /><span class="sx-switch-text"><b>{dt('Catch the same message again and again')}</b></span><i class="sx-toggle"></i></label>
        <div class="sx-grid" data-sx-needs="spam_repeat">
          <div class="sx-field"><label for="mp-rep">{dt('Copies that count as a flood')}</label><SxNumber id="mp-rep" name="repeat_threshold" value={automod.repeatThreshold} min="2" max="20" /></div>
          <div class="sx-field"><label for="mp-repw">{dt('In how many seconds')}</label><SxNumber id="mp-repw" name="repeat_window_seconds" value={automod.repeatWindow} min="3" max="120" /></div>
        </div>
      </div>

      <div class="sx-sub">
        <h3>{dt('Capital letters')}</h3>
        <label class="sx-switch"><input type="checkbox" name="spam_caps" checked={automod.spamCaps} /><span class="sx-switch-text"><b>{dt('Catch shouting (capital letters)')}</b></span><i class="sx-toggle"></i></label>
        <div class="sx-grid" data-sx-needs="spam_caps">
          <div class="sx-field"><label for="mp-caps">{dt('Percent in capitals')}</label><SxNumber id="mp-caps" name="caps_percent" value={automod.capsPercent} min="30" max="100" /></div>
          <div class="sx-field"><label for="mp-capsm">{dt('Shortest message checked')}</label><SxNumber id="mp-capsm" name="caps_min_length" value={automod.capsMinLength} min="4" max="200" /></div>
        </div>
      </div>

      <div class="sx-sub">
        <h3>{dt('Long messages')}</h3>
        <div class="sx-grid">
          <div class="sx-field"><label for="mp-len">{dt('Delete messages longer than (characters)')}</label><SxNumber id="mp-len" name="max_message_length" value={automod.maxMessageLength} min="0" max="2000" /></div>
          <div class="sx-field"><label for="mp-lines">{dt('Delete messages with more lines than')}</label><SxNumber id="mp-lines" name="max_lines" value={automod.maxLines} min="0" max="100" /></div>
        </div>
        <span class="sx-hint">{dt('0 turns a limit off. Long messages are only deleted, nobody is punished for them.')}</span>
      </div>

      <div class="sx-sub mp-wide">
        <h3>{dt('Invites')}</h3>
        <label class="sx-switch"><input type="checkbox" name="spam_invites" checked={automod.spamInvites} /><span class="sx-switch-text"><b>{dt('Catch invites that are not on the allow-list')}</b></span><i class="sx-toggle"></i></label>
        <div class="sx-field" data-sx-needs="spam_invites"><label for="md-allowed-invites">{dt('Allowed invites')}</label>
          <textarea id="md-allowed-invites" name="allowed_invite_codes" class="dgl-autogrow sx-mono" rows="3" placeholder={dt('discord.gg/petto, one per line')}>{automod.allowedInviteCodes.join('\n')}</textarea>
          <span class="sx-hint">{dt('Discord invites that members may post. Paste the full link or only the code. Other web links are filtered in the AutoMod filters page.')} <a href={`/dash/guild/${guildId}/automod`}>{dt('Open the AutoMod filters')}</a> {dt('The web domains that the All links filter lets through are set there too.')}</span>
        </div>
      </div>

      <div class="sx-sub mp-wide">
        <h3>{dt('Exceptions')}</h3>
        <div class="sx-field"><span class="sx-label">{dt('Ignored roles')}</span>
          <MultiSelect lazy name="immune_role_ids" options={roles} selected={automod.immuneRoleIds} placeholder={dt('Search roles...')} />
          <span class="sx-hint">{dt('Members with these roles are never checked by the word filter, anti-spam or the Petto filters.')}</span>
        </div>
        <div class="sx-field"><span class="sx-label">{dt('Ignored channels')}</span>
          <MultiSelect lazy name="exempt_channel_ids" options={channels} selected={automod.exemptChannelIds} placeholder={dt('Search channels...')} />
          <span class="sx-hint">{dt('Nothing is checked in these channels.')}</span>
        </div>
      </div>
      </div>
    </section>

    <section class="sx-panel mp-block">
      <div class="sx-panel-head">
        <span class="sx-panel-icon" style="--c:#ff6b6b"><Icon name="ph:warning-fill" width="17" height="17" /></span>
        <h2>{dt('Strikes')}</h2>
      </div>
      <p class="sx-lead">{dt('Mutes a member who breaks the automod again and again, on top of what each rule does.')}</p>
      <div class="sx-grid sx-grid-3">
        <div class="sx-field"><label for="mp-sl">{dt('Violations that trigger the mute (0 for off)')}</label><SxNumber id="mp-sl" name="strike_limit" value={automod.strikeLimit} min="0" max="20" /></div>
        <div class="sx-field"><label for="mp-sw">{dt('In how many minutes')}</label><SxNumber id="mp-sw" name="strike_window_minutes" value={automod.strikeWindow} min="1" max="1440" /></div>
        <div class="sx-field"><label for="mp-sm">{dt('Minutes of mute')}</label><SxNumber id="mp-sm" name="strike_mute_minutes" value={automod.strikeMute} min="1" max="40320" /></div>
      </div>
    </section>

    <div class="sx-duo">
      <section class="sx-panel mp-block">
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style="--c:#ff9f5a"><Icon name="ph:users-three-fill" width="17" height="17" /></span>
          <h2>{dt('Anti-raid')}</h2>
          <label class="sx-toggle-only"><input type="checkbox" name="anti_raid_enabled" checked={automod.antiRaidEnabled} aria-label={dt('Anti-raid')} /><i class="sx-toggle"></i></label>
        </div>
        <p class="sx-lead">{dt('Reacts when too many members join in a short burst.')}</p>
        <div class="mp-body" data-sx-needs="anti_raid_enabled">
          <div class="sx-grid">
            <div class="sx-field"><label for="mp-rj">{dt('Join threshold')}</label><SxNumber id="mp-rj" name="raid_join_threshold" value={automod.raidJoinThreshold} min="2" max="50" /></div>
            <div class="sx-field"><label for="mp-rw">{dt('Window (seconds)')}</label><SxNumber id="mp-rw" name="raid_window_seconds" value={automod.raidWindowSeconds} min="5" max="120" /></div>
          </div>
          <div class="sx-field"><span class="sx-label">{dt('Action')}</span>
            <div class="sx-choices mp-choices-sm">
              {raidActions.map(([value, label, icon]) => <label class="sx-choice"><input type="radio" name="raid_action" value={value} checked={automod.raidAction === value} /><span class="sx-choice-body"><Icon name={icon} width="17" height="17" /><b>{label}</b></span></label>)}
            </div>
          </div>
        </div>
      </section>

      <section class="sx-panel mp-block">
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style="--c:#5eead4"><Icon name="ph:identification-badge-fill" width="17" height="17" /></span>
          <h2>{dt('Anti-alt')}</h2>
          <label class="sx-toggle-only"><input type="checkbox" name="anti_alt_enabled" checked={automod.antiAltEnabled} aria-label={dt('Anti-alt')} /><i class="sx-toggle"></i></label>
        </div>
        <p class="sx-lead">{dt('Flags accounts newer than a minimum age on join.')}</p>
        <div class="mp-body" data-sx-needs="anti_alt_enabled">
          <div class="sx-field"><label for="mp-aa">{dt('Minimum account age (days)')}</label><SxNumber id="mp-aa" name="anti_alt_min_age_days" value={automod.antiAltMinAgeDays} min="0" max="365" /></div>
          <div class="sx-field"><span class="sx-label">{dt('Action')}</span>
            <div class="sx-choices mp-choices-sm">
              {altActions.map(([value, label, icon]) => <label class="sx-choice"><input type="radio" name="anti_alt_action" value={value} checked={automod.antiAltAction === value} /><span class="sx-choice-body"><Icon name={icon} width="17" height="17" /><b>{label}</b></span></label>)}
            </div>
          </div>
        </div>
      </section>
    </div>

    <label class="sx-switch"><input type="checkbox" name="sticky_roles_enabled" checked={stickyRolesEnabled} /><span class="sx-panel-icon" style="--c:#a5ea7a"><Icon name="ph:link-fill" width="17" height="17" /></span><span class="sx-switch-text"><b>{dt('Sticky roles')}</b><em>{dt('If a member leaves and rejoins within 90 days, their roles (except managed ones, e.g. booster/bot roles) are automatically restored.')}</em></span><i class="sx-toggle"></i></label>

    <div class="sx-foot mp-foot"><button type="submit" class="btn btn-accent btn-sm">{dt('Save changes')}</button></div>
  </form>

  <h2 class="mp-related-title">{dt('More protection')}</h2>
  <div class="mp-links dgl-stagger">
    <a class="mp-link" href={`/dash/guild/${guildId}/antinuke`}>
      <span class="sx-panel-icon" style="--c:#f78fb3"><Icon name="ph:siren-fill" width="17" height="17" /></span>
      <span class="mp-link-text"><b>{dt('Anti-raid & nuke')}</b><em>{dt('Each protection (bans, channels, roles, bots, webhooks...) now has its own page with its own limit, action, trusted accounts and a log to restore what was stopped.')}</em></span>
      <Icon name="ph:arrow-right-bold" class="mp-link-go" width="14" height="14" />
    </a>
    <a class="mp-link" href={`/dash/guild/${guildId}/antiscam`}>
      <span class="sx-panel-icon" style="--c:#ff6b6b"><Icon name="ph:shield-warning-fill" width="17" height="17" /></span>
      <span class="mp-link-text"><b>{dt('Anti scam')}</b><em>{dt('Catches hijacked accounts that spam the MrBeast giveaway scam, fake withdrawals and casino promos.')}</em></span>
      <Icon name="ph:arrow-right-bold" class="mp-link-go" width="14" height="14" />
    </a>
    <a class="mp-link" href={`/dash/guild/${guildId}/automod`}>
      <span class="sx-panel-icon" style="--c:#ffb86c"><Icon name="ph:funnel-fill" width="17" height="17" /></span>
      <span class="mp-link-text"><b>{dt('AutoMod templates')}</b><em>{dt('Ready filters for links, invites, emojis, zalgo, scams and more, in Discord AutoMod or in Petto, with packs.')}</em></span>
      <Icon name="ph:arrow-right-bold" class="mp-link-go" width="14" height="14" />
    </a>
  </div>
  </div>
  )}

  {selectedSection === 'silent-channels' && (
  <div class:list={['md-section', showSection('silent-channels')]}>
    <h2><Fragment set:html={dth('Silent channels <span class="md-count">{a}</span>', { a: (silentChannels.length) })} /></h2>
    <p class="md-section-note">{dt('Any message here counts as a violation, independent of the word filter or anti-spam toggles.')}</p>
    {silentChannels.length === 0 && <p class="md-list-empty"><Icon name="ph:speaker-slash-fill" width="16" height="16" />{dt('No silent channels yet. Add one below.')}</p>}
    <div class="md-list-grid dgl-stagger">
      {silentChannels.map((s) => (
        <form method="POST" class="md-list-row" data-no-dirty>
          <input type="hidden" name="action" value="delete_silent_channel" />
          <input type="hidden" name="channel_id" value={s.channelId} />
          <span class="md-list-name">#{s.name}</span>
          <span class="md-list-tag">{s.action}</span>
          <button type="submit" class="md-list-del" aria-label={dt('Remove')} title={dt('Remove')}><Icon name="ph:trash-fill" width="13" height="13" /></button>
        </form>
      ))}
    </div>
    <form method="POST" class="md-add-row" data-no-dirty>
      <input type="hidden" name="action" value="add_silent_channel" />
      <select name="channel_id" required>
        <option value="" disabled selected>{dt('Channel')}</option>
        {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
      </select>
      <select name="silent_action">
        {['warn', 'mute', 'kick'].map((act) => <option value={act}>{act}</option>)}
      </select>
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button>
    </form>
  </div>
  )}

  {selectedSection === 'warn-escalation' && (
  <div class:list={['md-section', showSection('warn-escalation')]}>
    <h2><Fragment set:html={dth('Warn escalation <span class="md-count">{a}</span>', { a: (escalationRules.length) })} /></h2>
    <p class="md-section-note">{dt('At warning #N, automatically take an action, checked against the member\'s live active-warn count.')}</p>
    {escalationRules.length === 0 && <p class="md-list-empty"><Icon name="ph:list-checks-fill" width="16" height="16" />{dt('No steps yet. Add the first one below.')}</p>}
    <div class="md-list-grid dgl-stagger">
      {escalationRules.map((r) => (
        <form method="POST" class="md-list-row" data-no-dirty>
          <input type="hidden" name="action" value="delete_escalation" />
          <input type="hidden" name="warn_count" value={r.warnCount} />
          <span class="md-list-name">{dt('Warn #{a}', { a: (r.warnCount) })}</span>
          <span class="md-list-tag">{r.action}{r.durationMinutes ? ` (${r.durationMinutes}m)` : ''}</span>
          <button type="submit" class="md-list-del" aria-label={dt('Remove')} title={dt('Remove')}><Icon name="ph:trash-fill" width="13" height="13" /></button>
        </form>
      ))}
    </div>
    <form method="POST" class="md-add-row" data-no-dirty>
      <input type="hidden" name="action" value="add_escalation" />
      <input type="number" name="warn_count" placeholder={dt('Warn #')} min="1" max="50" required />
      <select name="esc_action">
        {['mute', 'tempmute', 'kick', 'ban'].map((act) => <option value={act}>{act}</option>)}
      </select>
      <input type="number" name="duration_minutes" placeholder={dt('Minutes (temp only)')} min="0" />
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button>
    </form>
  </div>
  )}

  {selectedSection === 'sanction-messages' && (
  <div class:list={['md-section', showSection('sanction-messages')]}>
    <h2>{dt('Sanction messages')}</h2>
    <p class="md-section-note">{dt('Use a saved design from the Embeds page for what a member receives, what is posted where the command was used, and the log entry. A type without its own design uses the Default row. Variables start with {case.…}, for example {case.reason} and {case.moderator}.')}</p>
    {!sanctionMessagesReady && <p class="md-empty-note">{dt('This arrives with the next Petto update.')}</p>}
    {sanctionMessagesReady && (
      <form method="POST" class="md-msg-form">
        <input type="hidden" name="action" value="save_sanction_messages" />
        <div class="md-msg-grid">
          <span class="md-msg-head"></span>
          <span class="md-msg-head">{dt('DM to the member')}</span>
          <span class="md-msg-head">{dt('Reply in the channel')}</span>
          <span class="md-msg-head">{dt('Sanctions log')}</span>
          {['default', 'ban', 'tempban', 'softban', 'unban', 'kick', 'mute', 'tempmute', 'unmute', 'warn', 'jail', 'unjail'].map((type) => (
            <div class="md-msg-row">
              <span class="md-msg-type" style={`--c:${typeColor[type] ?? 'var(--accent)'}`}>{type}</span>
              {(['dm', 'reply', 'log'] as const).map((slot) => (
                <label class="md-msg-slot">
                  <span class="md-msg-slot-name">{slot === 'dm' ? dt('DM to the member') : slot === 'reply' ? dt('Reply in the channel') : dt('Sanctions log')}</span>
                  <select name={`${type}__${slot}`} aria-label={`${type} ${slot}`}>
                    <option value="" selected={!sanctionTemplates[type]?.[slot]}>{type === 'default' ? dt('Usual message') : dt('Same as default')}</option>
                    {embedTemplateNames.map((name) => <option value={name} selected={name === sanctionTemplates[type]?.[slot]}>{name}</option>)}
                  </select>
                </label>
              ))}
            </div>
          ))}
        </div>
        <button type="submit" class="btn btn-accent btn-sm">{dt('Save changes')}</button>
      </form>
    )}
  </div>
  )}

  {selectedSection === 'active' && (
  <div class:list={['md-section', showSection('active')]}>
    <h2><Fragment set:html={dth('Active sanctions <span class="md-count">{a}</span>', { a: (activeSanctions.length) })} /></h2>
    {activeSanctions.length === 0 ? <p class="md-empty-note">{dt('Nothing is active right now.')}</p> : (
      <div class="md-case-list">
        {activeSanctions.map((c) => (
          <div class="md-case-row">
            <span class="md-case-num">#{c.caseNumber}</span>
            <span class="md-case-type" style={`--c:${typeColor[c.type] ?? '#94a3b8'}`}>{c.type}</span>
            <span class="md-case-person">
              {people[c.userId] ? <img src={people[c.userId].avatar} alt="" width="20" height="20" loading="lazy" /> : null}
              <span><b>{people[c.userId]?.name ?? c.userId}</b><code>{c.userId}</code></span>
            </span>
            <span class="md-case-by">{dt('by')} {people[c.moderatorId]?.name ?? c.moderatorId}</span>
            {c.expiresAt ? <time class="md-case-when" datetime={c.expiresAt} data-local-time>{c.expiresAt}</time> : <span class="md-case-when">{dt('No end')}</span>}
            {c.reason && <span class="md-case-reason">{c.reason}</span>}
            {c.type === 'hardban'
              ? <span class="md-case-inactive">{dt('Only the owner can lift it')}</span>
              : <button type="button" class="btn btn-ghost btn-sm md-lift" data-lift={c.caseNumber} data-lift-confirm={dt('Lift this sanction now?')} data-lift-error={dt('It could not be lifted.')}>{dt('Lift')}</button>}
          </div>
        ))}
      </div>
    )}
  </div>
  )}

  {selectedSection === 'stats' && (
  <div class:list={['md-section', showSection('stats')]}>
    <h2>{dt('Moderator stats')} <span class="md-count">{dt('last 30 days')}</span></h2>
    <div class="md-stat-strip">
      <div><b>{modStats.total}</b><span>{dt('Cases')}</span></div>
      <div><b>{modStats.total - modStats.automatic}</b><span>{dt('By moderators')}</span></div>
      <div><b>{modStats.automatic}</b><span>{dt('By the bot (automatic)')}</span></div>
    </div>
    <div class="md-bars" aria-label={dt('Cases in the last 14 days')}>
      {modStats.days.map((d) => <div class="md-bar" title={`${d.label}: ${d.count}`}><i style={`height:${Math.max(4, d.count / Math.max(1, ...modStats.days.map((x) => x.count)) * 100)}%`}></i><span>{d.label.slice(3)}</span></div>)}
    </div>
    <div class="md-stat-cols">
      <div>
        <h3>{dt('By kind')}</h3>
        {modStats.byType.length === 0 ? <p class="md-empty-note">{dt('Nothing yet.')}</p> : modStats.byType.map(([type, count]) => <div class="md-stat-line"><span class="md-case-type" style={`--c:${typeColor[type] ?? '#94a3b8'}`}>{type}</span><b>{count}</b></div>)}
      </div>
      <div>
        <h3>{dt('Moderators')}</h3>
        {modStats.moderators.length === 0 ? <p class="md-empty-note">{dt('Nothing yet.')}</p> : modStats.moderators.map((m) => <div class="md-stat-line"><span class="md-case-person">{people[m.userId] ? <img src={people[m.userId].avatar} alt="" width="20" height="20" loading="lazy" /> : null}<b>{people[m.userId]?.name ?? m.userId}</b></span><b>{m.count}</b></div>)}
      </div>
    </div>
  </div>
  )}

  {selectedSection === 'cases' && (
  <div class:list={['md-section', showSection('cases')]} data-case-log>
    <h2><Fragment set:html={caseFiltered ? dth('Cases found <span class="md-count">{a}</span>', { a: cases.length + (caseLog.older ? '+' : '') }) : dth('Recent cases <span class="md-count">{a}</span>', { a: cases.length + (caseLog.older ? '+' : '') })} /></h2>
    {caseMessage && <div class:list={['md-case-flash', { 'md-case-flash-err': caseMessage.kind === 'err' }]} role={caseMessage.kind === 'err' ? 'alert' : 'status'}>{caseMessage.text}</div>}
    {cases.length === 0 && !caseFiltered && !caseLog.failed ? (
      <div class="md-case-empty">
        <Icon name="ph:clipboard-text-fill" width="22" height="22" />
        <div>
          <p class="md-empty-note"><Fragment set:html={dth('No cases yet. They show up here the moment a mod uses <code>{p}ban</code>, <code>{p}kick</code>, <code>{p}mute</code> or <code>{p}warn</code>.', { p: prefix })} /></p>
          <p class="md-case-empty-more">{dt('Each case gets a number. Here you can search them, fix the reason of one or delete one that was a mistake; the change is written to the sanctions log.')}</p>
        </div>
      </div>
    ) : (
      <>
        {/* A plain form and plain links: they work without the dashboard's script, and with it they load only the content. */}
        <form method="GET" class="md-case-tools" data-case-tools data-no-dirty role="search">
          <input type="hidden" name="section" value="cases" />
          {caseLog.type && <input type="hidden" name="type" value={caseLog.type} />}
          {casesLimit !== 25 && <input type="hidden" name="cases" value={casesLimit} />}
          <div class="md-case-search-row">
            <input type="search" name="q" value={caseLog.q} maxlength="100" class="md-case-search" placeholder={dt('Search by member, moderator, reason or case number')} aria-label={dt('Search cases')} autocomplete="off" data-case-search data-dash-hold />
            <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:magnifying-glass-bold" width="12" height="12" />{dt('Search')}</button>
          </div>
          <p class="md-case-hint" data-case-hint hidden>{dt('Only the cases on this page are filtered as you type. Press Enter to search every case.')}</p>
          <nav class="md-case-types" aria-label={dt('Kind of case')}>
            <a href={caseLogHref({ q: caseLog.q, size: casesLimit })} class:list={['md-case-pill', { on: !caseLog.filter }]} aria-current={!caseLog.filter ? 'page' : undefined} data-case-pill>{dt('All')}</a>
            {Object.keys(CASE_FILTERS).map((key) => (
              <a href={caseLogHref({ type: key, q: caseLog.q, size: casesLimit })} class:list={['md-case-pill', { on: caseLog.filter === key }]} aria-current={caseLog.filter === key ? 'page' : undefined} style={`--c:${typeColor[key] ?? '#94a3b8'}`} title={CASE_FILTERS[key].join(', ')} data-case-pill>{key}</a>
            ))}
          </nav>
          {caseLog.type && caseLog.type !== caseLog.filter && <p class="md-case-hint">{dt('Only {a} cases.', { a: caseLog.type })}</p>}
        </form>
        {caseLog.failed && <p class="md-case-flash md-case-flash-err" role="alert">{dt('The cases could not be read. Try again in a moment.')}</p>}
        {cases.length > 0 && (
          <div class="md-case-list" data-case-list>
            {cases.map((c) => (
              <div class="md-case-row" data-type={c.type} data-case={c.caseNumber} data-reason={c.reason ?? ''} data-search={`${c.caseNumber} #${c.caseNumber} ${c.type} ${c.userId} ${c.moderatorId} ${people[c.userId]?.name ?? ''} ${people[c.moderatorId]?.name ?? ''} ${c.reason ?? ''}`.toLowerCase()}>
                <span class="md-case-num">#{c.caseNumber}</span>
                <span class="md-case-type" style={`--c:${typeColor[c.type] ?? '#94a3b8'}`}>{c.type}</span>
                <span class="md-case-person">
                  {people[c.userId] ? <img src={people[c.userId].avatar} alt="" width="20" height="20" loading="lazy" decoding="async" /> : null}
                  <span><b>{people[c.userId]?.name ?? c.userId}</b><code>{c.userId}</code></span>
                </span>
                <span class="md-case-by">{dt('by')} {people[c.moderatorId]?.name ?? c.moderatorId}</span>
                <time class="md-case-when" datetime={c.createdAt} data-local-time>{c.createdAt}</time>
                {c.reason && <span class="md-case-reason">{c.reason}</span>}
                {(c.evidence ?? []).length > 0 && <span class="md-case-evidence">{dt('Proof')}: {(c.evidence ?? []).map((url, i) => <a href={url} target="_blank" rel="noopener noreferrer">{i + 1}</a>)}</span>}
                {!c.active && <span class="md-case-inactive">{dt('expired')}</span>}
                {/* One edit form at a time: a form in every row (a textarea in a fold, 100 of them) made the page slow to draw. The link
                    works without the script (the page comes back with the form of that case open); with it, the form is put in place
                    from the template below. */}
                <a class:list={['md-case-edit', { on: editCase === c.caseNumber }]} href={caseLogHref({ type: caseLog.type, q: caseLog.q, size: casesLimit, before: caseLog.before, edit: c.caseNumber })} data-case-edit={c.caseNumber} aria-expanded={editCase === c.caseNumber ? 'true' : 'false'}><Icon name="ph:pencil-simple-fill" width="12" height="12" />{dt('Edit')}</a>
                {editCase === c.caseNumber && (
                  <form method="POST" class="md-case-form" data-no-dirty data-dash-hold data-case-form>
                    <input type="hidden" name="case" value={c.caseNumber} />
                    <label><span>{dt('Reason of case #{a}', { a: c.caseNumber })}</span>
                      <textarea name="reason" rows="2" maxlength="1000" required placeholder={dt('Why this sanction was given')}>{c.reason ?? ''}</textarea>
                    </label>
                    <div class="md-case-form-actions">
                      <button type="submit" name="action" value="case_edit" class="btn btn-accent btn-sm">{dt('Save reason')}</button>
                      <button type="submit" name="action" value="case_delete" class="btn btn-ghost btn-sm md-case-delete" formnovalidate data-confirm={dt('Delete case #{a}? It disappears from the history of the member, and a deleted warning stops counting for warn escalation. The sanction itself is not lifted.', { a: c.caseNumber })}><Icon name="ph:trash-fill" width="12" height="12" />{dt('Delete case')}</button>
                      <a class="btn btn-ghost btn-sm" href={caseLogHref({ type: caseLog.type, q: caseLog.q, size: casesLimit, before: caseLog.before })} data-case-edit-close>{dt('Cancel')}</a>
                    </div>
                  </form>
                )}
              </div>
            ))}
          </div>
        )}
        {cases.length > 0 && (
          <template data-case-form-template>
            <form method="POST" class="md-case-form" data-no-dirty data-dash-hold data-case-form>
              <input type="hidden" name="case" value="" />
              <label><span data-case-label={dt('Reason of case #{a}', { a: '{n}' })}></span>
                <textarea name="reason" rows="2" maxlength="1000" required placeholder={dt('Why this sanction was given')}></textarea>
              </label>
              <div class="md-case-form-actions">
                <button type="submit" name="action" value="case_edit" class="btn btn-accent btn-sm">{dt('Save reason')}</button>
                <button type="submit" name="action" value="case_delete" class="btn btn-ghost btn-sm md-case-delete" formnovalidate data-case-confirm={dt('Delete case #{a}? It disappears from the history of the member, and a deleted warning stops counting for warn escalation. The sanction itself is not lifted.', { a: '{n}' })}><Icon name="ph:trash-fill" width="12" height="12" />{dt('Delete case')}</button>
                <button type="button" class="btn btn-ghost btn-sm" data-case-edit-close>{dt('Cancel')}</button>
              </div>
            </form>
          </template>
        )}
        <p class="md-case-none" data-case-none hidden={cases.length > 0 || caseLog.failed}>{dt('No case matches that.')}{caseFiltered && <> <a href={caseLogHref({ size: casesLimit })}>{dt('Show every case')}</a></>}</p>
        {(caseLog.before || caseLog.older) && (
          <div class="md-case-pager">
            {caseLog.before && <a class="btn btn-ghost btn-sm" href={caseLogHref({ type: caseLog.type, q: caseLog.q, size: casesLimit })}><Icon name="ph:arrow-left-bold" width="12" height="12" />{dt('Newest cases')}</a>}
            {caseLog.older && casesLimit < 100 && <a class="btn btn-ghost btn-sm" href={caseLogHref({ type: caseLog.type, q: caseLog.q, size: nextCasesLimit, before: caseLog.before })}>{dt('Show more cases')}</a>}
            {caseLog.older && lastCaseNumber && <a class="btn btn-ghost btn-sm" href={caseLogHref({ type: caseLog.type, q: caseLog.q, size: casesLimit, before: lastCaseNumber })}>{dt('Older cases')}<Icon name="ph:arrow-right-bold" width="12" height="12" /></a>}
          </div>
        )}
      </>
    )}
  </div>
  )}

  <script is:inline>
    // Inside the content, so it also runs when the page is reached from the menu (the dashboard runs the scripts of the content it
    // draws; a script after the layout only ran on a full load, and then the Lift button and the case search did nothing).
    // The listeners are on the document and bound once; what depends on the drawn page runs on every draw.
    (function () {
      if (!window.__mdCasesBound) {
        window.__mdCasesBound = true;
        // Typing filters the cases already on the page at once; Enter (or Search) asks the server, which searches every case.
        var filterRows = function (input) {
          var log = input.closest('[data-case-log]');
          if (!log) return;
          var q = (input.value || '').trim().toLowerCase();
          var local = q !== (input.defaultValue || '').trim().toLowerCase();
          var shown = 0;
          log.querySelectorAll('[data-case-list] .md-case-row').forEach(function (row) {
            var ok = !local || !q || (row.getAttribute('data-search') || '').indexOf(q) !== -1;
            row.hidden = !ok;
            if (ok) shown += 1;
          });
          var none = log.querySelector('[data-case-none]');
          if (none) none.hidden = shown !== 0;
          var hint = log.querySelector('[data-case-hint]');
          if (hint) hint.hidden = !local || !q;
        };
        document.addEventListener('input', function (event) {
          var target = event.target;
          if (target && target.matches && target.matches('[data-case-search]')) filterRows(target);
        });
        document.addEventListener('submit', function (event) {
          var form = event.target;
          if (!form || !form.matches || !form.matches('[data-case-tools]') || !window.dglNavigate) return;
          event.preventDefault();
          var params = new URLSearchParams(new FormData(form));
          if (!String(params.get('q') || '').trim()) params.delete('q');
          window.dglNavigate('?' + params.toString());
        });
        // The edit form of a case, put in its row from the template (one form on the page at a time). While it is open the
        // dashboard does not redraw the page for a live update (data-dash-hold), so what is typed stays.
        var closeEditor = function (form) {
          var row = form.closest('.md-case-row');
          var link = row && row.querySelector('[data-case-edit]');
          if (link) { link.classList.remove('on'); link.setAttribute('aria-expanded', 'false'); }
          form.remove();
        };
        var openEditor = function (row) {
          var log = row.closest('[data-case-log]');
          var template = log && log.querySelector('template[data-case-form-template]');
          if (!template) return false;
          log.querySelectorAll('[data-case-list] [data-case-form]').forEach(closeEditor);
          var number = row.getAttribute('data-case');
          var form = template.content.firstElementChild.cloneNode(true);
          form.querySelector('input[name=case]').value = number;
          var label = form.querySelector('[data-case-label]');
          label.textContent = label.getAttribute('data-case-label').replace('{n}', number);
          var area = form.querySelector('textarea');
          area.defaultValue = row.getAttribute('data-reason') || '';
          var del = form.querySelector('[data-case-confirm]');
          del.setAttribute('data-confirm', del.getAttribute('data-case-confirm').replace('{n}', number));
          row.appendChild(form);
          var link = row.querySelector('[data-case-edit]');
          if (link) { link.classList.add('on'); link.setAttribute('aria-expanded', 'true'); }
          if (window.dglInitContent) window.dglInitContent(row);
          area.focus();
          area.setSelectionRange(area.value.length, area.value.length);
          return true;
        };
        // Capture: these run before the dashboard's own handling of the links (which would load the page).
        document.addEventListener('click', function (event) {
          var target = event.target;
          if (!target || !target.closest || !target.closest('#dgl-content [data-case-log]')) return;
          var edit = target.closest('[data-case-edit]');
          if (edit) {
            var row = edit.closest('.md-case-row');
            var open = row && row.querySelector('[data-case-form]');
            if (open) { event.preventDefault(); event.stopPropagation(); closeEditor(open); return; }
            if (row && openEditor(row)) { event.preventDefault(); event.stopPropagation(); }
            return;
          }
          var close = target.closest('[data-case-edit-close]');
          if (close) {
            var form = close.closest('[data-case-form]');
            if (form) { event.preventDefault(); event.stopPropagation(); closeEditor(form); }
            return;
          }
          // A kind chosen while words are typed but not searched yet: the words go with it.
          var pill = target.closest('[data-case-pill]');
          if (pill) {
            var input = document.querySelector('#dgl-content [data-case-search]');
            if (input && input.value !== input.defaultValue) {
              var url = new URL(pill.getAttribute('href'), window.location.href);
              if (input.value.trim()) url.searchParams.set('q', input.value.trim()); else url.searchParams.delete('q');
              pill.setAttribute('href', url.search);
            }
          }
        }, true);
        document.addEventListener('click', function (event) {
          var target = event.target;
          // The Lift button of the active sanctions: the bot lifts it and the page is read again.
          var btn = target && target.closest ? target.closest('[data-lift]') : null;
          if (!btn) return;
          if (!window.confirm(btn.getAttribute('data-lift-confirm') || 'Lift this sanction now?')) return;
          var guild = window.location.pathname.split('/dash/guild/')[1].split('/')[0];
          var failed = btn.getAttribute('data-lift-error') || 'It could not be lifted.';
          var say = function (text) { if (window.dglToast) window.dglToast(text, { kind: 'error' }); else window.alert(text); };
          btn.disabled = true;
          fetch('/dash/guild/' + guild + '/moderation-api', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ case: Number(btn.getAttribute('data-lift')) }) })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (data && data.ok) { if (window.dglRefreshPage) window.dglRefreshPage(true); else window.location.reload(); }
              else { say((data && data.message) || failed); btn.disabled = false; }
            })
            .catch(function () { say(failed); btn.disabled = false; });
        });
      }
      document.querySelectorAll('#dgl-content time[data-local-time]').forEach(function (t) {
        var d = new Date(t.getAttribute('datetime'));
        if (!isNaN(d.getTime())) t.textContent = d.toLocaleString();
      });
    })();
  </script>
</DashGuildLayout>

<style>
  .mp-block { padding: 18px; }
  .mp-subs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 24px; }
  .mp-subs > .mp-wide { grid-column: 1 / -1; }
  @media (max-width: 720px) { .mp-subs { grid-template-columns: 1fr; } }
  .mp-body { display: flex; flex-direction: column; gap: 14px; }
  .mp-choices-sm { grid-template-columns: repeat(auto-fit, minmax(96px, 1fr)); }
  .mp-foot { justify-content: flex-end; }
  .mp-form .sx-switch > .sx-panel-icon { width: 32px; height: 32px; }
  .mp-related-title { font-size: 16px; margin: 26px 0 12px; }
  .mp-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin-bottom: 40px; }
  .mp-link { display: flex; align-items: flex-start; gap: 12px; text-decoration: none; color: inherit; border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 15px 16px; min-width: 0; transition: background-color .3s ease, border-color .3s ease; }
  .mp-link:hover { background: var(--card-hover); border-color: color-mix(in srgb, var(--accent) 35%, var(--border)); }
  .mp-link:active { background: color-mix(in srgb, var(--text) 10%, transparent); transform: none; filter: none; }
  .mp-link-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .mp-link-text b { font-size: 14px; }
  .mp-link-text em { font-style: normal; font-size: 12.5px; line-height: 1.45; color: var(--text-dim); }
  .mp-link :global(.mp-link-go) { flex: none; margin-top: 8px; color: var(--text-dim); transition: transform .35s cubic-bezier(.22, 1, .36, 1), color .25s ease; }
  .mp-link:hover :global(.mp-link-go) { color: var(--accent); transform: translateX(3px); }
  .md-case-tools { display: flex; flex-direction: column; gap: 10px; margin-bottom: 12px; max-width: 760px; }
  .md-case-search { width: 100%; box-sizing: border-box; padding: 9px 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg-raise); color: var(--text); font: 13px var(--sans); }
  .md-case-types { display: flex; flex-wrap: wrap; gap: 6px; }
  .md-case-search-row { display: flex; gap: 8px; align-items: center; }
  .md-case-search-row .md-case-search { flex: 1; min-width: 0; }
  .md-case-search-row .btn { display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0; }
  .md-case-hint { margin: 0; font-size: 12px; color: var(--text-dim); }
  .md-case-pill { display: inline-block; text-decoration: none; border: 1px solid var(--border); background: transparent; color: var(--text-muted); border-radius: 999px; padding: 4px 11px; font: 600 11.5px var(--sans); cursor: pointer; text-transform: capitalize; }
