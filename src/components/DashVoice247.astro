---
// Stay in voice: the voice channel Petto stays in for good, the status written on that channel, whether it joins with the sound off, and the switch. One form, one Save.
// The bot looks at it every minute (and brings Petto back after a restart), so a change is done within about a minute.
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import ChannelOptions from './ChannelOptions.astro';
import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string; guildName: string; guildIcon: string;
  row: { channelId: string; status: string; deaf: boolean; enabled: boolean } | null;
  channels: { id: string; name: string; category?: string }[];
  ready: boolean; saved: boolean; problem: string | null; maxStatus: number;
}
const { user, guildId, guildName, guildIcon, row, channels, ready, saved, problem, maxStatus } = Astro.props;
const defaultStatus = dashLang === 'es' ? 'Viendo el servidor 24/7' : dashLang === 'pt-BR' ? 'Vendo o servidor 24/7' : 'Watching the server 24/7';
const chosen = row ? channels.find((channel) => channel.id === row.channelId) : null;
const docsUrl = `https://wiki.petto.sbs${dashLang === 'es' ? '/es' : dashLang === 'pt-BR' ? '/pt-br' : ''}/utility/247`;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="voice-247" pageTitle="Stay in voice">
  <DashSettingsKit />
  <div class="sx-page sv">
    <div class="sv-head">
      <h1>{dt('Stay in voice')}</h1>
      <a class="btn btn-sm" href={docsUrl} target="_blank" rel="noopener"><Icon name="ph:book-open-fill" width="13" height="13" />{dt('Read the docs')}</a>
    </div>
    <p class="sx-lead">{dt('Petto joins a voice channel and stays there for good, also after it restarts, with a status written on the channel. It joins muted. If music is playing in the server, it waits and comes back when the music is over.')}</p>

    {saved && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved. Petto does it within a minute.')}</div>}
    {problem && <div class="sx-flash sx-flash-bad" role="alert"><Icon name="ph:warning-fill" width="15" height="15" />{problem}</div>}
    {!ready && <div class="sx-flash sx-flash-warn"><Icon name="ph:plug-fill" width="15" height="15" />{dt('Stay in voice is not available yet. Petto is being updated: try again in a few minutes.')}</div>}

    <form method="POST" class="sx-panel sv-box">
      <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--green)"><Icon name="ph:microphone-fill" width="17" height="17" /></span><h2>{dt('Voice channel')}</h2>{row && <span class:list={['sx-tag', 'sv-state', { 'sv-on': row.enabled }]}>{row.enabled ? dt('On') : dt('Off')}</span>}</div>

      <label class="sx-switch sv-switch"><input type="checkbox" name="enabled" role="switch" checked={row ? row.enabled : true} disabled={!ready} /><span class="sx-toggle"></span><span>{dt('Stay in the channel')}</span></label>

      <div class="sx-field"><label for="sv-channel">{dt('Channel')}</label>
        <select id="sv-channel" name="channel_id" required disabled={!ready}>
          <option value="" disabled selected={!chosen}>{dt('Pick a voice channel')}</option>
          <ChannelOptions channels={channels} selected={row?.channelId ?? ''} />
        </select>
        {channels.length === 0 && <p class="sx-hint">{dt('This server has no voice channels yet.')}</p>}
      </div>

      <div class="sx-field"><label for="sv-status">{dt('Status of the channel')}</label>
        <input id="sv-status" type="text" name="status" maxlength={maxStatus} value={row?.status ?? ''} placeholder={defaultStatus} disabled={!ready} />
        <p class="sx-hint">{dt('Shown under the name of the channel. Leave it empty for "{text}".', { text: defaultStatus })}</p>
      </div>

      <label class="sx-switch sv-switch"><input type="checkbox" name="deaf" role="switch" checked={row ? row.deaf : true} disabled={!ready} /><span class="sx-toggle"></span><span>{dt('Join with the sound off')}</span></label>

      <p class="sx-hint sv-perm"><Icon name="ph:info-fill" width="14" height="14" />{dt('Petto needs View Channel and Connect in the channel, and Set Voice Channel Status to write the status. Without that last one it stays in and leaves the status empty.')}</p>
      <div class="sx-foot"><button type="submit" class="btn btn-accent btn-sm" disabled={!ready}><Icon name="ph:floppy-disk-fill" width="13" height="13" />{dt('Save')}</button></div>
    </form>
  </div>
  <DashFormKit />
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0; }
  .sv { max-width: 720px; }
  .sv-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
  .sv :global(.sx-lead) { margin-bottom: 16px; }
  .sv-box { gap: 14px; }
  .sv :global(.sx-field input[type=text]) { border: 1px solid var(--border); border-radius: 9px; padding: 9px 11px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; width: 100%; box-sizing: border-box; min-width: 0; transition: border-color .25s ease, box-shadow .25s ease; }
  .sv-state { margin-left: auto; }
  .sv-state.sv-on { color: var(--green); }
  .sv-perm { display: flex; align-items: flex-start; gap: 8px; margin: 0; }
  .sv-perm :global(svg) { flex: none; margin-top: 2px; color: var(--text-dim); }
</style>
