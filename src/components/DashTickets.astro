---
import SilentMentionHint from './SilentMentionHint.astro';
import EmojiPicker from './EmojiPicker.astro';
import ColorPicker from './ColorPicker.astro';
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashAcData from './DashAcData.astro';
import MultiSelect from './MultiSelect.astro';
import SelectSource from './SelectSource.astro';
import SelectChosen from './SelectChosen.astro';
import TicketFieldsBuilder from './TicketFieldsBuilder.astro';
import TicketEmoji from './TicketEmoji.astro';
import DashFormKit from './DashFormKit.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import TicketGuide from './TicketGuide.astro';
import TicketPanelPreview from './TicketPanelPreview.astro';
import TicketLive from './TicketLive.astro';
import { minutesText, type TicketStats } from '../utils/ticketStats';

import DurationScript from './DurationScript.astro';
import { dashLocale, getDashLang, makeT } from '../i18n/dash';
import { FREE_LIMITS, PREMIUM_LIMITS, planLimits } from '../utils/planLimits';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface TicketCategory {
  id: number;
  panelId: number | null;
  key: string;
  label: string;
  emoji: string | null;
  description: string | null;
  buttonStyle: string;
  namingPattern: string;
  welcomeMessage?: string;
  welcomeSupported?: boolean;
  parentChannelId: string | null;
  supportRoleIds: string[];
  pingRoleIds: string[];
  maxOpenPerUser: number;
  formId: number | null;
  requiredRoleIds: string[];
}
interface TicketForm { id: number; name: string; title: string; fields: unknown[]; }
interface TicketBlacklistEntry { id: number; target_type: string; target_id: string; reason: string | null; name?: string | null; avatar?: string | null; }
interface Panel {
  id: number;
  channelId: string;
  messageId: string | null;
  title: string | null;
  description: string | null;
  style: string;
  embedTemplate: string | null;
  color: string;
  imageUrl: string;
  footer: string;
  placeholder: string;
  categoryCount: number;
  types: { label: string; emoji: string | null; description?: string | null; buttonStyle?: string }[];
}
interface TicketSettings {
  claimMode: string;
  pingOnClaim: boolean;
  rolesToAddOnClaim: string[];
  closeRequiresSupportRole: boolean;
  closeRequiresReason: boolean;
  hideClosingUser: boolean;
  dmUserOnClose: boolean;
  defaultCloseReason: string;
  logStaffMessageCounts: boolean;
  autocloseLeave: boolean;
  autocloseInactivityEnabled: boolean;
  autocloseInactivityHours: number;
  ratingEnabled: boolean;
  ratingMode: string;
  ratingLogChannelId: string;
  openedLogChannelId: string;
  closedLogChannelId: string;
  transcriptChannelId: string;
  transcriptMode: string;
  blockedRoleIds: string[];
  globalLimit: number;
  unclaimedReminderMinutes: number;
  autoDeleteClosedHours: number;
  hoursEnabled: boolean;
  hoursTimezone: string;
  hoursStart: string;
  hoursEnd: string;
  hoursDays: number[];
  hoursBlock: boolean;
  hoursMessage: string;
}
interface OpenTicket {
  id: number;
  ticketNumber: number;
  categoryLabel: string;
  openerId: string;
  claimedBy: string | null;
  channelId: string | null;
}

interface Props {
  customEmojis?: { id: string; name: string; animated: boolean }[];
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  categories: TicketCategory[];
  panels: Panel[];
  settings: TicketSettings;
  roles: { id: string; name: string }[];
  channelCategories: { id: string; name: string }[];
  textChannels: { id: string; name: string }[];
  embedTemplateNames: string[];
  forms: TicketForm[];
  blacklist: TicketBlacklistEntry[];
  openTickets: OpenTicket[];
  closedTickets?: { number: number; openerId: string; openerName?: string | null; openerAvatar?: string | null; closedAt: string | null; reason: string; categoryLabel: string }[];
  viewOnly?: boolean;
  me?: string;
  quickReplies?: { name: string; content: string }[];
  stats?: TicketStats | null;
  premiumActive: boolean;
  saved: boolean;
  error?: string | null;
  warnings?: string[];
  section?: string;
}
const { user, guildId, guildName, guildIcon, customEmojis = [], categories, panels, settings, roles, channelCategories, textChannels, embedTemplateNames, forms, blacklist, openTickets, closedTickets = [], quickReplies = [], stats = null, saved, error, warnings = [], premiumActive, section, viewOnly = false, me = '' } = Astro.props;
const sectionMeta: Record<string, string> = { panels: dt('Ticket panels'), types: dt('Support types'), forms: dt('Ticket forms'), access: dt('Ticket access'), settings: dt('Ticket settings'), replies: dt('Quick replies'), open: dt('Live tickets') };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'panels';
const selectedTitle = sectionMeta[selectedSection];
function channelName(id: string | null) {
  return textChannels.find((c) => c.id === id)?.name ?? id;
}
const ticketCategoryLimit = planLimits(premiumActive).ticketCategories;
const ticketCategoryAtLimit = categories.length >= ticketCategoryLimit;
const postedCount = panels.filter((p) => p.messageId).length;
const showGuide = ['panels', 'types', 'settings'].includes(selectedSection);
const buttonStyles = [
  { value: 'primary', label: dt('Blue (main)'), color: '#5865f2' },
  { value: 'secondary', label: dt('Gray'), color: '#80848e' },
  { value: 'success', label: dt('Green'), color: '#23a559' },
  { value: 'danger', label: dt('Red'), color: '#f23f43' },
];
// Ready designs for a new panel: pressing one fills the form below, and everything can still be changed.
const presets = [
  { id: 'classic', name: dt('Classic support'), icon: 'ph:ticket-fill', color: '#a5ea7a', style: 'button', title: dt('Support'), description: dt('Press a button to open a ticket. Our team will answer you as soon as possible.'), footer: dt('One ticket per topic, please.'), placeholder: '' },
  { id: 'help', name: dt('Help center (dropdown)'), icon: 'ph:list-bullets-fill', color: '#ffb86c', style: 'select', title: dt('Help center'), description: dt('Choose a category from the menu and a private channel opens with the staff.'), footer: dt('Replies can take a few minutes.'), placeholder: dt('Choose the type of ticket...') },
  { id: 'reports', name: dt('Reports'), icon: 'ph:flag-fill', color: '#ff6b6b', style: 'button', title: dt('Report a problem'), description: dt('Tell us about a member, a bug or something that is not right. Include proof if you have it.'), footer: dt('Only the staff can see your ticket.'), placeholder: '' },
  { id: 'apply', name: dt('Applications'), icon: 'ph:hand-waving-fill', color: '#f78fb3', style: 'button', title: dt('Join the team'), description: dt('Want to help? Open a ticket and answer a few questions so we can get to know you.'), footer: dt('We read every application.'), placeholder: '' },
  { id: 'minimal', name: dt('Minimal'), icon: 'ph:minus-circle-fill', color: '#ffd563', style: 'button', title: dt('Tickets'), description: dt('Press a button to talk to the staff.'), footer: '', placeholder: '' },
];
// The variables each section's hints name, offered first by the typed autocomplete of that section.
const ticketVars: Record<string, { tok: string; desc: string }[]> = {
  types: [{ tok: '{number}', desc: dt('Number of the ticket') }, { tok: '{username}', desc: dt('Name of the member') }, { tok: '{userid}', desc: dt('ID of the member') }, { tok: '{category}', desc: dt('Type of the ticket') }],
  settings: [{ tok: '{start}', desc: dt('When the staff hours start') }, { tok: '{end}', desc: dt('When the staff hours end') }, { tok: '{timezone}', desc: dt('Time zone of the staff hours') }],
  replies: [{ tok: '{username}', desc: dt('Name of the member') }, { tok: '{category}', desc: dt('Type of the ticket') }, { tok: '{server}', desc: dt('Name of the server') }, { tok: '{number}', desc: dt('Number of the ticket') }],
};
const hourDays = [
  { n: 1, label: dt('Mon') }, { n: 2, label: dt('Tue') }, { n: 3, label: dt('Wed') }, { n: 4, label: dt('Thu') }, { n: 5, label: dt('Fri') }, { n: 6, label: dt('Sat') }, { n: 0, label: dt('Sun') },
];
const timezones = ['America/Bogota', 'America/Mexico_City', 'America/Lima', 'America/Argentina/Buenos_Aires', 'America/Santiago', 'America/Sao_Paulo', 'America/New_York', 'America/Los_Angeles', 'Europe/Madrid', 'Europe/London', 'UTC'];
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'panels' ? 'tickets' : `tickets-${selectedSection}`} pageTitle={selectedTitle}>
  <h1>{selectedTitle}{selectedSection === 'open' && <span class="tk-live-badge"><i aria-hidden="true"></i>{dt('Live')}</span>}</h1>
  {['panels', 'types', 'settings', 'replies', 'open'].includes(selectedSection) && <DashAcData roles={roles} channels={textChannels} emojis={customEmojis} vars={ticketVars[selectedSection]} />}
  <DashFormKit />
  <DashSettingsKit />
  <DurationScript />
  {selectedSection === 'panels' && <DashStatTiles tiles={[
    { label: dt('Panels'), value: panels.length, tone: 'messages' },
    { label: dt('Posted'), value: postedCount, tone: 'joins' },
    { label: dt('Support types'), value: categories.length, tone: 'invites' },
    { label: dt('Open tickets'), value: openTickets.length, tone: 'voice' },
  ]} />}
  {showGuide && <TicketGuide guildId={guildId} section={selectedSection} typeCount={categories.length} panelCount={panels.length} postedCount={postedCount} />}

  {saved && <div class="tk-flash tk-flash-ok"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {warnings.map((w) => <div class="tk-flash tk-flash-warn"><Icon name="ph:info-fill" width="15" height="15" />{w}</div>)}
  {error && <div class="tk-flash tk-flash-err" role="alert"><Icon name="ph:warning-fill" width="15" height="15" />{error}</div>}

  {selectedSection === 'panels' && (
  <div class:list={['tk-section', { 'tk-section-hidden': selectedSection !== 'panels' }]}>
    <h2><Icon name="ph:squares-four-fill" width="15" height="15" /><Fragment set:html={dth('Panels <span class="tk-count">{a}</span>', { a: (panels.length) })} /></h2>
    <p class="tk-section-note">{dt('The message members use to open a ticket: a card with buttons or a dropdown. Saving posts it or updates it in the same place; moving posts a new one in the new channel.')}</p>
    {panels.length === 0 && <p class="tk-empty-note"><Icon name="ph:squares-four-fill" width="15" height="15" />{dt('No panels yet. Pick a ready design below to start.')}</p>}

    <div class="tk-panel-grid dgl-stagger">
      {panels.map((p) => (
        <div class="tk-panel-card">
          <form method="POST" class="tk-panel-form" data-panel-form>
            <input type="hidden" name="action" value="update_panel" />
            <input type="hidden" name="panel_id" value={p.id} />
            <div class="tk-panel-head">
              <span class="tk-panel-chan">#{channelName(p.channelId)}</span>
              {p.messageId
                ? <a class="tk-chip tk-chip-ok" href={`https://discord.com/channels/${guildId}/${p.channelId}/${p.messageId}`} target="_blank" rel="noopener"><Icon name="ph:check-circle-fill" width="12" height="12" />{dt('Posted')} · {dt('Open in Discord')}</a>
                : <span class="tk-chip tk-chip-warn"><Icon name="ph:warning-fill" width="12" height="12" />{dt('Not posted yet. Press Resend.')}</span>}
              {p.embedTemplate && <span class="tk-chip">{dt('Design')}: {p.embedTemplate}</span>}
            </div>
            <div class="tk-panel-body">
            <div class="tk-fields">
              <div class="tk-cat-row dfx-field"><label>{dt('Title')}</label><textarea name="title" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count data-ac="vars,emojis" maxlength="100" placeholder={dt('Panel title')}>{p.title ?? ''}</textarea></div>
              <div class="tk-cat-row dfx-field"><label>{dt('Description')}</label><textarea name="description" class="dgl-autogrow" data-count data-ac rows="3" maxlength="500" placeholder={dt('Panel description')}>{p.description ?? ''}</textarea></div>
              <div class="tk-two">
                <div class="tk-cat-row dfx-field"><label>{dt('Style')}</label>
                  <select name="style">
                    <option value="button" selected={p.style === 'button'}>{dt('Buttons (max 5 types)')}</option>
                    <option value="select" selected={p.style === 'select'}>{dt('Dropdown (up to 25 types)')}</option>
                  </select>
                </div>
                <div class="tk-cat-row dfx-field"><label>{dt('Card color')}</label>
                  <ColorPicker name="color" value={p.color || ''} label={dt('Card color')} allowNone />
                </div>
              </div>
              <div class="tk-cat-row dfx-field"><label>{dt('Picture on top')}</label><input type="url" name="image_url" value={p.imageUrl} maxlength="500" placeholder="https://..." /><p class="tk-row-hint">{dt('A banner. The link has to start with https.')}</p></div>
              <div class="tk-cat-row dfx-field"><label>{dt('Small text under the panel')}</label><textarea name="footer" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count data-ac="vars,emojis" maxlength="300" placeholder={dt('Optional')}>{p.footer}</textarea></div>
              <div class="tk-cat-row dfx-field" data-only-select><label>{dt('Text of the dropdown')}</label><input type="text" name="placeholder" data-ac="vars,emojis" value={p.placeholder} maxlength="150" placeholder={dt('Select a ticket category...')} /></div>
              {embedTemplateNames.length > 0 && (
                <div class="tk-cat-row dfx-field"><label>{dt('Saved design')}</label>
                  <select name="embed_template" data-dp-template-only>
                    <option value="">{dt('None: use the fields above')}</option>
                    {embedTemplateNames.map((n) => <option value={n} selected={n === p.embedTemplate}>{n}</option>)}
                  </select>
                  <p class="tk-row-hint">{dt('A design made in Embeds replaces the card above.')}</p>
                </div>
              )}
            </div>
            <TicketPanelPreview title={p.title} description={p.description} color={p.color} imageUrl={p.imageUrl} footer={p.footer} style={p.style} placeholder={p.placeholder} types={p.types} design={p.embedTemplate} />
            </div>
            <p class:list={['tk-panel-cats', { 'tk-panel-cats-empty': p.categoryCount === 0 }]}>{p.categoryCount === 0 ? dt('No types on this panel yet. Add one in Support types and pick this panel.') : dt('{n} types on this panel', { n: p.categoryCount })}</p>
            <div class="tk-panel-actions">
              <button type="submit" name="action" value="update_panel" class="btn btn-accent btn-sm">{dt('Save and update the message')}</button>
            </div>
          </form>
          <details class="tk-more">
            <summary>{dt('Move, resend or delete')}</summary>
            <form method="POST" class="tk-panel-move" data-no-dirty>
              <input type="hidden" name="action" value="move_panel" />
              <input type="hidden" name="panel_id" value={p.id} />
              <select name="channel_id" data-fill="tk-ch">
                <SelectChosen items={textChannels} selected={p.channelId} prefix="#" />
              </select>
              <button type="submit" name="action" value="move_panel" class="btn btn-ghost btn-sm">{dt('Move')}</button>
            </form>
            <div class="tk-panel-actions">
              <form method="POST" data-no-dirty><input type="hidden" name="action" value="resend_panel" /><input type="hidden" name="panel_id" value={p.id} /><button type="submit" name="action" value="resend_panel" class="btn btn-ghost btn-sm" data-confirm={dt('Resend this panel? The message in Discord is deleted and posted again.')}>{dt('Resend')}</button></form>
              <form method="POST" data-no-dirty><input type="hidden" name="action" value="delete_panel" /><input type="hidden" name="panel_id" value={p.id} /><button type="submit" name="action" value="delete_panel" class="tk-cat-del" title={dt('Delete this panel')} data-confirm={dt('Delete this panel? Its message in Discord is deleted too. Ticket types stay, but are no longer on a panel.')} formnovalidate><Icon name="ph:trash-fill" width="14" height="14" /></button></form>
            </div>
          </details>
        </div>
      ))}
    </div>

    <div class="tk-new-panel">
      <h2><Icon name="ph:plus-circle-fill" width="15" height="15" />{dt('New panel')}</h2>
      <p class="tk-section-note">{dt('Pick a ready design. It fills the form: you can change anything before posting.')}</p>
      <div class="tk-presets" data-presets>
        {presets.map((pr) => (
          <button type="button" class="tk-preset" data-preset={pr.id} data-title={pr.title} data-description={pr.description} data-color={pr.color} data-style={pr.style} data-footer={pr.footer} data-placeholder={pr.placeholder} style={`--pc:${pr.color}`}>
            <Icon name={pr.icon} width="16" height="16" /><span>{pr.name}</span>
          </button>
        ))}
      </div>
      <div class="tk-new-grid">
        <form method="POST" class="tk-panel-form tk-new-form" data-panel-form data-new-panel data-no-dirty>
          <input type="hidden" name="action" value="create_panel" />
          <div class="tk-fields">
            <div class="tk-cat-row dfx-field"><label>{dt('Channel')}</label>
              <select name="channel_id" required data-fill="tk-ch">
                <option value="" disabled selected>{dt('Choose where to post it')}</option>
                
              </select>
            </div>
            <div class="tk-cat-row dfx-field"><label>{dt('Title')}</label><textarea name="title" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count data-ac="vars,emojis" maxlength="100" placeholder={dt('Panel title')}></textarea></div>
            <div class="tk-cat-row dfx-field"><label>{dt('Description')}</label><textarea name="description" class="dgl-autogrow" data-count data-ac rows="3" maxlength="500" placeholder={dt('Panel description')}></textarea></div>
            <div class="tk-two">
              <div class="tk-cat-row dfx-field"><label>{dt('Style')}</label>
                <select name="style"><option value="button">{dt('Buttons (max 5 types)')}</option><option value="select">{dt('Dropdown (up to 25 types)')}</option></select>
              </div>
              <div class="tk-cat-row dfx-field"><label>{dt('Card color')}</label>
                <ColorPicker name="color" value="" label={dt('Card color')} allowNone />
              </div>
            </div>
            <div class="tk-cat-row dfx-field"><label>{dt('Picture on top')}</label><input type="url" name="image_url" maxlength="500" placeholder="https://..." /></div>
            <div class="tk-cat-row dfx-field"><label>{dt('Small text under the panel')}</label><textarea name="footer" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count data-ac="vars,emojis" maxlength="300" placeholder={dt('Optional')}></textarea></div>
            <div class="tk-cat-row dfx-field" data-only-select><label>{dt('Text of the dropdown')}</label><input type="text" name="placeholder" data-ac="vars,emojis" maxlength="150" placeholder={dt('Select a ticket category...')} /></div>
            {embedTemplateNames.length > 0 && (
              <div class="tk-cat-row dfx-field"><label>{dt('Saved design')}</label>
                <select name="embed_template" data-dp-template-only>
                  <option value="">{dt('None: use the fields above')}</option>
                  {embedTemplateNames.map((n) => <option value={n}>{n}</option>)}
                </select>
              </div>
            )}
          </div>
          <div class="tk-panel-actions"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:paper-plane-tilt-fill" width="13" height="13" />{dt('Create and post the panel')}</button></div>
        </form>
        <div class="tk-new-preview"><TicketPanelPreview title="" description="" style="button" types={categories.filter((c) => !c.panelId).slice(0, 5).map((c) => ({ label: c.label, emoji: c.emoji, description: c.description, buttonStyle: c.buttonStyle }))} /></div>
      </div>
      {embedTemplateNames.length > 0 && <p class="tk-row-hint">{dt('A template\'s own title/description/color/image win over the fields above. Only server-wide variables resolve here ({a}, {b}, etc), not per-member ones, since no one specific opens a panel.', { a: ('{server_name}'), b: ('{guild.icon}') })}</p>}
    </div>
  </div>
  )}

  {selectedSection === 'types' && (
  <div class="tkx-page">
    <DashStatTiles tiles={[
      { label: dt('Support types'), value: categories.length, tone: 'invites' },
      { label: dt('On a panel'), value: categories.filter((c) => c.panelId).length, tone: 'joins' },
      { label: dt('With a form'), value: categories.filter((c) => c.formId).length, tone: 'messages' },
    ]} />
    <div class="tkx-head">
      <h2>{dt('Support types')} <span class="tkx-count">{categories.length}/{ticketCategoryLimit}</span>{!premiumActive && <span class="tk-premium-tag">Premium: {PREMIUM_LIMITS.ticketCategories}</span>}</h2>
      <p>{dt('A support type is a reason to open a ticket: Support, Report a player, Purchases... Each one appears as a button or option on a panel, and has its own staff and rules.')}</p>
    </div>
    {categories.length === 0 && <p class="tkx-empty"><Icon name="ph:ticket" width="18" height="18" />{dt('No ticket types yet, add the first one below.')}</p>}

    <div class="tkx-list dgl-stagger">
      {categories.map((cat) => {
        const panel = panels.find((p) => p.id === cat.panelId);
        return (
        <form method="POST" class="tkx-item">
          <input type="hidden" name="category_id" value={cat.id} />
          {/* The first button of a form is the one Enter presses, so a save sits before the delete button. */}
          <button type="submit" name="action" value="update" class="tk-default-submit" tabindex="-1" aria-hidden="true"></button>
          <div class="tkx-item-head">
            <span class="tk-cat-emoji-chip"><TicketEmoji emoji={cat.emoji} size={20} /></span>
            <div class="dfx-field tkx-name"><textarea name="label" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count maxlength="40" aria-label={dt('Name of the type')}>{cat.label}</textarea></div>
            <button type="submit" name="action" value="delete" class="tk-cat-del" title={dt('Delete this type')} aria-label={dt('Delete this type')} data-confirm={dt('Delete this support type? Members can no longer open tickets with it. This cannot be undone.')} formnovalidate>
              <Icon name="ph:trash-fill" width="15" height="15" />
            </button>
          </div>
          {panel
            ? <span class="tkx-pill tkx-pill-ok"><Icon name="ph:check-circle-fill" width="13" height="13" />{dt('On the panel: {name}', { name: panel.title || `#${channelName(panel.channelId)}` })}</span>
            : <span class="tkx-pill tkx-pill-warn"><Icon name="ph:warning-fill" width="13" height="13" />{dt('Not on any panel yet: nobody can open it.')}</span>}

          <details class="dfx-acc" open>
            <summary><span class="dfx-acc-title"><b>{dt('How it looks on the panel')}</b></span><Icon name="ph:caret-down-bold" class="dfx-caret" width="14" height="14" /></summary>
            <div class="dfx-acc-body">
              <div class="dfx-grid">
                <div class="dfx-field">
                  <label>{dt('Panel where it appears')}</label>
                  <select name="panel_id">
                    <option value="">{dt('None (not on any panel)')}</option>
                    {panels.map((p) => <option value={p.id} selected={p.id === cat.panelId}>{p.title || `#${channelName(p.channelId)}`}</option>)}
                  </select>
                </div>
                <div class="dfx-field">
                  <span class="dfx-label">{dt('Button color')}</span>
                  <div class="dfx-chips">
                    {buttonStyles.map((b) => <label class="dfx-chip"><input type="radio" name="button_style" value={b.value} checked={b.value === cat.buttonStyle} /><i class="tkx-dot" style={`--c:${b.color}`}></i>{b.label}</label>)}
                  </div>
                </div>
                <div class="dfx-field">
                  <label>{dt('Emoji')}</label>
                  <input type="text" name="emoji" data-emoji-input value={cat.emoji ?? ''} maxlength="64" autocomplete="off" placeholder="🎫" />
                  <span class="dfx-hint">{dt('Pick one with the button on the right. Server emojis work too.')}</span>
                </div>
                <div class="dfx-field">
                  <label>{dt('Short description')}</label>
                  <textarea name="description" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count data-ac="vars,emojis" maxlength="100" placeholder={dt('Shown under the name in the dropdown')}>{cat.description ?? ''}</textarea>
                </div>
              </div>
            </div>
          </details>

          <details class="dfx-acc">
            <summary><span class="dfx-acc-title"><b>{dt('When the ticket opens')}</b></span><Icon name="ph:caret-down-bold" class="dfx-caret" width="14" height="14" /></summary>
            <div class="dfx-acc-body">
              <div class="dfx-grid">
                <div class="dfx-field">
                  <label>{dt('Channel name')}</label>
                  <textarea name="naming_pattern" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count data-ac="vars,emojis" maxlength="50" placeholder="ticket-{number}">{cat.namingPattern}</textarea>
                  <span class="dfx-hint">{dt('You can use {number}, {username}, {userid} and {category}.')}</span>
                </div>
                <div class="dfx-field">
                  <label>{dt('Discord category where the channel is made')}</label>
                  <select name="parent_channel_id">
                    <option value="">{dt('Server default')}</option>
                    {channelCategories.map((c) => (
                      <option value={c.id} selected={c.id === cat.parentChannelId}>{c.name}</option>
                    ))}
                  </select>
                </div>
                <div class="dfx-field">
                  <label>{dt('Intake form')}</label>
                  <select name="form_id">
                    <option value="">{dt('No form')}</option>
                    {forms.map((form) => <option value={form.id} selected={String(form.id) === String(cat.formId)}>{form.name} · {form.title}</option>)}
                  </select>
                </div>
                {cat.welcomeSupported && (
                  <div class="dfx-field dfx-wide">
                    <label>{dt('Welcome text')}</label>
                    <input type="hidden" name="welcome_supported" value="1" />
                    <textarea name="welcome_message" class="dgl-autogrow" data-count data-ac rows="3" maxlength="1000" placeholder={dt('Hi {user}! Tell us what you need and staff will answer soon.')}>{cat.welcomeMessage ?? ''}</textarea><SilentMentionHint />
                    <span class="dfx-hint">{dt('Shown inside the ticket. You can use {user}, {username}, {category}, {server} and {number}. A saved embed set for this type is used instead.')}</span>
                  </div>
                )}
              </div>
            </div>
          </details>

          <details class="dfx-acc">
            <summary><span class="dfx-acc-title"><b>{dt('Who answers and who can open it')}</b></span><Icon name="ph:caret-down-bold" class="dfx-caret" width="14" height="14" /></summary>
            <div class="dfx-acc-body">
              <div class="dfx-grid">
                <div class="dfx-field">
                  <label>{dt('Support roles')}</label>
                  <MultiSelect lazy name="support_role_ids" options={roles} selected={cat.supportRoleIds} placeholder={dt('Search roles...')} />
                  <span class="dfx-hint">{dt('They can see and answer these tickets.')}</span>
                </div>
                <div class="dfx-field">
                  <label>{dt('Ping on open')}</label>
                  <MultiSelect lazy name="ping_role_ids" options={roles} selected={cat.pingRoleIds} placeholder={dt('Search roles...')} />
                </div>
                <div class="dfx-field">
                  <label>{dt('Required roles')}</label>
                  <MultiSelect lazy name="required_role_ids" options={roles} selected={cat.requiredRoleIds} placeholder={dt('Search roles...')} />
                  <span class="dfx-hint">{dt('Only members with all of them can open this type. Empty for everyone.')}</span>
                </div>
                <div class="dfx-field">
                  <label>{dt('Max open per member')}</label>
                  <input type="number" name="max_open_per_user" value={cat.maxOpenPerUser} min="1" max="10" />
                </div>
              </div>
            </div>
          </details>

          <div class="dfx-foot"><button type="submit" name="action" value="update" class="btn btn-accent btn-sm">{dt('Save this type')}</button></div>
        </form>
        );
      })}
    </div>

    <div class="dfx-form tkx-add" data-tk-new-type>
      <div class="dfx-sec-head"><h2><Icon name="ph:plus-circle-fill" width="16" height="16" />{dt('Add a support type')}</h2></div>
      {!ticketCategoryAtLimit && categories.length < 4 && (
        <form method="POST" class="tkx-starter" data-no-dirty>
          <input type="hidden" name="action" value="add_starter_types" />
          <span class="tkx-starter-icon"><Icon name="ph:magic-wand-fill" width="18" height="18" /></span>
          <div class="tkx-starter-text"><strong>{dt('Start with a ready set')}</strong><span>{dt('Adds Support, Report a player, Purchases and Appeals (as many as your plan allows). You can rename or delete them.')}</span></div>
          <div class="tkx-starter-do">
            <select name="panel_id" aria-label={dt('Panel where it appears')}><option value="">{dt('No panel yet')}</option>{panels.map((p) => <option value={p.id}>{p.title || `#${channelName(p.channelId)}`}</option>)}</select>
            <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="13" height="13" />{dt('Add the ready types')}</button>
          </div>
        </form>
      )}
      {ticketCategoryAtLimit ? (
        <div class="tkx-limit">
          <Icon name="ph:crown-simple-fill" width="20" height="20" />
          <div><strong>{premiumActive ? dt('Ticket type limit reached') : dt('Free ticket type limit reached')}</strong><span>{premiumActive ? dt('You are using all {n} available ticket types.',{n:ticketCategoryLimit}) : dt('Free includes {a} ticket types. Premium increases this to {b}.', { a: FREE_LIMITS.ticketCategories, b: PREMIUM_LIMITS.ticketCategories })}</span></div>
          {!premiumActive && <a class="btn btn-ghost btn-sm" href={`/dash/premium?guild_id=${guildId}`}>{dt('Unlock Premium')}</a>}
        </div>
      ) : (
        <form method="POST" class="tkx-addform" data-no-dirty>
          <input type="hidden" name="action" value="create" />
          <div class="dfx-grid">
            <div class="dfx-field"><label>{dt('Name of the type')}</label><textarea name="label" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count placeholder={dt('e.g. Report a player')} maxlength="40" required></textarea></div>
            <div class="dfx-field"><label>{dt('Emoji')}</label><input type="text" name="emoji" data-emoji-input placeholder="🎫" maxlength="64" autocomplete="off" /></div>
            <div class="dfx-field"><label>{dt('Panel where it appears')}</label>
              <select name="panel_id">
                <option value="">{dt('No panel yet')}</option>
                {panels.map((p) => <option value={p.id}>{p.title || `#${channelName(p.channelId)}`}</option>)}
              </select>
            </div>
            <div class="dfx-field"><label>{dt('Discord category where the channel is made')}</label>
              <select name="parent_channel_id">
                <option value="">{dt('Server default category')}</option>
                {channelCategories.map((c) => <option value={c.id}>{c.name}</option>)}
              </select>
            </div>
          </div>
          <div class="dfx-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="13" height="13" />{dt('Add')}</button></div>
        </form>
      )}
      {forms.length === 0 && <p class="dfx-hint">{dt('Want questions before a ticket opens?')} <a href={`/dash/guild/${guildId}/tickets?section=forms`} class="dfx-link">{dt('Create a ticket form')} →</a></p>}
    </div>
  </div>
  )}

  {selectedSection === 'forms' && (
  <div class="tkx-page">
    <DashStatTiles tiles={[
      { label: dt('Ticket forms'), value: forms.length, tone: 'messages' },
      { label: dt('Questions'), value: forms.reduce((sum, f) => sum + f.fields.length, 0), tone: 'voice' },
    ]} />
    <div class="tkx-head">
      <h2>{dt('Ticket forms')} <span class="tkx-count">{forms.length}</span></h2>
      <p><Fragment set:html={dth('Reusable intake forms shown before a form-backed ticket opens. Add the questions below: short and long answers, choices, checkboxes, member, role and channel pickers, texts and file uploads (pictures are shown in the ticket and kept in it). In Discord the same questions use <code>type|id|label|placeholder|required|extra;...</code>.')} /></p>
    </div>
    {forms.length === 0 && <p class="tkx-empty"><Icon name="ph:clipboard-text-fill" width="18" height="18" />{dt('No forms yet. Create one here, then assign it to a support type.')}</p>}
    <div class="tkx-list dgl-stagger">
      {forms.map((form) => (
        <form method="POST" class="tkx-item">
          <input type="hidden" name="form_id" value={form.id} />
          <input type="hidden" name="form_name" value={form.name} />
          <input type="hidden" name="action" value="update_ticket_form" />
          <div class="tkx-item-head tkx-item-center">
            <span class="tk-cat-emoji-chip tkx-icon"><Icon name="ph:clipboard-text-fill" width="18" height="18" /></span>
            <div class="tkx-item-title"><b>{form.name}</b><span class="dfx-hint">{dt('{a} questions', { a: form.fields.length })}</span></div>
          </div>
          <div class="dfx-field"><label>{dt('Modal title')}</label><textarea name="form_title" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count maxlength="45" required>{form.title}</textarea></div>
          <div class="dfx-field"><span class="dfx-label">{dt('Fields')}</span><TicketFieldsBuilder fields={form.fields} /></div>
          <div class="dfx-foot">
            <button type="submit" class="btn btn-accent btn-sm">{dt('Save form')}</button>
            <button type="submit" form={`tk-form-del-${form.id}`} class="tk-cat-del tk-del-text" data-confirm={dt('Delete this form? Support types that use it open without a form.')} formnovalidate><Icon name="ph:trash-fill" width="13" height="13" />{dt('Delete form')}</button>
          </div>
        </form>
      ))}
    </div>
    {forms.map((form) => <form method="POST" id={`tk-form-del-${form.id}`} hidden data-no-dirty><input type="hidden" name="action" value="delete_ticket_form" /><input type="hidden" name="form_id" value={form.id} /></form>)}
    <form method="POST" class="dfx-form tkx-add" data-no-dirty>
      <input type="hidden" name="action" value="create_ticket_form" />
      <div class="dfx-sec-head"><h2><Icon name="ph:plus-circle-fill" width="16" height="16" />{dt('New form')}</h2></div>
      <div class="dfx-grid">
        <div class="dfx-field"><label>{dt('Form name')}</label><textarea name="form_name" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count autocomplete="off" maxlength="50" required></textarea></div>
        <div class="dfx-field"><label>{dt('Modal title')}</label><textarea name="form_title" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count autocomplete="off" maxlength="45" required>{dt('Ticket details')}</textarea></div>
      </div>
      <div class="dfx-field"><span class="dfx-label">{dt('Fields')}</span><TicketFieldsBuilder /></div>
      <div class="dfx-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="13" height="13" />{dt('Create form')}</button></div>
    </form>
  </div>
  )}

  {selectedSection === 'access' && (
  <div class="tkx-page">
    <DashStatTiles tiles={[
      { label: dt('Members blocked'), value: blacklist.filter((e) => e.target_type !== 'role').length, tone: 'leaves' },
      { label: dt('Roles blocked'), value: blacklist.filter((e) => e.target_type === 'role').length, tone: 'reactions' },
    ]} />
    <div class="tkx-head">
      <h2>{dt('Ticket access')} <span class="tkx-count">{blacklist.length}</span></h2>
      <p>{dt('Block a user or role from opening tickets. Role entries apply to every member with that role.')}</p>
    </div>
    {blacklist.length === 0 ? <p class="tkx-empty"><Icon name="ph:shield-check-fill" width="18" height="18" />{dt('Nobody is blocked. Everyone who can see a panel can open a ticket.')}</p> : (
    <div class="tkx-rows dgl-stagger">
      {blacklist.map((entry) => (
        <div class="tkx-row">
          {entry.target_type === 'role'
            ? <span class="tk-block-icon"><Icon name="ph:shield-fill" width="16" height="16" /></span>
            : <img class="tk-block-av" src={entry.avatar ?? `https://cdn.discordapp.com/embed/avatars/${Number(entry.target_id.slice(-3)) % 6}.png`} alt="" width="34" height="34" loading="lazy" />}
          <div class="tkx-row-main">
            <b>{entry.target_type === 'role' ? `@${entry.name ?? entry.target_id}` : (entry.name ?? entry.target_id)}</b>
            <span class="tkx-row-sub"><span class:list={['tkx-tag', { 'tkx-tag-role': entry.target_type === 'role' }]}>{entry.target_type === 'role' ? dt('Role') : dt('Member')}</span><code>{entry.target_id}</code></span>
            {entry.reason && <span class="tkx-row-reason">{entry.reason}</span>}
          </div>
          <form method="POST" data-no-dirty><input type="hidden" name="action" value="remove_ticket_blacklist" /><input type="hidden" name="target_type" value={entry.target_type} /><input type="hidden" name="target_id" value={entry.target_id} /><button type="submit" class="btn btn-ghost btn-sm">{dt('Unblock')}</button></form>
        </div>
      ))}
    </div>
    )}
    <form method="POST" class="dfx-form tkx-add" data-no-dirty>
      <input type="hidden" name="action" value="add_ticket_blacklist" />
      <div class="dfx-sec-head"><h2><Icon name="ph:plus-circle-fill" width="16" height="16" />{dt('Block a member or role')}</h2><p>{dt('Pick who it is, paste its ID and say why if you want to remember it.')}</p></div>
      <div class="dfx-field">
        <span class="dfx-label">{dt('Who')}</span>
        <div class="dfx-chips">
          <label class="dfx-chip"><input type="radio" name="target_type" value="user" checked />{dt('Member')}</label>
          <label class="dfx-chip"><input type="radio" name="target_type" value="role" />{dt('Role')}</label>
        </div>
      </div>
      <div class="dfx-grid">
        <div class="dfx-field"><label>{dt('Discord ID')}</label><input type="text" name="target_id" placeholder="123456789012345678" inputmode="numeric" pattern="[0-9]{5,25}" required /><span class="dfx-hint">{dt('In Discord, turn on Developer Mode, right-click the member or the role and copy its ID.')}</span></div>
        <div class="dfx-field"><label>{dt('Reason (optional)')}</label><textarea name="reason" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count maxlength="300"></textarea></div>
      </div>
      <div class="dfx-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="13" height="13" />{dt('Block')}</button></div>
    </form>
  </div>
  )}

  {selectedSection === 'settings' && (
  <div class="tkx-page">
  <form method="POST" class="dfx-form tkx-settings">
    <input type="hidden" name="action" value="save_settings" />

    <section class="dfx-sec tkx-first">
      <div class="dfx-sec-head"><h2>{dt('Claiming')}</h2><p>{dt('A claim says which staff member is taking care of a ticket.')}</p></div>
      <div class="sx-choices">
        <label class="sx-choice"><input type="radio" name="claim_mode" value="shared" checked={settings.claimMode !== 'exclusive'} /><span class="sx-choice-body"><Icon name="ph:users-fill" width="18" height="18" /><b>{dt('Shared')}</b><em>{dt('Any staff can still act on a claimed ticket.')}</em></span></label>
        <label class="sx-choice"><input type="radio" name="claim_mode" value="exclusive" checked={settings.claimMode === 'exclusive'} /><span class="sx-choice-body"><Icon name="ph:lock-simple-fill" width="18" height="18" /><b>{dt('Exclusive')}</b><em>{dt('Only the claimer (or an admin) can act on it.')}</em></span></label>
      </div>
      <label class="dfx-switch"><span><b>{dt('Ping the ticket opener when claimed')}</b><em>{dt('They get a mention in the ticket when a staff member takes it.')}</em></span><input type="checkbox" class="dfx-t" name="ping_on_claim" checked={settings.pingOnClaim} /></label>
      <div class="dfx-grid">
        <div class="dfx-field">
          <label>{dt('Remind the staff if nobody claims it (minutes)')}</label>
          <input type="number" name="unclaimed_reminder_minutes" value={settings.unclaimedReminderMinutes} min="0" max="10080" />
          <span class="dfx-hint">{dt('The support roles of the type are pinged once in the ticket. 0 for no reminder.')}</span>
        </div>
        <div class="dfx-field">
          <label>{dt('Roles to add on claim')}</label>
          <MultiSelect lazy name="roles_to_add_on_claim" options={roles} selected={settings.rolesToAddOnClaim} placeholder={dt('Search roles...')} />
        </div>
      </div>
    </section>

    <section class="dfx-sec">
      <div class="dfx-sec-head"><h2>{dt('Closing')}</h2><p>{dt('Who can close a ticket, what they have to say and what happens after.')}</p></div>
      <div class="dfx-switches">
        <label class="dfx-switch"><span><b>{dt('Only support roles can close (not the opener)')}</b><em>{dt('The member who opened it cannot close it.')}</em></span><input type="checkbox" class="dfx-t" name="close_requires_support_role" checked={settings.closeRequiresSupportRole} /></label>
        <label class="dfx-switch"><span><b>{dt('Require a reason to close')}</b><em>{dt('Whoever closes a ticket has to say why.')}</em></span><input type="checkbox" class="dfx-t" name="close_requires_reason" checked={settings.closeRequiresReason} /></label>
        <label class="dfx-switch"><span><b>{dt('Hide who closed it from the opener')}</b><em>{dt('The opener is not told which staff member closed it.')}</em></span><input type="checkbox" class="dfx-t" name="hide_closing_user" checked={settings.hideClosingUser} /></label>
        <label class="dfx-switch"><span><b>{dt('DM the opener with the transcript on close')}</b><em>{dt('A copy of the conversation goes to their DMs.')}</em></span><input type="checkbox" class="dfx-t" name="dm_user_on_close" checked={settings.dmUserOnClose} /></label>
        <label class="dfx-switch"><span><b>{dt('Log staff reply counts in the closed-ticket log')}</b><em>{dt('Shows how many times each staff member replied.')}</em></span><input type="checkbox" class="dfx-t" name="log_staff_message_counts" checked={settings.logStaffMessageCounts} /></label>
      </div>
      <div class="dfx-grid">
        <div class="dfx-field">
          <label>{dt('Delete the channel of a closed ticket after (hours)')}</label>
          <input type="number" name="auto_delete_closed_hours" value={settings.autoDeleteClosedHours} min="0" max="720" />
          <span class="dfx-hint">{dt('The transcript is kept. 0 to keep the channels until someone deletes them.')}</span>
        </div>
        <div class="dfx-field">
          <label>{dt('Default close reason')}</label>
          <textarea name="default_close_reason" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count data-ac="emojis" maxlength="300" placeholder={dt('Used when no reason is given')}>{settings.defaultCloseReason}</textarea>
        </div>
      </div>
    </section>

    <section class="dfx-sec">
      <div class="dfx-sec-head"><h2>{dt('Transcripts')}</h2><p>{dt('A transcript is the saved conversation of a ticket. It is made when the ticket closes or when staff press the transcript button.')}</p></div>
      <div class="dfx-field">
        <label>{dt('Transcripts channel')}</label>
        <select name="transcript_channel_id" data-fill="tk-ch">
          <option value="">{dt('None')}</option>
          <SelectChosen items={textChannels} selected={settings.transcriptChannelId} prefix="#" />
        </select>
        <span class="dfx-hint">{dt('Every transcript is also sent here, apart from the logs. Leave it empty to not use it.')}</span>
      </div>
      <div class="dfx-field">
        <span class="dfx-label">{dt('How it is sent')}</span>
        <div class="sx-choices">
          <label class="sx-choice"><input type="radio" name="transcript_mode" value="auto" checked={!['link', 'file', 'both'].includes(settings.transcriptMode)} /><span class="sx-choice-body"><Icon name="ph:magic-wand-fill" width="18" height="18" /><b>{dt('Automatic')}</b><em>{dt('A link, or the file if there is no link.')}</em></span></label>
          <label class="sx-choice"><input type="radio" name="transcript_mode" value="link" checked={settings.transcriptMode === 'link'} /><span class="sx-choice-body"><Icon name="ph:link-bold" width="18" height="18" /><b>{dt('Link')}</b><em>{dt('Link to read it online')}</em></span></label>
          <label class="sx-choice"><input type="radio" name="transcript_mode" value="file" checked={settings.transcriptMode === 'file'} /><span class="sx-choice-body"><Icon name="ph:file-text-bold" width="18" height="18" /><b>{dt('File')}</b><em>{dt('HTML file to download')}</em></span></label>
          <label class="sx-choice"><input type="radio" name="transcript_mode" value="both" checked={settings.transcriptMode === 'both'} /><span class="sx-choice-body"><Icon name="ph:stack-fill" width="18" height="18" /><b>{dt('Link and file')}</b><em>{dt('Both, one after the other.')}</em></span></label>
        </div>
        <span class="dfx-hint">{dt('Applies to the logs, the transcripts channel and the message to the opener. The opener only gets it if the option to send it on close is on.')}</span>
      </div>
    </section>

    <section class="dfx-sec">
      <div class="dfx-sec-head"><h2>{dt('Autoclose')}</h2><p>{dt('Tickets that close by themselves.')}</p></div>
      <div class="dfx-switches">
        <label class="dfx-switch"><span><b>{dt('Close a member\'s tickets when they leave')}</b><em>{dt('No ticket stays open for someone who is gone.')}</em></span><input type="checkbox" class="dfx-t" name="autoclose_leave" checked={settings.autocloseLeave} /></label>
        <label class="dfx-switch"><span><b>{dt('Close tickets after a period of inactivity')}</b><em>{dt('A ticket nobody writes in is closed by itself.')}</em></span><input type="checkbox" class="dfx-t" name="autoclose_inactivity_enabled" checked={settings.autocloseInactivityEnabled} /></label>
      </div>
      <div class="dfx-field tkx-narrow" data-sx-needs="autoclose_inactivity_enabled">
        <label>{dt('Inactivity period (hours)')}</label>
        <input type="number" name="autoclose_inactivity_hours" value={settings.autocloseInactivityHours} min="1" max="720" />
      </div>
    </section>

    <section class="dfx-sec">
      <div class="dfx-sec-head"><h2>{dt('Ratings')}</h2><p>{dt('Let members say how the help was when the ticket closes.')}</p></div>
      <label class="dfx-switch"><span><b>{dt('Let members rate a ticket after it closes')}</b><em>{dt('They rate the help with stars.')}</em></span><input type="checkbox" class="dfx-t" name="rating_enabled" checked={settings.ratingEnabled} /></label>
      <div class="dfx-grid" data-sx-needs="rating_enabled">
        <div class="dfx-field">
          <span class="dfx-label">{dt('Rating mode')}</span>
          <div class="dfx-chips">
            <label class="dfx-chip"><input type="radio" name="rating_mode" value="rating_only" checked={settings.ratingMode !== 'rating_comment'} />{dt('Stars only')}</label>
            <label class="dfx-chip"><input type="radio" name="rating_mode" value="rating_comment" checked={settings.ratingMode === 'rating_comment'} />{dt('Stars + optional comment')}</label>
          </div>
        </div>
        <div class="dfx-field">
          <label>{dt('Rating log channel')}</label>
          <select name="rating_log_channel_id" data-fill="tk-ch">
            <option value="">{dt('None')}</option>
            <SelectChosen items={textChannels} selected={settings.ratingLogChannelId} prefix="#" />
          </select>
        </div>
      </div>
    </section>

    <section class="dfx-sec">
      <div class="dfx-sec-head"><h2>{dt('Logging')}</h2><p>{dt('Where Petto writes when a ticket opens and when it closes.')}</p></div>
      <div class="dfx-grid">
        <div class="dfx-field">
          <label>{dt('Opened tickets log channel')}</label>
          <select name="opened_log_channel_id" data-fill="tk-ch">
            <option value="">{dt('None')}</option>
            <SelectChosen items={textChannels} selected={settings.openedLogChannelId} prefix="#" />
          </select>
        </div>
        <div class="dfx-field">
          <label>{dt('Closed tickets log channel')}</label>
          <select name="closed_log_channel_id" data-fill="tk-ch">
            <option value="">{dt('None')}</option>
            <SelectChosen items={textChannels} selected={settings.closedLogChannelId} prefix="#" />
          </select>
        </div>
      </div>
      <span class="dfx-hint"><Fragment set:html={dth('Separate from the Logging page\'s <b>Tickets</b> route, which can run alongside these dedicated channels.')} /></span>
    </section>

    <section class="dfx-sec">
      <div class="dfx-sec-head"><h2>{dt('Limits')}</h2><p>{dt('How many tickets a member can have open at once.')}</p></div>
      <div class="dfx-field tkx-narrow">
        <label>{dt('Open tickets at the same time per member')}</label>
        <input type="number" name="global_limit" value={settings.globalLimit} min="0" max="50" />
        <span class="dfx-hint">{dt('In the whole server, whatever the type. 0 for no limit. Each type has its own limit too.')}</span>
      </div>
    </section>

    <section class="dfx-sec">
      <div class="dfx-sec-head"><h2>{dt('Staff hours')}</h2><p>{dt('Say when the staff answers, and what members are told outside those hours.')}</p></div>
      <label class="dfx-master"><span><b>{dt('Tell members when the staff answers')}</b><em>{dt('The hours are shown to the member who opens a ticket.')}</em></span><input type="checkbox" class="dfx-t" name="hours_enabled" checked={settings.hoursEnabled} /></label>
      <div class="tkx-hours" data-sx-needs="hours_enabled">
        <div class="dfx-grid dfx-grid-3">
          <div class="dfx-field"><label>{dt('From')}</label><input type="time" name="hours_start" value={settings.hoursStart} /></div>
          <div class="dfx-field"><label>{dt('Until')}</label><input type="time" name="hours_end" value={settings.hoursEnd} /></div>
          <div class="dfx-field">
            <label>{dt('Timezone')}</label>
            <select name="hours_timezone">
              {[...new Set([settings.hoursTimezone, ...timezones])].map((tz) => <option value={tz} selected={tz === settings.hoursTimezone}>{tz}</option>)}
            </select>
          </div>
        </div>
        <div class="dfx-field">
          <span class="dfx-label">{dt('Days')}</span>
          <div class="dfx-chips">
            {hourDays.map((d) => <label class="dfx-chip"><input type="checkbox" name="hours_days" value={d.n} checked={settings.hoursDays.includes(d.n)} />{d.label}</label>)}
          </div>
        </div>
        <label class="dfx-switch"><span><b>{dt('Do not let tickets open outside these hours')}</b><em>{dt('Nobody can open a ticket outside the hours.')}</em></span><input type="checkbox" class="dfx-t" name="hours_block" checked={settings.hoursBlock} /></label>
        <div class="dfx-field">
          <label>{dt('Message outside the hours')}</label>
          <textarea name="hours_message" class="dgl-autogrow" data-count data-ac rows="3" maxlength="500" placeholder={dt('Our staff is away right now. They answer between {start} and {end} ({timezone}). Your ticket is open and someone will reply when they are back.')}>{settings.hoursMessage}</textarea><SilentMentionHint />
          <span class="dfx-hint">{dt('You can use {start}, {end} and {timezone}. Empty uses the message above.')}</span>
        </div>
      </div>
    </section>

    <section class="dfx-sec">
      <div class="dfx-sec-head"><h2>{dt('Blocked roles')}</h2><p>{dt('Can\'t open new tickets. Doesn\'t affect tickets they already have.')}</p></div>
      <div class="dfx-field">
        <MultiSelect lazy name="blocked_role_ids" options={roles} selected={settings.blockedRoleIds} placeholder={dt('Search roles...')} />
      </div>
    </section>

    <div class="dfx-foot"><button type="submit" class="btn btn-accent btn-sm">{dt('Save settings')}</button></div>
  </form>
  </div>
  )}

  {selectedSection === 'replies' && (
  <div class="tkx-page">
    <DashStatTiles tiles={[
      { label: dt('Quick replies'), value: quickReplies.length, tone: 'messages' },
      { label: dt('Characters'), value: quickReplies.reduce((sum, r) => sum + r.content.length, 0), tone: 'voice' },
    ]} />
    <div class="tkx-head">
      <h2>{dt('Quick replies')} <span class="tkx-count">{quickReplies.length}</span></h2>
      <p><Fragment set:html={dth('Texts the staff send inside a ticket with one command: <code>!quickreply send name</code> (or <code>!qr send name</code>). Good for the questions that come up again and again.')} /></p>
    </div>
    {quickReplies.length === 0 && <p class="tkx-empty"><Icon name="ph:chat-circle-text-fill" width="18" height="18" />{dt('No quick replies yet. Add the first one below.')}</p>}
    <div class="tkx-list tkx-list-2 dgl-stagger">
      {quickReplies.map((r) => (
        <form method="POST" class="tkx-item tk-reply-item">
          <input type="hidden" name="reply_name" value={r.name} />
          <div class="tkx-item-head tkx-item-center">
            <span class="tk-cat-emoji-chip tkx-icon" aria-hidden="true"><Icon name="ph:chat-circle-text-fill" width="17" height="17" /></span>
            <span class="tk-reply-title"><code class="tk-reply-name">{r.name}</code><span class="tk-row-hint">!qr send {r.name}</span></span>
            <button type="submit" name="action" value="delete_reply" class="tk-cat-del tk-reply-del" title={dt('Delete')} aria-label={dt('Delete')} data-confirm={dt('Delete this quick reply?')} formnovalidate><Icon name="ph:trash-fill" width="15" height="15" /></button>
          </div>
          <div class="dfx-field">
            <div class="tkx-vars" role="group" aria-label={dt('Add a variable')}>{['{user}', '{username}', '{category}', '{server}', '{number}'].map((v) => <button type="button" class="tkx-var" data-tk-var={v}>{v}</button>)}</div>
            <textarea name="reply_content" class="dgl-autogrow" data-count data-ac rows="4" maxlength="1500">{r.content}</textarea><SilentMentionHint />
          </div>
          <div class="tk-panel-actions">
            <button type="submit" name="action" value="save_reply" class="btn btn-accent btn-sm">{dt('Save')}</button>
          </div>
        </form>
      ))}
    </div>
    <form method="POST" class="dfx-form tkx-add" data-no-dirty>
      <input type="hidden" name="action" value="save_reply" />
      <div class="dfx-sec-head"><h2><Icon name="ph:plus-circle-fill" width="16" height="16" />{dt('New quick reply')}</h2></div>
      <div class="dfx-field tkx-narrow"><label>{dt('Name')}</label><input type="text" name="reply_name" maxlength="30" pattern="[a-zA-Z0-9][a-zA-Z0-9_\-]{0,29}" placeholder="rules" required /></div>
      <div class="dfx-field">
        <label>{dt('Text')}</label>
        <div class="tkx-vars" role="group" aria-label={dt('Add a variable')}>{['{user}', '{username}', '{category}', '{server}', '{number}'].map((v) => <button type="button" class="tkx-var" data-tk-var={v}>{v}</button>)}</div>
        <textarea name="reply_content" class="dgl-autogrow" data-count data-ac rows="4" maxlength="1500" placeholder={dt('Hi {user}! Please read the rules and tell us what you need.')} required></textarea><SilentMentionHint />
        <span class="dfx-hint">{dt('You can use {user}, {username}, {category}, {server} and {number}.')}</span>
      </div>
      <div class="dfx-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="13" height="13" />{dt('Save quick reply')}</button></div>
    </form>
  </div>
  )}

  {selectedSection === 'open' && (
  <div class="tkx-page tkx-open">
    {stats && <DashStatTiles against={dt('vs before')} tiles={[
      { label: dt('Open now'), value: stats.open, tone: 'joins' },
      { label: dt('Without a claimer'), value: stats.unclaimed, tone: 'reactions' },
      { label: dt('Opened in 7 days'), value: stats.opened7, tone: 'messages', change: stats.opened7Change },
      { label: dt('Closed in 7 days'), value: stats.closed7, tone: 'invites', change: stats.closed7Change },
      { label: dt('Average time open'), value: stats.averageMinutesOpen ?? 0, text: minutesText(stats.averageMinutesOpen, dashLocale(dashLang)), tone: 'voice' },
      { label: `${dt('Rating')}${stats.ratingCount ? ` (${stats.ratingCount})` : ''}`, value: stats.averageRating ?? 0, text: stats.averageRating === null ? '-' : `${stats.averageRating} / 5`, tone: 'leaves' },
    ]} />}
    <div class="tkx-head">
      <h2>{dt('Open tickets')} <span class="tkx-count">{openTickets.length}</span></h2>
      <p>{dt('The list updates by itself while this page is open. Pick a ticket to read it and answer from here.')}</p>
    </div>
    <TicketLive guildId={guildId} openCount={openTickets.length} viewOnly={viewOnly} me={me} />

    <div class="tkx-split">
      <div class="tkx-closed">
        <div class="tkx-head">
          <h2>{dt('Closed, with transcript')} <span class="tkx-count">{closedTickets.length}</span></h2>
        </div>
        {closedTickets.length === 0 ? (
          <p class="tkx-empty"><Icon name="ph:archive-fill" width="18" height="18" />{dt('No closed ticket with a saved transcript yet.')}</p>
        ) : (
          <div class="tkx-rows dgl-stagger" data-closed-list>
            {closedTickets.map((t) => (
              <div class="tkx-row">
                <img class="tk-block-av" src={t.openerAvatar ?? `https://cdn.discordapp.com/embed/avatars/${Number(String(t.openerId).slice(-3)) % 6}.png`} alt="" width="36" height="36" loading="lazy" />
                <div class="tkx-row-main">
                  <b><span class="tk-open-num">#{String(t.number).padStart(4, '0')}</span> {t.categoryLabel}</b>
                  <span class="tkx-row-reason">{t.openerName ?? t.openerId}{t.closedAt && <Fragment> · <time datetime={t.closedAt} data-tk-ago data-ago={dt('{a} ago')} data-now={dt('just now')}>{new Date(t.closedAt).toISOString().slice(0, 10)}</time></Fragment>}{t.reason && ` · ${t.reason.slice(0, 80)}`}</span>
                </div>
                <button type="button" class="btn btn-ghost btn-sm" data-transcript={t.number}><Icon name="ph:scroll-fill" width="13" height="13" />{dt('Transcript')}</button>
              </div>
            ))}
          </div>
        )}
      </div>
      {stats && (
      <div class="tkx-chart" role="img" aria-label={dt('Tickets opened and closed in the last 14 days')}>
        <div class="tkx-chart-head"><b>{dt('Last 14 days')}</b><span class="tk-key tk-key-open">{dt('Opened')}</span><span class="tk-key tk-key-closed">{dt('Closed')}</span></div>
        <div class="tkx-chart-bars">
          {(() => { const max = Math.max(1, ...stats.days.map((d) => Math.max(d.opened, d.closed))); return stats.days.map((d, i) => (
            <div class="tkx-bar" style={`--i:${i}`} title={`${d.label}: ${d.opened} / ${d.closed}`}>
              <div class="tkx-bar-cols"><i class="tk-col-open" style={`height:${Math.round((d.opened / max) * 100)}%`}></i><i class="tk-col-closed" style={`height:${Math.round((d.closed / max) * 100)}%`}></i></div>
              <span>{d.label.slice(3)}</span>
            </div>
          )); })()}
        </div>
      </div>
      )}
    </div>
  </div>
  )}
  {['panels', 'settings'].includes(selectedSection) && <SelectSource name="tk-ch" items={textChannels.map((c) => ({ id: c.id, name: c.name }))} prefix="#" />}
  <EmojiPicker customEmojis={customEmojis} />
  {/* Inside the content: the dashboard's navigation runs only the scripts of the content it swaps in, so these start when the page is
      reached from the menu too. Each one binds its document listeners once, and does the work of the page drawn now each time. */}
  <script is:inline>
    // A variable chip puts its text where the cursor is in the text box of its reply (the box keeps its place while the chip is pressed).
    (function () {
      if (window.__tkVars) return;
      window.__tkVars = true;
      document.addEventListener('click', function (event) {
        var chip = event.target && event.target.closest && event.target.closest('[data-tk-var]');
        if (!chip) return;
        var area = chip.closest('.dfx-field') && chip.closest('.dfx-field').querySelector('textarea');
        if (!area || area.readOnly) return;
        var start = area.selectionStart == null ? area.value.length : area.selectionStart;
        var end = area.selectionEnd == null ? start : area.selectionEnd;
        area.setRangeText(chip.getAttribute('data-tk-var'), start, end, 'end');
        area.focus();
        area.dispatchEvent(new Event('input', { bubbles: true }));
      });
    })();
  </script>
  <span hidden data-tk-text={JSON.stringify({ transcriptFailed: dt('The transcript could not be opened.'), clickHint: dt('Click a button below to open a ticket.') })}></span>
  <script is:inline>
    (function () {
      var holder = document.querySelector('#dgl-content [data-tk-text]');
      var T = {};
      try { T = JSON.parse(holder ? holder.getAttribute('data-tk-text') : '{}') || {}; } catch (e) { T = {}; }
      window.__tkText = T;
      // The transcript of a closed ticket opens in a new tab; the bot gives the signed link.
      if (!window.__tkTranscriptBound) {
        window.__tkTranscriptBound = true;
        document.addEventListener('click', function (event) {
          var btn = event.target.closest && event.target.closest('[data-transcript]');
          if (!btn) return;
          var failed = (window.__tkText && window.__tkText.transcriptFailed) || 'The transcript could not be opened.';
          var say = function (text) { if (window.dglToast) window.dglToast(text, { kind: 'error' }); };
          var guild = location.pathname.split('/dash/guild/')[1].split('/')[0];
          var win = window.open('', '_blank');
          btn.disabled = true; btn.classList.add('dgl-busy');
          fetch('/dash/guild/' + guild + '/tickets-api', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'transcript', number: Number(btn.getAttribute('data-transcript')) }) })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              if (data && data.ok && data.link) { if (win) win.location = data.link; else location.href = data.link; }
              else { if (win) win.close(); say((data && data.message) || failed); }
            })
            .catch(function () { if (win) win.close(); say(failed); })
            .finally(function () { btn.disabled = false; btn.classList.remove('dgl-busy'); });
        });
      }
      // The closing dates of the closed tickets, said as "3d ago".
      try {
        document.querySelectorAll('#dgl-content [data-tk-ago]').forEach(function (el) {
          var a = Math.abs((Date.parse(el.getAttribute('datetime')) - Date.now()) / 1000);
          el.textContent = a < 45 ? el.getAttribute('data-now') : el.getAttribute('data-ago').replace('{a}', window.dglDuration(a, { locale: document.documentElement.lang }));
          el.title = new Date(el.getAttribute('datetime')).toLocaleString();
        });
      } catch (e) { /* the date stays as it is */ }
    })();
  </script>
  <script is:inline>
    // The preview of a panel follows what is typed (no need to save to see it), the ready designs fill the new-panel form,
    // and the color picker and the hex box stay in step.
    (function () {
      var HEX = /^#[0-9a-fA-F]{6}$/;
      function refresh(form) {
        var preview = form.parentElement && form.parentElement.querySelector('[data-panel-preview]');
        if (!preview) preview = form.querySelector('[data-panel-preview]');
        if (!preview && form.hasAttribute('data-new-panel')) preview = document.querySelector('#dgl-content .tk-new-preview [data-panel-preview]');
        var val = function (name) { var el = form.querySelector('[name="' + name + '"]'); return el ? el.value : ''; };
        var style = val('style') === 'select' ? 'select' : 'button';
        form.querySelectorAll('[data-only-select]').forEach(function (row) { row.hidden = style !== 'select'; });
        if (!preview) return;
        preview.setAttribute('data-style', style);
        var set = function (selector, text) { var el = preview.querySelector(selector); if (el) el.textContent = text; };
        set('[data-pv-title]', val('title'));
        var hasTypes = preview.getAttribute('data-has-types') === '1';
        set('[data-pv-desc]', val('description') || (hasTypes ? ((window.__tkText && window.__tkText.clickHint) || '') : ''));
        var footer = preview.querySelector('[data-pv-foot]');
        if (footer) { footer.textContent = val('footer'); footer.hidden = !val('footer'); }
        var image = preview.querySelector('[data-pv-image]');
        if (image) { var url = val('image_url'); if (/^https:\/\//i.test(url)) { image.src = url; image.hidden = false; } else { image.hidden = true; } }
        var card = preview.querySelector('[data-pv-card]');
        if (card) card.style.setProperty('--pv-color', HEX.test(val('color')) ? val('color') : '#a5ea7a');
        var ph = preview.querySelector('[data-pv-placeholder]');
        if (ph && val('placeholder')) ph.textContent = val('placeholder');
      }
      if (!window.__tkPanelBound) {
        window.__tkPanelBound = true;
        document.addEventListener('input', function (event) {
          var form = event.target && event.target.closest && event.target.closest('[data-panel-form]');
          if (form) refresh(form);
        });
        document.addEventListener('change', function (event) {
          var form = event.target && event.target.closest && event.target.closest('[data-panel-form]');
          if (form) refresh(form);
        });
        document.addEventListener('click', function (event) {
          var button = event.target && event.target.closest && event.target.closest('[data-preset]');
          if (!button) return;
          var form = document.querySelector('#dgl-content [data-new-panel]');
          if (!form) return;
          var put = function (name, value) { var el = form.querySelector('[name="' + name + '"]'); if (el) el.value = value; };
          put('title', button.getAttribute('data-title') || '');
          put('description', button.getAttribute('data-description') || '');
          put('color', button.getAttribute('data-color') || '');
          put('style', button.getAttribute('data-style') || 'button');
          put('footer', button.getAttribute('data-footer') || '');
          put('placeholder', button.getAttribute('data-placeholder') || '');
          var colorField = form.querySelector('[name="color"]'); var colorBox = colorField && colorField.closest('[data-colorpicker]'); if (colorBox) colorBox.dispatchEvent(new CustomEvent('cp-set', { detail: button.getAttribute('data-color') || '' }));
          document.querySelectorAll('#dgl-content [data-preset]').forEach(function (b) { b.classList.toggle('on', b === button); });
          refresh(form);
          form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
      }
      // Every time the page is drawn (also after a save or from the menu): the previews and the rows that depend on the style.
      document.querySelectorAll('#dgl-content [data-panel-form]').forEach(refresh);
    })();
  </script>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 20px; }
  h2 { font-size: 14.5px; margin: 0 0 14px; display: flex; align-items: center; gap: 8px; }
  h2 :global(svg) { color: var(--accent); }

  .tk-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; border-radius: 9px; padding: 10px 14px; margin-bottom: 20px; max-width: fit-content; }
  .tk-flash-ok { color: var(--green); background: var(--green-soft); border: 1px solid var(--green); }
  .tk-flash-warn { color: var(--amber, #e0b15c); background: color-mix(in srgb, var(--amber, #e0b15c) 12%, transparent); border: 1px solid var(--amber, #e0b15c); }
  .tk-panel-cats-empty { color: var(--amber, #e0b15c); }
  .tk-flash-err { color: var(--red); background: var(--red-soft); border: 1px solid var(--red); }

  .tk-section { margin-bottom: 40px; }
  .tk-section-hidden { display: none; }
  .tk-empty-note { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-dim); }
  .tk-empty-note :global(svg) { flex-shrink: 0; color: var(--accent); }

  .tk-cat-emoji-chip { width: 30px; height: 30px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: var(--bg-raise); font-size: 15px; }
  .tk-cat-del { border: none; background: transparent; color: var(--text-dim); cursor: pointer; padding: 4px; border-radius: 6px; }
  .tk-cat-del:hover { color: var(--red); background: var(--red-soft); }

  .tk-cat-row { display: flex; flex-direction: column; gap: 5px; }
  .tk-cat-row label { font-size: 13px; font-weight: 600; color: var(--text); }
  .tk-default-submit { position: absolute; width: 1px; height: 1px; padding: 0; border: 0; opacity: 0; overflow: hidden; pointer-events: none; }
  .tk-cat-row:not(.dfx-field) input, .tk-cat-row:not(.dfx-field) select, .tk-cat-row:not(.dfx-field) textarea { width: 100%; box-sizing: border-box; border: 1px solid var(--border); border-radius: 8px; padding: 7px 9px; background: var(--bg-raise); color: var(--text); font-family: var(--sans); font-size: 13px; }
  .tk-cat-row:not(.dfx-field) textarea { resize: vertical; min-height: 72px; line-height: 1.45; }


  .tk-add-form { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .tk-add-form input[type="text"] { border: 1px solid var(--border); border-radius: 8px; padding: 8px 11px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; }
  .tk-add-form input[name="label"] { min-width: 220px; }
  .tk-add-form select { border: 1px solid var(--border); border-radius: 8px; padding: 8px 11px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; }
  .tk-add-form .btn { display: inline-flex; align-items: center; gap: 6px; }

  :global(.tk-count){ font-family: var(--mono); font-size: 11px; color: var(--text-dim); font-weight: 400; }
  .tk-premium-tag { font-family: var(--mono); font-size: 10px; font-weight: 600; color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border: 1px solid color-mix(in srgb, var(--yellow) 32%, var(--border)); border-radius: 999px; padding: 3px 7px; }

  .tk-open-num { font-family: var(--mono); color: var(--accent); font-weight: 600; }

  .tk-section-note { font-size: 13px; line-height: 1.5; color: var(--text-dim); margin: -6px 0 16px; max-width: 70ch; }

  .tk-chip { display: inline-flex; align-items: center; gap: 5px; max-width: 100%; min-width: 0; overflow-wrap: anywhere; font-size: 11px; padding: 3px 9px; border-radius: 999px; border: 1px solid var(--border); color: var(--text-dim); text-decoration: none; }
  .tk-chip-ok { color: var(--green); background: var(--green-soft); border-color: transparent; }
  .tk-chip-warn { color: var(--amber, #e0b15c); border-color: var(--amber, #e0b15c); }
  .tk-panel-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); gap: 14px; margin-bottom: 16px; }
  .tk-panel-card { border: 1px solid var(--border); border-radius: 16px; padding: 18px; background: var(--card); display: flex; flex-direction: column; gap: 14px; }
  .tk-panel-form { display: flex; flex-direction: column; gap: 8px; }
  .tk-panel-head { display: flex; align-items: center; gap: 8px; }
  .tk-panel-chan { font-family: var(--mono); font-size: 11px; color: var(--text-dim); flex-shrink: 0; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
