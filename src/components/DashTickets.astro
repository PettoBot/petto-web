---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';

interface TicketCategory {
  id: number;
  label: string;
  emoji: string | null;
  description: string | null;
  buttonStyle: string;
  namingPattern: string;
  parentChannelId: string | null;
  supportRoleIds: string[];
  pingRoleIds: string[];
  maxOpenPerUser: number;
}
interface OpenTicket {
  id: number;
  ticketNumber: number;
  categoryLabel: string;
  openerId: string;
  claimedBy: string | null;
  channelId: string | null;
}

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  categories: TicketCategory[];
  roles: { id: string; name: string }[];
  channelCategories: { id: string; name: string }[];
  openTickets: OpenTicket[];
  saved: boolean;
  error?: string | null;
}
const { user, guildId, guildName, guildIcon, categories, roles, channelCategories, openTickets, saved, error } = Astro.props;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="tickets" pageTitle="Tickets">
  <h1>Tickets</h1>
  <p class="tk-sub">The support types members pick from in <b>{guildName}</b>, who gets pinged, and where tickets land. Post the panel itself with <code>/ticket panel</code>, everything else is here.</p>

  {saved && <div class="tk-flash tk-flash-ok"><Icon name="ph:check-circle-fill" width="15" height="15" />Saved.</div>}
  {error && <div class="tk-flash tk-flash-err"><Icon name="ph:warning-fill" width="15" height="15" />{error}</div>}

  <div class="tk-section">
    <h2><Icon name="ph:ticket-fill" width="15" height="15" />Support types</h2>
    {categories.length === 0 && <p class="tk-empty-note">No ticket types yet, add the first one below.</p>}

    <div class="tk-cat-grid">
      {categories.map((cat) => (
        <form method="POST" class="tk-cat-card">
          <input type="hidden" name="category_id" value={cat.id} />
          <div class="tk-cat-head">
            <span class="tk-cat-emoji-chip">{cat.emoji || '🎫'}</span>
            <input type="text" name="label" value={cat.label} maxlength="40" class="tk-cat-label" />
            <button type="submit" name="action" value="delete" class="tk-cat-del" title="Delete this type" formnovalidate>
              <Icon name="ph:trash-fill" width="14" height="14" />
            </button>
          </div>

          <div class="tk-cat-row">
            <label>Emoji</label>
            <input type="text" name="emoji" value={cat.emoji ?? ''} maxlength="4" placeholder="🎫" class="tk-emoji-input" />
          </div>

          <div class="tk-cat-row">
            <label>Description</label>
            <input type="text" name="description" value={cat.description ?? ''} maxlength="100" placeholder="Shown on the panel button/option" />
          </div>

          <div class="tk-cat-row">
            <label>Button style</label>
            <select name="button_style">
              {['primary', 'secondary', 'success', 'danger'].map((s) => <option value={s} selected={s === cat.buttonStyle}>{s}</option>)}
            </select>
          </div>

          <div class="tk-cat-row">
            <label>Channel name</label>
            <input type="text" name="naming_pattern" value={cat.namingPattern} maxlength="50" placeholder="ticket-{number}" />
          </div>

          <div class="tk-cat-row">
            <label>Opens in category</label>
            <select name="parent_channel_id">
              <option value="">Server default</option>
              {channelCategories.map((c) => (
                <option value={c.id} selected={c.id === cat.parentChannelId}>{c.name}</option>
              ))}
            </select>
          </div>

          <div class="tk-cat-row" data-filterable>
            <label>Support roles</label>
            <input type="text" class="dgl-filter-input" placeholder="Search roles..." data-filter-input />
            <div class="tk-role-list" data-filter-list>
              {roles.map((r) => (
                <label class="tk-role-item"><input type="checkbox" name="support_role_ids" value={r.id} checked={cat.supportRoleIds.includes(r.id)} />{r.name}</label>
              ))}
            </div>
          </div>

          <div class="tk-cat-row" data-filterable>
            <label>Ping on open</label>
            <input type="text" class="dgl-filter-input" placeholder="Search roles..." data-filter-input />
            <div class="tk-role-list" data-filter-list>
              {roles.map((r) => (
                <label class="tk-role-item"><input type="checkbox" name="ping_role_ids" value={r.id} checked={cat.pingRoleIds.includes(r.id)} />{r.name}</label>
              ))}
            </div>
          </div>

          <div class="tk-cat-row">
            <label>Max open per member</label>
            <input type="number" name="max_open_per_user" value={cat.maxOpenPerUser} min="1" max="10" />
          </div>

          <button type="submit" name="action" value="update" class="btn btn-ghost btn-sm">Save this type</button>
        </form>
      ))}
    </div>
  </div>

  <div class="tk-section">
    <h2><Icon name="ph:plus-circle-fill" width="15" height="15" />Add a support type</h2>
    <form method="POST" class="tk-add-form">
      <input type="hidden" name="action" value="create" />
      <input type="text" name="label" placeholder="e.g. Report a player" maxlength="40" required />
      <input type="text" name="emoji" placeholder="🎫" maxlength="4" class="tk-emoji-input" />
      <select name="parent_channel_id">
        <option value="">Server default category</option>
        {channelCategories.map((c) => <option value={c.id}>{c.name}</option>)}
      </select>
      <button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="13" height="13" />Add</button>
    </form>
  </div>

  <div class="tk-section">
    <h2><Icon name="ph:door-open-fill" width="15" height="15" />Open right now <span class="tk-count">{openTickets.length}</span></h2>
    {openTickets.length === 0 ? (
      <p class="tk-empty-note">Nothing open at the moment.</p>
    ) : (
      <div class="tk-open-list">
        {openTickets.map((t) => (
          <div class="tk-open-row">
            <span class="tk-open-num">#{t.ticketNumber}</span>
            <span class="tk-open-cat">{t.categoryLabel}</span>
            <span class="tk-open-opener">opened by <code>{t.openerId}</code></span>
            {t.claimedBy && <span class="tk-open-claimed"><Icon name="ph:hand-fill" width="12" height="12" />claimed</span>}
            {t.channelId && <a href={`https://discord.com/channels/${guildId}/${t.channelId}`} target="_blank" rel="noopener" class="tk-open-link"><Icon name="ph:arrow-square-out" width="13" height="13" />Open</a>}
          </div>
        ))}
      </div>
    )}
  </div>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  h2 { font-size: 14.5px; margin: 0 0 14px; display: flex; align-items: center; gap: 8px; }
  h2 :global(svg) { color: var(--accent); }
  .tk-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 28px; max-width: 68ch; }
  .tk-sub b { color: var(--text); }
  .tk-sub code { font-family: var(--mono); color: var(--accent); }

  .tk-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; border-radius: 9px; padding: 10px 14px; margin-bottom: 20px; max-width: fit-content; }
  .tk-flash-ok { color: var(--green); background: var(--green-soft); border: 1px solid var(--green); }
  .tk-flash-err { color: var(--red); background: var(--red-soft); border: 1px solid var(--red); }

  .tk-section { margin-bottom: 40px; }
  .tk-empty-note { font-size: 13px; color: var(--text-dim); }

  .tk-cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
  .tk-cat-card { border: 1px solid var(--border); border-radius: 13px; padding: 14px; background: var(--card); display: flex; flex-direction: column; gap: 12px; }
  .tk-cat-head { display: flex; align-items: center; gap: 8px; }
  .tk-cat-emoji-chip { width: 30px; height: 30px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: var(--bg-raise); font-size: 15px; }
  .tk-cat-label { flex: 1; border: 1px solid transparent; background: transparent; font-size: 14px; font-weight: 600; color: var(--text); padding: 4px 6px; border-radius: 6px; font-family: var(--sans); }
  .tk-cat-label:focus { outline: none; border-color: var(--border); background: var(--bg-raise); }
  .tk-cat-del { border: none; background: transparent; color: var(--text-dim); cursor: pointer; padding: 4px; border-radius: 6px; }
  .tk-cat-del:hover { color: var(--red); background: var(--red-soft); }

  .tk-cat-row { display: flex; flex-direction: column; gap: 5px; }
  .tk-cat-row label { font-size: 11px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.04em; }
  .tk-cat-row input, .tk-cat-row select { border: 1px solid var(--border); border-radius: 8px; padding: 7px 9px; background: var(--bg-raise); color: var(--text); font-family: var(--sans); font-size: 13px; }
  .tk-role-list { border: 1px solid var(--border); border-radius: 8px; background: var(--bg-raise); max-height: 110px; overflow-y: auto; padding: 4px; display: flex; flex-direction: column; }
  .tk-role-item { display: flex; align-items: center; gap: 8px; padding: 5px 7px; border-radius: 6px; font-size: 12.5px; color: var(--text-muted); cursor: pointer; }
  .tk-role-item:hover { background: var(--card-hover); color: var(--text); }
  .tk-role-item input { flex-shrink: 0; accent-color: var(--accent); }
  .tk-emoji-input { max-width: 70px; }

  .tk-cat-card .btn-sm { align-self: flex-start; margin-top: 2px; }

  .tk-add-form { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .tk-add-form input[type="text"] { border: 1px solid var(--border); border-radius: 8px; padding: 8px 11px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; }
  .tk-add-form input[name="label"] { min-width: 220px; }
  .tk-add-form select { border: 1px solid var(--border); border-radius: 8px; padding: 8px 11px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; }
  .tk-add-form .btn { display: inline-flex; align-items: center; gap: 6px; }

  .tk-count { font-family: var(--mono); font-size: 11px; color: var(--text-dim); font-weight: 400; }

  .tk-open-list { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
  .tk-open-row { display: flex; align-items: center; gap: 14px; padding: 10px 14px; font-size: 13px; background: var(--card); flex-wrap: wrap; }
  .tk-open-row + .tk-open-row { border-top: 1px solid var(--border-soft); }
  .tk-open-num { font-family: var(--mono); color: var(--accent); font-weight: 600; }
  .tk-open-cat { color: var(--text-muted); }
  .tk-open-opener { color: var(--text-dim); font-size: 12px; }
  .tk-open-opener code { font-family: var(--mono); }
  .tk-open-claimed { display: flex; align-items: center; gap: 4px; font-size: 11.5px; color: var(--green); }
  .tk-open-link { margin-left: auto; display: flex; align-items: center; gap: 4px; color: var(--accent); text-decoration: none; font-size: 12.5px; }
  .tk-open-link:hover { text-decoration: underline; }
</style>
