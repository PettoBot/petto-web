---
import EmojiPicker from './EmojiPicker.astro';
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MultiSelect from './MultiSelect.astro';
import TicketFieldsBuilder from './TicketFieldsBuilder.astro';
import TicketEmoji from './TicketEmoji.astro';
import TicketGuide from './TicketGuide.astro';
import TicketPanelPreview from './TicketPanelPreview.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface TicketCategory {
  id: number;
  panelId: number | null;
  key: string;
  label: string;
  emoji: string | null;
  description: string | null;
  buttonStyle: string;
  namingPattern: string;
  welcomeMessage?: string;
  welcomeSupported?: boolean;
  parentChannelId: string | null;
  supportRoleIds: string[];
  pingRoleIds: string[];
  maxOpenPerUser: number;
  formId: number | null;
  requiredRoleIds: string[];
}
interface TicketForm { id: number; name: string; title: string; fields: { type: string; id: string; label: string; placeholder?: string; required?: boolean }[]; }
interface TicketBlacklistEntry { id: number; target_type: string; target_id: string; reason: string | null; }
interface Panel {
  id: number;
  channelId: string;
  messageId: string | null;
  title: string | null;
  description: string | null;
  style: string;
  embedTemplate: string | null;
  color: string;
  imageUrl: string;
  footer: string;
  placeholder: string;
  categoryCount: number;
  types: { label: string; emoji: string | null; description?: string | null; buttonStyle?: string }[];
}
interface TicketSettings {
  claimMode: string;
  pingOnClaim: boolean;
  rolesToAddOnClaim: string[];
  closeRequiresSupportRole: boolean;
  closeRequiresReason: boolean;
  hideClosingUser: boolean;
  dmUserOnClose: boolean;
  defaultCloseReason: string;
  logStaffMessageCounts: boolean;
  autocloseLeave: boolean;
  autocloseInactivityEnabled: boolean;
  autocloseInactivityHours: number;
  ratingEnabled: boolean;
  ratingMode: string;
  ratingLogChannelId: string;
  openedLogChannelId: string;
  closedLogChannelId: string;
  blockedRoleIds: string[];
  globalLimit: number;
  hoursEnabled: boolean;
  hoursTimezone: string;
  hoursStart: string;
  hoursEnd: string;
  hoursDays: number[];
  hoursBlock: boolean;
  hoursMessage: string;
}
interface OpenTicket {
  id: number;
  ticketNumber: number;
  categoryLabel: string;
  openerId: string;
  claimedBy: string | null;
  channelId: string | null;
}

interface Props {
  customEmojis?: { id: string; name: string; animated: boolean }[];
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  categories: TicketCategory[];
  panels: Panel[];
  settings: TicketSettings;
  roles: { id: string; name: string }[];
  channelCategories: { id: string; name: string }[];
  textChannels: { id: string; name: string }[];
  embedTemplateNames: string[];
  forms: TicketForm[];
  blacklist: TicketBlacklistEntry[];
  openTickets: OpenTicket[];
  premiumActive: boolean;
  saved: boolean;
  error?: string | null;
  warnings?: string[];
  section?: string;
}
const { user, guildId, guildName, guildIcon, customEmojis = [], categories, panels, settings, roles, channelCategories, textChannels, embedTemplateNames, forms, blacklist, openTickets, saved, error, warnings = [], premiumActive, section } = Astro.props;
const sectionMeta: Record<string, string> = { panels: dt('Ticket panels'), types: dt('Support types'), forms: dt('Ticket forms'), access: dt('Ticket access'), settings: dt('Ticket settings'), open: dt('Open tickets') };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'panels';
const selectedTitle = sectionMeta[selectedSection];
function channelName(id: string | null) {
  return textChannels.find((c) => c.id === id)?.name ?? id;
}
const ticketCategoryLimit = premiumActive ? 20 : 5;
const ticketCategoryAtLimit = categories.length >= ticketCategoryLimit;
const postedCount = panels.filter((p) => p.messageId).length;
const showGuide = ['panels', 'types', 'settings'].includes(selectedSection);
const buttonStyles = [
  { value: 'primary', label: dt('Blue (main)') },
  { value: 'secondary', label: dt('Gray') },
  { value: 'success', label: dt('Green') },
  { value: 'danger', label: dt('Red') },
];
// Ready designs for a new panel: pressing one fills the form below, and everything can still be changed.
const presets = [
  { id: 'classic', name: dt('Classic support'), icon: 'ph:ticket-fill', color: '#a5ea7a', style: 'button', title: dt('Support'), description: dt('Press a button to open a ticket. Our team will answer you as soon as possible.'), footer: dt('One ticket per topic, please.'), placeholder: '' },
  { id: 'help', name: dt('Help center (dropdown)'), icon: 'ph:list-bullets-fill', color: '#ffb86c', style: 'select', title: dt('Help center'), description: dt('Choose a category from the menu and a private channel opens with the staff.'), footer: dt('Replies can take a few minutes.'), placeholder: dt('Choose the type of ticket...') },
  { id: 'reports', name: dt('Reports'), icon: 'ph:flag-fill', color: '#ff6b6b', style: 'button', title: dt('Report a problem'), description: dt('Tell us about a member, a bug or something that is not right. Include proof if you have it.'), footer: dt('Only the staff can see your ticket.'), placeholder: '' },
  { id: 'apply', name: dt('Applications'), icon: 'ph:hand-waving-fill', color: '#f78fb3', style: 'button', title: dt('Join the team'), description: dt('Want to help? Open a ticket and answer a few questions so we can get to know you.'), footer: dt('We read every application.'), placeholder: '' },
  { id: 'minimal', name: dt('Minimal'), icon: 'ph:minus-circle-fill', color: '#ffd563', style: 'button', title: dt('Tickets'), description: dt('Press a button to talk to the staff.'), footer: '', placeholder: '' },
];
const hourDays = [
  { n: 1, label: dt('Mon') }, { n: 2, label: dt('Tue') }, { n: 3, label: dt('Wed') }, { n: 4, label: dt('Thu') }, { n: 5, label: dt('Fri') }, { n: 6, label: dt('Sat') }, { n: 0, label: dt('Sun') },
];
const timezones = ['America/Bogota', 'America/Mexico_City', 'America/Lima', 'America/Argentina/Buenos_Aires', 'America/Santiago', 'America/Sao_Paulo', 'America/New_York', 'America/Los_Angeles', 'Europe/Madrid', 'Europe/London', 'UTC'];
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'panels' ? 'tickets' : `tickets-${selectedSection}`} pageTitle={selectedTitle}>
  <h1>{selectedTitle}</h1>
  <p class="tk-sub"><Fragment set:html={dth('Panels, support types, and how tickets close, all configured for <b>{a}</b> from here. The prefix <code>ticket</code> command in Discord still works for everything, this is the same data.', { a: (guildName) })} /></p>
  {showGuide && <TicketGuide guildId={guildId} section={selectedSection} typeCount={categories.length} panelCount={panels.length} postedCount={postedCount} />}

  {saved && <div class="tk-flash tk-flash-ok"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {warnings.map((w) => <div class="tk-flash tk-flash-warn"><Icon name="ph:info-fill" width="15" height="15" />{w}</div>)}
  {error && <div class="tk-flash tk-flash-err"><Icon name="ph:warning-fill" width="15" height="15" />{error}</div>}

  {selectedSection === 'panels' && (
  <div class:list={['tk-section', { 'tk-section-hidden': selectedSection !== 'panels' }]}>
    <h2><Icon name="ph:squares-four-fill" width="15" height="15" /><Fragment set:html={dth('Panels <span class="tk-count">{a}</span>', { a: (panels.length) })} /></h2>
    <p class="tk-section-note">{dt('The message members use to open a ticket: a card with buttons or a dropdown. Saving posts it or updates it in the same place; moving posts a new one in the new channel.')}</p>
    {panels.length === 0 && <p class="tk-empty-note">{dt('No panels yet. Pick a ready design below to start.')}</p>}

    <div class="tk-panel-grid">
      {panels.map((p) => (
        <div class="tk-panel-card">
          <form method="POST" class="tk-panel-form" data-panel-form>
            <input type="hidden" name="action" value="update_panel" />
            <input type="hidden" name="panel_id" value={p.id} />
            <div class="tk-panel-head">
              <span class="tk-panel-chan">#{channelName(p.channelId)}</span>
              {p.messageId
                ? <a class="tk-chip tk-chip-ok" href={`https://discord.com/channels/${guildId}/${p.channelId}/${p.messageId}`} target="_blank" rel="noopener"><Icon name="ph:check-circle-fill" width="12" height="12" />{dt('Posted')} · {dt('Open in Discord')}</a>
                : <span class="tk-chip tk-chip-warn"><Icon name="ph:warning-fill" width="12" height="12" />{dt('Not posted yet. Press Resend.')}</span>}
              {p.embedTemplate && <span class="tk-chip">{dt('Design')}: {p.embedTemplate}</span>}
            </div>
            <div class="tk-panel-body">
            <div class="tk-fields">
              <div class="tk-cat-row"><label>{dt('Title')}</label><input type="text" name="title" value={p.title ?? ''} maxlength="100" placeholder={dt('Panel title')} /></div>
              <div class="tk-cat-row"><label>{dt('Description')}</label><textarea name="description" rows="3" maxlength="500" placeholder={dt('Panel description')}>{p.description ?? ''}</textarea></div>
              <div class="tk-two">
                <div class="tk-cat-row"><label>{dt('Style')}</label>
                  <select name="style">
                    <option value="button" selected={p.style === 'button'}>{dt('Buttons (max 5 types)')}</option>
                    <option value="select" selected={p.style === 'select'}>{dt('Dropdown (up to 25 types)')}</option>
                  </select>
                </div>
                <div class="tk-cat-row"><label>{dt('Card color')}</label>
                  <div class="tk-color"><input type="color" data-color-pick value={p.color || '#a5ea7a'} aria-label={dt('Card color')} /><input type="text" name="color" value={p.color} maxlength="7" placeholder="#a5ea7a" /></div>
                </div>
              </div>
              <div class="tk-cat-row"><label>{dt('Picture on top')}</label><input type="url" name="image_url" value={p.imageUrl} maxlength="500" placeholder="https://..." /><p class="tk-row-hint">{dt('A banner. The link has to start with https.')}</p></div>
              <div class="tk-cat-row"><label>{dt('Small text under the panel')}</label><input type="text" name="footer" value={p.footer} maxlength="300" placeholder={dt('Optional')} /></div>
              <div class="tk-cat-row" data-only-select><label>{dt('Text of the dropdown')}</label><input type="text" name="placeholder" value={p.placeholder} maxlength="150" placeholder={dt('Select a ticket category...')} /></div>
              {embedTemplateNames.length > 0 && (
                <div class="tk-cat-row"><label>{dt('Saved design')}</label>
                  <select name="embed_template" data-dp-template-only>
                    <option value="">{dt('None: use the fields above')}</option>
                    {embedTemplateNames.map((n) => <option value={n} selected={n === p.embedTemplate}>{n}</option>)}
                  </select>
                  <p class="tk-row-hint">{dt('A design made in Embeds replaces the card above.')}</p>
                </div>
              )}
            </div>
            <TicketPanelPreview title={p.title} description={p.description} color={p.color} imageUrl={p.imageUrl} footer={p.footer} style={p.style} placeholder={p.placeholder} types={p.types} design={p.embedTemplate} />
            </div>
            <p class:list={['tk-panel-cats', { 'tk-panel-cats-empty': p.categoryCount === 0 }]}>{p.categoryCount === 0 ? dt('No types on this panel yet. Add one in Support types and pick this panel.') : dt('{n} types on this panel', { n: p.categoryCount })}</p>
            <div class="tk-panel-actions">
              <button type="submit" name="action" value="update_panel" class="btn btn-accent btn-sm">{dt('Save and update the message')}</button>
            </div>
          </form>
          <details class="tk-more">
            <summary>{dt('Move, resend or delete')}</summary>
            <form method="POST" class="tk-panel-move">
              <input type="hidden" name="action" value="move_panel" />
              <input type="hidden" name="panel_id" value={p.id} />
              <select name="channel_id">
                {textChannels.map((c) => <option value={c.id} selected={c.id === p.channelId}>#{c.name}</option>)}
              </select>
              <button type="submit" name="action" value="move_panel" class="btn btn-ghost btn-sm">{dt('Move')}</button>
            </form>
            <div class="tk-panel-actions">
              <form method="POST"><input type="hidden" name="action" value="resend_panel" /><input type="hidden" name="panel_id" value={p.id} /><button type="submit" name="action" value="resend_panel" class="btn btn-ghost btn-sm" data-confirm={dt('Resend this panel? The message in Discord is deleted and posted again.')}>{dt('Resend')}</button></form>
              <form method="POST"><input type="hidden" name="action" value="delete_panel" /><input type="hidden" name="panel_id" value={p.id} /><button type="submit" name="action" value="delete_panel" class="tk-cat-del" title={dt('Delete this panel')} data-confirm={dt('Delete this panel? Its message in Discord is deleted too. Ticket types stay, but are no longer on a panel.')} formnovalidate><Icon name="ph:trash-fill" width="14" height="14" /></button></form>
            </div>
          </details>
        </div>
      ))}
    </div>

    <div class="tk-new-panel">
      <h2><Icon name="ph:plus-circle-fill" width="15" height="15" />{dt('New panel')}</h2>
      <p class="tk-section-note">{dt('Pick a ready design. It fills the form: you can change anything before posting.')}</p>
      <div class="tk-presets" data-presets>
        {presets.map((pr) => (
          <button type="button" class="tk-preset" data-preset={pr.id} data-title={pr.title} data-description={pr.description} data-color={pr.color} data-style={pr.style} data-footer={pr.footer} data-placeholder={pr.placeholder} style={`--pc:${pr.color}`}>
            <Icon name={pr.icon} width="16" height="16" /><span>{pr.name}</span>
          </button>
        ))}
      </div>
      <div class="tk-new-grid">
        <form method="POST" class="tk-panel-form tk-new-form" data-panel-form data-new-panel>
          <input type="hidden" name="action" value="create_panel" />
          <div class="tk-fields">
            <div class="tk-cat-row"><label>{dt('Channel')}</label>
              <select name="channel_id" required>
                <option value="" disabled selected>{dt('Choose where to post it')}</option>
                {textChannels.map((c) => <option value={c.id}>#{c.name}</option>)}
              </select>
            </div>
            <div class="tk-cat-row"><label>{dt('Title')}</label><input type="text" name="title" maxlength="100" placeholder={dt('Panel title')} /></div>
            <div class="tk-cat-row"><label>{dt('Description')}</label><textarea name="description" rows="3" maxlength="500" placeholder={dt('Panel description')}></textarea></div>
            <div class="tk-two">
              <div class="tk-cat-row"><label>{dt('Style')}</label>
                <select name="style"><option value="button">{dt('Buttons (max 5 types)')}</option><option value="select">{dt('Dropdown (up to 25 types)')}</option></select>
              </div>
              <div class="tk-cat-row"><label>{dt('Card color')}</label>
                <div class="tk-color"><input type="color" data-color-pick value="#a5ea7a" aria-label={dt('Card color')} /><input type="text" name="color" maxlength="7" placeholder="#a5ea7a" /></div>
              </div>
            </div>
            <div class="tk-cat-row"><label>{dt('Picture on top')}</label><input type="url" name="image_url" maxlength="500" placeholder="https://..." /></div>
            <div class="tk-cat-row"><label>{dt('Small text under the panel')}</label><input type="text" name="footer" maxlength="300" placeholder={dt('Optional')} /></div>
            <div class="tk-cat-row" data-only-select><label>{dt('Text of the dropdown')}</label><input type="text" name="placeholder" maxlength="150" placeholder={dt('Select a ticket category...')} /></div>
            {embedTemplateNames.length > 0 && (
              <div class="tk-cat-row"><label>{dt('Saved design')}</label>
                <select name="embed_template" data-dp-template-only>
                  <option value="">{dt('None: use the fields above')}</option>
                  {embedTemplateNames.map((n) => <option value={n}>{n}</option>)}
                </select>
              </div>
            )}
          </div>
          <div class="tk-panel-actions"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:paper-plane-tilt-fill" width="13" height="13" />{dt('Create and post the panel')}</button></div>
        </form>
        <div class="tk-new-preview"><TicketPanelPreview title="" description="" style="button" types={categories.filter((c) => !c.panelId).slice(0, 5).map((c) => ({ label: c.label, emoji: c.emoji, description: c.description, buttonStyle: c.buttonStyle }))} /></div>
      </div>
      {embedTemplateNames.length > 0 && <p class="tk-row-hint">{dt('A template\'s own title/description/color/image win over the fields above. Only server-wide variables resolve here ({a}, {b}, etc), not per-member ones, since no one specific opens a panel.', { a: ('{server_name}'), b: ('{guild.icon}') })}</p>}
    </div>
  </div>
  )}

  {selectedSection === 'types' && (
  <div class:list={['tk-section', { 'tk-section-hidden': selectedSection !== 'types' }]}>
    <h2><Icon name="ph:ticket" width="15" height="15" /><Fragment set:html={dth('Support types <span class="tk-count">{a}/{b}</span>', { a: (categories.length), b: (ticketCategoryLimit) })} />{!premiumActive && <span class="tk-premium-tag">Premium: 20</span>}</h2>
    <p class="tk-section-note">{dt('A support type is a reason to open a ticket: Support, Report a player, Purchases... Each one appears as a button or option on a panel, and has its own staff and rules.')}</p>
    {categories.length === 0 && <p class="tk-empty-note">{dt('No ticket types yet, add the first one below.')}</p>}

    <div class="tk-cat-grid">
      {categories.map((cat) => (
        <form method="POST" class="tk-cat-card">
          <input type="hidden" name="category_id" value={cat.id} />
          {/* The first button of a form is the one Enter presses, so a save sits before the delete button. */}
          <button type="submit" name="action" value="update" class="tk-default-submit" tabindex="-1" aria-hidden="true"></button>
          <div class="tk-cat-head">
            <span class="tk-cat-emoji-chip"><TicketEmoji emoji={cat.emoji} size={20} /></span>
            <input type="text" name="label" value={cat.label} maxlength="40" class="tk-cat-label" aria-label={dt('Name of the type')} />
            <button type="submit" name="action" value="delete" class="tk-cat-del" title={dt('Delete this type')} data-confirm={dt('Delete this support type? Members can no longer open tickets with it. This cannot be undone.')} formnovalidate>
              <Icon name="ph:trash-fill" width="14" height="14" />
            </button>
          </div>
          <p class="tk-where">{cat.panelId ? dt('On the panel: {name}', { name: panels.find((p) => p.id === cat.panelId)?.title || `#${channelName(panels.find((p) => p.id === cat.panelId)?.channelId ?? null)}` }) : dt('Not on any panel yet: nobody can open it.')}</p>

          <details class="tk-group" open>
            <summary>{dt('How it looks on the panel')}</summary>
            <div class="tk-cat-row">
              <label>{dt('Panel where it appears')}</label>
              <select name="panel_id">
                <option value="">{dt('None (not on any panel)')}</option>
                {panels.map((p) => <option value={p.id} selected={p.id === cat.panelId}>{p.title || `#${channelName(p.channelId)}`}</option>)}
              </select>
            </div>
            <div class="tk-cat-row">
              <label>{dt('Emoji')}</label>
              <input type="text" name="emoji" data-emoji-input value={cat.emoji ?? ''} maxlength="64" autocomplete="off" placeholder="🎫" class="tk-emoji-input" />
              <p class="tk-row-hint">{dt('Pick one with the button on the right. Server emojis work too.')}</p>
            </div>
            <div class="tk-cat-row">
              <label>{dt('Short description')}</label>
              <input type="text" name="description" value={cat.description ?? ''} maxlength="100" placeholder={dt('Shown under the name in the dropdown')} />
            </div>
            <div class="tk-cat-row">
              <label>{dt('Button color')}</label>
              <select name="button_style">
                {buttonStyles.map((b) => <option value={b.value} selected={b.value === cat.buttonStyle}>{b.label}</option>)}
              </select>
            </div>
          </details>

          <details class="tk-group">
            <summary>{dt('When the ticket opens')}</summary>
            <div class="tk-cat-row">
              <label>{dt('Channel name')}</label>
              <input type="text" name="naming_pattern" value={cat.namingPattern} maxlength="50" placeholder="ticket-{number}" />
              <p class="tk-row-hint">{dt('You can use {number}, {username}, {userid} and {category}.')}</p>
            </div>
            {cat.welcomeSupported && (
              <div class="tk-cat-row">
                <label>{dt('Welcome text')}</label>
                <input type="hidden" name="welcome_supported" value="1" />
                <textarea name="welcome_message" rows="3" maxlength="1000" placeholder={dt('Hi {user}! Tell us what you need and staff will answer soon.')}>{cat.welcomeMessage ?? ''}</textarea>
                <p class="tk-row-hint">{dt('Shown inside the ticket. You can use {user}, {username}, {category}, {server} and {number}. A saved embed set for this type is used instead.')}</p>
              </div>
            )}
            <div class="tk-cat-row">
              <label>{dt('Discord category where the channel is made')}</label>
              <select name="parent_channel_id">
                <option value="">{dt('Server default')}</option>
                {channelCategories.map((c) => (
                  <option value={c.id} selected={c.id === cat.parentChannelId}>{c.name}</option>
                ))}
              </select>
            </div>
            <div class="tk-cat-row">
              <label>{dt('Intake form')}</label>
              <select name="form_id">
                <option value="">{dt('No form')}</option>
                {forms.map((form) => <option value={form.id} selected={String(form.id) === String(cat.formId)}>{form.name} · {form.title}</option>)}
              </select>
            </div>
          </details>

          <details class="tk-group">
            <summary>{dt('Who answers and who can open it')}</summary>
            <div class="tk-cat-row">
              <label>{dt('Support roles')}</label>
              <MultiSelect name="support_role_ids" options={roles} selected={cat.supportRoleIds} placeholder={dt('Search roles...')} />
              <p class="tk-row-hint">{dt('They can see and answer these tickets.')}</p>
            </div>
            <div class="tk-cat-row">
              <label>{dt('Ping on open')}</label>
              <MultiSelect name="ping_role_ids" options={roles} selected={cat.pingRoleIds} placeholder={dt('Search roles...')} />
            </div>
            <div class="tk-cat-row">
              <label>{dt('Required roles')}</label>
              <MultiSelect name="required_role_ids" options={roles} selected={cat.requiredRoleIds} placeholder={dt('Search roles...')} />
              <p class="tk-row-hint">{dt('Only members with all of them can open this type. Empty for everyone.')}</p>
            </div>
            <div class="tk-cat-row">
              <label>{dt('Max open per member')}</label>
              <input type="number" name="max_open_per_user" value={cat.maxOpenPerUser} min="1" max="10" />
            </div>
          </details>

          <button type="submit" name="action" value="update" class="btn btn-accent btn-sm">{dt('Save this type')}</button>
        </form>
      ))}
    </div>
  </div>
  )}

  {selectedSection === 'types' && (
  <div class:list={['tk-section', { 'tk-section-hidden': selectedSection !== 'types' }]} data-tk-new-type>
    <h2><Icon name="ph:plus-circle-fill" width="15" height="15" />{dt('Add a support type')}</h2>
    {ticketCategoryAtLimit ? (
      <div class="tk-limit-card">
        <div><strong>{premiumActive ? dt('Ticket type limit reached') : dt('Free ticket type limit reached')}</strong><span>{premiumActive ? dt('You are using all {n} available ticket types.',{n:ticketCategoryLimit}) : dt('Free includes 5 ticket types. Premium increases this to 20.')}</span></div>
        {!premiumActive && <a class="btn btn-ghost btn-sm" href={`/dash/premium?guild_id=${guildId}`}>{dt('Unlock Premium')}</a>}
      </div>
    ) : (<form method="POST" class="tk-add-form tk-add-type">
      <input type="hidden" name="action" value="create" />
      <div class="tk-cat-row"><label>{dt('Name of the type')}</label><input type="text" name="label" placeholder={dt('e.g. Report a player')} maxlength="40" required /></div>
      <div class="tk-cat-row"><label>{dt('Emoji')}</label><input type="text" name="emoji" data-emoji-input placeholder="🎫" maxlength="64" autocomplete="off" class="tk-emoji-input" /></div>
      <div class="tk-cat-row"><label>{dt('Panel where it appears')}</label>
        <select name="panel_id">
          <option value="">{dt('No panel yet')}</option>
          {panels.map((p) => <option value={p.id}>{p.title || `#${channelName(p.channelId)}`}</option>)}
        </select>
      </div>
      <div class="tk-cat-row"><label>{dt('Discord category where the channel is made')}</label>
        <select name="parent_channel_id">
          <option value="">{dt('Server default category')}</option>
          {channelCategories.map((c) => <option value={c.id}>{c.name}</option>)}
        </select>
      </div>
      <button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="13" height="13" />{dt('Add')}</button>
    </form>)}
    {forms.length === 0 && <p class="tk-row-hint"><Fragment set:html={dth('Create forms in Discord with <code>!ticket form create</code>, then assign them here.')} /></p>}
  </div>
  )}

  {selectedSection === 'forms' && (
  <div class:list={['tk-section', { 'tk-section-hidden': selectedSection !== 'forms' }]}>
    <h2><Icon name="ph:clipboard-text-fill" width="15" height="15" /><Fragment set:html={dth('Ticket forms <span class="tk-count">{a}</span>', { a: (forms.length) })} /></h2>
    <p class="tk-section-note"><Fragment set:html={dth('Reusable intake forms shown before a form-backed ticket opens. Add the questions below; in Discord the same fields use <code>type|id|label|placeholder|required;...</code>.')} /></p>
    <div class="tk-cat-grid">
      {forms.map((form) => (
        <form method="POST" class="tk-cat-card">
          <input type="hidden" name="form_id" value={form.id} />
          <input type="hidden" name="form_name" value={form.name} />
          <input type="hidden" name="action" value="update_ticket_form" />
          <div class="tk-cat-head"><input type="text" name="form_name_display" value={form.name} disabled class="tk-cat-label" /></div>
          <div class="tk-cat-row"><label>{dt('Modal title')}</label><input type="text" name="form_title" value={form.title} maxlength="45" required /></div>
          <div class="tk-cat-row"><label>{dt('Fields')}</label><TicketFieldsBuilder fields={form.fields} /></div>
          <div class="tk-panel-actions"><button type="submit" class="btn btn-ghost btn-sm">{dt('Save form')}</button></div>
        </form>
        <form method="POST" class="tk-panel-actions"><input type="hidden" name="action" value="delete_ticket_form" /><input type="hidden" name="form_id" value={form.id} /><button type="submit" class="tk-cat-del">{dt('Delete form')}</button></form>
      ))}
    </div>
    <form method="POST" class="tk-add-form">
      <input type="hidden" name="action" value="create_ticket_form" />
      <input type="text" name="form_name" autocomplete="off" placeholder={dt('Form name')} maxlength="50" required />
      <input type="text" name="form_title" autocomplete="off" placeholder={dt('Modal title')} maxlength="45" value="Ticket details" required />
      <TicketFieldsBuilder />
      <button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="13" height="13" />{dt('Create form')}</button>
    </form>
    {forms.length === 0 && <p class="tk-row-hint">{dt('No forms yet. Create one here, then assign it to a support type.')}</p>}
  </div>
  )}

  {selectedSection === 'access' && (
  <div class:list={['tk-section', { 'tk-section-hidden': selectedSection !== 'access' }]}>
    <h2><Icon name="ph:prohibit-fill" width="15" height="15" /><Fragment set:html={dth('Ticket access <span class="tk-count">{a}</span>', { a: (blacklist.length) })} /></h2>
    <p class="tk-section-note">{dt('Block a user or role from opening tickets. Role entries apply to every member with that role.')}</p>
    <div class="tk-open-list">
      {blacklist.map((entry) => (
        <div class="tk-open-row">
          <div><span class="tk-open-num">{entry.target_type}</span><code>{entry.target_id}</code>{entry.reason && <span class="tk-row-hint">{entry.reason}</span>}</div>
          <form method="POST"><input type="hidden" name="action" value="remove_ticket_blacklist" /><input type="hidden" name="target_type" value={entry.target_type} /><input type="hidden" name="target_id" value={entry.target_id} /><button type="submit" class="btn btn-ghost btn-sm">{dt('Remove')}</button></form>
        </div>
      ))}
    </div>
    <form method="POST" class="tk-add-form">
      <input type="hidden" name="action" value="add_ticket_blacklist" />
      <select name="target_type"><option value="user">{dt('User ID')}</option><option value="role">{dt('Role ID')}</option></select>
      <input type="text" name="target_id" placeholder={dt('Discord ID')} inputmode="numeric" pattern="[0-9]{5,25}" required />
      <input type="text" name="reason" placeholder={dt('Reason (optional)')} maxlength="300" />
      <button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="13" height="13" />{dt('Block')}</button>
    </form>
  </div>
  )}

  {selectedSection === 'settings' && (
  <div class:list={['tk-section', { 'tk-section-hidden': selectedSection !== 'settings' }]}>
    <h2><Icon name="ph:gear-six-fill" width="15" height="15" />{dt('Settings')}</h2>
    <form method="POST" class="tk-settings-form">
      <input type="hidden" name="action" value="save_settings" />

      <div class="tk-settings-grid">
        <div class="tk-set-card">
          <div class="tk-set-head">{dt('Claiming')}</div>
          <div class="tk-cat-row">
            <label>{dt('Claim mode')}</label>
            <select name="claim_mode">
              <option value="shared" selected={settings.claimMode === 'shared'}>{dt('Shared, any staff can still act on a claimed ticket')}</option>
              <option value="exclusive" selected={settings.claimMode === 'exclusive'}>{dt('Exclusive, only the claimer (or an admin) can act on it')}</option>
            </select>
          </div>
          <label class="tk-check"><input type="checkbox" name="ping_on_claim" checked={settings.pingOnClaim} />{dt('Ping the ticket opener when claimed')}</label>
          <div class="tk-cat-row">
            <label>{dt('Roles to add on claim')}</label>
            <MultiSelect name="roles_to_add_on_claim" options={roles} selected={settings.rolesToAddOnClaim} placeholder={dt('Search roles...')} />
          </div>
        </div>

        <div class="tk-set-card">
          <div class="tk-set-head">{dt('Closing')}</div>
          <label class="tk-check"><input type="checkbox" name="close_requires_support_role" checked={settings.closeRequiresSupportRole} />{dt('Only support roles can close (not the opener)')}</label>
          <label class="tk-check"><input type="checkbox" name="close_requires_reason" checked={settings.closeRequiresReason} />{dt('Require a reason to close')}</label>
          <label class="tk-check"><input type="checkbox" name="hide_closing_user" checked={settings.hideClosingUser} />{dt('Hide who closed it from the opener')}</label>
          <label class="tk-check"><input type="checkbox" name="dm_user_on_close" checked={settings.dmUserOnClose} />{dt('DM the opener with the transcript on close')}</label>
          <div class="tk-cat-row">
            <label>{dt('Default close reason')}</label>
            <input type="text" name="default_close_reason" value={settings.defaultCloseReason} maxlength="300" placeholder={dt('Used when no reason is given')} />
          </div>
          <label class="tk-check"><input type="checkbox" name="log_staff_message_counts" checked={settings.logStaffMessageCounts} />{dt('Log staff reply counts in the closed-ticket log')}</label>
        </div>

        <div class="tk-set-card">
          <div class="tk-set-head">{dt('Autoclose')}</div>
          <label class="tk-check"><input type="checkbox" name="autoclose_leave" checked={settings.autocloseLeave} />{dt('Close a member\'s tickets when they leave')}</label>
          <label class="tk-check"><input type="checkbox" name="autoclose_inactivity_enabled" checked={settings.autocloseInactivityEnabled} />{dt('Close tickets after a period of inactivity')}</label>
          <div class="tk-cat-row">
            <label>{dt('Inactivity period (hours)')}</label>
            <input type="number" name="autoclose_inactivity_hours" value={settings.autocloseInactivityHours} min="1" max="720" />
          </div>
        </div>

        <div class="tk-set-card">
          <div class="tk-set-head">{dt('Ratings')}</div>
          <label class="tk-check"><input type="checkbox" name="rating_enabled" checked={settings.ratingEnabled} />{dt('Let members rate a ticket after it closes')}</label>
          <div class="tk-cat-row">
            <label>{dt('Rating mode')}</label>
            <select name="rating_mode">
              <option value="rating_only" selected={settings.ratingMode === 'rating_only'}>{dt('Stars only')}</option>
              <option value="rating_comment" selected={settings.ratingMode === 'rating_comment'}>{dt('Stars + optional comment')}</option>
            </select>
          </div>
          <div class="tk-cat-row">
            <label>{dt('Rating log channel')}</label>
            <select name="rating_log_channel_id">
              <option value="">{dt('None')}</option>
              {textChannels.map((c) => <option value={c.id} selected={c.id === settings.ratingLogChannelId}>#{c.name}</option>)}
            </select>
          </div>
        </div>

        <div class="tk-set-card">
          <div class="tk-set-head">{dt('Logging')}</div>
          <div class="tk-cat-row">
            <label>{dt('Opened tickets log channel')}</label>
            <select name="opened_log_channel_id">
              <option value="">{dt('None')}</option>
              {textChannels.map((c) => <option value={c.id} selected={c.id === settings.openedLogChannelId}>#{c.name}</option>)}
            </select>
          </div>
          <div class="tk-cat-row">
            <label>{dt('Closed tickets log channel')}</label>
            <select name="closed_log_channel_id">
              <option value="">{dt('None')}</option>
              {textChannels.map((c) => <option value={c.id} selected={c.id === settings.closedLogChannelId}>#{c.name}</option>)}
            </select>
          </div>
          <p class="tk-row-hint"><Fragment set:html={dth('Separate from the Logging page\'s <b>Tickets</b> route, which can run alongside these dedicated channels.')} /></p>
        </div>

        <div class="tk-set-card">
          <div class="tk-set-head">{dt('Limits')}</div>
          <div class="tk-cat-row">
            <label>{dt('Open tickets at the same time per member')}</label>
            <input type="number" name="global_limit" value={settings.globalLimit} min="0" max="50" />
            <p class="tk-row-hint">{dt('In the whole server, whatever the type. 0 for no limit. Each type has its own limit too.')}</p>
          </div>
        </div>

        <div class="tk-set-card tk-set-wide">
          <div class="tk-set-head">{dt('Staff hours')}</div>
          <label class="tk-check"><input type="checkbox" name="hours_enabled" checked={settings.hoursEnabled} />{dt('Tell members when the staff answers')}</label>
          <div class="tk-two">
            <div class="tk-cat-row"><label>{dt('From')}</label><input type="time" name="hours_start" value={settings.hoursStart} /></div>
            <div class="tk-cat-row"><label>{dt('Until')}</label><input type="time" name="hours_end" value={settings.hoursEnd} /></div>
          </div>
          <div class="tk-cat-row">
            <label>{dt('Timezone')}</label>
            <select name="hours_timezone">
              {[...new Set([settings.hoursTimezone, ...timezones])].map((tz) => <option value={tz} selected={tz === settings.hoursTimezone}>{tz}</option>)}
            </select>
          </div>
          <div class="tk-cat-row">
            <label>{dt('Days')}</label>
            <div class="tk-days">
              {hourDays.map((d) => <label class="tk-day"><input type="checkbox" name="hours_days" value={d.n} checked={settings.hoursDays.includes(d.n)} /><span>{d.label}</span></label>)}
            </div>
          </div>
          <label class="tk-check"><input type="checkbox" name="hours_block" checked={settings.hoursBlock} />{dt('Do not let tickets open outside these hours')}</label>
          <div class="tk-cat-row">
            <label>{dt('Message outside the hours')}</label>
            <textarea name="hours_message" rows="3" maxlength="500" placeholder={dt('Our staff is away right now. They answer between {start} and {end} ({timezone}). Your ticket is open and someone will reply when they are back.')}>{settings.hoursMessage}</textarea>
            <p class="tk-row-hint">{dt('You can use {start}, {end} and {timezone}. Empty uses the message above.')}</p>
          </div>
        </div>

        <div class="tk-set-card">
          <div class="tk-set-head">{dt('Blocked roles')}</div>
          <p class="tk-row-hint">{dt('Can\'t open new tickets. Doesn\'t affect tickets they already have.')}</p>
          <div class="tk-cat-row">
            <MultiSelect name="blocked_role_ids" options={roles} selected={settings.blockedRoleIds} placeholder={dt('Search roles...')} />
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-accent btn-sm">{dt('Save settings')}</button>
    </form>
  </div>
  )}

  {selectedSection === 'open' && (
  <div class:list={['tk-section', { 'tk-section-hidden': selectedSection !== 'open' }]}>
    <h2><Icon name="ph:door-open-fill" width="15" height="15" /><Fragment set:html={dth('Open right now <span class="tk-count">{a}</span>', { a: (openTickets.length) })} /></h2>
    {openTickets.length === 0 ? (
      <p class="tk-empty-note">{dt('Nothing open at the moment.')}</p>
    ) : (
      <div class="tk-open-list">
        {openTickets.map((t) => (
          <div class="tk-open-row">
            <span class="tk-open-num">#{t.ticketNumber}</span>
            <span class="tk-open-cat">{t.categoryLabel}</span>
            <span class="tk-open-opener">{dt('opened by')} <code>{t.openerId}</code></span>
            {t.claimedBy && <span class="tk-open-claimed"><Icon name="ph:hand-fill" width="12" height="12" />claimed</span>}
            {t.channelId && <a href={`https://discord.com/channels/${guildId}/${t.channelId}`} target="_blank" rel="noopener" class="tk-open-link"><Icon name="ph:arrow-square-out" width="13" height="13" />{dt('Open')}</a>}
          </div>
        ))}
      </div>
    )}
  </div>
  )}
  <EmojiPicker customEmojis={customEmojis} />
</DashGuildLayout>

<script is:inline>
  // The preview of a panel follows what is typed (no need to save to see it), the ready designs fill the new-panel form,
  // and the color picker and the hex box stay in step.
  if (!window.__tkPanelBound) {
    window.__tkPanelBound = true;
    var HEX = /^#[0-9a-fA-F]{6}$/;
    var refresh = function (form) {
      var preview = form.parentElement && form.parentElement.querySelector('[data-panel-preview]');
      if (!preview) preview = form.querySelector('[data-panel-preview]');
      if (!preview && form.hasAttribute('data-new-panel')) preview = document.querySelector('.tk-new-preview [data-panel-preview]');
      var val = function (name) { var el = form.querySelector('[name="' + name + '"]'); return el ? el.value : ''; };
      var style = val('style') === 'select' ? 'select' : 'button';
      form.querySelectorAll('[data-only-select]').forEach(function (row) { row.hidden = style !== 'select'; });
      if (!preview) return;
      preview.setAttribute('data-style', style);
      var set = function (selector, text) { var el = preview.querySelector(selector); if (el) el.textContent = text; };
      set('[data-pv-title]', val('title'));
      var hasTypes = preview.getAttribute('data-has-types') === '1';
      set('[data-pv-desc]', val('description') || (hasTypes ? 'Click a button below to open a ticket.' : ''));
      var footer = preview.querySelector('[data-pv-foot]');
      if (footer) { footer.textContent = val('footer'); footer.hidden = !val('footer'); }
      var image = preview.querySelector('[data-pv-image]');
      if (image) { var url = val('image_url'); if (/^https:\/\//i.test(url)) { image.src = url; image.hidden = false; } else { image.hidden = true; } }
      var card = preview.querySelector('[data-pv-card]');
      if (card) card.style.setProperty('--pv-color', HEX.test(val('color')) ? val('color') : '#a5ea7a');
      var ph = preview.querySelector('[data-pv-placeholder]');
      if (ph && val('placeholder')) ph.textContent = val('placeholder');
    };
    document.addEventListener('input', function (event) {
      var field = event.target;
      if (!field || !field.closest) return;
      var form = field.closest('[data-panel-form]');
      if (!form) return;
      if (field.matches('[data-color-pick]')) { var hex = form.querySelector('input[name="color"]'); if (hex) hex.value = field.value; }
      if (field.name === 'color' && HEX.test(field.value)) { var pick = form.querySelector('[data-color-pick]'); if (pick) pick.value = field.value; }
      refresh(form);
    });
    document.addEventListener('change', function (event) {
      var form = event.target && event.target.closest && event.target.closest('[data-panel-form]');
      if (form) refresh(form);
    });
    document.addEventListener('click', function (event) {
      var button = event.target && event.target.closest && event.target.closest('[data-preset]');
      if (!button) return;
      var form = document.querySelector('[data-new-panel]');
      if (!form) return;
      var put = function (name, value) { var el = form.querySelector('[name="' + name + '"]'); if (el) el.value = value; };
      put('title', button.getAttribute('data-title') || '');
      put('description', button.getAttribute('data-description') || '');
      put('color', button.getAttribute('data-color') || '');
      put('style', button.getAttribute('data-style') || 'button');
      put('footer', button.getAttribute('data-footer') || '');
      put('placeholder', button.getAttribute('data-placeholder') || '');
      var pick = form.querySelector('[data-color-pick]'); if (pick) pick.value = button.getAttribute('data-color') || '#a5ea7a';
      document.querySelectorAll('[data-preset]').forEach(function (b) { b.classList.toggle('on', b === button); });
      refresh(form);
      form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
    document.querySelectorAll('[data-panel-form]').forEach(refresh);
  }
</script>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  h2 { font-size: 14.5px; margin: 0 0 14px; display: flex; align-items: center; gap: 8px; }
  h2 :global(svg) { color: var(--accent); }
  .tk-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 28px; max-width: 68ch; }
  .tk-sub :global(b){ color: var(--text); }
  .tk-sub :global(code){ font-family: var(--mono); color: var(--accent); }

  .tk-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; border-radius: 9px; padding: 10px 14px; margin-bottom: 20px; max-width: fit-content; }
  .tk-flash-ok { color: var(--green); background: var(--green-soft); border: 1px solid var(--green); }
  .tk-flash-warn { color: var(--amber, #e0b15c); background: color-mix(in srgb, var(--amber, #e0b15c) 12%, transparent); border: 1px solid var(--amber, #e0b15c); }
  .tk-panel-cats-empty { color: var(--amber, #e0b15c); }
  .tk-flash-err { color: var(--red); background: var(--red-soft); border: 1px solid var(--red); }

  .tk-section { margin-bottom: 40px; }
  .tk-section-hidden { display: none; }
  .tk-empty-note { font-size: 13px; color: var(--text-dim); }

  .tk-cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr)); gap: 14px; }
  .tk-cat-card { border: 1px solid var(--border); border-radius: 13px; padding: 14px; background: var(--card); display: flex; flex-direction: column; gap: 12px; }
  .tk-cat-head { display: flex; align-items: center; gap: 8px; }
  .tk-cat-emoji-chip { width: 30px; height: 30px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: var(--bg-raise); font-size: 15px; }
  .tk-cat-label { flex: 1; border: 1px solid transparent; background: transparent; font-size: 14px; font-weight: 600; color: var(--text); padding: 4px 6px; border-radius: 6px; font-family: var(--sans); }
  .tk-cat-label:focus { outline: none; border-color: var(--border); background: var(--bg-raise); }
  .tk-cat-del { border: none; background: transparent; color: var(--text-dim); cursor: pointer; padding: 4px; border-radius: 6px; }
  .tk-cat-del:hover { color: var(--red); background: var(--red-soft); }

  .tk-cat-row { display: flex; flex-direction: column; gap: 5px; }
  .tk-cat-row label { font-size: 11px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.04em; }
  .tk-default-submit { position: absolute; width: 1px; height: 1px; padding: 0; border: 0; opacity: 0; overflow: hidden; pointer-events: none; }
  .tk-cat-row input, .tk-cat-row select, .tk-cat-row textarea { width: 100%; box-sizing: border-box; border: 1px solid var(--border); border-radius: 8px; padding: 7px 9px; background: var(--bg-raise); color: var(--text); font-family: var(--sans); font-size: 13px; }
  .tk-cat-row textarea { resize: vertical; min-height: 72px; line-height: 1.45; }
  .tk-role-list { border: 1px solid var(--border); border-radius: 8px; background: var(--bg-raise); max-height: 110px; overflow-y: auto; padding: 4px; display: flex; flex-direction: column; }
  .tk-role-item { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 8px; padding: 5px 7px; border-radius: 6px; font-size: 12.5px; color: var(--text-muted); cursor: pointer; }
  .tk-role-item:hover { background: var(--card-hover); color: var(--text); }
  .tk-role-item input { flex-shrink: 0; accent-color: var(--accent); }
  .tk-emoji-input { max-width: 70px; }

  .tk-cat-card .btn-sm { align-self: flex-start; margin-top: 2px; }

  .tk-add-form { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .tk-add-form input[type="text"] { border: 1px solid var(--border); border-radius: 8px; padding: 8px 11px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; }
  .tk-add-form input[name="label"] { min-width: 220px; }
  .tk-add-form select { border: 1px solid var(--border); border-radius: 8px; padding: 8px 11px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; }
  .tk-add-form .btn { display: inline-flex; align-items: center; gap: 6px; }

  :global(.tk-count){ font-family: var(--mono); font-size: 11px; color: var(--text-dim); font-weight: 400; }
  .tk-premium-tag { font-family: var(--mono); font-size: 10px; font-weight: 600; color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border: 1px solid color-mix(in srgb, var(--yellow) 32%, var(--border)); border-radius: 999px; padding: 3px 7px; }
  .tk-limit-card { display: flex; align-items: center; justify-content: space-between; gap: 12px; max-width: 680px; padding: 13px 15px; border: 1px solid color-mix(in srgb, var(--yellow) 38%, var(--border)); border-radius: 11px; background: color-mix(in srgb, var(--yellow) 6%, var(--card)); }
  .tk-limit-card > div { display: grid; gap: 3px; min-width: 0; }
  .tk-limit-card strong { color: var(--text); font-size: 13px; }
  .tk-limit-card :global(span){ color: var(--text-muted); font-size: 12px; line-height: 1.4; }
