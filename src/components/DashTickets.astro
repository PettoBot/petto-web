---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MultiSelect from './MultiSelect.astro';
import TicketFieldsBuilder from './TicketFieldsBuilder.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface TicketCategory {
  id: number;
  panelId: number | null;
  key: string;
  label: string;
  emoji: string | null;
  description: string | null;
  buttonStyle: string;
  namingPattern: string;
  parentChannelId: string | null;
  supportRoleIds: string[];
  pingRoleIds: string[];
  maxOpenPerUser: number;
  formId: number | null;
  requiredRoleIds: string[];
}
interface TicketForm { id: number; name: string; title: string; fields: { type: string; id: string; label: string; placeholder?: string; required?: boolean }[]; }
interface TicketBlacklistEntry { id: number; target_type: string; target_id: string; reason: string | null; }
interface Panel {
  id: number;
  channelId: string;
  messageId: string | null;
  title: string | null;
  description: string | null;
  style: string;
  embedTemplate: string | null;
  categoryCount: number;
  types: { label: string; emoji: string | null }[];
}
interface TicketSettings {
  claimMode: string;
  pingOnClaim: boolean;
  rolesToAddOnClaim: string[];
  closeRequiresSupportRole: boolean;
  closeRequiresReason: boolean;
  hideClosingUser: boolean;
  dmUserOnClose: boolean;
  defaultCloseReason: string;
  logStaffMessageCounts: boolean;
  autocloseLeave: boolean;
  autocloseInactivityEnabled: boolean;
  autocloseInactivityHours: number;
  ratingEnabled: boolean;
  ratingMode: string;
  ratingLogChannelId: string;
  openedLogChannelId: string;
  closedLogChannelId: string;
  blockedRoleIds: string[];
}
interface OpenTicket {
  id: number;
  ticketNumber: number;
  categoryLabel: string;
  openerId: string;
  claimedBy: string | null;
  channelId: string | null;
}

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  categories: TicketCategory[];
  panels: Panel[];
  settings: TicketSettings;
  roles: { id: string; name: string }[];
  channelCategories: { id: string; name: string }[];
  textChannels: { id: string; name: string }[];
  embedTemplateNames: string[];
  forms: TicketForm[];
  blacklist: TicketBlacklistEntry[];
  openTickets: OpenTicket[];
  premiumActive: boolean;
  saved: boolean;
  error?: string | null;
  warnings?: string[];
  section?: string;
}
const { user, guildId, guildName, guildIcon, categories, panels, settings, roles, channelCategories, textChannels, embedTemplateNames, forms, blacklist, openTickets, saved, error, warnings = [], premiumActive, section } = Astro.props;
const sectionMeta: Record<string, string> = { panels: dt('Ticket panels'), types: dt('Support types'), forms: dt('Ticket forms'), access: dt('Ticket access'), settings: dt('Ticket settings'), open: dt('Open tickets') };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'panels';
const selectedTitle = sectionMeta[selectedSection];
function formFieldSpec(form: TicketForm) {
  return form.fields.map((field) => `${field.type}|${field.id}|${field.label}|${field.placeholder ?? ''}|${field.required === false ? 'optional' : 'required'}`).join(';');
}
function channelName(id: string | null) {
  return textChannels.find((c) => c.id === id)?.name ?? id;
}
const ticketCategoryLimit = premiumActive ? 20 : 5;
const ticketCategoryAtLimit = categories.length >= ticketCategoryLimit;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'panels' ? 'tickets' : `tickets-${selectedSection}`} pageTitle={selectedTitle}>
  <h1>{selectedTitle}</h1>
  <p class="tk-sub"><Fragment set:html={dth('Panels, support types, and how tickets close, all configured for <b>{a}</b> from here. The prefix <code>ticket</code> command in Discord still works for everything, this is the same data.', { a: (guildName) })} /></p>

  {saved && <div class="tk-flash tk-flash-ok"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {warnings.map((w) => <div class="tk-flash tk-flash-warn"><Icon name="ph:info-fill" width="15" height="15" />{w}</div>)}
  {error && <div class="tk-flash tk-flash-err"><Icon name="ph:warning-fill" width="15" height="15" />{error}</div>}

  <div class:list={['tk-section', { 'tk-section-hidden': selectedSection !== 'panels' }]}>
    <h2><Icon name="ph:squares-four-fill" width="15" height="15" /><Fragment set:html={dth('Panels <span class="tk-count">{a}</span>', { a: (panels.length) })} /></h2>
    <p class="tk-section-note">{dt('The message members click to open a ticket. Editing/resending re-posts it in place; moving posts a fresh one in the new channel.')}</p>
    {panels.length === 0 && <p class="tk-empty-note">{dt('No panels yet, create one below.')}</p>}

    <div class="tk-panel-grid">
      {panels.map((p) => (
        <div class="tk-panel-card">
          <form method="POST" class="tk-panel-form">
            <input type="hidden" name="action" value="update_panel" />
            <input type="hidden" name="panel_id" value={p.id} />
            <div class="tk-panel-head">
              <input type="text" name="title" value={p.title ?? ''} maxlength="100" placeholder={dt('Panel title')} class="tk-panel-title" />
              <span class="tk-panel-chan">#{channelName(p.channelId)}</span>
            </div>
            <div class="tk-panel-status">
              {p.messageId
                ? <a class="tk-chip tk-chip-ok" href={`https://discord.com/channels/${guildId}/${p.channelId}/${p.messageId}`} target="_blank" rel="noopener"><Icon name="ph:check-circle-fill" width="12" height="12" />{dt('Posted')} · {dt('Open in Discord')}</a>
                : <span class="tk-chip tk-chip-warn"><Icon name="ph:warning-fill" width="12" height="12" />{dt('Not posted yet. Press Resend.')}</span>}
              {p.embedTemplate && <span class="tk-chip">{dt('Design')}: {p.embedTemplate}</span>}
            </div>
            <textarea name="description" rows="2" maxlength="500" placeholder={dt('Panel description')}>{p.description ?? ''}</textarea>
            <div class="tk-preview" data-panel-preview data-has-design={p.embedTemplate ? '1' : ''}>
              <div class="tk-pv-label">{dt('Preview')}</div>
              <div class="tk-pv-title" data-pv-title>{p.title}</div>
              <div class="tk-pv-desc" data-pv-desc>{p.description || (p.categoryCount ? dt('Click a button below to open a ticket.') : '')}</div>
              {p.embedTemplate && <div class="tk-pv-note">{dt('The design "{name}" decides how the message looks. This preview is only the plain panel.', { name: p.embedTemplate })}</div>}
              <div class="tk-pv-types">
                {p.types.length ? p.types.slice(0, 25).map((type) => <span class="tk-pv-btn">{type.emoji || '🎫'} {type.label}</span>) : <span class="tk-pv-none">{dt('No types yet, so there is nothing to click. Add one in Support types.')}</span>}
              </div>
            </div>
            <div class="tk-panel-row">
              <select name="style">
                <option value="button" selected={p.style === 'button'}>{dt('Buttons (max 5 types)')}</option>
                <option value="select" selected={p.style === 'select'}>{dt('Dropdown (up to 25 types)')}</option>
              </select>
              <span class:list={['tk-panel-cats', { 'tk-panel-cats-empty': p.categoryCount === 0 }]}>{p.categoryCount === 0 ? dt('No types yet') : `${p.categoryCount} type${p.categoryCount !== 1 ? 's' : ''}`}</span>
            </div>
            {embedTemplateNames.length > 0 && (
              <select name="embed_template" data-dp-template-only>
                <option value="">{dt('No template, plain title + description')}</option>
                {embedTemplateNames.map((n) => <option value={n} selected={n === p.embedTemplate}>{n}</option>)}
              </select>
            )}
            <div class="tk-panel-actions">
              <button type="submit" name="action" value="update_panel" class="btn btn-ghost btn-sm">{dt('Save')}</button>
            </div>
          </form>
          <form method="POST" class="tk-panel-move">
            <input type="hidden" name="action" value="move_panel" />
            <input type="hidden" name="panel_id" value={p.id} />
            <select name="channel_id">
              {textChannels.map((c) => <option value={c.id} selected={c.id === p.channelId}>#{c.name}</option>)}
            </select>
            <button type="submit" name="action" value="move_panel" class="btn btn-ghost btn-sm">{dt('Move')}</button>
          </form>
          <div class="tk-panel-actions">
            <form method="POST"><input type="hidden" name="action" value="resend_panel" /><input type="hidden" name="panel_id" value={p.id} /><button type="submit" name="action" value="resend_panel" class="btn btn-ghost btn-sm" data-confirm={dt('Resend this panel? The message in Discord is deleted and posted again.')}>{dt('Resend')}</button></form>
            <form method="POST"><input type="hidden" name="action" value="delete_panel" /><input type="hidden" name="panel_id" value={p.id} /><button type="submit" name="action" value="delete_panel" class="tk-cat-del" title={dt('Delete this panel')} data-confirm={dt('Delete this panel? Its message in Discord is deleted too. Ticket types stay, but are no longer on a panel.')} formnovalidate><Icon name="ph:trash-fill" width="14" height="14" /></button></form>
          </div>
        </div>
      ))}
    </div>

    <form method="POST" class="tk-add-form">
      <input type="hidden" name="action" value="create_panel" />
      <select name="channel_id" required>
        <option value="" disabled selected>{dt('Channel')}</option>
        {textChannels.map((c) => <option value={c.id}>#{c.name}</option>)}
      </select>
      <input type="text" name="title" placeholder={dt('Title (optional)')} maxlength="100" />
      <input type="text" name="description" placeholder={dt('Description (optional)')} maxlength="500" />
      <select name="style">
        <option value="button">{dt('Buttons')}</option>
        <option value="select">{dt('Dropdown')}</option>
      </select>
      {embedTemplateNames.length > 0 && (
        <select name="embed_template" data-dp-template-only>
          <option value="">{dt('No template, plain title + description')}</option>
          {embedTemplateNames.map((n) => <option value={n}>{n}</option>)}
        </select>
      )}
      <button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="13" height="13" />{dt('Create panel')}</button>
    </form>
    {embedTemplateNames.length > 0 && <p class="tk-row-hint">{dt('A template\'s own title/description/color/image win over the fields above. Only server-wide variables resolve here ({a}, {b}, etc), not per-member ones, since no one specific opens a panel.', { a: ('{server_name}'), b: ('{guild.icon}') })}</p>}
  </div>

  <div class:list={['tk-section', { 'tk-section-hidden': selectedSection !== 'types' }]}>
    <h2><Icon name="ph:ticket" width="15" height="15" /><Fragment set:html={dth('Support types <span class="tk-count">{a}/{b}</span>', { a: (categories.length), b: (ticketCategoryLimit) })} />{!premiumActive && <span class="tk-premium-tag">Premium: 20</span>}</h2>
    {categories.length === 0 && <p class="tk-empty-note">{dt('No ticket types yet, add the first one below.')}</p>}

    <div class="tk-cat-grid">
      {categories.map((cat) => (
        <form method="POST" class="tk-cat-card">
          <input type="hidden" name="category_id" value={cat.id} />
          <div class="tk-cat-head">
            <span class="tk-cat-emoji-chip">{cat.emoji || '🎫'}</span>
            <input type="text" name="label" value={cat.label} maxlength="40" class="tk-cat-label" />
            <button type="submit" name="action" value="delete" class="tk-cat-del" title={dt('Delete this type')} formnovalidate>
              <Icon name="ph:trash-fill" width="14" height="14" />
            </button>
          </div>

          <div class="tk-cat-row">
            <label>{dt('Panel')}</label>
            <select name="panel_id">
              <option value="">{dt('None (not on any panel)')}</option>
              {panels.map((p) => <option value={p.id} selected={p.id === cat.panelId}>{p.title || `#${channelName(p.channelId)}`}</option>)}
            </select>
          </div>

          <div class="tk-cat-row">
            <label>{dt('Emoji')}</label>
            <input type="text" name="emoji" value={cat.emoji ?? ''} maxlength="4" placeholder="🎫" class="tk-emoji-input" />
          </div>

          <div class="tk-cat-row">
            <label>{dt('Description')}</label>
            <input type="text" name="description" value={cat.description ?? ''} maxlength="100" placeholder={dt('Shown on the panel button/option')} />
          </div>

          <div class="tk-cat-row">
            <label>{dt('Button style')}</label>
            <select name="button_style">
              {['primary', 'secondary', 'success', 'danger'].map((s) => <option value={s} selected={s === cat.buttonStyle}>{s}</option>)}
            </select>
          </div>

          <div class="tk-cat-row">
            <label>{dt('Channel name')}</label>
            <input type="text" name="naming_pattern" value={cat.namingPattern} maxlength="50" placeholder="ticket-{number}" />
          </div>

          <div class="tk-cat-row">
            <label>{dt('Opens in category')}</label>
            <select name="parent_channel_id">
              <option value="">{dt('Server default')}</option>
              {channelCategories.map((c) => (
                <option value={c.id} selected={c.id === cat.parentChannelId}>{c.name}</option>
              ))}
            </select>
          </div>

          <div class="tk-cat-row">
            <label>{dt('Support roles')}</label>
            <MultiSelect name="support_role_ids" options={roles} selected={cat.supportRoleIds} placeholder={dt('Search roles...')} />
          </div>

          <div class="tk-cat-row">
            <label>{dt('Ping on open')}</label>
            <MultiSelect name="ping_role_ids" options={roles} selected={cat.pingRoleIds} placeholder={dt('Search roles...')} />
          </div>

          <div class="tk-cat-row">
            <label>{dt('Max open per member')}</label>
            <input type="number" name="max_open_per_user" value={cat.maxOpenPerUser} min="1" max="10" />
          </div>

          <div class="tk-cat-row">
            <label>{dt('Intake form')}</label>
            <select name="form_id">
              <option value="">{dt('No form')}</option>
              {forms.map((form) => <option value={form.id} selected={String(form.id) === String(cat.formId)}>{form.name} · {form.title}</option>)}
            </select>
          </div>

          <div class="tk-cat-row">
            <label>{dt('Required roles')}</label>
            <MultiSelect name="required_role_ids" options={roles} selected={cat.requiredRoleIds} placeholder={dt('Search roles...')} />
          </div>

          <button type="submit" name="action" value="update" class="btn btn-ghost btn-sm">{dt('Save this type')}</button>
        </form>
      ))}
    </div>
  </div>

  <div class:list={['tk-section', { 'tk-section-hidden': selectedSection !== 'types' }]}>
    <h2><Icon name="ph:plus-circle-fill" width="15" height="15" />{dt('Add a support type')}</h2>
    {ticketCategoryAtLimit ? (
      <div class="tk-limit-card">
        <div><strong>{premiumActive ? dt('Ticket type limit reached') : dt('Free ticket type limit reached')}</strong><span>{premiumActive ? dt('You are using all {n} available ticket types.',{n:ticketCategoryLimit}) : dt('Free includes 5 ticket types. Premium increases this to 20.')}</span></div>
        {!premiumActive && <a class="btn btn-ghost btn-sm" href={`/dash/premium?guild_id=${guildId}`}>{dt('Unlock Premium')}</a>}
      </div>
    ) : (<form method="POST" class="tk-add-form">
      <input type="hidden" name="action" value="create" />
      <input type="text" name="label" placeholder={dt('e.g. Report a player')} maxlength="40" required />
      <input type="text" name="emoji" placeholder="🎫" maxlength="4" class="tk-emoji-input" />
      <select name="panel_id">
        <option value="">{dt('No panel yet')}</option>
        {panels.map((p) => <option value={p.id}>{p.title || `#${channelName(p.channelId)}`}</option>)}
      </select>
      <select name="parent_channel_id">
        <option value="">{dt('Server default category')}</option>
        {channelCategories.map((c) => <option value={c.id}>{c.name}</option>)}
      </select>
      <button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="13" height="13" />{dt('Add')}</button>
    </form>)}
    {forms.length === 0 && <p class="tk-row-hint"><Fragment set:html={dth('Create forms in Discord with <code>!ticket form create</code>, then assign them here.')} /></p>}
  </div>

  <div class:list={['tk-section', { 'tk-section-hidden': selectedSection !== 'forms' }]}>
    <h2><Icon name="ph:clipboard-text-fill" width="15" height="15" /><Fragment set:html={dth('Ticket forms <span class="tk-count">{a}</span>', { a: (forms.length) })} /></h2>
    <p class="tk-section-note"><Fragment set:html={dth('Reusable intake forms shown before a form-backed ticket opens. Add the questions below; in Discord the same fields use <code>type|id|label|placeholder|required;...</code>.')} /></p>
    <div class="tk-cat-grid">
      {forms.map((form) => (
        <form method="POST" class="tk-cat-card">
          <input type="hidden" name="form_id" value={form.id} />
          <input type="hidden" name="form_name" value={form.name} />
          <input type="hidden" name="action" value="update_ticket_form" />
          <div class="tk-cat-head"><input type="text" name="form_name_display" value={form.name} disabled class="tk-cat-label" /></div>
          <div class="tk-cat-row"><label>{dt('Modal title')}</label><input type="text" name="form_title" value={form.title} maxlength="45" required /></div>
          <div class="tk-cat-row"><label>{dt('Fields')}</label><TicketFieldsBuilder fields={form.fields} /></div>
          <div class="tk-panel-actions"><button type="submit" class="btn btn-ghost btn-sm">{dt('Save form')}</button></div>
        </form>
        <form method="POST" class="tk-panel-actions"><input type="hidden" name="action" value="delete_ticket_form" /><input type="hidden" name="form_id" value={form.id} /><button type="submit" class="tk-cat-del">{dt('Delete form')}</button></form>
      ))}
    </div>
    <form method="POST" class="tk-add-form">
      <input type="hidden" name="action" value="create_ticket_form" />
      <input type="text" name="form_name" autocomplete="off" placeholder={dt('Form name')} maxlength="50" required />
      <input type="text" name="form_title" autocomplete="off" placeholder={dt('Modal title')} maxlength="45" value="Ticket details" required />
      <TicketFieldsBuilder />
      <button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="13" height="13" />{dt('Create form')}</button>
    </form>
    {forms.length === 0 && <p class="tk-row-hint">{dt('No forms yet. Create one here, then assign it to a support type.')}</p>}
  </div>

  <div class:list={['tk-section', { 'tk-section-hidden': selectedSection !== 'access' }]}>
    <h2><Icon name="ph:prohibit-fill" width="15" height="15" /><Fragment set:html={dth('Ticket access <span class="tk-count">{a}</span>', { a: (blacklist.length) })} /></h2>
    <p class="tk-section-note">{dt('Block a user or role from opening tickets. Role entries apply to every member with that role.')}</p>
    <div class="tk-open-list">
      {blacklist.map((entry) => (
        <div class="tk-open-row">
          <div><span class="tk-open-num">{entry.target_type}</span><code>{entry.target_id}</code>{entry.reason && <span class="tk-row-hint">{entry.reason}</span>}</div>
          <form method="POST"><input type="hidden" name="action" value="remove_ticket_blacklist" /><input type="hidden" name="target_type" value={entry.target_type} /><input type="hidden" name="target_id" value={entry.target_id} /><button type="submit" class="btn btn-ghost btn-sm">{dt('Remove')}</button></form>
        </div>
      ))}
    </div>
    <form method="POST" class="tk-add-form">
      <input type="hidden" name="action" value="add_ticket_blacklist" />
      <select name="target_type"><option value="user">{dt('User ID')}</option><option value="role">{dt('Role ID')}</option></select>
      <input type="text" name="target_id" placeholder={dt('Discord ID')} inputmode="numeric" pattern="[0-9]{5,25}" required />
      <input type="text" name="reason" placeholder={dt('Reason (optional)')} maxlength="300" />
      <button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="13" height="13" />{dt('Block')}</button>
    </form>
  </div>

  <div class:list={['tk-section', { 'tk-section-hidden': selectedSection !== 'settings' }]}>
    <h2><Icon name="ph:gear-six-fill" width="15" height="15" />{dt('Settings')}</h2>
    <form method="POST" class="tk-settings-form">
      <input type="hidden" name="action" value="save_settings" />

      <div class="tk-settings-grid">
        <div class="tk-set-card">
          <div class="tk-set-head">{dt('Claiming')}</div>
          <div class="tk-cat-row">
            <label>{dt('Claim mode')}</label>
            <select name="claim_mode">
              <option value="shared" selected={settings.claimMode === 'shared'}>{dt('Shared, any staff can still act on a claimed ticket')}</option>
              <option value="exclusive" selected={settings.claimMode === 'exclusive'}>{dt('Exclusive, only the claimer (or an admin) can act on it')}</option>
            </select>
          </div>
          <label class="tk-check"><input type="checkbox" name="ping_on_claim" checked={settings.pingOnClaim} />{dt('Ping the ticket opener when claimed')}</label>
          <div class="tk-cat-row">
            <label>{dt('Roles to add on claim')}</label>
            <MultiSelect name="roles_to_add_on_claim" options={roles} selected={settings.rolesToAddOnClaim} placeholder={dt('Search roles...')} />
          </div>
        </div>

        <div class="tk-set-card">
          <div class="tk-set-head">{dt('Closing')}</div>
          <label class="tk-check"><input type="checkbox" name="close_requires_support_role" checked={settings.closeRequiresSupportRole} />{dt('Only support roles can close (not the opener)')}</label>
          <label class="tk-check"><input type="checkbox" name="close_requires_reason" checked={settings.closeRequiresReason} />{dt('Require a reason to close')}</label>
          <label class="tk-check"><input type="checkbox" name="hide_closing_user" checked={settings.hideClosingUser} />{dt('Hide who closed it from the opener')}</label>
          <label class="tk-check"><input type="checkbox" name="dm_user_on_close" checked={settings.dmUserOnClose} />{dt('DM the opener with the transcript on close')}</label>
          <div class="tk-cat-row">
            <label>{dt('Default close reason')}</label>
            <input type="text" name="default_close_reason" value={settings.defaultCloseReason} maxlength="300" placeholder={dt('Used when no reason is given')} />
          </div>
          <label class="tk-check"><input type="checkbox" name="log_staff_message_counts" checked={settings.logStaffMessageCounts} />{dt('Log staff reply counts in the closed-ticket log')}</label>
        </div>

        <div class="tk-set-card">
          <div class="tk-set-head">{dt('Autoclose')}</div>
          <label class="tk-check"><input type="checkbox" name="autoclose_leave" checked={settings.autocloseLeave} />{dt('Close a member\'s tickets when they leave')}</label>
          <label class="tk-check"><input type="checkbox" name="autoclose_inactivity_enabled" checked={settings.autocloseInactivityEnabled} />{dt('Close tickets after a period of inactivity')}</label>
          <div class="tk-cat-row">
            <label>{dt('Inactivity period (hours)')}</label>
            <input type="number" name="autoclose_inactivity_hours" value={settings.autocloseInactivityHours} min="1" max="720" />
          </div>
        </div>

        <div class="tk-set-card">
          <div class="tk-set-head">{dt('Ratings')}</div>
          <label class="tk-check"><input type="checkbox" name="rating_enabled" checked={settings.ratingEnabled} />{dt('Let members rate a ticket after it closes')}</label>
          <div class="tk-cat-row">
            <label>{dt('Rating mode')}</label>
            <select name="rating_mode">
              <option value="rating_only" selected={settings.ratingMode === 'rating_only'}>{dt('Stars only')}</option>
              <option value="rating_comment" selected={settings.ratingMode === 'rating_comment'}>{dt('Stars + optional comment')}</option>
            </select>
          </div>
          <div class="tk-cat-row">
            <label>{dt('Rating log channel')}</label>
            <select name="rating_log_channel_id">
              <option value="">{dt('None')}</option>
              {textChannels.map((c) => <option value={c.id} selected={c.id === settings.ratingLogChannelId}>#{c.name}</option>)}
            </select>
          </div>
        </div>

        <div class="tk-set-card">
          <div class="tk-set-head">{dt('Logging')}</div>
          <div class="tk-cat-row">
            <label>{dt('Opened tickets log channel')}</label>
            <select name="opened_log_channel_id">
              <option value="">{dt('None')}</option>
              {textChannels.map((c) => <option value={c.id} selected={c.id === settings.openedLogChannelId}>#{c.name}</option>)}
            </select>
          </div>
          <div class="tk-cat-row">
            <label>{dt('Closed tickets log channel')}</label>
            <select name="closed_log_channel_id">
              <option value="">{dt('None')}</option>
              {textChannels.map((c) => <option value={c.id} selected={c.id === settings.closedLogChannelId}>#{c.name}</option>)}
            </select>
          </div>
          <p class="tk-row-hint"><Fragment set:html={dth('Separate from the Logging page\'s <b>Tickets</b> route, which can run alongside these dedicated channels.')} /></p>
        </div>

        <div class="tk-set-card">
          <div class="tk-set-head">{dt('Blocked roles')}</div>
          <p class="tk-row-hint">{dt('Can\'t open new tickets. Doesn\'t affect tickets they already have.')}</p>
          <div class="tk-cat-row">
            <MultiSelect name="blocked_role_ids" options={roles} selected={settings.blockedRoleIds} placeholder={dt('Search roles...')} />
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-accent btn-sm">{dt('Save settings')}</button>
    </form>
  </div>

  <div class:list={['tk-section', { 'tk-section-hidden': selectedSection !== 'open' }]}>
    <h2><Icon name="ph:door-open-fill" width="15" height="15" /><Fragment set:html={dth('Open right now <span class="tk-count">{a}</span>', { a: (openTickets.length) })} /></h2>
    {openTickets.length === 0 ? (
      <p class="tk-empty-note">{dt('Nothing open at the moment.')}</p>
    ) : (
      <div class="tk-open-list">
        {openTickets.map((t) => (
          <div class="tk-open-row">
            <span class="tk-open-num">#{t.ticketNumber}</span>
            <span class="tk-open-cat">{t.categoryLabel}</span>
            <span class="tk-open-opener">{dt('opened by')} <code>{t.openerId}</code></span>
            {t.claimedBy && <span class="tk-open-claimed"><Icon name="ph:hand-fill" width="12" height="12" />claimed</span>}
            {t.channelId && <a href={`https://discord.com/channels/${guildId}/${t.channelId}`} target="_blank" rel="noopener" class="tk-open-link"><Icon name="ph:arrow-square-out" width="13" height="13" />{dt('Open')}</a>}
          </div>
        ))}
      </div>
    )}
  </div>
</DashGuildLayout>

<script is:inline>
  // The preview of a panel follows what is typed, so there is no need to save to see it.
  if (!window.__tkPreviewBound) {
    window.__tkPreviewBound = true;
    document.addEventListener('input', function (event) {
      var field = event.target;
      if (!field || !field.closest) return;
      var form = field.closest('.tk-panel-form');
      if (!form) return;
      var preview = form.querySelector('[data-panel-preview]');
      if (!preview) return;
      var title = preview.querySelector('[data-pv-title]');
      var desc = preview.querySelector('[data-pv-desc]');
      if (field.name === 'title' && title) title.textContent = field.value;
      if (field.name === 'description' && desc) desc.textContent = field.value;
    });
  }
</script>

