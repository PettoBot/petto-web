---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MultiSelect from './MultiSelect.astro';

interface TicketCategory {
  id: number;
  panelId: number | null;
  key: string;
  label: string;
  emoji: string | null;
  description: string | null;
  buttonStyle: string;
  namingPattern: string;
  parentChannelId: string | null;
  supportRoleIds: string[];
  pingRoleIds: string[];
  maxOpenPerUser: number;
}
interface Panel {
  id: number;
  channelId: string;
  messageId: string | null;
  title: string | null;
  description: string | null;
  style: string;
  embedTemplate: string | null;
  categoryCount: number;
}
interface TicketSettings {
  claimMode: string;
  pingOnClaim: boolean;
  rolesToAddOnClaim: string[];
  closeRequiresSupportRole: boolean;
  closeRequiresReason: boolean;
  hideClosingUser: boolean;
  dmUserOnClose: boolean;
  defaultCloseReason: string;
  logStaffMessageCounts: boolean;
  autocloseLeave: boolean;
  autocloseInactivityEnabled: boolean;
  autocloseInactivityHours: number;
  ratingEnabled: boolean;
  ratingMode: string;
  ratingLogChannelId: string;
  openedLogChannelId: string;
  closedLogChannelId: string;
  blockedRoleIds: string[];
}
interface OpenTicket {
  id: number;
  ticketNumber: number;
  categoryLabel: string;
  openerId: string;
  claimedBy: string | null;
  channelId: string | null;
}

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  categories: TicketCategory[];
  panels: Panel[];
  settings: TicketSettings;
  roles: { id: string; name: string }[];
  channelCategories: { id: string; name: string }[];
  textChannels: { id: string; name: string }[];
  embedTemplateNames: string[];
  openTickets: OpenTicket[];
  saved: boolean;
  error?: string | null;
}
const { user, guildId, guildName, guildIcon, categories, panels, settings, roles, channelCategories, textChannels, embedTemplateNames, openTickets, saved, error } = Astro.props;
function channelName(id: string | null) {
  return textChannels.find((c) => c.id === id)?.name ?? id;
}
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="tickets" pageTitle="Tickets">
  <h1>Tickets</h1>
  <p class="tk-sub">Panels, support types, and how tickets close, all configured for <b>{guildName}</b> from here. <code>/ticket</code> in Discord still works for everything, this is the same data.</p>

  {saved && <div class="tk-flash tk-flash-ok"><Icon name="ph:check-circle-fill" width="15" height="15" />Saved.</div>}
  {error && <div class="tk-flash tk-flash-err"><Icon name="ph:warning-fill" width="15" height="15" />{error}</div>}

  <div class="tk-section">
    <h2><Icon name="ph:squares-four-fill" width="15" height="15" />Panels <span class="tk-count">{panels.length}</span></h2>
    <p class="tk-section-note">The message members click to open a ticket. Editing/resending re-posts it in place; moving posts a fresh one in the new channel.</p>
    {panels.length === 0 && <p class="tk-empty-note">No panels yet, create one below.</p>}

    <div class="tk-panel-grid">
      {panels.map((p) => (
        <div class="tk-panel-card">
          <form method="POST" class="tk-panel-form">
            <input type="hidden" name="panel_id" value={p.id} />
            <div class="tk-panel-head">
              <input type="text" name="title" value={p.title ?? ''} maxlength="100" placeholder="Panel title" class="tk-panel-title" />
              <span class="tk-panel-chan">#{channelName(p.channelId)}</span>
            </div>
            <textarea name="description" rows="2" maxlength="500" placeholder="Panel description">{p.description ?? ''}</textarea>
            <div class="tk-panel-row">
              <select name="style">
                <option value="button" selected={p.style === 'button'}>Buttons (max 5 types)</option>
                <option value="select" selected={p.style === 'select'}>Dropdown (up to 25 types)</option>
              </select>
              <span class="tk-panel-cats">{p.categoryCount} type{p.categoryCount !== 1 ? 's' : ''}</span>
            </div>
            {embedTemplateNames.length > 0 && (
              <select name="embed_template">
                <option value="">No template, plain title + description</option>
                {embedTemplateNames.map((n) => <option value={n} selected={n === p.embedTemplate}>{n}</option>)}
              </select>
            )}
            <div class="tk-panel-actions">
              <button type="submit" name="action" value="update_panel" class="btn btn-ghost btn-sm">Save</button>
            </div>
          </form>
          <form method="POST" class="tk-panel-move">
            <input type="hidden" name="panel_id" value={p.id} />
            <select name="channel_id">
              {textChannels.map((c) => <option value={c.id} selected={c.id === p.channelId}>#{c.name}</option>)}
            </select>
            <button type="submit" name="action" value="move_panel" class="btn btn-ghost btn-sm">Move</button>
          </form>
          <div class="tk-panel-actions">
            <form method="POST"><input type="hidden" name="panel_id" value={p.id} /><button type="submit" name="action" value="resend_panel" class="btn btn-ghost btn-sm">Resend</button></form>
            <form method="POST"><input type="hidden" name="panel_id" value={p.id} /><button type="submit" name="action" value="delete_panel" class="tk-cat-del" title="Delete this panel" formnovalidate><Icon name="ph:trash-fill" width="14" height="14" /></button></form>
          </div>
        </div>
      ))}
    </div>

    <form method="POST" class="tk-add-form">
      <input type="hidden" name="action" value="create_panel" />
      <select name="channel_id" required>
        <option value="" disabled selected>Channel</option>
        {textChannels.map((c) => <option value={c.id}>#{c.name}</option>)}
      </select>
      <input type="text" name="title" placeholder="Title (optional)" maxlength="100" />
      <input type="text" name="description" placeholder="Description (optional)" maxlength="500" />
      <select name="style">
        <option value="button">Buttons</option>
        <option value="select">Dropdown</option>
      </select>
      {embedTemplateNames.length > 0 && (
        <select name="embed_template">
          <option value="">No template, plain title + description</option>
          {embedTemplateNames.map((n) => <option value={n}>{n}</option>)}
        </select>
      )}
      <button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="13" height="13" />Create panel</button>
    </form>
    {embedTemplateNames.length > 0 && <p class="tk-row-hint">A template's own title/description/color/image win over the fields above. Only server-wide variables resolve here ({'{server_name}'}, {'{guild.icon}'}, etc), not per-member ones, since no one specific opens a panel.</p>}
  </div>

  <div class="tk-section">
    <h2><Icon name="ph:ticket-fill" width="15" height="15" />Support types</h2>
    {categories.length === 0 && <p class="tk-empty-note">No ticket types yet, add the first one below.</p>}

    <div class="tk-cat-grid">
      {categories.map((cat) => (
        <form method="POST" class="tk-cat-card">
          <input type="hidden" name="category_id" value={cat.id} />
          <div class="tk-cat-head">
            <span class="tk-cat-emoji-chip">{cat.emoji || '🎫'}</span>
            <input type="text" name="label" value={cat.label} maxlength="40" class="tk-cat-label" />
            <button type="submit" name="action" value="delete" class="tk-cat-del" title="Delete this type" formnovalidate>
              <Icon name="ph:trash-fill" width="14" height="14" />
            </button>
          </div>

          <div class="tk-cat-row">
            <label>Panel</label>
            <select name="panel_id">
              <option value="">None (not on any panel)</option>
              {panels.map((p) => <option value={p.id} selected={p.id === cat.panelId}>{p.title || `#${channelName(p.channelId)}`}</option>)}
            </select>
          </div>

          <div class="tk-cat-row">
            <label>Emoji</label>
            <input type="text" name="emoji" value={cat.emoji ?? ''} maxlength="4" placeholder="🎫" class="tk-emoji-input" />
          </div>

          <div class="tk-cat-row">
            <label>Description</label>
            <input type="text" name="description" value={cat.description ?? ''} maxlength="100" placeholder="Shown on the panel button/option" />
          </div>

          <div class="tk-cat-row">
            <label>Button style</label>
            <select name="button_style">
              {['primary', 'secondary', 'success', 'danger'].map((s) => <option value={s} selected={s === cat.buttonStyle}>{s}</option>)}
            </select>
          </div>

          <div class="tk-cat-row">
            <label>Channel name</label>
            <input type="text" name="naming_pattern" value={cat.namingPattern} maxlength="50" placeholder="ticket-{number}" />
          </div>

          <div class="tk-cat-row">
            <label>Opens in category</label>
            <select name="parent_channel_id">
              <option value="">Server default</option>
              {channelCategories.map((c) => (
                <option value={c.id} selected={c.id === cat.parentChannelId}>{c.name}</option>
              ))}
            </select>
          </div>

          <div class="tk-cat-row">
            <label>Support roles</label>
            <MultiSelect name="support_role_ids" options={roles} selected={cat.supportRoleIds} placeholder="Search roles..." />
          </div>

          <div class="tk-cat-row">
            <label>Ping on open</label>
            <MultiSelect name="ping_role_ids" options={roles} selected={cat.pingRoleIds} placeholder="Search roles..." />
          </div>

          <div class="tk-cat-row">
            <label>Max open per member</label>
            <input type="number" name="max_open_per_user" value={cat.maxOpenPerUser} min="1" max="10" />
          </div>

          <button type="submit" name="action" value="update" class="btn btn-ghost btn-sm">Save this type</button>
        </form>
      ))}
    </div>
  </div>

  <div class="tk-section">
    <h2><Icon name="ph:plus-circle-fill" width="15" height="15" />Add a support type</h2>
    <form method="POST" class="tk-add-form">
      <input type="hidden" name="action" value="create" />
      <input type="text" name="label" placeholder="e.g. Report a player" maxlength="40" required />
      <input type="text" name="emoji" placeholder="🎫" maxlength="4" class="tk-emoji-input" />
      <select name="panel_id">
        <option value="">No panel yet</option>
        {panels.map((p) => <option value={p.id}>{p.title || `#${channelName(p.channelId)}`}</option>)}
      </select>
      <select name="parent_channel_id">
        <option value="">Server default category</option>
        {channelCategories.map((c) => <option value={c.id}>{c.name}</option>)}
      </select>
      <button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:plus-bold" width="13" height="13" />Add</button>
    </form>
  </div>

  <div class="tk-section">
    <h2><Icon name="ph:gear-six-fill" width="15" height="15" />Settings</h2>
    <form method="POST" class="tk-settings-form">
      <input type="hidden" name="action" value="save_settings" />

      <div class="tk-settings-grid">
        <div class="tk-set-card">
          <div class="tk-set-head">Claiming</div>
          <div class="tk-cat-row">
            <label>Claim mode</label>
            <select name="claim_mode">
              <option value="shared" selected={settings.claimMode === 'shared'}>Shared — any staff can still act on a claimed ticket</option>
              <option value="exclusive" selected={settings.claimMode === 'exclusive'}>Exclusive — only the claimer (or an admin) can act on it</option>
            </select>
          </div>
          <label class="tk-check"><input type="checkbox" name="ping_on_claim" checked={settings.pingOnClaim} />Ping the ticket opener when claimed</label>
          <div class="tk-cat-row">
            <label>Roles to add on claim</label>
            <MultiSelect name="roles_to_add_on_claim" options={roles} selected={settings.rolesToAddOnClaim} placeholder="Search roles..." />
          </div>
        </div>

        <div class="tk-set-card">
          <div class="tk-set-head">Closing</div>
          <label class="tk-check"><input type="checkbox" name="close_requires_support_role" checked={settings.closeRequiresSupportRole} />Only support roles can close (not the opener)</label>
          <label class="tk-check"><input type="checkbox" name="close_requires_reason" checked={settings.closeRequiresReason} />Require a reason to close</label>
          <label class="tk-check"><input type="checkbox" name="hide_closing_user" checked={settings.hideClosingUser} />Hide who closed it from the opener</label>
          <label class="tk-check"><input type="checkbox" name="dm_user_on_close" checked={settings.dmUserOnClose} />DM the opener with the transcript on close</label>
          <div class="tk-cat-row">
            <label>Default close reason</label>
            <input type="text" name="default_close_reason" value={settings.defaultCloseReason} maxlength="300" placeholder="Used when no reason is given" />
          </div>
          <label class="tk-check"><input type="checkbox" name="log_staff_message_counts" checked={settings.logStaffMessageCounts} />Log staff reply counts in the closed-ticket log</label>
        </div>

        <div class="tk-set-card">
          <div class="tk-set-head">Autoclose</div>
          <label class="tk-check"><input type="checkbox" name="autoclose_leave" checked={settings.autocloseLeave} />Close a member's tickets when they leave</label>
          <label class="tk-check"><input type="checkbox" name="autoclose_inactivity_enabled" checked={settings.autocloseInactivityEnabled} />Close tickets after a period of inactivity</label>
          <div class="tk-cat-row">
            <label>Inactivity period (hours)</label>
            <input type="number" name="autoclose_inactivity_hours" value={settings.autocloseInactivityHours} min="1" max="720" />
          </div>
        </div>

        <div class="tk-set-card">
          <div class="tk-set-head">Ratings</div>
          <label class="tk-check"><input type="checkbox" name="rating_enabled" checked={settings.ratingEnabled} />Let members rate a ticket after it closes</label>
          <div class="tk-cat-row">
            <label>Rating mode</label>
            <select name="rating_mode">
              <option value="rating_only" selected={settings.ratingMode === 'rating_only'}>Stars only</option>
              <option value="rating_comment" selected={settings.ratingMode === 'rating_comment'}>Stars + optional comment</option>
            </select>
          </div>
          <div class="tk-cat-row">
            <label>Rating log channel</label>
            <select name="rating_log_channel_id">
              <option value="">None</option>
              {textChannels.map((c) => <option value={c.id} selected={c.id === settings.ratingLogChannelId}>#{c.name}</option>)}
            </select>
          </div>
        </div>

        <div class="tk-set-card">
          <div class="tk-set-head">Logging</div>
          <div class="tk-cat-row">
            <label>Opened tickets log channel</label>
            <select name="opened_log_channel_id">
              <option value="">None</option>
              {textChannels.map((c) => <option value={c.id} selected={c.id === settings.openedLogChannelId}>#{c.name}</option>)}
            </select>
          </div>
          <div class="tk-cat-row">
            <label>Closed tickets log channel</label>
            <select name="closed_log_channel_id">
              <option value="">None</option>
              {textChannels.map((c) => <option value={c.id} selected={c.id === settings.closedLogChannelId}>#{c.name}</option>)}
            </select>
          </div>
          <p class="tk-row-hint">Separate from <code>/logs add tickets</code>, which still works alongside these.</p>
        </div>

        <div class="tk-set-card">
          <div class="tk-set-head">Blocked roles</div>
          <p class="tk-row-hint">Can't open new tickets. Doesn't affect tickets they already have.</p>
          <div class="tk-cat-row">
            <MultiSelect name="blocked_role_ids" options={roles} selected={settings.blockedRoleIds} placeholder="Search roles..." />
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-accent btn-sm">Save settings</button>
    </form>
  </div>

  <div class="tk-section">
    <h2><Icon name="ph:door-open-fill" width="15" height="15" />Open right now <span class="tk-count">{openTickets.length}</span></h2>
    {openTickets.length === 0 ? (
      <p class="tk-empty-note">Nothing open at the moment.</p>
    ) : (
      <div class="tk-open-list">
        {openTickets.map((t) => (
          <div class="tk-open-row">
            <span class="tk-open-num">#{t.ticketNumber}</span>
            <span class="tk-open-cat">{t.categoryLabel}</span>
            <span class="tk-open-opener">opened by <code>{t.openerId}</code></span>
            {t.claimedBy && <span class="tk-open-claimed"><Icon name="ph:hand-fill" width="12" height="12" />claimed</span>}
            {t.channelId && <a href={`https://discord.com/channels/${guildId}/${t.channelId}`} target="_blank" rel="noopener" class="tk-open-link"><Icon name="ph:arrow-square-out" width="13" height="13" />Open</a>}
          </div>
        ))}
      </div>
    )}
  </div>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  h2 { font-size: 14.5px; margin: 0 0 14px; display: flex; align-items: center; gap: 8px; }
  h2 :global(svg) { color: var(--accent); }
  .tk-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 28px; max-width: 68ch; }
  .tk-sub b { color: var(--text); }
  .tk-sub code { font-family: var(--mono); color: var(--accent); }

  .tk-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; border-radius: 9px; padding: 10px 14px; margin-bottom: 20px; max-width: fit-content; }
  .tk-flash-ok { color: var(--green); background: var(--green-soft); border: 1px solid var(--green); }
  .tk-flash-err { color: var(--red); background: var(--red-soft); border: 1px solid var(--red); }

  .tk-section { margin-bottom: 40px; }
  .tk-empty-note { font-size: 13px; color: var(--text-dim); }

  .tk-cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
  .tk-cat-card { border: 1px solid var(--border); border-radius: 13px; padding: 14px; background: var(--card); display: flex; flex-direction: column; gap: 12px; }
  .tk-cat-head { display: flex; align-items: center; gap: 8px; }
  .tk-cat-emoji-chip { width: 30px; height: 30px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: var(--bg-raise); font-size: 15px; }
  .tk-cat-label { flex: 1; border: 1px solid transparent; background: transparent; font-size: 14px; font-weight: 600; color: var(--text); padding: 4px 6px; border-radius: 6px; font-family: var(--sans); }
  .tk-cat-label:focus { outline: none; border-color: var(--border); background: var(--bg-raise); }
  .tk-cat-del { border: none; background: transparent; color: var(--text-dim); cursor: pointer; padding: 4px; border-radius: 6px; }
  .tk-cat-del:hover { color: var(--red); background: var(--red-soft); }

  .tk-cat-row { display: flex; flex-direction: column; gap: 5px; }
  .tk-cat-row label { font-size: 11px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.04em; }
  .tk-cat-row input, .tk-cat-row select { width: 100%; box-sizing: border-box; border: 1px solid var(--border); border-radius: 8px; padding: 7px 9px; background: var(--bg-raise); color: var(--text); font-family: var(--sans); font-size: 13px; }
  .tk-role-list { border: 1px solid var(--border); border-radius: 8px; background: var(--bg-raise); max-height: 110px; overflow-y: auto; padding: 4px; display: flex; flex-direction: column; }
  .tk-role-item { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 8px; padding: 5px 7px; border-radius: 6px; font-size: 12.5px; color: var(--text-muted); cursor: pointer; }
  .tk-role-item:hover { background: var(--card-hover); color: var(--text); }
  .tk-role-item input { flex-shrink: 0; accent-color: var(--accent); }
  .tk-emoji-input { max-width: 70px; }

  .tk-cat-card .btn-sm { align-self: flex-start; margin-top: 2px; }

  .tk-add-form { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .tk-add-form input[type="text"] { border: 1px solid var(--border); border-radius: 8px; padding: 8px 11px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; }
  .tk-add-form input[name="label"] { min-width: 220px; }
  .tk-add-form select { border: 1px solid var(--border); border-radius: 8px; padding: 8px 11px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; }
  .tk-add-form .btn { display: inline-flex; align-items: center; gap: 6px; }

  .tk-count { font-family: var(--mono); font-size: 11px; color: var(--text-dim); font-weight: 400; }

  .tk-open-list { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
  .tk-open-row { display: flex; align-items: center; gap: 14px; padding: 10px 14px; font-size: 13px; background: var(--card); flex-wrap: wrap; }
  .tk-open-row + .tk-open-row { border-top: 1px solid var(--border-soft); }
  .tk-open-num { font-family: var(--mono); color: var(--accent); font-weight: 600; }
  .tk-open-cat { color: var(--text-muted); }
  .tk-open-opener { color: var(--text-dim); font-size: 12px; }
  .tk-open-opener code { font-family: var(--mono); }
  .tk-open-claimed { display: flex; align-items: center; gap: 4px; font-size: 11.5px; color: var(--green); }
  .tk-open-link { margin-left: auto; display: flex; align-items: center; gap: 4px; color: var(--accent); text-decoration: none; font-size: 12.5px; }
  .tk-open-link:hover { text-decoration: underline; }

  .tk-section-note { font-size: 12.5px; color: var(--text-dim); margin: -6px 0 14px; max-width: 62ch; }

  .tk-panel-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; margin-bottom: 16px; }
  .tk-panel-card { border: 1px solid var(--border); border-radius: 13px; padding: 14px; background: var(--card); display: flex; flex-direction: column; gap: 10px; }
  .tk-panel-form { display: flex; flex-direction: column; gap: 8px; }
  .tk-panel-head { display: flex; align-items: center; gap: 8px; }
  .tk-panel-title { flex: 1; border: 1px solid var(--border); background: var(--bg-raise); font-size: 13.5px; font-weight: 600; color: var(--text); padding: 6px 8px; border-radius: 7px; font-family: var(--sans); }
  .tk-panel-chan { font-family: var(--mono); font-size: 11px; color: var(--text-dim); flex-shrink: 0; }
  .tk-panel-form textarea { border: 1px solid var(--border); border-radius: 8px; padding: 7px 9px; background: var(--bg-raise); color: var(--text); font-family: var(--sans); font-size: 12.5px; resize: vertical; }
  .tk-panel-form select { width: 100%; box-sizing: border-box; border: 1px solid var(--border); border-radius: 8px; padding: 7px 9px; background: var(--bg-raise); color: var(--text); font-family: var(--sans); font-size: 12.5px; }
  .tk-panel-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .tk-panel-row select { flex: 1; border: 1px solid var(--border); border-radius: 8px; padding: 6px 8px; background: var(--bg-raise); color: var(--text); font-family: var(--sans); font-size: 12.5px; }
  .tk-panel-cats { font-size: 11px; color: var(--text-dim); flex-shrink: 0; }
  .tk-panel-actions { display: flex; align-items: center; gap: 8px; }
  .tk-panel-move { display: flex; gap: 8px; }
