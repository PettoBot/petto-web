---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import DiscordShot from './DiscordShot.astro';
import IsoArt from './IsoArt.astro';
import { localePath, type Locale } from '../i18n/ui';
import { featuresCopy } from '../data/featuresPage';
import { getShot } from '../data/shotsIndex';

interface Props { lang: Locale }
const { lang } = Astro.props;
const c = featuresCopy[lang];
const base = localePath[lang];

const shotOf = (id: string) => getShot(id, lang);
const href = (value: string) => (value.startsWith('http') ? value : `${base}${value}`);
---
<Base title={`${c.title} · Petto`} description={c.lede} active="home" lang={lang} skin="ash" preloadImages={['/assets/hero-art-3.webp']}>
  <main>
    <section class="ft-hero vx-sub-hero">
      <div class="vx-sub-bg" aria-hidden="true" style="background-image:url('/assets/hero-art-3.webp');background-size:cover;background-position:center 26%;">
        <img src="/assets/hero-art-3.webp" alt="" loading="eager" decoding="sync" fetchpriority="high" draggable="false" />
        <div class="vx-sub-fade"></div>
      </div>
      <div class="wrap">
        <div class="eyebrow">{c.eyebrow}</div>
        <h1>{c.h1}</h1>
        <p class="lede">{c.lede}</p>
        <div class="ft-cta">
          <a class="btn btn-primary" href="https://petto.sbs/invite" target="_blank" rel="noopener">{c.cta.add}</a>
          <a class="btn btn-ghost" href={`${base}/commands`}>{c.cta.commands} &rarr;</a>
        </div>
        <nav class="ft-jump" aria-label={c.title}>
          {c.groups.map((g) => (
            <a href={`#${g.id}`} class={`ft-chip ft-${g.color}`}><Icon name={g.icon} width="15" height="15" />{g.title.split(',')[0]}</a>
          ))}
        </nav>
        <div class="iso-stage"><IsoArt variant="hub" /></div>
      </div>
    </section>

    <section class="ft-body">
      <div class="wrap">
        {c.groups.map((g, i) => (
          <article id={g.id} class={`ft-group ft-${g.color} reveal${i % 2 ? ' reverse' : ''}${g.shots.length > 3 ? ' ft-tall' : ''}`}>
            <div class="ft-copy">
              <div class="ft-copy-in">
              <div class="ft-icon"><Icon name={g.icon} width="22" height="22" /></div>
              <h2>{g.title}</h2>
              <p class="ft-desc">{g.desc}</p>
              <ul class="ft-points">
                {g.points.map((p) => <li><Icon name="ph:check-circle-fill" width="16" height="16" /><span>{p}</span></li>)}
              </ul>
              <div class="ft-cmds">
                {g.commands.map((cmd) => <code>{cmd}</code>)}
              </div>
              {g.href && <a class="ft-more" href={href(g.href)}>{c.allCommands} <Icon name="ph:arrow-right-bold" width="13" height="13" /></a>}
              </div>
            </div>
            <div class="ft-shots">
              {g.shots.length
                ? g.shots.map((id) => <DiscordShot shot={shotOf(id)} label={`${g.title}: ${id}`} />)
                : <div class="ft-empty"><Icon name={g.icon} width="54" height="54" /></div>}
            </div>
          </article>
        ))}
        <p class="ft-note">{c.shotNote}</p>
      </div>
    </section>

    <section class="ft-gallery">
      <div class="wrap">
        <div class="ft-gallery-head reveal">
          <div class="eyebrow">{c.gallery.eyebrow}</div>
          <h2>{c.gallery.title}</h2>
          <p>{c.gallery.desc}</p>
        </div>
        <div class="ft-masonry reveal">
          {c.gallery.shots.map((id) => <DiscordShot shot={shotOf(id)} label={id} />)}
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .ft-hero { padding: 0; }
  .ft-hero > .wrap { padding-block: 52px 36px; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .ft-hero h1 { font-size: clamp(30px, 4.2vw, 44px); margin: 12px auto 14px; max-width: 19ch; line-height: 1.12; }
  .ft-hero .lede { color: var(--text-muted); font-size: 16px; line-height: 1.6; max-width: 56ch; margin-inline: auto; }
  .ft-cta { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin: 22px 0 24px; }
  .ft-jump { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .ft-chip { display: inline-flex; align-items: center; gap: 7px; min-height: 36px; padding: 7px 13px; border-radius: 999px; font-size: 13px; border: 1px solid var(--border); color: var(--text-muted); text-decoration: none; background: var(--bg-raise); transition: color 0.15s, border-color 0.15s; }
  .ft-chip:hover { color: var(--text); border-color: var(--sc); }
  .ft-chip:focus-visible, .ft-more:focus-visible { outline: 2px solid var(--sc); outline-offset: 3px; }
  .ft-chip :global(svg) { color: var(--sc); }

  .ft-red { --sc: var(--red); }
  .ft-yellow { --sc: var(--yellow); }
  .ft-blue { --sc: var(--accent); }
  .ft-green { --sc: var(--green); }

  .ft-body { padding: 0; }
  .ft-body > .wrap { padding-block: 52px 56px; }
  .ft-group { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 0; margin-bottom: 32px; border: 1px solid var(--border); border-radius: 20px; overflow: clip; scroll-margin-top: 90px; }
  .ft-group.reverse .ft-copy { order: 2; }
  .ft-group.reverse .ft-shots { order: 1; }
  .ft-copy { background: color-mix(in srgb, var(--sc) 16%, var(--bg)); padding: 40px 42px; display: flex; flex-direction: column; justify-content: center; }
  /* A group with many Discord cards is tall: the text follows along instead of leaving a big empty panel under it. */
  .ft-tall .ft-copy { justify-content: flex-start; }
  .ft-copy-in { position: sticky; top: 96px; display: flex; flex-direction: column; gap: 14px; }
  .ft-icon { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: color-mix(in srgb, var(--sc) 24%, transparent); color: var(--sc); }
  .ft-copy h2 { font-size: 25px; line-height: 1.3; margin: 2px 0 0; }
  .ft-desc { color: var(--text-muted); font-size: 15.5px; line-height: 1.7; }
  .ft-points { list-style: none; padding: 0; margin: 4px 0 0; display: flex; flex-direction: column; gap: 9px; }
  .ft-points li { display: flex; gap: 10px; font-size: 14.5px; line-height: 1.6; color: var(--text-muted); }
  .ft-points li :global(svg) { flex-shrink: 0; margin-top: 4px; color: var(--sc); }
  .ft-cmds { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 4px; }
  .ft-cmds code { font-family: var(--mono); font-size: 12.5px; padding: 4px 9px; border-radius: 7px; background: var(--bg-raise); border: 1px solid var(--border-soft); color: var(--text); }
  .ft-more { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: var(--sc); text-decoration: none; margin-top: 4px; }
  .ft-shots { background: color-mix(in srgb, var(--sc) 8%, var(--bg-raise)); padding: 32px; display: flex; flex-direction: column; gap: 18px; justify-content: center; min-width: 0; }
  .ft-empty { display: grid; place-items: center; min-height: 220px; color: color-mix(in srgb, var(--sc) 55%, transparent); }
  .ft-note { text-align: center; font-size: 13px; color: var(--text-dim); margin-top: 4px; }

  .ft-gallery { padding: 0; }
  .ft-gallery > .wrap { padding-block: 64px 72px; }
  .ft-gallery-head { max-width: 640px; margin-bottom: 30px; }
  .ft-gallery-head h2 { font-size: 30px; margin: 12px 0; }
  .ft-gallery-head p { color: var(--text-muted); line-height: 1.7; }
  .ft-masonry { column-count: 3; column-gap: 18px; }
  .ft-masonry :global(.dshot) { break-inside: avoid; margin-bottom: 18px; }
  @media (max-width: 1100px) { .ft-masonry { column-count: 2; } }
  @media (max-width: 700px) { .ft-masonry { column-count: 1; } }

  .ft-closing { padding: 88px 0 96px; text-align: center; position: relative; isolation: isolate; overflow: hidden; }
  .ft-closing::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(60% 75% at 50% 85%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 72%); }
  .ft-closing h2 { font-size: clamp(28px, 4vw, 40px); margin-bottom: 12px; }
  .ft-closing p { color: var(--text-muted); max-width: 56ch; margin: 0 auto 24px; line-height: 1.7; }

  @media (max-width: 860px) {
    .ft-hero { padding-top: 48px; }
    .ft-group { grid-template-columns: 1fr; }
    .ft-group.reverse .ft-copy, .ft-group.reverse .ft-shots { order: 0; }
    .ft-copy { padding: 30px 24px; }
    .ft-copy-in { position: static; }
    .ft-shots { padding: 20px 14px; }
  }
</style>
