---
import Base from '../layouts/Base.astro';
import { localePath, type Locale } from '../i18n/ui';
import { getEnv } from '../utils/env';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const localeBase = localePath[lang] ?? '';

const COPY = {
  en: {
    title: 'Petto in numbers', pill: 'Live', heading: 'Petto in numbers',
    desc: 'What every server that uses Petto has done so far. The numbers move on their own. Click one to refresh it right now.',
    messages: 'Messages', voice: 'Hours in voice', reactions: 'Reactions',
    all: 'All time', today: 'Today', week: 'This week',
    rankTitle: 'Server ranking', rankDesc: 'Only servers that turned it on in their dashboard appear here.',
    rankEmpty: 'No server is in the ranking yet. You can add yours in the dashboard, under General.',
    hoursShort: 'h', updated: 'Updated', never: 'waiting for the first numbers', refresh: 'Click to refresh',
    userTitle: 'Top members', userDesc: 'Members who chose to appear, with their messages and voice time added up over every server.', userEmpty: 'Nobody is in the member ranking yet. Type !globalranking on in a server with Petto to join.',
    note: 'The counters start from when each server began to be counted, so they grow from there.',
    unavailable: 'The numbers are not available right now. We will keep trying.',
  },
  es: {
    title: 'Petto en números', pill: 'En vivo', heading: 'Petto en números',
    desc: 'Lo que han hecho todos los servidores que usan Petto hasta ahora. Los números se mueven solos. Haz clic en uno para actualizarlo ya.',
    messages: 'Mensajes', voice: 'Horas en voz', reactions: 'Reacciones',
    all: 'Total', today: 'Hoy', week: 'Esta semana',
    rankTitle: 'Ranking de servidores', rankDesc: 'Solo aparecen los servidores que lo activaron en su dashboard.',
    rankEmpty: 'Todavía no hay ningún servidor en el ranking. Puedes añadir el tuyo en el dashboard, en General.',
    hoursShort: 'h', updated: 'Actualizado', never: 'esperando los primeros números', refresh: 'Clic para actualizar',
    userTitle: 'Top miembros', userDesc: 'Miembros que eligieron aparecer, con sus mensajes y tiempo en voz sumados de todos los servidores.', userEmpty: 'Nadie está en el ranking de miembros todavía. Escribe !globalranking on en un servidor con Petto para unirte.',
    note: 'Los contadores empiezan desde que cada servidor comenzó a contarse, y crecen desde ahí.',
    unavailable: 'Los números no están disponibles ahora. Seguiremos intentando.',
  },
  'pt-BR': {
    title: 'Petto em números', pill: 'Ao vivo', heading: 'Petto em números',
    desc: 'O que todos os servidores que usam o Petto já fizeram até agora. Os números se mexem sozinhos. Clique em um para atualizar agora.',
    messages: 'Mensagens', voice: 'Horas em voz', reactions: 'Reações',
    all: 'Total', today: 'Hoje', week: 'Esta semana',
    rankTitle: 'Ranking de servidores', rankDesc: 'Só aparecem os servidores que ativaram isso no dashboard.',
    rankEmpty: 'Ainda não há nenhum servidor no ranking. Você pode adicionar o seu no dashboard, em Geral.',
    hoursShort: 'h', updated: 'Atualizado', never: 'esperando os primeiros números', refresh: 'Clique para atualizar',
    userTitle: 'Top membros', userDesc: 'Membros que escolheram aparecer, com suas mensagens e tempo em voz somados de todos os servidores.', userEmpty: 'Ninguém está no ranking de membros ainda. Digite !globalranking on em um servidor com o Petto para entrar.',
    note: 'Os contadores começam de quando cada servidor passou a ser contado, e crescem a partir daí.',
    unavailable: 'Os números não estão disponíveis agora. Vamos continuar tentando.',
  },
} as const;
const c = COPY[lang] ?? COPY.en;

const statsEndpoint = new URL('/api/stats', Astro.url).pathname;

// The first paint already has the numbers; the browser then keeps them moving.
async function firstSnapshot() {
  const url = getEnv(Astro, 'PETTO_BOT_API_URL');
  const key = getEnv(Astro, 'PETTO_BOT_API_SECRET');
  if (!url || !key) return null;
  try {
    const res = await fetch(`${url}/rest/v1/global_stats?id=eq.main&select=data,updated_at`, {
      headers: { apikey: key, Authorization: `Bearer ${key}`, 'X-Petto-Dashboard-Key': key },
    });
    if (!res.ok) return null;
    const rows = await res.json();
    const row = Array.isArray(rows) ? rows[0] : null;
    return row?.data?.totals ? { data: row.data, updatedAt: row.updated_at } : null;
  } catch {
    return null;
  }
}
const initial = await firstSnapshot();
const COUNTERS = [
  { key: 'messages', label: c.messages },
  { key: 'voiceSeconds', label: c.voice },
  { key: 'reactions', label: c.reactions },
];
---
<Base title={`${c.title} · Petto`} lang={lang}>
  <main>
    <section class="gs-sec">
      <div class="wrap gs-wrap">
        <div class="eyebrow">{c.pill}</div>
        <h1>{c.heading}</h1>
        <p class="gs-desc">{c.desc}</p>

        <div
          id="gs"
          data-endpoint={statsEndpoint}
          data-locale={lang}
          data-initial={initial ? JSON.stringify(initial) : ''}
          data-hours={c.hoursShort}
          data-updated={c.updated}
          data-never={c.never}
          data-empty={c.rankEmpty}
          data-user-empty={c.userEmpty}
          data-unavailable={c.unavailable}
          data-guild-link={`${localeBase}/dash`}
        >
          <div class="gs-periods" role="tablist" aria-label="Period">
            <button type="button" class="gs-pill on" data-counter-period="all">{c.all}</button>
            <button type="button" class="gs-pill" data-counter-period="today">{c.today}</button>
            <button type="button" class="gs-pill" data-counter-period="week">{c.week}</button>
            <span class="gs-live" id="gsLive"><span class="gs-live-dot"></span><span id="gsUpdated">{c.never}</span></span>
          </div>

          <div class="gs-counters">
            {COUNTERS.map((counter) => (
              <button type="button" class="gs-counter" data-metric={counter.key} title={c.refresh}>
                <span class="gs-counter-label">{counter.label}</span>
                <span class="gs-odo" data-odo aria-live="off">0</span>
              </button>
            ))}
          </div>
          <p class="gs-unavailable" id="gsUnavailable" hidden>{c.unavailable}</p>

          <div class="gs-rank-head">
            <div>
              <h2>{c.rankTitle}</h2>
              <p class="gs-rank-desc">{c.rankDesc}</p>
            </div>
            <div class="gs-rank-tabs">
              <div class="gs-tabs" data-group="metric">
                <button type="button" class="gs-pill on" data-metric-tab="messages">{c.messages}</button>
                <button type="button" class="gs-pill" data-metric-tab="voiceSeconds">{c.voice}</button>
                <button type="button" class="gs-pill" data-metric-tab="reactions">{c.reactions}</button>
              </div>
              <div class="gs-tabs" data-group="period">
                <button type="button" class="gs-pill on" data-rank-period="all">{c.all}</button>
                <button type="button" class="gs-pill" data-rank-period="week">{c.week}</button>
              </div>
            </div>
          </div>
          <ol class="gs-rank" id="gsRank"></ol>

          <div class="gs-rank-head">
            <div>
              <h2>{c.userTitle}</h2>
              <p class="gs-rank-desc">{c.userDesc}</p>
            </div>
            <div class="gs-rank-tabs">
              <div class="gs-tabs" data-group="user-metric">
                <button type="button" class="gs-pill on" data-user-tab="messages">{c.messages}</button>
                <button type="button" class="gs-pill" data-user-tab="voiceSeconds">{c.voice}</button>
              </div>
            </div>
          </div>
          <ol class="gs-rank" id="gsUsers"></ol>
          <p class="gs-note">{c.note}</p>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  const root = document.getElementById('gs');
  if (root) {
    const locale = root.dataset.locale || 'en';
    const hoursShort = root.dataset.hours || 'h';
    const refreshMs = 30_000;
    const staleCapMs = 5 * 60_000; // the numbers are estimated for at most this long without a new snapshot
    const odo = (el: Element) => el as HTMLElement;

    let snapshot: any = null; // { data, updatedAt }
    let fetchedAt = Date.now();
    let counterPeriod = 'all';
    let rankMetric = 'messages';
    let rankPeriod = 'all';
    let userMetric = 'messages';

    try { if (root.dataset.initial) snapshot = JSON.parse(root.dataset.initial); } catch { snapshot = null; }

    // A number that rolls: each digit is a strip of 0 to 9 that slides to the new digit, up or down.
    function setOdometer(el: HTMLElement, value: number, decimals: number) {
      const text = Math.max(0, value).toLocaleString(locale, { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
      const shape = text.replace(/\d/g, '0');
      const fresh = el.dataset.shape !== shape;
      if (fresh) {
        el.dataset.shape = shape;
        el.textContent = '';
        for (const char of text) {
          if (/\d/.test(char)) {
            const col = document.createElement('span');
            col.className = 'gs-col';
            const strip = document.createElement('span');
            strip.className = 'gs-strip';
            for (let d = 0; d < 10; d += 1) { const cell = document.createElement('i'); cell.textContent = String(d); strip.appendChild(cell); }
            col.appendChild(strip);
            el.appendChild(col);
          } else {
            const sep = document.createElement('span');
            sep.className = 'gs-sep';
            sep.textContent = char;
            el.appendChild(sep);
          }
        }
      }
      el.setAttribute('aria-label', text);
      const digits = [...text].filter((char) => /\d/.test(char));
      const strips = el.querySelectorAll<HTMLElement>('.gs-strip');
      const apply = () => strips.forEach((strip, i) => { strip.style.transform = `translateY(${-Number(digits[i])}em)`; });
      if (fresh) requestAnimationFrame(() => requestAnimationFrame(apply)); else apply();
    }

    function estimate(metric: string) {
      const data = snapshot?.data;
      const base = data?.totals?.[counterPeriod]?.[metric] ?? 0;
      const rate = data?.rates?.[metric] ?? 0;
      const sinceSnapshot = Math.min(staleCapMs, Math.max(0, Date.now() - new Date(snapshot.updatedAt).getTime()));
      return base + rate * (sinceSnapshot / 1000);
    }

    function renderCounters() {
      if (!snapshot) return;
      root!.querySelectorAll<HTMLElement>('.gs-counter').forEach((card) => {
        const metric = card.dataset.metric || 'messages';
        const target = odo(card.querySelector('[data-odo]')!);
        if (metric === 'voiceSeconds') setOdometer(target, estimate(metric) / 3600, 1);
        else setOdometer(target, Math.floor(estimate(metric)), 0);
      });
    }

    function formatRankValue(metric: string, value: number) {
      if (metric === 'voiceSeconds') return `${(value / 3600).toLocaleString(locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 })} ${hoursShort}`;
      return value.toLocaleString(locale);
    }

    function iconUrl(value: unknown) {
      if (typeof value !== 'string') return null;
      try {
        const url = new URL(value);
        return url.protocol === 'https:' && url.hostname === 'cdn.discordapp.com' ? url.href : null;
      } catch { return null; }
    }

    function fillList(list: HTMLElement | null, rows: any[], metric: string, emptyText: string, pictureKey: string) {
      if (!list) return;
      list.textContent = '';
      if (!rows.length) {
        const empty = document.createElement('li');
        empty.className = 'gs-rank-empty';
        empty.textContent = emptyText;
        list.appendChild(empty);
        return;
      }
      rows.forEach((row, index) => {
        const item = document.createElement('li');
        item.className = 'gs-row';
        const place = document.createElement('span');
        place.className = 'gs-place';
        place.textContent = String(index + 1);
        const avatar = document.createElement('span');
        avatar.className = 'gs-avatar';
        const icon = iconUrl(row[pictureKey]);
        if (icon) { const img = document.createElement('img'); img.src = icon; img.alt = ''; img.loading = 'lazy'; avatar.appendChild(img); } else avatar.textContent = String(row.name || '?').slice(0, 1).toUpperCase();
        const name = document.createElement('span');
        name.className = 'gs-name';
        name.textContent = String(row.name || '');
        const value = document.createElement('span');
        value.className = 'gs-value';
        value.textContent = formatRankValue(metric, Number(row.value) || 0);
        item.append(place, avatar, name, value);
        list.appendChild(item);
      });
    }

    function renderRanking() {
      fillList(document.getElementById('gsRank'), snapshot?.data?.ranking?.[rankPeriod]?.[rankMetric] ?? [], rankMetric, root!.dataset.empty || '', 'icon');
      fillList(document.getElementById('gsUsers'), snapshot?.data?.users?.[userMetric] ?? [], userMetric, root!.dataset.userEmpty || '', 'avatar');
    }

    function renderStamp() {
      const stamp = document.getElementById('gsUpdated');
      const live = document.getElementById('gsLive');
      if (!stamp || !snapshot) return;
      const time = new Date(snapshot.updatedAt);
      stamp.textContent = `${root!.dataset.updated} ${time.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' })}`;
      live?.classList.add('on');
    }

    async function load(fromClick = false, card?: HTMLElement) {
      if (card) card.classList.add('loading');
      try {
        const response = await fetch(root!.dataset.endpoint || '/api/stats', { headers: { Accept: 'application/json' }, cache: 'no-store' });
        if (response.ok) {
          const payload = await response.json();
          if (payload?.data?.totals) {
            snapshot = { data: payload.data, updatedAt: payload.updatedAt };
            fetchedAt = Date.now();
            document.getElementById('gsUnavailable')?.setAttribute('hidden', '');
            renderCounters(); renderRanking(); renderStamp();
          }
        } else if (!snapshot) {
          document.getElementById('gsUnavailable')?.removeAttribute('hidden');
        }
      } catch {
        if (!snapshot) document.getElementById('gsUnavailable')?.removeAttribute('hidden');
      } finally {
        if (card) setTimeout(() => card.classList.remove('loading'), fromClick ? 350 : 0);
      }
    }

    function choose(group: Element[], active: Element) {
      group.forEach((button) => button.classList.toggle('on', button === active));
    }

    root.querySelectorAll<HTMLElement>('[data-counter-period]').forEach((button, _i, all) => {
      button.addEventListener('click', () => { counterPeriod = button.dataset.counterPeriod || 'all'; choose([...all], button); renderCounters(); });
    });
    root.querySelectorAll<HTMLElement>('[data-metric-tab]').forEach((button, _i, all) => {
      button.addEventListener('click', () => { rankMetric = button.dataset.metricTab || 'messages'; choose([...all], button); renderRanking(); });
    });
    root.querySelectorAll<HTMLElement>('[data-user-tab]').forEach((button, _i, all) => {
      button.addEventListener('click', () => { userMetric = button.dataset.userTab || 'messages'; choose([...all], button); renderRanking(); });
    });
    root.querySelectorAll<HTMLElement>('[data-rank-period]').forEach((button, _i, all) => {
      button.addEventListener('click', () => { rankPeriod = button.dataset.rankPeriod || 'all'; choose([...all], button); renderRanking(); });
    });
    root.querySelectorAll<HTMLElement>('.gs-counter').forEach((card) => {
      card.addEventListener('click', () => load(true, card));
    });

    renderCounters(); renderRanking(); renderStamp();
    load();
    setInterval(() => { if (!document.hidden) load(); }, refreshMs);
    setInterval(() => { if (!document.hidden) renderCounters(); }, 1000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden && Date.now() - fetchedAt > refreshMs) load(); });
  }
</script>

<style>
  .gs-sec { padding: 90px 0 120px; }
  .gs-wrap { max-width: 860px; }
  .gs-sec h1 { font-size: 34px; margin: 14px 0 12px; }
  .gs-desc { color: var(--text-muted); font-size: 15px; line-height: 1.6; max-width: 60ch; margin-bottom: 30px; }
  .gs-periods, .gs-tabs { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .gs-periods { margin-bottom: 14px; }
  .gs-live { margin-left: auto; display: flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-dim); opacity: 0.5; }
  .gs-live.on { opacity: 1; color: var(--green); }
  .gs-live-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .gs-live.on .gs-live-dot { animation: gsPulse 1.6s ease-in-out infinite; }
  @keyframes gsPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  .gs-pill { border: 1px solid var(--border); background: var(--card); color: var(--text-muted); border-radius: 999px; padding: 6px 13px; font-size: 13px; font-family: inherit; cursor: pointer; transition: color .15s ease, border-color .15s ease, background .15s ease; }
  .gs-pill:hover { color: var(--text); }
  .gs-pill.on { color: var(--text); border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, var(--card)); }

  .gs-counters { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 14px; }
  .gs-counter { text-align: left; border: 1px solid var(--border); border-radius: 16px; padding: 20px 20px 22px; background: var(--card); color: var(--text); font: inherit; cursor: pointer; display: flex; flex-direction: column; gap: 14px; min-width: 0; transition: border-color .15s ease, transform .15s ease; }
  .gs-counter:hover { border-color: var(--accent); }
  .gs-counter:active { transform: scale(0.99); }
  .gs-counter.loading { border-color: var(--accent); }
  .gs-counter-label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); }
  .gs-unavailable { color: var(--text-dim); font-size: 14px; margin: 0 0 14px; }

  /* The rolling number: every digit is a strip that slides, so a change is seen as movement. The digits are made by the
     script, so their rules are :global(). */
  .gs-odo { display: flex; align-items: flex-end; font-family: var(--serif); font-size: clamp(26px, 4.2vw, 38px); font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; }
  :global(.gs-col) { display: inline-block; height: 1em; overflow: hidden; }
  :global(.gs-strip) { display: flex; flex-direction: column; transition: transform 0.9s cubic-bezier(.2, .8, .2, 1); }
  :global(.gs-strip i) { display: block; height: 1em; line-height: 1; font-style: normal; text-align: center; }
  :global(.gs-sep) { display: inline-block; height: 1em; line-height: 1; padding: 0 1px; }

  .gs-rank-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 14px; margin: 38px 0 14px; }
  .gs-rank-head h2 { font-size: 20px; margin: 0 0 4px; }
  .gs-rank-desc { margin: 0; font-size: 13.5px; color: var(--text-dim); }
  .gs-rank-tabs { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
  :global(.gs-rank) { list-style: none; margin: 0; padding: 0; border: 1px solid var(--border); border-radius: 16px; overflow: hidden; background: var(--card); }
  :global(.gs-row) { display: flex; align-items: center; gap: 12px; padding: 12px 16px; }
  :global(.gs-row:not(:last-child)) { border-bottom: 1px solid var(--border-soft); }
  :global(.gs-place) { width: 22px; font-family: var(--mono); font-size: 13px; color: var(--text-dim); text-align: right; }
  :global(.gs-row:nth-child(1) .gs-place) { color: var(--yellow); }
  :global(.gs-avatar) { width: 34px; height: 34px; border-radius: 10px; background: var(--border-soft); color: var(--text-muted); display: inline-flex; align-items: center; justify-content: center; font-weight: 600; overflow: hidden; flex-shrink: 0; }
  :global(.gs-avatar img) { width: 100%; height: 100%; object-fit: cover; }
  :global(.gs-name) { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14.5px; font-weight: 500; }
  :global(.gs-value) { font-family: var(--mono); font-size: 13.5px; color: var(--text); font-variant-numeric: tabular-nums; }
  :global(.gs-rank-empty) { padding: 22px 18px; font-size: 14px; color: var(--text-dim); line-height: 1.55; }
  .gs-note { margin: 14px 2px 0; font-size: 12.5px; color: var(--text-dim); }

  @media (max-width: 720px) {
    .gs-counters { grid-template-columns: 1fr; }
    .gs-rank-tabs { align-items: flex-start; }
    .gs-live { margin-left: 0; width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.gs-strip) { transition: none; }
  }
</style>
