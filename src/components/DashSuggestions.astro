---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashAcData from './DashAcData.astro';
import EmojiPicker from './EmojiPicker.astro';
import ColorPicker from './ColorPicker.astro';
import DashFormKit from './DashFormKit.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import { getDashLang, makeT } from '../i18n/dash';
import DashBlockedMembers from './DashBlockedMembers.astro';
import type { BlockedMember } from '../utils/memberBlocks';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  config: {
    enabled: boolean; channelId: string; staffRoleId: string; embedTemplate: string; listenChannel: boolean; allowCommand: boolean; thread: boolean; threadName: string;
    selfVote: boolean; dmAuthor: boolean; anonymous: boolean; statusColors: boolean; upEmoji: string; downEmoji: string; colors: Record<string, string>;
  };
  channels: { id: string; name: string }[];
  roles: { id: string; name: string }[];
  templates: string[];
  customEmojis?: { id: string; name: string; animated: boolean }[];
  total: number;
  counts: Record<string, number>;
  recent: { id: string; number: number; authorId: string; content: string; status: string }[];
  ready: boolean;
  saved: boolean;
  failed: string;
  blocked?: BlockedMember[];
  blockResult?: 'blocked' | 'unblocked' | 'failed' | null;
}
const { user, guildId, guildName, guildIcon, config, channels, roles, templates, customEmojis = [], total, counts, recent, ready, saved, failed, blocked = [], blockResult = null } = Astro.props;
const errors: Record<string, string> = {
  channel: dt('Choose a channel from the list.'),
  role: dt('Choose a role from the list.'),
  save: dt('It could not be saved. Try again in a moment.'),
};
const statuses = [
  { id: 'pending', label: dt('Pending') },
  { id: 'approved', label: dt('Approved') },
  { id: 'denied', label: dt('Denied') },
  { id: 'considering', label: dt('Considering') },
  { id: 'implemented', label: dt('Implemented') },
];
// The suggestion variables the page's hint names, offered first by the typed autocomplete (the thread name uses them too).
const suggestionVars = [
  { tok: '{suggestion.id}', desc: dt('ID of the suggestion') }, { tok: '{suggestion.number}', desc: dt('Number of the suggestion') },
  { tok: '{suggestion.content}', desc: dt('Text of the suggestion') }, { tok: '{suggestion.status}', desc: dt('Status of the suggestion') },
  { tok: '{suggestion.reason}', desc: dt('Reason the staff wrote') }, { tok: '{suggestion.up}', desc: dt('Votes in favour') },
  { tok: '{suggestion.down}', desc: dt('Votes against') }, { tok: '{suggestion.author}', desc: dt('Who suggested it') },
];
const tones: Record<string, 'messages' | 'voice' | 'joins' | 'invites' | 'reactions' | 'leaves'> = { pending: 'reactions', approved: 'joins', denied: 'leaves', considering: 'voice', implemented: 'invites' };
const switches = [
  { name: 'allow_command', on: config.allowCommand, label: dt('Members can use the suggest command'), hint: dt('Like !suggest <text>.') },
  { name: 'listen_channel', on: config.listenChannel, label: dt('Every message in the channel is a suggestion'), hint: dt('Petto turns what they write into a suggestion and removes the original.') },
  { name: 'thread', on: config.thread, label: dt('Open a thread for each suggestion'), hint: dt('To talk about it without filling the channel.') },
  { name: 'self_vote', on: config.selfVote, label: dt('The author can vote on their own suggestion'), hint: '' },
  { name: 'dm_author', on: config.dmAuthor, label: dt('Send a DM to the author when the staff answers'), hint: '' },
  { name: 'status_colors', on: config.statusColors, label: dt('Color each suggestion by its status'), hint: dt('The message takes the color of its status. Pick the colors below.') },
  { name: 'anonymous', on: config.anonymous, label: dt('Hide who made each suggestion'), hint: dt('The staff still sees it in the list below.') },
];
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="suggestions" pageTitle={dt('Suggestions')}>
  <DashFormKit />
  <DashSettingsKit />
  <h1>{dt('Suggestions')}</h1>
  <DashAcData roles={roles} channels={channels} emojis={customEmojis} vars={suggestionVars} />
  {saved && <div class="dfx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {failed && <div class="dfx-flash dfx-warn"><Icon name="ph:warning-fill" width="15" height="15" />{errors[failed] ?? errors.save}</div>}
  {!ready && <div class="dfx-flash dfx-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}

  <div class="sg-page">
    <DashStatTiles tiles={[
      { label: dt('Suggestions'), value: total, tone: 'messages' },
      ...statuses.map((s) => ({ label: s.label, value: counts[s.id] ?? 0, tone: tones[s.id] })),
    ]} />

    <form method="POST" class="dfx-form">
      <label class="dfx-master"><span><b>{dt('Suggestions are on in this server')}</b><em>{dt('Members suggest, the server votes and the staff answers.')}</em></span><input type="checkbox" class="dfx-t" name="enabled" checked={config.enabled} /></label>

      <section class="dfx-sec">
        <div class="dfx-sec-head"><h2>{dt('Where it goes')}</h2><p>{dt('The channel of the suggestions and who answers them.')}</p></div>
        <div class="dfx-grid">
          <div class="dfx-field"><label>{dt('Channel')}</label>
            <select name="channel_id">
              <option value="">{dt('Choose a channel')}</option>
              {channels.map((c) => <option value={c.id} selected={c.id === config.channelId}>#{c.name}</option>)}
            </select>
            <span class="dfx-hint">{dt('The suggestions are posted here.')}</span>
          </div>
          <div class="dfx-field"><label>{dt('Staff role')}</label>
            <select name="staff_role_id">
              <option value="">{dt('Only who has Manage Server')}</option>
              {roles.map((r) => <option value={r.id} selected={r.id === config.staffRoleId}>{r.name}</option>)}
            </select>
            <span class="dfx-hint">{dt('Can answer, delete and block.')}</span>
          </div>
        </div>
        <div class="dfx-switches">
          {switches.filter((x) => ['allow_command', 'listen_channel'].includes(x.name)).map((x) => (
            <label class="dfx-switch"><span><b>{x.label}</b>{x.hint && <em>{x.hint}</em>}</span><input type="checkbox" class="dfx-t" name={x.name} checked={x.on} /></label>
          ))}
        </div>
      </section>

      <section class="dfx-sec">
        <div class="dfx-sec-head"><h2>{dt('How a suggestion looks')}</h2><p>{dt('The design of the message, the voting buttons and the colors.')}</p></div>
        <div class="dfx-grid">
          <div class="dfx-field dfx-wide"><label>{dt('Design')}</label>
            <select name="embed_template">
              <option value="">{dt('The usual design')}</option>
              {templates.map((name) => <option value={name} selected={name === config.embedTemplate}>{name}</option>)}
            </select>
            <span class="dfx-hint">{dt('A design from Embeds (it can be Components V2). Variables: {suggestion.id}, {suggestion.number}, {suggestion.content}, {suggestion.status}, {suggestion.reason}, {suggestion.up}, {suggestion.down}, {suggestion.author} and the usual ones.')}</span>
          </div>
        </div>
        <div class="dfx-emoji-row">
          <div class="dfx-field"><label>{dt('Vote in favor')}</label><input type="text" name="up_emoji" data-emoji-input value={config.upEmoji} maxlength="64" placeholder="✅" /></div>
          <div class="dfx-field"><label>{dt('Vote against')}</label><input type="text" name="down_emoji" data-emoji-input value={config.downEmoji} maxlength="64" placeholder="❌" /></div>
        </div>
        <div class="dfx-switches">
          {switches.filter((x) => ['self_vote', 'anonymous', 'dm_author', 'status_colors'].includes(x.name)).map((x) => (
            <label class="dfx-switch"><span><b>{x.label}</b>{x.hint && <em>{x.hint}</em>}</span><input type="checkbox" class="dfx-t" name={x.name} checked={x.on} /></label>
          ))}
        </div>
        <div class="sg-colors" data-sx-needs="status_colors">
          <div class="dfx-label">{dt('Color of each status')}</div>
          <div class="sg-color-row">
            {statuses.map((s) => (
              <ColorPicker name={`color_${s.id}`} value={config.colors[s.id]} label={s.label} />
            ))}
          </div>
        </div>
      </section>

      <section class="dfx-sec">
        <div class="dfx-sec-head"><h2>{dt('Threads')}</h2><p>{dt('To talk about each suggestion without filling the channel.')}</p></div>
        {switches.filter((x) => x.name === 'thread').map((x) => (
          <label class="dfx-switch"><span><b>{x.label}</b>{x.hint && <em>{x.hint}</em>}</span><input type="checkbox" class="dfx-t" name={x.name} checked={x.on} /></label>
        ))}
        <div class="dfx-field" data-sx-needs="thread"><label>{dt('Thread name')}</label>
          <textarea name="thread_name" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count data-ac="vars,emojis" maxlength="100">{config.threadName}</textarea>
          <span class="dfx-hint">{dt('The suggestion variables work here too, like {suggestion.number}.')}</span>
        </div>
      </section>

      <div class="dfx-foot">
        <button class="btn btn-accent btn-sm" type="submit" disabled={!ready}>{dt('Save')}</button>
        <span class="dfx-hint">{dt('To post a button that opens the form, use !suggestion panel in the channel you want.')}</span>
      </div>
    </form>

    <section class="sg-list">
      <h2>{dt('Latest suggestions')}</h2>
      {recent.length === 0 && <p class="dfx-empty"><Icon name="ph:lightbulb-fill" width="16" height="16" />{dt('There are no suggestions yet.')}</p>}
      {recent.length > 0 && <div class="sg-items dgl-stagger">
      {recent.map((s) => (
        <article class="sg-item" style={`--st:${config.colors[s.status] ?? '#888'}`}>
          <div class="sg-head">
            <span class="sg-num">#{s.number}</span>
            <span class="sg-pill" data-sg-status>{statuses.find((x) => x.id === s.status)?.label ?? s.status}</span>
            <code class="sg-id">{s.id}</code>
            <span class="sg-user">{s.authorId}</span>
          </div>
          <p class="sg-text">{s.content}</p>
          <div class="sg-answer" data-sg-id={s.id}>
            <textarea class="sg-reason dgl-autogrow" rows="2" data-ac="roles,channels,emojis" maxlength="1000" placeholder={dt('Reason (optional)')} aria-label={dt('Reason (optional)')}></textarea>
            <div class="sg-buttons">
              <button type="button" class="btn btn-ghost btn-sm sg-b-ok" data-sg-status-to="approved" disabled={!ready}>{dt('Approve')}</button>
              <button type="button" class="btn btn-ghost btn-sm sg-b-no" data-sg-status-to="denied" disabled={!ready}>{dt('Deny')}</button>
              <button type="button" class="btn btn-ghost btn-sm" data-sg-status-to="considering" disabled={!ready}>{dt('Consider')}</button>
              <button type="button" class="btn btn-ghost btn-sm" data-sg-status-to="implemented" disabled={!ready}>{dt('Implemented')}</button>
              <button type="button" class="btn btn-ghost btn-sm" data-sg-status-to="pending" disabled={!ready}>{dt('Reopen')}</button>
            </div>
            <span class="sg-msg" data-sg-msg hidden></span>
            <button type="button" class="sg-votes-btn" data-sg-votes disabled={!ready}><Icon name="ph:users-fill" width="12" height="12" />{dt('Who voted')}</button>
            <div class="sg-votes" data-sg-votes-box hidden></div>
          </div>
        </article>
      ))}
      </div>}
    </section>

    <DashBlockedMembers guildId={guildId} title={dt('Blocked from suggesting')} text={dt('A blocked member cannot make suggestions, the same as when the staff blocks them in Discord. Unblock them here at any time.')} empty={dt('Nobody is blocked. Block someone who keeps spamming suggestions or posts them in bad faith.')} blocked={blocked} result={blockResult} disabled={!ready} />
  </div>
  <EmojiPicker customEmojis={customEmojis} />
  <script is:inline define:vars={{ labels: { approved: dt('Approved'), denied: dt('Denied'), considering: dt('Under consideration'), implemented: dt('Implemented'), pending: dt('Pending') }, working: dt('Saving...'), votesWords: { up: dt('In favor'), down: dt('Against'), nobody: dt('nobody') }, failed: dt('It could not be saved. Try again in a moment.') }}>
    (function () {
      var guild = location.pathname.replace(/^\/(es|pt-br)(?=\/)/i, '').split('/')[3];
      document.querySelectorAll('[data-sg-status-to]').forEach(function (button) {
        button.addEventListener('click', function () {
          var box = button.closest('[data-sg-id]');
          var msg = box.querySelector('[data-sg-msg]');
          var status = button.getAttribute('data-sg-status-to');
          var all = box.querySelectorAll('button');
          var before = button.innerHTML;
          all.forEach(function (b) { b.disabled = true; });
          // The pressed button says it is saving (same width); the answer is a toast (the line under the buttons only without it).
          button.style.minWidth = button.offsetWidth + 'px';
          button.textContent = working;
          if (msg) msg.hidden = true;
          fetch('/dash/guild/' + guild + '/suggestions-api', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: box.getAttribute('data-sg-id'), status: status, reason: box.querySelector('.sg-reason').value }), signal: window.AbortSignal && AbortSignal.timeout ? AbortSignal.timeout(30000) : undefined })
            .then(function (r) { return r.json().catch(function () { return { ok: false, message: failed }; }); })
            .catch(function () { return { ok: false, message: failed }; })
            .then(function (result) {
              all.forEach(function (b) { b.disabled = false; });
              button.innerHTML = before; button.style.minWidth = '';
              var said = result.ok ? (labels[status] || '') : (result.message || failed);
              if (window.dglToast) { if (said) window.dglToast(said, { kind: result.ok ? 'ok' : 'error' }); }
              else if (msg) { msg.hidden = false; msg.className = 'sg-msg ' + (result.ok ? 'ok' : 'bad'); msg.textContent = said; }
              if (result.ok) { var label = box.parentElement.querySelector('[data-sg-status]'); if (label) label.textContent = labels[status] || status; }
            });
        });
      });
    })();
    (function () {
      var guild = location.pathname.replace(/^\/(es|pt-br)(?=\/)/i, '').split('/')[3];
      document.querySelectorAll('[data-sg-votes]').forEach(function (button) {
        button.addEventListener('click', function () {
          var box = button.closest('[data-sg-id]');
          var out = box.querySelector('[data-sg-votes-box]');
          if (!out.hidden && !out.classList.contains('dgl-leave')) { if (window.dglMotion) window.dglMotion.hide(out); else out.hidden = true; return; }
          if (window.dglMotion) window.dglMotion.stay(out);
          out.hidden = false; out.textContent = working;
          fetch('/dash/guild/' + guild + '/suggestions-api', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'votes', id: box.getAttribute('data-sg-id') }) })
            .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
            .catch(function () { return { ok: false }; })
            .then(function (result) {
              out.textContent = '';
              if (!result.ok) { out.textContent = result.message || failed; return; }
              [['up', votesWords.up, result.upTotal], ['down', votesWords.down, result.downTotal]].forEach(function (group) {
                var line = document.createElement('p');
                var names = (result[group[0]] || []).map(function (v) { return v.name; });
                line.textContent = group[1] + ' (' + group[2] + '): ' + (names.length ? names.join(', ') : votesWords.nobody);
                out.appendChild(line);
              });
            });
        });
      });
    })();
  </script>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 18px; }
  .sg-page { max-width: 1000px; }
  .sg-colors { display: flex; flex-direction: column; gap: 8px; }
  .sg-color-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .sg-list { padding: 18px 20px; margin-bottom: 20px; border: 1px solid var(--border); border-radius: 16px; background: var(--card); min-width: 0; animation: m-rise-in var(--m-slow) var(--m-out) backwards; }
  .sg-list h2 { font-size: 15px; margin: 0 0 12px; }
  .sg-items { display: flex; flex-direction: column; gap: 10px; }
  .sg-item { border: 1px solid var(--border-soft); border-left: 3px solid var(--st, var(--accent)); border-radius: 12px; padding: 12px 14px; background: var(--bg-raise); min-width: 0; }
  .sg-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 6px; }
  .sg-num { font-family: var(--mono); font-size: 12px; color: var(--text-dim); }
  .sg-pill { font-size: 11.5px; font-weight: 600; padding: 2px 10px; border-radius: 999px; color: var(--st); background: color-mix(in srgb, var(--st) 15%, transparent); }
  .sg-id, .sg-user { font-size: 11.5px; color: var(--text-dim); }
  .sg-text { margin: 0 0 10px; font-size: 14px; line-height: 1.5; overflow-wrap: anywhere; white-space: pre-wrap; }
  .sg-answer { display: flex; flex-direction: column; gap: 8px; }
  .sg-reason { border: 1px solid var(--border); border-radius: 10px; padding: 9px 12px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13px; line-height: 1.5; min-width: 0; max-width: 520px; width: 100%; box-sizing: border-box; resize: vertical; transition: border-color 0.25s ease, box-shadow 0.25s ease; }
  .sg-reason:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent); }
  .sg-buttons { display: flex; flex-wrap: wrap; gap: 6px; }
  .sg-b-ok { color: var(--green); }
  .sg-b-no { color: var(--red, #ff6b6b); }
  .sg-votes-btn { align-self: flex-start; display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-dim); background: none; border: 0; padding: 0; cursor: pointer; }
  .sg-votes-btn:hover { color: var(--text); }
  .sg-votes { font-size: 12.5px; color: var(--text-muted); border: 1px solid var(--border); border-radius: 10px; padding: 8px 10px; max-width: 520px; }
  .sg-votes:not([hidden]) { animation: m-pop-in var(--m-base) var(--m-out) both; }
  .sg-votes p { margin: 0 0 4px; overflow-wrap: anywhere; }
  .sg-msg { font-size: 12.5px; overflow-wrap: anywhere; }
  .sg-msg.ok { color: var(--green); }
  .sg-msg.bad { color: var(--red, #ff6b6b); }
  @media (max-width: 720px) { .sg-list { padding: 16px; } .sg-buttons .btn { flex: 1 1 auto; justify-content: center; } }
</style>
