---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';

import DashClientI18n from './DashClientI18n.astro';
import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  guilds: Array<{ id: string; name: string; icon: string | null; memberCount: number | null }>;
  error?: string;
  left?: boolean;
}

const { guilds, error, left = false } = Astro.props;
---

<Base title={dt('All servers · Petto')} active="dash" showFooter>
  <main>
    <section class="as-sec">
      <div class="wrap as-wrap">
        <div class="as-head">
          <div>
            <div class="eyebrow"><Icon name="ph:hard-drives-fill" width="14" height="14" /> {dt('Developer view')}</div>
            <h1>{dt('All servers')}</h1>
            <p>{dt('Every server Petto is in. Open one to see its dashboard exactly as the managers do, but read only. You can also remove Petto from a server.')}</p>
          </div>
          <div class="as-head-actions">
            <a class="btn btn-ghost btn-sm" href="/dash/admin"><Icon name="ph:gift-fill" width="14" height="14" /> {dt('Owner grants')}</a>
            <a class="btn btn-ghost btn-sm" href="/dash/manage"><Icon name="ph:arrow-left" width="14" height="14" /> {dt('Back to servers')}</a>
          </div>
        </div>

        {error === 'invalid' && <div class="as-alert error"><Icon name="ph:warning-fill" width="17" height="17" /> {dt('That request was not valid.')}</div>}
        {error === 'leave_failed' && <div class="as-alert error"><Icon name="ph:warning-fill" width="17" height="17" /> {dt('Discord did not let the bot leave that server.')}</div>}
        {error === 'discord_unavailable' && <div class="as-alert error"><Icon name="ph:warning-fill" width="17" height="17" /> {dt('Discord did not answer. Reload in a few seconds.')}</div>}
        {left && <div class="as-alert success"><Icon name="ph:check-circle-fill" width="17" height="17" /> {dt('Petto left the server.')}</div>}

        <div class="as-toolbar">
          <label class="as-search"><Icon name="ph:magnifying-glass" width="15" height="15" /><input id="as-filter" type="search" placeholder={dt('Search by name or ID')} autocomplete="off" /></label>
          <span class="as-count"><strong id="as-shown">{guilds.length}</strong> {dt('of {a} servers', { a: (guilds.length) })}</span>
        </div>

        {guilds.length === 0 ? <div class="as-empty">{dt('No servers found.')}</div> : <div class="as-list" id="as-list">
          {guilds.map((g) => (
            <article class="as-row" data-search={`${g.name} ${g.id}`.toLowerCase()}>
              {g.icon ? <img class="as-icon" src={g.icon} alt="" width="42" height="42" loading="lazy" /> : <div class="as-icon as-icon-fallback"><Icon name="ph:hard-drives-fill" width="18" height="18" /></div>}
              <div class="as-main">
                <strong>{g.name}</strong>
                <span>{g.memberCount !== null ? dt('{n} members',{n:g.memberCount.toLocaleString()}) : dt('Members unknown')}</span>
                <small>{g.id}</small>
              </div>
              <div class="as-actions">
                <a class="btn btn-ghost btn-sm" href={`/dash/guild/${g.id}/overview`}><Icon name="ph:eye-fill" width="14" height="14" /> {dt('View panel')}</a>
                <form method="POST" data-leave data-name={g.name}>
                  <input type="hidden" name="action" value="leave" />
                  <input type="hidden" name="guild_id" value={g.id} />
                  <button class="btn btn-danger btn-sm" type="submit"><Icon name="ph:sign-out-fill" width="14" height="14" /> {dt('Remove')}</button>
                </form>
              </div>
            </article>
          ))}
        </div>}
      </div>
    </section>
  </main>
</Base>

<DashClientI18n />
<script>
declare function cdt(key: string, vars?: Record<string, string | number>): string;
  const input = document.getElementById('as-filter') as HTMLInputElement | null;
  const shown = document.getElementById('as-shown');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.as-row'));
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let n = 0;
    for (const row of rows) {
      const match = !q || (row.dataset.search ?? '').includes(q);
      row.hidden = !match;
      if (match) n += 1;
    }
    if (shown) shown.textContent = String(n);
  });
  document.querySelectorAll<HTMLFormElement>('form[data-leave]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      if (!window.confirm(cdt('Remove Petto from {name}? The bot will leave the server.', { name: form.dataset.name ?? cdt('this server') }))) event.preventDefault();
    });
  });
</script>

<style>
  .as-sec { padding: 54px 0 96px; }
  .as-wrap { max-width: 1120px; }
  .as-head { display: flex; justify-content: space-between; align-items: end; gap: 25px; margin-bottom: 28px; }
  .as-head .eyebrow { display: flex; align-items: center; gap: 7px; color: var(--accent); }
  .as-head h1 { margin: 9px 0 10px; font-family: var(--serif); font-size: clamp(32px, 5vw, 54px); line-height: 1.04; }
  .as-head p { max-width: 680px; margin: 0; color: var(--text-muted); font-size: 15px; }
  .as-head-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .as-head .btn, .as-actions .btn { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .as-alert { display: flex; align-items: center; gap: 9px; padding: 13px 15px; border-radius: 12px; margin: 12px 0; font-size: 14px; }
  .as-alert.error { color: var(--red); background: var(--red-soft); border: 1px solid color-mix(in srgb, var(--red) 55%, var(--border)); }
  .as-alert.success { color: var(--green); background: var(--green-soft); border: 1px solid color-mix(in srgb, var(--green) 55%, var(--border)); }
  .as-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin: 18px 0 14px; }
  .as-search { display: flex; align-items: center; gap: 8px; flex: 1; max-width: 420px; padding: 0 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg-raise); color: var(--text-dim); }
  .as-search input { flex: 1; min-width: 0; padding: 11px 0; border: 0; outline: 0; background: transparent; color: var(--text); font: inherit; font-size: 13px; }
  .as-count { color: var(--text-dim); font-size: 12px; white-space: nowrap; }
  .as-empty { padding: 25px; border: 1px dashed var(--border); border-radius: 14px; color: var(--text-dim); text-align: center; font-size: 13px; }
  .as-list { display: grid; gap: 10px; }
  .as-row { display: flex; align-items: center; gap: 13px; padding: 12px 16px; border: 1px solid var(--border); border-radius: 13px; background: var(--card); min-width: 0; }
  .as-row[hidden] { display: none; }
  .as-icon { width: 42px; height: 42px; border-radius: 12px; object-fit: cover; flex: 0 0 auto; }
  .as-icon-fallback { display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); }
  .as-main { min-width: 0; flex: 1; }
  .as-main strong, .as-main span, .as-main small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .as-main strong { font-size: 14px; }
  .as-main span, .as-main small { margin-top: 3px; color: var(--text-dim); font-size: 11px; }
  .as-main small { font-family: var(--mono); }
  .as-actions { display: flex; gap: 8px; flex: 0 0 auto; }
  .as-actions form { margin: 0; }
  .btn-danger { color: var(--red); border-color: color-mix(in srgb, var(--red) 55%, var(--border)); }
  .btn-danger:hover { background: var(--red-soft); }
  @media (max-width: 760px) {
    .as-sec { padding: 28px 0 60px; }
    .as-head { align-items: flex-start; flex-direction: column; }
    .as-head-actions { width: 100%; }
    .as-head-actions .btn { flex: 1 1 100%; justify-content: center; }
    .as-toolbar { flex-direction: column; align-items: stretch; }
    .as-search { max-width: none; }
    .as-row { flex-wrap: wrap; align-items: flex-start; }
    .as-main { flex: 1 1 calc(100% - 55px); }
    .as-actions { flex: 1 1 100%; }
    .as-actions .btn, .as-actions form { flex: 1 1 0; width: 100%; justify-content: center; box-sizing: border-box; }
  }
</style>
