---
// A laptop drawn in CSS: a screen with a thin bezel, a camera dot and a base. It holds a picture (`src`) or whatever is put inside it (a simulated Discord window).
// What is put inside is drawn as a real screen would show it: at a smaller scale (`zoom`, by the width of the laptop) and cut to the shape of the screen, with a soft
// fade where it is cut. A picture can be opened bigger with a tap (`pop`).
interface Props { src?: string; alt?: string; width?: number; height?: number; class?: string; pop?: boolean }
const { src, alt = '', width = 1440, height = 900, class: className = '', pop = false } = Astro.props;
---
<div class:list={['lap', className]}>
  <div class="lap-screen">
    {src
      ? <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" data-pop={pop ? '' : undefined} />
      : <div class="lap-slot"><div class="lap-in"><slot /></div></div>}
  </div>
  <div class="lap-base" aria-hidden="true"></div>
</div>
<style>
  .lap { position: relative; width: 100%; container-type: inline-size; }
  .lap-screen { position: relative; border: 2px solid #3a3d44; border-radius: 18px 18px 4px 4px; background: #000; padding: 10px 10px 12px; box-shadow: 0 0 0 1px #000, 0 40px 90px -30px rgba(0, 0, 0, 0.7); }
  .lap-screen::after { content: ''; position: absolute; left: 50%; top: 3px; width: 5px; height: 5px; margin-left: -2.5px; border-radius: 50%; background: #20232a; }
  .lap-screen img { display: block; width: 100%; height: auto; border-radius: 7px; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; background: var(--bg); }
  .lap-slot { position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 7px; background: #313338; }
  .lap-slot::after { content: ''; position: absolute; inset: auto 0 0 0; height: 14%; pointer-events: none; background: linear-gradient(transparent, #313338); }
  .lap-in { zoom: 0.8; }
  .lap-base { position: relative; height: 14px; margin: 0 -3.5%; border-radius: 0 0 20px 20px; background: linear-gradient(#41444b, #1d1f24 72%, #121316); }
  .lap-base::before { content: ''; position: absolute; left: 50%; top: 0; width: 15%; height: 6px; margin-left: -7.5%; border-radius: 0 0 9px 9px; background: #0b0c0e; }
  @container (max-width: 640px) { .lap-in { zoom: 0.64; } }
  @container (max-width: 480px) { .lap-in { zoom: 0.52; } }
  @media (max-width: 560px) { .lap-screen { padding: 6px 6px 8px; border-radius: 12px 12px 3px 3px; } .lap-base { height: 9px; } .lap-base::before { height: 4px; } }
</style>
