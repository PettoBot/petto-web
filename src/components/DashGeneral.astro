---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  prefix: string;
  muteRoleId: string | null;
  globalStatsVisible?: boolean;
  roles: { id: string; name: string }[];
  saved: boolean;
  reset: boolean;
  section?: string;
}
const { user, guildId, guildName, guildIcon, prefix, muteRoleId, globalStatsVisible = true, roles, saved, reset, section } = Astro.props;
const sectionMeta: Record<string, string> = { settings: dt('Server settings'), management: dt('Configuration management') };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'settings';
const selectedTitle = sectionMeta[selectedSection];
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'settings' ? 'setup' : 'general-management'} pageTitle={selectedTitle}>
  <h1>{selectedTitle}</h1>
  <p class="dg-sub"><Fragment set:html={dth('The base settings every other system in <b>{a}</b> builds on.', { a: (guildName) })} /></p>

  {saved && (
    <div class="dg-success">
      <Icon name="ph:check-circle-fill" width="15" height="15" />
      {dt('Saved. Petto picks this up right away, no restart needed.')}
    </div>
  )}
  {reset && (
    <div class="dg-success">
      <Icon name="ph:check-circle-fill" width="15" height="15" />
      {dt('Reset. Prefix, mute role, and the bot\'s look in this server are back to default.')}
    </div>
  )}

  <div class:list={['dg-card', { 'dg-section-hidden': selectedSection !== 'settings' }]}>
    <h2><span class="dg-h2-icon" style="--c:var(--accent)"><Icon name="ph:gear-fill" width="14" height="14" /></span>{dt('Basic settings')}</h2>
    <p class="dg-card-desc">{dt('The base every other system in this server reads from.')}</p>

    <form method="POST" class="dg-form">
      <input type="hidden" name="action" value="save" />
      <div class="dg-field">
        <label for="prefix">{dt('Command prefix')}</label>
        <input id="prefix" type="text" name="prefix" value={prefix} maxlength="5" required />
        <p class="dg-hint"><Fragment set:html={dth('Used for text commands, e.g. <code>{a}ban</code>. Slash commands work no matter what this is set to.', { a: (prefix) })} /></p>
      </div>

      <div class="dg-field">
        <label for="mute_role_id">{dt('Mute role')}</label>
        <select id="mute_role_id" name="mute_role_id">
          <option value="">{dt('None, use Discord\'s native timeout')}</option>
          {roles.map((r) => (
            <option value={r.id} selected={r.id === muteRoleId}>{r.name}</option>
          ))}
        </select>
        <p class="dg-hint"><Fragment set:html={dth('The role <code>/mute</code> applies when set. Leave unset to use Discord\'s built-in timeout instead.')} /></p>
      </div>

      <div class="dg-field">
        <label class="dg-check" for="global_stats_visible">
          <input id="global_stats_visible" type="checkbox" name="global_stats_visible" checked={globalStatsVisible} />
          <span>{dt('Show this server in the public ranking')}</span>
        </label>
        <p class="dg-hint">{dt('The global stats page ranks servers by messages, voice time and reactions, and every server is in it by default. Turned off, this server is only counted in the totals, without its name.')}</p>
      </div>

      <button type="submit" class="btn btn-accent btn-sm">{dt('Save changes')}</button>
    </form>
  </div>

  <div class:list={['dg-card', { 'dg-section-hidden': selectedSection !== 'management' }]}>
    <h2><span class="dg-h2-icon" style="--c:#a5ea7a"><Icon name="ph:file-code-fill" width="14" height="14" /></span>{dt('Configuration management')}</h2>
    <p class="dg-card-desc">{dt('Back up or reset what\'s on this page and Petto\'s look in this server.')}</p>

    <div class="dg-manage-row">
      <a href={`/dash/guild/${guildId}/general-export`} class="btn btn-ghost btn-sm">
        <Icon name="ph:download-simple-bold" width="14" height="14" />
        {dt('Download config')}
      </a>
      <form method="POST" class="dg-reset-form">
        <input type="hidden" name="action" value="reset" />
        <button type="submit" class="btn btn-danger btn-sm" data-confirm={dt("Reset the prefix, mute role, and the bot's nickname/avatar/banner/description in this server back to default? This can't be undone.")}>
          <Icon name="ph:arrow-counter-clockwise-bold" width="14" height="14" />
          {dt('Reset config')}
        </button>
      </form>
    </div>

    <div class="dg-code-label">
      <Icon name="ph:file-code-bold" width="12" height="12" />
      {dt('Current configuration (YAML)')}
    </div>
    <pre class="dg-code" data-config-preview={`/dash/guild/${guildId}/general-config-preview`}><code>Loading...</code></pre>
    <p class="dg-code-note">{dt('Read-only, a snapshot of what\'s saved. Change it from the fields above, not by editing this.')}</p>
  </div>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  .dg-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 24px; }
  .dg-sub :global(b){ color: var(--text); }

  .dg-success { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 20px; max-width: fit-content; }

  .dg-card { border: 1px solid var(--border); border-radius: 14px; padding: 20px; background: var(--card); }
  .dg-section-hidden { display: none; }
  .dg-card + .dg-card { margin-top: 14px; }
  .dg-card h2 { font-size: 15px; margin: 0 0 4px; display: flex; align-items: center; gap: 9px; }
  .dg-h2-icon { width: 26px; height: 26px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: color-mix(in srgb, var(--c) 16%, transparent); color: var(--c); }
  .dg-card-desc { font-size: 12.5px; color: var(--text-dim); margin: 0 0 18px; }

  .dg-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 22px 32px; align-items: start; }
  .dg-form > .btn { grid-column: 1 / -1; justify-self: start; }
  .dg-field { display: flex; flex-direction: column; gap: 8px; width: 100%; max-width: 560px; }
  .dg-field label { font-size: 13.5px; font-weight: 600; color: var(--text); }
  .dg-field input, .dg-field select { border: 1px solid var(--border); border-radius: 9px; padding: 10px 12px; background: var(--bg-raise); color: var(--text); font-family: var(--sans); font-size: 14px; }
  .dg-field label.dg-check { display: flex; align-items: center; gap: 10px; cursor: pointer; }
  .dg-field .dg-check input { width: 18px; height: 18px; padding: 0; accent-color: var(--accent); }
  .dg-field input:focus, .dg-field select:focus { outline: 2px solid var(--accent-soft); border-color: var(--accent); }
  .dg-hint { font-size: 12px; color: var(--text-dim); line-height: 1.5; margin: 0; }
  .dg-hint :global(code){ font-family: var(--mono); color: var(--accent); }

  .dg-manage-row { display: flex; gap: 10px; margin-bottom: 18px; }
  .dg-manage-row .btn { display: inline-flex; align-items: center; gap: 6px; }
  .btn-sm { padding: 8px 16px; font-size: 13px; }
  .btn-danger { background: var(--red-soft); color: var(--red); border: 1px solid var(--red); }
  .btn-danger:hover { background: var(--red); color: var(--accent-ink); }

  .dg-code-label { display: flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 8px; padding-top: 16px; border-top: 1px solid var(--border-soft); }
  .dg-code { background: var(--bg-raise); border: 1px solid var(--border-soft); border-radius: 10px; padding: 14px 16px; overflow-x: auto; margin: 0; max-height: 260px; overflow-y: auto; }
  .dg-code :global(code){ font-family: var(--mono); font-size: 12px; line-height: 1.6; color: var(--accent); white-space: pre; }
  .dg-code-note { font-size: 11.5px; color: var(--text-dim); margin: 8px 0 0; }
</style>