---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashConfigManagement from './DashConfigManagement.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import Modal from './Modal.astro';
import { MAX_PREFIXES, MAX_PREFIX_LENGTH } from '../utils/guildPrefixes';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  prefix: string;
  prefixes?: string[];
  prefixError?: string;
  muteRoleId: string | null;
  globalStatsVisible?: boolean;
  language?: string;
  roles: { id: string; name: string }[];
  saved: boolean;
  reset: boolean;
  section?: string;
}
const { user, guildId, guildName, guildIcon, prefix, prefixes = [prefix], prefixError = '', muteRoleId, globalStatsVisible = true, language = 'en', roles, saved, reset, section } = Astro.props;
const sectionMeta: Record<string, string> = { settings: dt('Server settings'), management: dt('Configuration management') };
const selectedSection = sectionMeta[section ?? ''] ? section ?? '' : 'settings';
const selectedTitle = sectionMeta[selectedSection];
const languages = [
  { value: 'en', label: 'English', short: 'English' },
  { value: 'es', label: 'Español', short: 'Español' },
  { value: 'pt-BR', label: 'Português (Brasil)', short: 'Português' },
];
const currentLanguage = languages.find((item) => item.value === language) ?? languages[0];
// The commands a member can type with the main prefix. A word needs a space after it, a symbol is typed attached (the same rule the window of prefixes explains).
const spaced = /^[a-z0-9]/i.test(prefix);
const examples = ['ban', 'mute', 'language'].map((command) => `${prefix}${spaced ? ' ' : ''}${command}`);
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={selectedSection === 'settings' ? 'setup' : 'general-management'} pageTitle={selectedTitle}>
  {/* Both parts of this page use the kits: the Configuration management part has none of its own. */}
  <DashSettingsKit />
  <DashFormKit />
  <div class="sx-page gn-page">
  <h1>{selectedTitle}</h1>

  {saved && (
    <div class="sx-flash">
      <Icon name="ph:check-circle-fill" width="15" height="15" />
      {dt('Saved. Petto picks this up right away, no restart needed.')}
    </div>
  )}
  {prefixError && (
    <div class="sx-flash sx-flash-bad" role="alert">
      <Icon name="ph:warning-fill" width="15" height="15" />
      {prefixError}
    </div>
  )}
  {reset && (
    <div class="sx-flash">
      <Icon name="ph:check-circle-fill" width="15" height="15" />
      {dt('Reset. Prefix, mute role, and the bot\'s look in this server are back to default.')}
    </div>
  )}

  {selectedSection === 'management' ? <DashConfigManagement guildId={guildId} /> : (
    <Fragment>
      <DashStatTiles tiles={[
        { label: dt('Prefixes'), value: prefixes.length, tone: 'messages' },
        { label: dt('Language'), value: 0, text: currentLanguage.short, tone: 'voice' },
        { label: dt('Mute with'), value: 0, text: muteRoleId ? dt('A role') : dt('Timeout'), tone: 'reactions' },
        { label: dt('Public ranking'), value: 0, text: globalStatsVisible ? dt('Visible') : dt('Hidden'), tone: 'joins' },
      ]} />

      <form method="POST" class="sx-stack gn-form">
        <input type="hidden" name="action" value="save" />

        <section class="sx-panel gn-panel">
          <div class="sx-panel-head">
            <span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:terminal-window-fill" width="17" height="17" /></span>
            <h2>{dt('Command Prefixes')}</h2>
          </div>
          <p class="sx-lead"><Fragment set:html={dth('Used for text commands, e.g. <code>{a}ban</code>. Slash commands work no matter what this is set to.', { a: (prefix) })} /></p>
          <div class="gn-prefix-grid">
            <div class="gn-prefix-list">
              <span class="sx-label">{dt('Petto answers to')}</span>
              <div class="gn-prefix-row">
                <div class="pf-view">
                  {prefixes.map((p, i) => <code class:list={['pf-view-chip', { main: i === 0 }]} title={i === 0 ? dt('Main prefix') : undefined}>{p}</code>)}
                </div>
                <button type="button" class="btn btn-ghost btn-sm gn-manage" data-modal-open="pf-modal" data-pf-open><Icon name="ph:pencil-simple-fill" width="13" height="13" /> {dt('Manage prefixes')}</button>
              </div>
              <span class="sx-hint">{dt('The first one is the main one, the one shown in its messages.')}</span>
            </div>
            <div class="gn-try">
              <span class="sx-label">{dt('Try it in a channel')}</span>
              <div class="gn-try-list">
                {examples.map((example) => <code>{example}</code>)}
              </div>
            </div>
          </div>
        </section>

        <div class="gn-duo">
          <section class="sx-panel gn-panel">
            <div class="sx-panel-head">
              <span class="sx-panel-icon" style="--c:var(--blue)"><Icon name="ph:translate-fill" width="17" height="17" /></span>
              <h2 id="gn-lang-h">{dt('Server language')}</h2>
            </div>
            <p class="sx-lead"><Fragment set:html={dth('The language of Petto\'s messages in this server. Members can also use <code>{a}language</code>. Help us translate: <a href="/apply?role=translator">apply as a translator</a>.', { a: (prefix) })} /></p>
            <div class="dfx-chips" role="radiogroup" aria-labelledby="gn-lang-h">
              {languages.map((item) => <label class="dfx-chip"><input type="radio" name="language" value={item.value} checked={language === item.value} />{item.label}</label>)}
            </div>
          </section>

          <section class="sx-panel gn-panel">
            <div class="sx-panel-head">
              <span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:speaker-slash-fill" width="17" height="17" /></span>
              <h2 id="gn-mute-h">{dt('Mute role')}</h2>
            </div>
            <p class="sx-lead"><Fragment set:html={dth('The role <code>{p}mute</code> applies when set. Leave unset to use Discord\'s built-in timeout instead.', { p: prefix })} /></p>
            <div class="sx-field">
              <select id="mute_role_id" name="mute_role_id" data-give-role aria-labelledby="gn-mute-h">
                <option value="">{dt('None, use Discord\'s native timeout')}</option>
                {roles.map((r) => (
                  <option value={r.id} selected={r.id === muteRoleId}>{r.name}</option>
                ))}
              </select>
            </div>
          </section>
        </div>

        <section class="sx-panel gn-panel">
          <div class="sx-panel-head">
            <span class="sx-panel-icon" style="--c:var(--green)"><Icon name="ph:trophy-fill" width="17" height="17" /></span>
            <h2>{dt('Public ranking')}</h2>
          </div>
          <label class="sx-switch">
            <input id="global_stats_visible" type="checkbox" name="global_stats_visible" checked={globalStatsVisible} />
            <span class="sx-switch-text"><b>{dt('Show this server in the public ranking')}</b><em>{dt('Turned off, this server is only counted in the global totals, without its name.')}</em></span>
            <i class="sx-toggle"></i>
          </label>
        </section>

        <div class="sx-foot gn-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:check-bold" width="13" height="13" />{dt('Save changes')}</button></div>
      </form>

      <section class="gn-more" aria-labelledby="gn-more-h">
        <div class="dfx-sec-head"><h2 id="gn-more-h">{dt('More settings of the server')}</h2><p>{dt('Petto\'s look, a copy of these settings and the backups of the server.')}</p></div>
        <div class="gn-links">
          <a class="gn-link" href={`/dash/guild/${guildId}/customize`}>
            <span class="sx-panel-icon" style="--c:var(--red)"><Icon name="ph:paint-brush-broad-fill" width="17" height="17" /></span>
            <span class="gn-link-text"><b>{dt('Customize')}</b><em>{dt('Petto\'s nickname, picture and banner in this server.')}</em></span>
          </a>
          <a class="gn-link" href={`/dash/guild/${guildId}/general?section=management`}>
            <span class="sx-panel-icon" style="--c:var(--green)"><Icon name="ph:file-code-fill" width="17" height="17" /></span>
            <span class="gn-link-text"><b>{dt('Configuration management')}</b><em>{dt('Download a copy of these settings, or reset them.')}</em></span>
          </a>
          <a class="gn-link" href={`/dash/guild/${guildId}/backups`}>
            <span class="sx-panel-icon" style="--c:var(--blue)"><Icon name="ph:archive-fill" width="17" height="17" /></span>
            <span class="gn-link-text"><b>{dt('Backups')}</b><em>{dt('Bring back the roles, channels and emojis of the server.')}</em></span>
          </a>
        </div>
      </section>
    </Fragment>
  )}
  </div>

  <Modal id="pf-modal" title={dt('Manage Command Prefixes')} icon="ph:terminal-window-fill">
    <form method="POST" class="pf-form" data-no-dirty data-pf-form
      data-saved={JSON.stringify(prefixes)} data-max={MAX_PREFIXES} data-len={MAX_PREFIX_LENGTH}
      data-e-empty={dt('Write a prefix first.')} data-e-long={dt('A prefix has at most {n} characters.', { n: MAX_PREFIX_LENGTH })}
      data-e-space={dt('A prefix cannot have spaces.')} data-e-chars={dt('A prefix cannot have @ or backticks.')}
      data-e-dup={dt('{p} is already in the list.')} data-e-max={dt('A server can have up to {n} prefixes.', { n: MAX_PREFIXES })}
      data-e-none={dt('Keep at least one prefix.')} data-l-remove={dt('Remove {p}')} data-l-main={dt('Main prefix')}>
      <input type="hidden" name="action" value="prefixes" />
      <input type="hidden" name="prefixes" value={JSON.stringify(prefixes)} data-pf-value />
      <p class="pf-lede">{dt('Petto answers to every prefix in this list. The first one is the main one, the one shown in its messages.')}</p>
      <div class="pf-add">
        <input type="text" class="pf-input" data-pf-input maxlength="40" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder={dt('Add a prefix')} aria-label={dt('Add a prefix')} />
        <button type="button" class="btn btn-accent btn-sm pf-plus" data-pf-add aria-label={dt('Add prefix')} title={dt('Add prefix')}><Icon name="ph:plus-bold" width="16" height="16" /></button>
      </div>
      <p class="pf-error" role="alert" data-pf-error hidden></p>
      <div class="pf-chips" data-pf-chips aria-live="polite">
        {prefixes.map((p, i) => (
          <span class:list={['pf-chip', { main: i === 0 }]} data-p={p}><code>{p}</code><button type="button" class="pf-x" data-pf-remove aria-label={dt('Remove {p}', { p })}>×</button></span>
        ))}
      </div>
      <p class="pf-hint">{dt('A symbol is typed attached to the command (!help). A word like petto is not case sensitive and needs a space (petto help). Up to {n} prefixes of {m} characters, no spaces, no @ or backticks.', { n: MAX_PREFIXES, m: MAX_PREFIX_LENGTH })}</p>
      <footer><button type="button" class="btn btn-ghost btn-sm" data-modal-close>{dt('Cancel')}</button><button type="submit" class="btn btn-accent btn-sm" data-keep>{dt('Save')}</button></footer>
    </form>
  </Modal>

  <script is:inline>
    // The Manage prefixes window: bound once to the document, so it keeps working after the page content is swapped.
    if (!window.__pfBound) {
      window.__pfBound = true;
      var pfScope = function (el) { return el && el.closest ? el.closest('[data-pf-form]') : null; };
      var pfList = function (form) {
        return Array.prototype.map.call(form.querySelectorAll('[data-pf-chips] .pf-chip'), function (c) { return c.getAttribute('data-p'); });
      };
      var pfError = function (form, text) {
        var box = form.querySelector('[data-pf-error]');
        if (!box) return;
        box.textContent = text || '';
        box.hidden = !text;
      };
      var pfRender = function (form, list) {
        var holder = form.querySelector('[data-pf-chips]');
        holder.textContent = '';
        list.forEach(function (p, i) {
          var chip = document.createElement('span');
          chip.className = 'pf-chip' + (i === 0 ? ' main' : '');
          chip.setAttribute('data-p', p);
          if (i === 0) chip.title = form.getAttribute('data-l-main') || '';
          var code = document.createElement('code');
          code.textContent = p;
          var x = document.createElement('button');
          x.type = 'button';
          x.className = 'pf-x';
          x.setAttribute('data-pf-remove', '');
          x.setAttribute('aria-label', (form.getAttribute('data-l-remove') || 'Remove {p}').replace('{p}', p));
          x.textContent = '\u00d7';
          chip.appendChild(code);
          chip.appendChild(x);
          holder.appendChild(chip);
        });
        form.querySelector('[data-pf-value]').value = JSON.stringify(list);
      };
      var pfAdd = function (form) {
        var input = form.querySelector('[data-pf-input]');
        var value = (input.value || '').trim();
        var list = pfList(form);
        var max = Number(form.getAttribute('data-max')) || 10;
        var len = Number(form.getAttribute('data-len')) || 12;
        var problem = '';
        if (!value) problem = form.getAttribute('data-e-empty');
        else if (value.length > len) problem = form.getAttribute('data-e-long');
        else if (/\s/.test(value)) problem = form.getAttribute('data-e-space');
        else if (value.indexOf('@') !== -1 || value.indexOf('`') !== -1) problem = form.getAttribute('data-e-chars');
        else if (list.some(function (p) { return p.toLowerCase() === value.toLowerCase(); })) problem = (form.getAttribute('data-e-dup') || '').replace('{p}', value);
        else if (list.length >= max) problem = form.getAttribute('data-e-max');
        pfError(form, problem);
        if (problem) { input.focus(); return; }
        list.push(value);
        pfRender(form, list);
        input.value = '';
        input.focus();
      };
      document.addEventListener('click', function (event) {
        var t = event.target;
        if (!t || !t.closest) return;
        var opener = t.closest('[data-pf-open]');
        if (opener) {
          // Opening again starts from what is saved: a window closed with Cancel leaves nothing behind.
          document.querySelectorAll('[data-pf-form]').forEach(function (form) {
            try { pfRender(form, JSON.parse(form.getAttribute('data-saved') || '[]')); } catch (e) {}
            pfError(form, '');
            var input = form.querySelector('[data-pf-input]');
            if (input) input.value = '';
          });
          return;
        }
        var add = t.closest('[data-pf-add]');
        if (add) { var f = pfScope(add); if (f) pfAdd(f); return; }
        var rm = t.closest('[data-pf-remove]');
        if (rm) {
          var form = pfScope(rm);
          if (!form) return;
          var chip = rm.closest('.pf-chip');
          var list = pfList(form).filter(function (p) { return p !== chip.getAttribute('data-p'); });
          pfError(form, '');
          pfRender(form, list);
        }
      });
      document.addEventListener('keydown', function (event) {
        var t = event.target;
        if (event.key !== 'Enter' || !t || !t.hasAttribute || !t.hasAttribute('data-pf-input')) return;
        event.preventDefault();
        var form = pfScope(t);
        if (form) pfAdd(form);
      });
      // Capture phase, before the dashboard's own saving: a list that is not valid is never sent.
      document.addEventListener('submit', function (event) {
        var form = event.target;
        if (!form || !form.hasAttribute || !form.hasAttribute('data-pf-form')) return;
        var list = pfList(form);
        var max = Number(form.getAttribute('data-max')) || 10;
        var problem = !list.length ? form.getAttribute('data-e-none') : list.length > max ? form.getAttribute('data-e-max') : '';
        if (problem) {
          event.preventDefault();
          event.stopImmediatePropagation();
          pfError(form, problem);
          return;
        }
        form.querySelector('[data-pf-value]').value = JSON.stringify(list);
        // The window closes now; the page shows the answer when the save is done.
        var win = form.closest('.mdl');
        if (win) { win.hidden = true; document.body.classList.remove('mdl-lock'); }
      }, true);
    }
  </script>

</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 18px; }
  /* The columns follow the width of the page itself (the menu takes a third of the window), not the window. */
  .gn-page { container: gn / inline-size; }
  .gn-form { margin-bottom: 8px; }
  .gn-panel { padding: 18px; }
  .gn-duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; align-items: start; }
  .gn-duo > .gn-panel { animation: m-rise-in var(--m-slow) var(--m-out) backwards; }
  .gn-duo > .gn-panel:nth-child(2) { animation-delay: var(--m-stagger); }
  .sx-lead :global(code), .sx-hint :global(code) { font-family: var(--mono); color: var(--accent); }
  .sx-lead :global(a) { color: var(--accent); }
  .btn-sm { padding: 8px 16px; font-size: 13px; }
  .gn-manage { display: inline-flex; align-items: center; gap: 6px; flex: none; }
  .gn-prefix-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; }
  .gn-prefix-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 14px 22px; align-items: start; }
  .gn-prefix-list, .gn-try { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .sx-label { font-size: 13px; font-weight: 600; }
  .pf-view { display: flex; flex-wrap: wrap; gap: 8px; }
  .pf-view-chip { font-family: var(--mono); font-size: 15px; padding: 6px 14px; border-radius: 10px; border: 1px solid var(--border); background: color-mix(in srgb, var(--text) 3%, var(--card)); color: var(--text); overflow-wrap: anywhere; }
  .pf-view-chip.main { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
  .gn-try-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .gn-try-list code { font-family: var(--mono); font-size: 13px; padding: 6px 12px; border-radius: 10px; background: var(--bg-raise); border: 1px solid var(--border-soft); color: var(--text-muted); overflow-wrap: anywhere; }
  .gn-more { display: flex; flex-direction: column; gap: 12px; padding: 22px 0 0; }
  .gn-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .gn-link { display: flex; align-items: center; gap: 12px; min-width: 0; padding: 14px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); color: var(--text); text-decoration: none; transition: background-color .3s ease, border-color .3s ease; }
  .gn-link:hover { background: var(--card-hover); border-color: color-mix(in srgb, var(--text) 24%, var(--border)); }
  .gn-link:active { background: color-mix(in srgb, var(--text) 10%, transparent); transform: none; filter: none; }
  .gn-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .gn-link-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .gn-link-text b { font-size: 13.5px; font-weight: 600; }
  .gn-link-text em { font-style: normal; font-size: 12px; line-height: 1.4; color: var(--text-dim); }
  .gn-foot { justify-content: flex-start; }
  .gn-foot .btn { display: inline-flex; align-items: center; gap: 7px; }
  @container gn (max-width: 639px) { .gn-duo, .gn-links { grid-template-columns: minmax(0, 1fr); } }
  @container gn (max-width: 559px) { .gn-prefix-grid { grid-template-columns: minmax(0, 1fr); } .gn-panel { padding: 15px; } }
  @media (prefers-reduced-motion: reduce) { .gn-duo > .gn-panel { animation: none; } }
</style>

<style is:global>
  .pf-form { display: grid; gap: 14px; }
  .pf-lede, .pf-hint { margin: 0; font-size: 13px; color: var(--text-dim); line-height: 1.5; }
  .pf-hint { font-size: 12px; }
  .pf-add { display: flex; gap: 8px; align-items: stretch; }
  .pf-input { flex: 1; min-width: 0; border: 1px solid var(--border); border-radius: 9px; padding: 10px 12px; background: var(--bg-raise); color: var(--text); font-family: var(--mono); font-size: 14px; }
  .pf-input:focus { outline: 2px solid var(--accent-soft); border-color: var(--accent); }
  .pf-plus { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; padding: 0 12px; }
  .pf-error { margin: 0; font-size: 12.5px; color: var(--red); background: var(--red-soft); border: 1px solid var(--red); border-radius: 8px; padding: 8px 10px; }
  .pf-error[hidden] { display: none; }
  .pf-chips { display: flex; flex-wrap: wrap; gap: 8px; min-height: 36px; }
  .pf-chip { display: inline-flex; align-items: center; gap: 4px; max-width: 100%; padding: 4px 4px 4px 10px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg-raise); color: var(--text); }
  .pf-chip.main { border-color: var(--accent); }
  .pf-chip code { font-family: var(--mono); font-size: 13px; overflow-wrap: anywhere; }
  .pf-x { width: 24px; height: 24px; border-radius: 50%; border: 0; background: none; color: var(--text-dim); font-size: 16px; line-height: 1; cursor: pointer; display: grid; place-items: center; }
  .pf-x:hover { background: var(--red-soft); color: var(--red); }
  .pf-form footer { display: flex; justify-content: flex-end; gap: 8px; padding-top: 4px; }
  @media (max-width: 560px) { .pf-form footer .btn { flex: 1; } }
</style>
