---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { useTranslations, localePath, type Locale } from '../i18n/ui';
import { changelogEntries, changelogFeedUrl } from '../utils/changelogFeed';

interface Props {
  lang: Locale;
  /** Show a single version, with its own address, so it can be shared. */
  version?: string;
}
const { lang, version } = Astro.props;
const t = useTranslations(lang);
const c = t.changelogPage;
const base = localePath[lang];
// Newest first by version number (a patch such as 0.7.9-1 comes before the 0.7.9 it patches).
const entries = changelogEntries(lang).map((entry, index) => ({ entry, index })).filter(({ entry }) => !version || entry.version === version);
const single = version ? entries[0]?.entry : null;
const pageTitle = single ? `v${single.display ?? single.version}${single.name ? ` ${single.name}` : ''} · ${c.eyebrow} · Petto` : `${c.eyebrow} · Petto`;
const pageDescription = single ? single.items[0].replace(/`/g, '').replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').slice(0, 200) : undefined;

type InlinePart = { kind: 'code' | 'link' | 'text'; text: string; href?: string };

function parseInline(text: string): InlinePart[] {
  return text.split(/(`[^`]+`|\[[^\]]+\]\(https?:\/\/[^)\s]+\))/g).filter(Boolean).map((part) => {
    if (part.startsWith('`') && part.endsWith('`')) return { kind: 'code', text: part.slice(1, -1) };
    const link = /^\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)$/.exec(part);
    if (link) return { kind: 'link', text: link[1], href: link[2] };
    return { kind: 'text', text: part };
  });
}
---
<Base title={pageTitle} description={pageDescription} lang={lang} feed={{ title: c.rssTitle, href: changelogFeedUrl(lang) }}>
  <main>
    <section class="cl-sec" data-locale={lang}>
      <div class="wrap cl-wrap">
        {single ? (
          <a class="cl-back" href={`${base}/changelog`}>← {c.allVersions}</a>
        ) : (
          <>
            <div class="eyebrow">{c.eyebrow}</div>
            <h1>{c.title}</h1>
            <p class="cl-lede">{c.lede}</p>
            <a class="cl-rss" href={`${base}/changelog/rss.xml`} type="application/rss+xml" title={changelogFeedUrl(lang)}>
              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><circle cx="6" cy="18" r="2.2" fill="currentColor" /><path d="M4 10.5a9.5 9.5 0 0 1 9.5 9.5M4 4a16 16 0 0 1 16 16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></svg>
              {c.rssLabel}<span class="cl-rss-url">{changelogFeedUrl(lang).replace(/^https:\/\//, '')}</span>
            </a>
          </>
        )}

        {entries.map(({ entry, index: i }) => (
          <div class="win cl-win reveal">
            <div class="win-bar">
              <span class="chip" style="background:var(--red)"></span>
              <span class="chip" style="background:var(--yellow)"></span>
              <span class="chip" style="background:var(--green)"></span>
              <span class="win-chan">#changelog</span>
            </div>
            <div class="win-body">
              <div class="wmsg">
                <div class="wav bot"><img src="/assets/mascot-icon.webp" alt="" /></div>
                <div class="cl-body">
                  <div class="wmeta">
                    <b>Petto</b>
                    {i === 0 && <span class="wtag">{c.latest}</span>}
                    <span class="cl-date" data-date={entry.date}>{entry.date}</span>
                  </div>
                  <div class="cl-version">
                    {single ? <h1>v{entry.display ?? entry.version}{entry.name && <span class="cl-name"> “{entry.name}”</span>}</h1> : <a href={`${base}/changelog/${entry.version}`}>v{entry.display ?? entry.version}{entry.name && <span class="cl-name"> “{entry.name}”</span>}</a>}
                    <button type="button" class="cl-copy" data-path={`${base}/changelog/${entry.version}`} data-done={c.linkCopied} title={c.copyLink} aria-label={c.copyLink}>{c.copyLink}</button>
                  </div>
                  {(entry.notices ?? []).map((notice) => (
                    <div class={`cl-notice cl-notice-${notice.kind}`} role="note">
                      <div class="cl-notice-head">
                        <Icon name={notice.kind === 'security' ? 'ph:shield-warning-fill' : notice.kind === 'info' ? 'ph:info-fill' : 'ph:warning-fill'} width="17" height="17" />
                        <b>{notice.title}</b>
                      </div>
                      {notice.text.split(/\n{2,}/).map((paragraph) => (
                        <p>{parseInline(paragraph).map((p) => (p.kind === 'code' ? <code>{p.text}</code> : p.kind === 'link' ? <a href={p.href} target="_blank" rel="noreferrer">{p.text}</a> : p.text))}</p>
                      ))}
                    </div>
                  ))}
                  <ul class="cl-list">
                    {entry.items.map((item) => (
                      <li>{parseInline(item).map((p) => (p.kind === 'code' ? <code>{p.text}</code> : p.kind === 'link' ? <a href={p.href} target="_blank" rel="noreferrer">{p.text}</a> : p.text))}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</Base>

<script>
  const monthNumbers: Record<string, number> = {
    january: 0, february: 1, march: 2, april: 3, may: 4, june: 5, july: 6, august: 7, september: 8, october: 9, november: 10, december: 11,
    enero: 0, febrero: 1, marzo: 2, abril: 3, mayo: 4, junio: 5, julio: 6, agosto: 7, septiembre: 8, octubre: 9, noviembre: 10, diciembre: 11,
    janeiro: 0, fevereiro: 1, março: 2, maio: 4, junho: 5, julho: 6, setembro: 8, outubro: 9, novembro: 10, dezembro: 11,
  };

  function parseChangelogDate(dateStr: string) {
    const english = /^([a-z]+)\s+(\d{1,2}),\s+(\d{4})$/i.exec(dateStr.trim());
    const localized = /^(\d{1,2})\s+de\s+([a-zà-ÿ]+)\s+de\s+(\d{4})$/i.exec(dateStr.trim());
    const month = english ? monthNumbers[english[1].toLowerCase()] : localized ? monthNumbers[localized[2].toLowerCase()] : undefined;
    const day = english ? Number(english[2]) : localized ? Number(localized[1]) : NaN;
    const year = english ? Number(english[3]) : localized ? Number(localized[3]) : NaN;
    return month === undefined || Number.isNaN(day) || Number.isNaN(year) ? null : new Date(Date.UTC(year, month, day));
  }

  function timeAgo(dateStr: string, locale: string) {
    const d = parseChangelogDate(dateStr);
    if (!d || isNaN(d.getTime())) return null;
    const diffMs = Date.now() - d.getTime();
    const days = Math.floor(diffMs / 86400000);
    if (days < 0) return null;
    if (locale === 'es') {
      if (days === 0) return 'hoy';
      if (days === 1) return 'hace 1 día';
      if (days < 30) return `hace ${days} días`;
      const months = Math.floor(days / 30);
      return months === 1 ? 'hace 1 mes' : `hace ${months} meses`;
    }
    if (locale === 'pt-BR') {
      if (days === 0) return 'hoje';
      if (days === 1) return 'há 1 dia';
      if (days < 30) return `há ${days} dias`;
      const months = Math.floor(days / 30);
      return months === 1 ? 'há 1 mês' : `há ${months} meses`;
    }
    if (days === 0) return 'today';
    if (days === 1) return '1 day ago';
    if (days < 30) return `${days} days ago`;
    const months = Math.floor(days / 30);
    return months === 1 ? '1 month ago' : `${months} months ago`;
  }
  document.querySelectorAll<HTMLButtonElement>('.cl-copy').forEach((button) => {
    const label = button.textContent ?? '';
    button.addEventListener('click', async () => {
      const url = new URL(button.dataset.path ?? '', location.origin).href;
      try { await navigator.clipboard.writeText(url); } catch { return; }
      button.textContent = button.dataset.done ?? label;
      setTimeout(() => { button.textContent = label; }, 1800);
    });
  });
  const locale = document.querySelector<HTMLElement>('.cl-sec')?.dataset.locale ?? 'en';
  document.querySelectorAll('.cl-date').forEach((el) => {
    const raw = (el as HTMLElement).dataset.date;
    if (!raw) return;
    const rel = timeAgo(raw, locale);
    if (rel) el.textContent = `${rel} · ${raw}`;
  });
</script>

<style>
  .win { background: var(--card); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; box-shadow: 0 24px 48px -28px rgba(0,0,0,0.4); }
  .win-bar { display: flex; align-items: center; gap: 8px; padding: 12px 15px; border-bottom: 1px solid var(--border-soft); }
  .win-bar .chip { width: 9px; height: 9px; border-radius: 50%; }
  .win-chan { margin-left: 6px; font-family: var(--mono); font-size: 12px; color: var(--text-dim); }
  .win-body { padding: 20px; }
  .wmsg { display: flex; gap: 13px; }
  .wav { width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0; overflow: hidden; }
  .wav.bot img { width: 100%; height: 100%; object-fit: cover; }
  .wmeta b { font-weight: 600; font-size: 13.5px; }
  .wtag { font-family: var(--mono); font-size: 9.5px; background: var(--accent); color: var(--accent-ink); padding: 1px 5px; border-radius: 4px; }

  .cl-sec { padding: 64px 0 110px; }
  .cl-wrap { max-width: 700px; }
  .cl-sec h1 { font-size: 32px; margin: 14px 0 12px; }
  .cl-lede { color: var(--text-muted); font-size: 15.5px; line-height: 1.65; max-width: 58ch; margin-bottom: 40px; }

  .cl-win { margin-bottom: 22px; }
  .cl-win .win-bar .chip { width: 10px; height: 10px; }
  .cl-body { flex: 1; min-width: 0; }
  .cl-body :global(.wmeta) { display: flex; align-items: center; gap: 8px; font-size: 13px; margin-bottom: 10px; }
  .cl-date { color: var(--text-dim); font-size: 12px; }
  .cl-version { display: flex; align-items: baseline; gap: 12px; font-family: var(--serif); font-size: 19px; font-weight: 600; margin-bottom: 14px; }
  .cl-name { font-weight: 400; color: var(--text-muted); font-size: 0.8em; }
  .cl-version :global(a) { color: inherit; text-decoration: none; }
  .cl-version :global(a:hover) { color: var(--accent); }
  .cl-version :global(h1) { font-size: 26px; margin: 0; }
  .cl-copy { margin-left: auto; border: 1px solid var(--border); background: transparent; color: var(--text-dim); font-family: var(--sans); font-size: 11.5px; font-weight: 500; padding: 3px 9px; border-radius: 7px; cursor: pointer; }
  .cl-copy:hover { color: var(--text); border-color: var(--text-dim); }
  .cl-rss { display: inline-flex; align-items: center; gap: 7px; flex-wrap: wrap; margin: -24px 0 36px; font-size: 12.5px; font-weight: 500; color: var(--text-dim); text-decoration: none; border: 1px solid var(--border); border-radius: 8px; padding: 5px 10px; max-width: 100%; }
  .cl-rss svg { color: #f99b1d; flex-shrink: 0; }
  .cl-rss-url { font-family: var(--mono); font-size: 11.5px; color: var(--text-dim); overflow-wrap: anywhere; }
  .cl-rss:hover { color: var(--text); border-color: var(--text-dim); }
  .cl-back { display: inline-block; font-size: 13px; color: var(--text-dim); text-decoration: none; margin-bottom: 18px; }
  .cl-back:hover { color: var(--accent); }
  .cl-notice { margin: 0 0 16px; padding: 12px 14px; border-radius: 12px; border: 1px solid color-mix(in srgb, var(--notice) 55%, transparent); background: color-mix(in srgb, var(--notice) 11%, transparent); --notice: var(--text-dim); }
  .cl-notice-security { --notice: var(--red, #ff6b6b); }
  .cl-notice-warning { --notice: var(--yellow, #fed53c); }
  .cl-notice-breaking { --notice: var(--accent, #f4a58a); }
  .cl-notice-info { --notice: var(--blue, #7aa7ff); }
  .cl-notice-head { display: flex; align-items: center; gap: 8px; color: var(--notice); font-size: 14.5px; margin-bottom: 6px; }
  .cl-notice-head :global(svg) { flex: none; }
  .cl-notice p { margin: 6px 0 0; font-size: 14px; line-height: 1.6; color: var(--text); }
  .cl-notice :global(code) { font-family: var(--mono); font-size: 12.5px; color: var(--notice); background: color-mix(in srgb, var(--notice) 14%, transparent); padding: 1px 5px; border-radius: 5px; }
  .cl-list { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 10px; }
  .cl-list li { font-size: 14.5px; color: var(--text-muted); line-height: 1.6; }
  .cl-list :global(code) { font-family: var(--mono); font-size: 12.5px; color: var(--accent); background: var(--accent-soft); padding: 1px 6px; border-radius: 5px; }
</style>
