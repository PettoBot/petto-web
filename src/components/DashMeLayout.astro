---
// The shell of the account pages (/dash/me, /dash/manage, /dash/history, /dash/premium): the same look as a server's dashboard (a menu at the side, a drawer on a phone, a content panel),
// with the account's own header (its Discord banner, avatar and name), its own short menu and the server sheet.
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import DashSideHead from './DashSideHead.astro';
import DashServerSheet from './DashServerSheet.astro';
import DashUserCard from './DashUserCard.astro';
import { userHeaderArt } from '../utils/dashProfile.mjs';
import { userCardData } from '../utils/discordCosmetics.mjs';
import { isPettoOwner } from '../utils/premiumAdmin';
import { staffAccess } from '../utils/staffAccess';
import { loadSwitcherServers } from '../utils/dashSwitcherData';
import { getDashLang, makeT } from '../i18n/dash';
import type { Session } from '../utils/session';

type Active = 'overview' | 'servers' | 'history' | 'preferences' | 'privacy' | 'daily' | 'plans' | 'plan' | 'movements' | 'staff-plans' | 'staff-grant' | 'badges' | 'name' | 'banners' | 'rank' | 'buy' | 'premium' | 'staff-servers' | 'staff-premium' | 'staff-team' | 'staff-partners' | 'staff-credits' | 'staff-changelog' | 'staff-appeals' | 'staff-badges';
interface Props { user: Session; active: Active; pageTitle: string }
const { user, active, pageTitle: rawTitle } = Astro.props;
const dt = makeT(getDashLang(Astro));
const pageTitle = dt(rawTitle);
const servers = await loadSwitcherServers(Astro, user);
const card = userCardData(user);
const art = userHeaderArt(user);
// The @username goes under the name only when it says something the display name does not.
const handle = user.handle && user.handle !== (card.name || user.username) ? user.handle : null;

// A short menu: only places that exist and have something behind them. The server list, the Premium page and the name history are pages of
// their own; this page is the overview of the account.
const sections = [
  { title: dt('Main'), items: [
    { id: 'overview', href: '/dash/me', icon: 'ph:squares-four-fill', label: dt('Overview'), sk: 'stats' },
    { id: 'daily', href: '/dash/daily', icon: 'ph:gift-fill', label: dt('Daily reward'), sk: 'cards' },
  ] },
  { title: dt('Subscriptions'), items: [
    { id: 'plans', href: '/dash/plans', icon: 'ph:star-fill', label: dt('Plans'), sk: 'cards' },
    { id: 'plan', href: '/dash/plan', icon: 'ph:identification-badge-fill', label: dt('My plan'), sk: 'cards' },
    { id: 'premium', href: '/dash/premium', icon: 'ph:crown-fill', label: 'Premium', sk: 'cards' },
  ] },
  { title: dt('Personalization'), items: [
    { id: 'badges', href: '/dash/badges', icon: 'ph:medal-fill', label: dt('Badges'), sk: 'cards' },
    { id: 'name', href: '/dash/name', icon: 'ph:text-aa-fill', label: dt('Customize name'), sk: 'cards' },
    { id: 'banners', href: '/dash/banners', icon: 'ph:image-fill', label: dt('Customize profile'), sk: 'cards' },
    { id: 'rank', href: '/dash/rank', icon: 'ph:identification-card-fill', label: dt('Rank card'), sk: 'cards' },
  ] },
  { title: dt('Ceramos'), items: [
    { id: 'buy', href: '/dash/buy-ceramos', icon: 'ph:coins-fill', label: dt('Buy ceramos'), sk: 'cards' },
    { id: 'movements', href: '/dash/ceramos', icon: 'ph:list-bullets-fill', label: dt('Ceramos movements'), sk: 'list' },
  ] },
  { title: dt('Account'), items: [
    { id: 'servers', href: '/dash/manage', icon: 'ph:hard-drives-fill', label: dt('Your servers'), sk: 'grid' },
    { id: 'history', href: '/dash/history', icon: 'ph:clock-counter-clockwise', label: dt('History'), sk: 'list' },
    { id: 'preferences', href: '/dash/preferences', icon: 'ph:sliders-horizontal-fill', label: dt('Preferences'), sk: 'form' },
    { id: 'privacy', href: '/dash/privacy', icon: 'ph:shield-check-fill', label: dt('Privacy and session'), sk: 'cards' },
  ] },
];
// The Staff group is drawn only for the people who may open its pages (the owner: all of them; the team: partners, credits and appeal names).
// The pages check this again on their own; a person who may not open them gets no group, no links and no hint in the HTML.
const access = await staffAccess(Astro, user.userId);
const staffItems = [
  access.owner && { id: 'staff-servers', href: '/dash/admin/servers', icon: 'ph:hard-drives-fill', label: dt('All servers'), sk: 'list' },
  access.owner && { id: 'staff-premium', href: '/dash/admin', icon: 'ph:gift-fill', label: dt('Premium grants'), sk: 'form' },
  access.owner && { id: 'staff-grant', href: '/dash/ceramos-admin', icon: 'ph:coins-fill', label: dt('Give ceramos'), sk: 'form' },
  access.owner && { id: 'staff-plans', href: '/dash/plans-admin', icon: 'ph:star-fill', label: dt('User plans'), sk: 'form' },
  access.owner && { id: 'staff-badges', href: '/dash/badges-admin', icon: 'ph:medal-fill', label: dt('Shop editor'), sk: 'form' },
  access.owner && { id: 'staff-team', href: '/dash/team', icon: 'ph:users-three-fill', label: dt('Team'), sk: 'list' },
  access.team && { id: 'staff-partners', href: '/dash/partners-admin', icon: 'ph:handshake-fill', label: dt('Partners'), sk: 'list' },
  access.team && { id: 'staff-credits', href: '/dash/credits-admin', icon: 'ph:heart-fill', label: dt('Credits'), sk: 'list' },
  access.team && { id: 'staff-changelog', href: '/dash/changelog-admin', icon: 'ph:clock-counter-clockwise-fill', label: dt('Changelog'), sk: 'form' },
  access.team && { id: 'staff-appeals', href: '/dash/appeal-names', icon: 'ph:scales-fill', label: dt('Appeal names'), sk: 'list' },
].filter((item): item is { id: string; href: string; icon: string; label: string; sk: string } => Boolean(item));
if (staffItems.length) sections.push({ title: dt('Staff'), items: staffItems });
const activeItem = sections.flatMap((section) => section.items).find((item) => item.id === active);
---
<Base title={`${pageTitle} · Petto`} active="dash">
  <main>
    <section class="dme-sec">
      <div class="wrap dme-wrap">
        <div class="dme-layout">
          <div class="dme-bar" id="dme-bar">
            <button type="button" class="dme-burger dash-menu-btn" id="dme-burger" aria-controls="dme-side" aria-expanded="false" aria-label={dt('Open the menu')}><Icon name="ph:list" width="20" height="20" /></button>
            <span class="dme-bar-label">{activeItem?.label ?? pageTitle}</span>
          </div>
          <div class="dme-backdrop" id="dme-backdrop" hidden></div>
          <aside class="dme-side" id="dme-side">
            <div class="dme-close-row">
              <button type="button" class="dme-close" id="dme-close" aria-label={dt('Close the menu')}><Icon name="ph:x" width="16" height="16" /></button>
            </div>
            <DashSideHead kind="user" size="roomy" name={card.name || user.username} handle={handle} icon={card.avatar ? card.avatar.replace(/size=64$/, 'size=256') : null} art={art} decoration={card.decoration} />
            <nav class="dme-nav" aria-label={dt('Account')}>
              {sections.map((section) => (
                <Fragment>
                  <div class="dme-title">{section.title}</div>
                  {section.items.map((item) => (
                    <a href={item.href} data-sk={item.sk} class:list={['dme-link', { active: item.id === active }]} aria-current={item.id === active ? 'page' : undefined}>
                      <Icon name={item.icon} width="18" height="18" />
                      <span>{item.label}</span>
                    </a>
                  ))}
                </Fragment>
              ))}
            </nav>
            <DashUserCard user={user} />
          </aside>
          <div class="dme-content" id="dme-content"><slot /></div>
        </div>
      </div>
    </section>
  </main>
  <DashServerSheet user={{ name: card.name || user.username, avatar: card.avatar }} profileHref="/dash/me" onProfile={true} servers={servers.mine} invites={servers.invite} owner={isPettoOwner(Astro, user.userId)} />
</Base>
<script is:inline>
  (function () {
    // The bar with the menu button sticks right under the site header: its distance is the header's real height (the server dashboard
    // measures it the same way). Without it the bar sat a few pixels too high and the page showed through the gap.
    function syncHeaderHeight() {
      var header = document.querySelector('header.nav');
      if (header) document.documentElement.style.setProperty('--dgl-header-h', header.offsetHeight + 'px');
    }
    syncHeaderHeight();
    window.addEventListener('resize', syncHeaderHeight);
    var side = document.getElementById('dme-side');
    var burger = document.getElementById('dme-burger');
    var backdrop = document.getElementById('dme-backdrop');
    if (!side || !burger || !backdrop) return;
    // The menu scrolls when it is taller than the screen: the page you are on is brought into view (a Staff page sits at the end).
    function showActive() {
      var nav = side.querySelector('.dme-nav');
      var link = side.querySelector('.dme-link.active');
      if (!nav || !link) return;
      var top = link.getBoundingClientRect().top - nav.getBoundingClientRect().top + nav.scrollTop;
      if (top + link.offsetHeight > nav.clientHeight) nav.scrollTop = top - (nav.clientHeight - link.offsetHeight) / 2;
    }
    showActive();
    function setDrawer(open) {
      if (side.classList.contains('open') === open) return;
      side.classList.toggle('open', open);
      backdrop.hidden = !open;
      burger.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('dme-drawer-open', open);
      if (open) { showActive(); setTimeout(function () { document.getElementById('dme-close').focus({ preventScroll: true }); }, 60); }
      else burger.focus({ preventScroll: true });
    }
    burger.addEventListener('click', function () { setDrawer(!side.classList.contains('open')); });
    backdrop.addEventListener('click', function () { setDrawer(false); });
    document.getElementById('dme-close').addEventListener('click', function () { setDrawer(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setDrawer(false); });
  })();
</script>

<style>
  .dme-sec { padding: 28px 0; }
  .dme-wrap { max-width: none; padding-left: 40px; padding-right: 40px; }
  .dme-layout { display: grid; grid-template-columns: 292px 1fr; gap: 22px; align-items: start; }
  .dme-side {
    position: sticky; top: calc(var(--dgl-header-h, 60px) + 28px); align-self: start; display: flex; flex-direction: column; overflow: hidden;
    max-height: min(calc(100dvh - var(--dgl-header-h, 60px) - 56px), 100dvh); border: 1px solid var(--border); border-radius: 16px; background: var(--dgl-side-bg, var(--card));
  }
  .dme-bar, .dme-backdrop, .dme-close-row { display: none; }
  .dme-nav { display: flex; flex-direction: column; flex: 0 1 auto; min-height: 0; overflow-y: auto; padding: 2px 10px 12px; margin-top: 10px; scrollbar-width: thin; }
  .dme-title { font-family: var(--mono); font-size: 10.5px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--text-dim); padding: 14px 10px 6px; }
  .dme-link { position: relative; display: flex; align-items: center; gap: 11px; font-size: 14.5px; color: var(--text-muted); text-decoration: none; padding: 10px 12px; border-radius: 11px; -webkit-tap-highlight-color: transparent; transition: color var(--m-fast) ease, background-color var(--m-fast) ease, transform var(--m-instant) ease; }
  .dme-link :global(svg) { flex: none; color: var(--text-dim); transition: color var(--m-fast) ease; }
  .dme-link:hover { color: var(--text); background: var(--card-hover); }
  .dme-link:active:not(.active) { background: color-mix(in srgb, var(--text) 10%, transparent); }
  .dme-link.active { color: var(--accent); background: var(--accent-soft); font-weight: 600; }
  .dme-link.active :global(svg) { color: var(--accent); }
  .dme-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .dme-content {
    min-width: 0; border: 1px solid var(--border); border-radius: 18px; background: var(--dgl-panel-bg, var(--card)); padding: 28px 32px 40px; overflow-y: auto; scrollbar-width: none;
    max-height: calc(100dvh - var(--dgl-header-h, 60px) - 56px); min-height: min(640px, calc(100dvh - var(--dgl-header-h, 60px) - 56px));
  }
  .dme-content::-webkit-scrollbar { display: none; }

  @media (max-width: 880px) {
    .dme-sec { padding: 16px 0 32px; }
    .dme-wrap { padding-left: 16px; padding-right: 16px; }
    .dme-layout { display: block; }
    .dme-side { position: fixed; top: 0; left: 0; bottom: 0; z-index: 1001; width: min(86vw, 320px); height: 100dvh; max-height: 100dvh; padding-bottom: env(safe-area-inset-bottom, 0px); border-radius: 0 18px 18px 0; transform: translateX(-105%); visibility: hidden; transition: transform var(--m-base) var(--m-in), visibility 0s linear var(--m-base); will-change: transform; }
    .dme-side.open { transform: none; visibility: visible; box-shadow: 0 0 40px rgba(0, 0, 0, .55); transition: transform var(--m-slow) var(--m-out), visibility 0s; }
    .dme-backdrop { display: block; position: fixed; inset: 0; z-index: 1000; background: rgba(0, 0, 0, .55); touch-action: none; }
    .dme-backdrop[hidden] { display: none; }
    .dme-close-row { display: flex; position: absolute; z-index: 5; top: 0; right: 0; padding: calc(10px + env(safe-area-inset-top, 0px)) 10px 0 0; }
    .dme-close { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, .22); background: rgba(8, 9, 12, .42); color: #fff; cursor: pointer; touch-action: manipulation; -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
    .dme-bar { display: flex; align-items: center; gap: 12px; margin: 0 0 6px; padding: 10px 0; min-width: 0; position: sticky; top: var(--dgl-header-h, 60px); z-index: 30; background: var(--bg); }
    .dme-burger { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 42px; height: 42px; padding: 0; border-radius: 12px; border: 1px solid var(--border); background: var(--card); color: var(--accent); cursor: pointer; touch-action: manipulation; }
    .dme-bar-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 15px; font-weight: 700; color: var(--text); }
    /* The drawer takes the whole height: the menu grows and the user card stays at the bottom, so nothing of the page shows under it. */
    .dme-nav { flex: 1 1 auto; border-top: 1px solid var(--border-soft); margin-top: 10px; padding: 2px 12px 8px; }
    .dme-link { padding: 8px 12px; font-size: 15px; min-height: 44px; }
    .dme-content { display: block; max-height: none; min-height: 0; overflow-y: visible; border-radius: 14px; padding: 22px 18px 40px; }
  }
</style>

<style is:global>
  /* The account pages come in softly after the isometric loading drawing, they never just pop in. */
  .dme-content { animation: dmeIn .45s cubic-bezier(.16, 1, .3, 1) both; }
  @keyframes dmeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .dme-content { animation: none; } }
  /* The pieces the account pages share (overview, preferences, privacy): a heading, cards in a grid, rows of facts, pills. */
  .ac-head h1 { margin: 0; font-family: var(--serif); font-size: clamp(26px, 4.4vw, 36px); line-height: 1.08; overflow-wrap: anywhere; }
  .ac-head p { margin: 8px 0 0; color: var(--text-muted); font-size: 15px; max-width: 62ch; }
  .ac-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 18px; align-items: stretch; }
  .ac-card { min-width: 0; display: flex; flex-direction: column; padding: 18px 20px 20px; border: 1px solid var(--border-soft); border-radius: 16px; background: color-mix(in srgb, var(--text) 2%, transparent); }
  .ac-wide { grid-column: 1 / -1; }
  .ac-card-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
  .ac-card-head h2 { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 15.5px; font-weight: 700; }
  .ac-card-head h2 svg { color: var(--accent); flex: none; }
  .ac-card-head a { font-size: 12.5px; color: var(--accent); text-decoration: none; white-space: nowrap; }
  .ac-card-head a:hover { text-decoration: underline; }
  .ac-lead { margin: 0 0 12px; color: var(--text-muted); font-size: 13.5px; line-height: 1.5; }
  .ac-muted { margin: 0; color: var(--text-muted); font-size: 13.5px; line-height: 1.5; }
  .ac-rows { margin: 0; display: grid; gap: 0; }
  .ac-rows > div { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 11px 0; border-bottom: 1px solid var(--border-soft); }
  .ac-rows > div:first-child { padding-top: 0; }
  .ac-rows > div:last-child { border-bottom: 0; padding-bottom: 0; }
  .ac-rows dt { color: var(--text-muted); font-size: 13.5px; }
  .ac-rows dd { margin: 0; font-weight: 700; font-size: 14.5px; text-align: right; min-width: 0; overflow-wrap: anywhere; }
  .ac-rows dd small { display: block; color: var(--text-dim); font-weight: 400; font-size: 12px; }
  .ac-code { font-family: var(--mono); font-size: 13px; padding: 2px 8px; border-radius: 7px; background: var(--accent-soft); color: var(--accent); }
  .ac-pill { display: inline-flex; align-items: center; gap: 5px; padding: 4px 11px; border-radius: 999px; font-size: 12.5px; font-weight: 700; color: var(--text-muted); background: color-mix(in srgb, var(--text) 6%, transparent); border: 1px solid var(--border-soft); }
  .ac-pill.is-active { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: color-mix(in srgb, var(--yellow) 42%, var(--border)); }
  .ac-pill.is-past_due, .ac-pill.is-expired { color: var(--red); background: var(--red-soft); border-color: color-mix(in srgb, var(--red) 40%, var(--border)); }
  .ac-btns { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; padding-top: 14px; }
  .ac-btns .btn { display: inline-flex; align-items: center; gap: 6px; }
  .ac-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .ac-list li { display: flex; gap: 10px; align-items: flex-start; padding: 7px 0; font-size: 13.5px; line-height: 1.45; color: var(--text-muted); }
  .ac-list li > svg { flex: none; margin-top: 2px; color: var(--accent); }
  .ac-list b { color: var(--text); font-weight: 600; }
  @media (max-width: 720px) { .ac-grid { grid-template-columns: minmax(0, 1fr); } .ac-card { padding: 16px 16px 18px; } }

  html.dme-drawer-open, html.dme-drawer-open body { overflow: hidden; }
</style>
