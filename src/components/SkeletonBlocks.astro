---
// Grey shimmering blocks that stand in for a page, or an editor, while its data loads. Shown inside the islands that
// only draw in the browser (they are empty until their script is ready), the markup is the same the dashboard builds
// in its own navigation (see DashGuildLayout), and the look lives in Base.astro.
interface Props { variant?: 'page' | 'editor' }
const { variant = 'page' } = Astro.props;
---
{variant === 'editor' ? (
  <div class="sk-wrap sk-editor" aria-hidden="true">
    <div class="sk-col">
      <span class="sk sk-line"></span>
      <span class="sk sk-field"></span>
      <span class="sk sk-field"></span>
      <span class="sk sk-field tall"></span>
      <span class="sk sk-field"></span>
    </div>
    <div class="sk-col">
      <span class="sk sk-card tall"></span>
    </div>
  </div>
) : (
  <div class="sk-wrap" aria-hidden="true">
    <span class="sk sk-title"></span>
    <span class="sk sk-line"></span>
    <span class="sk sk-line short"></span>
    <div class="sk-grid">
      <span class="sk sk-card"></span>
      <span class="sk sk-card"></span>
      <span class="sk sk-card"></span>
      <span class="sk sk-card"></span>
    </div>
  </div>
)}
