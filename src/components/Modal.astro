---
// A pop-up window of the dashboard (Media channels, Boards): a dimmed layer with a card in the middle, opened by any button with
// data-modal-open="<id>" and closed by data-modal-close, by Escape or by a click on the dimmed area.
// It is a plain fixed layer and not a native <dialog>: a dialog sits in the browser's top layer, above the emoji picker and the select menus
// of the dashboard, which would then open behind it.
import { Icon } from 'astro-icon/components';
import { getDashLang, makeT } from '../i18n/dash';
const dt = makeT(getDashLang(Astro));
interface Props { id: string; title: string; icon?: string }
const { id, title, icon = 'ph:image-fill' } = Astro.props;
---
<div class="mdl" id={id} hidden role="dialog" aria-modal="true" aria-labelledby={`${id}-title`}>
  <div class="mdl-box">
    <header class="mdl-head"><span class="mdl-ico"><Icon name={icon} width="18" height="18" /></span><h2 id={`${id}-title`}>{title}</h2><button type="button" class="mdl-x" data-modal-close aria-label={dt('Close')}><Icon name="ph:x-bold" width="14" height="14" /></button></header>
    <slot />
  </div>
</div>

<script>
  const w = window as unknown as { __mdlBound?: boolean };
  if (!w.__mdlBound) {
    w.__mdlBound = true;
    const motion = () => (window as unknown as { dglMotion?: { leave: (el: HTMLElement, done: () => void) => void } }).dglMotion;
    const open = (el: HTMLElement) => {
      el.hidden = false;
      document.body.classList.add('mdl-lock');
      requestAnimationFrame(() => el.querySelector<HTMLElement>('select, input:not([type="hidden"]):not([type="checkbox"]), textarea, button')?.focus({ preventScroll: true }));
    };
    const close = (el: HTMLElement) => {
      const done = () => { el.hidden = true; el.classList.remove('dgl-leave'); if (!document.querySelector('.mdl:not([hidden])')) document.body.classList.remove('mdl-lock'); };
      el.classList.add('dgl-leave');
      setTimeout(done, 180);
    };
    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      const opener = target?.closest<HTMLElement>('[data-modal-open]');
      if (opener) {
        const wanted = opener.dataset.modalOpen ?? '';
        // The window is moved to <body> when it opens, out of the stacking layers of the page (its header and bars would sit above it).
        // A page swapped in again may leave an older copy there: the one in the page wins and the old one goes.
        const copies = [...document.querySelectorAll<HTMLElement>('.mdl')].filter((m) => m.id === wanted);
        const fresh = copies.find((m) => m.parentElement !== document.body) ?? copies[0];
        copies.forEach((m) => { if (m !== fresh) m.remove(); });
        if (fresh) {
          if (fresh.parentElement !== document.body) document.body.appendChild(fresh);
          // The emoji picker lives inside the page, whose layer sits below the window: it goes to <body> too (after the window) so it opens on top.
          const pickers = [...document.querySelectorAll<HTMLElement>('.ep-modal')];
          const picker = pickers.find((m) => m.parentElement !== document.body) ?? pickers[0];
          pickers.forEach((m) => { if (m !== picker) m.remove(); });
          if (picker) document.body.appendChild(picker);
          open(fresh);
        }
        return;
      }
      const closer = target?.closest('[data-modal-close]');
      if (closer) { const el = closer.closest<HTMLElement>('.mdl'); if (el) close(el); return; }
      // A click on the dimmed area (the layer itself, outside the card).
      if (target?.classList.contains('mdl') && !target.hidden) close(target);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      // The emoji picker and the menus have their own Escape; the window closes only when none of them is open.
      if (document.querySelector('.ep-modal:not([hidden]), .dgl-selmenu, .dgl-cp-panel:not([hidden])')) return;
      const top = [...document.querySelectorAll<HTMLElement>('.mdl:not([hidden])')].pop();
      if (top) close(top);
    });
    void motion;
  }
</script>

<style is:global>
  .mdl { position: fixed; inset: 0; z-index: 55; display: flex; align-items: center; justify-content: center; padding: 16px; background: rgb(0 0 0 / 58%); backdrop-filter: blur(3px); animation: m-fade-in var(--m-base, .2s) ease both; }
  .mdl[hidden] { display: none; }
  .mdl.dgl-leave { animation: m-fade-out .18s ease both; }
  .mdl-box { width: min(560px, 100%); max-height: min(92vh, 860px); overflow: auto; overscroll-behavior: contain; display: grid; gap: 16px; align-content: start; padding: 18px; border: 1px solid var(--border); border-radius: 18px; background: var(--card); color: var(--text); box-shadow: 0 24px 70px rgba(0, 0, 0, .5); animation: m-dialog-in var(--m-slow, .3s) var(--m-out, ease) both; }
  .mdl.dgl-leave .mdl-box { animation: m-dialog-out .18s ease both; }
  .mdl-head { display: flex; align-items: center; gap: 10px; }
  .mdl-head h2 { flex: 1; margin: 0; font-size: 17px; overflow-wrap: anywhere; }
  .mdl-ico { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); flex: none; }
  .mdl-x { width: 30px; height: 30px; border-radius: 8px; border: 0; background: none; color: var(--text-dim); display: grid; place-items: center; cursor: pointer; }
  .mdl-x:hover { color: var(--text); background: var(--card-hover, rgba(255, 255, 255, .06)); }
  body.mdl-lock { overflow: hidden; }
  @keyframes m-fade-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes m-fade-out { from { opacity: 1; } to { opacity: 0; } }
  @media (max-width: 560px) { .mdl { padding: 10px; } .mdl-box { padding: 16px 14px; } }
  @media (prefers-reduced-motion: reduce) { .mdl, .mdl-box { animation: none !important; } }
</style>
