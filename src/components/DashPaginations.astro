---
import { hiddenChannelSet, goneChannelLabel } from '../utils/channelLabel';
// The "Paginated messages" section of the Embeds page: the messages of the server with pages and buttons (`!pagination` in the bot),
// with their channel, pages and link, a way to stop one or put its buttons back, and a small builder that posts a new one from saved
// embeds in the order picked. Every change goes through the bot (embeds.astro handles the forms).
import { Icon } from 'astro-icon/components';
import { getDashLang, makeT } from '../i18n/dash';
import { FREE_LIMITS } from '../utils/planLimits';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Pagination {
  id: string; channelId: string; channelName: string | null; messageId: string; url: string; kind: 'embed' | 'v2'; private: boolean;
  pages: { type: string; name?: string }[];
}
interface Props {
  paginations: Pagination[];
  ready: boolean;
  message: { kind: 'ok' | 'err'; text: string } | null;
  templateNames: string[];
  channels: { id: string; name: string }[];
}
const { paginations, ready, message, templateNames, channels } = Astro.props;
const hiddenChannels = await hiddenChannelSet(String(Astro.params.id ?? ''));
const goneChannel = (id: string, goneKey: string) => goneChannelLabel(dt, hiddenChannels, id, goneKey);
const MAX_PAGES = 25;
const pageName = (page: { type: string; name?: string }) => (page.type === 'embed' ? page.name || dt('Saved embed') : page.type === 'message' ? dt('Original message') : dt('Embed code'));
const startRows = templateNames.length ? 1 : 0;
---
<section class="pg" id="paginated-messages" data-pagination-section>
  <header class="pg-head">
    <h2><Icon name="ph:book-open-fill" width="18" height="18" />{dt('Paginated messages')}</h2>
    <p class="pg-sub">{dt('One message with several pages and buttons to turn them (◀ page ▶, and a menu to jump when there are more than 5). Anyone can turn the pages; private ones show each member their own copy.')}</p>
  </header>

  {message && <div class:list={['pg-flash', { 'pg-flash-err': message.kind === 'err' }]} role="status"><Icon name={message.kind === 'ok' ? 'ph:check-circle-fill' : 'ph:warning-fill'} width="15" height="15" />{message.text}</div>}
  {!ready && <div class="pg-flash pg-flash-warn"><Icon name="ph:plug-fill" width="15" height="15" />{dt('The paginated messages could not be read. Try again in a moment.')}</div>}

  <div class:list={['pg-grid', { 'is-empty': paginations.length === 0 }]}>
    <div class="pg-list dgl-stagger">
      {paginations.length === 0 && ready && (
        <div class="pg-empty">
          <Icon name="ph:stack-fill" width="22" height="22" />
          <p>{dt('No paginated messages yet. Post one with the builder, or turn a message Petto sent into one with !pagination set <link>.')}</p>
        </div>
      )}
      {paginations.map((p) => (
        <article class="pg-card">
          <div class="pg-card-top">
            <div class="pg-card-title">
              <Icon name="ph:hash-bold" width="15" height="15" />
              <b>{p.channelName ?? goneChannel(p.channelId, 'Deleted channel')}</b>
              <span class="pg-tag">{p.pages.length === 1 ? dt('1 page') : dt('{n} pages', { n: p.pages.length })}</span>
              {p.private && <span class="pg-tag pg-tag-private">{dt('Private')}</span>}
              {p.kind === 'v2' && <span class="pg-tag pg-tag-v2">V2</span>}
            </div>
            <a class="pg-open" href={p.url} target="_blank" rel="noopener">{dt('Open in Discord')}<Icon name="ph:arrow-square-out-bold" width="11" height="11" /></a>
          </div>
          <ol class="pg-pages">
            {p.pages.map((page) => <li class:list={{ 'pg-page-code': page.type !== 'embed' }}>{pageName(page)}</li>)}
          </ol>
          <div class="pg-actions">
            <form method="POST" data-no-dirty>
              <input type="hidden" name="action" value="pagination_restore" />
              <input type="hidden" name="pagination_id" value={p.id} />
              <button class="btn btn-ghost btn-sm" type="submit"><Icon name="ph:arrow-counter-clockwise-bold" width="12" height="12" />{dt('Put the buttons back')}</button>
            </form>
            <form method="POST" data-no-dirty>
              <input type="hidden" name="action" value="pagination_delete" />
              <input type="hidden" name="pagination_id" value={p.id} />
              <button class="btn btn-ghost btn-sm" type="submit" data-confirm={dt('Stop this pagination? The message stays with the page it shows, without buttons.')}><Icon name="ph:stop-circle-fill" width="12" height="12" />{dt('Stop')}</button>
            </form>
            <form method="POST" data-no-dirty>
              <input type="hidden" name="action" value="pagination_delete" />
              <input type="hidden" name="pagination_id" value={p.id} />
              <input type="hidden" name="purge" value="1" />
              <button class="btn btn-ghost btn-sm pg-danger" type="submit" data-confirm={dt('Delete this message from Discord? Its pages are removed too.')}><Icon name="ph:trash-bold" width="12" height="12" />{dt('Delete message')}</button>
            </form>
          </div>
        </article>
      ))}
    </div>

    <form method="POST" class="pg-builder" data-no-dirty data-pg-builder>
      <input type="hidden" name="action" value="pagination_create" />
      <h3>{dt('New paginated message')}</h3>
      {templateNames.length === 0 ? (
        <p class="pg-hint">{dt('Save an embed above first: each page is a saved embed.')}</p>
      ) : (
        <>
          <label class="pg-field"><span>{dt('Channel')}</span>
            <select name="channel_id" required>
              <option value="">{dt('Choose a channel')}</option>
              {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
            </select>
          </label>
          <div class="pg-field">
            <span>{dt('Pages, in order')}</span>
            <ol class="pg-rows" data-pg-rows>
              {Array.from({ length: startRows }, (_, index) => (
                <li class="pg-row" data-pg-row>
                  <select name="embed" aria-label={dt('Saved embed')}>{templateNames.map((name, at) => <option value={name} selected={at === index}>{name}</option>)}</select>
                  <button type="button" class="pg-icon" data-pg-up aria-label={dt('Move up')}><Icon name="ph:caret-up-bold" width="12" height="12" /></button>
                  <button type="button" class="pg-icon" data-pg-down aria-label={dt('Move down')}><Icon name="ph:caret-down-bold" width="12" height="12" /></button>
                  <button type="button" class="pg-icon" data-pg-remove aria-label={dt('Remove page')}><Icon name="ph:x-bold" width="12" height="12" /></button>
                </li>
              ))}
            </ol>
            <button type="button" class="btn btn-ghost btn-sm pg-add" data-pg-add data-max={MAX_PAGES}><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add a page')}</button>
          </div>
          <label class="pg-check"><input type="checkbox" name="private" value="1" /><span><b>{dt('Private pages')}</b><em>{dt('A click shows the page only to who clicked, instead of turning it for everyone.')}</em></span></label>
          <button class="btn btn-accent btn-sm" type="submit" disabled={!ready}><Icon name="ph:paper-plane-tilt-fill" width="13" height="13" />{dt('Post')}</button>
          <p class="pg-hint">{dt('Up to 25 pages. All pages must be classic embeds or all Components V2 designs. Free servers can have {n} paginated messages.', { n: FREE_LIMITS.paginationMessages })}</p>
        </>
      )}
      <p class="pg-hint pg-cmd">{dt('With the prefix: !pagination create, set, add, update, remove, move, list, view, mode, restore, delete and reset (alias !pn).')}</p>
    </form>
    {paginations.length === 0 && <div class="pg-aside-slot" id="pg-aside-slot"></div>}
  </div>

  <script is:inline>
    (function () {
      function dockFooter() {
        var slot = document.getElementById('pg-aside-slot');
        var footer = document.querySelector('#dgl-content > aside.dgf');
        if (slot && footer) slot.appendChild(footer);
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', dockFooter);
      else requestAnimationFrame(dockFooter);
    })();
  </script>

  <script is:inline>
    // The builder's page rows: add (a copy of the last row), move up or down, remove (one row always stays). One listener for the
    // whole document, bound once, so it keeps working after the dashboard swaps the page content in. Once touched, the builder holds
    // the live updates of the page (data-dash-hold) so the pages picked are not redrawn away before they are posted.
    (function () {
      if (window.__pgBound) return;
      window.__pgBound = true;
      document.addEventListener('change', function (event) {
        var builder = event.target && event.target.closest ? event.target.closest('[data-pg-builder]') : null;
        if (builder) builder.setAttribute('data-dash-hold', '');
      });
      document.addEventListener('click', function (event) {
        var target = event.target && event.target.closest ? event.target.closest('[data-pg-builder] button[type="button"]') : null;
        if (!target) return;
        var builder = target.closest('[data-pg-builder]');
        // Being built: a live update of the page waits until it is posted (the layout's data-dash-hold).
        builder.setAttribute('data-dash-hold', '');
        var rows = builder.querySelector('[data-pg-rows]');
        var row = target.closest('[data-pg-row]');
        if (target.hasAttribute('data-pg-add')) {
          var all = rows.querySelectorAll('[data-pg-row]');
          if (all.length >= Number(target.getAttribute('data-max') || 25)) return;
          var last = all[all.length - 1];
          var copy = last.cloneNode(true);
          // A copy keeps the markup, not what was chosen: the new page is the saved embed after the last one.
          var from = last.querySelector('select');
          var select = copy.querySelector('select');
          if (from && select) select.selectedIndex = Math.min(from.selectedIndex + 1, select.options.length - 1);
          rows.appendChild(copy);
        } else if (row && target.hasAttribute('data-pg-up') && row.previousElementSibling) {
          rows.insertBefore(row, row.previousElementSibling);
        } else if (row && target.hasAttribute('data-pg-down') && row.nextElementSibling) {
          rows.insertBefore(row.nextElementSibling, row);
        } else if (row && target.hasAttribute('data-pg-remove') && rows.querySelectorAll('[data-pg-row]').length > 1 && !row.hasAttribute('data-pg-leaving')) {
          // The row fades out, then goes; it stops counting at once so a quick second click cannot remove the last one.
          row.setAttribute('data-pg-leaving', '');
          row.removeAttribute('data-pg-row');
          row.querySelectorAll('select').forEach(function (select) { select.disabled = true; });
          if (window.dglMotion && window.dglMotion.leave) window.dglMotion.leave(row, function () { window.dglMotion.flip(row, function () { row.remove(); }); });
          else row.remove();
        }
      });
    })();
  </script>
</section>

<style>
  /* The site sets a tall padding on every section for the landing pages; this one sits inside the dashboard. */
  .pg { margin-top: 24px; padding: 20px 0 0; border-top: 1px solid var(--border-soft); max-width: none; }
  .pg-head h2 { display: flex; align-items: center; gap: 8px; font-size: 18px; margin: 0 0 6px; }
  .pg-head h2 :global(svg) { color: var(--accent); }
  .pg-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 16px; max-width: 72ch; }
  .pg-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid color-mix(in srgb, var(--green) 55%, transparent); border-radius: 10px; padding: 10px 14px; margin: 0 0 14px; max-width: 760px; overflow-wrap: anywhere; }
  .pg-flash :global(svg) { flex: none; }
  .pg-flash-err { color: var(--red, #ff6b6b); background: color-mix(in srgb, var(--red, #ff6b6b) 10%, transparent); border-color: color-mix(in srgb, var(--red, #ff6b6b) 55%, transparent); }
  .pg-flash-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: color-mix(in srgb, var(--yellow) 55%, transparent); }
  .pg-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 380px); gap: 18px; align-items: start; }
  .pg-grid.is-empty { grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr); gap: 16px 20px; align-items: start; }
  .pg-grid.is-empty .pg-list { grid-column: 1 / -1; }
  .pg-grid.is-empty .pg-builder { display: flex; flex-direction: column; gap: 12px; }
  .pg-grid.is-empty .pg-builder > button[type="submit"] { align-self: flex-start; padding-inline: 22px; }
  .pg-aside-slot :global(.dgf) { margin: 0 !important; max-width: none !important; height: 100%; }
  .pg-aside-slot :global(.dgf-grid) { grid-template-columns: 1fr !important; gap: 10px !important; }
  .pg-aside-slot :global(.dgf-links) { flex-direction: column; align-items: flex-start; gap: 8px; padding-top: 8px; border-top: 1px solid var(--border-soft); }
  @media (max-width: 900px) { .pg-grid.is-empty { grid-template-columns: minmax(0, 1fr); } }
  .pg-list { display: grid; gap: 12px; min-width: 0; }
  .pg-empty { display: flex; gap: 12px; align-items: flex-start; border: 1px dashed var(--border); border-radius: 14px; padding: 16px; color: var(--text-muted); font-size: 14px; }
  .pg-empty p { margin: 0; }
  .pg-empty :global(svg) { color: var(--accent); flex: none; }
  .pg-card { border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 14px 16px; min-width: 0; }
  .pg-card-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 12px; }
  .pg-card-title { display: flex; align-items: center; gap: 8px; min-width: 0; flex-wrap: wrap; }
  .pg-card-title b { font-size: 15px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
  .pg-tag { font-size: 11px; font-weight: 700; letter-spacing: .03em; border-radius: 999px; padding: 2px 8px; background: var(--accent-soft); color: var(--accent); flex: none; }
  .pg-tag-private { background: color-mix(in srgb, var(--yellow) 16%, transparent); color: var(--yellow); }
  .pg-tag-v2 { background: color-mix(in srgb, var(--green) 14%, transparent); color: var(--green); }
  .pg-open { display: inline-flex; align-items: center; gap: 4px; font-size: 13px; color: var(--accent); }
  .pg-pages { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; counter-reset: page; padding: 0; margin: 10px 0; }
  .pg-pages li { counter-increment: page; font-size: 12.5px; border: 1px solid var(--border); border-radius: 8px; padding: 3px 8px; background: color-mix(in srgb, var(--text) 3%, var(--card)); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pg-pages li::before { content: counter(page) '. '; color: var(--text-dim); }
  .pg-pages li.pg-page-code { font-style: italic; color: var(--text-muted); }
  .pg-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .pg-actions form { margin: 0; }
  .pg-danger { color: var(--red, #e5484d); }
  .pg-builder { border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 16px; display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .pg-builder h3 { font-size: 15px; margin: 0; }
  .pg-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .pg-field > span { font-size: 13px; font-weight: 600; }
  .pg-field select { border: 1px solid var(--border); border-radius: 8px; padding: 7px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; min-width: 0; max-width: 100%; }
  .pg-rows { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; counter-reset: row; }
  .pg-row { display: grid; grid-template-columns: 22px minmax(0, 1fr) repeat(3, 28px); gap: 4px; align-items: center; counter-increment: row; }
  .pg-row::before { content: counter(row); font-size: 12px; color: var(--text-dim); text-align: center; }
  .pg-row select { width: 100%; }
  .pg-icon { display: inline-grid; place-items: center; width: 28px; height: 30px; border: 1px solid var(--border); border-radius: 8px; background: transparent; color: var(--text-muted); cursor: pointer; padding: 0; }
  .pg-icon:hover { border-color: var(--accent); color: var(--accent); }
  .pg-add { align-self: flex-start; margin-top: 4px; }
  .pg-check { display: flex; gap: 8px; align-items: flex-start; border: 1px solid var(--border); border-radius: 10px; padding: 9px 11px; cursor: pointer; }
  .pg-check:has(input:checked) { border-color: var(--green); background: var(--green-soft); }
  .pg-check input { margin-top: 3px; accent-color: var(--green); flex: none; }
  .pg-check b { display: block; font-size: 13.5px; }
  .pg-check em { display: block; font-style: normal; font-size: 12px; color: var(--text-dim); margin-top: 2px; }
  .pg-hint { font-size: 12.5px; color: var(--text-dim); margin: 0; }
  .pg-cmd { border-top: 1px solid var(--border); padding-top: 10px; }
  @media (max-width: 900px) {
    .pg-grid { grid-template-columns: minmax(0, 1fr); }
    .pg-builder { position: static; }
  }
</style>
