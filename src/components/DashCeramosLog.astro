---
// The movements of the ceramos of a person (/dash/ceramos): every daily, purchase, refund and gift of the team, newest first (the last 50), with the balance on top.
import DashMeLayout from './DashMeLayout.astro';
import DashPanelHead from './DashPanelHead.astro';
import DashCeramosNote from './DashCeramosNote.astro';
import DashShopShared from './DashShopShared.astro';
import { getDashLang, makeT } from '../i18n/dash';
import type { Session } from '../utils/session';

interface Move { delta: number; reason: string; ref: string | null; at: string }
interface Props { user: Session; balance: number | null; movements: Move[] | null }
const { user, balance, movements } = Astro.props;
const lang = getDashLang(Astro);
const dt = makeT(lang);
const when = new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
const reasons: Record<string, string> = {
  daily: dt('Daily reward'), badge: dt('Badge bought'), frame: dt('Frame bought'), banner: dt('Banner bought'), font: dt('Name font bought'), pack: dt('Pack bought'),
  purchase: dt('Pack of ceramos bought'), grant: dt('Gift from the team'), take: dt('Adjusted by the team'), refund: dt('Refund'),
};
const what = (move: Move): string => (move.ref ? move.ref.split(':')[0] : '');
---
<DashMeLayout user={user} active="movements" pageTitle="Ceramos movements">
  <DashShopShared />
  <DashPanelHead title={dt('Ceramos movements')} eyebrow={dt('Ceramos')} icon="ph:list-bullets-fill" back={false}>
    {balance !== null && <div class="bd-wallet"><span class="bd-bal"><i class="bd-coin"></i><b>{balance}</b></span></div>}
  </DashPanelHead>
  <DashCeramosNote />
  {!movements && <p class="bd-down" role="alert">{dt('Petto did not answer. Try again in a moment.')}</p>}
  {movements && movements.length === 0 && <p class="bd-empty">{dt('No movements yet. Claim your daily reward to start.')} <a href="/dash/daily">{dt('Daily reward')}</a></p>}
  {movements && movements.length > 0 && (
    <ul class="cl">
      {movements.map((move) => (
        <li class="bd-card cl-row">
          <div><strong>{reasons[move.reason] ?? move.reason}</strong>{what(move) && <span>{what(move)}</span>}</div>
          <time datetime={move.at}>{when.format(new Date(move.at))}</time>
          <b class:list={['cl-amount', { 'is-in': move.delta > 0 }]}>{move.delta > 0 ? '+' : '−'}{Math.abs(move.delta)}</b>
        </li>
      ))}
    </ul>
  )}
</DashMeLayout>

<style is:global>
  .cl { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .cl-row { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 14px; align-items: center; padding: 12px 16px; }
  .cl-row div { display: flex; flex-direction: column; gap: 2px; min-width: 0; } .cl-row span { color: var(--text-muted); font-size: 13px; overflow-wrap: anywhere; }
  .cl-row time { color: var(--text-muted); font-size: 13px; white-space: nowrap; }
  .cl-amount { font-size: 16px; min-width: 52px; text-align: right; color: var(--red-text); } .cl-amount.is-in { color: var(--green-text); }
  @media (max-width: 520px) { .cl-row { grid-template-columns: minmax(0, 1fr) auto; } .cl-row time { grid-column: 1; grid-row: 2; } .cl-amount { grid-row: 1 / span 2; grid-column: 2; align-self: center; } }
</style>
