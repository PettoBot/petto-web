---
import TicketEmoji from './TicketEmoji.astro';
import { getDashLang, makeT } from '../i18n/dash';
const dt = makeT(getDashLang(Astro));
interface Props {
  title?: string | null; description?: string | null; color?: string; imageUrl?: string; footer?: string; style?: string; placeholder?: string;
  types?: { label: string; emoji: string | null; description?: string | null; buttonStyle?: string }[];
  design?: string | null;
}
const { title = '', description = '', color = '', imageUrl = '', footer = '', style = 'button', placeholder = '', types = [], design = null } = Astro.props;
const stripe = /^#[0-9a-f]{6}$/i.test(color) ? color : '#a5ea7a';
const text = description || (types.length ? dt('Click a button below to open a ticket.') : '');
const styleOf = (s?: string) => (['secondary', 'success', 'danger'].includes(s ?? '') ? s : 'primary');
---
<div class="pv" data-panel-preview data-style={style} data-has-types={types.length ? '1' : ''}>
  <div class="pv-label">{dt('Preview')}</div>
  <div class="pv-msg">
    <div class="pv-who"><img src="/assets/mascot-icon.webp" alt="" width="24" height="24" /><b>Petto</b><span class="pv-app">APP</span></div>
    <div class="pv-card" style={`--pv-color:${stripe}`} data-pv-card>
      <img class="pv-banner" data-pv-image src={imageUrl || undefined} alt="" hidden={!imageUrl} referrerpolicy="no-referrer" />
      <p class="pv-title" data-pv-title>{title}</p>
      <p class="pv-desc" data-pv-desc>{text}</p>
      <p class="pv-foot" data-pv-foot hidden={!footer}>{footer}</p>
    </div>
    {design && <p class="pv-note">{dt('The saved design "{name}" decides how the message looks. This preview shows only the simple panel.', { name: design })}</p>}
    <div class="pv-buttons" data-pv-buttons>
      {types.length
        ? types.slice(0, 5).map((t) => <span class={`pv-btn pv-${styleOf(t.buttonStyle)}`}><TicketEmoji emoji={t.emoji} size={16} /> {t.label}</span>)
        : <span class="pv-none">{dt('No types yet, so there is nothing to click. Add one in Support types.')}</span>}
    </div>
    <div class="pv-select" data-pv-select>
      <span data-pv-placeholder>{placeholder || dt('Select a ticket category...')}</span><span class="pv-caret">⌄</span>
    </div>
    {types.length > 0 && <div class="pv-options" data-pv-options>
      {types.slice(0, 25).map((t) => <div class="pv-opt"><TicketEmoji emoji={t.emoji} size={18} /><span><b>{t.label}</b>{t.description && <small>{t.description}</small>}</span></div>)}
    </div>}
  </div>
</div>
<style>
  .pv { display: grid; gap: 8px; }
  .pv-label { font-family: var(--mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); }
  .pv-msg { border: 1px solid var(--border-soft); border-radius: 12px; padding: 12px; background: color-mix(in srgb, var(--text) 5%, var(--bg-raise)); display: grid; gap: 8px; min-width: 0; }
  .pv-who { display: flex; align-items: center; gap: 8px; font-size: 13.5px; }
  .pv-who img { width: 24px; height: 24px; border-radius: 50%; object-fit: cover; background: var(--card); }
  .pv-app { font-size: 9.5px; font-weight: 700; border-radius: 4px; padding: 1px 5px; background: var(--accent-soft); color: var(--accent); }
  .pv-card { border-left: 4px solid var(--pv-color); border-radius: 6px; background: var(--card); padding: 10px 12px; display: grid; gap: 6px; min-width: 0; }
  .pv-banner { width: 100%; max-height: 150px; object-fit: cover; border-radius: 6px; }
  .pv-title { margin: 0; font-weight: 700; font-size: 14.5px; overflow-wrap: anywhere; }
  .pv-title:empty { display: none; }
  .pv-desc { margin: 0; font-size: 13px; color: var(--text-muted); white-space: pre-wrap; overflow-wrap: anywhere; }
  .pv-desc:empty { display: none; }
  .pv-foot { margin: 2px 0 0; padding-top: 6px; border-top: 1px solid var(--border-soft); font-size: 11px; color: var(--text-dim); }
  .pv-note { margin: 0; font-size: 11.5px; color: var(--text-dim); font-style: italic; }
  .pv-buttons { display: flex; flex-wrap: wrap; gap: 6px; }
  .pv-btn { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; padding: 6px 12px; border-radius: 6px; color: #fff; }
  .pv-primary { background: #5865f2; }
  .pv-secondary { background: #4e5058; }
  .pv-success { background: #248046; }
  .pv-danger { background: #da373c; }
  .pv-none { font-size: 12px; color: var(--amber, #e0b15c); }
  .pv-select { display: none; justify-content: space-between; align-items: center; border: 1px solid var(--border); border-radius: 6px; background: var(--card); padding: 8px 12px; font-size: 13px; color: var(--text-muted); }
  .pv-options { border: 1px solid var(--border); border-radius: 8px; background: var(--card); padding: 4px; display: none; gap: 2px; max-height: 180px; overflow: auto; }
  .pv-opt { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: 6px; font-size: 13px; }
  .pv-opt small { display: block; font-size: 11px; color: var(--text-dim); }
  .pv[data-style="select"] [data-pv-buttons] { display: none; }
  .pv[data-style="select"] [data-pv-select] { display: flex; }
  .pv[data-style="select"] [data-pv-options] { display: grid; }
</style>
