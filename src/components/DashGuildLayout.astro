    // The page name in the bar over the content on a phone. It comes from the link's name (data-label), never from its text, which also
    // holds its "New" badge ("CountersNew").
    function setMenuLabel(link) {
      var menuLabel = document.getElementById('dgl-menu-label');
      if (menuLabel && link) menuLabel.textContent = link.getAttribute('data-label') || link.textContent.trim();
    }

    // Reading a page of the dashboard from a script. Only the content and its styles are asked for (X-Dash-Partial: the menu and the
    // scripts are already here), and the browser's own cache is used: the server answers 304 at once when the copy the browser has is
    // still current (same change stamp, see guildVersion.ts), so asking again costs almost nothing. The stamp of the answer comes back in
    // X-Dash-Version.
    function readPage(url, init) {
