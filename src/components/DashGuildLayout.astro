---
import { buildLabel, buildTitle } from '../utils/buildInfo';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import InlineIcon from './InlineIcon.astro';
import DashClientI18n from './DashClientI18n.astro';
import DashPreviews from './DashPreviews.astro';
import { useTranslations } from '../i18n/ui';
import { canManageGuild, guildIconUrl, getBotIdentity, getGuildList } from '../utils/discord';
import { getCachedUserGuilds, getCachedBotGuildIds } from '../utils/discordCache';
import { getEnv } from '../utils/env';
import { vanityConfig } from '../utils/vanityBot';
import { getPremiumGuildIds } from '../utils/premium';
import { isPettoOwner } from '../utils/premiumAdmin';
import { canUseQuests } from '../utils/questAccess';
import { canUseRollouts } from '../utils/rolloutAccess';
import { canUseCodeCommands } from '../utils/codeAccess';
import { getRoleAccess, pageDecision, pageOf } from '../utils/dashAccess';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  guildId: string;
  guildName: string;
  guildIcon: string;
  user: { userId?: string; username: string; avatar: string | null; accessToken?: string };
  active: string;
  pageTitle: string;
  premiumActive?: boolean;
}
const { guildId, guildName, guildIcon, user, active, pageTitle: rawPageTitle, premiumActive = false } = Astro.props;
// The server name as a CSS string (short, quotes and backslashes escaped) for the italic part of the page titles.
const cssString = (value: string) => `"${(value.length > 26 ? `${value.slice(0, 25).trimEnd()}…` : value).replace(/[\\"]/g, '\\$&').replace(/[\r\n]/g, ' ')}"`;
const pageTitle = dt(rawPageTitle);
// The roles Petto cannot give: @everyone, the ones an integration owns (bots, boosters) and the ones above its highest role. The pickers of
// roles that Petto hands out show them greyed out. Where the bot has not marked its own roles yet, nothing is claimed about the position.
async function loadRoleBlocks(serverId: string, token: string): Promise<Record<string, string>> {
  try {
    const res = await getGuildList(Astro, serverId, token, 'roles');
    if (!res.ok) return {};
    const roles: any[] = await res.json();
    const botTop = Math.max(-1, ...roles.filter((role) => role.mine === true).map((role) => Number(role.position)));
    const blocks: Record<string, string> = {};
    for (const role of roles) {
      const id = String(role.id);
      if (id === serverId) blocks[id] = 'everyone';
      else if (role.managed) blocks[id] = 'managed';
      else if (botTop >= 0 && Number(role.position) >= botTop) blocks[id] = 'above_bot';
    }
    return blocks;
  } catch { return {}; }
}
const botToken = getEnv(Astro, 'DISCORD_TOKEN');
// The premium snapshot, the visitor's servers, and the servers Petto is in do not depend on each
// other, so they load together instead of one after the other.
const [discordGuilds, activeBotGuildIds, botIdentity, roleBlocks] = await Promise.all([
  user.accessToken ? getCachedUserGuilds(user.accessToken, Astro.request) : Promise.resolve(null),
  user.accessToken && botToken ? getCachedBotGuildIds(botToken, Astro.request) : Promise.resolve(null),
  botToken ? getBotIdentity(guildId, botToken, Astro.request).catch(() => null) : Promise.resolve(null),
  botToken ? loadRoleBlocks(guildId, botToken) : Promise.resolve({} as Record<string, string>),
]);
// Premium belongs to the server, not to who bought it: every admin sees this server (and the ones in the switcher) as Premium.
const switchable = discordGuilds && activeBotGuildIds ? discordGuilds.filter(canManageGuild).filter((g: any) => activeBotGuildIds.has(g.id)).map((g: any) => g.id as string) : [];
const premiumGuildIds = user.userId ? await getPremiumGuildIds(Astro, user.userId, [guildId, ...switchable]) : new Set<string>();
// The database snapshot is authoritative. Do not trust a stale prop after a
// subscription is canceled, expires, or loses its server assignment.
const resolvedPremiumActive = premiumGuildIds.has(guildId);
// Someone who does not manage the server can still be let in by a role: they see only the parts their role opens.
const guildEntry = discordGuilds?.find((g: any) => g.id === guildId);
const isManager = Boolean(guildEntry && canManageGuild(guildEntry));
const roleAccess = guildEntry && !isManager && user.userId ? await getRoleAccess(Astro, guildId, user.userId) : null;
const pageAccess = roleAccess ? pageDecision(roleAccess, pageOf(Astro.url.pathname, guildId)) : null;
const accessNotice = ({ no_section: dt('Your role does not open that part of the dashboard.'), view_only: dt('Your role can look at that part but not change it.'), dev_readonly: dt('This is a read-only view of the server.') } as Record<string, string>)[Astro.url.searchParams.get('error') ?? ''] ?? null;
const roleBlockData = JSON.stringify({ blocks: roleBlocks, labels: { everyone: dt('everyone'), managed: dt('managed'), above_bot: dt('above the bot') } });

// Other servers Petto is already in, for the sidebar switcher dropdown, so picking a
// different server doesn't need a round trip through /dash/manage every time.
interface SwitcherGuild { id: string; name: string; icon: string | null; premium: boolean }
let switcherGuilds: SwitcherGuild[] = [];
let devView = false;
if (discordGuilds) {
  const manageable = discordGuilds.filter(canManageGuild);
  devView = Boolean(user.userId) && isPettoOwner(Astro, user.userId as string) && !manageable.some((g: any) => g.id === guildId);
  if (manageable.length > 0 && activeBotGuildIds) {
    switcherGuilds = manageable
      .filter((g: any) => activeBotGuildIds.has(g.id))
      .map((g: any) => ({ id: g.id, name: g.name, icon: guildIconUrl(g), premium: premiumGuildIds.has(g.id) }))
      .sort((a: SwitcherGuild, b: SwitcherGuild) => a.name.localeCompare(b.name));
  }
}

const t = useTranslations('en');
const categories = t.commandsPage.categories.filter((c) => c.id !== 'info');
const catById = Object.fromEntries(categories.map((c) => [c.id, c]));

const catIcon: Record<string, string> = {
  moderation: 'ph:shield-check-fill',
  // Keep this on the base Phosphor ticket glyph: it is present in every icon
  // bundle variant and avoids an empty icon if the filled alias is pruned.
  tickets: 'ph:ticket',
  leveling: 'ph:chart-line-up-fill',
  giveaways: 'ph:gift-fill',
  automation: 'ph:robot',
  community: 'ph:users-three-fill',
  onboarding: 'ph:hand-waving-fill',
  logging: 'ph:clipboard-text-fill',
  setup: 'ph:gear-fill',
};
const catLabel: Record<string, string> = { setup: dt('General'), onboarding: dt('Join Gate'), leveling: dt('Level Rewards') };

interface NavItem { id: string; href: string; icon: string; label: string; premium?: boolean; full?: boolean; isNew?: boolean; soon?: boolean; }

// The sections of the menu, each one in the group it belongs to.
const allGroups: { label: string; items: NavItem[] }[] = [
  {
    label: dt('Dashboard'),
    items: [
      { id: 'overview', href: `/dash/guild/${guildId}/overview`, icon: 'ph:squares-four-fill', label: dt('Overview') },
      { id: 'modules', href: `/dash/guild/${guildId}/modules`, icon: 'ph:puzzle-piece-fill', label: dt('Modules'), isNew: true },
      { id: 'stats', href: `/dash/guild/${guildId}/stats`, icon: 'ph:chart-bar-fill', label: dt('Statistics') },
      { id: 'setup', href: `/dash/guild/${guildId}/general?section=settings`, icon: catIcon.setup, label: dt('Settings') },
      { id: 'general-management', href: `/dash/guild/${guildId}/general?section=management`, icon: 'ph:file-code-fill', label: dt('Config Management') },
      { id: 'customize', href: `/dash/guild/${guildId}/customize`, icon: 'ph:sparkle-fill', label: dt('Customize') },
      { id: 'backups', href: `/dash/guild/${guildId}/backups`, icon: 'ph:archive-fill', label: dt('Backups') },
    ],
  },
  {
    label: dt('Design'),
    items: [
      { id: 'embeds', href: `/dash/guild/${guildId}/embeds`, icon: 'ph:chat-circle-dots-fill', label: dt('Embeds') },
      { id: 'cards', href: `/dash/guild/${guildId}/cards`, icon: 'ph:image-fill', label: dt('Image cards') },
    ],
  },
  {
    label: dt('Moderation'),
    items: [
      ...['moderation'].filter((id) => catById[id]).map((id) => ({
        id, href: `/dash/guild/${guildId}/${id}`, icon: catIcon[id], label: catLabel[id] ?? catById[id].title,
      })),
      { id: 'antinuke', href: `/dash/guild/${guildId}/antinuke`, icon: 'ph:siren-fill', label: dt('Anti-raid & nuke'), isNew: true },
      { id: 'antiscam', href: `/dash/guild/${guildId}/antiscam`, icon: 'ph:shield-warning-fill', label: dt('Anti scam'), isNew: true },
      { id: 'automod-templates', href: `/dash/guild/${guildId}/automod`, icon: 'ph:funnel-fill', label: dt('AutoMod templates'), isNew: true },
      { id: 'silent-channels', href: `/dash/guild/${guildId}/moderation?section=silent-channels`, icon: 'ph:speaker-slash-fill', label: dt('Silent Channels') },
      { id: 'warn-escalation', href: `/dash/guild/${guildId}/moderation?section=warn-escalation`, icon: 'ph:warning-fill', label: dt('Warn Escalation') },
      { id: 'sanction-messages', href: `/dash/guild/${guildId}/moderation?section=sanction-messages`, icon: 'ph:chat-text-fill', label: dt('Sanction Messages') },
      { id: 'active-sanctions', href: `/dash/guild/${guildId}/moderation?section=active`, icon: 'ph:gavel-fill', label: dt('Active sanctions'), isNew: true },
      { id: 'mod-stats', href: `/dash/guild/${guildId}/moderation?section=stats`, icon: 'ph:chart-line-up-fill', label: dt('Moderator stats'), isNew: true },
      { id: 'cases', href: `/dash/guild/${guildId}/moderation?section=cases`, icon: 'ph:clipboard-text-fill', label: dt('Case Log') },
    ],
  },
  {
    label: dt('Appeals'),
    items: [
      { id: 'appeals-overview', href: `/dash/guild/${guildId}/appeals?section=overview`, icon: 'ph:scales-fill', label: dt('Appeals'), isNew: true },
      { id: 'appeals-forms', href: `/dash/guild/${guildId}/appeals?section=forms`, icon: 'ph:list-checks-fill', label: dt('Appeal forms'), isNew: true },
      { id: 'appeals-submissions', href: `/dash/guild/${guildId}/appeals?section=submissions`, icon: 'ph:tray-fill', label: dt('Appeal submissions'), isNew: true },
      { id: 'appeals-settings', href: `/dash/guild/${guildId}/appeals?section=settings`, icon: 'ph:gear-six-fill', label: dt('Appeal settings'), isNew: true },
      { id: 'appeals-brand', href: `/dash/guild/${guildId}/appeals?section=brand`, icon: 'ph:paint-brush-broad-fill', label: dt('Appeal brand'), isNew: true },
      { id: 'appeals-messages', href: `/dash/guild/${guildId}/appeals?section=messages`, icon: 'ph:chat-teardrop-text-fill', label: dt('Appeal messages'), isNew: true },
    ],
  },
  {
    label: dt('Security'),
    items: [
      ...['onboarding'].filter((id) => catById[id]).map((id) => ({
        id, href: `/dash/guild/${guildId}/${id}`, icon: catIcon[id], label: catLabel[id] ?? catById[id].title,
      })),
      { id: 'security', href: `/dash/guild/${guildId}/security`, icon: 'ph:shield-warning-fill', label: dt('Security') },
      { id: 'security-unrestricted', href: `/dash/guild/${guildId}/security?section=unrestricted`, icon: 'ph:keyhole-fill', label: dt('Command Coverage') },
      { id: 'permissions', href: `/dash/guild/${guildId}/permissions`, icon: 'ph:key-fill', label: dt('Permissions') },
      ...(isManager ? [{ id: 'access', href: `/dash/guild/${guildId}/access`, icon: 'ph:user-gear-fill', label: dt('Dashboard access'), isNew: true }] : []),
      { id: 'audit', href: `/dash/guild/${guildId}/audit`, icon: 'ph:clock-counter-clockwise-fill', label: dt('Audit Log') },
      { id: 'logging', href: `/dash/guild/${guildId}/logging`, icon: catIcon.logging, label: dt('Logging') },
    ],
  },
  {
    label: dt('Leveling'),
    items: [
      { id: 'leveling', href: `/dash/guild/${guildId}/leveling?section=settings`, icon: 'ph:chart-line-up-fill', label: dt('Leveling') },
      { id: 'leveling-voice', href: `/dash/guild/${guildId}/leveling?section=voice`, icon: 'ph:headphones-fill', label: dt('Voice leveling') },
      { id: 'leveling-rank', href: `/dash/guild/${guildId}/leveling?section=rank`, icon: 'ph:identification-badge-fill', label: dt('Rank card') },
      { id: 'leveling-rules', href: `/dash/guild/${guildId}/leveling?section=rules`, icon: 'ph:shield-check-fill', label: dt('Rules and events') },
      { id: 'leveling-multipliers', href: `/dash/guild/${guildId}/leveling?section=multipliers`, icon: 'ph:rocket-launch-fill', label: dt('Multipliers') },
      { id: 'leveling-rewards', href: `/dash/guild/${guildId}/leveling?section=rewards`, icon: 'ph:trophy-fill', label: dt('Level Rewards') },
      { id: 'leveling-leaderboard', href: `/dash/guild/${guildId}/leveling?section=leaderboard`, icon: 'ph:ranking-fill', label: dt('Leaderboard'), isNew: true },
      { id: 'leveling-leaderboard-voice', href: `/dash/guild/${guildId}/leveling?section=leaderboard-voice`, icon: 'ph:ranking-fill', label: dt('Voice leaderboard') },
    ],
  },
  {
    label: dt('Automation'),
    items: [
      { id: 'automation-overview', href: `/dash/guild/${guildId}/automation?section=overview`, icon: 'ph:squares-four-fill', label: dt('Automation') },
      { id: 'custom-commands', href: `/dash/guild/${guildId}/automation?section=custom-commands`, icon: 'ph:terminal-window-fill', label: dt('Custom commands') },
      ...(canUseCodeCommands(Astro, user.userId) ? [{ id: 'code', href: `/dash/guild/${guildId}/code`, icon: 'ph:code-fill', label: dt('Commands in code'), full: true }] : []),
      { id: 'autoresponders', href: `/dash/guild/${guildId}/automation?section=autoresponders`, icon: 'ph:robot-fill', label: dt('Autoresponders') },
      { id: 'sticky-messages', href: `/dash/guild/${guildId}/automation?section=sticky-messages`, icon: 'ph:push-pin-fill', label: dt('Sticky Messages') },
      { id: 'reaction-roles', href: `/dash/guild/${guildId}/automation?section=reaction-roles`, icon: 'ph:smiley-fill', label: dt('Reaction Roles') },
      { id: 'reaction-messages', href: `/dash/guild/${guildId}/automation?section=reaction-messages`, icon: 'ph:chat-circle-dots-fill', label: dt('Message Reactions') },
      { id: 'reaction-triggers', href: `/dash/guild/${guildId}/automation?section=reaction-triggers`, icon: 'ph:smiley-fill', label: dt('Reaction Triggers') },
      { id: 'auto-threads', href: `/dash/guild/${guildId}/automation?section=auto-threads`, icon: 'ph:chats-circle-fill', label: 'Auto-threading' },
      { id: 'timers', href: `/dash/guild/${guildId}/automation?section=timers`, icon: 'ph:timer-fill', label: dt('Timers') },
      { id: 'aliases', href: `/dash/guild/${guildId}/automation?section=aliases`, icon: 'ph:command-fill', label: dt('Command Aliases') },
      { id: 'disabled-commands', href: `/dash/guild/${guildId}/automation?section=disabled-commands`, icon: 'ph:prohibit-fill', label: dt('Disabled Commands') },
      { id: 'bulk-role', href: `/dash/guild/${guildId}/bulk-role`, icon: 'ph:users-three-fill', label: dt('Roles') },
    ],
  },
  {
    label: dt('Community'),
    items: [
      { id: 'tickets', href: `/dash/guild/${guildId}/tickets?section=panels`, icon: catIcon.tickets, label: dt('Tickets') },
      { id: 'tickets-types', href: `/dash/guild/${guildId}/tickets?section=types`, icon: 'ph:ticket', label: dt('Support Types') },
      { id: 'tickets-forms', href: `/dash/guild/${guildId}/tickets?section=forms`, icon: 'ph:clipboard-text-fill', label: dt('Ticket Forms') },
      { id: 'tickets-access', href: `/dash/guild/${guildId}/tickets?section=access`, icon: 'ph:prohibit-fill', label: dt('Ticket Access') },
      { id: 'tickets-settings', href: `/dash/guild/${guildId}/tickets?section=settings`, icon: 'ph:gear-six-fill', label: dt('Ticket Settings') },
      { id: 'tickets-replies', href: `/dash/guild/${guildId}/tickets?section=replies`, icon: 'ph:chat-circle-text-fill', label: dt('Quick replies'), isNew: true },
      { id: 'tickets-ai', href: `/dash/guild/${guildId}/tickets?section=ai`, icon: 'ph:sparkle-fill', label: dt('Ticket AI'), soon: true },
      { id: 'tickets-open', href: `/dash/guild/${guildId}/tickets?section=open`, icon: 'ph:door-open-fill', label: dt('Open Tickets') },
      { id: 'giveaways', href: `/dash/guild/${guildId}/giveaways?section=settings`, icon: catIcon.giveaways, label: dt('Giveaways') },
      { id: 'giveaways-presets', href: `/dash/guild/${guildId}/giveaways?section=presets`, icon: 'ph:star-fill', label: dt('Giveaway Presets') },
      { id: 'giveaways-active', href: `/dash/guild/${guildId}/giveaways?section=active`, icon: 'ph:timer-fill', label: dt('Running Giveaways') },
      { id: 'community', href: `/dash/guild/${guildId}/community?section=settings`, icon: catIcon.community, label: dt('Community Settings') },
      { id: 'community-reputation', href: `/dash/guild/${guildId}/community?section=reputation`, icon: 'ph:medal-fill', label: dt('Reputation') },
      { id: 'community-boosters', href: `/dash/guild/${guildId}/community?section=boosters`, icon: 'ph:sparkle-fill', label: dt('Booster Roles') },
      { id: 'responders', href: `/dash/guild/${guildId}/responders`, icon: 'ph:list-checks-fill', label: dt('Buttons and panels') },
      { id: 'senders', href: `/dash/guild/${guildId}/senders`, icon: 'ph:user-circle-fill', label: dt('Message look') },
      { id: 'uploads', href: `/dash/guild/${guildId}/tools?section=uploads`, icon: 'ph:upload-simple-bold', label: dt('Uploads') },
      { id: 'requests', href: `/dash/guild/${guildId}/tools?section=requests`, icon: 'ph:ticket', label: dt('Requests') },
      { id: 'reviews', href: `/dash/guild/${guildId}/tools?section=reviews`, icon: 'ph:star-fill', label: dt('Reviews and profiles') },
      { id: 'partners', href: `/dash/guild/${guildId}/partners`, icon: 'ph:handshake-fill', label: dt('Partners') },
      { id: 'birthdays', href: `/dash/guild/${guildId}/birthdays`, icon: 'ph:cake-fill', label: dt('Birthdays'), isNew: true },
      { id: 'suggestions', href: `/dash/guild/${guildId}/suggestions`, icon: 'ph:lightbulb-fill', label: dt('Suggestions'), isNew: true },
      { id: 'confessions', href: `/dash/guild/${guildId}/confessions`, icon: 'ph:chat-circle-text-fill', label: dt('Confessions'), isNew: true },
      { id: 'counting', href: `/dash/guild/${guildId}/counting`, icon: 'ph:hash-fill', label: dt('Counting'), isNew: true },
      { id: 'community-polls', href: `/dash/guild/${guildId}/community?section=polls`, icon: 'ph:chart-bar-fill', label: dt('Polls') },
      { id: 'starboard', href: `/dash/guild/${guildId}/automation?section=starboard`, icon: 'ph:star-fill', label: dt('Starboard') },
      { id: 'monkeyboard', href: `/dash/guild/${guildId}/automation?section=monkeyboard`, icon: 'ph:smiley-fill', label: dt('Monkeyboard'), isNew: true },
      { id: 'voicemaster', href: `/dash/guild/${guildId}/automation?section=voicemaster`, icon: 'ph:headphones-fill', label: dt('VoiceMaster') },
      { id: 'sticky-roles', href: `/dash/guild/${guildId}/automation?section=sticky-roles`, icon: 'ph:arrow-counter-clockwise-fill', label: dt('Sticky roles') },
    ],
  },
  ...(canUseQuests(Astro, user.userId) ? [{
    label: dt('Quests'),
    items: [
      { id: 'quests', href: `/dash/guild/${guildId}/quests`, icon: 'ph:trophy-fill', label: dt('Quest alerts') },
    ],
  }] : []),
  ...(canUseRollouts(Astro, user.userId) ? [{
    label: dt('Rollouts'),
    items: [
      { id: 'rollouts', href: `/dash/guild/${guildId}/rollouts`, icon: 'ph:flask-fill', label: dt('Rollout alerts') },
    ],
  }] : []),
  ...(vanityConfig(Astro) ? [{
    label: dt('Vanity roles'),
    items: [
      { id: 'vanity', href: `/dash/guild/${guildId}/vanity?section=rules`, icon: 'ph:sparkle-fill', label: dt('Vanity rules') },
      { id: 'vanity-tags', href: `/dash/guild/${guildId}/vanity?section=tags`, icon: 'ph:tag-fill', label: dt('Server Tag rules') },
      { id: 'vanity-messages', href: `/dash/guild/${guildId}/vanity?section=messages`, icon: 'ph:chat-circle-dots-fill', label: dt('Thank-you messages') },
      { id: 'vanity-logs', href: `/dash/guild/${guildId}/vanity?section=logs`, icon: 'ph:clipboard-text-fill', label: dt('Vanity logs') },
    ],
  }] : []),
  {
    label: dt('Integrations'),
    items: [
      { id: 'webhooks', href: `/dash/guild/${guildId}/automation?section=webhooks`, icon: 'ph:webhooks-logo-fill', label: dt('Webhooks') },
      { id: 'counters', href: `/dash/guild/${guildId}/automation?section=counters`, icon: 'ph:chart-line-up-fill', label: dt('Counters') },
    ],
  },
];

// A role only sees the parts of the menu it opens.
const groups = roleAccess
  ? allGroups
      .map((group) => ({ ...group, items: group.items.filter((item) => pageDecision(roleAccess, pageOf(item.href.split('?')[0], guildId)).allowed) }))
      .filter((group) => group.items.length > 0)
  : allGroups;

const stableInlineItems = new Set([
  'customize',
  'community-boosters',
  'leveling',
  'leveling-voice',
  'leveling-leaderboard',
  'leveling-leaderboard-voice',
  'vanity',
  'vanity-tags',
  'vanity-messages',
  'vanity-logs',
]);
const activeNavItem = groups.flatMap((g) => g.items).find((item) => item.id === active);
---
<Base title={`${pageTitle} · ${guildName} · Petto`} active="dash" appShell>
  <main>
    <section class="dgl-sec">
      <div class="wrap dgl-wrap">
        <div class="dgl-layout">
          <div class="dgl-menu-bar">
            <button type="button" class="dgl-menu-btn" id="dgl-menu-btn" aria-controls="dgl-side" aria-expanded="false" aria-label={dt('Open the menu')}>
              <Icon name="ph:list" width="20" height="20" />
            </button>
            <span class="dgl-menu-label" id="dgl-menu-label">{activeNavItem?.label ?? pageTitle}</span>
          </div>
          <script type="application/json" id="dgl-role-blocks" set:html={roleBlockData}></script>
          <div class="dgl-backdrop" id="dgl-backdrop" hidden></div>
          <aside class="dgl-side reveal" id="dgl-side">
            <button type="button" class="dgl-side-close" id="dgl-side-close" aria-label={dt('Close the menu')}><Icon name="ph:x" width="16" height="16" /></button>
            <div class="dgl-switcher-wrap">
              <button type="button" class="dgl-switcher" id="dgl-switcher-btn" aria-expanded="false">
                <img src={guildIcon} alt="" />
                <div class="dgl-switcher-text">
                  <span class="dgl-switcher-eyebrow">{dt('Server')}</span>
                  <span class="dgl-switcher-name-row"><span class="dgl-switcher-name">{guildName}</span>{resolvedPremiumActive && <span class="dgl-server-premium"><InlineIcon name="ph:crown-fill" width="11" height="11" />Premium</span>}</span>
                </div>
                <Icon name="ph:caret-up-down" width="13" height="13" />
              </button>
              <div class="dgl-switcher-panel" id="dgl-switcher-panel" hidden>
                {switcherGuilds.length > 0 && (
                  <div class="dgl-switcher-list">
                    {switcherGuilds.map((g) => (
                      <a href={`/dash/guild/${g.id}/overview`} class:list={['dgl-switcher-item', { current: g.id === guildId }]}>
                        {g.icon ? <img src={g.icon} alt="" /> : <div class="dgl-switcher-item-fallback"><Icon name="ph:buildings-fill" width="14" height="14" /></div>}
                        <span>{g.name}</span>
                        {g.premium && <span class="dgl-switcher-premium"><InlineIcon name="ph:crown-fill" width="11" height="11" />Premium</span>}
                        {g.id === guildId && <Icon name="ph:check-fill" width="13" height="13" />}
                      </a>
                    ))}
                  </div>
                )}
                <a href="/dash/manage" class="dgl-switcher-all">
                  <Icon name="ph:squares-four-fill" width="14" height="14" />
                  {dt('Manage all servers')}
                </a>
