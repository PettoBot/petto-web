    }

    // Keep the next dashboard section ready while the user is deciding where to go.
    // A pointer that only passes over the menu does not fetch anything: the page is asked for after it rests on a link for
    // 80 ms, and at most two of those reads run at once (a click never waits for that limit).
    // A page read ahead is used while the server's stamp is still the one it was read with (and for a minute at most: a few parts,
    // like statistics, change without a stamp). Otherwise it is read again, which is a cheap 304 when nothing changed.
    var prefetchedPages = new Map();
    var PREFETCH_MAX_AGE_MS = 60000;
    var HOVER_DELAY_MS = 80;
    var MAX_HOVER_PREFETCHES = 2;
    var hoverPrefetches = 0;
    function prefetchUsable(entry) {
      return entry && Date.now() - entry.at < PREFETCH_MAX_AGE_MS && (!entry.version || !isNewer(latestVersion, entry.version));
    }
    function prefetchPage(href, fromHover) {
      if (dirtyForm) return;
      var entry = prefetchedPages.get(href);
      if (entry && (entry.pending || prefetchUsable(entry))) return;
      if (fromHover && hoverPrefetches >= MAX_HOVER_PREFETCHES) return;
      if (fromHover) hoverPrefetches += 1;
      var done = function () { if (fromHover) hoverPrefetches -= 1; };
      var fresh = { at: Date.now(), version: '', pending: true, request: null };
