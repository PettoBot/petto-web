    // Live updates. The server pushes the change stamp of this server (/events, Server-Sent Events); when it is newer than what is on
    // screen, the page is read again and redrawn right where the person was (same scroll), but only while nothing is being edited:
    // otherwise it waits until the edit is saved or dropped. Nothing is read when nothing changed. Without the stream (a proxy that
    // closes it or holds it back, an old browser) the stamp is asked every 12 seconds; a hidden tab asks nothing and checks once when it comes back.
    var refreshing = false;
    var refreshQueued = false;
    // `onlyIfChanged` (the checks of a live page, below): the copy that comes back is drawn only when it differs from the one on screen.
    function refreshCurrent(force, onlyIfChanged) {
      if (refreshing) { if (!onlyIfChanged) refreshQueued = true; return; }
      if (!force && !isNewer(latestVersion, shownVersion())) return;
      if (!pageIsIdle()) { if (!onlyIfChanged) waitForIdle(); return; }
      refreshing = true;
      var href = window.location.pathname + window.location.search;
      var wanted = latestVersion;
      readPage(href)
        .then(function (answer) {
          if (!answer.ok || href !== window.location.pathname + window.location.search || !pageIsIdle()) { if (answer.ok && !onlyIfChanged) waitForIdle(); return; }
          var shown = document.getElementById('dgl-content');
          if (onlyIfChanged && shown && answer.etag && answer.etag === shown.getAttribute('data-dash-etag')) return;
          var body = answer.html.replace(/ data-dash-etag="[^"]*"/, '');
          if (onlyIfChanged && liveHtml.href === href && liveHtml.body === body) { if (shown && answer.etag) shown.setAttribute('data-dash-etag', answer.etag); return; }
          if (!onlyIfChanged && drawnHtml.href === href && drawnHtml.body === comparable(answer.html)) { setShownVersion(answer.version || wanted); return; }
          liveHtml = { href: href, body: body };
          // On a wide screen the content scrolls inside its own panel, on a phone the window does: both places are kept.
          var y = window.scrollY;
