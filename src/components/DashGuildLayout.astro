    }

    // True when nothing on the page is being edited, so it can be redrawn without losing what the person is doing.
    function pageIsIdle() {
      if (dirtyForm || document.hidden) return false;
      if (document.querySelector('.dgl-selmenu, dialog[open], [data-modal-open]')) return false;
      var active = document.activeElement;
      var content = document.getElementById('dgl-content');
      // data-dash-hold holds the live update until the person is done, so it is not closed or emptied under them: a fold while it is
      // open, a field while it has something typed that was not sent yet (a search), anything else (a form a script opened) while it
      // is on the page.
      var holds = content ? content.querySelectorAll('[data-dash-hold]') : [];
      for (var i = 0; i < holds.length; i++) {
        var hold = holds[i];
