<script>
  // @ts-nocheck: plain browser JavaScript, written before this was a bundled script.
  // The dashboard's own behaviour (navigation without reloading, saving, live updates, menus...). A bundled script, so the browser
  // keeps it (it used to be sent inline, about 80 KB, with every page). It runs once per full page load, after the page is parsed.

  // The menu is never taller than the page next to it: the page's height is told to the layout (--dgl-panel-h) and the menu's list scrolls
  // when it is longer. The page is not changed by the menu, so there is no loop.
  (function () {
    var panel = document.getElementById('dgl-content');
    var layout = panel && panel.closest('.dgl-layout');
    if (!panel || !layout || !window.ResizeObserver) return;
    var tell = function () { layout.style.setProperty('--dgl-panel-h', panel.offsetHeight + 'px'); };
    new ResizeObserver(tell).observe(panel);
    tell();
  })();

  // "Sync server data": the bot saves its copy of the server now, then the page is read again so new roles and channels show up in the lists.
  document.addEventListener('click', function (event) {
    var button = event.target && event.target.closest ? event.target.closest('#dgl-resync') : null;
    if (!button || button.disabled) return;
    var label = button.querySelector('span');
    var original = label ? label.textContent : '';
    var say = function (text) { if (label) label.textContent = text; };
    button.disabled = true;
    button.classList.add('busy');
    say(button.getAttribute('data-busy') || '');
    fetch(button.getAttribute('data-url'), { method: 'POST', credentials: 'same-origin', headers: { Accept: 'application/json' } })
      .then(function (response) { return response.ok ? response.json() : Promise.reject(new Error('failed')); })
      .then(function () {
        button.classList.remove('busy');
        say(button.getAttribute('data-done') || '');
        // The page is read again in place (the lists now have the new roles and channels), without reloading it.
        setTimeout(function () {
          if (window.dglRefreshPage) window.dglRefreshPage(true); else window.location.reload();
          button.disabled = false;
          setTimeout(function () { say(original); }, 2500);
        }, 300);
      })
      .catch(function () {
        button.classList.remove('busy');
        button.disabled = false;
        say(button.getAttribute('data-failed') || original);
        setTimeout(function () { say(original); }, 3500);
      });
  });


  // Support mode (the Petto owner on a server he does not manage, utils/supportEdit.ts). The banner carries the policy of the page: the
  // actions its forms may send (per tab). A form that sends anything else is not sent (the server refuses it too, this is only the
  // courtesy), and the banner's own remove button asks before it leaves the server.
  function supportPolicy() {
