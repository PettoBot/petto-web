        keepSymbols(fresh);
        current.replaceWith(fresh);
        executeScripts(fresh);
        runHeadScripts(doc.head);
        initContent(fresh);
        if (window.PettoLevelingInit) window.PettoLevelingInit(fresh);
        if (window.PettoVoiceLevelingInit) window.PettoVoiceLevelingInit(fresh);
        if (window.PettoRankPreviewInit) window.PettoRankPreviewInit(fresh);
        if (pushUrl) window.history.pushState({ dglAjax: true }, '', pushUrl);
        drawnHtml = { href: window.location.pathname + window.location.search, body: comparable(html) };
        // Moving to another section starts at the very top of the page, so its title shows under the sticky header (and, on a phone,
        // under the bar with the menu button): scrolling the content box "into view" placed it under those bars. A save keeps the
        // place the person was at, and only brings the section back if it is entirely off screen. `instant`: the page's smooth
        // scrolling must not animate these jumps.
        if (pushUrl) { fresh.scrollTop = 0; window.scrollTo({ top: 0, left: 0, behavior: 'instant' }); }
        else if (!keepScroll && fresh.getBoundingClientRect().bottom < 0) fresh.scrollIntoView({ block: 'start', behavior: 'instant' });
