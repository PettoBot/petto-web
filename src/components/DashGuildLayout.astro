<style is:global>
  /* ---- motion and touch of the whole dashboard ---- */
  /* A tap on a phone must not flash a grey or orange box over the control: the control answers with its own press instead. */
  .dgl-sec a, .dgl-sec button, .dgl-sec summary, .dgl-sec label, .dgl-sec select, .dgl-sec [role="button"], .dgl-sec [role="tab"] { -webkit-tap-highlight-color: transparent; }
  .dgl-sec summary { -webkit-user-select: none; user-select: none; }
  .dgl-sec button, .dgl-sec summary, .dgl-sec .btn { touch-action: manipulation; }
  .dgl-content .btn { transition: transform .14s cubic-bezier(.3, 1, .4, 1), background-color .18s ease, border-color .18s ease, color .18s ease, box-shadow .2s ease, opacity .18s ease; }
  .dgl-content .btn:active:not(:disabled) { transform: scale(.97); }
  /* A button that says "Saving..." keeps its width and cuts a long word instead of growing out of its row. */
  .dgl-busy { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* The notices of the pages ("Saved.", warnings) never leave the content width: long words wrap, the icon keeps its size. */
  .dgl-content :is([class$="-flash"], [class*="-flash "]) { max-width: 100%; box-sizing: border-box; overflow-wrap: anywhere; min-width: 0; scroll-margin-top: calc(var(--dash-sticky, 72px) + 12px); }
  .dgl-content :is([class$="-flash"], [class*="-flash "]) > * { min-width: 0; }
  .dgl-content :is([class$="-flash"], [class*="-flash "]) > svg { flex-shrink: 0; }
  /* The page finder (Ctrl+K). */
  .dgl-pal-veil { position: fixed; inset: 0; z-index: 1200; display: flex; justify-content: center; align-items: flex-start; padding: min(14vh, 120px) 16px 16px; background: rgba(10, 8, 6, .55); animation: m-fade-in var(--m-base) var(--m-out) both; }
  .dgl-pal-veil[hidden] { display: none; }
  .dgl-pal { width: min(520px, 100%); max-height: min(70vh, 520px); display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--border); border-radius: 16px; background: var(--card); box-shadow: 0 30px 80px -20px rgba(0, 0, 0, .7); animation: m-dialog-in var(--m-slow) var(--m-out) both; }
  .dgl-pal-field { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border-bottom: 1px solid var(--border-soft); color: var(--text-dim); }
  .dgl-pal-field input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--text); font: inherit; font-size: 15px; box-shadow: none !important; }
  .dgl-pal-field kbd { font: 600 10px var(--mono); padding: 2px 6px; border-radius: 6px; border: 1px solid var(--border); }
  .dgl-pal-list { overflow-y: auto; overscroll-behavior: contain; padding: 6px; }
  .dgl-pal-row { display: flex; align-items: center; gap: 10px; min-height: 40px; padding: 8px 10px; border-radius: 10px; color: var(--text-muted); font-size: 13.5px; cursor: pointer; }
  .dgl-pal-row svg { flex-shrink: 0; color: var(--text-dim); }
  .dgl-pal-row span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dgl-pal-row small { font-family: var(--mono); font-size: 10px; letter-spacing: .05em; text-transform: uppercase; color: var(--text-dim); }
  .dgl-pal-row.on { background: var(--accent-soft); color: var(--text); }
  .dgl-pal-row.on svg, .dgl-pal-row.here svg { color: var(--accent); }
  .dgl-pal-empty { padding: 22px 12px; text-align: center; color: var(--text-dim); font-size: 13px; }
  @media (prefers-reduced-motion: reduce) { .dgl-pal-veil, .dgl-pal { animation: none; } }
  /* Long names, links, IDs and code a member or the bot wrote wrap inside their box instead of pushing the page sideways on a phone. */
  .dgl-content { overflow-wrap: break-word; }
  .dgl-content :is(p, li, dd, td, small, em, label, h2, h3) :is(code, kbd, a) { overflow-wrap: anywhere; }
  /* The chips of a searchable select take the width of the select and cut a long channel or role name, instead of widening the card. */
  .dgl-content .dgl-ms-chips { contain: inline-size; }
  .dgl-content .dgl-ms-chip { min-width: 0; }
  /* A status, badge or hint inside a section heading is helper text: the body font, not the serif of the title (zero specificity, so a
     component that sets its own font, like the mono counts, keeps it). */
  :where(.dgl-content :is(h2, h3)) :where(small, em, [class*="-status"], [class*="-badge"], [class*="-tag"], [class*="-hint"], [class*="-note"], [class*="-pill"]) { font-family: var(--sans); }
  /* The page under the open drawer does not scroll (and keeps its place). */
  html.dgl-drawer-open, html.dgl-drawer-open body { overflow: hidden; }
  /* The Save button of a form that the bar of unsaved changes already saves. */
  .dgl-bar-save { display: none !important; }
  /* The invisible area that makes a small control easy to hit (see bindTapTargets). */
  .dgl-tap-rel { position: relative; }
  .dgl-tap::after { content: ''; position: absolute; top: calc(var(--tap-y, 0px) * -1); bottom: calc(var(--tap-y, 0px) * -1); left: calc(var(--tap-x, 0px) * -1); right: calc(var(--tap-x, 0px) * -1); }
  /* A fold: while it slides, its content stays inside; the content fades in after it opens (also when a script opens it). */
  .dgl-content details > summary { cursor: pointer; transition: background-color .18s ease, color .18s ease; }
  .dgl-content details.is-closing > *:not(summary) { animation: dgl-close 150ms var(--m-in) both; }
  .dgl-content details > summary > svg, .dgl-content details > summary .caret, .dgl-content details > summary .chevron { transition: transform .28s cubic-bezier(.3, 1, .4, 1); }
  @keyframes dgl-open { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  @keyframes dgl-close { from { opacity: 1; transform: none; } to { opacity: 0; transform: translateY(-4px); } }
  /* Pickers, tabs and the lists that open under a control. */
  [data-panel]:not([hidden]) { animation: dgl-open .26s cubic-bezier(.2, .8, .2, 1) both; }
  @keyframes dgl-pop { from { opacity: 0; transform: translateY(-4px) scale(.98); } to { opacity: 1; transform: none; } }
  .dgl-tab { transition: color .18s ease, background-color .18s ease, border-color .18s ease, transform .14s ease; }
  .dgl-tab:active { transform: scale(.97); }
  @media (prefers-reduced-motion: reduce) {
    .dgl-content details.is-closing > *:not(summary), .dgl-ms-dropdown:not([hidden]), [data-panel]:not([hidden]) { animation: none; }
    .dgl-content .btn { transition: none; }
  }
  @media (max-width: 880px) {
    .dgl-content .am-heading, .dgl-content .dm-head, .dgl-content .pg-prefix-card { align-items: stretch; flex-direction: column; }
    .dgl-content .am-overview-link { align-self: flex-start; }
    .dgl-content .pg-prefix-examples { justify-content: flex-start; }
    .dgl-content .am-feature-actions, .dgl-content .tk-panel-actions, .dgl-content .tk-panel-move { width: 100%; flex-wrap: wrap; }
    .dgl-content .am-feature-actions > form, .dgl-content .tk-panel-actions > form, .dgl-content .tk-panel-move > form { flex: 1 1 auto; }
    .dgl-content .am-feature-actions .btn, .dgl-content .tk-panel-actions .btn, .dgl-content .tk-panel-move .btn { justify-content: center; width: 100%; }

    .dgl-content .am-add-row, .dgl-content .tk-add-form, .dgl-content .tk-panel-row, .dgl-content .dl-add-row, .dgl-content .md-add-row, .dgl-content .ob-jr-add { align-items: stretch; }
    .dgl-content .am-add-row > *, .dgl-content .tk-add-form > *, .dgl-content .tk-panel-row > *, .dgl-content .dl-add-row > *, .dgl-content .md-add-row > *, .dgl-content .ob-jr-add > * { min-width: 0; flex: 1 1 100%; }
    .dgl-content .am-add-row .dgl-cp-wrap, .dgl-content .tk-add-form .btn, .dgl-content .dl-add-row .btn, .dgl-content .md-add-row .btn, .dgl-content .ob-jr-add .btn { flex-basis: auto; }

    .dgl-content .br-grid, .dgl-content .cm-row-pair, .dgl-content .cz-form-grid, .dgl-content .gw-grid, .dgl-content .lv-grid, .dgl-content .dl-grid, .dgl-content .ob-grid { grid-template-columns: 1fr; }
    .dgl-content .cz-layout { grid-template-columns: 1fr; gap: 24px; }
    .dgl-content .cz-preview { position: static; }
    .dgl-content .dgo-metric-grid { grid-template-columns: 1fr 1fr; }
    .dgl-content .dgo-top-grid { grid-template-columns: 1fr; }
    .dgl-content .dgo-top-cols, .dgl-content .dgo-top-row { grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(42px, .7fr)); gap: 6px; }
    .dgl-content .dgo-top-cols { font-size: 9px; }
    .dgl-content .dgo-top-row { font-size: 11.5px; }
  }

  /* Support mode (the Petto owner on a server he does not manage): a form that cannot be saved there looks read-only, with no save button. */
  .dgl-support .dgl-dev-text span + span { margin-top: 4px; }
  form[data-support-ro] button[type="submit"], form[data-support-ro] button:not([type]) { display: none; }
