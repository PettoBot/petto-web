---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import InlineIcon from './InlineIcon.astro';
import { useTranslations } from '../i18n/ui';
import { canManageGuild, guildIconUrl } from '../utils/discord';
import { getCachedUserGuilds, getCachedBotGuildIds } from '../utils/discordCache';
import { getEnv } from '../utils/env';
import { getPremiumSnapshot } from '../utils/premium';

interface Props {
  guildId: string;
  guildName: string;
  guildIcon: string;
  user: { userId?: string; username: string; avatar: string | null; accessToken?: string };
  active: string;
  pageTitle: string;
  premiumActive?: boolean;
}
const { guildId, guildName, guildIcon, user, active, pageTitle, premiumActive = false } = Astro.props;
const premiumSnapshot = user.userId ? await getPremiumSnapshot(Astro, user.userId) : null;
const premiumGuildIds = new Set(premiumSnapshot?.assignments.map((assignment) => assignment.guild_id) ?? []);
const resolvedPremiumActive = premiumGuildIds.has(guildId) && Boolean(premiumSnapshot?.status === 'active');

interface SwitcherGuild { id: string; name: string; icon: string | null; premium: boolean }
let switcherGuilds: SwitcherGuild[] = [];
if (user.accessToken) {
  const botToken = getEnv(Astro, 'DISCORD_TOKEN');
  const discordGuilds = await getCachedUserGuilds(user.accessToken);
  const manageable = discordGuilds.filter(canManageGuild);
  if (manageable.length > 0 && botToken) {
    const activeIds = await getCachedBotGuildIds(botToken);
    switcherGuilds = manageable
      .filter((g: any) => activeIds.has(g.id))
      .map((g: any) => ({ id: g.id, name: g.name, icon: guildIconUrl(g), premium: premiumGuildIds.has(g.id) }))
      .sort((a: SwitcherGuild, b: SwitcherGuild) => a.name.localeCompare(b.name));
  }
}

const t = useTranslations('en');
const categories = t.commandsPage.categories.filter((c) => c.id !== 'info');
const catById = Object.fromEntries(categories.map((c) => [c.id, c]));

const catIcon: Record<string, string> = {
  moderation: 'ph:shield-check-fill',
  tickets: 'ph:ticket',
  leveling: 'ph:chart-line-up-fill',
  giveaways: 'ph:gift-fill',
  automation: 'ph:robot',
  community: 'ph:users-three-fill',
  onboarding: 'ph:hand-waving-fill',
  logging: 'fi-sr-clipboard-list',
  setup: 'ph:gear-fill',
};
const catLabel: Record<string, string> = { setup: 'General', onboarding: 'Join Gate', leveling: 'Level Rewards' };

interface NavItem { id: string; href: string; icon: string; label: string; uicon?: boolean; premium?: boolean; }

const groups: { label: string; items: NavItem[] }[] = [
  {
    label: 'Dashboard',
    items: [
      { id: 'overview', href: `/dash/guild/${guildId}/overview`, icon: 'ph:squares-four-fill', label: 'Overview' },
      { id: 'setup', href: `/dash/guild/${guildId}/general?section=settings`, icon: catIcon.setup, label: 'Settings' },
      { id: 'general-management', href: `/dash/guild/${guildId}/general?section=management`, icon: 'ph:file-code-fill', label: 'Config Management' },
      { id: 'customize', href: `/dash/guild/${guildId}/customize`, icon: 'ph:sparkle-fill', label: 'Customize', premium: true },
      { id: 'embeds', href: `/dash/guild/${guildId}/embeds`, icon: 'ph:chat-circle-dots-fill', label: 'Embeds' },
      { id: 'backups', href: `/dash/guild/${guildId}/backups`, icon: 'ph:archive-fill', label: 'Backups' },
    ],
  },
  {
    label: 'Security',
    items: [
      ...['moderation', 'onboarding'].filter((id) => catById[id]).map((id) => ({
        id, href: `/dash/guild/${guildId}/${id}`, icon: catIcon[id], uicon: id === 'logging', label: catLabel[id] ?? catById[id].title,
      })),
      { id: 'silent-channels', href: `/dash/guild/${guildId}/moderation?section=silent-channels`, icon: 'ph:speaker-slash-fill', label: 'Silent Channels' },
      { id: 'warn-escalation', href: `/dash/guild/${guildId}/moderation?section=warn-escalation`, icon: 'ph:warning-fill', label: 'Warn Escalation' },
      { id: 'cases', href: `/dash/guild/${guildId}/moderation?section=cases`, icon: 'ph:clipboard-text-fill', label: 'Case Log' },
      { id: 'permissions', href: `/dash/guild/${guildId}/permissions`, icon: 'ph:key-fill', label: 'Permissions' },
      { id: 'security', href: `/dash/guild/${guildId}/security`, icon: 'ph:shield-warning-fill', label: 'Security' },
      { id: 'security-unrestricted', href: `/dash/guild/${guildId}/security?section=unrestricted`, icon: 'ph:keyhole-fill', label: 'Command Coverage' },
      { id: 'audit', href: `/dash/guild/${guildId}/audit`, icon: 'ph:clock-counter-clockwise-fill', label: 'Audit Log' },
    ],
  },
  {
    label: 'Configuration',
    items: [
      { id: 'bulk-role', href: `/dash/guild/${guildId}/bulk-role`, icon: 'ph:users-three-fill', label: 'Roles' },
      { id: 'custom-commands', href: `/dash/guild/${guildId}/automation?section=custom-commands`, icon: 'ph:chat-circle-dots-fill', label: 'Messages' },
      { id: 'starboard', href: `/dash/guild/${guildId}/automation?section=starboard`, icon: 'ph:star-fill', label: 'Starboard' },
      { id: 'voicemaster', href: `/dash/guild/${guildId}/automation?section=voicemaster`, icon: 'ph:headphones-fill', label: 'VoiceMaster' },
      { id: 'leveling', href: `/dash/guild/${guildId}/leveling?section=settings`, icon: 'ph:chart-line-up-fill', label: 'Leveling' },
      { id: 'leveling-voice', href: `/dash/guild/${guildId}/leveling?section=voice`, icon: 'ph:headphones-fill', label: 'Voice leveling' },
      { id: 'leveling-rewards', href: `/dash/guild/${guildId}/leveling?section=rewards`, icon: 'ph:trophy-fill', label: 'Level Rewards' },
      { id: 'leveling-leaderboard', href: `/dash/guild/${guildId}/leveling?section=leaderboard`, icon: 'ph:ranking-fill', label: 'Leaderboard' },
      { id: 'leveling-leaderboard-voice', href: `/dash/guild/${guildId}/leveling?section=leaderboard-voice`, icon: 'ph:ranking-fill', label: 'Voice leaderboard' },
      { id: 'reaction-triggers', href: `/dash/guild/${guildId}/automation?section=reaction-triggers`, icon: 'ph:smiley-fill', label: 'Reaction Triggers' },
      { id: 'aliases', href: `/dash/guild/${guildId}/automation?section=aliases`, icon: 'ph:command-fill', label: 'Command Aliases' },
      { id: 'logging', href: `/dash/guild/${guildId}/logging`, icon: catIcon.logging, uicon: true, label: 'Logging' },
    ],
  },
  {
    label: 'Automation',
    items: [
      { id: 'automation-overview', href: `/dash/guild/${guildId}/automation?section=overview`, icon: 'ph:squares-four-fill', label: 'Automation' },
      { id: 'autoresponders', href: `/dash/guild/${guildId}/automation?section=autoresponders`, icon: 'ph:robot-fill', label: 'Autoresponders' },
      { id: 'sticky-messages', href: `/dash/guild/${guildId}/automation?section=sticky-messages`, icon: 'ph:push-pin-fill', label: 'Sticky Messages' },
      { id: 'reaction-roles', href: `/dash/guild/${guildId}/automation?section=reaction-roles`, icon: 'ph:smiley-fill', label: 'Reaction Roles' },
      { id: 'reaction-messages', href: `/dash/guild/${guildId}/automation?section=reaction-messages`, icon: 'ph:chat-circle-dots-fill', label: 'Message Reactions' },
      { id: 'auto-threads', href: `/dash/guild/${guildId}/automation?section=auto-threads`, icon: 'ph:chats-circle-fill', label: 'Auto-threading' },
      { id: 'timers', href: `/dash/guild/${guildId}/automation?section=timers`, icon: 'ph:timer-fill', label: 'Timers' },
      { id: 'disabled-commands', href: `/dash/guild/${guildId}/automation?section=disabled-commands`, icon: 'ph:prohibit-fill', label: 'Disabled Commands' },
    ],
  },
  {
    label: 'Community',
    items: [
      { id: 'tickets', href: `/dash/guild/${guildId}/tickets?section=panels`, icon: catIcon.tickets, label: 'Tickets' },
      { id: 'tickets-types', href: `/dash/guild/${guildId}/tickets?section=types`, icon: 'ph:ticket', label: 'Support Types' },
      { id: 'tickets-forms', href: `/dash/guild/${guildId}/tickets?section=forms`, icon: 'ph:clipboard-text-fill', label: 'Ticket Forms' },
      { id: 'tickets-access', href: `/dash/guild/${guildId}/tickets?section=access`, icon: 'ph:prohibit-fill', label: 'Ticket Access' },
      { id: 'tickets-settings', href: `/dash/guild/${guildId}/tickets?section=settings`, icon: 'ph:gear-six-fill', label: 'Ticket Settings' },
      { id: 'tickets-open', href: `/dash/guild/${guildId}/tickets?section=open`, icon: 'ph:door-open-fill', label: 'Open Tickets' },
      { id: 'giveaways', href: `/dash/guild/${guildId}/giveaways?section=settings`, icon: catIcon.giveaways, label: 'Giveaways' },
      { id: 'giveaways-presets', href: `/dash/guild/${guildId}/giveaways?section=presets`, icon: 'ph:star-fill', label: 'Giveaway Presets' },
      { id: 'giveaways-active', href: `/dash/guild/${guildId}/giveaways?section=active`, icon: 'ph:timer-fill', label: 'Running Giveaways' },
      { id: 'community', href: `/dash/guild/${guildId}/community?section=settings`, icon: catIcon.community, label: 'Community Settings' },
      { id: 'community-reputation', href: `/dash/guild/${guildId}/community?section=reputation`, icon: 'ph:medal-fill', label: 'Reputation' },
      { id: 'community-boosters', href: `/dash/guild/${guildId}/community?section=boosters`, icon: 'ph:sparkle-fill', label: 'Booster Roles' },
      { id: 'community-polls', href: `/dash/guild/${guildId}/community?section=polls`, icon: 'ph:chart-bar-fill', label: 'Polls' },
    ],
  },
  {
    label: 'Integrations',
    items: [
      { id: 'webhooks', href: `/dash/guild/${guildId}/automation?section=webhooks`, icon: 'ph:webhooks-logo-fill', label: 'Webhooks' },
      { id: 'counters', href: `/dash/guild/${guildId}/automation?section=counters`, icon: 'ph:chart-line-up-fill', label: 'Counters' },
    ],
  },
];

const stableInlineItems = new Set([
  'customize',
  'community-boosters',
  'leveling',
  'leveling-voice',
  'leveling-leaderboard',
  'leveling-leaderboard-voice',
]);
const activeNavItem = groups.flatMap((g) => g.items).find((item) => item.id === active);
---
<Base title={`${pageTitle} · ${guildName} · Petto`} active="dash" appShell>
  <main>
    <section class="dgl-sec">
      <div class="wrap dgl-wrap">
        <div class="dgl-layout">
          <aside class="dgl-side reveal">
            <div class="dgl-switcher-wrap">
              <button type="button" class="dgl-switcher" id="dgl-switcher-btn" aria-expanded="false">
                <img src={guildIcon} alt="" />
                <div class="dgl-switcher-text">
                  <span class="dgl-switcher-eyebrow">Server</span>
                  <span class="dgl-switcher-name-row"><span class="dgl-switcher-name">{guildName}</span>{resolvedPremiumActive && <span class="dgl-server-premium"><InlineIcon name="ph:crown-fill" width="11" height="11" />Premium</span>}</span>
                </div>
                <Icon name="ph:caret-up-down" width="13" height="13" />
              </button>
              <div class="dgl-switcher-panel" id="dgl-switcher-panel" hidden>
                {switcherGuilds.length > 0 && (
                  <div class="dgl-switcher-list">
                    {switcherGuilds.map((g) => (
                      <a href={`/dash/guild/${g.id}/overview`} class:list={['dgl-switcher-item', { current: g.id === guildId }]}>
                        {g.icon ? <img src={g.icon} alt="" /> : <div class="dgl-switcher-item-fallback"><Icon name="ph:buildings-fill" width="14" height="14" /></div>}
                        <span>{g.name}</span>
                        {g.premium && <span class="dgl-switcher-premium"><InlineIcon name="ph:crown-fill" width="11" height="11" />Premium</span>}
                        {g.id === guildId && <Icon name="ph:check-fill" width="13" height="13" />}
                      </a>
                    ))}
                  </div>
                )}
                <a href="/dash/manage" class="dgl-switcher-all">
                  <Icon name="ph:squares-four-fill" width="14" height="14" />
                  Manage all servers
                </a>
              </div>
            </div>

            <button type="button" class="dgl-mobile-toggle" id="dgl-mobile-toggle" aria-expanded="false">
              <span>
                {activeNavItem?.uicon ? <i class={`dgl-uicon fi ${activeNavItem.icon}`} aria-hidden="true" /> : stableInlineItems.has(activeNavItem?.id ?? '') ? <InlineIcon name={activeNavItem?.icon ?? 'ph:squares-four-fill'} width="15" height="15" /> : <Icon name={activeNavItem?.icon ?? 'ph:squares-four-fill'} width="15" height="15" />}
                {activeNavItem?.label ?? pageTitle}
              </span>
              <Icon name="ph:caret-down" width="14" height="14" class="dgl-mobile-toggle-caret" />
            </button>

            <nav class="dgl-nav" id="dgl-sidenav">
              {groups.map((group) => (
                <div class="dgl-group">
                  <div class="dgl-label">{group.label}</div>
                  {group.items.map((item) => (
                    <a href={item.href} class:list={['dgl-link', { active: active === item.id }]} aria-label={item.premium && !resolvedPremiumActive ? `${item.label}, Premium required` : undefined}>
                      {item.uicon ? <i class={`dgl-uicon fi ${item.icon}`} aria-hidden="true" /> : stableInlineItems.has(item.id) ? <InlineIcon name={item.icon} width="15" height="15" /> : <Icon name={item.icon} width="15" height="15" />}
                      {item.label}
                {item.premium && <InlineIcon name="ph:crown-fill" width="12" height="12" class="dgl-premium-crown" />}
                    </a>
                  ))}
                </div>
              ))}
            </nav>

            <div class="dgl-side-user">
              {user.avatar ? <img src={user.avatar} alt="" /> : <div class="dgl-side-user-fallback"><Icon name="ph:user-fill" width="14" height="14" /></div>}
              <span>{user.username}</span>
              <a href="/dash/logout" title="Log out"><Icon name="ph:sign-out-fill" width="14" height="14" /></a>
            </div>
          </aside>

          <div class="dgl-content reveal" id="dgl-content">
            <slot />
          </div>
        </div>
      </div>
    </section>
  </main>

  <div class="dgl-progress" id="dgl-progress"></div>

  <div class="dgl-savebar" id="dgl-savebar" role="status" aria-live="polite">
    <Icon name="ph:floppy-disk-fill" width="18" height="18" class="dgl-savebar-icon" />
    <span class="dgl-savebar-text">You have unsaved changes</span>
    <div class="dgl-savebar-actions">
      <button type="button" class="dgl-savebar-discard" data-savebar-discard>Discard</button>
      <button type="button" class="dgl-savebar-save" data-savebar-save>
        <Icon name="ph:check-fill" width="14" height="14" />
        Save changes
      </button>
    </div>
  </div>
</Base>

<script is:inline>
  (function () {
    function bindUploadLabels(root) {
      root.querySelectorAll('input[type="file"]').forEach((input) => {
        if (input.dataset.labelBound) return;
        input.dataset.labelBound = '1';
        var label = input.closest('label');
        var span = label ? label.querySelector('span') : null;
        var defaultText = span ? span.textContent : '';
        input.addEventListener('change', function () {
          if (span) span.textContent = (input.files && input.files[0] ? input.files[0].name : defaultText);
        });
      });
    }

    function bindFocusButtons(root) {
      root.querySelectorAll('[data-focus]').forEach((btn) => {
        if (btn.dataset.focusBound) return;
        btn.dataset.focusBound = '1';
        btn.addEventListener('click', function () {
          var target = root.querySelector('#' + btn.dataset.focus);
          if (!target) return;
          target.scrollIntoView({ block: 'center', behavior: 'smooth' });
          target.focus({ preventScroll: true });
        });
      });
    }

    function bindResetButtons(root) {
      root.querySelectorAll('[data-reset]').forEach((btn) => {
        if (btn.dataset.resetBound) return;
        btn.dataset.resetBound = '1';
        btn.addEventListener('click', function () {
          btn.dataset.reset.split(',').forEach(function (id) {
            var el = root.querySelector('#' + id.trim());
            if (el) el.value = '';
          });
        });
      });
    }

    var dirtyForm = null;
    var resettingForm = false;
    var saveBar = document.getElementById('dgl-savebar');
    var saveBarBtn = saveBar ? saveBar.querySelector('[data-savebar-save]') : null;
    var discardBtn = saveBar ? saveBar.querySelector('[data-savebar-discard]') : null;

    function showSaveBar() { if (saveBar) saveBar.classList.add('show'); }
    function hideSaveBar() { if (saveBar) saveBar.classList.remove('show'); dirtyForm = null; }
    function shakeSaveBar() {
      if (!saveBar) return;
      saveBar.classList.add('show');
      saveBar.classList.remove('shake');
      void saveBar.offsetWidth;
      saveBar.classList.add('shake');
    }

    function bindDirtyTracking(root) {
      root.querySelectorAll('form').forEach(function (form) {
        if (form.dataset.dirtyBound) return;
        form.dataset.dirtyBound = '1';
        if ((form.getAttribute('enctype') || '').indexOf('multipart') !== -1) return;
        form.addEventListener('input', function () {
          if (resettingForm) return;
          dirtyForm = form;
          showSaveBar();
        });
        form.addEventListener('change', function () {
          if (resettingForm) return;
          dirtyForm = form;
          showSaveBar();
        });
      });
    }

    if (saveBarBtn) saveBarBtn.addEventListener('click', function () {
      if (!dirtyForm) return;
      if (dirtyForm.requestSubmit) dirtyForm.requestSubmit();
      else dirtyForm.submit();
    });
    if (discardBtn) discardBtn.addEventListener('click', function () {
      if (dirtyForm) {
        var form = dirtyForm;
        resettingForm = true;
        try {
          form.reset();
          form.querySelectorAll('[data-multiselect] input[type="checkbox"]').forEach(function (cb) {
            cb.dispatchEvent(new Event('change', { bubbles: true }));
          });
          form.querySelectorAll('[data-colorpicker]').forEach(function (picker) {
            var valueInput = picker.querySelector('[data-cp-value]');
            var hexInput = picker.querySelector('[data-cp-hex]');
            if (valueInput && hexInput) {
              hexInput.value = valueInput.value;
              hexInput.dispatchEvent(new Event('change', { bubbles: true }));
            }
          });
        } finally {
          resettingForm = false;
        }
      }
      hideSaveBar();
    });

    window.addEventListener('beforeunload', function (e) {
      if (dirtyForm) { e.preventDefault(); e.returnValue = ''; }
    });

    function bindSwitcherMenu() {
      var btn = document.getElementById('dgl-switcher-btn');
      var panel = document.getElementById('dgl-switcher-panel');
      if (!btn || !panel) return;
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        if (dirtyForm) { shakeSaveBar(); return; }
        var isOpen = !panel.hidden;
        panel.hidden = !isOpen ? false : true;
        btn.classList.toggle('open', !isOpen);
        btn.setAttribute('aria-expanded', String(!isOpen));
      });
      document.addEventListener('click', function (e) {
        if (!panel.hidden && !panel.contains(e.target) && e.target !== btn && !btn.contains(e.target)) {
          panel.hidden = true;
          btn.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    }
    bindSwitcherMenu();

    var mobileToggle = document.getElementById('dgl-mobile-toggle');
    var dglSide = document.querySelector('.dgl-side');
    mobileToggle?.addEventListener('click', function () {
      var isOpen = dglSide?.classList.contains('open');
      dglSide?.classList.toggle('open', !isOpen);
      mobileToggle.setAttribute('aria-expanded', String(!isOpen));
    });
    document.querySelectorAll('.dgl-nav').forEach(function (nav) {
      nav.addEventListener('click', function (e) {
        if (e.target.closest('a')) dglSide?.classList.remove('open');
      });
    });

    function bindNavGuard(root) {
      root.querySelectorAll('.dgl-link, .dgl-switcher-item, .dgl-switcher-all, .dgl-side-user a').forEach(function (a) {
        if (a.dataset.navGuardBound) return;
        a.dataset.navGuardBound = '1';
        a.addEventListener('click', function (e) {
          if (dirtyForm) { e.preventDefault(); shakeSaveBar(); }
        });
      });
    }

    var progressEl = document.getElementById('dgl-progress');
    var progressFillAnim = null;
    var progressHideTimer = null;
    var MIN_PROGRESS_MS = 450;
    var progressStartedAt = 0;
    function startProgress() {
      if (!progressEl) return;
      progressStartedAt = Date.now();
      clearTimeout(progressHideTimer);
      if (progressFillAnim) progressFillAnim.cancel();
      progressEl.style.opacity = '1';
      progressEl.style.width = '0%';
      progressFillAnim = progressEl.animate(
        [{ width: '0%' }, { width: '78%' }],
        { duration: MIN_PROGRESS_MS + 250, easing: 'cubic-bezier(0.1, 0.7, 0.2, 1)', fill: 'forwards' },
      );
    }
    function finishProgress() {
      if (!progressEl) return;
      var elapsed = Date.now() - progressStartedAt;
      var wait = Math.max(0, MIN_PROGRESS_MS - elapsed);
      setTimeout(function () {
        if (progressFillAnim) progressFillAnim.cancel();
        progressEl.style.width = '100%';
        progressHideTimer = setTimeout(function () {
          progressEl.style.opacity = '0';
          progressEl.style.width = '0%';
        }, 220);
      }, wait);
    }

    function syncHeadAssets(freshHead) {
      var existingHrefs = new Set();
      document.querySelectorAll('head link[rel="stylesheet"]').forEach(function (l) { existingHrefs.add(l.href); });
      var stylesheetLoads = [];
      freshHead.querySelectorAll('link[rel="stylesheet"]').forEach(function (link) {
        if (existingHrefs.has(link.href)) return;
        var clone = link.cloneNode(true);
        stylesheetLoads.push(new Promise(function (resolve) {
          var settled = false;
          function done() { if (settled) return; settled = true; resolve(); }
          clone.addEventListener('load', done, { once: true });
          clone.addEventListener('error', done, { once: true });
          window.setTimeout(done, 1800);
          document.head.appendChild(clone);
        }));
      });
      var existingStyleText = new Set();
      document.querySelectorAll('head style').forEach(function (s) { existingStyleText.add(s.textContent); });
      freshHead.querySelectorAll('style').forEach(function (style) {
        if (!existingStyleText.has(style.textContent)) document.head.appendChild(style.cloneNode(true));
      });
      return Promise.all(stylesheetLoads);
    }

    var executedScriptSrcs = new Set();
    document.querySelectorAll('script[src]').forEach(function (s) { executedScriptSrcs.add(s.src); });
    function executeScripts(container) {
      container.querySelectorAll('script').forEach(function (oldScript) {
        if (oldScript.src) {
          if (executedScriptSrcs.has(oldScript.src)) return;
          executedScriptSrcs.add(oldScript.src);
        }
        var newScript = document.createElement('script');
        for (var i = 0; i < oldScript.attributes.length; i++) {
          newScript.setAttribute(oldScript.attributes[i].name, oldScript.attributes[i].value);
        }
        newScript.textContent = oldScript.textContent;
        oldScript.replaceWith(newScript);
      });
    }

    function swapContent(html, pushUrl) {
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var fresh = doc.getElementById('dgl-content');
      var current = document.getElementById('dgl-content');
      if (!fresh || !current) return Promise.resolve(false);
      return syncHeadAssets(doc.head).then(function () {
        fresh.classList.add('in');
        current.replaceWith(fresh);
        executeScripts(fresh);
        initContent(fresh);
        if (window.PettoLevelingInit) window.PettoLevelingInit(fresh);
        if (window.PettoVoiceLevelingInit) window.PettoVoiceLevelingInit(fresh);
        if (pushUrl) window.history.pushState({ dglAjax: true }, '', pushUrl);
        fresh.scrollIntoView({ block: 'nearest' });
        return true;
      });
    }

    function updateActiveLink(href) {
      document.querySelectorAll('.dgl-link').forEach(function (a) {
        a.classList.toggle('active', a.getAttribute('href') === href);
      });
      var toggleSpan = document.querySelector('#dgl-mobile-toggle span');
      var activeLink = document.querySelector('.dgl-link[href="' + href + '"]');
      if (toggleSpan && activeLink) toggleSpan.innerHTML = activeLink.innerHTML;
    }

    var prefetchedPages = new Map();
    function prefetchPage(href) {
      if (dirtyForm || prefetchedPages.has(href)) return;
      var request = fetch(href, { method: 'GET' })
        .then(function (res) {
          if (!res.ok) throw new Error('prefetch failed');
          return res.text();
        })
        .catch(function () {
          prefetchedPages.delete(href);
          return null;
        });
      prefetchedPages.set(href, request);
    }
    function getPageHtml(href) {
      if (!prefetchedPages.has(href)) prefetchPage(href);
      var request = prefetchedPages.get(href);
      return request || fetch(href, { method: 'GET' }).then(function (res) { return res.text(); });
    }

    function bindDglLinks(root) {
      root.querySelectorAll('.dgl-link').forEach(function (a) {
        if (a.dataset.dglNavBound) return;
        a.dataset.dglNavBound = '1';
        var href = a.getAttribute('href');
        if (href) {
          a.addEventListener('mouseenter', function () { prefetchPage(href); }, { passive: true });
          a.addEventListener('focus', function () { prefetchPage(href); }, { passive: true });
        }
        a.addEventListener('click', function (e) {
          if (dirtyForm) { e.preventDefault(); shakeSaveBar(); return; }
          if (!href) return;
          e.preventDefault();
          startProgress();
          getPageHtml(href)
            .then(function (html) {
              if (!html) throw new Error('navigation failed');
              return swapContent(html, href);
            })
            .then(function (ok) {
              if (ok) { updateActiveLink(href); finishProgress(); }
              else window.location.href = href;
            })
            .catch(function () { window.location.href = href; });
        });
      });
    }

    function bindQueryLinks(root) {
      root.querySelectorAll('a[href^="?"], a[href^="' + window.location.pathname + '?"]').forEach((a) => {
        if (a.dataset.ajaxBound) return;
        a.dataset.ajaxBound = '1';
        a.addEventListener('click', function (e) {
          if (dirtyForm) { e.preventDefault(); shakeSaveBar(); return; }
          e.preventDefault();
          var url = a.getAttribute('href');
          startProgress();
          fetch(url, { method: 'GET' })
            .then(function (res) { return res.text(); })
            .then(function (html) {
              return swapContent(html, url);
            })
            .then(function (ok) {
              if (ok) { updateActiveLink(url); finishProgress(); }
              else window.location.href = url;
            })
            .catch(function () { window.location.href = url; });
        });
      });
    }

    function bindForms(root) {
      root.querySelectorAll('form[method="POST" i]').forEach((form) => {
        if (form.dataset.ajaxBound) return;
        if ((form.getAttribute('enctype') || '').indexOf('multipart') !== -1) return;
        form.dataset.ajaxBound = '1';
        form.addEventListener('submit', function (e) {
          var submitter = e.submitter;
          var confirmMsg = submitter && submitter.dataset ? submitter.dataset.confirm : null;
          if (confirmMsg && !window.confirm(confirmMsg)) { e.preventDefault(); return; }
          e.preventDefault();
          var btn = submitter && submitter.tagName === 'BUTTON' ? submitter : form.querySelector('button[type="submit"]');
          var originalText = btn ? btn.textContent : null;
          if (btn) { btn.disabled = true; btn.textContent = 'Saving...'; }
          if (saveBarBtn && dirtyForm === form) { saveBarBtn.disabled = true; }
          startProgress();

          var fd = submitter ? new FormData(form, submitter) : new FormData(form);
          fetch(window.location.pathname + window.location.search, { method: 'POST', body: fd })
            .then(function (res) { return res.text(); })
            .then(function (html) {
              return swapContent(html, null);
            })
            .then(function (ok) {
              if (ok) {
                prefetchedPages.clear();
                hideSaveBar();
              }
              if (!ok && btn) { btn.disabled = false; btn.textContent = originalText; }
              if (saveBarBtn) saveBarBtn.disabled = false;
              finishProgress();
            })
            .catch(function () {
              if (btn) { btn.disabled = false; btn.textContent = originalText; }
              if (saveBarBtn) saveBarBtn.disabled = false;
              finishProgress();
            });
        });
      });
    }

    function bindFilterLists(root) {
      root.querySelectorAll('[data-filterable]').forEach((wrap) => {
        if (wrap.dataset.filterBound) return;
        wrap.dataset.filterBound = '1';
        var input = wrap.querySelector('[data-filter-input]');
        var list = wrap.querySelector('[data-filter-list]');
        if (!input || !list) return;
        input.addEventListener('input', function () {
          var q = input.value.trim().toLowerCase();
          list.querySelectorAll('label').forEach(function (label) {
            label.style.display = !q || label.textContent.toLowerCase().indexOf(q) !== -1 ? '' : 'none';
          });
        });
      });
    }

    function bindConfigPreview(root) {
      root.querySelectorAll('[data-config-preview]').forEach((pre) => {
        if (pre.dataset.previewBound) return;
        pre.dataset.previewBound = '1';
        var url = pre.dataset.configPreview;
        var code = pre.querySelector('code');
        fetch(url)
          .then(function (res) { return res.ok ? res.text() : Promise.reject(); })
          .then(function (text) { if (code) code.textContent = text; })
          .catch(function () { if (code) code.textContent = "Couldn't load the preview, try refreshing."; });
      });
    }

    function bindVarMenus(root) {
      root.querySelectorAll('[data-varmenu]').forEach((wrap) => {
        if (wrap.dataset.varmenuBound) return;
        wrap.dataset.varmenuBound = '1';
        var btn = wrap.querySelector('[data-varmenu-toggle]');
        var panel = wrap.querySelector('[data-varmenu-panel]');
        if (!btn || !panel) return;

        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          var isOpen = !panel.hidden;
          document.querySelectorAll('[data-varmenu-panel]').forEach((p) => { p.hidden = true; });
          document.querySelectorAll('.dgl-varbtn.open').forEach((b) => b.classList.remove('open'));
          if (!isOpen) {
            var r = btn.getBoundingClientRect();
            panel.style.position = 'fixed';
            panel.style.top = Math.min(r.bottom + 6, window.innerHeight - 20) + 'px';
            panel.style.left = Math.min(r.left, window.innerWidth - 316) + 'px';
            panel.hidden = false;
            btn.classList.add('open');
          }
        });

        panel.querySelectorAll('[data-var-token]').forEach((row) => {
          row.addEventListener('click', function () {
            var tok = row.dataset.varToken;
            var reset = function () { row.classList.remove('copied'); };
            (navigator.clipboard && navigator.clipboard.writeText ? navigator.clipboard.writeText(tok) : Promise.reject())
              .then(function () { row.classList.add('copied'); setTimeout(reset, 1200); })
              .catch(function () {});
          });
        });
      });
    }

    document.addEventListener('click', function (e) {
      document.querySelectorAll('[data-varmenu-panel]').forEach((p) => {
        if (!p.hidden && !p.closest('[data-varmenu]').contains(e.target)) p.hidden = true;
      });
      document.querySelectorAll('.dgl-varbtn.open').forEach((b) => {
        if (!b.closest('[data-varmenu]').contains(e.target)) b.classList.remove('open');
      });
    });

    function bindMultiSelects(root) {
      root.querySelectorAll('[data-multiselect]').forEach((wrap) => {
        if (wrap.dataset.msBound) return;
        wrap.dataset.msBound = '1';

        var chips = wrap.querySelector('[data-ms-chips]');
        var input = wrap.querySelector('[data-ms-input]');
        var control = wrap.querySelector('[data-ms-control]');
        var dropdown = wrap.querySelector('[data-ms-dropdown]');
        if (!chips || !input || !control || !dropdown) return;

        function checkboxes() {
          return Array.prototype.slice.call(wrap.querySelectorAll('[data-ms-option] input[type="checkbox"]'));
        }

        function openDropdown() {
          dropdown.hidden = false;
          wrap.classList.add('open');
        }
        function closeDropdown() {
          dropdown.hidden = true;
          wrap.classList.remove('open');
        }

        function render() {
          chips.innerHTML = '';
          var anyVisible = false;
          var q = input.value.trim().toLowerCase();

          checkboxes().forEach(function (cb) {
            var option = cb.closest('[data-ms-option]');
            var label = option.querySelector('span').textContent;

            if (cb.checked) {
              option.classList.add('dgl-ms-selected');
              var chip = document.createElement('span');
              chip.className = 'dgl-ms-chip';
              var chipLabel = document.createElement('span');
              chipLabel.textContent = label;
              var remove = document.createElement('button');
              remove.type = 'button';
              remove.className = 'dgl-ms-chip-remove';
              remove.setAttribute('aria-label', 'Remove ' + label);
              remove.innerHTML = '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M18 6 6 18M6 6l12 12"/></svg>';
              remove.addEventListener('click', function (e) {
                e.stopPropagation();
                cb.checked = false;
                cb.dispatchEvent(new Event('change', { bubbles: true }));
              });
              chip.appendChild(chipLabel);
              chip.appendChild(remove);
              chips.appendChild(chip);
            } else {
              option.classList.remove('dgl-ms-selected');
              var matches = !q || label.toLowerCase().indexOf(q) !== -1;
              option.classList.toggle('dgl-ms-nomatch', !matches);
              if (matches) anyVisible = true;
            }
          });

          var empty = dropdown.querySelector('.dgl-ms-empty');
          if (!anyVisible) {
            if (!empty) {
              empty = document.createElement('div');
              empty.className = 'dgl-ms-empty';
              empty.textContent = 'No matches.';
              dropdown.appendChild(empty);
            }
          } else if (empty) {
            empty.remove();
          }
        }

        checkboxes().forEach(function (cb) {
          cb.addEventListener('change', render);
        });
        input.addEventListener('input', render);
        input.addEventListener('focus', openDropdown);
        control.addEventListener('click', function () {
          input.focus();
          openDropdown();
        });
        wrap.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') closeDropdown();
        });
        document.addEventListener('click', function (e) {
          if (!wrap.contains(e.target)) closeDropdown();
        });

        render();
      });
    }

    function bindColorPickers(root) {
      root.querySelectorAll('[data-colorpicker]').forEach(function (wrap) {
        if (wrap.dataset.cpBound) return;
        wrap.dataset.cpBound = '1';

        var trigger = wrap.querySelector('[data-cp-trigger]');
        var valueInput = wrap.querySelector('[data-cp-value]');
        var swatch = wrap.querySelector('[data-cp-swatch]');
        var hexLabel = wrap.querySelector('[data-cp-hexlabel]');
        var panel = wrap.querySelector('[data-cp-panel]');
        var svWrap = wrap.querySelector('.dgl-cp-sv-wrap');
        var svCanvas = wrap.querySelector('[data-cp-sv]');
        var svThumb = wrap.querySelector('[data-cp-sv-thumb]');
        var hueWrap = wrap.querySelector('.dgl-cp-hue-wrap');
        var hueCanvas = wrap.querySelector('[data-cp-hue]');
        var hueThumb = wrap.querySelector('[data-cp-hue-thumb]');
        var hexInput = wrap.querySelector('[data-cp-hex]');
        var rInput = wrap.querySelector('[data-cp-r]');
        var gInput = wrap.querySelector('[data-cp-g]');
        var bInput = wrap.querySelector('[data-cp-b]');
        var resetBtn = wrap.querySelector('[data-cp-reset]');
        var presetBtns = Array.prototype.slice.call(wrap.querySelectorAll('[data-cp-preset]'));
        if (!trigger || !valueInput || !svCanvas || !hueCanvas) return;

        var svCtx = svCanvas.getContext('2d');
        var hueCtx = hueCanvas.getContext('2d');
        var W = svCanvas.width, H = svCanvas.height, HUEW = hueCanvas.width;
        var state = { h: 230, s: 0.5, v: 0.5 };

        function clamp(n, lo, hi) { return Math.min(hi, Math.max(lo, n)); }

        function hexToRgb(hex) {
          var m = /^#?([0-9a-f]{6})$/i.exec(hex || '');
          if (!m) return null;
          var n = parseInt(m[1], 16);
          return { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 };
        }
        function rgbToHex(r, g, b) {
          return '#' + [r, g, b].map(function (c) { return clamp(Math.round(c), 0, 255).toString(16).padStart(2, '0'); }).join('').toUpperCase();
        }
        function rgbToHsv(r, g, b) {
          r /= 255; g /= 255; b /= 255;
          var max = Math.max(r, g, b), min = Math.min(r, g, b), d = max - min;
          var h = 0;
          if (d !== 0) {
            if (max === r) h = ((g - b) / d) % 6;
            else if (max === g) h = (b - r) / d + 2;
            else h = (r - g) / d + 4;
            h *= 60;
            if (h < 0) h += 360;
          }
          return { h: h, s: max === 0 ? 0 : d / max, v: max };
        }
        function hsvToRgb(h, s, v) {
          var c = v * s, x = c * (1 - Math.abs((h / 60) % 2 - 1)), m = v - c;
          var r, g, b;
          if (h < 60) { r = c; g = x; b = 0; }
          else if (h < 120) { r = x; g = c; b = 0; }
          else if (h < 180) { r = 0; g = c; b = x; }
          else if (h < 240) { r = 0; g = x; b = c; }
          else if (h < 300) { r = x; g = 0; b = c; }
          else { r = c; g = 0; b = x; }
          return { r: (r + m) * 255, g: (g + m) * 255, b: (b + m) * 255 };
        }

        function drawSV() {
          var hueRgb = hsvToRgb(state.h, 1, 1);
          svCtx.clearRect(0, 0, W, H);
          svCtx.fillStyle = 'rgb(' + Math.round(hueRgb.r) + ',' + Math.round(hueRgb.g) + ',' + Math.round(hueRgb.b) + ')';
          svCtx.fillRect(0, 0, W, H);
          var whiteGrad = svCtx.createLinearGradient(0, 0, W, 0);
          whiteGrad.addColorStop(0, 'rgba(255,255,255,1)');
          whiteGrad.addColorStop(1, 'rgba(255,255,255,0)');
          svCtx.fillStyle = whiteGrad;
          svCtx.fillRect(0, 0, W, H);
          var blackGrad = svCtx.createLinearGradient(0, 0, 0, H);
          blackGrad.addColorStop(0, 'rgba(0,0,0,0)');
          blackGrad.addColorStop(1, 'rgba(0,0,0,1)');
          svCtx.fillStyle = blackGrad;
          svCtx.fillRect(0, 0, W, H);
        }

        function drawHue() {
          var grad = hueCtx.createLinearGradient(0, 0, HUEW, 0);
          ['#ff0000', '#ffff00', '#00ff00', '#00ffff', '#0000ff', '#ff00ff', '#ff0000'].forEach(function (c, i, arr) {
            grad.addColorStop(i / (arr.length - 1), c);
          });
          hueCtx.fillStyle = grad;
          hueCtx.fillRect(0, 0, HUEW, hueCanvas.height);
        }

        function positionThumbs() {
          svThumb.style.left = (state.s * W) + 'px';
          svThumb.style.top = ((1 - state.v) * H) + 'px';
          hueThumb.style.left = (state.h / 360 * HUEW) + 'px';
        }

        function syncFields(hex, rgb) {
          hexLabel.textContent = hex;
          swatch.style.setProperty('--sw', hex);
          valueInput.value = hex;
          if (document.activeElement !== hexInput) hexInput.value = hex;
          if (document.activeElement !== rInput) rInput.value = Math.round(rgb.r);
          if (document.activeElement !== gInput) gInput.value = Math.round(rgb.g);
          if (document.activeElement !== bInput) bInput.value = Math.round(rgb.b);
          valueInput.dispatchEvent(new Event('input', { bubbles: true }));
        }

        function applyState(redrawHue) {
          var rgb = hsvToRgb(state.h, state.s, state.v);
          var hex = rgbToHex(rgb.r, rgb.g, rgb.b);
          if (redrawHue) drawSV();
          positionThumbs();
          syncFields(hex, rgb);
        }

        function setFromHex(hex) {
          var rgb = hexToRgb(hex);
          if (!rgb) return;
          var hsv = rgbToHsv(rgb.r, rgb.g, rgb.b);
          state.h = hsv.h; state.s = hsv.s; state.v = hsv.v;
          applyState(true);
        }

        function setFromRgbInputs() {
          var r = clamp(parseInt(rInput.value, 10) || 0, 0, 255);
          var g = clamp(parseInt(gInput.value, 10) || 0, 0, 255);
          var b = clamp(parseInt(bInput.value, 10) || 0, 0, 255);
          var hsv = rgbToHsv(r, g, b);
          state.h = hsv.h; state.s = hsv.s; state.v = hsv.v;
          applyState(true);
        }

        function positionPanel() {
          if (panel.hidden) return;
          var triggerRect = trigger.getBoundingClientRect();
          var panelRect = panel.getBoundingClientRect();
          var left = Math.min(Math.max(12, triggerRect.left), Math.max(12, window.innerWidth - panelRect.width - 12));
          var top = triggerRect.bottom + 8;
          if (top + panelRect.height > window.innerHeight - 12) top = triggerRect.top - panelRect.height - 8;
          if (top < 12) top = 12;
          panel.style.left = left + 'px';
          panel.style.top = top + 'px';
        }
        function openPanel() { panel.hidden = false; wrap.classList.add('open'); drawSV(); drawHue(); positionThumbs(); positionPanel(); }
        function closePanel() { panel.hidden = true; wrap.classList.remove('open'); }

        trigger.addEventListener('click', function (e) {
          e.stopPropagation();
          if (panel.hidden) openPanel(); else closePanel();
        });
        document.addEventListener('click', function (e) {
          if (!wrap.contains(e.target)) closePanel();
        });
        window.addEventListener('resize', positionPanel);
        document.addEventListener('scroll', positionPanel, true);
        wrap.addEventListener('keydown', function (e) { if (e.key === 'Escape') closePanel(); });

        function svPointer(e) {
          var rect = svCanvas.getBoundingClientRect();
          var x = clamp((e.clientX - rect.left) / rect.width, 0, 1);
          var y = clamp((e.clientY - rect.top) / rect.height, 0, 1);
          state.s = x; state.v = 1 - y;
          applyState(false);
        }
        function huePointer(e) {
          var rect = hueCanvas.getBoundingClientRect();
          var x = clamp((e.clientX - rect.left) / rect.width, 0, 1);
          state.h = x * 360;
          applyState(true);
        }
        function drag(moveFn) {
          function onMove(e) { moveFn(e); }
          function onUp() {
            document.removeEventListener('pointermove', onMove);
            document.removeEventListener('pointerup', onUp);
          }
          document.addEventListener('pointermove', onMove);
          document.addEventListener('pointerup', onUp);
        }
        svWrap.addEventListener('pointerdown', function (e) { svPointer(e); drag(svPointer); });
        hueWrap.addEventListener('pointerdown', function (e) { huePointer(e); drag(huePointer); });

        hexInput.addEventListener('change', function () {
          var v = hexInput.value.trim();
          if (!/^#?[0-9a-f]{6}$/i.test(v)) { hexInput.value = valueInput.value; return; }
          setFromHex(v.startsWith('#') ? v : '#' + v);
        });
        [rInput, gInput, bInput].forEach(function (inp) { inp.addEventListener('change', setFromRgbInputs); });

        presetBtns.forEach(function (btn) {
          btn.addEventListener('click', function () { setFromHex(btn.getAttribute('data-cp-preset')); });
        });
        if (resetBtn) {
          resetBtn.addEventListener('click', function () { setFromHex(wrap.getAttribute('data-cp-default') || '#8399ff'); });
        }

        setFromHex(valueInput.value || '#8399ff');
      });
    }

    function initContent(root) {
      bindForms(root);
      bindUploadLabels(root);
      bindFocusButtons(root);
      bindQueryLinks(root);
      bindResetButtons(root);
      bindFilterLists(root);
      bindVarMenus(root);
      bindMultiSelects(root);
      bindColorPickers(root);
      bindDirtyTracking(root);
      bindConfigPreview(root);
    }

    window.addEventListener('popstate', function (e) {
      if (dirtyForm) {
        window.history.pushState({ dglAjax: true }, '', window.location.href);
        shakeSaveBar();
        return;
      }
      startProgress();
      fetch(window.location.pathname + window.location.search, { method: 'GET' })
        .then(function (res) { return res.text(); })
        .then(function (html) {
          return swapContent(html, null);
        })
        .then(function (ok) {
          if (ok) { updateActiveLink(window.location.pathname + window.location.search); finishProgress(); }
          else window.location.reload();
        })
        .catch(function () { window.location.reload(); });
    });

    var content = document.getElementById('dgl-content');
    if (content) initContent(content);
    bindNavGuard(document);
    bindDglLinks(document);

    function syncHeaderHeight() {
      var header = document.querySelector('header.nav');
      if (header) document.documentElement.style.setProperty('--dgl-header-h', header.offsetHeight + 'px');
    }
    syncHeaderHeight();
    window.addEventListener('resize', syncHeaderHeight);
  })();
</script>

<style>
  .dgl-sec { padding: 28px 0; }
  .dgl-wrap { max-width: none; padding-left: 40px; padding-right: 40px; }

  .dgl-layout { display: grid; grid-template-columns: 216px 1fr; gap: 24px; align-items: start; }
  .dgl-side {
    position: sticky; top: calc(var(--dgl-header-h, 60px) + 28px);
    height: calc(100vh - var(--dgl-header-h, 60px) - 56px);
    display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 16px; background: var(--card); overflow: hidden;
  }
  .dgl-switcher-wrap { position: relative; border-bottom: 1px solid var(--border-soft); }
  .dgl-switcher {
    display: flex; align-items: center; gap: 10px; padding: 14px; width: 100%;
    background: none; border: none; text-align: left; cursor: pointer; font-family: var(--sans);
  }
  .dgl-switcher:hover, .dgl-switcher.open { background: var(--card-hover); }
  .dgl-switcher img { width: 32px; height: 32px; border-radius: 9px; object-fit: cover; flex-shrink: 0; }
  .dgl-switcher-text { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .dgl-switcher-eyebrow { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--text-dim); }
  .dgl-switcher-name-row { display: flex; align-items: center; gap: 7px; min-width: 0; }
  .dgl-switcher-name { min-width: 0; font-size: 13px; font-weight: 600; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dgl-server-premium, .dgl-switcher-premium { display: inline-flex; align-items: center; gap: 4px; flex-shrink: 0; color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border: 1px solid color-mix(in srgb, var(--yellow) 42%, var(--border)); border-radius: 999px; font-family: var(--mono); font-size: 9px; font-weight: 700; line-height: 1; padding: 4px 6px; }
  .dgl-switcher :global(svg) { color: var(--text-dim); flex-shrink: 0; }
  .dgl-switcher.open .dgl-switcher-icon,
  .dgl-switcher.open :global(svg:last-child) { transform: rotate(180deg); }

  .dgl-switcher-panel {
