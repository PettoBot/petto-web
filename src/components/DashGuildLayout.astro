      // browser never reports an error: so a stream that says nothing within a few seconds of opening, or goes quiet for 40 s, is
      // closed and the page asks /version every 12 s instead (only while it is visible), trying the stream again every 5 minutes.
      var POLL_MS = 12000;
      var HELLO_MS = 5000;
      var CONNECT_MS = 10000;
      var SILENCE_MS = 40000;
      var RETRY_STREAM_MS = 300000;
      var ERROR_RETRY_MS = 120000;
