          a.addEventListener('blur', cancel, { passive: true });
        }
        a.addEventListener('click', function (e) {
          if (dirtyForm) { e.preventDefault(); shakeSaveBar(); return; }
          if (!href) return;
          e.preventDefault();
          startProgress();
          var ready = prefetchedPages.get(href);
          if (!(ready && !ready.pending && prefetchUsable(ready))) showContentSkeleton(href);
          setMenuLabel(a);
          getPage(href)
            .then(function (answer) {
              if (!answer || !answer.ok) throw new Error('navigation failed');
              return swapContent(answer.html, href).then(function (ok) { if (ok) setShownVersion(answer.version); return ok; });
            })
            .then(function (ok) {
              if (ok) {
                updateActiveLink(href);
                finishProgress();
