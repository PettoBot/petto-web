        // symbol inside the closed menu or the hidden toggle may stop drawing. Draw the icon inline instead.
        var copy = activeLink.cloneNode(true);
        // Only the icon and the name: the "New" / "Updated" badges and the crown stay in the menu.
        copy.querySelectorAll('.dgl-new, .dgl-premium-crown').forEach(function (el) { el.remove(); });
        copy.querySelectorAll('svg').forEach(function (svg) {
