          // gets its own label and icon back if the save fails.
          var originalHtml = btn ? btn.innerHTML : null;
          if (btn) { btn.style.minWidth = btn.offsetWidth + 'px'; btn.classList.add('dgl-busy'); btn.disabled = true; btn.textContent = cdt('Saving...'); }
          var restoreBtn = function () { if (btn) { btn.disabled = false; btn.innerHTML = originalHtml; btn.classList.remove('dgl-busy'); btn.style.minWidth = ''; } };
          // A form the person edited and is saving from the bar is saved without redrawing the page.
          var fromBar = dirtyForms.indexOf(form) !== -1;
          if (saveBarBtn && fromBar) { saveBarBtn.disabled = true; setBarState('saving', cdt('Saving...')); }
          if (!fromBar) startProgress();
          // A form that goes through the bot (data-bot-wait: refresh the counters, send a timer now) says what is going on while Petto answers.
          var waiting = form.hasAttribute('data-bot-wait') && window.__dglBotWait ? window.__dglBotWait.watch() : null;

