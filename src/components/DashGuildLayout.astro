            </div>

            <button type="button" class="dgl-mobile-toggle" id="dgl-mobile-toggle" aria-expanded="false">
              <span>
                {stableInlineItems.has(activeNavItem?.id ?? '') ? <InlineIcon name={activeNavItem?.icon ?? 'ph:squares-four-fill'} width="15" height="15" /> : <Icon name={activeNavItem?.icon ?? 'ph:squares-four-fill'} width="15" height="15" />}
                {activeNavItem?.label ?? pageTitle}
              </span>
              <Icon name="ph:caret-down" width="14" height="14" class="dgl-mobile-toggle-caret" />
            </button>

            <nav class="dgl-nav" id="dgl-sidenav">
              {groups.map((group) => (
                <div class:list={['dgl-group', { 'has-active': group.items.some((item) => item.id === active) }]} data-group={group.label}>
                  <button type="button" class="dgl-label" aria-expanded="true">
                    <span>{group.label}</span>
                    <Icon name="ph:caret-down" width="12" height="12" class="dgl-label-caret" />
                  </button>
                  <div class="dgl-items">
                  {group.items.map((item) => (
                    <a href={item.href} data-full={item.full ? '' : undefined} class:list={['dgl-link', { active: active === item.id }]} aria-label={item.premium && !resolvedPremiumActive ? `${item.label}, Premium required` : undefined}>
                      {stableInlineItems.has(item.id) ? <InlineIcon name={item.icon} width="15" height="15" /> : <Icon name={item.icon} width="15" height="15" />}
                      {item.label}
                      {item.isNew && <em class="dgl-new">{dt('New')}</em>}
                      {item.soon && <em class="dgl-new dgl-soon">{dt('Soon')}</em>}
                {item.premium && <InlineIcon name="ph:crown-fill" width="12" height="12" class="dgl-premium-crown" />}
                    </a>
                  ))}
                  </div>
                </div>
              ))}
            </nav>
            <script is:inline>
              // Every part of the menu folds: all of it open is a very long list. What was folded is remembered, the first time only the open
              // section's part is open, and the part with the open section is always shown. This runs before the first paint, so nothing jumps.
              (function () {
                var nav = document.getElementById('dgl-sidenav');
                if (!nav) return;
                var KEY = 'dgl-nav-open';
                var groups = Array.prototype.slice.call(nav.querySelectorAll('.dgl-group'));
                var saved = null;
                try { saved = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { saved = null; }
                var apply = function (group, open) {
                  group.classList.toggle('closed', !open);
                  var head = group.querySelector('.dgl-label');
                  if (head) head.setAttribute('aria-expanded', String(open));
                };
                groups.forEach(function (group) {
                  var name = group.getAttribute('data-group');
                  var open = Array.isArray(saved) ? saved.indexOf(name) !== -1 : false;
                  apply(group, open || group.classList.contains('has-active'));
                });
                var store = function () {
                  var open = groups.filter(function (g) { return !g.classList.contains('closed'); }).map(function (g) { return g.getAttribute('data-group'); });
                  try { localStorage.setItem(KEY, JSON.stringify(open)); } catch (e) {}
                };
                nav.addEventListener('click', function (event) {
                  var head = event.target.closest && event.target.closest('.dgl-label');
                  if (!head) return;
                  var group = head.closest('.dgl-group');
                  apply(group, group.classList.contains('closed'));
                  store();
                });
                // Moving to a section by the menu (the page is not reloaded) opens the part it lives in.
                window.dglOpenGroupOf = function (link) {
                  var group = link && link.closest('.dgl-group');
                  if (!group) return;
                  groups.forEach(function (g) { g.classList.toggle('has-active', g === group); });
                  if (group.classList.contains('closed')) { apply(group, true); store(); }
                };
              })();
            </script>
            <script is:inline>
              // The side menu keeps where it was scrolled: a reload, a tab that wakes up after a while or the back button must not throw it to the
              // top (the section would then be out of sight). With nothing saved, the open section is brought into view.
              (function () {
                var nav = document.getElementById('dgl-sidenav');
                if (!nav) return;
                var KEY = 'dgl-sidenav-scroll';
                var read = function () { try { var v = sessionStorage.getItem(KEY); return v === null ? null : Number(v); } catch (e) { return null; } };
                var save = function () { try { sessionStorage.setItem(KEY, String(nav.scrollTop)); } catch (e) {} };
                var showActive = function () {
                  var link = nav.querySelector('.dgl-link.active');
                  if (!link) return;
                  var box = nav.getBoundingClientRect();
                  var rect = link.getBoundingClientRect();
                  if (rect.top < box.top || rect.bottom > box.bottom) nav.scrollTop += (rect.top - box.top) - (box.height - rect.height) / 2;
                };
                var touched = false;
                var restore = function () { var saved = read(); if (saved !== null && !isNaN(saved)) nav.scrollTop = saved; else showActive(); };
                restore();
                // The menu only has its final height once the page is laid out (before that it is as tall as its list and cannot scroll), so
                // the position is put back again while the page settles, until the person scrolls the menu themselves.
                var tries = 0;
                var settle = function () {
                  if (touched || tries++ > 40) return;
                  var saved = read();
                  if (saved !== null && !isNaN(saved) && Math.abs(nav.scrollTop - Math.min(saved, nav.scrollHeight - nav.clientHeight)) > 1) restore();
                  requestAnimationFrame(settle);
                };
                requestAnimationFrame(settle);
                window.addEventListener('load', restore);
                ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach(function (name) { nav.addEventListener(name, function () { touched = true; }, { passive: true }); });
                var timer = null;
                nav.addEventListener('scroll', function () { clearTimeout(timer); timer = setTimeout(save, 120); }, { passive: true });
                window.addEventListener('pagehide', save);
                document.addEventListener('visibilitychange', function () { if (document.hidden) save(); });
                window.addEventListener('pageshow', function (event) { if (event.persisted) restore(); });
              })();
            </script>

            <div class="dgl-side-user">
              {user.avatar ? <img src={user.avatar} alt="" /> : <div class="dgl-side-user-fallback"><Icon name="ph:user-fill" width="14" height="14" /></div>}
              <span>{user.username}</span>
              <a href="/dash/logout" title={dt('Log out')}><Icon name="ph:sign-out-fill" width="14" height="14" /></a>
            </div>
            <div class="dgl-side-version" title={buildTitle()}>{buildLabel()}</div>
          </aside>

          <div class="dgl-content reveal" id="dgl-content" style={`--dgl-guild:${cssString(guildName)}`}>
            {botIdentity && <span hidden data-dp-bot data-name={botIdentity.name} data-icon={botIdentity.icon ?? ''}></span>}
            {accessNotice && <div class="dgl-dev-banner"><div class="dgl-dev-text"><Icon name="ph:eye-fill" width="16" height="16" /><div><strong>{accessNotice}</strong></div></div></div>}
            {roleAccess && pageAccess && pageAccess.allowed && !pageAccess.canEdit && (
              <div class="dgl-dev-banner" data-view-only>
                <div class="dgl-dev-text"><Icon name="ph:eye-fill" width="16" height="16" /><div><strong>{dt('View only')}</strong><span>{dt('Your role can look at this part of the dashboard but not change it.')}</span></div></div>
              </div>
            )}
            {devView && (
              <div class="dgl-dev-banner" data-dev-view>
                <div class="dgl-dev-text"><Icon name="ph:eye-fill" width="16" height="16" /><div><strong>{dt('Developer view')}</strong><span>{dt('Read only. You are not a manager of this server, so nothing can be changed here.')}</span></div></div>
                <div class="dgl-dev-actions">
                  <a class="btn btn-ghost btn-sm" href="/dash/admin/servers"><Icon name="ph:hard-drives-fill" width="13" height="13" /> {dt('All servers')}</a>
                  <form method="POST" action="/dash/admin/servers" data-dev-leave data-guild-name={guildName}>
                    <input type="hidden" name="action" value="leave" />
                    <input type="hidden" name="guild_id" value={guildId} />
                    <button class="btn btn-danger btn-sm" type="submit"><Icon name="ph:sign-out-fill" width="13" height="13" /> {dt('Remove Petto')}</button>
                  </form>
                </div>
              </div>
            )}
            <slot />
          </div>
        </div>
      </div>
    </section>
  </main>

  <div class="dgl-progress" id="dgl-progress"></div>

  <div class="dgl-savebar" id="dgl-savebar" role="status" aria-live="polite">
    <Icon name="ph:floppy-disk-fill" width="15" height="15" class="dgl-savebar-icon" />
    <span class="dgl-savebar-spin" aria-hidden="true"></span>
    <Icon name="ph:check-circle-fill" width="15" height="15" class="dgl-savebar-done" />
    <span class="dgl-savebar-text">{dt('You have unsaved changes')}</span>
    <div class="dgl-savebar-actions">
      <button type="button" class="dgl-savebar-discard" data-savebar-discard>{dt('Discard')}</button>
      <button type="button" class="dgl-savebar-save" data-savebar-save>
        {dt('Save changes')}
        <kbd class="dgl-savebar-kbd" aria-hidden="true">Ctrl S</kbd>
      </button>
    </div>
  </div>
</Base>

<DashClientI18n />
<DashPreviews />
<script is:inline>
  // Developer view: block every form except the banner's own remove button, and confirm removal.
  document.addEventListener('submit', function (event) {
    if (!document.querySelector('[data-dev-view]')) return;
    var form = event.target;
    if (form && form.hasAttribute && form.hasAttribute('data-dev-leave')) {
      if (!window.confirm(cdt('Remove Petto from {name}? The bot will leave the server.', { name: form.getAttribute('data-guild-name') || cdt('this server') }))) event.preventDefault();
      return;
    }
    event.preventDefault();
    event.stopImmediatePropagation();
    window.alert(cdt('Developer view is read only. Changes are disabled on servers you do not manage.'));
  }, true);
</script>
<script is:inline>
  (function () {
    function bindUploadLabels(root) {
      root.querySelectorAll('input[type="file"]').forEach((input) => {
        if (input.dataset.labelBound) return;
        input.dataset.labelBound = '1';
        var label = input.closest('label');
        var span = label ? label.querySelector('span') : null;
        var defaultText = span ? span.textContent : '';
        input.addEventListener('change', function () {
          if (span) span.textContent = (input.files && input.files[0] ? input.files[0].name : defaultText);
        });
      });
    }

    function bindFocusButtons(root) {
      root.querySelectorAll('[data-focus]').forEach((btn) => {
        if (btn.dataset.focusBound) return;
        btn.dataset.focusBound = '1';
        btn.addEventListener('click', function () {
          var target = root.querySelector('#' + btn.dataset.focus);
          if (!target) return;
          target.scrollIntoView({ block: 'center', behavior: 'smooth' });
          target.focus({ preventScroll: true });
        });
      });
    }

    function bindResetButtons(root) {
      root.querySelectorAll('[data-reset]').forEach((btn) => {
        if (btn.dataset.resetBound) return;
        btn.dataset.resetBound = '1';
        btn.addEventListener('click', function () {
          btn.dataset.reset.split(',').forEach(function (id) {
            var el = root.querySelector('#' + id.trim());
            if (el) el.value = '';
          });
        });
      });
    }

    // --- unsaved-changes save bar: tracks whichever form the user last touched, blocks
    // in-app navigation away from it (shakes instead), and doubles as the always-visible
    // "Save" control so users don't have to scroll down to a form's own submit button. ---
    // One listener for every dropdown on the page. Each widget used to add its own to the document and never took it away, so after a few
    // visits to other sections the page ran dozens of dead handlers on every click and scroll (and the scroll ones repositioned hidden panels).
    var outsideClosers = [];
    var repositioners = [];
    document.addEventListener('click', function (e) {
      outsideClosers = outsideClosers.filter(function (c) { if (!c.wrap.isConnected && c.extra) c.extra.remove(); return c.wrap.isConnected; });
      outsideClosers.forEach(function (c) { if (!c.wrap.contains(e.target) && !(c.extra && c.extra.contains(e.target))) c.close(); });
    });
    function reposition() {
      repositioners = repositioners.filter(function (r) { return r.wrap.isConnected; });
      repositioners.forEach(function (r) { if (!r.isOpen || r.isOpen()) r.place(); });
    }
    window.addEventListener('resize', reposition);
    document.addEventListener('scroll', reposition, true);
    // `extra` is a part of the widget that lives elsewhere in the page (a panel moved to the body), so clicks inside it do not count as outside.
    function closeOnOutside(wrap, close, extra) { outsideClosers.push({ wrap: wrap, close: close, extra: extra || null }); }
    function placeWhileOpen(wrap, isOpen, place) { repositioners.push({ wrap: wrap, isOpen: isOpen, place: place }); }

    var dirtyForm = null;
    // Every form the user changed since the last save, in the order they were first touched. The bar saves them all with one press.
    var dirtyForms = [];
    // Resetting a form also refreshes custom widgets by dispatching change events.
    // Those synthetic events must not be mistaken for a new user edit.
    var resettingForm = false;
    // Right after a save the page is swapped; a browser that fills in the new fields again (autofill) would raise the bar once more with
    // nothing changed, so for a moment after a save those events do not count.
    var savedAt = 0;
    var saveBar = document.getElementById('dgl-savebar');
    var saveBarBtn = saveBar ? saveBar.querySelector('[data-savebar-save]') : null;
    var discardBtn = saveBar ? saveBar.querySelector('[data-savebar-discard]') : null;

    var saveBarText = saveBar ? saveBar.querySelector('.dgl-savebar-text') : null;
    function updateSaveBarText() {
      if (!saveBarText) return;
      saveBarText.textContent = dirtyForms.length > 1
        ? cdt('{n} sections have unsaved changes', { n: dirtyForms.length })
        : cdt('You have unsaved changes');
    }
    function markDirty(form) {
      if (dirtyForms.indexOf(form) === -1) dirtyForms.push(form);
      dirtyForm = form;
      form.classList.add('is-dirty');
      updateSaveBarText();
      showSaveBar();
      document.dispatchEvent(new CustomEvent('dgl:dirty', { detail: { forms: dirtyForms.slice() } }));
    }
    // The bar says what is happening: a spinner while it saves, then "Saved" for a moment, and it goes. The page is not reloaded.
    var barTimer = null;
    function setBarState(state, text) {
      if (!saveBar) return;
      clearTimeout(barTimer);
      saveBar.classList.remove('saving', 'saved');
      if (state) saveBar.classList.add(state, 'show');
      if (text && saveBarText) saveBarText.textContent = text;
    }
    function finishBar(text) {
      setBarState('saved', text);
      barTimer = setTimeout(function () {
        if (saveBar) saveBar.classList.remove('show');
        barTimer = setTimeout(function () { setBarState(null); updateSaveBarText(); }, 260);
      }, 1300);
    }
    // What a form holds right now becomes what "discard" goes back to, so discarding after a save does not undo the save.
    function commitDefaults(form) {
      form.querySelectorAll('input, textarea, select').forEach(function (el) {
        if (el.tagName === 'SELECT') { Array.prototype.forEach.call(el.options, function (o) { o.defaultSelected = o.selected; }); return; }
        if (el.type === 'checkbox' || el.type === 'radio') el.defaultChecked = el.checked;
        else if (el.type !== 'file' && el.type !== 'password') el.defaultValue = el.value;
      });
    }
    // A save that came back with a warning or an error is shown by swapping the page, so the message can be read.
    function answerHasProblem(html) {
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var fresh = doc.getElementById('dgl-content');
      if (!fresh) return true;
      // Only a whole word of the class counts (an-bad, md-warn...), so "badge" or "fail-safe" names are not taken for a problem.
      var problem = /(^|[\s_-])(bad|error|errors|warn|warning|fail|failed)($|[\s_-])/i;
      var found = fresh.querySelectorAll('[class], [role="alert"]');
      for (var i = 0; i < found.length; i++) {
        var el = found[i];
        if ((el.getAttribute('role') === 'alert' || problem.test(el.getAttribute('class') || '')) && (el.textContent || '').trim()) return true;
      }
      return false;
    }
    function showSaveBar() { if (saveBar) saveBar.classList.add('show'); }
    function hideSaveBar() {
      if (saveBar && !saveBar.classList.contains('saved')) saveBar.classList.remove('show');
      dirtyForms.forEach(function (f) { f.classList.remove('is-dirty'); });
      dirtyForms = [];
      dirtyForm = null;
      updateSaveBarText();
      document.dispatchEvent(new CustomEvent('dgl:dirty', { detail: { forms: [] } }));
    }
    function shakeSaveBar() {
      if (!saveBar) return;
      saveBar.classList.add('show');
      saveBar.classList.remove('shake');
      void saveBar.offsetWidth;
      saveBar.classList.add('shake');
    }

    function bindDirtyTracking(root) {
      root.querySelectorAll('form').forEach(function (form) {
        if (form.dataset.dirtyBound) return;
        form.dataset.dirtyBound = '1';
        // File-upload forms do a real page reload on submit anyway (see bindForms), no point tracking those.
        if ((form.getAttribute('enctype') || '').indexOf('multipart') !== -1) return;
        // Forms that act at once (add or remove a row) are not part of "unsaved changes".
        if (form.hasAttribute('data-no-dirty')) return;
        form.addEventListener('input', function () {
          if (resettingForm || Date.now() - savedAt < 1200) return;
          markDirty(form);
        });
        form.addEventListener('change', function () {
          if (resettingForm || Date.now() - savedAt < 1200) return;
          markDirty(form);
        });
      });
    }

    // Saves every changed form, one after the other, with the same data a press on its own Save would send. The last one goes through the
    // usual submit, which swaps the page, so what is on screen is what was saved.
    async function saveAllDirty() {
      var forms = dirtyForms.slice();
      if (!forms.length) return;
      for (var i = 0; i < forms.length; i++) {
        if (!forms[i].checkValidity()) { forms[i].reportValidity(); return; }
      }
      if (saveBarBtn) saveBarBtn.disabled = true;
      var failed = 0;
      for (var j = 0; j < forms.length - 1; j++) {
        setBarState('saving', cdt('Saving {a} of {b}...', { a: j + 1, b: forms.length }));
        try {
          var fd = new FormData(forms[j]);
          var named = forms[j].querySelector('button[type="submit"][name]');
          if (named) fd.append(named.name, named.value);
          var res = await fetch(window.location.pathname + window.location.search, { method: 'POST', body: fd });
          if (!res.ok) failed += 1;
          else { commitDefaults(forms[j]); forms[j].classList.remove('is-dirty'); dirtyForms = dirtyForms.filter(function (f) { return f !== forms[j]; }); }
        } catch (err) { failed += 1; }
      }
      var last = forms[forms.length - 1];
      if (last.requestSubmit) last.requestSubmit();
      else last.submit();
      if (failed) { setBarState(null, cdt('{n} sections could not be saved', { n: failed })); if (saveBarBtn) saveBarBtn.disabled = false; }
    }
    if (saveBarBtn) saveBarBtn.addEventListener('click', function () {
      if (!dirtyForms.length) return;
      if (dirtyForms.length > 1) { saveAllDirty(); return; }
      var only = dirtyForms[0];
      if (only.requestSubmit) only.requestSubmit();
      else only.submit();
    });
    // Ctrl+S (or Cmd+S) does what the bar does.
    document.addEventListener('keydown', function (e) {
      if ((e.ctrlKey || e.metaKey) && (e.key === 's' || e.key === 'S') && dirtyForms.length) {
        e.preventDefault();
        if (saveBarBtn && !saveBarBtn.disabled) saveBarBtn.click();
      }
    });
    if (discardBtn) discardBtn.addEventListener('click', function () {
      var forms = dirtyForms.slice();
      resettingForm = true;
      try {
        forms.forEach(function (form) {
          form.reset();
          // Native reset restores hidden widget values but not their visual chips/thumbs.
          form.querySelectorAll('[data-multiselect] input[type="checkbox"]').forEach(function (cb) {
            cb.dispatchEvent(new Event('change', { bubbles: true }));
          });
          form.querySelectorAll('[data-colorpicker]').forEach(function (picker) {
            var valueInput = picker.querySelector('[data-cp-value]');
            var hexInput = picker.querySelector('[data-cp-hex]');
            if (valueInput && hexInput) {
              hexInput.value = valueInput.value;
              hexInput.dispatchEvent(new Event('change', { bubbles: true }));
            }
          });
        });
      } finally {
        resettingForm = false;
      }
      setBarState('saving', cdt('Discarding...'));
      setTimeout(function () {
        dirtyForms.forEach(function (f) { f.classList.remove('is-dirty'); });
        dirtyForms = [];
        dirtyForm = null;
        document.dispatchEvent(new CustomEvent('dgl:dirty', { detail: { forms: [] } }));
        finishBar(cdt('Discarded'));
      }, 350);
    });

    // Anything that leaves the app entirely (header links, closing the tab, refresh) goes
    // through the browser's native unload flow, so it's the one place a blanket guard fits.
    window.addEventListener('beforeunload', function (e) {
      if (dirtyForm) { e.preventDefault(); e.returnValue = ''; }
    });

    function bindSwitcherMenu() {
      var btn = document.getElementById('dgl-switcher-btn');
      var panel = document.getElementById('dgl-switcher-panel');
      if (!btn || !panel) return;
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        if (dirtyForm) { shakeSaveBar(); return; }
        var isOpen = !panel.hidden;
        panel.hidden = !isOpen ? false : true;
        btn.classList.toggle('open', !isOpen);
        btn.setAttribute('aria-expanded', String(!isOpen));
      });
      document.addEventListener('click', function (e) {
        if (!panel.hidden && !panel.contains(e.target) && e.target !== btn && !btn.contains(e.target)) {
          panel.hidden = true;
          btn.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    }
    bindSwitcherMenu();

    var mobileToggle = document.getElementById('dgl-mobile-toggle');
    var dglSide = document.querySelector('.dgl-side');
    // On a phone the menu is a drawer at the side: a button opens it, and it closes with the backdrop, the X, Escape or a link.
    var menuBtn = document.getElementById('dgl-menu-btn');
    var menuBackdrop = document.getElementById('dgl-backdrop');
    function setDrawer(open) {
      dglSide?.classList.toggle('open', open);
      if (menuBackdrop) menuBackdrop.hidden = !open;
      menuBtn?.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    }
    menuBtn?.addEventListener('click', function () { setDrawer(!dglSide?.classList.contains('open')); });
    menuBackdrop?.addEventListener('click', function () { setDrawer(false); });
    document.getElementById('dgl-side-close')?.addEventListener('click', function () { setDrawer(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setDrawer(false); });
    mobileToggle?.addEventListener('click', function () {
      var isOpen = dglSide?.classList.contains('open');
      dglSide?.classList.toggle('open', !isOpen);
      mobileToggle.setAttribute('aria-expanded', String(!isOpen));
    });
    // Collapse the mobile nav back down once a link inside it is actually followed,
    // otherwise it stays open covering the freshly-loaded page.
    document.querySelectorAll('.dgl-nav').forEach(function (nav) {
      nav.addEventListener('click', function (e) {
        if (e.target.closest('a')) setDrawer(false);
      });
    });

    function bindNavGuard(root) {
      root.querySelectorAll('.dgl-link, .dgl-switcher-item, .dgl-switcher-all, .dgl-side-user a').forEach(function (a) {
        if (a.dataset.navGuardBound) return;
        a.dataset.navGuardBound = '1';
        a.addEventListener('click', function (e) {
          if (dirtyForm) { e.preventDefault(); shakeSaveBar(); }
        });
      });
    }

    // --- thin top-of-page progress bar shown while an AJAX navigation/save is in flight (see startProgress) ---
    // While a section is being fetched for longer than a blink, its content gives way to grey placeholders with a moving
    // highlight (the styles live in Base.astro). Only for moving between sections, never while saving a form.
    var skeletonTimer = null;
    function showContentSkeleton() {
      var content = document.getElementById('dgl-content');
      if (!content) return;
      clearTimeout(skeletonTimer);
      skeletonTimer = setTimeout(function () {
        if (content.querySelector(':scope > .dgl-sk')) return;
        var sk = document.createElement('div');
        sk.className = 'dgl-sk sk-wrap';
        sk.setAttribute('aria-hidden', 'true');
        // Placeholders across the whole width of the section: title, text, a row of numbers, a big block and cards.
        sk.innerHTML = '<span class="sk sk-title"></span><span class="sk sk-line"></span><span class="sk sk-line short"></span>'
          + '<div class="sk-row"><span class="sk"></span><span class="sk"></span><span class="sk"></span><span class="sk"></span></div>'
          + '<span class="sk sk-block"></span>'
          + '<div class="sk-grid"><span class="sk sk-card"></span><span class="sk sk-card"></span><span class="sk sk-card"></span><span class="sk sk-card"></span><span class="sk sk-card"></span><span class="sk sk-card"></span></div>';
        // The placeholders are shorter than the section they replace; holding its height keeps the page from jumping up.
        content.style.minHeight = content.offsetHeight + 'px';
        content.classList.add('is-loading');
        content.appendChild(sk);
      }, 160);
    }
    function hideContentSkeleton() {
      clearTimeout(skeletonTimer);
      var content = document.getElementById('dgl-content');
      if (!content) return;
      content.classList.remove('is-loading');
      content.style.minHeight = '';
      content.querySelectorAll(':scope > .dgl-sk').forEach(function (el) { el.remove(); });
    }

    var progressEl = document.getElementById('dgl-progress');
    // The bar moves at one steady speed from the first moment, so it never rushes and then stalls. Its pace is the time the
    // last few moves actually took: it reaches 80% when the page is expected to arrive, then keeps creeping forward ever more slowly
    // instead of stopping. When the page arrives it runs to the end in a blink and fades.
    var progressFrame = 0;
    var progressHideTimer = null;
    var progressStartedAt = 0;
    var progressWidth = 0;
    var recentLoads = [];
    function expectedLoadMs() {
      if (!recentLoads.length) return 450;
      var avg = recentLoads.reduce(function (sum, ms) { return sum + ms; }, 0) / recentLoads.length;
      return Math.min(2500, Math.max(300, avg));
    }
    function startProgress() {
      if (!progressEl) return;
      clearTimeout(progressHideTimer);
      cancelAnimationFrame(progressFrame);
      progressStartedAt = Date.now();
      var expected = expectedLoadMs();
      progressEl.style.transition = 'opacity 0.2s ease';
      progressEl.style.opacity = '1';
      progressWidth = 0;
      progressEl.style.width = '0%';
      function frame() {
        var t = Date.now() - progressStartedAt;
        // Straight line to 80% when the page is expected, then the same speed that slows down smoothly toward 95%
        // (no step in the pace, and never a full stop if the page is late).
        var speed = 80 / expected;
        progressWidth = t < expected ? speed * t : 80 + 15 * ((t - expected) * speed / 15) / (((t - expected) * speed / 15) + 1);
        progressEl.style.width = progressWidth.toFixed(2) + '%';
        progressFrame = requestAnimationFrame(frame);
      }
      progressFrame = requestAnimationFrame(frame);
    }
    function finishProgress() {
      hideContentSkeleton();
      if (!progressEl) return;
      cancelAnimationFrame(progressFrame);
      if (progressStartedAt) {
        recentLoads.push(Date.now() - progressStartedAt);
        if (recentLoads.length > 5) recentLoads.shift();
        progressStartedAt = 0;
      }
      // Arrived: run to the end, fade, and reset, all in about a third of a second so the bar never lingers after the page.
      progressEl.style.transition = 'width 0.1s linear, opacity 0.18s ease';
      progressEl.style.width = '100%';
      progressHideTimer = setTimeout(function () {
        progressEl.style.opacity = '0';
        progressHideTimer = setTimeout(function () {
          progressEl.style.transition = 'opacity 0.18s ease';
          progressEl.style.width = '0%';
        }, 190);
      }, 110);
    }

    // Each dashboard module ships its own scoped stylesheet, emitted as a <link>/<style> in
    // that page's <head>, not inside #dgl-content. Swapping only the content fragment means a
    // module's CSS never arrives unless that exact page already loaded once this session, so
    // any first-time AJAX visit rendered completely unstyled. Sync the head assets in too.
    function syncHeadAssets(freshHead) {
      var existingHrefs = new Set();
      document.querySelectorAll('head link[rel="stylesheet"]').forEach(function (l) { existingHrefs.add(l.href); });
      var stylesheetLoads = [];
      freshHead.querySelectorAll('link[rel="stylesheet"]').forEach(function (link) {
        if (existingHrefs.has(link.href)) return;
        var clone = link.cloneNode(true);
        stylesheetLoads.push(new Promise(function (resolve) {
          var settled = false;
          function done() { if (settled) return; settled = true; resolve(); }
          clone.addEventListener('load', done, { once: true });
          clone.addEventListener('error', done, { once: true });
          window.setTimeout(done, 1800);
          document.head.appendChild(clone);
        }));
      });
      var existingStyleText = new Set();
      document.querySelectorAll('head style').forEach(function (s) { existingStyleText.add(s.textContent); });
      freshHead.querySelectorAll('style').forEach(function (style) {
        if (!existingStyleText.has(style.textContent)) document.head.appendChild(style.cloneNode(true));
      });
      return Promise.all(stylesheetLoads);
    }

    // Nodes inserted via replaceWith/innerHTML never execute their <script> tags, that's a
    // DOM rule, not a bug. But a swapped-in page's shared chunks (e.g. Astro's client-island
    // runtime, already loaded on the very first full page load) have the same src every time,
    // re-inserting those repeatedly on every nav risks re-running/registering things that are
    // only meant to happen once (custom elements, etc). Only ever run a given src once; inline
    // scripts with no src are assumed per-instance (e.g. a hydration trigger) and always re-run.
    var executedScriptSrcs = new Set();
    document.querySelectorAll('script[src]').forEach(function (s) { executedScriptSrcs.add(s.src); });
    function executeScripts(container) {
      container.querySelectorAll('script').forEach(function (oldScript) {
        if (oldScript.src) {
          if (executedScriptSrcs.has(oldScript.src)) return;
          executedScriptSrcs.add(oldScript.src);
        }
        var newScript = document.createElement('script');
        for (var i = 0; i < oldScript.attributes.length; i++) {
          newScript.setAttribute(oldScript.attributes[i].name, oldScript.attributes[i].value);
        }
        newScript.textContent = oldScript.textContent;
        oldScript.replaceWith(newScript);
      });
    }

    // astro-icon draws an icon with <use> and defines its <symbol> once per page, inside whichever part of the
    // page used it first. When a module is swapped in or out, a symbol that lived in the removed content takes the
    // icons of the menu with it. Symbols found in either side are kept in a sprite that is never replaced.
    function keepSymbols(root) {
      var sprite = document.getElementById('dgl-sprite');
      if (!sprite) {
        sprite = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        sprite.id = 'dgl-sprite';
        sprite.setAttribute('width', '0');
        sprite.setAttribute('height', '0');
        sprite.setAttribute('aria-hidden', 'true');
        sprite.style.cssText = 'position:absolute;width:0;height:0;overflow:hidden';
        document.body.appendChild(sprite);
      }
      root.querySelectorAll('symbol[id]').forEach(function (symbol) {
        if (!sprite.querySelector('symbol[id="' + symbol.id + '"]')) sprite.appendChild(symbol.cloneNode(true));
      });
    }

    function swapContent(html, pushUrl) {
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var fresh = doc.getElementById('dgl-content');
      var current = document.getElementById('dgl-content');
      if (!fresh || !current) return Promise.resolve(false);
      // Keep the current section on screen until the new module stylesheet is ready.
      // Otherwise the fresh HTML briefly paints unstyled before its Astro CSS arrives.
      return syncHeadAssets(doc.head).then(function () {
        // The fresh node carries the server-rendered "reveal" class (opacity:0 until an
        // IntersectionObserver, set up once at initial page load, adds "in"). That observer
        // never sees this node since it didn't exist yet, so without this it would replace
        // visible content with a permanently invisible one on every save/nav.
        fresh.classList.add('in');
        keepSymbols(current);
        keepSymbols(fresh);
        current.replaceWith(fresh);
        executeScripts(fresh);
        initContent(fresh);
        if (window.PettoLevelingInit) window.PettoLevelingInit(fresh);
        if (window.PettoVoiceLevelingInit) window.PettoVoiceLevelingInit(fresh);
        if (window.PettoRankPreviewInit) window.PettoRankPreviewInit(fresh);
        if (pushUrl) window.history.pushState({ dglAjax: true }, '', pushUrl);
        // The sticky top bar covers the first 80px of the page, so the new section is placed below it (scroll-margin-top in
        // Base.astro). Moving to another section starts at its top; a save keeps the place the person was at.
        fresh.scrollIntoView({ block: pushUrl ? 'start' : 'nearest' });
        return true;
      });
    }

    function updateActiveLink(href) {
      // The address may carry a tab (?section=shared) that no menu link has: the page keeps its own menu link selected.
      var target;
      try { target = new URL(href, window.location.href); } catch (e) { return; }
      var links = Array.prototype.slice.call(document.querySelectorAll('.dgl-link'));
      var same = function (a) { var u = new URL(a.getAttribute('href'), window.location.href); return u.pathname === target.pathname; };
      var exact = links.filter(function (a) { var u = new URL(a.getAttribute('href'), window.location.href); return u.pathname === target.pathname && u.search === target.search; });
      var chosen = exact.length ? exact : links.filter(function (a) { var u = new URL(a.getAttribute('href'), window.location.href); return same(a) && !u.search; });
      if (!chosen.length) return;
      links.forEach(function (a) { a.classList.toggle('active', chosen.indexOf(a) !== -1); });
      if (window.dglOpenGroupOf) window.dglOpenGroupOf(chosen[0]);
      href = chosen[0].getAttribute('href');
      // The mobile toggle button lives outside #dgl-content, so it never gets
      // re-rendered by the AJAX swap, copy the now-active link's icon/label into it.
      var menuLabel = document.getElementById('dgl-menu-label');
      var activeForLabel = document.querySelector('.dgl-link[href="' + href + '"]');
      if (menuLabel && activeForLabel) menuLabel.textContent = activeForLabel.textContent.trim();
      var toggleSpan = document.querySelector('#dgl-mobile-toggle span');
      var activeLink = document.querySelector('.dgl-link[href="' + href + '"]');
      if (toggleSpan && activeLink) {
        // Copying the link's markup as is can duplicate an icon's <symbol> id, and a <use> that points at a
        // symbol inside the closed menu or the hidden toggle may stop drawing. Draw the icon inline instead.
        var copy = activeLink.cloneNode(true);
        copy.querySelectorAll('svg').forEach(function (svg) {
          var use = svg.querySelector('use');
          var ref = use && (use.getAttribute('href') || use.getAttribute('xlink:href'));
          var symbol = ref && ref.charAt(0) === '#' ? document.getElementById(ref.slice(1)) : null;
          if (symbol) {
            svg.innerHTML = symbol.innerHTML;
            if (symbol.getAttribute('viewBox')) svg.setAttribute('viewBox', symbol.getAttribute('viewBox'));
          } else {
            svg.querySelectorAll('symbol').forEach(function (sym) { sym.remove(); });
          }
        });
        toggleSpan.innerHTML = copy.innerHTML;
      }
    }

    // Keep the next dashboard section ready while the user is deciding where to go.
    // The cache is memory-only and is cleared after a save, so it never persists stale
    // configuration across a meaningful write.
    // A pointer that only passes over the menu does not fetch anything: the page is asked for after it rests on a link for
    // 80 ms, and at most two of those reads run at once (a click never waits for that limit).
    var prefetchedPages = new Map();
    var HOVER_DELAY_MS = 80;
    var MAX_HOVER_PREFETCHES = 2;
    var hoverPrefetches = 0;
    function prefetchPage(href, fromHover) {
      if (dirtyForm || prefetchedPages.has(href)) return;
      if (fromHover && hoverPrefetches >= MAX_HOVER_PREFETCHES) return;
      if (fromHover) hoverPrefetches += 1;
      var done = function () { if (fromHover) hoverPrefetches -= 1; };
      var request = fetch(href, { method: 'GET' })
        .then(function (res) {
          if (!res.ok) throw new Error('prefetch failed');
          return res.text();
        })
        .then(function (html) { done(); return html; }, function () {
          done();
          prefetchedPages.delete(href);
          return null;
        });
      prefetchedPages.set(href, request);
    }
    function getPageHtml(href) {
      if (!prefetchedPages.has(href)) prefetchPage(href);
      var request = prefetchedPages.get(href);
      return request || fetch(href, { method: 'GET' }).then(function (res) { return res.text(); });
    }

    function bindDglLinks(root) {
      root.querySelectorAll('.dgl-link').forEach(function (a) {
        if (a.dataset.dglNavBound) return;
        a.dataset.dglNavBound = '1';
        // A page with a script of its own (the editor of commands in code) is opened as a whole page, so it always starts.
        if (a.hasAttribute('data-full')) return;
        var href = a.getAttribute('href');
        if (href) {
          var hoverTimer = 0;
          var later = function () { clearTimeout(hoverTimer); hoverTimer = setTimeout(function () { prefetchPage(href, true); }, HOVER_DELAY_MS); };
          var cancel = function () { clearTimeout(hoverTimer); };
          a.addEventListener('mouseenter', later, { passive: true });
          a.addEventListener('mouseleave', cancel, { passive: true });
          a.addEventListener('focus', later, { passive: true });
          a.addEventListener('blur', cancel, { passive: true });
        }
        a.addEventListener('click', function (e) {
          if (dirtyForm) { e.preventDefault(); shakeSaveBar(); return; }
          if (!href) return;
          e.preventDefault();
          startProgress();
          showContentSkeleton();
          getPageHtml(href)
            .then(function (html) {
              if (!html) throw new Error('navigation failed');
              return swapContent(html, href);
            })
            .then(function (ok) {
              if (ok) { updateActiveLink(href); finishProgress(); }
              else window.location.href = href;
            })
            .catch(function () { window.location.href = href; });
        });
      });
    }

    function bindQueryLinks(root) {
      root.querySelectorAll('a[href^="?"], a[href^="' + window.location.pathname + '?"]').forEach((a) => {
        if (a.dataset.ajaxBound) return;
        a.dataset.ajaxBound = '1';
        // Tabs that change what is shown on the page by themselves (data-an-tab) never load the page.
        if (a.hasAttribute('data-an-tab')) return;
        a.addEventListener('click', function (e) {
          if (dirtyForm) { e.preventDefault(); shakeSaveBar(); return; }
          e.preventDefault();
          var url = a.getAttribute('href');
          startProgress();
          showContentSkeleton();
          fetch(url, { method: 'GET' })
            .then(function (res) { return res.text(); })
            .then(function (html) {
              return swapContent(html, url);
            })
            .then(function (ok) {
              if (ok) { updateActiveLink(url); finishProgress(); }
              else window.location.href = url;
            })
            .catch(function () { window.location.href = url; });
        });
      });
    }

    function bindForms(root) {
      root.querySelectorAll('form[method="POST" i]').forEach((form) => {
        if (form.dataset.ajaxBound) return;
        // File-upload forms (multipart) submit normally, a real page reload, on purpose:
        // AJAX-swapping a page that just changed an avatar/banner leaves stale cached images
        // and broke the whole Customize form, so those get the plain, reliable path instead.
        if ((form.getAttribute('enctype') || '').indexOf('multipart') !== -1) return;
        form.dataset.ajaxBound = '1';
        form.addEventListener('submit', function (e) {
          var submitter = e.submitter;
          var confirmMsg = submitter && submitter.dataset ? submitter.dataset.confirm : null;
          if (confirmMsg && !window.confirm(confirmMsg)) { e.preventDefault(); return; }
          e.preventDefault();
          var btn = submitter && submitter.tagName === 'BUTTON' ? submitter : form.querySelector('button[type="submit"]');
          var originalText = btn ? btn.textContent : null;
          if (btn) { btn.disabled = true; btn.textContent = cdt('Saving...'); }
          // A form the person edited and is saving from the bar is saved without redrawing the page.
          var fromBar = dirtyForms.indexOf(form) !== -1;
          if (saveBarBtn && fromBar) { saveBarBtn.disabled = true; setBarState('saving', cdt('Saving...')); }
          if (!fromBar) startProgress();

          // The action of the pressed button (save, delete...) is added by hand. The button is disabled above, and a disabled button is left
          // out of the form data, so the action was lost and the page did nothing.
          var fd = new FormData(form);
          if (submitter && submitter.name) fd.append(submitter.name, submitter.value);
          fetch(window.location.pathname + window.location.search, { method: 'POST', body: fd })
            .then(function (res) { return res.text().then(function (html) { return { ok: res.ok, html: html }; }); })
            .then(function (answer) {
              if (fromBar && answer.ok && !answerHasProblem(answer.html)) {
                commitDefaults(form);
                form.classList.remove('is-dirty');
                dirtyForms = dirtyForms.filter(function (f) { return f !== form; });
                dirtyForm = dirtyForms.length ? dirtyForms[dirtyForms.length - 1] : null;
                prefetchedPages.clear();
                savedAt = Date.now();
                if (btn) { btn.disabled = false; btn.textContent = originalText; }
                if (saveBarBtn) saveBarBtn.disabled = false;
                if (dirtyForms.length) { setBarState(null); updateSaveBarText(); }
                else { document.dispatchEvent(new CustomEvent('dgl:dirty', { detail: { forms: [] } })); finishBar(cdt('Saved')); }
                return 'soft';
              }
              return swapContent(answer.html, null);
            })
            .then(function (ok) {
              if (ok === 'soft') return;
              if (ok) {
                prefetchedPages.clear();
                hideSaveBar();
                savedAt = Date.now();
                setBarState(null);
              }
              if (!ok && btn) { btn.disabled = false; btn.textContent = originalText; }
              if (saveBarBtn) saveBarBtn.disabled = false;
              if (!ok) setBarState(null, cdt('Something went wrong, try again.'));
              finishProgress();
            })
            .catch(function () {
              if (btn) { btn.disabled = false; btn.textContent = originalText; }
              if (saveBarBtn) saveBarBtn.disabled = false;
              setBarState(null, cdt('Something went wrong, try again.'));
              finishProgress();
            });
        });
      });
    }

    function bindFilterLists(root) {
      root.querySelectorAll('[data-filterable]').forEach((wrap) => {
        if (wrap.dataset.filterBound) return;
        wrap.dataset.filterBound = '1';
        var input = wrap.querySelector('[data-filter-input]');
        var list = wrap.querySelector('[data-filter-list]');
        if (!input || !list) return;
        input.addEventListener('input', function () {
          var q = input.value.trim().toLowerCase();
          list.querySelectorAll('label').forEach(function (label) {
            label.style.display = !q || label.textContent.toLowerCase().indexOf(q) !== -1 ? '' : 'none';
          });
        });
      });
    }

    function bindConfigPreview(root) {
      root.querySelectorAll('[data-config-preview]').forEach((pre) => {
        if (pre.dataset.previewBound) return;
        pre.dataset.previewBound = '1';
        var url = pre.dataset.configPreview;
        var code = pre.querySelector('code');
        fetch(url)
          .then(function (res) { return res.ok ? res.text() : Promise.reject(); })
          .then(function (text) { if (code) code.textContent = text; })
          .catch(function () { if (code) code.textContent = cdt("Couldn't load the preview, try refreshing."); });
      });
    }

    var openVarMenu = null;
    var varMenuFrame = 0;
    function placeVarMenu() {
      var menu = openVarMenu;
      if (!menu || menu.panel.hidden) return;
      var r = menu.btn.getBoundingClientRect();
      // The button left the screen: the menu goes with it instead of hanging in the air.
      if (r.bottom < 0 || r.top > window.innerHeight) { menu.panel.hidden = true; menu.btn.classList.remove('open'); openVarMenu = null; return; }
      var below = window.innerHeight - r.bottom - 16;
      var above = r.top - 16;
      var up = below < 240 && above > below;
      var room = Math.max(160, Math.min(420, up ? above : below));
      menu.panel.style.position = 'fixed';
      menu.panel.style.maxHeight = room + 'px';
      menu.panel.style.left = Math.max(8, Math.min(r.left, window.innerWidth - menu.panel.offsetWidth - 8)) + 'px';
      if (up) { menu.panel.style.top = 'auto'; menu.panel.style.bottom = (window.innerHeight - r.top + 6) + 'px'; }
      else { menu.panel.style.bottom = 'auto'; menu.panel.style.top = (r.bottom + 6) + 'px'; }
    }
    function queueVarMenu(e) {
      if (!openVarMenu || (e && e.target && e.target.nodeType === 1 && openVarMenu.panel.contains(e.target))) return;
      if (varMenuFrame) return;
      varMenuFrame = requestAnimationFrame(function () { varMenuFrame = 0; placeVarMenu(); });
    }
    window.addEventListener('scroll', queueVarMenu, true);
    window.addEventListener('resize', queueVarMenu);

    function bindVarMenus(root) {
      root.querySelectorAll('[data-varmenu]').forEach((wrap) => {
        if (wrap.dataset.varmenuBound) return;
        wrap.dataset.varmenuBound = '1';
        var btn = wrap.querySelector('[data-varmenu-toggle]');
        var panel = wrap.querySelector('[data-varmenu-panel]');
        if (!btn || !panel) return;

        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          var isOpen = !panel.hidden;
          document.querySelectorAll('[data-varmenu-panel]').forEach((p) => { p.hidden = true; });
          document.querySelectorAll('.dgl-varbtn.open').forEach((b) => b.classList.remove('open'));
          if (!isOpen) {
            // The scrollable dashboard panel clips regular absolute positioning once the button
            // isn't near the top, so the menu is fixed to the screen and placed from the button's
            // real position. It is placed again while the page scrolls, so it follows the button.
            openVarMenu = { btn: btn, panel: panel };
            panel.hidden = false;
            btn.classList.add('open');
            placeVarMenu();
          }
        });

        panel.querySelectorAll('[data-var-token]').forEach((row) => {
          row.addEventListener('click', function () {
            var tok = row.dataset.varToken;
            var reset = function () { row.classList.remove('copied'); };
            (navigator.clipboard && navigator.clipboard.writeText ? navigator.clipboard.writeText(tok) : Promise.reject())
              .then(function () { row.classList.add('copied'); setTimeout(reset, 1200); })
              .catch(function () {});
          });
        });
      });
    }

    document.addEventListener('click', function (e) {
      document.querySelectorAll('[data-varmenu-panel]').forEach((p) => {
        if (!p.hidden && !p.closest('[data-varmenu]').contains(e.target)) p.hidden = true;
      });
      document.querySelectorAll('.dgl-varbtn.open').forEach((b) => {
        if (!b.closest('[data-varmenu]').contains(e.target)) b.classList.remove('open');
      });
    });

    function bindMultiSelects(root) {
      root.querySelectorAll('[data-multiselect]').forEach((wrap) => {
        if (wrap.dataset.msBound) return;
        wrap.dataset.msBound = '1';

        var chips = wrap.querySelector('[data-ms-chips]');
        var input = wrap.querySelector('[data-ms-input]');
        var control = wrap.querySelector('[data-ms-control]');
        var dropdown = wrap.querySelector('[data-ms-dropdown]');
        if (!chips || !input || !control || !dropdown) return;

        function checkboxes() {
          return Array.prototype.slice.call(wrap.querySelectorAll('[data-ms-option] input[type="checkbox"]'));
        }

        // A select with a shared list (data-ms-source) only has its chosen options in the page; the rest are added the first
        // time it opens, in the order of the list, around the ones already there.
        var sourceName = wrap.getAttribute('data-ms-source');
        var filled = !sourceName;
        function fill() {
          if (filled) return;
          filled = true;
          var scope = wrap.closest('#dgl-content') || document;
          var holder = scope.querySelector('script[data-ms-options="' + sourceName + '"]') || document.querySelector('script[data-ms-options="' + sourceName + '"]');
          if (!holder) return;
          var list;
          try { list = JSON.parse(holder.textContent || '[]'); } catch (e) { return; }
          var fieldName = wrap.getAttribute('data-ms-name') || '';
          var present = {};
          checkboxes().forEach(function (cb) { present[cb.value] = cb.closest('[data-ms-option]'); });
          var fragment = document.createDocumentFragment();
