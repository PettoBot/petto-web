          var x = clamp((e.clientX - rect.left) / rect.width, 0, 1);
          var y = clamp((e.clientY - rect.top) / rect.height, 0, 1);
          state.s = x; state.v = 1 - y;
          applyState(false);
        }
        function huePointer(e) {
          var rect = hueCanvas.getBoundingClientRect();
          var x = clamp((e.clientX - rect.left) / rect.width, 0, 1);
          state.h = x * 360;
          applyState(true);
        }
        function drag(moveFn, e) {
        dragging = true;
        var target = e.currentTarget;
        try { target.setPointerCapture(e.pointerId); } catch (err) { /* The listeners on the document still follow the pointer. */ }
        function onMove(ev) { ev.preventDefault(); moveFn(ev); }
        function onUp() {
        dragging = false; dragEndedAt = Date.now();
        try { target.releasePointerCapture(e.pointerId); } catch (err) { /* Already released. */ }
        document.removeEventListener('pointermove', onMove);
        document.removeEventListener('pointerup', onUp);
        document.removeEventListener('pointercancel', onUp);
        }
        document.addEventListener('pointermove', onMove, { passive: false });
        document.addEventListener('pointerup', onUp);
        document.addEventListener('pointercancel', onUp);
        }
        svWrap.addEventListener('pointerdown', function (e) { e.preventDefault(); svPointer(e); drag(svPointer, e); });
        hueWrap.addEventListener('pointerdown', function (e) { e.preventDefault(); huePointer(e); drag(huePointer, e); });

        hexInput.addEventListener('change', function () {
          var v = hexInput.value.trim();
          if (!/^#?[0-9a-f]{6}$/i.test(v)) { hexInput.value = valueInput.value; return; }
          setFromHex(v.startsWith('#') ? v : '#' + v);
        });
        [rInput, gInput, bInput].forEach(function (inp) { inp.addEventListener('change', setFromRgbInputs); });

        presetBtns.forEach(function (btn) {
          btn.addEventListener('click', function () { setFromHex(btn.getAttribute('data-cp-preset')); });
        });
        // "No color": the field sends an empty value, which the server reads as no color at all.
        var allowNone = wrap.hasAttribute('data-cp-allownone');
        var noneBtn = wrap.querySelector('[data-cp-none]');
        function setNone(silent) {
          wrap.classList.add('is-none');
          hexLabel.textContent = wrap.getAttribute('data-cp-nonelabel') || '';
          valueInput.value = '';
          if (!silent) valueInput.dispatchEvent(new Event('input', { bubbles: true }));
        }
        if (noneBtn) noneBtn.addEventListener('click', function () { setNone(); closePanel(); });
        // Other scripts set the color through this event; an empty value means no color when the field allows it.
        wrap.addEventListener('cp-set', function (e) {
          var v = e.detail || '';
          if (!v && allowNone) setNone(); else if (hexToRgb(v)) setFromHex(v);
        });
        if (resetBtn) {
          resetBtn.addEventListener('click', function () {
            var def = wrap.getAttribute('data-cp-default');
            if (allowNone && !def) setNone(); else setFromHex(def || '#8399ff');
          });
        }

        setFromHex(valueInput.value || wrap.getAttribute('data-cp-default') || '#8399ff', true);
        if (allowNone && !wrap.getAttribute('data-cp-default')) setNone(true);
      });
    }

    // Roles that Petto hands out (a select or a multi-select marked data-give-role) cannot offer the ones it is unable to give: they stay in the
    // list, greyed out and with the reason, and one that is already chosen is left alone so a saved setting does not break.
    var roleBlockInfo = null;
    var roleBlockAsked = false;
    function applyRoleBlocks(root, info) {
      var blocks = info.blocks || {};
      var labels = info.labels || {};
      if (!Object.keys(blocks).length) return;
      (root || document).querySelectorAll('select[data-give-role] option').forEach(function (option) {
        var why = blocks[option.value];
        if (!why || option.selected || option.dataset.blocked) return;
        option.dataset.blocked = '1';
        option.disabled = true;
        option.textContent = option.textContent + ' (' + (labels[why] || why) + ')';
      });
      (root || document).querySelectorAll('[data-multiselect][data-give-role] [data-ms-option]').forEach(function (label) {
        var input = label.querySelector('input[type="checkbox"]');
        var why = input && blocks[input.value];
        if (!why || input.checked || label.dataset.blocked) return;
        label.dataset.blocked = '1';
        label.classList.add('blocked');
        input.disabled = true;
        var text = label.querySelector('span');
        if (text) text.textContent = text.textContent + ' (' + (labels[why] || why) + ')';
      });
    }
    // Which roles Petto cannot give is only asked (one small request) by a page that has such a picker; the other pages never pay for it.
    window.dglApplyRoleBlocks = function (root) {
      var scope = root || document;
      if (roleBlockInfo) { applyRoleBlocks(scope, roleBlockInfo); return; }
      if (roleBlockAsked || !scope.querySelector('[data-give-role]')) return;
      roleBlockAsked = true;
      var match = window.location.pathname.match(/^\/(?:(?:es|pt-br)\/)?dash\/guild\/(\d+)\//);
      if (!match) return;
      var labels = {};
      try { labels = JSON.parse((document.getElementById('dgl-role-labels') || {}).textContent || '{}'); } catch (e) { labels = {}; }
      fetch('/dash/guild/' + match[1] + '/role-blocks', { headers: { accept: 'application/json' } })
        .then(function (res) { return res.ok ? res.json() : { blocks: {} }; })
        .then(function (data) { roleBlockInfo = { blocks: data.blocks || {}, labels: labels }; roleBlockAsked = false; applyRoleBlocks(document, roleBlockInfo); })
        .catch(function () { roleBlockAsked = false; });
    };

    // A fold (<details>) opens and closes softly without animating its height: opening, its content fades in (the stylesheet) while what
    // comes after it slides down from where it was; closing, the content fades out first and then what comes after slides up (dglMotion.flip,
    // transforms only). Anything else that opens one from a script still gets the soft entrance of its content.
    function bindDetails(root) {
      root.querySelectorAll('details').forEach(function (box) {
        if (box.dataset.animBound || box.hasAttribute('data-no-anim')) return;
        var summary = box.querySelector(':scope > summary');
        if (!summary) return;
        box.dataset.animBound = '1';
        summary.addEventListener('click', function (event) {
          if (window.dglMotion.reduced()) return;
          // A button, link or field inside the summary does its own thing.
          var inner = event.target.closest && event.target.closest('a, button, input, select, textarea, label');
          if (inner && summary.contains(inner) && inner !== summary) return;
          event.preventDefault();
          if (box._fold) {
            // Pressed again while it was folding: it stays open.
            clearTimeout(box._fold); box._fold = 0; box.classList.remove('is-closing');
            return;
          }
          if (!box.open) { window.dglMotion.flip(box, function () { box.open = true; }); return; }
          box.classList.add('is-closing');
          box._fold = setTimeout(function () {
            box._fold = 0;
            box.classList.remove('is-closing');
            window.dglMotion.flip(box, function () { box.open = false; });
          }, 150);
        });
      });
    }

    // Small controls (an icon, a Delete, a filter chip) are hard to hit with a finger: on a touch screen they get an invisible area around them
    // that is up to 36px wide and tall, without changing how they look.
    var coarse = window.matchMedia && window.matchMedia('(pointer: coarse)').matches;
    var tapQueue = [];
    var tapScheduled = false;
    function flushTapTargets() {
      tapScheduled = false;
      var batch = tapQueue; tapQueue = [];
      // All the reads first and the writes after, so the page is laid out once and not once for each control.
      var reads = [];
      for (var i = 0; i < batch.length; i++) {
        var rect = batch[i].getBoundingClientRect();
        if (rect.width >= 4 && rect.height >= 4 && (rect.width < 36 || rect.height < 36)) reads.push([batch[i], rect, window.getComputedStyle(batch[i]).position === 'static']);
      }
      for (var j = 0; j < reads.length; j++) {
        var el = reads[j][0], box = reads[j][1];
        el.style.setProperty('--tap-y', Math.min(10, Math.max(0, 36 - box.height) / 2) + 'px');
        el.style.setProperty('--tap-x', Math.min(10, Math.max(0, 36 - box.width) / 2) + 'px');
        el.classList.add('dgl-tap');
        if (reads[j][2]) el.classList.add('dgl-tap-rel');
      }
    }
    function bindTapTargets(root) {
      if (!coarse) return;
      root.querySelectorAll('button, a.btn, [role="button"]').forEach(function (el) {
        if (el.dataset.tapChecked) return;
        el.dataset.tapChecked = '1';
        tapQueue.push(el);
      });
      if (tapQueue.length && !tapScheduled) {
        tapScheduled = true;
        (window.requestIdleCallback || function (fn) { return setTimeout(fn, 600); })(flushTapTargets, { timeout: 1500 });
      }
    }

    // The answer of an action (a delete, an add, a save from the form's own button) says how it went in a notice at the top of the page
    // ("Deleted.", a warning). The page keeps the person's place, so that notice can be off screen: it is then also shown as a toast.
    var NOTICE = '[class$="-flash"], [class*="-flash "], [role="alert"]';
    function announceNotice() {
      var content = document.getElementById('dgl-content');
      var notice = content && content.querySelector(NOTICE);
      if (!notice || !window.dglToast) return;
      var text = (notice.textContent || '').replace(/\s+/g, ' ').trim();
      if (!text) return;
      var rect = notice.getBoundingClientRect();
      var top = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--dash-sticky')) || 0;
      if (rect.top >= top && rect.bottom <= window.innerHeight) return;
      var bad = /(^|[\s_-])(bad|err|error|warn|warning|fail|failed)($|[\s_-])/i.test(notice.getAttribute('class') || '') || notice.getAttribute('role') === 'alert';
      window.dglToast(text.length > 160 ? text.slice(0, 157) + '…' : text, { kind: bad ? 'error' : 'ok' });
    }
    // Notices drawn by the server are announced by screen readers like the toasts (an error at once).
    function markNotices(root) {
      root.querySelectorAll('[class$="-flash"], [class*="-flash "]').forEach(function (el) {
        if (el.hasAttribute('role')) return;
        var bad = /(^|[\s_-])(bad|err|error|warn|warning|fail|failed)($|[\s_-])/i.test(el.getAttribute('class') || '');
        el.setAttribute('role', bad ? 'alert' : 'status');
      });
    }

    function initContent(root) {
      markNotices(root);
      bindTapTargets(root);
      bindDetails(root);
      window.dglApplyRoleBlocks(root);
      bindForms(root);
      bindUploadLabels(root);
      bindFocusButtons(root);
      bindQueryLinks(root);
      bindResetButtons(root);
      bindFilterLists(root);
      bindVarMenus(root);
      bindMultiSelects(root);
      bindColorPickers(root);
      bindDirtyTracking(root);
      bindConfigPreview(root);
      if (window.dglSelectNotes) window.dglSelectNotes(root);
      if (window.dglSupportReadOnly) window.dglSupportReadOnly(root);
      if (window.dashAppealsInit) window.dashAppealsInit(root);
    }

    window.dglInitContent = initContent;

    window.addEventListener('popstate', function () {
      if (dirtyForm) {
        // The URL already changed by the time popstate fires, push it back so the address
        // bar matches what's actually on screen instead of silently navigating away.
        window.history.pushState({ dglAjax: true }, '', window.location.href);
        shakeSaveBar();
        return;
      }
      startProgress();
      showContentSkeleton(window.location.pathname + window.location.search);
      readPage(window.location.pathname + window.location.search)
        .then(function (answer) {
          return swapContent(answer.html, null).then(function (ok) { if (ok) setShownVersion(answer.version); return ok; });
        })
        .then(function (ok) {
          if (ok) { updateActiveLink(window.location.pathname + window.location.search); finishProgress(); }
          else window.location.reload();
        })
        .catch(function () { window.location.reload(); });
    });

    var content = document.getElementById('dgl-content');
    if (content) { keepSymbols(document.body); initContent(content); }
    // The sidebar (nav links, server sheet, logout) never gets replaced by swapContent,
    // so these only need binding once, not on every navigation like initContent's binders.
    bindNavGuard(document);
    bindDglLinks(document);

    function syncHeaderHeight() {
      var header = document.querySelector('header.nav');
      if (header) document.documentElement.style.setProperty('--dgl-header-h', header.offsetHeight + 'px');
    }
    syncHeaderHeight();
    window.addEventListener('resize', syncHeaderHeight);
  })();

</script>
<style>
  .dgl-sec { padding: 28px 0; }
  .dgl-wrap { max-width: none; padding-left: 40px; padding-right: 40px; }

  /* The page decides its height (as tall as its content, up to the height of the screen, then it scrolls inside, and never shorter than a
     sensible minimum). The menu is as tall as its own content, never taller than the page next to it (--dgl-panel-h, set by the script of
     the layout) or the screen: its list scrolls when it is longer and the user card always follows the list, so there is no empty stretch. */
  .dgl-layout { display: grid; grid-template-columns: 268px 1fr; gap: 22px; align-items: start; }
  .dgl-side {
    position: sticky; top: calc(var(--dgl-header-h, 60px) + 28px); align-self: start;
    /* As tall as its content (the user card follows the list, no empty stretch), and no taller than the screen: then the list scrolls.
       The visible height is used: a phone's address and tab bars are not part of 100vh and cut the bottom of the menu. */
    max-height: calc(100vh - var(--dgl-header-h, 60px) - 56px);
    max-height: min(calc(100dvh - var(--dgl-header-h, 60px) - 56px), var(--dgl-panel-h, 100dvh));
    display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 16px; background: var(--card); overflow: hidden;
  }

  .dgl-resync { white-space: nowrap; display: flex; align-items: center; justify-content: center; gap: 8px; flex: none; width: calc(100% - 16px); margin: 6px 8px 0; padding: 5px 12px; border-radius: 10px; border: 1px dashed var(--border); background: transparent; color: var(--muted, var(--text)); font: inherit; font-size: .82rem; cursor: pointer; touch-action: manipulation; transition: color .15s ease, border-color .15s ease, background .15s ease; }
  .dgl-resync:hover { color: var(--text); border-color: var(--accent); }
  .dgl-resync[disabled] { opacity: .7; cursor: progress; }
  .dgl-resync.busy :global(svg) { animation: dgl-spin .8s linear infinite; }
  @keyframes dgl-spin { to { transform: rotate(360deg); } }

  .dgl-find { display: flex; flex: none; align-items: center; gap: 8px; width: calc(100% - 16px); margin: 5px 8px 0; padding: 5px 10px; border-radius: 10px; border: 1px solid var(--border-soft); background: color-mix(in srgb, var(--text) 3%, transparent); color: var(--text-dim); font: inherit; font-size: 12.5px; cursor: pointer; touch-action: manipulation; transition: color var(--m-fast) ease, border-color var(--m-fast) ease, transform var(--m-instant) ease; }
  .dgl-find span { flex: 1; text-align: left; }
  .dgl-find kbd { font: 600 9.5px var(--mono); padding: 1px 5px; border-radius: 5px; border: 1px solid var(--border); color: var(--text-dim); }
  .dgl-find:hover { color: var(--text); border-color: var(--border); }
  .dgl-find:active { transform: scale(.985); }
  @media (hover: none) { .dgl-find kbd { display: none; } }
  .dgl-menu-bar, .dgl-menu-btn, .dgl-backdrop, .dgl-side-close, .dgl-drawer-head { display: none; }
  .dgl-mobile-toggle {
    display: none; align-items: center; justify-content: space-between; width: 100%; padding: 12px 14px;
    background: none; border: none; border-bottom: 1px solid var(--border-soft); color: var(--text); font-family: var(--sans);
    font-size: 13.5px; font-weight: 600; cursor: pointer; touch-action: manipulation;
  }
  .dgl-mobile-toggle span { display: flex; align-items: center; gap: 8px; }
  .dgl-mobile-toggle :global(svg:first-child) { color: var(--accent); }
  .dgl-mobile-toggle-caret { transition: transform 0.18s ease; color: var(--text-dim); }
  .dgl-side.open .dgl-mobile-toggle-caret { transform: rotate(180deg); }

  /* A thin, quiet scrollbar says the menu goes on below. */
  .dgl-nav { padding: 2px 8px 14px; -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 14px), transparent); mask-image: linear-gradient(to bottom, #000 calc(100% - 14px), transparent); display: flex; flex-direction: column; flex: 0 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--text) 14%, transparent) transparent; }
  .dgl-nav::-webkit-scrollbar { width: 4px; }
  .dgl-nav::-webkit-scrollbar-thumb { border-radius: 4px; background: color-mix(in srgb, var(--text) 14%, transparent); }
  :global(.dgl-ms-option.blocked) { opacity: .45; cursor: not-allowed; }
  /* The menu reads as a few sections (a small title each), and each section as parts that fold, with their links indented under them. */
  .dgl-section-title { font-family: var(--mono); font-size: 9.5px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--text-dim); padding: 11px 8px 4px; }
  .dgl-section-title:first-child { padding-top: 8px; }
  .dgl-group + .dgl-group { margin-top: 1px; }
  .dgl-label { display: flex; align-items: center; gap: 10px; width: 100%; background: none; border: none; border-radius: 10px; cursor: pointer; text-align: left; font-family: var(--sans); font-size: 13.5px; font-weight: 600; color: var(--text); padding: 3px 6px; touch-action: manipulation; -webkit-tap-highlight-color: transparent; transition: color var(--m-fast) ease, background-color var(--m-fast) ease, transform var(--m-instant) ease; }
  .dgl-label span:not(.dgl-label-tile) { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* The top-level entries are plain text color (the open page already turns peach); only the pages inside an open part are dimmed. */
  .dgl-label:hover { color: var(--text); background: var(--card-hover); }
  .dgl-label:active { transform: scale(var(--m-press)); }
  .dgl-label-tile { display: grid; place-items: center; flex-shrink: 0; width: 24px; height: 24px; border-radius: 8px; background: color-mix(in srgb, var(--text) 5%, transparent); color: var(--text-dim); transition: background-color var(--m-base) ease, color var(--m-base) ease; }
  .dgl-label :global(.dgl-label-icon) { transition: transform var(--m-base) var(--m-soft); }
  .dgl-label:active :global(.dgl-label-icon) { transform: scale(.85); }
  .dgl-group:not(.closed) .dgl-label { color: var(--text); }
  .dgl-group:not(.closed) .dgl-label-tile, .dgl-group.has-active .dgl-label-tile { background: var(--accent-soft); color: var(--accent); }
  .dgl-label :global(.dgl-label-caret) { flex-shrink: 0; color: var(--text-dim); transition: transform var(--m-slow) var(--m-out); }
  .dgl-group.closed .dgl-label :global(.dgl-label-caret), .dgl-group.folding .dgl-label :global(.dgl-label-caret) { transform: rotate(-90deg); }
  /* A folded part hides its links at once; the motion is in the links (they fade in one after the other or fade out together) and in the
     parts below, which slide with transforms (the script of the menu). Nothing animates a height. */
  .dgl-items { display: block; }
  .dgl-group.closed .dgl-items { display: none; }
  .dgl-items-inner { display: flex; flex-direction: column; gap: 0; margin: 1px 0 4px 14px; padding-left: 6px; border-left: 1px solid var(--border-soft); }
  .dgl-group.unfolding .dgl-link { animation: dgl-link-in var(--m-slow) var(--m-out) backwards; }
  .dgl-group.unfolding .dgl-link:nth-child(2) { animation-delay: 20ms; }
  .dgl-group.unfolding .dgl-link:nth-child(3) { animation-delay: 40ms; }
  .dgl-group.unfolding .dgl-link:nth-child(4) { animation-delay: 60ms; }
  .dgl-group.unfolding .dgl-link:nth-child(5) { animation-delay: 80ms; }
  .dgl-group.unfolding .dgl-link:nth-child(n+6) { animation-delay: 100ms; }
  .dgl-group.folding .dgl-items-inner { animation: dgl-items-out 130ms var(--m-in) both; pointer-events: none; }
  @keyframes dgl-link-in { from { opacity: 0; transform: translateX(-6px); } to { opacity: 1; transform: none; } }
  @keyframes dgl-items-out { to { opacity: 0; transform: translateY(-4px); } }
  .dgl-link { position: relative; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-muted); text-decoration: none; padding: 5px 8px; border-radius: 8px; -webkit-tap-highlight-color: transparent; transition: color var(--m-fast) ease, background-color var(--m-fast) ease, transform var(--m-instant) ease; }
  .dgl-link:active { transform: scale(.98); }
  /* The tabs of the feeds (and only those) have the color of their platform on the icon. */
  .dgl-link[style*="--nav-c"] svg { color: var(--nav-c); }
  .dgl-link[style*="--nav-c"].active { background-color: color-mix(in srgb, var(--nav-c) 14%, transparent); }
  .dgl-link-text { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* In the menu a New, Updated or Soon mark is a small colored dot (the word is its tooltip and stays in the page for screen readers), so no
     language makes a row longer than its label. */
  .dgl-link > .dgl-new:not(.dgl-badge-icon) { font-size: 0; letter-spacing: 0; width: 7px; height: 7px; padding: 0; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 18%, transparent); margin-right: 3px; }
  .dgl-new.dgl-badge-icon { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 20px; height: 18px; padding: 0; }
  .dgl-new { flex: none; }
  .dgl-soon { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 14%, transparent); }
  .dgl-new { font-family: var(--mono); font-style: normal; font-size: 8.5px; font-weight: 600; letter-spacing: .02em; text-transform: uppercase; color: var(--accent); background: var(--accent-soft); padding: 1px 4px; border-radius: 5px; margin-left: auto; }
  .dgl-new.dgl-updated { color: var(--green, #3ba55d); background: color-mix(in srgb, var(--green, #3ba55d) 14%, transparent); }
  .dgl-new.dgl-soon { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 14%, transparent); }
  .dgl-link:hover { color: var(--text); background: var(--card-hover); }
  /* The open page: a soft pill, and a small bar that sits on the guide line of its part. */
  .dgl-link.active { color: var(--accent); background: var(--accent-soft); font-weight: 600; }
  .dgl-link::before { content: ''; position: absolute; left: -11px; top: 50%; width: 3px; height: 18px; border-radius: 3px; background: var(--accent); transform: translateY(-50%) scaleY(0); transition: transform var(--m-slow) var(--m-out); }
  .dgl-link.active::before { transform: translateY(-50%) scaleY(1); }
  .dgl-link :global(svg) { flex-shrink: 0; color: var(--text-dim); transition: transform var(--m-base) ease, color var(--m-fast) ease; }
  .dgl-link:hover :global(svg) { transform: translateX(1px); }
  .dgl-link.active :global(svg) { color: var(--accent); }
  .dgl-link .dgl-premium-crown { margin-left: auto; color: var(--yellow); opacity: .9; }
  @media (prefers-reduced-motion: reduce) { .dgl-group.unfolding .dgl-link, .dgl-group.folding .dgl-items-inner { animation: none; } }

  .dgl-side-version { flex: none; padding: 0 14px 8px; font-family: var(--mono); font-size: 10.5px; color: var(--text-dim); opacity: 0.8; }

  .dgl-dev-banner { display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap; padding:12px 14px; margin-bottom:18px; border:1px solid color-mix(in srgb,var(--accent) 45%,var(--border)); border-radius:12px; background:var(--accent-soft); }
