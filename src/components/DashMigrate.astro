---
// Moving from another bot: (1) a converter that rewrites the variables of a welcome or any message written for MEE6, Carl-bot or Dyno into Petto's,
// and (2) a checklist of what to rebuild, with a link to the page of Petto for each thing. A bot can not read the settings of another bot (Discord does
// not allow it), so nothing is read from the old one and nothing is saved here: the ticks stay in this browser. The rules are in src/utils/botMigration.ts.
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import { getDashLang, makeT } from '../i18n/dash';
import { BOTS, CHECKLISTS, FEATURE_PAGES, MOVE_STEPS, type BotId, type FeatureId, type MoveStep } from '../utils/botMigration';

interface Props {
  user: { username: string; avatar: string | null; userId?: string };
  guildId: string; guildName: string; guildIcon: string;
  canRun: boolean;
}
const { user, guildId, guildName, guildIcon, canRun } = Astro.props;
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const docsUrl = `https://wiki.petto.sbs${dashLang === 'es' ? '/es' : dashLang === 'pt-BR' ? '/pt-br' : ''}/guides/migrating-from-another-bot`;
const base = `/dash/guild/${guildId}`;

const STEP_TEXT: Record<MoveStep, { title: string; text: string; page?: string }> = {
  'keep-both': { title: dt('Add Petto and keep the old bot on'), text: dt('Never switch the old one off first: for a few days both run, so the server is never left without moderation.') },
  'write-down': { title: dt('Write down what matters'), text: dt('Open the dashboard of the old bot and copy your texts, role menus, commands and channels. Petto cannot read the settings of another bot.') },
  'quick-setup': { title: dt('Run Quick Setup'), text: dt('It makes the log, auto moderation, welcome, auto role, tickets and verification in seven steps, and nothing changes until the last one.'), page: 'quick-setup' },
  'messages': { title: dt('Convert your messages'), text: dt('Paste each welcome, goodbye or custom text in the converter above and copy the result into its Petto page.') },
  'features': { title: dt('Rebuild the rest, one by one'), text: dt('Each row below is something the old bot does, with the page of Petto where it lives now.') },
  'test': { title: dt('Test each thing once'), text: dt('Send a test welcome, open a test ticket, trigger a test autoresponder. When it all works, remove the old bot.') },
  'remove-old': { title: dt('Remove the old bot'), text: dt('Only when everything works. Its history stays with it: Petto starts its own from the day you add it.') },
};
const FEATURE_TEXT: Record<FeatureId, string> = {
  'welcome': dt('Welcome and goodbye messages'), 'reaction-roles': dt('Reaction roles'), 'levels': dt('XP and levels'), 'custom-commands': dt('Custom commands'),
  'autoresponders': dt('Autoresponders and automations'), 'polls': dt('Polls'), 'giveaways': dt('Giveaways'), 'feeds': dt('Social alerts and feeds'), 'birthdays': dt('Birthday messages'),
  'boards': dt('Starboard'), 'timers': dt('Timers, reminders and automessages'), 'voicemaster': dt('Temporary voice channels'), 'moderation': dt('Moderation and case log'),
  'sticky-roles': dt('Sticky roles'), 'automod': dt('Auto moderation'), 'logging': dt('Logging'), 'suggestions': dt('Suggestions'), 'permissions': dt('Command permissions'),
  'sticky-messages': dt('Sticky messages'), 'tickets': dt('Tickets'), 'forms': dt('Forms'), 'join-roles': dt('Roles for new members'), 'prefix': dt('Custom prefix'), 'embeds': dt('Embeds'),
};
// What does not move, by bot. Only said where the official pages of the bot say the thing exists.
const NOT_MOVING: Partial<Record<BotId, string[]>> = {
  mee6: [dt('MEE6 has an Economy plugin and Petto has no economy system. If your server runs on it, keep MEE6 for that.'), dt('The XP of your members does not move by itself.')],
  carl: [dt('TagScript tags do not run in Petto: each tag has to be rewritten with Petto variables or Petto Code.'), dt('The infractions and modlogs of the old bot stay there. Petto starts its own case log.')],
  dyno: [dt('Dyno commands and autoresponders have their own syntax: copy the text and rebuild the trigger in Petto.'), dt('Autodelete and autopurge are Dyno modules: check Moderation rules and Timers before you switch them off.')],
  probot: [dt('Colors, Temp Links, Anti-Raid and VIP Protection of ProBot are not in this list: check the Security pages of Petto and rebuild them by hand.'), dt('The XP of your members does not move by itself.')],
  nekotina: [dt('Only the welcome, the custom commands and the autoroles of Nekotina are in this list: the rest of the bot is not checked yet.')],
};
const HINTS: Record<string, string> = {
  'hash': dt('Discord image hashes have no equivalent. Use the variables with the full picture address (user avatar, server icon).'),
  'math': dt('Messages in Petto have no calculations. Write the result yourself.'),
  'bot-joined': dt('Petto has no variable for the day the bot joined the server.'),
  'mention-name': dt('Petto mentions by ID: write <@ and the ID of the person, then >.'),
  'role-name': dt('Petto mentions a role by ID: write <@& and the ID of the role, then >.'),
  'channel-name': dt('Petto links a channel by ID: write <# and the ID of the channel, then >, or use the variable of the current channel.'),
  'no-equivalent': dt('Petto has no variable that gives this.'),
  'command-argument': dt('The arguments of a Nekotina command are read in Petto with the variables of custom commands: look them up with !variables.'),
  'unknown': dt('Petto does not know this variable. Look it up with !variables or leave it out.'),
};
const AI_MODES = [
  { id: 'rewrite', label: dt('Rewrite for Petto'), hint: dt('Paste a command, tag or autoresponder of the old bot and the AI rewrites it for Petto.') },
  { id: 'plan', label: dt('What to set up'), hint: dt('Say what you had in the old bot (its modules, commands, roles) and the AI proposes what to set up in Petto.') },
  { id: 'ask', label: dt('Ask a question'), hint: dt('Ask anything about moving to Petto.') },
] as const;
const bots = BOTS.map((bot) => ({ ...bot, checklist: CHECKLISTS[bot.id] }));
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="migrate" pageTitle={dt('Migrate from another bot')}>
  <DashSettingsKit />
  <div class="sx-page mg" data-migrate data-guild={guildId}
    data-l-copy={dt('Copy the result')} data-l-copied={dt('Copied')}>
    <div class="mg-head">
      <h1>{dt('Migrate from another bot')}</h1>
      <a class="btn btn-sm" href={docsUrl} target="_blank" rel="noopener"><Icon name="ph:book-open-fill" width="13" height="13" />{dt('Read the docs')}</a>
    </div>
    <p class="sx-lead">{dt('Move your server without a gap. A bot cannot read the settings of another one (Discord does not allow it), so Petto rewrites your messages here and keeps the list of what is left to rebuild.')}</p>

    <div class="mg-bots" role="tablist" aria-label={dt('Bot you come from')}>
      {bots.map((bot, i) => (
        <button type="button" class="mg-bot" role="tab" data-bot={bot.id} aria-selected={i === 0 ? 'true' : 'false'}>{bot.name}</button>
      ))}
    </div>

    <div class="mg-unverified" data-unverified hidden>
      <Icon name="ph:info-fill" width="15" height="15" />
      <span>{dt('The variables of this bot are not checked yet (its website does not let its documentation be read), so Petto does not guess: your text comes back exactly as you wrote it.')}</span>
    </div>

    <section class="sx-panel mg-box">
      <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#7cc4ff"><Icon name="ph:arrows-left-right-fill" width="17" height="17" /></span><h2>{dt('Convert a message')}</h2></div>
      <div class="mg-cols">
        <div class="sx-field">
          <label for="mg-in">{dt('Message from the old bot')}</label>
          <textarea id="mg-in" class="dgl-autogrow" rows="4" spellcheck="false" data-in></textarea>
        </div>
        <div class="sx-field">
          <div class="mg-lab">
            <label for="mg-out">{dt('Message for Petto')}</label>
            <button type="button" class="btn btn-sm mg-copy" data-copy><Icon name="ph:copy-bold" width="13" height="13" /><span data-copy-label>{dt('Copy the result')}</span></button>
          </div>
          <textarea id="mg-out" class="dgl-autogrow" rows="4" spellcheck="false" readonly data-out></textarea>
        </div>
      </div>
      <div class="mg-result" data-result hidden>
        <div class="mg-block" data-changes-box hidden>
          <h3>{dt('What changed')}</h3>
          <ul class="mg-changes" data-changes></ul>
        </div>
        <div class="mg-block mg-bad" data-unsupported-box hidden>
          <h3><Icon name="ph:warning-fill" width="14" height="14" />{dt('Could not be converted')}</h3>
          <ul class="mg-unsupported" data-unsupported></ul>
        </div>
        <div class="mg-block" data-preview-box hidden>
          <h3>{dt('How it reads')}</h3>
          <p class="mg-preview" data-preview></p>
        </div>
      </div>
      <div hidden>{Object.entries(HINTS).map(([code, text]) => <span data-hint={code}>{text}</span>)}</div>
    </section>

    <section class="sx-panel mg-box" data-ai data-can-run={canRun ? '1' : '0'}
      data-l-busy={dt('Thinking…')} data-l-copy={dt('Copy')} data-l-copied={dt('Copied')} data-l-failed={dt('Could not reach Petto. Try again in a moment.')} data-l-unknown={dt('The AI used variables Petto does not have. Check them before you paste:')}>
      <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#b4a5f5"><Icon name="ph:sparkle-fill" width="17" height="17" /></span><h2>{dt('AI helper')}</h2></div>
      {!canRun && <div class="mg-unverified"><Icon name="ph:info-fill" width="15" height="15" /><span>{dt('Only people with Manage Server can use the AI helper.')}</span></div>}
      <div class="mg-bots" role="tablist" aria-label={dt('What should the AI do?')}>
        {AI_MODES.map((mode, i) => (
          <button type="button" class="mg-bot" role="tab" data-ai-mode={mode.id} data-hint={mode.hint} aria-selected={i === 0 ? 'true' : 'false'}>{mode.label}</button>
        ))}
      </div>
      <div class="sx-field">
        <label for="mg-ai-in" data-ai-hint>{AI_MODES[0].hint}</label>
        <textarea id="mg-ai-in" class="dgl-autogrow" rows="4" maxlength="1500" spellcheck="false" data-ai-in disabled={!canRun}></textarea>
      </div>
      <div class="mg-ai-row">
        <button type="button" class="btn btn-accent" data-ai-send disabled={!canRun}><Icon name="ph:sparkle-fill" width="13" height="13" />{dt('Ask the AI')}</button>
        <span class="mg-ai-note">{dt('The AI only proposes: it never changes your server. It can be wrong, so read it before you use it. Your text is sent to an AI service (Groq) to get the answer and Petto does not store it.')}</span>
      </div>
      <p class="mg-ai-error" data-ai-error role="alert" hidden></p>
      <div class="mg-block mg-bad" data-ai-unknown hidden><h3><Icon name="ph:warning-fill" width="14" height="14" /><span data-ai-unknown-title></span></h3><ul class="mg-unsupported" data-ai-unknown-list></ul></div>
      <div class="mg-answer" data-ai-answer hidden></div>
    </section>

    <section class="sx-panel mg-box">
      <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#6ee7a1"><Icon name="ph:list-checks-fill" width="17" height="17" /></span><h2>{dt('Checklist')}</h2><span class="sx-tag" data-progress></span></div>
      {bots.map((bot, i) => (
        <div class="mg-list" data-list={bot.id} hidden={i !== 0}>
          <ol class="mg-items">
            {MOVE_STEPS.filter((step) => step !== 'features' || bot.checklist.length > 0).map((step) => (
              <>
                <li class="mg-item">
                  <label class="mg-check"><input type="checkbox" data-item={`${bot.id}:${step}`} /><span class="mg-box-icon"><Icon name="ph:check-circle-fill" width="18" height="18" /></span>
                    <span class="mg-text"><b>{STEP_TEXT[step].title}</b><em>{STEP_TEXT[step].text}</em></span>
                  </label>
                  {STEP_TEXT[step].page && <a class="mg-go" href={`${base}/${STEP_TEXT[step].page}`}>{dt('Open')}</a>}
                </li>
                {step === 'features' && bot.checklist.map((feature) => (
                  <li class="mg-item mg-sub">
                    <label class="mg-check"><input type="checkbox" data-item={`${bot.id}:f:${feature}`} /><span class="mg-box-icon"><Icon name="ph:check-circle-fill" width="18" height="18" /></span>
                      <span class="mg-text"><b>{FEATURE_TEXT[feature]}</b></span>
                    </label>
                    <a class="mg-go" href={`${base}/${FEATURE_PAGES[feature]}`}>{dt('Open')}</a>
                  </li>
                ))}
              </>
            ))}
          </ol>
          {(NOT_MOVING[bot.id] ?? []).length > 0 && (
            <div class="mg-block">
              <h3>{dt('What does not move')}</h3>
              <ul class="mg-notes">{NOT_MOVING[bot.id]!.map((text) => <li>{text}</li>)}</ul>
            </div>
          )}
        </div>
      ))}
    </section>
  </div>
</DashGuildLayout>

<script>
  import { BOTS, SAMPLE_TEXT, convertMessage, isBotId, previewText } from '../utils/botMigration';
  import { sampleContext, tokenValues } from '../utils/variableSamples';
  import { parseMarkdown, type Inline } from '../utils/miniMarkdown';

  const root = document.querySelector<HTMLElement>('[data-migrate]');
  if (root) {
    const guild = root.dataset.guild ?? '';
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const input = q<HTMLTextAreaElement>('[data-in]');
    const output = q<HTMLTextAreaElement>('[data-out]');
    const result = q<HTMLElement>('[data-result]');
    const values = tokenValues(sampleContext);
    let bot = 'mee6';
    try { const saved = localStorage.getItem(`petto-migrate-bot:${guild}`); if (saved && isBotId(saved)) bot = saved; } catch { /* storage can be blocked */ }

    const hint = (code: string) => root.querySelector(`[data-hint="${code}"]`)?.textContent ?? '';
    const fill = (box: HTMLElement, list: HTMLElement, rows: HTMLElement[]) => { list.replaceChildren(...rows); box.hidden = rows.length === 0; };
    const code = (text: string) => { const el = document.createElement('code'); el.textContent = text; return el; };

    const convert = () => {
      const info = BOTS.find((item) => item.id === bot)!;
      const out = convertMessage(info.id, input.value);
      output.value = out.text;
      output.dispatchEvent(new Event('input', { bubbles: true }));
      const has = input.value.trim().length > 0;
      result.hidden = !has;
      fill(q('[data-changes-box]'), q('[data-changes]'), out.changes.map((change) => {
        const li = document.createElement('li');
        li.append(code(change.from), ' → ', code(change.to));
        if (change.count > 1) li.append(` ×${change.count}`);
        return li;
      }));
      fill(q('[data-unsupported-box]'), q('[data-unsupported]'), out.unsupported.map((item) => {
        const li = document.createElement('li');
        const why = document.createElement('span');
        why.textContent = hint(item.hint);
        li.append(code(item.token), why);
        return li;
      }));
      q('[data-preview-box]').hidden = !has || !out.verified;
      q('[data-preview]').textContent = out.verified ? previewText(out.text, values) : '';
    };

    const progress = () => {
      const boxes = [...root.querySelectorAll<HTMLInputElement>(`[data-list="${bot}"] input[data-item]`)];
      q('[data-progress]').textContent = boxes.length ? `${boxes.filter((box) => box.checked).length} / ${boxes.length}` : '';
    };

    const show = (next: string) => {
      bot = next;
      try { localStorage.setItem(`petto-migrate-bot:${guild}`, bot); } catch { /* storage can be blocked */ }
      root.querySelectorAll<HTMLElement>('[data-bot]').forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.bot === bot)));
      root.querySelectorAll<HTMLElement>('[data-list]').forEach((list) => { list.hidden = list.dataset.list !== bot; });
      q('[data-unverified]').hidden = BOTS.find((item) => item.id === bot)!.verified;
      input.placeholder = SAMPLE_TEXT[bot as keyof typeof SAMPLE_TEXT] ?? '';
      progress();
      convert();
    };

    root.querySelectorAll<HTMLElement>('[data-bot]').forEach((tab) => tab.addEventListener('click', () => show(tab.dataset.bot ?? 'mee6')));
    input.addEventListener('input', convert);

    // The ticks stay in this browser, for each server.
    let ticked: string[] = [];
    try { ticked = JSON.parse(localStorage.getItem(`petto-migrate:${guild}`) ?? '[]'); } catch { /* storage can be blocked */ }
    root.querySelectorAll<HTMLInputElement>('input[data-item]').forEach((box) => {
      box.checked = ticked.includes(box.dataset.item ?? '');
      box.addEventListener('change', () => {
        const key = box.dataset.item ?? '';
        ticked = box.checked ? [...new Set([...ticked, key])] : ticked.filter((item) => item !== key);
        try { localStorage.setItem(`petto-migrate:${guild}`, JSON.stringify(ticked)); } catch { /* storage can be blocked */ }
        progress();
      });
    });

    let timer = 0;
    q('[data-copy]').addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(output.value); } catch { output.select(); document.execCommand('copy'); }
      const label = q('[data-copy-label]');
      label.textContent = root.dataset.lCopied ?? '';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => { label.textContent = root.dataset.lCopy ?? ''; }, 1600);
    });

    // The AI helper: it only proposes. The answer is shown as text (never as markup); what is inside ``` is a block that can be copied.
    const ai = q<HTMLElement>('[data-ai]');
    const aiIn = q<HTMLTextAreaElement>('[data-ai-in]');
    const aiSend = q<HTMLButtonElement>('[data-ai-send]');
    const aiError = q<HTMLElement>('[data-ai-error]');
    const aiAnswer = q<HTMLElement>('[data-ai-answer]');
    let aiMode = 'rewrite';
    const lab = (key: string) => ai.dataset[key] ?? '';
    const copyText = async (text: string, button: HTMLElement, label: HTMLElement) => {
      try { await navigator.clipboard.writeText(text); } catch { /* the text can still be selected by hand */ }
      label.textContent = lab('lCopied');
      window.setTimeout(() => { label.textContent = lab('lCopy'); }, 1600);
      button.blur();
    };
    ai.querySelectorAll<HTMLElement>('[data-ai-mode]').forEach((tab) => tab.addEventListener('click', () => {
      aiMode = tab.dataset.aiMode ?? 'rewrite';
      ai.querySelectorAll<HTMLElement>('[data-ai-mode]').forEach((other) => other.setAttribute('aria-selected', String(other === tab)));
      q('[data-ai-hint]').textContent = tab.dataset.hint ?? '';
    }));
    const inlineNodes = (parts: Inline[]): Node[] => parts.map((part) => {
      if (part.t === 'text') return document.createTextNode(part.v);
      const el = document.createElement(part.t === 'bold' ? 'strong' : part.t === 'italic' ? 'em' : 'code');
      el.textContent = part.v;
      return el;
    });
    const showAnswer = (answer: string) => {
      const nodes: HTMLElement[] = parseMarkdown(answer).map((block) => {
        if (block.t === 'code') {
          const box = document.createElement('div');
          box.className = 'mg-code';
          const pre = document.createElement('pre');
          pre.textContent = block.v;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'btn btn-sm';
          const label = document.createElement('span');
          label.textContent = lab('lCopy');
          btn.append(label);
          btn.addEventListener('click', () => copyText(block.v, btn, label));
          box.append(pre, btn);
          return box;
        }
        if (block.t === 'list') {
          const list = document.createElement(block.ordered ? 'ol' : 'ul');
          if (block.ordered) (list as HTMLOListElement).start = block.start;
          if (block.level === 1) list.dataset.l = '1';
          for (const item of block.items) { const li = document.createElement('li'); li.append(...inlineNodes(item)); list.append(li); }
          return list;
        }
        const el = document.createElement(block.t === 'h' ? 'h4' : 'p');
        el.append(...inlineNodes(block.inline));
        return el;
      });
      aiAnswer.replaceChildren(...nodes);
      aiAnswer.hidden = nodes.length === 0;
    };
    aiSend.addEventListener('click', async () => {
      const text = aiIn.value.trim();
      aiError.hidden = true;
      if (!text || aiSend.disabled) { if (!text) aiIn.focus(); return; }
      aiSend.disabled = true;
      const idle = aiSend.innerHTML;
      aiSend.textContent = lab('lBusy');
      try {
        const res = await fetch(`/dash/guild/${guild}/migrate-ai`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mode: aiMode, bot, text }) });
        const data = await res.json().catch(() => null);
        if (!res.ok || !data?.ok) throw new Error(data?.message || lab('lFailed'));
        showAnswer(String(data.answer ?? ''));
        const unknown: string[] = Array.isArray(data.unknown) ? data.unknown : [];
        q('[data-ai-unknown-title]').textContent = lab('lUnknown');
        fill(q('[data-ai-unknown]'), q('[data-ai-unknown-list]'), unknown.map((token) => { const li = document.createElement('li'); li.append(code(token)); return li; }));
      } catch (error) {
        aiAnswer.hidden = true;
        q('[data-ai-unknown]').hidden = true;
        aiError.textContent = error instanceof Error && error.message ? error.message : lab('lFailed');
        aiError.hidden = false;
      } finally {
        aiSend.innerHTML = idle;
        aiSend.disabled = ai.dataset.canRun !== '1';
      }
    });

    show(bot);
  }
</script>

<style>
  h1 { font-size: 24px; margin: 0; }
  .mg { max-width: 1040px; }
  .mg-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
  .mg :global(.sx-lead) { margin-bottom: 16px; }
  .mg-bots { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
  .mg-bot { border: 1px solid var(--border); background: var(--card); color: var(--text-muted); border-radius: 999px; padding: 7px 16px; font: inherit; font-size: 13.5px; font-weight: 600; cursor: pointer; transition: background .15s ease, border-color .15s ease, color .15s ease; }
  .mg-bot:hover { color: var(--text); border-color: var(--text-dim); }
  .mg-bot[aria-selected="true"] { color: #6ee7a1; border-color: color-mix(in srgb, #6ee7a1 55%, transparent); background: color-mix(in srgb, #6ee7a1 12%, transparent); }
  .mg-bot:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .mg-unverified { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 14px; padding: 11px 14px; border-radius: 12px; border: 1px solid color-mix(in srgb, #f5c26b 45%, transparent); background: color-mix(in srgb, #f5c26b 10%, transparent); color: var(--text); font-size: 13.5px; line-height: 1.5; }
  .mg-unverified[hidden] { display: none; }
  .mg-unverified :global(svg) { flex: none; margin-top: 2px; color: #f5c26b; }
  .mg-box { margin-bottom: 14px; gap: 14px; }
  .mg-cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px; align-items: start; }
  .mg-lab { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 28px; }
  .mg-lab label { margin: 0; }
  .mg-result { display: flex; flex-direction: column; gap: 12px; }
  .mg-result[hidden], .mg-block[hidden], .mg-list[hidden] { display: none; }
  .mg-block { border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; background: var(--bg-raise); }
  .mg-block h3 { margin: 0 0 8px; font-size: 12.5px; letter-spacing: .04em; text-transform: uppercase; color: var(--text-dim); display: flex; align-items: center; gap: 6px; }
