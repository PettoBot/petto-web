---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MultiSelect from './MultiSelect.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface Reply { text: string; template: string; }
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  section: string;
  uploads: { enabled: boolean; channelIds: string[]; uploaderRoleId: string; welcome: Reply };
  requests: { enabled: boolean; channelId: string; staffRoleId: string; pingRoleId: string; maxOpen: number; completionHours: number; created: Reply };
  reviews: { enabled: boolean; channelId: string };
  openRequests: { number: number; userId: string; content: string; status: string; claimedBy: string }[];
  uploadStats: { total: number; week: number; board: { userId: string; count: number }[] };
  channels: { id: string; name: string; text: boolean }[];
  roles: { id: string; name: string }[];
  embedTemplates: { name: string; v2: boolean }[];
  uploadChannelLimit: number;
  premium: boolean;
  ready: boolean;
  saved: boolean;
  notice: string;
}
const { user, guildId, guildName, guildIcon, section, uploads, requests, reviews, openRequests, uploadStats, channels, roles, embedTemplates, uploadChannelLimit, premium, ready, saved, notice } = Astro.props;
const textChannels = channels.filter((ch) => ch.text);
const titles: Record<string, string> = { uploads: 'Uploads', requests: 'Requests', reviews: 'Reviews and profiles' };
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={section} pageTitle={titles[section]}>
  <h1>{dt(titles[section])}</h1>
  {saved && <div class="tl-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {notice === 'channel_limit' && <div class="tl-flash tl-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('Only the first {a} channels were kept. Premium raises the limit.', { a: uploadChannelLimit })}</div>}
  {notice === 'premium_timeout' && <div class="tl-flash tl-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('Sending a claimed request back to open by itself is a Premium feature.')}</div>}
  {!ready && <div class="tl-flash tl-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}

  {section === 'uploads' && (
    <>
      <p class="tl-sub"><Fragment set:html={dth('Counts the messages with files in the channels you choose, for <b>{a}</b>. The first upload of a member gives the uploader role and sends a welcome.', { a: guildName })} /></p>
      <div class="tl-stats"><div class="tl-stat"><b>{uploadStats.week}</b><span>{dt('This week')}</span></div><div class="tl-stat"><b>{uploadStats.total}</b><span>{dt('All time')}</span></div></div>
      <div class="tl-grid">
        <form method="POST" class="tl-form">
          <input type="hidden" name="action" value="save_uploads" />
          <label class="tl-check"><input type="checkbox" name="enabled" checked={uploads.enabled} />{dt('Count uploads')}</label>
          <div class="tl-field"><label>{dt('Upload channels')}</label>
            <MultiSelect lazy name="channel_ids" options={channels.map((ch) => ({ id: ch.id, name: `#${ch.name}` }))} selected={uploads.channelIds} placeholder={dt('Search channels...')} />
            <span class="tl-note">{dt('Free servers can have {a}, Premium 100.', { a: 20 })}</span></div>
          <div class="tl-field"><label>{dt('Uploader role')}</label><select name="uploader_role_id"><option value="">{dt('None')}</option>{roles.map((role) => <option value={role.id} selected={role.id === uploads.uploaderRoleId}>{role.name}</option>)}</select></div>
          <div class="tl-field"><label>{dt('Welcome at the first upload')}</label><textarea name="welcome_text" rows="3" maxlength="2000" placeholder="Thanks for your first upload, {user.mention}! You are an uploader now.">{uploads.welcome.text}</textarea>
            <select name="welcome_template"><option value="">{dt('No saved embed')}</option>{embedTemplates.map((tpl) => <option value={tpl.name} selected={tpl.name === uploads.welcome.template}>{tpl.name}{tpl.v2 ? ' (V2)' : ''}</option>)}</select></div>
          <button type="submit" class="btn btn-accent btn-sm" disabled={!ready}>{dt('Save changes')}</button>
        </form>
        <aside class="tl-side"><section class="tl-card"><h2>{dt('This week')}</h2>
          {uploadStats.board.length ? <ol>{uploadStats.board.map((entry) => <li><code>{entry.userId}</code><b>{entry.count}</b></li>)}</ol> : <p class="tl-note">{dt('Nobody has uploaded in this period.')}</p>}
        </section><p class="tl-note">{dt('Commands: !uploads stats, !uploads leaderboard and !uploadconfig.')}</p></aside>
      </div>
    </>
  )}

  {section === 'requests' && (
    <>
      <p class="tl-sub"><Fragment set:html={dth('Members of <b>{a}</b> ask for something with the command, and the staff claims and finishes it with the buttons of a card.', { a: guildName })} /></p>
      <div class="tl-grid">
        <form method="POST" class="tl-form">
          <input type="hidden" name="action" value="save_requests" />
          <label class="tl-check"><input type="checkbox" name="enabled" checked={requests.enabled} />{dt('Accept requests')}</label>
          <div class="tl-field"><label>{dt('Channel for the cards')}</label><select name="channel_id"><option value="">{dt('None')}</option>{textChannels.map((ch) => <option value={ch.id} selected={ch.id === requests.channelId}>#{ch.name}</option>)}</select></div>
          <div class="tl-row">
            <div class="tl-field"><label>{dt('Staff role')}</label><select name="staff_role_id"><option value="">{dt('Who can manage messages')}</option>{roles.map((role) => <option value={role.id} selected={role.id === requests.staffRoleId}>{role.name}</option>)}</select></div>
            <div class="tl-field"><label>{dt('Role to ping')}</label><select name="ping_role_id"><option value="">{dt('None')}</option>{roles.map((role) => <option value={role.id} selected={role.id === requests.pingRoleId}>{role.name}</option>)}</select></div>
          </div>
          <div class="tl-row">
            <div class="tl-field"><label>{dt('Open requests per member')}</label><input type="number" name="max_open" min="1" max="25" value={requests.maxOpen} /></div>
            <div class="tl-field"><label>{dt('Hours to finish a claimed request')} {premium ? '' : '(Premium)'}</label><input type="number" name="completion_hours" min="0" max="720" value={requests.completionHours} disabled={!premium} /></div>
          </div>
          <span class="tl-note">{dt('0 hours means no limit. After the time, a claimed request goes back to open by itself.')}</span>
          <div class="tl-field"><label>{dt('Answer to who makes a request')}</label><textarea name="created_text" rows="3" maxlength="2000" placeholder="{user.mention} your request #{request.number} is in. The staff will look at it: {request.link}">{requests.created.text}</textarea>
            <select name="created_template"><option value="">{dt('No saved embed')}</option>{embedTemplates.map((tpl) => <option value={tpl.name} selected={tpl.name === requests.created.template}>{tpl.name}{tpl.v2 ? ' (V2)' : ''}</option>)}</select>
            <span class="tl-note">{dt('Variables: {request.number}, {request.text}, {request.link}, {request.channel}.')}</span></div>
          <button type="submit" class="btn btn-accent btn-sm" disabled={!ready}>{dt('Save changes')}</button>
        </form>
        <aside class="tl-side"><section class="tl-card"><h2>{dt('Open requests')}</h2>
          {openRequests.length ? <ul>{openRequests.map((req) => <li><span><b>#{req.number}</b> <code>{req.userId}</code><small>{req.content.slice(0, 80)}</small></span><em>{req.status === 'claimed' ? dt('Claimed') : dt('Open')}</em></li>)}</ul> : <p class="tl-note">{dt('There are no open requests.')}</p>}
        </section><p class="tl-note">{dt('Commands: !request make, !request list and !requestconfig.')}</p></aside>
      </div>
    </>
  )}

  {section === 'reviews' && (
    <>
      <p class="tl-sub"><Fragment set:html={dth('Members of <b>{a}</b> rate each other from 1 to 5 stars. The profile shows the rating and the numbers of uploads, requests and partnerships.', { a: guildName })} /></p>
      <div class="tl-grid">
        <form method="POST" class="tl-form">
          <input type="hidden" name="action" value="save_reviews" />
          <label class="tl-check"><input type="checkbox" name="reviews_enabled" checked={reviews.enabled} />{dt('Allow reviews')}</label>
          <div class="tl-field"><label>{dt('Channel for new reviews')}</label><select name="review_channel_id"><option value="">{dt('None')}</option>{textChannels.map((ch) => <option value={ch.id} selected={ch.id === reviews.channelId}>#{ch.name}</option>)}</select>
            <span class="tl-note">{dt('Every new review is shown there. Empty shows them nowhere.')}</span></div>
          <button type="submit" class="btn btn-accent btn-sm" disabled={!ready}>{dt('Save changes')}</button>
        </form>
        <aside class="tl-side"><p class="tl-note">{dt('Commands: !review give, !review show, !review remove, !profile and !profileconfig.')}</p></aside>
      </div>
    </>
  )}
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  .tl-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 20px; max-width: 68ch; }
  .tl-sub :global(b) { color: var(--text); }
  .tl-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 16px; max-width: 640px; }
  .tl-flash-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: var(--yellow); }
  .tl-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; max-width: 420px; margin-bottom: 20px; }
  .tl-stat { border: 1px solid var(--border); border-radius: 12px; background: var(--card); padding: 12px 14px; display: flex; flex-direction: column; gap: 2px; }
  .tl-stat b { font-size: 24px; }
  .tl-stat span { font-size: 12px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.03em; }
  .tl-grid { display: grid; grid-template-columns: minmax(0, 640px) minmax(min(260px, 100%), 340px); gap: 28px; align-items: start; }
  @media (max-width: 960px) { .tl-grid { grid-template-columns: 1fr; } }
  .tl-form { display: flex; flex-direction: column; gap: 16px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 20px; }
  .tl-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr)); gap: 12px; }
  .tl-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .tl-field label { font-size: 12px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.03em; }
  .tl-field input, .tl-field select, .tl-field textarea { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; width: 100%; box-sizing: border-box; }
  .tl-field textarea { resize: vertical; font-family: var(--mono); font-size: 12.5px; }
  .tl-note { font-size: 11.5px; line-height: 1.4; color: var(--text-dim); }
  .tl-check { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--text); }
  .tl-side { display: flex; flex-direction: column; gap: 14px; }
  .tl-card { border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 14px 16px; }
  .tl-card h2 { font-size: 14px; margin: 0 0 8px; }
  .tl-card ol, .tl-card ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .tl-card li { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 13px; }
  .tl-card code { font-size: 12px; color: var(--text-muted); word-break: break-all; }
  .tl-card small { display: block; color: var(--text-dim); font-size: 11.5px; }
  .tl-card em { font-style: normal; font-size: 11.5px; color: var(--text-dim); }
</style>
