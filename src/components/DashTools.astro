---
import SilentMentionHint from './SilentMentionHint.astro';
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashAcData from './DashAcData.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import SxNumber from './SxNumber.astro';
import MultiSelect from './MultiSelect.astro';

import { getDashLang, makeT } from '../i18n/dash';
import { FREE_LIMITS, PREMIUM_LIMITS } from '../utils/planLimits';
import { rangeDays } from '../utils/activityStats';
import { formatDuration } from '../utils/formatDuration';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Reply { text: string; template: string; }
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  section: string;
  uploads: { enabled: boolean; channelIds: string[]; uploaderRoleId: string; welcome: Reply };
  requests: { enabled: boolean; channelId: string; staffRoleId: string; pingRoleId: string; maxOpen: number; completionHours: number; created: Reply };
  reviews: { enabled: boolean; channelId: string };
  openRequests: { number: number; userId: string; content: string; status: string; claimedBy: string }[];
  uploadStats: { total: number; capped?: boolean; week: number; today?: number; days?: number[]; board: { userId: string; count: number }[] };
  channels: { id: string; name: string; text: boolean }[];
  roles: { id: string; name: string }[];
  embedTemplates: { name: string; v2: boolean }[];
  uploadChannelLimit: number;
  premium: boolean;
  ready: boolean;
  saved: boolean;
  notice: string;
  people?: Record<string, { id: string; name: string | null; avatar: string }>;
  reviewStats?: { total: number; average: number; members: number; stars?: number[]; days?: number[]; week?: number; weekBefore?: number | null; top?: { userId: string; count: number; average: number }[] };
  reviewList?: { id: number; targetId: string; reviewerId: string; stars: number; comment: string; at: string }[];
  requestCounts?: { open: number; claimed: number; total: number; capped: boolean };
}
const { user, guildId, guildName, guildIcon, section, uploads, requests, reviews, openRequests, uploadStats, channels, roles, embedTemplates, uploadChannelLimit, premium, ready, saved, notice, people = {}, reviewStats = { total: 0, average: 0, members: 0 }, reviewList = [], requestCounts = { open: 0, claimed: 0, total: 0, capped: false } } = Astro.props;
const who = (userId: string) => people[userId] ?? { id: userId, name: null, avatar: `https://cdn.discordapp.com/embed/avatars/${Number(userId || 0) % 6}.png` };
const stars = (count: number) => '★'.repeat(count) + '☆'.repeat(5 - count);
const textChannels = channels.filter((ch) => ch.text);
const titles: Record<string, string> = { uploads: 'Uploads', requests: 'Requests', reviews: 'Reviews and profiles' };

// Times as "2h ago" (the compact format of the whole dashboard) and the days of the little bar charts (Petto's days, the same as the numbers).
const nowMs = Date.now();
const ago = (iso: string) => {
  const diff = nowMs - Date.parse(iso);
  if (!Number.isFinite(diff)) return '';
  return dt('{a} ago', { a: formatDuration(Math.max(0, diff) / 1000, { locale: dashLang }) });
};
const dayKeys = rangeDays(new Date(), 14);
const bars = (values: number[] = []) => {
  const top = Math.max(1, ...values);
  return dayKeys.map((key, i) => ({
    n: values[i] ?? 0,
    height: values[i] ? Math.max(6, Math.round((values[i] / top) * 100)) : 3,
    day: Number(key.slice(8)),
    name: new Date(`${key}T12:00:00Z`).toLocaleDateString(dashLang, { day: 'numeric', month: 'short', timeZone: 'UTC' }),
  }));
};
const sumOf = (values: number[] = []) => values.reduce((a, b) => a + b, 0);

const uploadBars = bars(uploadStats.days);
const uploads14 = sumOf(uploadStats.days);
const boardTop = Math.max(1, ...uploadStats.board.map((entry) => entry.count));
const reviewBars = bars(reviewStats.days);
const reviews14 = sumOf(reviewStats.days);
const starRows = [5, 4, 3, 2, 1].map((n) => ({ n, count: reviewStats.stars?.[n - 1] ?? 0 }));
const starsTop = Math.max(1, ...starRows.map((row) => row.count));
const openNow = Math.max(requestCounts.open, openRequests.filter((req) => req.status === 'open').length);
const claimedNow = Math.max(requestCounts.claimed, openRequests.filter((req) => req.status === 'claimed').length);
const requestsAll = Math.max(requestCounts.total, openNow + claimedNow);
const weekChange = reviewStats.weekBefore === undefined || reviewStats.weekBefore === null ? undefined : reviewStats.weekBefore > 0 ? Math.round((((reviewStats.week ?? 0) - reviewStats.weekBefore) / reviewStats.weekBefore) * 100) : (reviewStats.week ?? 0) > 0 ? null : undefined;
const moduleOn = section === 'uploads' ? uploads.enabled : section === 'requests' ? requests.enabled : reviews.enabled;
const moreOpen = openNow + claimedNow > openRequests.length;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={section} pageTitle={titles[section]}>
  <DashSettingsKit />
  <DashFormKit />
  <div class="sx-page tl">
  <h1 class="sx-title">{dt(titles[section])}<span class:list={['sx-pill-state', { on: moduleOn }]}>{moduleOn ? dt('On') : dt('Off')}</span></h1>
  {section !== 'reviews' && <DashAcData roles={roles} channels={textChannels} vars={section === 'requests' ? [{ tok: '{request.number}', desc: dt('Number of the request') }, { tok: '{request.text}', desc: dt('Text of the request') }, { tok: '{request.link}', desc: dt('Link of the request') }, { tok: '{request.channel}', desc: dt('Channel of the request') }] : []} />}
  {saved && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {notice === 'channel_limit' && <div class="sx-flash sx-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('Only the first {a} channels were kept. Premium raises the limit.', { a: uploadChannelLimit })}</div>}
  {notice === 'premium_timeout' && <div class="sx-flash sx-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('Sending a claimed request back to open by itself is a Premium feature.')}</div>}
  {notice === 'review_deleted' && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('The review was deleted. The profile of the member counts only the ones left.')}</div>}
  {notice === 'review_failed' && <div class="sx-flash sx-flash-bad" role="alert"><Icon name="ph:warning-fill" width="15" height="15" />{dt('The review could not be deleted. Try again in a moment.')}</div>}
  {!ready && <div class="sx-flash sx-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}

  {section === 'uploads' && (
    <>
      <DashStatTiles tiles={[
        { label: dt('Today'), value: uploadStats.today ?? 0, tone: 'messages' },
        { label: dt('This week'), value: uploadStats.week, tone: 'joins' },
        uploadStats.capped ? { label: dt('All time'), value: uploadStats.total, text: `${uploadStats.total.toLocaleString(dashLang)}+`, tone: 'invites' as const } : { label: dt('All time'), value: uploadStats.total, tone: 'invites' as const },
        { label: dt('Upload channels'), value: uploads.channelIds.length, tone: 'voice' },
      ]} />
      <div class="tl-cols">
        <form method="POST" class="sx-stack tl-form">
          <input type="hidden" name="action" value="save_uploads" />
          <label class="sx-switch sx-master"><input type="checkbox" name="enabled" checked={uploads.enabled} /><span class="sx-switch-text"><b>{dt('Count uploads')}</b><em>{dt('Petto counts the messages with files in the channels below.')}</em></span><i class="sx-toggle"></i></label>

          <section class="sx-panel" data-sx-needs="enabled">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--blue)"><Icon name="ph:hash-fill" width="17" height="17" /></span><h2>{dt('Channels and role')}</h2></div>
            <div class="sx-field"><span class="sx-label">{dt('Upload channels')}</span>
              <MultiSelect lazy name="channel_ids" options={channels.map((ch) => ({ id: ch.id, name: `#${ch.name}` }))} selected={uploads.channelIds} placeholder={dt('Search channels...')} />
              <span class="sx-hint">{dt('Free servers can have {a}, Premium {b}.', { a: FREE_LIMITS.uploadChannels, b: PREMIUM_LIMITS.uploadChannels })}</span></div>
            <div class="sx-field"><label for="tl-uploader">{dt('Uploader role')}</label><select id="tl-uploader" name="uploader_role_id"><option value="">{dt('None')}</option>{roles.map((role) => <option value={role.id} selected={role.id === uploads.uploaderRoleId}>{role.name}</option>)}</select><span class="sx-hint">{dt('The first upload of a member gives them this role and sends the welcome.')}</span></div>
          </section>

          <section class="sx-panel" data-sx-needs="enabled">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--green)"><Icon name="ph:hand-waving-fill" width="17" height="17" /></span><h2>{dt('Welcome at the first upload')}</h2></div>
            <div class="sx-field">
              <textarea id="tl-welcome" name="welcome_text" class="dgl-autogrow" data-ac data-count rows="3" maxlength="2000" aria-label={dt('Welcome at the first upload')} placeholder="Thanks for your first upload, {user.mention}! You are an uploader now.">{uploads.welcome.text}</textarea><SilentMentionHint />
            </div>
            <div class="sx-field"><label for="tl-welcome-embed">{dt('Saved embed')}</label>
              <select id="tl-welcome-embed" name="welcome_template" data-tpl-locks="welcome_text"><option value="">{dt('No saved embed')}</option>{embedTemplates.map((tpl) => <option value={tpl.name} selected={tpl.name === uploads.welcome.template}>{tpl.name}{tpl.v2 ? ' (V2)' : ''}</option>)}</select></div>
          </section>

          <div class="sx-foot tl-foot"><button type="submit" class="btn btn-accent btn-sm" disabled={!ready}><Icon name="ph:check-bold" width="13" height="13" />{dt('Save changes')}</button><p class="tl-cmds"><Icon name="ph:terminal-window-fill" width="14" height="14" />{dt('Commands: !uploads stats, !uploads leaderboard and !uploadconfig.')}</p></div>
        </form>

        <aside class="tl-side">
          <section class="sx-panel tl-block">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:trophy-fill" width="17" height="17" /></span><h2>{dt('This week')}</h2>{uploadStats.board.length > 0 && <span class="sx-tag">{uploadStats.week}</span>}</div>
            {uploadStats.board.length ? (
              <ol class="tl-ranks dgl-stagger">{uploadStats.board.map((entry, i) => (
                <li class="tl-rank">
                  <span class:list={['tl-rank-n', { 'tl-rank-top': i === 0 }]}>{i + 1}</span>
                  <img src={who(entry.userId).avatar} alt="" width="28" height="28" loading="lazy" referrerpolicy="no-referrer" />
                  <span class="tl-rank-main"><b>{who(entry.userId).name ?? entry.userId}</b><i style={`width:${Math.max(4, Math.round((entry.count / boardTop) * 100))}%`}></i></span>
                  <b class="tl-rank-count">{entry.count}</b>
                </li>
              ))}</ol>
            ) : <div class="tl-empty"><Icon name="ph:image-fill" width="24" height="24" /><p>{dt('Nobody has uploaded in this period.')}</p></div>}
          </section>
          <section class="sx-panel tl-block">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:chart-bar-fill" width="17" height="17" /></span><h2>{dt('Uploads in the last 14 days')}</h2>{uploads14 > 0 && <span class="sx-tag">{uploads14}</span>}</div>
            {uploads14 === 0 ? <p class="sx-empty"><Icon name="ph:chart-bar-fill" width="16" height="16" />{dt('No uploads in the last 14 days.')}</p> : (
              <div class="tl-bars" role="img" aria-label={dt('Uploads in the last 14 days')}>
                {uploadBars.map((d, i) => (
                  <div class:list={['tl-bar', { 'tl-bar-today': i === 13 }]} style={`--i:${i}`} title={`${d.name}: ${d.n}`}><em>{d.n || ''}</em><i style={`height:${d.height}%`}></i><span>{d.day}</span></div>
                ))}
              </div>
            )}
          </section>
        </aside>
      </div>
    </>
  )}

  {section === 'requests' && (
    <>
      <DashStatTiles tiles={[
        { label: dt('Open'), value: openNow, tone: 'reactions' },
        { label: dt('Claimed'), value: claimedNow, tone: 'voice' },
        requestCounts.capped ? { label: dt('Closed'), value: requestsAll - openNow - claimedNow, text: `${(requestsAll - openNow - claimedNow).toLocaleString(dashLang)}+`, tone: 'joins' as const } : { label: dt('Closed'), value: requestsAll - openNow - claimedNow, tone: 'joins' as const },
        requestCounts.capped ? { label: dt('All time'), value: requestsAll, text: `${requestsAll.toLocaleString(dashLang)}+`, tone: 'invites' as const } : { label: dt('All time'), value: requestsAll, tone: 'invites' as const },
      ]} />
      <div class="tl-cols">
        <form method="POST" class="sx-stack tl-form">
          <input type="hidden" name="action" value="save_requests" />
          <label class="sx-switch sx-master"><input type="checkbox" name="enabled" checked={requests.enabled} /><span class="sx-switch-text"><b>{dt('Accept requests')}</b><em>{dt('Members ask the staff for something with !request make.')}</em></span><i class="sx-toggle"></i></label>

          <section class="sx-panel" data-sx-needs="enabled">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--blue)"><Icon name="ph:hash-fill" width="17" height="17" /></span><h2>{dt('Where and who')}</h2></div>
            <div class="sx-field"><label for="tl-channel">{dt('Channel for the cards')}</label><select id="tl-channel" name="channel_id"><option value="">{dt('None')}</option>{textChannels.map((ch) => <option value={ch.id} selected={ch.id === requests.channelId}>#{ch.name}</option>)}</select></div>
            <div class="sx-grid">
              <div class="sx-field"><label for="tl-staff">{dt('Staff role')}</label><select id="tl-staff" name="staff_role_id"><option value="">{dt('Who can manage messages')}</option>{roles.map((role) => <option value={role.id} selected={role.id === requests.staffRoleId}>{role.name}</option>)}</select></div>
              <div class="sx-field"><label for="tl-ping">{dt('Role to ping')}</label><select id="tl-ping" name="ping_role_id"><option value="">{dt('None')}</option>{roles.map((role) => <option value={role.id} selected={role.id === requests.pingRoleId}>{role.name}</option>)}</select></div>
            </div>
          </section>

          <section class="sx-panel" data-sx-needs="enabled">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:hourglass-medium-fill" width="17" height="17" /></span><h2>{dt('Limits')}</h2></div>
            <div class="sx-grid">
              <div class="sx-field"><label for="tl-max">{dt('Open requests per member')}</label><SxNumber id="tl-max" name="max_open" value={requests.maxOpen} min="1" max="25" /></div>
              <div class="sx-field"><label for="tl-hours">{dt('Hours to finish a claimed request')}{!premium && <span class="sx-tag tl-premium">Premium</span>}</label><SxNumber id="tl-hours" name="completion_hours" value={requests.completionHours} min="0" max="720" disabled={!premium} /></div>
            </div>
            <span class="sx-hint">{dt('0 hours means no limit. After the time, a claimed request goes back to open by itself.')}</span>
          </section>

          <section class="sx-panel" data-sx-needs="enabled">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--green)"><Icon name="ph:chat-teardrop-text-fill" width="17" height="17" /></span><h2>{dt('Answer to who makes a request')}</h2></div>
            <div class="sx-field">
              <textarea id="tl-created" name="created_text" class="dgl-autogrow" data-ac data-count rows="3" maxlength="2000" aria-label={dt('Answer to who makes a request')} placeholder="{user.mention} your request #{request.number} is in. The staff will look at it: {request.link}">{requests.created.text}</textarea><SilentMentionHint />
              <span class="sx-hint">{dt('Variables: {request.number}, {request.text}, {request.link}, {request.channel}.')}</span>
            </div>
            <div class="sx-field"><label for="tl-created-embed">{dt('Saved embed')}</label>
              <select id="tl-created-embed" name="created_template" data-tpl-locks="created_text"><option value="">{dt('No saved embed')}</option>{embedTemplates.map((tpl) => <option value={tpl.name} selected={tpl.name === requests.created.template}>{tpl.name}{tpl.v2 ? ' (V2)' : ''}</option>)}</select></div>
          </section>

          <div class="sx-foot tl-foot"><button type="submit" class="btn btn-accent btn-sm" disabled={!ready}><Icon name="ph:check-bold" width="13" height="13" />{dt('Save changes')}</button><p class="tl-cmds"><Icon name="ph:terminal-window-fill" width="14" height="14" />{dt('Commands: !request make, !request list and !requestconfig.')}</p></div>
        </form>

        <aside class="tl-side">
          <section class="sx-panel tl-block">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:tray-fill" width="17" height="17" /></span><h2>{dt('Open requests')}</h2>{openRequests.length > 0 && <span class="sx-tag">{moreOpen ? `${openRequests.length}/${openNow + claimedNow}` : openRequests.length}</span>}</div>
            {openRequests.length ? (
              <ul class="sx-list tl-reqs dgl-stagger">{openRequests.map((req) => (
                <li class="sx-row tl-req">
                  <img src={who(req.userId).avatar} alt="" width="30" height="30" loading="lazy" referrerpolicy="no-referrer" />
                  <span class="tl-req-text">
                    <b><span class="tl-req-n">#{req.number}</span> {who(req.userId).name ?? req.userId}{req.claimedBy && <small>{dt('by {a}', { a: who(req.claimedBy).name ?? req.claimedBy })}</small>}</b>
                    <em>{req.content.slice(0, 80)}</em>
                  </span>
                  <span class:list={['sx-tag', req.status === 'claimed' ? 'tl-claimed' : 'sx-tag-accent']}>{req.status === 'claimed' ? dt('Claimed') : dt('Open')}</span>
                </li>
              ))}</ul>
            ) : <div class="tl-empty"><Icon name="ph:tray-fill" width="24" height="24" /><p>{dt('There are no open requests.')}</p></div>}
          </section>
        </aside>
      </div>
    </>
  )}

  {section === 'reviews' && (
    <>
      <DashStatTiles against={dt('vs the week before')} tiles={[
        { label: dt('Reviews'), value: reviewStats.total, tone: 'messages' },
        { label: dt('Average stars'), value: 0, text: reviewStats.total ? reviewStats.average.toFixed(1) : '–', tone: 'reactions' },
        { label: dt('Members rated'), value: reviewStats.members, tone: 'joins' },
        { label: dt('Last 7 days'), value: reviewStats.week ?? 0, tone: 'voice', change: weekChange },
      ]} />
      <div class="tl-cols tl-cols-reviews">
        <div class="tl-main">
          <form method="POST" class="sx-panel tl-set">
            <input type="hidden" name="action" value="save_reviews" />
            <label class="sx-switch sx-master"><input type="checkbox" name="reviews_enabled" checked={reviews.enabled} /><span class="sx-switch-text"><b>{dt('Allow reviews')}</b><em>{dt('Members rate each other from 1 to 5 stars.')}</em></span><i class="sx-toggle"></i></label>
            <div class="sx-field" data-sx-needs="reviews_enabled"><label for="tl-review-channel">{dt('Channel for new reviews')}</label><select id="tl-review-channel" name="review_channel_id"><option value="">{dt('None')}</option>{textChannels.map((ch) => <option value={ch.id} selected={ch.id === reviews.channelId}>#{ch.name}</option>)}</select>
              <span class="sx-hint">{dt('Every new review is shown there. Empty shows them nowhere.')}</span></div>
            <div class="sx-foot"><button type="submit" class="btn btn-accent btn-sm" disabled={!ready}><Icon name="ph:check-bold" width="13" height="13" />{dt('Save changes')}</button></div>
          </form>

          <section class="sx-panel tl-block tl-reviews">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:star-fill" width="17" height="17" /></span><h2>{dt('Latest reviews')}</h2>{reviewList.length > 0 && <span class="sx-tag">{reviewList.length}</span>}</div>
            {reviewList.length ? (
              <ul class="sx-list tl-review-list dgl-stagger">
                {reviewList.map((review) => (
                  <li class="sx-row tl-review">
                    <img src={who(review.targetId).avatar} alt="" width="34" height="34" loading="lazy" referrerpolicy="no-referrer" />
                    <div class="tl-review-body">
                      <div class="tl-review-top">
                        <b class="tl-review-name">{who(review.targetId).name ?? review.targetId}</b>
                        <span class="tl-stars" aria-label={dt('{a} of 5 stars', { a: review.stars })}>{stars(review.stars)}</span>
                      </div>
                      {review.comment && <p class="tl-review-text">{review.comment}</p>}
                      <p class="tl-review-by">{dt('by {a}', { a: who(review.reviewerId).name ?? review.reviewerId })} · <time datetime={review.at} title={review.at.slice(0, 16).replace('T', ' ')}>{ago(review.at)}</time></p>
                    </div>
                    <form method="POST" data-no-dirty class="tl-review-del">
                      <input type="hidden" name="review_id" value={review.id} />
                      <button type="submit" name="action" value="delete_review" class="sx-iconbtn" aria-label={dt('Delete review')} title={dt('Delete review')} data-confirm={dt('Delete this review? It is taken out of the rating of the member.')}><Icon name="ph:trash-fill" width="15" height="15" /></button>
                    </form>
                  </li>
                ))}
              </ul>
            ) : <div class="tl-empty"><Icon name="ph:star-fill" width="24" height="24" /><p>{dt('No reviews yet.')}</p></div>}
          </section>
        </div>

        <aside class="tl-side tl-side-sticky">
          <section class="sx-panel tl-block">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:star-fill" width="17" height="17" /></span><h2>{dt('Stars given')}</h2></div>
            {reviewStats.total === 0 ? <p class="sx-empty"><Icon name="ph:star-fill" width="16" height="16" />{dt('No reviews yet.')}</p> : (
              <ul class="tl-stars-list">
                {starRows.map((row) => (
                  <li><span class="tl-stars-n">{row.n}<Icon name="ph:star-fill" width="12" height="12" /></span><span class="tl-stars-bar"><i style={`width:${row.count ? Math.max(3, Math.round((row.count / starsTop) * 100)) : 0}%`}></i></span><b>{row.count}</b></li>
                ))}
              </ul>
            )}
          </section>
          <section class="sx-panel tl-block">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:chart-bar-fill" width="17" height="17" /></span><h2>{dt('Reviews in the last 14 days')}</h2>{reviews14 > 0 && <span class="sx-tag">{reviews14}</span>}</div>
            {reviews14 === 0 ? <p class="sx-empty"><Icon name="ph:chart-bar-fill" width="16" height="16" />{dt('No reviews in the last 14 days.')}</p> : (
              <div class="tl-bars" role="img" aria-label={dt('Reviews in the last 14 days')}>
                {reviewBars.map((d, i) => (
                  <div class:list={['tl-bar', { 'tl-bar-today': i === 13 }]} style={`--i:${i}`} title={`${d.name}: ${d.n}`}><em>{d.n || ''}</em><i style={`height:${d.height}%`}></i><span>{d.day}</span></div>
                ))}
              </div>
            )}
          </section>
          <section class="sx-panel tl-block">
            <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--green)"><Icon name="ph:medal-fill" width="17" height="17" /></span><h2>{dt('Most reviewed members')}</h2></div>
            {reviewStats.top && reviewStats.top.length > 0 ? (
              <ol class="tl-ranks">{reviewStats.top.map((entry, i) => (
                <li class="tl-rank">
                  <span class:list={['tl-rank-n', { 'tl-rank-top': i === 0 }]}>{i + 1}</span>
                  <img src={who(entry.userId).avatar} alt="" width="28" height="28" loading="lazy" referrerpolicy="no-referrer" />
                  <span class="tl-rank-main"><b>{who(entry.userId).name ?? entry.userId}</b><em>{entry.average.toFixed(1)} ★</em></span>
                  <b class="tl-rank-count">{entry.count}</b>
                </li>
              ))}</ol>
            ) : <p class="sx-empty"><Icon name="ph:medal-fill" width="16" height="16" />{dt('Nobody has been reviewed yet.')}</p>}
          </section>
          <p class="tl-cmds"><Icon name="ph:terminal-window-fill" width="14" height="14" />{dt('Commands: !review give, !review show, !review remove, !profile and !profileconfig.')}</p>
        </aside>
      </div>
    </>
  )}
  </div>
</DashGuildLayout>

<style>
