---
import { getDashLang, makeT } from '../i18n/dash';
import type { Locale } from '../i18n/ui';
// A real saturation/value + hue color picker (canvas-based), replacing plain `<input type="text">`
// hex fields. Renders a swatch trigger + hidden input carrying the hex value, so it's a drop-in
// replacement for any <form> that already reads `formData.get(name)`, nothing server-side changes.
interface Props {
  name: string;
  value?: string;
  label?: string;
  presets?: string[];
  /** Adds a "No color" choice; the field then sends an empty value. */
  allowNone?: boolean;
  /** Id of the hidden field, for scripts that read the value. */
  id?: string;
  /** The language of the labels; the dashboard uses the one of the person, a public page passes its own. */
  lang?: Locale;
}
const DEFAULT_PRESETS = ['#2dd4a7', '#3ba776', '#5b8def', '#a78bfa', '#e0568c', '#f5c945', '#f2994a', '#ef5b5b', '#7c8a94', '#4b5b63', '#0f1115', '#ffffff'];
const { name, value = '#8399ff', label = 'Color', presets = DEFAULT_PRESETS, allowNone = false, id, lang } = Astro.props;
const dt = makeT(lang ?? getDashLang(Astro));
const isNone = allowNone && value === '';
---
<div class:list={['dgl-cp', { 'is-none': isNone }]} data-colorpicker data-cp-default={value} data-cp-allownone={allowNone ? '' : undefined} data-cp-nonelabel={dt('No color')}>
  <button type="button" class="dgl-cp-trigger" data-cp-trigger>
    <span class="dgl-cp-swatch" data-cp-swatch style={`--sw:${value || '#8399ff'}`}></span>
    <span class="dgl-cp-hexlabel" data-cp-hexlabel>{isNone ? dt('No color') : value}</span>
    <span class="dgl-cp-fieldlabel">{label}</span>
  </button>
  <input type="hidden" id={id} name={name} value={value} data-cp-value />

  <div class="dgl-cp-panel" data-cp-panel hidden>
    <div class="dgl-cp-sv-wrap">
      <canvas class="dgl-cp-sv" data-cp-sv width="260" height="150"></canvas>
      <div class="dgl-cp-sv-thumb" data-cp-sv-thumb></div>
    </div>
    <div class="dgl-cp-hue-wrap">
      <canvas class="dgl-cp-hue" data-cp-hue width="260" height="12"></canvas>
      <div class="dgl-cp-hue-thumb" data-cp-hue-thumb></div>
    </div>
    <div class="dgl-cp-fields">
      <div class="dgl-cp-field dgl-cp-field-hex">
        <input type="text" data-cp-hex maxlength="7" />
        <label>{dt('Hex')}</label>
      </div>
      <div class="dgl-cp-field">
        <input type="number" data-cp-r min="0" max="255" />
        <label>R</label>
      </div>
      <div class="dgl-cp-field">
        <input type="number" data-cp-g min="0" max="255" />
        <label>G</label>
      </div>
      <div class="dgl-cp-field">
        <input type="number" data-cp-b min="0" max="255" />
        <label>B</label>
      </div>
    </div>
    <div class="dgl-cp-presets">
      {presets.map((p) => <button type="button" class="dgl-cp-preset" style={`--sw:${p}`} data-cp-preset={p} aria-label={p}></button>)}
    </div>
    <div class="dgl-cp-actions">
      {allowNone && <button type="button" class="dgl-cp-none" data-cp-none>{dt('No color')}</button>}
      <button type="button" class="dgl-cp-reset" data-cp-reset>{dt('Reset')}</button>
    </div>
  </div>
</div>

<style>
  .dgl-cp[data-cp-disabled] { opacity: .4; pointer-events: none; }
  .dgl-cp-actions { display: flex; gap: 8px; width: 100%; }
  .dgl-cp-actions > button { flex: 1; }
  .dgl-cp-none { border: 1px solid var(--border); background: var(--bg-raise); color: var(--text); border-radius: 9px; padding: 8px 10px; font: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer; }
  .dgl-cp-none:hover { border-color: var(--accent); }
  .dgl-cp.is-none .dgl-cp-swatch { background: repeating-linear-gradient(45deg, #5b5f68 0 4px, #33363c 4px 8px); }
  .dgl-cp-panel.dgl-cp-sheet { max-width: none; display: flex; flex-direction: column; align-items: center; box-shadow: 0 -12px 40px rgba(0, 0, 0, .55); max-height: calc(100vh - 24px); overflow-y: auto; }
  .dgl-cp { position: relative; display: inline-flex; }

  .dgl-cp-trigger {
    display: flex; align-items: center; gap: 8px; border: 1px solid var(--border); border-radius: 8px;
    padding: 6px 10px; background: var(--bg-raise); cursor: pointer; font-family: var(--sans); text-align: left;
  }
  .dgl-cp-trigger:hover { border-color: var(--accent); }
  .dgl-cp-swatch { width: 20px; height: 20px; border-radius: 6px; background: var(--sw); border: 1px solid rgba(255,255,255,0.15); flex-shrink: 0; }
  .dgl-cp-hexlabel { font-family: var(--mono); font-size: 12.5px; color: var(--text); text-transform: uppercase; }
  .dgl-cp-fieldlabel { font-size: 11px; color: var(--text-dim); margin-left: 2px; }

  .dgl-cp-panel {
    position: fixed; top: 0; left: 0; z-index: 60; box-sizing: border-box; width: 312px; max-width: calc(100vw - 24px);
    background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 14px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.35); display: flex; flex-direction: column; gap: 12px;
  }
  .dgl-cp-panel[hidden] { display: none !important; }

  .dgl-cp-sv-wrap { position: relative; width: 100%; height: 190px; border-radius: 12px; overflow: hidden; cursor: crosshair; touch-action: none; user-select: none; -webkit-user-select: none; }
  .dgl-cp-sv { display: block; width: 100%; height: 100%; }
  .dgl-cp-sv-thumb {
    position: absolute; width: 24px; height: 24px; border-radius: 50%; border: 3px solid #fff;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.4), 0 1px 4px rgba(0,0,0,0.5); transform: translate(-50%, -50%);
    pointer-events: none; top: 0; left: 0;
  }

  .dgl-cp-hue-wrap { position: relative; width: 100%; height: 24px; cursor: pointer; touch-action: none; user-select: none; -webkit-user-select: none; }
  .dgl-cp-hue { display: block; width: 100%; height: 100%; border-radius: 12px; }
  .dgl-cp-hue-thumb {
    position: absolute; top: 50%; width: 12px; height: 30px; border-radius: 5px; background: #fff;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.4), 0 1px 3px rgba(0,0,0,0.5); transform: translate(-50%, -50%);
    pointer-events: none; left: 0;
  }

  .dgl-cp-fields { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 8px; }
  .dgl-cp-field { display: flex; flex-direction: column; gap: 4px; align-items: center; }
  .dgl-cp-field input {
    width: 100%; box-sizing: border-box; text-align: center; border: 1px solid var(--border); border-radius: 7px;
    padding: 6px 4px; background: var(--bg-raise); color: var(--text); font-family: var(--mono); font-size: 12px;
  }
  .dgl-cp-field-hex input { text-transform: uppercase; }
  .dgl-cp-field label { font-size: 10px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.03em; }

  .dgl-cp-presets { display: flex; flex-wrap: wrap; gap: 6px; }
  .dgl-cp-preset {
    width: 22px; height: 22px; border-radius: 6px; background: var(--sw); border: 1px solid rgba(255,255,255,0.15);
    cursor: pointer; padding: 0; transition: transform 0.1s;
  }
  .dgl-cp-preset:hover { transform: scale(1.12); }

  .dgl-cp-reset {
    border: none; border-radius: 8px; padding: 9px; background: var(--accent); color: #fff; font-weight: 600;
    font-size: 12.5px; cursor: pointer; font-family: var(--sans);
  }
  .dgl-cp-reset:hover { filter: brightness(1.08); }
  @media (max-width: 520px) {
    .dgl-cp-panel { width: min(288px, calc(100vw - 24px)); padding: 12px; }
    .dgl-cp-sv-wrap, .dgl-cp-hue-wrap { width: 100%; }
    .dgl-cp-sv { width: 100%; }
  }
</style>
