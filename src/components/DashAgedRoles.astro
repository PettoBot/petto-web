---
// Aged roles: a list of rules ("after N days in the server, give this role and take another away") and a form to add one. Looked at by the bot about every 30 minutes, also for
// the members who were already in the server.
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import SelectSource from './SelectSource.astro';
import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Rule { id: number; roleId: string; days: number; removeRoleId: string | null; target: string; enabled: boolean }
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string; guildName: string; guildIcon: string;
  rules: Rule[]; roles: { id: string; name: string; color: number }[]; everyRole: { id: string; name: string }[];
  ready: boolean; saved: boolean; problem: string | null; max: number;
}
const { user, guildId, guildName, guildIcon, rules, roles, everyRole, ready, saved, problem, max } = Astro.props;
const name = (roleId: string | null) => (roleId ? everyRole.find((role) => role.id === roleId)?.name ?? dt('a role that is gone') : '');
const targets: [string, string][] = [['humans', dt('Humans only')], ['all', dt('Everyone')], ['bots', dt('Bots only')]];
const targetLabel = (target: string) => targets.find(([value]) => value === target)?.[1] ?? dt('Humans only');
const on = rules.filter((rule) => rule.enabled).length;
const docsUrl = `https://wiki.petto.sbs${dashLang === 'es' ? '/es' : dashLang === 'pt-BR' ? '/pt-br' : ''}/moderation/aged-roles`;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="aged-roles" pageTitle="Aged roles">
  <DashSettingsKit />
  <div class="sx-page ar">
    <div class="ar-head">
      <h1>{dt('Aged roles')}</h1>
      <a class="btn btn-sm" href={docsUrl} target="_blank" rel="noopener"><Icon name="ph:book-open-fill" width="13" height="13" />{dt('Read the docs')}</a>
    </div>
    <p class="sx-lead">{dt('Give a role after a member has been in the server for some days, and take another one away if you want. Petto looks about every 30 minutes, and the members who were already here get it too.')}</p>

    {saved && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
    {problem && <div class="sx-flash sx-flash-bad" role="alert"><Icon name="ph:warning-fill" width="15" height="15" />{problem}</div>}
    {!ready && <div class="sx-flash sx-flash-warn"><Icon name="ph:plug-fill" width="15" height="15" />{dt('Aged roles are not available yet. Petto is being updated: try again in a few minutes.')}</div>}

    <DashStatTiles tiles={[
      { label: dt('Rules'), value: rules.length, tone: 'messages' },
      { label: dt('On'), value: on, tone: 'joins' },
    ]} />

    <div class="ar-cols">
      <section class="sx-panel ar-box">
        <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#b4a5f5"><Icon name="ph:hourglass-medium-fill" width="17" height="17" /></span><h2>{dt('Rules')}</h2>{rules.length > 0 && <span class="sx-tag">{rules.length}/{max}</span>}</div>
        {rules.length === 0 && <p class="ar-empty"><Icon name="ph:hourglass-medium-fill" width="22" height="22" />{dt('No rules yet. Add the first one.')}</p>}
        {rules.length > 0 && (
          <div class="sx-list ar-list dgl-stagger">
            {rules.map((rule) => (
              <div class:list={['sx-row', 'ar-row', { 'ar-off': !rule.enabled }]}>
                <span class="ar-days"><b>{rule.days}</b><em>{dt('days')}</em></span>
                <span class="ar-what">
                  <span class="ar-line">{dt('Gives')} <b>{name(rule.roleId)}</b></span>
                  {rule.removeRoleId && <span class="ar-line ar-sub">{dt('Takes away')} <b>{name(rule.removeRoleId)}</b></span>}
                  <span class="sx-tag ar-target">{targetLabel(rule.target)}</span>
                </span>
                <form method="POST" data-no-dirty class="ar-act">
                  <input type="hidden" name="action" value="toggle" /><input type="hidden" name="rule_id" value={rule.id} />
                  <label class="sx-switch ar-switch" title={rule.enabled ? dt('On') : dt('Off')}><input type="checkbox" name="enabled" role="switch" checked={rule.enabled} aria-label={dt('On')} data-auto-submit /><span class="sx-toggle"></span></label>
                </form>
                <form method="POST" data-no-dirty class="ar-act">
                  <input type="hidden" name="action" value="remove" /><input type="hidden" name="rule_id" value={rule.id} />
                  <button type="submit" class="sx-iconbtn" aria-label={dt('Remove')} title={dt('Remove')}><Icon name="ph:trash-fill" width="15" height="15" /></button>
                </form>
              </div>
            ))}
          </div>
        )}
      </section>

      <form method="POST" class="sx-panel ar-box" data-no-dirty>
        <input type="hidden" name="action" value="add" />
        <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#7ac45a"><Icon name="ph:plus-circle-fill" width="17" height="17" /></span><h2>{dt('Add a rule')}</h2></div>
        <div class="sx-field"><label for="ar-role">{dt('Role to give')}</label>
          <select id="ar-role" name="role_id" required data-give-role data-fill="ar-roles" disabled={!ready}><option value="" disabled selected>{dt('Role')}</option></select>
        </div>
        <div class="sx-field"><label for="ar-days">{dt('After how many days in the server')}</label>
          <input id="ar-days" type="number" name="days" min="1" max="3650" value="7" required disabled={!ready} />
        </div>
        <div class="sx-field"><label for="ar-remove">{dt('Role to take away (optional)')}</label>
          <select id="ar-remove" name="remove_role_id" data-give-role data-fill="ar-roles" disabled={!ready}><option value="">{dt('None')}</option></select>
        </div>
        <div class="sx-field"><span class="sx-label" id="ar-target-l">{dt('Who gets it')}</span>
          <div class="dfx-chips" role="radiogroup" aria-labelledby="ar-target-l">{targets.map(([value, label]) => <label class="dfx-chip"><input type="radio" name="target" value={value} checked={value === 'humans'} />{label}</label>)}</div>
        </div>
        <p class="sx-hint">{dt("Petto's role has to be above the roles it gives or takes away.")}</p>
        <div class="sx-foot"><button type="submit" class="btn btn-accent btn-sm" disabled={!ready || rules.length >= max}><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button></div>
      </form>
    </div>
  </div>
  <SelectSource name="ar-roles" items={roles.map((role) => ({ id: role.id, name: role.name }))} />
  <script is:inline>
    // The switch of a rule saves at once (it is a small form of its own).
    document.addEventListener('change', function (event) {
      var box = event.target && event.target.closest ? event.target.closest('input[data-auto-submit]') : null;
      if (box && box.form) { if (box.form.requestSubmit) box.form.requestSubmit(); else box.form.submit(); }
    });
  </script>
  <DashFormKit />
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0; }
  .ar { max-width: 1040px; }
  .ar-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
  .ar :global(.sx-lead) { margin-bottom: 16px; }
  .ar :global(.sx-field input[type=number]) { border: 1px solid var(--border); border-radius: 9px; padding: 9px 11px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; width: 100%; box-sizing: border-box; min-width: 0; transition: border-color .25s ease, box-shadow .25s ease; }
  .ar-switch.sx-switch { flex: none; width: 40px; height: 24px; padding: 0; gap: 0; border: 0; border-radius: 999px; background: none; }
  .ar-switch.sx-switch:hover { background: none; }
  .ar-cols { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 14px; align-items: start; }
  .ar-box { gap: 12px; }
  .ar-list { display: flex; flex-direction: column; gap: 8px; }
  .ar-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; gap: 12px; align-items: center; transition: opacity .25s ease; }
  .ar-row.ar-off { opacity: .6; }
  .ar-days { display: grid; place-items: center; min-width: 56px; padding: 6px 8px; border-radius: 10px; background: color-mix(in srgb, #b4a5f5 14%, transparent); }
  .ar-days b { font-size: 18px; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .ar-days em { font-style: normal; font-size: 10.5px; color: var(--text-dim); }
  .ar-what { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .ar-line { font-size: 13.5px; overflow-wrap: anywhere; }
  .ar-sub { color: var(--text-muted); }
  .ar-target { align-self: flex-start; margin-top: 2px; }
  .ar-act { margin: 0; }
  .ar-empty { display: flex; align-items: center; gap: 10px; margin: 0; padding: 18px 14px; border: 1px dashed var(--border); border-radius: 12px; color: var(--text-dim); font-size: 13.5px; }
  .ar-empty :global(svg) { flex: none; color: #b4a5f5; }
  @media (max-width: 900px) { .ar-cols { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 520px) { .ar-row { gap: 8px; } .ar-days { min-width: 48px; } }
</style>
