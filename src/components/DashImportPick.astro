---
// The server picker of the two import links (a message from the Embed Generator, a command from the Code Generator). The thing to
// import travels in the URL fragment, which never reaches the server: the script adds it to each server link.
import { Icon } from 'astro-icon/components';
import DashMeLayout from './DashMeLayout.astro';
import type { Session } from '../utils/session';
import DashPanelHead from './DashPanelHead.astro';
import DashPanelEmpty from './DashPanelEmpty.astro';
import { getDashLang, makeT } from '../i18n/dash';
interface Props {
  user: Session;
  docTitle: string;
  title: string;
  noMessage: string;
  hint: string;
  page: 'embeds' | 'code';
  guilds: { id: string; name: string; icon: string | null }[];
  unavailable: boolean;
}
const { user, title, noMessage, hint, page, guilds, unavailable } = Astro.props;
const dt = makeT(getDashLang(Astro));
---
<DashMeLayout user={user} active="servers" pageTitle={title}>
      <div class="imp-wrap">
        <DashPanelHead title={title} eyebrow={dt('Import')} icon="ph:download-simple-bold" back={false} />
        <p class="imp-note imp-warn" data-imp-nomsg hidden><Icon name="ph:warning-fill" width="15" height="15" />{noMessage}</p>
        <p class="imp-note"><Icon name="ph:info-fill" width="15" height="15" />{hint}</p>
        {unavailable && <DashPanelEmpty tone="error" icon="ph:cloud-slash-fill" text={dt('Discord did not respond in time. Reload the page in a few seconds to load your servers again.')} />}
        {!unavailable && guilds.length === 0 && (
          <DashPanelEmpty icon="ph:hard-drives-fill" text={dt('Petto is not in any server you can manage yet.')}>
            <a class="btn btn-ghost btn-sm" href="/dash/manage">{dt('Manage servers')}</a>
          </DashPanelEmpty>
        )}
        {guilds.length > 0 && (
          <div class="imp-list dgl-stagger">
            {guilds.map((g) => (
              <a class="imp-item" data-imp-link href={`/dash/guild/${g.id}/${page}`}>
                {g.icon ? <img src={g.icon} alt="" loading="lazy" /> : <span class="imp-fallback"><Icon name="ph:hard-drives-fill" width="16" height="16" /></span>}
                <span class="imp-name">{g.name}</span>
                <Icon name="ph:arrow-right" width="15" height="15" class="imp-go" />
              </a>
            ))}
          </div>
        )}
      </div>
</DashMeLayout>

<script>
  const hash = location.hash;
  if (hash.startsWith('#import=')) {
    document.querySelectorAll<HTMLAnchorElement>('[data-imp-link]').forEach((link) => { link.href += hash; });
  } else {
    document.querySelector<HTMLElement>('[data-imp-nomsg]')?.removeAttribute('hidden');
  }
</script>

<style>
  .imp-wrap { max-width: 720px; min-width: 0; margin: 0 auto; }
  .imp-note { display: flex; align-items: flex-start; gap: 8px; color: var(--text-muted); font-size: 13.5px; margin: 0 0 16px; line-height: 1.5; }
  .imp-note :global(svg) { flex: none; margin-top: 2px; color: var(--accent); }
  .imp-note[hidden] { display: none; }
  .imp-warn { padding: 11px 14px; border: 1px solid color-mix(in srgb, var(--yellow) 50%, var(--border)); border-radius: 12px; background: color-mix(in srgb, var(--yellow) 10%, transparent); color: var(--yellow); }
  .imp-warn :global(svg) { color: var(--yellow); }
  .imp-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); gap: 8px; }
  .imp-item { display: flex; align-items: center; gap: 12px; min-width: 0; padding: 12px 14px; border: 1px solid var(--border-soft); border-radius: 14px; background: color-mix(in srgb, var(--text) 2%, transparent); color: var(--text); text-decoration: none; font-weight: 600; transition: border-color var(--m-fast) ease, background var(--m-fast) ease, transform var(--m-base) var(--m-out); }
  @media (hover: hover) { .imp-item:hover { border-color: var(--accent); background: var(--card-hover); transform: translateY(-2px); } }
  .imp-item:active { transform: scale(var(--m-press)); transition-duration: var(--m-instant); }
  .imp-item img, .imp-fallback { width: 36px; height: 36px; border-radius: 11px; object-fit: cover; flex-shrink: 0; }
  .imp-fallback { display: grid; place-items: center; background: var(--bg-raise); color: var(--text-dim); }
  .imp-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .imp-item :global(.imp-go) { flex: none; color: var(--text-dim); transition: transform var(--m-fast) var(--m-out), color var(--m-fast) ease; }
  .imp-item:hover :global(.imp-go) { color: var(--accent); transform: translateX(2px); }
  @media (prefers-reduced-motion: reduce) { .imp-item, .imp-item :global(.imp-go) { transition: none; } }
</style>
