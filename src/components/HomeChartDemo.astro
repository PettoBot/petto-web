---
// A chart of sample numbers for the home page, with the movable window of the statistics (DashChartRange.astro): the visitor drags the window over
// the days and the numbers above go up and down with it. Drawn on the server with the very same builder as the public statistics and the dashboard.
// The numbers are a sample (the card says so), made from the date so the chart always ends today and never changes between two loads of the same day.
import { lineChart, tickLabels } from '../utils/statsChart.mjs';
import { botDay, daysBefore } from '../utils/globalStatsMath.mjs';
import { COPY } from '../data/globalStatsCopy.mjs';
import DashChartTip from './DashChartTip.astro';
import StatsChartStyle from './StatsChartStyle.astro';
import DashChartRange from './DashChartRange.astro';
import type { Locale } from '../i18n/ui';

interface Props { lang: Locale; title: string; desc: string; sample: string; aria: string }
const { lang, title, desc, sample, aria } = Astro.props;
const copy = COPY[lang] ?? COPY.en;
const DAYS = 60;
const today = botDay();
// A week with a quiet weekend, a slow climb and a little noise that is always the same for the same day.
const noise = (n: number) => { const x = Math.sin(n * 91.7 + 13.3) * 10000; return x - Math.floor(x); };
const points = Array.from({ length: DAYS }, (_, i) => {
  const day = daysBefore(today, DAYS - 1 - i);
  const weekday = new Date(`${day}T00:00:00Z`).getUTCDay();
  const week = weekday === 0 || weekday === 6 ? 0.72 : 1;
  const value = Math.round((620 + i * 9 + Math.sin(i / 4.2) * 70) * week + noise(i) * 90);
  return { day, value };
});
const num = new Intl.NumberFormat(lang, { maximumFractionDigits: 0 });
const num1 = new Intl.NumberFormat(lang, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const dayText = (day: string, opts: Intl.DateTimeFormatOptions) => new Date(`${day}T00:00:00Z`).toLocaleDateString(lang, { ...opts, timeZone: 'UTC' });
const signed = (v: number) => `${v > 0 ? '+' : v < 0 ? '−' : ''}${num.format(Math.abs(v))}`;
const chart = lineChart({
  points, W: 760, H: 250, fluid: true, animate: true, color: 'var(--accent)', format: (v: number) => num.format(v), dayText, signed,
  tickLabels: (ticks: number[]) => tickLabels(ticks, { locale: lang, num, num1, fractional: false }),
  text: { todaySoFar: copy.todaySoFar, estimatedTag: copy.estimatedTag, changeVsPrev: copy.changeVsPrev },
  aria, svgLabel: aria,
  brush: { kind: 'flow', locale: lang, fmt: { type: 'count' }, text: { label: copy.brushLabel, total: copy.brushTotal, avg: copy.brushAvg, versus: copy.brushVersus, end: copy.brushEnd, change: copy.brushChange, high: copy.brushHigh, all: copy.brushAll } },
});
---
<div class="win chart-demo reveal">
  <div class="win-bar">
    <span class="chip" style="background:var(--red)"></span>
    <span class="chip" style="background:var(--yellow)"></span>
    <span class="chip" style="background:var(--green)"></span>
    <span class="win-chan">{title}</span>
    <span class="demo-tag">{sample}</span>
  </div>
  <div class="demo-body">
    <p class="demo-desc">{desc}</p>
    <div set:html={chart.html} />
  </div>
</div>
<DashChartTip />
<StatsChartStyle />
<DashChartRange />

<style>
  .chart-demo { margin: 28px 0 0; max-width: none; background: var(--card); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; box-shadow: 0 24px 48px -28px rgba(0, 0, 0, 0.4); }
  .win-bar { display: flex; align-items: center; gap: 8px; padding: 12px 15px; border-bottom: 1px solid var(--border-soft); }
  .win-bar .chip { width: 9px; height: 9px; border-radius: 50%; }
  .win-chan { margin-left: 6px; font-family: var(--mono); font-size: 12px; color: var(--text-dim); }
  .demo-tag { margin-left: auto; font-size: 11.5px; color: var(--text-dim); border: 1px solid var(--border); border-radius: 999px; padding: 2px 9px; }
  .demo-body { padding: 20px 22px 22px; background: var(--card); }
  .demo-desc { margin: 0 0 14px; font-size: 14px; line-height: 1.5; color: var(--text-muted); }
  @media (max-width: 520px) { .demo-body { padding: 16px 14px 16px; } .demo-tag { display: none; } }
</style>
