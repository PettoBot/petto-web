---
// A floating "liquid glass" bar for phones: the main places of the site in a pill, and the account in a round button.
// The glass is the shared liquid glass of LiquidGlass.astro, with a lens that slides to the item you press. It only shows on small screens, where the top menu is the burger.
interface Props {
  base: string;
  route: string;
  labels: { home: string; commands: string; premium: string; status: string; support: string; account: string };
}
const { base, route, labels } = Astro.props;

const items = [
  { key: 'home', href: `${base}/`, label: labels.home, match: (r: string) => r === '/', icon: 'M4 11.2 12 4l8 7.2V19a1 1 0 0 1-1 1h-4.5v-5.5h-5V20H5a1 1 0 0 1-1-1v-7.8Z' },
  { key: 'commands', href: `${base}/commands`, label: labels.commands, match: (r: string) => r.startsWith('/commands'), icon: 'M9 9V6.5A2.5 2.5 0 1 0 6.5 9H9Zm0 0h6m-6 0v6m6-6V6.5A2.5 2.5 0 1 1 17.5 9H15Zm0 0v6m-6 0H6.5A2.5 2.5 0 1 0 9 17.5V15Zm0 0h6m0 0h2.5a2.5 2.5 0 1 1-2.5 2.5V15Z' },
  { key: 'premium', href: `${base}/premium`, label: labels.premium, match: (r: string) => r.startsWith('/premium'), icon: 'M4 8l3.5 3L12 5l4.5 6L20 8l-1.6 10H5.6L4 8Zm1.6 12h12.8' },
  { key: 'status', href: `${base}/status`, label: labels.status, match: (r: string) => r.startsWith('/status') || r.startsWith('/stats'), icon: 'M3 12h4l2.5-6 4 12 2.5-6H21' },
  { key: 'support', href: 'https://petto.sbs/support', label: labels.support, match: () => false, external: true, icon: 'M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10C19.5 15.4 12 20 12 20Z' },
];
const activeIndex = items.findIndex((item) => item.match(route));
const accountActive = route === '/dash' || route.startsWith('/dash/');
---
<nav class="gdock" id="gdock" aria-label="Petto" style={`--i: ${Math.max(activeIndex, 0)};`} data-has-active={activeIndex >= 0 ? 'true' : 'false'}>
  <div class="gdock-pill lg-glass">
    <span class="gdock-lens" aria-hidden="true"></span>
    {items.map((item, index) => (
      <a
        class:list={['gdock-item', { 'is-active': index === activeIndex }]}
        href={item.href}
        aria-label={item.label}
        aria-current={index === activeIndex ? 'page' : undefined}
        data-index={index}
        target={item.external ? '_blank' : undefined}
        rel={item.external ? 'noopener' : undefined}
      >
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon} /></svg>
      </a>
    ))}
  </div>
  <a class:list={['gdock-account', 'lg-glass', { 'is-active': accountActive }]} href="/dash" aria-label={labels.account}>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 8c.6-3.4 3.4-5.5 7-5.5s6.4 2.1 7 5.5" /></svg>
  </a>
</nav>
<style is:global>
  .gdock { display: none; }

  @media (max-width: 880px) {
    /* The bar floats over the page, so the end of the page has to leave room for it. */
    body.public-body { padding-bottom: calc(92px + env(safe-area-inset-bottom)); }

    .gdock {
      --gdock-pad: 6px;
      --gdock-ink: var(--text-muted);
      position: fixed; z-index: 60;
      left: 0; right: 0; bottom: calc(12px + env(safe-area-inset-bottom));
      display: flex; align-items: center; justify-content: center; gap: 10px;
      width: min(100% - 24px, 520px); margin: 0 auto;
      pointer-events: none;
      /* No fill-mode after the end: an element that keeps an animation keeps being the root of its backdrop, and the glass would stop seeing the page. */
      animation: gdockIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    }
    .gdock-pill, .gdock-account {
      position: relative; pointer-events: auto;
      border: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
      box-shadow: 0 14px 34px -14px rgba(0, 0, 0, 0.7);
    }

    .gdock-pill {
      flex: 1; min-width: 0; display: flex; align-items: center; justify-content: space-between;
      height: 64px; padding: var(--gdock-pad); border-radius: 999px;
    }
    .gdock-account {
      flex: none; width: 64px; height: 64px; border-radius: 50%;
      display: grid; place-items: center; color: var(--gdock-ink); text-decoration: none; -webkit-tap-highlight-color: transparent;
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.2s ease;
    }
    .gdock-account:active { transform: scale(0.92); }
    .gdock-account.is-active { color: var(--accent); }

    .gdock-item {
      position: relative; z-index: 1; flex: 1; height: 100%; min-width: 0;
      display: grid; place-items: center; border-radius: 999px;
      color: var(--gdock-ink); text-decoration: none; -webkit-tap-highlight-color: transparent;
      transition: color 0.25s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .gdock-item svg { transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }
    .gdock-item:active svg { transform: scale(0.86); }
    .gdock-item.is-active, .gdock-item.is-pressed { color: var(--accent); }

    /* The lens: a drop of glass under the item that is active, it slides to the one you press. */
    .gdock-lens {
      position: absolute; z-index: 0; top: var(--gdock-pad); bottom: var(--gdock-pad); left: var(--gdock-pad);
      width: calc((100% - var(--gdock-pad) * 2) / 5); border-radius: 999px; pointer-events: none;
      transform: translateX(calc(var(--i) * 100%));
      transition: transform 0.45s cubic-bezier(0.34, 1.4, 0.5, 1), opacity 0.2s ease;
      background: radial-gradient(120% 140% at 30% 15%, color-mix(in srgb, var(--text) 18%, transparent), color-mix(in srgb, var(--text) 6%, transparent) 60%);
      box-shadow: inset 0 1px 0 color-mix(in srgb, var(--text) 24%, transparent), inset 0 -1px 0 color-mix(in srgb, var(--text) 6%, transparent), 0 6px 14px -8px rgba(0, 0, 0, 0.55);
      -webkit-backdrop-filter: blur(3px) brightness(1.12); backdrop-filter: blur(3px) brightness(1.12);
    }
    .gdock[data-has-active='false'] .gdock-lens { opacity: 0; }
    .gdock[data-has-active='false'].is-touching .gdock-lens { opacity: 1; }

    @media (prefers-reduced-motion: reduce) {
      .gdock { animation: none; }
      .gdock-lens, .gdock-item, .gdock-item svg, .gdock-account { transition: none; }
    }
    /* The full menu covers the screen: the bar steps aside instead of floating over it. */
    body:has(.mobile-nav.open) .gdock { opacity: 0; pointer-events: none; transform: translateY(12px); transition: opacity 0.2s ease, transform 0.2s ease; }
  }
  @keyframes gdockIn { from { opacity: 0; transform: translateY(22px) scale(0.96); } to { opacity: 1; transform: none; } }
</style>

<script is:inline>
  (function () {
    var dock = document.getElementById('gdock');
    if (!dock) return;

    var items = dock.querySelectorAll('.gdock-item');
    // Pressing an item slides the lens there right away, and the page follows.
    items.forEach(function (item) {
      var press = function () {
        dock.style.setProperty('--i', item.getAttribute('data-index'));
        dock.classList.add('is-touching');
        items.forEach(function (other) { other.classList.toggle('is-pressed', other === item); });
      };
      item.addEventListener('pointerdown', press);
      item.addEventListener('focus', press);
    });
  })();
</script>
