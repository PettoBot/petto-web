---
// A person in a list: their picture and name, with the id small underneath. Falls back to the id when Discord does not know them.
interface Props { id: string; person?: { name: string; avatar: string } | null }
const { id, person = null } = Astro.props;
---
<span class="uc">
  {person && <img src={person.avatar} alt="" width="22" height="22" loading="lazy" />}
  <span class="uc-text"><b>{person?.name ?? id}</b>{person && <code>{id}</code>}</span>
</span>

<style>
  .uc { display: inline-flex; align-items: center; gap: 8px; min-width: 0; }
  .uc img { border-radius: 50%; flex: 0 0 auto; }
  .uc-text { display: flex; flex-direction: column; min-width: 0; line-height: 1.25; }
  .uc-text b { font-size: 13px; font-weight: 600; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .uc-text code { font-size: 10px; color: var(--text-dim); }
</style>
