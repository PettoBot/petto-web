---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { useTranslations, localePath, sortedReleases, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = localePath[lang];
const np = t.newsPage;

const items = sortedReleases(lang).map((r) => ({ ...r, href: r.href ? `${base}${r.href}` : null, banner: r.banner || null }));
const [hero, ...rest] = items;
---
<Base title={`${np.title} · Petto`} lang={lang}>
  <main>
    <section class="news-hero-sec">
      <div class="wrap">
        <h1 class="reveal">{np.title}</h1>

        <div class="utility-box reveal">
          {np.utility.map((u) => {
            const external = u.href.startsWith('http') || u.href.startsWith('mailto:');
            return (
              <a class="utility-row" href={external ? u.href : `${base}${u.href}`} target={u.href.startsWith('http') ? '_blank' : undefined} rel={u.href.startsWith('http') ? 'noopener' : undefined}>
                <span class="utility-label">{u.label}</span>
                <span class="utility-value"><Icon name={u.icon} class="utility-ic" />{u.value}</span>
              </a>
            );
          })}
        </div>

        <div class="featured-grid reveal">
          <a class="hero-card" href={hero.href ?? undefined} aria-disabled={!hero.href}>
            <div class="hero-banner">
              {hero.banner ? <img src={hero.banner} alt="" /> : <img src="/assets/mascot-icon.png" alt="" class="hero-placeholder" />}
            </div>
            <div class="hero-meta">{hero.category} · {hero.date}</div>
            <h2>{hero.title}</h2>
            <p>{hero.desc}</p>
          </a>

          <div class="featured-list">
            {rest.map((r) => (
              <div class="featured-item">
                <div class="hero-meta">{r.category} · {r.date}</div>
                <h3>{r.title}</h3>
                <p>{r.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="news-table-sec">
      <div class="wrap">
        <div class="table-head">
          <h2>{np.tableTitle}</h2>
          <div class="search-box">
            <Icon name="ph:magnifying-glass" width="14" height="14" />
            <input type="text" id="newsSearch" placeholder={np.searchPlaceholder} autocomplete="off" />
          </div>
        </div>

        <div class="news-table">
          <div class="news-row news-head">
            <span>{t.releases.date}</span>
            <span>{t.releases.category}</span>
            <span>{np.titleCol}</span>
          </div>
          {items.map((r) => (
            <div class="news-row" data-title={r.title.toLowerCase()}>
              <span class="num">{r.date}</span>
              <span>{r.category}</span>
              {r.href ? (
                <a href={r.href}>{r.title}</a>
              ) : (
                <span class="news-soon">{r.title} <em>{t.releases.notPublished}</em></span>
              )}
            </div>
          ))}
        </div>
        <p class="no-results" id="newsNoResults" style="display:none;">{np.noResults}</p>
      </div>
    </section>
  </main>
</Base>

<script>
  const input = document.getElementById('newsSearch');
  const rows = Array.from(document.querySelectorAll('.news-row:not(.news-head)'));
  const noResults = document.getElementById('newsNoResults');
  input?.addEventListener('input', () => {
    const q = (input as HTMLInputElement).value.trim().toLowerCase();
    let visible = 0;
    rows.forEach((row) => {
      const match = !q || (row as HTMLElement).dataset.title?.includes(q);
      (row as HTMLElement).style.display = match ? '' : 'none';
      if (match) visible++;
    });
    if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
  });
</script>

<style>
  .news-hero-sec { padding: 56px 0 20px; }
  .news-hero-sec h1 { font-size: 40px; margin-bottom: 28px; }

  .utility-box { border: 1px solid var(--border); border-radius: 14px; overflow: hidden; margin-bottom: 44px; }
  .utility-row { display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; text-decoration: none; }
  .utility-row:not(:last-child) { border-bottom: 1px solid var(--border-soft); }
  .utility-row:hover { background: var(--card-hover); }
  .utility-label { font-size: 14px; color: var(--text); font-weight: 500; }
  .utility-value { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--text-muted); }
  .utility-value :global(.utility-ic) { width: 15px; height: 15px; color: var(--text-dim); }
  .utility-row:hover .utility-value { color: var(--accent); }
  .utility-row:hover .utility-value :global(.utility-ic) { color: var(--accent); }

  .featured-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 44px; padding-bottom: 48px; border-bottom: 1px solid var(--border-soft); margin-bottom: 48px; }
  .hero-card { display: block; text-decoration: none; color: inherit; }
  .hero-card[aria-disabled="true"] { pointer-events: none; cursor: default; }
  .hero-banner { aspect-ratio: 16/9; border-radius: 14px; overflow: hidden; border: 1px solid var(--border); background: var(--bg-raise); margin-bottom: 16px; display: flex; align-items: center; justify-content: center; }
  .hero-banner img { width: 100%; height: 100%; object-fit: cover; }
  .hero-banner img.hero-placeholder { width: 44px; height: 44px; object-fit: contain; opacity: 0.5; }
  .hero-meta { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 8px; }
  .hero-card h2 { font-size: 24px; margin-bottom: 8px; }
  .hero-card p, .featured-item p { font-size: 14px; color: var(--text-muted); line-height: 1.6; margin: 0; }

  .featured-list { display: flex; flex-direction: column; gap: 22px; }
  .featured-item { padding-bottom: 22px; border-bottom: 1px solid var(--border-soft); }
  .featured-item:last-child { border-bottom: none; padding-bottom: 0; }
  .featured-item h3 { font-size: 16.5px; margin-bottom: 6px; }

  .news-table-sec { padding-bottom: 100px; }
  .table-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
  .table-head h2 { font-size: 24px; }
  .search-box { display: flex; align-items: center; gap: 8px; border: 1px solid var(--border); border-radius: 9px; padding: 8px 12px; color: var(--text-dim); width: 220px; }
  .search-box input { border: none; background: none; outline: none; color: var(--text); font-size: 13.5px; width: 100%; font-family: var(--sans); }

  .news-table { border-top: 1px solid var(--border-soft); }
  .news-row { display: grid; grid-template-columns: 140px 160px 1fr; align-items: center; gap: 16px; padding: 15px 0; border-bottom: 1px solid var(--border-soft); font-size: 14px; }
  .news-head { font-family: var(--mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-dim); }
  .news-row span:nth-child(2) { color: var(--text-muted); }
  .news-row a { color: var(--text); text-decoration: none; font-weight: 500; }
  .news-row a:hover { color: var(--accent); }
  .news-soon { color: var(--text-dim); display: flex; align-items: center; gap: 8px; }
  .news-soon em { font-family: var(--mono); font-style: normal; font-size: 10.5px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-dim); background: var(--border-soft); padding: 2px 7px; border-radius: 5px; }
  .no-results { text-align: center; color: var(--text-dim); font-size: 14px; padding: 30px 0; }

  @media (max-width: 760px) {
    .featured-grid { grid-template-columns: 1fr; }
    .news-row { grid-template-columns: 90px 1fr; }
    .news-row span:nth-child(2) { display: none; }
    .search-box { width: 160px; }
  }
</style>
