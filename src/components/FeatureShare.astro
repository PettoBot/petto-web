---
// The address to share for one feature (/features/tickets): its link preview is drawn for that feature (its own card, title and description),
// and the page itself sends the visitor to that part of the Features page. Apps that read link previews do not run scripts, so they stop here;
// people go on to /features#tickets (a link in the page does the same when scripts are off).
import Base from '../layouts/Base.astro';
import { featuresCopy } from '../data/featuresPage';
import { localePath, type Locale } from '../i18n/ui';

interface Props { lang: Locale; id: string }
const { lang, id } = Astro.props;
const c = featuresCopy[lang];
const group = c.groups.find((g) => g.id === id);
if (!group) throw new Error(`There is no feature "${id}"`);
const target = `${localePath[lang]}/features#${id}`;
---
<Base title={`${group.title} · Petto`} description={group.desc} active="home" lang={lang} noindex>
  <main>
    <section class="fs-sec">
      <div class="wrap">
        <div class="eyebrow">{c.eyebrow}</div>
        <h1>{group.title}</h1>
        <p class="fs-desc">{group.desc}</p>
        <a class="btn btn-primary" id="fsGo" href={target}>{c.title} &rarr;</a>
      </div>
    </section>
  </main>
  <script is:inline define:vars={{ target }}>location.replace(target);</script>
</Base>

<style>
  .fs-sec { padding: 90px 0 120px; }
  .fs-sec h1 { font-size: 30px; margin: 14px 0 12px; }
  .fs-desc { color: var(--text-muted); font-size: 15px; line-height: 1.6; max-width: 54ch; margin: 0 0 24px; }
</style>
