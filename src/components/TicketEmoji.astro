---
// An emoji of a ticket type as Discord draws it: a custom emoji (`<:name:id>`) as its picture, a normal one as text. Never the raw code.
interface Props { emoji?: string | null; fallback?: string; size?: number }
const { emoji, fallback = '🎫', size = 18 } = Astro.props;
const custom = /^<(a?):(\w+):(\d+)>$/.exec(String(emoji ?? '').trim());
const url = custom ? `https://cdn.discordapp.com/emojis/${custom[3]}.${custom[1] ? 'gif' : 'png'}?size=${size > 24 ? 64 : 48}` : null;
const text = String(emoji ?? '').trim() || fallback;
---
{url
  ? <img class="tk-em" src={url} alt={custom![2]} width={size} height={size} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
  : <span class="tk-em-text" style={`font-size:${size - 3}px`}>{text}</span>}
<style>
  .tk-em { display: inline-block; vertical-align: -0.2em; object-fit: contain; }
  .tk-em-text { line-height: 1; }
</style>
