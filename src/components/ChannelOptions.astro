---
// The options of a channel picker: the channels grouped under their category the way Discord shows them, and, when asked, the choice that
// makes a new private channel when the page is saved. Used inside a <select>.
import { makeT, getDashLang } from '../i18n/dash';

interface Channel { id: string; name: string; category?: string }
interface Props { channels: Channel[]; selected?: string; create?: boolean }
const { channels, selected = '', create = false } = Astro.props;
const dt = makeT(getDashLang(Astro));
const groups = new Map<string, Channel[]>();
for (const channel of channels) {
  const key = channel.category ?? '';
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(channel);
}
---
{create && <option value="__new__">{dt('Create a new channel')}</option>}
{[...groups].map(([category, list]) => category
  ? <optgroup label={category}>{list.map((c) => <option value={c.id} selected={c.id === selected}>#{c.name}</option>)}</optgroup>
  : list.map((c) => <option value={c.id} selected={c.id === selected}>#{c.name}</option>))}
