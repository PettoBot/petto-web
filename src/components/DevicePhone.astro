---
// A phone drawn in CSS: a rounded frame, a small island at the top and the screen. It holds a picture (`src`, taken at 390 px wide) or whatever is put inside it.
interface Props { src?: string; alt?: string; width?: number; height?: number; class?: string }
const { src, alt = '', width = 780, height = 1688, class: className = '' } = Astro.props;
---
<div class:list={['ph', className]}>
  <div class="ph-screen">
    <span class="ph-island" aria-hidden="true"></span>
    {src ? <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" /> : <div class="ph-slot"><slot /></div>}
  </div>
</div>
<style>
  .ph { position: relative; width: 100%; border: 7px solid #2b2e35; border-radius: 40px; background: #000; box-shadow: 0 0 0 1px #000, 0 30px 70px -20px rgba(0, 0, 0, 0.75); overflow: hidden; }
  .ph-screen { position: relative; border-radius: 32px; overflow: hidden; background: var(--bg); }
  .ph-island { position: absolute; left: 50%; top: 9px; z-index: 2; width: 28%; height: 20px; margin-left: -14%; border-radius: 999px; background: #000; }
  .ph-screen img { display: block; width: 100%; height: auto; }
  .ph-slot { padding: 38px 12px 14px; }
  @media (max-width: 560px) { .ph { border-width: 5px; border-radius: 30px; } .ph-screen { border-radius: 24px; } .ph-island { top: 6px; height: 14px; } }
</style>
