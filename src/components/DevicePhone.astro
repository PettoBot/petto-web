---
// A phone drawn in CSS: a rounded frame, a small island at the top and the screen. It holds a picture (`src`, taken at 390 px wide) or whatever is put inside it.
// What is put inside is drawn at the scale of a phone screen (`zoom`, by the width of the phone) and cut to the shape of the screen, like a chat that is scrolled.
// A picture can be opened bigger with a tap (`pop`).
interface Props { src?: string; alt?: string; width?: number; height?: number; class?: string; pop?: boolean }
const { src, alt = '', width = 780, height = 1688, class: className = '', pop = false } = Astro.props;
---
<div class:list={['ph', className]}>
  <div class="ph-screen">
    <span class="ph-island" aria-hidden="true"></span>
    {src
      ? <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" data-pop={pop ? '' : undefined} />
      : <div class="ph-slot"><div class="ph-in"><slot /></div></div>}
  </div>
</div>
<style>
  .ph { position: relative; width: 100%; container-type: inline-size; border: 7px solid #2b2e35; border-radius: 40px; background: #000; box-shadow: 0 0 0 1px #000, 0 30px 70px -20px rgba(0, 0, 0, 0.75); overflow: hidden; }
  .ph-screen { position: relative; border-radius: 32px; overflow: hidden; background: #313338; }
  .ph-island { position: absolute; left: 50%; top: 9px; z-index: 2; width: 28%; height: 20px; margin-left: -14%; border-radius: 999px; background: #000; }
  .ph-screen img { display: block; width: 100%; height: auto; }
  .ph-slot { position: relative; aspect-ratio: 9 / 18.5; overflow: hidden; padding-top: 40px; }
  .ph-slot::after { content: ''; position: absolute; inset: auto 0 0 0; height: 12%; pointer-events: none; background: linear-gradient(transparent, #313338); }
  .ph-in { zoom: 0.74; display: flex; flex-direction: column; gap: 14px; padding: 0 10px; }
  @container (max-width: 270px) { .ph-in { zoom: 0.62; } }
  @media (max-width: 560px) { .ph { border-width: 5px; border-radius: 30px; } .ph-screen { border-radius: 24px; } .ph-island { top: 6px; height: 14px; } .ph-slot { padding-top: 30px; } }
</style>
