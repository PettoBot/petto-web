---
// A phone drawn in CSS, made to look like one that somebody is using: a frame, a status bar (time, island, signal, wifi, battery), the screen, the line of gestures at
// the bottom and, if asked, a finger that touches the screen now and then (`touch`: where, in % of the screen; `delay`: seconds, so the phones of a group do not tap together).
// It holds a picture (`src`, taken at 390 px wide: it is shown whole, between the two bars, so nothing is covered) or whatever is put inside it. What is put inside is drawn
// at the scale of a phone screen (`zoom`, by the width of the phone) and cut to the shape of the screen, like a chat that is scrolled. A picture can be opened bigger with a tap (`pop`).
interface Props { src?: string; alt?: string; width?: number; height?: number; class?: string; pop?: boolean; touch?: { x: number; y: number }; delay?: number }
const { src, alt = '', width = 780, height = 1688, class: className = '', pop = false, touch, delay = 0 } = Astro.props;
---
<div class:list={['ph', className]}>
  <div class="ph-screen">
    <div class="ph-status" aria-hidden="true">
      <span class="ph-time">9:41</span>
      <span class="ph-island"></span>
      <span class="ph-icons">
        <i class="ph-signal"><b></b><b></b><b></b><b></b></i>
        <svg class="ph-wifi" viewBox="0 0 16 12" width="13" height="10"><path d="M8 11.2 5.6 8.6a3.5 3.5 0 0 1 4.8 0L8 11.2Zm-4.3-4.6a6 6 0 0 1 8.6 0l-1.3 1.3a4.2 4.2 0 0 0-6 0L3.7 6.6ZM.9 3.7a10 10 0 0 1 14.2 0l-1.3 1.3a8.2 8.2 0 0 0-11.6 0L.9 3.7Z" fill="currentColor" /></svg>
        <i class="ph-battery"><b></b></i>
      </span>
    </div>
    {src
      ? <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" data-pop={pop ? '' : undefined} />
      : <div class="ph-slot"><div class="ph-in"><slot /></div></div>}
    <div class="ph-home" aria-hidden="true"><span></span></div>
    {touch && <span class="ph-touch" aria-hidden="true" style={`--x:${touch.x}%;--y:${touch.y}%;--d:${delay}s`}></span>}
  </div>
</div>
<style>
  .ph { position: relative; width: 100%; container-type: inline-size; border: 7px solid #2b2e35; border-radius: 40px; background: #000; box-shadow: 0 0 0 1px #000, 0 30px 70px -20px rgba(0, 0, 0, 0.75); overflow: hidden; }
  .ph-screen { position: relative; border-radius: 32px; overflow: hidden; background: #000; }
  /* The bar of the top: the time on the left, the island in the middle, the icons on the right. It is part of the phone, above the picture (never over it). */
  .ph-status { position: relative; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: clamp(18px, 8.5cqw, 30px); padding: 0 clamp(10px, 7cqw, 20px); color: #fff; font-size: clamp(7px, 3.6cqw, 11px); font-weight: 600; letter-spacing: .01em; background: #000; }
  .ph-time { justify-self: start; font-variant-numeric: tabular-nums; }
  .ph-island { width: clamp(30px, 26cqw, 78px); height: clamp(8px, 4.8cqw, 15px); border-radius: 999px; background: #15161a; box-shadow: inset 0 0 0 1px #1d1f24; }
  .ph-icons { justify-self: end; display: inline-flex; align-items: center; gap: clamp(2px, 1.6cqw, 5px); }
  .ph-signal { display: inline-flex; align-items: flex-end; gap: 1px; height: clamp(5px, 3cqw, 9px); }
  .ph-signal b { display: block; width: clamp(1.5px, .9cqw, 2.5px); background: #fff; border-radius: 1px; }
  .ph-signal b:nth-child(1) { height: 35%; } .ph-signal b:nth-child(2) { height: 55%; } .ph-signal b:nth-child(3) { height: 78%; } .ph-signal b:nth-child(4) { height: 100%; }
  .ph-wifi { width: clamp(8px, 4.4cqw, 13px); height: auto; }
  .ph-battery { position: relative; display: inline-block; width: clamp(11px, 6.4cqw, 19px); height: clamp(5px, 3.1cqw, 9px); border: 1px solid rgba(255, 255, 255, .6); border-radius: 2.5px; }
  .ph-battery::after { content: ''; position: absolute; right: -2.5px; top: 22%; width: 1.5px; height: 56%; border-radius: 0 1px 1px 0; background: rgba(255, 255, 255, .6); }
  .ph-battery b { position: absolute; inset: 1px; right: 22%; border-radius: 1px; background: #fff; }
  .ph-screen img { display: block; width: 100%; height: auto; background: #313338; }
  /* The line of gestures at the bottom, under the picture. */
  .ph-home { display: grid; place-items: center; height: clamp(10px, 5cqw, 16px); background: #000; }
  .ph-home span { width: 34%; height: clamp(2px, 1.1cqw, 3.5px); border-radius: 999px; background: rgba(255, 255, 255, .78); }
  .ph-slot { position: relative; aspect-ratio: 9 / 18.5; overflow: hidden; background: #313338; }
  .ph-slot::after { content: ''; position: absolute; inset: auto 0 0 0; height: 12%; pointer-events: none; background: linear-gradient(transparent, #313338); }
  .ph-in { zoom: 0.74; display: flex; flex-direction: column; gap: 14px; padding: 10px 10px 0; }
  @container (max-width: 270px) { .ph-in { zoom: 0.62; } }
  /* The finger: a soft circle that comes to a place of the screen, presses (it shrinks and a ring goes out) and leaves. Every few seconds, never together with the next phone. */
  .ph-touch { position: absolute; left: var(--x); top: var(--y); z-index: 3; width: clamp(14px, 9cqw, 26px); aspect-ratio: 1; margin: -4.5cqw 0 0 -4.5cqw; border-radius: 50%; background: radial-gradient(circle, rgba(255, 255, 255, .55), rgba(255, 255, 255, .22) 70%, transparent); box-shadow: 0 0 0 1px rgba(255, 255, 255, .25); opacity: 0; pointer-events: none; animation: phTouch 8s ease-in-out infinite; animation-delay: var(--d); }
  .ph-touch::after { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 2px solid rgba(255, 255, 255, .6); opacity: 0; animation: phRing 8s ease-out infinite; animation-delay: var(--d); }
  @keyframes phTouch {
    0% { opacity: 0; transform: translate(40%, 90%) scale(1); }
    14% { opacity: 1; transform: translate(0, 0) scale(1); }
    22% { opacity: 1; transform: translate(0, 0) scale(.72); }
    30% { opacity: 1; transform: translate(0, 0) scale(1); }
    42%, 100% { opacity: 0; transform: translate(-30%, -60%) scale(1); }
  }
  @keyframes phRing { 0%, 21% { opacity: 0; transform: scale(.7); } 23% { opacity: .9; transform: scale(.8); } 36%, 100% { opacity: 0; transform: scale(2.1); } }
  @media (prefers-reduced-motion: reduce) { .ph-touch, .ph-touch::after { animation: none; opacity: 0; } }
  @media (max-width: 560px) { .ph { border-width: 5px; border-radius: 30px; } .ph-screen { border-radius: 24px; } }
</style>
