---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MultiSelect from './MultiSelect.astro';
import DashAcData from './DashAcData.astro';
import { RULES, ACTIONS, type Effective, type GuardSettings } from '../utils/antinukeRules';
import { getDashLang, makeT } from '../i18n/dash';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  section: string;
  protections: Effective[];
  join: { raidEnabled: boolean; raidThreshold: number; raidWindow: number; raidAction: string; altEnabled: boolean; altDays: number; altAction: string };
  shared: { whitelistIds: string; whitelistRoleIds: string[]; alertChannelId: string; oldSwitch: boolean };
  guard: GuardSettings;
  viewerIsOwner: boolean;
  blocked: boolean;
  lockdownConfig: { channelIds: string[]; pauseInvites: boolean; raiseVerification: boolean; autoEndMinutes: number; announceChannelId: string; message: string };
  lockdownActive: { startedBy: string; reason: string; startedAt: string; endsAt: string; channels: number } | null;
  events: { id: number; rule: string; executor_id: string; executor_name: string | null; action_count: number; action: string; detail: string | null; restorable: unknown[]; previous_roles: string[]; restored_at: string | null; created_at: string }[];
  roles: { id: string; name: string }[];
  channels: { id: string; name: string }[];
  saved: boolean;
  failed: boolean;
}
const { user, guildId, guildName, guildIcon, section, protections, join, shared, guard, viewerIsOwner, blocked, events, lockdownConfig, lockdownActive, roles, channels, saved, failed } = Astro.props;

const names: Record<string, { label: string; text: string }> = {
  ban: { label: dt('Anti Ban'), text: dt('Punishes mass bans in a row.') },
  kick: { label: dt('Anti Kick'), text: dt('Punishes mass kicks in a row.') },
  bot_add: { label: dt('Anti Bots'), text: dt('Removes bots added without permission and punishes who added them.') },
  webhook: { label: dt('Anti Webhooks'), text: dt('Detects the mass creation of webhooks.') },
  channel_create: { label: dt('Anti Create Channels'), text: dt('Stops the mass creation of channels, and can delete them.') },
  channel_delete: { label: dt('Anti Delete Channels'), text: dt('Stops the mass deletion of channels, and can rebuild them.') },
  role_create: { label: dt('Anti Create Roles'), text: dt('Stops the mass creation of roles, and can delete them.') },
  role_delete: { label: dt('Anti Delete Roles'), text: dt('Stops the mass deletion of roles, and can rebuild them.') },
  role_assign: { label: dt('Anti Assign Roles'), text: dt('Takes back roles with dangerous permissions given to someone.') },
  unban: { label: dt('Anti Unban'), text: dt('Detects mass unbans, and can ban them again.') },
  emoji_delete: { label: dt('Anti Delete Emojis'), text: dt('Detects the mass deletion of emojis.') },
  emoji_create: { label: dt('Anti Create Emojis'), text: dt('Detects the mass creation of emojis.') },
  guild_update: { label: dt('Anti Server Changes'), text: dt('Watches who changes the name, the icon or the vanity again and again, and puts the name and the icon back.') },
  role_update: { label: dt('Anti Role Changes'), text: dt('Roles edited in a row. A role given Administrator or another dangerous permission answers at once, and the roles go back to how they were.') },
  channel_update: { label: dt('Anti Channel Changes'), text: dt('Channels renamed or their permissions changed in a row. A channel opened to @everyone with a dangerous permission answers at once, and the channels go back to how they were.') },
  mention_everyone: { label: dt('Anti Mass Mention'), text: dt('Pinging @everyone or @here again and again. The pings are deleted; bots are left alone.') },
  webhook_spam: { label: dt('Anti Webhook Spam'), text: dt('A webhook made by a person flooding messages: the webhook is deleted. Webhooks of bots and apps are left alone.') },
  prune: { label: dt('Anti Prune'), text: dt('Pruning members, a mass kick in one go.') },
};
const actionNames: Record<string, string> = {
  alert: dt('Only alert'),
  quarantine: dt('Take all their roles'),
  kick: dt('Kick'),
  ban: dt('Ban'),
};
const active = protections.filter((p) => p.enabled).length;
const tabs = [
  { id: 'rules', label: dt('Protections') },
  { id: 'lockdown', label: dt('Lockdown') },
  { id: 'shared', label: dt('Shared settings') },
  { id: 'guard', label: dt('Panic & owner') },
  { id: 'log', label: dt('Log') },
];
const ago = (iso: string) => new Date(iso).toLocaleString(dashLang, { dateStyle: 'medium', timeStyle: 'short' });
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="antinuke" pageTitle={dt('Anti-raid & nuke')}>
  <h1>{dt('Anti-raid & nuke')} <span class="an-count">{dt('{n} of {total} active', { n: active, total: protections.length })}</span></h1>
  <DashAcData roles={roles} channels={channels} />

  {saved && <div class="an-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {failed && <div class="an-flash an-bad">{dt('It could not be saved, try again.')}</div>}
  {blocked && <div class="an-flash an-bad">{dt('Owner only is on: only the server owner and the trusted admins can change the anti-nuke.')}</div>}

  <nav class="an-tabs">
    {tabs.map((t) => <a href={`?section=${t.id}`} class:list={['an-tab', { on: section === t.id }]} data-an-tab={t.id}>{t.label}</a>)}
  </nav>

  <div class="an-panel" data-an-panel="rules" data-lazy={section !== 'rules' ? '' : undefined} hidden={section !== 'rules'}>
  {section === 'rules' && (
  <Fragment>
  <div class="an-list dgl-stagger">
    <form method="POST" class="an-row" data-an-row>
      <input type="hidden" name="action" value="save_join" />
      <div class="an-head">
        <button type="button" class="an-open" data-an-open aria-expanded="false">
          <span class="an-ico"><Icon name="ph:users-three-fill" width="16" height="16" /></span>
          <span><b>{dt('Anti Raid')}</b><em>{dt('Reacts when many accounts join in a few seconds.')}</em></span>
        </button>
        <span class:list={['an-badge', { on: join.raidEnabled }]}>{join.raidEnabled ? dt('Active') : dt('Inactive')}</span>
        <label class="an-switch"><input type="checkbox" name="anti_raid_enabled" checked={join.raidEnabled} data-an-auto /><span></span></label>
      </div>
      <div class="an-body" hidden>
        <div class="an-grid">
          <label class="an-field"><span>{dt('Joins that count as a raid')}</span><input type="number" name="raid_join_threshold" value={join.raidThreshold} min="2" max="50" /></label>
          <label class="an-field"><span>{dt('In how many seconds')}</span><input type="number" name="raid_window_seconds" value={join.raidWindow} min="5" max="120" /></label>
          <label class="an-field"><span>{dt('What to do')}</span><select name="raid_action"><option value="alert" selected={join.raidAction === 'alert'}>{dt('Only alert')}</option><option value="kick" selected={join.raidAction === 'kick'}>{dt('Kick')}</option><option value="lockdown" selected={join.raidAction === 'lockdown'}>{dt('Start a lockdown')}</option></select></label>
        </div>
        <div class="an-sep"></div>
        <div class="an-grid">
          <label class="an-check"><input type="checkbox" name="anti_alt_enabled" checked={join.altEnabled} />{dt('Anti Alt: catch accounts that are too new when they join')}</label>
          <label class="an-field"><span>{dt('Minimum account age (days)')}</span><input type="number" name="anti_alt_min_age_days" value={join.altDays} min="1" max="365" /></label>
          <label class="an-field"><span>{dt('What to do')}</span><select name="anti_alt_action"><option value="kick" selected={join.altAction === 'kick'}>{dt('Kick')}</option><option value="flag" selected={join.altAction === 'flag'}>{dt('Only flag')}</option></select></label>
        </div>
        <div class="an-foot"><button type="button" class="btn btn-ghost btn-sm" data-an-close>{dt('Close')}</button><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:check-bold" width="13" height="13" />{dt('Save')}</button></div>
      </div>
    </form>

    {RULES.map((meta) => {
      const p = protections.find((x) => x.id === meta.id)!;
      const info = names[meta.id];
      return (
      <form method="POST" class="an-row" data-an-row>
        <input type="hidden" name="action" value="save_rule" />
        <input type="hidden" name="rule" value={meta.id} />
        <div class="an-head">
          <button type="button" class="an-open" data-an-open aria-expanded="false">
            <span class="an-ico"><Icon name={meta.icon} width="16" height="16" /></span>
            <span><b>{info.label}</b><em>{info.text}</em></span>
          </button>
          {p.followsOldSwitch && <span class="an-badge an-old" title={dt('It follows the old single switch. Save it to tune it on its own.')}>{dt('Old switch')}</span>}
          <span class:list={['an-badge', { on: p.enabled }]}>{p.enabled ? dt('Active') : dt('Inactive')}</span>
          <label class="an-switch"><input type="checkbox" name="enabled" checked={p.enabled} data-an-auto /><span></span></label>
        </div>
        <div class="an-body" hidden>
          <div class="an-grid">
            <label class="an-field"><span>{dt('Actions that count as an attack')}</span><input type="number" name="threshold" value={p.threshold} min="1" max="50" /></label>
            <label class="an-field"><span>{dt('In how many seconds')}</span><input type="number" name="window_seconds" value={p.window} min="2" max="600" /></label>
            <label class="an-field"><span>{dt('What to do to the account')}</span>
              <select name="rule_action">{ACTIONS.map((a) => <option value={a} selected={p.action === a}>{actionNames[a]}</option>)}</select>
            </label>
            <label class="an-field"><span>{dt('Alert channel')}</span>
              <select name="alert_channel_id"><option value="">{dt('The automod log (or the shared channel)')}</option>{channels.map((c) => <option value={c.id} selected={c.id === p.alertChannelId}>#{c.name}</option>)}</select>
            </label>
          </div>
          <div class="an-field an-wide"><span>{dt('Trusted roles for this protection')}</span><MultiSelect name="whitelist_role_ids" options={roles} selected={p.whitelistRoleIds} placeholder={dt('Search roles...')} /></div>
          <label class="an-field an-wide"><span>{dt('Trusted accounts for this protection (IDs)')}</span><input type="text" name="whitelist_ids" value={p.whitelistIds.join(', ')} placeholder={dt('Paste user IDs, separated by commas')} /></label>
          <p class="an-hint">{dt('Whoever is in the shared settings is trusted here too. A bot doing the attack is banned, whatever you pick.')}</p>
          <div class="an-foot"><button type="button" class="btn btn-ghost btn-sm" data-an-close>{dt('Close')}</button><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:check-bold" width="13" height="13" />{dt('Save')}</button></div>
        </div>
      </form>
      );
    })}
  </div>
  </Fragment>
  )}
  </div>

  <div class="an-panel" data-an-panel="lockdown" data-lazy={section !== 'lockdown' ? '' : undefined} hidden={section !== 'lockdown'}>
  {section === 'lockdown' && (
  <Fragment>
  <div class="an-card">
    <h2>{lockdownActive ? dt('Lockdown is ON') : dt('Lockdown is off')}</h2>
    <p class="an-hint">{dt('A lockdown closes the channels so nobody can write, pauses the invites and can raise the verification, and puts everything back when it ends. Use it while a raid lasts. Anti Raid can start it by itself.')}</p>
    {lockdownActive ? (
      <div class="an-old an-on">
        <p><b>{dt('Since')}</b> {ago(lockdownActive.startedAt)}{lockdownActive.endsAt ? <> · <b>{dt('Ends')}</b> {ago(lockdownActive.endsAt)}</> : <> · {dt('It stays until you end it.')}</>} · {dt('{n} channel(s) closed', { n: lockdownActive.channels })}</p>
        {lockdownActive.reason && <p class="an-hint">{lockdownActive.reason}</p>}
        <div class="an-foot"><button type="button" class="btn btn-accent btn-sm" data-lockdown="end">{dt('End the lockdown')}</button></div>
      </div>
    ) : (
      <div class="an-start">
        <label class="an-field"><span>{dt('Reason (optional)')}</span><input type="text" data-lockdown-reason maxlength="300" /></label>
        <label class="an-field"><span>{dt('Minutes until it ends (0 uses the setting below)')}</span><input type="number" data-lockdown-minutes value="0" min="0" max="10080" /></label>
        <button type="button" class="btn btn-accent btn-sm an-danger" data-lockdown="start">{dt('Start a lockdown now')}</button>
      </div>
    )}
    <div class="an-sep"></div>
    <form method="POST" class="an-lock-form">
      <input type="hidden" name="action" value="save_lockdown" />
      <h2>{dt('What a lockdown does')}</h2>
      <div class="an-field an-wide"><span>{dt('Channels it closes (none chosen means every text channel)')}</span><MultiSelect name="channel_ids" options={channels} selected={lockdownConfig.channelIds} placeholder={dt('Search channels...')} /></div>
      <label class="an-check"><input type="checkbox" name="pause_invites" checked={lockdownConfig.pauseInvites} />{dt('Delete the invites and block new ones')}</label>
      <label class="an-check"><input type="checkbox" name="raise_verification" checked={lockdownConfig.raiseVerification} />{dt('Raise the verification level of the server to High while it lasts')}</label>
      <div class="an-grid">
        <label class="an-field"><span>{dt('Ends by itself after (minutes, 0 for never)')}</span><input type="number" name="auto_end_minutes" value={lockdownConfig.autoEndMinutes} min="0" max="10080" /></label>
        <label class="an-field"><span>{dt('Channel for the notice')}</span>
          <select name="announce_channel_id"><option value="">{dt('No notice')}</option>{channels.map((c) => <option value={c.id} selected={c.id === lockdownConfig.announceChannelId}>#{c.name}</option>)}</select>
        </label>
      </div>
      <label class="an-field an-wide"><span>{dt('The notice')}</span><textarea name="message" rows="2" maxlength="500" placeholder={dt('This server is in lockdown for a moment. The staff is working on it, thank you for waiting.')} data-ac="roles,channels,commands,emojis">{lockdownConfig.message}</textarea></label>
      <div class="an-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:check-bold" width="13" height="13" />{dt('Save')}</button></div>
    </form>
  </div>
  </Fragment>
  )}
  </div>

  <div class="an-panel" data-an-panel="shared" data-lazy={section !== 'shared' ? '' : undefined} hidden={section !== 'shared'}>
  {section === 'shared' && (
  <Fragment>
  <form method="POST" class="an-card">
    <input type="hidden" name="action" value="save_shared" />
    <h2>{dt('Trusted by every protection')}</h2>
    <div class="an-field an-wide"><span>{dt('Trusted roles')}</span><MultiSelect name="whitelist_role_ids" options={roles} selected={shared.whitelistRoleIds} placeholder={dt('Search roles...')} /></div>
    <label class="an-field an-wide"><span>{dt('Trusted accounts and bots (IDs)')}</span><textarea name="whitelist_ids" rows="3" placeholder={dt('Paste user IDs, separated by commas')}>{shared.whitelistIds}</textarea></label>
    <label class="an-field an-wide"><span>{dt('Alert channel for every protection')}</span>
      <select name="alert_channel_id"><option value="">{dt('The automod log')}</option>{channels.map((c) => <option value={c.id} selected={c.id === shared.alertChannelId}>#{c.name}</option>)}</select>
    </label>
    {shared.oldSwitch && (
      <div class="an-old">
        <input type="hidden" name="old_switch_present" value="1" />
        <label class="an-check"><input type="checkbox" name="old_switch" checked />{dt('Old single switch is on')}</label>
        <p class="an-hint">{dt('The protections you have not tuned yet follow this switch (ban, kick, channels, roles, webhooks and emojis, counted together). Turn it off after tuning each one.')}</p>
      </div>
    )}
    <p class="an-hint">{dt('The server owner and Petto are always trusted.')}</p>
    <div class="an-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:check-bold" width="13" height="13" />{dt('Save')}</button></div>
  </form>
  </Fragment>
  )}
  </div>

  <div class="an-panel" data-an-panel="guard" data-lazy={section !== 'guard' ? '' : undefined} hidden={section !== 'guard'}>
  {section === 'guard' && (
  <Fragment>
  <form method="POST" class="an-card">
    <input type="hidden" name="action" value="save_guard" />
    <h2><Icon name="ph:siren-fill" width="16" height="16" /> {dt('Panic mode')}</h2>
    <p class="an-hint">{dt('When several protections act in a few minutes, or Anti Raid sees a raid, the server is locked down at once: the channels close and the invites are deleted and paused. It ends by itself after the minutes below, or earlier from the Lockdown tab.')}</p>
    <label class="an-check"><input type="checkbox" name="panic_enabled" checked={guard.panicEnabled} />{dt('Turn panic mode on')}</label>
    <div class="an-grid">
      <label class="an-field"><span>{dt('Protections acting that start it')}</span><input type="number" name="panic_threshold" value={guard.panicThreshold} min="1" max="20" /></label>
      <label class="an-field"><span>{dt('Within how many minutes')}</span><input type="number" name="panic_window_minutes" value={guard.panicWindow} min="1" max="120" /></label>
      <label class="an-field"><span>{dt('Lockdown ends by itself after (minutes)')}</span><input type="number" name="panic_lockdown_minutes" value={guard.panicMinutes} min="1" max="1440" /></label>
    </div>
    <label class="an-check"><input type="checkbox" name="panic_on_raid" checked={guard.panicOnRaid} />{dt('Also when Anti Raid sees a raid')}</label>
    <div class="an-sep"></div>
    <h2><Icon name="ph:crown-fill" width="16" height="16" /> {dt('Owner')}</h2>
    <label class="an-check"><input type="checkbox" name="dm_owner" checked={guard.dmOwner} />{dt('Send the owner a DM when a protection acts')}</label>
    <label class="an-check"><input type="checkbox" name="owner_only" checked={guard.ownerOnly} disabled={!viewerIsOwner} />{dt('Owner only: only the owner and the trusted admins can change the anti-nuke and restore')}</label>
    <label class="an-field an-wide"><span>{dt('Trusted admins (IDs): they can change the anti-nuke and the protections never touch them')}</span><textarea name="admin_ids" rows="2" disabled={!viewerIsOwner} placeholder={dt('Paste user IDs, separated by commas')}>{guard.adminIds.join(', ')}</textarea></label>
    {!viewerIsOwner && <p class="an-hint">{dt('Only the server owner can change owner only and the trusted admins.')}</p>}
    <p class="an-hint">{dt('The protections never act on the owner, on Petto or on an account whose role is at or above Petto\'s.')}</p>
    <div class="an-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:check-bold" width="13" height="13" />{dt('Save')}</button></div>
  </form>
  </Fragment>
  )}
  </div>

  <div class="an-panel" data-an-panel="log" data-lazy={section !== 'log' ? '' : undefined} hidden={section !== 'log'}>
  {section === 'log' && (
  <Fragment>
  <div class="an-card">
    <h2>{dt('What the protections did')}</h2>
    {events.length === 0 ? <p class="an-empty">{dt('No protection has acted yet.')}</p> : (
      <div class="an-events">
        {events.map((e) => (
          <div class="an-event">
            <div class="an-event-main">
              <b>#{e.id} · {names[e.rule]?.label ?? e.rule}</b>
              <span>{e.executor_name ?? e.executor_id} <code>{e.executor_id}</code> · {e.action_count}× {e.detail ?? ''} · {actionNames[e.action] ?? e.action}</span>
              <em>{ago(e.created_at)}</em>
            </div>
            {e.restored_at ? <span class="an-badge on">{dt('Restored')}</span> : (e.restorable.length > 0 || e.previous_roles.length > 0) ? (
              <button type="button" class="btn btn-ghost btn-sm" data-an-restore={e.id}><Icon name="ph:arrow-counter-clockwise-bold" width="13" height="13" />{dt('Restore')}</button>
            ) : null}
          </div>
        ))}
      </div>
    )}
    <p class="an-hint">{dt('Restore rebuilds deleted channels and roles (not their messages), lifts mass bans and gives the roles back. The owner, the trusted admins and (unless owner only is on) the administrators can do it.')}</p>
  </div>
  </Fragment>
  )}
  </div>
</DashGuildLayout>

<script is:inline>
  // The rows open and close by themselves; the switch of a row saves it right away.
  if (!window.__anBound) {
    window.__anBound = true;
    document.addEventListener('click', function (event) {
      var tab = event.target.closest && event.target.closest('[data-an-tab]');
      if (tab) {
        // The tabs change what is shown without loading the page again, so the menu on the side keeps its place and its animation.
        event.preventDefault();
        var wanted = tab.getAttribute('data-an-tab');
        document.querySelectorAll('[data-an-tab]').forEach(function (t) { t.classList.toggle('on', t === tab); });
        document.querySelectorAll('[data-an-panel]').forEach(function (panel) { panel.hidden = panel.getAttribute('data-an-panel') !== wanted; });
        try { history.replaceState(history.state, '', '?section=' + wanted); } catch (e) {}
        // A tab that was not read with the page is read now, only that part: the page itself is not loaded again.
        var panelEl = document.querySelector('[data-an-panel="' + wanted + '"]');
        if (panelEl && panelEl.hasAttribute('data-lazy') && !panelEl.hasAttribute('data-loading')) {
          panelEl.setAttribute('data-loading', '');
          panelEl.classList.add('an-panel-loading');
          fetch('?section=' + wanted, { method: 'GET' })
            .then(function (r) { return r.text(); })
            .then(function (html) {
              var doc = new DOMParser().parseFromString(html, 'text/html');
              var fresh = doc.querySelector('[data-an-panel="' + wanted + '"]');
              if (!fresh) throw new Error('missing');
              panelEl.innerHTML = fresh.innerHTML;
              panelEl.removeAttribute('data-lazy');
              panelEl.removeAttribute('data-loading');
              panelEl.classList.remove('an-panel-loading');
              panelEl.hidden = !document.querySelector('[data-an-tab="' + wanted + '"].on');
              if (window.dglInitContent) window.dglInitContent(panelEl);
            })
            .catch(function () { location.href = '?section=' + wanted; });
        }
        return;
      }
      var open = event.target.closest && event.target.closest('[data-an-open]');
      var close = event.target.closest && event.target.closest('[data-an-close]');
      var restore = event.target.closest && event.target.closest('[data-an-restore]');
      var lock = event.target.closest && event.target.closest('[data-lockdown]');
      if (lock) {
        var guildId = location.pathname.split('/')[3];
        var starting = lock.getAttribute('data-lockdown') === 'start';
        if (!confirm(starting ? 'Start a lockdown now? The channels will be closed.' : 'End the lockdown and reopen everything?')) return;
        var reasonEl = document.querySelector('[data-lockdown-reason]');
        var minutesEl = document.querySelector('[data-lockdown-minutes]');
        lock.disabled = true;
        fetch('/dash/guild/' + guildId + '/lockdown-api', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ op: starting ? 'start' : 'end', reason: reasonEl ? reasonEl.value : '', minutes: minutesEl ? Number(minutesEl.value) : 0 }) })
          .then(function (r) { return r.json(); })
          .then(function (data) { if (data && data.ok) location.reload(); else { alert((data && data.message) || 'It could not be done.'); lock.disabled = false; } })
          .catch(function () { alert('It could not be done.'); lock.disabled = false; });
        return;
      }

      if (open || close) {
        var row = (open || close).closest('[data-an-row]');
        var body = row.querySelector('.an-body');
        var show = open ? body.hidden : false;
        body.hidden = !show;
        row.classList.toggle('open', show);
        var btn = row.querySelector('[data-an-open]');
        if (btn) btn.setAttribute('aria-expanded', show ? 'true' : 'false');
      }
      if (restore) {
        if (!confirm('Put back what this protection stopped?')) return;
        var guild = location.pathname.split('/')[3];
        restore.disabled = true;
        fetch('/dash/guild/' + guild + '/antinuke-api', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: Number(restore.getAttribute('data-an-restore')) }) })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            var lines = [].concat(data.done || [], data.failed || []);
            alert(data.ok ? (lines.join('\n') || 'Done.') : (data.message || lines.join('\n') || 'It could not be restored.'));
            if (data.ok) location.reload(); else restore.disabled = false;
          })
          .catch(function () { alert('It could not be restored.'); restore.disabled = false; });
      }
    });
    document.addEventListener('change', function (event) {
      var auto = event.target.closest && event.target.closest('[data-an-auto]');
      if (auto && auto.form) auto.form.requestSubmit();
    });
  }
</script>

