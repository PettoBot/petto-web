---
import SilentMentionHint from './SilentMentionHint.astro';
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MultiSelect from './MultiSelect.astro';
import DashAcData from './DashAcData.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import SxNumber from './SxNumber.astro';
import { RULES, ACTIONS, type Effective, type GuardSettings } from '../utils/antinukeRules';
import { dashLocale, getDashLang, makeT } from '../i18n/dash';
import { agoText, formatDuration } from '../utils/formatDuration';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  section: string;
  protections: Effective[];
  join: { raidEnabled: boolean; raidThreshold: number; raidWindow: number; raidAction: string; altEnabled: boolean; altDays: number; altAction: string };
  shared: { whitelistIds: string; whitelistRoleIds: string[]; alertChannelId: string; oldSwitch: boolean };
  guard: GuardSettings;
  viewerIsOwner: boolean;
  blocked: boolean;
  lockdownConfig: { channelIds: string[]; pauseInvites: boolean; raiseVerification: boolean; autoEndMinutes: number; announceChannelId: string; message: string };
  lockdownActive: { startedBy: string; reason: string; startedAt: string; endsAt: string; channels: number } | null;
  events: { id: number; rule: string; executor_id: string; executor_name: string | null; action_count: number; action: string; detail: string | null; restorable: unknown[]; previous_roles: string[]; restored_at: string | null; created_at: string }[];
  /** How many times a protection acted in the last 7 days (only read for the Protections tab). */
  eventsWeek: number;
  roles: { id: string; name: string }[];
  channels: { id: string; name: string }[];
  saved: boolean;
  failed: boolean;
}
const { user, guildId, guildName, guildIcon, section, protections, join, shared, guard, viewerIsOwner, blocked, events, eventsWeek, lockdownConfig, lockdownActive, roles, channels, saved, failed } = Astro.props;

const names: Record<string, { label: string; text: string }> = {
  ban: { label: dt('Anti Ban'), text: dt('Punishes mass bans in a row.') },
  kick: { label: dt('Anti Kick'), text: dt('Punishes mass kicks in a row.') },
  bot_add: { label: dt('Anti Bots'), text: dt('Removes bots added without permission and punishes who added them.') },
  webhook: { label: dt('Anti Webhooks'), text: dt('Detects the mass creation of webhooks.') },
  channel_create: { label: dt('Anti Create Channels'), text: dt('Stops the mass creation of channels, and can delete them.') },
  channel_delete: { label: dt('Anti Delete Channels'), text: dt('Stops the mass deletion of channels, and can rebuild them.') },
  role_create: { label: dt('Anti Create Roles'), text: dt('Stops the mass creation of roles, and can delete them.') },
  role_delete: { label: dt('Anti Delete Roles'), text: dt('Stops the mass deletion of roles, and can rebuild them.') },
  role_assign: { label: dt('Anti Assign Roles'), text: dt('Takes back roles with dangerous permissions given to someone.') },
  unban: { label: dt('Anti Unban'), text: dt('Detects mass unbans, and can ban them again.') },
  emoji_delete: { label: dt('Anti Delete Emojis'), text: dt('Detects the mass deletion of emojis.') },
  emoji_create: { label: dt('Anti Create Emojis'), text: dt('Detects the mass creation of emojis.') },
  guild_update: { label: dt('Anti Server Changes'), text: dt('Watches who changes the name, the icon or the vanity again and again, and puts the name and the icon back.') },
  role_update: { label: dt('Anti Role Changes'), text: dt('Roles edited in a row. A role given Administrator or another dangerous permission answers at once, and the roles go back to how they were.') },
  channel_update: { label: dt('Anti Channel Changes'), text: dt('Channels renamed or their permissions changed in a row. A channel opened to @everyone with a dangerous permission answers at once, and the channels go back to how they were.') },
  mention_everyone: { label: dt('Anti Mass Mention'), text: dt('Pinging @everyone or @here again and again. The pings are deleted; bots are left alone.') },
  webhook_spam: { label: dt('Anti Webhook Spam'), text: dt('A webhook made by a person flooding messages: the webhook is deleted. Webhooks of bots and apps are left alone.') },
  prune: { label: dt('Anti Prune'), text: dt('Pruning members, a mass kick in one go.') },
};
const actionNames: Record<string, string> = {
  alert: dt('Only alert'),
  quarantine: dt('Take all their roles'),
  kick: dt('Kick'),
  ban: dt('Ban'),
};
const active = protections.filter((p) => p.enabled).length;
const tabs = [
  { id: 'rules', label: dt('Protections') },
  { id: 'lockdown', label: dt('Lockdown') },
  { id: 'shared', label: dt('Shared settings') },
  { id: 'guard', label: dt('Panic & owner') },
  { id: 'log', label: dt('Log') },
];
const ago = (iso: string) => new Date(iso).toLocaleString(dashLang, { dateStyle: 'medium', timeStyle: 'short' });
/** "5m ago", "1h 5m ago", "2d 3h ago". */
const since = (iso: string) => agoText(dt, iso, { locale: dashLocale(dashLang) });
const protection = (id: string) => protections.find((p) => p.id === id)!;
const ruleIcon = (id: string) => RULES.find((r) => r.id === id)?.icon ?? 'ph:shield-warning-fill';
const channelName = (id: string) => channels.find((c) => c.id === id)?.name ?? id;
/** A channel name that fits a number tile. */
const tileChannel = (id: string) => { const name = channelName(id); return `#${name.length > 11 ? `${name.slice(0, 10)}…` : name}`; };
// The protections in groups, so eighteen cards read as five short lists. "raid" is Anti Raid, which lives in the AutoMod settings.
const groups = [
  { id: 'joins', title: dt('Joins'), hint: dt('Raids, accounts that are too new and bots that come in.'), items: ['raid', 'bot_add'] },
  { id: 'members', title: dt('Members'), hint: dt('Mass bans, kicks, unbans and prunes.'), items: ['ban', 'kick', 'unban', 'prune'] },
  { id: 'channels', title: dt('Channels'), hint: dt('Channels created, deleted or changed in a row.'), items: ['channel_create', 'channel_delete', 'channel_update'] },
  { id: 'roles', title: dt('Roles'), hint: dt('Roles created, deleted or changed, and dangerous roles handed out.'), items: ['role_create', 'role_delete', 'role_update', 'role_assign'] },
  { id: 'server', title: dt('Server and messages'), hint: dt('The server itself, emojis, webhooks and mass pings.'), items: ['guild_update', 'emoji_create', 'emoji_delete', 'webhook', 'webhook_spam', 'mention_everyone'] },
];
const isOn = (id: string) => (id === 'raid' ? join.raidEnabled : protection(id).enabled);
// What the log shows, counted: which protection acted most and who set them off.
const byRule = Object.entries(events.reduce<Record<string, number>>((all, e) => ({ ...all, [e.rule]: (all[e.rule] ?? 0) + 1 }), {})).sort((a, b) => b[1] - a[1]).slice(0, 6);
const byPerson = Object.values(events.reduce<Record<string, { id: string; name: string; n: number }>>((all, e) => ({ ...all, [e.executor_id]: { id: e.executor_id, name: e.executor_name ?? e.executor_id, n: (all[e.executor_id]?.n ?? 0) + 1 } }), {})).sort((a, b) => b.n - a.n).slice(0, 5);
const restored = events.filter((e) => e.restored_at).length;
const canRestore = events.filter((e) => !e.restored_at && (e.restorable.length > 0 || e.previous_roles.length > 0)).length;
const lastWindow = events.filter((e) => Date.now() - new Date(e.created_at).getTime() < guard.panicWindow * 60000).length;
const ownTrust = (p: Effective) => p.whitelistRoleIds.length + p.whitelistIds.length;
const withOwnTrust = protections.filter((p) => ownTrust(p) > 0).length;
const sharedAccounts = shared.whitelistIds.split(/[\s,]+/).filter(Boolean).length;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="antinuke" pageTitle={dt('Anti-raid & nuke')}>
  <DashSettingsKit />
  <DashFormKit />
  <div class="anx-page" data-an-words data-saved={dt('Saved.')} data-failed={dt('It could not be saved, try again.')}>
  <h1>{dt('Anti-raid & nuke')} <span class="an-count">{dt('{n} of {total} active', { n: active, total: protections.length })}</span></h1>
  <DashAcData roles={roles} channels={channels} />

  {saved && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {failed && <div class="sx-flash sx-flash-bad">{dt('It could not be saved, try again.')}</div>}
  {blocked && <div class="sx-flash sx-flash-bad">{dt('Owner only is on: only the server owner and the trusted admins can change the anti-nuke.')}</div>}

  <nav class="an-tabs">
    {tabs.map((t) => <a href={`?section=${t.id}`} class:list={['an-tab', { on: section === t.id }]} data-an-tab={t.id}>{t.label}</a>)}
  </nav>

  <div class="an-panel" data-an-panel="rules" data-lazy={section !== 'rules' ? '' : undefined} hidden={section !== 'rules'}>
  {section === 'rules' && (
  <Fragment>
  <DashStatTiles tiles={[
    { label: dt('Protections on'), value: active, tone: 'joins' },
    { label: dt('Acted this week'), value: eventsWeek, tone: 'leaves' },
    { label: dt('Anti Raid'), value: 0, text: join.raidEnabled ? dt('{n} in {a}', { n: join.raidThreshold, a: formatDuration(join.raidWindow) }) : dt('Off'), tone: 'voice' },
    { label: dt('Anti Alt, minimum age'), value: 0, text: join.altEnabled ? formatDuration(join.altDays * 86400) : dt('Off'), tone: 'invites' },
  ]} />
  {groups.map((group) => (
  <div class="anx-group">
    <div class="anx-head">
      <h2>{group.title} <span class="anx-count">{dt('{n} of {total} on', { n: group.items.filter(isOn).length, total: group.items.length })}</span></h2>
      <p>{group.hint}</p>
    </div>
    <div class="an-list dgl-stagger">
    {group.items.map((id) => {
      if (id === 'raid') return (
    <form method="POST" class="an-row" data-an-row>
      <input type="hidden" name="action" value="save_join" />
      <div class="an-head">
        <button type="button" class="an-open" data-an-open aria-expanded="false">
          <span class="an-ico"><Icon name="ph:users-three-fill" width="16" height="16" /></span>
          <span class="an-text"><b>{dt('Anti Raid')}</b><em>{dt('Reacts when many accounts join in a few seconds.')}</em></span>
          <Icon name="ph:caret-down-bold" class="an-caret" width="13" height="13" />
        </button>
        <label class="sx-switch anx-sw"><input type="checkbox" name="anti_raid_enabled" checked={join.raidEnabled} data-an-auto data-no-dirty aria-label={dt('Anti Raid')} /><span class="sx-toggle"></span></label>
      </div>
      <div class="an-body" hidden>
        <div class="sx-grid">
          <div class="sx-field"><label for="an-raid-n">{dt('Joins that count as a raid')}</label><SxNumber id="an-raid-n" name="raid_join_threshold" value={join.raidThreshold} min={2} max={50} /></div>
          <div class="sx-field"><label for="an-raid-s">{dt('In how many seconds')}</label><SxNumber id="an-raid-s" name="raid_window_seconds" value={join.raidWindow} min={5} max={120} /></div>
        </div>
        <div class="sx-field"><span class="sx-label">{dt('What to do')}</span>
          <div class="dfx-chips">
            <label class="dfx-chip"><input type="radio" name="raid_action" value="alert" checked={join.raidAction === 'alert'} />{dt('Only alert')}</label>
            <label class="dfx-chip"><input type="radio" name="raid_action" value="kick" checked={join.raidAction === 'kick'} />{dt('Kick')}</label>
            <label class="dfx-chip"><input type="radio" name="raid_action" value="lockdown" checked={join.raidAction === 'lockdown'} />{dt('Start a lockdown')}</label>
          </div>
        </div>
        <div class="sx-sub">
          <label class="sx-switch"><input type="checkbox" name="anti_alt_enabled" checked={join.altEnabled} /><span class="sx-switch-text"><b>{dt('Anti Alt: catch accounts that are too new when they join')}</b></span><span class="sx-toggle"></span></label>
          <div class="anx-needs" data-sx-needs="anti_alt_enabled">
            <div class="sx-field"><label for="an-alt-d">{dt('Minimum account age (days)')}</label><SxNumber id="an-alt-d" name="anti_alt_min_age_days" value={join.altDays} min={1} max={365} /></div>
            <div class="sx-field"><span class="sx-label">{dt('What to do')}</span>
              <div class="dfx-chips">
                <label class="dfx-chip"><input type="radio" name="anti_alt_action" value="kick" checked={join.altAction === 'kick'} />{dt('Kick')}</label>
                <label class="dfx-chip"><input type="radio" name="anti_alt_action" value="flag" checked={join.altAction === 'flag'} />{dt('Only flag')}</label>
              </div>
            </div>
          </div>
        </div>
        <div class="an-foot"><button type="button" class="btn btn-ghost btn-sm" data-an-close>{dt('Close')}</button><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:check-bold" width="13" height="13" />{dt('Save')}</button></div>
      </div>
    </form>
      );
      const meta = RULES.find((r) => r.id === id)!;
      const p = protection(id);
      const info = names[id];
      return (
      <form method="POST" class="an-row" data-an-row>
        <input type="hidden" name="action" value="save_rule" />
        <input type="hidden" name="rule" value={meta.id} />
        <div class="an-head">
          <button type="button" class="an-open" data-an-open aria-expanded="false">
            <span class="an-ico"><Icon name={meta.icon} width="16" height="16" /></span>
            <span class="an-text"><b>{info.label}</b><em>{info.text}</em></span>
            <Icon name="ph:caret-down-bold" class="an-caret" width="13" height="13" />
          </button>
          {p.followsOldSwitch && <span class="anx-old" title={dt('It follows the old single switch. Save it to tune it on its own.')}>{dt('Old switch')}</span>}
          <label class="sx-switch anx-sw"><input type="checkbox" name="enabled" checked={p.enabled} data-an-auto data-no-dirty aria-label={info.label} /><span class="sx-toggle"></span></label>
        </div>
        <div class="an-body" hidden>
          <div class="sx-grid">
            <div class="sx-field"><label for={`an-${id}-n`}>{dt('Actions that count as an attack')}</label><SxNumber id={`an-${id}-n`} name="threshold" value={p.threshold} min={1} max={50} /></div>
            <div class="sx-field"><label for={`an-${id}-s`}>{dt('In how many seconds')}</label><SxNumber id={`an-${id}-s`} name="window_seconds" value={p.window} min={2} max={600} /></div>
          </div>
          <div class="sx-field"><span class="sx-label">{dt('What to do to the account')}</span>
            <div class="dfx-chips">{ACTIONS.map((a) => <label class="dfx-chip"><input type="radio" name="rule_action" value={a} checked={p.action === a} />{actionNames[a]}</label>)}</div>
          </div>
          <div class="sx-field"><label for={`an-${id}-ch`}>{dt('Alert channel')}</label>
            <select id={`an-${id}-ch`} name="alert_channel_id"><option value="">{dt('The automod log (or the shared channel)')}</option>{channels.map((c) => <option value={c.id} selected={c.id === p.alertChannelId}>#{c.name}</option>)}</select>
          </div>
          <div class="sx-field"><span class="sx-label">{dt('Trusted roles for this protection')}</span><MultiSelect name="whitelist_role_ids" options={roles} selected={p.whitelistRoleIds} placeholder={dt('Search roles...')} /></div>
          <div class="sx-field"><label for={`an-${id}-ids`}>{dt('Trusted accounts for this protection (IDs)')}</label><textarea id={`an-${id}-ids`} name="whitelist_ids" class="dgl-autogrow sx-one" rows="1" data-one-line placeholder={dt('Paste user IDs, separated by commas')}>{p.whitelistIds.join(', ')}</textarea></div>
          <p class="sx-hint">{dt('Whoever is in the shared settings is trusted here too. A bot doing the attack is banned, whatever you pick.')}</p>
          <div class="an-foot"><button type="button" class="btn btn-ghost btn-sm" data-an-close>{dt('Close')}</button><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:check-bold" width="13" height="13" />{dt('Save')}</button></div>
        </div>
      </form>
      );
    })}
    </div>
  </div>
  ))}
  </Fragment>
  )}
  </div>

  <div class="an-panel" data-an-panel="lockdown" data-lazy={section !== 'lockdown' ? '' : undefined} hidden={section !== 'lockdown'}>
  {section === 'lockdown' && (
  <Fragment>
  <DashStatTiles tiles={[
    { label: dt('Lockdown'), value: 0, text: lockdownActive ? dt('On') : dt('Off'), tone: lockdownActive ? 'leaves' : 'joins' },
    { label: dt('Channels it closes'), value: lockdownConfig.channelIds.length, text: lockdownConfig.channelIds.length ? undefined : dt('Every text channel'), tone: 'messages' },
    { label: dt('Ends by itself'), value: 0, text: lockdownConfig.autoEndMinutes ? formatDuration(lockdownConfig.autoEndMinutes * 60) : dt('Never'), tone: 'voice' },
    { label: dt('Notice'), value: 0, text: lockdownConfig.announceChannelId ? tileChannel(lockdownConfig.announceChannelId) : dt('No notice'), tone: 'invites' },
  ]} />
  <div class="sx-duo anx-duo">
    <div class="sx-stack">
      <div class="sx-panel">
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style={`--c:${lockdownActive ? 'var(--red, #ff6b6b)' : 'var(--green)'}`}><Icon name={lockdownActive ? 'ph:lock-fill' : 'ph:lock-simple-open-fill'} width="17" height="17" /></span>
          <h2>{lockdownActive ? dt('Lockdown is ON') : dt('Lockdown is off')}</h2>
          <span class:list={['sx-pill-state', { on: !lockdownActive }]}>{lockdownActive ? dt('On') : dt('Off')}</span>
        </div>
        <p class="sx-lead">{dt('A lockdown closes the channels so nobody can write, pauses the invites and can raise the verification, and puts everything back when it ends. Use it while a raid lasts. Anti Raid can start it by itself.')}</p>
        {lockdownActive ? (
          <div class="anx-live">
            <div class="sx-row"><span class="anx-k">{dt('Since')}</span><b>{ago(lockdownActive.startedAt)}</b></div>
            <div class="sx-row"><span class="anx-k">{dt('Ends')}</span><b>{lockdownActive.endsAt ? ago(lockdownActive.endsAt) : dt('It stays until you end it.')}</b></div>
            <div class="sx-row"><span class="anx-k">{dt('Channels closed')}</span><b>{lockdownActive.channels}</b></div>
            {lockdownActive.reason && <p class="sx-hint">{lockdownActive.reason}</p>}
            <div class="an-foot"><button type="button" class="btn btn-accent btn-sm" data-lockdown="end" data-confirm={dt('End the lockdown and reopen everything?')} data-confirm-tone="neutral" data-failed={dt('It could not be done.')}>{dt('End the lockdown')}</button></div>
          </div>
        ) : (
          <div class="anx-start">
            <div class="sx-field"><label for="an-lock-reason">{dt('Reason (optional)')}</label><textarea id="an-lock-reason" class="dgl-autogrow sx-one" rows="1" data-one-line data-count data-lockdown-reason maxlength="300"></textarea></div>
            <div class="sx-field"><label for="an-lock-min">{dt('Minutes until it ends (0 uses the setting below)')}</label><SxNumber id="an-lock-min" data-lockdown-minutes value={0} min={0} max={10080} /></div>
            <div><button type="button" class="btn btn-accent btn-sm an-danger" data-lockdown="start" data-confirm={dt('Start a lockdown now? The channels will be closed.')} data-failed={dt('It could not be done.')}>{dt('Start a lockdown now')}</button></div>
          </div>
        )}
      </div>
      <div class="sx-panel">
        <div class="sx-panel-head">
          <span class="sx-panel-icon"><Icon name="ph:list-checks-fill" width="17" height="17" /></span>
          <h2>{dt('What it will do now')}</h2>
        </div>
        <div class="anx-facts">
          <div class="sx-row"><span class="anx-k">{dt('Channels closed')}</span><b>{lockdownConfig.channelIds.length ? dt('{n} channel(s)', { n: lockdownConfig.channelIds.length }) : dt('Every text channel')}</b></div>
          <div class="sx-row"><span class="anx-k">{dt('Invites')}</span><b>{lockdownConfig.pauseInvites ? dt('Deleted and blocked') : dt('Left alone')}</b></div>
          <div class="sx-row"><span class="anx-k">{dt('Verification level')}</span><b>{lockdownConfig.raiseVerification ? dt('Raised to High') : dt('Not changed')}</b></div>
          <div class="sx-row"><span class="anx-k">{dt('It ends')}</span><b>{lockdownConfig.autoEndMinutes ? dt('After {a}', { a: formatDuration(lockdownConfig.autoEndMinutes * 60) }) : dt('When you end it')}</b></div>
          <div class="sx-row"><span class="anx-k">{dt('Notice')}</span><b>{lockdownConfig.announceChannelId ? `#${channelName(lockdownConfig.announceChannelId)}` : dt('No notice')}</b></div>
        </div>
      </div>
    </div>
    <form method="POST" class="sx-panel anx-lock-form">
      <input type="hidden" name="action" value="save_lockdown" />
      <div class="sx-panel-head">
        <span class="sx-panel-icon"><Icon name="ph:sliders-fill" width="17" height="17" /></span>
        <h2>{dt('What a lockdown does')}</h2>
      </div>
      <div class="sx-field"><span class="sx-label">{dt('Channels it closes (none chosen means every text channel)')}</span><MultiSelect name="channel_ids" options={channels} selected={lockdownConfig.channelIds} placeholder={dt('Search channels...')} /></div>
      <div class="sx-switches anx-one-col">
        <label class="sx-switch"><input type="checkbox" name="pause_invites" checked={lockdownConfig.pauseInvites} /><span class="sx-switch-text"><b>{dt('Delete the invites and block new ones')}</b></span><span class="sx-toggle"></span></label>
        <label class="sx-switch"><input type="checkbox" name="raise_verification" checked={lockdownConfig.raiseVerification} /><span class="sx-switch-text"><b>{dt('Raise the verification level of the server to High while it lasts')}</b></span><span class="sx-toggle"></span></label>
      </div>
      <div class="sx-grid">
        <div class="sx-field"><label for="an-lock-auto">{dt('Ends by itself after (minutes, 0 for never)')}</label><SxNumber id="an-lock-auto" name="auto_end_minutes" value={lockdownConfig.autoEndMinutes} min={0} max={10080} /></div>
        <div class="sx-field"><label for="an-lock-ann">{dt('Channel for the notice')}</label>
          <select id="an-lock-ann" name="announce_channel_id"><option value="">{dt('No notice')}</option>{channels.map((c) => <option value={c.id} selected={c.id === lockdownConfig.announceChannelId}>#{c.name}</option>)}</select>
        </div>
      </div>
      <div class="sx-field"><label for="an-lock-msg">{dt('The notice')}</label><textarea id="an-lock-msg" name="message" class="dgl-autogrow" rows="2" maxlength="500" data-count placeholder={dt('This server is in lockdown for a moment. The staff is working on it, thank you for waiting.')} data-ac="roles,channels,commands,emojis">{lockdownConfig.message}</textarea><SilentMentionHint /></div>
      <div class="an-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:check-bold" width="13" height="13" />{dt('Save')}</button></div>
    </form>
  </div>
  </Fragment>
  )}
  </div>

  <div class="an-panel" data-an-panel="shared" data-lazy={section !== 'shared' ? '' : undefined} hidden={section !== 'shared'}>
  {section === 'shared' && (
  <Fragment>
  <DashStatTiles tiles={[
    { label: dt('Trusted roles'), value: shared.whitelistRoleIds.length, tone: 'joins' },
    { label: dt('Trusted accounts'), value: sharedAccounts, tone: 'voice' },
    { label: dt('With own list'), value: withOwnTrust, tone: 'invites' },
    { label: dt('Alert channel'), value: 0, text: shared.alertChannelId ? tileChannel(shared.alertChannelId) : dt('Automod log'), tone: 'messages' },
  ]} />
  <form method="POST" class="sx-panel anx-shared-form">
    <input type="hidden" name="action" value="save_shared" />
    <div class="sx-panel-head">
      <span class="sx-panel-icon"><Icon name="ph:shield-check-fill" width="17" height="17" /></span>
      <h2>{dt('Trusted by every protection')}</h2>
    </div>
    <div class="sx-grid">
      <div class="sx-field"><span class="sx-label">{dt('Trusted roles')}</span><MultiSelect name="whitelist_role_ids" options={roles} selected={shared.whitelistRoleIds} placeholder={dt('Search roles...')} /></div>
      <div class="sx-field"><label for="an-sh-ids">{dt('Trusted accounts and bots (IDs)')}</label><textarea id="an-sh-ids" name="whitelist_ids" class="dgl-autogrow" rows="2" placeholder={dt('Paste user IDs, separated by commas')}>{shared.whitelistIds}</textarea></div>
      <div class="sx-field"><label for="an-sh-ch">{dt('Alert channel for every protection')}</label>
        <select id="an-sh-ch" name="alert_channel_id"><option value="">{dt('The automod log')}</option>{channels.map((c) => <option value={c.id} selected={c.id === shared.alertChannelId}>#{c.name}</option>)}</select>
        <p class="sx-hint">{dt('The server owner and Petto are always trusted.')}</p>
      </div>
      {shared.oldSwitch && (
        <div class="anx-old-box sx-wide">
          <input type="hidden" name="old_switch_present" value="1" />
          <label class="sx-switch"><input type="checkbox" name="old_switch" checked /><span class="sx-switch-text"><b>{dt('Old single switch is on')}</b><em>{dt('The protections you have not tuned yet follow this switch (ban, kick, channels, roles, webhooks and emojis, counted together). Turn it off after tuning each one.')}</em></span><span class="sx-toggle"></span></label>
        </div>
      )}
    </div>
    <div class="an-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:check-bold" width="13" height="13" />{dt('Save')}</button></div>
  </form>
  <div class="sx-panel">
    <div class="sx-panel-head">
      <span class="sx-panel-icon"><Icon name="ph:list-checks-fill" width="17" height="17" /></span>
      <h2>{dt('Trust in each protection')}</h2>
    </div>
    <p class="sx-lead">{dt('Every protection trusts the shared list. A protection can also have a list of its own.')}</p>
    <div class="anx-trust anx-trust-2">
      {RULES.map((meta) => {
        const p = protection(meta.id);
        return (
        <div class="anx-trust-row">
          <span class="an-ico anx-mini"><Icon name={meta.icon} width="14" height="14" /></span>
          <span class="anx-trust-name">{names[meta.id].label}</span>
          {ownTrust(p) > 0
            ? <span class="sx-tag sx-tag-accent">{dt('Own list: {n}', { n: ownTrust(p) })}</span>
            : <span class="sx-tag">{dt('Shared list only')}</span>}
        </div>
        );
      })}
    </div>
  </div>
  </Fragment>
  )}
  </div>

  <div class="an-panel" data-an-panel="guard" data-lazy={section !== 'guard' ? '' : undefined} hidden={section !== 'guard'}>
  {section === 'guard' && (
  <Fragment>
  <DashStatTiles tiles={[
    { label: dt('Panic mode'), value: 0, text: guard.panicEnabled ? dt('On') : dt('Off'), tone: guard.panicEnabled ? 'joins' : 'leaves' },
    { label: dt('Starts at'), value: 0, text: dt('{n} in {a}', { n: guard.panicThreshold, a: formatDuration(guard.panicWindow * 60) }), tone: 'voice' },
    { label: dt('Lockdown lasts'), value: 0, text: formatDuration(guard.panicMinutes * 60), tone: 'messages' },
    { label: dt('Owner only'), value: 0, text: guard.ownerOnly ? dt('On') : dt('Off'), tone: 'invites' },
    { label: dt('Trusted admins'), value: guard.adminIds.length, tone: 'reactions' },
  ]} />
  <form method="POST" class="anx-guard">
    <input type="hidden" name="action" value="save_guard" />
    <div class="sx-duo anx-duo">
      <div class="sx-panel">
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style="--c:var(--red, #ff6b6b)"><Icon name="ph:siren-fill" width="17" height="17" /></span>
          <h2>{dt('Panic mode')}</h2>
        </div>
        <p class="sx-lead">{dt('When several protections act in a few minutes, or Anti Raid sees a raid, the server is locked down at once: the channels close and the invites are deleted and paused. It ends by itself after the minutes below, or earlier from the Lockdown tab.')}</p>
        <label class="sx-switch"><input type="checkbox" name="panic_enabled" checked={guard.panicEnabled} /><span class="sx-switch-text"><b>{dt('Turn panic mode on')}</b></span><span class="sx-toggle"></span></label>
        <div class="anx-needs" data-sx-needs="panic_enabled">
          <div class="sx-grid">
            <div class="sx-field"><label for="an-pn-t">{dt('Protections acting that start it')}</label><SxNumber id="an-pn-t" name="panic_threshold" value={guard.panicThreshold} min={1} max={20} /></div>
            <div class="sx-field"><label for="an-pn-w">{dt('Within how many minutes')}</label><SxNumber id="an-pn-w" name="panic_window_minutes" value={guard.panicWindow} min={1} max={120} /></div>
            <div class="sx-field"><label for="an-pn-m">{dt('Lockdown ends by itself after (minutes)')}</label><SxNumber id="an-pn-m" name="panic_lockdown_minutes" value={guard.panicMinutes} min={1} max={1440} /></div>
          </div>
          <label class="sx-switch"><input type="checkbox" name="panic_on_raid" checked={guard.panicOnRaid} /><span class="sx-switch-text"><b>{dt('Also when Anti Raid sees a raid')}</b></span><span class="sx-toggle"></span></label>
        </div>
      </div>
      <div class="sx-panel">
        <div class="sx-panel-head">
          <span class="sx-panel-icon"><Icon name="ph:crown-fill" width="17" height="17" /></span>
          <h2>{dt('Owner')}</h2>
        </div>
        <label class="sx-switch"><input type="checkbox" name="dm_owner" checked={guard.dmOwner} /><span class="sx-switch-text"><b>{dt('Send the owner a DM when a protection acts')}</b></span><span class="sx-toggle"></span></label>
        <label class="sx-switch"><input type="checkbox" name="owner_only" checked={guard.ownerOnly} disabled={!viewerIsOwner} /><span class="sx-switch-text"><b>{dt('Owner only: only the owner and the trusted admins can change the anti-nuke and restore')}</b></span><span class="sx-toggle"></span></label>
        <div class="sx-field"><label for="an-admins">{dt('Trusted admins (IDs): they can change the anti-nuke and the protections never touch them')}</label><textarea id="an-admins" name="admin_ids" class="dgl-autogrow" rows="2" disabled={!viewerIsOwner} placeholder={dt('Paste user IDs, separated by commas')}>{guard.adminIds.join(', ')}</textarea></div>
        {!viewerIsOwner && <p class="sx-hint">{dt('Only the server owner can change owner only and the trusted admins.')}</p>}
        <p class="sx-hint">{dt('The protections never act on the owner, on Petto or on an account whose role is at or above Petto\'s.')}</p>
      </div>
    </div>
    <div class="an-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:check-bold" width="13" height="13" />{dt('Save')}</button></div>
  </form>
  <div class="sx-panel">
    <div class="sx-panel-head">
      <span class="sx-panel-icon"><Icon name="ph:clock-counter-clockwise-fill" width="17" height="17" /></span>
      <h2>{dt('Latest actions')}</h2>
      <span class="anx-count">{dt('{n} in the last {a}', { n: lastWindow, a: formatDuration(guard.panicWindow * 60) })}</span>
    </div>
    {events.length === 0 ? <p class="sx-empty"><Icon name="ph:shield-check-fill" width="18" height="18" />{dt('No protection has acted yet.')}</p> : (
      <div class="anx-trust">
        {events.slice(0, 5).map((e) => (
          <div class="anx-trust-row">
            <span class="an-ico anx-mini"><Icon name={ruleIcon(e.rule)} width="14" height="14" /></span>
            <span class="anx-trust-name"><b>{names[e.rule]?.label ?? e.rule}</b> · {e.executor_name ?? e.executor_id}</span>
            <span class={`sx-tag anx-act-${e.action}`}>{actionNames[e.action] ?? e.action}</span>
            <time class="anx-when" datetime={e.created_at}>{since(e.created_at)}</time>
          </div>
        ))}
      </div>
    )}
  </div>
  </Fragment>
  )}
  </div>

  <div class="an-panel" data-an-panel="log" data-lazy={section !== 'log' ? '' : undefined} hidden={section !== 'log'}>
  {section === 'log' && (
  <Fragment>
  <DashStatTiles tiles={[
    { label: dt('Actions shown'), value: events.length, tone: 'messages' },
    { label: dt('Restored'), value: restored, tone: 'joins' },
    { label: dt('Can be restored'), value: canRestore, tone: 'invites' },
    { label: dt('Last action'), value: 0, text: events.length ? since(events[0].created_at) : dt('None'), tone: 'voice' },
  ]} />
  {events.length === 0 ? (
    <div class="anx-empty">
      <Icon name="ph:shield-check-fill" width="28" height="28" />
      <b>{dt('No protection has acted yet.')}</b>
      <p>{dt('When a protection acts, it shows up here, and you can put back what it stopped.')}</p>
    </div>
  ) : (
  <div class="anx-split">
    <div class="sx-panel">
      <div class="sx-panel-head">
        <span class="sx-panel-icon"><Icon name="ph:clock-counter-clockwise-fill" width="17" height="17" /></span>
        <h2>{dt('What the protections did')}</h2>
      </div>
      <div class="anx-events dgl-stagger">
        {events.map((e) => (
          <div class="anx-event">
            <span class="an-ico"><Icon name={ruleIcon(e.rule)} width="16" height="16" /></span>
            <div class="anx-event-main">
              <b>#{e.id} · {names[e.rule]?.label ?? e.rule}</b>
              <span>{e.executor_name ?? e.executor_id} <code>{e.executor_id}</code> · {e.action_count}× {e.detail ?? ''}</span>
              <em>{ago(e.created_at)}</em>
            </div>
            <div class="anx-event-side">
              <span class={`sx-tag anx-act-${e.action}`}>{actionNames[e.action] ?? e.action}</span>
              {e.restored_at ? <span class="sx-pill-state on">{dt('Restored')}</span> : (e.restorable.length > 0 || e.previous_roles.length > 0) ? (
                <button type="button" class="btn btn-ghost btn-sm" data-an-restore={e.id} data-confirm={dt('Put back what this protection stopped?')} data-confirm-tone="neutral" data-done={dt('Done.')} data-failed={dt('It could not be restored.')}><Icon name="ph:arrow-counter-clockwise-bold" width="13" height="13" />{dt('Restore')}</button>
              ) : null}
            </div>
          </div>
        ))}
      </div>
      <p class="sx-hint">{dt('Restore rebuilds deleted channels and roles (not their messages), lifts mass bans and gives the roles back. The owner, the trusted admins and (unless owner only is on) the administrators can do it.')}</p>
    </div>
    <div class="sx-stack">
      <div class="sx-panel">
        <div class="sx-panel-head">
          <span class="sx-panel-icon"><Icon name="ph:chart-bar-fill" width="17" height="17" /></span>
          <h2>{dt('By protection')}</h2>
        </div>
        <div class="anx-bars">
          {byRule.map(([rule, n], i) => (
            <div class="anx-bar" style={`--i:${i}`}>
              <span class="anx-bar-name">{names[rule]?.label ?? rule}</span>
              <span class="anx-track"><i style={`width:${Math.round((n / byRule[0][1]) * 100)}%`}></i></span>
              <b>{n}</b>
            </div>
          ))}
        </div>
      </div>
      <div class="sx-panel">
        <div class="sx-panel-head">
          <span class="sx-panel-icon"><Icon name="ph:users-three-fill" width="17" height="17" /></span>
          <h2>{dt('Who set them off')}</h2>
        </div>
        <div class="anx-bars">
          {byPerson.map((who, i) => (
            <div class="anx-bar" style={`--i:${i}`}>
              <span class="anx-bar-name">{who.name}</span>
              <span class="anx-track"><i style={`width:${Math.round((who.n / byPerson[0].n) * 100)}%`}></i></span>
              <b>{who.n}</b>
            </div>
          ))}
        </div>
        <p class="sx-hint">{dt('Counted over the actions shown.')}</p>
      </div>
    </div>
  </div>
  )}
  </Fragment>
  )}
  </div>
  </div>
</DashGuildLayout>

<script is:inline>
  // The rows open and close by themselves; the switch of a row saves it right away.
  // What a button did, in the toast of the dashboard (a plain alert without it).
  var anSay = function (text, ok, ms) { if (window.dglToast) window.dglToast(text, { kind: ok ? 'ok' : 'error', ms: ms }); };
  if (!window.__anBound) {
    window.__anBound = true;
    document.addEventListener('click', function (event) {
      var tab = event.target.closest && event.target.closest('[data-an-tab]');
      if (tab) {
        // The tabs change what is shown without loading the page again, so the menu on the side keeps its place and its animation.
        event.preventDefault();
        var wanted = tab.getAttribute('data-an-tab');
        document.querySelectorAll('[data-an-tab]').forEach(function (t) { t.classList.toggle('on', t === tab); });
        document.querySelectorAll('[data-an-panel]').forEach(function (panel) { panel.hidden = panel.getAttribute('data-an-panel') !== wanted; });
        try { history.replaceState(history.state, '', '?section=' + wanted); } catch (e) {}
        // A tab that was not read with the page is read now, only that part: the page itself is not loaded again.
        var panelEl = document.querySelector('[data-an-panel="' + wanted + '"]');
        if (panelEl && panelEl.hasAttribute('data-lazy') && !panelEl.hasAttribute('data-loading')) {
          panelEl.setAttribute('data-loading', '');
          // The panel is empty until it is read: it waits with grey blocks (shared placeholder) and is uncovered from the top down.
          var waiting = window.dglLoad ? window.dglLoad.wait(panelEl, { shape: 'rows', count: 8, delay: 0, min: 300 }) : null;
          if (!waiting) panelEl.classList.add('an-panel-loading');
          fetch('?section=' + wanted, { method: 'GET' })
            .then(function (r) { return r.text(); })
            .then(function (html) {
              var doc = new DOMParser().parseFromString(html, 'text/html');
              var fresh = doc.querySelector('[data-an-panel="' + wanted + '"]');
              if (!fresh) throw new Error('missing');
              var draw = function () {
                panelEl.innerHTML = fresh.innerHTML;
                panelEl.removeAttribute('data-lazy');
                panelEl.removeAttribute('data-loading');
                panelEl.classList.remove('an-panel-loading');
                panelEl.hidden = !document.querySelector('[data-an-tab="' + wanted + '"].on');
                if (window.dglInitContent) window.dglInitContent(panelEl);
              };
              if (waiting) waiting.done(draw); else draw();
            })
            .catch(function () { if (waiting) waiting.cancel(); location.href = '?section=' + wanted; });
        }
        return;
      }
      var open = event.target.closest && event.target.closest('[data-an-open]');
      var close = event.target.closest && event.target.closest('[data-an-close]');
      var restore = event.target.closest && event.target.closest('[data-an-restore]');
      var lock = event.target.closest && event.target.closest('[data-lockdown]');
      if (lock) {
        var guildId = location.pathname.replace(/^\/(es|pt-br)(?=\/)/i, '').split('/')[3];
        var starting = lock.getAttribute('data-lockdown') === 'start';
        // The question was asked by the button itself (data-confirm, DashConfirm.astro).
        var lockFailed = lock.getAttribute('data-failed') || 'It could not be done.';
        var reasonEl = document.querySelector('[data-lockdown-reason]');
        var minutesEl = document.querySelector('[data-lockdown-minutes]');
        lock.disabled = true;
        fetch('/dash/guild/' + guildId + '/lockdown-api', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ op: starting ? 'start' : 'end', reason: reasonEl ? reasonEl.value : '', minutes: minutesEl ? Number(minutesEl.value) : 0 }) })
          .then(function (r) { return r.json(); })
          .then(function (data) { if (data && data.ok) location.reload(); else { anSay((data && data.message) || lockFailed, false); lock.disabled = false; } })
          .catch(function () { anSay(lockFailed, false); lock.disabled = false; });
        return;
      }

      if (open || close) {
        var row = (open || close).closest('[data-an-row]');
        var body = row.querySelector('.an-body');
        var show = open ? body.hidden : false;
        body.hidden = !show;
        row.classList.toggle('open', show);
        var btn = row.querySelector('[data-an-open]');
        if (btn) btn.setAttribute('aria-expanded', show ? 'true' : 'false');
      }
      if (restore) {
        var restoreFailed = restore.getAttribute('data-failed') || 'It could not be restored.';
        var guild = location.pathname.replace(/^\/(es|pt-br)(?=\/)/i, '').split('/')[3];
        restore.disabled = true;
        fetch('/dash/guild/' + guild + '/antinuke-api', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: Number(restore.getAttribute('data-an-restore')) }) })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            var lines = [].concat(data.done || [], data.failed || []);
            anSay(data.ok ? (lines.join(' · ') || restore.getAttribute('data-done') || 'Done.') : (data.message || lines.join(' · ') || restoreFailed), data.ok, 9000);
            // Read again in place, so the toast with what was put back stays on screen.
            if (data.ok) { if (window.dglRefreshPage) window.dglRefreshPage(true); else location.reload(); } else restore.disabled = false;
          })
          .catch(function () { anSay(restoreFailed, false); restore.disabled = false; });
      }
    });
    // The switch of a protection saves by itself, in the background, and the page stays as it is (nothing is read again or redrawn, no "unsaved changes" bar):
    // the switch has already moved, a small ring turns on its knob while it is saved, and it goes back with a toast only if the save fails.
    // A fast hand on many switches never sends a save twice at once for the same protection (each form is saved one change after the other), and never more
    // than three at a time in all, each one with the form as it is when its turn comes.
    var anTails = new WeakMap(); var anActive = 0; var anWaiting = [];
    var anPump = function () {
      while (anActive < 3 && anWaiting.length) {
        var job = anWaiting.shift(); anActive += 1;
        job().then(function () { anActive -= 1; anPump(); });
      }
    };
    var anRun = function (form, job) {
      var next = (anTails.get(form) || Promise.resolve()).then(function () { return new Promise(function (resolve) { anWaiting.push(function () { return job().then(resolve, resolve); }); anPump(); }); });
      anTails.set(form, next);
      return next;
    };
    var anWords = function () { var box = document.querySelector('[data-an-words]'); return { saved: (box && box.getAttribute('data-saved')) || 'Saved.', failed: (box && box.getAttribute('data-failed')) || 'It could not be saved, try again.' }; };
    var anRecount = function () {
      var count = document.querySelector('.an-count');
      if (!count) return;
      var on = document.querySelectorAll('[data-an-row] input[name="enabled"][data-an-auto]:checked').length;
      count.textContent = count.textContent.replace(/\d+/, String(on));
    };
    document.addEventListener('change', function (event) {
      var input = event.target.closest && event.target.closest('[data-an-auto]');
      if (!input || !input.form) return;
      var form = input.form; var want = input.checked; var wrap = input.closest('.sx-switch'); var words = anWords();
      if (wrap) { wrap.setAttribute('data-anx-pending', String((Number(wrap.getAttribute('data-anx-pending')) || 0) + 1)); wrap.setAttribute('data-anx-busy', '1'); }
      anRecount();
      anRun(form, function () {
        return fetch(location.pathname + location.search, { method: 'POST', credentials: 'same-origin', headers: { 'X-Dash-Partial': '1' }, body: new FormData(form) })
          .then(function (res) {
            if (!res.ok) throw new Error(words.failed);
            return res.text();
          })
          .then(function (html) {
            // A refusal comes back as the page with a red line (the same sign the page uses for it).
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var bad = doc.querySelector('#dgl-content .sx-flash-bad');
            if (!doc.querySelector('#dgl-content') || bad) throw new Error((bad && bad.textContent.trim()) || words.failed);
          })
          .then(function () { if (window.dglToast) window.dglToast(words.saved, { kind: 'ok', ms: 1400 }); })
          .catch(function (error) {
            input.checked = !want;
            anRecount();
            anSay(error && error.message ? error.message : words.failed, false);
          })
          .then(function () {
            if (!wrap) return;
            var left = (Number(wrap.getAttribute('data-anx-pending')) || 1) - 1;
            wrap.setAttribute('data-anx-pending', String(left));
            if (left <= 0) wrap.removeAttribute('data-anx-busy');
          });
      });
    });
  }
</script>
<style>
  .anx-page { display: flex; flex-direction: column; max-width: 1100px; }
  h1 { font-size: 24px; margin: 0 0 18px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .an-count { font-size: 12px; font-weight: 600; color: var(--text-dim); border: 1px solid var(--border); border-radius: 999px; padding: 3px 10px; }
  .an-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--border); margin-bottom: 16px; overflow-x: auto; }
  .an-tab { padding: 9px 14px; font-size: 13.5px; font-weight: 600; color: var(--text-dim); border-bottom: 2px solid transparent; white-space: nowrap; text-decoration: none; transition: color var(--m-fast) ease; }
  .an-tab:hover { color: var(--text); }
  .an-tab.on { color: var(--accent); border-color: var(--accent); }
  .an-tab:focus-visible { outline-offset: -2px; border-radius: 8px 8px 0 0; }
  .an-panel[hidden] { display: none; }
  .an-panel:not([hidden]) { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .an-panel-loading { min-height: 220px; border: 1px solid var(--border); border-radius: 14px; background: linear-gradient(100deg, color-mix(in srgb, var(--text) 5%, var(--card)) 30%, color-mix(in srgb, var(--text) 10%, var(--card)) 50%, color-mix(in srgb, var(--text) 5%, var(--card)) 70%); background-size: 200% 100%; animation: pettoShimmer 1.4s ease-in-out infinite; }
  .an-panel > :global(.stt) { margin-bottom: 0; }

  /* Protections: five short lists. Each protection is a card with its switch; it opens in place. */
  .anx-group { display: flex; flex-direction: column; gap: 10px; }
  .anx-head h2 { margin: 0; font-size: 15.5px; display: flex; align-items: center; gap: 10px; }
  .anx-head p { margin: 3px 0 0; font-size: 12.5px; line-height: 1.45; color: var(--text-dim); }
  .anx-count { font: 600 11.5px var(--sans); color: var(--text-dim); background: color-mix(in srgb, var(--text) 7%, transparent); border-radius: 999px; padding: 2px 9px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .an-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); gap: 12px; align-items: start; }
  .an-row { border: 1px solid var(--border); border-radius: 14px; background: var(--card); min-width: 0; transition: border-color var(--m-base) ease; }
  .an-row:has(.anx-sw input:checked) { border-color: color-mix(in srgb, var(--green) 35%, var(--border)); }
