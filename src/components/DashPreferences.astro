---
// Preferences (/dash/preferences): the choices that belong to the person, not to a server. The language of the dashboard (the same cookie the
// site menu sets), the theme (the same browser setting the top bar toggle uses), and what Petto keeps for the account: the personal prefix
// and the reputation, read-only here because the prefix is set in Discord (/myprefix).
import { Icon } from 'astro-icon/components';
import DashMeLayout from './DashMeLayout.astro';
import { dashLocale, getDashLang, makeT } from '../i18n/dash';
import type { Session } from '../utils/session';

interface Props { user: Session; prefix: string | null; reputation: { points: number; servers: number } | null; historyOff: boolean; contactEmail?: string | null; contactMessage?: { ok: boolean; text: string } | null }
const { user, prefix, reputation, historyOff, contactEmail = null, contactMessage = null } = Astro.props;
const lang = getDashLang(Astro);
const dt = makeT(lang);
const locale = dashLocale(lang);
const langs = [
  { code: 'en', label: 'English', flag: '/assets/flags/us.svg' },
  { code: 'es', label: 'Español', flag: '/assets/flags/es.svg' },
  { code: 'pt-BR', label: 'Português (Brasil)', flag: '/assets/flags/br.svg' },
];
const themes = [
  { id: 'dark', icon: 'ph:moon-fill', label: dt('Dark') },
  { id: 'light', icon: 'ph:sun-fill', label: dt('Light') },
  { id: 'system', icon: 'ph:desktop-fill', label: dt('Same as my device') },
];
---
<DashMeLayout user={user} active="preferences" pageTitle="Preferences">
  <header class="ac-head">
    <h1>{dt('Preferences')}</h1>
    <p>{dt('Your own choices for the dashboard. They follow you, not a server.')}</p>
  </header>

  <div class="ac-grid">
    <section class="ac-card ac-wide">
      <div class="ac-card-head"><h2><Icon name="ph:translate-fill" width="16" height="16" />{dt('Dashboard language')}</h2></div>
      <p class="ac-lead">{dt('It is saved in this browser and also changes the language of the dashboard menus and messages.')}</p>
      <div class="pf-langs" role="group" aria-label={dt('Dashboard language')}>
        {langs.map((l) => (
          <a class:list={['pf-opt', { on: l.code === lang }]} href={`/dash/lang?to=${encodeURIComponent(l.code)}&next=${encodeURIComponent('/dash/preferences')}`} lang={l.code} aria-current={l.code === lang ? 'true' : undefined}>
            <img src={l.flag} alt="" width="26" height="18" />
            <span>{l.label}</span>
            {l.code === lang && <Icon name="ph:check-circle-fill" width="17" height="17" class="pf-check" />}
          </a>
        ))}
      </div>
    </section>

    <section class="ac-card">
      <div class="ac-card-head"><h2><Icon name="ph:palette-fill" width="16" height="16" />{dt('Theme')}</h2></div>
      <p class="ac-lead">{dt('Dark, light, or the same as your device. The top bar toggle changes the same setting.')}</p>
      <div class="pf-themes" role="group" aria-label={dt('Theme')} data-pf-themes>
        {themes.map((th) => (
          <button type="button" class="pf-opt pf-theme" data-theme-pick={th.id} aria-pressed="false">
            <Icon name={th.icon} width="18" height="18" />
            <span>{th.label}</span>
          </button>
        ))}
      </div>
    </section>

    <section class="ac-card">
      <div class="ac-card-head"><h2><Icon name="ph:user-circle-fill" width="16" height="16" />{dt('Your Petto profile')}</h2></div>
      <dl class="ac-rows">
        <div><dt>{dt('Personal prefix')}</dt><dd>{prefix ? <code class="ac-code">{prefix}</code> : <span class="pf-dim">{dt('Not set')}</span>}</dd></div>
        <div><dt>{dt('Reputation')}</dt><dd>{reputation ? reputation.points.toLocaleString(locale) : <span class="pf-dim">{dt('None yet')}</span>}{reputation && <small>{reputation.servers === 1 ? dt('In 1 server') : dt('In {a} servers', { a: reputation.servers })}</small>}</dd></div>
      </dl>
      <p class="ac-muted pf-hint"><Icon name="ph:info-fill" width="14" height="14" /><span>{prefix ? dt('Change or remove your prefix in Discord with /myprefix.') : dt('Set your own prefix in Discord with /myprefix.')}</span></p>
    </section>

    <section class="ac-card">
      <div class="ac-card-head"><h2><Icon name="ph:clock-counter-clockwise" width="16" height="16" />{dt('Name history')}</h2><span class:list={['ac-pill', { 'is-active': !historyOff }]}>{historyOff ? dt('Not saving') : dt('Saving')}</span></div>
      <p class="ac-lead">{historyOff ? dt('Petto does not save your names, and nobody else can see your history.') : dt('Petto saves the names you use, and you can see them on the History page.')}</p>
      <div class="ac-btns"><a class="btn btn-ghost btn-sm" href="/dash/history" data-sk="list"><Icon name="ph:clock-counter-clockwise" width="13" height="13" />{dt('Open history')}</a></div>
    </section>

    <section class="ac-card">
      <div class="ac-card-head"><h2><Icon name="ph:envelope-simple-fill" width="16" height="16" />{dt('Contact email')}</h2><span class:list={['ac-pill', { 'is-active': Boolean(contactEmail) }]}>{contactEmail ? dt('Saved') : dt('Not set')}</span></div>
      <p class="ac-lead">{dt('Optional. Petto may write to it about the policies and about what you asked to delete. Nobody else sees it, and you can delete it here at any time.')}</p>
      {contactMessage && <p class:list={['pf-msg', { 'is-bad': !contactMessage.ok }]} role="status">{contactMessage.text}</p>}
      <form method="POST" class="pf-contact">
        <input type="hidden" name="action" value="contact_save" />
        <input type="email" name="email" value={contactEmail ?? ''} placeholder="you@example.com" maxlength="254" autocomplete="email" required aria-label={dt('Contact email')} />
        <button type="submit" class="btn btn-sm pf-save">{dt('Save')}</button>
      </form>
      {user.discordEmail && user.discordEmail !== contactEmail && (
        <form method="POST" class="pf-contact-discord"><input type="hidden" name="action" value="contact_discord" /><button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:discord-logo-fill" width="13" height="13" />{dt('Use the email of my Discord account')}</button><span class="pf-hint">{user.discordEmail}</span></form>
      )}
      {contactEmail && <form method="POST" class="pf-contact-remove"><input type="hidden" name="action" value="contact_remove" /><button type="submit" class="btn btn-ghost btn-sm" data-confirm={dt('Delete your contact email?')}>{dt('Delete my email')}</button></form>}
    </section>

    <section class="ac-card">
      <div class="ac-card-head"><h2><Icon name="ph:browser-fill" width="16" height="16" />{dt('This browser')}</h2></div>
      <p class="ac-lead">{dt('Your theme and how you sort your servers are kept only in this browser. You can forget them here.')}</p>
      <div class="ac-btns"><button type="button" class="btn btn-ghost btn-sm" data-pf-reset data-done={dt('Forgotten')}><Icon name="ph:arrow-counter-clockwise-bold" width="13" height="13" /><span>{dt('Forget saved choices')}</span></button></div>
    </section>
  </div>
</DashMeLayout>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var box = document.querySelector('[data-pf-themes]');
    if (!box) return;
    var buttons = Array.prototype.slice.call(box.querySelectorAll('[data-theme-pick]'));
    function stored() { try { return localStorage.getItem('petto-theme'); } catch (e) { return null; } }
    function mark() {
      var s = stored();
      var now = s === 'dark' || s === 'light' ? s : 'system';
      buttons.forEach(function (b) {
        var on = b.getAttribute('data-theme-pick') === now;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      });
    }
    buttons.forEach(function (b) {
      b.addEventListener('click', function () {
        var pick = b.getAttribute('data-theme-pick');
        try { if (pick === 'system') localStorage.removeItem('petto-theme'); else localStorage.setItem('petto-theme', pick); } catch (e) {}
        if (pick === 'system') root.removeAttribute('data-theme'); else root.setAttribute('data-theme', pick);
        mark();
      });
    });
    var reset = document.querySelector('[data-pf-reset]');
    if (reset) reset.addEventListener('click', function () {
      try { localStorage.removeItem('petto-theme'); localStorage.removeItem('petto-dash-server-sort'); } catch (e) {}
      root.removeAttribute('data-theme');
      mark();
      var label = reset.querySelector('span');
      if (label) label.textContent = reset.getAttribute('data-done');
      reset.disabled = true;
    });
    // The top bar toggle changes the same setting: keep the buttons in step with it.
    new MutationObserver(mark).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
    mark();
  })();
</script>

<style>
  .pf-langs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .pf-themes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .pf-contact { display: flex; gap: 10px; flex-wrap: wrap; } .pf-contact input { flex: 1 1 220px; min-width: 0; border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; background: var(--card); color: var(--text); font: inherit; font-size: 14px; }
  .pf-save { background: var(--green); color: var(--green-ink); border-color: transparent; }
  .pf-contact-remove { margin-top: 8px; }
  .pf-contact-discord { margin-top: 8px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; } .pf-hint { color: var(--text-muted); font-size: 13px; word-break: break-all; }
  .pf-msg { margin: 0 0 10px; padding: 10px 12px; border-radius: 10px; background: var(--green-soft); color: var(--green-text); font-size: 14px; } .pf-msg.is-bad { background: var(--red-soft); color: var(--red-text); }
  .pf-opt { position: relative; display: flex; align-items: center; gap: 10px; min-width: 0; padding: 12px 14px; border: 1px solid var(--border-soft); border-radius: 13px; background: color-mix(in srgb, var(--text) 3%, transparent); color: var(--text-muted); font: inherit; font-size: 14px; font-weight: 600; text-decoration: none; cursor: pointer; touch-action: manipulation; transition: background-color var(--m-fast) ease, border-color var(--m-fast) ease, color var(--m-fast) ease, transform var(--m-instant) ease; }
  .pf-opt span { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: left; }
  .pf-opt img { flex: none; border-radius: 3px; }
  .pf-opt:hover { background: var(--card-hover); color: var(--text); border-color: var(--border); }
  .pf-opt:active { transform: scale(.98); }
  .pf-opt:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .pf-opt.on { color: var(--green); background: var(--green-soft); border-color: color-mix(in srgb, var(--green) 45%, var(--border)); }
  .pf-opt :global(.pf-check) { flex: none; color: var(--accent); }
  .pf-theme { flex-direction: column; justify-content: center; gap: 6px; padding: 14px 8px; text-align: center; }
  .pf-theme span { flex: none; max-width: 100%; text-align: center; font-size: 12.5px; white-space: normal; line-height: 1.25; }
  .pf-dim { color: var(--text-dim); font-weight: 400; }
  .pf-hint { display: flex; gap: 8px; align-items: flex-start; margin-top: auto; padding-top: 14px; font-size: 13px; }
  .pf-hint :global(svg) { flex: none; margin-top: 2px; color: var(--text-dim); }
  @media (max-width: 720px) { .pf-langs { grid-template-columns: minmax(0, 1fr); } }
</style>
