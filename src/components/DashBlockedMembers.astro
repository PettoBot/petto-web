---
// The members blocked from a module (suggestions, confessions), with Unblock, and a box to block one more. The forms post to the page
// they are on, which handles `block_member` and `unblock_member` (utils/memberBlocks.ts).
import { Icon } from 'astro-icon/components';
import DashMemberPick from './DashMemberPick.astro';
import { getDashLang, makeT } from '../i18n/dash';
import type { BlockedMember } from '../utils/memberBlocks';

interface Props { guildId: string; title: string; text: string; empty: string; blocked: BlockedMember[]; result?: 'blocked' | 'unblocked' | 'failed' | null; disabled?: boolean }
const { guildId, title, text, empty, blocked, result = null, disabled = false } = Astro.props;
const dt = makeT(getDashLang(Astro));
const messages: Record<string, string> = {
  blocked: dt('The member is blocked.'),
  unblocked: dt('The member can use it again.'),
  failed: dt('It could not be saved. Try again in a moment.'),
};
---
<section class="bm" id="blocked">
  <div class="bm-head">
    <h2><Icon name="ph:prohibit-fill" width="15" height="15" />{title} <span class="bm-count">{blocked.length}</span></h2>
    <p>{text}</p>
  </div>
  {result && <div class:list={['bm-flash', { 'bm-flash-err': result === 'failed' }]} role={result === 'failed' ? 'alert' : 'status'}>{messages[result]}</div>}
  {blocked.length ? (
    <ul class="bm-list">
      {blocked.map((member) => (
        <li>
          <img src={member.avatar} alt="" width="26" height="26" loading="lazy" />
          <span class="bm-who"><b>{member.name ?? member.id}</b><small>{member.byName || member.by ? dt('Blocked by {a}', { a: member.byName ?? member.by }) : ''}{member.at ? <> · <time datetime={member.at} data-bm-time>{member.at.slice(0, 10)}</time></> : null}</small></span>
          <form method="POST" data-no-dirty>
            <input type="hidden" name="member_id" value={member.id} />
            <button type="submit" name="action" value="unblock_member" class="btn btn-ghost btn-sm" disabled={disabled}>{dt('Unblock')}</button>
          </form>
        </li>
      ))}
    </ul>
  ) : <p class="bm-empty">{empty}</p>}
  <form method="POST" class="bm-add" data-no-dirty>
    <div class="bm-pick"><DashMemberPick guildId={guildId} name="member_id" placeholder={dt('Type a name to block someone')} /></div>
    <button type="submit" name="action" value="block_member" class="btn btn-ghost btn-sm" disabled={disabled}><Icon name="ph:prohibit-fill" width="12" height="12" />{dt('Block')}</button>
  </form>
  <script is:inline>
    document.querySelectorAll('time[data-bm-time]').forEach(function (t) { var d = new Date(t.getAttribute('datetime')); if (!isNaN(d.getTime())) t.textContent = d.toLocaleDateString(); });
  </script>
</section>

<style>
  .bm { margin-top: 26px; max-width: 760px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 16px 18px; display: flex; flex-direction: column; gap: 12px; }
  .bm-head h2 { display: flex; align-items: center; gap: 7px; font-size: 15px; margin: 0 0 4px; }
  .bm-head h2 :global(svg) { color: var(--red, #fe6465); }
  .bm-head p { margin: 0; font-size: 12.5px; color: var(--text-muted); max-width: 70ch; }
  .bm-count { font-family: var(--mono); font-size: 11.5px; color: var(--text-dim); border: 1px solid var(--border); border-radius: 999px; padding: 1px 7px; }
  .bm-flash { font-size: 13px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 8px 12px; }
  .bm-flash-err { color: var(--red, #fe6465); background: color-mix(in srgb, var(--red, #fe6465) 12%, transparent); border-color: var(--red, #fe6465); }
  .bm-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .bm-list li { display: grid; grid-template-columns: 26px minmax(0, 1fr) auto; align-items: center; gap: 10px; padding: 8px 0; border-top: 1px solid var(--border); }
  .bm-list li:first-child { border-top: 0; }
  .bm-list img { border-radius: 50%; }
  .bm-list form { margin: 0; }
  .bm-who { display: flex; flex-direction: column; min-width: 0; }
  .bm-who b { font-size: 13px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bm-who small { font-size: 11.5px; color: var(--text-dim); }
  .bm-empty { margin: 0; font-size: 12.5px; color: var(--text-dim); padding: 10px 12px; border: 1px dashed var(--border); border-radius: 10px; }
  .bm-add { display: flex; flex-wrap: wrap; gap: 8px; align-items: flex-start; margin: 0; }
  .bm-pick { flex: 1 1 240px; min-width: 0; }
</style>
