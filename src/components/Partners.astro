---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import type { Locale } from '../i18n/ui';
import { getPartners, PARTNER_KINDS, type PartnerRow } from '../utils/partners';
import PartnerIcon from './PartnerIcon.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const copy = {
  en: {
    eyebrow: 'Partners',
    title: 'The partners of Petto.',
    lede: 'The providers that keep Petto and its data running, and the communities that work with us.',
    notice: 'This list is provisional. Partners may still be awaiting confirmation or may have been discontinued, so this page may not always be up to date. To add or remove a partner, send us a ticket in the Petto support Discord.',
    noticeTitle: 'Partner information may change',
    primary: 'Primary partner',
    partner: 'Partner',
    omniplexDesc: 'A place to discover Discord bots and servers: explore thousands of them, vote and leave reviews. Petto is a partner of Omniplex. They are not a hosting provider, ours is Discloud.',
    visitOmniplex: 'Visit Omniplex',
    discloudDesc: 'Petto\'s primary hosting provider, PostgreSQL database provider, and infrastructure partner for the bot.',
    visit: 'Visit Discloud',
    support: 'Open a support ticket',
  },
  es: {
    eyebrow: 'Partners',
    title: 'Los partners de Petto.',
    lede: 'Los proveedores que mantienen funcionando a Petto y sus datos, y las comunidades que trabajan con nosotros.',
    notice: 'Esta lista es provisional. Algunos partners pueden estar pendientes de confirmación o haber sido descontinuados, por lo que la página podría no estar siempre actualizada. Si quieres añadir o eliminar un partner, envíanos un ticket en el Discord de soporte de Petto.',
    noticeTitle: 'La información de los partners puede cambiar',
    primary: 'Partner principal',
    partner: 'Partner',
    omniplexDesc: 'Un lugar para descubrir bots y servidores de Discord: explora miles, vota y deja reseñas. Petto es partner de Omniplex. No son un proveedor de hosting, el nuestro es Discloud.',
    visitOmniplex: 'Visitar Omniplex',
    discloudDesc: 'Proveedor principal de hosting, base de datos PostgreSQL e infraestructura para el bot de Petto.',
    visit: 'Visitar Discloud',
    support: 'Abrir un ticket de soporte',
  },
  'pt-BR': {
    eyebrow: 'Partners',
    title: 'Os parceiros do Petto.',
    lede: 'Os provedores que mantêm o Petto e seus dados funcionando, e as comunidades que trabalham com a gente.',
    notice: 'Esta lista é provisória. Alguns partners podem estar aguardando confirmação ou ter sido descontinuados, então a página pode não estar sempre atualizada. Se quiser adicionar ou remover um partner, envie um ticket no Discord de suporte do Petto.',
    noticeTitle: 'As informações dos partners podem mudar',
    primary: 'Partner principal',
    partner: 'Partner',
    omniplexDesc: 'Um lugar para descobrir bots e servidores do Discord: explore milhares, vote e deixe avaliações. O Petto é parceiro da Omniplex. Eles não são um provedor de hospedagem, o nosso é a Discloud.',
    visitOmniplex: 'Visitar a Omniplex',
    discloudDesc: 'Provedor principal de hospedagem, banco de dados PostgreSQL e infraestrutura do bot do Petto.',
    visit: 'Visitar a Discloud',
    support: 'Abrir um ticket de suporte',
  },
} as const;

const extra = {
  en: { copyLink: 'Copy link', copied: 'Link copied', visitPartner: (name: string) => `Visit ${name}`, kinds: { hosting: 'Hosting', servers: 'Servers', apps: 'Apps', bots: 'Bots', communities: 'Communities', other: 'Other' } },
  es: { copyLink: 'Copiar enlace', copied: 'Enlace copiado', visitPartner: (name: string) => `Visitar ${name}`, kinds: { hosting: 'Hosting', servers: 'Servidores', apps: 'Apps', bots: 'Bots', communities: 'Comunidades', other: 'Otros' } },
  'pt-BR': { copyLink: 'Copiar link', copied: 'Link copiado', visitPartner: (name: string) => `Visitar ${name}`, kinds: { hosting: 'Hospedagem', servers: 'Servidores', apps: 'Apps', bots: 'Bots', communities: 'Comunidades', other: 'Outros' } },
} as const;

const t = { ...copy[lang], ...extra[lang] };

// The partners come from the table the team edits in the dashboard (or the original list), grouped by type.
const { partners } = await getPartners(Astro);
const groups = PARTNER_KINDS.map((kind) => ({ kind, items: partners.filter((partner) => partner.kind === kind) })).filter((group) => group.items.length > 0);
// The link to one partner: /partners?p=<slug> so Discord and social crawlers read it, while still supporting legacy #part_<type>:<slug> anchors.
const partnerSlug = (partner: PartnerRow) => partner.name.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const partnerAnchor = (partner: PartnerRow) => `part_${partner.kind}:${partnerSlug(partner)}`;
const descriptionOf = (partner: PartnerRow) => (lang === 'es' ? partner.description_es : lang === 'pt-BR' ? partner.description_pt : partner.description_en) || partner.description_en;

const wantedPartner = (Astro.url.searchParams.get('p') ?? '').trim().toLowerCase();
const selectedPartner = wantedPartner
  ? partners.find((p) => partnerSlug(p) === wantedPartner || partnerAnchor(p) === wantedPartner) ?? null
  : null;
---

<Base
  title={selectedPartner ? `${selectedPartner.name} · ${t.eyebrow} · Petto` : `${t.eyebrow} · Petto`}
  description={selectedPartner ? descriptionOf(selectedPartner) : undefined}
  ogTitle={selectedPartner ? `${selectedPartner.name} · ${t.eyebrow} · Petto` : undefined}
  ogImage={selectedPartner ? `/api/og/partner?p=${encodeURIComponent(partnerSlug(selectedPartner))}&lang=${lang}` : undefined}
  ogImageAlt={selectedPartner ? selectedPartner.name : undefined}
  lang={lang}
  preloadImages={['/assets/hero-art-4.webp']}
>
  <main>
    <section class="pa-hero vx-sub-hero pa-hero-tall">
      <div class="vx-sub-bg" aria-hidden="true" style="background-image:url('/assets/hero-art-4.webp');background-size:cover;background-position:center 26%;">
        <img src="/assets/hero-art-4.webp" alt="" loading="eager" decoding="sync" fetchpriority="high" draggable="false" />
        <div class="vx-sub-fade"></div>
      </div>
      <div class="wrap pa-hero-inner">
        <div class="eyebrow reveal">{t.eyebrow}</div>
        <h1 class="reveal">{t.title}</h1>
        <p class="pa-lede reveal">{t.lede}</p>
      </div>
    </section>

    <section class="pa-content">
      <div class="wrap">
        <div class="pa-notice reveal" role="note">
          <Icon name="ph:info-fill" width="19" height="19" />
          <div>
            <strong>{t.noticeTitle}</strong>
            <p>{t.notice}</p>
          </div>
        </div>

        <div class="pa-groups">
        {groups.map((group) => (
          <div class="pa-group reveal">
            {groups.length > 1 && <h2 class="pa-kind">{t.kinds[group.kind]}</h2>}
            <div class="pa-grid">
              {group.items.map((partner) => (
                <article class="pa-card" id={partnerAnchor(partner)}>
                  <div class="pa-card-top">
                    <PartnerIcon partner={partner} prefix="pa" label />
                    <span class="pa-status">{partner.is_primary ? t.primary : t.partner}</span>
                  </div>
                  <h2>{partner.name}</h2>
                  <p>{descriptionOf(partner)}</p>
                  <div class="pa-actions">
                    <a class="pa-link" href={partner.url} target="_blank" rel="noopener noreferrer">
                      {t.visitPartner(partner.name)}<Icon name="ph:arrow-up-right" width="14" height="14" />
                    </a>
                    <button type="button" class="pa-copy" data-copy-slug={partnerSlug(partner)} data-copy-anchor={partnerAnchor(partner)} data-copied={t.copied} title={t.copyLink} aria-label={t.copyLink}>
                      <Icon name="ph:link-simple-bold" width="14" height="14" /><span>{t.copyLink}</span>
                    </button>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}
        </div>

        <div class="pa-contact reveal">
          <a class="btn btn-ghost btn-sm" href="https://petto.sbs/support" target="_blank" rel="noopener">
            <Icon name="ph:ticket" width="14" height="14" />
            {t.support}
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  // Copies a crawler-friendly link to one partner (/partners?p=<slug>) and scrolls to the card on ?p= or legacy #part_ hashes.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-slug]').forEach((button) => {
    const label = button.querySelector('span');
    const original = label?.textContent ?? '';
    button.addEventListener('click', async () => {
      const slug = button.dataset.copySlug ?? '';
      const link = `${location.origin}${location.pathname}?p=${encodeURIComponent(slug)}`;
      try { await navigator.clipboard.writeText(link); } catch {
        const box = document.createElement('textarea'); box.value = link; document.body.append(box); box.select(); document.execCommand('copy'); box.remove();
      }
      if (label) { label.textContent = button.dataset.copied ?? original; setTimeout(() => { label.textContent = original; }, 1800); }
    });
  });
  const open = () => {
    const params = new URLSearchParams(location.search);
    const wanted = (params.get('p') ?? '').trim().toLowerCase();
    const hashId = decodeURIComponent(location.hash.slice(1));
    let card: HTMLElement | null = null;
    if (wanted) {
      const btn = document.querySelector<HTMLElement>(`[data-copy-slug="${CSS.escape(wanted)}"]`);
      card = btn?.closest<HTMLElement>('.pa-card') ?? document.getElementById(wanted);
    } else if (hashId.startsWith('part_')) {
      card = document.getElementById(hashId);
    }
    if (!card) return;
    card.scrollIntoView({ block: 'center', behavior: 'smooth' });
    card.classList.add('pa-target');
    setTimeout(() => card.classList.remove('pa-target'), 2600);
  };
  open();
  window.addEventListener('hashchange', open);
</script>

<style>
  .pa-hero { padding: 64px 0 40px; text-align: center; }
  .pa-hero h1 { font-size: 36px; margin: 14px 0 12px; }
  .pa-lede { color: var(--text-muted); font-size: 15.5px; max-width: 58ch; margin: 0 auto; line-height: 1.65; }
  .pa-content { padding: 8px 0 72px; }
  .pa-notice { display: flex; align-items: flex-start; gap: 12px; max-width: 760px; margin: 0 auto; padding: 14px 16px; border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border)); border-radius: 14px; background: color-mix(in srgb, var(--accent) 8%, var(--card)); color: var(--text-muted); }
  .pa-notice > :global(svg) { flex: 0 0 auto; color: var(--accent); margin-top: 1px; }
  .pa-notice strong { display: block; color: var(--text); font-size: 14px; margin-bottom: 4px; }
  .pa-notice p { margin: 0; font-size: 13.5px; line-height: 1.6; }
  .pa-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .pa-copy { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--border); background: transparent; color: var(--text-muted); border-radius: 999px; min-height: 36px; padding: 6px 14px; font: inherit; font-size: 12.5px; cursor: pointer; transition: color .15s, border-color .15s; }
  .pa-copy:hover { color: var(--text); border-color: var(--accent); }
  .pa-copy:focus-visible, .pa-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .pa-card { scroll-margin-top: 90px; }
  .pa-card.pa-target { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .pa-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; margin-top: 28px; }
  .pa-card { flex: 0 1 360px; min-width: 0; display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 16px; padding: 22px; background: var(--card); transition: transform .18s ease, border-color .18s ease; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .pa-card:hover { transform: translateY(-2px); border-color: var(--text-dim); } }
  .pa-card-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  :global(.pa-icon) { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; color: #57f287; background: rgba(87, 242, 135, .12); box-shadow: 0 0 22px rgba(87, 242, 135, .12); }
  :global(.pa-icon svg) { width: 30px; height: 30px; }
  :global(.pa-icon-omniplex) { color: #fff; background: linear-gradient(135deg, #15151d, #4a40c4); box-shadow: 0 0 22px rgba(74, 64, 196, .28); }
  :global(.pa-icon-omniplex svg) { width: 34px; height: 34px; }
  .pa-status { color: var(--text-dim); font-family: var(--mono); font-size: 10px; letter-spacing: .06em; text-transform: uppercase; }
  .pa-card h2 { margin: 20px 0 8px; font-size: 22px; }
  .pa-card p { flex: 1; min-height: 68px; margin: 0 0 18px; color: var(--text-muted); font-size: 14px; line-height: 1.65; white-space: pre-line; }
  /* Groups with a single card sit side by side and stay centered, instead of one narrow column in a wide page. */
  .pa-groups { display: flex; flex-wrap: wrap; justify-content: center; align-items: stretch; gap: 0 16px; }
  .pa-group { display: flex; flex-direction: column; margin-top: 28px; max-width: 100%; }
  .pa-group .pa-grid { flex: 1; margin-top: 12px; }
  .pa-kind { text-align: center; font-size: 13px; font-family: var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--text-dim); margin: 0; font-weight: 600; }
  :global(.pa-icon-logo) { background: var(--bg-raise); box-shadow: none; }
  :global(.pa-icon-logo img) { width: 40px; height: 40px; object-fit: contain; border-radius: 10px; }
  :global(.pa-icon-logo.pa-icon-letter::after) { content: attr(data-letter); }
  :global(.pa-icon-letter) { color: var(--accent); background: var(--accent-soft); box-shadow: none; font-weight: 700; font-size: 22px; }
  .pa-link { display: inline-flex; min-height: 36px; align-items: center; gap: 6px; color: var(--accent); font-size: 13.5px; font-weight: 600; text-decoration: none; }
  .pa-link:hover { text-decoration: underline; }
  .pa-contact { display: flex; justify-content: center; padding-top: 34px; }
  .pa-contact .btn { flex: 0 0 auto; }
  @media (max-width: 560px) {
    .pa-hero h1 { font-size: 30px; }
    .pa-card { flex-basis: 100%; }
  }
</style>
