---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import type { Locale } from '../i18n/ui';
import { faviconUrl, getPartners, PARTNER_KINDS, type PartnerRow } from '../utils/partners';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const copy = {
  en: {
    eyebrow: 'Partners',
    title: 'The partners of Petto.',
    lede: 'The providers that keep Petto and its data running, and the communities that work with us.',
    notice: 'This list is provisional. Partners may still be awaiting confirmation or may have been discontinued, so this page may not always be up to date. To add or remove a partner, send us a ticket in the Petto support Discord.',
    noticeTitle: 'Partner information may change',
    primary: 'Primary partner',
    partner: 'Partner',
    omniplexDesc: 'A place to discover Discord bots and servers: explore thousands of them, vote and leave reviews. Petto is a partner of Omniplex. They are not a hosting provider, ours is Discloud.',
    visitOmniplex: 'Visit Omniplex',
    discloudDesc: 'Petto\'s primary hosting provider, PostgreSQL database provider, and infrastructure partner for the bot.',
    visit: 'Visit Discloud',
    support: 'Open a support ticket',
  },
  es: {
    eyebrow: 'Partners',
    title: 'Los partners de Petto.',
    lede: 'Los proveedores que mantienen funcionando a Petto y sus datos, y las comunidades que trabajan con nosotros.',
    notice: 'Esta lista es provisional. Algunos partners pueden estar pendientes de confirmación o haber sido descontinuados, por lo que la página podría no estar siempre actualizada. Si quieres añadir o eliminar un partner, envíanos un ticket en el Discord de soporte de Petto.',
    noticeTitle: 'La información de los partners puede cambiar',
    primary: 'Partner principal',
    partner: 'Partner',
    omniplexDesc: 'Un lugar para descubrir bots y servidores de Discord: explora miles, vota y deja reseñas. Petto es partner de Omniplex. No son un proveedor de hosting, el nuestro es Discloud.',
    visitOmniplex: 'Visitar Omniplex',
    discloudDesc: 'Proveedor principal de hosting, base de datos PostgreSQL e infraestructura para el bot de Petto.',
    visit: 'Visitar Discloud',
    support: 'Abrir un ticket de soporte',
  },
  'pt-BR': {
    eyebrow: 'Partners',
    title: 'Os parceiros do Petto.',
    lede: 'Os provedores que mantêm o Petto e seus dados funcionando, e as comunidades que trabalham com a gente.',
    notice: 'Esta lista é provisória. Alguns partners podem estar aguardando confirmação ou ter sido descontinuados, então a página pode não estar sempre atualizada. Se quiser adicionar ou remover um partner, envie um ticket no Discord de suporte do Petto.',
    noticeTitle: 'As informações dos partners podem mudar',
    primary: 'Partner principal',
    partner: 'Partner',
    omniplexDesc: 'Um lugar para descobrir bots e servidores do Discord: explore milhares, vote e deixe avaliações. O Petto é parceiro da Omniplex. Eles não são um provedor de hospedagem, o nosso é a Discloud.',
    visitOmniplex: 'Visitar a Omniplex',
    discloudDesc: 'Provedor principal de hospedagem, banco de dados PostgreSQL e infraestrutura do bot do Petto.',
    visit: 'Visitar a Discloud',
    support: 'Abrir um ticket de suporte',
  },
} as const;

const extra = {
  en: { copyLink: 'Copy link', copied: 'Link copied', visitPartner: (name: string) => `Visit ${name}`, kinds: { hosting: 'Hosting', servers: 'Servers', apps: 'Apps', bots: 'Bots', communities: 'Communities', other: 'Other' } },
  es: { copyLink: 'Copiar enlace', copied: 'Enlace copiado', visitPartner: (name: string) => `Visitar ${name}`, kinds: { hosting: 'Hosting', servers: 'Servidores', apps: 'Apps', bots: 'Bots', communities: 'Comunidades', other: 'Otros' } },
  'pt-BR': { copyLink: 'Copiar link', copied: 'Link copiado', visitPartner: (name: string) => `Visitar ${name}`, kinds: { hosting: 'Hospedagem', servers: 'Servidores', apps: 'Apps', bots: 'Bots', communities: 'Comunidades', other: 'Outros' } },
} as const;

const t = { ...copy[lang], ...extra[lang] };

// The partners come from the table the team edits in the dashboard (or the original list), grouped by type.
const { partners } = await getPartners(Astro);
const groups = PARTNER_KINDS.map((kind) => ({ kind, items: partners.filter((partner) => partner.kind === kind) })).filter((group) => group.items.length > 0);
// The link to one partner: /partners#part_<type>:<name>, which scrolls to its card.
const partnerAnchor = (partner: PartnerRow) => `part_${partner.kind}:${partner.name.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')}`;
const descriptionOf = (partner: PartnerRow) => (lang === 'es' ? partner.description_es : lang === 'pt-BR' ? partner.description_pt : partner.description_en) || partner.description_en;
---

<Base title={`${t.eyebrow} · Petto`} lang={lang}>
  <main>
    <section class="pa-hero">
      <div class="wrap">
        <div class="eyebrow reveal">{t.eyebrow}</div>
        <h1 class="reveal">{t.title}</h1>
        <p class="pa-lede reveal">{t.lede}</p>
      </div>
    </section>

    <section class="pa-content">
      <div class="wrap">
        <div class="pa-notice reveal" role="note">
          <Icon name="ph:info-fill" width="19" height="19" />
          <div>
            <strong>{t.noticeTitle}</strong>
            <p>{t.notice}</p>
          </div>
        </div>

        {groups.map((group) => (
          <div class="pa-group reveal">
            {groups.length > 1 && <h2 class="pa-kind">{t.kinds[group.kind]}</h2>}
            <div class="pa-grid">
              {group.items.map((partner) => (
                <article class="pa-card" id={partnerAnchor(partner)}>
                  <div class="pa-card-top">
                    {partner.icon === 'discloud' ? (
                      <div class="pa-icon" aria-label={partner.name} role="img">
                        <svg viewBox="0 0 128 128" aria-hidden="true"><path fill="currentColor" d="m127.978 18.202-19.935 19.21V18.28L72.409 35.544a15.09 15.09 0 0 1-15.133-.017L32.484 21.125a21.59 21.59 0 0 0-21.599-.056A21.616 21.616 0 0 0 .033 39.753L0 52.226v57.571l19.957-19.21v19.21l35.534-17.03a15.097 15.097 0 0 1 15.454-.173l24.577 14.28a21.604 21.604 0 0 0 21.598.062 21.597 21.597 0 0 0 10.847-18.679L128 75.785ZM106.49 79.86c0 3.51-3.737 5.75-6.832 4.093L82.13 74.58a40.15 40.15 0 0 0-38.916.582l-14.74 8.458c-3.094 1.775-6.953-.46-6.953-4.026v-31.19c0-3.577 3.876-5.812 6.97-4.021l14.59 8.452a40.152 40.152 0 0 0 39.193.588l17.368-9.378c3.094-1.67 6.848.57 6.848 4.087z" /></svg>
                      </div>
                    ) : partner.icon === 'omniplex' ? (
                      <div class="pa-icon pa-icon-omniplex" aria-label={partner.name} role="img">
                        <svg viewBox="30 30 315 315" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M 225.589844 338.671875 C 252.628906 331.746094 276.699219 317.570312 295.824219 298.445312 C 323.847656 270.75 340.996094 232.503906 340.996094 190.300781 C 340.996094 148.09375 323.847656 109.515625 295.824219 81.496094 C 267.796875 53.796875 229.550781 36.320312 187.015625 36.320312 C 144.8125 36.320312 106.566406 53.796875 78.871094 81.496094 C 55.789062 104.902344 39.964844 135.566406 35.347656 169.855469 C 59.746094 121.71875 108.542969 96.328125 157.34375 98.308594 C 166.902344 95.011719 176.796875 93.363281 187.015625 93.363281 C 213.722656 93.363281 237.792969 104.246094 255.597656 122.046875 C 308.019531 174.472656 286.589844 298.113281 225.589844 338.671875" /><path fill="#6b62f0" fill-rule="evenodd" d="M 81.175781 158.316406 C 88.433594 151.0625 96.34375 145.128906 104.917969 140.511719 C 108.875 133.585938 113.820312 127.324219 119.425781 121.71875 C 129.976562 111.167969 142.835938 102.921875 157.34375 98.308594 C 108.542969 96.328125 59.746094 121.71875 35.347656 169.855469 C 34.359375 176.449219 34.027344 183.375 34.027344 190.300781 C 34.027344 231.511719 50.183594 268.769531 76.5625 296.46875 C 44.25 259.210938 40.292969 199.53125 81.175781 158.316406" /><path fill="currentColor" fill-rule="evenodd" d="M 104.917969 140.511719 C 96.34375 145.128906 88.433594 151.0625 81.175781 158.316406 C 40.292969 199.53125 44.25 259.210938 76.5625 296.46875 C 77.222656 297.125 77.878906 297.785156 78.871094 298.777344 C 84.804688 304.710938 91.070312 309.984375 97.992188 314.929688 C 113.160156 324.492188 131.292969 330.101562 151.738281 330.101562 C 197.238281 330.101562 231.527344 302.402344 246.035156 266.460938 C 229.550781 278.992188 209.105469 286.246094 187.015625 286.246094 C 160.640625 286.246094 136.570312 275.695312 119.09375 258.21875 C 101.949219 241.078125 91.070312 217.007812 91.070312 190.300781 C 91.070312 172.167969 96.015625 155.019531 104.917969 140.511719" /></svg>
                      </div>
                    ) : (partner.logo_url ?? faviconUrl(partner.url)) ? (
                      <div class="pa-icon pa-icon-logo"><img src={partner.logo_url ?? faviconUrl(partner.url)!} alt={partner.name} width="40" height="40" loading="lazy" /></div>
                    ) : (
                      <div class="pa-icon pa-icon-letter" aria-hidden="true">{partner.name.slice(0, 1).toUpperCase()}</div>
                    )}
                    <span class="pa-status">{partner.is_primary ? t.primary : t.partner}</span>
                  </div>
                  <h2>{partner.name}</h2>
                  <p>{descriptionOf(partner)}</p>
                  <div class="pa-actions">
                    <a class="pa-link" href={partner.url} target="_blank" rel="noopener noreferrer">
                      {t.visitPartner(partner.name)}<Icon name="ph:arrow-up-right" width="14" height="14" />
                    </a>
                    <button type="button" class="pa-copy" data-copy-anchor={partnerAnchor(partner)} data-copied={t.copied} title={t.copyLink} aria-label={t.copyLink}>
                      <Icon name="ph:link-simple-bold" width="14" height="14" /><span>{t.copyLink}</span>
                    </button>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}

        <div class="pa-contact reveal">
          <p>{t.notice}</p>
          <a class="btn btn-ghost btn-sm" href="https://petto.sbs/support" target="_blank" rel="noopener">
            <Icon name="ph:ticket" width="14" height="14" />
            {t.support}
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  // Copies the link to one partner (the page and #part_<type>:<name>) and, when the page is opened with one, scrolls to its card.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-anchor]').forEach((button) => {
    const label = button.querySelector('span');
    const original = label?.textContent ?? '';
    button.addEventListener('click', async () => {
      const link = `${location.origin}${location.pathname}#${button.dataset.copyAnchor}`;
      try { await navigator.clipboard.writeText(link); } catch {
        const box = document.createElement('textarea'); box.value = link; document.body.append(box); box.select(); document.execCommand('copy'); box.remove();
      }
      if (label) { label.textContent = button.dataset.copied ?? original; setTimeout(() => { label.textContent = original; }, 1800); }
    });
  });
  const open = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    const card = id.startsWith('part_') ? document.getElementById(id) : null;
    if (!card) return;
    card.scrollIntoView({ block: 'center', behavior: 'smooth' });
    card.classList.add('pa-target');
    setTimeout(() => card.classList.remove('pa-target'), 2600);
  };
  open();
  window.addEventListener('hashchange', open);
</script>

<style>
  .pa-hero { padding: 64px 0 40px; }
  .pa-hero h1 { font-size: 36px; margin: 14px 0 12px; }
  .pa-lede { color: var(--text-muted); font-size: 15.5px; max-width: 58ch; line-height: 1.65; }
  .pa-content { padding: 8px 0 72px; }
  .pa-notice { display: flex; align-items: flex-start; gap: 12px; max-width: 760px; padding: 14px 16px; border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border)); border-radius: 14px; background: color-mix(in srgb, var(--accent) 8%, var(--card)); color: var(--text-muted); }
  .pa-notice > :global(svg) { flex: 0 0 auto; color: var(--accent); margin-top: 1px; }
  .pa-notice strong { display: block; color: var(--text); font-size: 14px; margin-bottom: 4px; }
  .pa-notice p { margin: 0; font-size: 13.5px; line-height: 1.6; }
  .pa-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .pa-copy { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--border); background: transparent; color: var(--text-muted); border-radius: 999px; padding: 6px 12px; font: inherit; font-size: 12.5px; cursor: pointer; transition: color .15s, border-color .15s; }
  .pa-copy:hover { color: var(--text); border-color: var(--accent); }
  .pa-card { scroll-margin-top: 90px; }
  .pa-card.pa-target { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .pa-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 360px)); gap: 16px; margin-top: 28px; }
  .pa-card { border: 1px solid var(--border); border-radius: 16px; padding: 22px; background: var(--card); }
  .pa-card-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .pa-icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; color: #57f287; background: rgba(87, 242, 135, .12); box-shadow: 0 0 22px rgba(87, 242, 135, .12); }
  .pa-icon svg { width: 30px; height: 30px; }
  .pa-icon-omniplex { color: #fff; background: linear-gradient(135deg, #15151d, #4a40c4); box-shadow: 0 0 22px rgba(74, 64, 196, .28); }
  .pa-icon-omniplex svg { width: 34px; height: 34px; }
  .pa-status { color: var(--text-dim); font-family: var(--mono); font-size: 10px; letter-spacing: .06em; text-transform: uppercase; }
  .pa-card h2 { margin: 20px 0 8px; font-size: 22px; }
  .pa-card p { min-height: 68px; margin: 0 0 18px; color: var(--text-muted); font-size: 14px; line-height: 1.65; }
  .pa-group { margin-top: 28px; }
  .pa-group .pa-grid { margin-top: 12px; }
  .pa-kind { font-size: 13px; font-family: var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--text-dim); margin: 0; font-weight: 600; }
  .pa-icon-logo { background: var(--bg-raise); box-shadow: none; }
  .pa-icon-logo img { width: 40px; height: 40px; object-fit: contain; border-radius: 10px; }
  .pa-icon-letter { color: var(--accent); background: var(--accent-soft); box-shadow: none; font-weight: 700; font-size: 22px; }
  .pa-link { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); font-size: 13.5px; font-weight: 600; text-decoration: none; }
  .pa-link:hover { text-decoration: underline; }
  .pa-contact { display: flex; align-items: center; justify-content: space-between; gap: 20px; max-width: 760px; padding-top: 34px; color: var(--text-muted); }
  .pa-contact p { margin: 0; font-size: 13.5px; line-height: 1.6; }
  .pa-contact .btn { flex: 0 0 auto; }
  @media (max-width: 560px) {
    .pa-hero h1 { font-size: 30px; }
    .pa-grid { grid-template-columns: 1fr; }
    .pa-contact { align-items: flex-start; flex-direction: column; }
  }
</style>
