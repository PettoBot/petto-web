---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const copy = {
  en: {
    eyebrow: 'Partners',
    title: 'The services behind Petto.',
    lede: 'The providers that help keep Petto, its bot infrastructure, and its data running.',
    notice: 'This list is provisional. Partners may still be awaiting confirmation or may have been discontinued, so this page may not always be up to date. To add or remove a partner, send us a ticket in the Petto support Discord.',
    noticeTitle: 'Partner information may change',
    primary: 'Primary partner',
    discloudDesc: 'Petto\'s primary hosting provider, PostgreSQL database provider, and infrastructure partner for the bot.',
    visit: 'Visit Discloud',
    support: 'Open a support ticket',
  },
  es: {
    eyebrow: 'Partners',
    title: 'Los servicios detrás de Petto.',
    lede: 'Los proveedores que ayudan a mantener funcionando a Petto, su infraestructura y sus datos.',
    notice: 'Esta lista es provisional. Algunos partners pueden estar pendientes de confirmación o haber sido descontinuados, por lo que la página podría no estar siempre actualizada. Si quieres añadir o eliminar un partner, envíanos un ticket en el Discord de soporte de Petto.',
    noticeTitle: 'La información de los partners puede cambiar',
    primary: 'Partner principal',
    discloudDesc: 'Proveedor principal de hosting, base de datos PostgreSQL e infraestructura para el bot de Petto.',
    visit: 'Visitar Discloud',
    support: 'Abrir un ticket de soporte',
  },
  'pt-BR': {
    eyebrow: 'Partners',
    title: 'Os serviços por trás do Petto.',
    lede: 'Os provedores que ajudam a manter o Petto, sua infraestrutura e seus dados funcionando.',
    notice: 'Esta lista é provisória. Alguns partners podem estar aguardando confirmação ou ter sido descontinuados, então a página pode não estar sempre atualizada. Se quiser adicionar ou remover um partner, envie um ticket no Discord de suporte do Petto.',
    noticeTitle: 'As informações dos partners podem mudar',
    primary: 'Partner principal',
    discloudDesc: 'Provedor principal de hospedagem, banco de dados PostgreSQL e infraestrutura do bot do Petto.',
    visit: 'Visitar a Discloud',
    support: 'Abrir um ticket de suporte',
  },
} as const;

const t = copy[lang];
---

<Base title={`${t.eyebrow} · Petto`} lang={lang}>
  <main>
    <section class="pa-hero">
      <div class="wrap">
        <div class="eyebrow reveal">{t.eyebrow}</div>
        <h1 class="reveal">{t.title}</h1>
        <p class="pa-lede reveal">{t.lede}</p>
      </div>
    </section>

    <section class="pa-content">
      <div class="wrap">
        <div class="pa-notice reveal" role="note">
          <Icon name="ph:info-fill" width="19" height="19" />
          <div>
            <strong>{t.noticeTitle}</strong>
            <p>{t.notice}</p>
          </div>
        </div>

        <div class="pa-grid reveal">
          <article class="pa-card">
            <div class="pa-card-top">
              <div class="pa-icon"><Icon name="ph:cloud-arrow-up-fill" width="26" height="26" /></div>
              <span class="pa-status">{t.primary}</span>
            </div>
            <h2>Discloud</h2>
            <p>{t.discloudDesc}</p>
            <a class="pa-link" href="https://discloud.app" target="_blank" rel="noopener">
              {t.visit}<Icon name="ph:arrow-up-right-bold" width="14" height="14" />
            </a>
          </article>
        </div>

        <div class="pa-contact reveal">
          <p>{t.notice}</p>
          <a class="btn btn-ghost btn-sm" href="https://petto.sbs/support" target="_blank" rel="noopener">
            <Icon name="ph:ticket-fill" width="14" height="14" />
            {t.support}
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .pa-hero { padding: 64px 0 40px; }
  .pa-hero h1 { font-size: 36px; margin: 14px 0 12px; }
  .pa-lede { color: var(--text-muted); font-size: 15.5px; max-width: 58ch; line-height: 1.65; }
  .pa-content { padding: 8px 0 72px; }
  .pa-notice { display: flex; align-items: flex-start; gap: 12px; max-width: 760px; padding: 14px 16px; border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border)); border-radius: 14px; background: color-mix(in srgb, var(--accent) 8%, var(--card)); color: var(--text-muted); }
  .pa-notice > :global(svg) { flex: 0 0 auto; color: var(--accent); margin-top: 1px; }
  .pa-notice strong { display: block; color: var(--text); font-size: 14px; margin-bottom: 4px; }
  .pa-notice p { margin: 0; font-size: 13.5px; line-height: 1.6; }
  .pa-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 360px)); gap: 16px; margin-top: 28px; }
  .pa-card { border: 1px solid var(--border); border-radius: 16px; padding: 22px; background: var(--card); }
  .pa-card-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .pa-icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; color: #f38020; background: rgba(243, 128, 32, .12); }
  .pa-status { color: var(--text-dim); font-family: var(--mono); font-size: 10px; letter-spacing: .06em; text-transform: uppercase; }
  .pa-card h2 { margin: 20px 0 8px; font-size: 22px; }
  .pa-card p { min-height: 68px; margin: 0 0 18px; color: var(--text-muted); font-size: 14px; line-height: 1.65; }
  .pa-link { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); font-size: 13.5px; font-weight: 600; text-decoration: none; }
  .pa-link:hover { text-decoration: underline; }
  .pa-contact { display: flex; align-items: center; justify-content: space-between; gap: 20px; max-width: 760px; padding-top: 34px; color: var(--text-muted); }
  .pa-contact p { margin: 0; font-size: 13.5px; line-height: 1.6; }
  .pa-contact .btn { flex: 0 0 auto; }
  @media (max-width: 560px) {
    .pa-hero h1 { font-size: 30px; }
    .pa-grid { grid-template-columns: 1fr; }
    .pa-contact { align-items: flex-start; flex-direction: column; }
  }
</style>
