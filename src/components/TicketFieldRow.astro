---
// One question of the ticket form editor (TicketFieldsBuilder draws one for each saved question, and one more inside a <template> that "Add question" copies,
// so a new row is made fresh and every box, counter and number in it is set up like the others). The parts a type does not use are hidden by the script of the
// builder (data-part); every data-ff-* hook is what that script reads.
import { Icon } from 'astro-icon/components';
import { getDashLang, makeT } from '../i18n/dash';
import { TICKET_FORM_LIMITS, type TicketField } from '../utils/ticketForm';
interface Props { f: TicketField }
const dt = makeT(getDashLang(Astro));
const { f } = Astro.props;
const CHOICE_TYPES = ['select', 'radio', 'checkboxes'];
const PICKERS = ['user', 'role', 'channel'];
// What each part of a row is for: the types that show it.
const SHOWS: Record<string, string[]> = {
  desc: ['short_text', 'long_text', 'select', 'radio', 'checkboxes', 'check', 'file', 'user', 'role', 'channel'],
  hint: ['short_text', 'long_text', 'select', 'user', 'role', 'channel'],
  options: CHOICE_TYPES,
  multi: ['select'],
  file: ['file'],
  picks: PICKERS,
  content: ['display'],
  required: ['short_text', 'long_text', 'select', 'radio', 'checkboxes', 'check', 'file', 'user', 'role', 'channel'],
  label: ['short_text', 'long_text', 'select', 'radio', 'checkboxes', 'check', 'file', 'user', 'role', 'channel'],
  more: ['short_text', 'long_text', 'select', 'radio', 'checkboxes', 'check', 'file', 'user', 'role', 'channel'],
};
const isHidden = (part: string, type: string) => !SHOWS[part].includes(type);
---
<div class="ff-row" data-ff-row data-id={f.id} data-type={f.type}>
  <div class="ff-top">
    <select data-ff-type aria-label={dt('Type')}>
      <optgroup label={dt('Text')}>
        <option value="short_text" selected={f.type === 'short_text'}>{dt('Short answer')}</option>
        <option value="long_text" selected={f.type === 'long_text'}>{dt('Paragraph')}</option>
      </optgroup>
      <optgroup label={dt('Choices')}>
        <option value="select" selected={f.type === 'select'}>{dt('Dropdown menu')}</option>
        <option value="radio" selected={f.type === 'radio'}>{dt('Radio buttons')}</option>
        <option value="checkboxes" selected={f.type === 'checkboxes'}>{dt('Checkboxes')}</option>
        <option value="check" selected={f.type === 'check'}>{dt('One checkbox')}</option>
      </optgroup>
      <optgroup label={dt('Pictures and files')}>
        <option value="file" selected={f.type === 'file'}>{dt('File upload')}</option>
      </optgroup>
      <optgroup label={dt('Pickers')}>
        <option value="user" selected={f.type === 'user'}>{dt('Member picker')}</option>
        <option value="role" selected={f.type === 'role'}>{dt('Role picker')}</option>
        <option value="channel" selected={f.type === 'channel'}>{dt('Channel picker')}</option>
      </optgroup>
      <optgroup label={dt('Other')}>
        <option value="display" selected={f.type === 'display'}>{dt('Text only (no answer)')}</option>
      </optgroup>
    </select>
    <span class="ff-move">
      <button type="button" class="ff-icon" data-ff-up aria-label={dt('Move up')} title={dt('Move up')}><Icon name="ph:caret-up-bold" width="13" height="13" /></button>
      <button type="button" class="ff-icon" data-ff-down aria-label={dt('Move down')} title={dt('Move down')}><Icon name="ph:caret-down-bold" width="13" height="13" /></button>
      <button type="button" class="ff-icon ff-del" data-ff-del aria-label={dt('Remove')} title={dt('Remove')}><Icon name="ph:x-bold" width="13" height="13" /></button>
    </span>
  </div>
  <div class="ff-body">
    <div class="dfx-field" data-part="label" hidden={isHidden('label', f.type)}>
      <label>{dt('Question')}</label>
      <textarea class="dgl-autogrow dfx-one" rows="1" autocomplete="off" data-one-line data-count data-ff-label placeholder={dt('Question')} maxlength={TICKET_FORM_LIMITS.label}>{f.type === 'display' ? '' : f.label}</textarea>
    </div>
    <div class="dfx-field" data-part="content" hidden={isHidden('content', f.type)}>
      <label>{dt('Text members read (Markdown works)')}</label>
      <textarea class="dgl-autogrow" rows="3" data-count data-ff-content maxlength={TICKET_FORM_LIMITS.content}>{f.content ?? ''}</textarea>
    </div>
    <div class="dfx-field" data-part="options" hidden={isHidden('options', f.type)}>
      <label>{dt('Choices')}</label>
      <textarea class="dgl-autogrow" rows="4" data-ff-options placeholder={dt('One choice per line')}>{(f.options ?? []).join('\n')}</textarea>
      <span class="ff-count" data-ff-count></span>
    </div>
    <label class="dfx-switch" data-part="multi" hidden={isHidden('multi', f.type)}><span><b>{dt('Members can pick more than one choice')}</b></span><input type="checkbox" class="dfx-t" data-ff-multi checked={f.type === 'select' && (f.max ?? 1) > 1} /></label>
    <div class="dfx-grid ff-pair" data-part="file" hidden={isHidden('file', f.type)}>
      <div class="dfx-field"><label>{dt('Members can upload')}</label>
        <select data-ff-accept>
          <option value="images" selected={f.accept === 'images'}>{dt('Pictures only (PNG, JPG, GIF, WebP)')}</option>
          <option value="any" selected={f.accept !== 'images'}>{dt('Any file')}</option>
        </select>
      </div>
      <div class="dfx-field"><label>{dt('How many files')}</label>
        <select data-ff-files>
          {[1, 2, 3, 4, 5].map((n) => <option value={n} selected={(f.max ?? 1) === n}>{n}</option>)}
        </select>
      </div>
    </div>
    <div class="dfx-field ff-picks" data-part="picks" hidden={isHidden('picks', f.type)}>
      <label>{dt('Members can pick up to')}</label>
      <input type="number" min="1" max={TICKET_FORM_LIMITS.picks} data-ff-picks value={PICKERS.includes(f.type) ? (f.max ?? 1) : 1} />
    </div>
    <label class="dfx-switch" data-part="required" hidden={isHidden('required', f.type)}><span><b data-ff-req-text>{f.type === 'check' ? dt('Must be ticked') : dt('Required')}</b></span><input type="checkbox" class="dfx-t" data-ff-required checked={f.type === 'check' ? f.required === true : f.required !== false} /></label>
    <details class="dfx-acc ff-more" data-part="more" hidden={isHidden('more', f.type)} open={Boolean(f.description || f.placeholder)}>
      <summary><span class="dfx-acc-title"><b>{dt('More options')}</b></span><Icon name="ph:caret-down-bold" class="dfx-caret" width="14" height="14" /></summary>
      <div class="dfx-acc-body">
        <div class="dfx-field" data-part="desc" hidden={isHidden('desc', f.type)}>
          <label>{dt('Help text under the question (optional)')}</label>
          <textarea class="dgl-autogrow dfx-one" rows="1" autocomplete="off" data-one-line data-count data-ff-desc maxlength={TICKET_FORM_LIMITS.description}>{f.description ?? ''}</textarea>
        </div>
        <div class="dfx-field" data-part="hint" hidden={isHidden('hint', f.type)}>
          <label>{dt('Hint text (optional)')}</label>
          <textarea class="dgl-autogrow dfx-one" rows="1" autocomplete="off" data-one-line data-count data-ff-hint maxlength={TICKET_FORM_LIMITS.placeholder}>{f.placeholder ?? ''}</textarea>
        </div>
      </div>
    </details>
    <p class="ff-warn" data-ff-warn hidden role="status"></p>
  </div>
</div>
