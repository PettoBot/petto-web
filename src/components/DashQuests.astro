---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashAcData from './DashAcData.astro';
import DashFormKit from './DashFormKit.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  config: { enabled: boolean; channelId: string; roleId: string; style: string; embedTemplate: string; rewardKinds: string[]; taskKinds: string[]; hideSections: string[]; accentColor: string; expiringHours: number; autoThread: boolean; threadName: string; threadPing: boolean; threadArchive: number; methodEnabled: boolean; methodTemplate: string; methodText: string; methodTarget: string; methodChannelId: string; methodPing: boolean; typeTemplates: Record<string, string>; methodTypeTemplates: Record<string, string> };
  channels: { id: string; name: string }[];
  roles: { id: string; name: string }[];
  embedTemplates: { name: string; v2: boolean }[];
  ready: boolean;
  saved: boolean;
  methodResult?: { ok: boolean; message: string } | null;
}
const { user, guildId, guildName, guildIcon, config, channels, roles, embedTemplates, ready, saved, methodResult } = Astro.props;
const archiveChoices = [[60, '1 hour'], [1440, '1 day'], [4320, '3 days'], [10080, '1 week']] as const;
const rewardKinds = [['orbs', 'Orbs'], ['decoration', 'Collectibles (decorations, effects)'], ['code', 'Codes'], ['ingame', 'In-game items'], ['nitro', 'Nitro']];
const taskKinds = [['video', 'Watch a video'], ['play', 'Play a game'], ['stream', 'Stream'], ['activity', 'Activities']];
const sections = [['image', 'Picture'], ['rewards', 'Rewards'], ['tasks', 'Tasks'], ['platforms', 'Platforms'], ['limits', 'Region and age limits']];
const sample = { name: 'Watch the trailer', reward: '200 Orbs | 240', task: 'Watch a video (2:14)', platforms: 'Desktop, Mobile', limits: 'Users residing in United States 🇺🇸' };
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="quests" pageTitle="Quests">
  <DashFormKit />
  <h1>{dt('Quest alerts')}</h1>
  <DashAcData roles={roles} channels={channels} vars={[{ tok: '{quest.name}', desc: dt('Name of the quest') }, { tok: '{quest.game}', desc: dt('Game of the quest') }, { tok: '{quest.task}', desc: dt('Task of the quest') }, { tok: '{quest.reward}', desc: dt('Reward of the quest') }, { tok: '{quest.expires}', desc: dt('When the quest ends') }]} />
  {saved && <div class="dfx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {methodResult && <div class={`dfx-flash${methodResult.ok ? '' : ' dfx-warn'}`}><Icon name={methodResult.ok ? 'ph:check-circle-fill' : 'ph:warning-fill'} width="15" height="15" />{methodResult.ok ? dt('The method was sent.') : dt('The method could not be sent.')} {methodResult.message}</div>}
  {!ready && <div class="dfx-flash dfx-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}

  <div class="qa-page">
    <form method="POST" class="dfx-form qa-form">
      <label class="dfx-master"><span><b>{dt('Send alerts')}</b><em>{dt('Petto posts each new Discord quest in the channel.')}</em></span><input type="checkbox" class="dfx-t" name="enabled" checked={config.enabled} /></label>

      <section class="dfx-sec">
        <div class="dfx-sec-head"><h2>{dt('Where it goes')}</h2><p>{dt('The channel of the alerts, who is pinged and when a last call is sent.')}</p></div>
        <div class="dfx-grid dfx-grid-3">
          <div class="dfx-field"><label>{dt('Channel')}</label><select name="channel_id"><option value="">{dt('None')}</option>{channels.map((ch) => <option value={ch.id} selected={ch.id === config.channelId}>#{ch.name}</option>)}</select></div>
          <div class="dfx-field"><label>{dt('Role to ping')}</label><select name="role_id"><option value="">{dt('None')}</option>{roles.map((r) => <option value={r.id} selected={r.id === config.roleId}>{r.name}</option>)}</select></div>
          <div class="dfx-field"><label>{dt('Also alert before a quest ends (hours, 0 is off)')}</label><input type="number" name="expiring_hours" min="0" max="168" value={config.expiringHours} /></div>
        </div>
      </section>

      <section class="dfx-sec">
        <div class="dfx-sec-head"><h2>{dt('The alert')}</h2><p>{dt('Use the Petto card or one of your saved embeds. The preview is a rough one.')}</p></div>
        <div class="qa-msg">
          <div class="qa-msg-fields">
            <div class="dfx-field"><label>{dt('Message style')}</label>
              <select name="style" id="qa-style"><option value="card" selected={config.style !== 'template'}>{dt('Petto card')}</option><option value="template" selected={config.style === 'template'}>{dt('A saved embed')}</option></select>
            </div>
            <div class="dfx-field" id="qa-template-field"><label>{dt('Saved embed')}</label>
              <select name="embed_template" data-dp-template-only><option value="">{dt('None')}</option>{embedTemplates.map((tpl) => <option value={tpl.name} selected={tpl.name === config.embedTemplate}>{tpl.name}{tpl.v2 ? ' (V2)' : ''}</option>)}</select>
              <span class="dfx-hint">{dt('It can use the quest variables, such as {quest.name}, {quest.reward} and {quest.expires}. If it is missing, the card is sent.')}</span>
              {config.embedTemplate && <a class="dfx-link" href={`/dash/guild/${guildId}/embeds?name=${encodeURIComponent(config.embedTemplate)}`}>{dt('Edit this design')}</a>}
              <button type="submit" form="qa-design-form" class="btn btn-ghost btn-sm qa-make" disabled={!ready}>{dt('Make a V2 design from the Petto card')}</button>
            </div>
            <div class="qa-card-options" id="qa-card-options">
              <div class="dfx-field"><span class="dfx-label">{dt('What the card hides')}</span>
                <div class="dfx-chips">
                  {sections.map(([value, label]) => <label class="dfx-chip"><input type="checkbox" name={`hide_${value}`} data-hide={value} checked={config.hideSections.includes(value)} />{dt(label)}</label>)}
                </div>
              </div>
              <div class="dfx-field"><label for="qa-color">{dt('Card color')}</label>
                <div class="qa-colorbox"><i class="qa-swatch" id="qa-swatch" aria-hidden="true"></i><input type="text" name="accent_color" id="qa-color" value={config.accentColor} placeholder="#ff91c2" maxlength="7" /></div>
                <span class="dfx-hint">{dt('Empty uses the color of each quest.')}</span>
              </div>
            </div>
          </div>

          <aside class="qa-preview" aria-label={dt('Preview')}>
            <div class="qa-card" id="qa-card" style={`--qa-accent:${config.accentColor || '#4752c4'}`}>
              <div class="qa-title"><span class="qa-badge" aria-hidden="true">◆</span> <a>{sample.name}</a></div>
              <div class="qa-hero" data-part="image" aria-hidden="true"></div>
              <hr />
              <div class="qa-lines">
                <div>⏰ <b>{dt('Starts')}:</b> {dt('1 day ago')} | <b>{dt('Ends')}:</b> {dt('in 5 days')}</div>
                <div data-part="platforms">💿 <b>{dt('Platforms')}:</b> {sample.platforms}</div>
                <div data-part="tasks">🧫 <b>{dt('Task')}:</b> {sample.task}</div>
              </div>
              <div data-part="rewards"><hr />
                <div class="qa-h2">🎁 {dt('Rewards')}</div>
                <div class="qa-lines"><div>🥇 <b>{dt('Type')}:</b> {dt('Virtual currency')}</div><div>💸 <b>{dt('Amount')}:</b> {sample.reward}</div></div>
              </div>
              <div data-part="limits"><hr />
                <div class="qa-h2">⚠️ {dt('Limitations')}</div>
                <div class="qa-lines"><div>• {sample.limits}</div></div>
              </div>
              <hr />
            </div>
            <div class="qa-buttons"><span>{dt('Accept Quest')} ↗</span><span>{dt('Game page')} ↗</span></div>
          </aside>
        </div>
      </section>

      <section class="dfx-sec">
        <div class="dfx-sec-head"><h2>{dt('What gets an alert')}</h2><p>{dt('Pick the kinds you want. With nothing picked, every quest is sent.')}</p></div>
        <div class="dfx-field"><span class="dfx-label">{dt('Only these rewards')}</span>
          <div class="dfx-chips">{rewardKinds.map(([value, label]) => <label class="dfx-chip"><input type="checkbox" name="reward_kinds" value={value} checked={config.rewardKinds.includes(value)} />{dt(label)}</label>)}</div>
          <span class="dfx-hint">{dt('Leave all empty for every reward.')}</span>
        </div>
        <div class="dfx-field"><span class="dfx-label">{dt('Only these tasks')}</span>
          <div class="dfx-chips">{taskKinds.map(([value, label]) => <label class="dfx-chip"><input type="checkbox" name="task_kinds" value={value} checked={config.taskKinds.includes(value)} />{dt(label)}</label>)}</div>
          <span class="dfx-hint">{dt('Leave all empty for every task.')}</span>
        </div>
      </section>

      <section class="dfx-sec">
        <div class="dfx-sec-head"><h2>{dt('More options')}</h2><p>{dt('Open the ones you need.')}</p></div>

        <details class="dfx-acc" open={Object.values(config.typeTemplates).some(Boolean) || Object.values(config.methodTypeTemplates).some(Boolean)}>
          <summary><span class="dfx-acc-title"><b>{dt('A different design for each reward')}</b><em>{dt('Orbs, collectibles, codes and more can each look different.')}</em></span><Icon name="ph:caret-down-bold" class="dfx-caret" width="14" height="14" /></summary>
          <div class="dfx-acc-body">
            <span class="dfx-hint">{dt('Choose a saved embed (normal or V2) for the kinds of reward you want to look different, such as Orbs or avatar decorations. A quest uses the one of its reward; if there is none, the general design above.')}</span>
            <div class="qa-types">
              <div class="qa-types-head" aria-hidden="true"><span></span><span>{dt('Alert')}</span><span>{dt('Method')}</span></div>
              {rewardKinds.map(([value, label]) => (
                <div class="dfx-field qa-type">
                  <label>{dt(label)}</label>
                  <select name={`type_template_${value}`} aria-label={dt('Alert')}><option value="">{dt('The general design')}</option>{embedTemplates.map((tpl) => <option value={tpl.name} selected={tpl.name === config.typeTemplates[value]}>{tpl.name}{tpl.v2 ? ' (V2)' : ''}</option>)}</select>
                  <select name={`method_type_template_${value}`} aria-label={dt('Method')}><option value="">{dt('The general method')}</option>{embedTemplates.map((tpl) => <option value={tpl.name} selected={tpl.name === config.methodTypeTemplates[value]}>{tpl.name}{tpl.v2 ? ' (V2)' : ''}</option>)}</select>
                </div>
              ))}
            </div>
            <span class="dfx-hint">{dt('The first list is the alert, the second one is the method.')}</span>
          </div>
        </details>

        <details class="dfx-acc" open={config.autoThread}>
          <summary><span class="dfx-acc-title"><b>{dt('Thread')}</b><em>{dt('A thread under each alert to talk about the quest.')}</em></span><Icon name="ph:caret-down-bold" class="dfx-caret" width="14" height="14" /></summary>
          <div class="dfx-acc-body">
            <label class="dfx-switch"><span><b>{dt('Open a thread under each alert')}</b></span><input type="checkbox" class="dfx-t" name="auto_thread" checked={config.autoThread} /></label>
            <div class="dfx-field"><label>{dt('Thread name')}</label><textarea name="thread_name" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count data-ac="vars,emojis" placeholder="{quest.name}" maxlength="100">{config.threadName}</textarea><span class="dfx-hint">{dt('Quest variables such as {quest.name} and {quest.game} work. Empty uses the name of the quest.')}</span></div>
            <label class="dfx-switch"><span><b>{dt('Ping the role inside the thread (its members are added to it)')}</b></span><input type="checkbox" class="dfx-t" name="thread_ping" checked={config.threadPing} /></label>
            <div class="dfx-field"><label>{dt('Hide an idle thread after')}</label><select name="thread_archive">{archiveChoices.map(([value, label]) => <option value={value} selected={value === config.threadArchive}>{dt(label)}</option>)}</select></div>
            <span class="dfx-hint">{dt('Petto needs the Create Public Threads permission in the alert channel.')}</span>
          </div>
        </details>

        <details class="dfx-acc" open={config.methodEnabled}>
          <summary><span class="dfx-acc-title"><b>{dt('How to complete it (the method)')}</b><em>{dt('A message with the steps, sent with each new quest.')}</em></span><Icon name="ph:caret-down-bold" class="dfx-caret" width="14" height="14" /></summary>
          <div class="dfx-acc-body">
            <span class="dfx-hint">{dt('A message that tells how to complete the quests, written once and sent with each new quest. It can have several texts, pictures and buttons if you make it as a saved embed.')}</span>
            <label class="dfx-switch"><span><b>{dt('Send the method with each new quest')}</b></span><input type="checkbox" class="dfx-t" name="method_enabled" checked={config.methodEnabled} /></label>
            <div class="dfx-field"><label>{dt('Saved embed')}</label>
              <select name="method_template" data-tpl-locks="method_text"><option value="">{dt('None')}</option>{embedTemplates.map((tpl) => <option value={tpl.name} selected={tpl.name === config.methodTemplate}>{tpl.name}{tpl.v2 ? ' (V2)' : ''}</option>)}</select>
              {config.methodTemplate && <a class="dfx-link" href={`/dash/guild/${guildId}/embeds?name=${encodeURIComponent(config.methodTemplate)}`}>{dt('Edit this design')}</a>}
            </div>
            <div class="dfx-field"><label>{dt('Or a plain text')}</label><textarea name="method_text" class="dgl-autogrow" data-ac data-count rows="6" maxlength="2000" placeholder={dt('Step 1: ...')}>{config.methodText}</textarea><span class="dfx-hint">{dt('Used when there is no saved embed, or when it is missing. The quest variables work, such as {quest.name} and {quest.task}.')}</span></div>
            <div class="dfx-grid">
              <div class="dfx-field"><label>{dt('Where it goes')}</label>
                <select name="method_target"><option value="thread" selected={config.methodTarget !== 'channel'}>{dt('In the thread of the alert')}</option><option value="channel" selected={config.methodTarget === 'channel'}>{dt('In a channel')}</option></select>
              </div>
              <div class="dfx-field"><label>{dt('Channel for the method')}</label><select name="method_channel_id"><option value="">{dt('The alert channel')}</option>{channels.map((ch) => <option value={ch.id} selected={ch.id === config.methodChannelId}>#{ch.name}</option>)}</select></div>
            </div>
            <label class="dfx-switch"><span><b>{dt('Ping the role with the method')}</b></span><input type="checkbox" class="dfx-t" name="method_ping" checked={config.methodPing} /></label>
            <div class="dfx-foot">
              <button type="submit" form="qa-method-form" class="btn btn-ghost btn-sm qa-make" disabled={!ready}>{dt('Send the method now')}</button>
              <span class="dfx-hint">{dt('Sends it for the newest active quest, in its thread or in the channel above. Save your changes first.')}</span>
            </div>
          </div>
        </details>
      </section>

      <div class="dfx-foot"><button type="submit" class="btn btn-accent btn-sm" disabled={!ready}>{dt('Save changes')}</button></div>
    </form>

    <form method="POST" id="qa-method-form" data-no-dirty><input type="hidden" name="action" value="send_method" /></form>
    <form method="POST" id="qa-design-form" data-no-dirty><input type="hidden" name="action" value="create_design" /></form>
  </div>
</DashGuildLayout>

<script>
  const card = document.getElementById('qa-card');
  const color = document.getElementById('qa-color') as HTMLInputElement | null;
  const swatch = document.getElementById('qa-swatch');
  const style = document.getElementById('qa-style') as HTMLSelectElement | null;
  function update() {
    document.querySelectorAll<HTMLInputElement>('[data-hide]').forEach((box) => {
      card?.querySelectorAll<HTMLElement>(`[data-part="${box.dataset.hide}"]`).forEach((el) => { el.hidden = box.checked; });
    });
    const accent = color && /^#?[0-9a-f]{6}$/i.test(color.value.trim()) ? `#${color.value.trim().replace('#', '')}` : '#4752c4';
    if (card) card.style.setProperty('--qa-accent', accent);
    if (swatch) swatch.style.background = color && color.value.trim() ? accent : 'transparent';
    const useTemplate = style?.value === 'template';
    document.getElementById('qa-template-field')?.toggleAttribute('hidden', !useTemplate);
    document.getElementById('qa-card-options')?.toggleAttribute('hidden', useTemplate);
    document.getElementById('qa-card')?.toggleAttribute('hidden', useTemplate);
    document.querySelector('.qa-msg')?.classList.toggle('qa-msg-solo', useTemplate);
  }
  document.querySelectorAll('[data-hide], #qa-color, #qa-style').forEach((el) => el.addEventListener('input', update));
  update();
</script>

<style>
  h1 { font-size: 24px; margin: 0 0 18px; }
  .qa-page { max-width: 1000px; }
  [hidden] { display: none !important; }
  .qa-msg { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 340px); gap: 22px; align-items: start; }
  .qa-msg.qa-msg-solo { grid-template-columns: minmax(0, 1fr); }
  .qa-msg-fields { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .qa-card-options { display: flex; flex-direction: column; gap: 16px; }
  .qa-make { align-self: flex-start; margin-top: 4px; }
  .qa-colorbox { display: flex; align-items: center; gap: 10px; }
  .qa-colorbox input { flex: 1; }
  .qa-swatch { flex: none; width: 36px; height: 36px; border-radius: 10px; border: 1px solid var(--border); background: transparent; transition: background-color 0.3s ease; }
  .qa-preview { position: sticky; top: 8px; min-width: 0; }
  .qa-card { border: 1px solid var(--border); border-left: 4px solid var(--qa-accent); border-radius: 12px; background: var(--bg-raise, var(--card)); padding: 14px; display: flex; flex-direction: column; gap: 12px; }
  .qa-title { font-size: 16px; font-weight: 700; }
  .qa-title a { color: var(--accent); }
  .qa-badge { color: var(--qa-accent); }
  .qa-h2 { font-size: 14px; font-weight: 700; margin-bottom: 4px; }
  .qa-card hr { border: none; border-top: 1px solid var(--border-soft); margin: 2px 0; }
  .qa-hero { height: 110px; border-radius: 8px; background: linear-gradient(135deg, color-mix(in srgb, var(--qa-accent) 70%, #000), var(--qa-accent)); transition: background 0.3s ease; }
  .qa-lines { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--text-muted); }
  .qa-lines b { color: var(--text); }
  .qa-buttons { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
  .qa-buttons span { font-size: 12px; padding: 5px 10px; border-radius: 6px; background: var(--bg-raise); color: var(--text); }
  .qa-types { display: flex; flex-direction: column; gap: 10px; }
  .qa-types-head { display: grid; grid-template-columns: minmax(110px, 1fr) minmax(0, 2fr) minmax(0, 2fr); gap: 10px; font-size: 12px; color: var(--text-dim); }
  .qa-type { display: grid; grid-template-columns: minmax(110px, 1fr) minmax(0, 2fr) minmax(0, 2fr); align-items: center; gap: 10px; }
  @media (max-width: 860px) { .qa-msg { grid-template-columns: minmax(0, 1fr); } .qa-preview { position: static; } }
  @media (max-width: 720px) {
    .qa-types-head { display: none; }
    .qa-type { grid-template-columns: 1fr; gap: 6px; padding: 10px 0; border-top: 1px solid var(--border-soft); }
  }
</style>
