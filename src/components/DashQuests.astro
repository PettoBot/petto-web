---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  config: { enabled: boolean; channelId: string; roleId: string; style: string; embedTemplate: string; rewardKinds: string[]; taskKinds: string[]; hideSections: string[]; accentColor: string; expiringHours: number };
  channels: { id: string; name: string }[];
  roles: { id: string; name: string }[];
  embedTemplateNames: string[];
  ready: boolean;
  saved: boolean;
}
const { user, guildId, guildName, guildIcon, config, channels, roles, embedTemplateNames, ready, saved } = Astro.props;
const rewardKinds = [['orbs', 'Orbs'], ['decoration', 'Collectibles (decorations, effects)'], ['code', 'Codes'], ['ingame', 'In-game items'], ['nitro', 'Nitro']];
const taskKinds = [['video', 'Watch a video'], ['play', 'Play a game'], ['stream', 'Stream'], ['activity', 'Activities']];
const sections = [['image', 'Picture'], ['rewards', 'Rewards'], ['tasks', 'Tasks'], ['platforms', 'Platforms'], ['limits', 'Region and age limits']];
const sample = { name: 'Watch the trailer', game: 'March of Giants', publisher: 'Ubisoft', reward: '200 Orbs', task: 'Watch a video (2 min)', platforms: 'Desktop, Mobile', limits: 'Only in US · 18+' };
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="quests" pageTitle="Quests">
  <h1>{dt('Quest alerts')}</h1>
  <p class="qa-sub"><Fragment set:html={dth('A message in a channel of <b>{a}</b> when a new Discord Quest appears. In testing: only Petto\'s team can see this page for now.', { a: (guildName) })} /></p>
  {saved && <div class="qa-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {!ready && <div class="qa-flash qa-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}

  <div class="qa-grid">
    <form method="POST" class="qa-form">
      <label class="qa-check"><input type="checkbox" name="enabled" checked={config.enabled} />{dt('Send alerts')}</label>
      <div class="qa-field"><label>{dt('Channel')}</label><select name="channel_id"><option value="">{dt('None')}</option>{channels.map((ch) => <option value={ch.id} selected={ch.id === config.channelId}>#{ch.name}</option>)}</select></div>
      <div class="qa-field"><label>{dt('Role to ping')}</label><select name="role_id"><option value="">{dt('None')}</option>{roles.map((r) => <option value={r.id} selected={r.id === config.roleId}>{r.name}</option>)}</select></div>

      <div class="qa-field"><label>{dt('Message style')}</label>
        <select name="style" id="qa-style"><option value="card" selected={config.style !== 'template'}>{dt('Petto card')}</option><option value="template" selected={config.style === 'template'}>{dt('A saved embed')}</option></select>
      </div>
      <div class="qa-field" id="qa-template-field"><label>{dt('Saved embed')}</label>
        <select name="embed_template" data-dp-template-only><option value="">{dt('None')}</option>{embedTemplateNames.map((name) => <option value={name} selected={name === config.embedTemplate}>{name}</option>)}</select>
        <span class="qa-note">{dt('It can use the quest variables, such as {quest.name}, {quest.reward} and {quest.expires}. If it is missing, the card is sent.')}</span>
      </div>

      <fieldset class="qa-set"><legend>{dt('Only these rewards')}</legend>
        {rewardKinds.map(([value, label]) => <label class="qa-check"><input type="checkbox" name="reward_kinds" value={value} checked={config.rewardKinds.includes(value)} />{dt(label)}</label>)}
        <span class="qa-note">{dt('Leave all empty for every reward.')}</span>
      </fieldset>
      <fieldset class="qa-set"><legend>{dt('Only these tasks')}</legend>
        {taskKinds.map(([value, label]) => <label class="qa-check"><input type="checkbox" name="task_kinds" value={value} checked={config.taskKinds.includes(value)} />{dt(label)}</label>)}
        <span class="qa-note">{dt('Leave all empty for every task.')}</span>
      </fieldset>

      <fieldset class="qa-set" id="qa-card-options"><legend>{dt('What the card hides')}</legend>
        {sections.map(([value, label]) => <label class="qa-check"><input type="checkbox" name={`hide_${value}`} data-hide={value} checked={config.hideSections.includes(value)} />{dt(label)}</label>)}
        <div class="qa-field"><label>{dt('Card color')}</label><input type="text" name="accent_color" id="qa-color" value={config.accentColor} placeholder="#ff91c2" maxlength="7" /><span class="qa-note">{dt('Empty uses the color of each quest.')}</span></div>
      </fieldset>

      <div class="qa-field"><label>{dt('Also alert before a quest ends (hours, 0 is off)')}</label><input type="number" name="expiring_hours" min="0" max="168" value={config.expiringHours} /></div>
      <button type="submit" class="btn btn-accent btn-sm" disabled={!ready}>{dt('Save changes')}</button>
    </form>

    <aside class="qa-preview" aria-label={dt('Preview')}>
      <div class="qa-eyebrow">{dt('Preview')}</div>
      <div class="qa-card" id="qa-card" style={`--qa-accent:${config.accentColor || '#4752c4'}`}>
        <div class="qa-card-head"><div><b>{sample.name}</b><span>{sample.game} · {sample.publisher}</span></div><div class="qa-logo" aria-hidden="true"></div></div>
        <div class="qa-hero" data-part="image" aria-hidden="true"></div>
        <div class="qa-lines">
          <div data-part="rewards"><b>{dt('Reward')}:</b> {sample.reward}</div>
          <div data-part="tasks"><b>{dt('Task')}:</b> {sample.task}</div>
          <div data-part="platforms"><b>{dt('Platforms')}:</b> {sample.platforms}</div>
          <div><b>{dt('Starts')}:</b> {dt('1 day ago')} · <b>{dt('Ends')}:</b> {dt('in 5 days')}</div>
          <div data-part="limits"><b>{dt('Limits')}:</b> {sample.limits}</div>
        </div>
        <div class="qa-buttons"><span>{dt('Accept Quest')}</span><span>{dt('Game page')}</span></div>
        <div class="qa-credit">{dt('Data from discordquest.com')}</div>
      </div>
      <p class="qa-note">{dt('A rough preview. Discord draws the real message.')}</p>
    </aside>
  </div>
</DashGuildLayout>

<script>
  const card = document.getElementById('qa-card');
  const color = document.getElementById('qa-color') as HTMLInputElement | null;
  const style = document.getElementById('qa-style') as HTMLSelectElement | null;
  function update() {
    document.querySelectorAll<HTMLInputElement>('[data-hide]').forEach((box) => {
      card?.querySelectorAll<HTMLElement>(`[data-part="${box.dataset.hide}"]`).forEach((el) => { el.hidden = box.checked; });
    });
    if (card && color) card.style.setProperty('--qa-accent', /^#?[0-9a-f]{6}$/i.test(color.value.trim()) ? `#${color.value.trim().replace('#', '')}` : '#4752c4');
    const useTemplate = style?.value === 'template';
    document.getElementById('qa-template-field')?.toggleAttribute('hidden', !useTemplate);
    document.getElementById('qa-card-options')?.toggleAttribute('hidden', useTemplate);
    document.getElementById('qa-card')?.toggleAttribute('hidden', useTemplate);
  }
  document.querySelectorAll('[data-hide], #qa-color, #qa-style').forEach((el) => el.addEventListener('input', update));
  update();
</script>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  .qa-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 20px; max-width: 68ch; }
  .qa-sub :global(b) { color: var(--text); }
  .qa-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 16px; max-width: 640px; }
  .qa-flash-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: var(--yellow); }
  .qa-grid { display: grid; grid-template-columns: minmax(0, 640px) minmax(260px, 340px); gap: 28px; align-items: start; }
  @media (max-width: 960px) { .qa-grid { grid-template-columns: 1fr; } }
  .qa-form { display: flex; flex-direction: column; gap: 16px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 20px; }
  .qa-field { display: flex; flex-direction: column; gap: 6px; }
  .qa-field label { font-size: 12px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.03em; }
  .qa-field input, .qa-field select { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; }
  .qa-note { font-size: 11.5px; line-height: 1.4; color: var(--text-dim); }
  .qa-set { border: 1px solid var(--border-soft); border-radius: 10px; padding: 12px 14px; display: flex; flex-direction: column; gap: 8px; }
  .qa-set legend { font-size: 12px; font-weight: 600; color: var(--text-dim); padding: 0 6px; }
  .qa-check { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--text); }
  [hidden] { display: none !important; }
  .qa-preview { position: sticky; top: 16px; }
  .qa-eyebrow { font-size: 12px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 8px; }
  .qa-card { border: 1px solid var(--border); border-left: 4px solid var(--qa-accent); border-radius: 10px; background: var(--card); padding: 14px; display: flex; flex-direction: column; gap: 12px; }
  .qa-card-head { display: flex; justify-content: space-between; gap: 12px; }
  .qa-card-head b { display: block; font-size: 15px; }
  .qa-card-head span { font-size: 12.5px; color: var(--text-muted); }
  .qa-logo { width: 44px; height: 44px; border-radius: 10px; background: color-mix(in srgb, var(--qa-accent) 40%, var(--bg-raise)); flex-shrink: 0; }
  .qa-hero { height: 110px; border-radius: 8px; background: linear-gradient(135deg, color-mix(in srgb, var(--qa-accent) 70%, #000), var(--qa-accent)); }
  .qa-lines { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--text-muted); }
  .qa-lines b { color: var(--text); }
  .qa-buttons { display: flex; gap: 8px; }
  .qa-buttons span { font-size: 12px; padding: 5px 10px; border-radius: 6px; background: var(--bg-raise); color: var(--text); }
  .qa-credit { font-size: 11px; color: var(--text-dim); }
</style>
