---
import { Icon } from 'astro-icon/components';
import DashMeLayout from './DashMeLayout.astro';
import type { Session } from '../utils/session';
import { getDashLang, makeT } from '../i18n/dash';
import DashClientI18n from './DashClientI18n.astro';
import DashPanelHead from './DashPanelHead.astro';
import { MAX_PER_POSITION } from '../utils/team';

const dt = makeT(getDashLang(Astro));
interface Member { rowId: number; id: string; username: string; displayName: string; avatarUrl: string }
interface Props {
  user: Session;
  sections: { position: string; members: Member[] }[];
  custom: boolean;
  error?: string;
  saved?: boolean;
  added?: number;
  skipped?: number;
}
const { user, sections, custom, error, saved = false, added = 0, skipped = 0 } = Astro.props;

const titles: Record<string, string> = {
  owners: dt('Owners'),
  programming: dt('Programming'),
  support: dt('Support'),
  legal: dt('Legal'),
  test: dt('Testing'),
};
const errors: Record<string, string> = {
  invalid: dt('That request was not valid.'),
  nothing: dt('Paste at least one Discord ID or mention.'),
  full: dt('That position would pass {max} people.', { max: MAX_PER_POSITION }),
  database: dt('The database did not accept the change. Try again.'),
  not_configured: dt('The dashboard is not connected to the bot database.'),
};
---

<DashMeLayout user={user} active="staff-team" pageTitle="Team">
      <div class="tm-wrap">
        <DashPanelHead title={dt('Team')} eyebrow={dt('Staff')} icon="ph:users-three-fill" back={false}>
          <a class="btn btn-ghost btn-sm" href="/team" target="_blank" rel="noopener"><Icon name="ph:arrow-square-out" width="14" height="14" /> {dt('See the page')}</a>
        </DashPanelHead>

        {error && <div class="tm-alert error"><Icon name="ph:warning-fill" width="17" height="17" /> {errors[error] ?? errors.invalid}</div>}
        {saved && !error && <div class="tm-alert success"><Icon name="ph:check-circle-fill" width="17" height="17" /> {added ? dt('Saved: {n} added.', { n: added }) : dt('Saved.')}{skipped ? ' ' + (skipped === 1 ? dt('1 was already there.') : dt('{n} were already there.', { n: skipped })) : ''}</div>}

        {!custom && (
          <div class="tm-banner">
            <p>{dt('The page shows the original list. Start editing to save it, then change it as you like.')}</p>
            <form method="POST" data-no-dirty><input type="hidden" name="action" value="start" /><button class="btn btn-primary btn-sm" type="submit"><Icon name="ph:pencil-simple-fill" width="14" height="14" /> {dt('Start editing')}</button></form>
          </div>
        )}

        {sections.map((section) => (
          <article class="tm-block" id={section.position}>
            <header>
              <h2>{titles[section.position]}</h2>
              <span class="tm-count">{section.members.length} / {MAX_PER_POSITION}</span>
            </header>
            {section.members.length === 0 ? <p class="tm-empty"><Icon name="ph:user-circle-dashed-fill" width="16" height="16" />{dt('Nobody here. The position is hidden on the page.')}</p> : (
              <ul class="tm-list dgl-stagger">
                {section.members.map((member, index) => (
                  <li class="tm-row">
                    <img class="tm-avatar" src={member.avatarUrl} alt="" width="38" height="38" loading="lazy" />
                    <div class="tm-who"><strong>{member.displayName}</strong><span>@{member.username} · {member.id}</span></div>
                    {custom && (
                      <div class="tm-actions">
                        <form method="POST" data-no-dirty><input type="hidden" name="row_id" value={member.rowId} /><input type="hidden" name="position" value={section.position} /><button class="btn btn-ghost btn-sm" name="action" value="up" type="submit" disabled={index === 0} aria-label={dt('Move up')} title={dt('Move up')}><Icon name="ph:arrow-up" width="14" height="14" /></button></form>
                        <form method="POST" data-no-dirty><input type="hidden" name="row_id" value={member.rowId} /><input type="hidden" name="position" value={section.position} /><button class="btn btn-ghost btn-sm" name="action" value="down" type="submit" disabled={index === section.members.length - 1} aria-label={dt('Move down')} title={dt('Move down')}><Icon name="ph:arrow-down" width="14" height="14" /></button></form>
                        <form method="POST" data-remove data-no-dirty data-name={member.displayName}><input type="hidden" name="row_id" value={member.rowId} /><input type="hidden" name="position" value={section.position} /><button class="btn btn-danger btn-sm" name="action" value="remove" type="submit"><Icon name="ph:trash-fill" width="14" height="14" /> {dt('Remove')}</button></form>
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            )}
            {custom && section.members.length < MAX_PER_POSITION && (
              <form method="POST" class="tm-add" data-no-dirty>
                <input type="hidden" name="action" value="add" />
                <input type="hidden" name="position" value={section.position} />
                <textarea name="ids" rows="2" placeholder={dt('Discord IDs or mentions, separated by spaces or lines')} required></textarea>
                <button class="btn btn-ghost btn-sm" type="submit"><Icon name="ph:user-plus-fill" width="14" height="14" /> {dt('Add')}</button>
              </form>
            )}
          </article>
        ))}

        {custom && (
          <form method="POST" class="tm-reset" data-reset data-no-dirty>
            <input type="hidden" name="action" value="reset" />
            <button class="btn btn-danger btn-sm" type="submit"><Icon name="ph:arrow-counter-clockwise-fill" width="14" height="14" /> {dt('Go back to the original list')}</button>
          </form>
        )}
      </div>
</DashMeLayout>

<DashClientI18n />
<script>
declare function cdt(key: string, vars?: Record<string, string | number>): string;
  document.querySelectorAll<HTMLFormElement>('form[data-remove]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      if (!window.confirm(cdt('Remove {name} from this position?', { name: form.dataset.name ?? '' }))) event.preventDefault();
    });
  });
  document.querySelectorAll<HTMLFormElement>('form[data-reset]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      if (!window.confirm(cdt('Delete the saved team and show the original list again?'))) event.preventDefault();
    });
  });
</script>

<style>
  .tm-wrap { max-width: 860px; min-width: 0; margin: 0 auto; }
  .tm-actions .btn, .tm-add .btn { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .tm-alert { display: flex; align-items: center; gap: 9px; padding: 12px 14px; border-radius: 12px; margin: 12px 0; font-size: 13.5px; animation: m-rise-in var(--m-slow) var(--m-out) both; }
  .tm-alert.error { color: var(--red); background: var(--red-soft); border: 1px solid color-mix(in srgb, var(--red) 55%, var(--border)); }
  .tm-alert.success { color: var(--green); background: var(--green-soft); border: 1px solid color-mix(in srgb, var(--green) 55%, var(--border)); }
  .tm-banner { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 16px; border: 1px dashed var(--border); border-radius: 14px; margin-bottom: 12px; }
  .tm-banner p { margin: 0; color: var(--text-muted); font-size: 14px; }
  .tm-banner form { margin: 0; }
  .tm-block { border: 1px solid var(--border-soft); border-radius: 16px; background: color-mix(in srgb, var(--text) 2%, transparent); padding: 18px 20px 20px; margin-bottom: 12px; min-width: 0; }
  .tm-block header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
  .tm-block h2 { margin: 0; font-size: 15.5px; font-weight: 700; }
  .tm-count { font-family: var(--mono); font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 999px; background: var(--bg-raise); color: var(--text-dim); }
  .tm-empty { display: flex; align-items: center; gap: 8px; margin: 4px 0 12px; padding: 12px 14px; border: 1px dashed var(--border); border-radius: 12px; color: var(--text-dim); font-size: 13px; }
  .tm-empty :global(svg) { flex: none; color: var(--accent); }
  .tm-list { list-style: none; margin: 0 0 12px; padding: 0; display: grid; gap: 8px; }
  .tm-row { display: flex; align-items: center; gap: 12px; padding: 8px 10px; border: 1px solid var(--border-soft); border-radius: 12px; background: color-mix(in srgb, var(--bg-raise) 45%, transparent); min-width: 0; }
  .tm-avatar { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; flex: 0 0 auto; }
  .tm-who { min-width: 0; flex: 1; }
  .tm-who strong, .tm-who span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tm-who strong { font-size: 14px; }
  .tm-who span { margin-top: 2px; color: var(--text-dim); font-size: 11px; font-family: var(--mono); }
  .tm-actions { display: flex; gap: 6px; flex: 0 0 auto; }
  .tm-actions form { margin: 0; }
  .tm-add { display: flex; gap: 10px; align-items: flex-start; }
  .tm-add textarea { flex: 1; min-width: 0; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg-raise); color: var(--text); font: inherit; font-size: 13px; resize: vertical; }
  .tm-reset { margin-top: 22px; display: flex; justify-content: center; }
  .btn-danger { background: transparent; color: var(--red); border-color: color-mix(in srgb, var(--red) 55%, var(--border)); }
  .btn-danger:hover { background: var(--red-soft); }
  @media (max-width: 760px) {
    .tm-block { padding: 14px; }
    .tm-banner { flex-direction: column; align-items: stretch; }
    .tm-row { flex-wrap: wrap; }
    .tm-who { flex: 1 1 calc(100% - 55px); }
    .tm-actions { flex: 1 1 100%; justify-content: flex-end; }
    .tm-add { flex-direction: column; align-items: stretch; }
    .tm-add textarea { width: 100%; box-sizing: border-box; }
    .tm-add .btn { align-self: stretch; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) { .tm-alert { animation: none; } }
</style>
