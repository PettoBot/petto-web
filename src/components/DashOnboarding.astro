  .ob-sec { display: flex; flex-direction: column; gap: 11px; min-width: 0; padding: 14px; border: 1px solid var(--border-soft, var(--border)); border-radius: 12px; background: color-mix(in srgb, var(--bg-raise) 55%, transparent); }
