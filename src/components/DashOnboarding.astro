              <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#a5ea7a"><Icon name="ph:list-checks-fill" width="17" height="17" /></span><h2>{dt('Setup')}</h2><span class:list={['sx-tag', { 'sx-tag-accent': checklistDone === checklist.length }]}>{dt('{n} of {max}', { n: checklistDone, max: checklist.length })}</span></div>
              <ul class="ob-checks">
                {checklist.map((item) => <li class:list={{ done: item.done }}><Icon name={item.done ? 'ph:check-circle-fill' : 'ph:circle'} width="18" height="18" /><span>{item.label}</span></li>)}
