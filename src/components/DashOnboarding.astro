  .ob-chk .sx-toggle-only input:focus-visible ~ .sx-toggle { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ob-chk .sx-toggle-only input:disabled ~ .sx-toggle { opacity: .55; }
  .ob-chk-more { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 10px; padding-top: 10px; margin-top: 4px; border-top: 1px solid var(--border-soft); }
  .ob-chk-more .sx-field input[type=number], .ob-chk-more .sx-field input[type=text] { border: 1px solid var(--border); border-radius: 9px; padding: 9px 11px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; width: 100%; box-sizing: border-box; min-width: 0; }
