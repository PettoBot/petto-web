              <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#fed53c"><Icon name="ph:arrow-fat-lines-up-fill" width="17" height="17" /></span><h2>{dt('Bump reminder')}</h2></div>
              <p class="sx-lead"><Fragment set:html={dth('Reminds the server to <code>/bump</code> on Disboard once the cooldown ends.')} /></p>
              <div class="sx-field"><label for="ob-bp-ch">{dt('Channel')}</label><select id="ob-bp-ch" name="channel_id" data-fill="ob-ch"><option value="">{dt('Off')}</option><SelectChosen items={channels} selected={bump.channelId} prefix="#" /></select></div>
              <div class="sx-field ob-row"><label for="ob-bp-msg">{dt('Reminder message')}</label><textarea id="ob-bp-msg" class="dgl-autogrow" rows="2" name="message" data-ac data-dp data-count maxlength="300" placeholder={dt('It\'s time to /bump the server!')}>{bump.message}</textarea><SilentMentionHint /></div>
              <div class="sx-field"><label for="ob-bp-rtpl">{dt('Reminder design')}</label><select id="ob-bp-rtpl" name="reminder_embed_template" data-tpl-locks="message"><option value="">{dt('Usual message')}</option>{embedTemplateNames.map((n) => <option value={n} selected={n === bump.reminderTemplate}>{n}</option>)}</select></div>
              <div class="sx-field"><label for="ob-bp-thx">{dt('Thank-you message')}</label><textarea id="ob-bp-thx" class="dgl-autogrow" rows="2" name="thankyou" data-ac data-count maxlength="300" placeholder={dt('{user.mention} successfully bumped! Bump again {nextBump}.')}>{bump.thankyou}</textarea><SilentMentionHint /></div>
              <div class="sx-field"><label for="ob-bp-ttpl">{dt('Thank-you design')}</label><select id="ob-bp-ttpl" name="thankyou_embed_template" data-tpl-locks="thankyou"><option value="">{dt('Usual message')}</option>{embedTemplateNames.map((n) => <option value={n} selected={n === bump.thankyouTemplate}>{n}</option>)}</select></div>
              {bump.designReady && <input type="hidden" name="design_ready" value="1" />}
            </section>
          </div>
          <div class="ob-col">
            <section class="sx-panel ob-box">
              <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#f0a88f"><Icon name="ph:broom-fill" width="17" height="17" /></span><h2>{dt('While it waits')}</h2></div>
              <div class="ob-toggles">
                <label class="sx-switch"><input type="checkbox" name="pingable" checked={bump.pingable} /><span class="sx-switch-text"><b>{dt('Ping everyone when due')}</b></span><i class="sx-toggle"></i></label>
                <label class="sx-switch"><input type="checkbox" name="autolock" checked={bump.autolock} /><span class="sx-switch-text"><b>{dt('Lock channel between bumps')}</b></span><i class="sx-toggle"></i></label>
                <label class="sx-switch"><input type="checkbox" name="autoclean" checked={bump.autoclean} /><span class="sx-switch-text"><b>{dt('Auto-delete chatter')}</b></span><i class="sx-toggle"></i></label>
              </div>
            </section>
          </div>
        </div>
        <div class="ob-tools">
          <div class="sx-foot ob-save"><button type="submit" class="btn btn-accent btn-sm">{dt('Save')}</button></div>
          <VariableHelp />
        </div>
      </form>
