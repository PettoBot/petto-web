---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import VariableHelp from './VariableHelp.astro';
import SelectSource from './SelectSource.astro';
import SelectChosen from './SelectChosen.astro';
import DashAcData from './DashAcData.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface MemberEvents {
  welcomeChannelId: string | null;
  welcomeMessage: string;
  welcomeEmbedTemplate: string;
  leaveChannelId: string | null;
  leaveMessage: string;
  leaveEmbedTemplate: string;
  boostChannelId: string | null;
  boostMessage: string;
  boostEmbedTemplate: string;
  boostLevelMessage: string;
  boostLevelEmbedTemplate: string;
}
interface Verification { methodReady: boolean; method: string; designReady: boolean; promptTemplate: string; verifiedTemplate: string; enabled: boolean; unverifiedRoleId: string | null; verifiedRoleId: string | null; panelReady: boolean; panelChannelId: string | null; }
interface Bump { designReady: boolean; thankyouTemplate: string; reminderTemplate: string; channelId: string | null; message: string; thankyou: string; pingable: boolean; autolock: boolean; autoclean: boolean; }
interface DmJoin { message: string; embedTemplate: string; }
interface PingOnJoin { enabled: boolean; channelIds: string[]; delaysSeconds: Record<string, number>; }
interface JoinRole { roleId: string; target: string; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  memberEvents: MemberEvents;
  verification: Verification;
  bump: Bump;
  dmJoin: DmJoin;
  pingOnJoin: PingOnJoin;
  joinRoles: JoinRole[];
  roles: { id: string; name: string }[];
  channels: { id: string; name: string; canPost?: boolean }[];
  embedTemplateNames: string[];
  saved: boolean;
}
const { user, guildId, guildName, guildIcon, memberEvents, verification, bump, dmJoin, pingOnJoin, joinRoles, roles, embedTemplateNames, saved } = Astro.props;
// A channel where Petto cannot see or write says so in every list of this page (the welcome, the ping on join, the verification panel...), because nothing would arrive there.
const channels = Astro.props.channels.map((c) => (c.canPost === false ? { ...c, name: `${c.name} (${dt('Petto cannot post here')})` } : c));
const closedPings = Astro.props.channels.filter((c) => c.canPost === false && pingOnJoin.channelIds.includes(c.id)).map((c) => `#${c.name}`);

function roleName(id: string) {
  return roles.find((r) => r.id === id)?.name ?? id;
}
const pingRowsJson = JSON.stringify(channels.map((c) => [c.id, c.name, pingOnJoin.channelIds.includes(c.id) ? 1 : 0, pingOnJoin.delaysSeconds[c.id] ?? 5])).replace(/</g, '\\u003c');
function targetLabel(target: string) {
  return target === 'humans' ? dt('Humans only') : target === 'bots' ? dt('Bots only') : dt('Everyone');
}
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="onboarding" pageTitle="Onboarding">
  <h1>{dt('Onboarding')}</h1>
  <DashAcData roles={roles} channels={channels} />

  {saved && <div class="ob-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}

  <div class="ob-tabs" role="tablist" aria-label={dt('Onboarding')}>
    <button type="button" class="ob-tab" role="tab" data-ob-tab="messages"><Icon name="ph:hand-waving-fill" width="15" height="15" /><span>{dt('Messages')}</span><i class="ob-dot"></i></button>
    <button type="button" class="ob-tab" role="tab" data-ob-tab="verification"><Icon name="ph:seal-check-fill" width="15" height="15" /><span>{dt('Verification')}</span><i class="ob-dot"></i></button>
    <button type="button" class="ob-tab" role="tab" data-ob-tab="arrival"><Icon name="ph:user-plus-fill" width="15" height="15" /><span>{dt('Roles and DM')}</span><i class="ob-dot"></i></button>
    <button type="button" class="ob-tab" role="tab" data-ob-tab="ping"><Icon name="ph:bell-ringing-fill" width="15" height="15" /><span>{dt('Ping on join')}</span><i class="ob-dot"></i></button>
    <button type="button" class="ob-tab" role="tab" data-ob-tab="bump"><Icon name="ph:arrow-fat-lines-up-fill" width="15" height="15" /><span>{dt('Bump')}</span><i class="ob-dot"></i></button>
  </div>

  <div class="ob-panels" id="ob-panels">
    <section class="ob-panel" data-ob-panel="messages">
      <div class="ob-one">
    <form method="POST" class="ob-card">
      <input type="hidden" name="action" value="events" />
      <div class="ob-secs">
      <div class="ob-sec">
      <div class="ob-card-head"><div class="ob-card-icon" style="--c:#a5ea7a"><Icon name="ph:hand-waving-fill" width="16" height="16" /></div><div class="ob-card-title">{dt('Welcome')}</div></div>
      <div class="ob-row"><label>{dt('Channel')}</label><select name="welcome_channel_id" data-fill="ob-ch"><option value="">{dt('Off')}</option><SelectChosen items={channels} selected={memberEvents.welcomeChannelId} prefix="#" /></select></div>
      <div class="ob-row"><label>{dt('Message')}</label><textarea class="dgl-autogrow" rows="2" name="welcome_message" data-ac data-dp data-dp-template="welcome_embed_template" maxlength="300" placeholder={dt('Welcome {user} to {server_name}!')}>{memberEvents.welcomeMessage}</textarea></div>
      {embedTemplateNames.length > 0 && (
        <div class="ob-row"><label>{dt('Or use an embed template')}</label><select name="welcome_embed_template"><option value="">{dt('No template, use message text above')}</option>{embedTemplateNames.map((n) => <option value={n} selected={n === memberEvents.welcomeEmbedTemplate}>{n}</option>)}</select></div>
      )}
      </div>
      <div class="ob-sec">
      <div class="ob-card-head"><div class="ob-card-icon" style="--c:#94a3b8"><Icon name="ph:door-fill" width="16" height="16" /></div><div class="ob-card-title">{dt('Leave')}</div></div>
      <div class="ob-row"><label>{dt('Channel')}</label><select name="leave_channel_id" data-fill="ob-ch"><option value="">{dt('Off')}</option><SelectChosen items={channels} selected={memberEvents.leaveChannelId} prefix="#" /></select></div>
      <div class="ob-row"><label>{dt('Message')}</label><textarea class="dgl-autogrow" rows="2" name="leave_message" data-ac data-dp data-dp-template="leave_embed_template" maxlength="300" placeholder={dt('{user} left the server.')}>{memberEvents.leaveMessage}</textarea></div>
      {embedTemplateNames.length > 0 && (
        <div class="ob-row"><label>{dt('Or use an embed template')}</label><select name="leave_embed_template"><option value="">{dt('No template, use message text above')}</option>{embedTemplateNames.map((n) => <option value={n} selected={n === memberEvents.leaveEmbedTemplate}>{n}</option>)}</select></div>
      )}
      </div>
      <div class="ob-sec">
      <div class="ob-card-head"><div class="ob-card-icon" style="--c:#f78fb3"><Icon name="ph:sparkle-fill" width="16" height="16" /></div><div class="ob-card-title">{dt('Boost')}</div></div>
      <div class="ob-row"><label>{dt('Channel')}</label><select name="boost_channel_id" data-fill="ob-ch"><option value="">{dt('Off')}</option><SelectChosen items={channels} selected={memberEvents.boostChannelId} prefix="#" /></select></div>
      <div class="ob-row"><label>{dt('Message')}</label><textarea class="dgl-autogrow" rows="2" name="boost_message" data-ac data-dp data-dp-template="boost_embed_template" maxlength="300" placeholder={dt('{user} just boosted the server!')}>{memberEvents.boostMessage}</textarea></div>
      {embedTemplateNames.length > 0 && (
        <div class="ob-row"><label>{dt('Or use an embed template')}</label><select name="boost_embed_template"><option value="">{dt('No template, use message text above')}</option>{embedTemplateNames.map((n) => <option value={n} selected={n === memberEvents.boostEmbedTemplate}>{n}</option>)}</select></div>
      )}
      <div class="ob-row"><label>{dt('Boost tier reached message')}</label><textarea class="dgl-autogrow" rows="2" name="boost_level_message" data-ac data-dp data-dp-template="boost_level_embed_template" maxlength="300" placeholder={dt('{server_name} just reached a new boost tier!')}>{memberEvents.boostLevelMessage}</textarea></div>
      {embedTemplateNames.length > 0 && (
        <div class="ob-row"><label>{dt('Or use an embed template')}</label><select name="boost_level_embed_template"><option value="">{dt('No template, use message text above')}</option>{embedTemplateNames.map((n) => <option value={n} selected={n === memberEvents.boostLevelEmbedTemplate}>{n}</option>)}</select></div>
      )}
      </div>
      </div>

      <button type="submit" class="btn btn-ghost btn-sm">{dt('Save')}</button>
      {embedTemplateNames.length > 0 && <p class="ob-card-desc">{dt('Templates are managed on the Embeds page.')}</p>}
      <VariableHelp />
    </form>

      </div>
    </section>
    <section class="ob-panel" data-ob-panel="verification" hidden>
      <div class="ob-one">
      <form method="POST" class="ob-card ob-cols">
        <input type="hidden" name="action" value="verification" />
        <div class="ob-card-head">
          <div class="ob-card-icon" style="--c:var(--accent)"><Icon name="ph:seal-check-fill" width="16" height="16" /></div>
          <div class="ob-card-title">{dt('Verification')}</div>
          <label class="ob-switch"><input type="checkbox" name="enabled" checked={verification.enabled} data-vf-switch data-no-dirty /><span></span></label>
        </div>
        <div class="ob-auto"><div><strong>{dt('Set it up for me')}</strong><span>{dt('Makes the roles and a #verify channel, posts the panel and turns verification on. What you already chose is kept.')}</span></div><button type="button" class="btn btn-accent btn-sm" data-vf-action="setup"><Icon name="ph:magic-wand-fill" width="14" height="14" /> {dt('Set it up')}</button></div>
        <p class="ob-vf-msg" id="ob-vf-msg" role="status" hidden data-working={dt('Working on it…')} data-failed={dt('It could not be done. Try again.')} data-lost={dt('Petto stopped answering about the setup. Check the server and try again.')}></p>
        <div class="ob-vf-progress" id="ob-vf-progress" hidden data-starting={dt('Starting…')} data-roles={dt('Making the roles…')} data-channels={dt('Setting up… {done}/{total} channels')} data-panel={dt('Posting the panel…')}>
          <div class="ob-vf-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
          <span class="ob-vf-step" aria-live="polite"></span>
        </div>
        <p class="ob-vf-warn" id="ob-vf-warn" hidden data-missing={dt('Members cannot get a verification link right now: Petto\'s VERIFY_BASE_URL is not set.')} data-secret={dt('Members cannot get a verification link right now: Petto\'s VERIFY_TOKEN_SECRET is not set.')} data-invalid={dt('Members cannot get a verification link right now: Petto\'s VERIFY_BASE_URL is not a web address.')} data-local={dt('Members cannot get a verification link right now: Petto\'s VERIFY_BASE_URL points to localhost, which only opens on the bot\'s computer.')} data-letters={dt('Until it is fixed, the panel offers the letters inside Discord instead.')}></p>
        <p class="ob-card-desc">{dt('A Cloudflare Turnstile captcha gate, new members must pass it to get in.')}</p>
        <div class="ob-row"><label>{dt('Role while unverified')}</label><select name="unverified_role_id" data-give-role data-fill="ob-roles"><option value="">{dt('None')}</option><SelectChosen items={roles} selected={verification.unverifiedRoleId} /></select></div>
        <div class="ob-row"><label>{dt('Role once verified')}</label><select name="verified_role_id" data-give-role data-fill="ob-roles"><option value="">{dt('None')}</option><SelectChosen items={roles} selected={verification.verifiedRoleId} /></select></div>
        <div class="ob-row"><label>{dt('How members verify')}</label><select name="method" disabled={!verification.methodReady}>
          <option value="turnstile" selected={verification.method === 'turnstile'}>{dt('Cloudflare check')}</option>
          <option value="letters" selected={verification.method === 'letters'}>{dt('Letters in a picture')}</option>
          <option value="both" selected={verification.method === 'both'}>{dt('Both checks')}</option>
          <option value="discord" selected={verification.method === 'discord'}>{dt('Letters inside Discord (no link)')}</option>
        </select></div>
        {verification.methodReady && <input type="hidden" name="method_ready" value="1" />}
        <p class="ob-sub">{dt('The Cloudflare check is the usual one. With letters, members type the letters of a picture (the link page needs no Cloudflare), on the page or with a button in the DM. With both, they do the two. Inside Discord, they only press a button in the DM and type the letters there, with no link at all.')}</p>
        <div class="ob-row"><label>{dt('Verification DM design')}</label><select name="prompt_embed_template" data-dp-template-only><option value="">{dt('Usual message')}</option>{embedTemplateNames.map((n) => <option value={n} selected={n === verification.promptTemplate}>{n}</option>)}</select></div>
        <div class="ob-row"><label>{dt('Verified DM design')}</label><select name="verified_embed_template" data-dp-template-only><option value="">{dt('Usual message')}</option>{embedTemplateNames.map((n) => <option value={n} selected={n === verification.verifiedTemplate}>{n}</option>)}</select></div>
        <div class="ob-row"><label>{dt('Verification channel')}</label><select name="panel_channel_id" disabled={!verification.panelReady} data-fill="ob-ch"><option value="">{dt('Off')}</option><SelectChosen items={channels} selected={verification.panelChannelId} prefix="#" /></select></div>
        {verification.panelReady && <input type="hidden" name="panel_ready" value="1" />}
        <div class="ob-row"><label>{dt('Panel')}</label><button type="button" class="btn btn-ghost btn-sm" data-vf-action="panel" disabled={!verification.panelReady}><Icon name="ph:paper-plane-tilt-fill" width="14" height="14" /> {dt('Send the panel now')}</button></div>
        <label class="ob-check"><input type="checkbox" name="panel_repost" />{dt('Post the panel again when I save')}</label>
        <p class="ob-sub">{dt('Petto posts a panel there with the verify buttons, so members can verify in the server and not only by DM. Only the member who presses a button sees the picture. Changing the method? Post the panel again.')}</p>
        {verification.designReady && <input type="hidden" name="design_ready" value="1" />}
        <p class="ob-sub">{dt('A saved design for the DM with the link. Put {verify.link} where the link goes.')}</p>
        <button type="submit" class="btn btn-ghost btn-sm">{dt('Save')}</button>
      </form>

      </div>
    </section>
    <section class="ob-panel" data-ob-panel="arrival" hidden>
      <div class="ob-grid">
      <div class="ob-card">
        <div class="ob-card-head"><div class="ob-card-icon" style="--c:#7ac45a"><Icon name="ph:user-plus-fill" width="16" height="16" /></div><div class="ob-card-title">{dt('Join roles')}</div></div>
        <p class="ob-card-desc">{dt('Roles given automatically the moment someone joins.')}</p>
        {joinRoles.length > 0 && (
          <div class="ob-jr-list">
            {joinRoles.map((jr) => (
              <div class="ob-jr-row">
                <span class="ob-jr-role">{roleName(jr.roleId)}</span>
                <span class="ob-jr-target">{targetLabel(jr.target)}</span>
                <form method="POST" data-no-dirty><input type="hidden" name="action" value="remove_join_role" /><input type="hidden" name="role_id" value={jr.roleId} />
                  <button type="submit" class="ob-jr-del"><Icon name="ph:trash-fill" width="13" height="13" /></button>
                </form>
              </div>
            ))}
          </div>
        )}
        {joinRoles.length === 0 && <p class="ob-empty"><Icon name="ph:user-plus-fill" width="14" height="14" />{dt('No join roles yet. Pick one below.')}</p>}
        <form method="POST" class="ob-jr-add" data-no-dirty>
          <input type="hidden" name="action" value="add_join_role" />
          <select name="role_id" required data-give-role data-fill="ob-roles">
            <option value="" disabled selected>{dt('Role')}</option>
          </select>
          <select name="target">
            <option value="all">{dt('Everyone')}</option>
            <option value="humans">{dt('Humans only')}</option>
            <option value="bots">{dt('Bots only')}</option>
          </select>
          <button type="submit" class="btn btn-ghost btn-sm">{dt('Add')}</button>
        </form>
      </div>

      <form method="POST" class="ob-card ob-cols">
        <input type="hidden" name="action" value="dm_join" />
        <div class="ob-card-head"><div class="ob-card-icon" style="--c:#c792ea"><Icon name="ph:envelope-simple-fill" width="16" height="16" /></div><div class="ob-card-title">{dt('DM on join')}</div></div>
        <p class="ob-card-desc">{dt('A direct message sent to new members, separate from the channel welcome. Leave empty to turn off.')}</p>
        <div class="ob-row"><label>{dt('Message')}</label><textarea class="dgl-autogrow" rows="2" name="dm_join_message" data-ac data-dp data-dp-template="dm_join_embed_template" maxlength="300" placeholder={dt('Welcome to {server_name}! Check out #rules to get started.')}>{dmJoin.message}</textarea></div>
        {embedTemplateNames.length > 0 && (
          <div class="ob-row"><label>{dt('Or use an embed template')}</label><select name="dm_join_embed_template"><option value="">{dt('No template, use message text above')}</option>{embedTemplateNames.map((n) => <option value={n} selected={n === dmJoin.embedTemplate}>{n}</option>)}</select></div>
        )}
        <VariableHelp />
        <button type="submit" class="btn btn-ghost btn-sm">{dt('Save')}</button>
      </form>

      </div>
    </section>
    <section class="ob-panel" data-ob-panel="ping" hidden>
      <div class="ob-one">
      <form method="POST" class="ob-card ob-cols">
        <input type="hidden" name="action" value="ping_on_join" />
        <div class="ob-card-head">
          <div class="ob-card-icon" style="--c:#5eead4"><Icon name="ph:bell-ringing-fill" width="16" height="16" /></div>
          <div class="ob-card-title">{dt('Ping on join')}</div>
          <label class="ob-switch"><input type="checkbox" name="enabled" checked={pingOnJoin.enabled} /><span></span></label>
        </div>
        <p class="ob-card-desc">{dt('Mentions new members in these channels, then cleans the ping up after the delay below (default 5s).')}</p>
        {closedPings.length > 0 && <p class="ob-card-desc ob-warn">{dt('Petto cannot post in {channels}: the ping will not arrive there. Give it View Channel and Send Messages in those channels, or pick others.').replace('{channels}', closedPings.join(', '))}</p>}
        <div class="ob-row" data-filterable>
          <label>{dt('Channels')}</label>
          <input type="text" class="dgl-filter-input" placeholder={dt('Search channels...')} data-filter-input />
          {/* One row per channel (a box and its delay), drawn by the script below from the list the page carries: the same fields
              the server used to write, without sending 150 copies of the row. */}
          <div class="ob-role-list" data-filter-list data-poj-labels={JSON.stringify([dt('Delay'), dt('Seconds before the ping message is deleted')])}></div>
          <script type="application/json" data-poj-rows set:html={pingRowsJson}></script>
          <script is:inline>
            (function () {
              var holder = document.currentScript.previousElementSibling;
              var list = holder && holder.previousElementSibling;
              if (!list || !list.hasAttribute('data-poj-labels') || list.childElementCount) return;
              var rows, labels;
              try { rows = JSON.parse(holder.textContent || '[]'); labels = JSON.parse(list.getAttribute('data-poj-labels')); } catch (e) { return; }
              var scope = [];
              for (var i = 0; i < list.attributes.length; i++) if (list.attributes[i].name.indexOf('data-astro-cid-') === 0) scope.push(list.attributes[i].name);
              var make = function (tag, cls, text) {
                var el = document.createElement(tag);
                if (cls) el.className = cls;
                scope.forEach(function (name) { el.setAttribute(name, ''); });
                if (text != null) el.textContent = text;
                return el;
              };
              var fragment = document.createDocumentFragment();
              rows.forEach(function (row) {
                var item = make('label', 'ob-poj-item');
                var top = make('span', 'ob-poj-top');
                var box = make('input', 'ob-poj-check');
                box.type = 'checkbox'; box.name = 'channel_ids'; box.value = row[0]; box.defaultChecked = !!row[2];
                top.appendChild(box);
                top.appendChild(make('span', 'ob-poj-name', '#' + row[1]));
                var bottom = make('span', 'ob-poj-bottom');
                bottom.appendChild(make('span', 'ob-poj-delay-label', labels[0]));
                var delay = make('input', 'ob-poj-delay');
                delay.type = 'number'; delay.name = 'delay_' + row[0]; delay.min = '1'; delay.max = '300'; delay.defaultValue = String(row[3]); delay.title = labels[1];
                bottom.appendChild(delay);
                bottom.appendChild(make('span', 'ob-poj-unit', 's'));
                item.appendChild(top);
                item.appendChild(bottom);
                fragment.appendChild(item);
              });
              list.appendChild(fragment);
            })();
          </script>
        </div>
        <button type="submit" class="btn btn-ghost btn-sm">{dt('Save')}</button>
      </form>
      </div>
    </section>
    <section class="ob-panel" data-ob-panel="bump" hidden>
      <div class="ob-one">
      <form method="POST" class="ob-card ob-cols">
        <input type="hidden" name="action" value="bump" />
        <div class="ob-card-head"><div class="ob-card-icon" style="--c:#fed53c"><Icon name="ph:arrow-fat-lines-up-fill" width="16" height="16" /></div><div class="ob-card-title">{dt('Bump reminder')}</div></div>
        <p class="ob-card-desc"><Fragment set:html={dth('Reminds the server to <code>/bump</code> on Disboard once the cooldown ends.')} /></p>
        <div class="ob-row"><label>{dt('Channel')}</label><select name="channel_id" data-fill="ob-ch"><option value="">{dt('Off')}</option><SelectChosen items={channels} selected={bump.channelId} prefix="#" /></select></div>
        <div class="ob-row"><label>{dt('Reminder message')}</label><textarea class="dgl-autogrow" rows="2" name="message" data-ac data-dp maxlength="300" placeholder={dt('It\'s time to /bump the server!')}>{bump.message}</textarea></div>
        <div class="ob-row"><label>{dt('Thank-you message')}</label><textarea class="dgl-autogrow" rows="2" name="thankyou" data-ac maxlength="300" placeholder={dt('{user.mention} successfully bumped! Bump again {nextBump}.')}>{bump.thankyou}</textarea></div>
        <div class="ob-row"><label>{dt('Reminder design')}</label><select name="reminder_embed_template"><option value="">{dt('Usual message')}</option>{embedTemplateNames.map((n) => <option value={n} selected={n === bump.reminderTemplate}>{n}</option>)}</select></div>
        <div class="ob-row"><label>{dt('Thank-you design')}</label><select name="thankyou_embed_template"><option value="">{dt('Usual message')}</option>{embedTemplateNames.map((n) => <option value={n} selected={n === bump.thankyouTemplate}>{n}</option>)}</select></div>
        {bump.designReady && <input type="hidden" name="design_ready" value="1" />}
        <VariableHelp />
        <div class="ob-toggles">
          <label class="ob-check"><input type="checkbox" name="pingable" checked={bump.pingable} />{dt('Ping everyone when due')}</label>
          <label class="ob-check"><input type="checkbox" name="autolock" checked={bump.autolock} />{dt('Lock channel between bumps')}</label>
          <label class="ob-check"><input type="checkbox" name="autoclean" checked={bump.autoclean} />{dt('Auto-delete chatter')}</label>
        </div>
        <button type="submit" class="btn btn-ghost btn-sm">{dt('Save')}</button>
      </form>

      </div>
    </section>
  </div>
  <SelectSource name="ob-ch" items={channels.map((c) => ({ id: c.id, name: c.name }))} prefix="#" />
  <SelectSource name="ob-roles" items={roles.map((r) => ({ id: r.id, name: r.name }))} />

  <script is:inline>
    // The verification card: set it up, post the panel and switch it on or off right away, without the Save button. The bot answers within
    // a moment; a long one (setting it up edits every channel of the server) comes back running, and the card shows how far it is by
    // asking verification-status every moment until it ends, then says the result and draws the page again. Leaving the page stops asking;
    // coming back to it while the setup still runs picks it up again (the job is remembered for this tab).
    (function () {
      var msg = document.getElementById('ob-vf-msg');
      if (!msg) return;
      var guild = location.pathname.replace(/^\/(es|pt-br)(?=\/)/i, '').split('/')[3];
      var progress = document.getElementById('ob-vf-progress');
      var bar = progress ? progress.querySelector('.ob-vf-bar') : null;
      var fill = bar ? bar.querySelector('span') : null;
      var step = progress ? progress.querySelector('.ob-vf-step') : null;
      var warn = document.getElementById('ob-vf-warn');
      var toggle = document.querySelector('[data-vf-switch]');
      var buttons = Array.prototype.slice.call(document.querySelectorAll('[data-vf-action]'));
      var words = { working: msg.getAttribute('data-working') || '', failed: msg.getAttribute('data-failed') || '', lost: msg.getAttribute('data-lost') || '' };
      var KEY = 'ob-vf-job:' + guild;
      var following = null;
      function remember(id) { try { if (id) sessionStorage.setItem(KEY, id); else sessionStorage.removeItem(KEY); } catch (e) {} }
      function remembered() { try { return sessionStorage.getItem(KEY); } catch (e) { return null; } }
      function say(text, ok) { msg.hidden = false; msg.textContent = text; msg.className = 'ob-vf-msg ' + (ok ? 'ok' : 'bad'); }
      function busy(on) {
        buttons.forEach(function (button) { button.disabled = on || button.hasAttribute('data-vf-off'); button.classList.toggle('ob-busy', on); });
        if (toggle) toggle.disabled = on;
      }
      function stepText(job) {
        if (!progress) return '';
        if (job.phase === 'channels' && job.total) return (progress.getAttribute('data-channels') || '').replace('{done}', job.done).replace('{total}', job.total);
        return progress.getAttribute('data-' + (job.phase === 'roles' || job.phase === 'panel' ? job.phase : 'starting')) || '';
      }
      function showJob(job) {
        if (!progress) return;
        progress.hidden = false;
        var percent = Math.max(job.status === 'running' ? 4 : 100, Math.min(100, Number(job.percent) || 0));
        if (fill) fill.style.width = percent + '%';
        if (bar) bar.setAttribute('aria-valuenow', String(percent));
        if (step) step.textContent = job.status === 'running' ? stepText(job) : '';
        msg.hidden = true;
      }
      function status() {
        return fetch('/dash/guild/' + guild + '/verification-status', { headers: { Accept: 'application/json' }, cache: 'no-store' })
          .then(function (r) { return r.json(); })
          .catch(function () { return { ok: false }; });
      }
      function showLink(link) {
        if (!warn || !link) return;
        if (link.ok) { warn.hidden = true; return; }
        var text = warn.getAttribute('data-' + (link.problem || 'missing')) || warn.getAttribute('data-missing') || '';
        if (link.lettersInstead) text += ' ' + (warn.getAttribute('data-letters') || '');
        warn.textContent = text; warn.hidden = false;
      }
      function finish(job, action) {
        following = null; remember(null);
        if (job) showJob(job);
        busy(false);
        setTimeout(function () { if (progress && !following) progress.hidden = true; }, 900);
        say((job && job.message) || (job ? words.failed : words.lost), !!(job && job.ok));
        if (toggle && action === 'enable' && !(job && job.ok)) toggle.checked = false;
        // The roles, the channel and the switch changed: the page is read again (only the content, as the menu does).
        if (job && job.ok && (action === 'setup' || action === 'enable')) setTimeout(function () { if (window.dglRefreshPage) window.dglRefreshPage(true); else location.reload(); }, 900);
      }
      function follow(job) {
        if (!job) return;
        remember(job.id);
        showJob(job);
        busy(true);
        if (following) return;
        following = job.id;
        var misses = 0;
        var action = job.action;
        function tick() {
          // Another page was opened from the menu: this card is gone, stop asking.
          if (!msg.isConnected) { following = null; return; }
          status().then(function (data) {
            if (!msg.isConnected) { following = null; return; }
            if (data && data.link) showLink(data.link);
            var current = data && data.job;
            if (!data || !data.ok) { misses += 1; if (misses > 6) finish(null, action); else setTimeout(tick, 2500); return; }
            misses = 0;
            if (!current || (current.id !== following && current.status !== 'running')) { finish(null, action); return; }
            action = current.action || action;
            if (current.status === 'running') { showJob(current); setTimeout(tick, 1200); return; }
            finish(current, action);
          });
        }
        setTimeout(tick, 1000);
      }
      function call(action, extra) {
        return fetch('/dash/guild/' + guild + '/verification-api', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.assign({ action: action }, extra || {})) })
          .then(function (r) { return r.json().catch(function () { return { ok: false, message: words.failed }; }); })
          .catch(function () { return { ok: false, message: words.failed }; });
      }
      function answer(result, action) {
        if (result && result.ok && result.status === 'running' && result.job) { follow(result.job); return; }
        busy(false);
        if (toggle && action === 'enable' && !result.ok) toggle.checked = false;
        if (toggle && action === 'disable' && !result.ok) toggle.checked = true;
        say(result.message || words.failed, !!result.ok);
        if (result.ok && (action === 'setup' || action === 'enable')) setTimeout(function () { if (window.dglRefreshPage) window.dglRefreshPage(true); else location.reload(); }, 900);
      }
      buttons.forEach(function (button) {
        if (button.disabled) button.setAttribute('data-vf-off', '');
        button.addEventListener('click', function () {
          if (following) return;
          var action = button.getAttribute('data-vf-action');
          busy(true); say(words.working, true);
          var select = document.querySelector('select[name="panel_channel_id"]');
          call(action, action === 'panel' && select ? { channel_id: select.value } : {}).then(function (result) { answer(result, action); });
        });
      });
      // The switch acts at once (it does not wait for Save), so it is kept out of the form's unsaved changes.
      if (toggle) toggle.addEventListener('input', function (e) { e.stopPropagation(); });
      if (toggle) toggle.addEventListener('change', function (e) {
        e.stopPropagation();
