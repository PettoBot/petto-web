---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import VariableHelp from './VariableHelp.astro';

interface MemberEvents {
  welcomeChannelId: string | null;
  welcomeMessage: string;
  welcomeEmbedTemplate: string;
  leaveChannelId: string | null;
  leaveMessage: string;
  leaveEmbedTemplate: string;
  boostChannelId: string | null;
  boostMessage: string;
  boostEmbedTemplate: string;
  boostLevelMessage: string;
  boostLevelEmbedTemplate: string;
}
interface Verification { enabled: boolean; unverifiedRoleId: string | null; verifiedRoleId: string | null; }
interface Bump { channelId: string | null; message: string; thankyou: string; pingable: boolean; autolock: boolean; autoclean: boolean; }
interface DmJoin { message: string; embedTemplate: string; }
interface PingOnJoin { enabled: boolean; channelIds: string[]; delaysSeconds: Record<string, number>; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  memberEvents: MemberEvents;
  verification: Verification;
  bump: Bump;
  dmJoin: DmJoin;
  pingOnJoin: PingOnJoin;
  roles: { id: string; name: string }[];
  channels: { id: string; name: string }[];
  embedTemplateNames: string[];
  saved: boolean;
}
const { user, guildId, guildName, guildIcon, memberEvents, verification, bump, dmJoin, pingOnJoin, roles, channels, embedTemplateNames, saved } = Astro.props;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="onboarding" pageTitle="Onboarding">
  <h1>Onboarding</h1>
  <p class="ob-sub">Everything that happens the moment someone joins <b>{guildName}</b>.</p>

  {saved && <div class="ob-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />Saved.</div>}

  <div class="ob-grid">
    <form method="POST" class="ob-card">
      <input type="hidden" name="action" value="events" />
      <div class="ob-card-head"><div class="ob-card-icon" style="--c:#a5ea7a"><Icon name="ph:hand-waving-fill" width="16" height="16" /></div><div class="ob-card-title">Welcome</div></div>
      <div class="ob-row"><label>Channel</label><select name="welcome_channel_id"><option value="">Off</option>{channels.map((c) => <option value={c.id} selected={c.id === memberEvents.welcomeChannelId}>#{c.name}</option>)}</select></div>
      <div class="ob-row"><label>Message</label><input type="text" name="welcome_message" value={memberEvents.welcomeMessage} maxlength="300" placeholder="Welcome {user} to {server_name}!" /></div>
      {embedTemplateNames.length > 0 && (
        <div class="ob-row"><label>Or use an embed template</label><select name="welcome_embed_template"><option value="">No template, use message text above</option>{embedTemplateNames.map((n) => <option value={n} selected={n === memberEvents.welcomeEmbedTemplate}>{n}</option>)}</select></div>
      )}

      <div class="ob-card-head" style="margin-top:6px"><div class="ob-card-icon" style="--c:#94a3b8"><Icon name="ph:door-fill" width="16" height="16" /></div><div class="ob-card-title">Leave</div></div>
      <div class="ob-row"><label>Channel</label><select name="leave_channel_id"><option value="">Off</option>{channels.map((c) => <option value={c.id} selected={c.id === memberEvents.leaveChannelId}>#{c.name}</option>)}</select></div>
      <div class="ob-row"><label>Message</label><input type="text" name="leave_message" value={memberEvents.leaveMessage} maxlength="300" placeholder="{user} left the server." /></div>
      {embedTemplateNames.length > 0 && (
        <div class="ob-row"><label>Or use an embed template</label><select name="leave_embed_template"><option value="">No template, use message text above</option>{embedTemplateNames.map((n) => <option value={n} selected={n === memberEvents.leaveEmbedTemplate}>{n}</option>)}</select></div>
      )}

      <div class="ob-card-head" style="margin-top:6px"><div class="ob-card-icon" style="--c:#f78fb3"><Icon name="ph:sparkle-fill" width="16" height="16" /></div><div class="ob-card-title">Boost</div></div>
      <div class="ob-row"><label>Channel</label><select name="boost_channel_id"><option value="">Off</option>{channels.map((c) => <option value={c.id} selected={c.id === memberEvents.boostChannelId}>#{c.name}</option>)}</select></div>
      <div class="ob-row"><label>Message</label><input type="text" name="boost_message" value={memberEvents.boostMessage} maxlength="300" placeholder="{user} just boosted the server!" /></div>
      {embedTemplateNames.length > 0 && (
        <div class="ob-row"><label>Or use an embed template</label><select name="boost_embed_template"><option value="">No template, use message text above</option>{embedTemplateNames.map((n) => <option value={n} selected={n === memberEvents.boostEmbedTemplate}>{n}</option>)}</select></div>
      )}
      <div class="ob-row"><label>Boost tier reached message</label><input type="text" name="boost_level_message" value={memberEvents.boostLevelMessage} maxlength="300" placeholder="{server_name} just reached a new boost tier!" /></div>
      {embedTemplateNames.length > 0 && (
        <div class="ob-row"><label>Or use an embed template</label><select name="boost_level_embed_template"><option value="">No template, use message text above</option>{embedTemplateNames.map((n) => <option value={n} selected={n === memberEvents.boostLevelEmbedTemplate}>{n}</option>)}</select></div>
      )}

      <button type="submit" class="btn btn-ghost btn-sm">Save</button>
      {embedTemplateNames.length > 0 && <p class="ob-card-desc">Templates are managed on the Embeds page.</p>}
      <VariableHelp />
    </form>

    <div class="ob-col">
      <form method="POST" class="ob-card">
        <input type="hidden" name="action" value="verification" />
        <div class="ob-card-head">
          <div class="ob-card-icon" style="--c:#8399ff"><Icon name="ph:seal-check-fill" width="16" height="16" /></div>
          <div class="ob-card-title">Verification</div>
          <label class="ob-switch"><input type="checkbox" name="enabled" checked={verification.enabled} /><span></span></label>
        </div>
        <p class="ob-card-desc">A Cloudflare Turnstile captcha gate, new members must pass it to get in.</p>
        <div class="ob-row"><label>Role while unverified</label><select name="unverified_role_id"><option value="">None</option>{roles.map((r) => <option value={r.id} selected={r.id === verification.unverifiedRoleId}>{r.name}</option>)}</select></div>
        <div class="ob-row"><label>Role once verified</label><select name="verified_role_id"><option value="">None</option>{roles.map((r) => <option value={r.id} selected={r.id === verification.verifiedRoleId}>{r.name}</option>)}</select></div>
        <button type="submit" class="btn btn-ghost btn-sm">Save</button>
      </form>

      <form method="POST" class="ob-card">
        <input type="hidden" name="action" value="bump" />
        <div class="ob-card-head"><div class="ob-card-icon" style="--c:#fed53c"><Icon name="ph:arrow-fat-lines-up-fill" width="16" height="16" /></div><div class="ob-card-title">Bump reminder</div></div>
        <p class="ob-card-desc">Reminds the server to <code>/bump</code> on Disboard once the cooldown ends.</p>
        <div class="ob-row"><label>Channel</label><select name="channel_id"><option value="">Off</option>{channels.map((c) => <option value={c.id} selected={c.id === bump.channelId}>#{c.name}</option>)}</select></div>
        <div class="ob-row"><label>Reminder message</label><input type="text" name="message" value={bump.message} maxlength="300" placeholder="It's time to /bump the server!" /></div>
        <div class="ob-row"><label>Thank-you message</label><input type="text" name="thankyou" value={bump.thankyou} maxlength="300" placeholder="{user.mention} successfully bumped! Bump again {nextBump}." /></div>
        <VariableHelp />
        <div class="ob-toggles">
          <label class="ob-check"><input type="checkbox" name="pingable" checked={bump.pingable} />Ping everyone when due</label>
          <label class="ob-check"><input type="checkbox" name="autolock" checked={bump.autolock} />Lock channel between bumps</label>
          <label class="ob-check"><input type="checkbox" name="autoclean" checked={bump.autoclean} />Auto-delete chatter</label>
        </div>
        <button type="submit" class="btn btn-ghost btn-sm">Save</button>
      </form>

      <form method="POST" class="ob-card">
        <input type="hidden" name="action" value="dm_join" />
        <div class="ob-card-head"><div class="ob-card-icon" style="--c:#c792ea"><Icon name="ph:envelope-simple-fill" width="16" height="16" /></div><div class="ob-card-title">DM on join</div></div>
        <p class="ob-card-desc">A direct message sent to new members, separate from the channel welcome. Leave empty to turn off.</p>
        <div class="ob-row"><label>Message</label><input type="text" name="dm_join_message" value={dmJoin.message} maxlength="300" placeholder="Welcome to {server_name}! Check out #rules to get started." /></div>
        {embedTemplateNames.length > 0 && (
          <div class="ob-row"><label>Or use an embed template</label><select name="dm_join_embed_template"><option value="">No template, use message text above</option>{embedTemplateNames.map((n) => <option value={n} selected={n === dmJoin.embedTemplate}>{n}</option>)}</select></div>
        )}
        <VariableHelp />
        <button type="submit" class="btn btn-ghost btn-sm">Save</button>
      </form>

      <form method="POST" class="ob-card">
        <input type="hidden" name="action" value="ping_on_join" />
        <div class="ob-card-head">
          <div class="ob-card-icon" style="--c:#5eead4"><Icon name="ph:bell-ringing-fill" width="16" height="16" /></div>
          <div class="ob-card-title">Ping on join</div>
          <label class="ob-switch"><input type="checkbox" name="enabled" checked={pingOnJoin.enabled} /><span></span></label>
        </div>
        <p class="ob-card-desc">Mentions new members in these channels, then cleans the ping up after the delay below (default 5s).</p>
        <div class="ob-row" data-filterable>
          <label>Channels</label>
          <input type="text" class="dgl-filter-input" placeholder="Search channels..." data-filter-input />
          <div class="ob-role-list" data-filter-list>
            {channels.map((c) => (
              <label class="ob-role-item ob-poj-item">
                <input type="checkbox" class="ob-poj-check" name="channel_ids" value={c.id} checked={pingOnJoin.channelIds.includes(c.id)} />
                <span class="ob-poj-name">#{c.name}</span>
                <input type="number" class="ob-poj-delay" name={`delay_${c.id}`} min="1" max="300" value={pingOnJoin.delaysSeconds[c.id] ?? 5} title="Seconds before the ping message is deleted" />
                <span class="ob-poj-unit">s</span>
              </label>
            ))}
          </div>
        </div>
        <button type="submit" class="btn btn-ghost btn-sm">Save</button>
      </form>
    </div>
  </div>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  .ob-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 24px; }
  .ob-sub b { color: var(--text); }

  .ob-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 20px; max-width: fit-content; }

  .ob-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }
  .ob-col { display: flex; flex-direction: column; gap: 16px; }
  .ob-card { border: 1px solid var(--border); border-radius: 14px; padding: 16px; background: var(--card); display: flex; flex-direction: column; gap: 11px; align-items: flex-start; }
  .ob-card-head { display: flex; align-items: center; gap: 10px; width: 100%; }
  .ob-card-icon { width: 28px; height: 28px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: color-mix(in srgb, var(--c) 16%, transparent); color: var(--c); }
  .ob-card-title { flex: 1; font-size: 13px; font-weight: 600; color: var(--text); }
  .ob-card-desc { font-size: 11.5px; color: var(--text-dim); line-height: 1.5; margin: 0; }
  .ob-card-desc code { font-family: var(--mono); color: var(--accent); }

  .ob-switch { position: relative; display: inline-block; width: 34px; height: 20px; flex-shrink: 0; }
  .ob-switch input { opacity: 0; width: 0; height: 0; }
  .ob-switch span { position: absolute; inset: 0; background: var(--border); border-radius: 20px; transition: background 0.15s; cursor: pointer; }
  .ob-switch span::before { content: ''; position: absolute; width: 14px; height: 14px; left: 3px; top: 3px; background: var(--card); border-radius: 50%; transition: transform 0.15s; }
  .ob-switch input:checked + span { background: var(--accent); }
  .ob-switch input:checked + span::before { transform: translateX(14px); }

  .ob-row { display: flex; flex-direction: column; gap: 5px; width: 100%; }
  .ob-row label { font-size: 10.5px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.03em; }
  .ob-row input, .ob-row select { width: 100%; box-sizing: border-box; border: 1px solid var(--border); border-radius: 8px; padding: 7px 9px; background: var(--bg-raise); color: var(--text); font-family: var(--sans); font-size: 12.5px; }
  .ob-role-list { border: 1px solid var(--border); border-radius: 8px; background: var(--bg-raise); max-height: 110px; overflow-y: auto; padding: 4px; display: flex; flex-direction: column; }
  .ob-role-item { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 8px; padding: 5px 7px; border-radius: 6px; font-size: 12px; color: var(--text-muted); cursor: pointer; }
  .ob-role-item:hover { background: var(--card-hover); color: var(--text); }
  .ob-role-item input { flex-shrink: 0; accent-color: var(--accent); }

  .ob-poj-item { display: grid; grid-template-columns: 14px minmax(0, 1fr) 44px auto; align-items: center; column-gap: 8px; flex-wrap: nowrap; }
  .ob-poj-check { width: 14px; height: 14px; margin: 0; }
  .ob-poj-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ob-poj-delay { width: 44px; border: 1px solid var(--border); border-radius: 6px; padding: 2px 5px; background: var(--card); color: var(--text); font-size: 11.5px; text-align: right; }
  .ob-poj-unit { font-size: 11px; color: var(--text-dim); }

  .ob-toggles { display: flex; flex-direction: column; gap: 6px; width: 100%; }
  .ob-check { display: flex; align-items: center; gap: 7px; font-size: 12px; color: var(--text-muted); }

  @media (max-width: 780px) {
    .ob-grid { grid-template-columns: 1fr; }
  }
</style>
