---
import SilentMentionHint from './SilentMentionHint.astro';
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import VariableHelp from './VariableHelp.astro';
import SelectSource from './SelectSource.astro';
import SelectChosen from './SelectChosen.astro';
import DashAcData from './DashAcData.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import DashBotWait from './DashBotWait.astro';
import { withPostNotes, type PostableChannel } from '../utils/channelPost';
import type { VerifyChecks } from '../utils/verifyChecks';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface MemberEvents {
  welcomeChannelId: string | null;
  welcomeMessage: string;
  welcomeEmbedTemplate: string;
  waitReady: boolean;
  welcomeWait: string;
  secondEnabled: boolean;
  secondChannelId: string | null;
  secondMessage: string;
  secondEmbedTemplate: string;
  leaveChannelId: string | null;
  leaveMessage: string;
  leaveEmbedTemplate: string;
  boostChannelId: string | null;
  boostMessage: string;
  boostEmbedTemplate: string;
  boostLevelMessage: string;
  boostLevelEmbedTemplate: string;
}
interface Verification { dmReady: boolean; dmOnJoin: boolean; checksReady: boolean; checks: VerifyChecks; methodReady: boolean; method: string; designReady: boolean; promptTemplate: string; verifiedTemplate: string; enabled: boolean; unverifiedRoleId: string | null; verifiedRoleId: string | null; panelReady: boolean; panelChannelId: string | null; imageReady: boolean; panelImage: string; }
interface Bump { designReady: boolean; thankyouTemplate: string; reminderTemplate: string; channelId: string | null; message: string; thankyou: string; pingable: boolean; autolock: boolean; autoclean: boolean; }
interface DmJoin { message: string; embedTemplate: string; }
interface PingOnJoin { enabled: boolean; channelIds: string[]; delaysSeconds: Record<string, number>; }
interface JoinRole { roleId: string; target: string; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  memberEvents: MemberEvents;
  verification: Verification;
  bump: Bump;
  dmJoin: DmJoin;
  pingOnJoin: PingOnJoin;
  joinRoles: JoinRole[];
  roles: { id: string; name: string }[];
  channels: PostableChannel[];
  embedTemplateNames: string[];
  saved: boolean;
  problem?: string | null;
}
const { user, guildId, guildName, guildIcon, memberEvents, verification, bump, dmJoin, pingOnJoin, joinRoles, roles, embedTemplateNames, saved, problem } = Astro.props;
// A channel where Petto cannot see or write says so in every list of this page (the welcome, the ping on join, the verification panel...), because nothing would arrive there.
// The name stays as it is; the note (utils/channelPost.ts) goes under it, in red.
const channels = withPostNotes(dt, Astro.props.channels);
const closedPings = channels.filter((c) => c.note && pingOnJoin.channelIds.includes(c.id));

function roleName(id: string) {
  return roles.find((r) => r.id === id)?.name ?? id;
}
const pingRowsJson = JSON.stringify(channels.map((c) => [c.id, c.name, pingOnJoin.channelIds.includes(c.id) ? 1 : 0, pingOnJoin.delaysSeconds[c.id] ?? 5, c.note ?? ''])).replace(/</g, '\\u003c');
function targetLabel(target: string) {
  return target === 'humans' ? dt('Humans only') : target === 'bots' ? dt('Bots only') : dt('Everyone');
}
const hasTemplates = embedTemplateNames.length > 0;
const channelName = (id: string | null) => channels.find((c) => c.id === id)?.name ?? '';

// What is set up now (the tiles, the numbers on the tabs and the checklist): everything comes from the settings the page already reads.
const messagesOn = [
  Boolean(memberEvents.welcomeChannelId), Boolean(memberEvents.secondEnabled && memberEvents.secondChannelId), Boolean(memberEvents.leaveChannelId), Boolean(memberEvents.boostChannelId), Boolean(dmJoin.message || dmJoin.embedTemplate),
].filter(Boolean).length;
const bumpOn = Boolean(bump.channelId);
const checklist = [
  { done: Boolean(verification.unverifiedRoleId), label: dt('A role while unverified') },
  { done: Boolean(verification.verifiedRoleId), label: dt('A role once verified') },
  { done: Boolean(verification.panelChannelId), label: dt('A verification channel') },
  { done: verification.enabled, label: dt('Verification turned on') },
];
const checklistDone = checklist.filter((item) => item.done).length;
const methods: [string, string, string, string][] = [
  ['turnstile', dt('Cloudflare check'), dt('The usual one'), 'ph:shield-check-fill'],
  ['letters', dt('Letters in a picture'), dt('Type the letters of a picture'), 'ph:image-fill'],
  ['both', dt('Both checks'), dt('The two, one after the other'), 'ph:seal-check-fill'],
  ['discord', dt('Letters inside Discord (no link)'), dt('A button in the DM, no link'), 'ph:chat-circle-dots-fill'],
  ['email', dt('Email code (no captcha)'), dt('A code sent to their email'), 'ph:envelope-simple-fill'],
];
// The extra checks: three have a mode (off, tell the staff, block); the email code is on or off.
const checkModes: [string, string][] = [['off', dt('Off')], ['warn', dt('Tell the staff')], ['block', dt('Block')]];
const checkRows: [string, string, string, string, string][] = [
  ['tor', 'ph:detective-fill', dt('Tor network'), dt('Members connecting through the Tor network.'), verification.checks.tor],
  ['alt', 'ph:users-three-fill', dt('Alt accounts'), dt('The same connection or email as another member, or as a banned one. Only coded fingerprints are kept, for 90 days.'), verification.checks.alt],
];
const targets: [string, string][] = [['all', dt('Everyone')], ['humans', dt('Humans only')], ['bots', dt('Bots only')]];
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="onboarding" pageTitle="Onboarding">
  <DashSettingsKit />
  <div class="sx-page ob">
  <h1>{dt('Onboarding')}</h1>
  <DashAcData roles={roles} channels={channels.map((c) => ({ id: c.id, name: c.name }))} />

  {saved && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {problem && <div class="sx-flash sx-flash-bad" role="alert"><Icon name="ph:warning-fill" width="15" height="15" />{problem}</div>}

  <DashStatTiles tiles={[
    { label: dt('Messages on'), value: messagesOn, tone: 'messages' },
    { label: dt('Verification'), value: 0, text: verification.enabled ? dt('On') : dt('Off'), tone: 'joins' },
    { label: dt('Join roles'), value: joinRoles.length, tone: 'voice' },
    { label: dt('Ping channels'), value: pingOnJoin.channelIds.length, tone: 'reactions' },
  ]} />

  <div class="ob-tabs" role="tablist" aria-label={dt('Onboarding')}>
    <button type="button" class="ob-tab" role="tab" data-ob-tab="messages"><Icon name="ph:hand-waving-fill" width="15" height="15" /><span>{dt('Messages')}</span><em>{messagesOn}/5</em><i class="ob-dot"></i></button>
    <button type="button" class="ob-tab" role="tab" data-ob-tab="verification"><Icon name="ph:seal-check-fill" width="15" height="15" /><span>{dt('Verification')}</span><em>{verification.enabled ? dt('On') : dt('Off')}</em><i class="ob-dot"></i></button>
    <button type="button" class="ob-tab" role="tab" data-ob-tab="arrival"><Icon name="ph:user-plus-fill" width="15" height="15" /><span>{dt('Roles and DM')}</span><em>{joinRoles.length}</em><i class="ob-dot"></i></button>
    <button type="button" class="ob-tab" role="tab" data-ob-tab="ping"><Icon name="ph:bell-ringing-fill" width="15" height="15" /><span>{dt('Ping on join')}</span><em>{pingOnJoin.enabled ? pingOnJoin.channelIds.length : dt('Off')}</em><i class="ob-dot"></i></button>
    <button type="button" class="ob-tab" role="tab" data-ob-tab="bump"><Icon name="ph:arrow-fat-lines-up-fill" width="15" height="15" /><span>{dt('Bump')}</span><em>{bumpOn ? dt('On') : dt('Off')}</em><i class="ob-dot"></i></button>
  </div>

  <div class="ob-panels" id="ob-panels">
    <section class="ob-panel" data-ob-panel="messages">
      <form method="POST" class="ob-form">
        <input type="hidden" name="action" value="events" />
        <div class="ob-cols">
          <div class="ob-col">
            <section class="sx-panel ob-box">
              <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#a5ea7a"><Icon name="ph:hand-waving-fill" width="17" height="17" /></span><h2>{dt('Welcome')}</h2></div>
              <div class="sx-field"><label for="ob-w-ch">{dt('Channel')}</label><select id="ob-w-ch" name="welcome_channel_id" data-fill="ob-ch"><option value="">{dt('Off')}</option><SelectChosen items={channels} selected={memberEvents.welcomeChannelId} prefix="#" /></select></div>
              <div class="sx-field ob-row"><label for="ob-w-msg">{dt('Message')}</label><textarea id="ob-w-msg" class="dgl-autogrow" rows="2" name="welcome_message" data-ac data-dp data-dp-template="welcome_embed_template" data-count maxlength="300" placeholder={dt('Welcome {user} to {server_name}!')}>{memberEvents.welcomeMessage}</textarea><SilentMentionHint /></div>
              {hasTemplates && (
                <div class="sx-field"><label for="ob-w-tpl">{dt('Or use an embed template')}</label><select id="ob-w-tpl" name="welcome_embed_template"><option value="">{dt('No template, use message text above')}</option>{embedTemplateNames.map((n) => <option value={n} selected={n === memberEvents.welcomeEmbedTemplate}>{n}</option>)}</select></div>
              )}
              {memberEvents.waitReady && (
                <div class="sx-field">
                  <input type="hidden" name="wait_ready" value="1" />
                  <label for="ob-w-wait">{dt('Send the welcome')}</label>
                  <select id="ob-w-wait" name="welcome_wait" data-ob-wait>
                    <option value="off" selected={memberEvents.welcomeWait === 'off'}>{dt('As soon as the member joins')}</option>
                    <option value="rules" selected={memberEvents.welcomeWait === 'rules'}>{dt('After the member accepts the rules')}</option>
                    <option value="rules_onboarding" selected={memberEvents.welcomeWait === 'rules_onboarding'}>{dt('After the rules and the onboarding')}</option>
                  </select>
                  <span class="sx-hint ob-wait-note" data-ob-wait-note="off" hidden={memberEvents.welcomeWait !== 'off'}>{dt('The welcome goes out the moment the member joins, as it always did.')}</span>
                  <span class="sx-hint ob-wait-note" data-ob-wait-note="rules" hidden={memberEvents.welcomeWait !== 'rules'}>{dt('It waits until the member accepts the server rules (Membership Screening). A member who never accepts them is never welcomed.')}</span>
                  <span class="sx-hint ob-wait-note" data-ob-wait-note="rules_onboarding" hidden={memberEvents.welcomeWait !== 'rules_onboarding'}>{dt('It also waits until the member finishes Discord onboarding, but goes out anyway 10 minutes after the rules were accepted (30 minutes after joining when the server has no rules), because members can skip the onboarding.')}</span>
                  <span class="sx-hint ob-wait-note">{dt('Needs Membership Screening or Onboarding turned on in Discord. The second welcome waits the same way. The DM and the ping on join always go out at once.')}</span>
                </div>
              )}
            </section>

            <section class="sx-panel ob-box">
              <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#7ac7ea"><Icon name="ph:chats-circle-fill" width="17" height="17" /></span><h2>{dt('Second welcome')}</h2>
                <label class="sx-toggle-only"><input type="checkbox" name="welcome_second_enabled" checked={memberEvents.secondEnabled} aria-label={dt('Second welcome')} /><i class="sx-toggle"></i></label>
              </div>
              <p class="sx-lead">{dt('A second welcome in another channel, for example the general chat. It is sent right after the first one.')}</p>
              <div class="ob-body" data-sx-needs="welcome_second_enabled">
                <div class="sx-field"><label for="ob-s-ch">{dt('Channel')}</label><select id="ob-s-ch" name="welcome_second_channel_id" data-fill="ob-ch"><option value="">{dt('Off')}</option><SelectChosen items={channels} selected={memberEvents.secondChannelId} prefix="#" /></select></div>
                <div class="sx-field ob-row"><label for="ob-s-msg">{dt('Message')}</label><textarea id="ob-s-msg" class="dgl-autogrow" rows="2" name="welcome_second_message" data-ac data-dp data-dp-template="welcome_second_embed_template" data-count maxlength="300" placeholder={dt('Say hi to {user}!')}>{memberEvents.secondMessage}</textarea><SilentMentionHint /></div>
                {hasTemplates && (
                  <div class="sx-field"><label for="ob-s-tpl">{dt('Or use an embed template')}</label><select id="ob-s-tpl" name="welcome_second_embed_template"><option value="">{dt('No template, use message text above')}</option>{embedTemplateNames.map((n) => <option value={n} selected={n === memberEvents.secondEmbedTemplate}>{n}</option>)}</select></div>
                )}
              </div>
            </section>
          </div>

          <div class="ob-col">
            <section class="sx-panel ob-box">
              <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#94a3b8"><Icon name="ph:door-fill" width="17" height="17" /></span><h2>{dt('Leave')}</h2></div>
              <div class="sx-field"><label for="ob-l-ch">{dt('Channel')}</label><select id="ob-l-ch" name="leave_channel_id" data-fill="ob-ch"><option value="">{dt('Off')}</option><SelectChosen items={channels} selected={memberEvents.leaveChannelId} prefix="#" /></select></div>
              <div class="sx-field ob-row"><label for="ob-l-msg">{dt('Message')}</label><textarea id="ob-l-msg" class="dgl-autogrow" rows="2" name="leave_message" data-ac data-dp data-dp-template="leave_embed_template" data-count maxlength="300" placeholder={dt('{user} left the server.')}>{memberEvents.leaveMessage}</textarea><SilentMentionHint /></div>
              {hasTemplates && (
                <div class="sx-field"><label for="ob-l-tpl">{dt('Or use an embed template')}</label><select id="ob-l-tpl" name="leave_embed_template"><option value="">{dt('No template, use message text above')}</option>{embedTemplateNames.map((n) => <option value={n} selected={n === memberEvents.leaveEmbedTemplate}>{n}</option>)}</select></div>
              )}
            </section>

            <section class="sx-panel ob-box">
              <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#f78fb3"><Icon name="ph:sparkle-fill" width="17" height="17" /></span><h2>{dt('Boost')}</h2></div>
              <div class="sx-field"><label for="ob-b-ch">{dt('Channel')}</label><select id="ob-b-ch" name="boost_channel_id" data-fill="ob-ch"><option value="">{dt('Off')}</option><SelectChosen items={channels} selected={memberEvents.boostChannelId} prefix="#" /></select></div>
              <div class="sx-field ob-row"><label for="ob-b-msg">{dt('Message')}</label><textarea id="ob-b-msg" class="dgl-autogrow" rows="2" name="boost_message" data-ac data-dp data-dp-template="boost_embed_template" data-count maxlength="300" placeholder={dt('{user} just boosted the server!')}>{memberEvents.boostMessage}</textarea><SilentMentionHint /></div>
              {hasTemplates && (
                <div class="sx-field"><label for="ob-b-tpl">{dt('Or use an embed template')}</label><select id="ob-b-tpl" name="boost_embed_template"><option value="">{dt('No template, use message text above')}</option>{embedTemplateNames.map((n) => <option value={n} selected={n === memberEvents.boostEmbedTemplate}>{n}</option>)}</select></div>
              )}
              <div class="sx-field ob-row"><label for="ob-b-lvl">{dt('Boost tier reached message')}</label><textarea id="ob-b-lvl" class="dgl-autogrow" rows="2" name="boost_level_message" data-ac data-dp data-dp-template="boost_level_embed_template" data-count maxlength="300" placeholder={dt('{server_name} just reached a new boost tier!')}>{memberEvents.boostLevelMessage}</textarea><SilentMentionHint /></div>
              {hasTemplates && (
                <div class="sx-field"><label for="ob-b-ltpl">{dt('Or use an embed template')}</label><select id="ob-b-ltpl" name="boost_level_embed_template"><option value="">{dt('No template, use message text above')}</option>{embedTemplateNames.map((n) => <option value={n} selected={n === memberEvents.boostLevelEmbedTemplate}>{n}</option>)}</select></div>
              )}
            </section>
          </div>
        </div>
        <div class="ob-tools">
          <div class="sx-foot ob-save"><button type="submit" class="btn btn-accent btn-sm">{dt('Save')}</button></div>
          {hasTemplates && <p class="sx-hint">{dt('Templates are managed on the Embeds page.')}</p>}
          <VariableHelp />
        </div>
      </form>
    </section>

    <section class="ob-panel" data-ob-panel="verification" hidden>
      <form method="POST" class="ob-form ob-vf">
        <input type="hidden" name="action" value="verification" />
        <section class="sx-panel ob-box">
          <div class="sx-panel-head">
            <span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:seal-check-fill" width="17" height="17" /></span>
            <h2>{dt('Verification')}</h2>
            <label class="sx-toggle-only"><input type="checkbox" name="enabled" checked={verification.enabled} data-vf-switch data-no-dirty aria-label={dt('Verification')} /><i class="sx-toggle"></i></label>
          </div>
          <p class="sx-lead">{dt('A Cloudflare Turnstile captcha gate, new members must pass it to get in.')}</p>
          <div class="ob-auto"><div><strong>{dt('Set it up for me')}</strong><span>{dt('Makes the roles and a #verify channel, posts the panel and turns verification on. What you already chose is kept.')}</span></div><button type="button" class="btn btn-accent btn-sm" data-vf-action="setup"><Icon name="ph:magic-wand-fill" width="14" height="14" /> {dt('Set it up')}</button></div>
          <p class="ob-vf-msg" id="ob-vf-msg" role="status" hidden data-working={dt('Working on it…')} data-failed={dt('It could not be done. Try again.')} data-lost={dt('Petto stopped answering about the setup. Check the server and try again.')}></p>
          <div class="ob-vf-progress" id="ob-vf-progress" hidden data-starting={dt('Starting…')} data-roles={dt('Making the roles…')} data-channels={dt('Setting up… {done}/{total} channels')} data-panel={dt('Posting the panel…')}>
            <div class="ob-vf-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
            <span class="ob-vf-step" aria-live="polite"></span>
          </div>
          <p class="ob-vf-warn" id="ob-vf-warn" hidden data-missing={dt('Members cannot get a verification link right now: Petto\'s VERIFY_BASE_URL is not set.')} data-secret={dt('Members cannot get a verification link right now: Petto\'s VERIFY_TOKEN_SECRET is not set.')} data-invalid={dt('Members cannot get a verification link right now: Petto\'s VERIFY_BASE_URL is not a web address.')} data-local={dt('Members cannot get a verification link right now: Petto\'s VERIFY_BASE_URL points to localhost, which only opens on the bot\'s computer.')} data-letters={dt('Until it is fixed, the panel offers the letters inside Discord instead.')}></p>
        </section>

        <div class="ob-cols">
          <div class="ob-col">
            <section class="sx-panel ob-box">
              <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#7ac45a"><Icon name="ph:user-plus-fill" width="17" height="17" /></span><h2>{dt('Roles')}</h2></div>
              <div class="sx-grid">
                <div class="sx-field"><label for="ob-v-un">{dt('Role while unverified')}</label><select id="ob-v-un" name="unverified_role_id" data-give-role data-fill="ob-roles"><option value="">{dt('None')}</option><SelectChosen items={roles} selected={verification.unverifiedRoleId} /></select></div>
                <div class="sx-field"><label for="ob-v-ok">{dt('Role once verified')}</label><select id="ob-v-ok" name="verified_role_id" data-give-role data-fill="ob-roles"><option value="">{dt('None')}</option><SelectChosen items={roles} selected={verification.verifiedRoleId} /></select></div>
              </div>
            </section>

            <section class="sx-panel ob-box">
              <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#5eead4"><Icon name="ph:shield-check-fill" width="17" height="17" /></span><h2 id="ob-method-h">{dt('How members verify')}</h2></div>
              <div class="sx-choices ob-methods" role="radiogroup" aria-labelledby="ob-method-h">
                {methods.map(([value, label, hint, icon]) => (
                  <label class="sx-choice"><input type="radio" name="method" value={value} checked={verification.method === value} disabled={!verification.methodReady} /><span class="sx-choice-body"><Icon name={icon} width="17" height="17" /><b>{label}</b><em>{hint}</em></span></label>
                ))}
              </div>
              {verification.methodReady && <input type="hidden" name="method_ready" value="1" />}
              <p class="sx-hint">{dt('The Cloudflare check is the usual one. With letters, members type the letters of a picture (the link page needs no Cloudflare), on the page or with a button in the DM. With both, they do the two. Inside Discord, they only press a button in the DM and type the letters there, with no link at all.')}</p>
              <p class="sx-hint ob-email-note" id="ob-email-note" hidden={verification.method !== 'email'}>{dt('The email code proves that the member has an inbox, not that they are a person. A captcha plus the email (the Email code of Extra checks) is the strongest. It needs the verification link and a way to send the email.')}</p>
            </section>

            <section class="sx-panel ob-box" data-vf-checks>
              <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#ffb86c"><Icon name="ph:detective-fill" width="17" height="17" /></span><h2>{dt('Extra checks')}</h2></div>
              <p class="sx-hint">{dt('On top of the captcha. "Tell the staff" lets the member in and writes it in the verification log. "Block" stops them and tells them why.')}</p>
              <div class="ob-chk-list">
                {checkRows.map(([key, icon, title, hint, current]) => (
                  <div class="ob-chk">
                    <span class="ob-chk-icon"><Icon name={icon} width="18" height="18" /></span>
                    <div class="ob-chk-text"><b>{title}</b><em>{hint}</em></div>
                    <div class="ob-seg" role="radiogroup" aria-label={title}>
                      {checkModes.map(([value, label]) => <label><input type="radio" name={`chk_${key}`} value={value} checked={current === value} disabled={!verification.checksReady} /><span>{label}</span></label>)}
                    </div>
                  </div>
                ))}
                <div class="ob-chk ob-chk-wide">
                  <span class="ob-chk-icon"><Icon name="ph:identification-card-fill" width="18" height="18" /></span>
                  <div class="ob-chk-text"><b>{dt('Discord account')}</b><em>{dt('Accounts that are too new, have no avatar or are flagged by Discord.')}</em></div>
                  <div class="ob-seg" role="radiogroup" aria-label={dt('Discord account')}>
                    {checkModes.map(([value, label]) => <label><input type="radio" name="chk_account" value={value} checked={verification.checks.account.mode === value} disabled={!verification.checksReady} /><span>{label}</span></label>)}
                  </div>
                  <div class="ob-chk-more">
                    <div class="sx-field"><label for="ob-chk-age">{dt('Minimum age (days)')}</label><input id="ob-chk-age" type="number" name="chk_account_age" min="0" max="365" value={verification.checks.account.min_age_days} disabled={!verification.checksReady} /></div>
                    <div class="sx-chips">
                      <label class="sx-chip"><input type="checkbox" name="chk_account_avatar" checked={verification.checks.account.no_avatar} disabled={!verification.checksReady} /><span>{dt('Needs an avatar')}</span></label>
                      <label class="sx-chip"><input type="checkbox" name="chk_account_flagged" checked={verification.checks.account.flagged} disabled={!verification.checksReady} /><span>{dt('Refuse accounts flagged by Discord')}</span></label>
                    </div>
                  </div>
                </div>
                <div class="ob-chk ob-chk-wide">
                  <span class="ob-chk-icon"><Icon name="ph:envelope-simple-fill" width="18" height="18" /></span>
                  <div class="ob-chk-text"><b>{dt('Email code')}</b><em>{dt('Members type a 6-digit code sent to their email. Petto does not keep the email.')}</em></div>
                  <label class="sx-toggle-only"><input type="checkbox" name="chk_email" checked={verification.checks.email.required} disabled={!verification.checksReady} aria-label={dt('Email code')} /><i class="sx-toggle"></i></label>
                  <div class="ob-chk-more">
                    <div class="sx-chips">
                      <label class="sx-chip"><input type="checkbox" name="chk_email_common" checked={verification.checks.email.common_only} disabled={!verification.checksReady} /><span>{dt('Only well-known providers')}</span></label>
                      <label class="sx-chip"><input type="checkbox" name="chk_email_disposable" checked={verification.checks.email.block_disposable} disabled={!verification.checksReady} /><span>{dt('Refuse throwaway emails')}</span></label>
                    </div>
                    <div class="sx-grid">
                      <div class="sx-field"><label for="ob-chk-allow">{dt('Only these domains')}</label><input id="ob-chk-allow" type="text" name="chk_email_allow" value={verification.checks.email.allowed_domains.join(', ')} placeholder="school.edu, company.com" maxlength="900" disabled={!verification.checksReady} /></div>
                      <div class="sx-field"><label for="ob-chk-deny">{dt('Never these domains')}</label><input id="ob-chk-deny" type="text" name="chk_email_deny" value={verification.checks.email.blocked_domains.join(', ')} placeholder="example.com" maxlength="900" disabled={!verification.checksReady} /></div>
                    </div>
                    <p class="sx-hint">{dt('Well-known providers are Gmail, Outlook, Hotmail, Yahoo, iCloud, Proton and similar: addresses of a personal or company domain are refused. Fill "Only these domains" to accept your own (a school, a company) instead. Addresses with a + sign are never accepted.')}</p>
                <p class="sx-hint ob-email-note" id="ob-email-forced" hidden={verification.method !== 'email'}>{dt('With the Email code method, the code is always asked, whatever this switch says.')}</p>
                  </div>
                </div>
              </div>
              {verification.checksReady && <input type="hidden" name="checks_ready" value="1" />}
              <p class="sx-hint">{dt('Tor, alt accounts and the email code need the verification page, so they do not work with "Letters inside Discord (no link)". The Discord account check works everywhere.')}</p>
            </section>

            <section class="sx-panel ob-box">
              <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#c792ea"><Icon name="ph:envelope-simple-fill" width="17" height="17" /></span><h2>{dt('Messages members get')}</h2></div>
              <div class="sx-field"><label for="ob-v-prompt">{dt('Verification DM design')}</label><select id="ob-v-prompt" name="prompt_embed_template" data-dp-template-only><option value="">{dt('Usual message')}</option>{embedTemplateNames.map((n) => <option value={n} selected={n === verification.promptTemplate}>{n}</option>)}</select></div>
              <div class="sx-field"><label for="ob-v-done">{dt('Verified DM design')}</label><select id="ob-v-done" name="verified_embed_template" data-dp-template-only><option value="">{dt('Usual message')}</option>{embedTemplateNames.map((n) => <option value={n} selected={n === verification.verifiedTemplate}>{n}</option>)}</select></div>
              {verification.designReady && <input type="hidden" name="design_ready" value="1" />}
