              <div class="sx-field"><label for="ob-v-ch">{dt('Verification channel')}</label><select id="ob-v-ch" name="panel_channel_id" disabled={!verification.panelReady} data-fill="ob-ch"><option value="">{dt('Off')}</option><SelectChosen items={channels} selected={verification.panelChannelId} prefix="#" /></select></div>
              {verification.panelReady && <input type="hidden" name="panel_ready" value="1" />}
              <div class="ob-panel-actions"><button type="button" class="btn btn-ghost btn-sm" data-vf-action="panel" disabled={!verification.panelReady}><Icon name="ph:paper-plane-tilt-fill" width="14" height="14" /> {dt('Send the panel now')}</button></div>
              <div class="sx-field"><label for="ob-v-img">{dt('Panel picture')}</label><input id="ob-v-img" type="url" name="panel_image_url" value={verification.panelImage} maxlength="500" placeholder="https://..." disabled={!verification.imageReady} data-count /></div>
              {verification.imageReady && <input type="hidden" name="panel_image_ready" value="1" />}
              <p class="sx-hint">{dt('An optional picture at the top of the panel. The link has to start with https. Save, then press Send the panel now to change a panel that is already posted.')}</p>
              <div class="sx-chips"><label class="sx-chip"><input type="checkbox" name="panel_repost" /><span>{dt('Post the panel again when I save')}</span></label></div>
              <p class="sx-hint">{dt('Petto posts a panel there with the verify buttons, so members can verify in the server and not only by DM. Only the member who presses a button sees the picture. Changing the method? Post the panel again.')}</p>
              <div class="sx-chips"><label class="sx-chip"><input type="checkbox" name="dm_on_join" checked={verification.dmOnJoin} disabled={!verification.dmReady || !verification.panelChannelId} data-vf-dm /><span>{dt('Send the DM when someone joins')}</span></label></div>
              {verification.dmReady && <input type="hidden" name="dm_ready" value="1" />}
              <p class="sx-hint">{dt('When it is off, members verify from the panel of the channel. It only turns off when a channel is chosen for the panel.')}</p>
