---
// A number field with a minus and a plus (the counter of the Statistics page): it is the same <input type="number"> with the same name, min, max and value, so the form sends what it always sent.
// Any other attribute (data-s, data-opt, id, aria-label...) goes to the input.
interface Props { name?: string; value: number | string; min?: number | string; max?: number | string; step?: number | string; class?: string; [attr: string]: unknown }
const { name, value, min, max, step = 1, class: extra, ...rest } = Astro.props;
---
<span class:list={['sx-stepper', extra]}>
  <button type="button" class="sx-step" data-sx-step="-1" tabindex="-1" aria-label="−"><svg viewBox="0 0 256 256" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M224 128a8 8 0 0 1-8 8H40a8 8 0 0 1 0-16h176a8 8 0 0 1 8 8Z" /></svg></button>
  <input type="number" name={name} value={value} min={min} max={max} step={step} inputmode="numeric" {...rest} />
  <button type="button" class="sx-step" data-sx-step="1" tabindex="-1" aria-label="+"><svg viewBox="0 0 256 256" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M224 128a8 8 0 0 1-8 8h-88v88a8 8 0 0 1-16 0v-88H32a8 8 0 0 1 0-16h88V32a8 8 0 0 1 16 0v88h88a8 8 0 0 1 8 8Z" /></svg></button>
</span>
