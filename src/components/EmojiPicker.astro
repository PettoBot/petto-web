---
import { Icon } from 'astro-icon/components';
import { UNICODE_EMOJIS } from '../utils/unicodeEmojis';
import emojiInputCode from '../scripts/emoji-input.js?raw';
import { getDashLang, makeT } from '../i18n/dash';
// One picker per page: every input marked data-emoji-input gets a button that opens it.
const dt = makeT(getDashLang(Astro));
const { customEmojis = [] } = Astro.props as { customEmojis?: { id: string; name: string; animated: boolean }[] };
const emojiData = JSON.stringify({
  customEmojis,
  unicode: UNICODE_EMOJIS.map((g) => ({ name: g.name, emojis: g.emojis })),
  words: { pick: dt('Select emoji'), noMatches: dt('No emojis match.'), noServerEmojis: dt('This server has no custom emojis.') },
}).replace(/</g, '\\u003c');
---
  <div class="ep-modal" id="ep-modal" hidden>
    <div class="ep-box" role="dialog" aria-modal="true" aria-label={dt('Select emoji')}>
      <div class="ep-head"><Icon name="ph:smiley-fill" width="18" height="18" /><strong>{dt('Select emoji')}</strong><button type="button" class="ep-x" id="ep-close" aria-label={dt('Close')}><Icon name="ph:x-bold" width="14" height="14" /></button></div>
      <div class="ep-tabs"><button type="button" class="ep-tab" data-tab="server"><Icon name="ph:hard-drives-fill" width="13" height="13" />{dt('Server')}</button><button type="button" class="ep-tab" data-tab="unicode"><Icon name="ph:smiley-fill" width="13" height="13" />{dt('Unicode')}</button></div>
      <input type="search" id="ep-search" class="ep-search" placeholder={dt('Search')} />
      <div class="ep-grid" id="ep-grid"></div>
      <button type="button" class="ep-clear" id="ep-clear">{dt('Remove the emoji')}</button>
    </div>
  </div>
  <script type="application/json" id="ep-data" set:html={emojiData}></script>
  <script is:inline set:html={emojiInputCode}></script>

<style>
  :global(.ep-wrap) { display: inline-flex; align-items: center; position: relative; flex: 1 1 120px; min-width: 0; }
  :global(.ep-wrap input) { width: 100%; padding-right: 46px !important; }
  :global(.ep-btn) { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); width: 30px; height: 30px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); color: var(--text-muted); display: grid; place-items: center; cursor: pointer; padding: 0; font-size: 16px; }
  :global(.ep-btn:hover) { color: var(--accent); border-color: var(--accent); }
  :global(.ep-btn img) { width: 18px; height: 18px; }
  .ep-modal { position: fixed; inset: 0; z-index: 60; background: rgb(0 0 0 / 60%); display: flex; align-items: center; justify-content: center; padding: 16px; }
  .ep-modal[hidden] { display: none; }
  .ep-box { width: min(560px, 100%); max-height: min(640px, 90vh); display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 18px; background: var(--bg-raise); padding: 16px; gap: 12px; }
  .ep-head { display: flex; align-items: center; gap: 10px; font-size: 16px; }
  .ep-head strong { flex: 1; }
  .ep-x { border: none; background: transparent; color: var(--text-muted); cursor: pointer; padding: 6px; border-radius: 8px; }
  .ep-x:hover { background: var(--card); color: var(--text); }
  .ep-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .ep-tab { display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: 1px solid var(--border); background: var(--card); color: var(--text-muted); border-radius: 10px; padding: 10px; font: inherit; font-size: 13px; cursor: pointer; }
  .ep-tab.active { color: var(--text); border-color: var(--accent); background: var(--accent-soft); }
  .ep-search { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font: inherit; font-size: 13px; width: 100%; box-sizing: border-box; }
  .ep-grid { overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(44px, 1fr)); gap: 8px; padding: 4px; min-height: 140px; }
  .ep-grid :global(.ep-group) { grid-column: 1 / -1; font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--text-dim); margin-top: 6px; }
  .ep-grid :global(.ep-emoji) { height: 44px; border: 1px solid var(--border); border-radius: 10px; background: var(--card); display: grid; place-items: center; font-size: 22px; cursor: pointer; padding: 0; }
  .ep-grid :global(.ep-emoji:hover) { border-color: var(--accent); }
  .ep-grid :global(.ep-emoji img) { width: 28px; height: 28px; }
  .ep-grid :global(.ep-none) { grid-column: 1 / -1; color: var(--text-dim); font-size: 13px; text-align: center; padding: 20px 0; }
  .ep-clear { align-self: flex-start; border: 1px solid var(--border); background: var(--card); color: var(--text-muted); border-radius: 8px; padding: 7px 12px; font: inherit; font-size: 12px; cursor: pointer; }
</style>
