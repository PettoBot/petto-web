---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import { UNICODE_EMOJIS } from '../utils/unicodeEmojis';
import { getDashLang, makeT } from '../i18n/dash';
import clientCode from '../scripts/reaction-role-builder.js?raw';

// The builder of reaction roles: one message with an embed and rows of role buttons, as in the dashboards of other bots, with the
// saved embeds as a starting point. The page that holds it reads the server and saves; the form here is plain HTML plus a small script.
const dt = makeT(getDashLang(Astro));

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  channels: { id: string; name: string; type: number }[];
  roles: { id: string; name: string; color: number }[];
  customEmojis: { id: string; name: string; animated: boolean }[];
  templates: { name: string; content: string; embed: { title: string; description: string; color: string; footer: string; image: string; thumbnail: string } | null }[];
  initial: Record<string, unknown>;
  editing: boolean;
  error?: string | null;
  saved?: boolean;
}
const { user, guildId, guildName, guildIcon, channels, roles, customEmojis, templates, initial, editing, error, saved } = Astro.props;

// Everything the script shows comes from here, already in the language of the person.
const words = {
  button: dt('Button'),
  noName: dt('Empty (only the emoji)'),
  color: dt('Button color'),
  role: dt('Role'),
  behavior: dt('What it does'),
  emojiOptional: dt('Emoji (optional)'),
  addButton: dt('Add button'),
  row: dt('Row {a}', { a: '{a}' }),
  rowN: dt('Row'),
  removeButton: dt('Remove button'),
  removeRow: dt('Remove row'),
  selectRole: dt('Select role...'),
  selectEmoji: dt('Select emoji...'),
  noEmoji: dt('No emoji'),
  searchServer: dt('Search server emojis...'),
  searchUnicode: dt('Search emojis...'),
  noMatches: dt('No emojis match.'),
  noServerEmojis: dt('This server has no custom emojis.'),
  blurple: dt('Blurple'),
  gray: dt('Gray'),
  green: dt('Green'),
  red: dt('Red'),
  toggle: dt('Toggle (gives it, takes it on the next click)'),
  addOnly: dt('Add only'),
  removeOnly: dt('Remove only'),
  needChannel: dt('Pick a channel.'),
  needContent: dt('Write some text or turn the embed on.'),
  needButton: dt('Add at least one button.'),
  needRole: dt('Every button needs a role.'),
  needLook: dt('Every button needs a name or an emoji.'),
  needEmojiForEmpty: dt('A button with no name needs an emoji.'),
  today: dt('Today at 12:00 PM'),
  app: dt('APP'),
  previewEmpty: dt('Nothing to show yet.'),
};
const styleOptions = [
  { value: 1, label: words.blurple, color: '#5865f2' },
  { value: 2, label: words.gray, color: '#4e5058' },
  { value: 3, label: words.green, color: '#248046' },
  { value: 4, label: words.red, color: '#da373c' },
];
const textChannels = channels.filter((c) => c.type === 0 || c.type === 5);
const data = { initial, editing, words, styles: styleOptions, roles, customEmojis, templates, unicode: UNICODE_EMOJIS };
const dataJson = JSON.stringify(data).replace(/</g, '\\u003c');
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="reaction-roles" pageTitle={editing ? dt('Edit reaction role') : dt('Create reaction role')}>
  <div class="rb" id="rb">
    <div class="rb-top">
      <a class="rb-back" href={`/dash/guild/${guildId}/automation?section=reaction-roles`}><Icon name="ph:arrow-left-bold" width="13" height="13" />{dt('Back to reaction roles')}</a>
      <h1>{editing ? dt('Edit reaction role') : dt('Create reaction role')}</h1>
    </div>

    {saved && !error && <div class="rb-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved. The message is up to date in Discord.')}</div>}
    {error && <div class="rb-error" role="alert"><Icon name="ph:warning-fill" width="14" height="14" />{error}</div>}
    <div class="rb-error" id="rb-client-error" role="alert" hidden><Icon name="ph:warning-fill" width="14" height="14" /><span></span></div>

    <form method="POST" id="rb-form" autocomplete="off">
      <input type="hidden" name="payload" id="rb-payload" />

      <section class="rb-card">
        <h2><Icon name="ph:hash-bold" width="15" height="15" />{dt('Channel')}</h2>
        <select id="rb-channel" aria-label={dt('Channel')} disabled={editing}>
          <option value="">{dt('Select a channel...')}</option>
          {textChannels.map((c) => <option value={c.id}>{c.type === 5 ? '📢 ' : '#'}{c.name}</option>)}
        </select>
        <p class="rb-hint">{editing ? dt('The message stays in its channel.') : dt('The message is posted in this channel. Announcement channels are marked with 📢.')}</p>
      </section>

      <section class="rb-card">
        <h2><Icon name="ph:note-pencil-bold" width="15" height="15" />{dt('Message and role buttons')}</h2>

        <div class="rb-panel">
          <h3><Icon name="ph:chat-text-fill" width="14" height="14" />{dt('Message')}</h3>
          {templates.length > 0 && (
            <div class="rb-field">
              <label for="rb-template">{dt('Start from a saved embed')}</label>
              <div class="rb-inline">
                <select id="rb-template"><option value="">{dt('Write it here')}</option>{templates.map((tpl, index) => <option value={index}>{tpl.name}</option>)}</select>
                <a class="rb-link" href={`/dash/guild/${guildId}/embeds`} target="_blank" rel="noopener"><Icon name="ph:arrow-square-out-bold" width="12" height="12" />{dt('Open the embed generator')}</a>
              </div>
              <p class="rb-hint">{dt('It copies the text and the first embed of the saved design here; you can change them. Variables such as {user} are not filled in this message.')}</p>
            </div>
          )}
          {templates.length === 0 && <p class="rb-hint"><a class="rb-link" href={`/dash/guild/${guildId}/embeds`} target="_blank" rel="noopener"><Icon name="ph:arrow-square-out-bold" width="12" height="12" />{dt('Design an embed in the embed generator')}</a> {dt('and use it here as a starting point.')}</p>}

          <div class="rb-field">
            <label for="rb-content">{dt('Content')}</label>
            <textarea id="rb-content" rows="3" maxlength="2000" placeholder={dt('Message content (optional)')}></textarea>
          </div>

          <label class="rb-check"><input type="checkbox" id="rb-embed-on" /><span>{dt('Use an embed')}</span></label>
          <div id="rb-embed" class="rb-embed">
            <div class="rb-field"><label for="rb-title">{dt('Title')}</label><input type="text" id="rb-title" maxlength="256" placeholder={dt('Embed title')} /></div>
            <div class="rb-field"><label for="rb-desc">{dt('Description')}</label><textarea id="rb-desc" rows="4" maxlength="4096" placeholder={dt('Embed description')}></textarea></div>
            <div class="rb-grid">
              <div class="rb-field"><label for="rb-color-hex">{dt('Color')}</label>
                <div class="rb-color"><input type="color" id="rb-color" aria-label={dt('Color')} /><input type="text" id="rb-color-hex" maxlength="7" spellcheck="false" /></div>
              </div>
              <div class="rb-field"><label for="rb-footer">{dt('Footer')}</label><input type="text" id="rb-footer" maxlength="2048" placeholder={dt('Footer text (optional)')} /></div>
              <div class="rb-field"><label for="rb-thumb">{dt('Thumbnail link')}</label><input type="url" id="rb-thumb" maxlength="500" placeholder="https://" /></div>
              <div class="rb-field"><label for="rb-image">{dt('Image link')}</label><input type="url" id="rb-image" maxlength="500" placeholder="https://" /></div>
            </div>
          </div>
        </div>

        <div class="rb-panel">
          <h3><Icon name="ph:cursor-fill" width="14" height="14" />{dt('Role buttons')}</h3>
          <div id="rb-rows"></div>
          <button type="button" class="rb-add rb-add-row" id="rb-add-row"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add button row')}</button>
          <p class="rb-hint">{dt('Up to 5 rows of 5 buttons. Petto can only give roles that are below its own role, and it needs Manage Roles.')}</p>
        </div>

        <div class="rb-panel">
          <h3><Icon name="ph:eye-fill" width="14" height="14" />{dt('Preview')}</h3>
          <div class="rb-preview" id="rb-preview"></div>
        </div>
      </section>

      <div class="rb-actions">
        <button type="submit" class="rb-btn rb-primary" id="rb-save"><Icon name="ph:floppy-disk-fill" width="13" height="13" />{editing ? dt('Save changes') : dt('Create reaction role')}</button>
      </div>
    </form>

    <div class="rb-modal" id="rb-modal" hidden>
      <div class="rb-modal-box" role="dialog" aria-modal="true" aria-label={dt('Select emoji')}>
        <div class="rb-modal-head"><Icon name="ph:smiley-fill" width="18" height="18" /><strong>{dt('Select emoji')}</strong><button type="button" class="rb-x" id="rb-modal-close" aria-label={dt('Close')}><Icon name="ph:x-bold" width="14" height="14" /></button></div>
        <div class="rb-tabs"><button type="button" class="rb-tab" data-tab="server"><Icon name="ph:hard-drives-fill" width="13" height="13" />{dt('Server')}</button><button type="button" class="rb-tab" data-tab="unicode"><Icon name="ph:smiley-fill" width="13" height="13" />{dt('Unicode')}</button></div>
        <input type="search" id="rb-emoji-search" class="rb-search" />
        <div class="rb-emoji-grid" id="rb-emoji-grid"></div>
        <button type="button" class="rb-btn rb-clear" id="rb-emoji-clear">{dt('Remove the emoji')}</button>
      </div>
    </div>
  </div>
  <script type="application/json" id="rb-data" set:html={dataJson}></script>
  <script is:inline set:html={clientCode}></script>
</DashGuildLayout>

<style>
  .rb { max-width: 760px; padding-bottom: 90px; }
  .rb-top { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 18px; }
  .rb-top h1 { margin: 0; font-size: 22px; }
  .rb-back { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-muted); border: 1px solid var(--border); background: var(--card); border-radius: 8px; padding: 7px 10px; text-decoration: none; }
  .rb-back:hover { color: var(--accent); border-color: var(--accent); }
  .rb-card { border: 1px solid var(--border); border-radius: 14px; background: var(--bg-raise); padding: 16px 18px; margin-bottom: 16px; }
  .rb-card h2 { margin: 0 0 12px; font-size: 14.5px; display: flex; align-items: center; gap: 8px; }
  .rb-panel { border: 1px solid var(--border); border-radius: 12px; background: var(--card); padding: 14px; margin-bottom: 12px; }
  .rb-panel h3 { margin: 0 0 12px; font-size: 13.5px; display: flex; align-items: center; gap: 7px; }
  .rb-field { display: flex; flex-direction: column; gap: 5px; margin-bottom: 12px; min-width: 0; }
  .rb-field > label, .rb-label { font-size: 12px; font-weight: 600; color: var(--text); }
  .rb input[type="text"], .rb input[type="url"], .rb input[type="search"], .rb select, .rb textarea { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--bg-raise); color: var(--text); font: inherit; font-size: 13px; width: 100%; box-sizing: border-box; min-width: 0; }
  .rb textarea { resize: vertical; line-height: 1.45; }
  .rb input:focus, .rb select:focus, .rb textarea:focus { outline: none; border-color: var(--accent); }
  .rb-inline { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .rb-inline select { flex: 1 1 200px; width: auto; }
  .rb-link { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; color: var(--accent); text-decoration: none; }
  .rb-link:hover { text-decoration: underline; }
  .rb-hint { font-size: 11.5px; color: var(--text-dim); margin: 6px 0 0; line-height: 1.45; }
  .rb-check { display: flex; align-items: center; gap: 8px; font-size: 13px; margin: 2px 0 12px; cursor: pointer; }
  .rb-embed[hidden] { display: none; }
  .rb-embed { border-left: 3px solid var(--accent); padding-left: 12px; }
  .rb-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 12px; }
  .rb-color { display: flex; gap: 8px; align-items: center; }
  .rb-color input[type="color"] { width: 40px; height: 36px; padding: 2px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg-raise); cursor: pointer; flex: none; }
  .rb-color input[type="text"] { font-family: var(--mono); text-transform: uppercase; }
  .rb-error { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--red); background: var(--red-soft); border: 1px solid var(--red); border-radius: 9px; padding: 10px 14px; margin-bottom: 14px; }
  .rb-error[hidden] { display: none; }
  .rb-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 14px; }

  :global(.rb-row) { border: 1px solid var(--border); border-radius: 12px; background: var(--bg-raise); padding: 12px; margin-bottom: 10px; }
  :global(.rb-row-head) { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; font-weight: 600; font-size: 13px; }
  :global(.rb-btn-card) { border: 1px dashed var(--border); border-radius: 10px; padding: 12px; margin-bottom: 10px; background: var(--card); position: relative; }
  :global(.rb-btn-card .rb-del) { position: absolute; top: 8px; right: 8px; }
  :global(.rb-btn-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 12px; }
  :global(.rb-btn-grid .full) { grid-column: 1 / -1; }
  :global(.rb-btn-card label.rb-lbl) { display: block; font-size: 12px; font-weight: 600; margin-bottom: 5px; }
  :global(.rb-del) { border: none; background: var(--red-soft); color: var(--red); border-radius: 7px; padding: 5px 7px; cursor: pointer; display: inline-flex; }
  :global(.rb-del:hover) { background: var(--red); color: #fff; }
  :global(.rb-empty-check) { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; margin-top: 6px; color: var(--text-muted); cursor: pointer; }
  :global(.rb-emoji-btn) { display: flex; align-items: center; gap: 8px; width: 100%; text-align: left; border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--bg-raise); color: var(--text); font: inherit; font-size: 13px; cursor: pointer; }
  :global(.rb-emoji-btn:hover) { border-color: var(--accent); }
  :global(.rb-emoji-btn img) { width: 20px; height: 20px; }
  :global(.rb-style-dot) { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; }
  .rb-add { width: 100%; display: inline-flex; justify-content: center; align-items: center; gap: 6px; border: 1px solid var(--border); border-radius: 9px; background: var(--bg-raise); color: var(--text); padding: 8px; font-size: 12.5px; font-weight: 600; cursor: pointer; }
  .rb-add:hover { border-color: var(--accent); color: var(--accent); }
  :global(.rb-add-btn) { width: 100%; display: inline-flex; justify-content: center; align-items: center; gap: 6px; border: 1px solid var(--border); border-radius: 9px; background: var(--card); color: var(--text); padding: 8px; font-size: 12.5px; font-weight: 600; cursor: pointer; }
  :global(.rb-add-btn:hover) { border-color: var(--accent); color: var(--accent); }
  .rb-add-row { border-style: dashed; margin-top: 4px; }

  .rb-preview { background: #313338; color: #dbdee1; border-radius: 10px; padding: 14px; font-family: system-ui, sans-serif; font-size: 14px; }
  :global(.rb-pv-head) { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; font-weight: 600; color: #f2f3f5; }
  :global(.rb-pv-app) { font-size: 10px; background: #5865f2; color: #fff; border-radius: 4px; padding: 1px 5px; }
  :global(.rb-pv-time) { font-size: 11px; font-weight: 400; color: #949ba4; }
  :global(.rb-pv-content) { white-space: pre-wrap; word-break: break-word; margin-bottom: 6px; }
  :global(.rb-pv-embed) { border-left: 4px solid var(--c, #5865f2); background: #2b2d31; border-radius: 4px; padding: 10px 12px; max-width: 460px; position: relative; margin-bottom: 8px; }
  :global(.rb-pv-title) { font-weight: 700; color: #f2f3f5; margin-bottom: 4px; word-break: break-word; }
  :global(.rb-pv-desc) { white-space: pre-wrap; word-break: break-word; font-size: 13.5px; }
  :global(.rb-pv-footer) { font-size: 12px; color: #b5bac1; margin-top: 8px; }
  :global(.rb-pv-thumb) { position: absolute; top: 10px; right: 10px; width: 64px; height: 64px; object-fit: cover; border-radius: 6px; }
  :global(.rb-pv-image) { display: block; max-width: 100%; border-radius: 6px; margin-top: 8px; }
  :global(.rb-pv-rows) { display: flex; flex-direction: column; gap: 6px; }
  :global(.rb-pv-row) { display: flex; flex-wrap: wrap; gap: 6px; }
  :global(.rb-pv-button) { display: inline-flex; align-items: center; gap: 6px; border-radius: 4px; padding: 6px 14px; min-height: 32px; font-size: 13.5px; font-weight: 500; color: #fff; }
  :global(.rb-pv-button img) { width: 18px; height: 18px; }
  :global(.rb-pv-empty) { color: #949ba4; font-style: italic; }

  .rb-actions { display: flex; justify-content: flex-end; margin-top: 4px; }
  .rb-btn { border: 1px solid var(--border); background: var(--card); color: var(--text); border-radius: 9px; padding: 8px 14px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
  .rb-btn:hover { border-color: var(--accent); }
  .rb-primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink, #111); }
  .rb-primary[disabled] { opacity: .6; cursor: wait; }

  .rb-modal { position: fixed; inset: 0; z-index: 60; background: rgb(0 0 0 / 60%); display: flex; align-items: center; justify-content: center; padding: 16px; }
  .rb-modal[hidden] { display: none; }
  .rb-modal-box { width: min(560px, 100%); max-height: min(640px, 90vh); display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 18px; background: var(--bg-raise); padding: 16px; gap: 12px; }
  .rb-modal-head { display: flex; align-items: center; gap: 10px; font-size: 16px; }
  .rb-modal-head strong { flex: 1; }
  .rb-x { border: none; background: transparent; color: var(--text-muted); cursor: pointer; padding: 6px; border-radius: 8px; }
  .rb-x:hover { background: var(--card); color: var(--text); }
  .rb-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .rb-tab { display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: 1px solid var(--border); background: var(--card); color: var(--text-muted); border-radius: 10px; padding: 10px; font: inherit; font-size: 13px; cursor: pointer; }
  .rb-tab.active { color: var(--text); border-color: var(--accent); background: var(--accent-soft); }
  .rb-emoji-grid { overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(44px, 1fr)); gap: 8px; padding: 4px; min-height: 140px; }
  .rb-emoji-grid :global(.rb-group) { grid-column: 1 / -1; font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--text-dim); margin-top: 6px; }
  .rb-emoji-grid :global(.rb-emoji) { height: 44px; border: 1px solid var(--border); border-radius: 10px; background: var(--card); display: grid; place-items: center; font-size: 22px; cursor: pointer; padding: 0; }
  .rb-emoji-grid :global(.rb-emoji:hover) { border-color: var(--accent); transform: translateY(-1px); }
  .rb-emoji-grid :global(.rb-emoji img) { width: 28px; height: 28px; }
  .rb-emoji-grid :global(.rb-none) { grid-column: 1 / -1; color: var(--text-dim); font-size: 13px; text-align: center; padding: 20px 0; }
  .rb-clear { align-self: flex-start; }

  @media (max-width: 640px) {
    .rb-grid, :global(.rb-btn-grid) { grid-template-columns: minmax(0, 1fr); }
  }
</style>
