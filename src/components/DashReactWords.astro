---
import { getDashLang, dashCatalog } from '../i18n/dash';
// The translations the React apps of the dashboard read (src/react/embeds/t.ts), for this page's language only.
const lang = getDashLang(Astro);
const json = lang === 'en' ? '' : JSON.stringify(dashCatalog(lang)).replace(/</g, '\\u003c');
---
{json && <script type="application/json" id="dash-react-words" set:html={json}></script>}
