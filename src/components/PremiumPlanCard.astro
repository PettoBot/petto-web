---
import { Icon } from 'astro-icon/components';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  slots: number;
  monthly: string;
  annual: string;
  note: string;
  selectedPlan: string;
  checkoutReady: boolean;
  featured?: boolean;
}

// Every plan has the same Premium features (listed once on the page, from src/data/premiumCatalog.ts); a plan only changes how
// many servers it covers. The form opens the purchase dialog (CheckoutConsent) and acts at once, so it is never "unsaved".
const { slots, monthly, annual, note, selectedPlan, checkoutReady, featured = false } = Astro.props;
const label = slots === 1 ? dt('1 server') : dt('{n} servers', { n: slots });
const monthPlan = `premium-${slots}-month`;
const yearPlan = `premium-${slots}-year`;
---

<article class:list={['premium-plan-card dgl-card', { 'premium-plan-featured': featured }]}>
  <div class="premium-plan-top">
    <span class="premium-plan-icon"><Icon name="ph:crown-fill" width="17" height="17" /></span>
    <div class="premium-plan-title">
      <strong>{label}</strong>
      <span>{note}</span>
    </div>
    {featured && <span class="premium-plan-badge">{dt('Most popular')}</span>}
  </div>
  <div class="premium-plan-price"><span>{monthly.split(' ')[0]}</span> {monthly.slice(monthly.indexOf(' '))}</div>
  <div class="premium-plan-annual">{dt('Annual option: {a}', { a: (annual) })}</div>
  <form method="POST" class="premium-plan-form" data-no-dirty>
    <input type="hidden" name="action" value="checkout" />
    <select name="plan" aria-label={dt('Billing period for {s}', { s: label })}>
      <option value={monthPlan} selected={selectedPlan === monthPlan}>{dt('Monthly · {a}', { a: (monthly) })}</option>
      <option value={yearPlan} selected={selectedPlan === yearPlan}>{dt('Annual · {a}', { a: (annual) })}</option>
    </select>
    <button class="btn btn-primary btn-sm" type="submit" disabled={!checkoutReady}>
      <Icon name="ph:credit-card-fill" width="14" height="14" /> {dt('Choose plan')}
    </button>
  </form>
</article>

<style>
  .premium-plan-card {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: linear-gradient(145deg, var(--card), color-mix(in srgb, var(--card) 76%, var(--bg-raise)));
  }
  .premium-plan-featured {
    border-color: color-mix(in srgb, var(--accent) 68%, var(--border));
    background: linear-gradient(145deg, color-mix(in srgb, var(--accent-soft) 65%, var(--card)), var(--card) 54%);
    box-shadow: 0 18px 46px -18px color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .premium-plan-top { display:flex; align-items:center; gap:12px; min-width:0; }
  .premium-plan-icon { display:inline-flex; align-items:center; justify-content:center; flex:none; width:36px; height:36px; border:1px solid color-mix(in srgb, var(--accent) 40%, var(--border)); border-radius:11px; color:var(--accent); background:var(--accent-soft); }
  .premium-plan-title { min-width:0; flex:1; }
  .premium-plan-title strong, .premium-plan-title span { display:block; }
  .premium-plan-title strong { font-size:17px; letter-spacing:-.01em; line-height:1.2; }
  .premium-plan-title span { margin-top:2px; color:var(--text-dim); font-size:12.5px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .premium-plan-badge { flex:none; align-self:flex-start; padding:4px 8px; border-radius:999px; background:var(--accent); color:var(--accent-ink); font-family:var(--mono); font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; }
  .premium-plan-price { margin-top:18px; color:var(--text); font-size:15px; font-weight:700; }
  .premium-plan-price span { font-size:30px; letter-spacing:-.03em; font-variant-numeric:tabular-nums; }
  .premium-plan-annual { margin-top:2px; color:var(--text-dim); font-size:12.5px; }
  .premium-plan-form { display:grid; gap:8px; margin-top:auto; padding-top:16px; }
  .premium-plan-form select { width:100%; padding:10px 11px; border:1px solid var(--border); border-radius:10px; background:var(--bg-raise); color:var(--text); font:inherit; font-size:12.5px; }
  .premium-plan-form button { display:inline-flex; align-items:center; gap:7px; width:100%; justify-content:center; min-height:40px; }
  .premium-plan-form button:disabled { cursor:not-allowed; opacity:.5; }
  @media (max-width:560px) {
    .premium-plan-card { padding:16px; }
    /* On a phone the price sits next to the name, and the period and the button share one row. */
    .premium-plan-price { margin-top:12px; }
    .premium-plan-form { grid-template-columns:minmax(0, 1fr) auto; padding-top:12px; }
    .premium-plan-form button { width:auto; padding-left:14px; padding-right:14px; }
  }
</style>
