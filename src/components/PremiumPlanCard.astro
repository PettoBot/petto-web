---
import { Icon } from 'astro-icon/components';
import InlineIcon from './InlineIcon.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  slots: number;
  monthly: string;
  annual: string;
  note: string;
  selectedPlan: string;
  checkoutReady: boolean;
  featured?: boolean;
}

const { slots, monthly, annual, note, selectedPlan, checkoutReady, featured = false } = Astro.props;
const label = slots === 1 ? 'server' : 'servers';
const monthPlan = `premium-${slots}-month`;
const yearPlan = `premium-${slots}-year`;
// Every plan has the same Premium features, a plan only changes how many servers it covers.
const features = [
  dt('Image cards: advanced editor and every font'),
  dt('Bigger limits for commands, tickets and giveaways'),
  dt('Premium dashboard modules'),
  dt('Priority support queue'),
];
---

<article class:list={['premium-plan-card', { 'premium-plan-featured': featured }]}>
  <div class="premium-plan-topline">
    <span class="premium-plan-icon"><InlineIcon name="ph:crown-fill" width="18" height="18" /></span>
    {featured && <span class="premium-plan-badge">{dt('Most popular')}</span>}
  </div>
  <div class="premium-plan-title">
    <strong>{slots} {label}</strong>
    <span>{note}</span>
  </div>
  <div class="premium-plan-price"><span>{monthly.split(' ')[0]}</span> {monthly.slice(monthly.indexOf(' '))}</div>
  <div class="premium-plan-annual">{dt('Annual option: {a}', { a: (annual) })}</div>
  <ul class="premium-plan-features">
    {features.map((feature) => <li><Icon name="ph:check-fill" width="14" height="14" /> <span>{feature}</span></li>)}
  </ul>
  <form method="POST" class="premium-plan-form">
    <input type="hidden" name="action" value="checkout" />
    <select name="plan" aria-label={`Billing period for ${slots} ${label}`}>
      <option value={monthPlan} selected={selectedPlan === monthPlan}>{dt('Monthly · {a}', { a: (monthly) })}</option>
      <option value={yearPlan} selected={selectedPlan === yearPlan}>{dt('Annual · {a}', { a: (annual) })}</option>
    </select>
    <button class="btn btn-primary btn-sm" type="submit" disabled={!checkoutReady}>
      <Icon name="ph:credit-card-fill" width="14" height="14" /> {dt('Choose plan')}
    </button>
  </form>
</article>

<style>
  .premium-plan-card {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 438px;
    flex-direction: column;
    overflow: hidden;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: linear-gradient(145deg, var(--card), color-mix(in srgb, var(--card) 76%, var(--bg-raise)));
    box-shadow: 0 14px 36px color-mix(in srgb, #000 18%, transparent);
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
  }
  .premium-plan-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 48%, var(--border));
    box-shadow: 0 18px 42px color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .premium-plan-featured {
    border-color: color-mix(in srgb, var(--accent) 68%, var(--border));
    background: linear-gradient(145deg, color-mix(in srgb, var(--accent-soft) 65%, var(--card)), var(--card) 54%);
    box-shadow: 0 18px 46px color-mix(in srgb, var(--accent) 16%, transparent);
  }
  .premium-plan-topline { display:flex; align-items:center; justify-content:space-between; min-height:28px; }
  .premium-plan-icon { display:inline-flex; align-items:center; justify-content:center; width:36px; height:36px; border:1px solid color-mix(in srgb, var(--accent) 40%, var(--border)); border-radius:11px; color:var(--accent); background:var(--accent-soft); }
  .premium-plan-badge { padding:5px 8px; border-radius:999px; background:var(--accent); color:var(--bg); font-family:var(--mono); font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; }
  .premium-plan-title { margin-top:25px; }
  .premium-plan-title strong, .premium-plan-title span { display:block; }
  .premium-plan-title strong { font-size:21px; letter-spacing:-.02em; }
  .premium-plan-title span, .premium-plan-annual { color:var(--text-dim); font-size:13px; }
  .premium-plan-title span { margin-top:5px; }
  .premium-plan-price { margin-top:24px; color:var(--text); font-size:18px; font-weight:700; }
  .premium-plan-price span { font-size:34px; letter-spacing:-.04em; }
  .premium-plan-annual { margin-top:4px; }
  .premium-plan-features { display:grid; gap:10px; margin:25px 0 0; padding:18px 0 0; border-top:1px solid var(--border-soft); list-style:none; }
  .premium-plan-features li { display:flex; align-items:center; gap:8px; color:var(--text-muted); font-size:12px; }
  .premium-plan-features svg { flex:0 0 auto; color:var(--green); }
  .premium-plan-form { display:grid; gap:9px; margin-top:auto; padding-top:24px; }
  .premium-plan-form select { width:100%; padding:10px 11px; border:1px solid var(--border); border-radius:10px; background:var(--bg-raise); color:var(--text); font:inherit; font-size:12px; }
  .premium-plan-form button { display:inline-flex; align-items:center; gap:7px; width:100%; justify-content:center; min-height:40px; }
  .premium-plan-form button:disabled { cursor:not-allowed; opacity:.5; }
  @media (max-width:560px) { .premium-plan-card { min-height:0; padding:19px; } }
</style>
