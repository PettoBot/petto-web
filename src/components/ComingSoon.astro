---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import SpecularButton from '../react/SpecularButton.jsx';
import { useTranslations, localePath, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  page: 'nelu' | 'am' | 'premium';
  icon: string;
}
const { lang, page, icon } = Astro.props;
const t = useTranslations(lang);
const s = t.simplePages[page];
const base = localePath[lang];
---
<Base title={`${s.title} · Petto`} lang={lang}>
  <main>
    <section class="soon-sec">
      <div class="wrap soon-wrap">
        <div class="soon-ic">
          <Icon name={icon} width="30" height="30" />
        </div>
        <div class="eyebrow">{t.simplePages.comingSoon.pill}</div>
        <h1>{s.title}</h1>
        <p class="soon-desc">{s.desc}</p>
        <SpecularButton client:load size="md" href={`${base}/`} transparent tint="#ffffff" tintOpacity={0} baseColor="#bfc4d2" textColor="var(--text)" lineColor="#ffffff" intensity={1.2} speed={0.8} radius={11}>{t.simplePages.comingSoon.backHome}</SpecularButton>
      </div>
    </section>
  </main>
</Base>

<style>
  .soon-sec { padding: 120px 0 140px; }
  .soon-wrap { max-width: 460px; text-align: center; display: flex; flex-direction: column; align-items: center; }
  .soon-ic { width: 60px; height: 60px; border-radius: 16px; background: var(--accent-soft); color: var(--accent); display: flex; align-items: center; justify-content: center; margin-bottom: 22px; }
  .soon-sec .eyebrow { margin-bottom: 12px; }
  .soon-sec h1 { font-size: 32px; margin-bottom: 14px; }
  .soon-desc { color: var(--text-muted); font-size: 15.5px; line-height: 1.6; margin-bottom: 28px; }
</style>
