---
// The "waiting for Petto" state of the dashboard: one script (bound once to the document, scripts/bot-wait.js) and the look of the skeleton, the
// status line and the error with its Try again button. The words come through the client words of the dashboard (DashClientI18n.astro).
import botWaitCode from '../scripts/bot-wait.js?raw';
---
<script is:inline set:html={botWaitCode}></script>

<style is:global>
  .bw { --bw-base: var(--bg-soft, var(--card-hover, rgba(128, 128, 128, .16))); --bw-hi: color-mix(in srgb, var(--text, #fff) 14%, var(--bw-base)); display: grid; gap: 10px; padding: 10px 2px; min-width: 0; max-width: 100%; box-sizing: border-box; }
  .bw-line { margin: 0; display: flex; align-items: center; gap: 9px; font-size: 13px; line-height: 1.35; color: var(--text-muted, inherit); min-width: 0; overflow-wrap: anywhere; }
  .bw-text { min-width: 0; }
  .bw-dots { display: inline-flex; gap: 3px; flex: none; }
  .bw-dots i { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); opacity: .35; animation: bw-dot 1.05s ease-in-out infinite; }
  .bw-dots i:nth-child(2) { animation-delay: .15s; }
  .bw-dots i:nth-child(3) { animation-delay: .3s; }
  .bw-skel { display: grid; gap: 10px; min-width: 0; }
  .bw-bar, .bw-pic { display: block; background: linear-gradient(90deg, var(--bw-base) 25%, var(--bw-hi) 50%, var(--bw-base) 75%); background-size: 220% 100%; animation: bw-shimmer 1.5s linear infinite; }
  .bw-bar { height: 10px; border-radius: 6px; }
  .bw-pic { width: 34px; height: 34px; border-radius: 50%; flex: none; }
  .bw-pic-big { width: 44px; height: 44px; }
  .bw-row, .bw-card { display: flex; align-items: center; gap: 11px; min-width: 0; }
  .bw-card { border: 1px solid var(--border); border-radius: 10px; padding: 9px 11px; background: var(--card); }
  .bw-txt { flex: 1; min-width: 0; display: grid; gap: 7px; }
  .bw-txt .bw-bar:first-child { width: min(62%, 190px); height: 11px; }
  .bw-txt .bw-bar:last-child { width: min(40%, 120px); height: 8px; }
  .bw-lines .bw-bar { height: 12px; }
  .bw-lines .bw-bar:first-child { width: 72%; }
  .bw-lines .bw-bar:last-child { width: 46%; }
  .bw-flat { padding: 0; }
  .bw-err { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px; padding: 10px 2px; min-width: 0; }
  .bw-err-text { margin: 0; flex: 1 1 220px; min-width: 0; font-size: 13px; line-height: 1.4; color: var(--red, #f87171); overflow-wrap: anywhere; }
  .bw-pill { position: fixed; left: 50%; bottom: calc(76px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); z-index: 90; width: max-content; max-width: calc(100vw - 32px); box-sizing: border-box; background: var(--bg-raise, var(--card)); border: 1px solid var(--border); border-radius: 999px; padding: 9px 16px; box-shadow: 0 8px 24px rgba(0, 0, 0, .3); }
  .bw-pill .bw { padding: 0; }
  @keyframes bw-shimmer { from { background-position: 100% 0; } to { background-position: -100% 0; } }
  @keyframes bw-dot { 0%, 100% { opacity: .3; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-2px); } }
  /* No motion: no shimmer and no skeleton at all, only the line of text. */
  @media (prefers-reduced-motion: reduce) {
    .bw-skel { display: none; }
    .bw-dots i { animation: none; opacity: .8; }
  }
</style>
