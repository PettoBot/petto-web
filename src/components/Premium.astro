---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import SpecularButton from '../react/SpecularButton.jsx';
import { type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

// Pricing is handled in the authenticated dashboard, where Polar can tie the checkout
// to the user's Discord account and the selected server slots.
// Same Premium feature set at every tier, priced by how many servers it applies to (Carl-bot's
// own model), plus a flat 15% off if billed annually.
function annual(monthly: number) {
  return Math.round(monthly * 12 * 0.85 * 100) / 100;
}
const PREMIUM_TIERS = [
  { servers: 1, monthly: 4.99 },
  { servers: 3, monthly: 12.99, featured: true },
  { servers: 5, monthly: 19.99 },
];
const CUSTOM_MONTHLY = 25;

const copy = {
  en: {
    eyebrow: 'Pricing', title: 'Plans for every server.', lede: 'Start free. Upgrade when you need more room. Choose your plan in the dashboard and check out securely with Polar.',
    devNote: 'Premium is purchased from the dashboard after you sign in with Discord. Your free plan stays useful either way.',
    monthly: 'Monthly', annual: 'Annual', save: 'Save 15%', perMonth: '/mo', perYear: '/yr billed annually',
    featured: 'Best value', serverLabel: (n: number) => n === 1 ? '1 Server' : `${n} Servers`,
    freeName: 'Free', freeDesc: 'Everything to run a solid Discord server.',
    freeFeatures: ['Moderation, automod & anti-nuke', 'Tickets, leveling & giveaways', 'Web dashboard & embed builder', 'Image cards with the basic editor', 'Bulk role management', 'Unlimited servers'],
    freeCta: 'Add to Discord',
    premiumName: 'Petto Premium', premiumFor: (n: number) => `For ${n} server${n === 1 ? '' : 's'} of your choice.`,
    premiumFeatures: ['Image cards: advanced layer editor, every font, 30 cards', 'Uploaded pictures for your cards (60)', '100 custom commands', '75 autoresponders', '20 ticket categories', '40 level rewards and unlimited log routes', '15 reusable giveaway presets', 'Custom bot avatar, banner, bio and name style (gradient, neon)', 'Priority support queue', 'Access to support server'],
    premiumCta: 'Buy Premium', premiumNote: 'Choose a plan in the dashboard, then select the servers where you want to use it.',
    customName: 'Custom Bot', customDesc: 'A private Petto, dedicated to your server only.',
    customFeatures: ['Everything in Premium', 'Your own avatar & banner', 'Runs only in your server', 'Direct line to the developer'],
    customCta: 'Contact us', customNote: 'The Custom Bot is not live yet, reach out on the support server if this is what you need.',
    limitsEyebrow: 'Bigger limits', limitsTitle: 'Free → Premium',
    limits: [
      { label: 'Custom commands', free: '50', premium: '100' },
      { label: 'Auto responders', free: '15', premium: '75' },
      { label: 'Ticket categories', free: '5', premium: '20' },
      { label: 'Giveaway presets', free: '3', premium: '15' },
      { label: 'Level rewards', free: '10', premium: '40' },
      { label: 'Log routes', free: '8', premium: 'Unlimited' },
      { label: 'Image cards', free: '3', premium: '30' },
      { label: 'Uploaded pictures', free: '5', premium: '60' },
      { label: 'Bot name style', free: 'None', premium: 'Gradient, neon, glow' },
      { label: 'Card editor and fonts', free: 'Basic, 4 fonts', premium: 'Advanced, 16 fonts' },
    ],
    ctaBandTitle: 'Ready to upgrade?', ctaBandDesc: 'Open the dashboard to choose a plan, pay with Polar, and assign your Premium slots.', ctaBandBtn: 'Open Premium in dashboard',
  },
  es: {
    eyebrow: 'Precios', title: 'Planes para cada server.', lede: 'Empezá gratis. Sube de plan cuando necesites más. Elige tu plan en la Dash y paga de forma segura con Polar.',
    devNote: 'Premium se compra desde la Dash después de iniciar sesión con Discord. El plan Free sigue siendo útil para todos.',
    monthly: 'Mensual', annual: 'Anual', save: 'Ahorrá 15%', perMonth: '/mes', perYear: '/año, facturado anual',
    featured: 'La mejor opción', serverLabel: (n: number) => n === 1 ? '1 servidor' : `${n} servidores`,
    freeName: 'Free', freeDesc: 'Todo lo necesario para un server sólido.',
    freeFeatures: ['Moderación, automod y anti-nuke', 'Tickets, niveles y sorteos', 'Dashboard web y editor de embeds', 'Tarjetas de imagen con el editor básico', 'Gestión masiva de roles', 'Servers ilimitados'],
    freeCta: 'Añadir a Discord',
    premiumName: 'Petto Premium', premiumFor: (n: number) => `Para ${n} server${n === 1 ? '' : 's'} a elección.`,
    premiumFeatures: ['Tarjetas de imagen: editor avanzado de capas, todas las fuentes, 30 tarjetas', 'Imágenes subidas para tus tarjetas (60)', '100 comandos propios', '75 autorespuestas', '20 categorías de tickets', '40 recompensas de nivel y rutas de logs ilimitadas', '15 presets reutilizables de sorteo', 'Avatar, banner, bio y estilo de nombre (degradado, neón) personalizados', 'Cola de soporte prioritaria', 'Acceso al server de soporte'],
    premiumCta: 'Comprar Premium', premiumNote: 'Elige un plan en la Dash y después selecciona los servers donde quieres usarlo.',
    customName: 'Bot personalizado', customDesc: 'Un Petto privado, dedicado solo a tu server.',
    customFeatures: ['Todo lo de Premium', 'Tu propio avatar y banner', 'Corre solo en tu server', 'Línea directa con el desarrollador'],
    customCta: 'Contáctanos', customNote: 'El bot personalizado todavía no existe, escríbenos en el server de soporte si esto es lo que necesitas.',
    limitsEyebrow: 'Límites más altos', limitsTitle: 'Gratis → Premium',
    limits: [
      { label: 'Comandos propios', free: '50', premium: '100' },
      { label: 'Autorespuestas', free: '15', premium: '75' },
      { label: 'Categorías de tickets', free: '5', premium: '20' },
      { label: 'Presets de sorteo', free: '3', premium: '15' },
      { label: 'Recompensas de nivel', free: '10', premium: '40' },
      { label: 'Rutas de logs', free: '8', premium: 'Ilimitadas' },
      { label: 'Tarjetas de imagen', free: '3', premium: '30' },
      { label: 'Imágenes subidas', free: '5', premium: '60' },
      { label: 'Estilo del nombre del bot', free: 'Ninguno', premium: 'Degradado, neón, brillo' },
      { label: 'Editor y fuentes de tarjetas', free: 'Básico, 4 fuentes', premium: 'Avanzado, 16 fuentes' },
    ],
    ctaBandTitle: '¿Listo para subir de plan?', ctaBandDesc: 'Abrí la Dash para elegir un plan, pagar con Polar y asignar tus espacios Premium.', ctaBandBtn: 'Abrir Premium en la Dash',
  },
  'pt-BR': {
    eyebrow: 'Preços', title: 'Planos pra cada server.', lede: 'Comece grátis. Suba de plano quando precisar de mais. Escolha seu plano na Dash e pague com segurança pela Polar.',
    devNote: 'O Premium é comprado pela Dash depois de entrar com o Discord. O plano Free continua útil para todos.',
    monthly: 'Mensal', annual: 'Anual', save: 'Economize 15%', perMonth: '/mês', perYear: '/ano, cobrado anualmente',
    featured: 'Melhor opção', serverLabel: (n: number) => n === 1 ? '1 servidor' : `${n} servidores`,
    freeName: 'Free', freeDesc: 'Tudo pra rodar um server sólido.',
    freeFeatures: ['Moderação, automod e anti-nuke', 'Tickets, níveis e sorteios', 'Dashboard web e editor de embeds', 'Cartões de imagem com o editor básico', 'Gestão em massa de cargos', 'Servers ilimitados'],
    freeCta: 'Adicionar ao Discord',
    premiumName: 'Petto Premium', premiumFor: (n: number) => `Para ${n} server${n === 1 ? '' : 's'} de sua escolha.`,
    premiumFeatures: ['Cartões de imagem: editor avançado de camadas, todas as fontes, 30 cartões', 'Imagens enviadas para seus cartões (60)', '100 comandos personalizados', '75 autorespostas', '20 categorias de tickets', '40 recompensas de nível e rotas de logs ilimitadas', '15 presets reutilizáveis de sorteio', 'Avatar, banner, bio e estilo de nome (gradiente, neon) personalizados', 'Fila de suporte prioritária', 'Acesso ao server de suporte'],
    premiumCta: 'Comprar Premium', premiumNote: 'Escolha um plano na Dash e depois selecione os servers onde quer usar o Premium.',
    customName: 'Bot personalizado', customDesc: 'Um Petto privado, dedicado só ao seu server.',
    customFeatures: ['Tudo do Premium', 'Seu próprio avatar e banner', 'Roda só no seu server', 'Linha direta com o desenvolvedor'],
    customCta: 'Fale com a gente', customNote: 'O bot personalizado ainda não existe, chama no server de suporte se for isso que você precisa.',
    limitsEyebrow: 'Limites maiores', limitsTitle: 'Grátis → Premium',
    limits: [
      { label: 'Comandos personalizados', free: '50', premium: '100' },
      { label: 'Autorespostas', free: '15', premium: '75' },
      { label: 'Categorias de tickets', free: '5', premium: '20' },
      { label: 'Presets de sorteio', free: '3', premium: '15' },
      { label: 'Recompensas de nível', free: '10', premium: '40' },
      { label: 'Rotas de logs', free: '8', premium: 'Ilimitadas' },
      { label: 'Cartões de imagem', free: '3', premium: '30' },
      { label: 'Imagens enviadas', free: '5', premium: '60' },
      { label: 'Estilo do nome do bot', free: 'Nenhum', premium: 'Gradiente, neon, brilho' },
      { label: 'Editor e fontes dos cartões', free: 'Básico, 4 fontes', premium: 'Avançado, 16 fontes' },
    ],
    ctaBandTitle: 'Pronto para fazer upgrade?', ctaBandDesc: 'Abra a Dash para escolher um plano, pagar pela Polar e selecionar seus espaços Premium.', ctaBandBtn: 'Abrir Premium na Dash',
  },
}[lang];

const premiumCards = PREMIUM_TIERS.map((tier) => ({
  key: `premium-${tier.servers}`,
  servers: tier.servers,
  featured: Boolean(tier.featured),
  monthly: tier.monthly,
  annual: annual(tier.monthly),
}));
---
<Base title={`${copy.eyebrow} · Petto`} lang={lang}>
  <main>
    <section class="pr-hero">
      <div class="wrap pr-hero-wrap">
        <div class="eyebrow reveal">{copy.eyebrow}</div>
        <h1 class="reveal">{copy.title}</h1>
        <p class="pr-lede reveal">{copy.lede}</p>

        <div class="pr-dev-note reveal">
          <Icon name="ph:wrench-fill" width="13" height="13" />
          {copy.devNote}
        </div>

        <div class="pr-toggle" id="prToggle" role="tablist">
          <button type="button" class="pr-toggle-btn active" data-plan="monthly" role="tab" aria-selected="true">{copy.monthly}</button>
          <button type="button" class="pr-toggle-btn" data-plan="annual" role="tab" aria-selected="false">{copy.annual}<em class="pr-save">{copy.save}</em></button>
        </div>
      </div>
    </section>

    <section class="pr-carousel-sec reveal">
      <div class="wrap pr-carousel-wrap">
        <button type="button" class="pr-arrow pr-arrow-prev" id="prPrev" aria-label="Previous"><Icon name="ph:caret-left-bold" width="16" height="16" /></button>
        <div class="pr-carousel" id="prCarousel">
          <div class="pr-card pr-card-free">
            <div class="pr-banner pr-banner-free">
              <div class="pr-banner-deco"><Icon name="ph:heart-fill" /><Icon name="ph:sparkle-fill" /><Icon name="ph:smiley-fill" /><Icon name="ph:users-three-fill" /></div>
              <img src="/assets/mascot-icon.png" alt="" class="pr-banner-mascot" />
              <span class="pr-banner-tag">Petto</span>
            </div>
            <div class="pr-card-body">
              <div class="pr-card-name">{copy.freeName}</div>
              <div class="pr-card-price"><span class="pr-card-amount">$0</span></div>
              <a class="btn btn-ghost pr-card-cta" href="https://petto.sbs/invite" target="_blank" rel="noopener">{copy.freeCta}</a>
              <p class="pr-card-lede">{copy.freeDesc}</p>
              <ul class="pr-card-features">
                {copy.freeFeatures.map((f) => <li><Icon name="ph:check-bold" width="12" height="12" />{f}</li>)}
              </ul>
            </div>
          </div>

          {premiumCards.map((tier) => (
            <div class:list={['pr-card', { 'pr-card-featured': tier.featured }]}>
              {tier.featured && <div class="pr-ribbon">{copy.featured}</div>}
              <div class="pr-banner pr-banner-premium">
                <div class="pr-banner-deco"><Icon name="ph:chart-line-up-fill" /><Icon name="ph:gear-fill" /><Icon name="ph:check-circle-fill" /><Icon name="ph:users-three-fill" /></div>
                <span class="pr-banner-server">{copy.serverLabel(tier.servers)}</span>
                <div class="pr-banner-mascot-wrap">
                  <img src="/assets/mascot-icon.png" alt="" class="pr-banner-mascot" />
                  <div class="pr-crown"><Icon name="ph:crown-fill" width="13" height="13" /></div>
                </div>
                <span class="pr-banner-tag">Petto</span>
              </div>
              <div class="pr-card-body">
                <div class="pr-card-name">{copy.premiumName} | {copy.serverLabel(tier.servers)}</div>
                <div class="pr-card-price">
                  <span class="pr-card-amount" data-monthly={tier.monthly.toFixed(2)} data-annual={(tier.annual / 12).toFixed(2)}>${tier.monthly.toFixed(2)}</span>
                  <span class="pr-card-suffix" data-suffix-monthly={copy.perMonth} data-suffix-annual={copy.perYear}>{copy.perMonth}</span>
                </div>
                <p class="pr-card-annual-note" data-annual-note hidden>${tier.annual.toFixed(2)}{copy.perYear}</p>
                <SpecularButton client:load className="pr-card-cta" size="md" href={`/dash/premium?plan=premium-${tier.servers}-month`} transparent tint="#ffffff" tintOpacity={0} baseColor="#bfc4d2" textColor="var(--text)" lineColor="#ffffff" intensity={1.2} speed={0.8} radius={11}>{copy.premiumCta}</SpecularButton>
                <p class="pr-card-lede">{copy.premiumFor(tier.servers)}</p>
                <ul class="pr-card-features">
                  {copy.premiumFeatures.map((f) => <li><Icon name="ph:check-bold" width="12" height="12" />{f}</li>)}
                </ul>
                <p class="pr-card-note">{copy.premiumNote}</p>
              </div>
            </div>
          ))}

          <div class="pr-card">
            <div class="pr-banner pr-banner-custom">
              <div class="pr-banner-deco"><Icon name="ph:paint-brush-fill" /><Icon name="ph:link-fill" /><Icon name="ph:crown-fill" /><Icon name="ph:star-fill" /></div>
              <div class="pr-banner-mascot-wrap">
                <img src="/assets/mascot-icon.png" alt="" class="pr-banner-mascot" />
                <div class="pr-crown"><Icon name="ph:crown-fill" width="13" height="13" /></div>
              </div>
              <span class="pr-banner-tag">Petto</span>
            </div>
            <div class="pr-card-body">
              <div class="pr-card-name">{copy.customName}</div>
              <div class="pr-card-price">
                <span class="pr-card-amount" data-monthly={CUSTOM_MONTHLY.toFixed(2)} data-annual={(annual(CUSTOM_MONTHLY) / 12).toFixed(2)}>${CUSTOM_MONTHLY.toFixed(2)}</span>
                <span class="pr-card-suffix" data-suffix-monthly={copy.perMonth} data-suffix-annual={copy.perYear}>{copy.perMonth}</span>
              </div>
              <p class="pr-card-annual-note" data-annual-note hidden>${annual(CUSTOM_MONTHLY).toFixed(2)}{copy.perYear}</p>
              <a class="btn btn-ghost pr-card-cta" href="https://petto.sbs/support" target="_blank" rel="noopener">{copy.customCta}</a>
              <p class="pr-card-lede">{copy.customDesc}</p>
              <ul class="pr-card-features">
                {copy.customFeatures.map((f) => <li><Icon name="ph:check-bold" width="12" height="12" />{f}</li>)}
              </ul>
              <p class="pr-card-note">{copy.customNote}</p>
            </div>
          </div>
        </div>
        <button type="button" class="pr-arrow pr-arrow-next" id="prNext" aria-label="Next"><Icon name="ph:caret-right-bold" width="16" height="16" /></button>
      </div>
      <div class="pr-dots" id="prDots"></div>
    </section>

    <section class="pr-limits alt">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="eyebrow">{copy.limitsEyebrow}</div>
          <h2>{copy.limitsTitle}</h2>
        </div>
        <div class="pr-table reveal">
          {copy.limits.map((row) => (
            <div class="pr-table-row">
              <span class="pr-table-label">{row.label}</span>
              <span class="pr-table-values">
                <span class="pr-table-free">{row.free}</span>
                <Icon name="ph:arrow-right" class="pr-table-arrow" />
                <span class="pr-table-premium">{row.premium}</span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="pr-ctaband">
      <div class="wrap reveal">
        <h2>{copy.ctaBandTitle}</h2>
        <p>{copy.ctaBandDesc}</p>
        <SpecularButton client:load size="md" href="/dash/premium" transparent tint="#ffffff" tintOpacity={0} baseColor="#bfc4d2" textColor="var(--text)" lineColor="#ffffff" intensity={1.2} speed={0.8} radius={11}>{copy.ctaBandBtn}</SpecularButton>
      </div>
    </section>
  </main>
</Base>

<script>
  (function () {
    var toggle = document.getElementById('prToggle');
    if (toggle) {
      toggle.querySelectorAll('.pr-toggle-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          toggle.querySelectorAll('.pr-toggle-btn').forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
          var isAnnual = (btn as HTMLElement).dataset.plan === 'annual';

          document.querySelectorAll<HTMLElement>('[data-monthly]').forEach(function (amountEl) {
            var monthly = amountEl.getAttribute('data-monthly');
            var annualEach = amountEl.getAttribute('data-annual');
            amountEl.textContent = '$' + (isAnnual ? annualEach : monthly);
          });
          document.querySelectorAll<HTMLElement>('[data-suffix-monthly]').forEach(function (suffixEl) {
            suffixEl.textContent = isAnnual ? suffixEl.getAttribute('data-suffix-annual') : suffixEl.getAttribute('data-suffix-monthly');
          });
          document.querySelectorAll<HTMLElement>('[data-annual-note]').forEach(function (noteEl) {
            noteEl.hidden = !isAnnual;
          });
        });
      });
    }

    var carousel = document.getElementById('prCarousel');
    var prev = document.getElementById('prPrev');
    var next = document.getElementById('prNext');
    var dotsWrap = document.getElementById('prDots');
    if (!carousel || !prev || !next || !dotsWrap) return;

    var carouselState = carousel as HTMLElement & { _t?: number };
    var cards = Array.prototype.slice.call(carousel.children);
    cards.forEach(function (_, i) {
      var dot = document.createElement('button');
      dot.className = 'pr-dot' + (i === 0 ? ' active' : '');
      dot.type = 'button';
      dot.addEventListener('click', function () { scrollToCard(i); });
      dotsWrap.appendChild(dot);
    });

    function scrollToCard(i) {
      var card = cards[i];
      if (card) carousel.scrollTo({ left: card.offsetLeft - carousel.offsetLeft, behavior: 'smooth' });
    }

    function activeIndex() {
      var scrollLeft = carousel.scrollLeft;
      var closest = 0;
      var min = Infinity;
      cards.forEach(function (card, i) {
        var d = Math.abs(card.offsetLeft - carousel.offsetLeft - scrollLeft);
        if (d < min) { min = d; closest = i; }
      });
      return closest;
    }

    function updateDots() {
      var idx = activeIndex();
      dotsWrap.querySelectorAll('.pr-dot').forEach(function (d, i) { d.classList.toggle('active', i === idx); });
    }

    carousel.addEventListener('scroll', function () {
      window.clearTimeout(carouselState._t);
      carouselState._t = window.setTimeout(updateDots, 100);
    });
    prev.addEventListener('click', function () { scrollToCard(Math.max(0, activeIndex() - 1)); });
    next.addEventListener('click', function () { scrollToCard(Math.min(cards.length - 1, activeIndex() + 1)); });
  })();
</script>

<style>
  .pr-hero { padding: 72px 0 8px; text-align: center; }
  .pr-hero-wrap { max-width: 560px; }
  .pr-hero h1 { font-size: 32px; margin: 12px 0 12px; }
  .pr-lede { color: var(--text-muted); font-size: 15px; line-height: 1.6; max-width: 50ch; margin: 0 auto 24px; }

  .pr-dev-note {
    display: inline-flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--yellow);
    background: var(--yellow-soft); border: 1px solid var(--yellow); border-radius: 999px;
    padding: 8px 16px; margin: 0 auto 28px; max-width: fit-content; line-height: 1.4;
  }
  .pr-dev-note :global(svg) { flex-shrink: 0; }

  .pr-toggle { display: inline-flex; padding: 4px; border: 1px solid var(--border); border-radius: 999px; background: var(--card); gap: 2px; }
  .pr-toggle-btn { position: relative; display: flex; align-items: center; gap: 6px; padding: 9px 18px; border-radius: 999px; border: none; background: none; color: var(--text-muted); font-family: var(--sans); font-size: 13.5px; font-weight: 600; cursor: pointer; }
  .pr-toggle-btn.active { background: var(--accent); color: var(--accent-ink); }
  .pr-save { font-size: 10.5px; font-weight: 700; color: var(--green); background: var(--green-soft); padding: 2px 6px; border-radius: 999px; }
  .pr-toggle-btn.active .pr-save { color: var(--green); background: rgba(255,255,255,0.15); }

  .pr-carousel-sec { padding: 44px 0 20px; }
  .pr-carousel-wrap { position: relative; display: flex; align-items: center; gap: 8px; }
  .pr-carousel { display: flex; gap: 18px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding: 14px 4px 6px; flex: 1; }
  .pr-carousel::-webkit-scrollbar { display: none; }

  .pr-arrow { flex-shrink: 0; width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--border); background: var(--card); color: var(--text); display: flex; align-items: center; justify-content: center; cursor: pointer; }
  .pr-arrow:hover { border-color: var(--text-dim); }

  .pr-card { position: relative; scroll-snap-align: start; flex: 0 0 300px; display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 16px; background: var(--card); overflow: hidden; }
  .pr-card-featured { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), 0 24px 48px -24px rgba(131,153,255,0.35); }
  .pr-ribbon { position: relative; z-index: 2; background: var(--accent); color: var(--accent-ink); font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; text-align: center; padding: 7px 0; }

  .pr-banner { position: relative; height: 118px; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .pr-banner-free { background: linear-gradient(135deg, var(--bg-raise) 55%, var(--card) 55%); }
  .pr-banner-premium { background: linear-gradient(135deg, var(--accent-soft) 55%, var(--card) 55%); }
  .pr-banner-custom { background: linear-gradient(135deg, rgba(217,164,65,0.18) 55%, var(--card) 55%); }

  .pr-banner-deco { position: absolute; inset: 0; }
  .pr-banner-deco :global(svg) { position: absolute; color: var(--text-dim); opacity: 0.35; width: 15px; height: 15px; }
  .pr-banner-deco :global(svg:nth-child(1)) { top: 14px; left: 16px; }
  .pr-banner-deco :global(svg:nth-child(2)) { top: 16px; right: 20px; }
  .pr-banner-deco :global(svg:nth-child(3)) { bottom: 16px; left: 22px; }
  .pr-banner-deco :global(svg:nth-child(4)) { bottom: 14px; right: 16px; }

