---
import { Icon } from 'astro-icon/components';
import CheckoutConsent from './CheckoutConsent.astro';
import Base from '../layouts/Base.astro';
import SpecularButton from '../react/SpecularButton.jsx';
import { type Locale } from '../i18n/ui';
import { PREMIUM_TIERS, CUSTOM_MONTHLY, annual, tr, freeFeatures, premiumFeatures, customFeatures, compareRows } from '../data/premiumCatalog';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

// Pricing is handled in the authenticated dashboard, where Polar can tie the checkout
// to the user's Discord account and the selected server slots.
// The plans, prices and benefits come from src/data/premiumCatalog.ts (shared with the dashboard).
const tierList = (or: string) => {
  const list = PREMIUM_TIERS.map((tier) => tier.servers);
  return `${list.slice(0, -1).join(', ')} ${or} ${list[list.length - 1]}`;
};

const copy = {
  en: {
    eyebrow: 'Pricing', title: 'Plans for every server.', lede: 'Petto is free for almost everything. Premium gives about twice the room and a few small touches, and nothing important is locked behind it.',
    monthly: 'Monthly', annual: 'Annual', save: 'Save 15%', perMonth: '/mo', perYear: '/yr billed annually',
    featured: 'Best value', serverLabel: (n: number) => n === 1 ? '1 Server' : `${n} Servers`,
    freeName: 'Free', freeDesc: 'Everything to run a solid Discord server.',
    freeCta: 'Add to Discord',
    premiumName: 'Petto Premium', premiumFor: (n: number) => `For ${n} server${n === 1 ? '' : 's'} of your choice.`,
    premiumDesc: 'The same Premium features in every plan. A plan only changes how many servers it covers.',
    premiumCta: 'Buy Premium', premiumNote: 'Choose a plan in the dashboard, then select the servers where you want to use it.',
    seeFeatures: 'See everything Premium adds',
    customName: 'Custom Bot', customDesc: 'A private Petto, dedicated to your server only.',
    customEverything: 'Everything in Premium',
    customCta: 'Contact us', customNote: 'The Custom Bot is not live yet, reach out on the support server if this is what you need.',
    featuresEyebrow: 'What you get', featuresTitle: 'Everything Premium adds', newBadge: 'New',
    limitsEyebrow: 'About twice the room', limitsTitle: 'Free → Premium', colFree: 'Free', colPremium: 'Premium',
    alwaysFreeTitle: 'Always free, with no Premium limit',
    alwaysFree: 'Moderation, automod, anti-nuke, anti-scam, verification, logging of every event, level rewards, backups, forms, appeals and the embed builder.',
    stepsEyebrow: 'How it works', stepsTitle: 'Three small steps.',
    steps: [
      ['Sign in with Discord', 'Premium is purchased from the dashboard after you sign in with Discord.'],
      ['Pick a plan in the dashboard', `Choose ${tierList('or')} servers, billed monthly or annually with 15% off.`],
      ['Pay with Polar, choose servers', 'Check out securely with Polar, then select the servers where you want to use it.'],
    ],
    trust: [
      ['ph:credit-card-fill', 'Payments by Polar', 'Polar handles the payment, taxes and receipts. Petto never sees your card.'],
      ['ph:calendar-check-fill', 'Cancel at any time', 'Premium stays active until the end of the period you already paid.'],
    ],
    refundsTitle: 'Purchases and refunds', refundsDesc: 'How paying, cancelling and refunds work.',
    faqEyebrow: 'FAQ', faqTitle: 'Questions, answered.',
    faq: [
      ['Can I cancel at any time?', 'Yes. Cancel from the dashboard (Manage billing) or from the Polar customer portal. Premium stays active until the end of the period you already paid, and then it stops.'],
      ['Do you give refunds?', 'Payments for Premium are not refunded, including the unused part of a period. We do refund a charge that was made twice, a charge made by mistake, and a charge for which Premium never activated and we could not fix it.'],
      ['Who handles the payment?', 'Polar acts as the seller and handles the payment, taxes and receipts. Petto never sees or stores your card details.'],
      ['Which servers get Premium?', `A plan covers ${tierList('or')} servers of your choice. After paying, you select them in the dashboard, in servers where you have Manage Server or Administrator.`],
      ['What happens if Premium ends?', 'Paid modules fall back to Free, assigned slots are released, and Premium customization is restored to the server defaults. Everything free keeps working.'],
    ],
    faqRefundLink: 'Read the full policy',
    ctaBandTitle: 'Ready to upgrade?', ctaBandDesc: 'Open the dashboard to choose a plan, pay with Polar, and assign your Premium slots.', ctaBandBtn: 'Open Premium in dashboard',
  },
  es: {
    eyebrow: 'Precios', title: 'Planes para cada server.', lede: 'Petto es gratis para casi todo. Premium da cerca del doble de espacio y algunos detalles, y nada importante queda detrás de él.',
    monthly: 'Mensual', annual: 'Anual', save: 'Ahorrá 15%', perMonth: '/mes', perYear: '/año, facturado anual',
    featured: 'La mejor opción', serverLabel: (n: number) => n === 1 ? '1 servidor' : `${n} servidores`,
    freeName: 'Free', freeDesc: 'Todo lo necesario para un server sólido.',
    freeCta: 'Añadir a Discord',
    premiumName: 'Petto Premium', premiumFor: (n: number) => `Para ${n} server${n === 1 ? '' : 's'} a elección.`,
    premiumDesc: 'Las mismas funciones Premium en cada plan. Un plan solo cambia cuántos servers cubre.',
    premiumCta: 'Comprar Premium', premiumNote: 'Elige un plan en la Dash y después selecciona los servers donde quieres usarlo.',
    seeFeatures: 'Ver todo lo que suma Premium',
    customName: 'Bot personalizado', customDesc: 'Un Petto privado, dedicado solo a tu server.',
    customEverything: 'Todo lo de Premium',
    customCta: 'Contáctanos', customNote: 'El bot personalizado todavía no existe, escríbenos en el server de soporte si esto es lo que necesitas.',
    featuresEyebrow: 'Lo que obtienes', featuresTitle: 'Todo lo que suma Premium', newBadge: 'Nuevo',
    limitsEyebrow: 'Cerca del doble de espacio', limitsTitle: 'Gratis → Premium', colFree: 'Gratis', colPremium: 'Premium',
    alwaysFreeTitle: 'Siempre gratis, sin límite Premium',
    alwaysFree: 'Moderación, automod, anti-nuke, anti-estafas, verificación, logs de cada evento, recompensas de nivel, backups, formularios, apelaciones y el editor de embeds.',
    stepsEyebrow: 'Cómo funciona', stepsTitle: 'Tres pasos cortos.',
    steps: [
      ['Inicia sesión con Discord', 'Premium se compra desde la Dash después de iniciar sesión con Discord.'],
      ['Elige un plan en la Dash', `Elige ${tierList('o')} servers, con pago mensual o anual con 15% de descuento.`],
      ['Paga con Polar y elige servers', 'Paga de forma segura con Polar y después selecciona los servers donde quieres usarlo.'],
    ],
    trust: [
      ['ph:credit-card-fill', 'Pagos con Polar', 'Polar se encarga del pago, los impuestos y los recibos. Petto nunca ve tu tarjeta.'],
      ['ph:calendar-check-fill', 'Cancela cuando quieras', 'Premium sigue activo hasta el final del periodo que ya pagaste.'],
    ],
    refundsTitle: 'Compras y reembolsos', refundsDesc: 'Cómo funcionan los pagos, la cancelación y los reembolsos.',
    faqEyebrow: 'Preguntas', faqTitle: 'Preguntas frecuentes.',
    faq: [
      ['¿Puedo cancelar en cualquier momento?', 'Sí. Cancela desde la Dash (Gestionar facturación) o desde el portal de clientes de Polar. Premium sigue activo hasta el final del periodo que ya pagaste y luego se detiene.'],
      ['¿Hacen reembolsos?', 'Los pagos de Premium no se reembolsan, incluida la parte sin usar de un periodo. Sí reembolsamos un cobro hecho dos veces, un cobro hecho por error y un cobro por el que Premium nunca se activó y no pudimos arreglarlo.'],
      ['¿Quién se encarga del pago?', 'Polar actúa como vendedor y se encarga del pago, los impuestos y los recibos. Petto nunca ve ni guarda los datos de tu tarjeta.'],
      ['¿Qué servers reciben Premium?', `Un plan cubre ${tierList('o')} servers a elección. Después de pagar, los seleccionas en la Dash, en servers donde tengas Gestionar servidor o Administrador.`],
      ['¿Qué pasa si Premium termina?', 'Los módulos de pago vuelven a Gratis, los espacios asignados se liberan y la personalización Premium vuelve a los valores por defecto del servidor. Todo lo gratis sigue funcionando.'],
    ],
    faqRefundLink: 'Lee la política completa',
    ctaBandTitle: '¿Listo para subir de plan?', ctaBandDesc: 'Abrí la Dash para elegir un plan, pagar con Polar y asignar tus espacios Premium.', ctaBandBtn: 'Abrir Premium en la Dash',
  },
  'pt-BR': {
    eyebrow: 'Preços', title: 'Planos pra cada server.', lede: 'O Petto é grátis para quase tudo. O Premium dá cerca do dobro de espaço e alguns detalhes, e nada importante fica preso a ele.',
    monthly: 'Mensal', annual: 'Anual', save: 'Economize 15%', perMonth: '/mês', perYear: '/ano, cobrado anualmente',
    featured: 'Melhor opção', serverLabel: (n: number) => n === 1 ? '1 servidor' : `${n} servidores`,
    freeName: 'Free', freeDesc: 'Tudo pra rodar um server sólido.',
    freeCta: 'Adicionar ao Discord',
    premiumName: 'Petto Premium', premiumFor: (n: number) => `Para ${n} server${n === 1 ? '' : 's'} de sua escolha.`,
    premiumDesc: 'Os mesmos recursos Premium em todos os planos. Um plano só muda quantos servers ele cobre.',
    premiumCta: 'Comprar Premium', premiumNote: 'Escolha um plano na Dash e depois selecione os servers onde quer usar o Premium.',
    seeFeatures: 'Ver tudo o que o Premium adiciona',
    customName: 'Bot personalizado', customDesc: 'Um Petto privado, dedicado só ao seu server.',
    customEverything: 'Tudo do Premium',
    customCta: 'Fale com a gente', customNote: 'O bot personalizado ainda não existe, chama no server de suporte se for isso que você precisa.',
    featuresEyebrow: 'O que você ganha', featuresTitle: 'Tudo o que o Premium adiciona', newBadge: 'Novo',
    limitsEyebrow: 'Cerca do dobro de espaço', limitsTitle: 'Grátis → Premium', colFree: 'Grátis', colPremium: 'Premium',
    alwaysFreeTitle: 'Sempre grátis, sem limite Premium',
    alwaysFree: 'Moderação, automod, anti-nuke, anti-golpes, verificação, logs de cada evento, recompensas de nível, backups, formulários, apelações e o editor de embeds.',
    stepsEyebrow: 'Como funciona', stepsTitle: 'Três passos curtos.',
    steps: [
      ['Entre com o Discord', 'O Premium é comprado pela Dash depois de entrar com o Discord.'],
      ['Escolha um plano na Dash', `Escolha ${tierList('ou')} servers, com cobrança mensal ou anual com 15% de desconto.`],
      ['Pague pela Polar e escolha os servers', 'Pague com segurança pela Polar e depois selecione os servers onde quer usar o Premium.'],
    ],
    trust: [
      ['ph:credit-card-fill', 'Pagamentos pela Polar', 'A Polar cuida do pagamento, dos impostos e dos recibos. O Petto nunca vê seu cartão.'],
      ['ph:calendar-check-fill', 'Cancele quando quiser', 'O Premium continua ativo até o fim do período que você já pagou.'],
    ],
    refundsTitle: 'Compras e reembolsos', refundsDesc: 'Como funcionam o pagamento, o cancelamento e os reembolsos.',
    faqEyebrow: 'Perguntas', faqTitle: 'Perguntas frequentes.',
    faq: [
      ['Posso cancelar a qualquer momento?', 'Sim. Cancele pela Dash (Gerenciar cobrança) ou pelo portal de clientes da Polar. O Premium continua ativo até o fim do período que você já pagou e depois para.'],
      ['Vocês fazem reembolsos?', 'Os pagamentos do Premium não são reembolsados, incluindo a parte não usada de um período. Reembolsamos uma cobrança feita duas vezes, uma cobrança feita por engano e uma cobrança em que o Premium nunca ativou e não conseguimos resolver.'],
      ['Quem cuida do pagamento?', 'A Polar atua como vendedora e cuida do pagamento, dos impostos e dos recibos. O Petto nunca vê nem guarda os dados do seu cartão.'],
      ['Quais servers recebem o Premium?', `Um plano cobre ${tierList('ou')} servers de sua escolha. Depois de pagar, você os seleciona na Dash, em servers onde tem Gerenciar servidor ou Administrador.`],
      ['O que acontece se o Premium acabar?', 'Os módulos pagos voltam ao Grátis, os espaços atribuídos são liberados e a personalização Premium volta ao padrão do servidor. Tudo o que é grátis continua funcionando.'],
    ],
    faqRefundLink: 'Leia a política completa',
    ctaBandTitle: 'Pronto para fazer upgrade?', ctaBandDesc: 'Abra a Dash para escolher um plano, pagar pela Polar e selecionar seus espaços Premium.', ctaBandBtn: 'Abrir Premium na Dash',
  },
}[lang];

const prefix = lang === 'es' ? '/es' : lang === 'pt-BR' ? '/pt-br' : '';
const refundsHref = `${prefix}/refunds`;
const premiumCards = PREMIUM_TIERS.map((tier) => ({
  servers: tier.servers,
  featured: Boolean(tier.featured),
  monthly: tier.monthly,
  annual: annual(tier.monthly),
}));
const free = freeFeatures();
const paid = premiumFeatures();
const custom = customFeatures();
const rows = compareRows(lang);
---
<Base title={`${copy.eyebrow} · Petto`} lang={lang}>
  <main class="pr-main">
    <section class="pr-hero">
      <div class="wrap pr-hero-wrap">
        <div class="eyebrow reveal">{copy.eyebrow}</div>
        <h1 class="reveal">{copy.title}</h1>
        <p class="pr-lede reveal">{copy.lede}</p>
        <div class="pr-toggle" id="prToggle" role="tablist">
          <button type="button" class="pr-toggle-btn active" data-plan="monthly" role="tab" aria-selected="true">{copy.monthly}</button>
          <button type="button" class="pr-toggle-btn" data-plan="annual" role="tab" aria-selected="false">{copy.annual}<em class="pr-save">{copy.save}</em></button>
        </div>
      </div>
    </section>

    <section class="pr-plans-sec">
      <div class="wrap pr-plans">
        <div class="pr-card pr-card-free">
          <div class="pr-banner pr-banner-free">
            <div class="pr-banner-deco"><Icon name="ph:heart-fill" /><Icon name="ph:sparkle-fill" /><Icon name="ph:smiley-fill" /><Icon name="ph:users-three-fill" /></div>
            <img src="/assets/mascot-icon.webp" alt="" class="pr-banner-mascot" />
          </div>
          <div class="pr-card-body">
            <div class="pr-card-name">{copy.freeName}</div>
            <p class="pr-card-lede">{copy.freeDesc}</p>
            <div class="pr-card-price"><span class="pr-card-amount">$0</span></div>
            <a class="btn btn-ghost pr-card-cta" href="https://petto.sbs/invite" target="_blank" rel="noopener">{copy.freeCta}</a>
            <ul class="pr-card-features">
              {free.map((f) => <li><Icon name="ph:check-bold" width="12" height="12" />{tr(f.name, lang)}</li>)}
            </ul>
          </div>
        </div>

        <div class="pr-card pr-card-premium">
          <div class="pr-banner pr-banner-premium">
            <div class="pr-banner-deco"><Icon name="ph:chart-line-up-fill" /><Icon name="ph:gear-fill" /><Icon name="ph:check-circle-fill" /><Icon name="ph:users-three-fill" /></div>
            <div class="pr-banner-mascot-wrap">
              <img src="/assets/mascot-icon.webp" alt="" class="pr-banner-mascot" />
              <div class="pr-crown"><Icon name="ph:crown-fill" width="13" height="13" /></div>
            </div>
          </div>
          <div class="pr-card-body">
            <div class="pr-card-name">{copy.premiumName}</div>
            <p class="pr-card-lede">{copy.premiumDesc}</p>
            <div class="pr-opts">
              {premiumCards.map((tier) => (
                <div class:list={['pr-opt', { 'pr-opt-featured': tier.featured }]}>
                  <div class="pr-opt-info">
                    <div class="pr-opt-servers">{copy.serverLabel(tier.servers)}{tier.featured && <span class="pr-ribbon">{copy.featured}</span>}</div>
                    <p class="pr-opt-for">{copy.premiumFor(tier.servers)}</p>
                  </div>
                  <div class="pr-opt-price">
                    <div class="pr-card-price">
                      <span class="pr-card-amount" data-monthly={tier.monthly.toFixed(2)} data-annual={(tier.annual / 12).toFixed(2)}>${tier.monthly.toFixed(2)}</span>
                      <span class="pr-card-suffix">{copy.perMonth}</span>
                    </div>
                    <p class="pr-card-annual-note" data-annual-note hidden>${tier.annual.toFixed(2)}{copy.perYear}</p>
                  </div>
                  <SpecularButton client:idle className="pr-card-cta pr-opt-cta" size="md" href={`/dash/premium?plan=premium-${tier.servers}-month`} transparent tint="#ffffff" tintOpacity={0} baseColor="#bfc4d2" textColor="var(--text)" lineColor="#ffffff" intensity={1.2} speed={0.8} radius={11}>{copy.premiumCta}</SpecularButton>
                </div>
              ))}
            </div>
            <p class="pr-card-note">{copy.premiumNote}</p>
            <a class="pr-see" href="#pr-features">{copy.seeFeatures}<Icon name="ph:arrow-down" width="13" height="13" /></a>
          </div>
        </div>

        <div class="pr-card pr-card-custom">
          <div class="pr-banner pr-banner-custom">
            <div class="pr-banner-deco"><Icon name="ph:paint-brush-fill" /><Icon name="ph:link-fill" /><Icon name="ph:crown-fill" /><Icon name="ph:star-fill" /></div>
            <div class="pr-banner-mascot-wrap">
              <img src="/assets/mascot-icon.webp" alt="" class="pr-banner-mascot" />
              <div class="pr-crown"><Icon name="ph:crown-fill" width="13" height="13" /></div>
            </div>
          </div>
          <div class="pr-card-body">
            <div class="pr-card-name">{copy.customName}</div>
            <p class="pr-card-lede">{copy.customDesc}</p>
            <div class="pr-card-price">
              <span class="pr-card-amount" data-monthly={CUSTOM_MONTHLY.toFixed(2)} data-annual={(annual(CUSTOM_MONTHLY) / 12).toFixed(2)}>${CUSTOM_MONTHLY.toFixed(2)}</span>
              <span class="pr-card-suffix">{copy.perMonth}</span>
            </div>
            <p class="pr-card-annual-note" data-annual-note hidden>${annual(CUSTOM_MONTHLY).toFixed(2)}{copy.perYear}</p>
            <a class="btn btn-ghost pr-card-cta" href="https://petto.sbs/support" target="_blank" rel="noopener">{copy.customCta}</a>
            <ul class="pr-card-features">
              <li><Icon name="ph:check-bold" width="12" height="12" />{copy.customEverything}</li>
              {custom.map((f) => <li><Icon name="ph:check-bold" width="12" height="12" />{tr(f.name, lang)}</li>)}
            </ul>
            <p class="pr-card-note">{copy.customNote}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="pr-features-sec" id="pr-features">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="eyebrow">{copy.featuresEyebrow}</div>
          <h2>{copy.featuresTitle}</h2>
        </div>
        <div class="pr-feat-grid">
          {paid.map((f) => (
            <div class="pr-feat feat">
              <span class="pr-feat-icon"><Icon name={f.icon} width="18" height="18" /></span>
              <div class="pr-feat-text">
                <strong>{tr(f.name, lang)}{f.isNew && <span class="pr-new">{copy.newBadge}</span>}</strong>
                {f.desc && <span>{tr(f.desc, lang)}</span>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="pr-limits alt">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="eyebrow">{copy.limitsEyebrow}</div>
          <h2>{copy.limitsTitle}</h2>
        </div>
        <div class="pr-table reveal">
          <div class="pr-table-row pr-table-head" aria-hidden="true">
            <span></span>
            <span class="pr-table-free">{copy.colFree}</span>
            <span class="pr-table-premium">{copy.colPremium}</span>
          </div>
          {rows.map((row) => (
            <div class:list={['pr-table-row', { 'is-text': !row.numeric }]}>
              <span class="pr-table-label">{row.label}{row.isNew && <span class="pr-new">{copy.newBadge}</span>}</span>
              <span class="pr-table-free"><span class="pr-sr">{copy.colFree}: </span>{row.free}</span>
              <Icon name="ph:arrow-right" class="pr-table-arrow" aria-hidden="true" />
              <span class="pr-table-premium"><span class="pr-sr">{copy.colPremium}: </span>{row.premium}</span>
            </div>
          ))}
        </div>
        <div class="pr-always-free reveal">
          <span class="pr-always-icon"><Icon name="ph:heart-fill" width="16" height="16" /></span>
          <div><strong>{copy.alwaysFreeTitle}</strong><span>{copy.alwaysFree}</span></div>
        </div>
      </div>
    </section>

    <section class="pr-steps-sec">
      <div class="wrap">
        <div class="sec-head reveal">
          <div class="eyebrow">{copy.stepsEyebrow}</div>
          <h2>{copy.stepsTitle}</h2>
        </div>
        <ol class="pr-steps">
          {copy.steps.map(([title, desc], i) => (
            <li class="pr-step step-card">
              <span class="pr-step-num">{i + 1}</span>
              <div><strong>{title}</strong><span>{desc}</span></div>
            </li>
          ))}
        </ol>
        <div class="pr-trust">
          {copy.trust.map(([icon, title, desc]) => (
            <div class="pr-trust-item">
              <Icon name={icon} width="16" height="16" />
              <div><strong>{title}</strong><span>{desc}</span></div>
            </div>
          ))}
          <a class="pr-trust-item pr-trust-link" href={refundsHref}>
            <Icon name="ph:scales-fill" width="16" height="16" />
            <div><strong>{copy.refundsTitle}</strong><span>{copy.refundsDesc}</span></div>
            <Icon name="ph:arrow-right" width="14" height="14" class="pr-trust-go" />
          </a>
        </div>
      </div>
    </section>

    <section class="pr-faq-sec">
      <div class="wrap pr-faq-wrap">
        <div class="sec-head reveal">
          <div class="eyebrow">{copy.faqEyebrow}</div>
          <h2>{copy.faqTitle}</h2>
        </div>
        <div class="pr-faq">
          {copy.faq.map(([q, a], i) => (
            <details class="pr-faq-item faq-item">
              <summary>{q}<Icon name="ph:caret-down-bold" width="14" height="14" /></summary>
              <p>{a}{i === 1 && <> <a href={refundsHref}>{copy.faqRefundLink}</a>.</>}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="pr-ctaband">
      <div class="wrap reveal">
        <h2>{copy.ctaBandTitle}</h2>
        <p>{copy.ctaBandDesc}</p>
        <SpecularButton client:idle size="md" href="/dash/premium" transparent tint="#ffffff" tintOpacity={0} baseColor="#bfc4d2" textColor="var(--text)" lineColor="#ffffff" intensity={1.2} speed={0.8} radius={11}>{copy.ctaBandBtn}</SpecularButton>
      </div>
    </section>
  </main>
  <CheckoutConsent lang={lang} />
</Base>

<script>
  (function () {
    var toggle = document.getElementById('prToggle');
    if (!toggle) return;
    toggle.querySelectorAll('.pr-toggle-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        toggle!.querySelectorAll('.pr-toggle-btn').forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        var isAnnual = (btn as HTMLElement).dataset.plan === 'annual';
        // The amount is per month either way; the annual note says what a year costs.
        document.querySelectorAll<HTMLElement>('[data-monthly]').forEach(function (amountEl) {
          amountEl.textContent = '$' + (isAnnual ? amountEl.getAttribute('data-annual') : amountEl.getAttribute('data-monthly'));
        });
        document.querySelectorAll<HTMLElement>('[data-annual-note]').forEach(function (noteEl) {
          noteEl.hidden = !isAnnual;
        });
      });
    });
  })();
</script>

<style>
  /* The sections under the plans are laid out and painted only when they come near the screen, so the first paint has less to do. */
  .pr-features-sec, .pr-limits, .pr-steps-sec, .pr-faq-sec, .pr-ctaband { content-visibility: auto; contain-intrinsic-size: auto 720px; }
