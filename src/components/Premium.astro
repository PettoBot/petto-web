  .pr-opt-featured { border-color: color-mix(in srgb, var(--accent) 60%, var(--border)); background: linear-gradient(135deg, color-mix(in srgb, var(--accent-soft) 70%, var(--bg-raise)), var(--bg-raise) 70%); }
