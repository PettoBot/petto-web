</Base>

<script>
  (function () {
    var toggle = document.getElementById('prToggle');
    var tierPills = document.getElementById('prTierPills');
    var isAnnual = false;
    var activeTier = tierPills?.querySelector<HTMLElement>('.pr-tier-pill.active') ?? tierPills?.querySelector<HTMLElement>('.pr-tier-pill') ?? null;

    function rollPrice(el: HTMLElement, text: string) {
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { el.textContent = text; return; }
      var shape = text.replace(/\d/g, '0');
      var fresh = el.dataset.shape !== shape;
      if (fresh) {
        el.dataset.shape = shape;
        el.textContent = '';
        for (var i = 0; i < text.length; i++) {
          var ch = text[i];
          if (/\d/.test(ch)) {
            var col = document.createElement('span');
            col.className = 'pr-odo-col';
            var strip = document.createElement('span');
            strip.className = 'pr-odo-strip';
            for (var d = 0; d < 10; d++) { var cell = document.createElement('i'); cell.textContent = String(d); strip.appendChild(cell); }
            col.appendChild(strip);
            el.appendChild(col);
          } else {
            var sep = document.createElement('span');
            sep.className = 'pr-odo-sep';
            sep.textContent = ch;
            el.appendChild(sep);
          }
        }
      }
      el.setAttribute('aria-label', text);
      var digits = text.replace(/\D/g, '').split('');
      var strips = el.querySelectorAll<HTMLElement>('.pr-odo-strip');
      var apply = function () { strips.forEach(function (strip, idx) { strip.style.transform = 'translateY(' + (-Number(digits[idx] || 0) * 1.15) + 'em)'; }); };
      if (fresh) requestAnimationFrame(function () { requestAnimationFrame(apply); }); else apply();
    }

    function syncPrices() {
      if (activeTier) {
        var amount = document.getElementById('prPremiumAmount');
        var strike = document.getElementById('prPremiumStrike');
        var ann = document.getElementById('prPremiumAnnual');
        var sub = document.getElementById('prTierSub');
        var cta = document.getElementById('prPremiumCta') as HTMLAnchorElement | null;
        var m = activeTier.dataset.monthly || '0.00';
        var a = activeTier.dataset.annual || '0.00';
        var at = activeTier.dataset.annualTotal || '0.00';
        var servers = activeTier.dataset.servers || '3';
        if (amount) {
          amount.setAttribute('data-monthly', m);
          amount.setAttribute('data-annual', a);
        }
        if (strike) { strike.textContent = '$' + m; strike.hidden = !isAnnual; }
        if (ann) {
          var suffix = ann.textContent?.replace(/^\$[0-9.]+/, '') || '';
          ann.textContent = '$' + at + suffix;
          ann.classList.toggle('is-hidden', !isAnnual);
        }
        if (sub && activeTier.dataset.for) sub.textContent = activeTier.dataset.for;
        if (cta) cta.href = '/dash/premium?plan=premium-' + servers + '-' + (isAnnual ? 'year' : 'month');
      }
      document.querySelectorAll<HTMLElement>('[data-monthly]').forEach(function (amountEl) {
        if (amountEl.classList.contains('pr-tier-pill')) return;
        rollPrice(amountEl, '$' + (isAnnual ? amountEl.getAttribute('data-annual') : amountEl.getAttribute('data-monthly')));
      });
      document.querySelectorAll<HTMLElement>('[data-annual-strike]').forEach(function (el) {
        el.hidden = !isAnnual;
      });
      document.querySelectorAll<HTMLElement>('[data-annual-note]').forEach(function (noteEl) {
        noteEl.classList.toggle('is-hidden', !isAnnual);
      });
    }
    syncPrices();

    if (toggle) {
      toggle.querySelectorAll<HTMLElement>('.pr-toggle-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          toggle!.querySelectorAll('.pr-toggle-btn').forEach(function (b) { b.classList.remove('active'); b.setAttribute('aria-selected', 'false'); });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
          isAnnual = btn.dataset.plan === 'annual';
          syncPrices();
        });
      });
    }
    if (tierPills) {
      tierPills.querySelectorAll<HTMLElement>('.pr-tier-pill').forEach(function (pill) {
        pill.addEventListener('click', function () {
          tierPills!.querySelectorAll('.pr-tier-pill').forEach(function (p) { p.classList.remove('active'); p.setAttribute('aria-checked', 'false'); });
          pill.classList.add('active');
          pill.setAttribute('aria-checked', 'true');
          activeTier = pill;
          syncPrices();
        });
      });
    }
  })();
</script>

