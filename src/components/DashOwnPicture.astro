---
// Own picture (/dash/own-picture): a background of the rank card made by the person. It needs a plan that allows it (Silver or Gold), the user policy accepted first, and the
// team approves every picture before it is drawn. The bot checks all of that; this page shows the state and asks.
import DashMeLayout from './DashMeLayout.astro';
import DashPanelHead from './DashPanelHead.astro';
import DashShopShared from './DashShopShared.astro';
import { getDashLang, makeT } from '../i18n/dash';
import type { Session } from '../utils/session';

interface Data { allowed: boolean; perk: string; policyAccepted: boolean; blocked: boolean; upload: { hasApproved: boolean; hasPending: boolean; lastRejectReason: string | null; removedReason: string | null } }
interface Props { user: Session; data: Data | null }
const { user, data } = Astro.props;
const lang = getDashLang(Astro);
const dt = makeT(lang);
const reasons: Record<string, string> = { sexual: dt('sexual content'), minor: dt('content with minors'), violence: dt('violent content'), hate: dt('hate'), illegal: dt('illegal content'), private: dt('private data of someone'), copyright: dt('a copyright claim'), quality: dt('quality of the picture'), other: dt('the rules') };
const ui = {
  working: dt('Working…'), down: dt('Petto did not answer. Try again in a moment.'), sent: dt('Sent. It waits for the team to review it: nobody sees it until it is approved.'), used: dt('Done: your rank card now uses your own picture (once it is approved).'),
  errors: { blocked: dt('You cannot upload pictures any more.'), premium_required: dt('Your plan does not allow an own picture.'), policy_required: dt('Accept the user policy first.'), bad_file: dt('That is not a picture Petto can read (PNG, JPEG or WebP).'), too_big: dt('The picture is bigger than 1 MB.'), file_too_small: dt('The picture is too small: it needs at least 800 x 200 pixels.'), failed: dt('It could not be done. Try again in a moment.') },
};
const boot = JSON.stringify({ ui }).replace(/</g, '\\u003c');
---
<DashMeLayout user={user} active="own-picture" pageTitle="Own picture">
  <DashShopShared />
  <DashPanelHead title={dt('Own picture')} eyebrow={dt('Personalization')} icon="ph:image-square-fill" back={false} />
  {!data && <p class="bd-down" role="alert">{dt('Petto did not answer. Try again in a moment.')}</p>}
  {data && (
    <div class="op" id="op" data-boot={boot}>
      <p class="op-lead">{dt('Use a picture of your own as the background of your rank card. The team reviews every picture before it is shown.')}</p>
      {data.blocked && <p class="op-note is-bad" role="alert">{dt('You cannot upload pictures any more. If you think it is a mistake, write to us in the support server.')}</p>}
      {!data.blocked && !data.allowed && (
        <section class="bd-card op-card op-lock">
          <span class="op-crown"><i class="bd-coin"></i></span>
          <h2>{dt('Your plan does not include an own picture')}</h2>
          <p>{dt('An own picture comes with the Silver and Gold plans.')}</p>
          <a class="btn op-go" href="/dash/plans">{dt('See the plans')}</a>
        </section>
      )}
      {!data.blocked && data.allowed && !data.policyAccepted && (
        <section class="bd-card op-card op-policy" id="op-policy">
          <h2>{dt('User policy')}</h2>
          <p class="op-sub">{dt('Before you upload your own content, read and accept this.')}</p>
          <ul class="op-points">
            <li><b>{dt('You choose and you answer')}</b><span>{dt('Everything you upload (backgrounds) you upload by your own decision, and you declare you have the right to use it.')}</span></li>
            <li><b>{dt('Copyright')}</b><span>{dt('If something you upload breaks the copyright of someone else, the responsibility is yours, not Petto’s. We remove the content when we get a valid notice.')}</span></li>
            <li><b>{dt('We review the content')}</b><span>{dt('We review every picture. Sexual, minor-related, violent or illegal content is not allowed; it is rejected and the feature can be suspended.')}</span></li>
          </ul>
          <p class="op-sub">{dt('Full text in the')} <a href="/terms">{dt('Terms of use')}</a> {dt('and the')} <a href="/privacy">{dt('Privacy Policy')}</a>.</p>
          <label class="op-check"><input type="checkbox" id="op-agree" /> {dt('I have read the policy and I agree. I understand I answer for what I upload.')}</label>
          <p class="op-msg" id="op-msg" role="status" hidden></p>
          <div class="op-actions"><a class="btn" href="/dash/rank">{dt('I do not agree')}</a><button type="button" class="btn op-go" id="op-accept" disabled>{dt('I agree')}</button></div>
        </section>
      )}
      {!data.blocked && data.allowed && data.policyAccepted && (
        <section class="bd-card op-card" id="op-upload">
          <h2>{dt('Send a picture')}</h2>
          <p class="op-sub">{dt('PNG, JPEG or WebP, up to 1 MB and at least 800 x 200 pixels. It is cut to the middle, 1024 x 320.')}</p>
          {data.upload.hasApproved && <p class="op-note">{dt('You have an approved picture.')}</p>}
          {data.upload.hasPending && <p class="op-note is-wait">{dt('A picture is waiting for review.')}</p>}
          {data.upload.lastRejectReason && <p class="op-note is-bad">{dt('Your last picture was rejected: {reason}.', { reason: reasons[data.upload.lastRejectReason] ?? reasons.other })}</p>}
          {data.upload.removedReason && <p class="op-note is-bad">{dt('Your picture was removed: {reason}.', { reason: reasons[data.upload.removedReason] ?? reasons.other })}</p>}
          <input type="file" id="op-file" accept="image/png,image/jpeg,image/webp" />
          <p class="op-msg" id="op-msg" role="status" hidden></p>
          <div class="op-actions">
            <button type="button" class="btn op-go" id="op-send" disabled>{dt('Send for review')}</button>
            <button type="button" class="btn" id="op-use" disabled={!data.upload.hasApproved}>{dt('Use it on my rank card')}</button>
          </div>
        </section>
      )}
    </div>
  )}
</DashMeLayout>

<style is:global>
  .op { display: flex; flex-direction: column; gap: 14px; max-width: 760px; }
  .op-lead { margin: -4px 0 0; color: var(--text-muted); }
  .op-card { padding: 22px; display: flex; flex-direction: column; gap: 12px; } .op-card h2 { margin: 0; font-size: 20px; }
  .op-sub { margin: 0; color: var(--text-muted); font-size: 14px; } .op-sub a { color: var(--accent); }
  .op-lock { align-items: flex-start; } .op-lock p { margin: 0; color: var(--text-muted); } .op-crown { font-size: 28px; }
  .op-points { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .op-points li { display: flex; flex-direction: column; gap: 2px; padding-left: 26px; position: relative; } .op-points li::before { content: '✓'; position: absolute; left: 0; color: var(--green); font-weight: 700; }
  .op-points b { font-size: 15px; } .op-points span { color: var(--text-muted); font-size: 14px; }
  .op-check { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; } .op-check input { margin-top: 3px; accent-color: var(--green); width: 18px; height: 18px; }
  .op-actions { display: flex; gap: 10px; flex-wrap: wrap; } .op-actions .btn { flex: 1 1 160px; justify-content: center; }
  .op-go { background: var(--green); color: var(--green-ink); border-color: transparent; } .op-go:disabled { background: color-mix(in srgb, var(--text) 10%, transparent); color: var(--text-muted); cursor: default; }
  .op-note { margin: 0; padding: 10px 14px; border-radius: 12px; background: var(--green-soft); color: var(--green-text); font-size: 14px; } .op-note.is-bad { background: var(--red-soft); color: var(--red-text); } .op-note.is-wait { background: color-mix(in srgb, var(--yellow) 14%, transparent); color: var(--yellow-text); }
  .op-msg { margin: 0; font-size: 14px; padding: 10px 14px; border-radius: 12px; background: var(--green-soft); color: var(--green-text); } .op-msg.is-bad { background: var(--red-soft); color: var(--red-text); }
  #op-file { padding: 10px; border: 1px dashed var(--border-soft); border-radius: 12px; background: color-mix(in srgb, var(--text) 3%, transparent); color: var(--text); }
</style>

<script>
  const root = document.getElementById('op');
  if (root?.dataset.boot) {
    const { ui } = JSON.parse(root.dataset.boot) as { ui: any };
    const msg = document.getElementById('op-msg') as HTMLElement | null;
    const say = (text: string, bad = false) => { if (!msg) return; msg.hidden = false; msg.textContent = text; msg.className = `op-msg${bad ? ' is-bad' : ''}`; };
    const why = (data: any) => (data?.error === 'down' ? ui.down : (ui.errors[data?.error ?? 'failed'] ?? ui.errors.failed));
    const post = async (action: string, body?: BodyInit) => {
      const response = await fetch(`/dash/own-picture-act?action=${action}`, { method: 'POST', headers: body ? { 'content-type': 'application/octet-stream' } : { 'content-type': 'application/json' }, body: body ?? '{}' });
      const data = await response.json().catch(() => null);
      return { ok: Boolean(response.ok && data?.ok), data };
    };
    const agree = document.getElementById('op-agree') as HTMLInputElement | null;
    const accept = document.getElementById('op-accept') as HTMLButtonElement | null;
    agree?.addEventListener('change', () => { if (accept) accept.disabled = !agree.checked; });
    accept?.addEventListener('click', async () => { accept.disabled = true; say(ui.working); const out = await post('policy'); if (out.ok) location.reload(); else { accept.disabled = false; say(why(out.data), true); } });
    const file = document.getElementById('op-file') as HTMLInputElement | null;
    const send = document.getElementById('op-send') as HTMLButtonElement | null;
    file?.addEventListener('change', () => { if (send) send.disabled = !file.files?.length; });
    send?.addEventListener('click', async () => {
      const chosen = file?.files?.[0]; if (!chosen) return;
      send.disabled = true; say(ui.working);
      const out = await post('submit', chosen);
      if (out.ok) { say(ui.sent); setTimeout(() => location.reload(), 1500); } else { send.disabled = false; say(why(out.data), true); }
    });
    const use = document.getElementById('op-use') as HTMLButtonElement | null;
    use?.addEventListener('click', async () => { use.disabled = true; say(ui.working); const out = await post('use'); say(out.ok ? ui.used : why(out.data), !out.ok); use.disabled = false; });
  }
</script>
