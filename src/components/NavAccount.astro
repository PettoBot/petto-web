---
// The login of the top bar: a Login button that turns into the profile menu once the session is found.
// The page is the same for everyone (the CDN keeps it), so it always starts as Login; the script at the end asks /api/session once
// and swaps. Used twice: in the bar (variant "bar") and in the burger menu of a phone (variant "mobile").
import InlineIcon from './InlineIcon.astro';
import { useTranslations, type Locale } from '../i18n/ui';
import { accountEntries, loginHref } from '../utils/navAccount.mjs';

interface Props {
  lang: Locale;
  variant: 'bar' | 'mobile';
}
const { lang, variant } = Astro.props;
const t = useTranslations(lang).nav;
const entries = accountEntries(lang);
const login = loginHref(lang);
---
{variant === 'bar' ? (
  <div class="nav-account" data-nav-account data-state="guest">
    <a class="nav-login" href={login} data-nav-login>{t.login}</a>
    <div class="nav-profile">
      <button type="button" class="nav-profile-btn" id="navProfileBtn" aria-haspopup="menu" aria-expanded="false" aria-controls="navProfileMenu" aria-label={t.account.label}>
        <span class="nav-avatar"><img alt="" width="28" height="28" referrerpolicy="no-referrer" hidden /><span class="nav-avatar-letter" aria-hidden="true"></span></span>
        <span class="nav-profile-name"></span>
        <InlineIcon name="ph:caret-down" class="nav-profile-caret" width="12" height="12" />
      </button>
      <div class="nav-profile-menu" id="navProfileMenu" role="menu" aria-labelledby="navProfileBtn" hidden>
        {entries.map((entry) => (
          <>
            {entry.key === 'logout' && <div class="nav-profile-sep" role="separator"></div>}
            <a role="menuitem" tabindex="-1" class="nav-profile-item" href={entry.href} target={entry.external ? '_blank' : undefined} rel={entry.external ? 'noopener' : undefined} data-nav-entry={entry.key}>
              <InlineIcon name={entry.icon} width="16" height="16" />
              <span>{t.account[entry.key]}</span>
            </a>
          </>
        ))}
      </div>
    </div>
  </div>
) : (
  <div class="mnav-account" data-nav-account data-state="guest">
    <a class="mnav-login" href={login} data-nav-login>{t.login}</a>
    <div class="mnav-profile">
      <div class="mnav-who">
        <span class="nav-avatar"><img alt="" width="36" height="36" referrerpolicy="no-referrer" hidden /><span class="nav-avatar-letter" aria-hidden="true"></span></span>
        <span class="nav-profile-name"></span>
      </div>
      {entries.map((entry) => (
        <a class="mobile-nav-link" href={entry.href} target={entry.external ? '_blank' : undefined} rel={entry.external ? 'noopener' : undefined} data-nav-entry={entry.key}>
          <InlineIcon name={entry.icon} width="16" height="16" />
          {t.account[entry.key]}
        </a>
      ))}
    </div>
    <div class="mobile-nav-divider"></div>
  </div>
)}

<style is:global>
  .nav-avatar { position: relative; display: inline-grid; place-items: center; flex: none; width: 28px; height: 28px; border-radius: 50%; overflow: hidden; background: var(--accent-soft); color: var(--accent); font-weight: 700; font-size: 13px; line-height: 1; }
  .nav-avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
  .nav-avatar img[hidden] { display: none; }
  .nav-profile-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* In the bar both the button and the profile take the same place, so nothing around them moves when one replaces the other. */
  .nav-account { display: grid; min-width: 140px; }
  .nav-account > * { grid-area: 1 / 1; }
  .nav-account[data-state="guest"] .nav-profile, .nav-account[data-state="user"] .nav-login { visibility: hidden; }
  .nav-login {
    display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 38px; padding: 9px 18px;
    border: 1px solid var(--border); border-radius: 11px; background: transparent; color: var(--text);
    font: inherit; font-size: 0.9rem; font-weight: 600; line-height: 1; white-space: nowrap; text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .nav-login:hover { border-color: var(--text-dim); background: var(--card-hover); }
  .nav-profile { position: relative; width: 0; min-width: 100%; }
  .nav-profile-btn {
    display: flex; align-items: center; gap: 8px; width: 100%; min-height: 38px; padding: 4px 11px 4px 5px; box-sizing: border-box;
    border: 1px solid var(--border); border-radius: 11px; background: transparent; color: var(--text);
    font: inherit; font-size: 0.9rem; font-weight: 600; line-height: 1; cursor: pointer; text-align: left;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .nav-profile-btn:hover, .nav-profile-btn[aria-expanded="true"] { border-color: var(--text-dim); background: var(--card-hover); }
  .nav-profile-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .nav-profile-btn .nav-profile-name { flex: 1 1 auto; }
  .nav-profile-caret { flex: none; color: var(--text-dim); transition: transform 0.18s ease; }
  .nav-profile-btn[aria-expanded="true"] .nav-profile-caret { transform: rotate(180deg); }
  .nav-profile-menu {
    position: absolute; top: calc(100% + 12px); right: 0; z-index: 50; min-width: 232px; padding: 6px;
    background: var(--card); border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 14px 30px -12px rgba(0,0,0,0.4);
    animation: navMenuIn 0.16s cubic-bezier(0.16,1,0.3,1) both;
  }
  .nav-profile-menu[hidden] { display: none; }
  @keyframes navMenuIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  .nav-profile-item { display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 8px; font-size: 13.5px; color: var(--text-muted); text-decoration: none; white-space: nowrap; }
  .nav-profile-item svg { color: var(--text-dim); flex: none; }
  .nav-profile-item:hover, .nav-profile-item:focus-visible { background: var(--card-hover); color: var(--text); }
  .nav-profile-item:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .nav-profile-sep { height: 1px; margin: 5px 4px; background: var(--border-soft); }
  /* Little room between the links and the buttons: the picture alone is enough. */
  @media (max-width: 1120px) {
    .nav-account { min-width: 0; }
    .nav-profile-btn { justify-content: center; gap: 6px; padding: 4px 9px 4px 5px; }
    .nav-profile-btn .nav-profile-name { display: none; }
  }
  @media (max-width: 1060px) { .nav-account { display: none; } }

  /* The burger menu of a phone. */
  .mnav-account[data-state="guest"] .mnav-profile, .mnav-account[data-state="user"] .mnav-login { display: none; }
  .mnav-account[data-state="guest"] .mobile-nav-divider { display: none; }
  .mnav-login {
    display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 100%; min-height: 46px; margin: 6px 0 4px; padding: 10px 18px;
    border: 1px solid var(--border); border-radius: 11px; background: transparent; color: var(--text);
    font: inherit; font-size: 15px; font-weight: 600; text-decoration: none;
  }
  .mnav-login:hover { border-color: var(--text-dim); background: var(--card-hover); }
  .mnav-who { display: flex; align-items: center; gap: 12px; min-width: 0; padding: 12px 10px 8px; font-size: 15px; font-weight: 700; color: var(--text); }
  .mnav-who .nav-avatar { width: 36px; height: 36px; font-size: 16px; }
  .mnav-profile .mobile-nav-link { color: var(--text-muted); }
</style>

<script>
  import { CACHE_KEY, SESSION_ENDPOINT, accountState, cacheText, initialOf, readCache } from '../utils/navAccount.mjs';

  type Shown = ReturnType<typeof accountState>;
  const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-account]'));
  const button = document.getElementById('navProfileBtn') as HTMLButtonElement | null;
  const menu = document.getElementById('navProfileMenu') as HTMLElement | null;
  const items = menu ? Array.from(menu.querySelectorAll<HTMLElement>('[role="menuitem"]')) : [];
  const accountLabel = button?.getAttribute('aria-label') ?? '';

  const remember = (text: string) => {
    try {
      if (text) sessionStorage.setItem(CACHE_KEY, text);
      else sessionStorage.removeItem(CACHE_KEY);
    } catch { /* the bar works without it */ }
  };

  function show(shown: Shown) {
    for (const root of roots) {
      root.dataset.state = shown.state;
      if (shown.state !== 'user') continue;
      const { name, avatar } = shown.user;
      const image = root.querySelector<HTMLImageElement>('.nav-avatar img');
      const letter = root.querySelector<HTMLElement>('.nav-avatar-letter');
      const label = root.querySelector<HTMLElement>('.nav-profile-name');
      if (label) label.textContent = name;
      if (letter) letter.textContent = initialOf(name);
      if (image) {
        image.hidden = !avatar;
        if (avatar && image.getAttribute('src') !== avatar) {
          image.onerror = () => { image.hidden = true; };
          image.src = avatar;
        }
      }
    }
    if (button) {
      button.title = shown.state === 'user' ? shown.user.name : '';
      button.setAttribute('aria-label', shown.state === 'user' ? `${accountLabel}: ${shown.user.name}` : accountLabel);
    }
    if (shown.state !== 'user') closeMenu(false);
  }

  function openMenu(focus: 'first' | 'last' | null) {
    if (!button || !menu) return;
    menu.hidden = false;
    button.setAttribute('aria-expanded', 'true');
    if (focus === 'first') items[0]?.focus();
    else if (focus === 'last') items[items.length - 1]?.focus();
  }
  function closeMenu(returnFocus: boolean) {
    if (!button || !menu || menu.hidden) return;
    menu.hidden = true;
    button.setAttribute('aria-expanded', 'false');
    if (returnFocus) button.focus();
  }

  if (button && menu) {
    // A click made with the keyboard (Enter or Space on the button) has no pointer: it moves into the list.
    button.addEventListener('click', (event) => {
      if (menu.hidden) openMenu(event.detail === 0 ? 'first' : null);
      else closeMenu(event.detail === 0);
    });
    button.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') { event.preventDefault(); openMenu('first'); }
      else if (event.key === 'ArrowUp') { event.preventDefault(); openMenu('last'); }
    });
    menu.addEventListener('keydown', (event) => {
      const at = items.indexOf(document.activeElement as HTMLElement);
      if (event.key === 'ArrowDown') { event.preventDefault(); items[(at + 1) % items.length]?.focus(); }
      else if (event.key === 'ArrowUp') { event.preventDefault(); items[(at - 1 + items.length) % items.length]?.focus(); }
      else if (event.key === 'Home') { event.preventDefault(); items[0]?.focus(); }
      else if (event.key === 'End') { event.preventDefault(); items[items.length - 1]?.focus(); }
      else if (event.key === 'Escape') { event.preventDefault(); event.stopPropagation(); closeMenu(true); }
      else if (event.key === 'Tab') closeMenu(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) closeMenu(true);
    });
    // Capture phase: the language and Product menus stop their clicks, which would otherwise leave this one open.
    document.addEventListener('click', (event) => {
      if (!menu.hidden && event.target instanceof Node && !menu.contains(event.target) && !button.contains(event.target)) closeMenu(false);
    }, true);
    menu.addEventListener('click', (event) => {
      const entry = (event.target as Element | null)?.closest<HTMLElement>('[data-nav-entry]');
      if (!entry) return;
      if (entry.dataset.navEntry === 'logout') remember('');
      closeMenu(false);
    });
    window.addEventListener('resize', () => { if (window.innerWidth <= 1060) closeMenu(false); });
  }
  for (const link of document.querySelectorAll<HTMLElement>('.mnav-profile [data-nav-entry="logout"]')) link.addEventListener('click', () => remember(''));

  // What this tab saw on the last page shows first; the answer of the server decides.
  try { const kept = readCache(sessionStorage.getItem(CACHE_KEY)); if (kept) show({ state: 'user', user: kept }); } catch { /* nothing kept */ }

  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 8000);
  fetch(SESSION_ENDPOINT, { credentials: 'same-origin', cache: 'no-store', headers: { Accept: 'application/json' }, signal: controller.signal })
    .then((response) => (response.ok ? response.json() : null))
    .then((answer) => {
      // Anything that is not a clear answer leaves the bar as it is.
      if (!answer || typeof answer !== 'object' || !('user' in answer)) return;
      const shown = accountState(answer);
      remember(cacheText(shown.user));
      show(shown);
    })
    .catch(() => { /* the bar keeps what it shows */ })
    .finally(() => clearTimeout(timer));
</script>
