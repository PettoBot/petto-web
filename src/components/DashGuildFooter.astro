---
// The note at the bottom of every page of a server in the dashboard (like the one at the end of the backups page of other bots): what happens to the
// settings of the page, where the backups are, and where to get help. It is drawn once, by DashGuildLayout, so every page has it and none is edited one by one.
import { Icon } from 'astro-icon/components';
import { makeT, getDashLang } from '../i18n/dash';

interface Props { guildId: string }
const { guildId } = Astro.props;
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const wikiBase = `https://wiki.petto.sbs${dashLang === 'es' ? '/es' : dashLang === 'pt-BR' ? '/pt-br' : ''}`;
---
<aside class="dgf" aria-labelledby="dgf-title">
  <div class="dgf-head">
    <Icon name="ph:info-fill" width="15" height="15" />
    <h2 id="dgf-title">{dt('YOUR SETTINGS AND YOUR DATA')}</h2>
  </div>
  <div class="dgf-grid">
    <p>{dt('Petto keeps what you set here for as long as it is in your server. If you remove Petto, all of it is deleted within 5 minutes, backups included, and it cannot be brought back.')}</p>
    <p>{dt('Want a copy first? Make a backup of your server in Backups, or export your settings as a file in Config Management. Both are yours to keep.')}</p>
  </div>
  <div class="dgf-links">
    <a href={`/dash/guild/${guildId}/backups`}><Icon name="ph:archive-fill" width="14" height="14" />{dt('Backups')}</a>
    <a href={`/dash/guild/${guildId}/general?section=management`}><Icon name="ph:file-code-fill" width="14" height="14" />{dt('Config Management')}</a>
    <a href={wikiBase} target="_blank" rel="noopener"><Icon name="ph:book-open-fill" width="14" height="14" />{dt('Read the docs')}</a>
    <a href="https://petto.sbs/support" target="_blank" rel="noopener"><Icon name="ph:chat-circle-dots-fill" width="14" height="14" />{dt('Support server')}</a>
    <a href="/privacy" target="_blank" rel="noopener"><Icon name="ph:shield-check-fill" width="14" height="14" />{dt('Privacy Policy')}</a>
  </div>
</aside>

<style>
  .dgf { margin: 36px 0 8px; padding: 16px 18px; border: 1px solid var(--border); border-radius: 14px; background: color-mix(in srgb, var(--card) 70%, transparent); max-width: 1100px; }
  .dgf-head { display: flex; align-items: center; gap: 8px; color: var(--text-dim); }
  .dgf-head h2 { margin: 0; font-size: 11.5px; letter-spacing: 0.08em; font-weight: 700; }
  .dgf-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 6px 24px; margin: 10px 0 12px; }
  .dgf-grid p { margin: 0; font-size: 13px; line-height: 1.55; color: var(--text-muted); }
  .dgf-links { display: flex; flex-wrap: wrap; gap: 8px 16px; }
  .dgf-links a { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--accent); text-decoration: none; }
  .dgf-links a:hover { text-decoration: underline; }
</style>
