---
// The permission problems Petto found in this server (what it could not do because a permission is missing), on the Overview. The bot writes each one in the language of the dashboard,
// checks it again every time it is asked (so what the staff fixed goes away) and tells the staff in the log channel once a day. Hidden until there is something to show.
import { Icon } from 'astro-icon/components';
import { getDashLang, makeT } from '../i18n/dash';
const dt = makeT(getDashLang(Astro));
interface Props { guildId: string }
const { guildId } = Astro.props;
---
<section class="dpa" data-dpa data-guild={guildId} hidden aria-live="polite"
  data-t-seen-one={dt('Happened once.')}
  data-t-seen-many={dt('Happened {n} times.')}
  data-t-last={dt('Last time: {when}')}
  data-t-checking={dt('Checking…')}
  data-t-dismiss={dt('Dismiss')}>
  <div class="dpa-head">
    <span class="dpa-ico" aria-hidden="true"><Icon name="ph:warning-fill" width="18" height="18" /></span>
    <div class="dpa-title">
      <strong>{dt('Petto is missing permissions')}</strong>
      <p>{dt('Something Petto tried to do here failed because of a permission. Fix what is named below and it goes away by itself. The log channel gets this notice once a day while it lasts.')}</p>
    </div>
    <button type="button" class="dpa-btn" data-dpa-recheck>{dt('Check again')}</button>
  </div>
  <ul class="dpa-list" data-dpa-list></ul>
</section>

<style>
  .dpa { margin: 0 0 18px; border: 1px solid var(--yellow); background: var(--yellow-soft); border-radius: 12px; padding: 14px 16px; }
  .dpa[hidden] { display: none; }
  .dpa-head { display: flex; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
  .dpa-ico { color: var(--yellow); display: inline-flex; margin-top: 1px; }
  .dpa-title { flex: 1 1 260px; min-width: 0; }
  .dpa-title strong { font-size: 14px; }
  .dpa-title p { margin: 3px 0 0; font-size: 12.5px; color: var(--text-dim); line-height: 1.45; }
  .dpa-btn { font: 600 12px var(--sans, inherit); color: var(--text); background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 6px 12px; cursor: pointer; white-space: nowrap; }
  .dpa-btn:hover { border-color: var(--text-dim); }
  .dpa-btn[disabled] { opacity: .6; cursor: default; }
  .dpa-list { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 8px; }
  .dpa-list :global(li) { display: flex; align-items: flex-start; gap: 10px; background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; }
  .dpa-list :global(.dpa-body) { flex: 1 1 auto; min-width: 0; }
  .dpa-list :global(.dpa-feature) { display: block; font-size: 11.5px; color: var(--text-dim); margin-bottom: 3px; overflow-wrap: anywhere; }
  .dpa-list :global(.dpa-line) { margin: 0; font-size: 13px; line-height: 1.45; overflow-wrap: anywhere; }
  .dpa-list :global(.dpa-line + .dpa-line) { margin-top: 3px; }
  .dpa-list :global(.dpa-meta) { display: block; margin-top: 4px; font-size: 11px; color: var(--text-dim); }
  .dpa-list :global(.dpa-x) { flex: none; background: transparent; border: 0; color: var(--text-dim); cursor: pointer; padding: 2px; border-radius: 6px; display: inline-flex; }
  .dpa-list :global(.dpa-x:hover) { color: var(--text); background: var(--bg-hover, rgba(255, 255, 255, .06)); }
</style>

<script>
  // Everything the page writes is text (textContent): what comes from the bot is never read as HTML.
  const box = document.querySelector<HTMLElement>('[data-dpa]');
  if (box) {
    const guild = box.dataset.guild ?? '';
    const list = box.querySelector<HTMLElement>('[data-dpa-list]')!;
    const recheck = box.querySelector<HTMLButtonElement>('[data-dpa-recheck]')!;
    const label = recheck.textContent ?? '';
    const t = (name: string) => box.getAttribute(`data-t-${name}`) ?? '';
    type Alert = { key: string; feature: string; lines: string[]; occurrences: number; lastSeen: string };
    const when = (iso: string) => { const d = new Date(iso); return Number.isNaN(d.getTime()) ? '' : d.toLocaleString(document.documentElement.lang || undefined, { dateStyle: 'medium', timeStyle: 'short' }); };
    const draw = (alerts: Alert[]) => {
      list.replaceChildren();
      for (const alert of alerts) {
        const li = document.createElement('li');
        const body = document.createElement('div'); body.className = 'dpa-body';
        const feature = document.createElement('span'); feature.className = 'dpa-feature'; feature.textContent = alert.feature; body.append(feature);
        for (const line of alert.lines) { const p = document.createElement('p'); p.className = 'dpa-line'; p.textContent = line; body.append(p); }
        const meta = document.createElement('span'); meta.className = 'dpa-meta';
        const seen = alert.occurrences > 1 ? t('seen-many').replace('{n}', String(alert.occurrences)) : t('seen-one');
        const last = when(alert.lastSeen);
        meta.textContent = last ? `${seen} ${t('last').replace('{when}', last)}` : seen;
        body.append(meta);
        const x = document.createElement('button'); x.type = 'button'; x.className = 'dpa-x'; x.setAttribute('aria-label', t('dismiss')); x.title = t('dismiss');
        x.innerHTML = '<svg width="14" height="14" viewBox="0 0 256 256" aria-hidden="true"><path fill="currentColor" d="M205.66 194.34a8 8 0 0 1-11.32 11.32L128 139.31l-66.34 66.35a8 8 0 0 1-11.32-11.32L116.69 128 50.34 61.66a8 8 0 0 1 11.32-11.32L128 116.69l66.34-66.35a8 8 0 0 1 11.32 11.32L139.31 128Z"/></svg>';
        x.addEventListener('click', async () => {
          x.disabled = true;
          try { await fetch(`/dash/guild/${guild}/permission-alerts`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ key: alert.key }) }); } catch { /* the list is read again below */ }
          load();
        });
        li.append(body, x);
        list.append(li);
      }
      box.hidden = alerts.length === 0;
    };
    const load = async () => {
      recheck.disabled = true; recheck.textContent = t('checking');
      try {
        const res = await fetch(`/dash/guild/${guild}/permission-alerts`, { headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => null);
        if (res.ok && data?.ok && Array.isArray(data.alerts)) draw(data.alerts);
      } catch { /* nothing to show: the card stays as it was */ }
      recheck.disabled = false; recheck.textContent = label;
    };
    recheck.addEventListener('click', load);
    load();
  }
</script>
