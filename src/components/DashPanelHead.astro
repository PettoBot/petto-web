---
// The head of the dashboard pages outside a server (the server list, the staff panels, history, imports): a small back link, a mono
// eyebrow with an icon, the serif title, and the page's own buttons (the default slot) on the right, or under the title on a phone.
import { Icon } from 'astro-icon/components';
import { getDashLang, makeT } from '../i18n/dash';
interface Props {
  title: string;
  eyebrow?: string;
  icon?: string;
  /** Shows "Back to servers" above the eyebrow (false hides it, a string links somewhere else). */
  back?: boolean | string;
  backLabel?: string;
}
const dt = makeT(getDashLang(Astro));
const { title, eyebrow, icon, back = true, backLabel } = Astro.props;
const backHref = typeof back === 'string' ? back : '/dash/manage';
const hasActions = Astro.slots.has('default');
---
<header class="dph">
  {back !== false && (
    <a class="dph-back" href={backHref}><Icon name="ph:arrow-left" width="13" height="13" />{backLabel ?? dt('Back to servers')}</a>
  )}
  <div class="dph-row">
    <div class="dph-text">
      {eyebrow && <div class="eyebrow dph-eyebrow">{icon && <Icon name={icon} width="14" height="14" />}{eyebrow}</div>}
      <h1 class="dph-title">{title}<slot name="badge" /></h1>
    </div>
    {hasActions && <div class="dph-actions"><slot /></div>}
  </div>
</header>

<style>
  .dph { margin-bottom: 22px; min-width: 0; }
  .dph-back { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 14px; color: var(--text-dim); font-size: 12.5px; font-weight: 500; text-decoration: none; transition: color var(--m-fast) var(--m-std); }
  .dph-back :global(svg) { transition: transform var(--m-fast) var(--m-out); }
  .dph-back:hover { color: var(--text); }
  .dph-back:hover :global(svg) { transform: translateX(-2px); }
  .dph-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 14px 20px; flex-wrap: wrap; }
  .dph-text { min-width: 0; }
  .dph-eyebrow { display: flex; align-items: center; gap: 7px; color: var(--accent); }
  .dph-title { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin: 8px 0 0; font-family: var(--serif); font-size: clamp(28px, 4.6vw, 40px); line-height: 1.06; overflow-wrap: anywhere; }
  .dph-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .dph-actions :global(.btn) { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .dph-actions :global(form) { margin: 0; }
  @media (max-width: 600px) {
    .dph { margin-bottom: 18px; }
    .dph-back { margin-bottom: 10px; }
    .dph-actions { width: 100%; }
    .dph-actions > :global(*) { flex: 1 1 auto; justify-content: center; }
    .dph-actions > :global(:only-child) { flex: 0 1 auto; }
    /* The same 16 px side gutters as the server pages, on every page that uses this head. */
    :global(main .wrap:has(> .dph)) { padding-left: 16px; padding-right: 16px; }
  }
</style>
