---
// The fields of one media channel rule (Media channels, DashMedia.astro): what it accepts, the sites, the options and the roles. They sit in a
// dialog, once for the "add" dialog and once for each channel.
import { Icon } from 'astro-icon/components';
import MultiSelect from './MultiSelect.astro';
import { getDashLang, makeT } from '../i18n/dash';
import { MEDIA_NETWORKS, type MediaRule } from '../data/mediaChannels';

const dt = makeT(getDashLang(Astro));
interface Props { rule: MediaRule; roles: { id: string; name: string }[] }
const { rule: r, roles } = Astro.props;
---
<div class="mf-block">
  <label class="mf-master"><input type="checkbox" name="attachments_enabled" checked={r.attachments} /><span><b>{dt('Attachments')}</b><em>{dt('Files uploaded to Discord, the ones from the phone or the computer.')}</em></span></label>
  <div class="mf-sub">
    <label class="mf-chip"><input type="checkbox" name="allow_images" checked={r.images} /><span><Icon name="ph:image-fill" width="14" height="14" />{dt('Pictures')}</span></label>
    <label class="mf-chip"><input type="checkbox" name="allow_videos" checked={r.videos} /><span>{dt('Videos')}</span></label>
    <label class="mf-chip"><input type="checkbox" name="allow_audio" checked={r.audio} /><span>{dt('Audio')}</span></label>
    <label class="mf-chip"><input type="checkbox" name="allow_files" checked={r.files} /><span>{dt('Other files')}</span></label>
  </div>
</div>

<div class="mf-block">
  <label class="mf-master"><input type="checkbox" name="links_enabled" checked={r.links} /><span><b>{dt('Links')}</b><em>{dt('A link to a site, like a video, a post or a song.')}</em></span></label>
  <div class="mf-sub">
    <label class="mf-chip"><input type="checkbox" name="any_site" checked={r.networks.length === 0} /><span>{dt('Any site')}</span></label>
    <div class="mf-sites">
      {MEDIA_NETWORKS.map((n) => (
        <label class="mf-chip"><input type="checkbox" name="networks" value={n.id} checked={r.networks.includes(n.id)} /><span><Icon name={n.icon} width="14" height="14" />{n.name}</span></label>
      ))}
    </div>
  </div>
</div>

<div class="mf-opts">
  <label class="mf-switch"><input type="checkbox" name="allow_caption" checked={r.caption} /><span><b>{dt('Text next to it is fine')}</b><em>{dt('A message with a picture or a link and a few words.')}</em></span></label>
  <label class="mf-switch"><input type="checkbox" name="notice" checked={r.notice} /><span><b>{dt('Say why it was deleted')}</b><em>{dt('A short notice that deletes itself.')}</em></span></label>
</div>

<div class="mf-field">
  <label>{dt('Roles that can write anything')}</label>
  <MultiSelect lazy name="bypass_role_ids" options={roles} selected={r.bypassRoleIds} placeholder={dt('Search roles...')} />
  <span class="mf-hint">{dt('Members with Manage Messages are never touched.')}</span>
</div>

<style>
  .mf-block { display: grid; gap: 10px; }
  .mf-master, .mf-switch { display: flex; align-items: flex-start; gap: 10px; cursor: pointer; }
  .mf-switch { border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; }
  .mf-master input, .mf-switch input { margin-top: 3px; }
  .mf-master b, .mf-switch b { display: block; font-size: 13.5px; font-weight: 600; }
  .mf-master em, .mf-switch em { display: block; font-style: normal; font-size: 12px; color: var(--text-dim); margin-top: 2px; }
  .mf-sub { display: flex; flex-wrap: wrap; gap: 6px; padding-left: 26px; }
  .mf-sites { display: contents; }
  .mf-chip input { position: absolute; opacity: 0; pointer-events: none; }
  .mf-chip span { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--border); border-radius: 999px; padding: 7px 12px; font-size: 13px; cursor: pointer; transition: background var(--m-fast) ease, border-color var(--m-fast) ease, color var(--m-fast) ease; }
  .mf-chip span:hover { border-color: var(--text-dim); }
  .mf-chip input:checked + span { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }
  .mf-chip input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* The kinds and the sites only matter while their rule is on; "any site" makes the single sites pointless. */
  .mf-block:has(.mf-master input:not(:checked)) .mf-sub { opacity: .45; }
  .mf-block:has(input[name="any_site"]:checked) .mf-sites { opacity: .45; }
  .mf-opts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .mf-field { display: grid; gap: 6px; }
  .mf-field > label { font-size: 13px; font-weight: 600; }
  .mf-hint { font-size: 12px; color: var(--text-dim); }
  @media (max-width: 720px) { .mf-opts { grid-template-columns: 1fr; } .mf-sub { padding-left: 0; } }
</style>
