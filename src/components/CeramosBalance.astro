---
import { getDashLang, makeT } from '../i18n/dash';
// The balance of ceramos of the person, the same on every page of the account area that shows it: a small label and the number with the coin, left aligned.
// `id` is for the pages whose script writes the new number after a purchase.
interface Props { balance: number | string; id?: string }
const { balance, id } = Astro.props;
const dt = makeT(getDashLang(Astro));
---
<span class="bd-bal"><small>{dt('Your balance')}</small><span class="bd-bal-n"><i class="bd-coin"></i><b id={id}>{balance}</b></span></span>
