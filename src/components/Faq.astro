---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const f = t.faqPage;
const np = t.newsPage;
---
<Base title={`${f.eyebrow} · Petto`} lang={lang}>
  <main>
    <section class="faq-sec">
      <div class="wrap faq-wrap">
        <div class="faq-head">
          <div>
            <div class="eyebrow">{f.eyebrow}</div>
            <h1>{f.title}</h1>
          </div>
          <div class="search-box">
            <Icon name="ph:magnifying-glass" width="14" height="14" />
            <input type="text" id="faqSearch" placeholder={np.searchPlaceholder} autocomplete="off" />
          </div>
        </div>
        <p class="faq-lede">{f.lede}</p>

        <div class="faq-list reveal">
          {f.items.map((it, i) => (
            <div class="faq-item" data-q={it.q.toLowerCase()} data-a={it.a.toLowerCase()}>
              <button class="faq-q" aria-expanded="false" data-faq-toggle>
                <span class="faq-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="faq-q-text">{it.q}</span>
                <Icon name="ph:plus" class="faq-icon" width="16" height="16" />
              </button>
              <div class="faq-a">
                <p>{it.a}</p>
              </div>
            </div>
          ))}
        </div>
        <p class="no-results" id="faqNoResults" style="display:none;">{np.noResults}</p>
      </div>
    </section>
  </main>
</Base>

<script>
  document.querySelectorAll('[data-faq-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const open = item?.classList.contains('open');
      item?.classList.toggle('open', !open);
      btn.setAttribute('aria-expanded', String(!open));
    });
  });

  const input = document.getElementById('faqSearch');
  const items = Array.from(document.querySelectorAll('.faq-item'));
  const noResults = document.getElementById('faqNoResults');
  input?.addEventListener('input', () => {
    const q = (input as HTMLInputElement).value.trim().toLowerCase();
    let visible = 0;
    items.forEach((item) => {
      const el = item as HTMLElement;
      const match = !q || el.dataset.q?.includes(q) || el.dataset.a?.includes(q);
      el.style.display = match ? '' : 'none';
      if (match) visible++;
    });
    if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
  });
</script>

<style>
  .faq-sec { padding: 64px 0 110px; }
  .faq-wrap { max-width: 700px; }
  .faq-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
  .faq-sec h1 { font-size: 32px; margin: 14px 0 0; }
  .faq-lede { color: var(--text-muted); font-size: 15.5px; line-height: 1.65; margin: 14px 0 40px; }
  .search-box { display: flex; align-items: center; gap: 8px; border: 1px solid var(--border); border-radius: 9px; padding: 8px 12px; color: var(--text-dim); width: 200px; flex-shrink: 0; }
  .search-box input { border: none; background: none; outline: none; color: var(--text); font-size: 13.5px; width: 100%; font-family: var(--sans); }

  .faq-list { border-top: 1px solid var(--border-soft); }
  .faq-item { border-bottom: 1px solid var(--border-soft); border-left: 2px solid transparent; transition: border-color 0.15s ease; }
  .faq-item.open { border-left-color: var(--accent); }
  .faq-q { width: 100%; display: flex; align-items: center; gap: 14px; text-align: left; background: none; border: none; cursor: pointer; padding: 18px 10px; font-family: var(--sans); font-size: 15px; font-weight: 600; color: var(--text); }
  .faq-q:hover { color: var(--accent); }
  .faq-num { font-family: var(--mono); font-size: 12px; color: var(--text-dim); flex-shrink: 0; }
  .faq-q-text { flex: 1; }
  .faq-q :global(.faq-icon) { flex-shrink: 0; color: var(--text-dim); transition: transform 0.2s ease; }
  .faq-item.open .faq-q :global(.faq-icon) { transform: rotate(45deg); color: var(--accent); }
  .faq-a { max-height: 0; overflow: hidden; transition: max-height 0.25s ease; }
  .faq-item.open .faq-a { max-height: 240px; }
  .faq-a p { font-size: 14.5px; color: var(--text-muted); line-height: 1.65; margin: 0 0 20px; padding: 0 30px 0 40px; }
  .no-results { text-align: center; color: var(--text-dim); font-size: 14px; padding: 30px 0; }

  @media (max-width: 560px) {
    .faq-head { flex-direction: column; align-items: flex-start; }
    .search-box { width: 100%; }
  }
</style>
