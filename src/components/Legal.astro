---
import Base from '../layouts/Base.astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  doc: 'terms' | 'privacy' | 'cookies' | 'refunds';
}
const { lang, doc } = Astro.props;
const t = useTranslations(lang);
const s = t.simplePages[doc];
// A section is a list of points: one per line of its text (a single paragraph is one point).
const blocks = s.sections.map(([h, p], i) => ({ n: i + 1, h, points: String(p).split('\n').map((x) => x.trim()).filter(Boolean) }));
const toc = { en: 'On this page', es: 'En esta página', 'pt-BR': 'Nesta página' }[lang] ?? 'On this page';
const top = { en: 'Back to top', es: 'Volver arriba', 'pt-BR': 'Voltar ao topo' }[lang] ?? 'Back to top';
---
<Base title={`${s.title} · Petto`} lang={lang}>
  <main id="top">
    <section class="legal-sec">
      <div class="wrap legal-wrap">
        <h1>{s.title}</h1>
        <p class="legal-updated">{s.updated}</p>
        <p class="legal-intro">{s.intro}</p>
        <nav class="legal-toc" aria-label={toc}>
          <strong>{toc}</strong>
          <ol>
            {blocks.map((b) => <li><a href={`#s${b.n}`}>{b.h}</a></li>)}
          </ol>
        </nav>
        {blocks.map((b) => (
          <div class="legal-block" id={`s${b.n}`}>
            <h2><span class="legal-n">{b.n}.</span> {b.h}</h2>
            {b.points.length > 1 ? (
              <ol class="legal-points">
                {b.points.map((x, i) => <li data-n={`${b.n}.${i + 1}`}>{x}</li>)}
              </ol>
            ) : (
              <p>{b.points[0]}</p>
            )}
          </div>
        ))}
        <a class="legal-top" href="#top">{top}</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .legal-sec { padding: 80px 0 120px; }
  .legal-wrap { max-width: 620px; }
  .legal-sec h1 { font-size: 30px; margin-bottom: 8px; }
  .legal-updated { font-family: var(--mono); font-size: 12px; color: var(--text-dim); margin-bottom: 22px; }
  .legal-intro { color: var(--text-muted); font-size: 15px; line-height: 1.65; padding: 14px 16px; background: var(--bg-raise); border: 1px solid var(--border-soft); border-radius: 10px; margin-bottom: 36px; }
  .legal-block { margin-bottom: 26px; }
  .legal-block h2 { font-size: 17px; margin-bottom: 8px; }
  .legal-block p { color: var(--text-muted); font-size: 14.5px; line-height: 1.65; margin: 0; }
  .legal-toc { margin: 0 0 34px; padding: 14px 16px; border: 1px solid var(--border-soft); border-radius: 10px; }
  .legal-toc strong { display: block; font-size: 13px; margin-bottom: 8px; color: var(--text-dim); }
  .legal-toc ol { margin: 0; padding-left: 20px; columns: 2; column-gap: 24px; font-size: 14px; line-height: 1.9; }
  .legal-toc a { color: var(--text-muted); text-decoration: none; }
  .legal-toc a:hover { color: var(--accent); }
  .legal-block { scroll-margin-top: 110px; }
  .legal-n { color: var(--accent); font-family: var(--mono); font-size: .9em; margin-right: 4px; }
  .legal-points { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .legal-points li { position: relative; padding-left: 42px; color: var(--text-muted); font-size: 14.5px; line-height: 1.65; }
  .legal-points li::before { content: attr(data-n); position: absolute; left: 0; top: 1px; font-family: var(--mono); font-size: 12px; color: var(--text-dim); }
  .legal-top { display: inline-block; margin-top: 8px; font-size: 13px; color: var(--text-dim); text-decoration: none; }
  .legal-top:hover { color: var(--accent); }
  @media (max-width: 560px) { .legal-toc ol { columns: 1; } }
</style>
