---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import { COUNTER_FORMATS, PRESENCE_TYPES, renderCounterName, shownName, timeValue } from '../utils/counters';
import { getDashLang, makeT } from '../i18n/dash';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Counter {
  id: number; channelId: string; type: string; kind: string; template: string; format: string; goal: number | null; timezone: string | null; roleId: string | null;
  prefix: string; suffix: string; parentId: string | null; enabled: boolean; problem: string | null; currentName: string | null; exists: boolean; nextRenameAt: number | null; renamesLeft: number | null;
  target: 'name' | 'topic'; channelName: string | null;
  lastUpdatedAt: number | null; nextCheckAt: number | null; queued: boolean; badges: string[];
}
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string; guildName: string; guildIcon: string;
  counters: Counter[];
  categories: { id: string; name: string }[];
  roles: { id: string; name: string; color: number }[];
  freeChannels: { id: string; name: string; kind: string }[];
  values: Record<string, number | string> | null;
  roleCounts: Record<string, number>;
  roleOnlineCounts: Record<string, number>;
  presences: boolean;
  limits: { max: number; premium: boolean; premiumMax: number } | null;
  approxMembers: number;
  message: { kind: 'ok' | 'err'; text: string } | null;
  announce: { enabled: boolean; channelId: string | null; message: string; embedName: string | null; every: number | null; useGoals: boolean; lastAnnounced: number | null; next: number | null } | null;
  textChannels: { id: string; name: string }[];
  embedNames: string[];
  defaultAnnounce: string;
  memberDays: { day: string; members: number }[];
}
const { user, guildId, guildName, guildIcon, counters, categories, roles, freeChannels, values, roleCounts, roleOnlineCounts, presences, limits, approxMembers, message, announce, textChannels, embedNames, defaultAnnounce, memberDays } = Astro.props;

const labels: Record<string, string> = {
  members: dt('Members'), users_only: dt('Humans'), bots_only: dt('Bots'), online: dt('Online (any status)'), status_online: dt('Online'), status_idle: dt('Idle'), status_dnd: dt('Do not disturb'),
  in_voice: dt('In voice'), pending_members: dt('Pending members'), boosts: dt('Boosts'), booster_count: dt('Boosters'), boost_level: dt('Boost level'), role_members: dt('Members in a role'),
  goal: dt('Member goal'), roles: dt('Roles'), all_channels: dt('Channels'), text_channels: dt('Text channels'), voice_channels: dt('Voice channels'), categories: dt('Categories'),
  announcement_channels: dt('Announcement channels'), staging_channels: dt('Stage channels'), emojis: dt('Emojis'), stickers: dt('Stickers'), clock: dt('Clock'), date: dt('Date'),
  role_online: dt('Online in a role'), tag_users: dt('Wearing the server tag'), vanity_users: dt('Vanity supporters'), messages_today: dt('Messages today'),
};
const defaults: Record<string, string> = {
  members: dt('👥 Members: {count}'), users_only: dt('👤 Humans: {count}'), bots_only: dt('🤖 Bots: {count}'), online: dt('🟢 Online: {count}'), status_online: dt('🟢 Online: {count}'),
  status_idle: dt('🌙 Idle: {count}'), status_dnd: dt('⛔ Do not disturb: {count}'), in_voice: dt('🎧 In voice: {count}'), pending_members: dt('⏳ Pending: {count}'), boosts: dt('💎 Boosts: {count}'),
  booster_count: dt('🚀 Boosters: {count}'), boost_level: dt('💎 Boost level: {count}'), role_members: '🏷️ {role}: {count}', goal: dt('🎯 Goal: {count}/{goal}'), roles: dt('🏷️ Roles: {count}'),
  all_channels: dt('📁 Channels: {count}'), text_channels: dt('💬 Text channels: {count}'), voice_channels: dt('🔊 Voice channels: {count}'), categories: dt('🗂️ Categories: {count}'),
  announcement_channels: dt('📢 Announcements: {count}'), staging_channels: dt('🎙️ Stages: {count}'), emojis: dt('😀 Emojis: {count}'), stickers: dt('🖼️ Stickers: {count}'), clock: '🕒 {count} {tz}', date: '📅 {count}',
  role_online: dt('🟢 {role} online: {count}'), tag_users: dt('🏷️ Tag wearers: {count}'), vanity_users: dt('💜 Supporters: {count}'), messages_today: dt('💬 Messages today: {count}'),
};
const groups: { label: string; types: string[] }[] = [
  { label: dt('Members'), types: ['members', 'users_only', 'bots_only', 'pending_members', 'role_members', 'goal', 'tag_users', 'vanity_users'] },
  { label: dt('Activity'), types: ['online', 'status_online', 'status_idle', 'status_dnd', 'role_online', 'in_voice', 'messages_today'] },
  { label: dt('Boosts'), types: ['boosts', 'booster_count', 'boost_level'] },
  { label: dt('Server'), types: ['roles', 'all_channels', 'text_channels', 'voice_channels', 'categories', 'announcement_channels', 'staging_channels', 'emojis', 'stickers'] },
  { label: dt('Time'), types: ['clock', 'date'] },
];
// One-click packs, the same as the bot's (petto-bot src/utils/counterSetup.js PRESETS): each goes in its own locked category.
const membersNow = Number(values?.members ?? approxMembers ?? 0) || 0;
const nextGoal = (n: number) => { const step = n < 100 ? 10 : n < 1000 ? 100 : n < 10_000 ? 1000 : n < 100_000 ? 5000 : 10 ** (String(Math.trunc(n)).length - 2); return Math.floor(n / step) * step + step; };
const counted = new Set(counters.map((c) => c.type));
const packs: { id: string; title: string; icon: string; types: string[] }[] = [
  { id: 'basic', title: dt('Basic stats'), icon: 'ph:users-three-fill', types: ['members', 'users_only', 'bots_only'] },
  { id: 'boosts', title: dt('Boosts'), icon: 'ph:rocket-launch-fill', types: ['boosts', 'booster_count', 'boost_level'] },
  { id: 'online', title: dt('Who is online'), icon: 'ph:circle-fill', types: ['online', 'status_online', 'in_voice'] },
  { id: 'goal', title: dt('Goal to {a}', { a: nextGoal(membersNow).toLocaleString(dashLang) }), icon: 'ph:flag-fill', types: ['goal'] },
  { id: 'clock', title: dt('Clock'), icon: 'ph:clock-fill', types: ['clock', 'date'] },
];
const formatLabels: Record<string, string> = { plain: '1234', grouped: dashLang === 'en' ? '1,234' : '1.234', compact: dashLang === 'en' ? '1.2k' : '1,2k' };
const kindLabels: Record<string, string> = { voice: dt('Voice channel (locked)'), text: dt('Text channel name'), topic: dt('Text channel topic'), category: dt('Category name'), stage: dt('Stage channel'), announce: dt('Announcement channel') };
const kindIcon: Record<string, string> = { voice: 'ph:speaker-high-fill', text: 'ph:hash-bold', category: 'ph:folder-simple-fill', stage: 'ph:broadcast-fill', announce: 'ph:megaphone-fill', topic: 'ph:text-align-left-bold' };
// Where the value shows: a topic keeps what is written, a text channel's name is lower case with hyphens.
const shownKind = (c: { kind: string; target: string }) => (c.target === 'topic' ? 'topic' : c.kind);
const roleName = new Map(roles.map((r) => [r.id, r.name]));
// Without the bot's numbers the previews use what Discord tells the website: the member count, and examples for the rest.
const sample: Record<string, number | string> = values ?? { members: approxMembers || 1234, goal: approxMembers || 1234 };
const valueOf = (type: string, roleId: string | null) => (type === 'role_online' ? (roleId ? roleOnlineCounts[roleId] ?? 0 : 0) : type === 'role_members' ? (roleId ? roleCounts[roleId] ?? 0 : 0) : type === 'clock' || type === 'date' ? timeValue(type, 'UTC', dashLang) : sample[type] ?? 0);
const nameOf = (c: { type: string; template: string; format: string; goal: number | null; timezone: string | null; roleId: string | null; prefix?: string; suffix?: string; target?: string }) =>
  renderCounterName({ ...c, role: c.roleId ? roleName.get(c.roleId) ?? '' : '' }, c.type === 'clock' || c.type === 'date' ? timeValue(c.type, c.timezone ?? 'UTC', dashLang) : valueOf(c.type, c.roleId), dashLang);
const full = limits ? counters.length >= limits.max : false;
const problems: Record<string, string> = {
  missing_channel: dt('The channel was deleted, so the counter is off.'),
  missing_permission: dt('Petto cannot rename this channel. Give it Manage Channels and View Channel there.'),
  bad_target: dt('This channel has no topic. Show the value in its name.'),
};
const announceDefault = defaultAnnounce || dt('🎉 **{server}** just reached **{goal}** members! Thank you all.');
const sampleMilestone = announce?.next ?? (announce?.every ? (Math.floor(membersNow / announce.every) + 1) * announce.every : nextGoal(membersNow));
const config = {
  values: sample, roleCounts, roleOnlineCounts, roles: Object.fromEntries(roleName), labels, defaults, lang: dashLang, server: guildName, announceDefault, milestone: sampleMilestone,
  text: {
    ago: dt('Updated {a} ago'), justNow: dt('Updated just now'), nextIn: dt('Next update in {a}'), checkIn: dt('Next check in {a}'), soon: dt('Next update: now'),
    saving: dt('Saving the order...'), saved: dt('Order saved.'), failed: dt('It could not be saved, try again.'), nameSaved: dt('Counter saved. Its name changes as soon as Discord allows.'),
  },
};
const waitingText = dt('Next rename in {a}');
// The small line of members per day (the bot saves one number per server and day).
const spark = (() => {
  if (memberDays.length < 2) return null;
  const W = 300; const H = 56; const pad = 4;
  const nums = memberDays.map((d) => d.members);
  const min = Math.min(...nums); const max = Math.max(...nums);
  const span = max - min || 1;
  const points = memberDays.map((d, i) => ({ x: pad + (i * (W - 2 * pad)) / (memberDays.length - 1), y: pad + (H - 2 * pad) * (1 - (d.members - min) / span), ...d }));
  const line = points.map((pt) => `${pt.x.toFixed(1)},${pt.y.toFixed(1)}`).join(' ');
  const area = `${pad},${H - pad} ${line} ${W - pad},${H - pad}`;
  const change = nums[nums.length - 1] - nums[0];
  return { W, H, points, line, area, change, min, max, first: memberDays[0], last: memberDays[memberDays.length - 1] };
})();
const dayLabel = (day: string) => new Date(`${day}T12:00:00Z`).toLocaleDateString(dashLang, { day: 'numeric', month: 'short', timeZone: 'UTC' });
const badgeText: Record<string, string> = {
  no_presences: dt('No presences: online counts show 0'), members_partial: dt('Too many members to count them all'), rate_limited: dt('Discord asked to wait'),
};
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="counters" pageTitle={dt('Counters')}>
  <div class="cn" data-counters data-config={JSON.stringify(config)} data-waiting={waitingText}>
    <header class="cn-head">
      <div>
        <h1>{dt('Counters')}</h1>
        <p class="cn-sub">{dt('Channels whose name shows a live number: members, humans, bots, online, boosts, a role, a goal or a clock. Petto renames them when the number changes, never more than Discord allows (two renames per channel every 10 minutes).')}</p>
      </div>
      <div class="cn-head-actions">
        {counters.length > 0 && (
          <form method="POST"><input type="hidden" name="action" value="refresh" /><button class="btn btn-ghost btn-sm" type="submit" data-no-dirty><Icon name="ph:arrows-clockwise-bold" width="13" height="13" />{dt('Refresh all now')}</button></form>
        )}
      </div>
    </header>

    {message && <div class:list={['cn-flash', { 'cn-flash-err': message.kind === 'err' }]} role="status"><Icon name={message.kind === 'ok' ? 'ph:check-circle-fill' : 'ph:warning-fill'} width="15" height="15" />{message.text}</div>}
    {!values && <div class="cn-flash cn-flash-warn"><Icon name="ph:plug-fill" width="15" height="15" />{dt('Petto did not answer, so the previews use sample numbers. Creating counters needs Petto online.')}</div>}

    <div class="cn-stats">
      <div class="cn-stat"><b>{counters.length}{limits && <small>/{limits.max}</small>}</b><span>{dt('Counters')}</span></div>
      <div class="cn-stat"><b>{counters.filter((c) => c.enabled && !c.problem).length}</b><span>{dt('Working')}</span></div>
      <div class="cn-stat"><b>{values ? Number(values.members ?? 0).toLocaleString(dashLang) : approxMembers ? `~${approxMembers.toLocaleString(dashLang)}` : '—'}</b><span>{dt('Members now')}</span></div>
      <div class="cn-stat"><b>{values && presences ? Number(values.online ?? 0).toLocaleString(dashLang) : '—'}</b><span>{dt('Online now')}</span></div>
      <figure class="cn-stat cn-spark" data-spark aria-label={dt('Members, last 30 days')}>
        <figcaption><span>{dt('Members, last 30 days')}</span>{spark && <b class:list={['cn-spark-change', { up: spark.change > 0, down: spark.change < 0 }]}>{spark.change > 0 ? '+' : ''}{spark.change.toLocaleString(dashLang)}</b>}</figcaption>
        {spark ? (
          <div class="cn-spark-plot">
            <svg viewBox={`0 0 ${spark.W} ${spark.H}`} preserveAspectRatio="none" role="img" aria-label={dt('From {a} on {b} to {c} on {d}', { a: spark.first.members.toLocaleString(dashLang), b: dayLabel(spark.first.day), c: spark.last.members.toLocaleString(dashLang), d: dayLabel(spark.last.day) })}>
              <polygon points={spark.area} class="cn-spark-area" />
              <polyline points={spark.line} class="cn-spark-line" vector-effect="non-scaling-stroke" />
              <line class="cn-spark-cross" x1="0" x2="0" y1="0" y2={spark.H} vector-effect="non-scaling-stroke" data-spark-cross style="visibility: hidden" />
            </svg>
            <span class="cn-spark-dot" data-spark-dot hidden></span>
            <span class="cn-spark-tip" data-spark-tip hidden></span>
            <script type="application/json" data-spark-points set:html={JSON.stringify(spark.points.map((pt) => ({ x: pt.x / spark.W, y: pt.y / spark.H, label: `${dayLabel(pt.day)}: ${pt.members.toLocaleString(dashLang)}` })))} />
          </div>
        ) : <p class="cn-hint">{dt('Petto saves the members once a day; the line shows up after the second day.')}</p>}
        {spark && (
          <table class="cn-sr">
            <caption>{dt('Members, last 30 days')}</caption>
            <tbody>{memberDays.map((d) => <tr><th scope="row">{dayLabel(d.day)}</th><td>{d.members.toLocaleString(dashLang)}</td></tr>)}</tbody>
          </table>
        )}
      </figure>
    </div>

    {counters.length === 0 && (
      <div class="cn-empty">
        <div class="cn-empty-art" aria-hidden="true">
          <div class="cn-fake"><Icon name="ph:folder-simple-fill" width="13" height="13" /><span>{dt('📊 Server stats')}</span></div>
          {['members', 'users_only', 'bots_only'].map((type, i) => (
            <div class="cn-fake cn-fake-ch" style={`--i:${i}`}><Icon name="ph:speaker-high-fill" width="13" height="13" /><span>{nameOf({ type, template: defaults[type], format: 'grouped', goal: null, timezone: null, roleId: null })}</span></div>
          ))}
        </div>
        <div>
          <h2>{dt('Start with the server stats')}</h2>
          <p>{dt('One click makes a "Server stats" category with Members, Humans and Bots, in voice channels everyone can see and nobody can join.')}</p>
          <form method="POST"><input type="hidden" name="action" value="setup" /><button class="btn btn-accent btn-sm" type="submit" data-no-dirty disabled={!values}><Icon name="ph:lightning-fill" width="13" height="13" />{dt('Quick setup')}</button></form>
        </div>
      </div>
    )}

    <section class="cn-packs" aria-label={dt('Packs')}>
      <h2 class="cn-packs-title"><Icon name="ph:sparkle-fill" width="14" height="14" />{dt('Packs')}<span>{dt('One click adds a category with ready counters. What the server already counts is skipped.')}</span></h2>
      <div class="cn-pack-grid">
        {packs.map((pack, i) => {
          const missing = pack.types.filter((type) => type === 'goal' || !counted.has(type));
          return (
            <form method="POST" class="cn-pack" style={`--i:${i}`}>
              <input type="hidden" name="action" value="setup" /><input type="hidden" name="preset" value={pack.id} />
              <div class="cn-pack-head"><Icon name={pack.icon} width="14" height="14" /><strong>{pack.title}</strong></div>
              <ul>{pack.types.map((type) => <li class:list={{ 'cn-pack-have': type !== 'goal' && counted.has(type) }}><Icon name="ph:speaker-high-fill" width="11" height="11" /><span>{nameOf({ type, template: defaults[type], format: 'grouped', goal: type === 'goal' ? nextGoal(membersNow) : null, timezone: null, roleId: null })}</span></li>)}</ul>
              <button class="btn btn-ghost btn-sm" type="submit" data-no-dirty disabled={!values || full || !missing.length}>{missing.length ? <><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add pack')}</> : dt('Already added')}</button>
            </form>
          );
        })}
      </div>
    </section>

    {counters.length > 0 && (
      <p class="cn-hint cn-list-hint" id="cn-order-hint"><Icon name="ph:dots-six-vertical-bold" width="12" height="12" />{dt('Drag the handle (or use the arrows) to change the order; Petto moves the channels in Discord to match. Click a name to edit it in place.')}</p>
      <div class="cn-order-status" role="status" aria-live="polite" data-order-status></div>
      <div class="cn-list" aria-label={dt('Counters')} data-counter-list>
        {counters.map((c, index) => {
          const name = nameOf(c);
          const kind = shownKind(c);
          const status = c.problem ? 'problem' : !c.enabled ? 'off' : c.currentName !== null && shownName(name, kind) !== c.currentName ? 'waiting' : 'ok';
          return (
            <article class:list={['cn-card', `cn-${status}`]} style={`--i:${index}`} data-counter-card data-kind={kind} data-base-kind={c.kind} data-channel={c.channelId}
              data-template-now={c.template} data-type-now={c.type} data-format-now={c.format} data-goal-now={c.goal ?? ''} data-zone-now={c.timezone ?? ''} data-role-now={c.roleId ?? ''} data-target={c.target}>
              <div class="cn-card-top">
                <div class="cn-order">
                  <button type="button" class="cn-handle" data-drag-handle aria-label={dt('Drag to reorder')} aria-describedby="cn-order-hint"><Icon name="ph:dots-six-vertical-bold" width="14" height="14" /></button>
                  <span class="cn-arrows">
                    <button type="button" data-move="-1" aria-label={dt('Move up')} disabled={index === 0}><Icon name="ph:caret-up-bold" width="11" height="11" /></button>
                    <button type="button" data-move="1" aria-label={dt('Move down')} disabled={index === counters.length - 1}><Icon name="ph:caret-down-bold" width="11" height="11" /></button>
                  </span>
                </div>
                <div class="cn-channel">
                  <Icon name={kindIcon[kind] ?? kindIcon.voice} width="15" height="15" />
                  <span class="cn-name-wrap">
                    {c.target === 'topic' && c.channelName && <small class="cn-topic-of"># {c.channelName}</small>}
                    <button type="button" class="cn-name" data-preview-out data-inline-edit title={dt('Click to edit the name')}>{shownName(name, kind)}</button>
                    <span class="cn-inline" data-inline-box hidden>
                      <input type="text" maxlength={c.target === 'topic' ? 500 : 100} value={c.template} aria-label={c.target === 'topic' ? dt('Topic') : dt('Name')} data-inline-input />
                      <small data-inline-preview></small>
                      <small class="cn-inline-help">{dt('Enter saves, Esc cancels')}</small>
                    </span>
                  </span>
                </div>
                <span class="cn-type">{labels[c.type] ?? c.type}</span>
              </div>
              <div class="cn-meta">
                {status === 'ok' && <span class="cn-pill cn-pill-ok"><Icon name="ph:check-circle-fill" width="12" height="12" />{dt('Up to date')}</span>}
                {status === 'waiting' && <span class="cn-pill cn-pill-wait"><Icon name="ph:hourglass-medium-fill" width="12" height="12" />{c.nextRenameAt ? <span data-countdown={c.nextRenameAt}>{dt('Waiting for Discord')}</span> : dt('Updating')}</span>}
                {status === 'off' && <span class="cn-pill"><Icon name="ph:pause-fill" width="12" height="12" />{dt('Off')}</span>}
                {status === 'problem' && <span class="cn-pill cn-pill-err"><Icon name="ph:warning-fill" width="12" height="12" />{problems[c.problem ?? ''] ?? dt('The last rename failed.')}</span>}
                {c.currentName && status === 'waiting' && <span class="cn-now">{dt('Now: {a}', { a: c.currentName })}</span>}
              </div>
              <div class="cn-times">
                <span><Icon name="ph:clock-counter-clockwise-fill" width="12" height="12" />{c.lastUpdatedAt ? <span data-ago={c.lastUpdatedAt}>{dt('Updated')}</span> : dt('Not renamed yet')}</span>
                {c.enabled && !c.problem && (
                  <span><Icon name="ph:clock-countdown-fill" width="12" height="12" />{c.queued ? dt('Next update: now') : c.nextRenameAt ? <span data-next={c.nextRenameAt}>{dt('Next update')}</span> : c.nextCheckAt ? <span data-next={c.nextCheckAt} data-next-check>{dt('Next check')}</span> : dt('Updates when the number changes')}</span>
                )}
                {c.badges.filter((b) => badgeText[b]).map((b) => <span class:list={['cn-pill', b === 'rate_limited' ? 'cn-pill-wait' : 'cn-pill-warn']}><Icon name="ph:warning-fill" width="12" height="12" />{badgeText[b]}</span>)}
                {c.renamesLeft !== null && c.enabled && <span class="cn-budget" title={dt('Renames left in the current 10 minutes')}>{[0, 1].map((n) => <i class:list={{ used: n >= (c.renamesLeft ?? 2) }} />)}</span>}
              </div>
              <details class="cn-edit">
                <summary class="btn btn-ghost btn-sm"><Icon name="ph:pencil-simple-bold" width="13" height="13" />{dt('Edit')}</summary>
                <form method="POST" class="cn-form" data-counter-form>
                  <input type="hidden" name="action" value="save" /><input type="hidden" name="channel_id" value={c.channelId} />
                  <input type="hidden" name="category_changed" value="0" data-category-changed />
                  <div class="cn-grid">
                    <label class="cn-field"><span>{dt('Shows')}</span>
                      <select name="type" data-type>{groups.map((g) => <optgroup label={g.label}>{g.types.map((type) => <option value={type} selected={type === c.type}>{labels[type]}</option>)}</optgroup>)}</select>
                    </label>
                    <label class="cn-field cn-span"><span>{c.target === 'topic' ? dt('Topic') : dt('Name')}</span>
                      <input type="text" name="template" value={c.template} maxlength={c.target === 'topic' ? 500 : 100} data-template data-default={defaults[c.type]} />
                    </label>
                    {(c.kind === 'text' || c.kind === 'announce') && (
                      <label class="cn-field"><span>{dt('Shows the value in')}</span>
                        <select name="target" data-target><option value="name" selected={c.target !== 'topic'}>{dt('The channel name')}</option><option value="topic" selected={c.target === 'topic'}>{dt('The channel topic')}</option></select>
                      </label>
                    )}
                    <div class="cn-chips cn-span" data-chips>{['{count}', '{goal}', '{left}', '{percent}', '{role}', '{tz}'].map((v) => <button type="button" class="cn-chip" data-insert={v}>{v}</button>)}</div>
                    <fieldset class="cn-field cn-seg"><legend>{dt('Number format')}</legend>
                      {COUNTER_FORMATS.map((f) => <label><input type="radio" name="format" value={f} checked={c.format === f} /><span>{formatLabels[f]}</span></label>)}
                    </fieldset>
                    <label class="cn-field" data-when="role_members role_online"><span>{dt('Role')}</span>
                      <select name="role_id"><option value="">{dt('Pick a role')}</option>{roles.map((r) => <option value={r.id} selected={r.id === c.roleId}>{r.name}</option>)}</select>
                    </label>
                    <label class="cn-field" data-when="goal"><span>{dt('Goal (empty: the next round number)')}</span><input type="number" name="goal" min="1" value={c.goal ?? ''} placeholder="500" /></label>
                    <label class="cn-field" data-when="clock date"><span>{dt('Time zone')}</span><input type="text" name="timezone" value={c.timezone ?? ''} placeholder="Europe/Madrid" list="cn-zones" /></label>
                    <label class="cn-field"><span>{dt('Category')}</span>
                      <select name="category_id" data-category><option value="">{dt('No category')}</option>{categories.map((cat) => <option value={cat.id} selected={cat.id === c.parentId}>{cat.name}</option>)}</select>
                    </label>
                    <label class="cn-switch cn-span"><input type="checkbox" name="enabled" checked={c.enabled} /><span>{dt('Keep it updated')}</span></label>
                  </div>
                  <div class="cn-preview" aria-live="polite"><span>{dt('Preview')}</span><b data-preview>{shownName(name, kind)}</b></div>
                  <div class="cn-actions"><button class="btn btn-accent btn-sm" type="submit"><Icon name="ph:check-bold" width="13" height="13" />{dt('Save counter')}</button></div>
                </form>
              </details>
              <div class="cn-card-actions">
                <form method="POST"><input type="hidden" name="action" value="refresh" /><input type="hidden" name="channel_id" value={c.channelId} /><button class="btn btn-ghost btn-sm" type="submit" data-no-dirty disabled={!c.exists}><Icon name="ph:arrows-clockwise-bold" width="13" height="13" />{dt('Refresh now')}</button></form>
                <form method="POST" class="cn-delete"><input type="hidden" name="action" value="delete" /><input type="hidden" name="channel_id" value={c.channelId} />
                  <label class="cn-check"><input type="checkbox" name="delete_channel" checked={c.exists} disabled={!c.exists} />{dt('Also delete the channel')}</label>
                  <button class="cn-del" type="submit" data-no-dirty data-confirm={dt('Delete this counter?')}><Icon name="ph:trash-fill" width="13" height="13" />{dt('Delete')}</button>
                </form>
              </div>
            </article>
          );
        })}
      </div>
    )}

    <section class="cn-create cn-announce" id="announce" aria-labelledby="cn-announce-title">
      <h2 id="cn-announce-title"><Icon name="ph:megaphone-fill" width="17" height="17" />{dt('Milestone announcements')}</h2>
      <p class="cn-hint cn-announce-sub">{dt('A message when the server reaches the goal of a goal counter, and if you want every N members. The same number is never announced twice.')}</p>
      <form method="POST" class="cn-form" data-announce-form>
        <input type="hidden" name="action" value="announce" />
        <div class="cn-grid">
          <label class="cn-switch cn-span"><input type="checkbox" name="enabled" checked={announce ? announce.enabled : true} /><span>{dt('Announce milestones')}</span></label>
          <label class="cn-field"><span>{dt('Channel')}</span>
            <select name="channel_id"><option value="">{dt('Pick a channel')}</option>{textChannels.map((ch) => <option value={ch.id} selected={ch.id === announce?.channelId}># {ch.name}</option>)}</select>
          </label>
          <label class="cn-field"><span>{dt('Every N members (empty: only goals)')}</span><input type="number" name="every" min="1" step="1" value={announce?.every ?? ''} placeholder="100" data-every /></label>
          <label class="cn-switch cn-span"><input type="checkbox" name="use_goals" checked={announce ? announce.useGoals : true} /><span>{dt('When a goal counter reaches its goal')}</span></label>
          <label class="cn-field cn-span"><span>{dt('Saved embed (optional)')}</span>
            <select name="embed_name" data-embed><option value="">{dt('No embed: send the text')}</option>{embedNames.map((name) => <option value={name} selected={name === announce?.embedName}>{name}</option>)}</select>
          </label>
          <label class="cn-field cn-span" data-text-only><span>{dt('Message')}</span>
            <textarea name="message" rows="3" maxlength="2000" placeholder={announceDefault} data-announce-text>{announce?.message ?? ''}</textarea>
          </label>
          <div class="cn-chips cn-span" data-text-only>{['{count}', '{goal}', '{server}'].map((v) => <button type="button" class="cn-chip" data-insert-announce={v}>{v}</button>)}</div>
          <p class="cn-hint cn-span" data-embed-only hidden>{dt('The saved embed can use {counter.count}, {counter.goal} and {counter.server}.')}</p>
        </div>
        <div class="cn-preview cn-announce-preview" aria-live="polite" data-text-only><span>{dt('Preview')}</span><b data-announce-preview></b></div>
        <div class="cn-actions">
          <button class="btn btn-accent btn-sm" type="submit" data-no-dirty><Icon name="ph:check-bold" width="13" height="13" />{dt('Save announcements')}</button>
          <button class="btn btn-ghost btn-sm" type="submit" name="action" value="announce_test" data-no-dirty disabled={!values}><Icon name="ph:megaphone-fill" width="13" height="13" />{dt('Save and send a test')}</button>
          {announce && <span class="cn-hint">{dt('Last announced: {a} · next: {b}', { a: announce.lastAnnounced == null ? '—' : announce.lastAnnounced.toLocaleString(dashLang), b: announce.next == null ? '—' : announce.next.toLocaleString(dashLang) })}</span>}
        </div>
      </form>
    </section>

    <div class="cn-create" id="new">
      <h2><Icon name="ph:plus-circle-fill" width="17" height="17" />{dt('New counter')}</h2>
      {full && limits && <p class="cn-hint cn-limit">{limits.premium ? dt('This server has the most counters it can have ({a}).', { a: limits.max }) : dt('Free servers have {a} counters; Premium has {b}.', { a: limits.max, b: limits.premiumMax })}</p>}
      <form method="POST" class="cn-form" data-counter-form data-create>
        <input type="hidden" name="action" value="create" />
        <div class="cn-types" role="radiogroup" aria-label={dt('Shows')}>
          {groups.map((g) => (
            <div class="cn-type-group"><span class="cn-type-label">{g.label}</span>
              <div class="cn-type-row">{g.types.map((type) => (
                <label class="cn-type-pick"><input type="radio" name="type" value={type} checked={type === 'members'} data-type /><span><b>{labels[type]}</b><em>{type === 'role_members' || type === 'role_online' ? '' : type === 'clock' || type === 'date' ? timeValue(type, 'UTC', dashLang) : PRESENCE_TYPES.includes(type) && !presences ? '—' : typeof sample[type] === 'number' ? Number(sample[type]).toLocaleString(dashLang) : sample[type] ?? ''}</em></span></label>
              ))}</div>
            </div>
          ))}
        </div>
        <div class="cn-grid">
          <label class="cn-field cn-span"><span>{dt('Name')}</span><input type="text" name="template" value={defaults.members} maxlength="100" data-template data-default={defaults.members} /></label>
          <div class="cn-chips cn-span" data-chips>{['{count}', '{goal}', '{left}', '{percent}', '{role}', '{tz}'].map((v) => <button type="button" class="cn-chip" data-insert={v}>{v}</button>)}</div>
          <fieldset class="cn-field cn-seg"><legend>{dt('Number format')}</legend>
            {COUNTER_FORMATS.map((f) => <label><input type="radio" name="format" value={f} checked={f === 'grouped'} /><span>{formatLabels[f]}</span></label>)}
          </fieldset>
          <label class="cn-field" data-when="role_members role_online"><span>{dt('Role')}</span><select name="role_id"><option value="">{dt('Pick a role')}</option>{roles.map((r) => <option value={r.id}>{r.name}</option>)}</select></label>
          <label class="cn-field" data-when="goal"><span>{dt('Goal (empty: the next round number)')}</span><input type="number" name="goal" min="1" placeholder="500" /></label>
          <label class="cn-field" data-when="clock date"><span>{dt('Time zone')}</span><input type="text" name="timezone" placeholder="Europe/Madrid" list="cn-zones" /></label>
          <fieldset class="cn-field cn-seg cn-span"><legend>{dt('Channel')}</legend>
            <label><input type="radio" name="use" value="new" checked data-use /><span>{dt('Make a new one')}</span></label>
            <label><input type="radio" name="use" value="existing" data-use disabled={freeChannels.length === 0} /><span>{dt('Use one I have')}</span></label>
          </fieldset>
          <label class="cn-field" data-use-when="new"><span>{dt('Kind')}</span><select name="kind" data-kind>{Object.entries(kindLabels).map(([k, label]) => <option value={k}>{label}</option>)}</select></label>
          <label class="cn-field" data-use-when="new"><span>{dt('Category')}</span><select name="category_id"><option value="">{dt('No category')}</option>{categories.map((cat) => <option value={cat.id}>{cat.name}</option>)}</select></label>
          <label class="cn-field cn-span" data-use-when="existing" hidden><span>{dt('Channel')}</span><select name="channel_id" data-existing>{freeChannels.map((ch) => <option value={ch.id} data-kind={ch.kind}>{ch.kind === 'voice' || ch.kind === 'stage' ? '🔊 ' : '# '}{ch.name}</option>)}</select></label>
          <label class="cn-switch cn-span" data-use-when="existing" data-topic-switch hidden><input type="checkbox" name="target" value="topic" /><span>{dt('Show the value in the topic (the name stays as it is)')}</span></label>
        </div>
        <div class="cn-preview" aria-live="polite"><span>{dt('Preview')}</span><b data-preview>{shownName(nameOf({ type: 'members', template: defaults.members, format: 'grouped', goal: null, timezone: null, roleId: null }), 'voice')}</b></div>
        {!presences && values && <p class="cn-hint">{dt('The online counts need the Presence intent of Petto; until Discord sends presences they show 0.')}</p>}
        <div class="cn-actions">
          <button class="btn btn-accent btn-sm" type="submit" disabled={full || !values}><Icon name="ph:plus-bold" width="13" height="13" />{dt('Create counter')}</button>
          <span class="cn-hint">{dt('Prefix: !counter create members, !counter setup, !counter list.')}</span>
        </div>
      </form>
      <datalist id="cn-zones">{['UTC', 'Europe/London', 'Europe/Madrid', 'Europe/Lisbon', 'America/New_York', 'America/Chicago', 'America/Los_Angeles', 'America/Mexico_City', 'America/Bogota', 'America/Lima', 'America/Argentina/Buenos_Aires', 'America/Santiago', 'America/Sao_Paulo', 'Asia/Tokyo', 'Asia/Kolkata', 'Australia/Sydney'].map((z) => <option value={z} />)}</datalist>
    </div>
  </div>
</DashGuildLayout>

<script>
  import { renderCounterName, shownName, timeValue } from '../utils/counters';

  // Every form of the page shows, under it, the name the channel will have, while the person types.
  function initCounters() {
    const root = document.querySelector<HTMLElement>('[data-counters]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    const config = JSON.parse(root.dataset.config ?? '{}');
    const valueOf = (type: string, roleId: string, zone: string) => {
      if (type === 'clock' || type === 'date') return timeValue(type, zone || 'UTC', config.lang);
      if (type === 'role_members') return roleId ? Number(config.roleCounts?.[roleId] ?? 0) : 0;
      if (type === 'role_online') return roleId ? Number(config.roleOnlineCounts?.[roleId] ?? 0) : 0;
      const v = config.values?.[type];
      return typeof v === 'number' ? v : Number(v ?? 0) || 0;
    };
    root.querySelectorAll<HTMLFormElement>('[data-counter-form]').forEach((form) => {
      const typeOf = () => (form.querySelector<HTMLInputElement>('[data-type]:checked') ?? form.querySelector<HTMLSelectElement>('select[data-type]'))?.value ?? 'members';
      const template = form.querySelector<HTMLInputElement>('[data-template]');
      const out = form.querySelector<HTMLElement>('[data-preview]');
      const card = form.closest('[data-counter-card]');
      const cardOut = card?.querySelector<HTMLElement>('[data-preview-out]');
      const kindOf = () => {
        if (form.querySelector<HTMLInputElement>('[data-use]:checked')?.value === 'existing') {
          const kind = form.querySelector<HTMLSelectElement>('[data-existing]')?.selectedOptions[0]?.dataset.kind ?? 'voice';
          return (kind === 'text' || kind === 'announce') && form.querySelector<HTMLInputElement>('[data-topic-switch] input')?.checked ? 'topic' : kind;
        }
        return form.querySelector<HTMLSelectElement>('[data-kind]')?.value ?? 'voice';
      };
      const cardKind = () => {
        const target = form.querySelector<HTMLSelectElement>('[data-target]');
        if (target) return target.value === 'topic' ? 'topic' : (card as HTMLElement).dataset.baseKind ?? 'text';
        return (card as HTMLElement).dataset.kind ?? 'voice';
      };
      const update = () => {
        const type = typeOf();
        const data = new FormData(form);
        form.querySelectorAll<HTMLElement>('[data-when]').forEach((el) => { el.hidden = !String(el.dataset.when).split(' ').includes(type); });
        const use = String(data.get('use') ?? 'new');
        form.querySelectorAll<HTMLElement>('[data-use-when]').forEach((el) => { el.hidden = el.dataset.useWhen !== use; });
        // Only a text or announcement channel has a topic.
        const existingKind = form.querySelector<HTMLSelectElement>('[data-existing]')?.selectedOptions[0]?.dataset.kind ?? '';
        form.querySelectorAll<HTMLElement>('[data-topic-switch]').forEach((el) => { el.hidden = use !== 'existing' || !['text', 'announce'].includes(existingKind); });
        const topicNow = kindOf() === 'topic' || (card ? cardKind() === 'topic' : false);
        if (template) template.maxLength = topicNow ? 500 : 100;
        const roleId = String(data.get('role_id') ?? '');
        const zone = String(data.get('timezone') ?? '');
        const name = renderCounterName({ type, template: template?.value ?? '', format: String(data.get('format') ?? 'plain'), goal: Number(data.get('goal')) || null, timezone: zone || null, role: config.roles?.[roleId] ?? '', target: topicNow ? 'topic' : 'name' }, valueOf(type, roleId, zone), config.lang);
        const shown = shownName(name, card ? cardKind() : kindOf());
        if (out) out.textContent = shown;
        if (out) { out.classList.remove('cn-pop'); void out.offsetWidth; out.classList.add('cn-pop'); }
        if (cardOut && card?.querySelector('details[open]')) cardOut.textContent = shown;
      };
      form.addEventListener('input', update);
      form.addEventListener('change', (event) => {
        const target = event.target as HTMLElement;
        if (target.matches('[data-type]') && template) {
          // A name nobody wrote follows the type; one the person wrote is kept.
          const next = config.defaults?.[typeOf()] ?? '{count}';
          if (!template.value.trim() || template.value === template.dataset.default) template.value = next;
          template.dataset.default = next;
        }
        if (target.matches('[data-category]')) { const flag = form.querySelector<HTMLInputElement>('[data-category-changed]'); if (flag) flag.value = '1'; }
        update();
      });
      form.querySelectorAll<HTMLButtonElement>('[data-insert]').forEach((chip) => chip.addEventListener('click', () => {
        if (!template) return;
        const at = template.selectionStart ?? template.value.length;
        template.value = `${template.value.slice(0, at)}${chip.dataset.insert}${template.value.slice(template.selectionEnd ?? at)}`.slice(0, 100);
        template.focus();
        template.dispatchEvent(new Event('input', { bubbles: true }));
      }));
      update();
    });
    // The milestone announcement: its text with sample numbers, and the text box hidden while a saved embed is chosen.
    const announceForm = root.querySelector<HTMLFormElement>('[data-announce-form]');
    if (announceForm) {
      const area = announceForm.querySelector<HTMLTextAreaElement>('[data-announce-text]');
      const out = announceForm.querySelector<HTMLElement>('[data-announce-preview]');
      const grouped = (n: number) => n.toLocaleString(config.lang === 'en' ? 'en-US' : config.lang);
      const draw = () => {
        const embed = Boolean(announceForm.querySelector<HTMLSelectElement>('[data-embed]')?.value);
        announceForm.querySelectorAll<HTMLElement>('[data-text-only]').forEach((el) => { el.hidden = embed; });
        announceForm.querySelectorAll<HTMLElement>('[data-embed-only]').forEach((el) => { el.hidden = !embed; });
        if (!out) return;
        const milestone = Number(config.milestone) || 100;
        const vars: Record<string, string> = { '{count}': grouped(milestone), '{goal}': grouped(milestone), '{milestone}': grouped(milestone), '{server}': String(config.server ?? '') };
        const text = (area?.value.trim() || config.announceDefault || '').replace(/\{(?:counter\.)?(count|goal|milestone|server)\}/g, (_: string, key: string) => vars[`{${key}}`] ?? '');
        // **bold** as Discord shows it, the rest as plain text.
        out.replaceChildren(...text.split(/(\*\*[^*]+\*\*)/g).filter(Boolean).map((part) => {
          if (/^\*\*[^*]+\*\*$/.test(part)) { const b = document.createElement('strong'); b.textContent = part.slice(2, -2); return b; }
          return document.createTextNode(part);
        }));
      };
      announceForm.addEventListener('input', draw);
      announceForm.addEventListener('change', draw);
      announceForm.querySelectorAll<HTMLButtonElement>('[data-insert-announce]').forEach((chip) => chip.addEventListener('click', () => {
        if (!area) return;
        const at = area.selectionStart ?? area.value.length;
        area.value = `${area.value.slice(0, at)}${chip.dataset.insertAnnounce}${area.value.slice(area.selectionEnd ?? at)}`.slice(0, 2000);
        area.focus();
        draw();
      }));
      draw();
    }
    const words = config.text ?? {};
    const span = (ms: number) => {
      const sec = Math.max(0, Math.round(ms / 1000));
      if (sec < 60) return `${sec}s`;
      const min = Math.round(sec / 60);
      if (min < 60) return `${min}m`;
      const h = Math.floor(min / 60);
      return h < 48 ? `${h}h ${String(min % 60).padStart(2, '0')}m` : `${Math.floor(h / 24)}d`;
    };
    // The order of the list: dragged by the handle (mouse, pen or finger) or moved with the arrows, then sent to Petto.
    const list = root.querySelector<HTMLElement>('[data-counter-list]');
    const orderStatus = root.querySelector<HTMLElement>('[data-order-status]');
    const cards = () => [...(list?.querySelectorAll<HTMLElement>('[data-counter-card]') ?? [])];
    const orderOf = () => cards().map((card) => card.dataset.channel ?? '');
    const say = (text: string, bad = false) => { if (orderStatus) { orderStatus.textContent = text; orderStatus.classList.toggle('bad', bad); } };
    const post = async (fields: Record<string, string>) => {
      const body = new FormData();
      for (const [key, value] of Object.entries(fields)) body.set(key, value);
      const res = await fetch(location.pathname, { method: 'POST', body, headers: { Accept: 'application/json' } });
      const data = await res.json().catch(() => null);
      return { ok: Boolean(res.ok && data?.ok), message: String(data?.message ?? '') };
    };
    const syncArrows = () => {
      const all = cards();
      all.forEach((card, i) => {
        card.querySelector<HTMLButtonElement>('[data-move="-1"]')!.disabled = i === 0;
        card.querySelector<HTMLButtonElement>('[data-move="1"]')!.disabled = i === all.length - 1;
      });
    };
    let lastSent = orderOf().join(',');
    const sendOrder = async () => {
      const order = orderOf();
      if (order.join(',') === lastSent) return;
      say(words.saving ?? '');
      const result = await post({ action: 'reorder', order: JSON.stringify(order) }).catch(() => ({ ok: false, message: '' }));
      if (result.ok) lastSent = order.join(',');
      say(result.message || (result.ok ? words.saved : words.failed) || '', !result.ok);
    };
    list?.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-move]');
      if (!button) return;
      const card = button.closest<HTMLElement>('[data-counter-card]');
      if (!card || !list) return;
      const all = cards();
      const index = all.indexOf(card) + Number(button.dataset.move);
      if (index < 0 || index >= all.length) return;
      if (Number(button.dataset.move) < 0) list.insertBefore(card, all[index]); else list.insertBefore(card, all[index].nextSibling);
      syncArrows();
      button.focus();
      sendOrder();
    });
    list?.addEventListener('pointerdown', (event) => {
      const handle = (event.target as HTMLElement).closest<HTMLElement>('[data-drag-handle]');
      const card = handle?.closest<HTMLElement>('[data-counter-card]');
      if (!handle || !card || !list || event.button > 0) return;
      event.preventDefault();
      handle.setPointerCapture?.(event.pointerId);
      card.classList.add('cn-dragging');
      list.classList.add('cn-sorting');
      const move = (e: PointerEvent) => {
        // Near the top or the bottom of the window the page scrolls, so a long list can be crossed on a phone.
        if (e.clientY < 70) window.scrollBy(0, -14); else if (e.clientY > window.innerHeight - 70) window.scrollBy(0, 14);
        // The card under the pointer takes the dragged one before or after it, by which half the pointer is on.
        const over = cards().find((other) => {
          if (other === card) return false;
          const box = other.getBoundingClientRect();
          return e.clientX >= box.left && e.clientX <= box.right && e.clientY >= box.top && e.clientY <= box.bottom;
        });
        if (!over) return;
        const box = over.getBoundingClientRect();
        const after = list.clientWidth > box.width * 1.5 ? e.clientX > box.left + box.width / 2 || e.clientY > box.top + box.height * 0.75 : e.clientY > box.top + box.height / 2;
        list.insertBefore(card, after ? over.nextSibling : over);
      };
      const end = () => {
        handle.removeEventListener('pointermove', move);
        handle.removeEventListener('pointerup', end);
        handle.removeEventListener('pointercancel', end);
        card.classList.remove('cn-dragging');
        list.classList.remove('cn-sorting');
        syncArrows();
        sendOrder();
      };
      handle.addEventListener('pointermove', move);
      handle.addEventListener('pointerup', end);
      handle.addEventListener('pointercancel', end);
    });
    // A name edited in place: the template in a box, the name it gives under it while typing; Enter saves, Esc puts it back.
    root.querySelectorAll<HTMLElement>('[data-counter-card]').forEach((card) => {
      const nameButton = card.querySelector<HTMLButtonElement>('[data-inline-edit]');
      const box = card.querySelector<HTMLElement>('[data-inline-box]');
      const input = card.querySelector<HTMLInputElement>('[data-inline-input]');
      const preview = card.querySelector<HTMLElement>('[data-inline-preview]');
      if (!nameButton || !box || !input) return;
      const kind = card.dataset.kind ?? 'voice';
      const draw = () => {
        const type = card.dataset.typeNow ?? 'members';
        const roleId = card.dataset.roleNow ?? '';
        const zone = card.dataset.zoneNow ?? '';
        const name = renderCounterName({ type, template: input.value, format: card.dataset.formatNow ?? 'plain', goal: Number(card.dataset.goalNow) || null, timezone: zone || null, role: config.roles?.[roleId] ?? '', target: card.dataset.target }, valueOf(type, roleId, zone), config.lang);
        if (preview) preview.textContent = shownName(name, kind);
        return shownName(name, kind);
      };
      const close = () => { box.hidden = true; nameButton.hidden = false; nameButton.focus(); };
      nameButton.addEventListener('click', () => { input.value = card.dataset.templateNow ?? input.value; nameButton.hidden = true; box.hidden = false; draw(); input.focus(); input.select(); });
      input.addEventListener('input', draw);
      input.addEventListener('keydown', async (event) => {
        if (event.key === 'Escape') { event.preventDefault(); close(); return; }
        if (event.key !== 'Enter') return;
        event.preventDefault();
        const value = input.value.trim();
        if (!value) return;
        input.disabled = true;
        const result = await post({ action: 'template', channel_id: card.dataset.channel ?? '', template: value, target: card.dataset.target ?? 'name' }).catch(() => ({ ok: false, message: '' }));
        input.disabled = false;
        if (result.ok) {
          card.dataset.templateNow = value;
          nameButton.textContent = draw();
          const editTemplate = card.querySelector<HTMLInputElement>('[data-counter-form] [data-template]');
          if (editTemplate) editTemplate.value = value;
          close();
        }
        say(result.message || (result.ok ? words.nameSaved : words.failed) || '', !result.ok);
      });
      input.addEventListener('blur', () => { setTimeout(() => { if (!box.hidden && document.activeElement !== input) close(); }, 150); });
    });
    // The line of members: the day under the pointer.
    root.querySelectorAll<HTMLElement>('[data-spark]').forEach((fig) => {
      const plot = fig.querySelector<HTMLElement>('.cn-spark-plot');
      const pts = JSON.parse(fig.querySelector('[data-spark-points]')?.textContent ?? '[]') as { x: number; y: number; label: string }[];
      const tip = fig.querySelector<HTMLElement>('[data-spark-tip]');
      const dot = fig.querySelector<HTMLElement>('[data-spark-dot]');
      const cross = fig.querySelector<SVGLineElement>('[data-spark-cross]');
      if (!plot || !pts.length || !tip || !dot || !cross) return;
      const show = (clientX: number) => {
        const box = plot.getBoundingClientRect();
        const rel = (clientX - box.left) / box.width;
        const pt = pts.reduce((best, p) => (Math.abs(p.x - rel) < Math.abs(best.x - rel) ? p : best), pts[0]);
        tip.textContent = pt.label;
        tip.hidden = false; dot.hidden = false; cross.style.visibility = 'visible';
        const left = pt.x * box.width;
        tip.style.left = `${Math.min(Math.max(left, 50), box.width - 50)}px`;
        dot.style.left = `${left}px`; dot.style.top = `${pt.y * box.height}px`;
        const vx = String(pt.x * 300);
        cross.setAttribute('x1', vx); cross.setAttribute('x2', vx);
      };
      const hide = () => { tip.hidden = true; dot.hidden = true; cross.style.visibility = 'hidden'; };
      plot.addEventListener('pointermove', (e) => show(e.clientX));
      plot.addEventListener('pointerdown', (e) => show(e.clientX));
      plot.addEventListener('pointerleave', hide);
    });
    // "Waiting for Discord" turns into how long is left.
    const label = root.dataset.waiting ?? '{a}';
    const tick = () => {
      if (!document.body.contains(root)) return;
      root.querySelectorAll<HTMLElement>('[data-countdown]').forEach((el) => {
        const left = Math.max(0, Math.round((Number(el.dataset.countdown) - Date.now()) / 1000));
        el.textContent = label.replace('{a}', left >= 60 ? `${Math.floor(left / 60)}m ${String(left % 60).padStart(2, '0')}s` : `${left}s`);
      });
      // "Updated 3m ago", "Next update in 4m" (a check comes every minute; a counter changes when its number does).
      root.querySelectorAll<HTMLElement>('[data-ago]').forEach((el) => {
        const ago = Date.now() - Number(el.dataset.ago);
        el.textContent = ago < 30_000 ? words.justNow ?? '' : String(words.ago ?? '{a}').replace('{a}', span(ago));
      });
      root.querySelectorAll<HTMLElement>('[data-next]').forEach((el) => {
        let at = Number(el.dataset.next);
        if (el.dataset.nextCheck !== undefined) while (at < Date.now()) at += 60_000;
        const left = at - Date.now();
        el.textContent = left <= 1000 ? words.soon ?? '' : String((el.dataset.nextCheck !== undefined ? words.checkIn : words.nextIn) ?? '{a}').replace('{a}', span(left));
      });
      setTimeout(tick, 1000);
    };
    tick();
  }
  try { initCounters(); } catch (error) { console.error(error); }
  if (!(window as any).__cnWatch) {
    (window as any).__cnWatch = true;
    new MutationObserver(() => { if (document.querySelector('[data-counters]:not([data-bound])')) { try { initCounters(); } catch (error) { console.error(error); } } }).observe(document.body, { childList: true, subtree: true });
  }
</script>

