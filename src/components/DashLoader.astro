---
import { getDashLang, makeT } from '../i18n/dash';
// A full-screen "loading" curtain for the dashboard. It stays hidden until the member goes to their servers, or opens a server other
// than the one they are in, so the wait for the page does not look like nothing happened. Links inside one server do not use it: the side
// menu loads the content in place with page-shaped placeholders (DashGuildLayout), and a plain link to another page of the same server (a
// card or button inside a page) gets the same placeholders here, until the browser shows the page. It is hidden again when the browser
// comes back to the page from the cache.
const dt = makeT(getDashLang(Astro));
---
<div class="dl-curtain" id="dl-curtain" data-servers={dt('Loading your servers')} data-data={dt('Loading your data')} role="status" aria-live="polite" hidden>
  <div class="dl-box">
    <div class="dl-orbit" aria-hidden="true"><span></span><span></span><span></span></div>
    <strong id="dl-title">{dt('Loading your data')}</strong>
    <small>{dt('Getting your server ready…')}</small>
    <div class="dl-bar" aria-hidden="true"><i></i></div>
  </div>
</div>

<script>
  const curtain = document.getElementById('dl-curtain');
  const show = (servers: boolean) => {
    if (!curtain) return;
    const title = document.getElementById('dl-title');
    if (title) title.textContent = (servers ? curtain.dataset.servers : curtain.dataset.data) ?? '';
    curtain.hidden = false;
    requestAnimationFrame(() => curtain.classList.add('dl-on'));
  };
  const hide = () => { if (curtain) { curtain.classList.remove('dl-on'); curtain.hidden = true; } };
  document.addEventListener('click', (event) => {
    // The site's own page transition may take the click first, so this listens before it (capture) and does not ask who handled it.
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
    if (!link || link.target === '_blank' || link.hasAttribute('download')) return;
    const url = new URL(link.href, location.href);
    if (url.origin !== location.origin) return;
    // The Spanish and Portuguese dashboards live under /es/dash and /pt-br/dash: the language prefix is taken off before looking at the path.
    const plain = (path: string) => path.replace(/^\/(?:es|pt-br)(?=\/dash(?:\/|$))/i, '');
    const here = /^\/dash\/guild\/(\d+)/.exec(plain(location.pathname))?.[1];
    const target = plain(url.pathname);
    if (/^\/dash\/manage\/?$/.test(target) && !/^\/dash\/manage\/?$/.test(plain(location.pathname))) return show(true);
    const there = /^\/dash\/guild\/(\d+)/.exec(target)?.[1];
    if (there && there !== here) show(false);
  }, true);
  // A plain link to another page of the same server: nothing else answers it, so the content gives way to the placeholders (the same ones
  // the side menu shows). The site's own page transition takes the click too, so the click may be "handled" and still be a page load; the
  // layout does nothing while there are unsaved changes (that click only shakes the bar of changes).
  document.addEventListener('click', (event) => {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
    const show = (window as unknown as { dglShowSkeleton?: (href: string) => void }).dglShowSkeleton;
    if (!link || !show || link.target === '_blank' || link.hasAttribute('download')) return;
    const url = new URL(link.href, location.href);
    if (url.origin !== location.origin || (url.pathname === location.pathname && url.search === location.search)) return;
    const plain = (path: string) => path.replace(/^\/(?:es|pt-br)(?=\/dash(?:\/|$))/i, '');
    const guild = (path: string) => /^\/dash\/guild\/(\d+)(?:\/|$)/.exec(plain(path))?.[1];
    const here = guild(location.pathname);
    if (here && guild(url.pathname) === here) show(link.href);
  });
  window.addEventListener('pageshow', hide);
</script>

<style is:global>
  /* `display: grid` would beat the hidden attribute and leave the curtain over the page, taking every click. */
  .dl-curtain[hidden] { display: none !important; }
  .dl-curtain:not(.dl-on) { pointer-events: none; }
  .dl-curtain { position: fixed; inset: 0; z-index: 9999; display: grid; place-items: center; background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(6px); opacity: 0; transition: opacity .18s ease; }
  .dl-curtain.dl-on { opacity: 1; }
  .dl-box { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; padding: 28px 36px; border: 1px solid var(--border); border-radius: 18px; background: var(--card); box-shadow: 0 20px 60px rgba(0, 0, 0, .35); transform: translateY(8px) scale(.98); transition: transform .22s ease; }
  .dl-on .dl-box { transform: none; }
  .dl-box strong { font-size: 16px; }
  .dl-box small { font-size: 13px; color: var(--text-dim); }
  .dl-orbit { position: relative; width: 54px; height: 54px; margin-bottom: 10px; }
  .dl-orbit span { position: absolute; inset: 0; border-radius: 50%; border: 3px solid transparent; border-top-color: var(--accent); animation: dl-spin 1s linear infinite; }
  .dl-orbit span:nth-child(2) { inset: 7px; border-top-color: color-mix(in srgb, var(--accent) 60%, transparent); animation-duration: 1.4s; animation-direction: reverse; }
  .dl-orbit span:nth-child(3) { inset: 16px; border-top-color: color-mix(in srgb, var(--accent) 35%, transparent); animation-duration: .8s; }
  .dl-bar { width: 180px; height: 4px; border-radius: 4px; background: var(--accent-soft); overflow: hidden; margin-top: 12px; }
  .dl-bar i { display: block; height: 100%; width: 40%; border-radius: 4px; background: var(--accent); animation: dl-slide 1.2s ease-in-out infinite; }
  @keyframes dl-spin { to { transform: rotate(360deg); } }
  @keyframes dl-slide { 0% { transform: translateX(-110%); } 100% { transform: translateX(350%); } }
  @media (prefers-reduced-motion: reduce) { .dl-orbit span, .dl-bar i { animation-duration: 3s; } }
</style>
