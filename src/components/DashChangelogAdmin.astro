---
import { Icon } from 'astro-icon/components';
import DashMeLayout from './DashMeLayout.astro';
import type { Session } from '../utils/session';
import DashPanelHead from './DashPanelHead.astro';
import { getDashLang, makeT } from '../i18n/dash';

// The changelog editor (staff only, Staff → Changelog): write a version in Markdown, with notices (security, warning, breaking, information) that stand out above the list, in the
// three languages, with a live preview that looks like the public changelog. The form keeps its state in the page and sends it as one JSON field; the page that receives it
// (src/pages/dash/changelog-admin.astro) checks it again and saves it in the `site_changelog` table, and the public changelog shows the published ones.
interface Notice { kind: string; title: string; text: string }
interface Lang { notices: Notice[]; items: string[] }
interface Draft { version: string; name: string; date: string; published: boolean; langs: Record<'en' | 'es' | 'pt', Lang> }
interface Row { version: string; name: string; date: string; published: boolean; notices: number; source: 'db' | 'code' }
interface Props { user: Session; rows: Row[]; draft: Draft; isNew?: boolean; inDb?: boolean; inCode?: boolean; error?: string; saved?: boolean; deleted?: boolean; unavailable?: boolean }
const { user, rows, draft, isNew = false, inDb = false, inCode = false, error, saved = false, deleted = false, unavailable = false } = Astro.props;
const dt = makeT(getDashLang(Astro));
const kinds = [
  { value: 'security', label: dt('Security notice') },
  { value: 'warning', label: dt('Warning') },
  { value: 'breaking', label: dt('Change that breaks something') },
  { value: 'info', label: dt('Information') },
];
const tabs = [{ key: 'en', label: 'English' }, { key: 'es', label: 'Español' }, { key: 'pt', label: 'Português' }];
---

<DashMeLayout user={user} active="staff-changelog" pageTitle="Changelog">
  <div class="ce-wrap" data-ce>
    <DashPanelHead title={dt('Changelog')} eyebrow={dt('Staff')} icon="ph:clock-counter-clockwise-fill" back={false}>
      <a class="btn btn-ghost btn-sm" href="/changelog" target="_blank" rel="noopener"><Icon name="ph:arrow-square-out" width="14" height="14" /> {dt('See the page')}</a>
    </DashPanelHead>

    {error && <div class="ce-alert error"><Icon name="ph:warning-fill" width="17" height="17" /> {error}</div>}
    {saved && !error && <div class="ce-alert success"><Icon name="ph:check-circle-fill" width="17" height="17" /> {dt('Saved.')}</div>}
    {deleted && !error && <div class="ce-alert success"><Icon name="ph:check-circle-fill" width="17" height="17" /> {dt('Removed from the database.')}</div>}
    {unavailable && <div class="ce-alert error"><Icon name="ph:plug-fill" width="17" height="17" /> {dt('The database could not be read, so only the versions written in the code are listed. Saving may not work.')}</div>}

    <div class="ce-versions">
      {rows.map((row) => (
        <a href={`/dash/changelog-admin?v=${encodeURIComponent(row.version)}`} class:list={['ce-version', { 'is-current': !isNew && row.version === draft.version }]}>
          <b>v{row.version}</b>{row.name && <span> “{row.name}”</span>}
          <small>{row.date}</small>
          {row.notices > 0 && <i class="ce-pill ce-pill-red"><Icon name="ph:shield-warning-fill" width="11" height="11" /> {row.notices}</i>}
          {!row.published && <i class="ce-pill">{dt('Draft')}</i>}
          {row.source === 'code' && <i class="ce-pill">{dt('In the code')}</i>}
        </a>
      ))}
      <a href="/dash/changelog-admin?new=1" class:list={['ce-version', 'ce-new', { 'is-current': isNew }]}><Icon name="ph:plus-bold" width="13" height="13" /> {dt('New version')}</a>
    </div>

    <p class="ce-origin">
      {isNew ? dt('A new version. It is not shown on the site until you save it as published.')
        : inDb ? dt('Saved in the database. Published versions show on the changelog and in its RSS feed within a minute.')
        : dt('Written in the code of the website. Saving it here replaces it on the site with what you write.')}
    </p>

    <form method="POST" class="ce-grid" data-no-dirty>
      <input type="hidden" name="action" value="save" />
      <input type="hidden" name="draft" value="" data-ce-json />
      <section class="ce-editor">
        <div class="ce-card">
          <div class="ce-fields">
            <label>{dt('Version')}<input data-ce-field="version" value={draft.version} placeholder="0.7.12" maxlength="20" readonly={!isNew} required /></label>
            <label>{dt('Code name')}<input data-ce-field="name" value={draft.name} placeholder="Brownie" maxlength="40" /></label>
            <label>{dt('Date')}<input data-ce-field="date" type="date" value={draft.date} /></label>
            <label class="ce-check"><input data-ce-field="published" type="checkbox" checked={draft.published} /> {dt('Published')}</label>
          </div>
        </div>

        <div class="ce-tabs" role="tablist">
          {tabs.map((tab, index) => <button type="button" role="tab" class:list={['ce-tab', { 'is-on': index === 0 }]} data-ce-tab={tab.key}>{tab.label}</button>)}
        </div>

        <div class="ce-card">
          <div class="ce-head"><h2><Icon name="ph:shield-warning-fill" width="16" height="16" /> {dt('Notices')}</h2><button type="button" class="btn btn-ghost btn-sm" data-ce-add="notice"><Icon name="ph:plus-bold" width="12" height="12" /> {dt('Add a notice')}</button></div>
          <p class="ce-hint">{dt('A block that stands out above the list: a security breach, a warning, a change that breaks something, or plain information.')}</p>
          <div data-ce-notices></div>
        </div>

        <div class="ce-card">
          <div class="ce-head"><h2><Icon name="ph:list-bullets-fill" width="16" height="16" /> {dt('Changes')}</h2><button type="button" class="btn btn-ghost btn-sm" data-ce-add="item"><Icon name="ph:plus-bold" width="12" height="12" /> {dt('Add a change')}</button></div>
          <p class="ce-hint">{dt('One line for each change. Markdown: `code` and [links](https://petto.sbs).')}</p>
          <div data-ce-items></div>
        </div>

        <div class="ce-actions">
          <button class="btn btn-primary" type="submit"><Icon name="ph:floppy-disk-fill" width="15" height="15" /> {dt('Save')}</button>
          <button class="btn btn-ghost" type="button" data-ce-copy-from>{dt('Copy the English text to the other languages')}</button>
        </div>
      </section>

      <aside class="ce-preview">
        <div class="ce-preview-head"><Icon name="ph:eye-fill" width="14" height="14" /> {dt('Preview')} <span data-ce-preview-lang>English</span></div>
        <div class="win cl-win">
          <div class="win-bar">
            <span class="chip" style="background:var(--red)"></span><span class="chip" style="background:var(--yellow)"></span><span class="chip" style="background:var(--green)"></span>
            <span class="win-chan">#changelog</span>
          </div>
          <div class="win-body">
            <div class="wmsg">
              <div class="wav bot"><img src="/assets/mascot-icon.webp" alt="" /></div>
              <div class="cl-body">
                <div class="wmeta"><b>Petto</b><span class="wtag">{dt('Latest')}</span><span class="cl-date" data-ce-p-date></span></div>
                <div class="cl-version"><span data-ce-p-title></span></div>
                <div data-ce-p-notices></div>
                <ul class="cl-list" data-ce-p-items></ul>
              </div>
            </div>
          </div>
        </div>
      </aside>
    </form>
    {inDb && (
      <form method="POST" class="ce-delete" data-no-dirty>
        <input type="hidden" name="action" value="delete" />
        <input type="hidden" name="version" value={draft.version} />
        <button class="btn btn-ghost btn-sm" type="submit" data-confirm={inCode ? dt('Remove this version from the database? The one written in the code shows again.') : dt('Remove this version from the database? It disappears from the site.')}><Icon name="ph:trash-bold" width="13" height="13" /> {dt('Remove from the database')}</button>
      </form>
    )}
  </div>
</DashMeLayout>

<script type="application/json" id="ce-draft" set:html={JSON.stringify(draft)} />
<script type="application/json" id="ce-labels" set:html={JSON.stringify({ kindLabels: Object.fromEntries(kinds.map((kind) => [kind.value, kind.label])), langNames: { en: 'English', es: 'Español', pt: 'Português' }, labels: { remove: dt('Remove'), up: dt('Move up'), down: dt('Move down'), title: dt('Title'), text: dt('Text (Markdown)'), change: dt('Change'), none: dt('Nothing yet. Add the first one.'), copied: dt('Copied.') } })} />
<script>
  // @ts-nocheck
  const { kindLabels, langNames, labels } = JSON.parse(document.getElementById('ce-labels')!.textContent!);
  const state = JSON.parse(document.getElementById('ce-draft').textContent);
  const root = document.querySelector('[data-ce]');
  let lang = 'en';
  const esc = (text) => String(text).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  // The same inline Markdown as the public changelog: `code` and [links](https://...).
  const inline = (text) => esc(text).replace(/`([^`]+)`/g, '<code>$1</code>').replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noreferrer">$1</a>');
  const kindIcon = { security: 'M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5l-8-3Zm1 14h-2v-2h2v2Zm0-4h-2V7h2v5Z', warning: 'M1 21h22L12 2 1 21Zm12-3h-2v-2h2v2Zm0-4h-2v-4h2v4Z', breaking: 'M1 21h22L12 2 1 21Zm12-3h-2v-2h2v2Zm0-4h-2v-4h2v4Z', info: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 15h-2v-6h2v6Zm0-8h-2V7h2v2Z' };
  const icon = (kind) => `<svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path fill="currentColor" d="${kindIcon[kind] || kindIcon.info}"/></svg>`;

  function renderForm() {
    const data = state.langs[lang];
    root.querySelector('[data-ce-notices]').innerHTML = data.notices.length ? data.notices.map((notice, i) => `
      <div class="ce-row ce-notice-row" data-i="${i}">
        <div class="ce-row-top">
          <select data-k="kind">${Object.entries(kindLabels).map(([v, l]) => `<option value="${v}" ${v === notice.kind ? 'selected' : ''}>${esc(l)}</option>`).join('')}</select>
          <input data-k="title" value="${esc(notice.title)}" placeholder="${esc(labels.title)}" />
          <button type="button" class="ce-icon" data-act="remove-notice" title="${esc(labels.remove)}" aria-label="${esc(labels.remove)}">×</button>
        </div>
        <textarea data-k="text" rows="4" placeholder="${esc(labels.text)}">${esc(notice.text)}</textarea>
      </div>`).join('') : `<p class="ce-empty">${esc(labels.none)}</p>`;
    root.querySelector('[data-ce-items]').innerHTML = data.items.length ? data.items.map((item, i) => `
      <div class="ce-row ce-item-row" data-i="${i}">
        <textarea data-k="item" rows="2" placeholder="${esc(labels.change)}">${esc(item)}</textarea>
        <div class="ce-row-side">
          <button type="button" class="ce-icon" data-act="up" title="${esc(labels.up)}" aria-label="${esc(labels.up)}">↑</button>
          <button type="button" class="ce-icon" data-act="down" title="${esc(labels.down)}" aria-label="${esc(labels.down)}">↓</button>
          <button type="button" class="ce-icon" data-act="remove-item" title="${esc(labels.remove)}" aria-label="${esc(labels.remove)}">×</button>
        </div>
      </div>`).join('') : `<p class="ce-empty">${esc(labels.none)}</p>`;
  }

  function renderPreview() {
    const data = state.langs[lang];
    root.querySelector('[data-ce-preview-lang]').textContent = langNames[lang];
    root.querySelector('[data-ce-p-date]').textContent = state.date;
    root.querySelector('[data-ce-p-title]').innerHTML = `v${esc(state.version || '0.0.0')}${state.name ? ` <span class="cl-name">“${esc(state.name)}”</span>` : ''}`;
    root.querySelector('[data-ce-p-notices]').innerHTML = data.notices.map((n) => `<div class="cl-notice cl-notice-${esc(n.kind)}">
      <div class="cl-notice-head">${icon(n.kind)}<b>${esc(n.title || '…')}</b></div>
      ${String(n.text).split(/\n{2,}/).filter(Boolean).map((p) => `<p>${inline(p)}</p>`).join('')}</div>`).join('');
    root.querySelector('[data-ce-p-items]').innerHTML = data.items.filter((i) => i.trim()).map((i) => `<li>${inline(i)}</li>`).join('');
    root.querySelector('[data-ce-json]').value = JSON.stringify(state);
  }

  const redraw = () => { renderForm(); renderPreview(); };
  root.querySelectorAll('[data-ce-field]').forEach((input) => {
    input.addEventListener('input', () => { state[input.dataset.ceField] = input.type === 'checkbox' ? input.checked : input.value; renderPreview(); });
  });
  root.querySelectorAll('[data-ce-tab]').forEach((tab) => tab.addEventListener('click', () => {
    lang = tab.dataset.ceTab;
    root.querySelectorAll('[data-ce-tab]').forEach((other) => other.classList.toggle('is-on', other === tab));
    redraw();
  }));
  root.addEventListener('input', (event) => {
    const target = event.target;
    const row = target.closest?.('.ce-row');
    if (!row) return;
    const i = Number(row.dataset.i);
    const data = state.langs[lang];
    if (row.classList.contains('ce-notice-row')) data.notices[i][target.dataset.k] = target.value;
    else data.items[i] = target.value;
    renderPreview();
  });
  root.addEventListener('click', (event) => {
    const button = event.target.closest?.('button');
    if (!button) return;
    const data = state.langs[lang];
    const row = button.closest('.ce-row');
    const i = row ? Number(row.dataset.i) : -1;
    if (button.dataset.ceAdd === 'notice') data.notices.push({ kind: 'info', title: '', text: '' });
    else if (button.dataset.ceAdd === 'item') data.items.push('');
    else if (button.dataset.act === 'remove-notice') data.notices.splice(i, 1);
    else if (button.dataset.act === 'remove-item') data.items.splice(i, 1);
    else if (button.dataset.act === 'up' && i > 0) [data.items[i - 1], data.items[i]] = [data.items[i], data.items[i - 1]];
    else if (button.dataset.act === 'down' && i < data.items.length - 1) [data.items[i + 1], data.items[i]] = [data.items[i], data.items[i + 1]];
    else if (button.hasAttribute('data-ce-copy-from')) {
      for (const other of Object.keys(state.langs)) if (other !== lang) state.langs[other] = JSON.parse(JSON.stringify(data));
      button.textContent = labels.copied;
    } else return;
    redraw();
  });
  redraw();
</script>

<style is:global>
  .ce-wrap { max-width: 1180px; min-width: 0; margin: 0 auto; }
  .ce-alert { display: flex; align-items: center; gap: 8px; border-radius: 12px; padding: 11px 14px; font-size: 13.5px; margin-bottom: 14px; border: 1px solid; }
  .ce-alert.error { color: var(--red, #fe6465); background: color-mix(in srgb, currentColor 10%, transparent); }
  .ce-alert.success { color: var(--green); border-color: var(--green); background: var(--green-soft); }
  .ce-origin { margin: 0 0 14px; font-size: 13px; color: var(--text-dim); }
  .ce-delete { margin: 18px 0 0; }
  .ce-delete :global(button) { color: var(--red, #e5484d); }
  .ce-version { text-decoration: none; }
  .ce-versions { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 16px; }
  .ce-version { display: inline-flex; align-items: baseline; gap: 6px; border: 1px solid var(--border-soft); border-radius: 999px; padding: 7px 14px; background: transparent; color: var(--text-muted); font-family: var(--sans); font-size: 13px; cursor: pointer; }
  .ce-version b { color: var(--text); }
  .ce-version small { color: var(--text-dim); font-size: 11.5px; }
  .ce-version.is-current { border-color: var(--accent); background: var(--accent-soft); }
  .ce-new { align-items: center; color: var(--accent); border-style: dashed; }
  .ce-pill { display: inline-flex; align-items: center; gap: 3px; font-style: normal; font-size: 10.5px; font-weight: 700; padding: 1px 7px; border-radius: 999px; background: color-mix(in srgb, var(--text-dim) 20%, transparent); color: var(--text-muted); align-self: center; }
  .ce-pill-red { background: color-mix(in srgb, var(--red, #fe6465) 18%, transparent); color: var(--red, #fe6465); }
  .ce-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 18px; align-items: start; }
  .ce-editor { margin: 0; padding: 0; min-width: 0; }
  .ce-card { border: 1px solid var(--border-soft); border-radius: 14px; background: color-mix(in srgb, var(--text) 2%, transparent); padding: 14px 16px; margin-bottom: 12px; min-width: 0; }
  .ce-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 12px; }
  .ce-fields label, .ce-row label { display: flex; flex-direction: column; gap: 5px; font-size: 12.5px; color: var(--text-muted); min-width: 0; }
  .ce-check { flex-direction: row !important; align-items: center; gap: 8px !important; align-self: end; padding-bottom: 8px; }
  .ce-wrap input:not([type='checkbox']), .ce-wrap select, .ce-wrap textarea { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; min-width: 0; width: 100%; box-sizing: border-box; }
  .ce-wrap textarea { resize: vertical; line-height: 1.5; font-family: var(--mono); font-size: 12.5px; }
  .ce-tabs { display: flex; gap: 6px; margin-bottom: 12px; }
  .ce-tab { border: 1px solid var(--border-soft); background: transparent; color: var(--text-muted); border-radius: 999px; padding: 6px 14px; font-family: var(--sans); font-size: 13px; font-weight: 600; cursor: pointer; }
  .ce-tab.is-on { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }
  .ce-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .ce-head h2 { display: flex; align-items: center; gap: 7px; font-size: 14.5px; margin: 0; }
  .ce-hint { margin: 6px 0 12px; font-size: 12.5px; color: var(--text-dim); }
  .ce-empty { margin: 0; font-size: 13px; color: var(--text-dim); }
  .ce-row { border: 1px solid var(--border-soft); border-radius: 10px; padding: 10px; margin-bottom: 8px; display: flex; flex-direction: column; gap: 8px; }
  .ce-item-row { flex-direction: row; align-items: flex-start; }
  .ce-item-row textarea { flex: 1; }
  .ce-row-top { display: grid; grid-template-columns: 170px minmax(0, 1fr) auto; gap: 8px; align-items: center; }
  .ce-row-side { display: flex; flex-direction: column; gap: 4px; }
  .ce-icon { width: 28px; height: 28px; border-radius: 8px; border: 1px solid var(--border-soft); background: transparent; color: var(--text-muted); cursor: pointer; font-size: 15px; line-height: 1; }
  .ce-icon:hover { color: var(--text); border-color: var(--text-dim); }
  .ce-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .ce-preview { position: sticky; top: 16px; min-width: 0; }
  .ce-preview-head { display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--text-dim); margin-bottom: 8px; }
  .ce-preview-head span { color: var(--accent); font-weight: 600; }
  .ce-preview .win { background: var(--card); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; box-shadow: 0 24px 48px -28px rgba(0,0,0,0.4); }
  .ce-preview .win-bar { display: flex; align-items: center; gap: 8px; padding: 12px 15px; border-bottom: 1px solid var(--border-soft); }
  .ce-preview .win-bar .chip { width: 10px; height: 10px; border-radius: 50%; }
  .ce-preview .win-chan { margin-left: 6px; font-family: var(--mono); font-size: 12px; color: var(--text-dim); }
  .ce-preview .win-body { padding: 20px; }
  .ce-preview .wmsg { display: flex; gap: 13px; }
  .ce-preview .wav { width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0; overflow: hidden; }
  .ce-preview .wav img { width: 100%; height: 100%; object-fit: cover; }
  .ce-preview .wtag { font-family: var(--mono); font-size: 9.5px; background: var(--accent); color: var(--accent-ink); padding: 1px 5px; border-radius: 4px; }
  .cl-win { margin: 0; }
  .cl-win .win-bar .chip { width: 10px; height: 10px; }
  .cl-body { flex: 1; min-width: 0; }
  .cl-body .wmeta { display: flex; align-items: center; gap: 8px; font-size: 13px; margin-bottom: 10px; }
  .cl-date { color: var(--text-dim); font-size: 12px; }
  .cl-version { font-family: var(--serif); font-size: 21px; font-weight: 600; margin-bottom: 14px; }
  .cl-name { font-weight: 400; color: var(--text-muted); font-size: 0.8em; }
  .cl-list { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 10px; }
  .cl-list li { font-size: 14px; color: var(--text-muted); line-height: 1.6; }
  .cl-list code, .cl-notice code { font-family: var(--mono); font-size: 12.5px; color: var(--accent); background: var(--accent-soft); padding: 1px 6px; border-radius: 5px; }
  .cl-notice { margin: 0 0 16px; padding: 12px 14px; border-radius: 12px; border: 1px solid color-mix(in srgb, var(--notice) 55%, transparent); background: color-mix(in srgb, var(--notice) 11%, transparent); --notice: var(--text-dim); }
  .cl-notice-security { --notice: var(--red, #ff6b6b); }
  .cl-notice-warning { --notice: var(--yellow, #fed53c); }
  .cl-notice-breaking { --notice: var(--accent, #f4a58a); }
  .cl-notice-info { --notice: var(--blue, #7aa7ff); }
  .cl-notice .cl-notice-head { display: flex; align-items: center; gap: 8px; color: var(--notice); font-size: 14.5px; margin-bottom: 6px; }
  .cl-notice p { margin: 6px 0 0; font-size: 13.5px; line-height: 1.6; color: var(--text); }
  @media (max-width: 980px) { .ce-grid { grid-template-columns: minmax(0, 1fr); } .ce-preview { position: static; } .ce-row-top { grid-template-columns: minmax(0, 1fr) auto; } .ce-row-top select { grid-column: 1 / -1; } }
</style>
