---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = t.toolsPage.snowflake;
const intlLocale = lang === 'es' ? 'es-ES' : lang === 'pt-BR' ? 'pt-BR' : 'en-US';
---
<Base title={`${p.title} · Petto`} lang={lang}>
  <main>
    <section class="tool-sec">
      <div class="wrap tool-wrap">
        <div class="eyebrow">{p.eyebrow}</div>
        <h1>{p.title}</h1>
        <p class="tool-lede">{p.lede}</p>

        <div class="sf-input-row reveal">
          <Icon name="ph:hash" width="16" height="16" />
          <input type="text" id="sfInput" inputmode="numeric" placeholder={p.inputPlaceholder} autocomplete="off" data-locale={intlLocale} />
        </div>
        <p class="sf-error" id="sfError" style="display:none;">{p.invalidMessage}</p>

        <div class="sf-result reveal" id="sfResult" style="display:none;">
          <div class="sf-row">
            <span>{p.createdLabel}</span>
            <b id="sfCreated"></b>
          </div>
          <div class="sf-row">
            <span>{p.discordTimestampLabel}</span>
            <code id="sfCode"></code>
          </div>
          <div class="sf-grid">
            <div><span>{p.workerLabel}</span><b id="sfWorker"></b></div>
            <div><span>{p.processLabel}</span><b id="sfProcess"></b></div>
            <div><span>{p.incrementLabel}</span><b id="sfIncrement"></b></div>
          </div>
        </div>
        <p class="sf-empty" id="sfEmpty">{p.emptyMessage}</p>
      </div>
    </section>
  </main>
</Base>

<script>
  const DISCORD_EPOCH = 1420070400000n;
  const input = document.getElementById('sfInput') as HTMLInputElement;
  const locale = input?.dataset.locale || 'en-US';
  const errorEl = document.getElementById('sfError');
  const resultEl = document.getElementById('sfResult');
  const emptyEl = document.getElementById('sfEmpty');
  const createdEl = document.getElementById('sfCreated');
  const codeEl = document.getElementById('sfCode');
  const workerEl = document.getElementById('sfWorker');
  const processEl = document.getElementById('sfProcess');
  const incrementEl = document.getElementById('sfIncrement');

  function decode(raw: string) {
    if (!/^\d{15,20}$/.test(raw)) return null;
    try {
      const id = BigInt(raw);
      const unixMs = (id >> 22n) + DISCORD_EPOCH;
      const worker = (id & 0x3e0000n) >> 17n;
      const process = (id & 0x1f000n) >> 12n;
      const increment = id & 0xfffn;
      return { date: new Date(Number(unixMs)), worker, process, increment };
    } catch {
      return null;
    }
  }

  input?.addEventListener('input', () => {
    const raw = input.value.trim();
    if (!raw) {
      errorEl!.style.display = 'none';
      resultEl!.style.display = 'none';
      emptyEl!.style.display = 'block';
      return;
    }
    const decoded = decode(raw);
    if (!decoded) {
      errorEl!.style.display = 'block';
      resultEl!.style.display = 'none';
      emptyEl!.style.display = 'none';
      return;
    }
    errorEl!.style.display = 'none';
    emptyEl!.style.display = 'none';
    resultEl!.style.display = 'block';
    createdEl!.textContent = decoded.date.toLocaleString(locale, { dateStyle: 'long', timeStyle: 'medium' });
    codeEl!.textContent = `<t:${Math.floor(decoded.date.getTime() / 1000)}:F>`;
    workerEl!.textContent = String(decoded.worker);
    processEl!.textContent = String(decoded.process);
    incrementEl!.textContent = String(decoded.increment);
  });
</script>

<style>
  .tool-sec { padding: 64px 0 110px; }
  .tool-wrap { max-width: 640px; }
  .tool-sec h1 { font-size: 32px; margin: 14px 0 12px; }
  .tool-lede { color: var(--text-muted); font-size: 15.5px; line-height: 1.65; max-width: 60ch; margin-bottom: 32px; }

  .sf-input-row { display: flex; align-items: center; gap: 10px; border: 1px solid var(--border); border-radius: 10px; padding: 12px 16px; color: var(--text-dim); margin-bottom: 10px; }
  .sf-input-row input { border: none; background: none; outline: none; color: var(--text); font-family: var(--mono); font-size: 15px; width: 100%; }
  .sf-error { color: var(--red); font-size: 13px; margin: 0 0 20px; }
  .sf-empty { color: var(--text-dim); font-size: 13.5px; }

  .sf-result { border: 1px solid var(--border-soft); border-radius: 12px; padding: 18px 20px; margin-top: 14px; }
  .sf-row { display: flex; align-items: center; justify-content: space-between; padding: 9px 0; border-bottom: 1px solid var(--border-soft); font-size: 14px; }
  .sf-row span { color: var(--text-dim); }
  .sf-row b { color: var(--text); font-weight: 600; }
  .sf-row code { font-family: var(--mono); font-size: 12.5px; color: var(--accent); background: var(--accent-soft); padding: 3px 8px; border-radius: 6px; }
  .sf-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; padding-top: 14px; }
  .sf-grid div { display: flex; flex-direction: column; gap: 4px; }
  .sf-grid span { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-dim); }
  .sf-grid b { font-size: 15px; color: var(--text); }

  @media (max-width: 480px) {
    .sf-grid { grid-template-columns: 1fr; }
  }
</style>
