---
// Tickets → AI assistant (beta). Number tiles on top (replies of the month, the limit per ticket, the ticket types, the hand-over words), then the
// switch and scope and the fixed safety rules (read only) side by side, the instructions, the test chat and the setup helper. The switch, the scope
// and the instructions are one POST form (the save bar tracks it). The two chats are folds whose code (DashTicketAiChat.ts) is only loaded the
// first time one of them is opened.
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashAcData from './DashAcData.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import SxNumber from './SxNumber.astro';
import { agoText } from '../utils/formatDuration';
import { getDashLang, makeT, dashLocale } from '../i18n/dash';
import { LIMITS, LANGUAGES } from '../utils/ticketAiPrompt.mjs';
import { SAFETY_RULES, startersFor } from '../data/ticketAiRules';
import type { TicketAiSettings, TableState } from '../utils/ticketAi';

const lang = getDashLang(Astro);
const dt = makeT(lang);
interface Props {
  user: { userId?: string; username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  settings: TicketAiSettings;
  state: TableState;
  categories: { id: string; label: string; emoji: string; panelId: string }[];
  panels: { id: string; name: string }[];
  channels: { id: string; name: string; type?: number }[];
  usage: number;
  groqConfigured: boolean;
  viewOnly: boolean;
  saved: boolean;
  error: string | null;
}
const { user, guildId, guildName, guildIcon, settings, state, categories, panels, channels, usage, groqConfigured, viewOnly, saved, error } = Astro.props;
const canSave = state === 'ok' && !viewOnly;
const chatsOn = groqConfigured && !viewOnly;
const scopeSome = settings.categoryIds.length > 0;
const chosen = new Set(settings.categoryIds);

// The ticket types grouped by the panel they are on (types on no panel last).
const groups = [
  ...panels.map((p) => ({ name: p.name, items: categories.filter((c) => c.panelId === p.id) })),
  { name: dt('Not on a panel'), items: categories.filter((c) => !c.panelId || !panels.some((p) => p.id === c.panelId)) },
].filter((g) => g.items.length > 0);

const starters = startersFor(lang);
const starterList = [
  { id: 'community', icon: 'ph:users-three-fill', label: dt('Community') },
  { id: 'shop', icon: 'ph:tag-fill', label: dt('Shop') },
  { id: 'game', icon: 'ph:sword-fill', label: dt('Game server') },
] as const;
const languageLabels: Record<string, string> = {
  auto: dt("The ticket user's language"), en: 'English', es: 'Español', 'pt-BR': 'Português (Brasil)', fr: 'Français', de: 'Deutsch', it: 'Italiano',
};
const toneLabels: Record<string, string> = { friendly: dt('Friendly'), neutral: dt('Neutral'), formal: dt('Formal') };
const locale = dashLocale(lang);
const countNum = (n: number, max: number) => `${n.toLocaleString(locale)} / ${max.toLocaleString(locale)}`;
const count = (text: string, max: number) => countNum(text.length, max);
const handoffLines = settings.handoff.split('\n').filter((line) => line.trim()).length;
const lastSaved = settings.updatedAt ? agoText(dt, settings.updatedAt, { locale }) : null;
const totalChars = settings.instructions.length + settings.knowledge.length + settings.handoff.length;
const tones = Object.entries(toneLabels);

// What the scripts show in the browser, in the language of the dashboard.
const clientData = JSON.stringify({
  starters,
  endpoint: `/dash/guild/${guildId}/ai-assistant-api`,
  lang,
  locale,
  words: {
    replace: dt('Replace what is in the instructions, knowledge and hand-over fields with this template?'),
    replaceYes: dt('Replace'),
    you: dt('You'), assistant: dt('Assistant'), owner: dt('You'), helper: dt('Helper'),
    thinking: dt('Writing...'),
    handoffModel: dt('The assistant handed the ticket over to staff.'),
    handoffKeyword: dt('Handed over to staff: the message matches “{k}”.'),
    handoffLimit: dt('Handed over to staff: the limit of {n} AI replies was reached.'),
    handoffSecret: dt('Handed over to staff: the message looked like it had a token or a card number, so it was not sent to the AI.'),
    handoffEnd: dt('In a real ticket the assistant stops here and staff takes over.'),
    lastReply: dt('That was the last AI reply allowed in this ticket. The next message goes to staff.'),
    replies: dt('AI replies: {a} of {b}'),
    network: dt('No answer from Petto. Check your connection and try again.'),
    applied: dt('The draft is in the fields. Check it and press Save to keep it.'),
    draftTitle: dt('Draft from the helper'),
    instructions: dt('Instructions'), knowledge: dt('Knowledge'), handoff: dt('Hand over to staff when...'),
    empty: dt('(empty)'),
    draftNow: dt('Write the draft now with what you know.'),
    apply: dt('Apply to the fields'), dismiss: dt('Dismiss'),
  },
}).replace(/</g, '\\u003c');
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="ticket-ai" pageTitle="AI assistant">
  <DashSettingsKit />
  <DashFormKit />
  <DashAcData channels={channels} />
  <script type="application/json" id="tai-data" set:html={clientData}></script>
  <span hidden data-tai-handoff-icon><Icon name="ph:headset-fill" width="15" height="15" /></span>

  <div class="sx-page tai-page">
    <div class="sx-title">
      <h1>{dt('AI assistant')}</h1>
      <span class="tai-beta">{dt('Beta')}</span>
      <span class:list={['sx-pill-state', { on: settings.enabled }]} data-tai-pill data-on={dt('On')} data-off={dt('Off')}>{settings.enabled ? dt('On') : dt('Off')}</span>
    </div>
    <p class="tai-lead">{dt('Petto answers the first questions in a ticket from what you write here, and hands over to staff when needed.')}</p>

    {saved && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
    {error && <div class="sx-flash sx-flash-bad" role="alert"><Icon name="ph:warning-fill" width="15" height="15" />{error}</div>}
    {state === 'pending' && !error && <div class="sx-flash sx-flash-warn"><Icon name="ph:hourglass-medium-fill" width="15" height="15" /><span>{dt('The database update for the AI assistant is pending. You can look around and try the chats; saving turns on when the update arrives.')}</span></div>}
    {state === 'error' && !error && <div class="sx-flash sx-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" /><span>{dt("Couldn't read the saved settings, so saving is off to keep them safe. Reload the page in a moment.")}</span></div>}
    {!groqConfigured && <div class="sx-flash sx-flash-warn" data-tai-state="not-configured"><Icon name="ph:plug-fill" width="15" height="15" /><span>{dt('The AI is not configured on this Petto yet, so the test chat and the setup helper are off. Your settings can still be saved.')}</span></div>}
    {viewOnly && <div class="sx-flash sx-flash-warn"><Icon name="ph:eye-fill" width="15" height="15" />{dt('You can look at this page but not change it.')}</div>}

    <DashStatTiles tiles={[
      { label: dt('Replies this month'), value: usage, tone: 'messages' },
      { label: dt('Replies per ticket'), value: settings.maxReplies, tone: 'voice' },
      scopeSome ? { label: dt('Ticket types'), value: settings.categoryIds.length, tone: 'joins' } : { label: dt('Ticket types'), value: 0, text: dt('All'), tone: 'joins' },
      { label: dt('Hand-over words'), value: handoffLines, tone: 'invites' },
    ]} />

    <div class="tai-grid">
      <form method="POST" class="tai-form" id="tai-form" data-no-dirty={canSave ? undefined : ''}>
        <section class="sx-panel tai-scope-panel" aria-labelledby="tai-h-scope">
          <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:#9bd0f5"><Icon name="ph:sliders-horizontal-fill" width="17" height="17" /></span><h2 id="tai-h-scope">{dt('Switch and scope')}</h2></div>
          <label class="sx-switch sx-master">
            <input type="checkbox" name="enabled" checked={settings.enabled} disabled={viewOnly} />
            <span class="sx-switch-text"><b>{dt('Answer tickets with the AI assistant')}</b><em>{dt('It writes the first answers in a ticket, using only your instructions.')}</em></span>
            <i class="sx-toggle"></i>
          </label>

          <fieldset class="tai-set" disabled={viewOnly}>
            <legend class="sx-label">{dt('Where it answers')}</legend>
            <div class="sx-chips" role="radiogroup" aria-label={dt('Where it answers')}>
              <label class="sx-chip"><input type="radio" name="scope" value="all" checked={!scopeSome} /><span>{dt('In every ticket type')}</span></label>
              <label class="sx-chip"><input type="radio" name="scope" value="some" checked={scopeSome} /><span>{dt('Only in the ticket types I choose')}</span></label>
            </div>
            {groups.length === 0 && (
              <p class="sx-empty tai-empty"><Icon name="ph:ticket" width="16" height="16" /><span>{dt('This server has no ticket types yet.')} <a href={`/dash/guild/${guildId}/tickets?section=types`}>{dt('Add ticket types')}</a></span></p>
            )}
            <div class="tai-picker" data-sx-needs="scope=some" hidden={groups.length === 0}>
              {groups.map((g) => (
                <div class="tai-group">
                  <span class="tai-group-name">{g.name}</span>
                  <div class="sx-chips">
                    {g.items.map((c) => (
                      <label class="sx-chip"><input type="checkbox" name="category_ids" value={c.id} checked={chosen.has(c.id)} /><span>{c.emoji && !c.emoji.startsWith('<') ? `${c.emoji} ` : ''}{c.label}</span></label>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </fieldset>

          <div class="sx-field tai-max">
            <label for="tai-max">{dt('AI replies per ticket')}</label>
            <SxNumber id="tai-max" name="max_replies" min={LIMITS.maxRepliesMin} max={LIMITS.maxRepliesMax} value={settings.maxReplies} required disabled={viewOnly} />
            <span class="sx-hint">{dt('After this many replies it stops and asks for staff ({a} to {b}).', { a: LIMITS.maxRepliesMin, b: LIMITS.maxRepliesMax })}</span>
          </div>
          <p class="tai-note"><Icon name="ph:headset-fill" width="16" height="16" /><span><b>{dt('Staff can always take over.')}</b> {dt('As soon as a staff member writes in the ticket, the assistant stops answering there.')}</span></p>
        </section>

        <section class="sx-panel tai-instr" aria-labelledby="tai-h-instr">
          <div class="sx-panel-head">
            <span class="sx-panel-icon" style="--c:#f0a88f"><Icon name="ph:notebook-fill" width="17" height="17" /></span>
            <h2 id="tai-h-instr">{dt('Instructions')}</h2>
            <span class="tai-total" title={dt('The instructions, the knowledge and the hand-over list together can have up to {n} characters.', { n: LIMITS.total.toLocaleString(locale) })}>{dt('Together')} <b data-tai-total data-max={LIMITS.total}>{countNum(totalChars, LIMITS.total)}</b></span>
          </div>
          <div class="tai-starters" role="group" aria-label={dt('Starter templates')}>
            <span class="tai-starters-label">{dt('Start from a template')}</span>
            {starterList.map((s) => (
              <button type="button" class="tai-starter" data-tai-starter={s.id} disabled={viewOnly}><Icon name={s.icon} width="15" height="15" />{s.label}</button>
            ))}
          </div>

          <div class="sx-field">
            <div class="tai-label-row"><label for="tai-instructions">{dt('What the assistant should do and know')}</label><span class="tai-count" data-tai-counter="tai-instructions">{count(settings.instructions, LIMITS.instructions)}</span></div>
            <textarea id="tai-instructions" name="instructions" class="dgl-autogrow tai-t-lg" data-ac="channels,commands,emojis" data-tai-count maxlength={LIMITS.instructions} rows="9" disabled={viewOnly} placeholder={dt('How support works here, the rules it must explain, what it must never do, the tone and language...')}>{settings.instructions}</textarea>
            <span class="sx-hint">{dt('Type # to point to a channel and / for a command.')}</span>
          </div>

          <div class="sx-field">
            <div class="tai-label-row"><label for="tai-knowledge">{dt('Knowledge')}</label><span class="tai-count" data-tai-counter="tai-knowledge">{count(settings.knowledge, LIMITS.knowledge)}</span></div>
            <textarea id="tai-knowledge" name="knowledge" class="dgl-autogrow tai-t-md" data-ac="channels,commands,emojis" data-tai-count maxlength={LIMITS.knowledge} rows="7" disabled={viewOnly} placeholder={dt('Short questions and answers, or pasted text. Q: How long is delivery?  A: 24 hours.')}>{settings.knowledge}</textarea>
            <span class="sx-hint">{dt('The only facts it may use. Anything missing here, it says it does not know and calls staff.')}</span>
          </div>

          <div class="sx-grid tai-pair">
            <div class="sx-field">
              <div class="tai-label-row"><label for="tai-handoff">{dt('Hand over to staff when...')}</label><span class="tai-count" data-tai-counter="tai-handoff">{count(settings.handoff, LIMITS.handoff)}</span></div>
              <textarea id="tai-handoff" name="handoff" class="dgl-autogrow" data-tai-count maxlength={LIMITS.handoff} rows="4" disabled={viewOnly} placeholder={dt('One per line: refund, ban appeal, payment, threats...')}>{settings.handoff}</textarea>
              <span class="sx-hint">{dt('One keyword or situation per line. A message with one of these words goes straight to staff.')}</span>
            </div>
            <div class="sx-field">
              <div class="tai-label-row"><label for="tai-links">{dt('Discord messages it can read')}</label><span class="tai-count">{settings.messageLinks.length} / {LIMITS.discordMessages}</span></div>
              <textarea id="tai-links" name="message_links" class="dgl-autogrow tai-links" rows="3" disabled={viewOnly} placeholder="https://discord.com/channels/..." spellcheck="false">{settings.messageLinks.join('\n')}</textarea>
              <span class="sx-hint">{dt('One message link per line, from this server, for example your rules. Copy it with Copy Message Link. Petto reads the message when it answers, so if you edit the message the assistant knows the new text. Petto must be able to see that channel.')}</span>
            </div>
          </div>

          <div class="sx-field">
            <div class="tai-label-row"><label for="tai-style">{dt('How it should answer')}</label><span class="tai-count" data-tai-counter="tai-style">{count(settings.replyStyle, LIMITS.reply_style)}</span></div>
            <textarea id="tai-style" name="reply_style" class="dgl-autogrow" data-tai-count maxlength={LIMITS.reply_style} rows="5" disabled={viewOnly} placeholder={dt('Length, format and wording. Example: At most 3 short lines, no lists, no emojis, greet by name, end by asking if it solved the problem.')}>{settings.replyStyle}</textarea>
            <span class="sx-hint">{dt('Extra instructions for how the answers look and sound. You can add an example reply. The safety rules still come first.')}</span>
          </div>

          <div class="sx-grid tai-pair">
            <div class="sx-field">
              <span class="sx-label" id="tai-tone-label">{dt('Tone')}</span>
              <div class="sx-chips" role="radiogroup" aria-labelledby="tai-tone-label">
                {tones.map(([value, label]) => <label class="sx-chip"><input type="radio" name="tone" value={value} checked={settings.tone === value} disabled={viewOnly} /><span>{label}</span></label>)}
              </div>
            </div>
            <div class="sx-field">
              <label for="tai-lang">{dt('Language of the replies')}</label>
              <select id="tai-lang" name="language_mode" disabled={viewOnly}>
                {Object.keys(LANGUAGES).map((value) => <option value={value} selected={settings.languageMode === value}>{languageLabels[value] ?? value}</option>)}
              </select>
            </div>
          </div>

          <label class="sx-switch">
            <input type="checkbox" name="channel_guide" disabled={viewOnly} checked={settings.channelGuide} />
            <span class="sx-switch-text"><b>{dt('Let it know the channels of the server')}</b><em>{dt('It sees the names and topics of the channels the person can see, so it can say where to go and mention the channel. Write what each channel is for in its topic.')}</em></span>
            <i class="sx-toggle"></i>
          </label>

          <div class="sx-foot">
            <button type="submit" class="btn btn-accent btn-sm tai-save" disabled={!canSave}>{dt('Save changes')}</button>
            {lastSaved && <span class="sx-hint">{dt('Last saved {a}', { a: lastSaved })}</span>}
          </div>
        </section>
      </form>

      <section class="sx-panel tai-safety" aria-labelledby="tai-h-safety">
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style="--c:#86b894"><Icon name="ph:shield-check-fill" width="17" height="17" /></span>
          <h2 id="tai-h-safety">{dt('Safety')}</h2>
          <span class="tai-lock"><Icon name="ph:lock-fill" width="11" height="11" />{dt('Always on')}</span>
        </div>
        <ul class="tai-rules">
          {SAFETY_RULES.map((rule) => <li><span class="tai-rule-icon"><Icon name={rule.icon} width="14" height="14" /></span><span>{dt(rule.text)}</span></li>)}
        </ul>
        <p class="sx-hint">{dt('Petto puts these rules before and after your instructions. Your texts are read as data, so they cannot remove or change the rules.')}</p>
        <p class="tai-note"><Icon name="ph:flask-fill" width="16" height="16" /><span><b>{dt('This is a beta.')}</b> {dt('Answers can be wrong. Test it here first, keep your instructions clear, and check its tickets now and then. Test chat messages are not counted.')}</span></p>
      </section>

      <details class="dfx-acc tai-fold tai-fold-test" data-tai-chat="test">
        <summary><span class="sx-panel-icon" style="--c:#c6a8f5"><Icon name="ph:chat-circle-dots-fill" width="17" height="17" /></span><span class="dfx-acc-title"><b>{dt('Test chat')}</b><em>{dt('Write as a member who opened a ticket. Nothing is sent to Discord.')}</em></span><Icon name="ph:caret-down-bold" width="14" height="14" class="dfx-caret" /></summary>
        <div class="dfx-acc-body tai-chat-body">
          {chatsOn && (
            <div class="tai-source" role="radiogroup" aria-label={dt('Instructions to test')}>
              <label><input type="radio" name="tai_source" value="draft" checked /><span>{dt('What is in the fields now')}</span></label>
              <label><input type="radio" name="tai_source" value="saved" disabled={state !== 'ok'} /><span>{dt('Saved settings')}</span></label>
            </div>
          )}
          {chatsOn ? (
            <div class="tai-chat" data-tai-kind="test">
              <div class="tai-log" role="log" aria-live="polite"><p class="tai-log-empty">{dt('Try a common question, or one it should hand over, like a refund.')}</p></div>
              <div class="tai-meta"><span data-tai-replies>{dt('AI replies: {a} of {b}', { a: 0, b: settings.maxReplies })}</span><button type="button" class="tai-link" data-tai-reset>{dt('Start over')}</button></div>
              <div class="tai-compose">
                <textarea rows="2" maxlength={LIMITS.message} aria-label={dt('Message as a ticket user')} placeholder={dt('Hi, how long does delivery take?')}></textarea>
                <button type="button" class="btn btn-accent btn-sm tai-send" data-keep aria-label={dt('Send')}><Icon name="ph:paper-plane-tilt-fill" width="15" height="15" /></button>
              </div>
            </div>
          ) : (
            <p class="sx-empty tai-empty"><Icon name="ph:plug-fill" width="16" height="16" />{viewOnly ? dt('You can look at this page but not change it.') : dt('The AI is not configured on this Petto yet.')}</p>
          )}
        </div>
      </details>

      <details class="dfx-acc tai-fold tai-fold-helper" data-tai-chat="helper">
        <summary><span class="sx-panel-icon" style="--c:#ffb86c"><Icon name="ph:magic-wand-fill" width="17" height="17" /></span><span class="dfx-acc-title"><b>{dt('Help me configure')}</b><em>{dt('Answer a few questions and get a draft of the instructions, knowledge and hand-over list. Nothing is saved until you press Save.')}</em></span><Icon name="ph:caret-down-bold" width="14" height="14" class="dfx-caret" /></summary>
        <div class="dfx-acc-body tai-chat-body">
          {chatsOn ? (
            <div class="tai-chat" data-tai-kind="helper">
              <div class="tai-log" role="log" aria-live="polite">
                <div class="tai-msg tai-them" data-tai-intro><span class="tai-who">{dt('Helper')}</span><p>{dt('Hi! I will ask you a few short questions and then write a draft for you. First: what is your server about?')}</p></div>
              </div>
              <div class="tai-meta"><button type="button" class="tai-link" data-tai-draftnow>{dt('Write the draft now')}</button><button type="button" class="tai-link" data-tai-reset>{dt('Start over')}</button></div>
              <div class="tai-compose">
                <textarea rows="2" maxlength={LIMITS.message} aria-label={dt('Your answer')} placeholder={dt('A Minecraft server with a shop...')}></textarea>
                <button type="button" class="btn btn-accent btn-sm tai-send" data-keep aria-label={dt('Send')}><Icon name="ph:paper-plane-tilt-fill" width="15" height="15" /></button>
              </div>
            </div>
          ) : (
            <p class="sx-empty tai-empty"><Icon name="ph:plug-fill" width="16" height="16" />{viewOnly ? dt('You can look at this page but not change it.') : dt('The AI is not configured on this Petto yet.')}</p>
          )}
        </div>
      </details>
    </div>
  </div>
</DashGuildLayout>

<script>
  // The parts of the page that are always there: counters, templates. Listeners on the document, set once, so they also work after the
  // dashboard swaps this page in again. The chats' code is loaded the first time a chat fold is opened.
  type Starter = { instructions: string; knowledge: string; handoff: string };
  const w = window as any;
  if (!w.__taiBound) {
    w.__taiBound = true;
    const data = () => { try { return JSON.parse(document.getElementById('tai-data')?.textContent || '{}'); } catch { return {}; } };
    const updateCount = (el: HTMLTextAreaElement) => {
      const out = document.querySelector<HTMLElement>(`[data-tai-counter="${el.id}"]`);
      if (!out) return;
      const locale = data().locale || 'en-US';
      out.textContent = `${el.value.length.toLocaleString(locale)} / ${el.maxLength.toLocaleString(locale)}`;
      out.classList.toggle('near', el.value.length > el.maxLength * 0.9);
    };
    // The instructions, the knowledge and the hand-over list share one limit: the number of characters of the three together.
    const updateTotal = () => {
      const out = document.querySelector<HTMLElement>('[data-tai-total]');
      const form = document.getElementById('tai-form') as HTMLFormElement | null;
      if (!out || !form) return;
      const sum = (['instructions', 'knowledge', 'handoff'] as const).reduce((n, name) => n + ((form.elements.namedItem(name) as HTMLTextAreaElement | null)?.value.length ?? 0), 0);
      const max = Number(out.dataset.max) || 0;
      const locale = data().locale || 'en-US';
      out.textContent = `${sum.toLocaleString(locale)} / ${max.toLocaleString(locale)}`;
      out.classList.toggle('near', max > 0 && sum > max * 0.9);
    };
    // The "On" or "Off" next to the title follows the switch.
    const syncPill = () => {
      const box = document.querySelector<HTMLInputElement>('#tai-form input[name="enabled"]');
      const pill = document.querySelector<HTMLElement>('[data-tai-pill]');
      if (!box || !pill) return;
      pill.classList.toggle('on', box.checked);
      pill.textContent = (box.checked ? pill.dataset.on : pill.dataset.off) || '';
    };
    document.addEventListener('input', (e) => {
      const el = e.target as HTMLElement;
      if (el instanceof HTMLTextAreaElement && el.hasAttribute('data-tai-count')) { updateCount(el); updateTotal(); }
    });
    document.addEventListener('change', (e) => {
      const el = e.target as HTMLElement;
      if (el instanceof HTMLInputElement && el.name === 'enabled') syncPill();
    });
    // "Discard" of the save bar puts the form back: the counters follow once it has.
    document.addEventListener('reset', (e) => {
      const form = e.target as HTMLElement;
      if (form.id !== 'tai-form') return;
      setTimeout(() => { form.querySelectorAll<HTMLTextAreaElement>('[data-tai-count]').forEach(updateCount); updateTotal(); syncPill(); }, 0);
    }, true);
    document.addEventListener('click', async (e) => {
      const button = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tai-starter]');
      if (!button) return;
      const d = data();
      const starter: Starter | undefined = d.starters?.[button.dataset.taiStarter || ''];
      const form = document.getElementById('tai-form') as HTMLFormElement | null;
      if (!starter || !form) return;
      const fields = ['instructions', 'knowledge', 'handoff'] as const;
      const filled = fields.some((name) => (form.elements.namedItem(name) as HTMLTextAreaElement | null)?.value.trim());
      if (filled && !(await (window as unknown as { dglConfirm?: (t: string, o?: object) => Promise<boolean> }).dglConfirm?.(d.words?.replace || 'Replace?', { tone: 'neutral', confirm: d.words?.replaceYes }))) return;
      for (const name of fields) {
        const field = form.elements.namedItem(name) as HTMLTextAreaElement | null;
        if (!field) continue;
        field.value = starter[name];
        field.dispatchEvent(new Event('input', { bubbles: true }));
      }
      (form.elements.namedItem('instructions') as HTMLTextAreaElement | null)?.focus({ preventScroll: true });
    });
    // `toggle` does not bubble: it is caught on the way down.
    document.addEventListener('toggle', (e) => {
      const fold = e.target as HTMLDetailsElement;
      if (!(fold instanceof HTMLDetailsElement) || !fold.open || !fold.matches('[data-tai-chat]')) return;
      const chat = fold.querySelector<HTMLElement>('.tai-chat');
      if (!chat || chat.dataset.taiMounted) return;
      import('./DashTicketAiChat').then((m) => m.mountTicketAiChat(chat)).catch(() => {});
    }, true);
  }
</script>

