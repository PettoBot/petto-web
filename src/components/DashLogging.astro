---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashTabs from './DashTabs.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface EventDef {
  id: string;
  label: string;
  desc: string;
  icon: string;
  color: string;
}

const EVENTS: EventDef[] = [
  { id: 'sanctions', label: dt('Sanctions'), desc: dt('Bans, kicks, mutes, warns, every case Petto logs'), icon: 'ph:gavel-fill', color: '#fe6465' },
  { id: 'automod', label: dt('Automod'), desc: dt('Messages blocked or flagged by the filter, and AutoMod rule changes'), icon: 'ph:shield-warning-fill', color: '#ff9f5a' },
  { id: 'verification', label: dt('Verification'), desc: dt('Members passing or failing verification'), icon: 'ph:seal-check-fill', color: '#a5ea7a' },
  { id: 'members', label: dt('Members'), desc: dt('Joins, leaves, kicks, timeouts and boosts as they happen'), icon: 'ph:door-open-fill', color: '#6ec6ff' },
  { id: 'messages', label: dt('Messages'), desc: dt('Edits, deletes and pinned messages'), icon: 'ph:chat-text-fill', color: '#8399ff' },
  { id: 'voice', label: dt('Voice'), desc: dt('Joining, leaving, and switching voice channels, and stages'), icon: 'ph:speaker-high-fill', color: '#c792ea' },
  { id: 'roles', label: dt('Roles'), desc: dt('Role created, deleted, or changed (with its permissions), and member role changes'), icon: 'ph:tag-fill', color: '#f78fb3' },
  { id: 'channels', label: dt('Channels'), desc: dt('Channel created, deleted, or changed, with its permissions'), icon: 'ph:hash-fill', color: '#5eead4' },
  { id: 'invites', label: dt('Invites'), desc: dt('Invite links created or deleted'), icon: 'ph:link-fill', color: '#7dd3fc' },
  { id: 'emojis', label: dt('Emojis'), desc: dt('Server emoji, sticker and soundboard changes'), icon: 'ph:smiley-fill', color: '#fed53c' },
  { id: 'webhooks', label: dt('Webhooks'), desc: dt('Webhooks created, changed, or deleted'), icon: 'ph:webhooks-logo-fill', color: '#ff7ab6' },
  { id: 'threads', label: dt('Threads'), desc: dt('Threads created, changed, or deleted'), icon: 'ph:chats-fill', color: '#9ad1ff' },
  { id: 'integrations', label: dt('Integrations'), desc: dt('Bots added or removed, and apps and integrations'), icon: 'ph:plugs-connected-fill', color: '#7ee0a8' },
  { id: 'commands', label: dt('Commands'), desc: dt('Which Petto command was used, by whom (only its name)'), icon: 'ph:terminal-window-fill', color: '#b4bcd0' },
  { id: 'tickets', label: dt('Tickets'), desc: dt('Tickets opened, claimed, and closed'), icon: 'ph:ticket', color: '#ffb86c' },
  { id: 'server', label: dt('Server'), desc: dt('Name, icon, vanity URL, security settings, and scheduled events'), icon: 'ph:gear-fill', color: '#94a3b8' },
];

const GROUPS: { id: string; label: string; icon: string; events: string[] }[] = [
  { id: 'people', label: dt('Members and moderation'), icon: 'ph:shield-check-fill', events: ['sanctions', 'automod', 'verification', 'members', 'messages'] },
  { id: 'server', label: dt('Server changes'), icon: 'ph:gear-fill', events: ['roles', 'channels', 'invites', 'emojis', 'webhooks', 'threads', 'integrations', 'server'] },
  { id: 'activity', label: dt('Activity'), icon: 'ph:speaker-high-fill', events: ['voice', 'commands', 'tickets'] },
];

interface IgnoredId { targetId: string; channelName: string | null; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  channels: { id: string; name: string }[];
  routing: Record<string, string>;
  ignoredIds: IgnoredId[];
  saved: boolean;
  problems?: string[];
}
const { user, guildId, guildName, guildIcon, channels, routing, ignoredIds, saved, problems = [] } = Astro.props;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="logging" pageTitle="Logging">
  <h1>{dt('Logging')}</h1>
  <p class="dl-sub"><Fragment set:html={dth('Send each kind of event to its own channel in <b>{a}</b>, or leave it off. Petto creates the webhook for you the moment you pick a channel.', { a: (guildName) })} /></p>

  {saved && (
    <div class="dl-success">
      <Icon name="ph:check-circle-fill" width="15" height="15" />
      {dt('Saved, routing is live.')}
    </div>
  )}

  {problems.map((problem) => <div class="dl-problem"><Icon name="ph:warning-fill" width="15" height="15" />{problem}</div>)}

  <div class="dl-bulk">
    <label for="dlAll">{dt('Send everything to one channel')}</label>
    <select id="dlAll" data-dl-all>
      <option value="">{dt('Pick a channel')}</option>
      {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
    </select>
    <button type="button" class="btn btn-ghost btn-sm" data-dl-all-apply>{dt('Use it for every event')}</button>
    <span class="dl-bulk-note" data-dl-note hidden><Icon name="ph:check-circle-fill" width="13" height="13" />{dt('Set on every event. Press Save changes to keep it.')}</span>
  </div>

  <div data-tabs="logging">
    <div class="dgl-tabs" role="tablist" aria-label={dt('Logging')}>
      {GROUPS.map((g) => (
        <button type="button" class="dgl-tab" role="tab" data-tab={g.id}><Icon name={g.icon} width="15" height="15" /><span>{g.label}</span><em>{g.events.filter((id) => routing[id]).length}/{g.events.length}</em><i class="dgl-tab-dot"></i></button>
      ))}
      <button type="button" class="dgl-tab" role="tab" data-tab="ignored"><Icon name="ph:eye-slash-fill" width="15" height="15" /><span>{dt('Ignored')}</span><em>{ignoredIds.length}</em></button>
    </div>
    <div class="dl-grid">
      <form method="POST" class="dl-routing-form">
        {GROUPS.map((g) => (
          <div class="dl-panel" data-panel={g.id} hidden>
            {EVENTS.filter((ev) => g.events.includes(ev.id)).map((ev) => {
              const active = Boolean(routing[ev.id]);
              return (
                <div class="dl-card" style={`--row-c:${ev.color}`}>
                  <div class="dl-card-top">
                    <div class="dl-card-icon"><Icon name={ev.icon} width="17" height="17" /></div>
                    <div class="dl-card-text">
                      <div class="dl-card-label">{ev.label}</div>
                      <div class="dl-card-desc">{ev.desc}</div>
                    </div>
                    <span class:list={['dl-dot', { on: active }]} title={active ? dt('Routed') : dt('Off')} />
                  </div>
                  <select name={`event_${ev.id}`}>
                    <option value="">{dt('Off, don\'t log this')}</option>
                    {channels.map((c) => (
                      <option value={c.id} selected={c.id === routing[ev.id]}>#{c.name}</option>
                    ))}
                  </select>
                </div>
              );
            })}
          </div>
        ))}
        <button type="submit" class="btn btn-accent dl-save-btn">{dt('Save changes')}</button>
      </form>
    <div class="dl-ignore-panel" data-panel="ignored" hidden>
  <div class="dl-card dl-card-wide dl-ignored-card">
    <div class="dl-card-top">
      <div class="dl-card-icon" style="--row-c:#f78fb3"><Icon name="ph:eye-slash-fill" width="17" height="17" /></div>
      <div class="dl-card-text">
        <div class="dl-card-label"><Fragment set:html={dth('Ignored <span class="dl-count">{a}</span>', { a: (ignoredIds.length) })} /></div>
        <div class="dl-card-desc">{dt('These users or channels are skipped entirely, across every event below.')}</div>
      </div>
    </div>
    {ignoredIds.length > 0 && (
      <div class="dl-list-grid">
        {ignoredIds.map((i) => (
          <form method="POST" class="dl-list-row" data-no-dirty>
            <input type="hidden" name="action" value="delete_ignored" />
            <input type="hidden" name="target_id" value={i.targetId} />
            <span class="dl-list-name">{i.channelName ? `#${i.channelName}` : i.targetId}</span>
            <button type="submit" class="dl-list-del"><Icon name="ph:trash-fill" width="13" height="13" /></button>
          </form>
        ))}
      </div>
    )}
    <form method="POST" class="dl-add-row" data-no-dirty>
      <input type="hidden" name="action" value="add_ignored" />
      <input type="text" name="target_id" placeholder={dt('User or channel IDs or mentions')} maxlength="600" required />
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button>
    </form>
  </div>

    </div>
    </div>
  </div>
  <DashTabs />
</DashGuildLayout>

<script is:inline>
  if (!window.__dlAllBound) {
    window.__dlAllBound = true;
    // Picking a channel in the "everything" box fills every event right away (and raises the unsaved changes bar); the button does the same again.
    var applyAll = function () {
      var picker = document.querySelector('[data-dl-all]');
      if (!picker || !picker.value) return;
      document.querySelectorAll('.dl-routing-form select[name^="event_"]').forEach(function (select) {
        select.value = picker.value;
        select.dispatchEvent(new Event('change', { bubbles: true }));
        select.dispatchEvent(new Event('input', { bubbles: true }));
      });
      var note = document.querySelector('[data-dl-note]');
      if (note) note.hidden = false;
    };
    document.addEventListener('change', function (event) {
      if (event.target && event.target.matches && event.target.matches('[data-dl-all]')) applyAll();
    });
    document.addEventListener('click', function (event) {
      var button = event.target && event.target.closest ? event.target.closest('[data-dl-all-apply]') : null;
      if (button) applyAll();
    });
  }
</script>

<style>
  .dl-problem { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--red); background: var(--red-soft); border: 1px solid color-mix(in srgb, var(--red) 55%, transparent); border-radius: 9px; padding: 10px 14px; margin-bottom: 12px; max-width: fit-content; }
  .dl-bulk { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 0 0 16px; }
  .dl-bulk-note { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--green); }
  .dl-bulk label { font-size: 12px; font-weight: 600; color: var(--text-dim); }
  .dl-bulk select { border: 1px solid var(--border); border-radius: 8px; padding: 6px 9px; background: var(--bg-raise); color: var(--text); font: 12.5px var(--sans); }
  h1 { font-size: 24px; margin: 0 0 6px; }
  .dl-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 24px; max-width: 62ch; }
  .dl-sub b { color: var(--text); }

  .dl-success { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 22px; max-width: fit-content; }

  .dl-grid { display: grid; grid-template-columns: 1fr; gap: 12px; margin-bottom: 40px; }
  .dl-panel { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); gap: 12px; }
  .dl-ignore-panel { max-width: 820px; }
  .dl-routing-form { display: contents; }
  .dl-save-btn { grid-column: 1 / -1; justify-self: start; }

  .dl-card { border: 1px solid var(--border); border-radius: 13px; padding: 14px 16px; background: var(--card); display: flex; flex-direction: column; gap: 12px; }
  .dl-card-wide { grid-column: 1 / -1; }
  .dl-ignored-card { margin-bottom: 8px; }
  .dl-card-top { display: flex; align-items: flex-start; gap: 11px; }
  .dl-card-icon { width: 32px; height: 32px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: color-mix(in srgb, var(--row-c) 16%, transparent); color: var(--row-c); }
  .dl-card-text { min-width: 0; flex: 1; }
  .dl-card-label { font-size: 13.5px; font-weight: 600; color: var(--text); }
  .dl-card-desc { font-size: 12px; color: var(--text-dim); margin-top: 2px; line-height: 1.4; }
  .dl-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--border); flex-shrink: 0; margin-top: 5px; }
  .dl-dot.on { background: var(--green); box-shadow: 0 0 0 3px var(--green-soft); }

  .dl-card select { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--bg-raise); color: var(--text); font-family: var(--sans); font-size: 13px; width: 100%; }
  .dl-card select:focus { outline: 2px solid var(--accent-soft); border-color: var(--accent); }

  @media (max-width: 780px) {
    .dl-grid { grid-template-columns: 1fr; }
  }

  .dl-count { font-family: var(--mono); font-size: 11px; color: var(--text-dim); font-weight: 400; }

  .dl-list-grid { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .dl-list-row { display: flex; align-items: center; gap: 8px; border: 1px solid var(--border); border-radius: 9px; padding: 7px 8px 7px 12px; background: var(--card); }
  .dl-list-name { font-family: var(--mono); font-size: 12px; color: var(--text); }
  .dl-list-del { border: none; background: transparent; color: var(--text-dim); cursor: pointer; padding: 3px; border-radius: 6px; }
  .dl-list-del:hover { color: var(--red); background: var(--red-soft); }

  .dl-add-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 4px; }
  .dl-add-row input { flex: 1 1 160px; min-width: 0; border: 1px solid var(--border); border-radius: 8px; padding: 7px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 12.5px; max-width: 200px; }
  .dl-add-row .btn { display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0; }
</style>