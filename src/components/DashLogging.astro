---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashTabs from './DashTabs.astro';
import MultiSelect from './MultiSelect.astro';
import MultiSelectOptions from './MultiSelectOptions.astro';
import SelectSource from './SelectSource.astro';
import SelectChosen from './SelectChosen.astro';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface EventDef {
  id: string;
  label: string;
  desc: string;
  icon: string;
  color: string;
}

const EVENTS: EventDef[] = [
  { id: 'sanctions', label: dt('Sanctions'), desc: dt('Bans, kicks, mutes, warns, every case Petto logs, and cases or notes the staff changes'), icon: 'ph:gavel-fill', color: '#fe6465' },
  { id: 'automod', label: dt('Automod'), desc: dt('Messages blocked or flagged by the filter, and AutoMod rule changes'), icon: 'ph:shield-warning-fill', color: '#ff9f5a' },
  { id: 'verification', label: dt('Verification'), desc: dt('Members passing or failing verification'), icon: 'ph:seal-check-fill', color: '#a5ea7a' },
  { id: 'members', label: dt('Members'), desc: dt('Joins, leaves, kicks, timeouts and boosts as they happen'), icon: 'ph:door-open-fill', color: '#6ec6ff' },
  { id: 'messages', label: dt('Messages'), desc: dt('Edits, deletes, pinned or published messages, and poll votes'), icon: 'ph:chat-text-fill', color: '#8399ff' },
  { id: 'voice', label: dt('Voice'), desc: dt('Joining, leaving, and switching voice channels, and stages'), icon: 'ph:speaker-high-fill', color: '#c792ea' },
  { id: 'roles', label: dt('Roles'), desc: dt('Role created, deleted, or changed (with its permissions), and member role changes'), icon: 'ph:tag-fill', color: '#f78fb3' },
  { id: 'channels', label: dt('Channels'), desc: dt('Channel created, deleted, or changed (permissions, voice settings, forum tags)'), icon: 'ph:hash-fill', color: '#5eead4' },
  { id: 'invites', label: dt('Invites'), desc: dt('Invite links created, deleted or posted in a message'), icon: 'ph:link-fill', color: '#7dd3fc' },
  { id: 'emojis', label: dt('Emojis'), desc: dt('Server emoji (and the roles that can use them), sticker and soundboard changes'), icon: 'ph:smiley-fill', color: '#fed53c' },
  { id: 'webhooks', label: dt('Webhooks'), desc: dt('Webhooks created, changed, or deleted'), icon: 'ph:webhooks-logo-fill', color: '#ff7ab6' },
  { id: 'threads', label: dt('Threads'), desc: dt('Threads created, changed, or deleted'), icon: 'ph:chats-fill', color: '#9ad1ff' },
  { id: 'integrations', label: dt('Integrations'), desc: dt('Bots added or removed, apps, and the permissions of their commands'), icon: 'ph:plugs-connected-fill', color: '#7ee0a8' },
  { id: 'commands', label: dt('Commands'), desc: dt('Which Petto command was used, by whom (only its name)'), icon: 'ph:terminal-window-fill', color: '#b4bcd0' },
  { id: 'tickets', label: dt('Tickets'), desc: dt('Tickets opened, claimed, and closed'), icon: 'ph:ticket', color: '#ffb86c' },
  { id: 'forms', label: dt('Forms'), desc: dt('Forms sent by members, and who accepted or denied them'), icon: 'ph:clipboard-text-fill', color: '#8399ff' },
  { id: 'server', label: dt('Server'), desc: dt('Name, icon, vanity URL, security settings, onboarding, and scheduled events'), icon: 'ph:gear-fill', color: '#94a3b8' },
];

const GROUPS: { id: string; label: string; icon: string; events: string[] }[] = [
  { id: 'people', label: dt('Members and moderation'), icon: 'ph:shield-check-fill', events: ['sanctions', 'automod', 'verification', 'members', 'messages'] },
  { id: 'server', label: dt('Server changes'), icon: 'ph:gear-fill', events: ['roles', 'channels', 'invites', 'emojis', 'webhooks', 'threads', 'integrations', 'server'] },
  { id: 'activity', label: dt('Activity'), icon: 'ph:speaker-high-fill', events: ['voice', 'commands', 'tickets', 'forms'] },
];

interface IgnoredId { targetId: string; kind: 'channel' | 'role' | 'user'; label: string; }

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  channels: { id: string; name: string; category?: string }[];
  roles: { id: string; name: string }[];
  routing: Record<string, string>;
  ignoredIds: IgnoredId[];
  saved: boolean;
  problems?: string[];
}
const { user, guildId, guildName, guildIcon, channels, roles, routing, ignoredIds, saved, problems = [] } = Astro.props;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="logging" pageTitle="Logging">
  <h1>{dt('Logging')}</h1>
  <p class="dl-sub"><Fragment set:html={dth('Send each kind of event to its own channel in <b>{a}</b>, or leave it off. Petto creates the webhook for you the moment you pick a channel.', { a: (guildName) })} /></p>

  {saved && (
    <div class="dl-success">
      <Icon name="ph:check-circle-fill" width="15" height="15" />
      {dt('Saved, routing is live.')}
    </div>
  )}

  {problems.map((problem) => <div class="dl-problem"><Icon name="ph:warning-fill" width="15" height="15" />{problem}</div>)}

  <div class="dl-bulk">
    <label for="dlAll">{dt('Send everything to one channel')}</label>
    <select id="dlAll" data-dl-all data-fill="dl-ch">
      <option value="">{dt('Pick a channel')}</option>
      <option value="__new__">{dt('Create a new channel')}</option>
    </select>
    <button type="button" class="btn btn-ghost btn-sm" data-dl-all-apply>{dt('Use it for every event')}</button>
    <button type="button" class="btn btn-ghost btn-sm" data-dl-all-clear>{dt('Turn every event off')}</button>
    <span class="dl-bulk-note" data-dl-note hidden><Icon name="ph:check-circle-fill" width="13" height="13" />{dt('Set on every event. Press Save changes to keep it.')}</span>
  </div>

  <p class="dl-hint">{dt('"Create a new channel" makes a private channel called #petto-logs that only the staff can see, when you save.')}</p>

  <div data-tabs="logging">
    <div class="dgl-tabs" role="tablist" aria-label={dt('Logging')}>
      {GROUPS.map((g) => (
        <button type="button" class="dgl-tab" role="tab" data-tab={g.id}><Icon name={g.icon} width="15" height="15" /><span>{g.label}</span><em>{g.events.filter((id) => routing[id]).length}/{g.events.length}</em><i class="dgl-tab-dot"></i></button>
      ))}
      <button type="button" class="dgl-tab" role="tab" data-tab="ignored"><Icon name="ph:eye-slash-fill" width="15" height="15" /><span>{dt('Ignored')}</span><em>{ignoredIds.length}</em></button>
    </div>
    <div class="dl-grid">
      <form method="POST" class="dl-routing-form">
        {GROUPS.map((g) => (
          <div class="dl-panel" data-panel={g.id} hidden>
            <div class="dl-group-bar">
              <label>{dt('Send this whole group to')}</label>
              <select data-dl-group data-fill="dl-ch">
                <option value="">{dt('Pick a channel')}</option>
                <option value="__new__">{dt('Create a new channel')}</option>
              </select>
              <button type="button" class="btn btn-ghost btn-sm" data-dl-group-clear>{dt('Turn this group off')}</button>
            </div>
            {EVENTS.filter((ev) => g.events.includes(ev.id)).map((ev) => {
              const active = Boolean(routing[ev.id]);
              return (
                <div class="dl-card" style={`--row-c:${ev.color}`}>
                  <div class="dl-card-top">
                    <div class="dl-card-icon"><Icon name={ev.icon} width="17" height="17" /></div>
                    <div class="dl-card-text">
                      <div class="dl-card-label">{ev.label}</div>
                      <div class="dl-card-desc">{ev.desc}</div>
                    </div>
                    <span class:list={['dl-dot', { on: active }]} title={active ? dt('Routed') : dt('Off')} />
                  </div>
                  <select name={`event_${ev.id}`} data-fill="dl-ch">
                    <option value="">{dt('Off, don\'t log this')}</option>
                    <option value="__new__">{dt('Create a new channel')}</option>
                    <SelectChosen items={channels} selected={routing[ev.id]} prefix="#" />
                  </select>
                </div>
              );
            })}
          </div>
        ))}
        <button type="submit" class="btn btn-accent dl-save-btn">{dt('Save changes')}</button>
      </form>
    <div class="dl-ignore-panel" data-panel="ignored" hidden>
  <div class="dl-card dl-card-wide dl-ignored-card">
    <div class="dl-card-top">
      <div class="dl-card-icon" style="--row-c:#f78fb3"><Icon name="ph:eye-slash-fill" width="17" height="17" /></div>
      <div class="dl-card-text">
        <div class="dl-card-label"><Fragment set:html={dth('Ignored <span class="dl-count">{a}</span>', { a: (ignoredIds.length) })} /></div>
        <div class="dl-card-desc">{dt('These channels, roles or people are skipped entirely, across every event.')}</div>
      </div>
    </div>
    {ignoredIds.length > 0 && (
      <div class="dl-list-grid">
        {ignoredIds.map((i) => (
          <form method="POST" class="dl-list-row" data-no-dirty>
            <input type="hidden" name="action" value="delete_ignored" />
            <input type="hidden" name="target_id" value={i.targetId} />
            <span class="dl-list-name">{i.label}</span>
            <button type="submit" class="dl-list-del"><Icon name="ph:trash-fill" width="13" height="13" /></button>
          </form>
        ))}
      </div>
    )}
    <form method="POST" class="dl-add-form" data-no-dirty data-ignore-add data-search-url={`/dash/guild/${guildId}/members-search`}>
      <input type="hidden" name="action" value="add_ignored" />
      <div class="dl-add-field">
        <span class="dl-add-label">{dt('Channels')}</span>
        <MultiSelect name="channel_id" options={[]} source="dl-ms-channels" selected={[]} placeholder={dt('Pick channels')} />
      </div>
      <div class="dl-add-field">
        <span class="dl-add-label">{dt('Roles')}</span>
        <MultiSelect name="role_id" options={[]} source="dl-ms-roles" selected={[]} placeholder={dt('Pick roles')} />
      </div>
      <div class="dl-add-field">
        <span class="dl-add-label">{dt('People')}</span>
        <div class="dl-people" data-people>
          <div class="dl-people-chips" data-people-chips></div>
          <input type="text" class="dl-people-input" data-people-input placeholder={dt('Type a name to search')} autocomplete="off" maxlength="32" />
          <div class="dl-people-results" data-people-results hidden></div>
        </div>
      </div>
      <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button>
    </form>
  </div>

    </div>
    </div>
  </div>
  <MultiSelectOptions name="dl-ms-channels" options={channels.map((c) => ({ id: c.id, name: `#${c.name}` }))} />
  <MultiSelectOptions name="dl-ms-roles" options={roles} />
  <SelectSource name="dl-ch" items={channels} prefix="#" />
  <DashTabs />
</DashGuildLayout>

<script is:inline>
  if (!window.__dlPeopleBound) {
    window.__dlPeopleBound = true;
    var dlTimer = 0;
    var dlSeq = 0;
    var dlText = function (node, text) { node.textContent = text; return node; };
    document.addEventListener('input', function (event) {
      var input = event.target && event.target.closest ? event.target.closest('[data-people-input]') : null;
      if (!input) return;
      var wrap = input.closest('[data-people]');
      var results = wrap.querySelector('[data-people-results]');
      var form = input.closest('[data-ignore-add]');
      clearTimeout(dlTimer);
      var query = input.value.trim();
      if (query.length < 2) { results.hidden = true; results.innerHTML = ''; return; }
      dlTimer = setTimeout(function () {
        var mine = ++dlSeq;
        fetch(form.getAttribute('data-search-url') + '?q=' + encodeURIComponent(query), { credentials: 'same-origin', headers: { Accept: 'application/json' } })
          .then(function (res) { return res.ok ? res.json() : { members: [] }; })
          .then(function (data) {
            if (mine !== dlSeq) return;
            results.innerHTML = '';
            var members = data.members || [];
            if (!members.length) results.appendChild(dlText(Object.assign(document.createElement('div'), { className: 'dl-people-note' }), cdt('Nobody found')));
            members.forEach(function (member) {
              var row = document.createElement('button');
              row.type = 'button';
              row.className = 'dl-person';
              row.setAttribute('data-id', member.id);
              if (member.avatar) { var img = document.createElement('img'); img.src = member.avatar; img.alt = ''; row.appendChild(img); }
              row.appendChild(dlText(document.createElement('span'), member.displayName || member.username || member.id));
              results.appendChild(row);
            });
            results.hidden = false;
          })
          .catch(function () { results.hidden = true; });
      }, 300);
    });
    document.addEventListener('click', function (event) {
      var target = event.target && event.target.closest ? event.target : null;
      if (!target) return;
      var pick = target.closest('.dl-person');
      if (pick) {
        var wrap = pick.closest('[data-people]');
        var id = pick.getAttribute('data-id');
        var chips = wrap.querySelector('[data-people-chips]');
        if (!chips.querySelector('[data-id="' + id + '"]')) {
          var chip = document.createElement('span');
          chip.className = 'dl-person-chip';
          chip.setAttribute('data-id', id);
          var hidden = document.createElement('input');
          hidden.type = 'hidden'; hidden.name = 'user_id'; hidden.value = id;
          var remove = document.createElement('button');
          remove.type = 'button'; remove.setAttribute('data-person-remove', ''); remove.textContent = '\u00d7';
          chip.appendChild(dlText(document.createElement('span'), pick.textContent));
          chip.appendChild(hidden);
          chip.appendChild(remove);
          chips.appendChild(chip);
        }
        var box = wrap.querySelector('[data-people-input]');
        box.value = '';
        wrap.querySelector('[data-people-results]').hidden = true;
        return;
      }
      var gone = target.closest('[data-person-remove]');
      if (gone) gone.closest('.dl-person-chip').remove();
    });
  }
</script>
<script is:inline>
  if (!window.__dlAllBound) {
    window.__dlAllBound = true;
    // Picking a channel in the "everything" box fills every event right away (and raises the unsaved changes bar); the button does the same again.
    var applyAll = function () {
      var picker = document.querySelector('[data-dl-all]');
      if (!picker || !picker.value) return;
      document.querySelectorAll('.dl-routing-form select[name^="event_"]').forEach(function (select) {
        select.value = picker.value;
        select.dispatchEvent(new Event('change', { bubbles: true }));
        select.dispatchEvent(new Event('input', { bubbles: true }));
      });
      var note = document.querySelector('[data-dl-note]');
      if (note) note.hidden = false;
    };
    // The same for the events of one group (a tab), and the buttons that turn events off.
    var setSelects = function (selects, value) {
      selects.forEach(function (select) {
        select.value = value;
        select.dispatchEvent(new Event('change', { bubbles: true }));
        select.dispatchEvent(new Event('input', { bubbles: true }));
      });
    };
    document.addEventListener('change', function (event) {
      var target = event.target;
      if (!target || !target.matches) return;
      if (target.matches('[data-dl-all]')) applyAll();
      if (target.matches('[data-dl-group]') && target.value) {
        var panel = target.closest('.dl-panel');
        if (panel) setSelects(Array.prototype.slice.call(panel.querySelectorAll('select[name^="event_"]')), target.value);
      }
    });
    document.addEventListener('click', function (event) {
      var closest = function (selector) { return event.target && event.target.closest ? event.target.closest(selector) : null; };
      if (closest('[data-dl-all-apply]')) applyAll();
      if (closest('[data-dl-all-clear]')) setSelects(Array.prototype.slice.call(document.querySelectorAll('.dl-routing-form select[name^="event_"]')), '');
      var groupClear = closest('[data-dl-group-clear]');
      if (groupClear) {
        var panel = groupClear.closest('.dl-panel');
        if (panel) setSelects(Array.prototype.slice.call(panel.querySelectorAll('select[name^="event_"]')), '');
      }
    });
  }
</script>

<style>
  /* On the Ignored tab the routing form is not in play, so its Save button and the "everything to one channel" bar step aside. */
  :global(#dgl-content:has(.dgl-tab[data-tab="ignored"].on)) .dl-save-btn,
  :global(#dgl-content:has(.dgl-tab[data-tab="ignored"].on)) .dl-bulk { display: none; }
  .dl-problem { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--red); background: var(--red-soft); border: 1px solid color-mix(in srgb, var(--red) 55%, transparent); border-radius: 9px; padding: 10px 14px; margin-bottom: 12px; max-width: fit-content; }
  .dl-bulk { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 0 0 16px; }
  .dl-hint { margin: -6px 0 16px; font-size: 12.5px; color: var(--text-dim); }
  .dl-group-bar { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 10px 12px; border: 1px dashed var(--border); border-radius: 11px; }
  .dl-group-bar label { font-size: 12px; font-weight: 600; color: var(--text-dim); }
  .dl-group-bar select { border: 1px solid var(--border); border-radius: 8px; padding: 6px 9px; background: var(--bg-raise); color: var(--text); font: 12.5px var(--sans); max-width: 100%; }
  .dl-bulk-note { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--green); }
  .dl-bulk label { font-size: 12px; font-weight: 600; color: var(--text-dim); }
  .dl-bulk select { border: 1px solid var(--border); border-radius: 8px; padding: 6px 9px; background: var(--bg-raise); color: var(--text); font: 12.5px var(--sans); }
  h1 { font-size: 24px; margin: 0 0 6px; }
  .dl-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 24px; max-width: 62ch; }
  .dl-sub b { color: var(--text); }

  .dl-success { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 22px; max-width: fit-content; }

  .dl-grid { display: grid; grid-template-columns: 1fr; gap: 12px; margin-bottom: 40px; }
  .dl-panel { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); gap: 12px; }
  .dl-ignore-panel { max-width: 820px; }
  .dl-routing-form { display: contents; }
  .dl-save-btn { grid-column: 1 / -1; justify-self: start; }

  .dl-card { border: 1px solid var(--border); border-radius: 13px; padding: 14px 16px; background: var(--card); display: flex; flex-direction: column; gap: 12px; }
  .dl-card-wide { grid-column: 1 / -1; }
  .dl-ignored-card { margin-bottom: 8px; }
  .dl-card-top { display: flex; align-items: flex-start; gap: 11px; }
  .dl-card-icon { width: 32px; height: 32px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: color-mix(in srgb, var(--row-c) 16%, transparent); color: var(--row-c); }
  .dl-card-text { min-width: 0; flex: 1; }
  .dl-card-label { font-size: 13.5px; font-weight: 600; color: var(--text); }
  .dl-card-desc { font-size: 12px; color: var(--text-dim); margin-top: 2px; line-height: 1.4; }
  .dl-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--border); flex-shrink: 0; margin-top: 5px; }
  .dl-dot.on { background: var(--green); box-shadow: 0 0 0 3px var(--green-soft); }

  .dl-card select { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--bg-raise); color: var(--text); font-family: var(--sans); font-size: 13px; width: 100%; }
  .dl-card select:focus { outline: 2px solid var(--accent-soft); border-color: var(--accent); }

  @media (max-width: 780px) {
    .dl-grid { grid-template-columns: 1fr; }
  }

  .dl-count { font-family: var(--mono); font-size: 11px; color: var(--text-dim); font-weight: 400; }

  .dl-list-grid { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .dl-list-row { display: flex; align-items: center; gap: 8px; border: 1px solid var(--border); border-radius: 9px; padding: 7px 8px 7px 12px; background: var(--card); }
  .dl-list-name { font-family: var(--mono); font-size: 12px; color: var(--text); }
  .dl-list-del { border: none; background: transparent; color: var(--text-dim); cursor: pointer; padding: 3px; border-radius: 6px; }
  .dl-list-del:hover { color: var(--red); background: var(--red-soft); }

  .dl-add-form { display: grid; gap: 12px; margin-top: 8px; }
  .dl-add-field { display: grid; gap: 6px; min-width: 0; }
  .dl-add-label { font-size: .78rem; opacity: .7; }
  .dl-add-form .btn { justify-self: start; display: inline-flex; align-items: center; gap: 6px; }
  .dl-people { position: relative; display: grid; gap: 6px; }
  .dl-people-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .dl-people-chips:empty { display: none; }
  .dl-people-input { min-width: 0; border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 12.5px; }
  .dl-people-results { display: grid; gap: 2px; padding: 4px; border: 1px solid var(--border); border-radius: 10px; background: var(--card); max-height: 220px; overflow-y: auto; }
  .dl-people-results[hidden] { display: none; }
  :global(.dl-person) { display: inline-flex; align-items: center; gap: 8px; padding: 6px 8px; border: 0; border-radius: 8px; background: transparent; color: var(--text); font: inherit; font-size: .85rem; text-align: left; cursor: pointer; }
  :global(.dl-person:hover) { background: var(--card-hover, rgba(255, 255, 255, .07)); }
  :global(.dl-person img) { width: 22px; height: 22px; border-radius: 50%; }
  :global(.dl-person-chip) { display: inline-flex; align-items: center; gap: 6px; padding: 4px 6px 4px 8px; border-radius: 999px; border: 1px solid var(--border); font-size: .8rem; }
  :global(.dl-person-chip button) { border: 0; background: transparent; color: inherit; cursor: pointer; font-size: 1rem; line-height: 1; padding: 0 2px; }
  :global(.dl-people-note) { padding: 6px 8px; font-size: .8rem; opacity: .65; }
  .dl-add-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 4px; }
  .dl-add-row input { flex: 1 1 160px; min-width: 0; border: 1px solid var(--border); border-radius: 8px; padding: 7px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 12.5px; max-width: 200px; }
  .dl-add-row .btn { display: inline-flex; align-items: center; gap: 6px; flex-shrink: 0; }
</style>