---
// The fields that say where and for whom a custom command works (the same ones for a new command and for each command of the list): the channels and roles it is allowed in
// or blocked from, the NSFW switch, and the restricted switch with the channel the answer goes to. The page that holds the form reads them with utils/commandScope.ts.
import MultiSelect from './MultiSelect.astro';
import { getDashLang, makeT } from '../i18n/dash';
import type { CommandScope } from '../utils/commandScope';
interface Option { id: string; name: string }
interface Props { scope?: CommandScope; channelOptions: Option[]; roleOptions: Option[]; idPrefix: string }
const { scope, channelOptions, roleOptions, idPrefix } = Astro.props;
const dt = makeT(getDashLang(Astro));
const value = scope ?? { allowChannels: [], blockChannels: [], allowRoles: [], blockRoles: [], nsfw: false, restricted: false, restrictedChannel: null };
---
<div class="csf">
  <div class="sx-grid">
    <div class="sx-field"><span class="sx-label">{dt('Allowed channels')}</span><MultiSelect name="scope_allow_channels" options={channelOptions} source="am-channels" selected={value.allowChannels} placeholder={dt('All channels')} /></div>
    <div class="sx-field"><span class="sx-label">{dt('Blocked channels')}</span><MultiSelect name="scope_block_channels" options={channelOptions} source="am-channels" selected={value.blockChannels} placeholder={dt('No channel')} /></div>
    <div class="sx-field"><span class="sx-label">{dt('Allowed roles')}</span><MultiSelect name="scope_allow_roles" options={roleOptions} source="am-roles" selected={value.allowRoles} placeholder={dt('Everyone')} /></div>
    <div class="sx-field"><span class="sx-label">{dt('Blocked roles')}</span><MultiSelect name="scope_block_roles" options={roleOptions} source="am-roles" selected={value.blockRoles} placeholder={dt('No role')} /></div>
  </div>
  <div class="sx-switches">
    <label class="sx-switch"><input type="checkbox" name="scope_nsfw" checked={value.nsfw} /><span class="sx-switch-text"><b>NSFW</b><em>{dt('It only works in channels marked as NSFW.')}</em></span><span class="sx-toggle"></span></label>
    <label class="sx-switch"><input type="checkbox" name="scope_restricted" checked={value.restricted} /><span class="sx-switch-text"><b>{dt('Restricted')}</b><em>{dt('When somebody who is not a moderator uses it, the answer goes to the channel you choose.')}</em></span><span class="sx-toggle"></span></label>
  </div>
  <div class="sx-field csf-answer">
    <label for={`${idPrefix}-answer`}>{dt('Answer channel for restricted use')}</label>
    <select id={`${idPrefix}-answer`} name="scope_restricted_channel">
      <option value="">{dt('Choose a channel')}</option>
      {channelOptions.map((c) => <option value={c.id} selected={value.restrictedChannel === c.id}>{c.name}</option>)}
    </select>
  </div>
</div>
<style>
  .csf { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .csf-answer { max-width: 420px; }
</style>
