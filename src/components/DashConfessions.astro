---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashAcData from './DashAcData.astro';
import ColorPicker from './ColorPicker.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import { getDashLang, makeT } from '../i18n/dash';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  config: {
    enabled: boolean; channelId: string; reviewChannelId: string; logChannelId: string; requireReview: boolean; allowCommand: boolean; allowImages: boolean; allowReplies: boolean; keepAuthor: boolean; useWebhook: boolean;
    webhookName: string; webhookAvatar: string; title: string; footer: string; color: string; buttonLabel: string; replyLabel: string; panelText: string; cooldownSeconds: number;
    staffRoleId: string; embedTemplate: string; panelChannelId: string;
  };
  channels: { id: string; name: string }[];
  roles: { id: string; name: string }[];
  templates: string[];
  counts: { posted: number; pending: number; rejected: number };
  ready: boolean;
  saved: boolean;
  failed: string;
}
const { user, guildId, guildName, guildIcon, config, channels, roles, templates, counts, ready, saved, failed } = Astro.props;
const errors: Record<string, string> = { channel: dt('Choose a channel from the list.'), role: dt('Choose a role from the list.'), avatar: dt('The picture has to be a link that starts with https.'), save: dt('It could not be saved. Try again in a moment.') };
const switches = [
  { name: 'require_review', on: config.requireReview, label: dt('The staff checks each confession first'), hint: dt('It waits in the review channel until someone approves it.') },
  { name: 'use_webhook', on: config.useWebhook, label: dt('Send it with its own name and picture'), hint: dt('A webhook, so nothing shows the bot.') },
  { name: 'allow_replies', on: config.allowReplies, label: dt('Anonymous replies'), hint: dt('A button under each confession opens a thread.') },
  { name: 'allow_images', on: config.allowImages, label: dt('Confessions can have a picture'), hint: '' },
  { name: 'allow_command', on: config.allowCommand, label: dt('The confess command works'), hint: dt('If it is off, only the panel button works.') },
  { name: 'keep_author', on: config.keepAuthor, label: dt('Keep who confessed, only for the staff'), hint: dt('Lets the staff see who it was or block them. Off keeps nothing.') },
];
const sample = config.title.replace('{confession.number}', '12').replace('{confession.id}', 'si2tr-foytm');
const foot = config.footer.replace('{confession.id}', 'si2tr-foytm').replace('{confession.number}', '12');
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="confessions" pageTitle={dt('Confessions')}>
  <DashFormKit />
  <h1>{dt('Confessions')}</h1>
  <DashAcData roles={roles} channels={channels} vars={[{ tok: '{confession.number}', desc: dt('Number of the confession') }, { tok: '{confession.id}', desc: dt('ID of the confession') }]} />
  {saved && <div class="dfx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {failed && <div class="dfx-flash dfx-warn"><Icon name="ph:warning-fill" width="15" height="15" />{errors[failed] ?? errors.save}</div>}
  {!ready && <div class="dfx-flash dfx-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}

  <div class="cf-page">
    <DashStatTiles tiles={[
      { label: dt('Posted'), value: counts.posted, tone: 'joins' },
      { label: dt('Waiting for the staff'), value: counts.pending, tone: 'reactions' },
      { label: dt('Rejected'), value: counts.rejected, tone: 'leaves' },
    ]} />

    <form method="POST" class="dfx-form">
      <label class="dfx-master"><span><b>{dt('Confessions are on')}</b><em>{dt('Members confess in secret and Petto posts it without their name.')}</em></span><input type="checkbox" class="dfx-t" name="enabled" checked={config.enabled} /></label>

      <section class="dfx-sec">
        <div class="dfx-sec-head"><h2>{dt('Channels and staff')}</h2><p>{dt('Where confessions appear, where the staff checks them and who can answer.')}</p></div>
        <div class="dfx-grid">
          <div class="dfx-field"><label>{dt('Channel')}</label>
            <select name="channel_id" data-cf-channel><option value="">{dt('Choose a channel')}</option>{channels.map((c) => <option value={c.id} selected={c.id === config.channelId}>#{c.name}</option>)}</select>
            <span class="dfx-hint">{dt('The confessions appear here.')}</span>
          </div>
          <div class="dfx-field"><label>{dt('Review channel')}</label>
            <select name="review_channel_id"><option value="">{dt('None')}</option>{channels.map((c) => <option value={c.id} selected={c.id === config.reviewChannelId}>#{c.name}</option>)}</select>
            <span class="dfx-hint">{dt('Only the staff should see it. Needed if the staff checks first.')}</span>
          </div>
          <div class="dfx-field"><label>{dt('Log channel')}</label>
            <select name="log_channel_id"><option value="">{dt('None')}</option>{channels.map((ch) => <option value={ch.id} selected={ch.id === config.logChannelId}>#{ch.name}</option>)}</select>
            <span class="dfx-hint">{dt('What the staff does (approve, reject, look at who made one, block, delete) is written here.')}</span>
          </div>
          <div class="dfx-field"><label>{dt('Role of the staff')}</label>
            <select name="staff_role_id"><option value="">{dt('Only who manages the server')}</option>{roles.map((r) => <option value={r.id} selected={r.id === config.staffRoleId}>{r.name}</option>)}</select>
          </div>
        </div>
      </section>

      <section class="dfx-sec">
        <div class="dfx-sec-head"><h2>{dt('How it looks')}</h2><p>{dt('The preview changes while you write.')}</p></div>
        <aside class="cf-preview" aria-label={dt('Preview')}>
          <div class="cf-msgbox">
            <div class="cf-who"><span class="cf-ava" data-cf-ava>{config.webhookAvatar ? <img src={config.webhookAvatar} alt="" referrerpolicy="no-referrer" /> : <Icon name="ph:mask-happy-fill" width="18" height="18" />}</span><b data-cf-name>{config.webhookName}</b><span class="cf-app">APP</span></div>
            <div class="cf-card" data-cf-card style={`border-left-color:${config.color}`}>
              <p class="cf-card-title" data-cf-title data-raw={config.title}>{sample}</p>
              <p>{dt('I still sleep with the light on.')}</p>
              <p class="cf-card-foot" data-cf-foot data-raw={config.footer} hidden={!foot}>{foot}</p>
            </div>
            <span class="cf-btn" data-cf-reply hidden={!config.allowReplies}>{config.replyLabel}</span>
          </div>
        </aside>
        <div class="dfx-grid">
          <div class="dfx-field"><label>{dt('Name it shows')}</label><input type="text" name="webhook_name" data-cf-in="name" value={config.webhookName} maxlength="80" /></div>
          <div class="dfx-field"><label>{dt('Picture it shows')}</label><input type="url" name="webhook_avatar" value={config.webhookAvatar} maxlength="400" placeholder="https://..." /><span class="dfx-hint">{dt('A link. Empty uses the picture Petto has in this server, or the usual one of Petto.')}</span></div>
          <div class="dfx-field dfx-wide"><label>{dt('Title of each confession')}</label><textarea name="title" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count data-cf-in="title" data-ac="vars,emojis" maxlength="200">{config.title}</textarea><span class="dfx-hint">{dt('You can use {confession.number} and {confession.id}.')}</span></div>
          <div class="dfx-field dfx-wide"><label>{dt('Small text under each confession')}</label><textarea name="footer" class="dgl-autogrow dfx-one" rows="1" data-one-line data-count data-cf-in="footer" data-ac="vars,emojis" maxlength="200">{config.footer}</textarea><span class="dfx-hint">{dt('Empty for none.')}</span></div>
          <div class="dfx-field"><label>{dt('Color')}</label><ColorPicker name="color" value={config.color} label={dt('Color')} /></div>
          <div class="dfx-field"><label>{dt('Saved design')}</label>
            <select name="embed_template" data-tpl-locks="title footer"><option value="">{dt('The usual one')}</option>{templates.map((n) => <option value={n} selected={n === config.embedTemplate}>{n}</option>)}</select>
            <span class="dfx-hint">{dt('A design of the Embeds page. It can use the {confession.*} variables.')}</span>
          </div>
          <div class="dfx-field"><label>{dt('Text of the panel button')}</label><input type="text" name="button_label" data-ac="vars,emojis" value={config.buttonLabel} maxlength="80" /></div>
          <div class="dfx-field"><label>{dt('Text of the reply button')}</label><input type="text" name="reply_label" data-cf-in="reply" data-ac="vars,emojis" value={config.replyLabel} maxlength="80" /></div>
          <div class="dfx-field dfx-wide"><label>{dt('Text of the panel')}</label><textarea name="panel_text" class="dgl-autogrow" rows="3" data-count data-ac maxlength="400">{config.panelText}</textarea></div>
        </div>
      </section>

      <section class="dfx-sec">
        <div class="dfx-sec-head"><h2>{dt('Rules')}</h2><p>{dt('Who can confess and what happens to each confession.')}</p></div>
        <div class="dfx-grid">
          <div class="dfx-field"><label>{dt('Seconds to wait between confessions')}</label><input type="number" name="cooldown_seconds" min="0" max="86400" value={config.cooldownSeconds} /><span class="dfx-hint">{dt('0 for no wait.')}</span></div>
        </div>
        <div class="dfx-switches">
          {switches.map((s) => (
            <label class="dfx-switch"><span><b>{s.label}</b>{s.hint && <em>{s.hint}</em>}</span><input type="checkbox" class="dfx-t" name={s.name} data-cf-in={s.name === 'allow_replies' ? 'replies' : undefined} checked={s.on} /></label>
          ))}
        </div>
      </section>

      <div class="dfx-foot">
        <button class="btn btn-accent btn-sm" type="submit" disabled={!ready}>{dt('Save')}</button>
        <button class="btn btn-ghost btn-sm" type="button" data-cf-panel data-working={dt('Posting...')} data-failed={dt('The panel could not be posted.')} disabled={!ready}><Icon name="ph:paper-plane-tilt-fill" width="13" height="13" />{dt('Post the panel')}</button>
        <span class="cf-msg" data-cf-msg hidden></span>
      </div>
      <span class="dfx-hint">{dt('Save first, then post the panel in the channel. With the prefix: !confession setup, panel, reveal, block.')}</span>
    </form>
  </div>

  <script is:inline>
    (function () {
      var button = document.querySelector('[data-cf-panel]');
      var msg = document.querySelector('[data-cf-msg]');
      if (!button || !msg) return;
      var guild = location.pathname.replace(/^\/(es|pt-br)(?=\/)/i, '').split('/')[3];
      var label = button.innerHTML;
      button.addEventListener('click', function () {
        var select = document.querySelector('[data-cf-channel]');
        // The button says it is posting (same width, its icon back after); the answer is a toast at the bottom (inline only without it).
        button.style.minWidth = button.offsetWidth + 'px';
        button.disabled = true; button.textContent = button.getAttribute('data-working'); msg.hidden = true;
        fetch('/dash/guild/' + guild + '/confessions-api', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ channel_id: select ? select.value : '' }), signal: window.AbortSignal && AbortSignal.timeout ? AbortSignal.timeout(30000) : undefined })
          .then(function (r) { return r.json().catch(function () { return { ok: false, message: button.getAttribute('data-failed') }; }); })
          .catch(function () { return { ok: false, message: button.getAttribute('data-failed') }; })
          .then(function (result) {
            button.disabled = false; button.innerHTML = label; button.style.minWidth = '';
            var text = result.message || button.getAttribute('data-failed');
            if (window.dglToast) window.dglToast(text, { kind: result.ok ? 'ok' : 'error' });
            else { msg.hidden = false; msg.className = 'cf-msg ' + (result.ok ? 'ok' : 'bad'); msg.textContent = text; }
          });
      });
    })();
    // The preview follows what is written.
    (function () {
      var q = function (s) { return document.querySelector(s); };
      var card = q('[data-cf-card]'), title = q('[data-cf-title]'), foot = q('[data-cf-foot]'), name = q('[data-cf-name]'), reply = q('[data-cf-reply]');
      var avatar = q('[data-cf-ava]'), color = q('input[name="color"]');
      var inTitle = q('[data-cf-in="title"]'), inFoot = q('[data-cf-in="footer"]'), inName = q('[data-cf-in="name"]'), inReply = q('[data-cf-in="reply"]'), inReplies = q('[data-cf-in="replies"]');
      var picture = q('input[name="webhook_avatar"]');
      if (!card || !title) return;
      var fill = function (text) { return String(text || '').split('{confession.number}').join('12').split('{confession.id}').join('si2tr-foytm'); };
      function paint() {
        if (inTitle) title.textContent = fill(inTitle.value);
        if (inFoot) { var f = fill(inFoot.value); foot.textContent = f; foot.hidden = !f; }
        if (inName) name.textContent = inName.value;
        if (inReply && reply) reply.textContent = inReply.value;
        if (reply && inReplies) reply.hidden = !inReplies.checked;
        if (color && /^#[0-9a-f]{6}$/i.test(color.value)) card.style.borderLeftColor = color.value;
        if (picture && avatar) {
          var url = picture.value.trim(); var img = avatar.querySelector('img');
          if (/^https:\/\//i.test(url)) {
            if (!img) { img = document.createElement('img'); img.alt = ''; img.referrerPolicy = 'no-referrer'; avatar.textContent = ''; avatar.appendChild(img); }
            if (img.getAttribute('src') !== url) img.src = url;
          }
        }
      }
      document.addEventListener('input', paint); document.addEventListener('change', paint);
      // The color picker writes its value without an event the page can hear: it is looked at while the page is open.
      var last = color ? color.value : '';
      setInterval(function () { if (color && color.value !== last) { last = color.value; paint(); } }, 250);
      paint();
    })();
  </script>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 18px; }
  .cf-page { max-width: 1000px; }
  .cf-msg { font-size: 13px; min-width: 0; overflow-wrap: anywhere; }
  .cf-msg.ok { color: var(--green); }
  .cf-msg.bad { color: var(--red, #ff6b6b); }
  /* The preview stays in view while the fields under it are changed. */
  .cf-preview { position: sticky; top: 8px; z-index: 2; border: 1px solid var(--border); border-radius: 14px; background: var(--bg-raise, var(--card)); padding: 14px 16px; box-shadow: 0 10px 24px -18px rgb(0 0 0 / 60%); }
  .cf-msgbox { display: flex; flex-direction: column; gap: 8px; }
  .cf-who { display: flex; align-items: center; gap: 8px; font-size: 14px; }
  .cf-ava { width: 30px; height: 30px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); display: grid; place-items: center; overflow: hidden; flex: none; }
  .cf-ava img { width: 100%; height: 100%; object-fit: cover; }
  .cf-who b { min-width: 0; overflow-wrap: anywhere; }
  .cf-app { flex: none; font-size: 10px; font-weight: 700; border-radius: 4px; padding: 1px 5px; background: var(--accent-soft); color: var(--accent); }
  .cf-card { border-left: 4px solid var(--green); border-radius: 6px; background: color-mix(in srgb, var(--text) 6%, var(--card)); padding: 10px 12px; transition: border-color 0.3s ease; }
  .cf-card p { margin: 0 0 6px; font-size: 13.5px; overflow-wrap: anywhere; }
  .cf-card-title { font-weight: 700; }
  .cf-card-foot { font-size: 11.5px !important; color: var(--text-dim); margin: 6px 0 0 !important; }
  .cf-btn { align-self: flex-start; max-width: 100%; overflow-wrap: anywhere; font-size: 12.5px; border: 1px solid var(--border); border-radius: 6px; padding: 5px 10px; background: color-mix(in srgb, var(--text) 8%, var(--card)); }
  [hidden] { display: none !important; }
  @media (max-width: 720px) { .cf-preview { position: static; } }
</style>
