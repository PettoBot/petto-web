---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import { getDashLang, makeT } from '../i18n/dash';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  config: {
    enabled: boolean; channelId: string; reviewChannelId: string; requireReview: boolean; allowCommand: boolean; allowImages: boolean; allowReplies: boolean; keepAuthor: boolean; useWebhook: boolean;
    webhookName: string; webhookAvatar: string; title: string; footer: string; color: string; buttonLabel: string; replyLabel: string; panelText: string; cooldownSeconds: number;
    staffRoleId: string; embedTemplate: string; panelChannelId: string;
  };
  channels: { id: string; name: string }[];
  roles: { id: string; name: string }[];
  templates: string[];
  counts: { posted: number; pending: number; rejected: number };
  ready: boolean;
  saved: boolean;
  failed: string;
}
const { user, guildId, guildName, guildIcon, config, channels, roles, templates, counts, ready, saved, failed } = Astro.props;
const errors: Record<string, string> = { channel: dt('Choose a channel from the list.'), role: dt('Choose a role from the list.'), avatar: dt('The picture has to be a link that starts with https.'), save: dt('It could not be saved. Try again in a moment.') };
const switches = [
  { name: 'require_review', on: config.requireReview, label: dt('The staff checks each confession first'), hint: dt('It waits in the review channel until someone approves it.') },
  { name: 'use_webhook', on: config.useWebhook, label: dt('Send it with its own name and picture'), hint: dt('A webhook, so nothing shows the bot.') },
  { name: 'allow_replies', on: config.allowReplies, label: dt('Anonymous replies'), hint: dt('A button under each confession opens a thread.') },
  { name: 'allow_images', on: config.allowImages, label: dt('Confessions can have a picture'), hint: '' },
  { name: 'allow_command', on: config.allowCommand, label: dt('The confess command works'), hint: dt('If it is off, only the panel button works.') },
  { name: 'keep_author', on: config.keepAuthor, label: dt('Keep who confessed, only for the staff'), hint: dt('Lets the staff see who it was or block them. Off keeps nothing.') },
];
const sample = config.title.replace('{confession.number}', '12').replace('{confession.id}', 'si2tr-foytm');
const foot = config.footer.replace('{confession.id}', 'si2tr-foytm').replace('{confession.number}', '12');
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="confessions" pageTitle={dt('Confessions')}>
  <h1>{dt('Confessions')}</h1>
  <p class="cf-sub">{dt('Members confess without a name. It can go out with the name and picture you choose, wait for the staff to check it, and anyone can reply anonymously in a thread.')}</p>
  {saved && <div class="cf-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {failed && <div class="cf-flash cf-warn"><Icon name="ph:warning-fill" width="15" height="15" />{errors[failed] ?? errors.save}</div>}
  {!ready && <div class="cf-flash cf-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}

  <div class="cf-stats">
    <div><b>{counts.posted}</b><span>{dt('Posted')}</span></div>
    <div><b>{counts.pending}</b><span>{dt('Waiting for the staff')}</span></div>
    <div><b>{counts.rejected}</b><span>{dt('Rejected')}</span></div>
  </div>

  <div class="cf-layout">
    <form method="POST" class="cf-form">
      <label class="cf-check"><input type="checkbox" name="enabled" checked={config.enabled} />{dt('Confessions are on')}</label>
      <div class="cf-grid">
        <div class="cf-field"><label>{dt('Channel')}</label>
          <select name="channel_id" data-cf-channel><option value="">{dt('Choose a channel')}</option>{channels.map((c) => <option value={c.id} selected={c.id === config.channelId}>#{c.name}</option>)}</select>
          <span class="cf-hint">{dt('The confessions appear here.')}</span>
        </div>
        <div class="cf-field"><label>{dt('Review channel')}</label>
          <select name="review_channel_id"><option value="">{dt('None')}</option>{channels.map((c) => <option value={c.id} selected={c.id === config.reviewChannelId}>#{c.name}</option>)}</select>
          <span class="cf-hint">{dt('Only the staff should see it. Needed if the staff checks first.')}</span>
        </div>
        <div class="cf-field"><label>{dt('Role of the staff')}</label>
          <select name="staff_role_id"><option value="">{dt('Only who manages the server')}</option>{roles.map((r) => <option value={r.id} selected={r.id === config.staffRoleId}>{r.name}</option>)}</select>
        </div>
        <div class="cf-field"><label>{dt('Seconds to wait between confessions')}</label><input type="number" name="cooldown_seconds" min="0" max="86400" value={config.cooldownSeconds} /><span class="cf-hint">{dt('0 for no wait.')}</span></div>
        <div class="cf-field"><label>{dt('Name it shows')}</label><input type="text" name="webhook_name" value={config.webhookName} maxlength="80" /></div>
        <div class="cf-field"><label>{dt('Picture it shows')}</label><input type="url" name="webhook_avatar" value={config.webhookAvatar} maxlength="400" placeholder="https://..." /><span class="cf-hint">{dt('A link. Empty uses the picture of the bot.')}</span></div>
        <div class="cf-field cf-wide"><label>{dt('Title of each confession')}</label><input type="text" name="title" value={config.title} maxlength="200" /><span class="cf-hint">{dt('You can use {confession.number} and {confession.id}.')}</span></div>
        <div class="cf-field cf-wide"><label>{dt('Small text under each confession')}</label><input type="text" name="footer" value={config.footer} maxlength="200" /><span class="cf-hint">{dt('Empty for none.')}</span></div>
        <div class="cf-field"><label>{dt('Color')}</label><input type="color" name="color" value={config.color} class="cf-color" /></div>
        <div class="cf-field"><label>{dt('Saved design')}</label>
          <select name="embed_template"><option value="">{dt('The usual one')}</option>{templates.map((n) => <option value={n} selected={n === config.embedTemplate}>{n}</option>)}</select>
          <span class="cf-hint">{dt('A design of the Embeds page. It can use the {confession.*} variables.')}</span>
        </div>
        <div class="cf-field"><label>{dt('Text of the panel button')}</label><input type="text" name="button_label" value={config.buttonLabel} maxlength="80" /></div>
        <div class="cf-field"><label>{dt('Text of the reply button')}</label><input type="text" name="reply_label" value={config.replyLabel} maxlength="80" /></div>
        <div class="cf-field cf-wide"><label>{dt('Text of the panel')}</label><input type="text" name="panel_text" value={config.panelText} maxlength="400" /></div>
      </div>
      <div class="cf-switches">
        {switches.map((s) => (
          <label class="cf-switch"><input type="checkbox" name={s.name} checked={s.on} /><span><b>{s.label}</b>{s.hint && <em>{s.hint}</em>}</span></label>
        ))}
      </div>
      <div class="cf-foot">
        <button class="btn btn-accent btn-sm" type="submit" disabled={!ready}>{dt('Save')}</button>
        <button class="btn btn-ghost btn-sm" type="button" data-cf-panel data-working={dt('Posting...')} data-failed={dt('The panel could not be posted.')} disabled={!ready}><Icon name="ph:paper-plane-tilt-fill" width="13" height="13" />{dt('Post the panel')}</button>
        <span class="cf-msg" data-cf-msg hidden></span>
      </div>
      <span class="cf-hint">{dt('Save first, then post the panel in the channel. With the prefix: !confession setup, panel, reveal, block.')}</span>
    </form>

    <aside class="cf-preview" aria-label={dt('Preview')}>
      <p class="cf-preview-title">{dt('Preview')}</p>
      <div class="cf-msgbox">
        <div class="cf-who"><span class="cf-ava">{config.webhookAvatar ? <img src={config.webhookAvatar} alt="" referrerpolicy="no-referrer" /> : <Icon name="ph:mask-happy-fill" width="18" height="18" />}</span><b>{config.webhookName}</b><span class="cf-app">APP</span></div>
        <div class="cf-card" style={`border-left-color:${config.color}`}>
          <p class="cf-card-title">{sample}</p>
          <p>{dt('I still sleep with the light on.')}</p>
          {foot && <p class="cf-card-foot">{foot}</p>}
        </div>
        {config.allowReplies && <span class="cf-btn">{config.replyLabel}</span>}
      </div>
    </aside>
  </div>

  <script is:inline>
    (function () {
      var button = document.querySelector('[data-cf-panel]');
      var msg = document.querySelector('[data-cf-msg]');
      if (!button || !msg) return;
      var guild = location.pathname.replace(/^\/(es|pt-br)(?=\/)/i, '').split('/')[3];
      button.addEventListener('click', function () {
        var select = document.querySelector('[data-cf-channel]');
        button.disabled = true; msg.hidden = false; msg.className = 'cf-msg'; msg.textContent = button.getAttribute('data-working');
        fetch('/dash/guild/' + guild + '/confessions-api', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ channel_id: select ? select.value : '' }) })
          .then(function (r) { return r.json().catch(function () { return { ok: false, message: button.getAttribute('data-failed') }; }); })
          .catch(function () { return { ok: false, message: button.getAttribute('data-failed') }; })
          .then(function (result) { button.disabled = false; msg.className = 'cf-msg ' + (result.ok ? 'ok' : 'bad'); msg.textContent = result.message || button.getAttribute('data-failed'); });
      });
    })();
  </script>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  .cf-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 20px; max-width: 70ch; }
  .cf-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 16px; max-width: 760px; }
  .cf-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: var(--yellow); }
  .cf-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px; margin-bottom: 20px; max-width: 560px; }
  .cf-stats div { border: 1px solid var(--border); border-radius: 12px; background: var(--card); padding: 12px 16px; }
  .cf-stats b { display: block; font-size: 22px; }
  .cf-stats span { font-size: 12.5px; color: var(--text-dim); }
  .cf-layout { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 18px; align-items: start; max-width: 1180px; }
  .cf-form { display: flex; flex-direction: column; gap: 18px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 18px; min-width: 0; }
  .cf-check { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; }
  .cf-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .cf-wide { grid-column: 1 / -1; }
  .cf-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .cf-field label { font-size: 13px; font-weight: 600; }
  .cf-field input[type=text], .cf-field input[type=url], .cf-field input[type=number], .cf-field select { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; min-width: 0; max-width: 100%; }
  .cf-color { width: 56px; height: 36px; padding: 2px; border: 1px solid var(--border); border-radius: 8px; background: var(--card); }
  .cf-hint { font-size: 12px; color: var(--text-dim); }
  .cf-switches { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .cf-switch { display: flex; align-items: flex-start; gap: 10px; border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; cursor: pointer; }
  .cf-switch input { margin-top: 3px; }
  .cf-switch b { display: block; font-size: 13.5px; font-weight: 600; }
  .cf-switch em { display: block; font-style: normal; font-size: 12px; color: var(--text-dim); margin-top: 2px; }
  .cf-foot { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .cf-msg { font-size: 13px; }
  .cf-msg.ok { color: var(--green); }
  .cf-msg.bad { color: var(--red, #ff6b6b); }
  .cf-preview { border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 16px; position: sticky; top: 16px; }
  .cf-preview-title { margin: 0 0 12px; font-size: 13px; font-weight: 600; color: var(--text-dim); }
  .cf-msgbox { display: flex; flex-direction: column; gap: 8px; }
  .cf-who { display: flex; align-items: center; gap: 8px; font-size: 14px; }
  .cf-ava { width: 30px; height: 30px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); display: grid; place-items: center; overflow: hidden; flex: none; }
  .cf-ava img { width: 100%; height: 100%; object-fit: cover; }
  .cf-app { font-size: 10px; font-weight: 700; border-radius: 4px; padding: 1px 5px; background: var(--accent-soft); color: var(--accent); }
  .cf-card { border-left: 4px solid var(--green); border-radius: 6px; background: color-mix(in srgb, var(--text) 6%, var(--card)); padding: 10px 12px; }
  .cf-card p { margin: 0 0 6px; font-size: 13.5px; overflow-wrap: anywhere; }
  .cf-card-title { font-weight: 700; }
  .cf-card-foot { font-size: 11.5px !important; color: var(--text-dim); margin: 6px 0 0 !important; }
  .cf-btn { align-self: flex-start; font-size: 12.5px; border: 1px solid var(--border); border-radius: 6px; padding: 5px 10px; background: color-mix(in srgb, var(--text) 8%, var(--card)); }
  @media (max-width: 900px) { .cf-layout { grid-template-columns: minmax(0, 1fr); } .cf-preview { position: static; } }
  @media (max-width: 720px) { .cf-grid, .cf-switches { grid-template-columns: 1fr; } }
</style>
