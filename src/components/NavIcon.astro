---
import InlineIcon from './InlineIcon.astro';

interface Props {
  name: string;
  class?: string;
  width?: string | number;
  height?: string | number;
}

const { name, class: className, width, height } = Astro.props;
const iconProps = { class: className, width, height };
---
<InlineIcon name={name} {...iconProps} />
