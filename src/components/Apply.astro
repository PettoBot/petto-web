---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { localePath, type Locale } from '../i18n/ui';
import { applicationCopy } from '../data/applicationCopy';
import { applicationRoleList, applicationRoles, isApplicationRole } from '../utils/applications';
import { getDashboardSession } from '../utils/dashAuth';
import { getEnv } from '../utils/env';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const copy = applicationCopy[lang];
const base = localePath[lang];

const roleParam = Astro.url.searchParams.get('role');
const role = isApplicationRole(roleParam) ? roleParam : null;
const sent = Astro.url.searchParams.get('sent') === '1';
const errorParam = Astro.url.searchParams.get('error');
const error = errorParam && errorParam in copy.errors ? (errorParam as keyof typeof copy.errors) : null;

const session = await getDashboardSession(Astro);
const open = Boolean(getEnv(Astro, 'PETTO_FORMS_WEBHOOK_URL'));

const icons: Record<string, string> = {
  developer: 'ph:code-fill',
  manager: 'ph:users-three-fill',
  partner: 'ph:share-network-fill',
  staff: 'ph:shield-check-fill',
};
const fields = role ? applicationRoles[role].fields : [];
---
<Base title={copy.title} lang={lang}>
  <main>
    <section class="ap-hero">
      <div class="wrap">
        <div class="eyebrow reveal">{copy.eyebrow}</div>
        <h1 class="reveal">{copy.h1}</h1>
        <p class="ap-lede reveal">{copy.lede}</p>
      </div>
    </section>

    <section class="ap-body">
      <div class="wrap ap-wrap">
        {sent && (
          <div class="ap-alert success" role="status">
            <Icon name="ph:check-circle-fill" width="18" height="18" />
            <span>{copy.success}</span>
          </div>
        )}
        {error && (
          <div class="ap-alert error" role="alert">
            <Icon name="ph:warning-fill" width="18" height="18" />
            <span>{copy.errors[error]}</span>
          </div>
        )}
        {!open && (
          <div class="ap-alert error" role="status">
            <Icon name="ph:warning-fill" width="18" height="18" />
            <span>{copy.errors.unavailable}</span>
          </div>
        )}

        {!role || sent ? (
          <>
            <h2 class="ap-choose">{copy.choose}</h2>
            <div class="ap-grid">
              {applicationRoleList.map((key) => (
                <a class="ap-card" href={`${base}/apply?role=${key}`}>
                  <span class="ap-card-icon"><Icon name={icons[key]} width="22" height="22" /></span>
                  <span class="ap-card-title">{copy.roles[key].title}</span>
                  <span class="ap-card-desc">{copy.roles[key].desc}</span>
                </a>
              ))}
            </div>
          </>
        ) : (
          <form class="ap-form" method="POST" action="/api/apply">
            <a class="ap-back" href={`${base}/apply`}><Icon name="ph:arrow-left" width="14" height="14" /> {copy.back}</a>
            <div class="ap-form-head">
              <span class="ap-card-icon"><Icon name={icons[role]} width="22" height="22" /></span>
              <div>
                <h2>{copy.roles[role].title}</h2>
                <p>{copy.roles[role].intro}</p>
              </div>
            </div>

            {session ? (
              <div class="ap-login ok"><Icon name="ph:check-circle-fill" width="16" height="16" /> {copy.loggedInAs} <b>{session.username}</b></div>
            ) : (
              <div class="ap-login">
                <span>{copy.loginHint}</span>
                <a class="btn btn-ghost btn-sm" href="/dash">{copy.loginCta}</a>
              </div>
            )}

            <input type="hidden" name="role" value={role} />
            <input type="hidden" name="lang" value={lang} />
            <div class="ap-trap" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>

            {fields.map((field) => {
              const text = copy.fields[role][field.key];
              return (
                <label class="ap-field">
                  <span class="ap-label">{text.label} <em>{field.required ? copy.required : copy.optional}</em></span>
                  {text.hint && <span class="ap-hint">{text.hint}</span>}
                  {field.kind === 'textarea' ? (
                    <textarea name={field.key} rows="5" maxlength={field.max} required={field.required} placeholder={text.placeholder}></textarea>
                  ) : field.kind === 'select' ? (
                    <select name={field.key} required={field.required}>
                      <option value="" disabled selected>{copy.select}</option>
                      {field.options?.map((option) => <option value={option}>{copy.options[option]}</option>)}
                    </select>
                  ) : (
                    <input
                      type={field.kind === 'url' ? 'url' : field.kind === 'number' ? 'number' : 'text'}
                      name={field.key}
                      maxlength={field.kind === 'number' ? undefined : field.max}
                      min={field.kind === 'number' ? 0 : undefined}
                      required={field.required}
                      placeholder={text.placeholder}
                      value={field.key === 'discord' && session ? session.username : undefined}
                    />
                  )}
                </label>
              );
            })}

            <p class="ap-privacy">{copy.privacy} <a href={`${base}/privacy`}>{lang === 'es' ? 'Política de privacidad' : lang === 'pt-BR' ? 'Política de privacidade' : 'Privacy Policy'}</a></p>
            <button class="btn btn-primary" type="submit" disabled={!open}><Icon name="ph:paper-plane-tilt-fill" width="15" height="15" /> {copy.submit}</button>
          </form>
        )}
      </div>
    </section>
  </main>
</Base>

<style>
  .ap-hero { padding: 64px 0 24px; }
  .ap-hero h1 { font-size: 34px; margin: 14px 0 12px; }
  .ap-lede { color: var(--text-muted); font-size: 15.5px; max-width: 60ch; }
  .ap-body { padding: 8px 0 100px; }
  .ap-wrap { max-width: 760px; }
  .ap-alert { display: flex; align-items: center; gap: 10px; padding: 13px 15px; border-radius: 12px; margin: 0 0 14px; font-size: 14px; }
  .ap-alert.error { color: var(--red); background: var(--red-soft); border: 1px solid color-mix(in srgb, var(--red) 55%, var(--border)); }
  .ap-alert.success { color: var(--green); background: var(--green-soft); border: 1px solid color-mix(in srgb, var(--green) 55%, var(--border)); }
  .ap-choose { font-size: 18px; margin: 18px 0 14px; }
  .ap-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .ap-card { display: flex; flex-direction: column; gap: 8px; padding: 20px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); color: var(--text); text-decoration: none; min-width: 0; }
  .ap-card:hover { border-color: var(--text-dim); }
  .ap-card-icon { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--accent-soft); color: var(--accent); flex: 0 0 auto; }
  .ap-card-title { font-family: var(--serif); font-size: 20px; }
  .ap-card-desc { color: var(--text-muted); font-size: 13.5px; line-height: 1.5; }
  .ap-form { display: grid; gap: 18px; padding: 24px; border: 1px solid var(--border); border-radius: 16px; background: var(--card); }
  .ap-back { display: inline-flex; align-items: center; gap: 6px; color: var(--text-dim); font-size: 13px; text-decoration: none; }
  .ap-back:hover { color: var(--text); }
  .ap-form-head { display: flex; align-items: center; gap: 14px; }
  .ap-form-head h2 { font-family: var(--serif); font-size: 24px; margin: 0 0 4px; }
  .ap-form-head p { color: var(--text-muted); font-size: 14px; margin: 0; }
  .ap-login { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 12px 14px; border: 1px dashed var(--border); border-radius: 12px; color: var(--text-muted); font-size: 13px; }
  .ap-login.ok { justify-content: flex-start; color: var(--green); border-style: solid; }
  .ap-trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .ap-field { display: grid; gap: 6px; }
  .ap-label { font-size: 13.5px; font-weight: 600; color: var(--text); }
  .ap-label em { font-style: normal; font-weight: 400; font-size: 11px; color: var(--text-dim); margin-left: 6px; }
  .ap-hint { font-size: 12px; color: var(--text-dim); }
  .ap-field input, .ap-field textarea, .ap-field select { width: 100%; box-sizing: border-box; padding: 11px 12px; border: 1px solid var(--border); border-radius: 9px; background: var(--bg-raise); color: var(--text); font: inherit; font-size: 14px; }
  .ap-field textarea { resize: vertical; min-height: 110px; }
  .ap-field input:focus, .ap-field textarea:focus, .ap-field select:focus { outline: 2px solid color-mix(in srgb, var(--accent) 55%, transparent); outline-offset: 1px; }
  .ap-privacy { font-size: 12px; color: var(--text-dim); line-height: 1.55; margin: 0; }
  .ap-privacy a { color: var(--accent); }
  .ap-form .btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; }
  .ap-form .btn[disabled] { opacity: 0.5; cursor: not-allowed; }
  @media (max-width: 640px) {
    .ap-hero { padding: 40px 0 16px; }
    .ap-grid { grid-template-columns: minmax(0, 1fr); }
    .ap-form { padding: 18px; }
  }
</style>
