---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { localePath, type Locale } from '../i18n/ui';
import { applicationCopy } from '../data/applicationCopy';
import { applicationRoleList, applicationRoles, isApplicationRole } from '../utils/applications';
import { getDashboardSession } from '../utils/dashAuth';
import { getEnv } from '../utils/env';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const copy = applicationCopy[lang];
const base = localePath[lang];

const roleParam = Astro.url.searchParams.get('role');
const role = isApplicationRole(roleParam) ? roleParam : null;
const sent = Astro.url.searchParams.get('sent') === '1';
const errorParam = Astro.url.searchParams.get('error');
const error = errorParam && errorParam in copy.errors ? (errorParam as keyof typeof copy.errors) : null;

const session = await getDashboardSession(Astro);
const open = Boolean(getEnv(Astro, 'PETTO_FORMS_WEBHOOK_URL'));

const icons: Record<string, string> = {
  developer: 'ph:code-fill',
  manager: 'ph:users-three-fill',
  partner: 'ph:share-network-fill',
  staff: 'ph:shield-check-fill',
  translator: 'ph:translate-fill',
};
const fields = role ? applicationRoles[role].fields : [];
const sections = fields.reduce<{ key: string; fields: typeof fields }[]>((groups, field) => {
  const last = groups[groups.length - 1];
  if (last && last.key === field.section) last.fields.push(field);
  else groups.push({ key: field.section, fields: [field] });
  return groups;
}, []);
---
<Base title={copy.title} lang={lang}>
  <main>
    <section class="ap-hero">
      <div class="wrap">
        <div class="eyebrow reveal">{copy.eyebrow}</div>
        <h1 class="reveal">{copy.h1}</h1>
        <p class="ap-lede reveal">{copy.lede}</p>
      </div>
    </section>

    <section class="ap-body">
      <div class="wrap ap-wrap">
        {sent && (
          <div class="ap-alert success" role="status">
            <Icon name="ph:check-circle-fill" width="18" height="18" />
            <span>{copy.success}</span>
          </div>
        )}
        {error && (
          <div class="ap-alert error" role="alert">
            <Icon name="ph:warning-fill" width="18" height="18" />
            <span>{copy.errors[error]}</span>
          </div>
        )}
        {!open && (
          <div class="ap-alert error" role="status">
            <Icon name="ph:warning-fill" width="18" height="18" />
            <span>{copy.errors.unavailable}</span>
          </div>
        )}

        {!role || sent ? (
          <>
            <h2 class="ap-choose">{copy.choose}</h2>
            <div class="ap-grid">
              {applicationRoleList.map((key, index) => (
                <a class="ap-card" style={`--i:${index}`} href={`${base}/apply?role=${key}`}>
                  <span class="ap-card-icon"><Icon name={icons[key]} width="22" height="22" /></span>
                  <span class="ap-card-title">{copy.roles[key].title}</span>
                  <span class="ap-card-desc">{copy.roles[key].desc}</span>
                  <span class="ap-card-time"><Icon name="ph:clock-fill" width="12" height="12" /> {copy.roles[key].time}</span>
                </a>
              ))}
            </div>
          </>
        ) : (
          <form class="ap-form" id="apForm" method="POST" action="/api/apply">
            <a class="ap-back" href={`${base}/apply`}><Icon name="ph:arrow-left" width="14" height="14" /> {copy.back}</a>
            <div class="ap-alert error" id="apSummary" role="alert" hidden>
              <Icon name="ph:warning-fill" width="18" height="18" />
              <span id="apSummaryText"></span>
            </div>
            <div class="ap-form-head">
              <span class="ap-card-icon"><Icon name={icons[role]} width="22" height="22" /></span>
              <div>
                <h2>{copy.roles[role].title}</h2>
                <p>{copy.roles[role].intro}</p>
                <p class="ap-time"><Icon name="ph:clock-fill" width="12" height="12" /> {copy.roles[role].time}</p>
              </div>
            </div>

            {session ? (
              <div class="ap-login ok"><Icon name="ph:check-circle-fill" width="16" height="16" /> {copy.loggedInAs} <b>{session.username}</b></div>
            ) : (
              <div class="ap-login">
                <span>{copy.loginHint}</span>
                <a class="btn btn-ghost btn-sm" href="/dash">{copy.loginCta}</a>
              </div>
            )}

            <input type="hidden" name="role" value={role} />
            <input type="hidden" name="lang" value={lang} />
            <div class="ap-trap" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>

            {sections.map((section) => (
              <fieldset class="ap-section">
                {section.key !== 'confirm' && <legend>{copy.sections[role][section.key]}</legend>}
                {section.fields.map((field) => {
                  const text = copy.fields[role][field.key];
                  const attrs = { 'data-field': field.key, 'data-kind': field.kind, 'data-min': field.min, 'data-max': field.max, 'data-required': field.required ? '1' : '0' };
                  return field.kind === 'checkbox' ? (
                    <div class="ap-check-wrap" {...attrs}>
                      <label class="ap-check">
                        <input type="checkbox" name={field.key} required={field.required} />
                        <span>{text.label}</span>
                      </label>
                      <p class="ap-error" role="alert" hidden></p>
                    </div>
                  ) : (
                    <div class="ap-field" {...attrs}>
                      <label class="ap-label-row" for={`ap-${field.key}`}>
                        <span class="ap-label">{text.label} <em>{field.required ? copy.required : copy.optional}</em></span>
                        {text.hint && <span class="ap-hint">{text.hint}</span>}
                      </label>
                      {field.kind === 'textarea' ? (
                        <textarea id={`ap-${field.key}`} name={field.key} rows="5" maxlength={field.max} required={field.required} placeholder={text.placeholder}></textarea>
                      ) : field.kind === 'select' ? (
                        <select id={`ap-${field.key}`} name={field.key} required={field.required}>
                          <option value="" disabled selected>{copy.select}</option>
                          {field.options?.map((option) => <option value={option}>{copy.options[option]}</option>)}
                        </select>
                      ) : (
                        <input
                          id={`ap-${field.key}`}
                          type={field.kind === 'url' ? 'url' : field.kind === 'number' ? 'text' : 'text'}
                          inputmode={field.kind === 'number' ? 'numeric' : undefined}
                          name={field.key}
                          maxlength={field.kind === 'number' ? undefined : field.max}
                          required={field.required}
                          placeholder={text.placeholder}
                          value={field.key === 'discord' && session ? session.username : undefined}
                        />
                      )}
                      <div class="ap-meta">
                        <p class="ap-error" role="alert" hidden></p>
                        {field.min >= 20 && (field.kind === 'textarea' || field.kind === 'text') && <span class="ap-count" data-count></span>}
                      </div>
                    </div>
                  );
                })}
              </fieldset>
            ))}

            <p class="ap-privacy">{copy.privacy} <a href={`${base}/privacy`}>{copy.privacyLink}</a></p>
            <button class="btn btn-primary" type="submit" disabled={!open}><Icon name="ph:paper-plane-tilt-fill" width="15" height="15" /> {copy.submit}</button>
          </form>
        )}
        {role && !sent && (
          <div class="ap-alert success" id="apSuccess" role="status" hidden>
            <Icon name="ph:check-circle-fill" width="18" height="18" />
            <span>{copy.success}</span>
          </div>
        )}
        <script is:inline type="application/json" id="apMessages" set:html={JSON.stringify({ ...copy.validation, errors: copy.errors }).replace(/</g, '\\u003c')}></script>
      </div>
    </section>
  </main>
</Base>

<script>
  const form = document.getElementById('apForm') as HTMLFormElement | null;
  if (form) {
    form.noValidate = true;
    const msgs = JSON.parse(document.getElementById('apMessages')?.textContent ?? '{}');
    const fields = Array.from(form.querySelectorAll<HTMLElement>('[data-field]'));
    const summary = document.getElementById('apSummary');
    const summaryText = document.getElementById('apSummaryText');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const buttonLabel = button?.innerHTML ?? '';
    const DISCORD = /^(@?[A-Za-z0-9_.]{2,32}|\d{17,20})$/;
    const touched = new Set<string>();

    const control = (el: HTMLElement) => el.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select')!;
    const valueOf = (el: HTMLElement) => control(el).value.replace(/\r\n/g, '\n').trim();
    const fill = (text: string, vars: Record<string, number>) => text.replace(/\{(\w+)\}/g, (_, key) => String(vars[key] ?? ''));

    function problemOf(el: HTMLElement): { key: string; vars: Record<string, number> } | null {
      const kind = el.dataset.kind;
      const required = el.dataset.required === '1';
      const min = Number(el.dataset.min ?? 0);
      if (kind === 'checkbox') return (control(el) as HTMLInputElement).checked || !required ? null : { key: 'confirm', vars: {} };
      const value = valueOf(el);
      if (!value) return required ? { key: 'missing', vars: {} } : null;
      if (kind === 'select') return null;
      if (kind === 'number') return /^\d{1,9}$/.test(value) ? null : { key: 'number', vars: {} };
      if (kind === 'url') {
        try {
          const url = new URL(value);
          return url.protocol === 'https:' || url.protocol === 'http:' ? null : { key: 'url', vars: {} };
        } catch {
          return { key: 'url', vars: {} };
        }
      }
      if (el.dataset.field === 'discord' && !DISCORD.test(value)) return { key: 'discord', vars: {} };
      if (min > 0 && value.length < min) return { key: 'short', vars: { min, n: value.length } };
      return null;
    }

    function paint(el: HTMLElement, problem: { key: string; vars: Record<string, number> } | null) {
      const box = el.querySelector<HTMLElement>('.ap-error');
      const input = control(el);
      if (box) {
        box.hidden = !problem;
        box.textContent = problem ? fill(msgs[problem.key] ?? msgs.missing, problem.vars) : '';
      }
      el.classList.toggle('invalid', Boolean(problem));
      input.setAttribute('aria-invalid', problem ? 'true' : 'false');
      if (!problem && summary && !form.querySelector('.invalid')) summary.hidden = true;
    }

    function updateCount(el: HTMLElement) {
      const counter = el.querySelector<HTMLElement>('[data-count]');
      if (!counter) return;
      const min = Number(el.dataset.min ?? 0);
      const length = valueOf(el).length;
      counter.textContent = fill(msgs.counter, { n: length, min });
      counter.classList.toggle('ok', length >= min);
    }

    fields.forEach((el) => {
      const input = control(el);
      updateCount(el);
      input.addEventListener('input', () => {
        updateCount(el);
        if (touched.has(el.dataset.field ?? '')) paint(el, problemOf(el));
      });
      input.addEventListener('change', () => { if (touched.has(el.dataset.field ?? '')) paint(el, problemOf(el)); });
      input.addEventListener('blur', () => {
        if (!valueOf(el) && el.dataset.kind !== 'checkbox' && !touched.has(el.dataset.field ?? '')) return;
        touched.add(el.dataset.field ?? '');
        paint(el, problemOf(el));
      });
    });

    function showSummary(text: string) {
      if (!summary || !summaryText) return;
      summaryText.textContent = text;
      summary.hidden = false;
      summary.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (summary) summary.hidden = true;
      let first: HTMLElement | null = null;
      fields.forEach((el) => {
        touched.add(el.dataset.field ?? '');
        const problem = problemOf(el);
        paint(el, problem);
        if (problem && !first) first = el;
      });
      if (first) {
        showSummary(msgs.summary);
        window.setTimeout(() => (first as HTMLElement).scrollIntoView({ behavior: 'smooth', block: 'center' }), 250);
        control(first).focus({ preventScroll: true });
        return;
      }

      if (button) { button.disabled = true; button.textContent = msgs.sending; }
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const result = await response.json().catch(() => ({}));
        if (response.ok && result.ok) {
          form.hidden = true;
          const done = document.getElementById('apSuccess');
          if (done) { done.hidden = false; done.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
          return;
        }
        if (result.errors) {
          let firstServer: HTMLElement | null = null;
          fields.forEach((el) => {
            const reason = result.errors[el.dataset.field ?? ''];
            if (reason) {
              paint(el, { key: reason, vars: { min: Number(el.dataset.min ?? 0), n: valueOf(el).length } });
              if (!firstServer) firstServer = el;
            }
          });
          showSummary(msgs.summary);
          if (firstServer) control(firstServer).focus({ preventScroll: true });
        } else {
          showSummary(msgs.errors[result.error] ?? msgs.errors.failed);
        }
      } catch {
        showSummary(msgs.network);
      } finally {
        if (button) { button.disabled = false; button.innerHTML = buttonLabel; }
      }
    });
  }
</script>

<style>
  .ap-hero { padding: 64px 0 24px; }
  .ap-hero h1 { font-size: 34px; margin: 14px 0 12px; }
  .ap-lede { color: var(--text-muted); font-size: 15.5px; max-width: 60ch; }
  .ap-body { padding: 8px 0 100px; }
  .ap-wrap { max-width: 760px; }
  .ap-alert { display: flex; align-items: center; gap: 10px; padding: 13px 15px; border-radius: 12px; margin: 0 0 14px; font-size: 14px; }
  .ap-alert.error { color: var(--red); background: var(--red-soft); border: 1px solid color-mix(in srgb, var(--red) 55%, var(--border)); }
  .ap-alert.success { color: var(--green); background: var(--green-soft); border: 1px solid color-mix(in srgb, var(--green) 55%, var(--border)); }
  .ap-choose { font-size: 18px; margin: 18px 0 14px; }
  .ap-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .ap-card { display: flex; flex-direction: column; gap: 8px; padding: 20px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); color: var(--text); text-decoration: none; min-width: 0; }
  .ap-card { transition: border-color .2s ease, transform .25s cubic-bezier(.2, .8, .2, 1), box-shadow .25s ease; animation: ap-card-in .5s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i, 0) * 70ms); }
  .ap-card:hover { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); transform: translateY(-3px); box-shadow: 0 12px 28px -18px color-mix(in srgb, var(--accent) 60%, transparent); }
  .ap-card:active { transform: translateY(-1px) scale(.99); }
  .ap-card:hover .ap-card-icon { transform: rotate(-6deg) scale(1.06); }
  .ap-card-icon { transition: transform .25s cubic-bezier(.2, .8, .2, 1); }
  @keyframes ap-card-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  .ap-card-icon { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--accent-soft); color: var(--accent); flex: 0 0 auto; }
  .ap-card-title { font-family: var(--serif); font-size: 20px; }
  .ap-card-desc { color: var(--text-muted); font-size: 13.5px; line-height: 1.5; }
  .ap-form { display: grid; gap: 18px; padding: 24px; border: 1px solid var(--border); border-radius: 16px; background: var(--card); }
  .ap-back { display: inline-flex; align-items: center; gap: 6px; color: var(--text-dim); font-size: 13px; text-decoration: none; }
  .ap-back:hover { color: var(--text); }
  .ap-form-head { display: flex; align-items: center; gap: 14px; }
  .ap-form-head h2 { font-family: var(--serif); font-size: 24px; margin: 0 0 4px; }
  .ap-form-head p { color: var(--text-muted); font-size: 14px; margin: 0; }
  .ap-login { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; padding: 12px 14px; border: 1px dashed var(--border); border-radius: 12px; color: var(--text-muted); font-size: 13px; }
  .ap-login.ok { justify-content: flex-start; color: var(--green); border-style: solid; }
  .ap-card-time, .ap-time { display: inline-flex; align-items: center; gap: 5px; color: var(--text-dim); font-size: 12px; margin: 4px 0 0; }
  .ap-section { display: grid; gap: 18px; margin: 0; padding: 0; border: 0; min-width: 0; }
  .ap-section legend { padding: 0; margin-bottom: 14px; font-family: var(--serif); font-size: 19px; color: var(--text); }
  .ap-section + .ap-section { padding-top: 6px; border-top: 1px solid var(--border-soft); }
  .ap-check { display: flex; align-items: flex-start; gap: 10px; font-size: 13.5px; color: var(--text); line-height: 1.5; cursor: pointer; }
  .ap-check input { width: 18px; height: 18px; margin: 2px 0 0; flex: 0 0 auto; accent-color: var(--accent); }
  .ap-trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .ap-field { display: grid; gap: 6px; }
  .ap-label { font-size: 13.5px; font-weight: 600; color: var(--text); }
  .ap-label-row { display: grid; gap: 4px; cursor: pointer; }
  .ap-meta { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .ap-meta .ap-error { flex: 1; }
  .ap-count { margin-left: auto; flex: 0 0 auto; font-family: var(--mono); font-size: 11px; color: var(--text-dim); }
  .ap-count.ok { color: var(--green); }
  .ap-error { margin: 0; font-size: 12.5px; line-height: 1.45; color: var(--red); }
  .ap-error[hidden] { display: none; }
  .ap-field.invalid input, .ap-field.invalid textarea, .ap-field.invalid select { border-color: var(--red); }
  .ap-check-wrap.invalid .ap-check { color: var(--red); }
  .ap-check-wrap { display: grid; gap: 6px; }
  .ap-alert[hidden] { display: none; }
  .ap-label em { font-style: normal; font-weight: 400; font-size: 11px; color: var(--text-dim); margin-left: 6px; }
  .ap-hint { font-size: 12px; color: var(--text-dim); }
  .ap-field input, .ap-field textarea, .ap-field select { width: 100%; box-sizing: border-box; padding: 11px 12px; border: 1px solid var(--border); border-radius: 9px; background: var(--bg-raise); color: var(--text); font: inherit; font-size: 14px; }
  .ap-field textarea { resize: vertical; min-height: 110px; }
  .ap-field input:focus, .ap-field textarea:focus, .ap-field select:focus { outline: 2px solid color-mix(in srgb, var(--accent) 55%, transparent); outline-offset: 1px; }
  .ap-privacy { font-size: 12px; color: var(--text-dim); line-height: 1.55; margin: 0; }
  .ap-privacy a { color: var(--accent); }
  .ap-form .btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; }
  .ap-form .btn[disabled] { opacity: 0.5; cursor: not-allowed; }
  @media (max-width: 640px) {
    .ap-hero { padding: 40px 0 16px; }
    .ap-grid { grid-template-columns: minmax(0, 1fr); }
    .ap-form { padding: 18px; }
  }
</style>
