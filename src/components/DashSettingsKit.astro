---
// The shared pieces of the settings pages that were redesigned (Dashboard access, Anti scam, AutoMod templates, Protection): one width, panels that rise in one after the other,
// fields with the label on top, switches with a short hint, choice cards, a counter with minus and plus (SxNumber), and soft states. Put <DashSettingsKit /> once in a page.
// Nothing here changes a field: the pages keep every name and value they sent. Two small behaviours (script below):
//   - the minus and plus of SxNumber (they hold to repeat);
//   - data-sx-needs="name" or data-sx-needs="name=value": the block is dimmed (and cannot be focused) while that checkbox is off or that choice is another,
//     but its fields are still sent, so nothing is lost by turning the other thing on and off.
// Class names avoid the word "card": the press fallback of the site (Base.astro) shrinks anything whose class has it while a child is pressed.
---
<script is:inline>
  (function () {
    // The dashboard swaps a page's content in without a reload and runs this script again: the listeners are not added twice, but the blocks of the new page are checked.
    if (window.__sxKit) { window.__sxKit(); return; }
    window.__sxKit = function () {};
    var clamp = function (input, value) {
      var min = input.min === '' ? -Infinity : Number(input.min); var max = input.max === '' ? Infinity : Number(input.max);
      return Math.min(max, Math.max(min, value));
    };
    var bump = function (button) {
      var input = button.parentElement.querySelector('input'); if (!input || input.disabled || input.readOnly) return;
      var step = Number(input.step) || 1; var now = input.value === '' ? (input.min === '' ? 0 : Number(input.min)) : Number(input.value);
      var next = clamp(input, Math.round((now + step * Number(button.getAttribute('data-sx-step'))) * 1000) / 1000);
      if (String(next) === input.value) return;
      input.value = String(next);
      input.dispatchEvent(new Event('input', { bubbles: true })); input.dispatchEvent(new Event('change', { bubbles: true }));
    };
    var timer = 0; var repeat = 0;
    var stop = function () { clearTimeout(timer); clearInterval(repeat); };
    document.addEventListener('pointerdown', function (event) {
      var button = event.target.closest && event.target.closest('[data-sx-step]'); if (!button || event.button > 0) return;
      event.preventDefault(); bump(button); stop();
      timer = setTimeout(function () { repeat = setInterval(function () { bump(button); }, 70); }, 420);
    });
    ['pointerup', 'pointerleave', 'pointercancel', 'blur'].forEach(function (name) { document.addEventListener(name, stop, true); });
    document.addEventListener('keydown', function (event) {
      var button = event.target.closest && event.target.closest('[data-sx-step]'); if (button && (event.key === 'Enter' || event.key === ' ')) { event.preventDefault(); bump(button); }
    });
    // A value typed past the limits settles on the nearest one when the field is left.
    document.addEventListener('change', function (event) {
      var input = event.target; if (!input || !input.matches || !input.matches('.sx-stepper input') || input.value === '') return;
      var fixed = clamp(input, Number(input.value)); if (String(fixed) !== input.value) input.value = String(fixed);
    });
    var needsMet = function (scope, rule) {
      var parts = rule.split('='); var name = parts[0]; var wanted = parts.length > 1 ? parts.slice(1).join('=') : null;
      var fields = (scope.closest('form') || document).querySelectorAll('[name="' + name.replace(/"/g, '') + '"]'); if (!fields.length) return true;
      var met = false;
      Array.prototype.forEach.call(fields, function (field) {
        if (field.type === 'checkbox' || field.type === 'radio') { if (field.checked && (wanted === null || field.value === wanted)) met = true; }
        else if (wanted === null ? field.value !== '' : field.value === wanted) met = true;
      });
      return met;
    };
    var refresh = function () {
      document.querySelectorAll('[data-sx-needs]').forEach(function (block) {
        var off = !needsMet(block, block.getAttribute('data-sx-needs'));
        if (block.hasAttribute('data-sx-off') === off) return;
        if (off) { block.setAttribute('data-sx-off', ''); try { block.inert = true; } catch (e) { /* dimmed is enough */ } }
        else { block.removeAttribute('data-sx-off'); try { block.inert = false; } catch (e) { /* nothing to undo */ } }
      });
    };
    window.__sxKit = refresh;
    document.addEventListener('change', refresh); document.addEventListener('input', refresh);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', refresh); else refresh();
  })();
</script>
<style is:global>
  .sx-page { max-width: 1000px; }
  .sx-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 10px; padding: 10px 14px; margin-bottom: 14px; animation: m-rise-in var(--m-base, .25s) var(--m-out, ease) both; }
  .sx-flash-bad { color: var(--red); background: var(--red-soft); border-color: color-mix(in srgb, var(--red) 55%, transparent); }
  .sx-flash-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: var(--yellow); }
  .sx-title { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .sx-pill-state { display: inline-flex; align-items: center; gap: 6px; font: 600 12px var(--sans); border-radius: 999px; padding: 3px 11px 3px 9px; color: var(--text-dim); background: color-mix(in srgb, var(--text) 7%, transparent); }
  .sx-pill-state::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: currentColor; opacity: .7; }
  .sx-pill-state.on { color: var(--green); background: var(--green-soft); }
  .sx-pill-state.on::before { opacity: 1; box-shadow: 0 0 0 3px color-mix(in srgb, var(--green) 25%, transparent); }

  /* numbers as tiles (the look of Statistics) for values a script fills in later */
  .sx-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; margin: 0 0 14px; }
  .sx-tile { --m: #f0a88f; position: relative; border: 1px solid var(--border); border-radius: 14px; padding: 14px 14px 12px; display: flex; flex-direction: column; gap: 6px; min-width: 0; overflow: hidden; background: linear-gradient(180deg, color-mix(in srgb, var(--m) 9%, var(--card)), var(--card) 70%); animation: m-rise-in var(--m-slow) var(--m-out) both; }
  .sx-tile:nth-child(2) { --m: #9bd0f5; animation-delay: var(--m-stagger); } .sx-tile:nth-child(3) { --m: #86b894; animation-delay: calc(var(--m-stagger) * 2); } .sx-tile:nth-child(4) { --m: #c6a8f5; animation-delay: calc(var(--m-stagger) * 3); }
  .sx-tile-label { display: flex; align-items: center; gap: 7px; font-family: var(--mono); font-size: 9.5px; letter-spacing: .01em; text-transform: uppercase; color: var(--text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sx-tile-label::before { content: ''; width: 8px; height: 8px; border-radius: 3px; background: var(--m); flex: none; }
  .sx-tile > b { font-family: var(--serif); font-size: 23px; font-weight: 600; line-height: 1.1; font-variant-numeric: lining-nums tabular-nums; }

  /* panels (a block of settings) */
  .sx-stack { display: flex; flex-direction: column; gap: 14px; }
  .sx-panel { display: flex; flex-direction: column; gap: 14px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 18px; min-width: 0; }
  .sx-stack > .sx-panel, .sx-duo > .sx-panel { animation: m-rise-in var(--m-slow) var(--m-out) both; }
  .sx-stack > .sx-panel:nth-child(2) { animation-delay: var(--m-stagger); } .sx-stack > .sx-panel:nth-child(3) { animation-delay: calc(var(--m-stagger) * 2); } .sx-stack > .sx-panel:nth-child(4) { animation-delay: calc(var(--m-stagger) * 3); }
  .sx-duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; align-items: start; }
  .sx-duo > .sx-panel:nth-child(2) { animation-delay: var(--m-stagger); }
  .sx-panel-head { display: flex; align-items: center; gap: 11px; min-width: 0; }
  .sx-panel-head h2 { flex: 1; min-width: 0; margin: 0; font-size: 15.5px; }
  .sx-panel-icon { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; color: var(--c, var(--accent)); background: color-mix(in srgb, var(--c, var(--accent)) 14%, transparent); }
  .sx-panel > h2 { margin: 0; font-size: 15.5px; }
  .sx-sub { display: flex; flex-direction: column; gap: 12px; margin: 0; padding: 14px 0 0; border-top: 1px solid var(--border-soft); min-width: 0; }
  .sx-sub > h3 { margin: 0; font-size: 13.5px; color: var(--text-muted); font-weight: 600; }
  .sx-lead { margin: -6px 0 0; font-size: 13px; line-height: 1.5; color: var(--text-muted); }
  .sx-hint { margin: 0; font-size: 12px; line-height: 1.45; color: var(--text-dim); }
  .sx-hint a { color: var(--accent); }

  /* fields */
  .sx-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .sx-grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .sx-wide { grid-column: 1 / -1; }
  .sx-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .sx-field > label, .sx-field > .sx-label { font-size: 13px; font-weight: 600; }
  .sx-field input[type=text], .sx-field input[type=search], .sx-field select, .sx-field textarea { border: 1px solid var(--border); border-radius: 9px; padding: 9px 11px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; width: 100%; box-sizing: border-box; min-width: 0; transition: border-color .25s ease, box-shadow .25s ease; }
  .sx-field input:focus-visible, .sx-field select:focus-visible, .sx-field textarea:focus-visible { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .sx-field textarea { line-height: 1.5; resize: vertical; min-height: 5.6em; }
  .sx-field textarea.sx-one { min-height: 2.6em; resize: none; }
  .sx-field textarea.sx-mono { font-family: var(--mono); font-size: 12.5px; }
  .sx-field textarea:disabled, .sx-field input:disabled { opacity: .55; cursor: not-allowed; }
  [data-sx-off] { opacity: .42; transition: opacity .3s ease; }
  [data-sx-needs] { transition: opacity .3s ease; }

  /* the counter: minus, the number, plus */
  .sx-stepper { display: inline-flex; align-items: stretch; width: 100%; max-width: 190px; border: 1px solid var(--border); border-radius: 10px; background: var(--card); overflow: hidden; transition: border-color .25s ease, box-shadow .25s ease; }
  .sx-stepper:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .sx-stepper input { flex: 1; min-width: 0; width: 100%; border: 0 !important; border-radius: 0 !important; background: transparent !important; box-shadow: none !important; text-align: center; padding: 9px 4px !important; font: 600 14px var(--sans) !important; font-variant-numeric: tabular-nums; color: var(--text); appearance: textfield; -moz-appearance: textfield; }
  .sx-stepper input::-webkit-outer-spin-button, .sx-stepper input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .sx-stepper input:focus-visible { outline: none; }
  .sx-step { flex: none; width: 38px; display: grid; place-items: center; border: 0; background: color-mix(in srgb, var(--text) 5%, transparent); color: var(--text-muted); cursor: pointer; padding: 0; transition: background-color .25s ease, color .25s ease; touch-action: manipulation; }
  .sx-step:hover { background: color-mix(in srgb, var(--text) 11%, transparent); color: var(--text); }
  .sx-step:active { background: color-mix(in srgb, var(--accent) 22%, transparent); color: var(--accent); }

  /* a switch with a short hint */
  .sx-switches { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .sx-switch { position: relative; display: flex; align-items: center; gap: 12px; border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; cursor: pointer; background: var(--card); min-width: 0; transition: background-color .3s ease, border-color .3s ease; }
  .sx-switch:hover { background: var(--card-hover); }
  .sx-switch:has(input:checked) { border-color: color-mix(in srgb, var(--green) 45%, var(--border)); }
  .sx-switch > input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; z-index: 1; }
  .sx-switch-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .sx-switch-text b { font-size: 13.5px; font-weight: 600; line-height: 1.35; }
  .sx-switch-text em { font-style: normal; font-size: 12px; line-height: 1.4; color: var(--text-dim); }
  .sx-toggle { position: relative; flex: none; width: 40px; height: 24px; border-radius: 999px; background: color-mix(in srgb, var(--text) 22%, var(--card)); transition: background-color .3s ease; }
  .sx-toggle::after { content: ''; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgb(0 0 0 / .35); transition: transform .35s cubic-bezier(.22, 1, .36, 1); }
  .sx-switch input:checked ~ .sx-toggle, .sx-panel-head input:checked ~ .sx-toggle { background: var(--green); }
  .sx-switch input:checked ~ .sx-toggle::after, .sx-panel-head input:checked ~ .sx-toggle::after { transform: translateX(16px); }
  .sx-switch input:focus-visible ~ .sx-toggle, .sx-panel-head input:focus-visible ~ .sx-toggle { outline: 2px solid var(--accent); outline-offset: 2px; }
  .sx-toggle-only { position: relative; display: inline-flex; flex: none; cursor: pointer; }
  .sx-toggle-only > input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; z-index: 1; }
  .sx-master { padding: 16px 18px; border-radius: 14px; }
  .sx-master .sx-switch-text b { font-size: 15px; }

  /* choose one of a few: cards with an icon and a label */
  .sx-choices { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
  .sx-choice { position: relative; display: block; cursor: pointer; min-width: 0; }
  .sx-choice > input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; z-index: 1; }
  .sx-choice-body { display: flex; flex-direction: column; gap: 3px; height: 100%; box-sizing: border-box; border: 1px solid var(--border); border-radius: 12px; padding: 11px 13px; background: var(--card); transition: background-color .3s ease, border-color .3s ease, box-shadow .3s ease; }
  .sx-choice:hover .sx-choice-body { background: var(--card-hover); }
  .sx-choice-body > svg { color: var(--text-dim); margin-bottom: 2px; transition: color .3s ease; }
  .sx-choice-body b { font-size: 13.5px; font-weight: 600; }
  .sx-choice-body em { font-style: normal; font-size: 12px; color: var(--text-dim); line-height: 1.35; }
  .sx-choice input:checked + .sx-choice-body { border-color: var(--accent); background: var(--accent-soft); box-shadow: 0 0 0 1px var(--accent) inset; }
  .sx-choice input:checked + .sx-choice-body > svg { color: var(--accent); }
  .sx-choice input:focus-visible + .sx-choice-body { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* a chip you can switch on (a part of the dashboard) */
  .sx-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .sx-chip { position: relative; display: inline-flex; cursor: pointer; }
  .sx-chip > input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; z-index: 1; }
  .sx-chip > span { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; border: 1px solid var(--border); border-radius: 999px; padding: 7px 14px 7px 11px; color: var(--text-muted); background: var(--card); transition: background-color .3s ease, border-color .3s ease, color .3s ease; }
  .sx-chip > span::before { content: ''; width: 14px; height: 14px; border-radius: 50%; border: 1.5px solid var(--text-dim); box-sizing: border-box; transition: background-color .25s ease, border-color .25s ease, box-shadow .25s ease; }
  .sx-chip:hover > span { background: var(--card-hover); color: var(--text); }
  .sx-chip input:checked + span { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); }
  .sx-chip input:checked + span::before { border-color: var(--accent); background: var(--accent); box-shadow: inset 0 0 0 2.5px var(--accent-soft); }
  .sx-chip input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .sx-linkbtn { border: 0; background: none; color: var(--accent); font: 600 12.5px var(--sans); cursor: pointer; padding: 2px 4px; border-radius: 6px; }
  .sx-linkbtn:hover { background: var(--accent-soft); }

  /* a list of things (rules, events) */
  .sx-list { display: flex; flex-direction: column; gap: 8px; }
  .sx-row { display: flex; align-items: center; gap: 12px; border: 1px solid var(--border-soft); border-radius: 12px; padding: 11px 14px; background: color-mix(in srgb, var(--text) 3%, var(--card)); min-width: 0; transition: background-color .3s ease, border-color .3s ease; }
  .sx-row:hover { border-color: var(--border); background: var(--card-hover); }
  .sx-tag { font: 600 11.5px var(--sans); border-radius: 999px; padding: 3px 10px; color: var(--text-dim); background: color-mix(in srgb, var(--text) 7%, transparent); white-space: nowrap; }
  .sx-tag-accent { color: var(--accent); background: var(--accent-soft); }
  .sx-tag-red { color: var(--red); background: var(--red-soft); }
  .sx-empty { display: flex; align-items: center; gap: 10px; margin: 0; padding: 16px; border: 1px dashed var(--border); border-radius: 12px; font-size: 13.5px; color: var(--text-dim); }
  .sx-empty svg { flex: none; color: var(--accent); }
  .sx-iconbtn { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border: 0; border-radius: 9px; background: transparent; color: var(--text-dim); cursor: pointer; transition: background-color .25s ease, color .25s ease; }
  .sx-iconbtn:hover { background: var(--red-soft); color: var(--red); }

  .sx-foot { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  @media (max-width: 720px) {
    .sx-grid, .sx-grid-3, .sx-switches, .sx-duo { grid-template-columns: 1fr; }
    .sx-panel { padding: 15px; }
    .sx-stepper { max-width: none; }
    .sx-tiles { grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) { .sx-flash, .sx-tile, .sx-stack > .sx-panel, .sx-duo > .sx-panel { animation: none; } }
</style>
