---
// Staff roles: for each moderation action, the roles that may use it without the permission of Discord (a Mod role that can ban without "Ban Members"). The same thing the bot does with
// `/moderation allow action:ban role:@Mod`. Only for whoever manages the server, since it gives power. Each action is a card: its roles as chips (with a button to take one away) and a
// small form to add one.
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import SelectSource from './SelectSource.astro';
import DashStatTiles from './DashStatTiles.astro';
import { STAFF_ACTIONS } from '../utils/staffRoles';
import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string; guildName: string; guildIcon: string;
  staff: Record<string, string[]>; roles: { id: string; name: string; color: number }[]; everyRole: { id: string; name: string; color: number }[];
  saved: boolean; problem: string | null;
}
const { user, guildId, guildName, guildIcon, staff, roles, everyRole, saved, problem } = Astro.props;
const roleOf = (id: string) => everyRole.find((role) => role.id === id);
const hex = (color: number) => (color > 0 ? `#${color.toString(16).padStart(6, '0')}` : '#99aab5');
const used = STAFF_ACTIONS.filter((action) => (staff[action.id] ?? []).length > 0).length;
const total = new Set(Object.values(staff).flat()).size;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="staff-roles" pageTitle="Staff roles">
  <DashSettingsKit />
  <div class="sx-page sr">
    <h1>{dt('Staff roles')}</h1>
    <p class="sx-lead">{dt('Let a role use a moderation action without having the permission of Discord for it: for example a Mod role that can ban without "Ban Members". Each role is only let in for the actions you choose here. Administrators and the owner can always use them.')}</p>

    {saved && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
    {problem && <div class="sx-flash sx-flash-bad" role="alert"><Icon name="ph:warning-fill" width="15" height="15" />{problem}</div>}

    <DashStatTiles tiles={[
      { label: dt('Actions with roles'), value: used, tone: 'messages' },
      { label: dt('Roles let in'), value: total, tone: 'joins' },
    ]} />

    <div class="sr-grid dgl-stagger">
      {STAFF_ACTIONS.map((action) => {
        const chosen = staff[action.id] ?? [];
        return (
          <section class="sx-panel sr-card">
            <div class="sr-top"><h2>{dt(action.label)}</h2>{chosen.length > 0 && <span class="sx-tag">{chosen.length}</span>}</div>
            <p class="sx-hint">{dt(action.hint)}</p>
            <div class="sr-chips">
              {chosen.length === 0 && <span class="sr-none">{dt('Only whoever has the permission of Discord.')}</span>}
              {chosen.map((roleId) => (
                <form method="POST" class="sr-chip" data-no-dirty style={`--c:${hex(roleOf(roleId)?.color ?? 0)}`}>
                  <input type="hidden" name="action" value="deny" /><input type="hidden" name="staff_action" value={action.id} /><input type="hidden" name="role_id" value={roleId} />
                  <i class="sr-dot"></i><span>{roleOf(roleId)?.name ?? dt('a role that is gone')}</span>
                  <button type="submit" class="sr-x" aria-label={dt('Remove')} title={dt('Remove')}><Icon name="ph:x-bold" width="11" height="11" /></button>
                </form>
              ))}
            </div>
            <form method="POST" class="sr-add" data-no-dirty>
              <input type="hidden" name="action" value="allow" /><input type="hidden" name="staff_action" value={action.id} />
              <select name="role_id" required data-give-role data-fill="sr-roles" aria-label={dt('Role')}><option value="" disabled selected>{dt('Add a role')}</option></select>
              <button type="submit" class="btn btn-ghost btn-sm" aria-label={dt('Add')} title={dt('Add')}><Icon name="ph:plus-bold" width="12" height="12" /></button>
            </form>
          </section>
        );
      })}
    </div>
    <p class="sx-hint sr-foot">{dt("The same can be done with the command: /moderation allow. It is also here so you can see everything at once. Bulk actions (mass ban, mass kick...) stay for administrators.")}</p>
  </div>
  <SelectSource name="sr-roles" items={roles.map((role) => ({ id: role.id, name: role.name }))} />
  <DashFormKit />
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 8px; }
  .sr :global(.sx-lead) { margin-bottom: 16px; }
  .sr { max-width: 1100px; }
  .sr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; align-items: stretch; margin-top: 4px; }
  .sr-card { gap: 8px; }
  .sr-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .sr-top h2 { margin: 0; font-size: 15px; }
  .sr-chips { display: flex; flex-wrap: wrap; gap: 6px; min-height: 28px; align-content: flex-start; }
  .sr-none { font-size: 12.5px; color: var(--text-dim); }
  .sr-chip { display: inline-flex; align-items: center; gap: 6px; margin: 0; padding: 3px 4px 3px 9px; border: 1px solid color-mix(in srgb, var(--c) 45%, var(--border)); border-radius: 999px; background: color-mix(in srgb, var(--c) 12%, transparent); font-size: 12.5px; animation: m-rise-in var(--m-base, .2s) var(--m-out, ease) backwards; }
  .sr-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c); flex: none; }
  .sr-x { display: grid; place-items: center; width: 20px; height: 20px; border: 0; border-radius: 50%; background: transparent; color: var(--text-dim); cursor: pointer; transition: background-color .2s ease, color .2s ease; }
  .sr-x:hover { background: var(--red-soft); color: var(--red-text); }
  .sr-add { display: flex; gap: 6px; margin: 0; margin-top: auto; }
  .sr-add select { flex: 1; min-width: 0; }
  .sr-foot { margin-top: 12px; }
  @media (prefers-reduced-motion: reduce) { .sr-chip { animation: none; } }
</style>
