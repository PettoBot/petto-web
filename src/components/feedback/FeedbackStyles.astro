---
// The look of the feedback board: the list, a post, the forms and the badges.
---
<style is:global>
  .fb-wrap { max-width: 900px; margin: 0 auto; padding: 44px 16px 90px; }
  .fb-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 22px; }
  .fb-head h1 { font-size: clamp(28px, 4.5vw, 40px); margin: 6px 0 6px; }
  .fb-lede { color: var(--text-muted); max-width: 56ch; margin: 0; }
  .fb-eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .fb-eyebrow img { width: 20px; height: 20px; }
  .fb-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; border-radius: 10px; padding: 10px 14px; margin-bottom: 16px; border: 1px solid var(--border); background: var(--card); }
  .fb-flash.ok { color: var(--green); border-color: var(--green); background: var(--green-soft); }
  .fb-flash.warn { color: var(--yellow); border-color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); }

  .fb-new { display: inline-flex; align-items: center; gap: 7px; }
  .fb-bar { display: flex; gap: 8px; margin-bottom: 10px; }
  .fb-find { position: relative; flex: 1 1 auto; min-width: 0; display: block; }
  .fb-find svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-dim); pointer-events: none; }
  .fb-bar input[type='search'], .fb-bar select, .fb-field input, .fb-field select, .fb-field textarea {
    border: 1px solid var(--border); border-radius: 10px; padding: 9px 12px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 14px; min-width: 0;
  }
  .fb-bar input[type='search'] { width: 100%; box-sizing: border-box; padding-left: 36px; }
  .fb-bar select { flex: none; max-width: 46%; }
  .fb-filters { margin-bottom: 12px; }
  .fb-filters-btn { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 600; color: var(--text-muted); padding: 7px 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--card); user-select: none; transition: border-color .15s ease, color .15s ease; }
  .fb-filters-btn::-webkit-details-marker { display: none; }
  .fb-filters-btn:hover { color: var(--text); border-color: color-mix(in srgb, var(--accent) 50%, var(--border)); }
  .fb-filters[open] > .fb-filters-btn { color: var(--accent); border-color: var(--accent); }
  .fb-filters-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .fb-count { min-width: 18px; height: 18px; padding: 0 5px; display: inline-grid; place-items: center; border-radius: 999px; background: var(--accent); color: #1a1013; font-size: 11px; font-weight: 700; }
  .fb-caret { transition: transform .18s ease; }
  .fb-filters[open] .fb-caret { transform: rotate(180deg); }
  .fb-filters-body { display: flex; flex-direction: column; gap: 14px; margin-top: 10px; padding: 14px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); animation: fb-drop .18s ease both; }
  .fb-group { display: flex; flex-direction: column; gap: 7px; }
  .fb-group-name { font-size: 11.5px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--text-dim); }
  .fb-active { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 0 0 12px; }
  .fb-pill { color: var(--accent); border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .fb-pill svg { opacity: .8; }
  .fb-clear { border-style: dashed; }
  @keyframes fb-drop { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .fb-filters-body { animation: none; } .fb-caret { transition: none; } }
  .fb-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .fb-chip { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; padding: 5px 11px; border-radius: 999px; border: 1px solid var(--border); background: var(--card); color: var(--text-muted); text-decoration: none; transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease; }
  .fb-chip:hover { color: var(--text); border-color: color-mix(in srgb, var(--accent) 50%, var(--border)); }
  .fb-chip.on { color: var(--accent); border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); }

  .fb-list { display: flex; flex-direction: column; gap: 8px; }
  .fb-card { display: flex; gap: 12px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 12px 14px 12px 10px; transition: border-color 0.15s ease, transform 0.15s ease; }
  .fb-card:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
  .fb-vote { display: flex; flex-direction: column; align-items: center; gap: 0; flex: none; width: 42px; padding: 3px 0; border-radius: 12px; background: var(--bg-raise); align-self: flex-start; }
  .fb-vote button, .fb-vote a { all: unset; cursor: pointer; width: 34px; height: 28px; display: grid; place-items: center; border-radius: 8px; opacity: 0.55; transition: opacity 0.15s ease, background 0.15s ease, transform 0.15s ease; }
  .fb-vote button:hover, .fb-vote a:hover { opacity: 1; background: color-mix(in srgb, var(--text) 8%, transparent); }
  .fb-vote button:active { transform: scale(0.88); }
  .fb-vote button.on { opacity: 1; background: color-mix(in srgb, var(--accent) 16%, transparent); }
  .fb-vote img { width: 20px; height: 20px; }
  .fb-score { font-weight: 700; font-size: 14px; font-variant-numeric: tabular-nums; line-height: 1.5; }
  .fb-main { min-width: 0; flex: 1; }
  .fb-badges { display: flex; flex-wrap: wrap; align-items: center; gap: 5px; margin-bottom: 5px; }
  .fb-title { display: block; font-size: 16px; font-weight: 650; color: var(--text); text-decoration: none; line-height: 1.3; overflow-wrap: anywhere; }
  .fb-title:hover { color: var(--accent); }
  .fb-excerpt { margin: 4px 0 8px; font-size: 13.5px; line-height: 1.5; color: var(--text-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }
  .fb-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-size: 12.5px; color: var(--text-dim); }
  .fb-by { display: inline-flex; align-items: center; gap: 6px; }
  .fb-by img { width: 18px; height: 18px; border-radius: 50%; }
  .fb-badge { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; font-weight: 650; padding: 2px 9px; border-radius: 999px; border: 1px solid var(--border); color: var(--text-muted); }
  .fb-badge.s-planned { color: #7aa7ff; border-color: color-mix(in srgb, #7aa7ff 50%, transparent); background: color-mix(in srgb, #7aa7ff 10%, transparent); }
  .fb-badge.s-in_progress { color: var(--yellow); border-color: color-mix(in srgb, var(--yellow) 50%, transparent); background: color-mix(in srgb, var(--yellow) 10%, transparent); }
  .fb-badge.s-done { color: var(--green); border-color: color-mix(in srgb, var(--green) 50%, transparent); background: var(--green-soft); }
  .fb-badge.s-declined { color: var(--text-dim); text-decoration: line-through; }
  .fb-badge.k-bug { color: #ff7a8a; border-color: color-mix(in srgb, #ff7a8a 45%, transparent); }
  .fb-badge.k-idea { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, transparent); }
  .fb-tag { font-size: 11.5px; padding: 2px 8px; border-radius: 6px; background: var(--bg-raise); color: var(--text-muted); }
  .fb-empty { text-align: center; padding: 56px 16px; color: var(--text-muted); border: 1px dashed var(--border); border-radius: 14px; }
  .fb-pager { display: flex; justify-content: center; align-items: center; gap: 12px; margin-top: 20px; font-size: 13.5px; color: var(--text-muted); }

  .fb-post { border: 1px solid var(--border); border-radius: 16px; background: var(--card); padding: 20px; display: flex; gap: 16px; }
  .fb-post h1 { font-size: clamp(22px, 3.6vw, 30px); margin: 0 0 10px; line-height: 1.25; overflow-wrap: anywhere; }
  .fb-body { white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.65; color: var(--text); margin: 14px 0; font-size: 15px; }
  .fb-note { border-left: 3px solid var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); border-radius: 0 10px 10px 0; padding: 10px 14px; font-size: 14px; margin: 12px 0; }
  .fb-staff, .fb-comment-form, .fb-form { border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 16px; display: flex; flex-direction: column; gap: 12px; margin-top: 18px; }
  .fb-staff h2, .fb-comments h2 { font-size: 15px; margin: 0; }
  .fb-comments { margin-top: 26px; }
  .fb-comment { display: flex; gap: 10px; padding: 12px 0; border-bottom: 1px solid var(--border-soft); }
  .fb-comment img { width: 32px; height: 32px; border-radius: 50%; flex: none; }
  .fb-comment p { margin: 3px 0 0; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 14px; line-height: 1.55; }
  .fb-comment b { font-size: 13.5px; }
  .fb-staff-mark { font-size: 10.5px; font-weight: 700; padding: 1px 6px; border-radius: 5px; background: var(--accent); color: #1a1013; margin-left: 6px; vertical-align: 1px; }
  .fb-field { display: flex; flex-direction: column; gap: 6px; }
  .fb-field label { font-size: 12px; font-weight: 650; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.03em; }
  .fb-field textarea { min-height: 120px; resize: vertical; line-height: 1.5; }
  .fb-hint { font-size: 12px; color: var(--text-dim); }
  .fb-check { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; padding: 5px 11px; border: 1px solid var(--border); border-radius: 999px; cursor: pointer; background: var(--card); }
  .fb-check:has(input:checked) { border-color: var(--accent); color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .fb-check input { accent-color: var(--accent); }
  .fb-trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .fb-actions { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .fb-link { font-size: 13px; color: var(--text-muted); text-decoration: none; }
  .fb-link:hover { color: var(--accent); }
  .fb-meta .fb-link { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
  .fb-danger { color: #ff7a8a; }
  .fb-delete { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border-soft); }
  .fb-delete .fb-danger { border-color: color-mix(in srgb, #ff7a8a 45%, var(--border)); display: inline-flex; align-items: center; gap: 6px; }
  @media (max-width: 560px) {
    .fb-wrap { padding-top: 28px; }
    .fb-head { margin-bottom: 16px; }
    .fb-new { width: 100%; justify-content: center; }
    .fb-card { padding: 10px 12px 10px 8px; gap: 9px; }
    .fb-vote { width: 38px; }
    .fb-title { font-size: 15.5px; }
    .fb-post { padding: 14px; flex-direction: column; }
  }
</style>
