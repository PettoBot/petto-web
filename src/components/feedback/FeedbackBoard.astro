---
// The feedback board: the list of ideas, feedback and bugs, with search, sort and a folding panel of filters. The page (feedback/index.astro) reads
// the posts; this draws them, so the board can also be shown with sample posts. Links carry the language prefix of the address (/es/feedback).
import { Icon } from 'astro-icon/components';
import { ago, avatarOf, feedbackBase, KIND_ICON, KIND_LABEL, score, STATUS_LABEL, TAG_LABEL } from './feedbackUi';
import { makeT } from '../../i18n/dash';
import { EMOJI, emojiUrl, KINDS, SORTS, STATUSES, TAGS, type Post } from '../../utils/feedback';

interface Props {
  lang: 'en' | 'es' | 'pt-BR';
  loggedIn: boolean;
  result: { posts: Post[]; total: number; pages: number } | null;
  mine: Map<number, number>;
  filters: { kind: string; status: string; tag: string; sort: string; q: string; page: number };
  deleted?: boolean;
}
const { lang, loggedIn, result, mine, filters, deleted = false } = Astro.props;
const dt = makeT(lang);
const base = feedbackBase(lang);
const { kind, status, tag, sort, q: search, page } = filters;

// An address of the board with some filters changed ('' removes one). The page goes back to the first.
const href = (changes: Record<string, string | number>) => {
  const next = new URLSearchParams();
  const current: Record<string, string> = { kind, status, tag, sort: sort === 'top' ? '' : sort, q: search };
  for (const [key, value] of Object.entries({ ...current, ...Object.fromEntries(Object.entries(changes).map(([k, v]) => [k, String(v)])) })) {
    if (value && !(key === 'page' && value === '1')) next.set(key, value);
  }
  const text = next.toString();
  return `${base}${text ? `?${text}` : ''}`;
};
const active = [
  ...(kind ? [{ key: 'kind', label: dt(KIND_LABEL[kind] ?? kind) }] : []),
  ...(status ? [{ key: 'status', label: dt(STATUS_LABEL[status] ?? status) }] : []),
  ...(tag ? [{ key: 'tag', label: dt(TAG_LABEL[tag] ?? tag) }] : []),
];
const newHref = loggedIn ? `${base}/new` : `/feedback/login?next=/feedback/new`;
const flash = deleted ? dt('The post was deleted.') : '';
---
<main class="fb-wrap" data-no-loader data-base={base}>
  <div class="fb-head">
    <div>
      <div class="fb-eyebrow"><img src={emojiUrl(EMOJI.suggest)} alt="" width="20" height="20" />{dt('Feedback')}</div>
      <h1>{dt('Tell us what Petto needs')}</h1>
      <p class="fb-lede">{dt('Ideas, feedback and bugs. Write yours, vote on the ones you want, and see what the team plans.')}</p>
    </div>
    <a class="btn btn-accent fb-new" href={newHref}><Icon name="ph:plus-bold" width="14" height="14" />{dt('New post')}</a>
  </div>

  {flash && <div class="fb-flash ok"><Icon name="ph:check-circle-fill" width="15" height="15" />{flash}</div>}
  {!result && <div class="fb-flash warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('The board is not available right now. Try again in a moment.')}</div>}

  <div id="fb-live">
    <form class="fb-bar" method="GET" action={base}>
      <label class="fb-find">
        <Icon name="ph:magnifying-glass-bold" width="15" height="15" />
        <input type="search" name="q" value={search} placeholder={dt('Search posts')} maxlength="60" aria-label={dt('Search posts')} />
      </label>
      {kind && <input type="hidden" name="kind" value={kind} />}
      {tag && <input type="hidden" name="tag" value={tag} />}
      {status && <input type="hidden" name="status" value={status} />}
      <select name="sort" aria-label={dt('Sort')} data-auto-submit>
        {SORTS.map((value) => <option value={value} selected={value === sort}>{value === 'top' ? dt('Top') : value === 'new' ? dt('Newest') : dt('Most discussed')}</option>)}
      </select>
    </form>

    <details class="fb-filters" data-filters>
      <summary class="fb-filters-btn">
        <Icon name="ph:sliders-horizontal-fill" width="14" height="14" />{dt('Filters')}
        {active.length > 0 && <span class="fb-count">{active.length}</span>}
        <Icon class="fb-caret" name="ph:caret-down-bold" width="12" height="12" />
      </summary>
      <div class="fb-filters-body">
        <div class="fb-group"><span class="fb-group-name">{dt('Type')}</span>
          <div class="fb-chips">
            <a class:list={['fb-chip', { on: !kind }]} href={href({ kind: '', page: 1 })}>{dt('All')}</a>
            {KINDS.map((value) => <a class:list={['fb-chip', { on: kind === value }]} href={href({ kind: value, page: 1 })}><Icon name={KIND_ICON[value]} width="13" height="13" />{dt(KIND_LABEL[value])}</a>)}
          </div>
        </div>
        <div class="fb-group"><span class="fb-group-name">{dt('State')}</span>
          <div class="fb-chips">
            <a class:list={['fb-chip', { on: !status }]} href={href({ status: '', page: 1 })}>{dt('Any state')}</a>
            {STATUSES.map((value) => <a class:list={['fb-chip', { on: status === value }]} href={href({ status: value, page: 1 })}>{dt(STATUS_LABEL[value])}</a>)}
          </div>
        </div>
        <div class="fb-group"><span class="fb-group-name">{dt('Topic')}</span>
          <div class="fb-chips">
            <a class:list={['fb-chip', { on: !tag }]} href={href({ tag: '', page: 1 })}>{dt('Any topic')}</a>
            {TAGS.map((value) => <a class:list={['fb-chip', { on: tag === value }]} href={href({ tag: value, page: 1 })}>{dt(TAG_LABEL[value])}</a>)}
          </div>
        </div>
      </div>
    </details>

    {active.length > 0 && (
      <div class="fb-active" aria-label={dt('Filters')}>
        {active.map((entry) => <a class="fb-pill fb-chip" href={href({ [entry.key]: '', page: 1 })} title={dt('Remove')}>{entry.label}<Icon name="ph:x-bold" width="10" height="10" /></a>)}
        {active.length > 1 && <a class="fb-clear fb-chip" href={href({ kind: '', status: '', tag: '', page: 1 })}>{dt('Clear all')}</a>}
      </div>
    )}

    {result && result.posts.length === 0 && <div class="fb-empty">{dt('No posts here yet. Be the first one!')}</div>}
    <div class="fb-list">
      {result?.posts.map((post) => {
        const vote = mine.get(post.id) ?? 0;
        const tags = post.tags ?? [];
        return (
          <article class="fb-card" data-post={post.id}>
            <div class="fb-vote" data-vote-box data-post={post.id} data-login={loggedIn ? '' : 'yes'}>
              <button type="button" data-value="1" class:list={{ on: vote === 1 }} aria-label={dt('Like')} title={dt('Like')}><img src={emojiUrl(EMOJI.like)} alt="" width="22" height="22" /></button>
              <span class="fb-score" data-score>{score(post)}</span>
              <button type="button" data-value="-1" class:list={{ on: vote === -1 }} aria-label={dt('Dislike')} title={dt('Dislike')}><img src={emojiUrl(EMOJI.dislike)} alt="" width="22" height="22" /></button>
            </div>
            <div class="fb-main">
              <div class="fb-badges">
                <span class:list={['fb-badge', `k-${post.kind}`]}><Icon name={KIND_ICON[post.kind]} width="12" height="12" />{dt(KIND_LABEL[post.kind])}</span>
                {post.status !== 'open' && <span class:list={['fb-badge', `s-${post.status}`]}>{dt(STATUS_LABEL[post.status])}</span>}
                {tags.slice(0, 2).map((value) => <span class="fb-tag">{dt(TAG_LABEL[value] ?? value)}</span>)}
                {tags.length > 2 && <span class="fb-tag">+{tags.length - 2}</span>}
              </div>
              <a class="fb-title" href={`${base}/${post.id}`}>{post.title}</a>
              {post.body && <p class="fb-excerpt">{post.body}</p>}
              <div class="fb-meta">
                <span class="fb-by"><img src={avatarOf(post.user_id, post.avatar)} alt="" width="18" height="18" loading="lazy" />{post.username || dt('Someone')}</span>
                <span>{ago(post.created_at, lang)}</span>
                <a class="fb-link" href={`${base}/${post.id}#comments`}><Icon name="ph:chat-circle-fill" width="12" height="12" /> {post.comments_count}</a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    {result && result.pages > 1 && (
      <nav class="fb-pager" aria-label={dt('Pages')}>
        {page > 1 && <a class="fb-chip" href={href({ page: page - 1 })}>← {dt('Previous')}</a>}
        <span>{dt('Page {a} of {b}', { a: Math.min(page, result.pages), b: result.pages })}</span>
        {page < result.pages && <a class="fb-chip" href={href({ page: page + 1 })}>{dt('Next')} →</a>}
      </nav>
    )}
  </div>
</main>

<script>
  // The filters, the search, the sort and the pages change the list in place: the new list is asked for, only that part of the page is
  // replaced, and the address is updated. The page does not reload and the scroll stays where it is. Without JavaScript they are normal links
  // (and the folding panel of filters is a native <details>).
  const wrap = () => document.querySelector<HTMLElement>('main.fb-wrap');
  const base = () => wrap()?.dataset.base ?? '/feedback';
  const live = () => document.getElementById('fb-live');

  function bindVotes(root: ParentNode) {
    root.querySelectorAll<HTMLElement>('[data-vote-box]').forEach((box) => {
      box.querySelectorAll<HTMLButtonElement>('button[data-value]').forEach((button) => {
        button.addEventListener('click', async () => {
          if (box.dataset.login) { location.href = `/feedback/login?next=/feedback`; return; }
          button.disabled = true;
          try {
            const response = await fetch(`/api/feedback/${box.dataset.post}/vote`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ value: Number(button.dataset.value) }) });
            if (response.status === 401) { location.href = `/feedback/login?next=/feedback`; return; }
            const data = await response.json();
            if (data.ok) {
              box.querySelector('[data-score]')!.textContent = String(data.up - data.down);
              box.querySelectorAll('button[data-value]').forEach((other) => other.classList.toggle('on', Number((other as HTMLElement).dataset.value) === data.vote));
            }
          } finally { button.disabled = false; }
        });
      });
    });
  }

  let pending = 0;
  async function show(url: string, push: boolean) {
    const box = live();
    if (!box) { location.href = url; return; }
    const turn = ++pending;
    const filtersOpen = box.querySelector<HTMLDetailsElement>('details[data-filters]')?.open ?? false;
    box.style.opacity = '0.55';
    try {
      const response = await fetch(url, { headers: { Accept: 'text/html' } });
      if (!response.ok) throw new Error('bad answer');
      const next = new DOMParser().parseFromString(await response.text(), 'text/html').getElementById('fb-live');
      if (!next) throw new Error('no list');
      if (turn !== pending) return;
      box.innerHTML = next.innerHTML;
      const panel = box.querySelector<HTMLDetailsElement>('details[data-filters]');
      if (panel) panel.open = filtersOpen;
      bindVotes(box);
      if (push) history.pushState({ feedback: true }, '', url);
    } catch {
      location.href = url;
    } finally {
      if (turn === pending) box.style.opacity = '';
    }
  }

  const inBoard = (pathname: string) => pathname === base();
  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || (event as MouseEvent).button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element | null)?.closest?.('#fb-live a.fb-chip') as HTMLAnchorElement | null;
    if (!link || link.target === '_blank') return;
    const url = new URL(link.href, location.href);
    if (!inBoard(url.pathname)) return;
    event.preventDefault();
    void show(`${url.pathname}${url.search}`, true);
  });
  document.addEventListener('submit', (event) => {
    const form = event.target as HTMLFormElement;
    if (!form.closest('#fb-live') || !form.classList.contains('fb-bar')) return;
    event.preventDefault();
    const params = new URLSearchParams();
    new FormData(form).forEach((value, key) => { const text = String(value).trim(); if (text && !(key === 'sort' && text === 'top')) params.set(key, text); });
    const text = params.toString();
    void show(`${base()}${text ? `?${text}` : ''}`, true);
  });
  document.addEventListener('change', (event) => {
    const select = event.target as HTMLSelectElement;
    if (select.matches?.('select[data-auto-submit]')) select.form?.requestSubmit();
  });
  window.addEventListener('popstate', () => { if (inBoard(location.pathname)) void show(`${location.pathname}${location.search}`, false); });

  bindVotes(document);
</script>
