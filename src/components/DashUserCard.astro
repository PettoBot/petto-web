---
// The user card at the bottom of the dashboard menu (desktop sidebar and phone drawer): the avatar with its Discord decoration, the
// nameplate behind it and a way to log out. Without a decoration or a nameplate it is a calm card with the plain avatar, the same size.
import { Icon } from 'astro-icon/components';
import { userCardData } from '../utils/discordCosmetics.mjs';
import { makeT, getDashLang } from '../i18n/dash';

interface Props { user: { username: string; avatar: string | null; decoration?: string | null; nameplate?: { asset: string; palette: string } | null } }
const { user } = Astro.props;
const dt = makeT(getDashLang(Astro));
const card = userCardData(user);
const name = card.name || user.username;
const plate = card.nameplate;
// The still picture of the nameplate paints the card while the video loads (and for good when motion is off). The address is built from validated strings.
const style = plate ? `--np-from:${plate.from};--np-to:${plate.to};--np-img:url("${plate.still}")` : undefined;
---
<div class:list={['dgl-user', { 'has-plate': Boolean(plate) }]} style={style} data-dgl-user>
  {plate && (
    <div class="dgl-user-plate" aria-hidden="true">
      <video class="dgl-user-video" muted loop playsinline preload="none" disablepictureinpicture tabindex="-1" poster={plate.still} data-src={plate.video}></video>
    </div>
  )}
  <span class="dgl-user-av">
    {card.avatar ? <img class="dgl-user-pic" src={card.avatar} alt="" width="40" height="40" /> : <span class="dgl-user-pic dgl-user-pic-fallback"><Icon name="ph:user-fill" width="16" height="16" /></span>}
    {card.decoration && (
      <picture class="dgl-user-deco">
        <source media="(prefers-reduced-motion: reduce)" srcset={card.decoration.still} />
        <img src={card.decoration.animated} data-still={card.decoration.still} alt="" width="48" height="48" decoding="async" />
      </picture>
    )}
  </span>
  <span class="dgl-user-text">
    <span class="dgl-user-name" title={name}>{name}</span>
    <a class="dgl-user-out" href="/dash/logout"><Icon name="ph:sign-out-fill" width="12" height="12" />{dt('Log out')}</a>
  </span>
</div>

<script>
  // The nameplate video starts only while the card is on screen, and never with reduced motion or Save-Data (the still picture stays).
  // A decoration or a video that does not load is dropped, so there is never an empty frame.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const saveData = Boolean((navigator as any).connection?.saveData);
  document.querySelectorAll<HTMLElement>('[data-dgl-user]').forEach((card) => {
    const deco = card.querySelector<HTMLImageElement>('.dgl-user-deco img');
    if (deco) {
      if (saveData && deco.dataset.still) deco.src = deco.dataset.still;
      deco.addEventListener('error', () => deco.closest('.dgl-user-deco')?.remove());
    }
    const video = card.querySelector<HTMLVideoElement>('video[data-src]');
    if (!video) return;
    let started = false;
    video.addEventListener('playing', () => card.classList.add('plate-live'));
    video.addEventListener('error', () => { card.classList.remove('plate-live'); video.remove(); });
    const stop = () => { video.pause(); card.classList.remove('plate-live'); };
    const watcher = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting || reduce.matches || saveData) { if (started) stop(); continue; }
        if (!started) { started = true; video.src = video.dataset.src ?? ''; }
        video.play().catch(() => {});
      }
    });
    watcher.observe(card);
    reduce.addEventListener('change', () => { if (reduce.matches && started) stop(); });
  });
</script>

<style>
  .dgl-user {
    position: relative; isolation: isolate; display: flex; align-items: center; gap: 10px; flex: none; min-width: 0;
    margin: 8px 12px 10px; padding: 8px 12px 8px 10px; border: 1px solid var(--border-soft); border-radius: 13px;
    background: var(--bg-raise); color: var(--text);
  }
  /* The picture sits in its own clipped layer, so the decoration of the avatar can reach past the edge of the avatar without being cut. */
  .dgl-user-plate {
    position: absolute; inset: 0; z-index: -1; border-radius: inherit; overflow: hidden;
    background: var(--np-img, none) center / cover no-repeat, linear-gradient(100deg, var(--np-from, transparent), var(--np-to, transparent));
  }
  .dgl-user-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .35s ease; pointer-events: none; }
  .has-plate.plate-live .dgl-user-video { opacity: 1; }
  /* A veil on the side of the text keeps the name readable on any picture (AA on the brightest palette). */
  .dgl-user-plate::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(8, 9, 12, .66) 0%, rgba(8, 9, 12, .46) 55%, rgba(8, 9, 12, .16) 100%); }
  .has-plate { border-color: rgba(255, 255, 255, .16); color: #fff; }
  /* The avatar keeps the same box with or without a decoration; the margin is the room the ring (1.2x) needs. */
  .dgl-user-av { position: relative; flex: none; width: 36px; height: 36px; margin: 4px; }
  .dgl-user-pic { display: block; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
  .dgl-user-pic-fallback { display: grid; place-items: center; background: var(--bg-raise); color: var(--text-dim); }
  .has-plate .dgl-user-pic-fallback { background: rgba(255, 255, 255, .16); color: #fff; }
  .dgl-user-deco { position: absolute; left: -10%; top: -10%; width: 120%; height: 120%; pointer-events: none; }
  .dgl-user-deco img { width: 100%; height: 100%; max-width: none; }
  .dgl-user-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; line-height: 1.25; }
  .dgl-user-name { font-size: 13.5px; font-weight: 700; letter-spacing: -.005em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .has-plate .dgl-user-name { text-shadow: 0 1px 6px rgba(0, 0, 0, .5); }
  .dgl-user-out {
    display: inline-flex; align-items: center; gap: 5px; align-self: flex-start; max-width: 100%; border-radius: 6px; padding: 1px 2px; margin-left: -2px;
    font-size: 11.5px; color: var(--text-dim); text-decoration: none; touch-action: manipulation; transition: color var(--m-fast) ease;
  }
  .dgl-user-out:hover { color: var(--red); }
  .has-plate .dgl-user-out { color: rgba(255, 255, 255, .82); text-shadow: 0 1px 4px rgba(0, 0, 0, .5); }
  .has-plate .dgl-user-out:hover { color: #fff; }
  @media (max-width: 880px) {
    .dgl-user { margin: 8px 12px calc(10px + env(safe-area-inset-bottom, 0px)); padding: 8px 12px 8px 10px; gap: 12px; border-radius: 16px; }
    .dgl-user-av { width: 42px; height: 42px; margin: 5px; }
    .dgl-user-name { font-size: 15px; }
    .dgl-user-out { font-size: 12.5px; padding: 4px 4px; margin-left: -4px; }
  }
</style>
