---
// Message roles: a list of rules ("at N messages, give this role") and a form to add one. The bot counts the messages of the servers that have rules and gives the role right after the message that
// reaches the number. `All time` counts every message since the first rule was made; `Last days` counts only the last days and can take the role away when the member falls under.
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import SelectSource from './SelectSource.astro';
import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Rule { id: number; roleId: string; messages: number; mode: 'total' | 'period'; periodDays: number; removeBelow: boolean; enabled: boolean }
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string; guildName: string; guildIcon: string;
  rules: Rule[]; roles: { id: string; name: string; color: number }[]; everyRole: { id: string; name: string }[];
  ready: boolean; saved: boolean; problem: string | null; max: number;
}
const { user, guildId, guildName, guildIcon, rules, roles, everyRole, ready, saved, problem, max } = Astro.props;
const name = (roleId: string) => everyRole.find((role) => role.id === roleId)?.name ?? dt('a role that is gone');
const on = rules.filter((rule) => rule.enabled).length;
const docsUrl = `https://wiki.petto.sbs${dashLang === 'es' ? '/es' : dashLang === 'pt-BR' ? '/pt-br' : ''}/onboarding/message-roles`;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="message-roles" pageTitle="Message roles">
  <DashSettingsKit />
  <div class="sx-page mr">
    <div class="mr-head">
      <h1>{dt('Message roles')}</h1>
      <a class="btn btn-ghost btn-sm" href={docsUrl} target="_blank" rel="noopener"><Icon name="ph:book-open-fill" width="13" height="13" />{dt('Read the docs')}</a>
    </div>
    <p class="sx-lead">{dt('Give a role when a member reaches a number of messages: all of them since the first rule, or only the ones of the last days. Petto counts from the moment you add the first rule, and gives the role right after the message that reaches the number.')}</p>

    {saved && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
    {problem && <div class="sx-flash sx-flash-bad" role="alert"><Icon name="ph:warning-fill" width="15" height="15" />{problem}</div>}
    {!ready && <div class="sx-flash sx-flash-warn"><Icon name="ph:plug-fill" width="15" height="15" />{dt('Message roles are not available yet. Petto is being updated: try again in a few minutes.')}</div>}

    <DashStatTiles tiles={[
      { label: dt('Rules'), value: rules.length, tone: 'messages' },
      { label: dt('On'), value: on, tone: 'joins' },
    ]} />

    <div class="mr-cols">
      <section class="sx-panel mr-box">
        <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--blue)"><Icon name="ph:chat-circle-text-fill" width="17" height="17" /></span><h2>{dt('Rules')}</h2>{rules.length > 0 && <span class="sx-tag">{rules.length}/{max}</span>}</div>
        {rules.length === 0 && <p class="mr-empty"><Icon name="ph:chat-circle-text-fill" width="22" height="22" />{dt('No rules yet. Add the first one.')}</p>}
        {rules.length > 0 && (
          <div class="sx-list mr-list dgl-stagger">
            {rules.map((rule) => (
              <div class:list={['sx-row', 'mr-row', { 'mr-off': !rule.enabled }]}>
                <span class="mr-count"><b>{rule.messages.toLocaleString('en-US')}</b><em>{dt('messages')}</em></span>
                <span class="mr-what">
                  <span class="mr-line">{dt('Gives')} <b>{name(rule.roleId)}</b></span>
                  <span class="mr-tags">
                    <span class="sx-tag">{rule.mode === 'period' ? dt('In the last {n} days', { n: rule.periodDays }) : dt('All time')}</span>
                    {rule.removeBelow && <span class="sx-tag">{dt('Taken away if under')}</span>}
                  </span>
                </span>
                <form method="POST" data-no-dirty class="mr-act">
                  <input type="hidden" name="action" value="toggle" /><input type="hidden" name="rule_id" value={rule.id} />
                  <label class="sx-switch mr-switch" title={rule.enabled ? dt('On') : dt('Off')}><input type="checkbox" name="enabled" role="switch" checked={rule.enabled} aria-label={dt('On')} data-auto-submit /><span class="sx-toggle"></span></label>
                </form>
                <form method="POST" data-no-dirty class="mr-act">
                  <input type="hidden" name="action" value="remove" /><input type="hidden" name="rule_id" value={rule.id} />
                  <button type="submit" class="sx-iconbtn" aria-label={dt('Remove')} title={dt('Remove')}><Icon name="ph:trash-fill" width="15" height="15" /></button>
                </form>
              </div>
            ))}
          </div>
        )}
      </section>

      <form method="POST" class="sx-panel mr-box" data-no-dirty data-mr-form>
        <input type="hidden" name="action" value="add" />
        <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--green)"><Icon name="ph:plus-circle-fill" width="17" height="17" /></span><h2>{dt('Add a rule')}</h2></div>
        <div class="sx-field"><label for="mr-role">{dt('Role to give')}</label>
          <select id="mr-role" name="role_id" required data-give-role data-fill="mr-roles" disabled={!ready}><option value="" disabled selected>{dt('Role')}</option></select>
        </div>
        <div class="sx-field"><label for="mr-messages">{dt('Number of messages')}</label>
          <input id="mr-messages" type="number" name="messages" min="1" max="10000000" value="100" required disabled={!ready} />
        </div>
        <div class="sx-field"><span class="sx-label" id="mr-mode-l">{dt('Which messages count')}</span>
          <div class="dfx-chips" role="radiogroup" aria-labelledby="mr-mode-l">
            <label class="dfx-chip"><input type="radio" name="mode" value="total" checked data-mr-mode />{dt('All time')}</label>
            <label class="dfx-chip"><input type="radio" name="mode" value="period" data-mr-mode />{dt('Only the last days')}</label>
          </div>
        </div>
        <div class="sx-field" data-mr-period hidden><label for="mr-days">{dt('Days of the period')}</label>
          <input id="mr-days" type="number" name="period_days" min="1" max="365" value="30" disabled={!ready} />
        </div>
        <label class="sx-switch mr-below" data-mr-period hidden><input type="checkbox" name="remove_below" role="switch" /><span class="sx-toggle"></span><span>{dt('Take the role away if the member falls under the number')}</span></label>
        <p class="sx-hint">{dt("Petto's role has to be above the role it gives or takes away.")}</p>
        <div class="sx-foot"><button type="submit" class="btn btn-accent btn-sm" disabled={!ready || rules.length >= max}><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add')}</button></div>
      </form>
    </div>
  </div>
  <SelectSource name="mr-roles" items={roles.map((role) => ({ id: role.id, name: role.name }))} />
  <script is:inline>
    // The switch of a rule saves at once (it is a small form of its own). The days and the switch of the period only show when the period is chosen.
    document.addEventListener('change', function (event) {
      var box = event.target && event.target.closest ? event.target.closest('input[data-auto-submit]') : null;
      if (box && box.form) { if (box.form.requestSubmit) box.form.requestSubmit(); else box.form.submit(); }
      var mode = event.target && event.target.matches ? event.target.matches('input[data-mr-mode]') : false;
      if (mode) {
        var form = event.target.closest('form');
        var period = event.target.value === 'period';
        form.querySelectorAll('[data-mr-period]').forEach(function (el) { el.hidden = !period; });
      }
    });
  </script>
  <DashFormKit />
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0; }
  .mr { max-width: 1040px; }
  .mr-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
  .mr :global(.sx-lead) { margin-bottom: 16px; }
  .mr :global(.sx-field input[type=number]) { border: 1px solid var(--border); border-radius: 9px; padding: 9px 11px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; width: 100%; box-sizing: border-box; }
  .mr :global([hidden]) { display: none !important; }
  .mr-switch.sx-switch { flex: none; width: 40px; height: 24px; padding: 0; gap: 0; border: 0; border-radius: 999px; background: none; }
  .mr-switch.sx-switch:hover { background: none; }
  .mr-below { display: flex; align-items: center; gap: 10px; font-size: 13px; cursor: pointer; }
  .mr-cols { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 14px; align-items: start; }
  .mr-box { gap: 12px; }
  .mr-list { display: flex; flex-direction: column; gap: 8px; }
  .mr-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; gap: 12px; align-items: center; transition: opacity .25s ease; }
  .mr-row.mr-off { opacity: .6; }
  .mr-count { display: grid; place-items: center; min-width: 64px; padding: 6px 8px; border-radius: 10px; background: color-mix(in srgb, #6fb7f2 14%, transparent); }
  .mr-count b { font-size: 18px; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .mr-count em { font-style: normal; font-size: 10.5px; color: var(--text-dim); }
  .mr-what { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .mr-line { font-size: 13.5px; overflow-wrap: anywhere; }
  .mr-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .mr-act { margin: 0; }
  .mr-empty { display: flex; align-items: center; gap: 10px; margin: 0; padding: 18px 14px; border: 1px dashed var(--border); border-radius: 12px; color: var(--text-dim); font-size: 13.5px; }
  .mr-empty :global(svg) { flex: none; color: #6fb7f2; }
  @media (max-width: 900px) { .mr-cols { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 520px) { .mr-row { gap: 8px; } .mr-count { min-width: 54px; } }
</style>
