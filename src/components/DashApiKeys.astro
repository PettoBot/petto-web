---
// Petto API (/dash/api): Vetox-inspired layout for Petto's personal read-only API.
// A person makes up to three keys for the read-only API and removes them. A key is shown once, when it is made; only its hash is kept.
import { Icon } from 'astro-icon/components';
import DashMeLayout from './DashMeLayout.astro';
import DashPanelHead from './DashPanelHead.astro';
import DashShopAdminShared from './DashShopAdminShared.astro';
import { getDashLang, makeT } from '../i18n/dash';
import type { Session } from '../utils/session';

interface KeyRow { id: number; label: string; createdAt: string; lastUsed: string | null }
interface Props { user: Session; data: { keys: KeyRow[]; max: number } | null; origin: string }
const { user, data, origin } = Astro.props;
const lang = getDashLang(Astro);
const dt = makeT(lang);
const date = new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'short', year: 'numeric' });

const DOCS_URL: Record<'en' | 'es' | 'pt-BR', string> = {
  en: 'https://wiki.petto.sbs/user/api',
  es: 'https://wiki.petto.sbs/es/user/api',
  'pt-BR': 'https://wiki.petto.sbs/pt-br/user/api',
};
const docsHref = DOCS_URL[lang];

const COPY = {
  en: {
    title: 'Petto API',
    docs: 'Documentation',
    heroTitle: 'Build on Petto',
    heroSub: 'Read your ceramos balance, personal plan, wallet movements and packs from your own apps. Read-only, up to 60 reads a minute per key.',
    placeholder: 'Key name (e.g. Portfolio widget)',
    copy: 'Copy',
    copied: 'Copied',
    keysTitle: 'Your API keys',
    keysCount: '{n} of {max} keys',
    buildTitle: 'What you can build',
    features: [
      { icon: 'ph:coins-fill', title: 'Balance and plan', desc: 'Read your current ceramos balance and active plan via /api/v1/me.' },
      { icon: 'ph:clock-counter-clockwise-fill', title: 'Movement history', desc: 'Fetch the last 50 ceramos movements from /api/v1/movements.' },
      { icon: 'ph:package-fill', title: 'Public packs catalog', desc: 'Query available ceramos packs via /api/v1/packs with no key needed.' },
      { icon: 'ph:key-fill', title: 'Read-only API keys', desc: 'Keys only read your own data and can never modify anything.' },
    ],
    howTitle: 'How it works',
    steps: [
      { title: 'Create a key', desc: 'Give your key a name so you remember what app uses it.' },
      { title: 'Copy it once', desc: 'Your key is shown only once; only its hash is stored.' },
      { title: 'Send the header', desc: 'Pass Authorization: Bearer YOUR_KEY on every request.' },
      { title: 'Start building', desc: 'Call the endpoints and manage or revoke keys here anytime.' },
    ],
    quickTitle: 'Quick start',
    rateNote: 'Rate limit: 60 reads per minute for each key.',
  },
  es: {
    title: 'Petto API',
    docs: 'Documentación',
    heroTitle: 'Construye con Petto',
    heroSub: 'Lee tu saldo de céramos, tu plan personal, movimientos y paquetes desde tus propios programas. Solo lectura, hasta 60 consultas por minuto por clave.',
    placeholder: 'Nombre de la clave (ej. Mi web)',
    copy: 'Copiar',
    copied: 'Copiada',
    keysTitle: 'Tus claves de API',
    keysCount: '{n} de {max} claves',
    buildTitle: 'Qué puedes construir',
    features: [
      { icon: 'ph:coins-fill', title: 'Saldo y plan', desc: 'Consulta tus céramos y tu plan activo desde /api/v1/me.' },
      { icon: 'ph:clock-counter-clockwise-fill', title: 'Historial de movimientos', desc: 'Obtén los últimos 50 movimientos de tu billetera en /api/v1/movements.' },
      { icon: 'ph:package-fill', title: 'Catálogo público de paquetes', desc: 'Lee los paquetes de céramos en /api/v1/packs sin necesidad de clave.' },
      { icon: 'ph:key-fill', title: 'Claves de solo lectura', desc: 'Solo leen tus propios datos y nunca pueden modificar nada.' },
    ],
    howTitle: 'Cómo funciona',
    steps: [
      { title: 'Crea una clave', desc: 'Ponle un nombre para recordar qué proyecto la usa.' },
      { title: 'Cópiala una vez', desc: 'Se muestra una sola vez; solo guardamos su hash.' },
      { title: 'Envía el encabezado', desc: 'Usa Authorization: Bearer TU_CLAVE en cada petición.' },
      { title: 'Empieza a construir', desc: 'Consulta los endpoints y administra tus claves aquí.' },
    ],
    quickTitle: 'Inicio rápido',
    rateNote: 'Límite: 60 lecturas por minuto por cada clave.',
  },
  'pt-BR': {
    title: 'Petto API',
    docs: 'Documentação',
    heroTitle: 'Construa com o Petto',
    heroSub: 'Leia seu saldo de céramos, plano pessoal, movimentações e pacotes nos seus próprios aplicativos. Somente leitura, até 60 leituras por minuto por chave.',
    placeholder: 'Nome da chave (ex. Meu site)',
    copy: 'Copiar',
    copied: 'Copiada',
    keysTitle: 'Suas chaves de API',
    keysCount: '{n} de {max} chaves',
    buildTitle: 'O que você pode construir',
    features: [
      { icon: 'ph:coins-fill', title: 'Saldo e plano', desc: 'Leia seus céramos atuais e seu plano ativo via /api/v1/me.' },
      { icon: 'ph:clock-counter-clockwise-fill', title: 'Histórico de movimentações', desc: 'Busque as últimas 50 movimentações em /api/v1/movements.' },
      { icon: 'ph:package-fill', title: 'Catálogo público de pacotes', desc: 'Consulte pacotes de céramos em /api/v1/packs sem precisar de chave.' },
      { icon: 'ph:key-fill', title: 'Chaves somente leitura', desc: 'As chaves leem apenas seus próprios dados e nunca alteram nada.' },
    ],
    howTitle: 'Como funciona',
    steps: [
      { title: 'Crie uma chave', desc: 'Dê um nome para lembrar qual app usa esta chave.' },
      { title: 'Copie uma vez', desc: 'Sua chave aparece apenas uma vez; guardamos só o hash.' },
      { title: 'Envie o cabeçalho', desc: 'Passe Authorization: Bearer SUA_CHAVE em cada requisição.' },
      { title: 'Comece a construir', desc: 'Chame os endpoints e gerencie ou remova chaves aqui.' },
    ],
    quickTitle: 'Início rápido',
    rateNote: 'Limite: 60 leituras por minuto para cada chave.',
  },
}[lang];

const ui = {
  down: dt('Petto did not answer. Try again in a moment.'),
  working: dt('Working…'),
  copy: COPY.copy,
  copied: COPY.copied,
  errors: {
    too_many: dt('You already have the most keys. Remove one first.'),
    failed: dt('It could not be done. Try again in a moment.'),
  },
};
const boot = JSON.stringify({ ui }).replace(/</g, '\\u003c');
const curlSnippet = `curl ${origin}/api/v1/me \\\n  -H "Authorization: Bearer YOUR_KEY"`;
---
<DashMeLayout user={user} active="api" pageTitle={COPY.title}>
  <DashShopAdminShared />
  <DashPanelHead title={COPY.title} eyebrow={dt('Account')} icon="ph:code-fill" back={false}>
    <a class="btn ak-docs-btn" href={docsHref} target="_blank" rel="noopener">
      <Icon name="ph:book-open-fill" width="15" height="15" />
      {COPY.docs}
      <Icon name="ph:arrow-up-right-bold" width="13" height="13" />
    </a>
  </DashPanelHead>

  {!data && <p class="be-down" role="alert">{ui.down}</p>}
  {data && (
    <div class="ak" id="be" data-boot={boot}>
      <div class="ak-hero-card">
        <div class="ak-hero-banner">
          <div class="ak-hero-copy">
            <h2>{COPY.heroTitle}</h2>
            <p>{COPY.heroSub}</p>
          </div>
          <div class="ak-hero-badge" aria-hidden="true">
            <Icon name="ph:code-fill" width="42" height="42" />
          </div>
        </div>

        <form class="ak-create-bar" id="be-form" autocomplete="off">
          <div class="ak-create-row">
            <input class="ak-input" name="label" maxlength="40" placeholder={COPY.placeholder} aria-label={dt('Name (to remember what it is for)')} />
            <button type="submit" class="btn be-save ak-create-btn" id="be-save" disabled={data.keys.length >= data.max}>
              <Icon name="ph:plus-bold" width="14" height="14" />
              {dt('Make key')}
            </button>
          </div>
          <div class="ak-new" id="ak-new" hidden>
            <div class="ak-new-top">
              <p>{dt('This is your key. Copy it now: it is shown only once.')}</p>
              <button type="button" class="btn ak-copy-btn" id="ak-copy-key">{COPY.copy}</button>
            </div>
            <code id="ak-key"></code>
          </div>
          <p class="be-msg" id="be-msg" role="status" hidden></p>
        </form>
      </div>

      <div class="ak-section">
        <div class="ak-sec-head">
          <h2>{COPY.keysTitle}</h2>
          <span class="ak-count">{COPY.keysCount.replace('{n}', String(data.keys.length)).replace('{max}', String(data.max))}</span>
        </div>
        <div class="ak-keys-card">
          {data.keys.length === 0 ? (
            <p class="ak-empty">{dt('You have no keys yet.')}</p>
          ) : (
            <div class="ak-keys-list">
              {data.keys.map((row) => (
                <article class="ak-key-row">
                  <span class="ak-key-icon"><Icon name="ph:key-fill" width="16" height="16" /></span>
                  <div class="be-info">
                    <strong>{row.label || dt('Key {n}', { n: String(row.id) })}</strong>
                    <span class="be-meta">
                      <span>{dt('Made {date}', { date: date.format(new Date(row.createdAt)) })}</span>
                      <span>{row.lastUsed ? dt('Last used {date}', { date: date.format(new Date(row.lastUsed)) }) : dt('Never used')}</span>
                    </span>
                  </div>
                  <div class="be-actions">
                    <button type="button" class="btn be-off" data-remove={row.id}>{dt('Remove')}</button>
                  </div>
                </article>
              ))}
            </div>
          )}
        </div>
      </div>

      <div class="ak-section">
        <h2 class="ak-sec-title">{COPY.buildTitle}</h2>
        <div class="ak-feat-grid">
          {COPY.features.map((feat) => (
            <article class="ak-feat-card">
              <span class="ak-feat-well"><Icon name={feat.icon} width="20" height="20" /></span>
              <h3>{feat.title}</h3>
              <p>{feat.desc}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="ak-how-card">
        <h2>{COPY.howTitle}</h2>
        <ol class="ak-steps">
          {COPY.steps.map((step, i) => (
            <li class="ak-step">
              <div class="ak-step-top">
                <span class="ak-step-num">{i + 1}</span>
                {i < COPY.steps.length - 1 && <span class="ak-step-line" aria-hidden="true"></span>}
              </div>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="ak-how-card ak-quick">
        <div class="ak-sec-head">
          <h2>{COPY.quickTitle}</h2>
          <button type="button" class="btn ak-copy-btn" id="ak-copy-curl">{COPY.copy}</button>
        </div>
        <pre class="ak-code" id="ak-curl">{curlSnippet}</pre>
        <p class="ak-rate">{COPY.rateNote}</p>
      </div>
    </div>
  )}
</DashMeLayout>

<style is:global>
  .ak { display: flex; flex-direction: column; gap: 22px; }
  .ak-docs-btn { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; padding: 7px 13px; border-radius: 10px; border: 1px solid var(--border); background: color-mix(in srgb, var(--text) 4%, transparent); text-decoration: none; }
  .ak-docs-btn:hover { background: color-mix(in srgb, var(--text) 8%, transparent); }

  /* Hero card — Vetox Vito API structure with Petto's warm peach/indigo glow */
  .ak-hero-card { display: flex; flex-direction: column; gap: 14px; padding: 14px; border-radius: 18px; border: 1px solid var(--border); background: var(--card); }
  .ak-hero-banner {
    position: relative; display: flex; align-items: center; justify-content: space-between; gap: 20px;
    min-height: 156px; padding: 24px 26px; border-radius: 13px; overflow: hidden;
    background:
      radial-gradient(620px 260px at 14% 20%, rgba(240, 168, 143, 0.42), transparent 65%),
      radial-gradient(520px 260px at 88% 80%, rgba(155, 208, 245, 0.34), transparent 68%),
      linear-gradient(130deg, #271b2e 0%, #1d2238 55%, #191a24 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .ak-hero-copy { max-width: 56ch; display: flex; flex-direction: column; gap: 8px; }
  .ak-hero-copy h2 { margin: 0; font-size: clamp(22px, 3vw, 28px); font-weight: 700; color: #fff; letter-spacing: -0.02em; }
  .ak-hero-copy p { margin: 0; font-size: 14px; line-height: 1.5; color: rgba(255, 255, 255, 0.82); }
  .ak-hero-badge {
    flex: none; width: 78px; height: 78px; border-radius: 18px;
    display: grid; place-items: center;
    background: rgba(255, 255, 255, 0.14); color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(8px);
  }
  .ak-create-bar { display: flex; flex-direction: column; gap: 10px; }
  .ak-create-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .ak-input {
    flex: 1 1 240px; height: 40px; padding: 0 13px; border-radius: 10px;
    border: 1px solid var(--border); background: color-mix(in srgb, var(--text) 4%, transparent);
    color: var(--text); font: inherit; font-size: 13.5px; min-width: 0;
  }
  .ak-create-btn { height: 40px; padding: 0 16px; border-radius: 10px; display: inline-flex; align-items: center; gap: 7px; font-weight: 600; }

  .ak-new { padding: 14px 16px; border-radius: 12px; background: var(--green-soft); color: var(--green-text); border: 1px solid color-mix(in srgb, var(--green) 32%, transparent); }
  .ak-new-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; flex-wrap: wrap; }
  .ak-new p { margin: 0; font-size: 13.5px; font-weight: 500; }
  .ak-new code { display: block; word-break: break-all; user-select: all; font-family: var(--mono); font-size: 13px; color: var(--text); padding: 8px 10px; border-radius: 8px; background: rgba(0, 0, 0, 0.25); }
  .ak-copy-btn { padding: 5px 12px; font-size: 12.5px; border-radius: 8px; border: 1px solid var(--border); background: color-mix(in srgb, var(--text) 6%, transparent); }

  /* Sections */
  .ak-section { display: flex; flex-direction: column; gap: 12px; }
  .ak-sec-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .ak-sec-head h2, .ak-sec-title, .ak-how-card h2 { margin: 0; font-size: 17px; font-weight: 600; }
  .ak-count { font-family: var(--mono); font-size: 12px; color: var(--text-dim); padding: 3px 9px; border-radius: 999px; border: 1px solid var(--border-soft); background: color-mix(in srgb, var(--text) 3%, transparent); }

  /* Keys list */
  .ak-keys-card { border-radius: 16px; border: 1px solid var(--border); background: var(--card); overflow: hidden; }
  .ak-empty { margin: 0; padding: 18px 20px; color: var(--text-muted); font-size: 13.5px; }
  .ak-keys-list { display: flex; flex-direction: column; }
  .ak-key-row { display: flex; align-items: center; gap: 14px; padding: 14px 18px; flex-wrap: wrap; }
  .ak-key-row + .ak-key-row { border-top: 1px solid var(--border-soft); }
  .ak-key-icon { flex: none; width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); }

  /* 2x2 Feature grid — Vetox "What you can build" */
  .ak-feat-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .ak-feat-card {
    display: flex; flex-direction: column; gap: 10px; padding: 18px 20px;
    border-radius: 16px; border: 1px solid var(--border); background: var(--card);
  }
  .ak-feat-well {
    width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center;
    background: color-mix(in srgb, var(--accent) 14%, var(--bg)); color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .ak-feat-card h3 { margin: 2px 0 0; font-family: var(--sans); font-size: 15px; font-weight: 600; color: var(--text); }
  .ak-feat-card p { margin: 0; font-size: 13.5px; line-height: 1.5; color: var(--text-muted); }

  /* 4-step Horizontal Stepper — Vetox "How it works" */
  .ak-how-card { display: flex; flex-direction: column; gap: 16px; padding: 20px; border-radius: 16px; border: 1px solid var(--border); background: var(--card); }
  .ak-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  .ak-step { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .ak-step-top { display: flex; align-items: center; gap: 10px; }
  .ak-step-num {
    flex: none; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center;
    font-family: var(--mono); font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums;
    background: color-mix(in srgb, var(--text) 7%, var(--bg)); color: var(--text);
    border: 1px solid var(--border);
  }
  .ak-step-line { flex: 1; height: 1px; background: var(--border); }
  .ak-step h3 { margin: 2px 0 0; font-family: var(--sans); font-size: 14.5px; font-weight: 600; color: var(--text); }
  .ak-step p { margin: 0; font-size: 13px; line-height: 1.5; color: var(--text-muted); }

  /* Quick start */
  .ak-code { margin: 0; padding: 14px 16px; border-radius: 11px; overflow-x: auto; background: color-mix(in srgb, var(--text) 5%, var(--bg)); border: 1px solid var(--border-soft); font-family: var(--mono); font-size: 13px; line-height: 1.55; color: var(--text); }
  .ak-rate { margin: -4px 0 0; font-size: 12.5px; color: var(--text-dim); }

  @media (max-width: 860px) {
    .ak-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ak-step-line { display: none; }
  }
  @media (max-width: 640px) {
    .ak-hero-badge { display: none; }
    .ak-feat-grid, .ak-steps { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  const root = document.getElementById('be');
  const form = document.getElementById('be-form') as HTMLFormElement | null;
  if (root?.dataset.boot && form) {
    const { ui } = JSON.parse(root.dataset.boot) as { ui: any };
    const msg = document.getElementById('be-msg') as HTMLElement;
    const say = (text: string, level: 'ok' | 'error') => { msg.hidden = false; msg.textContent = text; msg.className = `be-msg is-${level}`; };
    const send = async (action: string, body: unknown) => {
      const response = await fetch(`/dash/api-act?action=${action}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      const data = await response.json().catch(() => null);
      return { ok: Boolean(response.ok && data?.ok), data };
    };
    const why = (data: any) => (data?.error === 'down' ? ui.down : (ui.errors[data?.error ?? 'failed'] ?? ui.errors.failed));
    const bindCopy = (btnId: string, sourceId: string) => {
      const btn = document.getElementById(btnId);
      btn?.addEventListener('click', async () => {
        const text = document.getElementById(sourceId)?.textContent?.trim() ?? '';
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = ui.copied;
          setTimeout(() => { btn.textContent = ui.copy; }, 1600);
        } catch { /* clipboard unavailable */ }
      });
    };
    bindCopy('ak-copy-key', 'ak-key');
    bindCopy('ak-copy-curl', 'ak-curl');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = document.getElementById('be-save') as HTMLButtonElement; button.disabled = true; say(ui.working, 'ok');
      const out = await send('create', { label: (form.elements.namedItem('label') as HTMLInputElement).value });
      if (out.ok && out.data?.key) {
        msg.hidden = true;
        (document.getElementById('ak-key') as HTMLElement).textContent = out.data.key;
        (document.getElementById('ak-new') as HTMLElement).hidden = false;
      } else { button.disabled = false; say(why(out.data), 'error'); }
    });
    document.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((button) => button.addEventListener('click', async () => {
      button.disabled = true;
      const out = await send('remove', { id: Number(button.dataset.remove) });
      if (out.ok) location.reload(); else { button.disabled = false; say(why(out.data), 'error'); }
    }));
  }
</script>
