---
// Privacy and session (/dash/privacy): what Petto keeps about the login of the account, where it is kept, and the ways out (log out, the
// history page, the privacy policy). Everything written here is what the site's own privacy and cookie pages already say about the
// dashboard session; the only live values are the account's own name, id and when Discord's access key runs out.
import { Icon } from 'astro-icon/components';
import DashMeLayout from './DashMeLayout.astro';
import { dashLocale, getDashLang, makeT } from '../i18n/dash';
import { localePath } from '../i18n/ui';
import type { Session } from '../utils/session';

interface Props { user: Session }
const { user } = Astro.props;
const lang = getDashLang(Astro);
const dt = makeT(lang);
const locale = dashLocale(lang);
const base = localePath[lang];
const until = Number.isFinite(user.expiresAt) && user.expiresAt > 0 ? new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(user.expiresAt)) : null;
const handle = user.handle && user.handle !== user.username ? user.handle : null;
const kept = [
  dt('Your Discord ID, name and @username.'),
  dt('Your avatar, banner and accent color, and the avatar decoration and nameplate you wear.'),
  dt('The access key Discord gave Petto for this login, so it can ask Discord for your servers.'),
];
const browser = [
  { icon: 'ph:cookie-fill', name: 'petto_lang', text: dt('Your dashboard language. A cookie, 1 year.') },
  { icon: 'ph:palette-fill', name: 'petto-theme', text: dt('Your theme, dark or light. Kept only in this browser.') },
  { icon: 'ph:sort-ascending-fill', name: 'petto-dash-server-sort', text: dt('How you sort your list of servers. Kept only in this browser.') },
];
const links = [
  { icon: 'ph:shield-check-fill', href: `${base}/privacy`, title: dt('Privacy Policy'), text: dt('What Petto stores, why, and your rights to see, correct or delete it.'), external: false },
  { icon: 'ph:cookie-fill', href: `${base}/cookies`, title: dt('Cookies'), text: dt('Every cookie and browser setting of this site, one by one.'), external: false },
  { icon: 'ph:clock-counter-clockwise', href: '/dash/history', title: dt('Your name history'), text: dt('See the names Petto saved, delete them, or stop it from saving them.'), external: false, sk: 'list' },
  { icon: 'ph:headset-fill', href: 'https://petto.sbs/support', title: dt('Ask for your data to be deleted'), text: dt('Open a ticket in the support server and say what you want removed.'), external: true },
];
---
<DashMeLayout user={user} active="privacy" pageTitle="Privacy and session">
  <header class="ac-head">
    <h1>{dt('Privacy and session')}</h1>
    <p>{dt('What Petto keeps about your login, where it is kept, and how to leave.')}</p>
  </header>

  <div class="ac-grid">
    <section class="ac-card">
      <div class="ac-card-head"><h2><Icon name="ph:key-fill" width="16" height="16" />{dt('This session')}</h2></div>
      <dl class="ac-rows">
        <div><dt>{dt('Signed in as')}</dt><dd>{user.username}{handle && <small>@{handle}</small>}</dd></div>
        <div><dt>{dt('Discord ID')}</dt><dd><code class="ac-code">{user.userId}</code></dd></div>
        {until && <div><dt>{dt('Discord access key until')}</dt><dd>{until}<small>{dt('It renews by itself while you visit.')}</small></dd></div>}
        <div><dt>{dt('Login cookie')}</dt><dd>petto_session<small>{dt('7 days from its last renewal')}</small></dd></div>
      </dl>
      <div class="ac-btns"><a class="btn btn-ghost btn-sm" href="/dash/logout"><Icon name="ph:sign-out-fill" width="13" height="13" />{dt('Log out')}</a></div>
    </section>

    <section class="ac-card">
      <div class="ac-card-head"><h2><Icon name="ph:lock-key-fill" width="16" height="16" />{dt('What the login cookie holds')}</h2></div>
      <ul class="ac-list">
        {kept.map((item) => <li><Icon name="ph:check-bold" width="13" height="13" /><span>{item}</span></li>)}
        <li><Icon name="ph:x-bold" width="13" height="13" class="pv-no" /><span><b>{dt('Never your email.')}</b> {dt('It is encrypted, HttpOnly (scripts cannot read it) and only sent over HTTPS.')}</span></li>
      </ul>
      <p class="ac-muted pv-note"><Icon name="ph:info-fill" width="14" height="14" /><span>{dt('Logging out removes the cookie. To also take Petto off your Discord account, remove it in Discord under Settings, Authorized Apps.')}</span></p>
    </section>

    <section class="ac-card ac-wide">
      <div class="ac-card-head"><h2><Icon name="ph:browser-fill" width="16" height="16" />{dt('What this browser remembers')}</h2></div>
      <ul class="pv-browser">
        {browser.map((item) => <li><Icon name={item.icon} width="18" height="18" /><div><code class="ac-code">{item.name}</code><span>{item.text}</span></div></li>)}
      </ul>
      <p class="ac-muted pv-note"><Icon name="ph:info-fill" width="14" height="14" /><span>{dt('No tracking cookies, no analytics, no ads.')}</span></p>
    </section>

    <section class="ac-card ac-wide">
      <div class="ac-card-head"><h2><Icon name="ph:hand-heart-fill" width="16" height="16" />{dt('Your data and your choices')}</h2></div>
      <ul class="pv-links">
        {links.map((l) => (
          <li>
            <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined} data-sk={l.sk}>
              <span class="pv-ic"><Icon name={l.icon} width="18" height="18" /></span>
              <span class="pv-tx"><strong>{l.title}</strong><small>{l.text}</small></span>
              <Icon name={l.external ? 'ph:arrow-up-right-bold' : 'ph:caret-right-bold'} width="13" height="13" class="pv-go" />
            </a>
          </li>
        ))}
      </ul>
      <p class="ac-muted pv-note"><Icon name="ph:info-fill" width="14" height="14" /><span>{dt('Do not want your messages counted in statistics? Write !stats privacy in any server and press Do not count me.')}</span></p>
    </section>
  </div>
</DashMeLayout>

<style>
  .pv-note { display: flex; gap: 8px; align-items: flex-start; margin-top: auto; padding-top: 14px; font-size: 13px; }
  .pv-note :global(svg) { flex: none; margin-top: 2px; color: var(--text-dim); }
  .ac-list :global(.pv-no) { color: var(--red); }
  .pv-browser { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .pv-browser li { display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; border: 1px solid var(--border-soft); border-radius: 13px; background: color-mix(in srgb, var(--text) 3%, transparent); min-width: 0; }
  .pv-browser li > :global(svg) { flex: none; margin-top: 2px; color: var(--accent); }
  .pv-browser li div { display: flex; flex-direction: column; gap: 6px; min-width: 0; align-items: flex-start; }
  .pv-browser code { max-width: 100%; overflow-wrap: anywhere; }
  .pv-browser span { color: var(--text-muted); font-size: 13px; line-height: 1.45; }
  .pv-links { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .pv-links a { display: flex; align-items: center; gap: 13px; height: 100%; box-sizing: border-box; padding: 12px 14px; border: 1px solid var(--border-soft); border-radius: 13px; color: var(--text); text-decoration: none; transition: background-color var(--m-fast) ease, border-color var(--m-fast) ease; }
  .pv-links a:hover { background: var(--card-hover); border-color: var(--border); }
  .pv-links a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .pv-ic { flex: none; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 11px; background: var(--accent-soft); color: var(--accent); }
  .pv-tx { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
  .pv-tx strong { font-size: 14px; }
  .pv-tx small { color: var(--text-muted); font-size: 12.5px; line-height: 1.4; }
  .pv-links :global(.pv-go) { flex: none; color: var(--text-dim); }
  .pv-links a:hover :global(.pv-go) { color: var(--accent); }
  @media (max-width: 960px) { .pv-browser { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 720px) { .pv-links { grid-template-columns: minmax(0, 1fr); } }
</style>
