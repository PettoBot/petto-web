---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import PremiumGate from './PremiumGate.astro';
import ColorPicker from './ColorPicker.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import { renderMarkdown } from '../utils/discordPreview';
import { NAME_FONTS, NAME_EFFECTS, NAME_FONT_STACKS, DEFAULT_NAME_STYLE, intToHex, nameStyleCss, type NameStyle } from '../utils/nameStyle';
import { avatarPresetGroups, bannerPresetGroups } from '../utils/customizePresets';

import { getDashLang, makeT } from '../i18n/dash';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  nickname: string;
  avatarUrl: string;
  effectiveAvatar: string;
  botUsername: string;
  bannerUrl: string;
  effectiveBanner: string | null;
  description: string;
  effectiveDescription: string;
  globalUsername: string;
  globalAvatar: string | null;
  globalBanner: string | null;
  globalDescription: string;
  saved: boolean;
  discordWarning?: boolean;
  error?: string | null;
  premiumActive: boolean;
  nameStyle?: NameStyle | null;
}
const {
  user, guildId, guildName, guildIcon,
  nickname, avatarUrl, effectiveAvatar,
  botUsername, bannerUrl, effectiveBanner,
  description, effectiveDescription,
  globalUsername, globalAvatar, globalBanner, globalDescription,
  saved, discordWarning, error, premiumActive, nameStyle = null,
} = Astro.props;

const errorMessages: Record<string, string> = {
  avatar_too_large: dt('That image is too big, Discord\'s limit is small, try something under 2MB.'),
  avatar_fetch_failed: dt('Couldn\'t fetch that image, make sure it\'s a direct link or a valid image file.'),
  banner_too_large: dt('That banner is too big, try something under 2MB.'),
  banner_fetch_failed: dt('Couldn\'t fetch that banner, make sure it\'s a direct link or a valid image file.'),
  discord_rejected: dt('Couldn\'t save, try again in a moment.'),
  name_style_invalid: dt('Pick a font, an effect and valid colors for the name style.'),
  name_style_rejected: dt('Discord did not accept this name style. It may not be available for bots yet, nothing was changed.'),
};

const previewName = nickname || botUsername;
const styleForm = nameStyle ?? DEFAULT_NAME_STYLE;
const styleColors = [intToHex(styleForm.colors[0] ?? DEFAULT_NAME_STYLE.colors[0]), intToHex(styleForm.colors[1] ?? DEFAULT_NAME_STYLE.colors[1])];
const effectColorCount = Object.fromEntries(NAME_EFFECTS.map((effect) => [effect.id, effect.colors]));
const nameCss = nameStyleCss(nameStyle);
const previewDescHtml = renderMarkdown(effectiveDescription);
const globalDescHtml = renderMarkdown(globalDescription);
// What is set in this server: the saved link, or what Discord shows when it is not the bot's own profile (a picture that was uploaded keeps no link).
const defaultAvatar = globalAvatar ?? '/assets/mascot-icon.webp';
const customAvatar = Boolean(avatarUrl) || Boolean(globalAvatar && effectiveAvatar !== globalAvatar);
const customBanner = Boolean(bannerUrl) || Boolean(effectiveBanner && effectiveBanner !== globalBanner);
const avatarGroups = avatarPresetGroups();
const bannerGroups = bannerPresetGroups(globalBanner);
const pickerWords = {
  avatar: dt('Select server avatar'),
  banner: dt('Select server banner'),
  upload: dt('Upload from device'),
  uploadHint: dt('A picture, under 2MB.'),
  or: dt('Or import a link'),
  import: dt('Import'),
  samples: dt('Sample images'),
  close: dt('Close'),
};
const fontStack = NAME_FONT_STACKS[styleForm.fontId] ?? 'inherit';
const nameFontCss = nameStyle ? `font-family:${fontStack};` : '';
const effectName = nameStyle ? NAME_EFFECTS.find((effect) => effect.id === nameStyle.effectId)?.label : null;
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="customize" pageTitle="Customize" premiumActive={premiumActive}>
  <DashSettingsKit />
  <DashFormKit />
  <div class="sx-page cz-root">
  <h1>{dt('Customize')}</h1>

  <div class="cz-flashes">
    {saved && <div class="sx-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
    {discordWarning && <div class="sx-flash sx-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('Discord didn\'t accept the profile sync, it\'ll retry next save.')}</div>}
    {error && <div class="sx-flash sx-flash-bad" role="alert"><Icon name="ph:warning-fill" width="15" height="15" />{errorMessages[error] ?? dt('Something went wrong, try again.')}</div>}
  </div>

  <div class="cz-tiles"><DashStatTiles tiles={[
    { label: dt('Custom nickname'), value: 0, text: nickname ? dt('Yes') : dt('No'), tone: 'messages' },
    { label: dt('Custom avatar'), value: 0, text: customAvatar ? dt('Yes') : dt('No'), tone: 'voice' },
    { label: dt('Custom banner'), value: 0, text: customBanner ? dt('Yes') : dt('No'), tone: 'joins' },
    { label: dt('Custom description'), value: 0, text: description ? dt('Yes') : dt('No'), tone: 'reactions' },
    { label: dt('Name style'), value: 0, text: effectName ? dt(effectName) : dt('None'), tone: 'invites' },
  ]} /></div>

  <div class="cz-layout">
    <aside class="cz-preview">
      <section class="sx-panel cz-preview-panel">
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style="--c:#9bd0f5"><Icon name="ph:eye-fill" width="17" height="17" /></span>
          <h2>{dt('Preview, in {a}', { a: (guildName) })}</h2>
        </div>
        <div class="cz-profile">
          <div class="cz-profile-banner" id="czBanner" style={effectiveBanner ? `background-image:url(${effectiveBanner})` : undefined}>
            <div class="cz-profile-banner-fallback" id="czBannerFallback" style={effectiveBanner ? 'display:none' : undefined} />
            <button type="button" class="cz-edit-btn cz-edit-banner" data-cz-pick="banner" title={dt('Edit banner')} aria-haspopup="dialog"><Icon name="ph:pencil-simple-fill" width="13" height="13" /></button>
          </div>
          <div class="cz-profile-body">
            <div class="cz-profile-avatar-wrap">
              <img src={effectiveAvatar} alt="" class="cz-profile-avatar" id="czAvatar" />
              <button type="button" class="cz-edit-btn cz-edit-avatar" data-cz-pick="avatar" title={dt('Edit avatar')} aria-haspopup="dialog"><Icon name="ph:pencil-simple-fill" width="12" height="12" /></button>
            </div>
            <div class="cz-profile-name"><span id="czName" style={(nameFontCss + nameCss) || undefined}>{previewName}</span><span class="cz-profile-tag">{dt('APP')}</span></div>
            <div class="cz-profile-handle">{botUsername}</div>
            <p class="cz-profile-desc" id="czDesc" set:html={previewDescHtml} style={effectiveDescription ? undefined : 'display:none'} />
          </div>
        </div>

        <div class="sx-sub cz-global">
          <div class="cz-global-label"><Icon name="ph:lock-simple-fill" width="13" height="13" />{dt('Petto\'s real Discord identity')}</div>
          <div class="cz-global-row">
            <img src={globalAvatar ?? '/assets/mascot-icon.webp'} alt="" />
            <div>
              <div class="cz-global-name">{globalUsername}</div>
              {globalDescription && <p class="cz-global-desc" set:html={globalDescHtml} />}
            </div>
          </div>
          <p class="sx-hint">{dt('Shared by every server Petto is in, can\'t be edited from a single server. What you set on the left only changes how Petto looks here.')}</p>
        </div>
      </section>
    </aside>

    <div class="cz-main">
      <form method="POST" enctype="multipart/form-data" class="cz-form sx-stack" id="czForm" data-revert-clean data-discard-sync data-default-name={botUsername} data-default-avatar={defaultAvatar} data-default-banner={globalBanner ?? ''} data-default-description={globalDescription}>
        <section class="sx-panel cz-panel">
          <div class="sx-panel-head">
            <span class="sx-panel-icon" style="--c:#f0a88f"><Icon name="ph:identification-badge-fill" width="17" height="17" /></span>
            <h2 id="cz-nick-h"><Fragment set:html={dth('Nickname <span class="cz-free-tag">Free</span>')} /></h2>
            <button type="button" class="cz-reset" data-reset="nickname" data-reset-field="nickname">{dt('Reset')}</button>
          </div>
          <div class="dfx-field">
            <input id="nickname" type="text" name="nickname" value={nickname} maxlength="32" placeholder={botUsername} data-count aria-labelledby="cz-nick-h" />
            <span class="dfx-hint">{dt('Max 32 characters. Leave empty to use "{a}". This stays available without Premium.', { a: (botUsername) })}</span>
          </div>
        </section>

        <div class="cz-premium-fields">
          <PremiumGate locked={!premiumActive} title={dt('Customize your server profile')} description={dt("Server specific avatar, banner and bio are available with Premium. Nicknames are free and stay available to help identify Petto in your server.")} href={`/dash/premium?guild_id=${guildId}`}>
            <div class="sx-stack">
              <section class="sx-panel cz-panel">
                <div class="sx-panel-head">
                  <span class="sx-panel-icon" style="--c:#9bd0f5"><Icon name="ph:image-fill" width="17" height="17" /></span>
                  <h2>{dt('Avatar and banner')}</h2>
                </div>
                <div class="dfx-grid">
                  <div class="dfx-field">
                    <div class="cz-field-head"><label for="avatar_url">{dt('Avatar')}</label><button type="button" class="cz-reset" data-reset="avatar_url,avatar_file" data-reset-field="avatar">{dt('Reset')}</button></div>
                    <input id="avatar_url" type="url" name="avatar_url" value={avatarUrl} placeholder="https://example.com/avatar.png" />
                    <label class="cz-upload" for="avatar_file">
                      <Icon name="ph:upload-simple-bold" width="14" height="14" />
                      <span>{dt('Or upload a file')}</span>
                      <input id="avatar_file" type="file" name="avatar_file" accept="image/*" />
                    </label>
                    <span class="dfx-hint">{dt('A link or an upload, under 2MB. Leave empty for the default avatar.')}</span>
                  </div>

                  <div class="dfx-field">
                    <div class="cz-field-head"><label for="banner_url">{dt('Banner')}</label><button type="button" class="cz-reset" data-reset="banner_url,banner_file" data-reset-field="banner">{dt('Reset')}</button></div>
                    <input id="banner_url" type="url" name="banner_url" value={bannerUrl} placeholder="https://example.com/banner.png" />
                    <label class="cz-upload" for="banner_file">
                      <Icon name="ph:upload-simple-bold" width="14" height="14" />
                      <span>{dt('Or upload a file')}</span>
                      <input id="banner_file" type="file" name="banner_file" accept="image/*" />
                    </label>
                    <span class="dfx-hint">{dt('Shown behind the avatar on the preview card, under 2MB.')}</span>
                  </div>
                </div>
              </section>

              <section class="sx-panel cz-panel">
                <div class="sx-panel-head">
                  <span class="sx-panel-icon" style="--c:#f5c26b"><Icon name="ph:chat-text-fill" width="17" height="17" /></span>
                  <h2 id="cz-desc-h">{dt('Description')}</h2>
                  <button type="button" class="cz-reset" data-reset="description" data-reset-field="description">{dt('Reset')}</button>
                </div>
                <div class="dfx-field">
                  <textarea class="dgl-autogrow" id="description" name="description" data-ac data-count maxlength="190" rows="3" aria-labelledby="cz-desc-h" placeholder={dt('A friendly moderation and community bot.')}>{description}</textarea>
                  <span class="dfx-hint">{dt('Max 190 characters. Custom emoji like')} <code>{'<:name:id>'}</code> {dt('render fine.')}</span>
                </div>
              </section>

              <section class="sx-panel cz-panel cz-style" data-effect-colors={JSON.stringify(effectColorCount)}>
                <div class="sx-panel-head">
                  <span class="sx-panel-icon" style="--c:#c6a8f5"><Icon name="ph:palette-fill" width="17" height="17" /></span>
                  <h2>{dt('Name style')}</h2>
                  <button type="button" class="cz-reset" data-reset="name_effect" data-reset-field="name_style">{dt('Reset')}</button>
                </div>
                <div class="cz-style-box">
                  {/* The two selects are what the form sends; the tiles below are how they are picked (each one shows how the name would look). */}
                  <select id="name_effect" name="name_effect" hidden>
                    <option value="0" selected={!nameStyle}>{dt('No style')}</option>
                    {NAME_EFFECTS.map((effect) => <option value={effect.id} selected={nameStyle?.effectId === effect.id}>{dt(effect.label)}</option>)}
                  </select>
                  <select id="name_font" name="name_font" hidden>
                    {NAME_FONTS.map((font) => <option value={font.id} selected={styleForm.fontId === font.id}>{dt(font.label)}</option>)}
                  </select>

                  <div class="dfx-field">
                    <span class="cz-opt-label" id="cz-effect-h">{dt('Effect')}</span>
                    <div class="cz-opts" role="radiogroup" aria-labelledby="cz-effect-h" data-cz-opts="name_effect">
                      <button type="button" role="radio" class="cz-opt" data-value="0" aria-checked={!nameStyle ? 'true' : 'false'}><span class="cz-opt-sample">{dt('No style')}</span></button>
                      {NAME_EFFECTS.map((effect) => (
                        <button type="button" role="radio" class="cz-opt" data-value={effect.id} aria-checked={nameStyle?.effectId === effect.id ? 'true' : 'false'}><span class="cz-opt-sample" data-effect={effect.id}>{dt(effect.label)}</span></button>
                      ))}
                    </div>
                  </div>
                  <div class="dfx-field">
                    <span class="cz-opt-label" id="cz-font-h">{dt('Font')}</span>
                    <div class="cz-opts cz-opts-fonts" role="radiogroup" aria-labelledby="cz-font-h" data-cz-opts="name_font">
                      {NAME_FONTS.map((font) => (
                        <button type="button" role="radio" class="cz-opt cz-opt-font" data-value={font.id} aria-checked={styleForm.fontId === font.id ? 'true' : 'false'} title={dt(font.label)}>
                          <span class="cz-opt-gg" style={`font-family:${NAME_FONT_STACKS[font.id] ?? 'inherit'}`}>Gg</span>
                          <small>{dt(font.label)}</small>
                        </button>
                      ))}
                    </div>
                  </div>
                  <div class="dfx-grid cz-style-grid">
                    <div class="dfx-field cz-color"><ColorPicker id="name_color_1" name="name_color_1" value={styleColors[0]} label={dt('Color')} /></div>
                    <div class="dfx-field cz-color"><ColorPicker id="name_color_2" name="name_color_2" value={styleColors[1]} label={dt('Second color')} /></div>
                  </div>
                </div>
                <span class="dfx-hint">{dt('Like the name styles of Nitro: a gradient, neon or glow on the name of Petto in this server. The preview shows the colors and the effect, Discord draws the font.')}</span>
              </section>
            </div>
          </PremiumGate>
        </div>
        <div class="sx-foot"><button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:check-bold" width="13" height="13" />{dt('Save changes')}</button></div>
      </form>
    </div>
  </div>

  {/* The picker the two pencils of the preview open: a picture from the device, a link, or one of the samples. */}
  <dialog id="czPicker" class="cz-picker" aria-labelledby="czPickerTitle" data-w-avatar={pickerWords.avatar} data-w-banner={pickerWords.banner}>
    <div class="cz-picker-head">
      <h2 id="czPickerTitle">{pickerWords.avatar}</h2>
      <button type="button" class="cz-picker-x" data-cz-close aria-label={pickerWords.close}><Icon name="ph:x-bold" width="16" height="16" /></button>
    </div>
    {!premiumActive ? (
      <div class="cz-picker-lock">
        <span class="cz-picker-lock-icon"><Icon name="ph:crown-fill" width="20" height="20" /></span>
        <p>{dt("Server specific avatar, banner and bio are available with Premium. Nicknames are free and stay available to help identify Petto in your server.")}</p>
        <a class="btn btn-primary btn-sm" href={`/dash/premium?guild_id=${guildId}`}><Icon name="ph:lock-open-fill" width="14" height="14" />{dt('See Premium plans')}</a>
      </div>
    ) : (
      [['avatar', avatarGroups], ['banner', bannerGroups]].map(([kind, groups]) => (
        <div class="cz-picker-body" data-panel={kind} hidden={kind !== 'avatar'}>
          <button type="button" class="cz-drop" data-cz-upload={kind}>
            <span class="cz-drop-icon"><Icon name="ph:upload-simple-bold" width="22" height="22" /></span>
            <strong>{pickerWords.upload}</strong>
            <span>{pickerWords.uploadHint}</span>
          </button>
          <div class="cz-or"><span>{pickerWords.or}</span></div>
          <div class="cz-import">
            <div class="dfx-field"><input type="url" inputmode="url" placeholder="https://example.com/image.png" data-cz-link={kind} autocomplete="off" aria-label={pickerWords.or} /></div>
            <button type="button" class="btn btn-accent btn-sm" data-cz-import={kind}>{pickerWords.import}</button>
          </div>
          <h3 class="cz-samples-h">{pickerWords.samples}</h3>
          {(groups as typeof avatarGroups).map((group) => (
            <div class="cz-group">
              <div class="cz-group-label">{dt(group.label)}</div>
              <div class:list={['cz-samples', { 'is-banner': kind === 'banner' }]}>
                {group.items.map((item) => (
                  <button type="button" class="cz-sample" data-src={item.src} title={dt(item.label)}>
                    <img src={item.src} alt={dt(item.label)} loading="lazy" decoding="async" />
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
      ))
    )}
  </dialog>
  </div>
</DashGuildLayout>

<script>
import { renderMarkdown } from '../utils/discordPreview';
import { NAME_FONT_STACKS } from '../utils/nameStyle';
declare function cdt(key: string, vars?: Record<string, string | number>): string;
  const form = document.getElementById('czForm') as HTMLFormElement | null;
  if (form) {
    const defaultName = form.dataset.defaultName ?? '';
    const defaultAvatar = form.dataset.defaultAvatar ?? '';
    const defaultBanner = form.dataset.defaultBanner ?? '';
    const defaultDescription = form.dataset.defaultDescription ?? '';

    const nameEl = document.getElementById('czName');
    const avatarEl = document.getElementById('czAvatar') as HTMLImageElement | null;
    const bannerEl = document.getElementById('czBanner') as HTMLElement | null;
    const bannerFallbackEl = document.getElementById('czBannerFallback') as HTMLElement | null;
    const descEl = document.getElementById('czDesc') as HTMLElement | null;

    const nicknameInput = document.getElementById('nickname') as HTMLInputElement | null;
    const avatarUrlInput = document.getElementById('avatar_url') as HTMLInputElement | null;
    const avatarFileInput = document.getElementById('avatar_file') as HTMLInputElement | null;
    const bannerUrlInput = document.getElementById('banner_url') as HTMLInputElement | null;
    const bannerFileInput = document.getElementById('banner_file') as HTMLInputElement | null;
    const descriptionInput = document.getElementById('description') as HTMLTextAreaElement | null;

    let avatarObjectUrl: string | null = null;
    let bannerObjectUrl: string | null = null;

    if (nicknameInput && nameEl) {
      nicknameInput.addEventListener('input', () => {
        nameEl.textContent = nicknameInput.value.trim() || defaultName;
      });
    }

    if (avatarEl) {
      const updateAvatar = () => {
        const file = avatarFileInput?.files?.[0];
        if (file) {
          if (avatarObjectUrl) URL.revokeObjectURL(avatarObjectUrl);
          avatarObjectUrl = URL.createObjectURL(file);
          avatarEl.src = avatarObjectUrl;
          return;
        }
        const url = avatarUrlInput?.value.trim();
        avatarEl.src = url || defaultAvatar;
      };
      avatarUrlInput?.addEventListener('input', updateAvatar);
      avatarFileInput?.addEventListener('change', updateAvatar);
    }

    if (bannerEl && bannerFallbackEl) {
      const applyBanner = (url: string) => {
        if (url) {
          bannerEl.style.backgroundImage = `url(${url})`;
          bannerFallbackEl.style.display = 'none';
        } else {
          bannerEl.style.backgroundImage = '';
          bannerFallbackEl.style.display = '';
        }
      };
      const updateBanner = () => {
        const file = bannerFileInput?.files?.[0];
        if (file) {
          if (bannerObjectUrl) URL.revokeObjectURL(bannerObjectUrl);
          bannerObjectUrl = URL.createObjectURL(file);
          applyBanner(bannerObjectUrl);
          return;
        }
        applyBanner(bannerUrlInput?.value.trim() || defaultBanner);
      };
      bannerUrlInput?.addEventListener('input', updateBanner);
      bannerFileInput?.addEventListener('change', updateBanner);
    }

    if (descriptionInput && descEl) {
      descriptionInput.addEventListener('input', () => {
        const value = descriptionInput.value.trim();
        const previewValue = value || defaultDescription;
        descEl.style.display = previewValue ? '' : 'none';
        descEl.innerHTML = renderMarkdown(previewValue);
      });
    }

    // Name style: the preview shows the colors, the effect and the font; the second color only matters for a gradient. Every tile of the
    // picker shows how a name looks with it (the effects with the colors chosen now), and picking one writes the hidden select the form sends.
    const effectSelect = document.getElementById('name_effect') as HTMLSelectElement | null;
    const fontSelect = document.getElementById('name_font') as HTMLSelectElement | null;
    const color1 = document.getElementById('name_color_1') as HTMLInputElement | null;
    const color2 = document.getElementById('name_color_2') as HTMLInputElement | null;
    const styleBox = document.querySelector<HTMLElement>('.cz-style');
    if (effectSelect && fontSelect && color1 && color2 && nameEl && styleBox) {
      const colorCounts: Record<string, number> = JSON.parse(styleBox.dataset.effectColors ?? '{}');
      const effectCss = (id: number, first: string, second: string): string => {
        switch (id) {
          case 2: return `background:linear-gradient(90deg,${first},${second});-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;`;
          case 3: return `color:#fff;text-shadow:0 0 4px ${first},0 0 10px ${first},0 0 18px ${first};`;
          case 4: return `color:${first};-webkit-text-stroke:1px #000;text-shadow:1px 1px 0 #000;`;
          case 5: return `color:${first};text-shadow:2px 2px 0 color-mix(in srgb,${first} 45%,#000);`;
          case 6: return `color:${first};text-shadow:0 0 8px ${first};`;
          default: return `color:${first};`;
        }
      };
      // The tiles show each effect the way it reads on the dark tile: the colors are lifted toward white (a dark blue vanishes there) and the effects keep their own
      // marks (the glow of Neon, the stroke of Toon, the drop shadow of Pop). The name in the preview uses the exact colors, as Discord does.
      const lift = (color: string) => `color-mix(in srgb, ${color} 60%, #ffffff)`;
      const tileCss = (id: number, first: string, second: string): string => {
        const a = lift(first); const b = lift(second);
        switch (id) {
          case 2: return `background:linear-gradient(90deg,${a},${b});-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;`;
          case 3: return `color:#fff;text-shadow:0 0 3px ${a},0 0 9px ${first},0 0 18px ${first};`;
          case 4: return `background:linear-gradient(180deg,${a},${first});-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;-webkit-text-stroke:1px color-mix(in srgb, ${first} 45%, #000000);`;
          case 5: return `color:${a};text-shadow:2px 2px 0 ${first};`;
          case 6: return `color:${a};text-shadow:0 0 4px ${first},0 0 12px ${first};`;
          default: return `color:${a};`;
        }
      };
      const updateStyle = () => {
        const id = Number(effectSelect.value || 0);
        const fontId = Number(fontSelect.value || 11);
        const box1 = color1.closest<HTMLElement>('[data-colorpicker]');
        const box2 = color2.closest<HTMLElement>('[data-colorpicker]');
        if (box2) box2.style.display = colorCounts[String(id)] === 2 ? '' : 'none';
        if (box1) { if (id) box1.removeAttribute('data-cp-disabled'); else box1.setAttribute('data-cp-disabled', ''); }
        nameEl.setAttribute('style', id ? `font-family:${NAME_FONT_STACKS[fontId] ?? 'inherit'};${effectCss(id, color1.value, color2.value)}` : '');
        // The tiles: the one that is on, and each effect drawn with the colors that are chosen now.
        styleBox.querySelectorAll<HTMLElement>('[data-cz-opts]').forEach((group) => {
          const select = document.getElementById(group.dataset.czOpts ?? '') as HTMLSelectElement | null;
          const current = String(Number(select?.value || (group.dataset.czOpts === 'name_font' ? 11 : 0)));
          group.querySelectorAll<HTMLElement>('[data-value]').forEach((tile) => tile.setAttribute('aria-checked', tile.dataset.value === current ? 'true' : 'false'));
        });
        styleBox.querySelectorAll<HTMLElement>('.cz-opt-sample[data-effect]').forEach((sample) => {
          sample.setAttribute('style', tileCss(Number(sample.dataset.effect), color1.value, color2.value));
        });
      };
      styleBox.addEventListener('click', (event) => {
        const tile = (event.target as HTMLElement).closest<HTMLElement>('[data-cz-opts] [data-value]');
        if (!tile) return;
        const select = document.getElementById(tile.closest<HTMLElement>('[data-cz-opts]')?.dataset.czOpts ?? '') as HTMLSelectElement | null;
        if (!select || select.value === tile.dataset.value) return;
        select.value = tile.dataset.value ?? '';
        select.dispatchEvent(new Event('input', { bubbles: true }));
        select.dispatchEvent(new Event('change', { bubbles: true }));
      });
      for (const el of [effectSelect, color1, color2, fontSelect]) el.addEventListener('input', updateStyle);
      updateStyle();
    }

    // The picker the pencils of the preview open (a picture from the device, a link, or a sample). Picking only fills the same fields the form already
    // has, so the preview shows it at once and it is saved with the rest.
    const picker = document.getElementById('czPicker') as HTMLDialogElement | null;
    if (picker) {
      const fields = {
        avatar: { url: avatarUrlInput, file: avatarFileInput },
        banner: { url: bannerUrlInput, file: bannerFileInput },
      } as const;
      type Kind = keyof typeof fields;
      const title = document.getElementById('czPickerTitle');
      const open = (kind: Kind) => {
        picker.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => { panel.hidden = panel.dataset.panel !== kind; });
        if (title) title.textContent = picker.dataset[kind === 'avatar' ? 'wAvatar' : 'wBanner'] ?? '';
        if (typeof picker.showModal === 'function' && !picker.open) picker.showModal();
      };
      const choose = (kind: Kind, link: string) => {
        const { url, file } = fields[kind];
        if (!url) return;
        // A file picked before would win over the link: the last choice is the one that counts.
        if (file) file.value = '';
        url.value = link;
        url.dispatchEvent(new Event('input', { bubbles: true }));
        picker.close();
      };
      document.querySelectorAll<HTMLElement>('[data-cz-pick]').forEach((pencil) => {
        pencil.addEventListener('click', () => open(pencil.dataset.czPick === 'banner' ? 'banner' : 'avatar'));
      });
      picker.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target === picker || target.closest('[data-cz-close]')) { picker.close(); return; }
        const upload = target.closest<HTMLElement>('[data-cz-upload]');
        if (upload) { fields[upload.dataset.czUpload as Kind]?.file?.click(); return; }
        const importBtn = target.closest<HTMLElement>('[data-cz-import]');
        if (importBtn) {
          const kind = importBtn.dataset.czImport as Kind;
          const input = picker.querySelector<HTMLInputElement>(`[data-cz-link="${kind}"]`);
          const link = input?.value.trim() ?? '';
          if (!/^https?:\/\/\S+$/i.test(link)) { input?.focus(); input?.classList.add('is-bad'); return; }
          choose(kind, link);
          return;
        }
        const sample = target.closest<HTMLElement>('[data-src]');
        if (sample) {
          const kind = (sample.closest<HTMLElement>('[data-panel]')?.dataset.panel ?? 'avatar') as Kind;
          const src = sample.dataset.src ?? '';
          choose(kind, src.startsWith('/') ? `${location.origin}${src}` : src);
        }
      });
      picker.querySelectorAll<HTMLInputElement>('[data-cz-link]').forEach((input) => {
        input.addEventListener('input', () => input.classList.remove('is-bad'));
        input.addEventListener('keydown', (event) => { if (event.key === 'Enter') { event.preventDefault(); picker.querySelector<HTMLElement>(`[data-cz-import="${input.dataset.czLink}"]`)?.click(); } });
      });
      // A file chosen from the device closes the picker (the preview already shows it: the listeners above hear the same change).
      for (const { file } of Object.values(fields)) file?.addEventListener('change', () => { if (file.files?.length && picker.open) picker.close(); });
    }

    // After a save the address carries what happened (so that reloading the page does not send the form again): it is shown, then dropped.
    if (/[?&](saved|warning|error)=/.test(location.search)) {
      try { history.replaceState(history.state, '', location.pathname); } catch { /* the notice stays in the address, which is harmless */ }
    }

    document.querySelectorAll<HTMLButtonElement>('.cz-reset').forEach((btn) => {
      btn.addEventListener('click', () => {
        const names = (btn.dataset.reset ?? '').split(',');
        const fields: (HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement)[] = [];
        for (const name of names) {
          const field = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
          if (!field) continue;
          fields.push(field);
          field.value = '';
          // Only the field hears it (its preview updates): a reset saves at once, so it is not an unsaved change of the form.
          field.dispatchEvent(new Event('input', { bubbles: false }));
          if (field instanceof HTMLInputElement && field.type === 'file') field.dispatchEvent(new Event('change', { bubbles: false }));
        }
        // The emptied fields are what the server now has (Discard goes back to them); if the reset fails, they are left as an
        // unsaved change for the bar to save.
        const settle = (ok: boolean) => { fields.forEach((field) => {
          if (!ok) { field.dispatchEvent(new Event('input', { bubbles: true })); return; }
          if (field instanceof HTMLSelectElement) Array.from(field.options).forEach((option) => { option.defaultSelected = option.selected; });
          else if (!(field instanceof HTMLInputElement && field.type === 'file')) field.defaultValue = field.value;
        });
        // What the server has now is the new starting point of the bar (Discard and "back to how it was" compare with it).
        if (ok) form.dispatchEvent(new CustomEvent('dpk-rebase', { detail: { names } })); };

        // Reset is an immediate, field-scoped save. The server receives only
        // the field being reset, so other edits currently in the form remain
        // drafts instead of being saved by accident.
        const resetField = btn.dataset.resetField;
        if (!resetField) return;
        const label = btn.innerHTML;
        btn.style.minWidth = `${btn.offsetWidth}px`;
        btn.disabled = true;
        btn.textContent = cdt('Resetting…');
        const body = new FormData();
        body.set('reset_field', resetField);
        const flashes = document.querySelector('.cz-flashes');
        // The answer is a toast at the bottom (the notices at the top are out of sight from the lower fields); without it, a notice there.
        const flash = (kind: 'ok' | 'warn' | 'err', text: string) => {
          const toast = (window as unknown as { dglToast?: (text: string, opts?: { kind?: string }) => void }).dglToast;
          if (toast) { toast(text, { kind: kind === 'ok' ? 'ok' : kind === 'err' ? 'error' : 'info' }); return; }
          if (!flashes) return;
          flashes.innerHTML = '';
          const el = document.createElement('div');
          el.className = `cz-flash cz-flash-${kind}`;
          el.textContent = text;
          flashes.appendChild(el);
        };
        // Only the field being reset is sent, and the page stays where it is: the answer says what to show.
        fetch(location.href, { method: 'POST', body, headers: { 'x-petto-ajax': '1' }, credentials: 'same-origin' })
          .then(async (res) => {
            if (!(res.headers.get('content-type') ?? '').includes('application/json')) { location.reload(); return; }
            const result = await res.json() as { saved: boolean; warning: boolean; error: string | null };
            settle(!result.error && result.saved);
            if (result.error || !result.saved) flash('err', cdt('Something went wrong, try again.'));
            else if (result.warning) flash('warn', cdt("Discord didn't accept the profile sync, it'll retry next save."));
            else flash('ok', cdt('Saved.'));
          })
          .catch(() => { settle(false); flash('err', cdt('Something went wrong, try again.')); })
          .finally(() => { btn.disabled = false; btn.innerHTML = label; btn.style.minWidth = ''; });
      });
    });
  }
</script>

<style>
  h1 { font-size: 24px; margin: 0 0 18px; }
  .cz-profile-desc :global(.dp-mention), .cz-global-desc :global(.dp-mention) { color: #c9cdfb; background: rgba(88, 101, 242, .3); border-radius: 3px; padding: 0 2px; font-weight: 500; }
  .cz-profile-desc :global(.dp-code), .cz-global-desc :global(.dp-code) { font-family: var(--mono); background: #1e1f22; border-radius: 4px; padding: 0 4px; font-size: 12px; }
  .cz-profile-desc :global(.dp-quote), .cz-global-desc :global(.dp-quote) { display: block; border-left: 3px solid #4e5058; padding-left: 8px; }
  .cz-profile-desc :global(.dp-link), .cz-global-desc :global(.dp-link) { color: #00a8fc; }
  .cz-profile-desc :global(.dp-emoji), .cz-global-desc :global(.dp-emoji) { width: 18px; height: 18px; vertical-align: -3px; }

  /* Five tiles: in one row when there is room, else three and two (each row fills the width), and on a phone two by two with the last one across. */
  .cz-tiles { container: czt / inline-size; }
  @container czt (max-width: 799px) {
    .cz-tiles :global(.stt) { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .cz-tiles :global(.stt-tile) { grid-column: span 2; }
    .cz-tiles :global(.stt-tile:nth-child(n+4)) { grid-column: span 3; }
  }
  @container czt (max-width: 479px) {
    .cz-tiles :global(.stt) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cz-tiles :global(.stt-tile), .cz-tiles :global(.stt-tile:nth-child(n+4)) { grid-column: auto; }
    .cz-tiles :global(.stt-tile:last-child) { grid-column: 1 / -1; }
  }
  .cz-flashes:empty { display: none; }
  /* A reset writes its message here from the script when there is no toast, so these reach it with :global. */
  .cz-flashes :global(.cz-flash) { display: flex; align-items: center; gap: 8px; font-size: 13.5px; border-radius: 10px; padding: 10px 14px; margin-bottom: 14px; animation: m-pop-in var(--m-base) var(--m-out) both; }
  .cz-flashes :global(.cz-flash-ok) { color: var(--green); background: var(--green-soft); border: 1px solid var(--green); }
  .cz-flashes :global(.cz-flash-warn) { color: var(--yellow); background: var(--yellow-soft); border: 1px solid var(--yellow); }
  .cz-flashes :global(.cz-flash-err) { color: var(--red); background: var(--red-soft); border: 1px solid var(--red); }

  /* The form on the left, the preview in a column that stays in view on the right. On a narrow screen the preview comes first. */
  .cz-layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 14px 18px; align-items: start; }
  .cz-layout > * { min-width: 0; }
  .cz-preview { grid-column: 2; grid-row: 1; position: sticky; top: 4px; }
  .cz-main { grid-column: 1; grid-row: 1; }
  .cz-preview-panel { gap: 16px; }
  .cz-panel { padding: 18px; }

  .cz-profile { border: 1px solid var(--border); border-radius: 14px; overflow: hidden; background: var(--bg-raise); }
  .cz-profile-banner { height: 88px; background-size: cover; background-position: center; position: relative; }
  .cz-profile-banner-fallback { position: absolute; inset: 0; background: linear-gradient(135deg, var(--accent) 0%, color-mix(in srgb, var(--accent) 60%, #7c5cff) 130%); opacity: 0.85; }
  .cz-profile-body { padding: 0 18px 18px; margin-top: -34px; position: relative; }
  .cz-profile-avatar-wrap { position: relative; width: 68px; }
  .cz-profile-avatar { width: 68px; height: 68px; border-radius: 50%; object-fit: cover; border: 4px solid var(--bg-raise); background: var(--bg-raise); display: block; }

  .cz-edit-btn { position: absolute; display: flex; align-items: center; justify-content: center; border: none; border-radius: 50%; background: rgba(0,0,0,0.55); color: #fff; cursor: pointer; opacity: 0; transition: opacity var(--m-fast) ease, background-color var(--m-fast) ease; backdrop-filter: blur(2px); }
  .cz-edit-btn:hover { background: rgba(0,0,0,0.75); }
  .cz-profile-banner:hover .cz-edit-btn, .cz-profile-avatar-wrap:hover .cz-edit-btn, .cz-edit-btn:focus-visible { opacity: 1; }
  /* A touch screen has no hover: the pencils stay in sight. */
  @media (hover: none) { .cz-edit-btn { opacity: 1; } }
  .cz-edit-banner { top: 10px; right: 10px; width: 28px; height: 28px; }
  .cz-edit-avatar { right: -2px; bottom: 2px; width: 24px; height: 24px; border: 2px solid var(--bg-raise); }
  .cz-profile-name { font-family: var(--serif); font-size: 16px; font-weight: 600; color: var(--text); margin-top: 12px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .cz-profile-tag { font-family: var(--mono); font-size: 9px; font-weight: 600; color: var(--accent-ink); background: var(--accent); padding: 1px 6px; border-radius: 4px; }
  .cz-profile-handle { font-size: 12px; color: var(--text-dim); margin-top: 2px; }
  .cz-profile-desc { font-size: 12.5px; color: var(--text-muted); line-height: 1.6; margin: 12px 0 0; padding-top: 12px; border-top: 1px solid var(--border-soft); overflow-wrap: anywhere; }
  .cz-profile-desc :global(.inline-emoji) { width: 16px; height: 16px; vertical-align: -3px; }

  .cz-global { gap: 10px; }
  .cz-global-label { display: flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 600; color: var(--text-muted); }
  .cz-global-row { display: flex; gap: 10px; align-items: flex-start; }
  .cz-global-row img { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; flex-shrink: 0; background: var(--bg-raise); }
  .cz-global-name { font-size: 13px; font-weight: 600; color: var(--text-muted); }
  .cz-global-desc { font-size: 12px; color: var(--text-dim); line-height: 1.5; margin: 4px 0 0; overflow-wrap: anywhere; }
  .cz-global-desc :global(.inline-emoji) { width: 14px; height: 14px; vertical-align: -3px; }

  :global(.cz-free-tag){ display: inline-block; margin-left: 6px; padding: 2px 8px; border: 1px solid color-mix(in srgb, var(--green) 45%, var(--border)); border-radius: 999px; color: var(--green); font-family: var(--sans); font-size: 11px; font-weight: 700; vertical-align: 2px; }
  .cz-premium-fields { min-width: 0; }
  .cz-premium-fields :global(.premium-gate) { width: 100%; }
  /* The notice sits in the middle of the locked fields, still, and scrolls with the page like any other block. The locked fields are cut at a
     height (the rest would only show through), and blurred more, so what is behind the notice reads as "there is more here", not as a form. */
  .cz-premium-fields :global(.premium-gate-overlay) { place-items: center; }
  .cz-premium-fields :global(.premium-gate-locked .premium-gate-content) { max-height: 520px; overflow: hidden; filter: blur(3px); opacity: .32; }
  .cz-premium-fields :global(.premium-gate-locked) { min-height: 0; }
  @media (max-width: 560px) { .cz-premium-fields :global(.premium-gate-locked .premium-gate-content) { max-height: 440px; } }
  .cz-field-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .dfx-field .cz-field-head > label { font-size: 13px; font-weight: 600; }
  .cz-reset { flex: none; border: 0; background: transparent; color: var(--text-dim); font: 600 12.5px var(--sans); cursor: pointer; padding: 4px 8px; border-radius: 7px; transition: background-color .25s ease, color .25s ease; }
  .cz-reset:hover { color: var(--red); background: var(--red-soft); }
  .cz-reset:disabled { opacity: .6; cursor: progress; }
  .cz-form .dfx-grid { grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); }
  .cz-form .cz-style-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cz-form .dfx-field textarea.dgl-autogrow { min-height: 5.4em; resize: none; }
  .dfx-hint :global(code), .sx-hint :global(code) { font-family: var(--mono); color: var(--accent); }
  .cz-upload { position: relative; display: flex; align-items: center; justify-content: center; gap: 7px; min-height: 40px; box-sizing: border-box; padding: 8px 12px; border: 1px dashed var(--border); border-radius: 10px; font-size: 13px; font-weight: 500; color: var(--text-muted); cursor: pointer; transition: background-color .25s ease, border-color .25s ease, color .25s ease; }
  .cz-upload:hover { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); background: var(--accent-soft); }
  .cz-upload:active { transform: none; filter: none; background: color-mix(in srgb, var(--text) 10%, transparent); }
  .cz-upload:has(input:focus-visible) { color: var(--accent); outline: 2px solid var(--accent); outline-offset: 2px; }
  .cz-upload input[type="file"] { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .cz-color :global(.dgl-cp) { display: flex; width: 100%; }
  .cz-color :global(.dgl-cp-trigger) { width: 100%; min-height: 40px; box-sizing: border-box; border-radius: 10px; padding: 6px 12px; }
  .cz-color:has(> [data-colorpicker][style*="none"]) { display: none; }
  .cz-form .sx-foot .btn { display: inline-flex; align-items: center; gap: 7px; }
  .btn-sm { padding: 8px 18px; font-size: 13px; }

  @media (max-width: 1100px) {
    .cz-layout { grid-template-columns: minmax(0, 1fr); }
    .cz-preview, .cz-main { grid-column: 1; }
    .cz-preview { grid-row: 1; position: static; }
    .cz-main { grid-row: 2; }
  }
  @media (max-width: 720px) { .cz-panel { padding: 15px; } }
  @media (max-width: 520px) { .cz-form .cz-style-grid { grid-template-columns: minmax(0, 1fr); } }

  /* The tiles of the name style: the effects (a name drawn with each) and the fonts ("Gg" in each). */
  .cz-style-box { display: grid; gap: 14px; }
  .cz-opt-label { display: block; margin-bottom: 8px; font-size: 13px; font-weight: 600; color: var(--text); }
  .cz-opts { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 8px; }
  .cz-opts-fonts { grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); }
  .cz-opt { display: grid; place-items: center; gap: 2px; min-height: 52px; padding: 8px 6px; border: 1px solid var(--border); border-radius: 12px; background: var(--bg-raise); color: var(--text); font: inherit; cursor: pointer; transition: border-color var(--m-fast) ease, background-color var(--m-fast) ease, transform var(--m-fast) ease; }
  .cz-opt:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); transform: translateY(-1px); }
  .cz-opt:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cz-opt[aria-checked="true"] { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, var(--bg-raise)); box-shadow: 0 0 0 1px var(--accent) inset; }
  .cz-opt-sample { font-size: 17px; font-weight: 800; line-height: 1.25; letter-spacing: .01em; }
  .cz-opt-gg { font-size: 26px; line-height: 1.1; }
  .cz-opt-font { min-width: 0; }
  .cz-opt-font small { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 10.5px; color: var(--text-dim); }
  @media (prefers-reduced-motion: reduce) { .cz-opt:hover { transform: none; } }

  /* The picker of the pencils. */
  .cz-picker { width: min(540px, calc(100vw - 24px)); max-height: min(86vh, 720px); padding: 0; border: 1px solid var(--border); border-radius: 18px; background: var(--card); color: var(--text); box-shadow: 0 30px 80px -30px rgba(0,0,0,.8); overflow: hidden; }
  .cz-picker[open] { display: flex; flex-direction: column; animation: m-pop-in var(--m-base) var(--m-out) both; }
  .cz-picker::backdrop { background: rgba(8, 9, 12, .66); }
  .cz-picker-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 20px 6px; }
  .cz-picker-head h2 { margin: 0; font-family: var(--serif); font-size: 21px; }
  .cz-picker-x { display: grid; place-items: center; width: 32px; height: 32px; border: 0; border-radius: 10px; background: transparent; color: var(--text-muted); cursor: pointer; }
  .cz-picker-x:hover { background: var(--bg-raise); color: var(--text); }
  .cz-picker-body { padding: 10px 20px 20px; overflow-y: auto; overscroll-behavior: contain; }
  .cz-picker-body[hidden] { display: none; }
  .cz-drop { display: grid; justify-items: center; gap: 4px; width: 100%; padding: 22px 16px; border: 1.5px dashed var(--border); border-radius: 14px; background: transparent; color: var(--text); font: inherit; cursor: pointer; transition: border-color var(--m-fast) ease, background-color var(--m-fast) ease; }
  .cz-drop:hover, .cz-drop:focus-visible { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 7%, transparent); outline: none; }
  .cz-drop-icon { display: grid; place-items: center; width: 48px; height: 48px; margin-bottom: 4px; border-radius: 50%; background: var(--bg-raise); }
  .cz-drop span:last-child { font-size: 12.5px; color: var(--text-dim); }
  .cz-or { display: flex; align-items: center; gap: 12px; margin: 16px 0 12px; color: var(--text-dim); font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  .cz-or::before, .cz-or::after { content: ''; flex: 1; height: 1px; background: var(--border-soft); }
  /* The link field is the dashboard's own field (dfx-field) and the button its own accent button, as everywhere else. */
  .cz-import { display: flex; gap: 8px; align-items: flex-start; }
  .cz-import .dfx-field { flex: 1; min-width: 0; }
  .cz-import .btn { flex: none; min-height: 40px; }
  .cz-import :global(input.is-bad) { border-color: var(--red); }
  .cz-samples-h { margin: 18px 0 2px; font-size: 14px; font-weight: 700; }
  .cz-group { margin-top: 12px; }
  .cz-group-label { margin-bottom: 8px; color: var(--text-dim); font-size: 12px; font-weight: 600; }
  .cz-samples { display: grid; grid-template-columns: repeat(auto-fill, minmax(56px, 1fr)); gap: 8px; }
  .cz-samples.is-banner { grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); }
  .cz-sample { padding: 0; border: 2px solid transparent; border-radius: 14px; background: var(--bg-raise); overflow: hidden; cursor: pointer; aspect-ratio: 1; transition: border-color var(--m-fast) ease, transform var(--m-fast) ease; }
  .cz-samples.is-banner .cz-sample { aspect-ratio: 5 / 2; border-radius: 10px; }
  .cz-sample:hover, .cz-sample:focus-visible { border-color: var(--accent); transform: translateY(-1px); outline: none; }
