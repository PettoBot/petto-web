---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import { renderDiscordEmojis } from '../utils/discord';

interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  nickname: string;
  avatarUrl: string;
  effectiveAvatar: string;
  botUsername: string;
  bannerUrl: string;
  effectiveBanner: string | null;
  description: string;
  effectiveDescription: string;
  globalUsername: string;
  globalAvatar: string | null;
  globalBanner: string | null;
  globalDescription: string;
  saved: boolean;
  discordWarning?: boolean;
  error?: string | null;
}
const {
  user, guildId, guildName, guildIcon,
  nickname, avatarUrl, effectiveAvatar,
  botUsername, bannerUrl, effectiveBanner,
  description, effectiveDescription,
  globalUsername, globalAvatar, globalBanner, globalDescription,
  saved, discordWarning, error,
} = Astro.props;

const errorMessages: Record<string, string> = {
  avatar_too_large: "That image is too big, Discord's limit is small, try something under 2MB.",
  avatar_fetch_failed: "Couldn't fetch that image, make sure it's a direct link or a valid image file.",
  banner_too_large: 'That banner is too big, try something under 2MB.',
  banner_fetch_failed: "Couldn't fetch that banner, make sure it's a direct link or a valid image file.",
  discord_rejected: "Couldn't save, try again in a moment.",
};

const previewName = nickname || botUsername;
const previewDescHtml = renderDiscordEmojis(effectiveDescription);
const globalDescHtml = renderDiscordEmojis(globalDescription);
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="customize" pageTitle="Customize">
  <h1>Customize</h1>
  <p class="cz-sub">How Petto looks and introduces itself in <b>{guildName}</b>. Every server sets its own.</p>

  <div class="cz-root">
    <div class="cz-flashes">
      {saved && <div class="cz-flash cz-flash-ok"><Icon name="ph:check-circle-fill" width="15" height="15" />Saved.</div>}
      {discordWarning && <div class="cz-flash cz-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />Discord didn't accept the profile sync (nickname/avatar/banner/description), it'll retry next save.</div>}
      {error && <div class="cz-flash cz-flash-err"><Icon name="ph:warning-fill" width="15" height="15" />{errorMessages[error] ?? 'Something went wrong, try again.'}</div>}
    </div>

    <div class="cz-layout">
      <aside class="cz-preview">
        <div class="cz-preview-label">Preview, in {guildName}</div>
        <div class="cz-card">
          <div class="cz-card-banner" id="czBanner" style={effectiveBanner ? `background-image:url(${effectiveBanner})` : undefined}>
            <div class="cz-card-banner-fallback" id="czBannerFallback" style={effectiveBanner ? 'display:none' : undefined} />
            <button type="button" class="cz-edit-btn cz-edit-banner" data-focus="banner_url" title="Edit banner"><Icon name="ph:pencil-simple-fill" width="13" height="13" /></button>
          </div>
          <div class="cz-card-body">
            <div class="cz-card-avatar-wrap">
              <img src={effectiveAvatar} alt="" class="cz-card-avatar" id="czAvatar" />
              <button type="button" class="cz-edit-btn cz-edit-avatar" data-focus="avatar_url" title="Edit avatar"><Icon name="ph:pencil-simple-fill" width="12" height="12" /></button>
            </div>
            <div class="cz-card-name"><span id="czName">{previewName}</span><span class="cz-card-tag">APP</span></div>
            <div class="cz-card-handle">{botUsername}</div>
            <p class="cz-card-desc" id="czDesc" set:html={previewDescHtml} style={effectiveDescription ? undefined : 'display:none'} />
          </div>
        </div>

        <div class="cz-global">
          <div class="cz-global-label"><Icon name="ph:lock-simple-fill" width="12" height="12" />Petto's real Discord identity</div>
          <div class="cz-global-row">
            <img src={globalAvatar ?? '/assets/mascot-icon.png'} alt="" />
            <div>
              <div class="cz-global-name">{globalUsername}</div>
              {globalDescription && <p class="cz-global-desc" set:html={globalDescHtml} />}
            </div>
          </div>
          <p class="cz-global-note">Shared by every server Petto is in, can't be edited from a single server. What you set on the left only changes how Petto looks here.</p>
        </div>
      </aside>

      <div class="cz-main">
        <form method="POST" enctype="multipart/form-data" class="cz-form" id="czForm" data-default-name={botUsername} data-default-avatar={globalAvatar ?? '/assets/mascot-icon.png'}>
          <div class="cz-form-grid">
            <div class="cz-field">
              <div class="cz-field-head"><label for="nickname">Nickname</label><button type="button" class="cz-reset" data-reset="nickname">Reset</button></div>
              <input id="nickname" type="text" name="nickname" value={nickname} maxlength="32" placeholder={botUsername} />
              <p class="cz-hint">Max 32 characters. Leave empty to use "{botUsername}".</p>
            </div>

            <div class="cz-field">
              <div class="cz-field-head"><label for="avatar_url">Avatar</label><button type="button" class="cz-reset" data-reset="avatar_url,avatar_file">Reset</button></div>
              <input id="avatar_url" type="url" name="avatar_url" value={avatarUrl} placeholder="https://example.com/avatar.png" />
              <label class="cz-upload" for="avatar_file">
                <Icon name="ph:upload-simple-bold" width="12" height="12" />
                <span>Or upload a file</span>
                <input id="avatar_file" type="file" name="avatar_file" accept="image/*" />
              </label>
              <p class="cz-hint">A link or an upload, under 2MB. Leave empty for the default avatar.</p>
            </div>

            <div class="cz-field">
              <div class="cz-field-head"><label for="banner_url">Banner</label><button type="button" class="cz-reset" data-reset="banner_url,banner_file">Reset</button></div>
              <input id="banner_url" type="url" name="banner_url" value={bannerUrl} placeholder="https://example.com/banner.png" />
              <label class="cz-upload" for="banner_file">
                <Icon name="ph:upload-simple-bold" width="12" height="12" />
                <span>Or upload a file</span>
                <input id="banner_file" type="file" name="banner_file" accept="image/*" />
              </label>
              <p class="cz-hint">Shown behind the avatar on the preview card, under 2MB.</p>
            </div>

            <div class="cz-field">
              <div class="cz-field-head"><label for="description">Description</label><button type="button" class="cz-reset" data-reset="description">Reset</button></div>
              <textarea id="description" name="description" maxlength="190" rows="3" placeholder="A friendly moderation and community bot.">{description}</textarea>
              <p class="cz-hint">Max 190 characters. Custom emoji like <code>{'<:name:id>'}</code> render fine.</p>
            </div>
          </div>
          <button type="submit" class="btn btn-accent btn-sm">Save changes</button>
        </form>
      </div>
    </div>
  </div>
</DashGuildLayout>

<script>
  const form = document.getElementById('czForm') as HTMLFormElement | null;
  if (form) {
    const defaultName = form.dataset.defaultName ?? '';
    const defaultAvatar = form.dataset.defaultAvatar ?? '';

    const nameEl = document.getElementById('czName');
    const avatarEl = document.getElementById('czAvatar') as HTMLImageElement | null;
    const bannerEl = document.getElementById('czBanner') as HTMLElement | null;
    const bannerFallbackEl = document.getElementById('czBannerFallback') as HTMLElement | null;
    const descEl = document.getElementById('czDesc') as HTMLElement | null;

    const nicknameInput = document.getElementById('nickname') as HTMLInputElement | null;
    const avatarUrlInput = document.getElementById('avatar_url') as HTMLInputElement | null;
    const avatarFileInput = document.getElementById('avatar_file') as HTMLInputElement | null;
    const bannerUrlInput = document.getElementById('banner_url') as HTMLInputElement | null;
    const bannerFileInput = document.getElementById('banner_file') as HTMLInputElement | null;
    const descriptionInput = document.getElementById('description') as HTMLTextAreaElement | null;

    let avatarObjectUrl: string | null = null;
    let bannerObjectUrl: string | null = null;

    if (nicknameInput && nameEl) {
      nicknameInput.addEventListener('input', () => {
        nameEl.textContent = nicknameInput.value.trim() || defaultName;
      });
    }

    if (avatarEl) {
      const updateAvatar = () => {
        const file = avatarFileInput?.files?.[0];
        if (file) {
          if (avatarObjectUrl) URL.revokeObjectURL(avatarObjectUrl);
          avatarObjectUrl = URL.createObjectURL(file);
          avatarEl.src = avatarObjectUrl;
          return;
        }
        const url = avatarUrlInput?.value.trim();
        avatarEl.src = url || defaultAvatar;
      };
      avatarUrlInput?.addEventListener('input', updateAvatar);
      avatarFileInput?.addEventListener('change', updateAvatar);
    }

    if (bannerEl && bannerFallbackEl) {
      const applyBanner = (url: string) => {
        if (url) {
          bannerEl.style.backgroundImage = `url(${url})`;
          bannerFallbackEl.style.display = 'none';
        } else {
          bannerEl.style.backgroundImage = '';
          bannerFallbackEl.style.display = '';
        }
      };
      const updateBanner = () => {
        const file = bannerFileInput?.files?.[0];
        if (file) {
          if (bannerObjectUrl) URL.revokeObjectURL(bannerObjectUrl);
          bannerObjectUrl = URL.createObjectURL(file);
          applyBanner(bannerObjectUrl);
          return;
        }
        applyBanner(bannerUrlInput?.value.trim() ?? '');
      };
      bannerUrlInput?.addEventListener('input', updateBanner);
      bannerFileInput?.addEventListener('change', updateBanner);
    }

    if (descriptionInput && descEl) {
      descriptionInput.addEventListener('input', () => {
        const value = descriptionInput.value.trim();
        descEl.style.display = value ? '' : 'none';
        descEl.textContent = value;
      });
    }

    document.querySelectorAll<HTMLButtonElement>('.cz-reset').forEach((btn) => {
      btn.addEventListener('click', () => {
        const names = (btn.dataset.reset ?? '').split(',');
        for (const name of names) {
          const field = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
          if (!field) continue;
          field.value = '';
          field.dispatchEvent(new Event('input', { bubbles: true }));
          if (field instanceof HTMLInputElement && field.type === 'file') field.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });
    });
  }
</script>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  .cz-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 24px; }
  .cz-sub b { color: var(--text); }

  .cz-flashes:empty { display: none; }
  .cz-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; border-radius: 9px; padding: 10px 14px; margin-bottom: 20px; max-width: fit-content; }
  .cz-flash-ok { color: var(--green); background: var(--green-soft); border: 1px solid var(--green); }
  .cz-flash-warn { color: var(--yellow); background: var(--yellow-soft); border: 1px solid var(--yellow); }
  .cz-flash-err { color: var(--red); background: var(--red-soft); border: 1px solid var(--red); }

  .cz-layout { display: grid; grid-template-columns: 320px 1fr; gap: 44px; align-items: start; }
  .cz-preview { position: sticky; top: 90px; display: flex; flex-direction: column; gap: 18px; }

  .cz-preview-label { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); margin-bottom: -6px; }
  .cz-card { border: 1px solid var(--border); border-radius: 16px; overflow: hidden; background: var(--card); }
  .cz-card-banner { height: 88px; background-size: cover; background-position: center; position: relative; }
  .cz-card-banner-fallback { position: absolute; inset: 0; background: linear-gradient(135deg, var(--accent) 0%, color-mix(in srgb, var(--accent) 60%, #7c5cff) 130%); opacity: 0.85; }
  .cz-card-body { padding: 0 18px 20px; margin-top: -34px; position: relative; }
  .cz-card-avatar-wrap { position: relative; width: 68px; }
  .cz-card-avatar { width: 68px; height: 68px; border-radius: 50%; object-fit: cover; border: 4px solid var(--card); background: var(--bg-raise); display: block; }

  .cz-edit-btn { position: absolute; display: flex; align-items: center; justify-content: center; border: none; border-radius: 50%; background: rgba(0,0,0,0.55); color: #fff; cursor: pointer; opacity: 0; transition: opacity 0.12s; backdrop-filter: blur(2px); }
  .cz-card-banner:hover .cz-edit-btn, .cz-card-avatar-wrap:hover .cz-edit-btn, .cz-edit-btn:focus-visible { opacity: 1; }
  .cz-edit-banner { top: 10px; right: 10px; width: 28px; height: 28px; }
  .cz-edit-avatar { right: -2px; bottom: 2px; width: 24px; height: 24px; border: 2px solid var(--card); }
  .cz-card-name { font-family: var(--serif); font-size: 16px; font-weight: 600; color: var(--text); margin-top: 12px; display: flex; align-items: center; gap: 6px; }
  .cz-card-tag { font-family: var(--mono); font-size: 9px; font-weight: 600; color: var(--accent-ink); background: var(--accent); padding: 1px 6px; border-radius: 4px; }
  .cz-card-handle { font-size: 12px; color: var(--text-dim); margin-top: 2px; }
  .cz-card-desc { font-size: 12.5px; color: var(--text-muted); line-height: 1.6; margin: 12px 0 0; padding-top: 12px; border-top: 1px solid var(--border-soft); }
  .cz-card-desc :global(.inline-emoji) { width: 16px; height: 16px; vertical-align: -3px; }

  .cz-global { border: 1px dashed var(--border); border-radius: 14px; padding: 14px; }
  .cz-global-label { display: flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 12px; }
  .cz-global-row { display: flex; gap: 10px; align-items: flex-start; }
  .cz-global-row img { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; flex-shrink: 0; background: var(--bg-raise); }
  .cz-global-name { font-size: 13px; font-weight: 600; color: var(--text-muted); }
  .cz-global-desc { font-size: 12px; color: var(--text-dim); line-height: 1.5; margin: 4px 0 0; }
  .cz-global-desc :global(.inline-emoji) { width: 14px; height: 14px; vertical-align: -3px; }
  .cz-global-note { font-size: 11.5px; color: var(--text-dim); line-height: 1.55; margin: 12px 0 0; }

  .cz-form { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .cz-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px 28px; width: 100%; }
  .cz-field { display: flex; flex-direction: column; gap: 8px; }
  .cz-field-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .cz-field label { font-size: 13.5px; font-weight: 600; color: var(--text); }
  .cz-reset { border: none; background: transparent; color: var(--text-dim); font-size: 11.5px; cursor: pointer; padding: 2px 4px; }
  .cz-reset:hover { color: var(--red); }
  .cz-field input[type="text"], .cz-field input[type="url"], .cz-field textarea { border: 1px solid var(--border); border-radius: 9px; padding: 10px 12px; background: var(--bg-raise); color: var(--text); font-family: var(--sans); font-size: 14px; resize: vertical; }
  .cz-field input:focus, .cz-field textarea:focus { outline: 2px solid var(--accent-soft); border-color: var(--accent); }
  .cz-hint { font-size: 12px; color: var(--text-dim); line-height: 1.5; margin: 0; }
  .cz-hint code { font-family: var(--mono); color: var(--accent); }

  .cz-upload { display: flex; align-items: center; gap: 6px; font-size: 11.5px; font-weight: 500; color: var(--text-dim); cursor: pointer; width: fit-content; }
  .cz-upload:hover { color: var(--accent); }
  .cz-upload input[type="file"] { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }

  .btn-sm { padding: 8px 18px; font-size: 13px; }

  @media (max-width: 980px) {
    .cz-layout { grid-template-columns: 1fr; }
    .cz-preview { position: static; }
  }
  @media (max-width: 620px) {
    .cz-form-grid { grid-template-columns: 1fr; }
  }
</style>
