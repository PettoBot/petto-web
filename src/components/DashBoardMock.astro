---
// How the usual repost of the starboard and the monkeyboard looks in Discord (what Petto sends when no saved design is picked).
interface Props { emoji: string; color: string; count: number }
const { emoji, color, count } = Astro.props;
---
<div class="bm-wrap" data-board-mock>
  <div class="bm-line"><span class="bm-emoji">{emoji}</span> <b>{count}</b> <span class="bm-sep">|</span> <span class="bm-chan">#general</span></div>
  <div class="bm-embed" style={`--bm-c:${color}`}>
    <div class="bm-author"><span class="bm-avatar"></span>Friend</div>
    <div class="bm-text">Fuh</div>
    <div class="bm-foot">09/25/2026 10:17 PM</div>
  </div>
  <div class="bm-btn">Original Message <span aria-hidden="true">↗</span></div>
</div>
<style>
  .bm-wrap { background: #313338; border-radius: 8px; padding: 12px 14px; max-width: 420px; color: #dbdee1; font: 400 13.5px/1.4 var(--sans); display: flex; flex-direction: column; gap: 6px; text-align: left; }
  .bm-line b { color: #f2f3f5; }
  .bm-sep { color: #949ba4; }
  .bm-chan { color: #c9cdfb; background: rgba(88, 101, 242, .3); border-radius: 3px; padding: 0 3px; }
  .bm-embed { background: #2b2d31; border-left: 4px solid var(--bm-c); border-radius: 4px; padding: 8px 12px 10px; }
  .bm-author { display: flex; align-items: center; gap: 7px; font-size: 12.5px; font-weight: 600; color: #f2f3f5; margin-bottom: 4px; }
  .bm-avatar { width: 18px; height: 18px; border-radius: 50%; background: linear-gradient(135deg, #8399ff, #c792ea); }
  .bm-foot { margin-top: 8px; font-size: 11.5px; color: #b5bac1; }
  .bm-btn { align-self: flex-start; background: #4e5058; color: #fff; border-radius: 6px; padding: 6px 12px; font-size: 12.5px; font-weight: 500; }
</style>
