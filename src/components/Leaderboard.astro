---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import type { Locale } from '../i18n/ui';
import { localePath } from '../i18n/ui';
import type { LeaderboardData } from '../utils/leaderboard';

interface Props {
  lang: Locale;
  slug: string;
  data: LeaderboardData;
}
const { lang, slug, data } = Astro.props;

const copy = {
  en: { eyebrow: 'Leaderboard', messages: 'Messages', voice: 'Voice', rank: 'Rank', member: 'Member', level: 'Level', xp: 'XP', voiceXp: 'Voice XP', members: 'members', join: 'Join the server', copy: 'Copy link', copied: 'Link copied', prev: 'Previous', next: 'Next', page: (a: number, b: number) => `Page ${a} of ${b}`, empty: 'Nobody has earned XP here yet.', left: 'Former member', notFoundTitle: 'This leaderboard is not public', notFound: 'The server may have turned it off, or the address is wrong.', home: 'Back to Petto', minutes: 'min', messagesCount: 'messages', unavailable: 'The leaderboard could not be loaded. Try again in a moment.', by: 'Ranking by Petto', podium: 'Top three' },
  es: { eyebrow: 'Ranking', messages: 'Mensajes', voice: 'Voz', rank: 'Puesto', member: 'Miembro', level: 'Nivel', xp: 'XP', voiceXp: 'XP de voz', members: 'miembros', join: 'Unirse al servidor', copy: 'Copiar enlace', copied: 'Enlace copiado', prev: 'Anterior', next: 'Siguiente', page: (a: number, b: number) => `Página ${a} de ${b}`, empty: 'Nadie ha ganado XP aquí todavía.', left: 'Ex miembro', notFoundTitle: 'Este ranking no es público', notFound: 'Puede que el servidor lo haya desactivado, o que la dirección esté mal.', home: 'Volver a Petto', minutes: 'min', messagesCount: 'mensajes', unavailable: 'No se pudo cargar el ranking. Inténtalo de nuevo en un momento.', by: 'Ranking de Petto', podium: 'Podio' },
  'pt-BR': { eyebrow: 'Ranking', messages: 'Mensagens', voice: 'Voz', rank: 'Posição', member: 'Membro', level: 'Nível', xp: 'XP', voiceXp: 'XP de voz', members: 'membros', join: 'Entrar no servidor', copy: 'Copiar link', copied: 'Link copiado', prev: 'Anterior', next: 'Próxima', page: (a: number, b: number) => `Página ${a} de ${b}`, empty: 'Ninguém ganhou XP aqui ainda.', left: 'Ex-membro', notFoundTitle: 'Este ranking não é público', notFound: 'O servidor pode ter desativado, ou o endereço está errado.', home: 'Voltar ao Petto', minutes: 'min', messagesCount: 'mensagens', unavailable: 'Não foi possível carregar o ranking. Tente de novo em instantes.', by: 'Ranking do Petto', podium: 'Pódio' },
}[lang];

const { source, page, board, status } = data;

const base = `${localePath[lang]}/lb/${encodeURIComponent(slug)}`;
const href = (type: string, to: number) => `${base}${type === 'voice' || to > 1 ? `?${[type === 'voice' ? 'type=voice' : '', to > 1 ? `page=${to}` : ''].filter(Boolean).join('&')}` : ''}`;
const totalPages = board ? Math.max(1, Math.ceil((board.total ?? 0) / (board.pageSize ?? 25))) : 1;
const number = (value: number) => new Intl.NumberFormat(lang === 'en' ? 'en-US' : lang).format(value);
const title = board ? `${board.guild.name} · ${copy.eyebrow} · Petto` : `${copy.eyebrow} · Petto`;
// The first three of the first page stand on a podium (second on the left, first in the middle and taller, third on the right); the rest
// of the page, and every later page, stays in the list. Fewer than three members show only the places that exist.
const podium: any[] = board && page === 1 ? board.rows.filter((row: any) => row.rank >= 1 && row.rank <= 3).sort((a: any, b: any) => a.rank - b.rank) : [];
const listRows: any[] = board ? board.rows.filter((row: any) => !podium.includes(row)) : [];
const avatarOf = (row: any) => row.avatar ?? `https://cdn.discordapp.com/embed/avatars/${Number(BigInt(row.userId) >> 22n) % 6}.png`;
---

<Base
  title={title}
  lang={lang}
  description={board ? `${board.guild.name} · ${copy.by}` : undefined}
  ogTitle={board ? `${board.guild.name} · ${copy.eyebrow} · Petto` : undefined}
  ogImage={board ? `/api/og/lb/${encodeURIComponent(slug)}?lang=${lang}` : undefined}
  ogImageAlt={board ? `${board.guild.name} — ${copy.eyebrow}` : undefined}
>
  <main>
    {status === 'ok' ? (
      <section class="lb">
        <div class="wrap">
          <header class="lb-head reveal">
            {board.guild.icon ? <img class="lb-icon" src={board.guild.icon} alt="" width="64" height="64" /> : <span class="lb-icon lb-icon-ph" aria-hidden="true">{board.guild.name.slice(0, 1).toUpperCase()}</span>}
            <div class="lb-title">
              <div class="eyebrow">{copy.eyebrow}</div>
              <h1>{board.guild.name}</h1>
              {board.guild.memberCount != null && <p>{number(board.guild.memberCount)} {copy.members}</p>}
            </div>
            <div class="lb-actions">
              {board.guild.joinUrl && <a class="btn btn-primary btn-sm" href={board.guild.joinUrl} target="_blank" rel="noopener noreferrer"><Icon name="ph:arrow-up-right" width="14" height="14" />{copy.join}</a>}
              <button type="button" class="btn btn-ghost btn-sm" data-copy-page data-copied={copy.copied}><Icon name="ph:link-simple-bold" width="14" height="14" /><span>{copy.copy}</span></button>
            </div>
          </header>

          <nav class="lb-tabs" aria-label={copy.eyebrow}>
            <a href={href('text', 1)} class:list={[{ active: source === 'text' }]} aria-current={source === 'text' ? 'page' : undefined}>{copy.messages}</a>
            <a href={href('voice', 1)} class:list={[{ active: source === 'voice' }]} aria-current={source === 'voice' ? 'page' : undefined}>{copy.voice}</a>
          </nav>

          {board.rows.length === 0 ? (
            <p class="lb-empty">{copy.empty}</p>
          ) : (
            <>
              {podium.length > 0 && (
                <ol class:list={['lb-podium', `lb-podium-${podium.length}`]} aria-label={copy.podium}>
                  {podium.map((row: any) => (
                    <li class={`lb-pod lb-pod-${row.rank}`}>
                      {row.rank === 1 && <Icon class="lb-crown" name="ph:crown-simple-fill" width="26" height="26" aria-hidden="true" />}
                      <div class="lb-pod-av">
                        <img src={avatarOf(row)} alt="" width="88" height="88" loading={row.rank === 1 ? 'eager' : 'lazy'} />
                        <span class="lb-pod-badge" aria-hidden="true">{row.rank}</span>
                      </div>
                      <strong class="lb-pod-name" title={row.name ?? copy.left}>{row.name ?? copy.left}</strong>
                      <span class="lb-pod-level">{copy.level} {row.level}</span>
                      <span class="lb-pod-xp">{number(row.xp)} <small>{source === 'voice' ? copy.voiceXp : copy.xp}</small></span>
                      <div class="lb-pod-step" aria-hidden="true"><span>{row.rank}</span></div>
                    </li>
                  ))}
                </ol>
              )}
              {listRows.length > 0 && (
                <ol class="lb-list" start={listRows[0].rank}>
                  {listRows.map((row: any) => (
                    <li class:list={['lb-row', { 'lb-top': row.rank <= 3 }, `lb-r${row.rank <= 3 ? row.rank : 0}`]}>
                      <span class="lb-rank">{row.rank}</span>
                      <img class="lb-avatar" src={avatarOf(row)} alt="" width="40" height="40" loading="lazy" />
                      <div class="lb-who">
                        <strong>{row.name ?? copy.left}</strong>
                        <small><span class="lb-level-inline">{copy.level} {row.level} · </span>{source === 'voice' ? `${number(row.voiceMinutes ?? 0)} ${copy.minutes}` : `${number(row.messages ?? 0)} ${copy.messagesCount}`}</small>
                      </div>
                      <span class="lb-level">{copy.level} {row.level}</span>
                      <span class="lb-xp">{number(row.xp)} <small>{source === 'voice' ? copy.voiceXp : copy.xp}</small></span>
                    </li>
                  ))}
                </ol>
              )}
            </>
          )}

          {totalPages > 1 && (
            <nav class="lb-pager" aria-label={copy.page(page, totalPages)}>
              {page > 1 ? <a class="btn btn-ghost btn-sm" href={href(source, page - 1)} rel="prev">{copy.prev}</a> : <span class="btn btn-ghost btn-sm lb-off">{copy.prev}</span>}
              <span>{copy.page(page, totalPages)}</span>
              {page < totalPages ? <a class="btn btn-ghost btn-sm" href={href(source, page + 1)} rel="next">{copy.next}</a> : <span class="btn btn-ghost btn-sm lb-off">{copy.next}</span>}
            </nav>
          )}
          <p class="lb-by">{copy.by}</p>
        </div>
      </section>
    ) : (
      <section class="lb">
        <div class="wrap lb-missing">
          <div class="eyebrow">{copy.eyebrow}</div>
          <h1>{status === 'missing' ? copy.notFoundTitle : copy.eyebrow}</h1>
          <p>{status === 'missing' ? copy.notFound : copy.unavailable}</p>
          <a class="btn btn-ghost btn-sm" href={`${localePath[lang]}/`}>{copy.home}</a>
        </div>
      </section>
    )}
  </main>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-page]').forEach((button) => {
    const label = button.querySelector('span');
    const original = label?.textContent ?? '';
    button.addEventListener('click', async () => {
      const link = `${location.origin}${location.pathname}`;
      try { await navigator.clipboard.writeText(link); } catch {
        const box = document.createElement('textarea'); box.value = link; document.body.append(box); box.select(); document.execCommand('copy'); box.remove();
      }
      if (label) { label.textContent = button.dataset.copied ?? original; setTimeout(() => { label.textContent = original; }, 1800); }
    });
  });
</script>

<style>
  .lb { padding: 112px 0 72px; }
  .lb > .wrap { max-width: 860px; margin-inline: auto; }
  .lb-head { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .lb-icon { width: 64px; height: 64px; border-radius: 18px; object-fit: cover; flex: none; background: var(--bg-raise); }
  .lb-icon-ph { display: grid; place-items: center; color: var(--accent); background: var(--accent-soft); font-weight: 700; font-size: 26px; }
  .lb-title { flex: 1 1 220px; min-width: 0; }
  .lb-title h1 { font-size: 30px; margin: 6px 0 4px; overflow-wrap: anywhere; }
  .lb-title p { margin: 0; color: var(--text-muted); font-size: 14px; }
  .lb-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .lb-tabs { display: flex; width: fit-content; gap: 4px; margin: 26px auto 18px; padding: 4px; border: 1px solid var(--border); border-radius: 999px; background: var(--card); }
  .lb-tabs a { padding: 7px 16px; border-radius: 999px; color: var(--text-muted); text-decoration: none; font-size: 13.5px; font-weight: 600; }
  .lb-tabs a.active { background: var(--accent-soft); color: var(--accent); }
  .lb-list { list-style: none; margin: 0 auto; padding: 0; display: flex; flex-direction: column; gap: 8px; max-width: 820px; }
  .lb-row { display: grid; grid-template-columns: 42px 40px minmax(0, 1fr) auto auto; align-items: center; gap: 12px; padding: 10px 14px; border: 1px solid var(--border); border-radius: 14px; background: var(--card); }
  .lb-rank { font-family: var(--mono); font-size: 14px; color: var(--text-dim); text-align: center; }
  .lb-top .lb-rank { font-weight: 700; font-size: 17px; }
  .lb-r1 { border-color: color-mix(in srgb, #f5c542 55%, var(--border)); }
  .lb-r1 .lb-rank { color: #f5c542; }
  .lb-r2 { border-color: color-mix(in srgb, #c0c6d0 55%, var(--border)); }
  .lb-r2 .lb-rank { color: #c0c6d0; }
  .lb-r3 { border-color: color-mix(in srgb, #d98b5a 55%, var(--border)); }
  .lb-r3 .lb-rank { color: #d98b5a; }
  .lb-avatar { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; background: var(--bg-raise); }
  .lb-who { min-width: 0; }
  .lb-who strong { display: block; font-size: 14.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lb-who small { color: var(--text-dim); font-size: 12px; }
  .lb-level-inline { display: none; color: var(--accent); font-weight: 600; }
  .lb-level { font-size: 12.5px; font-weight: 600; color: var(--accent); background: var(--accent-soft); padding: 4px 10px; border-radius: 999px; white-space: nowrap; }
  .lb-xp { font-weight: 700; font-size: 14.5px; text-align: right; white-space: nowrap; }
  .lb-xp small { color: var(--text-dim); font-weight: 500; font-size: 11.5px; }

  /* The podium: first in the middle and taller, second on the left, third on the right. The DOM keeps the order 1, 2, 3 (reading order). */
  .lb-podium { --gold: #e6ae17; --silver: #aab3c0; --bronze: #c9814f; list-style: none; margin: 8px auto 22px; padding: 0; max-width: 820px; display: flex; justify-content: center; align-items: flex-end; gap: 14px; }
  :global(:root[data-theme="light"]) .lb-podium { --gold: #c98f00; --silver: #8893a3; --bronze: #b0653a; }
  @media (prefers-color-scheme: light) { :global(:root:not([data-theme="dark"])) .lb-podium { --gold: #c98f00; --silver: #8893a3; --bronze: #b0653a; } }
  .lb-pod { --medal: var(--gold); position: relative; flex: 1 1 0; min-width: 0; max-width: 250px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 3px; }
  .lb-pod-1 { order: 2; --medal: var(--gold); flex-grow: 1.18; }
  .lb-pod-2 { order: 1; --medal: var(--silver); }
  .lb-pod-3 { order: 3; --medal: var(--bronze); }
  :global(.lb-crown) { color: var(--gold); margin-bottom: -2px; filter: drop-shadow(0 2px 6px color-mix(in srgb, var(--gold) 45%, transparent)); }
  .lb-pod-av { position: relative; width: 72px; height: 72px; margin-bottom: 4px; }
  .lb-pod-1 .lb-pod-av { width: 92px; height: 92px; }
  .lb-pod-av img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; background: var(--bg-raise); border: 3px solid var(--medal); box-shadow: 0 6px 18px color-mix(in srgb, var(--medal) 28%, transparent); box-sizing: border-box; }
  .lb-pod-badge { position: absolute; right: -4px; bottom: -4px; width: 24px; height: 24px; display: grid; place-items: center; border-radius: 50%; background: var(--medal); color: #1a1405; font: 700 13px var(--mono); border: 2px solid var(--bg); box-sizing: border-box; }
  .lb-pod-name { display: block; max-width: 100%; font-size: 14.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lb-pod-1 .lb-pod-name { font-size: 16.5px; }
  .lb-pod-level { font-size: 12px; font-weight: 600; color: var(--accent); background: var(--accent-soft); padding: 2px 10px; border-radius: 999px; white-space: nowrap; }
  .lb-pod-xp { max-width: 100%; font-size: 14px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lb-pod-xp small { color: var(--text-dim); font-weight: 500; font-size: 11px; }
  .lb-pod-step { width: 100%; height: 58px; margin-top: 8px; display: grid; place-items: center; border-radius: 12px 12px 4px 4px; border: 1px solid color-mix(in srgb, var(--medal) 55%, var(--border)); border-bottom: 0; background: linear-gradient(180deg, color-mix(in srgb, var(--medal) 30%, var(--card)), color-mix(in srgb, var(--medal) 8%, var(--card))); transform-origin: bottom; }
  .lb-pod-step span { font: 700 26px var(--mono); color: color-mix(in srgb, var(--medal) 70%, var(--text)); opacity: .9; }
  .lb-pod-1 .lb-pod-step { height: 104px; }
  .lb-pod-2 .lb-pod-step { height: 76px; }
  .lb-pod-3 .lb-pod-step { height: 58px; }
  .lb-podium-1 .lb-pod { max-width: 280px; }
  .lb-podium-2 .lb-pod { max-width: 240px; }
  @media (prefers-reduced-motion: no-preference) {
    .lb-pod { animation: lb-pod-in .55s cubic-bezier(.2, .8, .2, 1) backwards; }
    .lb-pod-3 { animation-delay: .05s; }
    .lb-pod-2 { animation-delay: .15s; }
    .lb-pod-1 { animation-delay: .28s; }
    .lb-pod-step { animation: lb-pod-grow .6s cubic-bezier(.2, .8, .2, 1) backwards; animation-delay: inherit; }
    :global(.lb-crown) { animation: lb-crown-in .6s cubic-bezier(.2, .9, .3, 1.3) .55s backwards; }
  }
  @keyframes lb-pod-in { from { opacity: 0; transform: translateY(18px); } }
  @keyframes lb-pod-grow { from { transform: scaleY(.15); } }
  @keyframes lb-crown-in { from { opacity: 0; transform: translateY(-10px) rotate(-12deg) scale(.7); } }
  @media (max-width: 560px) {
    .lb-podium { gap: 8px; margin-bottom: 18px; }
    .lb-pod { gap: 2px; }
    .lb-pod-av { width: 50px; height: 50px; }
    .lb-pod-1 .lb-pod-av { width: 66px; height: 66px; }
    .lb-pod-av img { border-width: 2px; }
    .lb-pod-badge { width: 20px; height: 20px; font-size: 11px; right: -3px; bottom: -3px; }
    .lb-pod-name { font-size: 12.5px; }
    .lb-pod-1 .lb-pod-name { font-size: 13.5px; }
    .lb-pod-level { font-size: 10.5px; padding: 1px 7px; }
    .lb-pod-xp { font-size: 12px; }
    .lb-pod-xp small { font-size: 9.5px; }
    :global(.lb-crown) { width: 20px; height: 20px; }
    .lb-pod-step span { font-size: 20px; }
    .lb-pod-1 .lb-pod-step { height: 78px; }
    .lb-pod-2 .lb-pod-step { height: 58px; }
    .lb-pod-3 .lb-pod-step { height: 44px; }
  }
  .lb-empty { color: var(--text-muted); font-size: 14px; text-align: center; }
  .lb-pager { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 20px; color: var(--text-muted); font-size: 13.5px; flex-wrap: wrap; }
  .lb-off { opacity: .4; pointer-events: none; }
  .lb-by { margin: 26px 0 0; font-size: 12px; color: var(--text-dim); text-align: center; }
  .lb-missing { max-width: 560px; margin: 0 auto; text-align: center; }
  .lb-missing h1 { font-size: 30px; margin: 10px 0 8px; }
  .lb-missing p { color: var(--text-muted); font-size: 14.5px; line-height: 1.65; margin: 0 0 18px; }
  @media (max-width: 560px) {
    .lb { padding-top: 88px; }
    .lb-title h1 { font-size: 24px; }
    .lb-row { grid-template-columns: 30px 36px minmax(0, 1fr) auto; gap: 10px; padding: 9px 11px; }
    .lb-level { display: none; }
    .lb-level-inline { display: inline; }
    .lb-avatar { width: 36px; height: 36px; }
  }
</style>
