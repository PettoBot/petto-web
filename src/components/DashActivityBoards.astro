---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import { getDashLang, makeT } from '../i18n/dash';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const docsUrl = `https://wiki.petto.sbs${dashLang === 'es' ? '/es' : dashLang === 'pt-BR' ? '/pt-br' : ''}/community/activity-leaderboards`;
interface Board { kind: string; channelId: string; refreshedAt: string | null; error: string | null; messages: number; periods: string[] }
interface RoleBoard { kind: string; role: { roleId: string; holderId: string | null; error: string | null } | null; roleName: string | null; holderName: string | null }
interface Props {
  user: { username: string; avatar: string | null; userId?: string };
  guildId: string;
  guildName: string;
  guildIcon: string;
  boards: { kind: string; board: Board | null; channelName: string | null }[];
  roleBoards: RoleBoard[];
  roles: { id: string; name: string }[];
  roleState: 'ok' | 'unavailable' | 'error';
  roleReasons: Record<string, string>;
  channels: { id: string; name: string }[];
  state: 'ok' | 'unavailable' | 'error';
  canEdit: boolean;
  message: { kind: 'ok' | 'err'; text: string } | null;
  problem: string | null;
  reasons: Record<string, string>;
}
const { user, guildId, guildName, guildIcon, boards, roleBoards, roles, roleState, roleReasons, channels, state, canEdit, message, problem, reasons } = Astro.props;
const roleOf = (kind: string) => roleBoards.find((entry) => entry.kind === kind) ?? null;
const day = (iso: string | null) => {
  const date = iso ? new Date(iso) : null;
  return date && Number.isFinite(date.getTime()) ? date.toLocaleString(dashLang, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '';
};
// The cards a board can have, in the order they are posted (the same as the bot's).
const periodOptions = [{ value: 'monthly', label: dt('Month') }, { value: 'weekly', label: dt('Week') }, { value: 'daily', label: dt('Day') }];
const periodsOf = (board: Board | null) => (board?.periods?.length ? board.periods : periodOptions.map((option) => option.value));
const ready = state === 'ok';
const editable = ready && canEdit;
const roleEditable = editable && roleState === 'ok';
const kindTitle = (kind: string) => (kind === 'voice' ? dt('Voice leaderboards') : dt('Chat leaderboards'));
const kindHint = (kind: string) => (kind === 'voice' ? dt('The members who spend the most minutes in voice channels.') : dt('The members who send the most messages.'));
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="activity-boards" pageTitle={dt('Activity leaderboards')}>
  <div class="ab">
    <header class="ab-head">
      <h1>{dt('Activity leaderboards')}</h1>
      <a class="btn btn-sm ab-docs" href={docsUrl} target="_blank" rel="noopener"><Icon name="ph:book-open-fill" width="13" height="13" />{dt('Read the docs')}</a>
    </header>
    <p class="ab-lead">{dt('Post the most active members in a channel: a card for the month, the week and the day (all of them or only some), updated every few minutes.')}</p>

    {message && <div class:list={['ab-flash', { 'ab-flash-err': message.kind === 'err' }]} role="status"><Icon name={message.kind === 'ok' ? 'ph:check-circle-fill' : 'ph:warning-fill'} width="15" height="15" />{message.text}</div>}
    {state === 'unavailable' && <div class="ab-flash ab-flash-warn"><Icon name="ph:plug-fill" width="15" height="15" />{dt('The leaderboards are not available yet. Petto is being updated: try again in a few minutes.')}</div>}
    {state === 'error' && <div class="ab-flash ab-flash-warn"><Icon name="ph:plug-fill" width="15" height="15" />{dt('The leaderboards could not be read. Try again in a moment.')}</div>}
    {ready && problem && <div class="ab-flash ab-flash-warn" data-ab-problem><Icon name="ph:warning-fill" width="15" height="15" />{problem}</div>}
    {ready && !canEdit && <div class="ab-flash ab-flash-warn" data-ab-readonly><Icon name="ph:eye-fill" width="15" height="15" />{dt('Only people with Manage Server can change the leaderboards, the same as the command. You can look at them.')}</div>}

    <div class="ab-grid">
      {boards.map(({ kind, board, channelName }) => (
        <section class="ab-card" data-ab-kind={kind}>
          <div class="ab-card-head">
            <h2>{kindTitle(kind)}</h2>
            <span class:list={['ab-pill', { 'ab-pill-off': !board, 'ab-pill-bad': Boolean(board?.error) }]}>
              {!board ? dt('Not set') : board.error ? dt('Needs attention') : board.refreshedAt ? dt('Updated {when}', { when: day(board.refreshedAt) }) : dt('Waiting to be written')}
            </span>
          </div>
          <p class="ab-hint">{kindHint(kind)}</p>
          {board && <p class="ab-where">{dt('Posted in')} <b>{channelName ? `#${channelName}` : dt('a channel that is gone')}</b> · {periodsOf(board).map((value) => periodOptions.find((option) => option.value === value)?.label).join(', ')}</p>}
          {board?.error && <p class="ab-problem">{reasons[board.error] ?? reasons.error}</p>}
          <form method="POST" class="ab-form" data-no-dirty>
            <input type="hidden" name="action" value="set" />
            <input type="hidden" name="kind" value={kind} />
            <label class="ab-field"><span>{dt('Channel')}</span>
              <select name="channel_id" required disabled={!editable}>
                <option value="">{dt('Choose a channel')}</option>
                {channels.map((channel) => <option value={channel.id} selected={board?.channelId === channel.id}>#{channel.name}</option>)}
              </select>
            </label>
            <fieldset class="ab-periods" disabled={!editable}>
              <legend>{dt('Cards')}</legend>
              <div class="ab-chips">
                {periodOptions.map((option) => (
                  <label class="ab-chip"><input type="checkbox" name="periods" value={option.value} checked={periodsOf(board).includes(option.value)} /><span>{option.label}</span></label>
                ))}
              </div>
              <p class="ab-periods-hint">{dt('Choose the cards this board has: at least one.')}</p>
            </fieldset>
            <button class="btn btn-accent btn-sm" type="submit" disabled={!editable || Boolean(problem)}><Icon name="ph:check-bold" width="12" height="12" />{board ? dt('Save') : dt('Post the leaderboards')}</button>
          </form>
          {editable && board && (
            <form method="POST" class="ab-remove" data-no-dirty>
              <input type="hidden" name="action" value="remove" />
              <input type="hidden" name="kind" value={kind} />
              <button class="btn btn-ghost btn-sm" type="submit" data-confirm={dt('Remove these leaderboards and delete their messages?')} aria-label={dt('Remove')}><Icon name="ph:trash-bold" width="13" height="13" /><span>{dt('Remove')}</span></button>
            </form>
          )}
          <div class="ab-role" data-ab-role={kind}>
            <h3>{kind === 'voice' ? dt('Role of the most active talker') : dt('Role of the most active chatter')}</h3>
            <p class="ab-hint ab-role-hint">{dt('When each week ends, the number 1 of the week gets this role and the one who had it loses it.')}</p>
            {roleOf(kind)?.role && (
              <p class="ab-where">
                {dt('Role')} <b>{roleOf(kind)?.roleName ? `@${roleOf(kind)?.roleName}` : dt('a role that is gone')}</b> ·
                {roleOf(kind)?.role?.holderId ? <>{' '}{dt('has it now:')}{' '}<b>{roleOf(kind)?.holderName ?? dt('a member who left')}</b></> : <>{' '}{dt('nobody has it yet')}</>}
              </p>
            )}
            {roleOf(kind)?.role?.error && <p class="ab-problem">{roleReasons[roleOf(kind)!.role!.error!] ?? roleReasons.error}</p>}
            {roleState !== 'ok' && ready && <p class="ab-problem">{roleState === 'unavailable' ? dt('The roles are not available yet. Petto is being updated: try again in a few minutes.') : dt('The roles could not be read. Try again in a moment.')}</p>}
            <form method="POST" class="ab-form ab-form-role" data-no-dirty>
              <input type="hidden" name="action" value="role-set" />
              <input type="hidden" name="kind" value={kind} />
              <label class="ab-field"><span>{dt('Role')}</span>
                <select name="role_id" required disabled={!roleEditable} data-give-role>
                  <option value="">{dt('Choose a role')}</option>
                  {roles.map((role) => <option value={role.id} selected={roleOf(kind)?.role?.roleId === role.id}>@{role.name}</option>)}
                </select>
              </label>
              <button class="btn btn-accent btn-sm" type="submit" disabled={!roleEditable || Boolean(problem)}><Icon name="ph:check-bold" width="12" height="12" />{roleOf(kind)?.role ? dt('Save') : dt('Give this role')}</button>
            </form>
            {roleEditable && roleOf(kind)?.role && (
              <form method="POST" class="ab-remove" data-no-dirty>
                <input type="hidden" name="action" value="role-remove" />
                <input type="hidden" name="kind" value={kind} />
                <button class="btn btn-ghost btn-sm" type="submit" data-confirm={dt('Stop giving this role and take it from who has it?')} aria-label={dt('Remove the role')}><Icon name="ph:trash-bold" width="13" height="13" /><span>{dt('Remove the role')}</span></button>
              </form>
            )}
          </div>
        </section>
      ))}
    </div>

    <section class="ab-card ab-how">
      <div class="ab-card-head"><h2>{dt('How it works')}</h2></div>
      <ul class="ab-notes">
        <li>{dt('Each kind is one message in its channel, with a card for each period you choose (the month, the week, the day) one under the other, and Petto edits it about every 5 minutes, only when the numbers change. If someone deletes it, Petto writes it again.')}</li>
        <li>{dt('Days, weeks (Monday to Sunday) and months are counted in GMT-5, the time of Petto.')}</li>
        <li>{dt('Petto uses the numbers it already keeps for the statistics of the server, never what was said. Members who asked not to be counted, bots and members who left are not shown.')}</li>
        <li>{dt('Petto needs View Channel, Send Messages and Read Message History in the channel. If you change the channel, the old message is deleted and the board is written again in the new one. If you take a card away or add one, the same message is edited.')}</li>
        <li>{dt('The role goes to the number 1 of the week when the week ends (Monday, GMT-5). Petto needs Manage Roles and the role has to be below its highest role. When you choose a role, last week\'s number 1 gets it within a few minutes.')}</li>
      </ul>
    </section>
  </div>
</DashGuildLayout>

<script>
  // At least one card has to be checked; the page that receives the form checks it too, this only saves the trip.
  document.querySelectorAll<HTMLElement>('.ab-periods').forEach((box) => {
    box.closest('form')?.addEventListener('submit', (event) => {
      if (!box.querySelector('input:checked')) { event.preventDefault(); box.classList.add('ab-periods-bad'); }
    });
    box.addEventListener('change', () => box.classList.remove('ab-periods-bad'));
  });
</script>

<style>
  .ab { max-width: 1180px; display: flex; flex-direction: column; min-height: 100%; }
  .ab-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 14px; margin: 0 0 8px; }
  .ab-head h1 { font-size: 24px; margin: 0; }
  .ab-docs { display: inline-flex; align-items: center; gap: 6px; }
  .ab-lead { margin: 0 0 16px; font-size: 14px; color: var(--text-muted); }
  .ab h2 { font-size: 15px; margin: 0; }
  .ab-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid color-mix(in srgb, var(--green) 55%, transparent); border-radius: 10px; padding: 9px 12px; margin: 0 0 14px; }
  .ab-flash :global(svg) { flex: none; }
  .ab-flash-err { color: var(--red, #ff6b6b); background: color-mix(in srgb, var(--red, #ff6b6b) 10%, transparent); border-color: color-mix(in srgb, var(--red, #ff6b6b) 55%, transparent); }
  .ab-flash-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: color-mix(in srgb, var(--yellow) 55%, transparent); }
  .ab-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; align-items: start; }
  .ab-card { border: 1px solid var(--border); border-radius: 14px; background: var(--card); min-width: 0; padding: 0; margin: 0; }
  .ab-card-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--border); }
  .ab-pill { font-size: 12.5px; font-weight: 700; padding: 2px 10px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); white-space: nowrap; }
  .ab-pill-off { background: color-mix(in srgb, var(--text-dim) 18%, transparent); color: var(--text-dim); }
  .ab-pill-bad { background: color-mix(in srgb, var(--yellow) 18%, transparent); color: var(--yellow); }
  .ab-hint, .ab-where, .ab-problem { margin: 0; padding: 10px 16px 0; font-size: 13px; color: var(--text-muted); overflow-wrap: anywhere; }
  .ab-where b { color: var(--text); }
  .ab-problem { color: var(--yellow); }
  .ab-form { display: flex; flex-direction: column; gap: 12px; padding: 12px 16px 16px; }
  .ab-field { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .ab-field > span { font-size: 13px; font-weight: 600; }
  .ab-field select { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; min-width: 0; }
  .ab-field select:disabled { opacity: .6; }
  .ab-periods { border: 0; margin: 0; padding: 0; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .ab-periods legend { font-size: 13px; font-weight: 600; padding: 0; margin: 0 0 5px; }
  .ab-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .ab-chip { position: relative; cursor: pointer; }
  .ab-chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .ab-chip span { display: inline-block; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--border); background: var(--card); color: var(--text-muted); font-size: 13px; font-weight: 600; transition: background .12s, color .12s, border-color .12s; }
  .ab-chip input:checked + span { background: color-mix(in srgb, var(--green) 16%, transparent); border-color: color-mix(in srgb, var(--green) 60%, transparent); color: var(--green); }
  .ab-chip input:focus-visible + span { outline: 2px solid var(--green); outline-offset: 2px; }
  .ab-periods:disabled .ab-chip { cursor: not-allowed; }
  .ab-periods:disabled .ab-chip span { opacity: .6; }
  .ab-periods-hint { margin: 0; font-size: 12.5px; color: var(--text-dim); }
  .ab-periods-bad .ab-periods-hint { color: var(--red, #ff6b6b); }
  .ab-form button[type="submit"] { align-self: flex-start; }
  .ab-form button[type="submit"]:disabled { opacity: .5; cursor: not-allowed; }
  .ab-role { border-top: 1px solid var(--border); margin-top: 6px; }
  .ab-role h3 { font-size: 14px; margin: 0; padding: 12px 16px 0; }
  .ab-role-hint { padding-top: 4px; }
  .ab-remove { margin: 0; padding: 0 16px 14px; }
  .ab-remove :global(button) { color: var(--red, #e5484d); }
  .ab-how { margin-top: 16px; }
  .ab-notes { margin: 0; padding: 12px 16px 14px 32px; display: grid; gap: 6px; font-size: 13.5px; color: var(--text-muted); }
  @media (max-width: 900px) { .ab-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 720px) { .ab-card-head { padding: 10px 14px; flex-wrap: wrap; } .ab-hint, .ab-where, .ab-problem { padding-left: 14px; padding-right: 14px; } .ab-form, .ab-remove { padding-left: 14px; padding-right: 14px; } }
</style>
