---
// The one-line tip under a text field whose text becomes message content (or Components V2 text): a `!` before a mention shows it
// without notifying anyone. The words are the dashboard's (dt); what is between backticks is drawn as code. The React editors have the
// same line in src/react/embeds/SilentHint.tsx.
import { getDashLang, makeT } from '../i18n/dash';
const dt = makeT(getDashLang(Astro));
const parts = dt('Tip: put `!` before a mention (`!@everyone`, `!@Role`) to show it without notifying anyone.').split('`');
---
<span class="dgl-silent-hint">{parts.map((part, index) => (index % 2 ? <code>{part}</code> : part))}</span>
<style is:global>
  .dgl-silent-hint { display: block; margin: 4px 0 0; font-size: 11.5px; line-height: 1.4; font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--text-dim); overflow-wrap: anywhere; }
  .dgl-silent-hint code { font-family: var(--mono); font-size: 11px; padding: 0 3px; border-radius: 4px; background: var(--bg-raise); color: var(--text); }
</style>
