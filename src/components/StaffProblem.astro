---
import { getDashLang, makeT } from '../i18n/dash';
import type { StaffProblem } from '../utils/staffProblem';
// The message of a staff page that has nothing to show: the bot is away, the bot does not know this account as the owner, or the bot has not been restarted with
// the latest code. See utils/staffProblem.ts.
interface Props { problem?: StaffProblem }
const { problem = 'down' } = Astro.props;
const dt = makeT(getDashLang(Astro));
---
<p class="be-down" role="alert">
  {problem === 'forbidden'
    ? dt('The bot does not know this account as the owner. Check that the owner ID saved in the bot is the one of the account you logged in with, and restart the bot.')
    : problem === 'old'
      ? dt('The bot answered, but it does not know this page yet. Restart the bot with the latest update.')
      : dt('Petto did not answer. Try again in a moment.')}
</p>
