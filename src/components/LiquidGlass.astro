---
// The liquid glass used by the top bar and the bar at the bottom of the phone. It is the same recipe as kythia.xyz: a layer that
// blurs what is behind it, and a filter on that layer (waves of noise, a point of light on a wet surface, and a displacement
// of the picture along the waves) so the page behind seems to flow under the glass. Anything that has the `lg-glass` class gets it.
---
<svg class="lg-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <filter id="lg-filter" x="0%" y="0%" width="100%" height="100%" filterUnits="objectBoundingBox">
    <feTurbulence type="fractalNoise" baseFrequency="0.01 0.01" numOctaves="1" seed="5" result="turbulence" />
    <feGaussianBlur in="turbulence" stdDeviation="3" result="softMap" />
    <feSpecularLighting in="softMap" surfaceScale="5" specularConstant="1" specularExponent="100" lighting-color="white" result="specLight">
      <fePointLight x="-200" y="-200" z="300" />
    </feSpecularLighting>
    <feComposite in="specLight" operator="arithmetic" k1="0" k2="1" k3="1" k4="0" result="litImage" />
    <feDisplacementMap in="SourceGraphic" in2="softMap" scale="30" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>

<style is:global>
  /* Zero-sized and not display:none, so that every browser still finds the filter. */
  .lg-defs { position: absolute; width: 0; height: 0; overflow: hidden; pointer-events: none; }

  .lg-glass, body.public-body header.nav {
    isolation: isolate;
    background: rgba(255, 255, 255, 0.05);
  }
  :root[data-theme='light'] .lg-glass, :root[data-theme='light'] body.public-body header.nav { background: rgba(255, 255, 255, 0.34); }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme='dark']) .lg-glass, :root:not([data-theme='dark']) body.public-body header.nav { background: rgba(255, 255, 255, 0.34); }
  }

  /* The shine of the top edge and a soft inner glow. */
  .lg-glass::before, body.public-body header.nav::before {
    content: ''; position: absolute; inset: 0; z-index: 0; border-radius: inherit; pointer-events: none;
    /* A point of light that moves with the page and with your finger or pointer, so the glass answers to what you do. */
    background: radial-gradient(130px 70px at var(--lg-x, 30%) 0%, rgba(255, 255, 255, 0.2), transparent 70%);
    box-shadow:
      inset 0 1.5px 0 0 rgba(255, 255, 255, 0.55),
      inset 0 -1px 0 0 rgba(255, 255, 255, 0.08),
      inset 1px 0 0 0 rgba(255, 255, 255, 0.12),
      inset -1px 0 0 0 rgba(255, 255, 255, 0.08),
      inset 0 4px 8px 0 rgba(255, 255, 255, 0.08);
  }
  /* The glass itself: what is behind it, blurred a little, and then bent by the filter. */
  .lg-glass::after, body.public-body header.nav::after {
    content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; pointer-events: none; overflow: hidden;
    -webkit-backdrop-filter: blur(4px) saturate(1) brightness(1.05); backdrop-filter: blur(4px) saturate(1) brightness(1.05);
    -webkit-filter: url(#lg-filter); filter: url(#lg-filter);
  }
  /* The old blur of the top bar would hide the page from the glass layer (it makes the bar the root of its own backdrop). */
  body.public-body header.nav { -webkit-backdrop-filter: none; backdrop-filter: none; }

  @media (prefers-reduced-transparency: reduce) {
    .lg-glass::after, body.public-body header.nav::after { -webkit-filter: none; filter: none; -webkit-backdrop-filter: none; backdrop-filter: none; background: var(--card); }
  }
  @media (prefers-reduced-motion: reduce) { .lg-glass::after, body.public-body header.nav::after { -webkit-filter: none; filter: none; } }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var frame = 0;
    var set = function (x) { root.style.setProperty('--lg-x', Math.max(0, Math.min(100, x)).toFixed(1) + '%'); };
    // Scrolling slides the light along the bars, from one end of the page to the other.
    var onScroll = function () {
      if (frame) return;
      frame = requestAnimationFrame(function () {
        frame = 0;
        var room = document.documentElement.scrollHeight - window.innerHeight;
        set(room > 0 ? (window.scrollY / room) * 100 : 30);
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    // A finger or a pointer over the screen pulls it to where it is.
    var onMove = function (event) {
      var point = event.touches ? event.touches[0] : event;
      if (point) set((point.clientX / window.innerWidth) * 100);
    };
    window.addEventListener('pointermove', onMove, { passive: true });
    window.addEventListener('touchmove', onMove, { passive: true });
  })();
</script>
