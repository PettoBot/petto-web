---
import DashGuildLayout from './DashGuildLayout.astro';
import CardsApp from '../react/cards/CardsApp';
import { getDashLang, makeT } from '../i18n/dash';
import { userCardData } from '../utils/discordCosmetics.mjs';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null; userId?: string };
  guildId: string;
  guildName: string;
  guildIcon: string;
  selected: string;
}
const { user, guildId, guildName, guildIcon, selected } = Astro.props;
// What Discord shows around the person (decoration and nameplate), for the card preview, as still pictures.
const look = userCardData(user);
const decorationUrl = look.decoration?.still?.replace('size=96', 'size=256') ?? '';
const nameplateUrl = look.nameplate?.still ?? '';
import SkeletonBlocks from './SkeletonBlocks.astro';
import DashReactWords from './DashReactWords.astro';
import DashAcData from './DashAcData.astro';
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="cards" pageTitle="Image cards">
  <div class="crd-page">
    <header class="crd-head">
      <h1>{dt('Image cards')}</h1>
      <p class="crd-lead">{dt('The pictures of welcome and rank messages. Design a card here, then pick it in an embed template, under Image card.')}</p>
    </header>
    <DashAcData />
    <DashReactWords />
    <CardsApp client:only="react" guildId={guildId} premiumUrl="/dash/premium" initialSelected={selected} userId={String(user.userId ?? '')} userName={user.username} userAvatarUrl={user.avatar ?? '/assets/mascot-icon.webp'} serverName={guildName} serverIconUrl={guildIcon} decorationUrl={decorationUrl} nameplateUrl={nameplateUrl} ><SkeletonBlocks slot="fallback" variant="editor" /></CardsApp>
  </div>
</DashGuildLayout>

<style>
  .crd-page { max-width: none; }
  .crd-head { margin-bottom: 18px; }
  h1 { font-size: 26px; margin: 0 0 6px; overflow-wrap: anywhere; }
  .crd-lead { margin: 0; font-size: 14.5px; line-height: 1.55; color: var(--text-muted); max-width: 76ch; }
</style>
