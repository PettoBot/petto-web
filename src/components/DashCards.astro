---
import DashGuildLayout from './DashGuildLayout.astro';
import CardsApp from '../react/cards/CardsApp';
import { getDashLang, makeT } from '../i18n/dash';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null; userId?: string };
  guildId: string;
  guildName: string;
  guildIcon: string;
  selected: string;
}
const { user, guildId, guildName, guildIcon, selected } = Astro.props;
import SkeletonBlocks from './SkeletonBlocks.astro';
import DashReactWords from './DashReactWords.astro';
import DashAcData from './DashAcData.astro';
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="cards" pageTitle="Image cards">
  <h1>{dt('Image cards')}</h1>
  <DashAcData />
  <DashReactWords />
  <CardsApp client:only="react" guildId={guildId} premiumUrl="/dash/premium" initialSelected={selected} userId={String(user.userId ?? '')} userName={user.username} userAvatarUrl={user.avatar ?? '/assets/mascot-icon.webp'} serverName={guildName} serverIconUrl={guildIcon} ><SkeletonBlocks slot="fallback" variant="editor" /></CardsApp>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 18px; }
</style>
