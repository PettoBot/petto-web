---
import { Icon } from 'astro-icon/components';
import { guildLetter, guildLetterStyle } from '../utils/guildLetter.mjs';
import { getDashLang, makeT } from '../i18n/dash';

interface RailGuild {
  id: string;
  name: string;
  icon: string | null;
  premium?: boolean;
}

interface Props {
  user: { username: string; avatar: string | null };
  guilds: RailGuild[];
  activeGuildId?: string;
}

const { user, guilds, activeGuildId = '' } = Astro.props;
const dt = makeT(getDashLang(Astro));
const onProfile = !activeGuildId;
const dashTip = dt('Your dashboard');
---
<nav class="vx-rail" id="vx-rail" aria-label={dt('Servers')}>
  <a href="/dash/me" class:list={['vx-rail-item vx-rail-me', { active: onProfile }]} data-tip={dashTip} aria-label={dashTip} aria-current={onProfile ? 'page' : undefined}>
    <i class="vx-rail-pill" aria-hidden="true"></i>
    {user.avatar ? (
      <img src={user.avatar} alt="" width="44" height="44" referrerpolicy="no-referrer" draggable="false" />
    ) : (
      <span class="vx-rail-fallback"><Icon name="ph:user-fill" width="20" height="20" /></span>
    )}
  </a>

  <div class="vx-rail-sep" aria-hidden="true"></div>

  <div class="vx-rail-list">
    {guilds.map((g) => {
      const isActive = g.id === activeGuildId;
      return (
        <a href={`/dash/guild/${g.id}/overview`} class:list={['vx-rail-item', { active: isActive }]} data-tip={g.name} data-tip-prem={g.premium ? '1' : undefined} aria-label={g.name} aria-current={isActive ? 'page' : undefined}>
          <i class="vx-rail-pill" aria-hidden="true"></i>
          {g.icon ? (
            <img src={g.icon} alt="" width="44" height="44" loading="lazy" referrerpolicy="no-referrer" draggable="false" />
          ) : (
            <span class="vx-rail-letter" style={guildLetterStyle(g.name)}>{guildLetter(g.name)}</span>
          )}
        </a>
      );
    })}

    <button type="button" class="vx-rail-item vx-rail-add" data-sheet-open data-tip={dt('Add a server')} aria-haspopup="dialog" aria-expanded="false" aria-controls="ds-sheet" aria-label={dt('Add a server')}>
      <Icon name="ph:plus" width="20" height="20" />
    </button>
  </div>
</nav>
<div class="vx-rail-tip" id="vx-rail-tip" role="tooltip" hidden></div>
<script is:inline>
  (function () {
    var rail = document.getElementById('vx-rail');
    var tip = document.getElementById('vx-rail-tip');
    if (!rail || !tip || rail.dataset.tipBound) return;
    rail.dataset.tipBound = '1';
    function show(el) {
      var text = el.getAttribute('data-tip');
      if (!text) return;
      var prem = el.getAttribute('data-tip-prem') === '1';
      tip.textContent = '';
      var span = document.createElement('span');
      span.textContent = text;
      tip.appendChild(span);
      if (prem) {
        var badge = document.createElement('em');
        badge.className = 'vx-rail-tip-prem';
        badge.textContent = 'Premium';
        tip.appendChild(badge);
      }
      var r = el.getBoundingClientRect();
      tip.style.left = Math.round(r.right + 12) + 'px';
      tip.style.top = Math.round(r.top + r.height / 2) + 'px';
      tip.hidden = false;
      requestAnimationFrame(function () { tip.classList.add('on'); });
    }
    function hide() {
      tip.classList.remove('on');
      tip.hidden = true;
    }
    rail.addEventListener('pointerover', function (e) {
      var item = e.target && e.target.closest ? e.target.closest('.vx-rail-item[data-tip]') : null;
      if (item) show(item);
    });
    rail.addEventListener('pointerout', function (e) {
      var item = e.target && e.target.closest ? e.target.closest('.vx-rail-item[data-tip]') : null;
      if (item) hide();
    });
    rail.addEventListener('scroll', hide, { passive: true });
  })();
</script>
