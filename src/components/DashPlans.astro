---
// The plans of a person (/dash/plans): Bronze, Silver and Gold, with what each gives. What already works is listed plainly; what is coming has a "Soon" tag, so nothing is
// promised that does not exist. The payment is not connected yet: until it is, the team gives a plan by hand (the button says so).
import DashMeLayout from './DashMeLayout.astro';
import DashPanelHead from './DashPanelHead.astro';
import DashShopShared from './DashShopShared.astro';
import CheckoutConsent from './CheckoutConsent.astro';
import { getDashLang, makeT } from '../i18n/dash';
import type { Session } from '../utils/session';

interface Perks { price: number; aiPerDay: number; showcaseSlots: number; ownBadges: number; ceramosPerDay: number; streakFreezes: number; limitsBonus: number; ownBackground: string }
interface Props { user: Session; plans: Record<string, Perks> | null; current: { plan: string; active: boolean; endsAt: string | null } | null; checkout?: Record<string, boolean> }
const { user, plans, current, checkout = {} } = Astro.props;
const lang = getDashLang(Astro);
const dt = makeT(lang);
const date = new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'long', year: 'numeric' });
const names: Record<string, string> = { bronze: dt('Bronze'), silver: dt('Silver'), gold: dt('Gold') };
const mine = current?.active ? current.plan : null;
// Each line: the text, and whether it already works. A line that does not work yet says "Soon".
const lines = (key: string, perks: Perks): { text: string; live: boolean }[] => [
  { text: dt('{n} ceramos a day', { n: perks.ceramosPerDay }), live: true },
  { text: dt('Places in the showcase of your profile: {n}', { n: perks.showcaseSlots }), live: true },
  { text: dt('Uses of the AI a day: {n}', { n: perks.aiPerDay }), live: true },
  { text: dt('Badges of your own: {n}', { n: perks.ownBadges }), live: true },
  { text: dt('Streak freezes in each streak: {n}', { n: perks.streakFreezes }), live: true },
  ...(perks.ownBackground === 'still' ? [{ text: dt('Your own picture as the background of your rank card'), live: true }] : []),
  ...(perks.ownBackground === 'animated' ? [{ text: dt('An animated background (GIF) on your rank card'), live: true }] : []),
  { text: dt('More reminders waiting at once: +{n}%', { n: perks.limitsBonus }), live: true },
];
const ui = { down: dt('Petto did not answer. Try again in a moment.') };
---
<DashMeLayout user={user} active="plans" pageTitle="Plans">
  <DashShopShared />
  <DashPanelHead title={dt('Plans')} eyebrow={dt('Subscriptions')} icon="ph:star-fill" back={false} />
  {!plans && <p class="bd-down" role="alert">{ui.down}</p>}
  {plans && (
    <div class="pl">
      <p class="pl-intro">{dt('Monthly plans for you, outside the servers. Cancel whenever you want: it stays active until the end of the paid period. The Premium of a server is separate.')}</p>
      <div class="pl-grid">
        {(['bronze', 'silver', 'gold'] as const).map((key) => (
          <article class:list={['bd-card', 'pl-card', { 'is-mine': mine === key, 'is-best': key === 'gold' }]}>
            <header>
              <img src={`/assets/badges/plan-${key}.png`} alt="" width="44" height="44" />
              <div><h2>{names[key]}</h2>{key === 'gold' && <span class="pl-best">{dt('Most complete')}</span>}</div>
            </header>
            <p class="pl-price"><b>${plans[key].price.toFixed(2)}</b> <span>{dt('/ month')}</span></p>
            {key !== 'bronze' && <p class="pl-more">{dt('Everything in the plan before, and also:')}</p>}
            <ul>
              {lines(key, plans[key]).map((line) => <li class:list={{ 'is-soon': !line.live }}>{line.text}{!line.live && <i class="pl-soon">{dt('Soon')}</i>}</li>)}
            </ul>
            {mine === key
              ? <span class="btn pl-have">{dt('Your plan')}{current?.endsAt && ` · ${dt('until {date}', { date: date.format(new Date(current.endsAt)) })}`}</span>
              : checkout[key]
                ? <a class="btn pl-ask pl-buy" href={`/dash/plans?buy=${key}`}>{dt('Choose {plan}', { plan: names[key] })}</a>
                : <a class="btn pl-ask" href="/support" rel="noopener">{dt('Ask the team for it')}</a>}
          </article>
        ))}
      </div>
      <p class="pl-note">{dt('Payments are not refunded, except a charge that was duplicated, made by mistake or never activated. The Premium of a server is separate.')}</p>
    </div>
    <CheckoutConsent lang={lang} />
  )}
</DashMeLayout>

<style is:global>
  .pl { display: flex; flex-direction: column; gap: 16px; }
  .pl-intro, .pl-note { margin: 0; color: var(--text-muted); font-size: 14px; }
  .pl-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 14px; align-items: stretch; }
  .pl-card { display: flex; flex-direction: column; gap: 10px; }
  .pl-card.is-best { border-color: color-mix(in srgb, #f4cf3a 55%, transparent); }
  .pl-card.is-mine { border-color: var(--green); }
  .pl-card header { display: flex; align-items: center; gap: 12px; min-height: 56px; }
  .pl-card h2 { margin: 0; font-size: 20px; }
  .pl-best { display: inline-block; margin-top: 2px; font-size: 11px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: #f4cf3a; }
  .pl-price { margin: 0; color: var(--text-muted); } .pl-price b { color: var(--text); font-size: 30px; }
  .pl-more { margin: 0; font-size: 13px; color: var(--text-muted); }
  .pl-card ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; flex: 1; font-size: 14px; }
  .pl-card li { position: relative; padding-left: 16px; line-height: 1.4; }
  .pl-card li::before { content: ''; position: absolute; left: 0; top: .5em; width: 7px; height: 7px; border-radius: 50%; background: var(--green); }
  .pl-card li.is-soon { color: var(--text-muted); } .pl-card li.is-soon::before { background: color-mix(in srgb, var(--text) 25%, transparent); }
  .pl-soon { margin-left: 8px; font-style: normal; font-size: 11px; font-weight: 700; padding: 1px 7px; border-radius: 999px; background: color-mix(in srgb, var(--text) 10%, transparent); color: var(--text-muted); }
  .pl-ask, .pl-have { display: flex; justify-content: center; align-items: center; text-align: center; padding: 11px 14px; border-radius: 12px; border: 1px solid var(--border-soft); background: color-mix(in srgb, var(--text) 6%, transparent); color: var(--text); font-weight: 600; text-decoration: none; }
  .pl-buy { background: var(--green); color: var(--green-ink); border-color: transparent; }
  .pl-have { background: var(--green-soft); color: var(--green-text); border-color: transparent; cursor: default; }
</style>
