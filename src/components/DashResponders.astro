---
import EmojiPicker from './EmojiPicker.astro';
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import MultiSelect from './MultiSelect.astro';
import DashAcData from './DashAcData.astro';

import { getDashLang, makeT } from '../i18n/dash';
import { FREE_LIMITS } from '../utils/planLimits';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
const dth = makeT(dashLang, true);
interface Responder { name: string; label: string; emoji: string; style: string; reply: string; replyTemplate: string; give: string[]; remove: string[]; required: string[]; toggle: boolean; deleteMessage: boolean; reactEmoji: string; sendChannelId: string; }
interface Panel { name: string; kind: string; content: string; embedTemplate: string; responders: string[]; placeholder: string; exclusive: boolean; channelId: string; }
interface Props {
  customEmojis?: { id: string; name: string; animated: boolean }[];
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  responders: Responder[];
  panels: Panel[];
  roles: { id: string; name: string }[];
  channels: { id: string; name: string }[];
  embedTemplates: { name: string; v2: boolean }[];
  limits: { responders: number; panels: number };
  premium: boolean;
  ready: boolean;
  saved: boolean;
  notice: string;
}
const { user, guildId, guildName, guildIcon, customEmojis = [], responders, panels, roles, channels, embedTemplates, limits, premium, ready, saved, notice } = Astro.props;
const styles = [['primary', 'Blue'], ['secondary', 'Grey'], ['success', 'Green'], ['danger', 'Red']];
const blank: Responder = { name: '', label: '', emoji: '', style: 'secondary', reply: '', replyTemplate: '', give: [], remove: [], required: [], toggle: false, deleteMessage: false, reactEmoji: '', sendChannelId: '' };
const blankPanel: Panel = { name: '', kind: 'buttons', content: '', embedTemplate: '', responders: [], placeholder: '', exclusive: false, channelId: '' };
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="responders" pageTitle="Buttons and panels">
  <h1>{dt('Buttons and panels')}</h1>
  <p class="br-sub"><Fragment set:html={dth('Buttons and menus for <b>{a}</b> that answer in private and give or take roles. Make the buttons first, then put them in a panel and post it with the command.', { a: guildName })} /></p>
  {saved && <div class="br-flash"><Icon name="ph:check-circle-fill" width="15" height="15" />{dt('Saved.')}</div>}
  {notice === 'bad_name' && <div class="br-flash br-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('The name can have letters, numbers, dashes and underscores, up to 60.')}</div>}
  {notice === 'responder_limit' && <div class="br-flash br-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This server already has {a} button responders. Premium raises the limit.', { a: limits.responders })}</div>}
  {notice === 'panel_limit' && <div class="br-flash br-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This server already has {a} panels. Premium raises the limit.', { a: limits.panels })}</div>}
  {!ready && <div class="br-flash br-flash-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}

  <DashAcData roles={roles} channels={channels} emojis={customEmojis} />
  <h2 class="br-h2">{dt('Button responders')} <span class="br-count">{responders.length} / {limits.responders}</span></h2>
  <div class="br-list">
    {[...responders, null].map((r) => {
      const item = r ?? blank;
      return (
        <details class="br-item" open={!r && responders.length === 0}>
          <summary>{r ? <><span class={`br-chip br-${item.style}`}>{item.emoji} {item.label || item.name}</span><code>{item.name}</code></> : <><Icon name="ph:plus-bold" width="12" height="12" />{dt('New button responder')}</>}</summary>
          <form method="POST" class="br-form">
            <input type="hidden" name="action" value="save_responder" />
            <div class="br-row">
              <div class="br-field"><label>{dt('Name')}</label><input type="text" name="name" value={item.name} maxlength="60" required readonly={Boolean(r)} placeholder="vip-role" /></div>
              <div class="br-field"><label>{dt('Button text')}</label><input type="text" name="label" value={item.label} maxlength="80" /></div>
              <div class="br-field"><label>{dt('Emoji')}</label><input type="text" name="emoji" data-emoji-input value={item.emoji} maxlength="64" placeholder="🌸" /></div>
              <div class="br-field"><label>{dt('Color')}</label><select name="style">{styles.map(([value, label]) => <option value={value} selected={value === item.style}>{dt(label)}</option>)}</select></div>
            </div>
            <div class="br-field"><label>{dt('Roles to give')}</label><MultiSelect lazy name="give_role_ids" options={roles} selected={item.give} placeholder={dt('Search roles...')} /></div>
            <div class="br-field"><label>{dt('Roles to take')}</label><MultiSelect lazy name="remove_role_ids" options={roles} selected={item.remove} placeholder={dt('Search roles...')} /></div>
            <div class="br-field"><label>{dt('Roles needed to use it')}</label><MultiSelect lazy name="required_role_ids" options={roles} selected={item.required} placeholder={dt('Everyone')} /></div>
            <label class="br-check"><input type="checkbox" name="toggle" checked={item.toggle} />{dt('Take the roles back when it is clicked again')}</label>
            <label class="br-check"><input type="checkbox" name="delete_message" checked={item.deleteMessage} />{dt('Delete the message the button is on after it is used')}</label>
            <div class="br-row">
              <div class="br-field"><label>{dt('React to that message with')}</label><input type="text" name="react_emoji" data-emoji-input value={item.reactEmoji} maxlength="64" placeholder="👍" /></div>
              <div class="br-field"><label>{dt('Send the answer in a channel')}</label><select name="send_channel_id"><option value="">{dt('No, answer in private')}</option>{channels.map((ch) => <option value={ch.id} selected={ch.id === item.sendChannelId}>#{ch.name}</option>)}</select></div>
            </div>
            <div class="br-field"><label>{dt('Private reply')}</label><textarea name="reply" data-ac rows="3" maxlength="2000" placeholder={dt('Empty says what changed. Variables like {user.mention} work.')}>{item.reply}</textarea></div>
            <div class="br-field"><label>{dt('Or a saved embed as the reply')}</label><select name="reply_template"><option value="">{dt('No saved embed')}</option>{embedTemplates.map((tpl) => <option value={tpl.name} selected={tpl.name === item.replyTemplate}>{tpl.name}{tpl.v2 ? ' (V2)' : ''}</option>)}</select></div>
            <div class="br-actions">
              <button type="submit" class="btn btn-accent btn-sm" disabled={!ready}>{dt('Save changes')}</button>
              {r && <button type="submit" form={`br-del-${item.name}`} class="btn btn-ghost btn-sm">{dt('Delete')}</button>}
            </div>
          </form>
          {r && <form method="POST" id={`br-del-${item.name}`}><input type="hidden" name="action" value="delete_responder" /><input type="hidden" name="name" value={item.name} /></form>}
        </details>
      );
    })}
  </div>

  <h2 class="br-h2">{dt('Panels')} <span class="br-count">{panels.length} / {limits.panels}</span></h2>
  <p class="br-note">{dt('To post a panel in a channel, or update the one already there, use')} <code>!panel send {'<name>'} #channel</code></p>
  <div class="br-list">
    {[...panels, null].map((p) => {
      const item = p ?? blankPanel;
      return (
        <details class="br-item">
          <summary>{p ? <><span class="br-chip">{item.kind === 'select' ? dt('Menu') : dt('Buttons')}</span><code>{item.name}</code><small>{item.responders.length}</small></> : <><Icon name="ph:plus-bold" width="12" height="12" />{dt('New panel')}</>}</summary>
          <form method="POST" class="br-form">
            <input type="hidden" name="action" value="save_panel" />
            <div class="br-row">
              <div class="br-field"><label>{dt('Name')}</label><input type="text" name="name" value={item.name} maxlength="60" required readonly={Boolean(p)} placeholder="roles" /></div>
              <div class="br-field"><label>{dt('Shown as')}</label><select name="kind"><option value="buttons" selected={item.kind !== 'select'}>{dt('Buttons')}</option><option value="select" selected={item.kind === 'select'}>{dt('A menu')}</option></select></div>
            </div>
            <div class="br-field"><label>{dt('Text above')}</label><textarea name="content" rows="3" maxlength="2000">{item.content}</textarea></div>
            <div class="br-field"><label>{dt('Or a saved embed')}</label><select name="embed_template"><option value="">{dt('No saved embed')}</option>{embedTemplates.map((tpl) => <option value={tpl.name} selected={tpl.name === item.embedTemplate}>{tpl.name}{tpl.v2 ? ' (V2)' : ''}</option>)}</select></div>
            <div class="br-field"><label>{dt('Menu text before choosing')}</label><input type="text" name="placeholder" value={item.placeholder} maxlength="100" /></div>
            <label class="br-check"><input type="checkbox" name="exclusive" checked={item.exclusive} />{dt('In a menu, choosing one takes back the roles the others give')}</label>
            <fieldset class="br-set"><legend>{dt('Shows these responders')}</legend>
              {responders.length === 0 && <span class="br-note">{dt('Make a button responder first.')}</span>}
              {responders.map((r) => <label class="br-check"><input type="checkbox" name="responders" value={r.name} checked={item.responders.includes(r.name)} />{r.emoji} {r.label || r.name} <code>{r.name}</code></label>)}
            </fieldset>
            <div class="br-actions">
              <button type="submit" class="btn btn-accent btn-sm" disabled={!ready}>{dt('Save changes')}</button>
              {p && <button type="submit" form={`brp-del-${item.name}`} class="btn btn-ghost btn-sm">{dt('Delete')}</button>}
            </div>
          </form>
          {p && <form method="POST" id={`brp-del-${item.name}`}><input type="hidden" name="action" value="delete_panel" /><input type="hidden" name="name" value={item.name} /></form>}
        </details>
      );
    })}
  </div>
  <p class="br-note">{dt('Commands: !responder, !panel.')}{premium ? '' : ` ${dt('Free servers can have {a} responders and {b} panels.', { a: FREE_LIMITS.buttonResponders, b: FREE_LIMITS.componentPanels })}`}</p>
  <EmojiPicker customEmojis={customEmojis} />
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0 0 6px; }
  .br-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 20px; max-width: 68ch; }
  .br-sub :global(b) { color: var(--text); }
  .br-h2 { font-size: 16px; margin: 26px 0 10px; display: flex; align-items: center; gap: 10px; }
  .br-count { font-size: 12px; color: var(--text-dim); font-weight: 500; }
  .br-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid var(--green); border-radius: 9px; padding: 10px 14px; margin-bottom: 16px; max-width: 640px; }
  .br-flash-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: var(--yellow); }
  .br-list { display: flex; flex-direction: column; gap: 8px; max-width: 980px; }
  .br-item { border: 1px solid var(--border); border-radius: 12px; background: var(--card); padding: 10px 14px; }
  .br-item summary { cursor: pointer; display: flex; align-items: center; gap: 10px; font-size: 13.5px; font-weight: 600; }
  .br-item summary small { color: var(--text-dim); font-weight: 500; }
  .br-item[open] summary { margin-bottom: 12px; }
  .br-chip { display: inline-flex; align-items: center; gap: 4px; border-radius: 6px; padding: 3px 9px; font-size: 12.5px; background: var(--bg-raise); color: var(--text); }
  .br-primary { background: #5865f2; color: #fff; } .br-success { background: #248046; color: #fff; } .br-danger { background: #da373c; color: #fff; }
  .br-form { display: flex; flex-direction: column; gap: 14px; }
  .br-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr)); gap: 12px; }
  .br-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .br-field label { font-size: 12px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.03em; }
  .br-field input, .br-field select, .br-field textarea { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; width: 100%; box-sizing: border-box; }
  .br-field textarea { resize: vertical; }
  .br-field input[readonly] { opacity: 0.7; }
  .br-check { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--text); }
  .br-check code, .br-item code { font-size: 11.5px; color: var(--text-dim); }
  .br-set { border: 1px solid var(--border-soft); border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; }
  .br-set legend { font-size: 12px; font-weight: 600; color: var(--text-dim); padding: 0 6px; }
  .br-note { font-size: 12px; line-height: 1.5; color: var(--text-dim); }
  .br-actions { display: flex; gap: 8px; }
</style>
