---
// The strip that joins the pages of the editor of the shop (only the owner sees them): the badges made by hand, the badges of the code, the packs, the banners and the name fonts.
import { getDashLang, makeT } from '../i18n/dash';
interface Props { active: 'badges' | 'builtin' | 'packs' | 'banners' | 'fonts' }
const { active } = Astro.props;
const dt = makeT(getDashLang(Astro));
const tabs = [
  { id: 'badges', href: '/dash/badges-admin', label: dt('Badges') },
  { id: 'builtin', href: '/dash/shop-admin?tab=builtin', label: dt('Badges of the code') },
  { id: 'packs', href: '/dash/shop-admin?tab=packs', label: dt('Packs') },
  { id: 'banners', href: '/dash/shop-admin?tab=banners', label: dt('Banners') },
  { id: 'fonts', href: '/dash/shop-admin?tab=fonts', label: dt('Name fonts') },
];
---
<nav class="st" aria-label={dt('Editor of the shop')}>
  {tabs.map((tab) => <a href={tab.href} class={tab.id === active ? 'is-on' : ''} aria-current={tab.id === active ? 'page' : undefined}>{tab.label}</a>)}
</nav>
<style is:global>
  .st { display: flex; gap: 6px; flex-wrap: wrap; margin: 0 0 16px; }
  .st a { padding: 8px 14px; border-radius: 999px; font-size: 14px; font-weight: 600; color: var(--text-muted); text-decoration: none; background: color-mix(in srgb, var(--text) 5%, transparent); }
  .st a:hover { color: var(--text); }
  .st a.is-on { color: var(--text); background: color-mix(in srgb, var(--text) 13%, transparent); }
</style>
