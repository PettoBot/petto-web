---
// My plan (/dash/plan): the plan of the person, when it ends, what it gives, and their ceramos. Only what exists is shown: the uses of the AI and the freezes of a streak are
// not counted yet, so they have no meter here.
import DashMeLayout from './DashMeLayout.astro';
import DashPanelHead from './DashPanelHead.astro';
import DashShopShared from './DashShopShared.astro';
import { getDashLang, makeT } from '../i18n/dash';
import type { Session } from '../utils/session';

interface Props { user: Session; state: { balance: number; plan: string | null; slots: number; daily: { amount: number }; planInfo: { plan: string; active: boolean; endsAt: string | null; source: string } | null } | null; plans: Record<string, { price: number }> | null }
const { user, state, plans } = Astro.props;
const lang = getDashLang(Astro);
const dt = makeT(lang);
const date = new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'long', year: 'numeric' });
const names: Record<string, string> = { bronze: dt('Bronze'), silver: dt('Silver'), gold: dt('Gold') };
const info = state?.planInfo ?? null;
interface Perks { aiPerDay: number; showcaseSlots: number; ownBadges: number; ceramosPerDay: number; streakFreezes: number; limitsBonus: number; ownBackground: string }
const key = (info?.active ? info.plan : 'free') as string;
const perks = ((plans as unknown as Record<string, Perks> | null)?.[key] ?? null) as Perks | null;
// What the plan gives: what already works is marked, the rest is marked as coming (the same lines as the page of plans).
const gives: { text: string; live: boolean }[] = perks ? [
  { text: dt('{n} ceramos a day', { n: perks.ceramosPerDay }), live: true },
  { text: dt('Places in the showcase of your profile: {n}', { n: perks.showcaseSlots }), live: true },
  { text: dt('Uses of the AI a day: {n}', { n: perks.aiPerDay }), live: true },
  { text: dt('Badges of your own: {n}', { n: perks.ownBadges }), live: true },
  { text: dt('Streak freezes in each streak: {n}', { n: perks.streakFreezes }), live: true },
  ...(perks.ownBackground === 'still' ? [{ text: dt('Your own picture as the background of your rank card'), live: true }] : []),
  ...(perks.ownBackground === 'animated' ? [{ text: dt('An animated background (GIF) on your rank card'), live: true }] : []),
  { text: dt('More reminders waiting at once: +{n}%', { n: perks.limitsBonus }), live: true },
] : [];
const active = Boolean(info?.active);
---
<DashMeLayout user={user} active="plan" pageTitle="My plan">
  <DashShopShared />
  <DashPanelHead title={dt('My plan')} eyebrow={dt('Subscriptions')} icon="ph:identification-badge-fill" back={false} />
  {!state && <p class="bd-down" role="alert">{dt('Petto did not answer. Try again in a moment.')}</p>}
  {state && (
    <div class="mp">
      <section class="bd-card mp-plan">
        {active && info ? (<>
          <img src={`/assets/badges/plan-${info.plan}.png`} alt="" width="56" height="56" />
          <div>
            <h2>{dt('{plan} plan', { plan: names[info.plan] ?? info.plan })}</h2>
            <p>{plans?.[info.plan] ? `$${plans[info.plan].price.toFixed(2)} ${dt('a month')}` : ''}{info.endsAt ? ` · ${dt('active until {date}', { date: date.format(new Date(info.endsAt)) })}` : ` · ${dt('no end date')}`}{info.source === 'team' ? ` · ${dt('given by the team')}` : ''}</p>
          </div>
          <div class="mp-actions">
            <a class="btn" href="/dash/plans">{dt('Change plan')}</a>
            {info.source === 'payment' && <a class="btn" href="/plans/portal" rel="noopener">{dt('Payments and cancel')}</a>}
          </div>
        </>) : (<>
          <div>
            <h2>{dt('You have no plan')}</h2>
            <p>{dt('With no plan you get {n} ceramos a day and one place in the showcase of your profile.', { n: state.daily.amount })}</p>
          </div>
          <a class="btn mp-go" href="/dash/plans">{dt('See plans')}</a>
        </>)}
      </section>
      <div class="mp-stats">
        <div class="bd-card"><span>{dt('Ceramos')}</span><b><i class="bd-coin"></i> {state.balance}</b><small>{dt('+{n} a day with your plan', { n: state.daily.amount })}</small></div>
        <div class="bd-card"><span>{dt('Places in the showcase')}</span><b>{state.slots} / 6</b><small><a href="/dash/badges">{dt('Choose your badges')}</a></small></div>
      </div>
      {gives.length > 0 && (
        <section class="bd-card mp-gives">
          <span class="mp-label">{dt('What your plan gives')}</span>
          <ul>{gives.map((line) => <li class:list={{ 'is-soon': !line.live }}>{line.text}{!line.live && <i>{dt('Soon')}</i>}</li>)}</ul>
        </section>
      )}
      <p class="mp-note">{dt('If you cancel, the plan stays active until the end of the paid period and does not renew. Payments are not refunded, except duplicated charges, charges made by mistake or never activated.')}</p>
    </div>
  )}
</DashMeLayout>

<style is:global>
  .mp { display: flex; flex-direction: column; gap: 14px; }
  .mp-plan { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .mp-plan div { flex: 1 1 220px; min-width: 0; } .mp-plan h2 { margin: 0 0 4px; font-size: 20px; } .mp-plan p { margin: 0; color: var(--text-muted); font-size: 14px; }
  .mp-actions { display: flex; gap: 8px; flex-wrap: wrap; flex: none !important; }
  .mp-go { background: var(--green); color: var(--green-ink); border-color: transparent; }
  .mp-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
  .mp-stats .bd-card { display: flex; flex-direction: column; gap: 6px; }
  .mp-stats span { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--text-muted); }
  .mp-stats b { font-size: 28px; display: inline-flex; align-items: center; gap: 8px; } .mp-stats small { color: var(--text-muted); font-size: 13px; }
  .mp-gives { display: flex; flex-direction: column; gap: 10px; }
  .mp-label { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--text-muted); }
  .mp-gives ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 8px; }
  .mp-gives li { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 12px; background: color-mix(in srgb, var(--text) 4%, transparent); font-size: 14.5px; }
  .mp-gives li.is-soon { color: var(--text-muted); } .mp-gives li i { font-style: normal; font-size: 11.5px; padding: 1px 8px; border-radius: 999px; background: color-mix(in srgb, var(--text) 10%, transparent); }
  .mp-note { margin: 0; color: var(--text-muted); font-size: 13px; }
</style>
