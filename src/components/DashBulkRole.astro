---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import SxNumber from './SxNumber.astro';
import MultiSelect from './MultiSelect.astro';

import { getDashLang, makeT, dashLocale } from '../i18n/dash';
import { etaSeconds, shortDuration, type BulkJob } from '../utils/bulkRole';
import { agoText } from '../utils/formatDuration';
import DurationScript from './DurationScript.astro';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);

interface RoleOption { id: string; name: string; color: number; memberRisk: string[]; blocked: string | null }
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  roles: RoleOption[];
  channels: { id: string; name: string }[];
  jobs: BulkJob[];
  flash: string | null;
  error: string | null;
  today: string;
}
const { user, guildId, guildName, guildIcon, roles, channels, jobs, flash, error, today } = Astro.props;

const job = jobs[0] ?? null;
const history = jobs.slice(1);
const jobActive = job ? ['pending', 'running'].includes(job.status) : false;
const locale = dashLocale(dashLang);

function roleName(id: string) {
  return roles.find((r) => r.id === id)?.name ?? id;
}
const fmt = (n: number) => n.toLocaleString(locale);
const fullDate = (value: string | null) => (value ? new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value)) : '');

const statusLabel: Record<string, string> = {
  pending: dt('Queued'), running: dt('Running'), completed: dt('Completed'), cancelled: dt('Cancelled'), failed: dt('Failed'), paused: dt('Paused'),
};
const flashText: Record<string, string> = {
  started: dt('Job started, it\'ll process in the background.'),
  previewed: dt('Preview started, the numbers show up below in a moment. Nothing is changed.'),
  cancelled: dt('The job was cancelled.'),
  paused: dt('The job is paused.'),
  resumed: dt('The job goes on.'),
};
// What the page and the bot say when a job cannot run, by the same codes (the bot saves them in `error_code`).
const errorText: Record<string, string> = {
  busy: dt('A bulk role job is already running for this server. Wait for it to finish or cancel it first.'),
  pick_role: dt('Pick a role first.'),
  save_failed: dt("Couldn't start the job, try again."),
  bad_date: dt('That date is not valid.'),
  date_order: dt('"Joined after" has to be earlier than "joined before".'),
  bad_count: dt('The number of roles has to be a whole number from 0 to 250.'),
  count_order: dt('The minimum number of roles cannot be higher than the maximum.'),
  role_gone: dt('That role no longer exists.'),
  role_everyone: dt('@everyone cannot be given or taken away.'),
  role_managed: dt('That role is managed by an integration, so Discord does not let anyone give it.'),
  role_above_bot: dt("That role is above Petto's highest role. Move Petto's role above it and try again."),
  confirm_danger: dt('This role gives powerful permissions. Tick the box to confirm you want to give it to many members.'),
  no_preview: dt('That preview is not there any more. Run it again.'),
  guild_gone: dt("Petto isn't in that server anymore."),
  missing_permission: dt('Petto needs the Manage Roles permission to do this.'),
  member_list: dt('Petto could not read the member list. Try again in a moment.'),
  permission_lost: dt('Discord kept refusing, so the job stopped: Petto lost the permission, or the role moved above its own, while it was running.'),
  crashed: dt('The job stopped because of an unexpected error. What was already done stays done.'),
};
const failureText = (j: BulkJob) => (j.errorCode && errorText[j.errorCode]) || j.errorMessage || '';
const flashMessage = flash ? flashText[flash] ?? null : null;
const errorMessage = error ? errorText[error] ?? null : null;

const titleOf = (j: BulkJob) => (j.dryRun ? (j.action === 'add' ? dt('Preview of assigning') : dt('Preview of removing')) : j.action === 'add' ? dt('Assigning') : dt('Removing'));
const stateOf = (j: BulkJob) => (j.status === 'running' && j.paused ? 'paused' : j.status);
// The colors are the site's own (they change with the light and dark themes).
const colorOf = (state: string) => (state === 'pending' || state === 'running' || state === 'paused' ? 'var(--yellow)' : state === 'completed' ? 'var(--green)' : state === 'failed' ? 'var(--red)' : 'var(--text-dim)');
const percent = (j: BulkJob) => (j.totalMembers > 0 ? Math.min(100, Math.round((j.processedMembers / j.totalMembers) * 100)) : 0);
const filtered = (j: BulkJob) => Math.max(0, j.processedMembers - j.successCount - j.skippedCount - j.errorCount);
const left = job ? etaSeconds(job) : null;
const took = job && job.startedAt && job.finishedAt ? Math.round((new Date(job.finishedAt).getTime() - new Date(job.startedAt).getTime()) / 1000) : null;
const state = job ? stateOf(job) : 'completed';

// The numbers on top come from the jobs the page loads (the last 8, newest first).
const changedTotal = jobs.filter((j) => !j.dryRun).reduce((sum, j) => sum + j.successCount, 0);
const previewCount = jobs.filter((j) => j.dryRun).length;
const lastWhen = job ? agoText(dt, job.finishedAt ?? job.startedAt ?? job.createdAt, { locale }) : '—';

// The words the page script writes while it follows a job, in the language of the dashboard.
const jsWords = JSON.stringify({
  labels: statusLabel,
  titles: { add: dt('Assigning'), remove: dt('Removing'), previewAdd: dt('Preview of assigning'), previewRemove: dt('Preview of removing') },
  note: dt('{done} / {total} members checked'),
  waiting: dt('Waiting to start...'),
  changed: dt('Changed'), wouldChange: dt('Would change'), failed: dt('Failed'), notMatching: dt('Not matching'),
  timeLeft: dt('Time left'), took: dt('Took'),
  errors: errorText,
  start: dt('Start'), busy: dt('A job is already running'),
  summary: {
    assign: dt('Assign the role'), remove: dt('Remove the role'), noRole: dt('Choose a role'),
    after: dt('joined after {date}'), before: dt('joined before {date}'), least: dt('at least {n} roles'), most: dt('at most {n} roles'),
    filter: dt('with some of {n} chosen roles'), exclude: dt('without {n} chosen roles'), pending: dt('not counting members who have not accepted the rules'),
  },
});
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="bulk-role" pageTitle="Bulk Role">
  <DurationScript />
  <DashSettingsKit />
  <DashFormKit />
  <div class="sx-page br-page">
    <div class="sx-title">
      <h1>{dt('Bulk Role')}</h1>
      <span class:list={['sx-pill-state', { on: jobActive }]}>{jobActive ? dt('Running') : dt('Nothing running')}</span>
    </div>
    <p class="br-lead">{dt('Give or take away one role for many members at once. Check how many members it would change first, then run it: you can pause or cancel it while it works.')}</p>

    {flashMessage && <div class="sx-flash" role="status"><Icon name="ph:check-circle-fill" width="15" height="15" />{flashMessage}</div>}
    {(errorMessage || (error && !errorMessage)) && <div class="sx-flash sx-flash-bad" role="alert"><Icon name="ph:warning-fill" width="15" height="15" />{errorMessage ?? dt("Couldn't start the job, try again.")}</div>}

    <DashStatTiles tiles={[
      { label: dt('Recent jobs'), value: jobs.length, tone: 'voice' },
      { label: dt('Members changed'), value: changedTotal, tone: 'joins' },
      { label: dt('Previews'), value: previewCount, tone: 'invites' },
      { label: dt('Last job'), value: 0, text: lastWhen, tone: 'messages' },
    ]} />

    <div class="br-grid">
      {/* Start and Preview run a job at once: they are not settings, so the bar of unsaved changes leaves them alone. */}
      <form method="POST" class="br-form sx-stack" data-no-dirty data-status-url={`/dash/guild/${guildId}/bulk-role-status`} data-words={jsWords} data-today={today}>
        <section class="sx-panel">
          <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:users-three-fill" width="17" height="17" /></span><h2>{dt('What to do')}</h2></div>
          <fieldset class="br-set" disabled={jobActive} data-config>
            <div class="sx-grid">
              <div class="sx-field">
                <label for="br-role">{dt('Role')}</label>
                <select id="br-role" name="target_role_id" required data-give-role data-role-select>
                  <option value="" disabled selected>{dt('Choose a role')}</option>
                  {roles.map((r) => <option value={r.id} data-risk={r.memberRisk.join(', ')}>{r.name}</option>)}
                </select>
              </div>
              <div class="sx-field">
                <span class="sx-label" id="br-action-label">{dt('Action')}</span>
                <div class="sx-chips" role="radiogroup" aria-labelledby="br-action-label">
                  <label class="sx-chip"><input type="radio" name="role_action" value="add" checked /><span>{dt('Assign the role')}</span></label>
                  <label class="sx-chip"><input type="radio" name="role_action" value="remove" /><span>{dt('Remove the role')}</span></label>
                </div>
              </div>
            </div>
            <div class="br-danger" data-danger hidden role="group" aria-label={dt('Powerful permissions')}>
              <p><Icon name="ph:warning-fill" width="15" height="15" /><span>{dt('This role gives powerful permissions:')} <strong data-danger-list></strong></span></p>
              <label class="br-inline-check"><input type="checkbox" name="confirm_danger" />{dt('I understand, give it to every member that matches.')}</label>
            </div>
          </fieldset>
        </section>

        <section class="sx-panel">
          <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--blue)"><Icon name="ph:funnel-fill" width="17" height="17" /></span><h2>{dt('Who')}</h2></div>
          <fieldset class="br-set" disabled={jobActive} data-config>
            <div class="sx-field">
              <span class="sx-label" id="br-members-label">{dt('Members')}</span>
              <div class="sx-chips" role="radiogroup" aria-labelledby="br-members-label">
                <label class="sx-chip"><input type="radio" name="member_type" value="all" checked /><span>{dt('All members')}</span></label>
                <label class="sx-chip"><input type="radio" name="member_type" value="humans" /><span>{dt('Humans only')}</span></label>
                <label class="sx-chip"><input type="radio" name="member_type" value="bots" /><span>{dt('Bots only')}</span></label>
              </div>
            </div>

            <div class="sx-grid">
              <div class="sx-field">
                <label for="br-after">{dt('Joined after (optional)')}</label>
                <div class="br-date" data-date data-empty="true">
                  <input id="br-after" type="date" name="joined_after" max={today} />
                  <span class="br-date-hint" aria-hidden="true">{dt('Any date')}</span>
                </div>
                <div class="br-chips" role="group" aria-label={dt('Joined after (optional)')}>
                  <button type="button" class="br-chip" data-after-days="7">{dt('Last 7 days')}</button>
                  <button type="button" class="br-chip" data-after-days="30">{dt('Last 30 days')}</button>
                  <button type="button" class="br-chip" data-after-days="90">{dt('Last 90 days')}</button>
                  <button type="button" class="br-chip" data-clear="joined_after">{dt('Clear')}</button>
                </div>
              </div>
              <div class="sx-field">
                <label for="br-before">{dt('Joined before (optional)')}</label>
                <div class="br-date" data-date data-empty="true">
                  <input id="br-before" type="date" name="joined_before" max={today} />
                  <span class="br-date-hint" aria-hidden="true">{dt('Any date')}</span>
                </div>
                <div class="br-chips" role="group" aria-label={dt('Joined before (optional)')}>
                  <button type="button" class="br-chip" data-before-days="30">{dt('Older than 30 days')}</button>
                  <button type="button" class="br-chip" data-before-days="90">{dt('Older than 90 days')}</button>
                  <button type="button" class="br-chip" data-before-days="365">{dt('Older than a year')}</button>
                  <button type="button" class="br-chip" data-clear="joined_before">{dt('Clear')}</button>
                </div>
              </div>
            </div>

            <div class="sx-grid">
              <div class="sx-field">
                <label for="br-min">{dt('At least this many roles (optional)')}</label>
                <SxNumber id="br-min" name="min_roles" value="" min="0" max="250" placeholder="0" />
              </div>
              <div class="sx-field">
                <label for="br-max">{dt('At most this many roles (optional)')}</label>
                <SxNumber id="br-max" name="max_roles" value="" min="0" max="250" placeholder="250" />
              </div>
              <p class="sx-hint sx-wide">{dt('@everyone does not count. Use 0 as the most to pick the members who have no roles.')}</p>
            </div>

            <div class="sx-field">
              <span class="sx-label" id="br-filter-label">{dt('Filter by existing roles (optional)')}</span>
              <MultiSelect lazy name="filter_role_ids" options={roles} selected={[]} placeholder={dt('Search roles...')} />
              <div class="br-filter-opts" data-sx-needs="filter_role_ids">
                <div class="sx-chips" role="radiogroup" aria-label={dt('Filter by existing roles (optional)')}>
                  <label class="sx-chip"><input type="radio" name="filter_mode" value="any" checked /><span>{dt('Has any of these')}</span></label>
                  <label class="sx-chip"><input type="radio" name="filter_mode" value="all" /><span>{dt('Has all of these')}</span></label>
                </div>
                <label class="sx-switch"><input type="checkbox" name="filter_exclude" /><span class="sx-switch-text"><b>{dt('Invert (members WITHOUT them instead)')}</b></span><i class="sx-toggle"></i></label>
              </div>
            </div>

            <label class="sx-switch"><input type="checkbox" name="skip_pending" /><span class="sx-switch-text"><b>{dt('Skip members who have not accepted the rules of the server yet')}</b></span><i class="sx-toggle"></i></label>
          </fieldset>
        </section>

        <section class="sx-panel">
          <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--accent)"><Icon name="ph:note-pencil-bold" width="17" height="17" /></span><h2>{dt('Details')}</h2></div>
          <fieldset class="br-set" disabled={jobActive} data-config>
            <div class="sx-field">
              <label for="br-reason">{dt('Reason (optional)')}</label>
              <textarea id="br-reason" name="reason" class="dgl-autogrow sx-one" rows="1" data-one-line data-count maxlength="300" autocomplete="off"></textarea>
              <span class="sx-hint">{dt('Shown in the audit log of Discord, with the number of the job.')}</span>
            </div>
            <div class="sx-field">
              <label for="br-notify">{dt('Notify channel (optional)')}</label>
              <select id="br-notify" name="notify_channel_id">
                <option value="">{dt('None')}</option>
                {channels.map((c) => <option value={c.id}>#{c.name}</option>)}
              </select>
            </div>
          </fieldset>

          <p class="br-summary" data-summary aria-live="polite"></p>

          <div class="br-submit">
            <button type="submit" name="action" value="preview" formnovalidate class="btn btn-ghost btn-sm" disabled={jobActive} data-submit-preview>
              <Icon name="ph:eye-fill" width="13" height="13" />{dt('Preview')}
            </button>
            <button type="submit" name="action" value="start" class="btn btn-accent btn-sm" disabled={jobActive} data-submit-start>
              <Icon name="ph:play-fill" width="13" height="13" />
              <span data-start-label>{jobActive ? dt('A job is already running') : dt('Start')}</span>
            </button>
          </div>
        </section>
      </form>

      <div class="br-side">
        {job && (
          <section class="sx-panel br-job" id="br-status-card" aria-labelledby="br-job-title" data-status-url={`/dash/guild/${guildId}/bulk-role-status`} data-live={jobActive ? 'true' : 'false'} data-job-id={job.id} data-state={state}>
            <div class="sx-panel-head">
              <span class="sx-panel-icon" data-status-icon style={`--c:${colorOf(state)}`}>
                <span data-job-icon="active" class:list={{ 'br-icon-hidden': !(jobActive && !job.paused) }}><Icon name="ph:spinner-gap" width="17" height="17" class="br-spin" /></span>
                <span data-job-icon="paused" class:list={{ 'br-icon-hidden': !(jobActive && job.paused) }}><Icon name="ph:pause-fill" width="17" height="17" /></span>
                <span data-job-icon="completed" class:list={{ 'br-icon-hidden': job.status !== 'completed' }}><Icon name="ph:check-fill" width="17" height="17" /></span>
                <span data-job-icon="failed" class:list={{ 'br-icon-hidden': job.status !== 'failed' }}><Icon name="ph:x-fill" width="17" height="17" /></span>
                <span data-job-icon="other" class:list={{ 'br-icon-hidden': job.status !== 'cancelled' }}><Icon name="ph:prohibit-fill" width="17" height="17" /></span>
              </span>
              <h2 id="br-job-title">
                <span data-job-title>{titleOf(job)}</span> <span class="br-role-chip">{roleName(job.targetRoleId)}</span>
              </h2>
            </div>
            <div class="br-job-line">
              <span class="br-status-label" data-status-text>{statusLabel[state]}</span>
              <span class="br-when" title={fullDate(job.createdAt)}>{agoText(dt, job.startedAt ?? job.createdAt, { locale })}</span>
            </div>

            <div>
              <div class="br-progress-track" role="progressbar" aria-label={dt('Progress')} aria-valuemin="0" aria-valuemax="100" aria-valuenow={percent(job)} data-progress-bar>
                <div class="br-progress-fill" data-progress-fill style={`width:${percent(job)}%`}></div>
              </div>
              <p class="br-progress-note">
                <span data-progress-note aria-live="polite">{job.status === 'pending' ? dt('Waiting to start...') : dt('{done} / {total} members checked', { done: fmt(job.processedMembers), total: fmt(Math.max(job.totalMembers, job.processedMembers)) })}</span>
                <b data-progress-pct>{percent(job)}%</b>
              </p>
            </div>

            <dl class="br-stats" data-stats>
              <div><dt data-stat-label="changed">{job.dryRun ? dt('Would change') : dt('Changed')}</dt><dd data-stat="changed">{fmt(job.successCount)}</dd></div>
              <div><dt>{dt('Already fine')}</dt><dd data-stat="skipped">{fmt(job.skippedCount)}</dd></div>
              <div><dt data-stat-label="third">{job.dryRun ? dt('Not matching') : dt('Failed')}</dt><dd data-stat="third">{fmt(job.dryRun ? filtered(job) : job.errorCount)}</dd></div>
              <div><dt data-stat-label="time">{jobActive ? dt('Time left') : dt('Took')}</dt><dd data-stat="time">{jobActive ? (left !== null ? shortDuration(left) : '-') : took !== null ? shortDuration(took) : '-'}</dd></div>
            </dl>

            {job.reason && <p class="br-meta"><Icon name="ph:note-pencil-bold" width="13" height="13" /><span>{dt('Reason')}: {job.reason}</span></p>}
            <p class="br-error-note" data-error-note hidden={job.status !== 'failed' || !failureText(job)} role="alert"><Icon name="ph:warning-fill" width="14" height="14" /><span data-error-text>{failureText(job)}</span></p>

            <div class="br-actions" data-job-actions hidden={!jobActive}>
              <form method="POST" data-no-dirty data-form-pause hidden={job.paused}>
                <input type="hidden" name="action" value="pause" />
                <button type="submit" class="btn btn-ghost btn-sm"><Icon name="ph:pause-fill" width="13" height="13" />{dt('Pause')}</button>
              </form>
              <form method="POST" data-no-dirty data-form-resume hidden={!job.paused}>
                <input type="hidden" name="action" value="resume" />
                <button type="submit" class="btn btn-accent btn-sm"><Icon name="ph:play-fill" width="13" height="13" />{dt('Resume')}</button>
              </form>
              <form method="POST" data-no-dirty>
                <input type="hidden" name="action" value="cancel" />
                <button type="submit" class="btn btn-ghost btn-sm br-cancel">{dt('Cancel')}</button>
              </form>
            </div>

            {job.dryRun && job.status === 'completed' && (
              <form method="POST" class="br-run-preview" data-no-dirty>
                <input type="hidden" name="action" value="run_preview" />
                <input type="hidden" name="preview_id" value={job.id} />
                <p>{dt('Nothing was changed. Run it for real with the same settings?')}</p>
                <button type="submit" class="btn btn-accent btn-sm" disabled={job.successCount === 0}><Icon name="ph:play-fill" width="13" height="13" />{dt('Run it for real')}</button>
              </form>
            )}
          </section>
        )}

        <section class="sx-panel br-history" aria-labelledby="br-history-title">
          <div class="sx-panel-head">
            <span class="sx-panel-icon" style="--c:var(--blue)"><Icon name="ph:clock-counter-clockwise-fill" width="17" height="17" /></span>
            <h2 id="br-history-title">{dt('Recent jobs')}</h2>
            {history.length > 0 && <span class="br-count">{history.length}</span>}
          </div>
          {history.length === 0 ? (
            <p class="sx-empty"><Icon name="ph:clock-counter-clockwise-fill" width="18" height="18" />{dt('No earlier jobs.')}</p>
          ) : (
            <ul class="br-history-list dgl-stagger">
              {history.map((j) => (
                <li style={`--c:${colorOf(j.status)}`}>
                  <div class="br-history-main">
                    <span class="br-history-title">{titleOf(j)}</span> <span class="br-role-chip">{roleName(j.targetRoleId)}</span>
                  </div>
                  <div class="br-history-meta">
                    <span class="br-badge">{statusLabel[j.status]}</span>
                    <span>{j.dryRun ? dt('{n} would change', { n: fmt(j.successCount) }) : dt('{n} changed, {m} failed', { n: fmt(j.successCount), m: fmt(j.errorCount) })}</span>
                    <span class="br-history-when" title={fullDate(j.finishedAt ?? j.createdAt)}>{agoText(dt, j.finishedAt ?? j.createdAt, { locale })}</span>
                  </div>
                  {j.status === 'failed' && failureText(j) && <p class="br-error-note"><Icon name="ph:warning-fill" width="14" height="14" /><span>{failureText(j)}</span></p>}
                </li>
              ))}
            </ul>
          )}
        </section>

        <section class="sx-panel br-how" aria-labelledby="br-how-title">
          <div class="sx-panel-head"><span class="sx-panel-icon" style="--c:var(--green)"><Icon name="ph:list-checks-fill" width="17" height="17" /></span><h2 id="br-how-title">{dt('How a job runs')}</h2></div>
          <ul class="br-how-list">
            <li><Icon name="ph:eye-fill" width="15" height="15" /><span>{dt('Preview counts how many members would change and touches nobody.')}</span></li>
            <li><Icon name="ph:play-fill" width="15" height="15" /><span>{dt('A job runs in the background, one at a time per server, and goes on by itself if Petto restarts.')}</span></li>
            <li><Icon name="ph:hourglass-medium-fill" width="15" height="15" /><span>{dt('Large servers can take a few minutes: Discord paces it.')}</span></li>
          </ul>
        </section>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var timer: any = null;
      var current: { tick: () => void } | null = null;
      function schedule(ms: number) { clearTimeout(timer); timer = setTimeout(function () { if (current) current.tick(); }, ms); }
      document.addEventListener('visibilitychange', function () { if (!document.hidden && current) schedule(200); });

      // The script is set up for the form that is on the page. When the dashboard draws the page again without a reload (the answer of a
      // form, or the page opened from the side menu) a new form appears and it is set up too; the old one's follow-up stops.
      function init() {
      var found = document.querySelector('.br-form') as HTMLFormElement | null;
      if (!found || found.dataset.brInit) return;
      found.dataset.brInit = '1';
      var form: HTMLFormElement = found;
      var lastKey: string | null = null;
      var words: any = { labels: {}, titles: {}, errors: {}, summary: {} };
      try { words = JSON.parse(form.dataset.words || '{}'); } catch (e) { /* The English words stay empty and the server-rendered text is kept. */ }

      // The form answers with a redirect and a word in the address: the address goes back to the clean one, so a reload shows no old message.
      if (window.location.search && /[?&](ok|error)=/.test(window.location.search)) {
        try { window.history.replaceState(null, '', window.location.pathname); } catch (e) { /* not important */ }
      }

      /* ---- the date fields: the hint is shown while one is empty (a phone draws an empty date as a blank box) and the chips fill it ---- */
      function dayOffset(days: number) { return new Date(Date.now() - days * 86400000).toISOString().slice(0, 10); }
      function syncDate(box: Element) {
        var input = box.querySelector('input') as HTMLInputElement | null;
        if (input) (box as HTMLElement).dataset.empty = input.value ? 'false' : 'true';
      }
      form.querySelectorAll('[data-date]').forEach(function (box) {
        var input = box.querySelector('input');
        if (!input) return;
        input.addEventListener('input', function () { syncDate(box); update(); });
        input.addEventListener('change', function () { syncDate(box); update(); });
      });
      function setDate(name: string, value: string) {
        var input = form.querySelector('input[name="' + name + '"]') as HTMLInputElement | null;
        if (!input) return;
        input.value = value;
        var box = input.closest('[data-date]');
        if (box) syncDate(box);
        update();
      }
      form.querySelectorAll('[data-after-days]').forEach(function (chip) {
        chip.addEventListener('click', function () { setDate('joined_after', dayOffset(Number((chip as HTMLElement).dataset.afterDays))); });
      });
      form.querySelectorAll('[data-before-days]').forEach(function (chip) {
        chip.addEventListener('click', function () { setDate('joined_before', dayOffset(Number((chip as HTMLElement).dataset.beforeDays))); });
      });
      form.querySelectorAll('[data-clear]').forEach(function (chip) {
        chip.addEventListener('click', function () { setDate((chip as HTMLElement).dataset.clear || '', ''); });
      });

      /* ---- the powerful-permissions warning, and the sentence that says what the job will do ---- */
      var roleSelect = form.querySelector('[data-role-select]') as HTMLSelectElement;
      var danger = form.querySelector('[data-danger]') as HTMLElement;
      var summary = form.querySelector('[data-summary]') as HTMLElement;
      function field(name: string) { return form.querySelector('[name="' + name + '"]') as HTMLInputElement | HTMLSelectElement | null; }
      // The action and the kind of member are choices drawn as chips (radio buttons): the one that is on, and the words written on it.
      function chosen(name: string) { return form.querySelector('input[name="' + name + '"]:checked') as HTMLInputElement | null; }
      function update() {
        var option = roleSelect.selectedOptions[0];
        var risk = (option && option.dataset.risk) || '';
        var action = chosen('role_action');
        var show = Boolean(risk) && (action ? action.value : 'add') === 'add';
        danger.hidden = !show;
        var list = danger.querySelector('[data-danger-list]');
        if (list) list.textContent = risk;
        var confirm = danger.querySelector('input') as HTMLInputElement;
        if (confirm) { confirm.required = show; if (!show) confirm.checked = false; }

        var s = words.summary || {};
        var parts: string[] = [];
        var roleText = roleSelect.value && option ? option.textContent || '' : s.noRole;
        parts.push((action && action.value === 'remove' ? s.remove : s.assign) + ': ' + roleText);
        var members = chosen('member_type');
        if (members && members.value !== 'all') parts.push((members.parentElement && members.parentElement.textContent || '').trim());
        var after = (field('joined_after') as HTMLInputElement).value;
        var before = (field('joined_before') as HTMLInputElement).value;
        var min = (field('min_roles') as HTMLInputElement).value;
        var max = (field('max_roles') as HTMLInputElement).value;
        if (after && s.after) parts.push(s.after.replace('{date}', after));
        if (before && s.before) parts.push(s.before.replace('{date}', before));
        if (min !== '' && s.least) parts.push(s.least.replace('{n}', min));
        if (max !== '' && s.most) parts.push(s.most.replace('{n}', max));
        var picked = form.querySelectorAll('input[name="filter_role_ids"]:checked').length;
        // Which of these roles, and the inversion, only matter once a role is chosen: dimmed until then, but still sent.
        var filterOpts = form.querySelector('.br-filter-opts') as HTMLElement | null;
        if (filterOpts) { filterOpts.toggleAttribute('data-sx-off', picked === 0); filterOpts.inert = picked === 0; }
        if (picked) {
          var invert = (field('filter_exclude') as HTMLInputElement).checked;
          parts.push((invert ? s.exclude : s.filter).replace('{n}', String(picked)));
        }
        if ((field('skip_pending') as HTMLInputElement).checked && s.pending) parts.push(s.pending);
        summary.textContent = parts.join(' · ');
      }
      form.addEventListener('input', update);
      form.addEventListener('change', update);
      update();

      /* ---- the card of the job follows it while it runs ---- */
      function render(card: HTMLElement, job: any, eta: number | null) {
        var active = job.status === 'pending' || job.status === 'running';
        var paused = active && job.paused;
        var state = paused ? 'paused' : job.status;
        var color = active ? 'var(--yellow)' : state === 'completed' ? 'var(--green)' : state === 'failed' ? 'var(--red)' : 'var(--text-dim)';
        var total = Math.max(job.totalMembers, job.processedMembers);
        var pct = total > 0 ? Math.min(100, Math.round((job.processedMembers / total) * 100)) : 0;
        var filtered = Math.max(0, job.processedMembers - job.successCount - job.skippedCount - job.errorCount);
        function text(selector: string, value: string) { var node = card.querySelector(selector); if (node) node.textContent = value; }

        card.dataset.state = state;
        var fill = card.querySelector('[data-progress-fill]') as HTMLElement | null;
        if (fill) fill.style.width = pct + '%';
        var bar = card.querySelector('[data-progress-bar]');
        if (bar) bar.setAttribute('aria-valuenow', String(pct));
        text('[data-progress-pct]', pct + '%');
        text('[data-progress-note]', job.status === 'pending' ? (words.waiting || '') : String(words.note || '').replace('{done}', fmt(job.processedMembers)).replace('{total}', fmt(total)));
        text('[data-status-text]', (words.labels || {})[state] || state);
        var titles = words.titles || {};
        text('[data-job-title]', job.dryRun ? (job.action === 'add' ? titles.previewAdd : titles.previewRemove) : (job.action === 'add' ? titles.add : titles.remove));
        function fmt(n: number) { return Number(n).toLocaleString(document.documentElement.lang || 'en-US'); }
        text('[data-stat="changed"]', fmt(job.successCount));
        text('[data-stat="skipped"]', fmt(job.skippedCount));
        text('[data-stat="third"]', fmt(job.dryRun ? filtered : job.errorCount));
        text('[data-stat-label="changed"]', job.dryRun ? words.wouldChange : words.changed);
        text('[data-stat-label="third"]', job.dryRun ? words.notMatching : words.failed);
        text('[data-stat-label="time"]', active ? words.timeLeft : words.took);
        function span(seconds: number) { return (window as any).dglDuration(Math.max(0, seconds), { locale: document.documentElement.lang }); }
        var took = job.startedAt && job.finishedAt ? Math.round((new Date(job.finishedAt).getTime() - new Date(job.startedAt).getTime()) / 1000) : null;
        text('[data-stat="time"]', active ? (eta ? span(eta) : '-') : took !== null ? span(took) : '-');

        var errorNote = card.querySelector('[data-error-note]') as HTMLElement | null;
        if (errorNote) {
          var message = (job.errorCode && (words.errors || {})[job.errorCode]) || job.errorMessage || '';
          errorNote.hidden = job.status !== 'failed' || !message;
          text('[data-error-text]', message);
        }
        var icon = card.querySelector('[data-status-icon]') as HTMLElement | null;
        if (icon) {
          icon.style.setProperty('--c', color);
          var which = paused ? 'paused' : active ? 'active' : job.status === 'completed' ? 'completed' : job.status === 'failed' ? 'failed' : 'other';
          icon.querySelectorAll('[data-job-icon]').forEach(function (item) { item.classList.toggle('br-icon-hidden', item.getAttribute('data-job-icon') !== which); });
        }
        card.dataset.live = active ? 'true' : 'false';
        var actions = card.querySelector('[data-job-actions]') as HTMLElement | null;
        if (actions) {
          actions.hidden = !active;
          var pauseForm = actions.querySelector('[data-form-pause]') as HTMLElement | null;
          var resumeForm = actions.querySelector('[data-form-resume]') as HTMLElement | null;
          if (pauseForm) pauseForm.hidden = Boolean(job.paused);
          if (resumeForm) resumeForm.hidden = !job.paused;
        }
        form.querySelectorAll('[data-config]').forEach(function (set) { (set as HTMLFieldSetElement).disabled = active; });
        form.querySelectorAll('.br-submit button').forEach(function (button) { (button as HTMLButtonElement).disabled = active; });
        var label = form.querySelector('[data-start-label]');
        if (label) label.textContent = active ? words.busy : words.start;
      }

      // Every 2 seconds while a job runs, every 8 otherwise (to notice a job started from Discord or from another tab), and it rests while the
      // tab is hidden. A job that shows up when the page had none, or one that has just ended, loads the page once so the history is right.
      function tick() {
        if (!form.isConnected) return;
        if (document.hidden) { schedule(4000); return; }
        var card = document.getElementById('br-status-card');
        var url = (card && card.dataset.statusUrl) || form.dataset.statusUrl;
        if (!url) return;
        fetch(url + (url.indexOf('?') === -1 ? '?' : '&') + 't=' + Date.now(), { cache: 'no-store', headers: { Accept: 'application/json' } })
          .then(function (res) { if (!res.ok) throw new Error('status request failed'); return res.json(); })
          .then(function (body) {
            var job = body.job;
            if (!form.isConnected) return;
            if (!job) { schedule(8000); return; }
            var key = job.id + ':' + job.status;
            if (!card || card.dataset.jobId !== String(job.id)) {
              if (lastKey !== key) { lastKey = key; window.location.reload(); }
              return;
            }
            var active = job.status === 'pending' || job.status === 'running';
            var wasActive = lastKey !== null ? /(pending|running)$/.test(lastKey) : card.dataset.live === 'true';
            render(card, job, body.etaSeconds);
            lastKey = key;
            if (wasActive && !active) { card.classList.add('br-just-finished'); setTimeout(function () { window.location.reload(); }, 1200); return; }
            schedule(active ? 2000 : 8000);
          })
          .catch(function () { schedule(5000); });
      }
      current = { tick: tick };
      var first = document.getElementById('br-status-card');
      schedule(first && first.dataset.live === 'true' ? 0 : 1500);
      }

      init();
      new MutationObserver(init).observe(document.body, { childList: true, subtree: true });
    })();
  </script>
</DashGuildLayout>

<style>
  h1 { font-size: 24px; margin: 0; }
  .sx-title { margin-bottom: 6px; }
  .br-lead { margin: 0 0 16px; font-size: 13.5px; line-height: 1.5; color: var(--text-muted); max-width: 70ch; }

  .br-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(min(260px, 100%), 330px); gap: 14px; align-items: start; }
  .br-form { min-width: 0; }
  .br-side { display: flex; flex-direction: column; gap: 14px; min-width: 0; position: sticky; top: 12px; }
  .br-set { border: 0; margin: 0; padding: 0; min-width: 0; display: flex; flex-direction: column; gap: 14px; transition: opacity .3s ease; }
  .br-set:disabled { opacity: 0.55; }
  /* The hidden radios and boxes of the chips and switches stay hidden while a job runs (the site draws a disabled input faded). */
  .br-set :is(.sx-chip, .sx-switch) > input:disabled { opacity: 0 !important; }

  /* the job */
  .br-job-line { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; margin-top: -4px; }
  .br-status-label { font-size: 12px; font-weight: 600; border-radius: 999px; padding: 3px 11px; color: var(--text-dim); background: color-mix(in srgb, var(--text) 7%, transparent); }
  .br-job[data-state="completed"] .br-status-label { color: var(--green); background: var(--green-soft); }
  .br-job[data-state="failed"] .br-status-label { color: var(--red); background: var(--red-soft); }
  .br-job[data-state="pending"] .br-status-label, .br-job[data-state="running"] .br-status-label, .br-job[data-state="paused"] .br-status-label { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 14%, transparent); }
  .br-when { font-size: 12px; color: var(--text-dim); }
  .br-icon-hidden { display: none; }
  .br-role-chip { display: inline-block; vertical-align: middle; font-family: var(--mono); font-size: 12px; font-weight: 500; color: var(--accent); background: var(--accent-soft); padding: 2px 8px; border-radius: 6px; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; box-sizing: border-box; }
  .br-job h2 { overflow-wrap: anywhere; line-height: 1.35; }
  .br-just-finished { animation: brPulse 1.2s ease-out 1; }
  @keyframes brPulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--green) 55%, transparent); } 100% { box-shadow: 0 0 0 14px transparent; } }
  .br-spin { animation: br-spin 1s linear infinite; }
  @keyframes br-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .br-spin, .br-just-finished { animation: none; } .br-progress-fill { transition: none; } }

  .br-progress-track { height: 10px; border-radius: 999px; background: color-mix(in srgb, var(--text) 10%, transparent); overflow: hidden; }
  .br-progress-fill { height: 100%; background: var(--accent); border-radius: 999px; transition: width 0.3s ease; }
  .br-progress-note { display: flex; justify-content: space-between; gap: 10px; font-size: 12.5px; color: var(--text-dim); margin: 8px 0 0; }
  .br-progress-note b { color: var(--text); font-variant-numeric: tabular-nums; }
  .br-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 0; }
  .br-stats > div { border: 1px solid var(--border-soft); border-radius: 12px; padding: 10px 12px; background: color-mix(in srgb, var(--text) 3%, var(--card)); min-width: 0; }
  .br-stats dt { font-size: 12px; color: var(--text-dim); }
  .br-stats dd { margin: 3px 0 0; font-family: var(--serif); font-size: 22px; font-weight: 600; line-height: 1.15; color: var(--text); font-variant-numeric: lining-nums tabular-nums; overflow-wrap: anywhere; }
  .br-meta { display: flex; align-items: flex-start; gap: 7px; font-size: 12.5px; line-height: 1.45; color: var(--text-muted); margin: 0; overflow-wrap: anywhere; }
  .br-meta :global(svg) { flex: none; margin-top: 2px; color: var(--text-dim); }
  .br-error-note { display: flex; align-items: flex-start; gap: 7px; font-size: 12.5px; line-height: 1.45; color: var(--red); margin: 0; overflow-wrap: anywhere; }
  .br-error-note[hidden] { display: none; }
  .br-error-note :global(svg) { flex: none; margin-top: 2px; }
  .br-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .br-actions[hidden], .br-actions form[hidden] { display: none; }
  .br-actions .btn, .br-submit .btn, .br-run-preview .btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
  .br-cancel:hover { color: var(--red); border-color: color-mix(in srgb, var(--red) 55%, var(--border)); }
  .br-run-preview { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 12px 14px; border-radius: 12px; background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); }
  .br-run-preview p { margin: 0; font-size: 13px; line-height: 1.45; color: var(--text); }

  /* a date field: a phone draws an empty one as a blank box, so it gets a real height, no native frame and a hint that shows while it is empty */
  .br-date { position: relative; }
  .br-date input { display: block; width: 100%; box-sizing: border-box; min-height: 40px; border: 1px solid var(--border); border-radius: 10px; padding: 9px 12px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; line-height: 1.3; -webkit-appearance: none; appearance: none; color-scheme: light dark; text-align: left; transition: border-color 0.25s ease, box-shadow 0.25s ease; }
  .br-date input:focus-visible { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .br-date input::-webkit-date-and-time-value { text-align: left; min-height: 1.3em; }
  .br-date input::-webkit-calendar-picker-indicator { opacity: 0.7; cursor: pointer; }
  .br-date[data-empty="true"] input { color: transparent; }
  .br-date[data-empty="true"] input:focus { color: var(--text); }
  .br-date-hint { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); pointer-events: none; color: var(--text-dim); font-size: 13.5px; }
  .br-date[data-empty="false"] .br-date-hint, .br-date:focus-within .br-date-hint { display: none; }
  .br-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .br-chip { border: 1px solid var(--border); background: var(--card); color: var(--text-muted); border-radius: 999px; padding: 5px 11px; min-height: 30px; font-family: var(--sans); font-size: 12px; cursor: pointer; transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease; }
  .br-chip:hover { background: var(--card-hover); color: var(--text); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
  .br-chip:active { background: var(--accent-soft); color: var(--accent); }

  .br-filter-opts { display: flex; flex-direction: column; gap: 10px; margin-top: 4px; }
  .br-inline-check { display: flex; align-items: center; gap: 9px; font-size: 13px; color: var(--text-muted); cursor: pointer; min-height: 32px; }
  .br-inline-check input { accent-color: var(--green); width: 18px; height: 18px; flex-shrink: 0; }

  .br-danger { border: 1px solid color-mix(in srgb, var(--red) 55%, transparent); background: var(--red-soft); color: var(--text); border-radius: 12px; padding: 12px 14px; }
  .br-danger[hidden] { display: none; }
  .br-danger p { display: flex; align-items: flex-start; gap: 8px; margin: 0 0 8px; font-size: 13px; line-height: 1.45; }
  .br-danger p :global(svg) { color: var(--red); flex-shrink: 0; margin-top: 2px; }
  .br-danger strong { overflow-wrap: anywhere; }

  .br-summary { margin: 0; padding: 11px 14px; border-radius: 12px; background: color-mix(in srgb, var(--text) 3%, var(--card)); border: 1px dashed var(--border); font-size: 13px; line-height: 1.5; color: var(--text); overflow-wrap: anywhere; }
  .br-summary:empty { display: none; }
  .br-submit { display: flex; flex-wrap: wrap; gap: 10px; }
  .br-submit .btn:disabled { opacity: 0.55; }

  .br-count { flex: none; font-family: var(--mono); font-size: 11.5px; color: var(--text-dim); background: color-mix(in srgb, var(--text) 7%, transparent); border-radius: 999px; padding: 2px 9px; }
  .br-history-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .br-history-list li { border: 1px solid var(--border-soft); border-left: 3px solid var(--c); border-radius: 12px; padding: 10px 12px; background: color-mix(in srgb, var(--text) 3%, var(--card)); min-width: 0; display: flex; flex-direction: column; gap: 6px; transition: border-color 0.3s ease, background-color 0.3s ease; }
  .br-history-list li:hover { border-color: var(--border); border-left-color: var(--c); background: var(--card-hover); }
  .br-history-main { font-size: 13px; font-weight: 600; color: var(--text); display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; min-width: 0; overflow-wrap: anywhere; }
  .br-history-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; font-size: 12px; color: var(--text-dim); }
  .br-badge { font-size: 11.5px; font-weight: 600; color: var(--c); background: color-mix(in srgb, var(--c) 14%, transparent); padding: 2px 9px; border-radius: 999px; }
  .br-history-when { margin-left: auto; white-space: nowrap; }

  .br-how-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .br-how-list li { display: flex; align-items: flex-start; gap: 10px; font-size: 12.5px; line-height: 1.5; color: var(--text-muted); }
  .br-how-list li :global(svg) { flex: none; margin-top: 2px; color: var(--accent); }

  @media (max-width: 960px) {
    .br-grid { grid-template-columns: minmax(0, 1fr); }
    /* On a narrow screen the job comes first, then the form, then the history. */
    .br-side { display: contents; position: static; }
    .br-job { order: -1; }
    .br-history, .br-how { order: 2; }
  }
  @media (max-width: 720px) {
    .br-submit .btn { flex: 1 1 100%; min-height: 44px; }
    .br-actions .btn { min-height: 44px; }
    .br-history-when { margin-left: 0; flex-basis: 100%; }
  }
</style>
