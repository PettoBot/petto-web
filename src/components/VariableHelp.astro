---
// Keep this list aligned with the bot's resolver and its contextual handlers. The choose, range,
// nextBump, and reactreply tokens are handled by dedicated logic rather than the base map.
interface VarDef { tok: string; desc: string; }
interface VarGroup { label: string; vars: VarDef[]; }

const GROUPS: VarGroup[] = [
  {
    label: 'User',
    vars: [
      { tok: '{user}', desc: 'Mentions the user' },
      { tok: '{user.mention}', desc: 'Mentions the user (same as {user})' },
      { tok: '{user.name}', desc: 'Username' },
      { tok: '{user.id}', desc: 'User ID' },
      { tok: '{user.avatar}', desc: 'Global avatar image URL' },
      { tok: '{user.display_avatar}', desc: 'Server avatar, falls back to global' },
      { tok: '{user.display_name}', desc: 'Server nickname, or username if none' },
      { tok: '{user.joined_at}', desc: 'Date they joined this server' },
      { tok: '{user.joined_at_timestamp}', desc: 'Unix timestamp of that join date' },
      { tok: '{user.created_at}', desc: 'Date the account was created' },
      { tok: '{user.created_at_timestamp}', desc: 'Unix timestamp of account creation' },
      { tok: '{user.boost}', desc: '"Yes" or "No", are they boosting' },
      { tok: '{user.boost_since}', desc: 'Date they started boosting, or "Not boosting"' },
      { tok: '{user.boost_since_timestamp}', desc: 'Unix timestamp of boost start' },
      { tok: '{user.color}', desc: 'Highest role color as hex' },
      { tok: '{user.top_role}', desc: 'Their highest role name' },
      { tok: '{user.role_list}', desc: 'All their roles, mentioned' },
      { tok: '{user.bot}', desc: '"Yes" or "No", is it a bot account' },
      { tok: '{user.join_position}', desc: 'Which member number they were' },
      { tok: '{user.join_position_suffix}', desc: 'Join position with suffix (1st, 2nd...)' },
    ],
  },
  {
    label: 'User (legacy)',
    vars: [
      { tok: '{user_tag}', desc: 'Username (same as {user.name})' },
      { tok: '{user_name}', desc: 'Username' },
      { tok: '{user_avatar}', desc: 'Avatar image URL' },
      { tok: '{user_id}', desc: 'User ID' },
      { tok: '{user_discrim}', desc: 'Discriminator, mostly empty on new usernames' },
      { tok: '{user_nick}', desc: 'Server nickname, or username if none' },
      { tok: '{user_joindate}', desc: 'Date they joined this server' },
      { tok: '{user_createdate}', desc: 'Date the account was created' },
      { tok: '{user_displaycolor}', desc: 'Highest role color as hex' },
      { tok: '{user_boostsince}', desc: 'Date they started boosting, or "Not boosting"' },
    ],
  },
  {
    label: 'Server',
    vars: [
      { tok: '{server_name}', desc: 'Server name' },
      { tok: '{server_id}', desc: 'Server ID' },
      { tok: '{server_prefix}', desc: "The server's configured prefix" },
      { tok: '{server_membercount}', desc: 'Total member count' },
      { tok: '{server_membercount_ordinal}', desc: 'Member count with suffix (1st, 2nd...)' },
      { tok: '{server_membercount_nobots}', desc: 'Member count excluding bots' },
      { tok: '{server_membercount_nobots_ordinal}', desc: 'That count, with suffix' },
      { tok: '{server_botcount}', desc: 'Number of bots in the server' },
      { tok: '{server_botcount_ordinal}', desc: 'Bot count, with suffix' },
      { tok: '{server_icon}', desc: 'Server icon URL' },
      { tok: '{server_rolecount}', desc: 'Number of roles' },
      { tok: '{server_channelcount}', desc: 'Number of channels' },
      { tok: '{server_randommember}', desc: 'Mentions a random member' },
      { tok: '{server_randommember_tag}', desc: 'Username of a random member' },
      { tok: '{server_randommember_nobots}', desc: 'Mentions a random non-bot member' },
      { tok: '{server_owner}', desc: 'Mentions the server owner' },
      { tok: '{server_owner_id}', desc: "Server owner's user ID" },
      { tok: '{server_createdate}', desc: 'Date the server was created' },
      { tok: '{server_boostlevel}', desc: 'Current boost level (0-3)' },
      { tok: '{server_boostcount}', desc: 'Total boost count' },
      { tok: '{server_nextboostlevel}', desc: 'The next boost level (1-3)' },
      { tok: '{server_nextboostlevel_required}', desc: 'Boosts required to reach it' },
      { tok: '{server_nextboostlevel_until_required}', desc: 'Boosts still needed to reach it' },
    ],
  },
  {
    label: 'Guild',
    vars: [
      { tok: '{guild.name}', desc: 'Server name' },
      { tok: '{guild.id}', desc: 'Server ID' },
      { tok: '{guild.count}', desc: 'Total member count' },
      { tok: '{guild.icon}', desc: 'Server icon URL' },
      { tok: '{guild.banner}', desc: 'Server banner URL' },
      { tok: '{guild.owner_id}', desc: "Server owner's user ID" },
      { tok: '{guild.created_at}', desc: 'Date the server was created' },
      { tok: '{guild.created_at_timestamp}', desc: 'Unix timestamp of server creation' },
      { tok: '{guild.emoji_count}', desc: 'Number of custom emojis' },
      { tok: '{guild.role_count}', desc: 'Number of roles' },
      { tok: '{guild.boost_count}', desc: 'Total boost count' },
      { tok: '{guild.boost_tier}', desc: 'Boost tier, e.g. "Level 2" or "No Level"' },
      { tok: '{guild.channels_count}', desc: 'Number of channels' },
      { tok: '{guild.vanity}', desc: 'Vanity invite URL, if the server has one' },
      { tok: '{guild.region}', desc: "Server's preferred locale" },
      { tok: '{guild.max_members}', desc: 'Max member capacity' },
    ],
  },
  {
    label: 'Channel',
    vars: [
      { tok: '{channel}', desc: 'Mentions the current channel' },
      { tok: '{channel.mention}', desc: 'Mentions the current channel' },
      { tok: '{channel.name}', desc: 'Channel name' },
      { tok: '{channel.id}', desc: 'Channel ID' },
      { tok: '{channel.topic}', desc: 'Channel topic' },
      { tok: '{channel_name}', desc: 'Channel name (legacy)' },
      { tok: '{channel_createdate}', desc: 'Date the channel was created (legacy)' },
    ],
  },
  {
    label: 'Message',
    vars: [
      { tok: '{message_link}', desc: 'Only where a triggering message exists (e.g. autoresponders)' },
      { tok: '{message_id}', desc: 'ID of the triggering message' },
      { tok: '{message_content}', desc: 'Text of the triggering message' },
    ],
  },
  {
    label: 'Leveling',
    vars: [
      { tok: '{level}', desc: 'Only in the level-up message: the new level reached' },
      { tok: '{level_xp}', desc: 'Only in the level-up message: total XP' },
      { tok: '{level_xp_needed}', desc: 'Only in the level-up message: XP needed for the next level' },
      { tok: '{level_rank}', desc: 'Only in the level-up message: leaderboard rank' },
    ],
  },
  {
    label: 'Giveaway',
    vars: [
      { tok: '{gw.prize}', desc: 'The prize' },
      { tok: '{gw.winners}', desc: 'Number of winners' },
      { tok: '{gw.host}', desc: 'Mentions whoever started it' },
      { tok: '{gw.duration}', desc: 'End time, as a raw unix timestamp' },
      { tok: '{gw.timestamp}', desc: 'End time, as a relative Discord timestamp' },
      { tok: '{gw.claim_time}', desc: 'How long winners have to claim' },
      { tok: '{gw.reaction}', desc: 'The entry emoji, if using reaction mode' },
      { tok: '{gw.entry_mode}', desc: '"react with" or "click on", matches entry mode' },
      { tok: '{gw.preset}', desc: 'The bonus-entry roles list, if a preset is used' },
    ],
  },
  {
    label: 'Bump',
    vars: [
      { tok: '{user.mention}', desc: 'Only in bump messages: mentions whoever bumped' },
      { tok: '{nextBump}', desc: 'Only in bump messages: relative time until the next bump is allowed' },
    ],
  },
  {
    label: 'Date',
    vars: [
      { tok: '{date}', desc: "Today's date" },
      { tok: '{date.now}', desc: "Today's date, Pacific time" },
      { tok: '{date.utc_now}', desc: 'Current date and time, UTC' },
      { tok: '{date.utc_timestamp}', desc: 'Current unix timestamp' },
    ],
  },
  {
    label: 'Functions',
    vars: [
      { tok: '{choose:a|b|c}', desc: 'Picks one option at random each time' },
      { tok: '{range:1-100}', desc: 'A random whole number in that range' },
      { tok: '{newline}', desc: 'Forces a line break' },
      { tok: '{separator}', desc: 'A decorative divider line' },
    ],
  },
  {
    label: 'Actions',
    vars: [
      { tok: '{reactreply:emoji}', desc: 'Reacts to the sent message with this emoji, repeat the tag for more than one. If the field is nothing but reactreply tags (no other text), it reacts to the trigger itself instead of sending anything.' },
    ],
  },
];
---
<div class="dgl-varmenu-wrap" data-varmenu>
  <button type="button" class="dgl-varbtn" data-varmenu-toggle>
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V5a1 1 0 0 1 1-1h2M20 7V5a1 1 0 0 1-1-1h-2M4 17v2a1 1 0 0 0 1 1h2M20 17v2a1 1 0 0 1-1 1h-2" /><path d="M9 9l1.5 6M15 9l-1.5 6" /></svg>
    Variables
    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="dgl-varbtn-caret"><path d="m6 9 6 6 6-6" /></svg>
  </button>
  <div class="dgl-varmenu" data-varmenu-panel hidden>
    <p class="dgl-varmenu-hint">Click one to copy it, then paste it wherever you want it to appear.</p>
    {GROUPS.map((g) => (
      <div>
        <div class="dgl-varmenu-group-label">{g.label}</div>
        {g.vars.map((v) => (
          <button type="button" class="dgl-varmenu-row" data-var-token={v.tok}>
            <code>{v.tok}</code>
            <span>{v.desc}</span>
          </button>
        ))}
      </div>
    ))}
  </div>
</div>
