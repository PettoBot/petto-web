---
import { getDashLang, makeT } from '../i18n/dash';
import { variableGroupsJson } from '../utils/variableGroups';
import { firstInRequest } from '../utils/oncePerRequest';
const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
// The list is the same for every menu of the page, so it is written once (by whichever menu of the request is drawn first) and each
// menu draws its rows from it the first time it opens (bindVarMenus in DashGuildLayout). A page with several menus used to repeat
// the 130 rows in each.
const first = firstInRequest(Astro.request, 'variables');
const json = first ? await variableGroupsJson(Astro, dt) : '';
---
<div class="dgl-varmenu-wrap" data-varmenu>
  <button type="button" class="dgl-varbtn" data-varmenu-toggle>
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V5a1 1 0 0 1 1-1h2M20 7V5a1 1 0 0 1-1-1h-2M4 17v2a1 1 0 0 0 1 1h2M20 17v2a1 1 0 0 1-1 1h-2" /><path d="M9 9l1.5 6M15 9l-1.5 6" /></svg>
    {dt('Variables')}
    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="dgl-varbtn-caret"><path d="m6 9 6 6 6-6" /></svg>
  </button>
  <div class="dgl-varmenu" data-varmenu-panel data-varmenu-lazy hidden>
    <p class="dgl-varmenu-hint">{dt('Click one to copy it, then paste it wherever you want it to appear.')}</p>
  </div>
  {first && <script type="application/json" data-var-groups set:html={json}></script>}
</div>
