---
import { hiddenChannelSet, goneChannelLabel } from '../utils/channelLabel';
import SilentMentionHint from './SilentMentionHint.astro';
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashAcData from './DashAcData.astro';
import DashStatTiles from './DashStatTiles.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashFormKit from './DashFormKit.astro';
import { dashLocale, getDashLang, makeT } from '../i18n/dash';
import { agoText } from '../utils/formatDuration';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Honeypot {
  channelId: string; channelName: string | null; punishment: string; caught: number; messages: number;
  mode: string; text: string; template: string; panelMessageId: string | null; dm: boolean; reinvite: boolean;
}
interface Catch { caseNumber: number; userId: string; type: string; at: string; name: string | null; username: string | null; avatar: string }
interface Props {
  user: { username: string; avatar: string | null; userId?: string };
  guildId: string;
  guildName: string;
  guildIcon: string;
  honeypots: Honeypot[];
  freeChannels: { id: string; name: string }[];
  embedNames: string[];
  catches: Catch[];
  ready: boolean;
  message: { kind: 'ok' | 'err'; text: string } | null;
  openChannel: string | null;
}
const { user, guildId, guildName, guildIcon, honeypots, freeChannels, embedNames, catches, ready, message } = Astro.props;
const hiddenChannels = await hiddenChannelSet(guildId);
const goneChannel = (id: string, goneKey: string) => goneChannelLabel(dt, hiddenChannels, id, goneKey);

// The words of Petto's own panel, as the bot writes them (security.honeypot.* in the bot), for the preview.
const punishments = [
  { id: 'softban', label: dt('Softban (recommended)'), hint: dt('Removes them and deletes their messages of the last day. They can join again.'), text: dt('a softban') },
  { id: 'ban', label: dt('Ban'), hint: dt('Removes them for good and deletes their messages of the last day.'), text: dt('a ban') },
  { id: 'kick', label: dt('Kick'), hint: dt('Removes them. Their messages stay and they can join again.'), text: dt('a kick') },
];
const punishmentText = (id: string) => punishments.find((p) => p.id === id)?.text ?? punishments[0].text;
const punishmentLabel = (id: string) => ({ softban: dt('Softban'), ban: dt('Ban'), kick: dt('Kick') } as Record<string, string>)[id] ?? id;
const docsUrl = `https://wiki.petto.sbs${dashLang === 'es' ? '/es' : dashLang === 'pt-BR' ? '/pt-br' : ''}/moderation/honeypot`;
const totalCaught = honeypots.reduce((sum, h) => sum + h.caught, 0);
const totalTriggers = honeypots.reduce((sum, h) => sum + h.messages, 0);
/** "5m ago", "1h 5m ago", "2d 3h ago". */
const since = (iso: string) => agoText(dt, iso, { locale: dashLocale(dashLang) });
const panelWords = {
  title: dt('DO NOT SEND MESSAGES IN THIS CHANNEL'),
  body: dt('This channel is used to catch spam bots. Any messages sent here will result in {punishment}.'),
  button: dt('Kicks: {count}'),
  punishments: Object.fromEntries(punishments.map((p) => [p.id, p.text])),
};
const when = (iso: string) => {
  const date = new Date(iso);
  return Number.isFinite(date.getTime()) ? date.toLocaleString(dashLang, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '';
};
// The typed autocomplete of the warning text: the channels the page knows (free ones and the bait channels) and the three honeypot
// variables, written before DashAcData so they are the list this page offers (the warning only knows these).
const acChannels = [...freeChannels, ...honeypots.filter((h) => h.channelName).map((h) => ({ id: h.channelId, name: h.channelName as string }))];
const honeypotVars = JSON.stringify([{ l: dt('Honeypot'), v: [['{honeypot.action}', dt('What happens to who writes there')], ['{honeypot.count}', dt('Members caught')], ['{honeypot.channel}', dt('The bait channel')]] }]).replace(/</g, '\\u003c');
const modeLabel = (h: Honeypot) => (h.mode === 'none' ? dt('Nothing posted') : h.mode === 'custom' ? (h.template ? dt('Saved embed: {name}', { name: h.template }) : dt('Your text')) : dt("Petto's normal panel"));
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="honeypot" pageTitle={dt('Honeypot')}>
  <DashSettingsKit />
  <DashFormKit />
  <div class="hp" data-honeypot data-words={JSON.stringify(panelWords)}>
    <header class="hp-head">
      <h1>{dt('Honeypot')}</h1>
      <a class="btn btn-sm hp-docs" href={docsUrl} target="_blank" rel="noopener"><Icon name="ph:book-open-fill" width="13" height="13" />{dt('Read the docs')}</a>
    </header>
    {honeypots.length > 0 && <script type="application/json" data-var-groups set:html={honeypotVars}></script>}
    {honeypots.length > 0 && <DashAcData channels={acChannels} />}

    {message && <div class:list={['hp-flash', { 'hp-flash-err': message.kind === 'err' }]} role="status" data-hp-flash><Icon name={message.kind === 'ok' ? 'ph:check-circle-fill' : 'ph:warning-fill'} width="15" height="15" />{message.text}</div>}
    {!ready && <div class="hp-flash hp-flash-warn"><Icon name="ph:plug-fill" width="15" height="15" />{dt('The honeypot settings could not be read. Try again in a moment.')}</div>}

    {honeypots.length > 0 && (
      <DashStatTiles tiles={[
        { label: dt('Bait channels'), value: honeypots.length, tone: 'invites' },
        { label: dt('Members caught'), value: totalCaught, tone: 'leaves' },
        { label: dt('Trap triggers'), value: totalTriggers, tone: 'messages' },
        { label: dt('Last catch'), value: 0, text: catches[0] ? since(catches[0].at) : '—', tone: 'voice' },
      ]} />
    )}

    {honeypots.length === 0 && (
      <section class="hp-empty">
        <img src="/assets/petto-honeypot.webp" alt="" width="96" height="92" loading="lazy" />
        <div>
          <h2>{dt('What is a honeypot?')}</h2>
          <p>{dt('It is a trap for spam bots. You make a channel (for example #do-not-write) and Petto posts a big warning in it: "do not send messages here".')}</p>
          <ol>
            <li>{dt('People read the warning and never write there.')}</li>
            <li>{dt('Spam bots and hacked accounts do not read: they post the same scam link in every channel.')}</li>
            <li>{dt('The moment one posts in the bait channel, Petto deletes the message and removes the account (softban, ban or kick), and writes a case.')}</li>
          </ol>
        </div>
      </section>
    )}

    <section class="hp-add">
      <h2>{honeypots.length ? dt('Add a bait channel') : dt('Set up your first honeypot')}</h2>
      <form method="POST" class="hp-add-form" data-no-dirty>
        <input type="hidden" name="action" value="add" />
        <div class="sx-field hp-add-channel"><label for="hp-add-channel">{dt('Channel')}</label>
          <select id="hp-add-channel" name="channel_id" required>
            <option value="">{dt('Choose a channel')}</option>
            {freeChannels.map((c) => <option value={c.id}>#{c.name}</option>)}
          </select>
        </div>
        <div class="sx-field"><span class="sx-label">{dt('What happens to who posts there')}</span>
          <div class="dfx-chips">{punishments.map((p) => <label class="dfx-chip" title={p.hint}><input type="radio" name="punishment" value={p.id} checked={p.id === 'softban'} />{p.label}</label>)}</div>
        </div>
        <button class="btn btn-accent btn-sm" type="submit" disabled={!ready || !freeChannels.length}><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add honeypot')}</button>
      </form>
      <p class="hp-hint">{dt('Use an empty channel members can see. Petto needs View Channel, Send Messages, Read Message History and Manage Messages there, and posts the warning at once.')}</p>
    </section>

    {honeypots.map((h) => {
      const href = h.panelMessageId ? `https://discord.com/channels/${guildId}/${h.channelId}/${h.panelMessageId}` : null;
      const exists = Boolean(h.channelName);
      return (
        <article class="hp-card" data-hp-card data-mode={h.mode} data-punishment={h.punishment} id={`hp-${h.channelId}`}>
          <header class="hp-card-head">
            <div class="hp-card-title">
              <Icon name="ph:hash-bold" width="16" height="16" />
              <b>{h.channelName ?? goneChannel(h.channelId, 'Deleted channel')}</b>
              <span class:list={['hp-tag', `hp-tag-${h.punishment}`]}>{punishmentLabel(h.punishment)}</span>
            </div>
            <div class="hp-card-meta">
              <span class="hp-count"><Icon name="ph:bug-fill" width="12" height="12" /><b>{h.caught.toLocaleString(dashLang)}</b> {h.caught === 1 ? dt('member caught') : dt('members caught')}</span>
              <span class:list={['hp-state', { 'hp-state-off': !h.panelMessageId }]}>
                {h.mode === 'none' ? dt('Nothing posted') : h.panelMessageId ? <a href={href} target="_blank" rel="noopener">{modeLabel(h)} <Icon name="ph:arrow-square-out-bold" width="11" height="11" /></a> : dt('The message is not posted')}
              </span>
            </div>
          </header>
          {!exists && <p class="hp-gone"><Icon name="ph:plug-fill" width="14" height="14" />{dt('This channel was deleted in Discord. Remove the honeypot or make it again in another channel.')}</p>}

          <div class="hp-body">
            <form method="POST" class="hp-form" data-hp-form>
              <input type="hidden" name="action" value="save" />
              <input type="hidden" name="channel_id" value={h.channelId} />
              <input type="hidden" name="member_settings" value="1" />
              <fieldset class="hp-group">
                <legend><span class="hp-step">1</span>{dt('Punishment')}</legend>
                <div class="hp-options">
                  {punishments.map((p) => (
                    <label class="hp-option"><input type="radio" name="punishment" value={p.id} checked={p.id === h.punishment} data-hp-punishment /><span><b>{p.label}</b><em>{p.hint}</em></span></label>
                  ))}
                </div>
              </fieldset>
              <fieldset class="hp-group">
                <legend><span class="hp-step">2</span>{dt('Message in the channel')}</legend>
                <div class="hp-modes">
                  <label class="hp-mode"><input type="radio" name="mode" value="default" checked={h.mode === 'default'} data-hp-mode /><span><Icon name="ph:shield-warning-fill" width="15" height="15" /><b>{dt("Petto's normal panel")}</b><em>{dt('The warning with the picture and the count.')}</em></span></label>
                  <label class="hp-mode"><input type="radio" name="mode" value="custom" checked={h.mode === 'custom'} data-hp-mode /><span><Icon name="ph:pencil-simple-bold" width="15" height="15" /><b>{dt('A custom message')}</b><em>{dt('Your own text or a saved embed.')}</em></span></label>
                  <label class="hp-mode"><input type="radio" name="mode" value="none" checked={h.mode === 'none'} data-hp-mode /><span><Icon name="ph:prohibit-fill" width="15" height="15" /><b>{dt('Nothing')}</b><em>{dt('The channel stays empty. The trap still works.')}</em></span></label>
                </div>
                <div class="hp-custom" data-hp-custom>
                  <label class="hp-field"><span>{dt('Saved embed')}</span>
                    <select name="template">
                      <option value="">{dt('No embed: send the text')}</option>
                      {embedNames.map((name) => <option value={name} selected={name === h.template}>{name}</option>)}
                      {h.template && !embedNames.includes(h.template) && <option value={h.template} selected>{h.template}</option>}
                    </select>
                  </label>
                  <div class="hp-field hp-text">
                    <span>{dt('Text')}</span>
                    <textarea name="text" class="dgl-autogrow" rows="4" maxlength="2000" data-count data-dp data-dp-template="template" data-ac placeholder={dt('Do not write in {honeypot.channel}: anyone who does gets {honeypot.action}. Caught so far: {honeypot.count}.')}>{h.text}</textarea><SilentMentionHint />
                  </div>
                  <p class="hp-hint">{dt('Variables: {honeypot.action} (what happens), {honeypot.count} (members caught) and {honeypot.channel}. A saved embed is posted instead of the text; the text is used if the embed is deleted.')}</p>
                </div>
              </fieldset>
              <fieldset class="hp-group">
                <legend><span class="hp-step">3</span>{dt('The member who is caught')}</legend>
                <div class="hp-switches">
                  <label class="sx-switch"><input type="checkbox" name="dm" value="1" checked={h.dm} data-hp-dm /><span class="sx-switch-text"><b>{dt('Send them a DM')}</b><em>{dt("The server's sanction message, sent before they are removed (with the appeal link when appeals are on).")}</em></span><span class="sx-toggle"></span></label>
                  <label class="sx-switch hp-reinvite"><input type="checkbox" name="reinvite" value="1" checked={h.reinvite} data-hp-reinvite /><span class="sx-switch-text"><b>{dt('Add an invite back')}</b><em>{dt('Softban only: a link that works once and lasts 7 days, so a real member whose account was hacked can come back. Petto needs Create Invite in a channel everyone can see.')}</em></span><span class="sx-toggle"></span></label>
                  <p class="hp-hint hp-reinvite-off">{dt('The invite back is only sent with a softban: a ban keeps them out and a kicked member can join again with any invite.')}</p>
                </div>
              </fieldset>
              <div class="hp-actions">
                <button class="btn btn-accent btn-sm" type="submit" disabled={!ready}>{dt('Save')}</button>
              </div>
            </form>

            <aside class="hp-preview" aria-label={dt('Preview')}>
              <p class="hp-preview-title">{dt('Preview')}</p>
              <div class="hp-preview-default" data-hp-default>
                <div class="dp-msg">
                  <img class="dp-avatar" src="/assets/mascot-icon.webp" alt="" />
                  <div class="dp-body">
                    <div class="dp-head"><span class="dp-name">Petto</span><span class="dp-tag">APP</span></div>
                    <div class="dp-v2-container noaccent">
                      <div class="dp-v2-section">
                        <div class="dp-v2-section-text">
                          <span class="dp-h2">{panelWords.title}</span>
                          <p class="hp-panel-text" data-hp-panel-text set:html={panelWords.body.replace('{punishment}', `<strong>${punishmentText(h.punishment)}</strong>`)} />
                        </div>
                        <img class="dp-v2-thumb" src="/assets/petto-honeypot.webp" alt="" />
                      </div>
                      <div class="dp-btn-row"><span class="dp-btn"><Icon name="ph:bug-fill" width="13" height="13" />{panelWords.button.replace('{count}', String(h.caught))}</span></div>
                    </div>
                  </div>
                </div>
              </div>
              <p class="hp-preview-note hp-preview-none"><Icon name="ph:prohibit-fill" width="14" height="14" />{dt('Nothing is posted. The channel looks empty, and anyone who writes there is still caught.')}</p>
              <p class="hp-preview-note hp-preview-custom"><Icon name="ph:pencil-simple-bold" width="14" height="14" />{dt('Your message, as members will see it, appears under the text.')}</p>
            </aside>
          </div>

          <footer class="hp-card-foot">
            <form method="POST" data-no-dirty>
              <input type="hidden" name="action" value="post" />
              <input type="hidden" name="channel_id" value={h.channelId} />
              <input type="hidden" name="fresh" value="1" />
              <button class="btn btn-ghost btn-sm" type="submit" disabled={!ready || !exists || h.mode === 'none'}><Icon name="ph:paper-plane-tilt-fill" width="13" height="13" />{h.panelMessageId ? dt('Post it again') : dt('Post the message')}</button>
            </form>
            <form method="POST" data-no-dirty>
              <input type="hidden" name="action" value="remove" />
              <input type="hidden" name="channel_id" value={h.channelId} />
              <button class="btn btn-ghost btn-sm hp-remove" type="submit" disabled={!ready} data-confirm={dt('Remove this honeypot? Its warning message is deleted and the channel stays.')}><Icon name="ph:trash-bold" width="13" height="13" />{dt('Remove honeypot')}</button>
            </form>
            <span class="hp-hint hp-foot-hint">{dt('Saved changes are posted in the channel right away.')}</span>
          </footer>
        </article>
      );
    })}

    {honeypots.length > 0 && (
      <section class="hp-catches">
        <h2>{dt('Recent catches')}</h2>
        {catches.length ? (
          <ul>
            {catches.map((c) => (
              <li>
                <img src={c.avatar} alt="" width="28" height="28" loading="lazy" referrerpolicy="no-referrer" />
                <span class="hp-who"><b>{c.name ?? c.userId}</b>{c.username && c.name !== c.username && <em>@{c.username}</em>}</span>
                <span class:list={['hp-tag', `hp-tag-${c.type}`]}>{punishmentLabel(c.type)}</span>
                <a class="hp-case" href={`/dash/guild/${guildId}/moderation?section=cases`}>{dt('Case #{n}', { n: c.caseNumber })}</a>
                <time datetime={c.at}>{when(c.at)}</time>
              </li>
            ))}
          </ul>
        ) : <p class="hp-hint">{dt('Nobody has been caught yet. That is good news: the trap is waiting.')}</p>}
      </section>
    )}
    <p class="hp-hint hp-cmd">{dt('With the prefix: !honeypot add, remove, panel, dm and list.')}</p>
  </div>
    <script is:inline>
      // Runs on every arrival of the page: a full load, a move from the menu (the dashboard swaps the content in and runs the scripts
      // inside it) and every redraw after a save or a live update. What shows and hides (the custom message, the invite back, the
      // previews) is CSS on the checked inputs, so it is right before this runs; this only writes the punishment into the preview,
      // through one listener for the whole document (bound once, so nothing doubles).
      (function () {
        var root = document.querySelector('[data-honeypot]');
        if (!root) return;
        var words = {};
        try { words = JSON.parse(root.getAttribute('data-words') || '{}'); } catch (e) { words = {}; }
        var escape = function (text) { return String(text).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
        var update = function (card) {
          var mode = card.querySelector('[data-hp-mode]:checked');
          var punishment = card.querySelector('[data-hp-punishment]:checked');
          card.setAttribute('data-mode', mode ? mode.value : 'default');
          card.setAttribute('data-punishment', punishment ? punishment.value : 'softban');
          var text = card.querySelector('[data-hp-panel-text]');
          var word = (words.punishments || {})[punishment ? punishment.value : 'softban'] || '';
          if (text) text.innerHTML = escape(words.body || '').replace('{punishment}', '<strong>' + escape(word) + '</strong>');
        };
        window.__hpUpdate = update;
        root.querySelectorAll('[data-hp-card]').forEach(update);
        if (!window.__hpBound) {
          window.__hpBound = true;
          var onChange = function (event) {
            var card = event.target && event.target.closest ? event.target.closest('[data-honeypot] [data-hp-card]') : null;
            if (card && window.__hpUpdate) window.__hpUpdate(card);
          };
          document.addEventListener('change', onChange);
          // Discarding the changes resets the form without change events.
          document.addEventListener('reset', function (event) { setTimeout(function () { onChange(event); }, 0); }, true);
        }
        // The answer of a save says what happened; the live update that follows a moment later (the bot changed the channel) redraws
        // the page without it, so the message is kept on screen for a few seconds.
        var flash = root.querySelector('[data-hp-flash]');
        var kept = window.__hpFlash;
        if (flash) {
          var copy = flash.cloneNode(true);
          copy.removeAttribute('data-hp-flash');
          window.__hpFlash = { path: location.pathname, html: copy.outerHTML, at: Date.now() };
        }
        else if (kept && kept.path === location.pathname && Date.now() - kept.at < 8000) {
          var head = root.querySelector('.hp-head');
          if (head) head.insertAdjacentHTML('afterend', kept.html);
        }
      })();
    </script>

</DashGuildLayout>


<style>
  .hp { max-width: 1100px; display: flex; flex-direction: column; }
  .hp-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 14px; margin: 0 0 18px; }
  .hp-head h1 { font-size: 24px; margin: 0; }
  .hp-docs { display: inline-flex; align-items: center; gap: 6px; }
  .hp h2 { font-size: 16px; margin: 0 0 10px; }
  .hp-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid color-mix(in srgb, var(--green) 55%, transparent); border-radius: 10px; padding: 10px 14px; margin: 0 0 14px; max-width: 760px; overflow-wrap: anywhere; }
  .hp-flash :global(svg) { flex: none; }
  .hp-flash-err { color: var(--red, #ff6b6b); background: color-mix(in srgb, var(--red, #ff6b6b) 10%, transparent); border-color: color-mix(in srgb, var(--red, #ff6b6b) 55%, transparent); }
  .hp-flash-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: color-mix(in srgb, var(--yellow) 55%, transparent); }
  .hp-hint { font-size: 12.5px; color: var(--text-dim); margin: 6px 0 0; }
  .hp-empty { display: flex; gap: 24px; align-items: center; justify-content: center; max-height: 280px; overflow: hidden; border: 1px dashed color-mix(in srgb, #d99a3d 60%, var(--border)); background: color-mix(in srgb, #d99a3d 7%, var(--card)); border-radius: 14px; padding: 20px; margin-bottom: 18px; }
  .hp-empty img { width: 96px; height: auto; max-height: 160px; object-fit: contain; flex: none; }
  .hp-empty p { margin: 0 0 10px; font-size: 14px; color: var(--text-muted); }
  .hp-empty ol { margin: 0 0 10px; padding-left: 20px; font-size: 14px; display: grid; gap: 6px; }
  .hp-add { border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 16px 18px; margin-bottom: 18px; }
  .hp-add-form { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
  .hp-add-form .sx-field { flex: 1 1 220px; }
  .hp-add-form .btn { flex: none; }
  .hp-add-form .dfx-chips { padding-top: 1px; }
  .hp-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .hp-field > span { font-size: 13px; font-weight: 600; }
  .hp-field select, .hp-field textarea { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; min-width: 0; max-width: 100%; }
  .hp-field textarea { resize: vertical; min-height: 84px; }

  /* A channel card: the name and what it does on top, the three choices on the left, what is posted on the right. */
  .hp-card { border: 1px solid var(--border); border-radius: 14px; background: var(--card); margin-bottom: 16px; overflow: hidden; }
  .hp-card:has(form.is-dirty) { border-color: color-mix(in srgb, var(--accent) 60%, var(--border)); }
  .hp-card-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 12px; padding: 12px 16px; border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--text) 2.5%, var(--card)); }
  .hp-card-title { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .hp-card-title b { font-size: 15px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hp-card-meta { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 13px; color: var(--text-muted); }
  .hp-count { display: inline-flex; align-items: center; gap: 5px; }
  .hp-count :global(svg) { color: #d99a3d; }
  .hp-state { color: var(--green); }
  .hp-state a { color: inherit; display: inline-flex; align-items: center; gap: 4px; }
  .hp-state-off { color: var(--text-dim); }
