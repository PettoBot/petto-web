---
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import { getDashLang, makeT } from '../i18n/dash';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Honeypot {
  channelId: string; channelName: string | null; punishment: string; caught: number; messages: number;
  mode: string; text: string; template: string; panelMessageId: string | null;
}
interface Catch { caseNumber: number; userId: string; type: string; at: string; name: string | null; username: string | null; avatar: string }
interface Props {
  user: { username: string; avatar: string | null; userId?: string };
  guildId: string;
  guildName: string;
  guildIcon: string;
  honeypots: Honeypot[];
  freeChannels: { id: string; name: string }[];
  embedNames: string[];
  catches: Catch[];
  ready: boolean;
  message: { kind: 'ok' | 'err'; text: string } | null;
  openChannel: string | null;
}
const { user, guildId, guildName, guildIcon, honeypots, freeChannels, embedNames, catches, ready, message, openChannel } = Astro.props;

// The words of Petto's own panel, as the bot writes them (security.honeypot.* in the bot), for the preview.
const punishments = [
  { id: 'softban', label: dt('Softban (recommended)'), hint: dt('Removes them and deletes their messages of the last day. They can join again.'), text: dt('a softban') },
  { id: 'ban', label: dt('Ban'), hint: dt('Removes them for good and deletes their messages of the last day.'), text: dt('a ban') },
  { id: 'kick', label: dt('Kick'), hint: dt('Removes them. Their messages stay and they can join again.'), text: dt('a kick') },
];
const punishmentText = (id: string) => punishments.find((p) => p.id === id)?.text ?? punishments[0].text;
const punishmentLabel = (id: string) => ({ softban: dt('Softban'), ban: dt('Ban'), kick: dt('Kick') } as Record<string, string>)[id] ?? id;
const totalCaught = honeypots.reduce((sum, h) => sum + h.caught, 0);
const panelWords = {
  title: dt('DO NOT SEND MESSAGES IN THIS CHANNEL'),
  body: dt('This channel is used to catch spam bots. Any messages sent here will result in {punishment}.'),
  button: dt('Kicks: {count}'),
  punishments: Object.fromEntries(punishments.map((p) => [p.id, p.text])),
};
const when = (iso: string) => {
  const date = new Date(iso);
  return Number.isFinite(date.getTime()) ? date.toLocaleString(dashLang, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '';
};
const modeLabel = (h: Honeypot) => (h.mode === 'none' ? dt('Nothing posted') : h.mode === 'custom' ? (h.template ? dt('Saved embed: {name}', { name: h.template }) : dt('Your text')) : dt("Petto's normal panel"));
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active="honeypot" pageTitle={dt('Honeypot')}>
  <div class="hp" data-honeypot data-words={JSON.stringify(panelWords)}>
    <header class="hp-head">
      <h1>{dt('Honeypot')}</h1>
      <p class="hp-sub">{dt('A bait channel that nobody should write in. Real members read the warning and stay away; spam bots and hacked accounts post in every channel they see, so the first message they send there gets them removed.')}</p>
    </header>

    {message && <div class:list={['hp-flash', { 'hp-flash-err': message.kind === 'err' }]} role="status"><Icon name={message.kind === 'ok' ? 'ph:check-circle-fill' : 'ph:warning-fill'} width="15" height="15" />{message.text}</div>}
    {!ready && <div class="hp-flash hp-flash-warn"><Icon name="ph:plug-fill" width="15" height="15" />{dt('The honeypot settings could not be read. Try again in a moment.')}</div>}

    {honeypots.length > 0 && (
      <div class="hp-stats">
        <div><b>{honeypots.length}</b><span>{dt('Bait channels')}</span></div>
        <div><b>{totalCaught.toLocaleString(dashLang)}</b><span>{dt('Members caught')}</span></div>
        <div><b>{catches[0] ? when(catches[0].at) : '—'}</b><span>{dt('Last catch')}</span></div>
      </div>
    )}

    {honeypots.length === 0 && (
      <section class="hp-empty">
        <img src="/assets/petto-honeypot.webp" alt="" width="96" height="92" loading="lazy" />
        <div>
          <h2>{dt('What is a honeypot?')}</h2>
          <p>{dt('It is a trap for spam bots. You make a channel (for example #do-not-write) and Petto posts a big warning in it: "do not send messages here".')}</p>
          <ol>
            <li>{dt('People read the warning and never write there.')}</li>
            <li>{dt('Spam bots and hacked accounts do not read: they post the same scam link in every channel.')}</li>
            <li>{dt('The moment one posts in the bait channel, Petto deletes the message and removes the account (softban, ban or kick), and writes a case.')}</li>
          </ol>
          <p class="hp-hint">{dt('The owner, administrators and anyone with Manage Messages are never punished. Each member is punished once; their later messages are only deleted.')}</p>
        </div>
      </section>
    )}

    <section class="hp-add">
      <h2>{honeypots.length ? dt('Add a bait channel') : dt('Set up your first honeypot')}</h2>
      <form method="POST" class="hp-add-form" data-no-dirty>
        <input type="hidden" name="action" value="add" />
        <label class="hp-field"><span>{dt('Channel')}</span>
          <select name="channel_id" required>
            <option value="">{dt('Choose a channel')}</option>
            {freeChannels.map((c) => <option value={c.id}>#{c.name}</option>)}
          </select>
        </label>
        <label class="hp-field"><span>{dt('What happens to who posts there')}</span>
          <select name="punishment">{punishments.map((p) => <option value={p.id} selected={p.id === 'softban'}>{p.label}</option>)}</select>
        </label>
        <button class="btn btn-accent btn-sm" type="submit" disabled={!ready || !freeChannels.length}><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add honeypot')}</button>
      </form>
      <p class="hp-hint">{dt('Use an empty channel members can see. Petto needs View Channel, Send Messages, Read Message History and Manage Messages there, and posts the warning at once.')}</p>
    </section>

    {honeypots.map((h) => {
      const href = h.panelMessageId ? `https://discord.com/channels/${guildId}/${h.channelId}/${h.panelMessageId}` : null;
      const exists = Boolean(h.channelName);
      return (
        <article class="hp-card" data-hp-card data-mode={h.mode} id={`hp-${h.channelId}`}>
          <header class="hp-card-head">
            <div class="hp-card-title">
              <Icon name="ph:hash-bold" width="16" height="16" />
              <b>{h.channelName ?? dt('Deleted channel')}</b>
              <span class:list={['hp-tag', `hp-tag-${h.punishment}`]}>{punishmentLabel(h.punishment)}</span>
            </div>
            <div class="hp-card-meta">
              <span><b>{h.caught.toLocaleString(dashLang)}</b> {h.caught === 1 ? dt('member caught') : dt('members caught')}</span>
              <span class:list={['hp-state', { 'hp-state-off': !h.panelMessageId }]}>
                {h.mode === 'none' ? dt('Nothing posted') : h.panelMessageId ? <a href={href} target="_blank" rel="noopener">{modeLabel(h)} <Icon name="ph:arrow-square-out-bold" width="11" height="11" /></a> : dt('The message is not posted')}
              </span>
            </div>
          </header>
          {!exists && <p class="hp-flash hp-flash-warn hp-inline"><Icon name="ph:warning-fill" width="14" height="14" />{dt('This channel was deleted in Discord. Remove the honeypot or make it again in another channel.')}</p>}

          <div class="hp-body">
            <form method="POST" class="hp-form" data-hp-form>
              <input type="hidden" name="action" value="save" />
              <input type="hidden" name="channel_id" value={h.channelId} />
              <fieldset class="hp-group">
                <legend>{dt('Punishment')}</legend>
                <div class="hp-options">
                  {punishments.map((p) => (
                    <label class="hp-option"><input type="radio" name="punishment" value={p.id} checked={p.id === h.punishment} data-hp-punishment /><span><b>{p.label}</b><em>{p.hint}</em></span></label>
                  ))}
                </div>
              </fieldset>
              <fieldset class="hp-group">
                <legend>{dt('Message in the channel')}</legend>
                <div class="hp-modes" role="radiogroup">
                  <label class="hp-mode"><input type="radio" name="mode" value="default" checked={h.mode === 'default'} data-hp-mode /><span><Icon name="ph:shield-warning-fill" width="15" height="15" /><b>{dt("Petto's normal panel")}</b><em>{dt('The warning with the picture and the count.')}</em></span></label>
                  <label class="hp-mode"><input type="radio" name="mode" value="custom" checked={h.mode === 'custom'} data-hp-mode /><span><Icon name="ph:pencil-simple-bold" width="15" height="15" /><b>{dt('A custom message')}</b><em>{dt('Your own text or a saved embed.')}</em></span></label>
                  <label class="hp-mode"><input type="radio" name="mode" value="none" checked={h.mode === 'none'} data-hp-mode /><span><Icon name="ph:prohibit-fill" width="15" height="15" /><b>{dt('Nothing')}</b><em>{dt('The channel stays empty. The trap still works.')}</em></span></label>
                </div>
                <div class="hp-custom" data-hp-custom>
                  <label class="hp-field"><span>{dt('Saved embed')}</span>
                    <select name="template">
                      <option value="">{dt('No embed: send the text')}</option>
                      {embedNames.map((name) => <option value={name} selected={name === h.template}>{name}</option>)}
                      {h.template && !embedNames.includes(h.template) && <option value={h.template} selected>{h.template}</option>}
                    </select>
                  </label>
                  <div class="hp-field hp-text">
                    <span>{dt('Text')}</span>
                    <textarea name="text" rows="4" maxlength="2000" data-dp data-dp-template="template" placeholder={dt('Do not write in {honeypot.channel}: anyone who does gets {honeypot.action}. Caught so far: {honeypot.count}.')}>{h.text}</textarea>
                  </div>
                  <p class="hp-hint">{dt('Variables: {honeypot.action} (what happens), {honeypot.count} (members caught) and {honeypot.channel}. A saved embed is posted instead of the text; the text is used if the embed is deleted.')}</p>
                </div>
              </fieldset>
              <div class="hp-actions">
                <button class="btn btn-accent btn-sm" type="submit" disabled={!ready || !exists}>{dt('Save')}</button>
              </div>
            </form>

            <aside class="hp-preview" aria-label={dt('Preview')}>
              <p class="hp-preview-title">{dt('Preview')}</p>
              <div class="hp-preview-default" data-hp-default>
                <div class="dp-msg">
                  <img class="dp-avatar" src="/assets/mascot-icon.webp" alt="" />
                  <div class="dp-body">
                    <div class="dp-head"><span class="dp-name">Petto</span><span class="dp-tag">APP</span></div>
                    <div class="dp-v2-container noaccent">
                      <div class="dp-v2-section">
                        <div class="dp-v2-section-text">
                          <span class="dp-h2">{panelWords.title}</span>
                          <p class="hp-panel-text" data-hp-panel-text set:html={panelWords.body.replace('{punishment}', `<strong>${punishmentText(h.punishment)}</strong>`)} />
                        </div>
                        <img class="dp-v2-thumb" src="/assets/petto-honeypot.webp" alt="" />
                      </div>
                      <div class="dp-btn-row"><span class="dp-btn"><Icon name="ph:bug-fill" width="13" height="13" />{panelWords.button.replace('{count}', String(h.caught))}</span></div>
                    </div>
                  </div>
                </div>
              </div>
              <p class="hp-preview-none" data-hp-none>{dt('Nothing is posted. The channel looks empty, and anyone who writes there is still caught.')}</p>
              <p class="hp-preview-custom-note" data-hp-custom-note>{dt('Your message, as members will see it, appears under the text.')}</p>
            </aside>
          </div>

          <footer class="hp-card-foot">
            <form method="POST" data-no-dirty>
              <input type="hidden" name="action" value="post" />
              <input type="hidden" name="channel_id" value={h.channelId} />
              <input type="hidden" name="fresh" value="1" />
              <button class="btn btn-ghost btn-sm" type="submit" disabled={!ready || !exists || h.mode === 'none'}><Icon name="ph:paper-plane-tilt-fill" width="13" height="13" />{h.panelMessageId ? dt('Post it again') : dt('Post the message')}</button>
            </form>
            <form method="POST" data-no-dirty>
              <input type="hidden" name="action" value="remove" />
              <input type="hidden" name="channel_id" value={h.channelId} />
              <button class="btn btn-ghost btn-sm hp-remove" type="submit" disabled={!ready} data-confirm={dt('Remove this honeypot? Its warning message is deleted and the channel stays.')}><Icon name="ph:trash-bold" width="13" height="13" />{dt('Remove honeypot')}</button>
            </form>
            {h.channelId === openChannel && <span class="hp-hint">{dt('Saved changes are posted in the channel right away.')}</span>}
          </footer>
        </article>
      );
    })}

    {honeypots.length > 0 && (
      <section class="hp-catches">
        <h2>{dt('Recent catches')}</h2>
        {catches.length ? (
          <ul>
            {catches.map((c) => (
              <li>
                <img src={c.avatar} alt="" width="28" height="28" loading="lazy" referrerpolicy="no-referrer" />
                <span class="hp-who"><b>{c.name ?? c.userId}</b>{c.username && c.name !== c.username && <em>@{c.username}</em>}</span>
                <span class:list={['hp-tag', `hp-tag-${c.type}`]}>{punishmentLabel(c.type)}</span>
                <a class="hp-case" href={`/dash/guild/${guildId}/moderation?section=cases`}>{dt('Case #{n}', { n: c.caseNumber })}</a>
                <time datetime={c.at}>{when(c.at)}</time>
              </li>
            ))}
          </ul>
        ) : <p class="hp-hint">{dt('Nobody has been caught yet. That is good news: the trap is waiting.')}</p>}
      </section>
    )}
    <p class="hp-hint hp-cmd">{dt('With the prefix: !honeypot add, remove, panel and list.')}</p>
  </div>
</DashGuildLayout>

<script>
  // Each card shows the preview of the message it would post: Petto's panel with the chosen punishment, the custom text or saved embed
  // (drawn by DashPreviews under the text), or a note that nothing is posted.
  function initHoneypot() {
    const root = document.querySelector<HTMLElement>('[data-honeypot]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    const words = JSON.parse(root.dataset.words ?? '{}');
    const escape = (text: string) => text.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
    root.querySelectorAll<HTMLElement>('[data-hp-card]').forEach((card) => {
      const form = card.querySelector<HTMLFormElement>('[data-hp-form]');
      if (!form) return;
      const update = () => {
        const mode = form.querySelector<HTMLInputElement>('[data-hp-mode]:checked')?.value ?? 'default';
        card.dataset.mode = mode;
        const punishment = form.querySelector<HTMLInputElement>('[data-hp-punishment]:checked')?.value ?? 'softban';
        const text = card.querySelector<HTMLElement>('[data-hp-panel-text]');
        if (text) text.innerHTML = escape(String(words.body ?? '')).replace('{punishment}', `<strong>${escape(String(words.punishments?.[punishment] ?? ''))}</strong>`);
      };
      form.addEventListener('change', update);
      form.addEventListener('reset', () => setTimeout(update, 0));
      update();
    });
  }
  try { initHoneypot(); } catch (error) { console.error(error); }
  if (!(window as any).__hpWatch) {
    (window as any).__hpWatch = true;
    new MutationObserver(() => { if (document.querySelector('[data-honeypot]:not([data-bound])')) { try { initHoneypot(); } catch (error) { console.error(error); } } }).observe(document.body, { childList: true, subtree: true });
  }
</script>

<style>
  .hp { max-width: 1180px; }
  .hp-head h1 { font-size: 24px; margin: 0 0 6px; }
  .hp-sub { font-size: 14px; color: var(--text-muted); margin: 0 0 18px; max-width: 72ch; }
  .hp h2 { font-size: 16px; margin: 0 0 10px; }
  .hp-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--green); background: var(--green-soft); border: 1px solid color-mix(in srgb, var(--green) 55%, transparent); border-radius: 10px; padding: 10px 14px; margin: 0 0 14px; max-width: 760px; overflow-wrap: anywhere; }
  .hp-flash :global(svg) { flex: none; }
  .hp-flash-err { color: var(--red, #ff6b6b); background: color-mix(in srgb, var(--red, #ff6b6b) 10%, transparent); border-color: color-mix(in srgb, var(--red, #ff6b6b) 55%, transparent); }
  .hp-flash-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: color-mix(in srgb, var(--yellow) 55%, transparent); }
  .hp-inline { margin: 0 16px 12px; }
  .hp-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 18px; max-width: 640px; }
  .hp-stats div { border: 1px solid var(--border); border-radius: 12px; background: var(--card); padding: 12px 16px; min-width: 0; }
  .hp-stats b { display: block; font-size: 20px; overflow-wrap: anywhere; }
  .hp-stats span { font-size: 12.5px; color: var(--text-dim); }
  .hp-hint { font-size: 12.5px; color: var(--text-dim); margin: 6px 0 0; }
  .hp-empty { display: flex; gap: 20px; align-items: flex-start; border: 1px dashed color-mix(in srgb, #d99a3d 60%, var(--border)); background: color-mix(in srgb, #d99a3d 7%, var(--card)); border-radius: 14px; padding: 20px; margin-bottom: 18px; max-width: 820px; }
  .hp-empty img { width: 96px; height: auto; flex: none; }
  .hp-empty p { margin: 0 0 10px; font-size: 14px; color: var(--text-muted); }
  .hp-empty ol { margin: 0 0 10px; padding-left: 20px; font-size: 14px; display: grid; gap: 6px; }
  .hp-add { border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 16px 18px; margin-bottom: 18px; max-width: 820px; }
  .hp-add-form { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
  .hp-add-form .hp-field { flex: 1 1 200px; }
  .hp-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .hp-field > span { font-size: 13px; font-weight: 600; }
  .hp-field select, .hp-field textarea { border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; min-width: 0; max-width: 100%; }
  .hp-field textarea { resize: vertical; min-height: 84px; }
  .hp-card { border: 1px solid var(--border); border-radius: 14px; background: var(--card); margin-bottom: 16px; overflow: hidden; }
  .hp-card-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--border); }
  .hp-card-title { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .hp-card-title b { font-size: 15px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hp-card-meta { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 13px; color: var(--text-muted); }
  .hp-state { color: var(--green); }
  .hp-state a { color: inherit; display: inline-flex; align-items: center; gap: 4px; }
  .hp-state-off { color: var(--text-dim); }
  .hp-tag { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; border-radius: 999px; padding: 2px 8px; background: color-mix(in srgb, #d99a3d 18%, transparent); color: #b7791f; flex: none; }
  .hp-tag-ban { background: color-mix(in srgb, var(--red, #ff6b6b) 16%, transparent); color: var(--red, #e5484d); }
  .hp-tag-kick { background: color-mix(in srgb, var(--accent) 16%, transparent); color: var(--accent); }
  .hp-body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 360px); gap: 18px; padding: 16px; align-items: start; }
  .hp-form { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .hp-group { border: 0; padding: 0; margin: 0; min-width: 0; }
  .hp-group legend { font-size: 13px; font-weight: 700; margin-bottom: 8px; padding: 0; }
  .hp-options, .hp-modes { display: grid; grid-template-columns: 1fr; gap: 6px; }
  .hp-option, .hp-mode { display: flex; align-items: flex-start; gap: 8px; border: 1px solid var(--border); border-radius: 10px; padding: 9px 11px; cursor: pointer; min-width: 0; }
  .hp-option:has(input:checked), .hp-mode:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
  .hp-option input, .hp-mode input { margin-top: 3px; flex: none; }
  .hp-option span, .hp-mode span { min-width: 0; overflow-wrap: anywhere; }
  .hp-option b, .hp-mode b { display: block; font-size: 13.5px; }
  .hp-option em, .hp-mode em { display: block; font-style: normal; font-size: 12px; color: var(--text-dim); margin-top: 2px; }
  .hp-mode span { display: grid; grid-template-columns: 18px minmax(0, 1fr); column-gap: 6px; min-width: 0; }
  .hp-mode span em { grid-column: 2; }
  .hp-mode span :global(svg) { color: var(--accent); margin-top: 2px; }
  .hp-custom { display: none; flex-direction: column; gap: 10px; margin-top: 12px; }
  [data-mode='custom'] .hp-custom { display: flex; }
  .hp-actions { display: flex; gap: 10px; align-items: center; }
  .hp-preview { border: 1px solid var(--border); border-radius: 12px; padding: 12px; background: color-mix(in srgb, var(--text) 3%, var(--card)); min-width: 0; }
  .hp-preview-title { margin: 0 0 10px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--text-dim); }
  .hp-preview-default, .hp-preview-none, .hp-preview-custom-note { display: none; }
  [data-mode='default'] .hp-preview-default { display: block; }
  [data-mode='none'] .hp-preview-none, [data-mode='custom'] .hp-preview-custom-note { display: block; margin: 0; font-size: 13px; color: var(--text-muted); }
  .hp-panel-text { margin: 6px 0 0; }
  .hp-panel-text :global(strong) { color: #f2f3f5; }
  .hp-card-foot { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; padding: 12px 16px; border-top: 1px solid var(--border); }
  .hp-remove { color: var(--red, #e5484d); }
  .hp-catches { border: 1px solid var(--border); border-radius: 14px; background: var(--card); padding: 16px 18px; margin-bottom: 14px; max-width: 820px; }
  .hp-catches ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .hp-catches li { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto auto auto; align-items: center; gap: 10px; padding: 6px 0; border-top: 1px solid var(--border); font-size: 13px; }
  .hp-catches li:first-child { border-top: 0; }
  .hp-catches img { width: 28px; height: 28px; border-radius: 50%; }
  .hp-who { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hp-who em { font-style: normal; color: var(--text-dim); margin-left: 6px; }
  .hp-case { color: var(--accent); white-space: nowrap; }
