---
// Feeds: follow an account of another service (YouTube, Twitch, Bluesky, Modrinth, the Pokémon of the day) and let Petto post what it
// publishes in a channel. The list is read from the database by the page; looking up an account, following it, the test notice and the
// preview of the card go through the bot (feeds-api.ts). The preview is the real card of the bot drawn with the same renderer as the
// Embed Builder.
import SilentMentionHint from './SilentMentionHint.astro';
import { Icon } from 'astro-icon/components';
import DashGuildLayout from './DashGuildLayout.astro';
import DashAcData from './DashAcData.astro';
import DashSettingsKit from './DashSettingsKit.astro';
import DashStatTiles from './DashStatTiles.astro';
import Modal from './Modal.astro';
import { agoText, formatDuration } from '../utils/formatDuration';
import { dashLocale, getDashLang, makeT } from '../i18n/dash';
import { postProblemText, type PostableChannel } from '../utils/channelPost';
import { ANIMAL_KINDS, ANIMAL_PLATFORM_IDS, ANNOUNCING_PLATFORMS, FEED_PACES, FEED_PLATFORMS, FEED_TYPES, FEED_VARIABLES, LOCKED_PLATFORMS, paceOf, platformById, platformGroup, type FeedRow } from '../utils/feeds';

const dashLang = getDashLang(Astro);
const dt = makeT(dashLang);
interface Props {
  user: { username: string; avatar: string | null };
  guildId: string;
  guildName: string;
  guildIcon: string;
  platform: string | null;
  feeds: FeedRow[];
  channels: PostableChannel[];
  roles: { id: string; name: string; color: number }[];
  limit: number;
  premium: boolean;
  premiumLimit: number;
  freeLimit: number;
  ready: boolean;
}
const { user, guildId, guildName, guildIcon, platform, feeds, channels, roles, limit, premium, premiumLimit, freeLimit, ready } = Astro.props;
const current = platform ? platformById(platform) : null;
const shown = current ? feeds.filter((feed) => platformGroup(current.id).includes(feed.platform)) : feeds; // the animals that were a platform each are shown with the animals
const channelName = new Map(channels.map((channel) => [channel.id, channel.name]));
// Where Petto cannot see or write (it says so, the notices would not arrive): the reason is told under the name (utils/channelPost.ts), never inside it.
const channelClosed = new Map(channels.filter((channel) => channel.problem).map((channel) => [channel.id, postProblemText(dt, channel.problem)]));
// The limit is for each platform (3 of YouTube, 3 of Twitch... on Free; 25 of each on Premium).
const used = current ? feeds.filter((feed) => feed.platform === current.id).length : feeds.length;
const full = current ? used >= limit : false;
const countOf = (id: string) => feeds.filter((feed) => feed.platform === id).length;
const locale = dashLocale(dashLang);
// The numbers of the tiles: what the page lists (every feed, or the ones of the platform), counted from the same rows.
const activeCount = shown.filter((feed) => feed.enabled).length;
const pausedCount = shown.length - activeCount;
const platformsInUse = new Set(feeds.map((feed) => (ANIMAL_PLATFORM_IDS.includes(feed.platform) ? 'animals' : feed.platform))).size;
const lastSentAt = shown.reduce<number>((latest, feed) => Math.max(latest, feed.lastSentAt ? Date.parse(feed.lastSentAt) || 0 : 0), 0);
const tiles = current
  ? [
    { label: dt('Followed'), value: shown.length, tone: 'voice' as const },
    { label: dt('Active'), value: activeCount, tone: 'joins' as const },
    { label: dt('Paused'), value: pausedCount, tone: 'reactions' as const },
    { label: dt('Last notice'), value: 0, text: lastSentAt ? agoText(dt, lastSentAt, { locale }) : '—', tone: 'messages' as const },
  ]
  : [
    { label: dt('Feeds'), value: feeds.length, tone: 'voice' as const },
    { label: dt('Platforms'), value: platformsInUse, tone: 'invites' as const },
    { label: dt('Active'), value: activeCount, tone: 'joins' as const },
    { label: dt('Paused'), value: pausedCount, tone: 'reactions' as const },
    { label: dt('Limit per platform'), value: limit, tone: 'messages' as const },
  ];

// What the bot writes in last_error (petto-bot src/feeds/engine.js), in words. A failed look at an account (noFeed, rateLimited, unavailable) does not
// count as a failure: the feed stays on and says why until a look works again.
const ERROR_TEXT: Record<string, string> = {
  permission: dt('Petto cannot post in that channel.'),
  canPostHere: dt('Petto can post in #{channel}.'), cannotPostHere: dt('Give Petto the permission there, or pick another channel, or nothing will arrive.'),
  channelGone: dt('The channel no longer exists.'),
  send: dt('The last notice could not be sent.'),
  accountGone: dt('The account no longer exists.'),
  noFeed: dt('The address is a web page, not a feed. Use the link of the RSS or Atom feed itself.'),
  rateLimited: dt('The site asks Petto to wait. It will try again by itself.'),
  unavailable: dt('The account cannot be read right now. Petto keeps trying.'),
};
const errorText = (code: string | null): string => (code ? ERROR_TEXT[code] ?? code : '');
const statusOf = (feed: FeedRow): { key: string; label: string; detail: string } => {
  if (!feed.enabled && feed.failures >= 5) return { key: 'off', label: dt('Turned off'), detail: errorText(feed.lastError) };
  if (!feed.enabled) return { key: 'paused', label: dt('Paused'), detail: errorText(feed.lastError) };
  if (!feed.ready) return { key: 'wait', label: dt('Getting ready'), detail: '' };
  if (feed.lastError) return { key: 'warn', label: dt('Having trouble'), detail: errorText(feed.lastError) };
  return { key: 'ok', label: dt('Active'), detail: '' };
};

const text = {
  find: dt('Find'), change: dt('Change'), looking: dt('Looking…'), pasteFirst: dt('Paste the link or the name first.'),
  save: dt('Save feed'), create: dt('Follow this account'), saving: dt('Saving…'), saved: dt('Saved.'), newFeed: dt('New feed'), editFeed: dt('Edit feed'),
  pickChannel: dt('Pick the channel for the notices.'), pickAccount: dt('Find the account first.'), pickType: dt('Pick at least one kind of notice.'),
  failed: dt('Petto did not answer. Try again in a moment.'), deleteAsk: dt('Stop following {name}? The channel keeps what was already posted.'),
  previewFail: dt('The preview is not available right now.'), removeRole: dt('Remove'), retry: dt('Try again'),
  messageExample: dt('{feed.author} just posted!'), messageOptional: dt('Optional text above the card'),
  searchName: dt('Search {name} or paste a link'), noResults: dt('No results. Try another name or paste the link.'),
  followed: dt('Now following {name} on {platform} in {channel}. Nothing from the past is posted: the next notice will be new.'), updated: dt('Saved the changes to {name}.'),
  pickTags: dt('Write one to four words first.'), tagsPlaceholder: dt('pink flower anime -character'),
  whichMeaning: dt('Which “{word}” do you mean?'), meaningHelp: dt('Pick one and the feed is saved with it, or add a word that says it.'),
  paused: dt('Feed paused.'), resumed: dt('Feed resumed.'), removed: dt('Stopped following {name}.'), everyN: dt('Every {n} minutes'),
  // The two lines under the channel of the window (showChannelNote): without them opening a feed to edit it, or picking a channel, stopped with an error.
  canPostHere: ERROR_TEXT.canPostHere, cannotPostHere: ERROR_TEXT.cannotPostHere,
};
const config = {
  guildId, limit, used, platforms: Object.fromEntries(FEED_PLATFORMS.map((p) => [p.id, { name: p.name, color: p.color, ink: p.ink, types: p.types, defaultTypes: p.defaultTypes, pace: Boolean(p.pace), announces: ANNOUNCING_PLATFORMS.has(p.id), extra: p.extra ?? null, intro: p.intro ? dt(p.intro) : '', account: p.account ? { ...p.account, label: dt(p.account.label), placeholder: p.account.placeholder, help: dt(p.account.help) } : null }])),
  types: Object.fromEntries(Object.entries(FEED_TYPES).map(([id, type]) => [id, dt(type.label)])),
  paces: FEED_PACES.map((pace) => [pace.minutes, dt(pace.label)]),
  roles: roles.map((role) => [role.id, role.name]), channels: channels.map((channel) => [channel.id, channel.name, channel.canPost, channelClosed.get(channel.id) ?? '']), text,
  feeds: Object.fromEntries(feeds.map((feed) => [feed.id, feed])),
};
const typeTable: Record<string, { label: string; icon: string }> = FEED_TYPES;
// How often an auto feed posts, in the short form of every duration of the dashboard (the labels of the pace choices are only for the select of the window).
const paceShort = (minutes: number): string => dt('Every {a}', { a: formatDuration(minutes * 60, { locale }) });
const typeIcon = (id: string): string => typeTable[id]?.icon ?? 'ph:bell-ringing-fill';
// The picture a feed of a website falls back to when the one its feed gives does not load: the icon of the site.
const siteIcon = (url: string | null): string => {
  try { return url ? `https://www.google.com/s2/favicons?domain=${encodeURIComponent(new URL(url).hostname)}&sz=128` : ''; } catch { return ''; }
};
const typeLabel = (id: string): string => dt(typeTable[id]?.label ?? id);
---
<DashGuildLayout guildId={guildId} guildName={guildName} guildIcon={guildIcon} user={user} active={current ? `feeds-${current.id}` : 'feeds-overview'} pageTitle={current ? `${current.name} · ${dt('Feeds')}` : dt('Feeds')}>
  <DashSettingsKit />
  <div class="fd sx-page" data-feeds data-config={JSON.stringify(config)} style={current ? `--fd-c:${current.color};--fd-ink:${current.ink}` : ''}>
    <header class="fd-head">
      <div class="fd-title">
        {current ? <span class="fd-logo" style={`--fd-c:${current.color};--fd-ink:${current.ink}`}><Icon name={current.icon} width="22" height="22" /></span> : <span class="fd-logo fd-logo-all"><Icon name="ph:bell-ringing-fill" width="22" height="22" /></span>}
        <div>
          <h1>{current ? current.name : dt('Feeds')}</h1>
          <p class="fd-lead">{current ? dt('Petto posts what these accounts publish, in the channel you choose.') : dt('Follow accounts of other services and Petto posts what they publish: videos, live streams, posts and more.')}</p>
        </div>
      </div>
      {current && (
        <div class="fd-head-actions">
          <span class={`fd-count${full ? ' fd-count-full' : ''}`} title={premium ? dt('The limit of Premium servers.') : dt('Free servers follow up to {count} accounts of each platform, Premium servers up to {premium}.', { count: String(freeLimit), premium: String(premiumLimit) })}>
            {dt('{used} of {limit} {name} accounts', { used: String(used), limit: String(limit), name: current.name })}
          </span>
          <a class="btn btn-ghost btn-sm" href={`/dash/guild/${guildId}/feeds`}><Icon name="ph:arrow-left-bold" width="13" height="13" />{dt('All feeds')}</a>
          {!current.soon && <button type="button" class="btn btn-accent btn-sm" data-feed-new={current.id} disabled={!ready || full}><Icon name="ph:plus-bold" width="14" height="14" />{dt('New feed')}</button>}
        </div>
      )}
    </header>

    <div class="fd-flash" data-flash hidden role="status"></div>
    {!ready && <div class="fd-note fd-note-warn"><Icon name="ph:warning-fill" width="15" height="15" />{dt('This arrives with the next Petto update.')}</div>}
    {ready && full && !premium && current && <div class="fd-note"><Icon name="ph:crown-fill" width="15" height="15" /><span>{dt('You follow the {count} {name} accounts a free server can. Premium servers can follow up to {premium} of each platform.', { count: String(limit), name: current.name, premium: String(premiumLimit) })} <a href="/premium">{dt('See Premium')}</a></span></div>}

    <DashStatTiles tiles={tiles} />

    {!current && (
      <section class="sx-panel fd-picker" aria-labelledby="fd-pick-title">
        <div class="sx-panel-head">
          <span class="sx-panel-icon"><Icon name="ph:squares-four-fill" width="17" height="17" /></span>
          <h2 id="fd-pick-title">{dt('Platforms')}</h2>
        </div>
        <p class="sx-hint">{dt('Pick a platform to see its accounts or to follow a new one.')}</p>
        <nav class="fd-plats dgl-stagger" aria-label={dt('Platforms')}>
          {FEED_PLATFORMS.filter((p) => !p.hidden).map((p) => {
            const count = countOf(p.id);
            return p.soon
              ? <span class="fd-plat fd-plat-soon" style={`--fd-c:${p.color};--fd-ink:${p.ink}`}><span class="fd-logo"><Icon name={p.icon} width="16" height="16" /></span><b>{p.name}</b><em class="fd-plat-n">{dt('Coming soon')}</em></span>
              : <a class="fd-plat" href={`/dash/guild/${guildId}/feeds?platform=${p.id}`} title={count ? dt('{count} of {limit} followed', { count: String(count), limit: String(limit) }) : dt('Nothing followed yet')} style={`--fd-c:${p.color};--fd-ink:${p.ink}`}>
                <span class="fd-logo"><Icon name={p.icon} width="16" height="16" /></span><b>{p.name}</b>{count > 0 && <em class={`fd-plat-n${count >= limit ? ' fd-plat-n-full' : ''}`}><span>{count}</span><span class="fd-plat-lim">/{limit}</span></em>}
              </a>;
          })}
        </nav>
      </section>
    )}

    {shown.length > 0 && (
      <section class="fd-listbox" aria-labelledby="fd-list-title">
        <div class="fd-list-head">
          <div class="fd-list-title"><h2 id="fd-list-title">{current ? dt('Accounts') : dt('Followed accounts')}</h2><span class="sx-tag">{shown.length}</span></div>
          <label class="fd-search"><Icon name="ph:magnifying-glass-bold" width="14" height="14" /><input type="search" data-feed-search placeholder={dt('Search accounts')} aria-label={dt('Search accounts')} autocomplete="off" /></label>
        </div>
        <ul class="fd-list dgl-stagger">
          {shown.map((feed) => {
            const p = platformById(feed.platform);
            const status = statusOf(feed);
            return (
              <li class={`fd-feed fd-feed-${status.key}`} data-feed-row={feed.id} data-search={`${feed.accountName} ${p?.name ?? ''} ${channelName.get(feed.channelId) ?? ''}`.toLowerCase()} style={`--fd-c:${p?.color ?? '#888'};--fd-ink:${p?.ink ?? '#fff'}`}>
                <div class="fd-top">
                  <span class="fd-avatar">{feed.accountAvatar ? <img src={feed.accountAvatar} alt="" loading="lazy" referrerpolicy="no-referrer" data-platform={feed.platform} data-fallback={siteIcon(feed.accountUrl)} /> : p ? <Icon name={p.icon} width="20" height="20" /> : null}</span>
                  <div class="fd-main">
                    <div class="fd-name">{feed.accountUrl ? <a href={feed.accountUrl} target="_blank" rel="noopener noreferrer">{feed.accountName}</a> : <span>{feed.accountName}</span>}{!current && p && <span class="fd-plat-tag"><Icon name={p.icon} width="11" height="11" />{p.name}</span>}</div>
                    <div class="fd-last"><Icon name="ph:clock-counter-clockwise-fill" width="12" height="12" />{feed.lastSentAt ? <span>{dt('Last notice')}: <time datetime={feed.lastSentAt} data-when data-keep>{agoText(dt, feed.lastSentAt, { locale })}</time></span> : dt('Nothing posted yet')}</div>
                  </div>
                  <span class={`fd-status fd-status-${status.key}`}>{status.label}</span>
                </div>
                <div class="fd-meta">
                  <span class="fd-chans"><Icon name="ph:hash-bold" width="11" height="11" />{channelName.get(feed.channelId) ?? dt('deleted channel')}</span>
                  {feed.types.map((type) => <span class="fd-type"><Icon name={typeIcon(type)} width="11" height="11" />{typeLabel(type)}</span>)}
                  {p?.pace && <span class="fd-type"><Icon name="ph:timer-fill" width="11" height="11" />{paceShort(paceOf(feed.accountId))}</span>}
                </div>
                {status.detail && <div class="fd-err" title={status.detail}><Icon name="ph:warning-fill" width="13" height="13" /><span>{status.detail}</span></div>}
                {channelClosed.has(feed.channelId) && <div class="fd-err"><Icon name="ph:warning-fill" width="13" height="13" /><span><strong>#{channelName.get(feed.channelId)}</strong>: {channelClosed.get(feed.channelId)}<span class="fd-err-fix">{dt('Give Petto the permission there, or edit the feed and pick another channel.')}</span></span></div>}
                <div class="fd-actions">
                  <button type="button" class="btn btn-ghost btn-sm" data-feed-test={feed.id} title={dt('Send a test notice')} aria-label={dt('Send a test notice')}><Icon name="ph:paper-plane-tilt-fill" width="13" height="13" />{dt('Test')}</button>
                  <button type="button" class="btn btn-ghost btn-sm" data-feed-edit={feed.id} title={dt('Edit')} aria-label={dt('Edit')}><Icon name="ph:pencil-simple-bold" width="13" height="13" />{dt('Edit')}</button>
                  <button type="button" class="btn btn-ghost btn-sm" data-feed-toggle={feed.id} data-on={feed.enabled ? '1' : ''} title={feed.enabled ? dt('Pause') : dt('Resume')} aria-label={feed.enabled ? dt('Pause') : dt('Resume')}><Icon name={feed.enabled ? 'ph:pause-fill' : 'ph:play-fill'} width="13" height="13" />{feed.enabled ? dt('Pause') : dt('Resume')}</button>
                  <button type="button" class="fd-del" data-feed-delete={feed.id} data-name={feed.accountName} title={dt('Stop following')} aria-label={dt('Stop following')}><Icon name="ph:trash-bold" width="13" height="13" />{dt('Remove')}</button>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )}
    <p class="sx-empty fd-nomatch" data-feed-nomatch hidden><Icon name="ph:magnifying-glass-bold" width="15" height="15" />{dt('No account matches your search.')}</p>

    {shown.length === 0 && ready && (current ? (
      <div class="fd-empty"><span class="fd-logo" style={`--fd-c:${current.color};--fd-ink:${current.ink}`}><Icon name={current.icon} width="24" height="24" /></span><h2>{dt('No {name} account followed yet', { name: current.name })}</h2><p>{dt('Add one and Petto will post its news here as soon as they happen.')}</p><button type="button" class="btn btn-accent btn-sm" data-feed-new={current.id} disabled={full}><Icon name="ph:plus-bold" width="14" height="14" />{dt('New feed')}</button></div>
    ) : (
      <div class="fd-empty"><span class="fd-logo fd-logo-all"><Icon name="ph:bell-ringing-fill" width="24" height="24" /></span><h2>{dt('No account followed yet')}</h2><p>{dt('Pick a platform to follow your first account.')}</p></div>
    ))}

    {current && (
      <section class="sx-panel fd-about" aria-labelledby="fd-about-title">
        <div class="sx-panel-head">
          <span class="sx-panel-icon"><Icon name="ph:info-fill" width="17" height="17" /></span>
          <h2 id="fd-about-title">{dt('What Petto posts')}</h2>
        </div>
        {(current.intro || current.account) && <p class="sx-lead fd-about-text">{current.intro ? dt(current.intro) : dt(current.account!.help)}</p>}
        <div class="fd-kinds">{current.types.map((type) => <span class="fd-kind"><Icon name={typeIcon(type)} width="13" height="13" />{typeLabel(type)}</span>)}</div>
      </section>
    )}

    {!current && (
      <section class="sx-panel fd-locked" aria-label={dt('Locked for now')}>
        <div class="sx-panel-head">
          <span class="sx-panel-icon" style="--c:var(--text-dim)"><Icon name="ph:lock-fill" width="17" height="17" /></span>
          <h2>{dt('Premium, locked for now')}</h2>
          <a class="fd-locked-link" href="/premium">{dt('See Premium')}</a>
        </div>
        <p class="sx-hint">{dt('These services cost money to follow, so they will be Premium only to cover that cost. They unlock when they are ready.')}</p>
        <ul class="fd-locked-list">
          {LOCKED_PLATFORMS.map((p) => (
            <li style={`--fd-c:${p.color};--fd-ink:${p.ink}`}><span class="fd-logo"><Icon name={p.icon} width="16" height="16" /></span><div><b>{p.name}</b><small>{dt(p.reason)}</small></div><Icon name="ph:lock-fill" width="14" height="14" /></li>
          ))}
        </ul>
      </section>
    )}
  </div>

  <DashAcData roles={roles} channels={channels} vars={FEED_VARIABLES.map((variable) => ({ tok: variable.tok, desc: dt(variable.desc) }))} />
  <div hidden data-icons="platform">{FEED_PLATFORMS.map((p) => <span data-icon-id={p.id}><Icon name={p.icon} width="16" height="16" /></span>)}</div>
  <div hidden data-icons="type">{Object.entries(FEED_TYPES).map(([id, type]) => <span data-icon-id={id}><Icon name={type.icon} width="14" height="14" /></span>)}</div>
  <Modal id="fd-modal" title={dt('New feed')} icon="ph:bell-ringing-fill">
    <form class="fd-form" data-feed-form data-no-dirty autocomplete="off" novalidate>
      <p class="fd-sub" data-sub></p>
      <div class="fd-wait" data-auto-wait hidden></div>

      <div class="fd-field" data-step="account">
        <div class="fd-combo" data-combo>
          <div class="fd-search-box">
            <Icon name="ph:magnifying-glass-bold" width="15" height="15" />
            <input id="fd-account" type="text" data-account-input maxlength="200" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="fd-results" aria-label={dt('Search')} />
            <span class="fd-spin" data-spin hidden aria-hidden="true"></span>
          </div>
          <ul class="fd-results" id="fd-results" data-results role="listbox" hidden></ul>
        </div>
        <div class="fd-found" data-found hidden></div>
        <span class="fd-help" data-account-help></span>
      </div>

      <div class="fd-field" data-step="pace" hidden>
        <label for="fd-pace">{dt('How often')}</label>
        <select id="fd-pace" data-pace>{FEED_PACES.map((pace) => <option value={String(pace.minutes)}>{dt(pace.label)}</option>)}</select>
        <span class="fd-help">{dt('Every time Petto posts something new. The shortest is every 5 minutes, so the channel is not flooded.')}</span>
      </div>

      <fieldset class="fd-field fd-set" data-step="kinds" hidden><legend>{dt('Which animals')}</legend>
        <div class="fd-types" data-kinds>{ANIMAL_KINDS.map((kind) => <label class="fd-type-pick"><input type="checkbox" value={kind.id} /><span><Icon name={kind.icon} width="14" height="14" />{dt(kind.label)}</span></label>)}</div>
        <span class="fd-help">{dt('Pick the ones you want, or none to get any of them.')}</span>
      </fieldset>

      <div class="fd-field" data-step="tags" hidden>
        <label for="fd-tags">{dt('Tags')}</label>
        <input id="fd-tags" type="text" data-tags maxlength="60" autocomplete="off" />
        <span class="fd-help">{dt('One to four words in English, like pink, cats aesthetic or anime roses. Add anime to get anime pictures, memes for funny ones (cat memes) and a minus sign to leave a word out (pink flower anime -character).')}</span>
      </div>

      <fieldset class="fd-field fd-set" data-types-box><legend>{dt('What to post')}</legend><div class="fd-types" data-types></div></fieldset>

      <div class="fd-field">
        <label for="fd-channel">{dt('Channel')}</label>
        <select id="fd-channel" data-channel><option value="">{dt('Pick a channel')}</option>{channels.map((channel) => <option value={channel.id}>#{channel.name}</option>)}</select>
        <span class="fd-help fd-chan-note" data-chan-note hidden></span>
      </div>

      <div class="fd-field">
        <label for="fd-message">{dt('Message above the notice')} <small>({dt('optional')})</small></label>
        <textarea id="fd-message" data-message data-ac="vars,emojis,roles" rows="3" maxlength="1500" placeholder={dt('Optional text above the card')}></textarea><SilentMentionHint />
        <div class="fd-chips" data-var-chips>{FEED_VARIABLES.slice(0, 4).map((variable) => <button type="button" class="fd-chip" data-var={variable.tok} title={dt(variable.desc)}>{variable.tok}</button>)}</div>
      </div>

      <div class="fd-field">
        <label for="fd-role">{dt('Ping')}</label>
        <select id="fd-role" data-role-select><option value="">{dt('Add a role to ping')}</option>{roles.map((role) => <option value={role.id}>{role.name}</option>)}</select>
        <div class="fd-roles" data-roles></div>
        <label class="fd-switch"><span>{dt('Also mention @everyone')}</span><input type="checkbox" data-everyone /><i aria-hidden="true"></i></label>
      </div>

      <details class="fd-more">
        <summary>{dt('More options')}</summary>
        <div class="fd-field" data-image-field>
          <label for="fd-image">{dt('Big picture')}</label>
          <select id="fd-image" data-image><option value="">{dt('Automatic')}</option><option value="on">{dt('Always show it')}</option><option value="off">{dt('Never show it')}</option></select>
          <span class="fd-help">{dt('Automatic shows the cover of videos and streams, and leaves it out for Shorts.')}</span>
        </div>
        <div class="fd-field" data-player-field hidden>
          <label class="fd-switch"><span>{dt('Show the video player')}</span><input type="checkbox" data-player /><i aria-hidden="true"></i></label>
          <span class="fd-help">{dt('Posts the link instead of the card, so Discord plays the video right there. Streams keep their card.')}</span>
        </div>
        <label class="fd-switch"><span>{dt('Add a button that opens it')}</span><input type="checkbox" data-button checked /><i aria-hidden="true"></i></label>
        <div class="fd-field"><label for="fd-include">{dt('Only if the title has one of these words')}</label><input id="fd-include" type="text" data-include maxlength="300" placeholder={dt('words, separated by commas')} /></div>
        <div class="fd-field"><label for="fd-exclude">{dt('Skip it if the title has one of these words')}</label><input id="fd-exclude" type="text" data-exclude maxlength="300" placeholder={dt('words, separated by commas')} /></div>
      </details>

      <details class="fd-more fd-prev" data-preview-details>
        <summary>{dt('Preview')}</summary>
        <div class="fd-tabs" data-preview-tabs></div>
        <div class="fd-preview-box" data-preview></div>
        <p class="fd-help">{dt('This is an example. The real notice has the title, picture and link of what was published.')}</p>
      </details>

      <div class="fd-senses" data-senses hidden role="group"></div>
      <div class="fd-wait" data-wait hidden></div>
      <p class="fd-error" data-error hidden role="alert"></p>
      <div class="fd-foot">
        <button type="button" class="btn btn-ghost btn-sm" data-modal-close>{dt('Cancel')}</button>
        <button type="submit" class="btn btn-accent btn-sm" data-submit>{dt('Follow this account')}</button>
      </div>
    </form>
  </Modal>
</DashGuildLayout>

<script>
  import { renderV2Message, defaultContext } from '../utils/discordPreview';

  type Feed = {
    id: number; platform: string; accountId: string; accountName: string; accountAvatar: string | null; accountUrl: string | null; channelId: string; types: string[];
    message: string; pingRoles: string[]; pingEveryone: boolean; options: { image?: boolean; button?: boolean; player?: boolean }; filters: { include: string[]; exclude: string[] };
  };
  type Account = { id: string; name: string; avatar: string | null; url: string | null };
  type Result = { value: string; name: string; avatar: string | null; url: string | null; detail: string };
  // A word with several meanings (the bot answers 409 `ambiguous`): each choice is sent again as the account (or `every`) of the feed.
  type Choice = { key: string; label: string; account: string };
  const choicesOf = (data: any): Choice[] => (data?.error === 'ambiguous' && Array.isArray(data.choices) ? data.choices : [])
    .filter((choice: any) => choice && typeof choice.account === 'string' && choice.account.trim())
    .map((choice: any) => ({ key: String(choice.key ?? ''), label: String(choice.label || choice.account), account: String(choice.account) }));

  function initFeeds() {
    const root = document.querySelector<HTMLElement>('[data-feeds]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    const config = JSON.parse(root.dataset.config ?? '{}');
    const text = config.text as Record<string, string>;
    const api = `/dash/guild/${config.guildId}/feeds-api`;
    const $ = <T extends HTMLElement>(sel: string, scope: ParentNode = document) => scope.querySelector<T>(sel);
    const modal = () => document.getElementById('fd-modal') as HTMLElement | null;
    const flashBox = $<HTMLElement>('[data-flash]', root)!;
    // The icons of the platforms and of the kinds of notice come drawn with the page (a hidden copy of each one); they are copied where they are needed.
    const icon = (kind: 'platform' | 'type', id: string) => document.querySelector<HTMLElement>(`[data-icons="${kind}"] [data-icon-id="${id}"] svg`)?.cloneNode(true) as SVGElement | undefined;

    // A picture in the list that does not load tries the icon of the site once and then shows the icon of its platform (errors do not bubble, so this listens while they go down).
    root.addEventListener('error', (event) => {
      const img = event.target;
      if (!(img instanceof HTMLImageElement) || !img.closest('.fd-avatar')) return;
      const fallback = img.dataset.fallback;
      if (fallback && img.src !== fallback) { img.src = fallback; return; }
      const svg = icon('platform', img.dataset.platform ?? '');
      if (svg) { svg.setAttribute('width', '20'); svg.setAttribute('height', '20'); img.replaceWith(svg); } else img.remove();
    }, true);

    // Every call goes through the shared "waiting for Petto" state (scripts/bot-wait.js, in the dashboard layout): a skeleton and one line of status while
    // it is out, automatic retries for a few seconds when the bot is away, and the error with Try again when it still is. `wait` says where it is shown.
    type Wait = { host?: HTMLElement; skeleton?: string; ui?: BotWaitUi; again?: () => void };
    type BotWaitUi = { status(words: string): void; clear(): void; fail(again?: () => void): void };
    const botWait = () => (window as unknown as { __dglBotWait: { request: (url: string, payload: unknown, o: Record<string, unknown>) => Promise<any> & { cancel(): void }; ui: (host: HTMLElement, o: Record<string, unknown>) => BotWaitUi } }).__dglBotWait;
    const waitUi = (host: HTMLElement, skeleton: string) => botWait().ui(host, { skeleton, hold: root });
    const call = (action: string, body: Record<string, unknown> = {}, wait: Wait = {}) => {
      const platform = ['resolve', 'search', 'create'].includes(action) ? config.platforms[String(body.platform ?? '')]?.name : undefined; // the platform Petto asks
      const pending = botWait().request(api, { action, ...body }, {
        ...wait, hold: root, service: platform, idempotent: ['resolve', 'search', 'preview'].includes(action), limit: action === 'create' || action === 'test' ? 30_000 : 14_000,
      });
      const answer = pending.then((r: any) => ({ ok: Boolean(r.ok && r.data?.ok), data: r.data, message: r.message || '', unreachable: Boolean(r.unreachable) })) as Promise<{ ok: boolean; data: any; message: string; unreachable: boolean }> & { cancel(): void };
      answer.cancel = () => pending.cancel();
      return answer;
    };
    // The bot writes its answers for Discord (**bold**, `code`, commands to type): here they are shown as plain words.
    const plain = (message: string) => message.replace(/\s*(Pru[eé]balo|Try it|Teste)[^.]*`[^`]*`\.?/i, '').replace(/\s*\(feed `#\d+`\)/i, '').replace(/[*`]/g, '').trim();
    const flash = (message: string, ok: boolean) => {
      flashBox.hidden = false;
      flashBox.className = `fd-flash ${ok ? 'fd-flash-ok' : 'fd-flash-err'}`;
      flashBox.textContent = plain(message);
      flashBox.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    };

    // The list is read again and swapped in place (no page reload, so nothing blinks); the page is reloaded only if that fails.
    const refresh = async (message = '') => {
      try {
        if (message) sessionStorage.setItem('fd-flash', message);
        const res = await fetch(location.href, { headers: { Accept: 'text/html' }, credentials: 'same-origin' });
        const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
        const next = doc.querySelector<HTMLElement>('[data-feeds]');
        if (!res.ok || !next) throw new Error('refresh');
        root.replaceWith(next);
        initFeeds();
      } catch { location.reload(); }
    };

    // The exact date, in the viewer's own time zone, is the tooltip of the short "3h ago" the page was drawn with.
    root.querySelectorAll<HTMLTimeElement>('time[data-when]').forEach((el) => {
      const date = new Date(el.dateTime);
      if (!Number.isNaN(date.getTime())) el.title = date.toLocaleString(document.documentElement.lang || undefined, { dateStyle: 'medium', timeStyle: 'short' });
    });

    // Search of the page: filters the rows by account, platform or channel.
    const rows = [...root.querySelectorAll<HTMLElement>('[data-feed-row]')];
    $<HTMLInputElement>('[data-feed-search]', root)?.addEventListener('input', (event) => {
      const query = (event.target as HTMLInputElement).value.trim().toLowerCase();
      let any = false;
      rows.forEach((row) => { const match = !query || (row.dataset.search ?? '').includes(query); row.hidden = !match; if (match) any = true; });
      const none = $<HTMLElement>('[data-feed-nomatch]', root);
      if (none) none.hidden = any;
    });

    // ---- The window to follow an account or to change a feed ----
    // The page is swapped in again after each save, while a window can already be open for the next account: the state is kept across swaps, so the window
    // carries on with the platform it was opened for (a new empty state made the search ask for a platform without a name).
    const shared = window as unknown as { __fdState?: { platform: string; feedId: number; input: string; account: Account | null; type: string; roles: string[]; timer: number; run: number; searchTimer: number; searchRun: number; results: Result[]; active: number; cancelSearch?: () => void } };
    const state = (shared.__fdState ??= { platform: '', feedId: 0, input: '', account: null as Account | null, type: '', roles: [] as string[], timer: 0, run: 0, searchTimer: 0, searchRun: 0, results: [] as Result[], active: -1 });
    // A window left in <body> by the page before is the one in use: the copy that came with the new page goes.
    const copies = [...document.querySelectorAll<HTMLElement>('#fd-modal')];
    const placed = copies.find((m) => m.parentElement === document.body);
    if (placed) copies.forEach((m) => { if (m !== placed) m.remove(); });

    const form = () => $<HTMLFormElement>('[data-feed-form]', modal() ?? document)!;
    const field = <T extends HTMLElement>(sel: string) => $<T>(sel, form())!;
    const words = (value: string) => value.split(',').map((word) => word.trim()).filter(Boolean).slice(0, 10);
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className = '', content?: string) => { const node = document.createElement(tag); if (className) node.className = className; if (content !== undefined) node.textContent = content; return node; };
    // The picture of an account; one that has none (or does not load) shows the icon of its platform.
    const picture = (url: string | null, platformId: string) => {
      const badge = () => { const node = el('span', 'fd-pic fd-pic-ico'); const svg = icon('platform', platformId); if (svg) node.append(svg); return node; };
      if (!url) return badge();
      const img = el('img', 'fd-pic');
      img.alt = ''; img.loading = 'lazy'; img.referrerPolicy = 'no-referrer'; img.src = url;
      img.addEventListener('error', () => img.replaceWith(badge()), { once: true });
      return img;
    };

    const fillRoles = () => {
      const box = field<HTMLElement>('[data-roles]');
      box.replaceChildren(...state.roles.map((id) => {
        const chip = el('button', 'fd-chip fd-chip-role');
        chip.type = 'button'; chip.dataset.removeRole = id; chip.title = text.removeRole;
        chip.textContent = `@${(config.roles as [string, string][]).find(([rid]) => rid === id)?.[1] ?? id}  ×`;
        return chip;
      }));
    };
    const checkedTypes = () => [...form().querySelectorAll<HTMLInputElement>('[data-types] input:checked')].map((input) => input.value);
    const showError = (message: string) => { const box = field<HTMLElement>('[data-error]'); box.hidden = !message; box.textContent = message; };
    const hideSenses = () => { const box = field<HTMLElement>('[data-senses]'); box.hidden = true; box.replaceChildren(); };
    // The question of a word with several meanings: a button for each one; the one pressed saves the feed with it.
    const showSenses = (word: string, choices: Choice[]) => {
      const box = field<HTMLElement>('[data-senses]');
      const buttons = el('div', 'fd-senses-list');
      buttons.append(...choices.map((choice) => {
        const button = el('button', 'btn btn-ghost btn-sm fd-sense', choice.label);
        button.type = 'button'; button.dataset.sense = choice.account;
        return button;
      }));
      box.replaceChildren(el('b', '', text.whichMeaning.replace('{word}', word)), buttons, el('small', 'fd-help', text.meaningHelp));
      box.hidden = false;
      box.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    };

    // The account chosen: a card with its picture, in place of the search.
    const showFound = () => {
      const found = field<HTMLElement>('[data-found]');
      const combo = field<HTMLElement>('[data-combo]');
      found.hidden = !state.account;
      combo.hidden = Boolean(state.account);
      if (!state.account) { found.replaceChildren(); return; }
      const names = el('div', 'fd-found-text');
      names.append(el('b', '', state.account.name));
      if (state.account.url) names.append(el('small', '', state.account.url.replace(/^https?:\/\/(www\.)?/, '').slice(0, 60)));
      const change = el('button', 'btn btn-ghost btn-sm', text.change);
      change.type = 'button'; change.dataset.changeAccount = '1';
      change.hidden = Boolean(state.feedId); // an account cannot change in a feed that already exists
      found.replaceChildren(picture(state.account.avatar, state.platform), names, change);
    };

    // ---- The search while typing ----
    const resultsBox = () => field<HTMLUListElement>('[data-results]');
    const spin = (on: boolean) => { field<HTMLElement>('[data-spin]').hidden = !on; };
    const hideResults = () => { const box = resultsBox(); box.hidden = true; box.replaceChildren(); state.results = []; state.active = -1; field<HTMLInputElement>('[data-account-input]').setAttribute('aria-expanded', 'false'); };
    const showRows = (rowsList: HTMLElement[]) => { const box = resultsBox(); box.replaceChildren(...rowsList); box.hidden = false; field<HTMLInputElement>('[data-account-input]').setAttribute('aria-expanded', 'true'); };
    // What is still on its way is not wanted any more (a newer search, a pick, the window opened for another account).
    const dropSearch = () => { state.searchRun += 1; state.cancelSearch?.(); state.cancelSearch = undefined; };
    const waitRow = () => { const row = el('li', 'fd-res-wait'); showRows([row]); return row; };
    const note = (message: string, bad = false) => showRows([el('li', `fd-res-note${bad ? ' fd-res-bad' : ''}`, message)]);
    const markActive = () => resultsBox().querySelectorAll<HTMLElement>('[data-pick]').forEach((row, i) => row.classList.toggle('fd-res-on', i === state.active));

    const renderResults = (list: Result[]) => {
      state.results = list; state.active = list.length ? 0 : -1;
      if (!list.length) { note(text.noResults); return; }
      showRows(list.map((result, i) => {
        const row = el('li', 'fd-res');
        row.setAttribute('role', 'option'); row.dataset.pick = String(i);
        const names = el('div', 'fd-res-text');
        names.append(el('b', '', result.name));
        if (result.detail) names.append(el('small', '', result.detail));
        row.append(picture(result.avatar, state.platform), names);
        return row;
      }));
      markActive();
    };

    async function runSearch(raw: string) {
      dropSearch();
      const run = state.searchRun;
      const query = raw.trim();
      if (query.length < 2) { spin(false); hideResults(); return; }
      spin(true);
      // A link (or an @name) points at one account: it is looked up as it is.
      if (!state.platform) { spin(false); hideResults(); return; }
      const link = /^https?:\/\//i.test(query) || (state.platform === 'youtube' && query.startsWith('@'));
      // The list is replaced by the wait (rows for a search, the card of the account for a link) until the answer comes.
      const pending = link
        ? call('resolve', { platform: state.platform, account: query }, { host: waitRow(), skeleton: 'card', again: () => void runSearch(raw) })
        : call('search', { platform: state.platform, query }, { host: waitRow(), skeleton: 'rows', again: () => void runSearch(raw) });
      state.cancelSearch = pending.cancel;
      const answer = await pending;
      if (run !== state.searchRun) return; // a newer search took its place
      spin(false);
      if (answer.unreachable) return; // Petto is not answering: the list says so, with Try again
      const senses = choicesOf(answer.data);
      if (!answer.ok && senses.length) { renderResults(senses.map((choice) => ({ value: choice.account, name: choice.label, avatar: null, url: null, detail: choice.account }))); return; }
      if (!answer.ok) { note(answer.message || text.failed, true); return; }
      renderResults(link ? [{ value: query, name: answer.data.account.name, avatar: answer.data.account.avatar, url: answer.data.account.url, detail: '' }] : (answer.data.results as Result[]));
    }

    const pick = (index: number) => {
      const result = state.results[index];
      if (!result) return;
      state.account = { id: result.value, name: result.name, avatar: result.avatar, url: result.url };
      state.input = result.value;
      dropSearch(); // what is still on its way is not wanted any more
      spin(false); hideResults(); showError(''); showFound(); schedule();
    };

    // ---- The preview (a section that opens on demand, so typing is never slowed down by it) ----
    const previewOpen = () => Boolean(field<HTMLDetailsElement>('[data-preview-details]').open);
    const renderTabs = () => {
      const platform = config.platforms[state.platform];
      const box = field<HTMLElement>('[data-preview-tabs]');
      const chosen = checkedTypes();
      const list: string[] = (platform.types as string[]).filter((type) => chosen.includes(type));
      if (!list.includes(state.type)) state.type = list[0] ?? platform.defaultTypes[0];
      box.hidden = list.length < 2;
      box.replaceChildren(...list.map((type) => {
        const tab = el('button', `fd-tab${type === state.type ? ' fd-tab-on' : ''}`, config.types[type]);
        tab.type = 'button'; tab.dataset.previewType = type;
        return tab;
      }));
    };

    // Under the channel: whether Petto can post in the one picked (the page knows it from the saved copy of the server; unknown counts as yes).
    const showChannelNote = () => {
      const note = field<HTMLElement>('[data-chan-note]');
      const id = field<HTMLSelectElement>('[data-channel]').value;
      const found = (config.channels as [string, string, boolean, string][]).find(([channelId]) => channelId === id);
      note.hidden = !found;
      if (!found) { note.textContent = ''; return; }
      // Blocked: the reason Petto cannot post there, and what to do about it, one under the other.
      note.textContent = found[2] ? text.canPostHere.replace('{channel}', found[1]) : `${found[3]}\n${text.cannotPostHere}`;
      note.dataset.state = found[2] ? 'ok' : 'blocked';
    };
    const previewAccounts = new Map<string, Account | null>(); // `platform|pace and tags` -> the account the bot gave for it
    const drawPreview = async () => {
      if (!previewOpen()) return;
      const run = ++state.run;
      const box = field<HTMLElement>('[data-preview]');
      // Nothing drawn yet (or the last try failed): the skeleton of the card and the status of the wait while it comes, so the box is never empty. A card
      // that is already there is redrawn without it (it stays until the new one is ready).
      const wait = box.dataset.html ? null : waitUi(box, 'card');
      const asking = wait ? { ui: wait, again: () => { box.dataset.html = ''; void drawPreview(); } } : {};
      const image = field<HTMLSelectElement>('[data-image]').value;
      // An auto feed (pictures, animals) has no account to choose: the bot reads the pace and the tags, and gives the account that is then used to draw a real picture, not a made-up one.
      let account: Account | null = state.account;
      const chosen = config.platforms[state.platform];
      if (chosen?.pace) {
        const extra = chosen.extra === 'kinds' ? [...field<HTMLElement>('[data-kinds]').querySelectorAll<HTMLInputElement>('input:checked')].map((box) => box.value).join(' ')
          : chosen.extra === 'tags' ? field<HTMLInputElement>('[data-tags]').value.trim() : '';
        const asked = [state.input, extra].filter(Boolean).join(' ');
        if (!asked || (chosen.extra === 'tags' && !extra)) account = null;
        else {
          const known = previewAccounts.get(`${state.platform}|${asked}`);
          let found: Account | null;
          if (known !== undefined) found = known;
          else {
            const looked = await call('resolve', { platform: state.platform, account: asked }, asking);
            if (looked.unreachable && wait) return; // Petto is not answering: the box says so, with Try again
            found = (looked.data?.account as Account | undefined) ?? null;
          }
          if (known === undefined) { if (previewAccounts.size > 40) previewAccounts.clear(); previewAccounts.set(`${state.platform}|${asked}`, found); }
          account = found ?? state.account;
        }
        if (run !== state.run) { wait?.clear(); return; }
      }
      const answer = await call('preview', {
        platform: state.platform, type: state.type, message: field<HTMLTextAreaElement>('[data-message]').value, ping_roles: state.roles, ping_everyone: field<HTMLInputElement>('[data-everyone]').checked,
        account: account ? { id: account.id, name: account.name, avatar: account.avatar, url: account.url } : '', options: { ...(image ? { image: image === 'on' } : {}), button: field<HTMLInputElement>('[data-button]').checked, ...(state.platform === 'youtube' && field<HTMLInputElement>('[data-player]').checked ? { player: true } : {}) },
      }, asking);
      if (answer.unreachable && wait) return; // the box says Petto is not answering, with Try again
      if (run !== state.run) { wait?.clear(); return; }
      wait?.clear();
      const doc = answer.data?.messages?.[0];
      if (!answer.ok || !doc) {
        const retry = el('button', 'btn btn-ghost btn-sm', text.retry);
        retry.type = 'button';
        retry.addEventListener('click', () => { box.dataset.html = ''; void drawPreview(); });
        box.dataset.html = '';
        box.replaceChildren(el('div', 'fd-prev-wait', text.previewFail), retry);
        return;
      }
      const bot = document.querySelector<HTMLElement>('[data-dp-bot]');
      const tr = (key: string) => ((window as unknown as { cdt?: (k: string) => string }).cdt ? (window as unknown as { cdt: (k: string) => string }).cdt(key) : key);
      let html = renderV2Message({ components: doc }, { ...defaultContext, botName: bot?.dataset.name || defaultContext.botName, botIcon: bot?.dataset.icon || defaultContext.botIcon, t: tr });
      // The renderer does not know the names of the roles: the roles pinged are written in the order of the ping line.
      for (const id of state.roles) html = html.replace('<span class="dp-mention">@role</span>', `<span class="dp-mention">@${((config.roles as [string, string][]).find(([rid]) => rid === id)?.[1] ?? 'role').replace(/[&<>"']/g, '')}</span>`);
      // The same picture again is not written again (writing it would blink its images).
      if (box.dataset.html !== html) { box.dataset.html = html; box.innerHTML = html; }
    };
    const schedule = () => { window.clearTimeout(state.timer); state.timer = window.setTimeout(() => { renderTabs(); void drawPreview(); }, 400); };

    const open = (platformId: string, feed?: Feed) => {
      const platform = config.platforms[platformId];
      const box = modal();
      if (!platform || !box) return;
      Object.assign(state, { platform: platformId, feedId: feed?.id ?? 0, input: '', account: feed ? { id: feed.accountId, name: feed.accountName, avatar: feed.accountAvatar, url: feed.accountUrl } : null, roles: feed ? [...feed.pingRoles] : [], type: '', results: [], active: -1 });
      dropSearch();
      box.style.setProperty('--fd-c', platform.color);
      box.style.setProperty('--fd-ink', platform.ink);
      const head = box.querySelector('.mdl-head h2')!;
      head.textContent = `${feed ? text.editFeed : text.newFeed} · ${platform.name}`;
      field<HTMLElement>('[data-submit]').textContent = feed ? text.save : text.create;
      field<HTMLElement>('[data-sub]').textContent = platform.account?.help ?? platform.intro ?? '';
      field<HTMLTextAreaElement>('[data-message]').placeholder = platform.announces ? text.messageExample : text.messageOptional;
      const input = field<HTMLInputElement>('[data-account-input]');
      input.value = '';
      input.placeholder = platform.account ? text.searchName.replace('{name}', platform.account.label) : '';
      field<HTMLElement>('[data-account-help]').textContent = '';
      field<HTMLElement>('[data-step="account"]').hidden = !platform.account;
      field<HTMLElement>('[data-step="pace"]').hidden = !platform.pace;
      if (platform.pace) {
        const minutes = feed ? (/^every:(\d+)(?::[a-z0-9+_-]*)?$/.exec(feed.accountId)?.[1] ?? '1440') : '1440';
        const pick = field<HTMLSelectElement>('[data-pace]');
        // A pace the list does not have (set with a command) is added so it is not lost when the feed is saved.
        if (![...pick.options].some((option) => option.value === minutes)) pick.append(new Option(text.everyN.replace('{n}', minutes), minutes));
        pick.value = minutes; state.input = minutes;
        state.account = { id: '', name: platform.name, avatar: null, url: null };
      }
      // What an auto feed asks for besides the pace: which animals, or a few tags (written after the pace in the account of the feed).
      const written = feed ? (/^every:\d+:([a-z0-9+_-]+)$/.exec(feed.accountId)?.[1] ?? '').split('+').filter(Boolean) : [];
      field<HTMLElement>('[data-step="kinds"]').hidden = platform.extra !== 'kinds';
      field<HTMLElement>('[data-step="tags"]').hidden = platform.extra !== 'tags';
      field<HTMLElement>('[data-kinds]').querySelectorAll<HTMLInputElement>('input').forEach((box) => { box.checked = platform.extra === 'kinds' && written.includes(box.value); });
      const tagsInput = field<HTMLInputElement>('[data-tags]');
      tagsInput.value = platform.extra === 'tags' ? written.join(' ') : '';
      tagsInput.placeholder = text.tagsPlaceholder;
      field<HTMLElement>('[data-types-box]').hidden = (platform.types as string[]).length < 2;
      field<HTMLElement>('[data-types]').replaceChildren(...(platform.types as string[]).map((type) => {
        const label = el('label', 'fd-type-pick');
        const check = el('input');
        check.type = 'checkbox'; check.value = type; check.checked = feed ? feed.types.includes(type) : (platform.defaultTypes as string[]).includes(type);
        const span = el('span');
        const svg = icon('type', type);
        if (svg) span.append(svg);
        span.append(document.createTextNode(config.types[type]));
        label.append(check, span);
        return label;
      }));
      field<HTMLSelectElement>('[data-channel]').value = feed?.channelId ?? '';
      showChannelNote();
      field<HTMLTextAreaElement>('[data-message]').value = feed?.message ?? '';
      field<HTMLInputElement>('[data-everyone]').checked = feed?.pingEveryone ?? false;
      field<HTMLSelectElement>('[data-image]').value = feed?.options.image === undefined ? '' : feed.options.image ? 'on' : 'off';
      field<HTMLInputElement>('[data-button]').checked = feed?.options.button ?? true;
      field<HTMLInputElement>('[data-player]').checked = feed?.options.player ?? false;
      field<HTMLElement>('[data-player-field]').hidden = platformId !== 'youtube';
      field<HTMLInputElement>('[data-include]').value = (feed?.filters.include ?? []).join(', ');
      field<HTMLInputElement>('[data-exclude]').value = (feed?.filters.exclude ?? []).join(', ');
      field<HTMLSelectElement>('[data-role-select]').value = '';
      field<HTMLDetailsElement>('[data-preview-details]').open = false;
      box.querySelectorAll<HTMLDetailsElement>('.fd-more:not(.fd-prev)').forEach((details) => { details.open = false; });
      field<HTMLElement>('[data-preview]').dataset.html = '';
      showError(''); hideSenses(); spin(false); hideResults(); showFound(); fillRoles(); renderTabs();
      for (const wait of [field<HTMLElement>('[data-wait]'), field<HTMLElement>('[data-auto-wait]')]) { wait.hidden = true; wait.replaceChildren(); }
      field<HTMLButtonElement>('[data-submit]').disabled = false;
      // Opening goes through the common window code (it moves the window to <body> and focuses it).
      const opener = el('button');
      opener.type = 'button'; opener.dataset.modalOpen = 'fd-modal'; opener.hidden = true; document.body.appendChild(opener); opener.click(); opener.remove();
      // A platform with no account to choose (the Pokémon of the day, Wikipedia, Chess.com) is looked up at once.
      if (!platform.account && !platform.pace && !feed) void autoResolve();
    };

    async function autoResolve() {
      const box = field<HTMLElement>('[data-auto-wait]');
      box.hidden = false;
      const platformId = state.platform;
      const answer = await call('resolve', { platform: platformId, account: '' }, { ui: waitUi(box, 'card'), again: () => void autoResolve() });
      if (answer.unreachable) return; // the window says Petto is not answering, with Try again
      if (platformId !== state.platform) return; // the window was opened for another platform meanwhile
      box.hidden = true; box.replaceChildren();
      if (!answer.ok) { showError(answer.message || text.failed); return; }
      state.account = answer.data.account as Account; state.input = '';
      schedule();
    }

    const closeWindow = () => { const closer = el('button'); closer.type = 'button'; closer.dataset.modalClose = '1'; closer.hidden = true; modal()?.appendChild(closer); closer.click(); closer.remove(); };

    async function save(event: Event | null, forced = '') {
      event?.preventDefault();
      const types = checkedTypes();
      const channelId = field<HTMLSelectElement>('[data-channel]').value;
      if (!state.account) { showError(text.pickAccount); return; }
      if (!types.length) { showError(text.pickType); return; }
      if (!channelId) { showError(text.pickChannel); return; }
      // The pace and, after it, which animals or which tags: that is what the bot reads as the account of an auto feed.
      const chosen = config.platforms[state.platform];
      const extra = chosen.extra === 'kinds' ? [...field<HTMLElement>('[data-kinds]').querySelectorAll<HTMLInputElement>('input:checked')].map((box) => box.value).join(' ')
        : chosen.extra === 'tags' ? field<HTMLInputElement>('[data-tags]').value.trim() : '';
      if (chosen.extra === 'tags' && !extra) { showError(text.pickTags); return; }
      // A meaning picked for a word with several (`forced`) is what the bot is sent, as it gave it.
      const paceText = forced || [state.input, extra].filter(Boolean).join(' ');
      const image = field<HTMLSelectElement>('[data-image]').value;
      const body = {
        channel_id: channelId, types, message: field<HTMLTextAreaElement>('[data-message]').value, ping_roles: state.roles, ping_everyone: field<HTMLInputElement>('[data-everyone]').checked,
        options: { ...(image ? { image: image === 'on' } : {}), button: field<HTMLInputElement>('[data-button]').checked, ...(state.platform === 'youtube' && field<HTMLInputElement>('[data-player]').checked ? { player: true } : {}) },
        filters: { include: words(field<HTMLInputElement>('[data-include]').value), exclude: words(field<HTMLInputElement>('[data-exclude]').value) },
      };
      const submit = field<HTMLButtonElement>('[data-submit]');
      submit.disabled = true; submit.classList.add('fd-saving'); const label = submit.textContent; submit.textContent = text.saving; showError(''); hideSenses();
      // The wait under the form: the shape of the feed that is coming and what Petto is doing. Following (create) is asked again only when the bot was never reached.
      const waitBox = field<HTMLElement>('[data-wait]');
      waitBox.hidden = false;
      const wait = { ui: waitUi(waitBox, state.feedId ? 'lines' : 'card'), again: () => void save(null, forced) };
      const answer = state.feedId
        ? await call('update', { id: state.feedId, ...body, ...(config.platforms[state.platform].pace ? { every: paceText } : {}) }, wait)
        : await call('create', { platform: state.platform, account: config.platforms[state.platform].pace ? paceText : forced || state.input || state.account.url || state.account.id, ...body }, wait);
      if (answer.unreachable) { submit.disabled = false; submit.classList.remove('fd-saving'); submit.textContent = label; return; } // Petto is not answering: the wait box says so, with Try again
      waitBox.hidden = true; waitBox.replaceChildren();
      if (!answer.ok) {
        submit.disabled = false; submit.classList.remove('fd-saving'); submit.textContent = label;
        const senses = choicesOf(answer.data);
        if (senses.length) { showSenses(String(answer.data?.word ?? ''), senses); return; }
        showError(plain(answer.message) || text.failed);
        return;
      }
      const channel = (config.channels as [string, string][]).find(([id]) => id === channelId)?.[1] ?? '';
      const done = state.feedId ? text.updated.replace('{name}', state.account.name) : text.followed.replace('{name}', state.account.name).replace('{platform}', config.platforms[state.platform].name).replace('{channel}', `#${channel}`);
      closeWindow();
      submit.disabled = false; submit.classList.remove('fd-saving'); submit.textContent = label;
      await refresh(done);
    }

    // The window lives in <body> once opened: its events are caught on the document. A page swapped in again binds again, so the listeners
    // of the page before are taken off first (otherwise every click would be handled twice).
    const w = window as unknown as { __fdOff?: (() => void)[] };
    w.__fdOff?.forEach((off) => off());
    w.__fdOff = [];
    const on = <K extends keyof DocumentEventMap>(type: K, fn: (event: DocumentEventMap[K]) => void, capture = false) => { document.addEventListener(type, fn, capture); w.__fdOff!.push(() => document.removeEventListener(type, fn, capture)); };
    on('submit', (event) => { if ((event.target as HTMLElement | null)?.matches('[data-feed-form]')) void save(event); });
    on('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;
      const sense = target.closest<HTMLElement>('[data-sense]');
      if (sense && sense.closest('[data-feed-form]')) {
        const account = sense.dataset.sense ?? '';
        // The words of the feed show the meaning picked (`rose-flower` for the flower), so saving again keeps it.
        const tags = field<HTMLInputElement>('[data-tags]');
        if (config.platforms[state.platform]?.extra === 'tags') tags.value = account.split(/\s+/).filter((word) => !/^(?:every:)?\d{1,4}\s*(?:m|min|mins|minutes?|h|hrs?|hours?|d|days?)?$/i.test(word)).join(' ');
        void save(null, account);
        return;
      }
      const picked = target.closest<HTMLElement>('[data-pick]');
      if (picked) { pick(Number(picked.dataset.pick)); return; }
      if (target.closest('[data-change-account]')) { state.account = null; showFound(); const input = field<HTMLInputElement>('[data-account-input]'); input.value = ''; hideResults(); schedule(); input.focus(); return; }
      if (!target.closest('[data-combo]')) { const box = $<HTMLElement>('[data-results]', modal() ?? document); if (box && !box.hidden && target.closest('#fd-modal')) hideResults(); }
      const variable = target.closest<HTMLElement>('[data-var]');
      if (variable) {
        const area = field<HTMLTextAreaElement>('[data-message]');
        const at = area.selectionStart ?? area.value.length;
        area.value = `${area.value.slice(0, at)}${variable.dataset.var}${area.value.slice(area.selectionEnd ?? at)}`;
        area.focus(); area.dispatchEvent(new Event('input', { bubbles: true }));
        return;
      }
      const removeRole = target.closest<HTMLElement>('[data-remove-role]');
      if (removeRole) { state.roles = state.roles.filter((id) => id !== removeRole.dataset.removeRole); fillRoles(); schedule(); return; }
      const tab = target.closest<HTMLElement>('[data-preview-type]');
      if (tab) { state.type = tab.dataset.previewType ?? state.type; renderTabs(); void drawPreview(); }
    });
    on('keydown', (event) => {
      const input = event.target as HTMLElement | null;
      if (!input?.matches('[data-account-input]')) return;
      const count = state.results.length;
      if (event.key === 'ArrowDown' && count) { event.preventDefault(); state.active = (state.active + 1) % count; markActive(); }
      else if (event.key === 'ArrowUp' && count) { event.preventDefault(); state.active = (state.active - 1 + count) % count; markActive(); }
      else if (event.key === 'Enter') { event.preventDefault(); if (state.active >= 0) pick(state.active); else { window.clearTimeout(state.searchTimer); void runSearch((input as HTMLInputElement).value); } }
      else if (event.key === 'Escape' && !resultsBox().hidden) { event.stopPropagation(); hideResults(); }
    });
    on('change', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target || !target.closest('[data-feed-form]')) return;
      if (target.matches('[data-pace]')) state.input = (target as HTMLSelectElement).value;
      if (target.matches('[data-channel]')) showChannelNote();
      if (target.matches('[data-role-select]')) {
        const id = (target as HTMLSelectElement).value;
        if (id && !state.roles.includes(id) && state.roles.length < 10) { state.roles.push(id); fillRoles(); }
        (target as HTMLSelectElement).value = '';
      }
      schedule();
    });
    on('input', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target || !target.closest('[data-feed-form]')) return;
      if (target.matches('[data-tags]')) hideSenses();
      // Typing in the search looks for accounts (a moment after the last key); every other field only redraws the preview when it is open.
      if (target.matches('[data-account-input]')) {
        window.clearTimeout(state.searchTimer);
        const value = (target as HTMLInputElement).value;
        // A name of YouTube costs the bot a search of a hundred units, so it waits for a whole second without typing (and three letters); a link or an @name is cheap.
        const slow = state.platform === 'youtube' && !/^@|youtube\.com|youtu\.be|^UC[\w-]{22}$/.test(value.trim());
        if (value.trim().length < (slow ? 3 : 2)) { dropSearch(); spin(false); hideResults(); return; }
        spin(true);
        state.searchTimer = window.setTimeout(() => void runSearch(value), slow ? 1000 : 380);
        return;
      }
      schedule();
    });
    // `toggle` does not bubble, so it is heard on the way down.
    on('toggle', (event) => { if ((event.target as HTMLElement | null)?.matches?.('[data-preview-details]') && previewOpen()) { renderTabs(); void drawPreview(); window.setTimeout(() => field<HTMLElement>('[data-preview-details]').scrollIntoView({ block: 'nearest', behavior: 'smooth' }), 60); } }, true);

    // ---- The buttons of the page ----
    root.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement | null;
      const button = target?.closest<HTMLButtonElement>('button');
      if (!button) return;
      if (button.dataset.feedNew) { open(button.dataset.feedNew); return; }
      const feed = (id: string | undefined) => (config.feeds as Record<string, Feed>)[id ?? ''];
      if (button.dataset.feedEdit) { const f = feed(button.dataset.feedEdit); if (f) open(f.platform, f); return; }
      // The action of a row of the list waits in the box at the top of the page (flashBox) and, if Petto does not answer, says so there with Try again.
      const waitInFlash = () => {
        flashBox.hidden = false; flashBox.className = 'fd-flash fd-flash-wait';
        flashBox.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        return { ui: waitUi(flashBox, 'lines'), again: () => { button.dataset.confirmed = '1'; button.click(); } }; // Try again does not ask the question twice
      };
      if (button.dataset.feedTest) {
        button.disabled = true; button.classList.add('dgl-busy');
        const answer = await call('test', { id: Number(button.dataset.feedTest) }, waitInFlash());
        button.disabled = false; button.classList.remove('dgl-busy');
        if (answer.unreachable) return;
        flash(answer.message || (answer.ok ? text.saved : text.failed), answer.ok);
        return;
      }
      if (button.dataset.feedToggle) {
        button.disabled = true; button.classList.add('dgl-busy');
        const answer = await call('update', { id: Number(button.dataset.feedToggle), enabled: !button.dataset.on }, waitInFlash());
        if (answer.ok) { await refresh(button.dataset.on ? text.paused : text.resumed); return; }
        button.disabled = false; button.classList.remove('dgl-busy');
        if (!answer.unreachable) flash(answer.message || text.failed, false);
        return;
      }
      if (button.dataset.feedDelete) {
        const asked = button.dataset.confirmed === '1'; delete button.dataset.confirmed;
        if (!asked && !(await (window as unknown as { dglConfirm?: (t: string, o?: object) => Promise<boolean> }).dglConfirm?.(text.deleteAsk.replace('{name}', button.dataset.name ?? ''), { confirm: button.getAttribute('aria-label') || button.textContent?.trim() || undefined }))) return;
        button.disabled = true; button.classList.add('dgl-busy');
        const answer = await call('delete', { id: Number(button.dataset.feedDelete) }, waitInFlash());
        if (answer.ok) { await refresh(text.removed.replace('{name}', button.dataset.name ?? '')); return; }
        button.disabled = false; button.classList.remove('dgl-busy');
        if (!answer.unreachable) flash(answer.message || text.failed, false);
      }
    });

    try {
      const saved = sessionStorage.getItem('fd-flash');
      if (saved) { sessionStorage.removeItem('fd-flash'); flash(saved, true); }
    } catch { /* storage can be off */ }
  }
  try { initFeeds(); } catch (error) { console.error(error); }
  if (!(window as unknown as { __fdObserver?: boolean }).__fdObserver) {
    (window as unknown as { __fdObserver?: boolean }).__fdObserver = true;
    new MutationObserver(() => { if (document.querySelector('[data-feeds]:not([data-bound])')) { try { initFeeds(); } catch (error) { console.error(error); } } }).observe(document.body, { childList: true, subtree: true });
  }
</script>

<style is:global>
  .fd { --fd-c: var(--accent); display: block; }
  .fd[hidden], .fd [hidden] { display: none !important; }
  .fd-head { display: flex; align-items: center; justify-content: space-between; gap: 12px 16px; flex-wrap: wrap; margin-bottom: 16px; }
  .fd-title { display: flex; align-items: center; gap: 12px; min-width: 0; flex: 1 1 320px; }
  .fd-title > div { min-width: 0; }
  .fd-title h1 { margin: 0 0 4px; font-size: 24px; overflow-wrap: anywhere; }
  .fd-lead { margin: 0; font-size: 13.5px; line-height: 1.5; color: var(--text-muted); max-width: 70ch; }
  .fd-logo { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; flex: none; color: var(--fd-ink, #fff); background: var(--fd-c, var(--accent)); }
  .fd-logo-all { background: var(--accent-soft); color: var(--accent); }
  .fd-head-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .fd-head-actions .btn, .fd-actions .btn, .fd-empty .btn { display: inline-flex; align-items: center; gap: 6px; }
  .fd-count { display: inline-flex; align-items: center; font: 600 12px var(--sans); color: var(--text-dim); border-radius: 999px; padding: 5px 12px; background: color-mix(in srgb, var(--text) 7%, transparent); font-variant-numeric: tabular-nums; }
  .fd-count-full { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); }
  .fd-note { display: flex; align-items: flex-start; gap: 8px; font-size: 13.5px; color: var(--text-muted); border: 1px solid var(--border); border-radius: 10px; background: var(--card); padding: 10px 14px; margin-bottom: 14px; overflow-wrap: anywhere; }
  .fd-note svg { flex: none; margin-top: 2px; }
  .fd-note a { color: var(--accent); }
  .fd-note-warn { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 12%, transparent); border-color: var(--yellow); }
  .fd-flash { display: flex; align-items: center; gap: 8px; font-size: 13.5px; border-radius: 10px; padding: 10px 14px; margin-bottom: 14px; border: 1px solid var(--border); overflow-wrap: anywhere; }
  .fd-flash[hidden] { display: none; }
  .fd-flash-ok { color: var(--green); background: var(--green-soft); border-color: var(--green); }
  .fd-flash-err { color: var(--red); background: var(--red-soft); border-color: color-mix(in srgb, var(--red) 55%, transparent); }
  .fd-flash-wait { display: block; background: var(--card); }
  .fd-picker, .fd-about, .fd-locked, .fd-empty, .fd-listbox { margin: 0 0 14px; }
  .fd-picker { gap: 10px; }
  .fd-picker .sx-hint { margin-top: -4px; }

  /* The platforms: a chip for each one, with how many accounts follow it. */
  .fd-plats { display: grid; grid-template-columns: repeat(auto-fill, minmax(168px, 1fr)); gap: 8px; }
  .fd-plat { display: flex; align-items: center; gap: 9px; min-width: 0; border: 1px solid var(--border-soft); border-radius: 12px; background: color-mix(in srgb, var(--text) 3%, var(--card)); padding: 7px 10px 7px 7px; text-decoration: none; color: inherit; transition: border-color var(--m-base, .2s) ease, background-color var(--m-base, .2s) ease; }
  .fd-plat .fd-logo { width: 30px; height: 30px; border-radius: 9px; }
  .fd-plat b { flex: 1; min-width: 0; font-size: 13.5px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fd-plat-n { flex: none; font: 600 11.5px var(--sans); border-radius: 999px; padding: 2px 8px; color: var(--accent); background: var(--accent-soft); font-variant-numeric: tabular-nums; }
  .fd-plat-n-full { color: var(--yellow); background: color-mix(in srgb, var(--yellow) 14%, transparent); }
  a.fd-plat:hover { border-color: color-mix(in srgb, var(--fd-c) 60%, var(--border)); background: var(--card-hover); }
  a.fd-plat:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .fd-plat-soon { opacity: .55; }
  .fd-plat-soon .fd-logo { background: var(--card-hover); color: var(--text-dim); }
  .fd-plat-soon .fd-plat-n { color: var(--text-dim); background: color-mix(in srgb, var(--text) 8%, transparent); }

  /* The accounts followed */
  .fd-listbox { padding: 0; }
  .fd-list-head { display: flex; align-items: center; justify-content: space-between; gap: 10px 14px; flex-wrap: wrap; margin-bottom: 10px; }
  .fd-list-title { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .fd-list-title h2 { margin: 0; font-size: 15.5px; }
  .fd-search { display: flex; align-items: center; gap: 8px; flex: 0 1 300px; min-width: 0; border: 1px solid var(--border); border-radius: 10px; background: var(--card); padding: 0 12px; color: var(--text-dim); transition: border-color .15s ease, box-shadow .15s ease; }
  .fd-search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .fd-search svg { flex: none; }
  .fd-search input { flex: 1; min-width: 0; border: 0; background: none; color: var(--text); font: inherit; font-size: 13.5px; padding: 9px 0; outline: none; }
  .fd-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; align-items: start; }
  .fd-feed { display: flex; flex-direction: column; gap: 10px; min-width: 0; border: 1px solid var(--border); border-left: 3px solid var(--fd-c); border-radius: 14px; background: var(--card); padding: 13px 14px 12px; transition: border-color var(--m-base, .2s) ease, box-shadow var(--m-base, .2s) ease; }
  .fd-feed[hidden] { display: none; }
  .fd-feed:hover { border-color: color-mix(in srgb, var(--fd-c) 40%, var(--border)); border-left-color: var(--fd-c); box-shadow: 0 6px 22px -16px var(--fd-c); }
  .fd-feed-paused .fd-top, .fd-feed-off .fd-top { opacity: .7; }
  .fd-top { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 11px; align-items: center; }
  .fd-avatar { width: 42px; height: 42px; border-radius: 50%; overflow: hidden; display: grid; place-items: center; background: var(--fd-c); color: var(--fd-ink, #fff); flex: none; }
  .fd-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .fd-main { min-width: 0; display: grid; gap: 3px; }
  .fd-name { font-weight: 600; font-size: 14.5px; line-height: 1.3; display: flex; align-items: center; gap: 4px 8px; flex-wrap: wrap; min-width: 0; overflow-wrap: anywhere; }
  .fd-name a { color: inherit; text-decoration: none; min-width: 0; }
  .fd-name a:hover { text-decoration: underline; }
  .fd-plat-tag { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 600; color: var(--fd-ink, #fff); background: var(--fd-c); border-radius: 999px; padding: 1px 8px; }
  .fd-meta { display: flex; flex-wrap: wrap; gap: 5px; }
  .fd-chans, .fd-type { display: inline-flex; align-items: center; gap: 4px; font-size: 11.5px; color: var(--text-muted); background: color-mix(in srgb, var(--text) 6%, transparent); border-radius: 6px; padding: 2px 7px; max-width: 100%; overflow-wrap: anywhere; }
  .fd-chans svg, .fd-type svg { flex: none; }
  .fd-last { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--text-dim); min-width: 0; }
  .fd-last svg { flex: none; }
  .fd-last time { color: var(--text-muted); }
