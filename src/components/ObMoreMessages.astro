---
// "More messages" under the first message of the welcome, the goodbye or the boost: each one is a text (or a saved embed), and Petto picks one of them at random each time,
// never the same twice in a row. The rows are fields of the form of the page (`variant_<kind>_message` and `variant_<kind>_embed`); the buttons add and remove rows (the
// script of this component, bound once for the whole document: the dashboard swaps pages in without a reload).
import { Icon } from 'astro-icon/components';
import { getDashLang, makeT } from '../i18n/dash';
interface Props { kind: 'welcome' | 'leave' | 'boost'; rows: { message: string; template: string }[]; templates: string[]; max: number }
const { kind, rows, templates, max } = Astro.props;
const dt = makeT(getDashLang(Astro));
const words = { remove: dt('Remove this message'), full: dt('There is no room for more messages here.') };
---
<div class="mm" data-mm={kind} data-mm-max={max} data-mm-words={JSON.stringify(words)}>
  <div class="mm-head">
    <b>{dt('More messages')}</b>
    <span class="sx-tag" data-mm-count>{dt('{n} of {m}', { n: rows.length + 1, m: max + 1 })}</span>
  </div>
  <p class="sx-hint">{dt('Add more and Petto picks one of them at random each time, never the same twice in a row.')}</p>
  <input type="hidden" name={`variants_touch_${kind}`} value="0" data-mm-touch />
  <div class="mm-list" data-mm-list>
    {rows.map((row) => (
      <div class="mm-row" data-mm-row>
        <textarea class="dgl-autogrow" rows="2" name={`variant_${kind}_message`} maxlength="300" placeholder={dt('Another message')} aria-label={dt('Another message')}>{row.message}</textarea>
        {templates.length > 0 && (
          <select name={`variant_${kind}_embed`} aria-label={dt('Or use an embed template')}>
            <option value="">{dt('No template, use message text above')}</option>
            {templates.map((name) => <option value={name} selected={name === row.template}>{name}</option>)}
          </select>
        )}
        <button type="button" class="sx-iconbtn" data-mm-remove aria-label={dt('Remove this message')} title={dt('Remove this message')}><Icon name="ph:trash-fill" width="15" height="15" /></button>
      </div>
    ))}
  </div>
  <template data-mm-template>
    <div class="mm-row" data-mm-row>
      <textarea class="dgl-autogrow" rows="2" name={`variant_${kind}_message`} maxlength="300" placeholder={dt('Another message')} aria-label={dt('Another message')}></textarea>
      {templates.length > 0 && (
        <select name={`variant_${kind}_embed`} aria-label={dt('Or use an embed template')}>
          <option value="">{dt('No template, use message text above')}</option>
          {templates.map((name) => <option value={name}>{name}</option>)}
        </select>
      )}
      <button type="button" class="sx-iconbtn" data-mm-remove aria-label={dt('Remove this message')} title={dt('Remove this message')}><Icon name="ph:trash-fill" width="15" height="15" /></button>
    </div>
  </template>
  <button type="button" class="btn btn-ghost btn-sm mm-add" data-mm-add><Icon name="ph:plus-bold" width="12" height="12" />{dt('Add another message')}</button>
</div>

<script is:inline>
  // Adds and removes rows. Bound once for the whole document. A counter field changes with every add or remove, so the page notices that the form has changed (a removed row
  // leaves no field behind to compare).
  if (!window.__mmBound) {
    window.__mmBound = true;
    var mmUpdate = function (box) {
      var rows = box.querySelectorAll('[data-mm-list] [data-mm-row]').length;
      var max = Number(box.getAttribute('data-mm-max')) || 24;
      var count = box.querySelector('[data-mm-count]');
      if (count) count.textContent = count.textContent.replace(/\d+ of \d+/, (rows + 1) + ' of ' + (max + 1));
      var add = box.querySelector('[data-mm-add]');
      if (add) add.disabled = rows >= max;
      var touch = box.querySelector('[data-mm-touch]');
      if (touch) { touch.value = String(Number(touch.value) + 1); touch.dispatchEvent(new Event('input', { bubbles: true })); touch.dispatchEvent(new Event('change', { bubbles: true })); }
    };
    document.addEventListener('click', function (event) {
      var target = event.target && event.target.closest ? event.target : null;
      var add = target && target.closest('[data-mm-add]');
      var remove = target && target.closest('[data-mm-remove]');
      if (!add && !remove) return;
      var box = (add || remove).closest('[data-mm]');
      if (!box) return;
      if (add) {
        if (add.disabled) return;
        var template = box.querySelector('[data-mm-template]');
        var list = box.querySelector('[data-mm-list]');
        if (!template || !list) return;
        var row = template.content.firstElementChild.cloneNode(true);
        list.appendChild(row);
        mmUpdate(box);
        var field = row.querySelector('textarea'); if (field) field.focus({ preventScroll: false });
      } else {
        var row2 = remove.closest('[data-mm-row]'); if (row2) row2.remove();
        mmUpdate(box);
      }
    });
  }
</script>

<style>
  .mm { display: flex; flex-direction: column; gap: 8px; margin-top: 4px; padding: 12px; border: 1px dashed var(--border); border-radius: 12px; background: color-mix(in srgb, var(--text) 2%, transparent); }
  .mm-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .mm-head b { font-size: 13.5px; }
  .mm-list { display: flex; flex-direction: column; gap: 8px; }
  .mm-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: start; animation: m-rise-in var(--m-base, .2s) var(--m-out, ease) backwards; }
  .mm-row textarea, .mm-row select { grid-column: 1; border: 1px solid var(--border); border-radius: 9px; padding: 9px 11px; background: var(--card); color: var(--text); font-family: var(--sans); font-size: 13.5px; width: 100%; box-sizing: border-box; min-width: 0; transition: border-color .25s ease, box-shadow .25s ease; }
  .mm-row textarea { min-height: 64px; resize: none; }
  .mm-row textarea:focus-visible, .mm-row select:focus-visible { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .mm-row .sx-iconbtn { grid-column: 2; grid-row: 1; }
  .mm-add { align-self: flex-start; }
  .mm-add:disabled { opacity: .5; cursor: not-allowed; }
  @media (prefers-reduced-motion: reduce) { .mm-row { animation: none; } }
</style>
