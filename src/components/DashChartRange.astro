---
// The movable window of the statistics charts, once for every page that draws them (the public /stats, the dashboard's statistics, the home).
// src/utils/statsChart.mjs writes the markup (`brush` option): a readout of numbers, the chart, and under it a strip with a small copy of the chart
// and a window. The window is dragged to move it, pulled by its edges to stretch it, clicked on the strip to jump, or moved with the arrow keys;
// the numbers of the days inside count up and down as it goes and the rest of the chart is shaded. The rules are in src/utils/chartRange.ts.
// It also holds the entrance animations of the charts (a line draws and the bars grow) until the chart is on the screen, so they are seen.
---
<style is:global>
  .cr { display: flex; flex-direction: column; gap: 10px; width: 100%; }
  .cr:not([data-cr-on]) .cr-read, .cr:not([data-cr-on]) .cr-nav { display: none; }
  .cr-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 32px; }
  .cr-when { font-size: 13px; font-weight: 600; color: var(--text); font-variant-numeric: tabular-nums; }
  .cr-all { appearance: none; border: 1px solid var(--border); background: transparent; color: var(--text-muted); font: inherit; font-size: 12px; padding: 3px 11px; border-radius: 999px; cursor: pointer; transition: background .15s, color .15s, opacity .15s; }
  .cr-all:hover { background: var(--accent-soft); color: var(--accent); }
  .cr-all:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cr[data-cr-full] .cr-all { opacity: .45; pointer-events: none; }
  .cr-cells { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 0; }
  .cr-cell { min-width: 0; padding: 9px 12px; border: 1px solid var(--border); border-radius: 12px; background: color-mix(in srgb, var(--c) 7%, transparent); }
  .cr-cell dt { margin: 0 0 3px; font-size: 11.5px; color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* The number is always on one line and the share of a change always on the line under it: it never jumps from beside the number to under it while the window moves. */
  .cr-cell dd { margin: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 2px; font-size: 18px; font-weight: 650; line-height: 1.25; color: var(--text); font-variant-numeric: tabular-nums; min-width: 0; max-width: 100%; }
  .cr-cell dd > span { max-width: 100%; white-space: nowrap; }
  .cr-cell dd small { font-size: 12px; line-height: 1.2; font-weight: 600; color: var(--text-dim); white-space: nowrap; min-height: 1.2em; }
  .cr-cell .cr-up { color: var(--green); }
  .cr-cell .cr-down { color: var(--red); }
  @media (max-width: 520px) { .cr-cells { gap: 6px; } .cr-cell { padding: 8px 9px; } .cr-cell dd { font-size: 15px; } .cr-cell dt { font-size: 11px; } }
  /* Soft desaturated veil over the days outside the selected range (Flamey-style): unselected turns muted grey, selected stays vivid. */
  .cr-dim { position: absolute; z-index: 1; pointer-events: none; background: color-mix(in srgb, var(--card) 52%, transparent); backdrop-filter: grayscale(0.92) saturate(0.25); -webkit-backdrop-filter: grayscale(0.92) saturate(0.25); opacity: 0; transition: opacity .3s cubic-bezier(.16, 1, .3, 1); }
  .cr-dim-l { border-right: 1.5px solid color-mix(in srgb, var(--c) 65%, transparent); }
  .cr-dim-r { border-left: 1.5px solid color-mix(in srgb, var(--c) 65%, transparent); }
  .cr[data-cr-on] .cr-dim { opacity: 1; }
  .cr[data-cr-full] .cr-dim { opacity: 0; border-color: transparent; }
  /* The strip: a small copy of the chart and the window over it. */
  .cr-nav { position: relative; height: 46px; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; touch-action: none; user-select: none; -webkit-user-select: none; cursor: pointer; background: color-mix(in srgb, var(--c) 4%, transparent); }
  .cr-spark { position: absolute; inset: 4px 0 0; width: 100%; height: calc(100% - 4px); display: block; overflow: visible; }
  .cr-spark-area { fill: color-mix(in srgb, var(--c) 18%, transparent); stroke: none; }
  .cr-spark-line { fill: none; stroke: var(--c); stroke-width: 1.6; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .cr-spark-bar { fill: color-mix(in srgb, var(--c) 70%, transparent); }
  .cr-shade { position: absolute; top: 0; bottom: 0; background: color-mix(in srgb, var(--bg, #000) 62%, transparent); pointer-events: none; }
  .cr-shade-l { left: 0; width: 0; } .cr-shade-r { right: 0; width: 0; }
  .cr-win { position: absolute; top: 0; bottom: 0; left: 0; width: 100%; box-sizing: border-box; border: 2px solid var(--c); border-radius: 10px; background: color-mix(in srgb, var(--c) 10%, transparent); cursor: grab; transition: box-shadow .15s; }
  .cr-nav[data-cr-drag] .cr-win { cursor: grabbing; box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 22%, transparent); }
  .cr-win:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .cr-h { position: absolute; top: 0; bottom: 0; width: 18px; cursor: ew-resize; }
  .cr-h::after { content: ''; position: absolute; top: 50%; left: 50%; width: 4px; height: 18px; margin: -9px 0 0 -2px; border-radius: 3px; background: var(--c); }
  .cr-h-l { left: -9px; } .cr-h-r { right: -9px; }
  @media (max-width: 520px) { .cr-h { width: 26px; } .cr-h-l { left: -13px; } .cr-h-r { right: -13px; } }
  @media (prefers-reduced-motion: reduce) { .cr-dim, .cr-win { transition: none; } }
</style>

<script>
  import { clampWin, dragWin, edgeAt, indexAt, makeFormat, percentText, rangeStats, signedText, startWin } from '../utils/chartRange';
  import type { FormatSpec, Kind, Layout, Win } from '../utils/chartRange';

  interface BrushData { kind: Kind; layout: Layout; fmt: FormatSpec; locale: string; v: number[]; p: number[]; d: string[]; e: [number, number][]; box: [number, number, number, number] }
  /** A number of the readout: where it is written, how, the value it shows now and the one it goes to. `tol` is how close is close enough to stop. */
  interface Slot { el: HTMLElement; text: (value: number) => string; cur: number | null; to: number | null; tol: number }

  const MIN_DAYS = 3;
  // How fast things settle (milliseconds for the movement to cover about two thirds of what is left): the window glides, the numbers follow a little behind it.
  const WINDOW_TAU = 75;
  const NUMBER_TAU = 120;
  // The shade goes a few pixels past the plot, so the round end of a line and its dots, which stick out of it, are under the shade too.
  const SHADE_BLEED = 6;
  const reduced = () => Boolean(window.matchMedia?.('(prefers-reduced-motion: reduce)').matches);

  class Brush {
    root: HTMLElement;
    nav: HTMLElement;
    win: HTMLElement;
    shadeL: HTMLElement | null;
    shadeR: HTMLElement | null;
    dimL: HTMLElement | null;
    dimR: HTMLElement | null;
    data: BrushData;
    format: (value: number) => string;
    dayFormat: Intl.DateTimeFormat;
    points: { value: number; partial: boolean }[];
    current: Win;
    /** Where the window is drawn (a fraction of the strip, 0-1) and where it is going: the first glides to the second. */
    vis = { l: 0, r: 1 };
    tgt = { l: 0, r: 1 };
    slots = new Map<string, Slot>();
    /** The edges of the plot where each day starts, and the end of the last one: the shade follows the window between them. */
    bounds: number[];
    frame = 0;
    last = 0;

    constructor(root: HTMLElement, data: BrushData) {
      this.root = root;
      this.data = data;
      this.nav = root.querySelector<HTMLElement>('[data-cr-nav]')!;
      this.win = root.querySelector<HTMLElement>('[data-cr-win]')!;
      this.shadeL = root.querySelector<HTMLElement>('.cr-shade-l');
      this.shadeR = root.querySelector<HTMLElement>('.cr-shade-r');
      this.dimL = root.querySelector<HTMLElement>('[data-cr-dim="l"]');
      this.dimR = root.querySelector<HTMLElement>('[data-cr-dim="r"]');
      this.format = makeFormat(data.fmt, data.locale);
      this.dayFormat = new Intl.DateTimeFormat(data.locale, { month: 'short', day: 'numeric', timeZone: 'UTC' });
      this.points = data.v.map((value, i) => ({ value, partial: data.p[i] === 1 }));
      this.bounds = data.e.map((edge) => edge[0]);
      this.bounds.push(data.e[data.e.length - 1][1]);
      const first = clampWin(startWin(this.points.length, MIN_DAYS), this.points.length, MIN_DAYS);
      this.current = first;
      this.makeSlots();
      this.bind();
      // Start on the full period so the whole chart stays vivid until the user drags/selects a sub-range.
      root.dataset.crOn = '';
      this.set({ a: 0, b: this.points.length - 1 }, false);
    }

    get count() { return this.points.length; }

    makeSlots() {
      const add = (role: string, text: (value: number) => string, tol: number) => {
        const el = this.root.querySelector<HTMLElement>(`[data-cr-n="${role}"]`);
        if (el) this.slots.set(role, { el, text, cur: null, to: null, tol });
      };
      const locale = this.data.locale;
      if (this.data.kind === 'level') {
        add('end', this.format, 0.4);
        add('change', (v) => signedText(this.format, v), 0.4);
        add('high', this.format, 0.4);
        add('share', (v) => percentText(v, locale), 0.0004);
      } else {
        add('total', this.format, 0.4);
        add('avg', this.format, 0.4);
        add('versus', (v) => percentText(v, locale), 0.0004);
      }
    }

    bind() {
      let drag: { mode: 'move' | 'left' | 'right'; x: number; start: Win; width: number } | null = null;
      this.nav.addEventListener('pointerdown', (event) => {
        if (event.button > 0) return;
        const box = this.nav.getBoundingClientRect();
        const f = (event.clientX - box.left) / Math.max(1, box.width);
        const target = event.target as HTMLElement;
        const handle = target.closest<HTMLElement>('[data-cr-h]')?.dataset.crH as 'left' | 'right' | undefined;
        let mode: 'move' | 'left' | 'right' = handle ?? 'move';
        let start = this.current;
        // A press outside the window jumps it there (centered on the finger) and keeps dragging it.
        if (!handle && !target.closest('[data-cr-win]')) {
          const middle = indexAt(f, this.count, this.data.layout);
          const half = Math.floor((start.b - start.a) / 2);
          start = clampWin({ a: middle - half, b: middle - half + (start.b - start.a) }, this.count, MIN_DAYS);
          this.set(start, true);
          mode = 'move';
        }
        drag = { mode, x: event.clientX, start, width: box.width };
        this.nav.dataset.crDrag = '';
        // A page that redraws its chart by itself (the public statistics every half minute) leaves it alone while it is held.
        this.root.dataset.dashHold = '';
        this.nav.setPointerCapture(event.pointerId);
        event.preventDefault();
      });
      this.nav.addEventListener('pointermove', (event) => {
        if (!drag) return;
        const perDay = drag.width / (this.data.layout === 'points' ? Math.max(1, this.count - 1) : this.count);
        const delta = Math.round((event.clientX - drag.x) / Math.max(1, perDay));
        this.set(dragWin(drag.start, drag.mode, delta, this.count, MIN_DAYS), true);
      });
      const end = (event: PointerEvent) => {
        if (!drag) return;
        drag = null;
        delete this.nav.dataset.crDrag;
        delete this.root.dataset.dashHold;
        if (this.nav.hasPointerCapture(event.pointerId)) this.nav.releasePointerCapture(event.pointerId);
      };
      this.nav.addEventListener('pointerup', end);
      this.nav.addEventListener('pointercancel', end);
      this.win.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowLeft' ? -1 : event.key === 'ArrowRight' ? 1 : 0;
        if (event.key === 'Home' || event.key === 'End') {
          event.preventDefault();
          const size = this.current.b - this.current.a;
          this.set(event.key === 'Home' ? { a: 0, b: size } : { a: this.count - 1 - size, b: this.count - 1 }, true);
          return;
        }
        if (!step) return;
        event.preventDefault();
        // Arrows move the window; with Shift they stretch (or shrink) its right edge.
        this.set(dragWin(this.current, event.shiftKey ? 'right' : 'move', step, this.count, MIN_DAYS), true);
      });
      this.root.querySelector('[data-cr-all]')?.addEventListener('click', () => this.set({ a: 0, b: this.count - 1 }, true));
    }

    /** Puts the window on days `win.a` to `win.b`. It glides there (the numbers count to the new ones a moment behind it), or jumps when `animate` is false. */
    set(win: Win, animate: boolean) {
      this.current = win;
      const { layout } = this.data;
      this.tgt = { l: edgeAt(win.a, 'left', this.count, layout), r: edgeAt(win.b, 'right', this.count, layout) };
      const full = win.a === 0 && win.b === this.count - 1;
      if (full) this.root.dataset.crFull = ''; else delete this.root.dataset.crFull;
      this.win.setAttribute('aria-valuenow', String(win.a));
      this.targets(win);
      const glide = animate && !reduced();
      if (!glide) {
        this.vis = { ...this.tgt };
        for (const slot of this.slots.values()) slot.cur = slot.to;
        this.paint();
        return;
      }
      if (!this.frame) { this.last = performance.now(); this.frame = requestAnimationFrame((now) => this.step(now)); }
    }

    /** The text of the range and the values the numbers go to. */
    targets(win: Win) {
      const when = this.root.querySelector<HTMLElement>('[data-cr-when]');
      const first = this.dayFormat.format(new Date(`${this.data.d[win.a]}T00:00:00Z`));
      const last = this.dayFormat.format(new Date(`${this.data.d[win.b]}T00:00:00Z`));
      const text = win.b > win.a ? `${first} – ${last}` : first;
      if (when) when.textContent = text;
      this.win.setAttribute('aria-valuetext', text);
      const s = rangeStats(this.points, win, this.data.kind);
      const values: Record<string, number | null> = this.data.kind === 'level'
        ? { end: s.end, change: s.change, high: s.high, share: s.versus }
        : { total: s.total, avg: s.average, versus: s.versus };
      for (const [role, slot] of this.slots) {
        const to = values[role] ?? null;
        slot.to = to;
        if (to === null) slot.cur = null;
        else if (slot.cur === null) slot.cur = to;
      }
      // A rise is green and a fall red (the change of a level, the share against the period before).
      for (const role of ['change', 'versus']) {
        const slot = this.slots.get(role);
        if (!slot) continue;
        slot.el.classList.toggle('cr-up', slot.to !== null && slot.to > 0);
        slot.el.classList.toggle('cr-down', slot.to !== null && slot.to < 0);
      }
    }

    /** One step of the glide: everything moves a share of what is left, by the time that passed, so it looks the same at 60 and at 120 frames a second. */
    step(now: number) {
      const dt = Math.min(64, Math.max(1, now - this.last));
      this.last = now;
      const kw = 1 - Math.exp(-dt / WINDOW_TAU);
      const kn = 1 - Math.exp(-dt / NUMBER_TAU);
      let moving = false;
      for (const edge of ['l', 'r'] as const) {
        const diff = this.tgt[edge] - this.vis[edge];
        if (Math.abs(diff) < 0.0003) this.vis[edge] = this.tgt[edge]; else { this.vis[edge] += diff * kw; moving = true; }
      }
      for (const slot of this.slots.values()) {
        if (slot.to === null || slot.cur === null) continue;
        const diff = slot.to - slot.cur;
        if (Math.abs(diff) <= slot.tol) slot.cur = slot.to; else { slot.cur += diff * kn; moving = true; }
      }
      this.paint();
      this.frame = moving ? requestAnimationFrame((time) => this.step(time)) : 0;
    }

    /** Draws the window, the shade over the strip and over the chart, and the numbers, as they are now. */
    paint() {
      const { l, r } = this.vis;
      this.win.style.left = `${l * 100}%`;
      this.win.style.width = `${Math.max(0, r - l) * 100}%`;
      if (this.shadeL) this.shadeL.style.width = `${l * 100}%`;
      if (this.shadeR) this.shadeR.style.width = `${(1 - r) * 100}%`;
      if (this.dimL && this.dimR) {
        const [x0, x1, y0, y1] = this.data.box;
        const left = this.plotX(l);
        const right = this.plotX(r);
        for (const dim of [this.dimL, this.dimR]) { dim.style.top = `calc(${y0 * 100}% - ${SHADE_BLEED}px)`; dim.style.height = `calc(${(y1 - y0) * 100}% + ${SHADE_BLEED * 2}px)`; }
        this.dimL.style.left = `calc(${x0 * 100}% - ${SHADE_BLEED}px)`;
        this.dimL.style.width = `calc(${Math.max(0, left - x0) * 100}% + ${SHADE_BLEED}px)`;
        this.dimR.style.left = `${right * 100}%`;
        this.dimR.style.width = `calc(${Math.max(0, x1 - right) * 100}% + ${SHADE_BLEED}px)`;
      }
      for (const slot of this.slots.values()) slot.el.textContent = slot.cur === null ? (slot.el.dataset.crN === 'share' ? '' : '–') : slot.text(slot.cur);
    }

    /** Where on the plot (0-1 of its box) the place `f` of the strip lies: between the limits of the days, so the shade glides smoothly, not day by day. */
    plotX(f: number): number {
      const days = this.count;
      const position = Math.max(0, Math.min(1, f)) * (this.data.layout === 'points' ? days - 1 : days);
      const k = Math.min(this.bounds.length - 2, Math.floor(position));
      const from = this.bounds[k];
      const to = this.bounds[k + 1];
      return from + (to - from) * (position - k);
    }
  }

  const made = new WeakSet<Element>();
  function init(root: HTMLElement) {
    if (made.has(root)) return;
    made.add(root);
    const node = root.querySelector('script[data-cr-data]');
    let data: BrushData | null = null;
    try { data = JSON.parse(node?.textContent ?? ''); } catch { data = null; }
    if (!data || !data.v || data.v.length < 3) return;
    new Brush(root, data);
  }

  function scan(scope: ParentNode) {
    scope.querySelectorAll<HTMLElement>('[data-cr]').forEach(init);
  }
  scan(document);
  // A chart that the page draws later (public page redraws) is picked up for its range brush.
  new MutationObserver((records) => {
    for (const record of records) {
      record.addedNodes.forEach((node) => {
        if (!(node instanceof HTMLElement)) return;
        if (node.matches('[data-cr]')) init(node);
        scan(node);
      });
    }
  }).observe(document.body, { childList: true, subtree: true });
</script>
