---
// Three isometric line drawings, animated with CSS only: a rack of phones that are checked one by one (anti-nuke), a gate that closes on a queue of
// new accounts (anti-raid) and a scanner that sweeps a stack of messages and pulls one out (automod). The geometry is computed here; the movement is in
// the style at the bottom and stops with "reduce motion" (the drawing stays still).
import { Icon } from 'astro-icon/components';
import IsoBox from './IsoBox.astro';
import { HOME_COPY } from '../data/homeCopy';
import type { Locale } from '../i18n/ui';
import * as iso from '../utils/iso';
import type { P2 } from '../utils/iso';

interface Props { lang: Locale }
const { lang } = Astro.props;
const c = HOME_COPY[lang].layers;

const { P, str, scene } = iso;

// A: a rack of six phones checked one by one.
const A = scene();
const aTray = A.box(0, 0, 0, 7, 2.6, 0.3);
const aPosts = [A.box(0.15, 0.2, 0.3, 0.3, 0.3, 2.9), A.box(6.55, 0.2, 0.3, 0.3, 0.3, 2.9)];
const aPhones = Array.from({ length: 6 }, (_, i) => A.box(0.7 + i * 0.95, 0.7, 0.3, 0.42, 1.3, 2.3));
const aBar = A.box(0.15, 0.2, 3.0, 6.7, 0.3, 0.28);
const aView = A.view();

// B: a queue of new accounts on a conveyor and a gate that closes.
const B = scene();
const bBelt = B.box(0, 0.5, 0, 10, 1.7, 0.22);
const bCubes = Array.from({ length: 7 }, (_, i) => B.box(0.3 + i * 0.98, 0.95, 0.22, 0.72, 0.72, 0.72));
const bPosts = [B.box(7.7, 0.25, 0.22, 0.3, 0.3, 2.7), B.box(7.7, 1.95, 0.22, 0.3, 0.3, 2.7)];
const bBar = B.box(7.7, 0.25, 0.55, 0.3, 2.0, 0.3);
const bView = B.view();

// C: a stack of messages, a scanner that sweeps it and one message pulled out.
const C = scene();
const cBase = C.box(0.4, -0.3, -0.25, 2.9, 7.2, 0.25);
const cCards = Array.from({ length: 6 }, (_, i) => ({ y: 0.1 + i * 1.1, box: C.box(0.9, 0.1 + i * 1.1, 0, 1.9, 0.26, 2.3) }));
const cLines = cCards.map(({ y }) => [1.7, 1.25, 0.8].map((z, k) => ({ a: P(1.15, y + 0.26, z), b: P(k === 0 ? 2.2 : 2.5 - k * 0.2, y + 0.26, z) })));
const cScan = C.add([P(0.7, 0.0, -0.05), P(3.0, 0.0, -0.05), P(3.0, 0.0, 2.7), P(0.7, 0.0, 2.7)]);
const cView = C.view();
const ln = (q: { a: P2; b: P2 }) => ({ x1: q.a[0].toFixed(1), y1: q.a[1].toFixed(1), x2: q.b[0].toFixed(1), y2: q.b[1].toFixed(1) });
---
<div class="layers">
  <article class="layer l-nuke">
    <div class="layer-copy">
      <span class="chip"><Icon name="ph:shield-check-fill" width="14" height="14" />{c.nuke.chip}</span>
      <h3>{c.nuke.title}</h3>
      <p>{c.nuke.desc}</p>
    </div>
    <div class="art" aria-hidden="true">
      <svg viewBox={aView} class="iso" xmlns="http://www.w3.org/2000/svg">
        <IsoBox {...aTray} />
        {aPosts.map((b) => <IsoBox {...b} />)}
        {aPhones.map((b, i) => <IsoBox {...b} class="ph" style={`--i:${i}`} />)}
        <IsoBox {...aBar} class="bar" />
      </svg>
    </div>
  </article>

  <article class="layer l-raid">
    <div class="layer-copy">
      <span class="chip"><Icon name="ph:users-three-fill" width="14" height="14" />{c.raid.chip}</span>
      <h3>{c.raid.title}</h3>
      <p>{c.raid.desc}</p>
    </div>
    <div class="art" aria-hidden="true">
      <svg viewBox={bView} class="iso" xmlns="http://www.w3.org/2000/svg">
        <IsoBox {...bBelt} />
        {bCubes.map((b, i) => <IsoBox {...b} class="cube" style={`--i:${6 - i}`} />)}
        {bPosts.map((b) => <IsoBox {...b} />)}
        <IsoBox {...bBar} class="gate" />
      </svg>
    </div>
  </article>

  <article class="layer l-auto">
    <div class="layer-copy">
      <span class="chip"><Icon name="ph:robot-fill" width="14" height="14" />{c.automod.chip}</span>
      <h3>{c.automod.title}</h3>
      <p>{c.automod.desc}</p>
    </div>
    <div class="art" aria-hidden="true">
      <svg viewBox={cView} class="iso" xmlns="http://www.w3.org/2000/svg">
        <IsoBox {...cBase} />
        {cCards.map((card, i) => (
          <g class:list={['card', { flag: i === 3 }]}>
            <IsoBox {...card.box} />
            {cLines[i].map((q) => <line {...ln(q)} class="ln" />)}
          </g>
        ))}
        <polygon class="scan" points={str(cScan)} />
      </svg>
    </div>
  </article>
</div>

<style>
  .layers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .layer { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 24px; background: var(--card); overflow: hidden; }
  .layer-copy { padding: 26px 26px 0; min-height: 200px; }
  .chip { display: inline-flex; align-items: center; gap: 7px; padding: 5px 12px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-text); font-size: 12.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .layer h3 { margin: 16px 0 8px; font-size: 21px; line-height: 1.25; }
  .layer p { margin: 0; color: var(--text-muted); font-size: 14.5px; line-height: 1.6; }
  /* The drawing sits on a faint isometric grid that fades out at the edges, like a blueprint. */
  .art { position: relative; margin-top: 22px; flex: 1; border-top: 1px solid var(--border-soft); background: var(--bg-raise); overflow: hidden; display: grid; place-items: center; --iso-line: color-mix(in srgb, var(--text) 62%, transparent); }
  .art::before { content: ''; position: absolute; inset: 0; opacity: .7;
    background-image: repeating-linear-gradient(30deg, var(--ash-line, rgba(255,255,255,.07)) 0 1px, transparent 1px 30px), repeating-linear-gradient(-30deg, var(--ash-line, rgba(255,255,255,.07)) 0 1px, transparent 1px 30px);
    -webkit-mask-image: radial-gradient(70% 70% at 50% 50%, #000 30%, transparent 100%); mask-image: radial-gradient(70% 70% at 50% 50%, #000 30%, transparent 100%); }
  .iso { position: relative; width: 100%; height: auto; display: block; overflow: visible; }
  .iso :global(polygon), .iso line { stroke: var(--iso-line); stroke-width: 1.2; stroke-linejoin: round; stroke-linecap: round; fill: var(--bg-raise); vector-effect: non-scaling-stroke; }
  .iso :global(.f-top) { fill: var(--card-hover); }
  .iso .ln { stroke-opacity: .55; fill: none; }

  /* A: the phones are checked one by one: the one being checked lifts a little and its lines turn bright. */
  .iso :global(.bx.ph) { transform-box: fill-box; }
  /* B: the gate and the queue. C: the scanner and the message that is pulled out. */
  .iso .scan { fill: color-mix(in srgb, var(--accent) 16%, transparent); stroke: var(--accent); stroke-dasharray: 4 3; }
  .iso .flag { transform-box: fill-box; }

  @media (prefers-reduced-motion: no-preference) {
    .iso :global(.bx.ph) { animation: phCheck 6s ease-in-out infinite; animation-delay: calc(var(--i) * 0.6s); }
    .iso :global(.bx.cube) { animation: cubeIn 7s cubic-bezier(.3, .7, .3, 1) infinite; animation-delay: calc(var(--i) * 0.12s); }
    .iso :global(.bx.gate) { animation: gateClose 7s cubic-bezier(.5, 0, .3, 1) infinite; }
    .iso .scan { animation: scanSweep 7s linear infinite; }
    .iso .flag { animation: flagOut 7s ease-in-out infinite; }
  }
  @keyframes phCheck {
    0%, 100% { transform: none; }
    8%, 14% { transform: translateY(-14px); }
    24% { transform: none; }
  }
  @keyframes cubeIn {
    0% { transform: translate(-98px, -57px); opacity: 0; }
    12% { opacity: 1; }
    42%, 90% { transform: none; opacity: 1; }
    100% { transform: translate(8px, 5px); opacity: 0; }
  }
  @keyframes gateClose {
    0%, 12% { transform: translateY(-58px); }
    36%, 90% { transform: none; }
    100% { transform: translateY(-58px); }
  }
  @keyframes scanSweep {
    0% { transform: translate(0, 0); opacity: 0; }
    6% { opacity: 1; }
    62% { transform: translate(-135px, 78px); opacity: 1; }
    70%, 100% { transform: translate(-135px, 78px); opacity: 0; }
  }
  @keyframes flagOut {
    0%, 34% { transform: none; opacity: 1; }
    40% { transform: translate(0, 0); }
    52% { transform: translate(34px, 20px); opacity: .25; }
    88% { transform: translate(34px, 20px); opacity: .25; }
    100% { transform: none; opacity: 1; }
  }
  .iso .flag :global(polygon) { animation: flagStroke 7s ease-in-out infinite; }
  @keyframes flagStroke { 0%, 33% { stroke: var(--iso-line); } 38%, 88% { stroke: var(--red); } 100% { stroke: var(--iso-line); } }
  @media (prefers-reduced-motion: reduce) { .iso .flag :global(polygon) { animation: none; } }

  @media (max-width: 980px) { .layers { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; } }
</style>
