---
// Summary (/dash/summary): what a person did across Petto (messages and time in voice), their streaks in every server, and the six Bufis (the ones they have are lit, the others are dim).
// The bot counts everything and sends the numbers; this page only shows them.
import DashMeLayout from './DashMeLayout.astro';
import DashPanelHead from './DashPanelHead.astro';
import DashShopShared from './DashShopShared.astro';
import { Icon } from 'astro-icon/components';
import { getDashLang, makeT } from '../i18n/dash';
import type { Session } from '../utils/session';

interface Row { guildId: string; name: string | null; icon: string | null; current: number; best: number; activeToday: boolean; freezesUsed: number; rules: { minMessages: number; minVoiceMinutes: number } }
interface Props {
  user: Session;
  data: { freezes: number; bestEver: number; longestNow: number; totals: { messages: number; voiceSeconds: number }; servers: Row[] } | null;
  state: { plan: string | null; owned: { id: string }[] } | null;
}
const { user, data, state } = Astro.props;
const lang = getDashLang(Astro);
const dt = makeT(lang);
const number = new Intl.NumberFormat(lang);
const planNames: Record<string, string> = { free: dt('Free'), bronze: dt('Bronze'), silver: dt('Silver'), gold: dt('Gold') };
const hours = data ? Math.floor(data.totals.voiceSeconds / 3600) : 0;
const minutes = data ? Math.floor((data.totals.voiceSeconds % 3600) / 60) : 0;
const BUFIS = [
  { id: 'bufi-normal', name: dt('Normal'), color: '#8a8f98' },
  { id: 'bufi-silver', name: dt('Silver'), color: '#b8bcc4' },
  { id: 'bufi-girl', name: dt('Girl'), color: '#ff3d8f' },
  { id: 'bufi-boy', name: dt('Boy'), color: '#1e90ff' },
  { id: 'bufi-bu', name: dt('Bu'), color: '#f4cf3a' },
  { id: 'bufi-black-friday', name: dt('Black Friday'), color: '#3a3a42' },
];
const owned = new Set((state?.owned ?? []).map((row) => row.id));
const have = BUFIS.filter((bufi) => owned.has(bufi.id)).length;
const plan = state?.plan ?? 'free';
---
<DashMeLayout user={user} active="summary" pageTitle="Summary">
  <DashShopShared />
  <DashPanelHead title={dt('Summary')} eyebrow={dt('Main')} icon="ph:fire-fill" back={false} />
  {!data && <p class="bd-down" role="alert">{dt('Petto did not answer. Try again in a moment.')}</p>}
  {data && (
    <div class="sm">
      <div class="sm-tiles" role="group" aria-label={dt('Summary')}>
        <article class="bd-card sm-tile"><span>{dt('Plan')}</span><b>{planNames[plan] ?? plan}</b></article>
        <article class="bd-card sm-tile"><span>{dt('Messages')}</span><b>{number.format(data.totals.messages)}</b></article>
        <article class="bd-card sm-tile"><span>{dt('In voice')}</span><b>{hours > 0 ? dt('{h} h {m} min', { h: String(hours), m: String(minutes) }) : dt('{m} min', { m: String(minutes) })}</b></article>
        <article class="bd-card sm-tile sm-fire"><span>{dt('Best streak')}</span><b><Icon name="ph:fire-fill" width="20" height="20" />{dt('{n} days', { n: number.format(data.bestEver) })}</b></article>
      </div>

      <section class="bd-card sm-card" aria-labelledby="sm-streaks">
        <header><h2 id="sm-streaks">{dt('My streaks by server')}</h2><span>{dt('Freezes: {n}', { n: String(data.freezes) })}</span></header>
        {data.servers.length === 0
          ? <p class="sm-empty">{dt('You have no streak yet. Chat or join a voice channel in a server with streaks to start one.')}</p>
          : (
            <ul class="sm-list">
              {data.servers.map((row) => (
                <li class="sm-row">
                  {row.icon ? <img src={row.icon} alt="" width="36" height="36" loading="lazy" /> : <span class="sm-ph" aria-hidden="true"></span>}
                  <div class="sm-name"><strong>{row.name ?? dt('Server')}</strong><span>{row.activeToday ? dt('Done today') : row.current > 0 ? dt('Be active today to keep it') : dt('No streak now')}</span></div>
                  <div class="sm-days" title={dt('Best: {n} days', { n: String(row.best) })}><Icon name="ph:fire-fill" width="16" height="16" /><b>{dt('{n} days', { n: number.format(row.current) })}</b></div>
                </li>
              ))}
            </ul>
          )}
      </section>

      <section class="bd-card sm-card" aria-labelledby="sm-bufis">
        <header><h2 id="sm-bufis">{dt('Bufis')}</h2><span>{dt('{n} of {m} owned', { n: String(have), m: String(BUFIS.length) })}</span></header>
        <ul class="sm-bufis">
          {BUFIS.map((bufi) => (
            <li class:list={['sm-bufi', { 'is-own': owned.has(bufi.id) }]} style={`--bufi:${bufi.color}`}>
              <span class="sm-dot" aria-hidden="true"></span>
              <b>{bufi.name}</b>
              <em>{owned.has(bufi.id) ? dt('Yours') : dt('Not yet')}</em>
            </li>
          ))}
        </ul>
        <a class="btn btn-sm sm-more" href="/dash/badges">{dt('See the badges')}</a>
      </section>
    </div>
  )}
</DashMeLayout>

<style is:global>
  .sm { display: flex; flex-direction: column; gap: 14px; }
  .sm-tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 900px) { .sm-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .sm-tile { padding: 16px 18px; display: flex; flex-direction: column; gap: 6px; }
  .sm-tile span { color: var(--text-muted); font-size: 13px; } .sm-tile b { font-size: 22px; display: inline-flex; align-items: center; gap: 6px; }
  .sm-fire b { color: var(--yellow, #f5b73c); }
  .sm-card { padding: 18px; display: flex; flex-direction: column; gap: 12px; }
  .sm-card header { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; flex-wrap: wrap; } .sm-card h2 { margin: 0; font-size: 18px; } .sm-card header span { color: var(--text-muted); font-size: 13px; }
  .sm-empty { margin: 0; color: var(--text-muted); }
  .sm-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  @media (max-width: 760px) { .sm-list { grid-template-columns: minmax(0, 1fr); } }
  .sm-row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 10px 14px; border: 1px solid var(--border-soft); border-radius: 14px; background: color-mix(in srgb, var(--text) 3%, transparent); }
  .sm-row img, .sm-ph { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; background: color-mix(in srgb, var(--text) 10%, transparent); }
  .sm-name { display: flex; flex-direction: column; min-width: 0; } .sm-name strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .sm-name span { color: var(--text-muted); font-size: 12.5px; }
  .sm-days { display: inline-flex; align-items: center; gap: 5px; color: var(--yellow, #f5b73c); white-space: nowrap; }
  .sm-bufis { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; }
  @media (max-width: 900px) { .sm-bufis { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 460px) { .sm-bufis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .sm-bufi { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 14px 8px; border: 1px solid var(--border-soft); border-radius: 14px; background: color-mix(in srgb, var(--text) 3%, transparent); opacity: .5; filter: grayscale(.8); text-align: center; }
  .sm-bufi.is-own { opacity: 1; filter: none; border-color: color-mix(in srgb, var(--bufi) 55%, transparent); background: color-mix(in srgb, var(--bufi) 12%, transparent); }
  .sm-dot { width: 44px; height: 44px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--bufi) 60%, #fff), var(--bufi)); box-shadow: inset 0 0 0 2px rgba(0,0,0,.25); }
  .sm-bufi b { font-size: 14px; } .sm-bufi em { font-style: normal; font-size: 12px; color: var(--text-muted); }
  .sm-more { align-self: flex-start; border: 1px solid var(--border); border-radius: 10px; padding: 8px 14px; }
  @media (max-width: 520px) { .sm-tile { padding: 14px; } .sm-tile b { font-size: 18px; white-space: nowrap; } }
</style>
